                      name: "expr",
                      value: "The expression by which to order rows",
                      type: "/__root__/definitions/object/expr"
                    },
                    {
                      name: "isAscending",
                      value: "Contains a value true if ordering in ascending directory, or false for descending",
                      type: "/__root__/definitions/object/valueObject/booleanObject"
                    }
                  ]
                }, // EndPath: /__root__/definitions/object/compound/stageRange
// Path: /__root__/definitions/object/compound/hint
                {
                  name: "hint",
                  value: "A query hint that is applied to a statement or part thereof. Its children are values associated with the hint.",
                  properties: [
                    { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      { name: "valueType", type:  "/__root__/primitives/constraints/valueType", children: [
