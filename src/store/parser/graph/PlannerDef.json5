// Path: /__root__/definitions/types
        {
          name: "types",
          value: "a container of different types used in the system",
          children: [

// Path: /__root__/definitions/types/sqlType
            {
              name: "sqlType",
              value: "Covers the main SQL data types used in planning queries",
              children: [
// Path: /__root__/definitions/types/sqlType/boolean
                {
                  name: "boolean",
                  value: "an SQL true/false value"
                },
// Path: /__root__/definitions/types/sqlType/integer
                {
                  name: "integer",
                  value: "an SQL exact-numeric integer",
                },
// Path: /__root__/definitions/types/sqlType/float
                {
                  name: "float",
                  value: "an SQL approximate-numeric floating point value",
                },
// Path: /__root__/definitions/types/sqlType/decimal
                {
                  name: "decimal",
                  value: "an SQL exact-numeric decimal value",
                  properties: [
                    {
                      name: "precision",
                      value: "An optional property that is the number of digits in the value",
                      type: "/__root__/definitions/object/valueObject/integerObject",
                      properties: [
                        { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                        ]}
                      ]
                    },
                    {
                      name: "scale",
                      value: "An optional property that is the number of digits to the right of the decimal point in the value",
                      type: "/__root__/definitions/object/valueObject/integerObject",
                      properties: [
                        { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                        ]}
                      ]
                    }
                  ]
                },
// Path: /__root__/definitions/types/sqlType/varchar
                {
                  name: "varchar",
                  value: "an SQL exact-numeric decimal value",
                  properties: [
                    {
                      name: "length",
                      value: "An optional property that is the max number of bytes in the value",
                      type: "/__root__/definitions/object/valueObject/integerObject",
                      properties: [
                        { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                        ]}
                      ]
                    }
                  ]
                },
// Path: /__root__/definitions/types/sqlType/date
                {
                  name: "date",
                  value: "a SQL date value with optional timezone information",
                  properties: [
                    {
                      // TODO: We may wish to support other timezone formats, such as TZ names
                      // TODO: which can vary in their offset (e.g. "Australia/Sydney"), as well
                      // TODO: as timezone abbreviations such as "AEST".
                      name: "tzOffset",
                      value: "Optional number of minutes offset from GMT. East of Greenwich is positive, west is negative.",
                      type: "/__root__/definitions/object/valueObject/integerObject",
                      properties: [
                        { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                        ]}
                      ]
                    }
                  ]
                },
// Path: /__root__/definitions/types/sqlType/time
                {
                  name: "time",
                  value: "a SQL time value with optional timezone information",
                  properties: [
                    {
                      // TODO: We may wish to support other timezone formats, such as TZ names
                      // TODO: which can vary in their offset (e.g. "Australia/Sydney"), as well
                      // TODO: as timezone abbreviations such as "AEST".
                      name: "tzOffset",
                      value: "Optional number of minutes offset from GMT. East of Greenwich is positive, west is negative.",
                      type: "/__root__/definitions/object/valueObject/integerObject",
                      properties: [
                        { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                        ]}
                      ]
                    }
                  ]
                },
// Path: /__root__/definitions/types/sqlType/timestamp
                {
                  name: "timestamp",
                  value: "a SQL date value with optional timezone information",
                  properties: [
                    {
                      // TODO: We may wish to support other timezone formats, such as TZ names
                      // TODO: which can vary in their offset (e.g. "Australia/Sydney"), as well
                      // TODO: as timezone abbreviations such as "AEST".
                      name: "tzOffset",
                      value: "Optional number of minutes offset from GMT. East of Greenwich is positive, west is negative.",
                      type: "/__root__/definitions/object/valueObject/integerObject",
                      properties: [
                        { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                        ]}
                      ]
                    }
                  ]
                },
// Path: /__root__/definitions/types/sqlType/intervalYM
                {
                  name: "intervalYM",
                  value: "a range between two timestamps in years and months"
                },
// Path: /__root__/definitions/types/sqlType/intervalDT
                {
                  name: "intervalDT",
                  value: "a range between two timestamps in days and time"
                },
// Path: /__root__/definitions/types/sqlType/unknown
                {
                  name: "unknown",
                  value: "represents the data type for a NULL literal"
                }
              ]
            }, // EndPath: /__root__/definitions/types/sqlType

// Path: /__root__/definitions/types/location
            {
              name: "location",
              value: "a container for the enumeration of different locations where SQL operators can execute",
              children: [
// Path: /__root__/definitions/types/location/allPartitions
                {
                  name: "allPartitions",
                  value: "The object that has this designation runs on all partitions in the system"
                },
// Path: /__root__/definitions/types/location/allNodes
                {
                  name: "allNodes",
                  value: "The object that has this designation runs one per node on all nodes in the system"
                },
// Path: /__root__/definitions/types/location/origin
                {
                  name: "origin",
                  value: "The object that has this designation runs on the origin node only"
                }
              ]
            }, // EndPath: /__root__/definitions/types/location

// Path: /__root__/definitions/types/routing
            {
              name: "routing",
              value: "a container for the enumeration of different ways data can be sent from a child operator to a parent",
              children: [
// Path: /__root__/definitions/types/routing/unicast
                {
                  name: "unicast",
                  value: "Data is sent to a single endpoint only"
                },
// Path: /__root__/definitions/types/routing/broadcast
                {
                  name: "broadcast",
                  value: "Data is sent to all endpoints"
                },
// Path: /__root__/definitions/types/routing/hashcast
                {
                  name: "hashcast",
                  value: "Data is sent to one specific endpoint based on the hashing of an expression"
                },
// Path: /__root__/definitions/types/routing/localPartition
                {
                  name: "localPartition",
                  value: "Data is sent to a pipeline stage running on the same partition on the current node"
                },
// Path: /__root__/definitions/types/routing/localNode
                {
                  name: "localNode",
                  value: "Data is sent to a pipeline stage running on the same node"
                }
              ]
            }, // EndPath: /__root__/definitions/types/routing

// Path: /__root__/definitions/types/joinType
            {
              name: "joinType",
              value: "Whether the join is an inner join, left outer join, full outer join, etc",
              children: [
// Path: /__root__/definitions/types/joinType/innerJoin
                {
                  name: "innerJoin",
                  value: "Emits combined left/right row if join predicate evaluates true"
                },
// Path: /__root__/definitions/types/joinType/crossJoin
                {
                  name: "crossJoin",
                  value: "Emits combined left/right row for all left/right combinations"
                },
// Path: /__root__/definitions/types/joinType/semiJoin
                {
                  name: "semiJoin",
                  value: "Emits only left row if join predicate evaluates true"
                },
// Path: /__root__/definitions/types/joinType/antiJoin
                {
                  name: "antiJoin",
                  value: "Emits only left row if join predicate never evaluated to true for all right row combinations"
                },
// Path: /__root__/definitions/types/joinType/leftOuterJoin
                {
                  name: "leftOuterJoin",
                  value: "Emits combined left/right row if join predicate evaluates true as well as combined left/null row for any previously unmatched left rows"
                },
// Path: /__root__/definitions/types/joinType/rightOuterJoin
                {
                  name: "rightOuterJoin",
                  value: "Emits combined left/right row if join predicate evaluates true as well as combined right/null row for any previously unmatched right rows"
                },
// Path: /__root__/definitions/types/joinType/fullOuterJoin
                {
                  name: "fullOuterJoin",
                  value: "Emits combined left/right row if join predicate evaluates true as well as combined left/null row and null/right row for any previously unmatched left and right rows"
                },
// Path: /__root__/definitions/types/joinType/naturalInnerJoin
                {
                  name: "naturalInnerJoin",
                  value: "Emits combined left/right row of distinctly named columns if join predicate evaluates true. Only 1 copy of common columns is emitted."
                },
// Path: /__root__/definitions/types/joinType/naturalLeftOuterJoin
                {
                  name: "naturalLeftOuterJoin",
                  value: "Emits combined left/right row of distinctly named columns if join predicate evaluates true as well as combined left/null row for any previously unmatched left rows. Only 1 copy of common columns is emitted."
                },
// Path: /__root__/definitions/types/joinType/naturalRightOuterJoin
                {
                  name: "naturalRightOuterJoin",
                  value: "Emits combined left/right row of distinctly named columns if join predicate evaluates true as well as combined right/null row for any previously unmatched right rows. Only 1 copy of common columns is emitted."
                },
// Path: /__root__/definitions/types/joinType/naturalFullOuterJoin
                {
                  name: "naturalFullOuterJoin",
                  value: "Emits combined left/right row of distinctly named columns if join predicate evaluates true as well as combined left/null row and null/right row for any previously unmatched left and right rows. Only 1 copy of common columns is emitted."
                }
              ]
            } // EndPath: /__root__/definitions/types/joinType
          ]
        }, // EndPath: /__root__/definitions/types
      ]
    }, // EndPath: /__root__/definitions

