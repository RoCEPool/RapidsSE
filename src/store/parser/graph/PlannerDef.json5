                      properties: [
                        {name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          {name: "nonNullable", type:  "/__root__/primitives/constraints/nonNullable"}
                        ]}
                      ]
                    } // EndPath: /__root__/definitions/object/valueObject/stringObject/nonNullableStringObject
                  ]
                }, // EndPath: /__root__/definitions/object/valueObject/stringObject
// Path: /__root__/definitions/object/valueObject/integerObject
                {
                  name: "integerObject",
                  value: "A simple object that only contains an integer value",
                  properties: [
                    // Add a constraint that the value of this object must be of an integer primitive type
                    {name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      {
