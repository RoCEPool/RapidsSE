                {
                  name: "stageRange",
                  value: "An object that identifies a SQL compilation stage or a range of stages. Used for EXPLAINing queries",
                  properties: [
                    {
                      name: "begin",
                      value: "The starting stage name (string), number (integer), or '*'. Begin range is inclusive.",
                      type: "/__root__/definitions/object/valueObject"
                    },
                    {
                      name: "end",
                      value: "The ending stage name (string), number (integer), or '*'. Property may be null. End range is inclusive.",
                      type: "/__root__/definitions/object/valueObject",
                      properties: [
                        { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                        ]}
                      ]
                    }
                  ]
                }, // EndPath: /__root__/definitions/object/compound/stageRange
// Path: /__root__/definitions/object/compound/orderItem
                {
                  name: "orderItem",
