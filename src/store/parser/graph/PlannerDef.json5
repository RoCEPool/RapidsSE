                }, // EndPath: /__root__/definitions/object/compound/indexDef
// Path: /__root__/definitions/object/compound/cteDef
                {
                  name: "cteDef",
                  value: "contains the definition of a Common Table Expression",
                  properties: [
                    {
                      name: "aliasName",
                      value: "The name of the virtual table that this CTE provides rows as",
