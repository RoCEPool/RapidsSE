// Plan graph definitions
// **********************
//
// This document is in JSON5 format.
// All objects have the following fields:
//  - name        (string)
//  - value       (simple value)
//  - type        (string)
//  - properties  (an array)
//  - children    (an array)
//
// A field not specified will be treated as null.
// There are two special named properties:
//   "__path", which is the current path of the object (to be added dynamically);
//   "__constraints", which is a container of any constraints that are applied to an object.
//
// The __path property will be added automatically when this file is parsed.
//
// To read/scan this document, look for the "Path:" comments at the left margin
// as they will tell you the current hierarchical path of the object about to be defined.

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Start with the root object of the plan graph
// Path: /__root__/
{
  name: "__root__",
  value: "The root of the plan graph",
  type: "/__root__/primitives/root",
  children: [
// Path: /__root__/primitives
    {
      name: "primitives",
      value: "Contains all of the apriori information about definitions",
      type: "/__root__/primitives/trunk",
      children: [
// Path: /__root__/primitives/root
        {
          name: "root",
          value: "A definition for the root node of the graph, /",
        },
// Path: /__root__/primitives/trunk
        {
          name: "trunk",
          value: "A definition for a major branch node of the graph, /plan, /definitions, etc",
        },
// Path: /__root__/primitives/types
        {
          name: "types",
          value: "A container of all the apriori type information used in definitions",
          children: [
// Path: /__root__/primitives/types/scalarType
            {
              name: "scalarType",
              value: "A container of all the scalar data types used in definitions",
              children: [
// Path: /__root__/primitives/types/scalarType/integer
                {
                  name: "integer",
                  value: "A basic whole number type",
                },
// Path: /__root__/primitives/types/scalarType/float
                {
                  name: "float",
                  value: "A basic approximate-numeric decimal number type",
                },
// Path: /__root__/primitives/types/scalarType/decimal
                {
                  name: "decimal",
                  value: "An exact-numeric decimal number type",
                },
// Path: /__root__/primitives/types/scalarType/string
                {
                  name: "string",
                  value: "A basic character string type",
                },
// Path: /__root__/primitives/types/scalarType/boolean
                {
                  name: "boolean",
                  value: "A basic true/false type",
                },
// Path: /__root__/primitives/types/scalarType/date
                {
                  name: "date",
                  value: "A date type",
                },
// Path: /__root__/primitives/types/scalarType/time
                {
                  name: "time",
                  value: "A time type",
                },
// Path: /__root__/primitives/types/scalarType/timestamp
                {
                  name: "timestamp",
                  value: "A timestamp type",
                },
// Path: /__root__/primitives/types/scalarType/interval
                {
                  name: "interval",
                  value: "A interval type",
                },
// Path: /__root__/primitives/types/scalarType/unknown
                {
                  name: "unknown",
                  value: "An unknown (null) type",
                }
              ]
            }, // EndPath: /__root__/primitives/types/scalarType
// Path: /__root__/primitives/types/vectorType
            {
              name: "vectorType",
              value: "A type representing a list/array of objects",
            },
// Path: /__root__/primitives/types/anyType
            {
              name: "anyType",
              value: "A type representing a plurality of types. ie, anything goes!",
            },
// Path: /__root__/primitives/types/nullType
            {
              name: "nullType",
              value: "A type representing a null only",
            }
          ]
        }, // EndPath: /__root__/primitives/types

// Path: /__root__/primitives/constraints
        {
          name: "constraints",
          value: "A container of all the constraint modifiers used in definitions",
          children: [
// Path: /__root__/primitives/constraints/noChildren
            {
              name: "noChildren",
              value: "The target object is not allowed to have any children objects",
            },
// Path: /__root__/primitives/constraints/alwaysChildren
            {
              name: "alwaysChildren",
              value: "The target object is must always have children objects",
            },
// Path: /__root__/primitives/constraints/nullable
            {
              name: "nullable",
              value: "The value of the target object is allowed to be null",
            },
// Path: /__root__/primitives/constraints/nonNullable
            {
              name: "nonNullable",
              value: "The value of the target object is not allowed to be null",
            },
// Path: /__root__/primitives/constraints/optional
            {
              name: "optional",
              value: "The target object (note: not its value) is may not exist and can be null",
            },
// Path: /__root__/primitives/constraints/mandatory
            {
              name: "mandatory",
              value: "The target object (note: not its value) must exist and not be null",
            },
// Path: /__root__/primitives/constraints/childType
            {
              name: "childType",
              value: "All children of an object with this constraint must have children of a given type. The types are specified as children of an instantiation of this constraint."
            },
// Path: /__root__/primitives/constraints/valueType
            {
              name: "valueType",
              value: "A constraint on the type of the object in the value field. The actual type is specified as a child of an instantiation of this constraint."
            },
// Path: /__root__/primitives/constraints/childCount
            {
              name: "childCount",
              value: "A constraint where the target object must have a specific number of children. The count is specified as a child of an instantiation of this constraint."
            },
// Path: /__root__/primitives/constraints/minChildCount
            {
              name: "minChildCount",
              value: "A constraint where the target object must have at least a specific number of children. The count is specified as a child of an instantiation of this constraint."
            },
// Path: /__root__/primitives/constraints/maxChildCount
            {
              name: "maxChildCount",
              value: "A constraint where the target object must have no more than a specific number of children. The count is specified as a child of an instantiation of this constraint."
            }
          ]
        } // EndPath: /__root__/primitives/constraints
      ]
    }, // EndPath: /__root__/primitives

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Path: /__root__/definitions
    {
      name: "definitions",
      value: "A container of all definitions",
      type: "/__root__/primitives/trunk",
      children: [
// Path: /__root__/definitions/object
        {
          name: "object",
          value: "A container of all object definitions",
          children: [

// Path: /__root__/definitions/object/valueObject
            {
              name: "valueObject",
              value: "An object that only contains a simple value",
              properties: [
                // Add a constraint that the valueObjects contain no children
                { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                  { name: "noChildren", type:  "/__root__/primitives/constraints/noChildren" }
                ]}
              ],
              children: [

// Path: /__root__/definitions/object/valueObject/stringObject
                {
                  name: "stringObject",
                  value: "A simple object that only contains a string value",
                  properties: [
                    // Add a constraint that the value of this object must be of a string primitive type
                    {name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      {
                        name: "valueType",
                        type:  "/__root__/primitives/constraints/valueType",
                        children: [
                          {
                            name: "valueTypeParam",
                            type: "/__root__/definitions/object/valueObject/stringObject",  // yes, this is recursive
                            value: "/__root__/primitives/types/scalarType/string"
                          }
                        ]
                      }
                    ]}
                  ],
                  children: [

// Path: /__root__/definitions/object/valueObject/stringObject/nonNullableStringObject
                    {
                      name: "nonNullableStringObject",
                      value: "A simple object that only contains a non-nullable string value",
                      properties: [
                        {name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          {name: "nonNullable", type:  "/__root__/primitives/constraints/nonNullable"}
                        ]}
                      ]
                    } // EndPath: /__root__/definitions/object/valueObject/stringObject/nonNullableStringObject
                  ]
                }, // EndPath: /__root__/definitions/object/valueObject/stringObject
// Path: /__root__/definitions/object/valueObject/integerObject
                {
                  name: "integerObject",
                  value: "A simple object that only contains an integer value",
                  properties: [
                    // Add a constraint that the value of this object must be of an integer primitive type
                    {name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      {
                        name: "valueType",
                        type:  "/__root__/primitives/constraints/valueType",
                        children: [
                          {
                            name: "valueTypeParam",
                            type: "/__root__/definitions/object/valueObject/stringObject",
                            value: "/__root__/primitives/types/scalarType/integer"
                          }
                        ]
                      }
                    ]}
                  ]
                },

// Path: /__root__/definitions/object/valueObject/floatObject
                {
                  name: "floatObject",
                  value: "A simple object that only contains a floating-point value",
                  properties: [
                    // Add a constraint that the value of this object must be of a float primitive type
                    {name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      {
                        name: "valueType",
                        type:  "/__root__/primitives/constraints/valueType",
                        children: [
                          {
                            name: "valueTypeParam",
                            type: "/__root__/definitions/object/valueObject/stringObject",
                            value: "/__root__/primitives/types/scalarType/float"
                          }
                        ]
                      }
                    ]}
                  ]
                },
// Path: /__root__/definitions/object/valueObject/booleanObject
                {
                  name: "booleanObject",
                  value: "A simple object that only contains a boolean value",
                  properties: [
                    // Add a constraint that the value of this object must be of a boolean primitive type
                    {name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      {
                        name: "valueType",
                        type:  "/__root__/primitives/constraints/valueType",
                        children: [
                          {
                            name: "valueTypeParam",
                            type: "/__root__/definitions/object/valueObject/stringObject",
                            value: "/__root__/primitives/types/scalarType/boolean"
                          }
                        ]
                      }
                    ]}
                  ]
                },

// Path: /__root__/definitions/object/valueObject/unknownObject
                {
                  name: "unknownObject",
                  value: "A simple object that only contains an unknown (null) value",
                  properties: [
                    // Add a constraint that the value of this object must be of an unknown primitive type
                    {name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      {
                        name: "valueType",
                        type:  "/__root__/primitives/constraints/valueType",
                        children: [
                          {
                            name: "valueTypeParam",
                            type: "/__root__/definitions/object/valueObject/stringObject",
                            value: "/__root__/primitives/types/scalarType/unknown"
                          }
                        ]
                      }
                    ]}
                  ]
                }
              ]
            }, // EndPath: /__root__/definitions/object/valueObject

// Path: /__root__/definitions/object/planObject
            {
              name: "planObject",
              value: "The abstract root of all objects that appear in the main data path of the plan graph",
              properties: [
                {
                  name:  "location",
                  value: "Where this planObject runs in the cluster (optional)",
                  type: "/__root__/definitions/types/location",
                  properties: [
                    // Add a constraint that this property is optional
                    { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                    ]}
                  ]
                },
                {
                  name:  "hints",
                  value: "Any hints that apply from this point of the graph down",
                  type:  "/__root__/definitions/object/list/hints",
                  properties: [
                    // Add a constraint that this property is optional
                    { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                    ]}
                  ]
                }
              ],
              children: [

// Path: /__root__/definitions/object/planObject/planMarker
                {
                  name: "planMarker",
                  value: "An inert object in the graph that separates logical concepts",
                  children: [

// Path: /__root__/definitions/object/planObject/planMarker/stageMarker
                    {
                      name: "stageMarker",
                      value: "An inert marker used in the transliteration process to indicate a new pipeline stage is required",
                      properties: [
                        // don't forget all planObjects also have an optional location too
                        {
                          name: "routing",
                          value: "How row data that comes from the child node is to be routed to the parent node",
                          type: "/__root__/definitions/types/routing"
                        }
                      ]
                    },

// Path: /__root__/definitions/object/planObject/planMarker/subqueryMarker
                    {
                      name: "subqueryMarker",
                      value: "Marks the start of some type of subquery. This is an abstract base type.",
                      properties: [
                        {
                          // Where the definition of this CTE may be found. Could be null temporarily.
                          name: "defnPath",
                          value: "The full path to the definition of this CTE",
                          type: "/__root__/definitions/object/valueObject/stringObject"
                        },
                        {
                          name: "sqlText",
                          value: "The textual representation of this subquery",
                          type: "/__root__/definitions/object/valueObject/stringObject"
                        },
                        {
                          // All subqueries must have a table alias, even if it isn't referenced
                          name: "tableAlias",
                          value: "The virtual table name that this subquery is known as",
                          type: "/__root__/definitions/object/valueObject/stringObject"
                        },
                        {
                          name: "correlatedExprs",
                          value: "A list of expressions in this subquery that are correlated to a parent subquery",
                          type: "/__root__/definitions/object/list/exprList"
                        }
                      ],
                      children: [

// Path: /__root__/definitions/object/planObject/planMarker/subqueryMarker/mainSubquery
                        {
                          name: "mainSubquery",
                          value: "Identifies the primary subquery to be executed.",
                          properties: [
                            {
                              // Add a constraint that children of a mainSubquery must be
                              // either a StatementMarker or StageMarker.
                              name: "__constraints", type: "/__root__/primitives/constraints", children: [
                              {
                                name: "childType",
                                type: "/__root__/primitives/constraints/childType",
                                children: [
                                  {
                                    name: "childTypeParam1",
                                    type: "/__root__/definitions/object/valueObject/stringObject",
                                    value: "/__root__/definitions/object/planObject/planMarker/statementMarker"
                                  },
                                  {
                                    name: "childTypeParam2",
                                    type: "/__root__/definitions/object/valueObject/stringObject",
                                    value: "/__root__/definitions/object/planObject/planMarker/stageMarker"
                                  }
                                ]
                              }]
                            }
                          ],
                        },

// Path: /__root__/definitions/object/planObject/planMarker/subqueryMarker/tableSubquery
                        {
                          name: "tableSubquery",
                          value: "Identifies a subquery emanating from a WITH or FROM clause",
                          properties: [
                            {
                              // Table subqueries must also specify column names.
                              // This will get filled in automatically if the user does not specify them.
                              name: "columnNames",
                              value: "The list of names for each column that this table subquery provides",
                              type: "/__root__/definitions/object/list/idList"
                            },
                            {
                              name: "isRecursive",
                              value: "Has a value of TRUE if this subquery has been defined with the RECURSIVE keyword.",
                              type: "/__root__/definitions/object/valueObject/booleanObject"
                            },
                            {
                              // Add a constraint that children of a tableSubquery object must be
                              // some type of subqueryMarker
                              name: "__constraints", type: "/__root__/primitives/constraints", children: [
                              {
                                name: "childType",
                                type: "/__root__/primitives/constraints/childType",
                                children: [
                                  {
                                    name: "childTypeParam1",
                                    type: "/__root__/definitions/object/valueObject/stringObject",
                                    value: "/__root__/definitions/object/planObject/planMarker/subqueryMarker"
                                  }
                                ]
                              }]
                            }
                          ],
                        },
// Path: /__root__/definitions/object/planObject/planMarker/subqueryMarker/exprSubquery
                        {
                          name: "exprSubquery",
                          value: "Identifies a subquery emanating from an expression. It is basically a container for child table subqueries and a main subquery",
                          properties: [
                            {
                              // Add a constraint that children of a tableSubquery object must be
                              // some type of subqueryMarker
                              name: "__constraints", type: "/__root__/primitives/constraints", children: [
                              {
                                name: "childType",
                                type: "/__root__/primitives/constraints/childType",
                                children: [
                                  {
                                    name: "childTypeParam1",
                                    type: "/__root__/definitions/object/valueObject/stringObject",
                                    value: "/__root__/definitions/object/planObject/planMarker/subqueryMarker"
                                  }
                                ]
                              }]
                            }
                          ],
                        } // EndPath: /__root__/definitions/object/planObject/planMarker/subqueryMarker/exprSubquery
                      ]
                    }, // EndPath: /__root__/definitions/object/planObject/planMarker/subqueryMarker

                    // Path: /__root__/definitions/object/planObject/planMarker/statementMarker
                    {
                      name: "statementMarker",
                      value: "Marks the start of a logical query or subquery. It identifies the type of query.",
                      properties: [
                        {
                          name: "queryText",
                          value: "The string that the user entered",
                          type: "/__root__/definitions/object/valueObject/stringObject/nonNullableStringObject"
                        },
                        {
                          // Add a constraint that children of statementMarker objects must be planObjects
                          name: "__constraints", type: "/__root__/primitives/constraints", children: [
                          {
                            name: "childType",
                            type: "/__root__/primitives/constraints/childType",
                            children: [
                              {
                                name: "childTypeParam",
                                type: "/__root__/definitions/object/valueObject/stringObject",
                                value: "/__root__/definitions/object/planObject"
                              }
                            ]
                          }
                        ]}
                      ],
                      children: [

// Path: /__root__/definitions/object/planObject/planMarker/statementMarker/ddl
                        {
                          name: "ddl",
                          value: "A container of all DDL statement objects",
                          children: [
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/ddl/createTable
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/ddl/dropTable
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/ddl/createIndex
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/ddl/dropIndex
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/ddl/createTableAsSelect
                          ]
                        }, // EndPath: /__root__/definitions/object/planObject/planMarker/statementMarker/ddl

// Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dml
                        {
                          name: "dml",
                          value: "A container of all DML statementMarker objects",
                          children: [
// Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dml/explain
                            {
                              name: "explain",
                              value: "A marker for an EXPLAIN statement",
                              children: []
                            },
// Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dml/select
                            {
                              name: "select",
                              value: "A marker for a SELECT statement",
                              children: []
                            },
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dml/insert
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dml/update
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dml/delete
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dml/insertSelect
                          ]
                        }, // EndPath: /__root__/definitions/object/planObject/planMarker/statementMarker/dml

// Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dcl
                        {
                          name: "dcl",
                          value: "A container of all DCL statementMarker objects",
                          children: [
// TODO Path: /__root__/definitions/object/planObject/planMarker/statementMarker/dcl/xxxx
                          ]
                        } // EndPath: /__root__/definitions/object/planObject/planMarker/statementMarker/dcl
                      ]
                    }, // EndPath: /__root__/definitions/object/planObject/planMarker/statementMarker

                  ]
                }, // EndPath: /__root__/definitions/object/planObject/planMarker

// Path: /__root__/definitions/object/planObject/sqlOperator
                {
                  name: "sqlOperator",
                  value: "A container of all operators that process streams of data",
                  properties: [
                    {
                      // Add a constraint that all children of sqlOperator objects must also be planObjects
                      name: "__constraints", type: "/__root__/primitives/constraints", children: [
                      {
                        name: "childType",
                        type: "/__root__/primitives/constraints/childType",
                        children: [
                          {
                            name: "childTypeParam",
                            type: "/__root__/definitions/object/valueObject/stringObject",
                            value: "/__root__/definitions/object/planObject"
                          }
                        ]
                      }
                    ]}
                  ],
                  children: [

// Path: /__root__/definitions/object/planObject/sqlOperator/explainOp
                    {
                      name: "explainOp",
                      value: "An operator that outputs a description of the plan underneath",
                      properties: [
                        {
                          name: "format",
                          value: "How the explain output should be rendered",
                          type: "/__root__/definitions/object/valueObject/stringObject",
                        },
                        {
                          name: "stageRangeList",
                          value: "For which stages should an explain output be generated?",
                          type: "/__root__/definitions/object/list/stageRangeList"
                        },
                        {
                          name: "stageCount",
                          value: "A count of how many stages have been encountered",
                          type: "/__root__/definitions/object/valueObject/integerObject",
                        },
                        {
                          name: "stagesPast",
                          value: "A list of the names of stages that have been encountered",
                          type: "/__root__/definitions/object/list/stringList",
                        },
                        {
                          name: "withNames",
                          value: "If true then the names of sql operator nodes should be printed instead of their types",
                          type: "/__root__/definitions/object/valueObject/booleanObject",
                        },
                      ]
                    }, // EndPath: /__root__/definitions/object/planObject/sqlOperator/explainOp
// Path: /__root__/definitions/object/planObject/sqlOperator/projectOp
                    {
                      name: "projectOp",
                      value: "An operator that changes the definition of the rows that it processes",
                      properties: [
                        {
                          name: "projectedColumns",
                          value: "A list of expressions to be projected and their aliases",
                          type: "/__root__/definitions/object/list/projectedColumns",
                          children: []
                        }
                      ],
                      children: [
// Path: /__root__/definitions/object/planObject/sqlOperator/projectOp/aggregateOp
                        {
                          name: "aggregateOp",
                          value: "A subclass of projectOp that adds a group-by list for aggregate expressions",
                          properties: [
                            {
                              name: "groupBy",
                              value: "A list of expressions that the projectedColumns are to be grouped by",
                              type: "/__root__/definitions/object/list/exprList"
                            }
                          ],
                          children: []
                        } // EndPath: /__root__/definitions/object/planObject/sqlOperator/projectOp/aggregateOp
                      ]
                    }, // EndPath: /__root__/definitions/object/planObject/sqlOperator/projectOp

// Path: /__root__/definitions/object/planObject/sqlOperator/filterOp
                    {
                      name: "filterOp",
                      value: "An operator that filters out rows that do not meet an expression condition",
                      properties: [
                        {
                          name: "filterExpr",
                          value: "An expression to be evaluated against each input row",
                          type: "/__root__/definitions/object/expr"
                        }
                      ],
                      children: []
                    },

// Path: /__root__/definitions/object/planObject/sqlOperator/joinOp
                    {
                      name: "joinOp",
                      value: "Base definition of a join operation",
                      properties: [
                        {
                          name: "joinType",
                          value: "Is this an inner join, semi join, right outer join, etc",
                          type: "/__root__/definitions/types/joinType"
                        },
                        {
                          name: "joinPredicate",
                          value: "An expression that determines if a given left/right row are to be joined",
                          type: "/__root__/definitions/object/expr"
                        },
                        {
                          name: "usingList",
                          value: "A temporary and optional list of column names that will be turned into a join predicate during planning.",
                          type: "/__root__/definitions/object/list/stringList",
                          properties: [
                            { name: "__constraints", type: "/__root__/primitives/constraints", children: [
                              { name: "optional", type:  "/__root__/primitives/constraints/optional"},
                            ]}
                          ]
                        }
                      ],
                      children: [
