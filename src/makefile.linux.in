# Linux-specific makefile variables and rules.
#
# The intent is not to change a variable in the main makefile but to define
# variables such that the main makefile will include them for a given setting.
# E.g. if we need to add something to the CPPFLAGS variable then we define a
# variable here called LINUX_CPPFLAGS. The main makefile should have the common 
# settings for this variable and will then include $(LINUX_CPPFLAGS) as well as
# $(MACOS_CPPFLAGS), etc. Only one of these variables will be non-empty.

# Note that the assignments of some variables is sensitive to how it is done. e.g.:
#    =  will recursively expand any variables on the rhs when it is used.
#   :=  will expand any variables when the variable is defined.'
# Refer to the below url for details:
#  https://www.gnu.org/software/make/manual/html_node/Flavors.html#Flavors

# $(info $$MAKECMDGOALS is [${MAKECMDGOALS}])

IS_TGT_CLEAN := $(filter clean,${MAKECMDGOALS})
IS_TGT_CENTOS7DEBUG := $(filter centos7Debug,${MAKECMDGOALS})
IS_TGT_CENTOS7RELEASE := $(filter centos7Release,${MAKECMDGOALS})

CHECK_GCC_VER := $(or $(IS_TGT_CLEAN), $(IS_TGT_CENTOS7DEBUG), $(IS_TGT_CENTOS7RELEASE), checkGccVer)

# $(info $$IS_TGT_CLEAN is [${IS_TGT_CLEAN}])
# $(info $$IS_TGT_CENTOS7DEBUG is [${IS_TGT_CENTOS7DEBUG}])
# $(info $$IS_TGT_CENTOS7RELEASE is [${IS_TGT_CENTOS7RELEASE}])
# $(info $$CHECK_GCC_VER is [${CHECK_GCC_VER}])

ifeq ($(CHECK_GCC_VER),checkGccVer)
  # First check for gcc version 5 or later. This is needed by ANTLR.
  GCC_VERSION_GTE5 := $(shell echo `gcc -dumpversion | cut -f1-2 -d.` \>= 5 | bc)
  ifeq ($(GCC_VERSION_GTE5), 0)
    define ERR
gcc version 5 or later is required. You have v$(shell gcc -dumpversion).

To install gcc >5 on Centos7 run the following commands:
  sudo yum install libuuid-devel centos-release-scl devtoolset-8-gcc*

Then from the Source directory run the following command to build rapidsse:
  scl enable devtoolset-8 'make -j 8'


    endef
    $(error $(ERR))
  endif
endif

# Warnings flags that are specific to g++ on Linux
LINUX_WARNINGS := -Wfatal-errors     # Stop compiling when an error is encountered
LINUX_WARNINGS += -Wno-attributes    # Ignore function attributes that don't apply

# Specific error flags and warnings that are being promoted to errors on g++ on Linux
#LINUX_ERRORS := -Werror
LINUX_ERRORS :=
LINUX_ERRORS += -Werror=div-by-zero     # this is normally an 'extra' warning

# These errors can be removed once we turn on -Werror above.
LINUX_ERRORS := -Werror=return-type
LINUX_ERRORS += -Werror=unused-parameter
LINUX_ERRORS += -Werror=unused-but-set-variable
LINUX_ERRORS += -Werror=enum-compare
LINUX_ERRORS += -Werror=unused-label
LINUX_ERRORS += -Werror=uninitialized
LINUX_ERRORS += -Werror=varargs
LINUX_ERRORS += -Werror=parentheses
LINUX_ERRORS += -Werror=unused-value
LINUX_ERRORS += -Werror=deprecated-declarations
# LINUX_ERRORS += -Werror=array-bounds  # Not ready yet


# Warnings specific to linux that are to be ignored when compiling
# the code synthesizer fragment files.
LINUX_FRAGMENT_IGNORE_WARNINGS :=

# Warnings specific to linux that are to be ignored when compiling
# the ANTLR-generated tokeniser/parser files.
LINUX_ANTLR_IGNORE_WARNINGS := -Wno-attributes

LINUX_CPPFLAGS :=       -D__LINUX__
LINUX_CPPFLAGS_DEBUG := -D__LINUX__

LINUX_LDFLAGS := -rdynamic
LINUX_LDFLAGS_DEBUG := -rdynamic

# The name of the extension on a dynamic library / shared object
LINUX_LIBRARY_EXT := so

# Any additional linux-specific libraries to link in?
LINUX_LIBS := -lrt -latomic

# Any linux-specific library search paths to include?
LINUX_LIB_DIRS := 

