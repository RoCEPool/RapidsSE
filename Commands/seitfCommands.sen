/*============================================================================*/
/* seitfCommands.sen -- the set of commands from seitf                        */
/*============================================================================*/

"seitfCommands.sen" .

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

Connection Commands:

  con     connect
  dis     disconnect

Tenant Commands:

  mkten   create_tenant
  lsten   list_tenants
  rmten   drop_tenant

Catalog Commands:

  mkcat   create_catalog
  lscat   list_catalogs
  rmcat   drop_catalog

Schema Commands:

  mksch   create_schema
  lssch   list_schemas
  rmsch   drop_schema

Table Commands:

  mktbl   create_table
  lstbl   list_tables
  add     add_column
  lscol   list_columns
  ld      load_table
  sel     select_table
  dump    dump_table
  cp      copy_table
  ex      export_table
  sz      size_table
  tr      truncate_table
  rmtbl   drop_table

Dictionary Commands:

  cd      cd ..
          cd ~
          cd
  pwd     pwd
  ls      ls
  rmdic   drop_dictionary

Misc Commands:

  mon     get_monitor
  ping    ping
  x       x

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect
    "connected" success
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect
    "disconnected" success
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
: create_tenant

    checkInTenants not if exit then

    :dic dup ' tenant swap word.kind! execute {{
      "catalogs" :dic drop
    }}

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* get list of tenants                                                        */
/*----------------------------------------------------------------------------*/
: list_tenants

    checkInTenants not if exit then

    contents_string             // get contents of dic as a string

    success
;

/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
: drop_tenant ( "<tenantname>" -- "dropped tenant" 1 2 )

  find

  checkIsTenant not if exit then

  >forget

  "<ok>" success
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a catalog                                                           */
/*----------------------------------------------------------------------------*/
: create_catalog

    checkInCatalogs not if exit then

    :dic dup ' catalog swap word.kind! execute {{
      "schemas" :dic drop
    }}

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* get list of catalogs                                                       */
/*----------------------------------------------------------------------------*/
: list_catalogs

    checkInCatalogs not if exit then

    contents_string             // get contents of dic as a string
    success
;

/*----------------------------------------------------------------------------*/
/* drop a catalog                                                             */
/*----------------------------------------------------------------------------*/
: drop_catalog ( "<catalogname>" -- "dropped catalog" 1 2 )

    find

    checkIsCatalog not if exit then

    >forget

    "<ok>" success
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a schema                                                            */
/*----------------------------------------------------------------------------*/
: create_schema

    checkInSchemas not if exit then

    :dic dup ' schema swap word.kind! execute {{
      "tables" :dic drop
    }}

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* get list of schemas                                                        */
/*----------------------------------------------------------------------------*/
: list_schemas

    contents_string             // get contents of dic as a string
    success
;

/*----------------------------------------------------------------------------*/
/* drop a schema                                                              */
/*----------------------------------------------------------------------------*/
: drop_schema ( "<schemaname>" -- "dropped schema" 1 2 )

    find

    checkIsSchema not if exit then

    >forget

    "<ok>" success
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table

    checkInTables not if exit then

    :table execute createColumnsDic drop

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables

    checkInTables not if exit then

    contents_string             // get contents of dic as a string
    success
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "filename" "tablename" )

    //freespace .

    find

    checkIsTable not if exit then

    execute ( "filename" table )

    tableLoader

    //freespace .

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "filename" "tablename" )

    find

    checkIsTable not if exit then

    execute ( "filename" table )

    tableExporter

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- "text" n 2 )

    find

    checkIsTable not if exit then

    execute        ( "<to-tableNm>" ^fromTable )

    swap           ( ^fromTable "<to-tableNm>" )

    :table execute ( ^fromTable ^toTable )

//    swap           ( ^toTable ^fromTable )

    tableCopier

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dump_table ( "<tableNm>" )

  find

  checkIsTable not if exit then

  execute ( table )

  rowDump

  "<ok>" success

;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "tablename" )

    find

    checkIsTable not if exit then

    execute ( table )

    table.space
    >str success
;

/*----------------------------------------------------------------------------*/
/* get row cursor for table                                                   */
/*----------------------------------------------------------------------------*/
: select_table ( "tablename" )

traceon

    find

    checkIsTable not if traceoff exit then

    queryCount ++

    execute ( table )

    rowcursor.new dup rot rowcursor.table!

    >str

    success

traceoff
;

/*----------------------------------------------------------------------------*/
/* get address of table                                                       */
/*----------------------------------------------------------------------------*/
: address_table ( "tablename" )

    find

    checkIsTable not if exit then

    execute ( table )

    >str success
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "tablename" )

    find

    checkIsTable not if exit then

    execute ( table )

    table.truncate

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tablename>" -- "dropped table" 1 2 )

    find

    checkIsTable not if exit then

    dup execute table.truncate

    >forget

    "<ok>" success
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column ( "<columnType>" "<columnName" "<tableName>" -- <response> )

    checkInTables not if exit then

    pushTable not if exit then

    pushColumns not if exit then

    addColumn not if exit then

    popColumns

    popTable

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<tableName>" -- <response> )

    checkInTables not if exit then

    pushTable not if exit then

    pushColumns not if exit then

    listColumns

    popColumns

    popTable

    success
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* change dictionary                                                          */
/*----------------------------------------------------------------------------*/
: cd

    dup ".." streql if
      drop
      dic.drop
    else
      dup "~" streql if
        drop
        begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
      else
        dup "tenants" streql if
          begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
          find
          checkIsKnown not if exit then
          execute dic.push
        else
          find
          checkIsKnown not if exit then
          execute dic.push
        then
      then
    then

    "<ok>" success
;

/*----------------------------------------------------------------------------*/
/* print working dictionary                                                   */
/*----------------------------------------------------------------------------*/
: pwd

    "/"
    dic.count 0 do
      dic.count 1 - I -
      dic.pick dic.name concat
      "/" concat
    loop

    success
;

/*----------------------------------------------------------------------------*/
/* list dictionary contents                                                   */
/*----------------------------------------------------------------------------*/
: ls

    ""
    word.this dup iterate

      dup strlen if "\n" concat then

      object@ word.name 12 strpad concat

      "(" concat
      object@ word.kind@ word.name concat

      object@ isTable if
        " " concat
        object@ execute table.space >str concat " bytes" concat
      then
      ")" concat

      object@ prevWord object!

    next
    success
;

/*----------------------------------------------------------------------------*/
/* drop a dictionary                                                          */
/*----------------------------------------------------------------------------*/
: drop_dictionary ( "<dicname>" -- "dropped dictionary" 1 2 )

    find

    checkIsDic not if exit then

    >forget

    "<ok>" success
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* get monitor string                                                         */
/*----------------------------------------------------------------------------*/
: get_monitor
    monitorString@ success
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping
    "pong" success
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x
    words
    "x" success
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/