/*============================================================================*/
/* task.sen -- task related words                                             */
/*============================================================================*/

"task.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create a task using string from input stream as name                       */
/*----------------------------------------------------------------------------*/

: task:

  create
  object!!
  sizeof_task allot
  word.this >body magic!!
  word.this >body CN_TASK class!
  word.this >body task.init
  word.this >body object.wordbody
  does>
;

: :task

  >create
  object!!
  sizeof_task allot
  word.this >body magic!!
  word.this >body CN_TASK class!
  word.this >body task.init
  word.this >body object.wordbody
  word.this
  does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
