/*============================================================================*/
/* connectorTask.sen -- connector task                                        */
/*============================================================================*/

"connectorTask.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

task:    con.task
queue:   con.queue
taskset: con.taskset
thread:  con.thread

/*----------------------------------------------------------------------------*/
/* start the connector task                                                   */
/*----------------------------------------------------------------------------*/
: connectorStart

tp: connectorStart

/*
  // set up connector task
  0 "con.loop" nullPtr task.new con.taskset taskSet.append

  // set up the connector thread
  con.taskset  con.thread thread.taskset!
  "connectorThread" con.thread thread.name!
                    con.thread thread.spawn
*/

  0 "con.loop" con.task con.queue con.taskset con.thread actorInterlink
;

/*----------------------------------------------------------------------------*/
/* connector loop                                                             */
/*----------------------------------------------------------------------------*/
: con.loop

  "renaming to Connector Task" .putVerbose

  "connectorTask" task.this task.name!

  con.queue  task.this task.queue!

  connectorTaskPrint if "Connector running..." . then

  //10 thread.sleep_s

  args.nodes 0 do

    I args.node == if
      nullptr I senderQueue !

    else

      args.port I +
      "127.0.0.1"
      socket.open  socket.connect

      args.verbose if
        "Node" args.node >str concat
        " connected to node" concat
        I >str concat
        .
      then

      // start sender
      //"starting sender" .
ddlLock.grabWrite

      1 "snd.loop" "sr" I >str concat actorForm

      I senderQueue !
ddlLock.dropWrite

    then

  loop

  //1000000 thread.sleep_s

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
