/*============================================================================*/
/* connectorTask.sen -- connector task                                        */
/*============================================================================*/

"connectorTask.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* define the con actor (con.task, con.queue, con.taskset, con.thread)        */
/*----------------------------------------------------------------------------*/
actor: con

/*----------------------------------------------------------------------------*/
/* start the connector task                                                   */
/*----------------------------------------------------------------------------*/
: connectorStart

tp: connectorStart

  0 "con.loop"

  "con" actor.spawn
;

/*----------------------------------------------------------------------------*/
/* connector loop                                                             */
/*----------------------------------------------------------------------------*/
: con.loop

  connectorTaskPrint if "Connector running..." . then

  args.nodes 0 do

    I args.node == if
      nullptr I senderQueue !

    else

      args.port I +
      "127.0.0.1"
      socket.open  socket.connect

      args.verbose if
        "Node" args.node >str concat
        " connected to node" concat
        I >str concat
        .
      then

      // start sender
      //"starting sender" .
ddlLock.grabWrite

      1 "snd.loop" "sr" I >str concat actorForm

      I senderQueue !
ddlLock.dropWrite

    then

  loop

  1000000 thread.sleep_s
  1000000 thread.sleep_s
  1000000 thread.sleep_s
  1000000 thread.sleep_s
  1000000 thread.sleep_s

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
