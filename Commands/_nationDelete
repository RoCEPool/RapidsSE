	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);

create index nation_idx1 ON nation(N_NationKey);
load nation "/DATA/TPCH/nation.csv" ;

tableScan nation;

print "------------------";
