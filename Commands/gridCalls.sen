/*============================================================================*/
/* gridCalls -- grid calls                                                    */
/*============================================================================*/

"gridCalls" .putVerbose

/*----------------------------------------------------------------------------*/
/* create the grid actors C, PP, CP and P                                     */
/*----------------------------------------------------------------------------*/
: createGridActors

  /*

    r->C->PP-> (snd ... rcv) ->CP->P
       |
       +->P

  */

  args.nodes 0 do

    //
    // participant for node I
    //

    0 "p.loop"

    "p" I >str concat :actor
    dup actor.queue I pQueues !
    actor.spawn

    //
    // coordinator proxy for node I
    //

    I I pQueues @ 2 "cp.loop"
    "cp" I >str concat :actor
    dup actor.queue I cpQueues !
    actor.spawn

    //
    // partitipant proxy for node I
    //

    I args.node == if
      I I pQueues  @ 2 "pp.loop"
      "pp" I >str concat :actor
      dup actor.queue I ppQueues !
      actor.spawn
    else
      I I cpQueues @ 2 "pp.loop"
      "pp" I >str concat :actor
      dup actor.queue I ppQueues !
      actor.spawn
    then

  loop

  //
  // coordinator for this node
  //
  0 "c.loop"
  "c" :actor  ( 0 "c.loop" "c" )

  actor.spawn

  args.verbose if
    cpQueuesDump
  then
;

////////////////////////////////////////////////////////////////////////////////

createGridActors

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* queue an indirect call set to the coordinator and wait for indirect result */
/*----------------------------------------------------------------------------*/
: >coordinator> ( <<call*>> -- <<result>> )

tp: >coordinator>

/*
  // could be task such as req.task or ld#.task

  addCaller ( << <<call*>> <<caller>> >> )
*/

  // target queue is c.queue
  c.queue >queue> ( <<result>> )

tp: resumedbyCoord

  // we expect an indirect result
;

/*----------------------------------------------------------------------------*/
/* get coordinator to send indirect call to each participant to execute       */
/*----------------------------------------------------------------------------*/
: >>participants> ( <<$$>> -- bool )

  // a) we are in request task (req.task)
  // b) indirect call on stack is to be executed by all participants

tp: >>participants>

  task.this task.name@ "req.task" streql assert

  // add current dic path of this req.task
  addDicPath ( << <<$$>> <<dicStack!>> >> )

  // add indirect call to participants
  addParticipants ( << <<$$>> <<dicStack!>> <<>participants>>> >> )

  addCaller

  // queue on coordinator (which waits for a indirect result)
  >coordinator> ( bool )

  valset>

  // drop number of values
  drop

  // we should have a true result
  //assert

  // return true
  //true
;

/*----------------------------------------------------------------------------*/
/* get coordinator to send indirect call to participant on a node to execute  */
/*----------------------------------------------------------------------------*/
: >>participant> ( <<$$>> nodeNo -- bool )

  // a) we are in loader sub task
  // b) indirect call on stack is to be executed by participant on given nodeNo

tp: >>participant>

  // assert we are in loader subtask
  task.this task.name@ 2 0 substr "sl" streql assert

  // save the node number
  >r

  // add current dic path of this req.task
  addDicPath ( << <<$$>> <<dicStack!>> >> )

  // add indirect call to participant on given node
  r> addParticipant ( << <<$$>> <<dicStack!>> <<>participant>>> >> )

  addCaller

  // queue on coordinator (which waits for a indirect result)
  >coordinator> ( bool )

  // we should have a true result
  //assert

  // return true
  true
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
