// TPC-H Demo Setup.
//
// This script prepares RapidsSE for executing the TPC-H demo queries in the
// script file _demoQueries. 
//
// Please modify this file to specify the locations of the data to be loaded
// for each of the LINEITEM, ORDERS and CUSTOMER tables. Refer to the "dload"
// commands below.
//
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "" ;
print "Creating TPC-H Tables" ;
print "" ;

/time create table customer (
   C_CUSTKEY       INTEGER       NOT NULL,  // 0)
   C_NAME          VARCHAR(25)   NOT NULL,  // 1)
   C_ADDRESS       VARCHAR(40)   NOT NULL,  // 2)
   C_NATIONKEY     INTEGER       NOT NULL,  // 3)
   C_PHONE         CHAR(15)      NOT NULL,  // 4)
   C_ACCTBAL       DECIMAL(15,2) NOT NULL,  // 5)
   C_MKTSEGMENT    CHAR(10)      NOT NULL,  // 6)
   C_COMMENT       VARCHAR(117)  NOT NULL   // 7)
);

/time create index customer_idx1 ON customer(C_CUSTKEY);

/time create table orders (
   O_ORDERKEY        INTEGER       NOT NULL,  // 0)
   O_CUSTKEY         INTEGER       NOT NULL,  // 1)
   O_ORDERSTATUS     CHAR(1)       NOT NULL,  // 2)
   O_TOTALPRICE      DECIMAL(15,2) NOT NULL,  // 3)
   O_ORDERDATE       DATE          NOT NULL,  // 4)
   O_ORDERPRIORITY   CHAR(15)      NOT NULL,  // 5)
   O_CLERK           CHAR(15)      NOT NULL,  // 6)
   O_SHIPPRIORITY    INTEGER       NOT NULL,  // 7)
   O_COMMENT         VARCHAR(79)   NOT NULL   // 8)
) partition by (O_CUSTKEY) ;

/time create index orders_idx1 ON orders(O_CUSTKEY);
/time create index orders_idx2 ON orders(O_ORDERKEY);


/time create table lineitem (
  L_ORDERKEY      INTEGER       NOT NULL,
  L_PARTKEY       INTEGER       NOT NULL,
  L_SUPPKEY       INTEGER       NOT NULL,
  L_LINENUMBER    INTEGER       NOT NULL,
  L_QUANTITY      DECIMAL(15,2) NOT NULL,
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,
  L_TAX           DECIMAL(15,2) NOT NULL,
  L_RETURNFLAG    CHAR(1)       NOT NULL,
  L_LINESTATUS    CHAR(1)       NOT NULL,
  L_SHIPDATE      DATE NOT      NULL,
  L_COMMITDATE    DATE NOT      NULL,
  L_RECEIPTDATE   DATE NOT      NULL,
  L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
  L_SHIPMODE      CHAR(10)      NOT NULL,
  L_COMMENT       VARCHAR(44)   NOT NULL
);

/time create index lineitem_idx1 on lineitem (l_shipdate) ;
/time create index lineitem_idx2 on lineitem (l_orderkey) ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "" ;
print "Loading table: LINEITEM" ;

/time dload lineitem paths
  "/mnt/disk1/tpch/sf1000/lineitem.tbl"
  "/mnt/disk2/tpch/sf1000/lineitem.tbl"
  "/mnt/disk3/tpch/sf1000/lineitem.tbl"
  "/mnt/disk4/tpch/sf1000/lineitem.tbl"
;

print "" ;
print "Compacting indexes: LINEITEM" ;

/time compact index lineItem lineitem_idx1 ;
/time compact index lineItem lineitem_idx2 ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "" ;
print "Loading table: ORDERS" ;

/time dload orders paths
  "/mnt/disk1/tpch/sf1000/orders.tbl"
  "/mnt/disk2/tpch/sf1000/orders.tbl"
  "/mnt/disk3/tpch/sf1000/orders.tbl"
  "/mnt/disk4/tpch/sf1000/orders.tbl"
;

print "" ;
print "Compacting indexes: ORDERS" ;

/time compact index orders orders_idx1 ;
/time compact index orders orders_idx2 ;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "" ;
print "Loading table: CUSTOMER" ;

/time dload customer paths
  "/mnt/disk1/tpch/sf1000/customer.tbl"
  "/mnt/disk2/tpch/sf1000/customer.tbl"
  "/mnt/disk3/tpch/sf1000/customer.tbl"
  "/mnt/disk4/tpch/sf1000/customer.tbl"
;

print "" ;
print "Compacting indexes: CUSTOMER" ;

/time compact index customer customer_idx1 ;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "" ;
print "" ;
print "All data loaded for TPC-H queries" ;
print "" ;




