am "Running script: _ids";

print "";
print "---------------------------------------------------------------------";
print "starting the cluster...";
print "---------------------------------------------------------------------";
startCluster;

print "";
print "---------------------------------------------------------------------";
print "creating sensorEvents table...";
print "---------------------------------------------------------------------";
_sensorEvents;

print "";
print "---------------------------------------------------------------------";
print "removing the pipe...";
print "---------------------------------------------------------------------";
rmpipe "/tmp/sensorEvents.rowAgg";
rmpipe "/tmp/sensorEvents.pipe";

print "";
print "---------------------------------------------------------------------";
print "making the pipe...";
print "---------------------------------------------------------------------";
mkpipe "/tmp/sensorEvents.rowAgg";
mkpipe "/tmp/sensorEvents.pipe";

print "";
print "---------------------------------------------------------------------";
print "ingesting sensoreEvents table...";
print "---------------------------------------------------------------------";

nowait monitor;

nowait purge sensorEvents 30;

nowait publish sensorEvents "/tmp/sensorEvents.rowAgg" ;

nowait report sensorEvents "/tmp/sensorEvents.rowAgg" ;

nowait repeater "/rapids/sensorEvents.csv" "/tmp/sensorEvents.pipe" ;

nowait ingest sensorEvents "/tmp/sensorEvents.pipe" stats ;

