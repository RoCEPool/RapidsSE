/*============================================================================*/
/* loader.sen -- Parallel Table Loader                                        */
/*============================================================================*/

"loader.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create a loader using name on the stack (leaves loader on stack)           */
/*----------------------------------------------------------------------------*/

: :loader
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader.init
    word.this
    does>
;

: :loaderSub
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADERSUB class!
    word.this >body loaderSub.init
    word.this
    does>
;

/*----------------------------------------------------------------------------*/
/* form loaderSubNm                                                           */
/*----------------------------------------------------------------------------*/
: >loadSubNm ( i -- s )

  "loadSub_" swap >str concat
;

/*----------------------------------------------------------------------------*/
/* distributable form of table.appendBuffer                                   */
/*----------------------------------------------------------------------------*/
: ~loadAppendBuffer

  valset> drop dicStack! assert dic.stack

  valset> drop ( rowBuffer partition# tableNm )

stk

  find execute dup table.name .

  table.appendBuffer
;

/*----------------------------------------------------------------------------*/
/* parallel sub-loading of file into table                                    */
/*----------------------------------------------------------------------------*/
/*
: loadSub ( ^LoaderSub -- )
//traceOn

  reg.push

  >reg0

  loaderSub.begin

  begin
    loaderSub.fetchrecord if
      loaderSub.hashRecord
      loaderSub.insertrow
    else
      false
    then
    while
  repeat

  loaderSub.end

  loaderSub.completed if signalParentThread then

  reg.pop

//traceOff
;
*/
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: loadSub ( ^loaderSub -- )

  valset> drop dicStack! assert

  valset> drop

  reg.push

  >reg0

  loaderSub.begin

  begin

    // fetch next record from file
    loaderSub.fetchRecord

    if
      // hash the record to get partition
      loaderSub.hashRecord

      // attempt to insert row into working buffer
      loaderSub.insertRow?

      // was buffer full?
      not if
        // append buffer to table
        $$
        loaderSub.partition loaderSub.rowBuffer
        loaderSub.partition
        loaderSub.table table.name
//stk
        //table.appendBuffer

        $$>valset

        // dic path
        seitf.path@
        $$>valset

        ~loadAppendBuffer

        // insert row into new working buffer
        loaderSub.insertRow? assert
      then
      true
    else
      false
    then

  while repeat

  // check for dangling buffers
  args.partitions 0 do
    I loaderSub.rowBuffer
    dup
    if
      $$ swap
      I
      loaderSub.table table.name

      $$>valset

      // dic path
      seitf.path@
      $$>valset

      ~loadAppendBuffer
    else
      drop
    then

  loop

  // tidyup
  loaderSub.end

  // this sub has completed
  loaderSub.completed
  if
    signalParentThread
  then

  reg.pop

//traceOff
;

/*----------------------------------------------------------------------------*/
/* parallel loading of file into table                                        */
/*----------------------------------------------------------------------------*/

timer: loadTimer

: tableLoader ( "<path>" "<tableNm>" -- t|f )

  find execute ( "filename" table )

  // check if path file exists
  swap file.new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  loadTimer timer.start

  // create a Loader
  "__table_loader" find dup if else
    drop
    "__table_loader" :loader
  then
  execute

  // put Loader into register 0
  >r
  // r0 ^Loader

  // initialise r0:Loader
  r0 loader.table!
  r0 loader.path!

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // open the file to be loaded
//r0 loader.openFile not if "file not opened" . rdrop exit then

  // begin a new transaction
  beginTransaction r0 loader.txref!

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  grabThreadMutex

  N_GENERAL_THREADS r0 loader.subs!

  N_GENERAL_THREADS 0 do

//traceon
    $$ r2 loader.newSub $$>valset

    seitf.path@ $$>valset

    1 "loadSub" task.this task.new

    dup I >loadSubNm swap task.name!

    I >genTaskSet taskSet.append
  loop

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin r0 loader.findChunk while repeat


  threadCondWait
  dropThreadMutex

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // commit the transaction
  commitTransaction

  // discard r0:Loader
  rdrop

  // destroy Loader
  "__table_loader" find >forget

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  true

//traceoff
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream ( "<path>" ^table -- t|f )

  // check if path file exists
  swap file.new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

stk

  reg.push

  file.new >reg0         // reg0 - file
  >reg1                  // reg1 - table
  >reg2                  // reg2 - path
  rowBuffer.new >reg3    // reg3 - rowbuffer
  beginTransaction >reg4 // reg4 - txref
  0 >regF                // regF - counter

  reg2 reg0 file.path!
  OPEN_READ reg0 file.open drop

  loadTimer timer.start

  begin
    reg0 file.read
    while
      reg4 reg3 rowbuffer.append
      not if
        reg3 0 reg1 table.appendBuffer
        rowBuffer.new >reg3
        reg4 reg3 rowbuffer.append
        drop
      then

      regF inc dup >regF
      100000 % not if regF . then
  repeat

  reg3 0 reg1 table.appendBuffer

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  reg0 file.close

  reg0 file.delete

  reg.pop

  true

stk
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream2 ( "<path>" ^table -- t|f )

  find execute ( "filename" table )

  // check if path file exists
  swap file.new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  stk

  reg.push

  file.new >reg0         // reg0 - file
  >reg1                  // reg1 - table
  >reg2                  // reg2 - path
  rowBuffer.new >reg3    // reg3 - rowbuffer
  beginTransaction >reg4 // reg4 - txref
  0 >regF                // regF - counter

  reg2 reg0 file.path!
  OPEN_READ reg0 file.open drop

  loadTimer timer.start

  begin
    reg0 file.readRecord
    while
      reg0 reg4 reg3 rowbuffer.appendRecord
      not if
        reg3 0 reg1 table.appendBuffer
        rowBuffer.new >reg3
        reg0 reg4 reg3 rowbuffer.appendRecord
        drop
      then

      regF inc dup >regF
      100000 % not if task.yield then
  repeat

  reg3 0 reg1 table.appendBuffer

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  reg0 file.close

  reg0 file.delete

  reg.pop

  true

  stk
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* a bit of rowbuffer testing                                                 */
/*----------------------------------------------------------------------------*/
: rbTest

  checkInTables assert

  "j10" ( "<tableNm" )

  checkIsTable assert ( "<tableNm" )

  find execute ( table )

  "__row_cursor" :rowCursor execute ( table rowCursor )

  tuck rowCursor.table! ( table )

  dup rowCursor.first drop

  rowCursor.rowBuffer

tp: rowBuffer

  $$ swap

tp: marker

  $$>valset

tp: valset

  valset>

tp: values

  drop drop assert.stack_0

  "__row_cursor" find >forget
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
