/*============================================================================*/
/* loader.sen -- Table Loader                                                 */
/*============================================================================*/

"loader.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create a loader using name from input stream (doesnt leave loader on stk)  */
/*----------------------------------------------------------------------------*/
: loader:
    create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader.init
    does>
;

: loader3:
    create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader3.init
    does>
;

: loader3Sub:
  create
  object!!
  sizeof_loader allot
  word.this >body magic!!
  word.this >body CN_LOADERSUB class!
  word.this >body loader3Sub.init
  does>
;

/*----------------------------------------------------------------------------*/
/* create a loader using name on the stack (leaves loader on stack)           */
/*----------------------------------------------------------------------------*/
: :loader
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader.init
    word.this
    does>
;

: :loader3
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader3.init
    word.this
    does>
;

: :loader3Sub
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADERSUB class!
    word.this >body loader3Sub.init
    word.this
    does>
;

/*----------------------------------------------------------------------------*/
/* calculate partition number of row                                          */
/*----------------------------------------------------------------------------*/
: toPartition ( ^row -- i )
//traceon

    csv.firstvalue

    hash

    partitions %

//traceoff
;

/*----------------------------------------------------------------------------*/
/* load file into table                                                       */
/*----------------------------------------------------------------------------*/
: load ( "<path>" ^table -- t|f )
//traceon

//childTest_call

    // create a Loader
    "__table_loader" find dup if else
      drop
      "__table_loader" :loader
    then
    execute

    // put Loader into register 0
    >r
    // r0 ^Loader

    // initialise r0:Loader
    r0 loader.table!
    r0 loader.path!

    // open the file to be loaded
    r0 loader.openFile not if "file not opened" . rdrop false exit then

    // begin a new transaction
    beginTransaction r0 loader.txref!

    // loader loop
    r0 loader.begin
    begin
      r0 loader.fetchrecord
      while
        r0 loader.pushRecord toPartition
        r0 loader.insertrow  drop
    repeat
    r0 loader.end

    // commit the transaction
    commitTransaction

    r0 loader.closeFile

    // discard r0:Loader
    rdrop

    // destroy Loader
    "__table_loader" find >forget

    // successful load
    true

//traceoff
;

/*----------------------------------------------------------------------------*/
/* grab this threads mutex                                                    */
/*----------------------------------------------------------------------------*/
: grabThreadMutex task.this task.thread thread.mutexLock ;

/*----------------------------------------------------------------------------*/
/* drop this threads mutex                                                    */
/*----------------------------------------------------------------------------*/
: dropThreadMutex task.this task.thread thread.mutexUnlock ;

/*----------------------------------------------------------------------------*/
/* wait on this threads cond variable                                         */
/*----------------------------------------------------------------------------*/
: threadCondWait task.this task.thread thread.condWait ;

/*----------------------------------------------------------------------------*/
/* signal parent thread                                                       */
/*----------------------------------------------------------------------------*/
: signalParentThread task.parent@ task.thread thread.condSignal ;

/*----------------------------------------------------------------------------*/
/* spawn load3Sub                                                             */
/*----------------------------------------------------------------------------*/
: spawnLoad3Sub_0

  1 "load3Sub" task.this task.new

  dup "load3Sub_0" swap task.name!

  0 >genTaskSet taskSet.append
;

: spawnLoad3Sub_1

  1 "load3Sub" task.this task.new

  dup "load3Sub_1" swap task.name!

  1 >genTaskSet taskSet.append
;

: spawnLoad3Sub_2

  1 "load3Sub" task.this task.new

  dup "load3Sub_2" swap task.name!

  2 >genTaskSet taskSet.append
;

: spawnLoad3Sub_3

  1 "load3Sub" task.this task.new

  dup "load3Sub_3" swap task.name!

  3 >genTaskSet taskSet.append
;

: spawnLoad3Sub_4

  1 "load3Sub" task.this task.new

  dup "load3Sub_4" swap task.name!

  4 >genTaskSet taskSet.append
;

: spawnLoad3Sub_5

  1 "load3Sub" task.this task.new

  dup "load3Sub_5" swap task.name!

  5 >genTaskSet taskSet.append
;

/*----------------------------------------------------------------------------*/
/* parallel sub-loading of file into table                                    */
/*----------------------------------------------------------------------------*/
: load3Sub ( ^Loader3Sub )
//traceOn

  >r
  // r0 ^Loader3Sub

  r0 loader3Sub.begin

  begin
    r0 loader3Sub.fetchrecord
    while
      r0 loader3Sub.pushRecord toPartition
      r0 loader3Sub.insertrow  drop
  repeat

  r0 loader3Sub.end

  r0 loader3Sub.completed if signalParentThread then

  rdrop

//traceOff
;

/*----------------------------------------------------------------------------*/
/* parallel loading of file into table                                        */
/*----------------------------------------------------------------------------*/
: load3 ( "<path>" ^table -- t|f )
//traceon

  // create a Loader
  "__table_loader3" find dup if else
    drop
    "__table_loader3" :loader3
  then
  execute

  // put Loader into register 0
  >r
  // r0 ^Loader3

  // initialise r0:Loader
  r0 loader3.table!
  r0 loader3.path!

  // open the file to be loaded
  r0 loader3.openFile not if "file not opened" . rdrop false exit then

  // begin a new transaction
  beginTransaction r0 loader3.txref!

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //load3Sub

  grabThreadMutex

  2 r0 loader3.subs!

  r0 loader3.newSub spawnLoad3Sub_0
  r0 loader3.newSub spawnLoad3Sub_1
//r0 loader3.newSub spawnLoad3Sub_2
//r0 loader3.newSub spawnLoad3Sub_3
//r0 loader3.newSub spawnLoad3Sub_4
//r0 loader3.newSub spawnLoad3Sub_5

  threadCondWait
  dropThreadMutex

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // commit the transaction
  commitTransaction

  // close the file
  r0 loader3.closeFile

  // discard r0:Loader3
  rdrop

  // destroy Loader
  "__table_loader3" find >forget

//traceoff
;

/*----------------------------------------------------------------------------*/
/* table loader (can probably be removed)                                     */
/*----------------------------------------------------------------------------*/
: tableLoader ( "<fileNm>" ^table )

  load3
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/