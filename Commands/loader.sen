/*============================================================================*/
/* loader.sen -- Table Loader                                                 */
/*============================================================================*/

"loader.sen" .

/*----------------------------------------------------------------------------*/
/* create a loader using name from input stream (doesnt leave loader on stk)  */
/*----------------------------------------------------------------------------*/
: loader:
    create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader.init
    does>
;

/*----------------------------------------------------------------------------*/
/* create a loader using name on the stack (leaves loader on stack)           */
/*----------------------------------------------------------------------------*/
: :loader
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader.init
    word.this
    does>
;

: toPartition

traceon
    csv.firstvalue

    hash

    partitions %

traceoff
;

: load ( "<path>" ^table -- t|f )
//traceon

    "Table_Loader" find dup if else
      drop
      "Table_Loader" :loader
    then
    execute

    >r

    0 rpick loader.table!
    0 rpick loader.path!
    0 rpick loader.openFile not if "file not opened" . rdrop false exit then
    0 rpick loader.begin
    begin
      0 rpick loader.fetchrecord
      while
        0 rpick loader.pushRecord toPartition
        0 rpick loader.insertrow drop
    repeat
    0 rpick loader.end
    0 rpick loader.closeFile
    rdrop

    true

//traceoff
;

: loadtest

traceon
    // "/tpch/lineitem.tbl"
    "/tpch/nation.tbl"
    "nation" :table execute

   load if "loaded!" . else . then
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/