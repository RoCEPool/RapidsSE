/*============================================================================*/
/* loader.sen -- Parallel Table Loader                                        */
/*============================================================================*/

"loader.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create a loader using name on the stack (leaves loader on stack)           */
/*----------------------------------------------------------------------------*/

: :loader
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader.init
    word.this
    does>
;

: :loaderSub
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADERSUB class!
    word.this >body loaderSub.init
    word.this
    does>
;

/*----------------------------------------------------------------------------*/
/* parallel sub-loading of file into table                                    */
/*----------------------------------------------------------------------------*/

: >loadSubNm ( i -- s ) "loadSub_" swap >str concat ;

: loadSub ( ^LoaderSub )
//traceOn

  reg.push

  >reg0

  loaderSub.begin

  begin
    loaderSub.fetchrecord if
      loaderSub.hashRecord
      loaderSub.insertrow
    else
      false
    then
    while
  repeat

  loaderSub.end

  loaderSub.completed if signalParentThread then

  reg.pop

//traceOff
;

/*----------------------------------------------------------------------------*/
/* parallel loading of file into table                                        */
/*----------------------------------------------------------------------------*/

timer: loadTimer

: tableLoader ( "<path>" ^table -- t|f )

  // check if path file exists
  swap file.new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  loadTimer timer.start

  // create a Loader
  "__table_loader" find dup if else
    drop
    "__table_loader" :loader
  then
  execute

  // put Loader into register 0
  >r
  // r0 ^Loader

  // initialise r0:Loader
  r0 loader.table!
  r0 loader.path!

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // open the file to be loaded
//r0 loader.openFile not if "file not opened" . rdrop exit then

  // begin a new transaction
  beginTransaction r0 loader.txref!

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  grabThreadMutex

  N_GENERAL_THREADS r0 loader.subs!

  N_GENERAL_THREADS 0 do

    r2 loader.newSub 1 "loadSub" task.this task.new

    dup I >loadSubNm swap task.name!

    I >genTaskSet taskSet.append
  loop

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin r0 loader.findChunk while repeat


  threadCondWait
  dropThreadMutex

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // commit the transaction
  commitTransaction

  // discard r0:Loader
  rdrop

  // destroy Loader
  "__table_loader" find >forget

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  true

//traceoff
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream ( "<path>" ^table -- t|f )

  // check if path file exists
  swap file.new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  loadTimer timer.start

  drop drop ( ^table "<path>" -- )

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  true

stk
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
