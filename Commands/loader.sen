/*============================================================================*/
/* loader.sen -- Table Loader                                                 */
/*============================================================================*/

"loader.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create a loader using name from input stream (doesnt leave loader on stk)  */
/*----------------------------------------------------------------------------*/
: loader:
    create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader.init
    does>
;

/*----------------------------------------------------------------------------*/
/* create a loader using name on the stack (leaves loader on stack)           */
/*----------------------------------------------------------------------------*/
: :loader
    >create
    object!!
    sizeof_loader allot
    word.this >body magic!!
    word.this >body CN_LOADER class!
    word.this >body loader.init
    word.this
    does>
;

/*----------------------------------------------------------------------------*/
/* calculate partition number of row                                          */
/*----------------------------------------------------------------------------*/
: toPartition ( ^row -- i )
//traceon

    csv.firstvalue

    hash

    partitions %

//traceoff
;

/*----------------------------------------------------------------------------*/
/* load file into table                                                       */
/*----------------------------------------------------------------------------*/
: load ( "<path>" ^table -- t|f )
//traceon

//childTest_call

    // create a Loader
    "__table_loader" find dup if else
      drop
      "__table_loader" :loader
    then
    execute

    // put Loader into register 0
    >r
    // r0 ^Loader

    // initialise r0:Loader
    r0 loader.table!
    r0 loader.path!

    // open the file to be loaded
    r0 loader.openFile not if "file not opened" . rdrop false exit then

    // begin a new transaction
    beginTransaction r0 loader.txref!

    // loader loop
    r0 loader.begin
    begin
      r0 loader.fetchrecord
      while
        r0 loader.pushRecord toPartition
        r0 loader.insertrow  drop
    repeat
    r0 loader.end

    // commit the transaction
    commitTransaction

    r0 loader.closeFile

    // discard r0:Loader
    rdrop

    // destroy Loader
    "__table_loader" find >forget

    // successful load
    true

//traceoff
;

/*----------------------------------------------------------------------------*/
/* child loading                                                              */
/*----------------------------------------------------------------------------*/
: loadByChild
  //traceOn

  // grab mutex lock of request thread
  task.this task.thread thread.mutexLock

  // creates the child task

  2 "loadLoop_child0" task.this task.new dup "loadChild0" swap task.name!
  generalTaskSet0 taskSet.append

  task.this task.thread thread.condWait

  task.this task.thread thread.mutexUnlock

//traceOff
;

: loadChild1

  // grab mutex lock of request thread
  task.this task.thread thread.mutexLock

  // creates the child task

  0 "loadLoop_child1" task.this task.new dup "loadChild1" swap task.name!
  generalTaskSet1 taskSet.append

  task.this task.thread thread.condWait

  task.this task.thread thread.mutexUnlock
;

: loadLoop_child0

  "loadLoop_child0" .

  loadChild1

  load drop

  //tasklist taskList.dump

  task.parent@ task.thread thread.condSignal

  TS_EXITED task.this task.state!
;

: LoadLoop_child1

  "loadLoop_child1" .

  task.parent@ task.thread thread.condSignal

  TS_EXITED task.this task.state!
;

/*----------------------------------------------------------------------------*/
/* table loader (can probably be removed)                                     */
/*----------------------------------------------------------------------------*/
: tableLoader ( "<fileNm>" ^table )

  loadByChild
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/