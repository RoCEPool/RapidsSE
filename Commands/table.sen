/*============================================================================*/
/* table.sen -- table related words                                           */
/*============================================================================*/

"table.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* table is use as a kind of word to identify tables                          */
/*----------------------------------------------------------------------------*/
: table ;

: makeTables {{ "tables" :dic ' folder swap execute dic.kind! }} ;

: isTable word.kind@ ' table eql ;

/*----------------------------------------------------------------------------*/
/* create a table using name from input stream (doesnt leave table on stk)    */
/*----------------------------------------------------------------------------*/
: table:
    create
    object!!
    sizeof_table allot
    word.this >body magic!!
    word.this >body CN_TABLE class!
    word.this >body table.init
    ' table word.this word.kind!
    does>
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: :table
    >create
    object!!
    sizeof_table allot
    word.this >body magic!!
    word.this >body CN_TABLE class!
    word.this >body table.init
    ' table word.this word.kind!
    word.this
    does>
;

/*----------------------------------------------------------------------------*/
/* se> checking                                                               */
/*----------------------------------------------------------------------------*/

: withinTables
    0 dic.pick dic.name "tables" streql
;

: checkInTables
    withinTables if true exit then
    EC_NOT_IN_TABLES false
;

: checkIsTable ( word )

  dup not if drop EC_NO_SUCH_TABLE false exit then

  dup word.kind@ ' table eql if true exit then
  drop
  EC_NOT_A_TABLE false
;

: checkIsNotTable ( word )
  dup findInCurrent not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
: pushTable ( "<tableName>" -- )

    find checkIsWord

    not if EC_NO_SUCH_TABLE false exit then

    execute table.dic dic.push

    true
;

: popTable
    dic.drop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/