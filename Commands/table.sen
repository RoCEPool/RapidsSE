/*============================================================================*/
/* table.sen -- table related words                                           */
/*============================================================================*/

"table.sen" .

/*----------------------------------------------------------------------------*/
/* table is use as a kind of word to identify tables                          */
/*----------------------------------------------------------------------------*/
: table ;

: isTable word.kind@ ' table eql ;

/*----------------------------------------------------------------------------*/
/* create a table using name from input stream (doesnt leave table on stk)    */
/*----------------------------------------------------------------------------*/
: table:
    create
    object!!
    sizeof_table allot
    word.this >body magic!!
    word.this >body CN_TABLE class!
    word.this >body table.init
    ' table word.this word.kind!
    does>
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: :table
    >create
    object!!
    sizeof_table allot
    word.this >body magic!!
    word.this >body CN_TABLE class!
    word.this >body table.init
    ' table word.this word.kind!
    word.this
    does>
;

/*----------------------------------------------------------------------------*/
/* se> checking                                                               */
/*----------------------------------------------------------------------------*/

: withinTables
    0 dic.pick dic.name "tables" streql
;

: checkInTables
    withinTables if 1 exit then
    EM_NOT_IN_TABLES EC_NOT_IN_TABLES failure 0
;

: checkIsTable ( word )

  dup not if drop EM_NO_SUCH_TABLE EC_NO_SUCH_TABLE failure 0 exit then

  dup word.kind@ ' table eql if 1 exit then
  drop
  EM_NOT_A_TABLE EC_NOT_A_TABLE failure 0
;

/*----------------------------------------------------------------------------*/
: pushTable ( "<tableName>" -- )

    find checkIsKnown

    not if EM_NO_SUCH_TABLE EC_NO_SUCH_TABLE failure 0 exit then

    execute table.dic dic.push

    true
;

: popTable
    dic.drop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/