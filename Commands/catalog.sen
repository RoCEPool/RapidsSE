/*============================================================================*/
/* catalog.sen -- catalog related words                                       */
/*============================================================================*/

"catalog.sen" .

: catalog ;

: withinCatalogs
    0 dic.pick dic.name "catalogs" streql
;

: checkInCatalogs
    withinCatalogs if 1 exit then
    "not in catalogs" 1 failure 0
;

: checkIsCatalog ( word )

    dup not if drop "no such catalog" 1 failure 0 exit then

    dup word.kind@ ' catalog eql if 1 exit then
    drop
    "not a catalog" 1 failure 0
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/