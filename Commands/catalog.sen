/*============================================================================*/
/* catalog.sen -- catalog related words                                       */
/*============================================================================*/

"catalog.sen" .

: catalog ;

: makeCatalogs {{ "catalogs" :dic drop }} ;

: :catalog
    :dic dup ' catalog swap word.kind!
;

: withinCatalogs
    0 dic.pick dic.name "catalogs" streql
;

: checkInCatalogs
    withinCatalogs if true exit then
    EC_NOT_IN_CATALOGS false
;

: checkIsCatalog ( word )

    dup not if drop EC_NO_SUCH_CATALOG false exit then

    dup word.kind@ ' catalog eql if true exit then
    drop
    EC_NOT_A_CATALOG false
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/