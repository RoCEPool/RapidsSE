/*============================================================================*/
/* txRef.sen -- Tx Reference                                                  */
/*============================================================================*/

"txref.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create a txRef using name on the stack                   (leaves on stack) */
/*----------------------------------------------------------------------------*/
: :txRef
    >create
    object!!
    sizeof_txRef allot
    word.this >body magic!!
    word.this >body CN_TXREF class!
    word.this >body txRef.init
    word.this >body object.wordbody
    word.this
    does>
;

////////////////////////////////////////////////////////////////////////////////

: ::txRef ( create a txRef )

  "txRef" find dup
  not if
    drop
    "txRef" :txRef
  then
  execute
;

: beginTransaction  ( -- txref )
  ::txRef
  txRef.begin drop
  ::txref
;

: commitTransaction
  ::txRef
  dup
  txRef.commit drop
  txRef.end drop
  "txRef" find >forget
;

: rollbackTransaction
  ::txRef
  dup
  txRef.rollback drop
  txRef.end drop
  "txRef" find >forget
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
