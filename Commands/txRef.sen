/*============================================================================*/
/* txRef.sen -- Tx Reference                                                  */
/*============================================================================*/

"txref.sen" .

/*----------------------------------------------------------------------------*/
/* create a txRef using name on the stack                   (leaves on stack) */
/*----------------------------------------------------------------------------*/
: :txRef
    >create
    object!!
    sizeof_txRef allot
    word.this >body magic!!
    word.this >body CN_TXREF class!
    word.this >body txRef.init
    word.this
    does>
;

////////////////////////////////////////////////////////////////////////////////

: ::txRef ( create a txRef )

  "txRef" find dup
  not if
    drop
    "txRef" :txCursor
  then
  execute
;

: beginTransaction
  ::txRef
  tx.begin drop
;

: commitTransaction
  ::txRef
  tx.commit drop
;

: rollbackTransaction
  ::txRef
  tx.rollback drop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/