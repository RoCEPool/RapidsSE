/*============================================================================*/
/* requestTask.sen -- request processing task                                 */
/*============================================================================*/

"requestServer.sen" .

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

queue:   requestQueue

dic:     tenants

taskset: requestTaskSet

thread:  requestThread

/*----------------------------------------------------------------------------*/
/* start the request task                                                     */
/*----------------------------------------------------------------------------*/
: requestStart

    "requestLoop"   task.new

    requestTaskSet  taskSet.append

    requestTaskSet  requestThread  thread.taskset!

    "requestThread" requestThread  thread.name!

    requestThread   thread.spawn
;

/*----------------------------------------------------------------------------*/
/* receive request                                                            */
/*----------------------------------------------------------------------------*/
: req>

    begin
      task.this task.queue@
      queue.pop
      dup not if 100 thread.sleep_us then
    until
;

/*----------------------------------------------------------------------------*/
/* process request                                                            */
/*----------------------------------------------------------------------------*/
: !req

    valset>

    // check stack
    depth 3 != if "incorrect request stack depth" . quit then
    0 stack.class CN_INTVAL != if "incorrect request value 0" . quit then
    1 stack.class CN_STRVAL != if "incorrect request value 1" . quit then
    2 stack.class CN_STRVAL != if "incorrect request value 2" . quit then

    drop // the count
    >:   // execute the response return address
    >:   // decode/push the request
;

/*----------------------------------------------------------------------------*/
/* send response                                                              */
/*----------------------------------------------------------------------------*/
: >rsp ( send response    )

    // check stack
    depth 3 != if "incorrect reponse stack depth" . quit then

    0 stack.class CN_INTVAL != if "incorrect reponse value 0" . quit then
    1 stack.class CN_INTVAL != if "incorrect reponse value 1" . quit then
    2 stack.class CN_STRVAL != if "incorrect reponse value 2" . quit then

    >valset
    "rspque" find execute queue.append
    0 task.this task.seitf!
;

/*----------------------------------------------------------------------------*/
/* request processing loop                                                    */
/*----------------------------------------------------------------------------*/
: requestLoop

    "renaming to Request Task" .

    "requestTask" task.this task.name!

    requestQueue  task.this task.queue!

    "Request Server running..." .

    begin
      req>
      !req
      >rsp
    0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/