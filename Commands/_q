print "" ;
print "lineitem join orders (not-opt)" ;
time dynamic
  fetch lineitem LineItem_Idx1 ||
  fetch orders   orders_idx1   |
  join |
  limit 1 |
  output
;

print "" ;
print "lineitem join orders (opt)" ;
time dynamic
  fetch lineitem LineItem_Idx1 1 ||
  fetch orders   orders_idx1   1 |
  join |
  limit 1 |
  output
;

print "" ;
print "lineitem join orders orderby" ;
time dynamic
  fetch lineitem LineItem_Idx1 ||
  fetch orders   orders_idx1   |
  join |
  getKey O_CUSTKEY |
  sort | merge |supermerge |
  limit 1 |
  output
;

print "" ;
print "orders join lineitem (not-opt)" ;
