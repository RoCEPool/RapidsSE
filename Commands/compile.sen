/*============================================================================*/
/* compile.sen -- compile the dictionary                                      */
/*============================================================================*/

"compile.sen" .putVerbose

//
// step 1: compile all the words
//


"core.sen" >>:
"common.sen" >>:
"structures.sen" >>:
"tasks.sen" >>:
"threads.sen" >>:
"transactions.sen" >>:
"interface.sen" >>:
"dbobjects.sen" >>:
"gridModel.sen" >>:
"systemObjects.sen" >>:
"actors.sen" >>:
"request.sen" >>:
"testing.sen" >>:
assert.stack_0

//
// step 2: runs some basic tests
//

ut

assert.stack_0

//
// step 3: spawn the root thread
//

( spawn the posix thread for the root thread )
rootThread thread.spawn

( leave root thread on stack )
rootThread

assert.stack_1

: __compiled__ ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/