/*============================================================================*/
/* _indexDemo - create and load Supllier table for SF10                       */
/*============================================================================*/

/*----------------------------------------------------------------------------*/
create table supplier (
	 S_SUPPKEY       INTEGER NOT NULL,
	 S_NAME          VARCHAR(25) NOT NULL,
	 S_ADDRESS       VARCHAR(40) NOT NULL,
	 S_NATIONKEY     INTEGER NOT NULL,
	 S_PHONE         CHAR(15) NOT NULL,
	 S_ACCTBAL       DECIMAL(15,2) NOT NULL,
	 S_COMMENT       VARCHAR(101) NOT NULL
);

/*----------------------------------------------------------------------------*/
print "----------------------------------------------------------------------";
print "Creating index idx1 with key S_SUPPKEY";
create index idx1 on supplier (S_SUPPKEY);

print "----------------------------------------------------------------------";
print "Creating index idx2 with key S_NAME";
create index idx2 on supplier (S_NAME);

/*----------------------------------------------------------------------------*/
print "----------------------------------------------------------------------";
print "Loading table..." ;
ld supplier "/tpch/SF100/supplier.tbl" ;
print "loaded supplier.tbl..." ;

pwf ;
lf ;

/*----------------------------------------------------------------------------*/
print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx1) where S_SUPPKEY == 100000..." ;
keyselidx supplier idx1 1000000 ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 99720 ..." ;
fetch supplier "S_SUPPKEY 99720 >=";

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx1) where S_SUPPKEY <= 20 ..." ;
uprselidx supplier idx1 20 ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 9972 & <= 9982..." ;
rgeselidx supplier idx1 9972 9982 ;


displayOff;
/*----------------------------------------------------------------------------*/
print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx2) where S_NAME == 'Supplier#000001900'..." ;
keyselidx supplier idx2 "Supplier#000001900" ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx2) where S_NAME >= 'Supplier#0000099000' ..." ;
fetch supplier "S_NAME Supplier#000099900 >=" ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx2) where S_NAME <= 'Supplier#0000054000' ..." ;
uprselidx supplier idx2 "Supplier#0000054000" ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx2) where S_NAME >= 'Supplier#0000099000' & <= 'Supplier#0000019000'..." ;
rgeselidx supplier idx2 "Supplier#0000099000" "Supplier#0000019000" ;


/*----------------------------------------------------------------------------*/
print "-----------------------------------------------------------------------";
print "\nCreating index idx3 with key S_ADDRESS ..." ;
create index idx3 on supplier (S_ADDRESS);

/*----------------------------------------------------------------------------*/
//dumpidx supplier idx3 ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx3) where S_ADDRESS == 'mX37oAzqsBPhN1LWdzV p'..." ;
keyselidx supplier idx3 "mX37oAzqsBPhN1LWdzV p" ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx3) where S_ADDRESS >= 'm' ..." ;
fetch supplier "S_ADDRESS m >=" ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx3) where S_ADDRESS <= 'p'..." ;
uprselidx supplier idx3 "p" ;

print "-----------------------------------------------------------------------";
print "\nSelecting rows from supplier (idx3) where S_ADDRESS >= 'm' & <= 'q'..." ;
rgeselidx supplier idx3 "m" "q" ;

displayOn;

/*----------------------------------------------------------------------------*/
print "-----------------------------------------------------------------------";
print "Listing indices of supplier..." ;
lsidx supplier;

/*----------------------------------------------------------------------------*/
print "-----------------------------------------------------------------------";
print "Listing columns of index idx1 of supplier..." ;
lsidxcol supplier idx1;

/*----------------------------------------------------------------------------*/
print "-----------------------------------------------------------------------";
print "Analyzing index idx1 of supplier..." ;
anidx supplier idx1;

/*----------------------------------------------------------------------------*/
print "-≥®--------------------------------------------------------------------";
print "Detailed analysis of index idx1 of supplier..." ;
danidx supplier idx1;

/*----------------------------------------------------------------------------*/
print "-----------------------------------------------------------------------";
print "Size of index idx1 of supplier..." ;
szidx supplier idx1;

print "-----------------------------------------------------------------------";
print "Size of index idx2 of supplier..." ;
szidx supplier idx2;

print "-----------------------------------------------------------------------";
print "Size of index idx3 of supplier..." ;
szidx supplier idx3;

/*----------------------------------------------------------------------------*/
//dumpidx supplier idx1;

visidx supplier idx1;
visidx supplier idx2;
visidx supplier idx3;

