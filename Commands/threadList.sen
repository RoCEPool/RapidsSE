/*============================================================================*/
/* threadList.sen -- thread list related words                                */
/*============================================================================*/

"threadList.sen" .putVerbose

: threadList:
    create
    object!!
    sizeof_threadlist allot
    word.this >body magic!!
    word.this >body CN_THREADLIST class!
    word.this >body threadlist.init
    word.this >body object.wordbody
    does>
;

