/*============================================================================*/
/* requestSet.sen -- request set group                                        */
/*============================================================================*/

"requestSet.sen" .putVerbose

"copier.sen" >>:
"exporter.sen" >>:
"fileGen.sen" >>:
"loader.sen" >>:

"requests.sen" >>:

// find the tenants folder
"tenants" findInCurrent
execute dic.push

// create tenant boray
"boray" create_tenant
drop drop drop

// find the boray folder
"boray" findInCurrent
execute dic.push

// find the catalogs folder
"catalogs" findInCurrent
execute dic.push

// create catalog rapidsse
"rapidsse" create_catalog
drop drop drop

// go back to main dictionary
dic.drop dic.drop dic.drop

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
