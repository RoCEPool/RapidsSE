/*============================================================================*/
/* _supplierLoad - create and load TPC-H Supllier table for SF1               */
/*============================================================================*/

cf~ ;
cf tenants ;
cf boray ;
cf catalogs ;
cf rapidsse ;
cf schemas ;

create schema tpchSchema;

cf tpchSchema ;
cf tables ;

docol epochTake;
create table supplier (
	 S_SUPPKEY       INTEGER NOT NULL,
	 S_NAME          VARCHAR(25) NOT NULL,
	 S_ADDRESS       VARCHAR(40) NOT NULL,
	 S_NATIONKEY     INTEGER NOT NULL,
	 S_PHONE         CHAR(15) NOT NULL,
	 S_ACCTBAL       DECIMAL(15,2) NOT NULL,
	 S_COMMENT       VARCHAR(101) NOT NULL
);

create index idx1 on supplier (S_SUPPKEY);
create index idx2 on supplier (S_NAME);

create index idx4 on supplier (S_COMMENT);

print "loading supplier.csv..." ;
ld supplier "/tpch/SF1/supplier.csv" ;
print "loaded supplier.csv..." ;

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY == 22 ...\n" ;
fetch supplier "S_SUPPKEY 22 ==";

docol epochDump;

pwf ;
lf ;

create index idx3 on supplier (S_ADDRESS);

//dumpidx supplier idx1;

displayOff;

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 9972 ...\n" ;
fetch supplier "S_SUPPKEY 9972 >=";

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 9972 & <= 9982...\n" ;
rgeselidx supplier idx1 9972 9982 ;

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 9985 ...\n" ;
fetch supplier "S_SUPPKEY 9985 >=";

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 9985 & <= 9987...\n" ;
rgeselidx supplier idx1 9985 9987 ;

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 9995 ...\n" ;
fetch supplier "S_SUPPKEY 9995 >=";

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 9995 & <= 1995 ...\n" ;
rgeselidx supplier idx1 9995 1995 ;

print "\nSelecting rows from supplier (idx2) where S_NAME >= 'Supplier#000009900' ...\n" ;
fetch supplier "S_NAME Supplier#000009900 >=" ;

print "\nSelecting rows from supplier (idx2) where S_NAME >= 'Supplier#000009900' & <= Supplier#000009990 ...\n" ;
rgeselidx supplier idx2 "Supplier#000009900" "Supplier#000009990" ;

print "\nSelecting rows from supplier (idx2) where S_NAME >= 'Supplier#000009900' & <= 'Supplier#000001900'...\n" ;
rgeselidx supplier idx2 "Supplier#000009900" "Supplier#000001900" ;

//dumpidx supplier idx3 ;

print "\nSelecting rows from supplier (idx3) where S_ADDRESS >= 'm' ...\n" ;
fetch supplier "S_ADDRESS m >=" ;

print "\nSelecting rows from supplier (idx3) where S_ADDRESS >= 'xo' ...\n" ;
fetch supplier "S_ADDRESS xo >=" ;

print "\nSelecting rows from supplier (idx3) where S_ADDRESS >= 'a' ...\n" ;
fetch supplier "S_ADDRESS a >=" ;

print "\nSelecting rows from supplier (idx3) where S_ADDRESS >= 'm' & <= 'q'...\n" ;
rgeselidx supplier idx3 "m" "q" ;

print "\nSelecting rows from supplier (idx3) where S_ADDRESS <= 'p'...\n" ;
uprselidx supplier idx3 "p" ;

print "\nSelecting rows from supplier (idx2) where S_NAME == 'Supplier#000001900'...\n" ;
keyselidx supplier idx2 "Supplier#000001900" ;

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY == 9785...\n" ;
keyselidx supplier idx1 "9785" ;

print "\nSelecting rows from supplier (idx3) where S_ADDRESS == 'mX37oAzqsBPhN1LWdzV p'...\n" ;
keyselidx supplier idx3 "mX37oAzqsBPhN1LWdzV p" ;

anidx supplier idx1;
//danidx supplier idx1 ;

visidx supplier idx1;
visidx supplier idx2;
visidx supplier idx3;

displayOn;

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY = 5 ...\n" ;
//keyselidx supplier idx1 5 ;

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY == 22 ...\n" ;
fetch supplier "S_SUPPKEY 22 ==";

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY >= 2 ...\n" ;
fetch supplier "S_SUPPKEY 2 >=";

print "\nSelecting rows from supplier (idx1) where S_SUPPKEY <= 10 ...\n" ;
fetch supplier "S_SUPPKEY 10 <=";

/*============================================================================*/
/* end                                                                        */
