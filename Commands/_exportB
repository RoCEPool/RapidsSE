print "\n";
print "**************************************************************************";
print "B) Exporting Lineitem";
print "**************************************************************************";

time pipeline exportB
begin
 
  stage scanBuffers on all partitions:

    scanOp LineItem | toCsvOp | stageB


  stage outputCsv on origin:

    toFileOp "/tmp/LineItemB.csv" | outputOp
 
end
;

