/*============================================================================*/
/* txMap.sen -- transaction map related words                                 */
/*============================================================================*/

"txmap.sen" .putVerbose

: txMap:
    create
    object!!
    sizeof_txmap allot
    word.this >body magic!!
    word.this >body CN_TXMAP class!
    word.this >body txmap.init
    word.this >body object.wordbody
    does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
