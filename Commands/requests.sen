: ping ( -- <R> )

    "pong"

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* docol_command                                                              */
/*----------------------------------------------------------------------------*/
: docol_command ( "command" -- <R> )

    checkIsWord not if <ERROR> exit then
    execute

    begin
     depth while drop
    repeat

   <OK>
;

/*----------------------------------------------------------------------------*/
/* get_version                                                                */
/*----------------------------------------------------------------------------*/
: get_version ( -- <R> )

  version

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x                                                     //! GET RID OF THIS WORD
    words

    "x"

    <SUCCESS>
;

