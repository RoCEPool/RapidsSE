/*----------------------------------------------------------------------------*/
/* print contents of a row buffer on each node                                */
/*----------------------------------------------------------------------------*/
: ~printRB ( )

tp: printRBOnAll

  // set indirect call to be printRB
  $$ swap "printRB"

tp: theIndirectCall

  $$>valset ( valset )

  >>allParticipants> ( bool )

tp: printRBOnAllDone

  checkResult
;

int: countRows

/*----------------------------------------------------------------------------*/
/* print contents of a string sent via a row buffer on each node              */
/*----------------------------------------------------------------------------*/
: pRB ( "filename" )

tp: pRB

  reg.push

  rowBuffer.new >reg0    // reg0 - rowbuffer
  beginTransaction >reg1 // reg1 - txref

/*
  0 countRows !
  begin
  while
    countRows @ >str
    "Hello there " swap concat reg1 reg0 rowbuffer.append
    countRows @
    1 +
    countRows !
  repeat
*/

  10 countRows !
  countRows @ 0 do
    "Hello there " I >str concat reg1 reg0 rowbuffer.append
  loop

  // commit the transaction
  commitTransaction

  drop

  //reg0 rowbuffer.dump

  reg0

tp: marker

$$>valset

tp: valset

  ~printRB  ( rowbuffer )

  reg.pop

  <OK>
;

/*----------------------------------------------------------------------------*/
/* print contents of a string sent via a row buffer on each node              */
/*----------------------------------------------------------------------------*/
: printRB$ ( rowbuffer )

tp: printRB$

  "PRINTING ROWBUFFER on NODE " args.node >str concat .

  rowbuffer.dump

  true ( true )
;

/*----------------------------------------------------------------------------*/
/* print contents of a string sent via a row buffer on each node              */
/*----------------------------------------------------------------------------*/
: printRB (  rowBuffer ... #folders -- true )

  valset>

  drop

  //dup "dicStack!" strEql
  //if
//tp: settingDicStack
  //  !indirect drop
  //  then

  printRB$
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x                                                     //! GET RID OF THIS WORD

  words

  "x"

  <SUCCESS>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* create /tenants/boray/catalogs/rapidsse                                    */
/*----------------------------------------------------------------------------*/
: createDefaultFolders localCalls ( )

  assert.stack_0

  // push tenants folder
  "tenants" findInCurrent
  execute dic.push

  // create tenant boray (and catalogs sub-folder)
  "boray" makeTenant drop drop drop

  // push boray folder
  "boray" findInCurrent
  execute dic.push

  // push catalogs folder
  "catalogs" findInCurrent
  execute dic.push

  // create catalog rapidsse (and schemas sub-folder)
  "rapidsse" makeCatalog drop drop drop

  // go back to main dictionary
  dic.drop
  dic.drop
  dic.drop

  assert.stack_0
;

/*============================================================================*/
/* end                                                                        */
