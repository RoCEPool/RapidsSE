/*----------------------------------------------------------------------------*/
/* use a schema                                                               */
/*----------------------------------------------------------------------------*/
: use_schema ( "<schemaNm>" -- <R> )

  begin 0 dic.pick dic.name "tenants" streql not while dic.drop repeat

  // find the boray folder
  "boray" findInCurrent
  execute dic.push

  // find the catalogs folder
  "catalogs" findInCurrent
  execute dic.push

  // find the rapidssecatalogs folder
  "rapidsse" findInCurrent
  execute dic.push

  // find the schemas folder
  "schemas" findInCurrent
  execute dic.push

  checkIsWord   not if EC_NO_SUCH_SCHEMA <NIP+ERROR> exit then
  checkIsSchema not if <NIP+ERROR> exit then
  execute dic.push

  // find the tables folder
  "tables" findInCurrent
  execute dic.push

  <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeTable     not if <NIP+ERROR> exit then

  ~makeTable ( ) assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables ( -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then

  contentsString

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  //freespace .

  tableLoader   not if <NIP+ERROR> exit then

  //freespace .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* load a table from a stream                                                 */
/*----------------------------------------------------------------------------*/
: load_table_stream ( "<fileNm>" "<tableNm>" -- <R> )

  ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  //freespace .

  tableLoaderStream2 not if <NIP+ERROR> exit then

  //freespace .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  tableExporter not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- <R> )

ddlLock.grabRead

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkInTables      not if <NIP+ERROR> exit then
  checkIsTable       not if <NIP+ERROR> exit then

  //freespace .

  tableCopier

  //freespace .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dump_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  dumpTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* append row buffer into table                                               */
/*----------------------------------------------------------------------------*/
: table_append ( "table", "buffer", "partition" -- <R> )        //! append_table

ddlLock.grabRead

  table.append

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

  checkInTables not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  sizeTable ( "<size>" )

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get row cursor for table                                                   */
/*----------------------------------------------------------------------------*/
: select_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

  getTableRef not if <NIP+ERROR> exit then

  selectTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  truncateTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

  checkRemoveTable not if <NIP+ERROR> exit then

tp ( "<tableNm>" )

  ~removeTable ( ) assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: table_inuse ( "<tableNm>" -- <R> )

  checkInTables not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  tableInUse
  if
    "table in use" .
  else
    "table not in use" .
  then

   <OK>
;

/*----------------------------------------------------------------------------*/
/* get a table ref                                                            */
/*----------------------------------------------------------------------------*/
: get_table ( "<tableNm>" -- <R> )

  getTableRef not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* return a table ref                                                         */
/*----------------------------------------------------------------------------*/
: return_table ( )

  returnTableRef not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column ( "<columnTy>" "<columnNm>" "<tableNm>" -- <R> )

  checkAddColumn not if <NIP+ERROR> exit then

  ~addColumn ( ) assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<tableNm>" -- <R> )

  checkInTables not if <NIP+ERROR> exit then

  pushTable     not if <NIP+ERROR> exit then
  pushColumns   not if <NIP+ERROR> exit then

  listColumns

  popColumns
  popTable

  <SUCCESS>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* change folder                                                              */
/*----------------------------------------------------------------------------*/
: cf

  dup ".." streql if
    drop
    0 dic.pick dic.name "tenants" streql not if dic.drop then
  else
    dup "~" streql if
      drop
      begin 0 dic.pick dic.name "tenants" streql not while dic.drop repeat
    else
      dup "tenants" streql if
        begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
        checkIsWord not if <NIP+ERROR> exit then
        execute dic.push
      else
        find
        checkIsDic not if <NIP+ERROR> exit then
        execute dic.push
      then
    then
  then

  <OK>
;


/*----------------------------------------------------------------------------*/
/* print working folder                                                       */
/*----------------------------------------------------------------------------*/
: pwf

  "/"
  dic.count 2 do
    dic.count 1 - I -
    dic.pick dic.name concat
    "/" concat
  loop

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf

  ""
  word.this dup iterate

    dup strlen if "\n" concat then

    object@ word.name 12 strpad concat

    "(" concat

    object@ isTable if
      "table " concat
      object@ execute table.space bytes.magnitude concat
    then

    object@ isFolder if
      object@ execute dic.kind@ word.name concat
    then

    ")" concat

    object@ prevWord object!

  next

  // 128 clip

   <SUCCESS>
;

