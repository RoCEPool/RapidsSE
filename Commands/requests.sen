/*============================================================================*/
/* requests.sen -- the set of requests supported by requestTask               */
/*============================================================================*/

"requests.sen" .verbose

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

Connection Requests:

  con     connect
  dis     disconnect

Tenant Requests:

  mkten   create_tenant
  lsten   list_tenants
  rmten   drop_tenant

Catalog Requests:

  mkcat   create_catalog
  lscat   list_catalogs
  rmcat   drop_catalog

Schema Requests:

  mksch   create_schema
  lssch   list_schemas
  rmsch   drop_schema
  usesch  use_schema

Table Requests:

  gettbl  get_table
  mktbl   create_table
  lstbl   list_tables
  add     add_column
  lscol   list_columns
  ld      load_table
  tblInUse  table_inuse
  sel     select_table
  dump    dump_table
  cp      copy_table
  ex      export_table
  sz      size_table
  tr      truncate_table
  rettbl  return_table
  rmtbl   drop_table

Dictionary Requests:

  cf      cf ..
          cf ~
          cf
  pwf     pwf
  lf      lf

Misc Requests:

  seitf   seitf_count
  mon     get_monitor
  ping    ping
  x       x

Grid Request:
  lfG     lf on grid
  pRB     print a row buffer on each node

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

//: <ERROR> dup error.msg swap 2 ddlLock.testDrop ;

: <NIP+ERROR> nipAll dup error.msg swap 2 ddlLock.testDrop ;

: <SUCCESS> 0 2 ddlLock.testDrop ;

: <OK> "<ok>" 0 2 ddlLock.testDrop ;

/*----------------------------------------------------------------------------*/
/* check system has enough buffers                                            */
/*----------------------------------------------------------------------------*/
: checkEnoughBuffers

  freeBuffers 100 >
  if
    true exit
  else
    EC_LOW_BUFFERS false
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
: create_tenant ( "<tenantNm>" -- <R> )

tp: createTenant

ddlLock.grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then              //! NEEDS TO BE ~
  checkMakeTenant    not if <NIP+ERROR> exit then

//traceon
  makeTenant ( ) assert.stack_0
//traceoff

tp: createdTenant

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tenants                                                        */
/*----------------------------------------------------------------------------*/
: list_tenants ( -- <R> )

ddlLock.grabRead

  checkInTenants not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
: drop_tenant ( "<tenantNm>" -- <R> )

tp: dropTenant

ddlLock.grabWrite

  checkRemoveTenant not if <NIP+ERROR> exit then

  ~removeTenant ( ) assert.stack_0

tp: removedTenant

  <OK>
;

