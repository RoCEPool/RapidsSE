/*============================================================================*/
/* requests.sen -- the set of requests supported by requestTask               */
/*============================================================================*/

"requests.sen" .

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

Connection Requests:

  con     connect
  dis     disconnect

Tenant Requests:

  mkten   create_tenant
  lsten   list_tenants
  rmten   drop_tenant

Catalog Requests:

  mkcat   create_catalog
  lscat   list_catalogs
  rmcat   drop_catalog

Schema Requests:

  mksch   create_schema
  lssch   list_schemas
  rmsch   drop_schema

Table Requests:

  mktbl   create_table
  lstbl   list_tables
  add     add_column
  lscol   list_columns
  ld      load_table
  sel     select_table
  dump    dump_table
  cp      copy_table
  ex      export_table
  sz      size_table
  tr      truncate_table
  rmtbl   drop_table

Dictionary Requests:

  cd      cd ..
          cd ~
          cd
  pwd     pwd
  ls      ls
  rmdic   drop_dictionary

Misc Requests:

  mon     get_monitor
  ping    ping
  x       x

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

: <ERROR> dup toEM swap 2 ;

: <SUCCESS> 0 2 ;

: <OK> "<ok>" 0 2 ;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect

    <SUCCESS>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
: create_tenant ( "<tenantNm>" -- <R> )

    checkInTenants not if <ERROR> exit then

    :tenant execute makeCatalogs

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tenants                                                        */
/*----------------------------------------------------------------------------*/
: list_tenants ( -- <R> )

    checkInTenants not if <ERROR> exit then

    contents_string

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
: drop_tenant ( "<tenantNm>" -- <R> )

    checkInTenants not if <ERROR> exit then

    find

    checkIsTenant not if <ERROR> exit then

    >forget

    <OK>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a catalog                                                           */
/*----------------------------------------------------------------------------*/
: create_catalog ( "<catalogNm>" -- <R> )

    checkInCatalogs not if <ERROR> exit then

    :catalog execute makeSchemas

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of catalogs                                                       */
/*----------------------------------------------------------------------------*/
: list_catalogs ( -- <R> )

    checkInCatalogs not if <ERROR> exit then

    contents_string

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a catalog                                                             */
/*----------------------------------------------------------------------------*/
: drop_catalog ( "<catalogNm>" -- <R> )

    checkInCatalogs not if <ERROR> exit then

    find

    checkIsCatalog not if <ERROR> exit then

    >forget

    <SUCCESS>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a schema                                                            */
/*----------------------------------------------------------------------------*/
: create_schema ( "<schemaNm>" -- <R> )

    checkInSchemas not if <ERROR> exit then

    :schema execute makeTables

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of schemas                                                        */
/*----------------------------------------------------------------------------*/
: list_schemas ( -- <R> )

    checkInSchemas not if <ERROR> exit then

    contents_string

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a schema                                                              */
/*----------------------------------------------------------------------------*/
: drop_schema ( "<schemaNm>" -- <R> )

    checkInSchemas not if <ERROR> exit then

    find

    checkIsSchema not if <ERROR> exit then

    >forget

    <OK>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table ( "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    :table execute makeColumns

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables ( -- <R> )

    checkInTables not if <ERROR> exit then

    contents_string

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    //freespace .

    find

    checkIsTable not if <ERROR> exit then

    execute ( "filename" table )

    tableLoader

    //freespace .

    <OK>
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "<fileNm>" "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    execute ( "filename" table )

    tableExporter

    <OK>
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- <R> )

freespace .

    checkInTables not if swap drop <ERROR> exit then

    find

    checkIsTable not if swap drop <ERROR> exit then

    execute        ( "<to-tableNm>" ^fromTable )

    swap           ( ^fromTable "<to-tableNm>" )

    :table execute ( ^fromTable ^toTable )

//    swap           ( ^toTable ^fromTable )

    tableCopier

freespace .

    <OK>
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dump_table ( "<tableNm>" -- <R> )

  checkInTables not if <ERROR> exit then

  find

  checkIsTable not if <ERROR> exit then

  execute ( table )

  rowDump

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    execute ( table )

    table.space >str

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get row cursor for table                                                   */
/*----------------------------------------------------------------------------*/
: select_table ( "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    queryCount ++

    execute ( table )

    rowcursor.new dup rot rowcursor.table!

    >str

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get address of table                                                       */
/*----------------------------------------------------------------------------*/
: address_table ( "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    execute ( table )

    >str

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    execute ( table )

    table.truncate

    <OK>
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    dup execute table.truncate

    >forget

    <OK>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column ( "<columnTy>" "<columnNm>" "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    pushTable not if <ERROR> exit then

    pushColumns not if <ERROR> exit then

    addColumn not if <ERROR> exit then

    popColumns

    popTable

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<tableNm>" -- <R> )

    checkInTables not if <ERROR> exit then

    pushTable not if <ERROR> exit then

    pushColumns not if <ERROR> exit then

    listColumns

    popColumns

    popTable

    <SUCCESS>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* change dictionary                                                          */
/*----------------------------------------------------------------------------*/
: cd

    dup ".." streql if
      drop
      dic.drop
    else
      dup "~" streql if
        drop
        begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
      else
        dup "tenants" streql if
          begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
          find
          checkIsWord not if <ERROR> exit then
          execute dic.push
        else
          find
          checkIsWord not if <ERROR> exit then
          execute dic.push
        then
      then
    then

    <OK>
;

/*----------------------------------------------------------------------------*/
/* print working dictionary                                                   */
/*----------------------------------------------------------------------------*/
: pwd

    "/"
    dic.count 0 do
      dic.count 1 - I -
      dic.pick dic.name concat
      "/" concat
    loop

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* list dictionary contents                                                   */
/*----------------------------------------------------------------------------*/
: ls

    ""
    word.this dup iterate

      dup strlen if "\n" concat then

      object@ word.name 12 strpad concat

      "(" concat
      object@ word.kind@ word.name concat

      object@ isTable if
        " " concat
        object@ execute table.space >str concat " bytes" concat
      then
      ")" concat

      object@ prevWord object!

    next

//    128 clip

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a dictionary                                                          */
/*----------------------------------------------------------------------------*/
: drop_dictionary ( "<dicNm>" -- <R> )

    find

    checkIsDic not if exit then

    >forget

    <OK>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* get monitor string                                                         */
/*----------------------------------------------------------------------------*/
: get_monitor ( -- <R> )

    monitorString@

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping ( -- <R> )

    "pong"

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x
    words

    "x"

    <SUCCESS>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/