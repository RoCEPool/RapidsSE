  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<tableNm>" -- <R> )

  checkInTables not if <NIP+ERROR> exit then

  listColumns

  <SUCCESS>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* change folder                                                              */
/*----------------------------------------------------------------------------*/
: cf

  dup ".." streql if
    drop
    0 dic.pick dic.name "tenants" streql not if dic.drop then
  else
    dup "~" streql if
      drop
      begin 0 dic.pick dic.name "tenants" streql not while dic.drop repeat
    else
      dup "tenants" streql if
        begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
        checkIsWord not if <NIP+ERROR> exit then
        execute dic.push
      else
        find
        checkIsDic not if <NIP+ERROR> exit then
        execute dic.push
      then
    then
  then

  <OK>
;


/*----------------------------------------------------------------------------*/
/* print working folder                                                       */
/*----------------------------------------------------------------------------*/
: pwf

  "/"
  dic.count 2 do
    dic.count 1 - I -
    dic.pick dic.name concat
    "/" concat
  loop

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf

  ""
  0 dic.pick dic.last dup iterate

    dup strlen if "\n" concat then

    object@ word.name 12 strpad concat

    "(" concat

    object@ isTable if
      "table " concat
      object@ execute table.space bytes.magnitude concat
    then

    object@ isFolder if
      object@ execute dic.kind@ word.name concat
    then

    ")" concat

    object@ word.prev object!

  next

  // 128 clip

   <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: ~lf ( )

tp: lfOnAll

  // set indirect call to be lf_
  $$ "lf_"

  tp: theIndirectCall

  $$>valset ( valset )

  >>allParticipants> ( bool )

tp: lfOnAllDone

  checkResult
;

/*----------------------------------------------------------------------------*/
/* list folder contents across the grid                                       */
/*----------------------------------------------------------------------------*/
: lfG

  ~lf

  <OK>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf$ ( )

tp: lf

  "LISTING FOLDER on NODE " args.node >str concat .

  ""
  0 dic.pick dic.last dup iterate

  dup strlen if "\n" concat then

  object@ word.name 12 strpad concat

  "(" concat

  object@ isTable if
  "table " concat
  object@ execute table.space bytes.magnitude concat
  then

  object@ isFolder if
  object@ execute dic.kind@ word.name concat
  then

  ")" concat

  object@ word.prev object!

  next

  // 128 clip

  .

  //drop ( "<tenantNm>" )

  true ( true )
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf_ (  #folders -- true )

  depth 0 != if
    "dicStack!" strEql
    if
  tp: settingDicStack
    !indirect drop
    then
  then

  lf$
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* get space in the pool (run by participant)                                 */
/*----------------------------------------------------------------------------*/
: space$ ( -- <R> )

tp: gettingSpace

  args.tracepoint if
    "GETTING SPACE on NODE "args.node >str concat .
  then

  "Pool - Size(" 2 totalSpace number.magnitude concat ")" concat
  " InUse(" 2 inUseSpace number.magnitude concat ")" concat
  " Free(" 2 freeSpace number.magnitude concat ")" concat

  concat concat

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* have participants run: space$                                              */
/*----------------------------------------------------------------------------*/
: ~space (  )

tp: spaceOnAll

  // the indirect word to be called
  "space$"

  tp: theIndirectCall

  $$>valset ( valset )

  // space$ to be executed by all participants
  >>allParticipants> ( bool )

  tp: spaceOnAllDone

  printResult
tp: dpne
;

/*----------------------------------------------------------------------------*/
/* get space in the pool                                                      */
/*----------------------------------------------------------------------------*/
: space ( -- <R> )

  ~space ( ) assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get free space in the pool                                                 */
/*----------------------------------------------------------------------------*/
: getFreeSpace ( -- <R> )

  freeSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get inUse space in the pool                                                */
/*----------------------------------------------------------------------------*/
: getInUseSpace ( -- <R> )

