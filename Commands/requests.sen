/*============================================================================*/
/* requests.sen -- the set of requests supported by requestTask               */
/*============================================================================*/

"requests.sen" .putVerbose

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

Connection Requests:

  con     connect
  dis     disconnect

Tenant Requests:

  mkten   create_tenant
  lsten   list_tenants
  rmten   drop_tenant

Catalog Requests:

  mkcat   create_catalog
  lscat   list_catalogs
  rmcat   drop_catalog

Schema Requests:

  mksch   create_schema
  lssch   list_schemas
  rmsch   drop_schema
  usesch  use_schema

Table Requests:

  gettbl  get_table
  mktbl   create_table
  lstbl   list_tables
  add     add_column
  lscol   list_columns
  ld      load_table
  tblInUse  table_inuse
  sel     select_table
  dump    dump_table
  cp      copy_table
  ex      export_table
  sz      size_table
  tr      truncate_table
  rettbl  return_table
  rmtbl   drop_table

Dictionary Requests:

  cf      cf ..
          cf ~
          cf
  pwf     pwf
  lf      lf

Misc Requests:

  seitf   seitf_count
  mon     get_monitor
  ping    ping
  x       x

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

/*----------------------------------------------------------------------------*/
/* get seitif folder path                                                     */
/*----------------------------------------------------------------------------*/
: seitf.path@ ( -- ... #dics )

  // this word puts the dictionary path onto the stack as a series of names
  // ( ... "<subFolderC>"  "<subFolderB>"  "<subFolderA>" "main" 4 )

  dic.count 0 do
    // calculate dic subscript
    //dic.count I - dec ( d )

    I 
    // get dictionary[d]
    dic.pick  ( dic )

    // push dictionary name
    dic.name ( ... dicNm )
  loop

  // push number of dictionary names
  dic.count ( ... #dics )

;

/*----------------------------------------------------------------------------*/
/* set task dictionary stack                                                  */
/*----------------------------------------------------------------------------*/
: dicStack! ( ... #dics -- )

  // this word puts the folder path on the stack into task dictionary stack
  // ( ... "<subFolderC>"  "<subFolderB>"  "<subFolderA>" "main" 4 )

  0 do

    dup "<main>" streql if
      drop
      dic.main
      dicStack.push
    else

      dup "seitf" streql if
        drop
        dic.main
        dicStack.push
      else

        find
        execute
        dicStack.push
    then

   then

  loop

;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

: <ERROR> dup error.msg swap 2 ddlLock.testDrop ;
: <NIP+ERROR> nipAll dup error.msg swap 2 ddlLock.testDrop ;

: <SUCCESS> 0 2 ddlLock.testDrop ;

: <OK> "<ok>" 0 2 ddlLock.testDrop ;

: checkEnoughBuffers
   freeBuffers 100 > if true exit then
   EC_LOW_BUFFERS false
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
/*
: create_tenant ( "<tenantNm>" -- <R> )

ddlLock.grabWrite

  checkEnoughBuffers not if swap drop <ERROR> exit then
  checkInTenants     not if swap drop <ERROR> exit then

  checkIsNotTenant   not if swap drop <ERROR> exit then

  :tenant execute makeCatalogs

  <OK>
;
*/
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: create_tenant ( "<tenantNm>" -- <R> )

ddlLock.grabWrite

  checkEnoughBuffers not if swap drop <ERROR> exit then
  checkInTenants     not if swap drop <ERROR> exit then
  checkIsNotTenant   not if swap drop <ERROR> exit then

  dup          ( "<tenantNm>" "<tenantNm>" )
  ~makeTenant  ( "<tenantNm>" )
  makeCatalogs ( )

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tenants                                                        */
/*----------------------------------------------------------------------------*/
: list_tenants ( -- <R> )

ddlLock.grabRead

  checkInTenants not if <ERROR> exit then

  contentsString

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
/*
: drop_tenant ( "<tenantNm>" -- <R> )

ddlLock.grabWrite

  checkInTenants not if swap drop <ERROR> exit then

  checkIsWord not if drop EC_NO_SUCH_TENANT <ERROR> exit then

  checkIsTenant not if <ERROR> exit then

  dicHasRef " dic ref " .put .put .\n

  dicHasRef if drop EC_FOLDER_IN_USE <ERROR> exit then

  >forget

  <OK>
;
*/
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: drop_tenant ( "<tenantNm>" -- <R> )

ddlLock.grabWrite

  checkRemoveTenant not if <NIP+ERROR> exit then

  ~removeTenant

  <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a catalog                                                           */
/*----------------------------------------------------------------------------*/
: create_catalog ( "<catalogNm>" -- <R> )

ddlLock.grabWrite

    checkEnoughBuffers not if swap drop <ERROR> exit then
    checkInCatalogs    not if swap drop <ERROR> exit then
    checkIsNotCatalog  not if swap drop <ERROR> exit then

    :catalog execute makeSchemas

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of catalogs                                                       */
/*----------------------------------------------------------------------------*/
: list_catalogs ( -- <R> )

ddlLock.grabRead

    checkInCatalogs not if <ERROR> exit then

    contentsString

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a catalog                                                             */
/*----------------------------------------------------------------------------*/
: drop_catalog ( "<catalogNm>" -- <R> )

ddlLock.grabWrite

    checkInCatalogs not if swap drop <ERROR> exit then

    checkIsWord not if drop EC_NO_SUCH_CATALOG <ERROR> exit then

    checkIsCatalog not if swap drop <ERROR> exit then

    dicHasRef if drop EC_FOLDER_IN_USE <ERROR> exit then

    >forget

    <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a schema                                                            */
/*----------------------------------------------------------------------------*/
: create_schema ( "<schemaNm>" -- <R> )

ddlLock.grabWrite

    checkEnoughBuffers not if swap drop <ERROR> exit then
    checkInSchemas     not if swap drop <ERROR> exit then
    checkIsNotSchema   not if swap drop <ERROR> exit then

    :schema execute makeTables

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of schemas                                                        */
/*----------------------------------------------------------------------------*/
: list_schemas ( -- <R> )

ddlLock.grabRead

    checkInSchemas not if <ERROR> exit then

    contentsString

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a schema                                                              */
/*----------------------------------------------------------------------------*/
: drop_schema ( "<schemaNm>" -- <R> )

ddlLock.grabWrite

    checkInSchemas not if swap drop <ERROR> exit then

    checkIsWord not if drop EC_NO_SUCH_SCHEMA <ERROR> exit then

    checkIsSchema not if swap drop <ERROR> exit then

    dicHasRef if drop EC_FOLDER_IN_USE <ERROR> exit then

    >forget

    <OK>
;

/*----------------------------------------------------------------------------*/
/* use a schema                                                               */
/*----------------------------------------------------------------------------*/
: use_schema ( "<schemaNm>" -- <R> )

    begin 0 dic.pick dic.name "tenants" streql not while dic.drop repeat

    // find the boray folder
    "boray" findInCurrent
    execute dic.push

    // find the catalogs folder
    "catalogs" findInCurrent
    execute dic.push

    // find the rapidssecatalogs folder
    "rapidsse" findInCurrent
    execute dic.push

    // find the schemas folder
    "schemas" findInCurrent
    execute dic.push

    checkIsWord not if drop EC_NO_SUCH_SCHEMA <ERROR> exit then
    checkIsSchema not if swap drop <ERROR> exit then
    execute dic.push

    // find the tables folder
    "tables" findInCurrent
    execute dic.push

    <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table ( "<tableNm>" -- <R> )

seitf.path@

dicStack!

ddlLock.grabWrite

    checkEnoughBuffers not if swap drop <ERROR> exit then
    checkInTables      not if swap drop <ERROR> exit then
    checkIsNotTable    not if swap drop <ERROR> exit then

    :table execute makeColumns

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables ( -- <R> )

ddlLock.grabRead

    checkInTables not if <ERROR> exit then

    contentsString

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

    checkInTables not if rot drop drop <ERROR> exit then

    //freespace .

    find

    checkIsTable not if swap drop <ERROR> exit then

    execute ( "filename" table )

    tableLoader not if <ERROR> exit then

    //freespace .

    <OK>
;

/*----------------------------------------------------------------------------*/
/* load a table from a stream                                                 */
/*----------------------------------------------------------------------------*/
: load_table_stream ( "<fileNm>" "<tableNm>" -- <R> )

  ddlLock.grabRead

  checkInTables not if rot drop drop <ERROR> exit then

  //freespace .

  find

  checkIsTable not if swap drop <ERROR> exit then

  execute ( "filename" table )

  tableLoaderStream2 not if <ERROR> exit then

  //freespace .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

    checkInTables not if rot drop drop <ERROR> exit then

    find

    checkIsTable not if swap drop <ERROR> exit then

    execute ( "filename" table )

    tableExporter not if <ERROR> exit then

    <OK>
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- <R> )

ddlLock.grabRead

    freespace .

    checkEnoughBuffers not if swap drop <ERROR> exit then
    checkInTables      not if rot drop drop <ERROR> exit then

    find

    checkIsTable not if swap drop <ERROR> exit then

    execute        ( "<to-tableNm>" ^fromTable )

    swap           ( ^fromTable "<to-tableNm>" )

    :table execute ( ^fromTable ^toTable )

//    swap           ( ^toTable ^fromTable )

    tableCopier

freespace .

    <OK>
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dump_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if swap drop <ERROR> exit then

  find

  checkIsTable not if <ERROR> exit then

  execute ( table )

  rowDump

  <OK>
;

/*----------------------------------------------------------------------------*/
/* append row buffer into table                                               */
/*----------------------------------------------------------------------------*/
: table_append ( "table", "buffer", "partition" -- <R> )

ddlLock.grabRead

  table.append

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

    checkInTables not if swap drop  <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    execute ( table )

    table.space >str

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get row cursor for table                                                   */
/*----------------------------------------------------------------------------*/
: select_table ( "<tableNm>" -- <R> )

/*
ddlLock.grabRead

    checkInTables not if swap drop  <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    queryCount ++

    execute ( table )

    rowcursor.new dup rot rowcursor.table!

    >str

    <SUCCESS>
*/

ddlLock.grabRead

    get_tableRef not if swap drop <ERROR> exit then

    queryCount ++

    task.this task.seitf@ seitf.table@

    rowcursor.new dup rot rowcursor.table!

    >str

    <SUCCESS>

;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

    checkInTables not if swap drop  <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    execute ( table )

    table.truncate

    <OK>
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

    checkInTables not if swap drop  <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    dup execute dup

    tableInUse if drop drop EC_TABLE_IN_USE <ERROR> exit then

    table.truncate

    >forget

    <OK>
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: table_inuse ( "<tableNm>" -- <R> )

    checkInTables not if swap drop  <ERROR> exit then

    find

    checkIsTable not if <ERROR> exit then

    execute ( table )

    tableInUse not if "Table not in use" . <OK> exit then

    "Table in Use" .

   <OK>
;

/*----------------------------------------------------------------------------*/
/* get a table                                                                */
/*----------------------------------------------------------------------------*/
: get_table ( "<tableNm>" -- <R> )

    get_tableRef not if <ERROR> exit then

    <OK>
;

/*----------------------------------------------------------------------------*/
: return_table ( )

    return_tableRef not if <ERROR> exit then

    <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column ( "<columnTy>" "<columnNm>" "<tableNm>" -- <R> )

    checkInTables not if swap drop rot drop drop <ERROR> exit then

    pushTable not if swap drop rot drop drop <ERROR> exit then

    pushColumns not if swap drop rot drop drop <ERROR> exit then

    addColumn not if swap drop rot drop drop <ERROR> exit then

    popColumns

    popTable

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<tableNm>" -- <R> )

    checkInTables not if swap drop <ERROR> exit then

    pushTable not if swap drop <ERROR> exit then

    pushColumns not if swap drop <ERROR> exit then

    listColumns

    popColumns

    popTable

    <SUCCESS>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* change folder                                                              */
/*----------------------------------------------------------------------------*/
: cf

    dup ".." streql if
      drop
      0 dic.pick dic.name "tenants" streql not if dic.drop then
    else
      dup "~" streql if
        drop
        begin 0 dic.pick dic.name "tenants" streql not while dic.drop repeat
      else
        dup "tenants" streql if
          begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
          checkIsWord not if <ERROR> exit then
          execute dic.push
        else
          find
          checkIsDic not if <ERROR> exit then
          execute dic.push
        then
      then
    then

    <OK>
;


/*----------------------------------------------------------------------------*/
/* print working folder                                                       */
/*----------------------------------------------------------------------------*/
: pwf

    "/"
    dic.count 2 do
      dic.count 1 - I -
      dic.pick dic.name concat
      "/" concat
    loop

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf

    ""
    word.this dup iterate

      dup strlen if "\n" concat then

      object@ word.name 12 strpad concat

      "(" concat

      object@ isTable if
        "table " concat
        object@ execute table.space bytes.magnitude concat
      then

      object@ isFolder if
        object@ execute dic.kind@ word.name concat
      then

      ")" concat

      object@ prevWord object!

    next

//    128 clip

    <SUCCESS>
;

