  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping ( -- <R> )

  "pong"

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* docol_command                                                              */
/*----------------------------------------------------------------------------*/
: docol_command ( "command" -- <R> )

  checkIsWord not if <NIP+ERROR> exit then
  execute

  begin
   depth while drop
  repeat

 <OK>
;

/*----------------------------------------------------------------------------*/
/* get_version                                                                */
/*----------------------------------------------------------------------------*/
: get_version ( -- <R> )

  version

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x                                                     //! GET RID OF THIS WORD

  words

  "x"

  <SUCCESS>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* create /tenants/boray/catalogs/rapidsse                                    */
/*----------------------------------------------------------------------------*/
: createDefaultFolders ( )

  assert.stack_0

  // push tenants folder
  "tenants" findInCurrent
  execute dic.push

  // create tenant boray (and catalogs sub-folder)
  "boray" makeTenant$ assert

  // push boray folder
  "boray" findInCurrent
  execute dic.push

  // push catalogs folder
  "catalogs" findInCurrent
  execute dic.push

  // create catalog rapidsse (and schemas sub-folder)
  "rapidsse" makeCatalog assert

  // go back to main dictionary
  dic.drop
  dic.drop
  dic.drop

  assert.stack_0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
