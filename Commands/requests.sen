/*============================================================================*/
/* requests.sen -- the set of requests supported by requestTask               */
/*============================================================================*/

"requests.sen" .putVerbose

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

Connection Requests:

  con     connect
  dis     disconnect

Tenant Requests:

  mkten   create_tenant
  lsten   list_tenants
  rmten   drop_tenant

Catalog Requests:

  mkcat   create_catalog
  lscat   list_catalogs
  rmcat   drop_catalog

Schema Requests:

  mksch   create_schema
  lssch   list_schemas
  rmsch   drop_schema
  usesch  use_schema

Table Requests:

  gettbl  get_table
  mktbl   create_table
  lstbl   list_tables
  add     add_column
  lscol   list_columns
  ld      load_table
  tblInUse  table_inuse
  sel     select_table
  dump    dump_table
  cp      copy_table
  ex      export_table
  sz      size_table
  tr      truncate_table
  rettbl  return_table
  rmtbl   drop_table

Dictionary Requests:

  cf      cf ..
          cf ~
          cf
  pwf     pwf
  lf      lf

Misc Requests:

  seitf   seitf_count
  mon     get_monitor
  ping    ping
  x       x

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

: <ERROR> dup error.msg swap 2 ddlLock.testDrop ;
: <NIP+ERROR> nipAll dup error.msg swap 2 ddlLock.testDrop ;

: <SUCCESS> 0 2 ddlLock.testDrop ;

: <OK> "<ok>" 0 2 ddlLock.testDrop ;

: checkEnoughBuffers
   freeBuffers 100 > if true exit then
   EC_LOW_BUFFERS false
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
: create_tenant ( "<tenantNm>" -- <R> )

ddlLock.grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeTenant    not if <NIP+ERROR> exit then

  dup          ( "<tenantNm>" "<tenantNm>" )
  ~makeTenant  ( "<tenantNm>" )
  makeCatalogs ( )

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tenants                                                        */
/*----------------------------------------------------------------------------*/
: list_tenants ( -- <R> )

ddlLock.grabRead

  checkInTenants not if <ERROR> exit then

  contentsString

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
: drop_tenant ( "<tenantNm>" -- <R> )

ddlLock.grabWrite

  checkRemoveTenant not if <NIP+ERROR> exit then

  ~removeTenant

  <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a catalog                                                           */
/*----------------------------------------------------------------------------*/
: create_catalog ( "<catalogNm>" -- <R> )

ddlLock.grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeCatalog   not if <NIP+ERROR> exit then

  dup
  makeCatalog assert
  makeSchemas

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of catalogs                                                       */
/*----------------------------------------------------------------------------*/
: list_catalogs ( -- <R> )

ddlLock.grabRead

    checkInCatalogs not if <ERROR> exit then

    contentsString

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a catalog                                                             */
/*----------------------------------------------------------------------------*/
: drop_catalog ( "<catalogNm>" -- <R> )

ddlLock.grabWrite

  checkRemoveCatalog not if <NIP+ERROR> exit then

  removeCatalog drop

  <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a schema                                                            */
/*----------------------------------------------------------------------------*/
: create_schema ( "<schemaNm>" -- <R> )

ddlLock.grabWrite

//    checkEnoughBuffers not if swap drop <ERROR> exit then
//    checkInSchemas     not if swap drop <ERROR> exit then
//    checkIsNotSchema   not if swap drop <ERROR> exit then

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeSchema    not if <NIP+ERROR> exit then

  dup
  makeSchema assert
  makeTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of schemas                                                        */
/*----------------------------------------------------------------------------*/
: list_schemas ( -- <R> )

ddlLock.grabRead

    checkInSchemas not if <ERROR> exit then

    contentsString

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* drop a schema                                                              */
/*----------------------------------------------------------------------------*/
: drop_schema ( "<schemaNm>" -- <R> )

ddlLock.grabWrite

  checkRemoveSchema not if <NIP+ERROR> exit then

  removeSchema drop

  <OK>
;

/*----------------------------------------------------------------------------*/
/* use a schema                                                               */
/*----------------------------------------------------------------------------*/
: use_schema ( "<schemaNm>" -- <R> )

    begin 0 dic.pick dic.name "tenants" streql not while dic.drop repeat

    // find the boray folder
    "boray" findInCurrent
    execute dic.push

    // find the catalogs folder
    "catalogs" findInCurrent
    execute dic.push

    // find the rapidssecatalogs folder
    "rapidsse" findInCurrent
    execute dic.push

    // find the schemas folder
    "schemas" findInCurrent
    execute dic.push

    checkIsWord not if drop EC_NO_SUCH_SCHEMA <ERROR> exit then
    checkIsSchema not if swap drop <ERROR> exit then
    execute dic.push

    // find the tables folder
    "tables" findInCurrent
    execute dic.push

    <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

//    checkEnoughBuffers not if swap drop <ERROR> exit then
//    checkInTables      not if swap drop <ERROR> exit then
//    checkIsNotTable    not if swap drop <ERROR> exit then

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeTable     not if <NIP+ERROR> exit then

  dup
  makeTable assert
  makeColumns

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables ( -- <R> )

ddlLock.grabRead

    checkInTables not if <ERROR> exit then

    contentsString

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

    checkInTables not if rot drop drop <ERROR> exit then

    //freespace .

    checkIsTable not if swap drop <ERROR> exit then

    execute ( "filename" table )

    tableLoader not if <ERROR> exit then

    //freespace .

    <OK>
;

/*----------------------------------------------------------------------------*/
/* load a table from a stream                                                 */
/*----------------------------------------------------------------------------*/
: load_table_stream ( "<fileNm>" "<tableNm>" -- <R> )

  ddlLock.grabRead

  checkInTables not if rot drop drop <ERROR> exit then

  //freespace .

  checkIsTable not if swap drop <ERROR> exit then

  execute ( "filename" table )

  tableLoaderStream2 not if <ERROR> exit then

  //freespace .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

    checkInTables not if rot drop drop <ERROR> exit then

    checkIsTable not if swap drop <ERROR> exit then

    execute ( "filename" table )

    tableExporter not if <ERROR> exit then

    <OK>
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- <R> )

ddlLock.grabRead

    freespace .

    checkEnoughBuffers not if swap drop <ERROR> exit then
    checkInTables      not if rot drop drop <ERROR> exit then

    checkIsTable not if swap drop <ERROR> exit then

    execute        ( "<to-tableNm>" ^fromTable )

    swap           ( ^fromTable "<to-tableNm>" )

    :table execute ( ^fromTable ^toTable )

//    swap           ( ^toTable ^fromTable )

    tableCopier

freespace .

    <OK>
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dump_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if swap drop <ERROR> exit then

  checkIsTable not if <ERROR> exit then

  execute ( table )

  rowDump

  <OK>
;

/*----------------------------------------------------------------------------*/
/* append row buffer into table                                               */
/*----------------------------------------------------------------------------*/
: table_append ( "table", "buffer", "partition" -- <R> )

ddlLock.grabRead

  table.append

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

    checkInTables not if swap drop  <ERROR> exit then

    checkIsTable not if <ERROR> exit then

    execute ( table )

    table.space >str

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get row cursor for table                                                   */
/*----------------------------------------------------------------------------*/
: select_table ( "<tableNm>" -- <R> )

/*
ddlLock.grabRead

    checkInTables not if swap drop  <ERROR> exit then

    checkIsTable not if <ERROR> exit then

    queryCount ++

    execute ( table )

    rowcursor.new dup rot rowcursor.table!

    >str

    <SUCCESS>
*/

ddlLock.grabRead

    getTableRef not if swap drop <ERROR> exit then

    queryCount ++

    task.this task.seitf@ seitf.table@

    rowcursor.new dup rot rowcursor.table!

    >str

    <SUCCESS>

;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

    checkInTables not if swap drop  <ERROR> exit then

    checkIsTable not if <ERROR> exit then

    execute ( table )

    table.truncate

    <OK>
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

dup ( "<tableNm>" "<tableNm>" )

    checkRemoveTable not if <NIP+ERROR> exit then



    // checkInTables not if swap drop  <ERROR> exit then

    checkIsTable not if <ERROR> exit then

    dup execute dup

    tableInUse if drop drop EC_TABLE_IN_USE <ERROR> exit then

    ( "<tableNm>" ^w:table ^table ) tp

    drop drop ( "<tableNm>" ) tp




    removeTable assert

    <OK>
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: table_inuse ( "<tableNm>" -- <R> )

    checkInTables not if swap drop  <ERROR> exit then

    checkIsTable not if <ERROR> exit then

    execute ( table )

    tableInUse not if "Table not in use" . <OK> exit then

    "Table in Use" .

   <OK>
;

/*----------------------------------------------------------------------------*/
/* get a table                                                                */
/*----------------------------------------------------------------------------*/
: get_table ( "<tableNm>" -- <R> )

    getTableRef not if <ERROR> exit then

    <OK>
;

/*----------------------------------------------------------------------------*/
: return_table ( )

    returnTableRef not if <ERROR> exit then

    <OK>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column ( "<columnTy>" "<columnNm>" "<tableNm>" -- <R> )

    checkInTables not if swap drop rot drop drop <ERROR> exit then

    pushTable not if swap drop rot drop drop <ERROR> exit then

    pushColumns not if swap drop rot drop drop <ERROR> exit then

    addColumn not if swap drop rot drop drop <ERROR> exit then

    popColumns

    popTable

    <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<tableNm>" -- <R> )

    checkInTables not if swap drop <ERROR> exit then

    pushTable not if swap drop <ERROR> exit then

    pushColumns not if swap drop <ERROR> exit then

    listColumns

    popColumns

    popTable

    <SUCCESS>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* change folder                                                              */
/*----------------------------------------------------------------------------*/
: cf

    dup ".." streql if
      drop
      0 dic.pick dic.name "tenants" streql not if dic.drop then
    else
      dup "~" streql if
        drop
        begin 0 dic.pick dic.name "tenants" streql not while dic.drop repeat
      else
        dup "tenants" streql if
          begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
          checkIsWord not if <ERROR> exit then
          execute dic.push
        else
          find
          checkIsDic not if <ERROR> exit then
          execute dic.push
        then
      then
    then

    <OK>
;


/*----------------------------------------------------------------------------*/
/* print working folder                                                       */
/*----------------------------------------------------------------------------*/
: pwf

    "/"
    dic.count 2 do
      dic.count 1 - I -
      dic.pick dic.name concat
      "/" concat
    loop

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf

    ""
    word.this dup iterate

      dup strlen if "\n" concat then

      object@ word.name 12 strpad concat

      "(" concat

      object@ isTable if
        "table " concat
        object@ execute table.space bytes.magnitude concat
      then

      object@ isFolder if
        object@ execute dic.kind@ word.name concat
      then

      ")" concat

      object@ prevWord object!

    next

//    128 clip

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* get free space in the pool                                                 */
/*----------------------------------------------------------------------------*/
: getFreeSpace ( -- <R> )

  freeSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get inUse space in the pool                                                */
/*----------------------------------------------------------------------------*/
: getInUseSpace ( -- <R> )

  inUseSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get total space in the pool                                                */
/*----------------------------------------------------------------------------*/
: getTotalSpace ( -- <R> )

  totalSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get seif count                                                             */
/*----------------------------------------------------------------------------*/
: seitf_count

  seitf.count

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* get monitor string                                                         */
/*----------------------------------------------------------------------------*/
: get_monitor ( -- <R> )

    monitorString@

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping ( -- <R> )

    "pong"

    <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* docol_command                                                              */
/*----------------------------------------------------------------------------*/
: docol_command ( "command" -- <R> )

    checkIsWord not if <ERROR> exit then
    execute

    begin
     depth while drop
    repeat

   <OK>
;

/*----------------------------------------------------------------------------*/
/* get_version                                                                */
/*----------------------------------------------------------------------------*/
: get_version ( -- <R> )

  version

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x                                                     //! GET RID OF THIS WORD
    words

    "x"

    <SUCCESS>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* create /tenants/boray/catalogs/rapidsse                                    */
/*----------------------------------------------------------------------------*/
: createDefaultFolders ( )

  // find the tenants folder
  "tenants" findInCurrent
  execute dic.push

  // create tenant boray (and catalogs sub-folder)
  "boray" makeTenant$ assert
  "boray" makeCatalogs

  // find the boray folder
  "boray" findInCurrent
  execute dic.push

  // find the catalogs folder
  "catalogs" findInCurrent
  execute dic.push

  // create catalog rapidsse
  "rapidsse" makeCatalog assert
  "rapidsse" makeSchemas

  // go back to main dictionary
  dic.drop dic.drop dic.drop

  assert.stack_0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
