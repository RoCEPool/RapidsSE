// this is C_TDEF_ANALYZEINDEX
create table definition __analyzeIndex (
  nodeName       VARCHAR NOT NULL,
  partition      INTEGER NOT NULL,
  buffers        INTEGER NOT NULL,
  entries        INTEGER NOT NULL
);

// this is C_TDEF_ANALYZETABLE
create table definition __analyzeTable (
  nodeName       VARCHAR NOT NULL,
  partition      INTEGER NOT NULL,
