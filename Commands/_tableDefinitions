/*============================================================================*/
/* _tableDefinitions -- create SE system table definitions                    */
/*============================================================================*/

Print "Creating System Table Definitions";

// this is C_TDEF_GRIDSANITY
create table definition __gridSanity (
  nodeName   VARCHAR NOT NULL,
  homogenous BOOLEAN NOT NULL
);

// this is C_TDEF_LISTCOLUMNS
create table definition __listColumns (
  columnNo       INTEGER NOT NULL,
  columnName     VARCHAR NOT NULL,
  columnType     VARCHAR NOT NULL,
  columnLength   INTEGER NOT NULL,
  columnScale    INTEGER NOT NULL,
  isNullable     BOOLEAN NOT NULL,
  isPartitionKey BOOLEAN NOT NULL
);
// this is C_TDEF_LISTCONTENTS
create table definition __listContents (
Name       VARCHAR NOT NULL
);

// this is C_TDEF_LISTFOLDER
create table definition __listFolder (
Name       VARCHAR NOT NULL,
Type       VARCHAR NOT NULL
);

// this is C_TDEF_LISTINDEX
create table definition __listIndex (
  indexName    VARCHAR NOT NULL,
  isUnique     BOOLEAN NOT NULL,
  isPrimaryKey BOOLEAN NOT NULL
);

// this is C_TDEF_LOCKSTATS
create table definition __lockStats (
  nodeNo         INTEGER     NOT NULL,
  takeNo         INTEGER     NOT NULL,

  lockNo         INTEGER     NOT NULL,
  lockNm         VARCHAR(32) NOT NULL,

  readGrab       INTEGER     NOT NULL,
  readCollision  INTEGER     NOT NULL,
  readPercent    INTEGER     NOT NULL,

  writeGrab      INTEGER     NOT NULL,
  writeCollision INTEGER     NOT NULL,
  WritePercent   INTEGER     NOT NULL
);

// this is C_TDEF_NODEINFO
create table definition __nodeInfo (
  nodeName       VARCHAR NOT NULL,
  regionSize     INTEGER NOT NULL,
  partitionCount INTEGER NOT NULL
);

// this is C_TDEF_PINGINFO
create table definition __pingInfo (
  pong      VARCHAR NOT NULL
);

// this is C_TDEF_PROGRESSUNITS
create table definition __progressUnits (
  units      INTEGER NOT NULL
);

// this is C_TDEF_PWF
create table definition __pwf (
  folder   VARCHAR NOT NULL
);

// this is C_TDEF_SEEKOFFSETS
create table definition __seekOffsets (
  offset INTEGER NOT NULL,
  size   INTEGER NOT NULL
);

// this is C_TDEF_SHOWCLUSTER
create table definition __showCluster (
  NodeNo    INTEGER NOT NULL,
  NodeName  VARCHAR NOT NULL,
  IPAddress VARCHAR NOT NULL,
  PortNo    INTEGER NOT NULL,
  Connected BOOLEAN NOT NULL
);

// this is C_TDEF_SPACE
create table definition __space (
  nodeName   VARCHAR NOT NULL,
  totalSpace INTEGER NOT NULL,
  inUseSpace INTEGER NOT NULL,
  freeSpace  INTEGER NOT NULL
);

// this is C_TDEF_TOTALUNITS
create table definition __totalUnits (
  UNITS      INTEGER NOT NULL
);

