/*============================================================================*/
/* copier.sen -- table copier                                                 */
/*============================================================================*/

"copier.sen" .

: copy ( ^fromTable ^toTable )

  swap
  >r >r
  // r0 ^toTable
  // r1 ^fromtable

  "row_cursor" find dup if else
    drop "row_cursor" :rowCursor
  then
  execute

  >r

  // r0 ^rowCursor
  // r1 ^toTable
  // r2 ^fromTable

  r2 r0 rowcursor.table!

  beginTransaction

  partitions 0
  do
    // r2 ^rowCursor
    // r3 ^toTable
    // r4 ^fromTable

    I r2 rowcursor.begin
    r2 rowcursor.first

    begin
      while
      //r2 rowcursor.get .
      r2 rowcursor.get r3 table.insert
      r2 rowcursor.next
    repeat

    r2 rowcursor.end
  loop

  commitTransaction

  // r0 ^rowCursor
  // r1 ^toTable
  // r2 ^fromTable

  rdrop rdrop rdrop

  true
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/