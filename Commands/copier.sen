/*============================================================================*/
/* copier.sen -- table copier                                                 */
/*============================================================================*/

"copier.sen" .

: copy ( ^fromTable ^toTable )

  swap
  >r >r
  // r0 ^toTable
  // r1 ^fromtable

  "row_cursor" find dup if else
    drop "row_cursor" :rowCursor
  then
  execute

  >r

  // r0 ^rowCursor
  // r1 ^toTable
  // r2 ^fromTable

  r2 r0 rowcursor.table!

  beginTransaction >r
  // r0 ^txRefCursor
  // r1 ^rowCursor
  // r2 ^toTable
  // r3 ^fromTable

  partitions 0
  do
    // r0 partition
    // r1 partitions
    // r2 ^txRefCursor
    // r3 ^rowCursor
    // r4 ^toTable
    // r5 ^fromTable

    I r3 rowcursor.begin
    r3 rowcursor.first

    begin
      while
      r0 r3 rowcursor.get r2 r4 table.insert
      r3 rowcursor.next
    repeat

    r3 rowcursor.end
  loop

  commitTransaction

  // r0 ^txRefCursor
  // r1 ^rowCursor
  // r2 ^toTable
  // r3 ^fromTable

  rdrop rdrop rdrop rdrop

  true
;

: tableCopier

    copy if "copied!" . else . then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/