/*============================================================================*/
/* column.sen -- column related words                                         */
/*============================================================================*/

"column.sen" .putVerbose

: column: ;

//: makeColumns ( table --  ) table.dic {{ "columns" :dic drop }} ;

: makeColumns ( "<tableNm>" -- )

  find execute ( dic )
  table.dic {{ "columns" :dic drop }}
;

: withinColumns
    0 dic.pick dic.name "columns" streql
;

: checkInColumns
    withinColumns if true exit then
    EC_NOT_IN_COLUMNS false
;

: pushColumns ( -- )

    "columns" checkIsWord

    not if EC_NO_COLUMNS_DIC false exit then

    execute dic.push

    true
;

: popColumns
    dic.drop
;

: :column ( "<columnType>" "<columnName>" )

    :constant
;

: addColumn ( "<columnType>" "<columnName" -- <result> )

    :column

    true
;

: listColumns ( -- )

    ""                             // initial ls string
    0 dic.pick dic.last            // get last word of current dic
    dup                            // setup iteration of words
    iterate                        //

      object@ word.name            // column name

      " " concat
      object@ execute concat       // column type

      swap

      dup strlen
      if " , " swap concat then    //

      concat                       // prepend column to ls

      object@ prevWord object!     // step backwards thru words

    next                           //

    //"\n" concat

;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
