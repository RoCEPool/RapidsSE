/*============================================================================*/
/* core.sen -- additional high-level core words                               */
/*============================================================================*/

"core.sen" .

/*----------------------------------------------------------------------------*/
/* list all words in the current dictionary                                   */
/*----------------------------------------------------------------------------*/
: words_old
   word.this
   begin
     dup while dup nameWord .put " " .put prevWord
   repeat
   drop .\n
;

: words
    word.this iterate              // iterate word cursor
      cursor@ word.name .          // print the name of the word
      cursor@ prevWord dup cursor! // advance cursor backwards thru words
    next
;

/*----------------------------------------------------------------------------*/
/* list all words (long form) in the current dictionary                       */
/*----------------------------------------------------------------------------*/
: symbols
    word.this
    begin dup while
      dup nameWord .put " " .put dup word.kind@ nameword .put .\n
      prevWord
    repeat
    drop
;

/*----------------------------------------------------------------------------*/
/* get all words in the current dictionary as a single string                 */
/*----------------------------------------------------------------------------*/
: contents_string

    ""                             // initial contents string
// "(" concat                     //
    word.this dup iterate          // setup iteration of words
      object@ word.name concat     // add name of the word to contents string
                                   // add word kind to ls string
      " " concat                   //
      object@ prevWord object!     // step backwards thru words
    next                           //
//    ")" concat                     //

;

/*----------------------------------------------------------------------------*/
/* dump the parameter stack                                                   */
/*----------------------------------------------------------------------------*/
: stk
    "parameter stack" .
    p.depth dup not if drop exit then 0 do I pick dump loop
;

/*----------------------------------------------------------------------------*/
/* dump the return stack                                                      */
/*----------------------------------------------------------------------------*/
: rstk
    "return stack" .
    rstack.depth dup not if drop exit then
    0 do I 2 + r@ dup .put " ".put locate .put .\n loop
;

/*----------------------------------------------------------------------------*/
/* define a constant                                                          */
/*----------------------------------------------------------------------------*/
: constant create , does> ;

/*----------------------------------------------------------------------------*/
/* increment integer on stack                                                 */
/*----------------------------------------------------------------------------*/
: inc 1 + ;

: ++ dup @ 1 + swap ! ;

/*----------------------------------------------------------------------------*/
/* increment integer on stack twice                                           */
/*----------------------------------------------------------------------------*/
: incinc inc inc ;

/*----------------------------------------------------------------------------*/
/* decrement integer on stack                                                 */
/*----------------------------------------------------------------------------*/
: dec 1 - ;

/*----------------------------------------------------------------------------*/
/* interpret string on stack                                                  */
/*----------------------------------------------------------------------------*/
: >: input.push input.text docol input.pop ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/