/*============================================================================*/
/* core.sen -- additional high-level core words                               */
/*============================================================================*/

"core.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* define a constant                                                          */
/*----------------------------------------------------------------------------*/
: constant
create
,
//    does>
;

: :constant
>create
,
//    does>
;

//"errorCodes.sen" >>:

/*----------------------------------------------------------------------------*/
/* list all words in the current dictionary                                   */
/*----------------------------------------------------------------------------*/
: words
    word.this dup iterate          // iterate word cursor
      object@ word.name .          // print the name of the word
      object@ prevWord object!     // advance cursor backwards thru words
    next
;

/*----------------------------------------------------------------------------*/
/* list all words (long form) in the current dictionary                       */
/*----------------------------------------------------------------------------*/
: symbols
    word.this
    begin dup while
      dup nameWord .put " " .put dup word.kind@ nameword .put .\n
      prevWord
    repeat
    drop
;

/*----------------------------------------------------------------------------*/
/* get all words in the current dictionary as a single string                 */
/*----------------------------------------------------------------------------*/
: contentsString

    ""                             // initial contents string
// "(" concat                     //
    word.this dup iterate          // setup iteration of words
      object@ word.name concat     // add name of the word to contents string
                                   // add word kind to ls string
      " " concat                   //
      object@ prevWord object!     // step backwards thru words
    next                           //
//    ")" concat                     //

;

/*----------------------------------------------------------------------------*/
/* dump the parameter stack                                                   */
/*----------------------------------------------------------------------------*/
: stk
    "parameter stack" .
    depth dup not if drop exit then
    0 do I pick dump loop
;

/*----------------------------------------------------------------------------*/
/* dump the return stack                                                      */
/*----------------------------------------------------------------------------*/
: rstk

  "return stack" .
  rdepth dup not if drop exit then
  0 do
    I 2 + rpick
    dup .put
    " ".put
    locate
    dup if .put else drop then
    .\n
  loop
;

/*----------------------------------------------------------------------------*/
/* increment integer on stack                                                 */
/*----------------------------------------------------------------------------*/
: inc 1 + ;

: ++ dup @ 1 + swap ! ;

/*----------------------------------------------------------------------------*/
/* increment integer on stack twice                                           */
/*----------------------------------------------------------------------------*/
: incinc inc inc ;

/*----------------------------------------------------------------------------*/
/* decrement integer on stack                                                 */
/*----------------------------------------------------------------------------*/
: dec 1 - ;

/*----------------------------------------------------------------------------*/
/* interpret string on stack                                                  */
/*----------------------------------------------------------------------------*/
: >: input.push input.text docol input.pop ;

/*----------------------------------------------------------------------------*/
/* check for known word                                                       */
/*----------------------------------------------------------------------------*/
: checkIsWord ( <"wordNm"> )
    find
    dup not if drop EC_NO_SUCH_WORD false exit then
    true
;

/*----------------------------------------------------------------------------*/
/* forget named word                                                          */
/*----------------------------------------------------------------------------*/
: :forget ( <"wordNm"> )

  find ( word )

  dup not if drop exit then ( )

  >forget ( )
;

/*----------------------------------------------------------------------------*/
/* drop all values on stack except topmost                                    */
/*----------------------------------------------------------------------------*/
: nipAll ( ... top -- top )

  // handle expty stack case
  depth not if exit then

  // save topmost
  >r

  // drop everything else
  begin
    depth while
      drop
  repeat

  // restore topmost
  r>
;

"dic.sen" >>:
"var.sen" >>:
"useful.sen" >>:

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
