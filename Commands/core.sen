/*============================================================================*/
/* core.sen -- additional high-level core words                               */
/*============================================================================*/
"core.sen" .

: words word.this begin dup while dup nameWord .put " " .put prevWord repeat drop .\n ;

: symbols
    word.this
    begin dup while
      dup nameWord .put " " .put dup word.kind@ nameword .put .\n
      prevWord
    repeat
    drop
;

: stk p.depth dup not if drop exit then 0 do I pick dump loop ;

( : rstk rstack.depth dup not if drop exit then 0 do I 2 + r@ dup .put " ".put locate .put .\n loop ; )

: rstk rstack.depth dup not if drop exit then 0 do I 2 + r@ dup .put " ".put locate .put .\n loop ;

: +looptest 10 0 do I . 2 +loop ;

: constant create , does> ;

: inc 1 + ;

: incinc inc inc ;

: dec 1 - ;

: >: input.push input.text docol input.pop ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/