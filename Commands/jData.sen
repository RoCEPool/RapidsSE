/*============================================================================*/
/* jData.sen -- generate jTest data                                           */
/*============================================================================*/

"jData.sen" .verbose

: >DigitWords

  >str ""            ( "TBD"  "<dw>"        )

  0 >r
  begin               ( "TBD"  "<dw>"        )
    swap              ( "<dw>" "TBD"         )
    dup               ( "<dw>" "TBD" "TBD"   )
    str.length        ( "<dw>" "TBD" l       )
    while             ( "<dw>" "TBD"         )
      dup             ( "<dw>" "TBD"  "TBD"  )
      1 0 str.sub     ( "<dw>" "TBD"  "<d>"  )
      swap            ( "<dw>" "<d>"  "TBD"  )
      1 neg 1 str.sub ( "<dw>" "<d>"  "BD"   )
      -rot            ( "BD"   "<dw>" "<d>"  )
      >int            ( "BD"   "<dw>" d      )
      >digitName      ( "BD"   "<dw>" "name" )

      r> dup 1+ >r
      if swap " " str.cat swap then

      str.cat         ( "BD"   "<dw>"        )
  repeat
  drop                ( "<dw>"               )
  rdrop
;

: jData1000

  file.new >r

  "../JTEST/j1000.csv" r0 file.path!

  OPEN_WRITE r0 file.open not if "file not opened" . exit then

  1000 0
  do
    I >str          r2 file.write
    "|"             r2 file.write
    I >DigitWords   r2 file.write
    "|"             r2 file.write
    I 100 % >str    r2 file.write
    "|"             r2 file.write
    I 10 % >str     r2 file.write
    "\n"            r2 file.write
  loop

  r0 file.close

  rdrop
;

: jData100

  file.new >r

  "../JTEST/j100.csv" r0 file.path!

  OPEN_WRITE r0 file.open not if "file not opened" . exit then

  100 0
  do
    I >str          r2 file.write
    "|"             r2 file.write
    I >DigitWords   r2 file.write
    "|"             r2 file.write
    I 10 % >str     r2 file.write
    "\n"            r2 file.write
  loop

  r0 file.close

  rdrop
;

: jData10

  file.new >r

  "../JTEST/j10.csv" r0 file.path!

  OPEN_WRITE r0 file.open not if "file not opened" . exit then

  10 0
  do
    I >str          r2 file.write
    "|"             r2 file.write
    I >DigitWords   r2 file.write
    "\n"            r2 file.write
  loop

  r0 file.close

  rdrop
;

: jData

  jData1000
  jData100
  jData10
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
