/*============================================================================*/
/* txCollection.sen -- Transaction Collection                                 */
/*============================================================================*/

"txCollection.sen" .putVerbose

: txCollection:
    create
    WT_OBJECT word.this word.type!
    sizeof_txcollection allot
    word.this >body magic!!
    word.this >body CN_TXCOLLECTION class!
    word.this >body txCollection.init
    word.this >body object.wordbody
    does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
