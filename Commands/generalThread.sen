/*============================================================================*/
/* generalThread.sen -- general processing thread                             */
/*============================================================================*/

"generalThread.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

taskset: generalTaskSet

thread:  generalThread

/*----------------------------------------------------------------------------*/
/* start the general processing thread                                        */
/*----------------------------------------------------------------------------*/
: generalThreadStart

    // set up the general processing thread
    generalTaskSet  generalThread  thread.taskset!
    "generalThread" generalThread  thread.name!
                    generalThread  thread.spawn
;

/*----------------------------------------------------------------------------*/
/* child test                                                                 */
/*----------------------------------------------------------------------------*/
: childTest

  "childTest" .

// task.parentTask task.notify

   TS_EXITED task.this task.state!
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/