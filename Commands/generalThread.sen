/*============================================================================*/
/* generalThread.sen -- general processing thread                             */
/*============================================================================*/

"generalThread.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

taskset: generalTaskSet

thread:  generalThread

/*----------------------------------------------------------------------------*/
/* start the general processing thread                                        */
/*----------------------------------------------------------------------------*/
: generalThreadStart

    // set up the general processing thread
    generalTaskSet  generalThread  thread.taskset!
    "generalThread" generalThread  thread.name!
                    generalThread  thread.spawn
;

/*----------------------------------------------------------------------------*/
/* child test                                                                 */
/*----------------------------------------------------------------------------*/
: childTest

  "childTest" .

// task.parentTask task.notify

   TS_EXITED task.this task.state!
;

/*----------------------------------------------------------------------------*/
/* signal/mutex testing                                                       */
/*----------------------------------------------------------------------------*/
: mutexLock
traceOn

  "mutexLock" .

  task.this task.thread thread.mutexLock

traceOff
;

: mutexUnlock
traceOn

  "mutexUnlock" .

  task.this task.thread thread.mutexUnlock

traceOff
;

: condWait
traceOn

  "condWait" .

  mutexLock
  task.this task.thread thread.condWait
  mutexUnlock

traceOff
;

: condSignal
traceOn

  "condSignal" .

  task.this task.thread thread.condSignal

traceOff
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/