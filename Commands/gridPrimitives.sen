/*============================================================================*/
/* gridPrimitives.sen -- grid testing                                         */
/*============================================================================*/

"gridPrimitives.sen" .putVerbose

: SE_PATH "../OS\ X/Build/Products/Debug/SE" ;

: se_command

    dup

//  "nohup "
    ""
    SE_PATH concat
    " --start --restart --size 4gb " concat
    " --commands /Users/ray/Desktop/rapidsse/Commands" concat
    " --region /SE_" concat
    swap >str concat

    " --node " concat
    swap >str concat

    " --nodes 8" concat

    " &" concat
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: g

  1 se_command dup . shell.execute .
  2 se_command dup . shell.execute .
  3 se_command dup . shell.execute .
  4 se_command dup . shell.execute .
  5 se_command dup . shell.execute .
  6 se_command dup . shell.execute .
  7 se_command dup . shell.execute .
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: gn

  args.nodes 1 do
    I se_command
    dup .
    shell.execute .
  loop
  
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipcChild

  3 sleep

//traceon

  "ipcChild" task.this task.name!

  "ipcChild" .

  task.parent@ task.signal
//traceoff
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipc

//traceon

  3 task.this task.acks!

  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append

  //TS_WAITING task.this task.state!

  task.suspend

  "Parent" .
//traceoff
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* pop indirect valset from queue                                             */
/*----------------------------------------------------------------------------*/
: queue> ( -- valset )

  begin
    task.this task.queue@ queue.pop
    dup not if task.yield /*100 thread.sleep_us*/ then
  until
;

/*----------------------------------------------------------------------------*/
/* convert valset to indirect call                                            */
/*----------------------------------------------------------------------------*/
: >indirect ( valset -- ... wordName ; reg0 == caller )

  valset>  // expand valset into stack values ( ... wordName caller #args )
  drop     // discard the args                ( ... wordName caller )
  >reg0    // put caller into reg0            ( ... wordName )
;

/*----------------------------------------------------------------------------*/
/* execute indirect call on the stack                                         */
/*----------------------------------------------------------------------------*/
: !indirect ( ... wordName -- ... )

  find execute
;

/*----------------------------------------------------------------------------*/
/* convert values on stack into a result valset                               */
/*----------------------------------------------------------------------------*/
: >result ( ... -- valset )

  depth >valset
;

/*----------------------------------------------------------------------------*/
/* push valset onto invoking tasks stack and signal caller                    */
/*----------------------------------------------------------------------------*/
: >caller ( valset -- ; caller -- valset )

  begin reg0 task.state@ TS_WAITING == until

  reg0 >stack

  reg0 task.signal
;

/*----------------------------------------------------------------------------*/
/* put request onto queue for processing, suspend for notification            */
/*----------------------------------------------------------------------------*/
: >queue> ( ... wordName #args queue -- result )

  >r                       // save target queue onto rstack

  1 task.this task.acks!   // will wait for 1 ack

  task.this                // this task is the caller

  swap                     // bring #args to top

  1 +                      // valset will be ( args, wordname, caller )

  >valset                  // convert stack values to valset

  r>                       // restore target queue onto stack

  queue.append             // pop valset and append to target queue

  task.suspend             // this task suspends

  valset>                  // convert valset to stack values

  drop                     // discard number of values
;

//------------------------------------------------------------------------------

: >queue2> ( ... wordName #args queue -- result )

  >r                       // save target queue onto rstack

  task.this                // this task is the caller

  swap                     // bring #args to top

  1 +                      // valset will be ( args, wordname, caller )

stk
  >valset                  // convert stack values to valset
stk

  r>                       // restore target queue onto stack

  queue.append             // pop valset and append to target queue
;

/*----------------------------------------------------------------------------*/
/* actor formation                                                            */
/*----------------------------------------------------------------------------*/
: actorForm ( ... #args "<loop>" "<actorName>" -- queue )

  reg.push

  >r

  // r0 has <actorName>

  r0 ".task"    concat dup . :task    execute >reg0  // reg0 has task
  r0 ".queue"   concat dup . :queue   execute >reg1  // reg1 has queue
  r0 ".taskset" concat dup . :taskset execute >reg2  // reg2 has taskset
  r0 ".thread"  concat dup . :thread  execute >reg3  // reg3 has thread

  // seed the task
  reg0 task.seed

  // attach queue to task
  reg1 reg0 task.queue!

  // put task in taskset
  reg0 reg2 taskset.append

  // attach taskset to thread
  reg2 reg3 thread.taskset!

  // spawn the os thread
  reg3 thread.spawn

  rdrop

  // leave queue on stack
  reg1

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* execute processing loop                                                    */
/*----------------------------------------------------------------------------*/
: execute.loop

  reg.push

  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack

    >indirect  // convert valset to indirect call

    //stk
    !indirect  // execute indirect call
    //stk

    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* pass on loop                                                               */
/*----------------------------------------------------------------------------*/
: passOn.loop ( actorNo queue -- )

  reg.push

  >r
  >r
  // r0 has actorNo
  // r1 has queue
  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack
    >indirect  // convert valset to indirect call; reg0 has caller

    //stk
    depth r1 >queue>
    //stk

    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  rdrop
  rdrop

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* pointer arrays                                                             */
/*----------------------------------------------------------------------------*/

args.nodes intArray: ddlInts
args.nodes ptrArray: ppQueues
args.nodes ptrArray: cpQueues
args.nodes ptrArray: pQueues

/*----------------------------------------------------------------------------*/
/* grab ddl lock n                                                            */
/*----------------------------------------------------------------------------*/
: grabDDL_n ( n -- true|false )

  dup                ( n n )

  ddlInts @          ( n v )

  if                 ( n )

   drop              ( )
   false             ( false )

  else               ( n )

   // put 1 into ddlInts[n]

   1                 ( n 1 )
   swap              ( 1 n )
   ddlInts !         ( )
   true              ( true )
  then
;

/*----------------------------------------------------------------------------*/
/* drop ddl lock n                                                            */
/*----------------------------------------------------------------------------*/
: dropDDL_n ( n -- true )

  // put 0 into ddlInts[n]

  0          ( n 0 )
  swap       ( 0 n )
  ddlInts !  ( )

  true       ( true )
;

////////////////////////////////////////////////////////////////////////////////

: createActors

  args.nodes 0 do
    0 I ddlInts !
  loop

  args.nodes 0 do

    // create the participant for this I
    0 "execute.loop" "p" I >str concat actorForm
    I pQueues !

    // create the coordinator proxy for this I
    I I pQueues @ 2 "passOn.loop" "cp" I >str concat actorForm
    I cpQueues !

    // create the partitipant proxy for this I
    I args.node == if
      I I pQueues  @ 2 "passOn.loop" "pp" I >str concat actorForm
      I ppQueues !
    else
      I I cpQueues @ 2 "passOn.loop" "pp" I >str concat actorForm
      I ppQueues !
    then

  loop

  // coordinator
  0 "execute.loop" "c" actorForm drop
;


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distributed pattern test                                                   */
/*----------------------------------------------------------------------------*/
/*
: d

  args.nodes 0 do
    0 I ddlInts !
  loop

  0 grabDDL_n . 0 ddlInts @ .
  0 dropDDL_n . 0 ddlInts @ .

  1 sleep

  "xyz" "-PONG" "concat" 3
stk
  c.queue >queue> .
stk

;
*/

////////////////////////////////////////////////////////////////////////////////

createActors

/*----------------------------------------------------------------------------*/
/* dispatch indirect call to given participant                                */
/*----------------------------------------------------------------------------*/
: dispatch ( ... #args actorNo -- ..result.. )

  // determine which queue to forward to
  dup args.node == if

    // queue will be the participant for this node
    pQueues @    ( ... #args queue )

  else

    // queue will be participant proxy for other node
    ppQueues @   ( ... #args queue )

  then

  // transfer to another actors queue and wait for result
  >queue>        ( ..result.. )
;

/*----------------------------------------------------------------------------*/
/* grab distributed ddl lock                                                  */
/*----------------------------------------------------------------------------*/
: grabDistDDL ( -- true )

  // dispatch grab of lock 0 to node 0

  begin
    0            // participant is to grab lock 0
    "grabDDL_n"  // the word to execute
    2            // there are 2 args now on stack
    0            // dispatch to node 0
                 ( 0 "grabDDL_n" 2 0 )

    dispatch     // send indirect call to node 0

                 ( true | false )
  until

  // dispatch grab of lock I to all other nodes

  args.nodes 1 do
    I            // participant is to grab lock I
    "grabDDL_n"  // the word to execute
    2            // there are 2 args now on stack
    I            // dispatch to node I
                 ( I "grabDDL_n" 2 I )

    dispatch     // send indirect call to node I

    .            // just print the indirect result for the moment

  loop

  true           ( true )
;

/*----------------------------------------------------------------------------*/
/* drop distributed ddl lock                                                  */
/*----------------------------------------------------------------------------*/
: dropDistDDL ( -- true )

  // dispatch drop to all other nodes

  args.nodes 1 do
    I            // participant is to drop lock 0
    "dropDDL_n"  // the word to execute
    2            // there are 2 args now on stack
    I            // dispatch to node I
                 ( I "dropDDL_n" 2 I )

    dispatch     // send indirect call to node I

    .            // just print the indirect result
  loop

  // dispatch drop to node 0

  0              // participant is to drop lock 0
  "dropDDL_n"    // the word to execute
  2              // there are 2 args now on stack
  0              // dispatch to node 0
                 ( 0 "dropDDL_n" 2 0 )

  dispatch       // send indirect call to node 0

  .              // just print the indirect result for the moment

  true           ( true )
;

/*----------------------------------------------------------------------------*/
/* coordinate a dispatch of indirect all to the coordinator                   */
/*----------------------------------------------------------------------------*/
: coordinate ( ... wordName #args -- ..result.. )

  c.queue ( -- ... wordName #args c.queue )
  >queue> ( -- ..result.. )
;

/*----------------------------------------------------------------------------*/
/* distributed lock test                                                      */
/*----------------------------------------------------------------------------*/
: ddlDump

  "{ " .put
  args.nodes 0 do
    I ddlInts @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* distributed lock test                                                      */
/*----------------------------------------------------------------------------*/
: dl

  // coordinate grab of dist ddl lock
  "grabDistDDL" 1  ( "grabDistDdl" 1 )
  coordinate       ( true|false )
  .

  ddlDump

  // coordinate drop of dist ddl lock
  "dropDistDDL" 1 ( "dropDistDdl" 1 )
  coordinate      ( true|false )
  .

  ddlDump

stk
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
