/*============================================================================*/
/* gridPrimitives.sen -- grid primitives                                      */
/*============================================================================*/

"gridPrimitives.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* task and queue arrays                                                      */
/*----------------------------------------------------------------------------*/
args.nodes ptrArray: ppTasks
args.nodes ptrArray: cpTasks
args.nodes ptrArray: pTasks
args.nodes ptrArray: senderTasks

args.nodes ptrArray: ppQueues
args.nodes ptrArray: cpQueues
args.nodes ptrArray: pQueues
args.nodes ptrArray: senderQueues

/*----------------------------------------------------------------------------*/
: to_CALLER  >reg0 ;
: to_QUEUE   >reg1 ;
: to_TASKSET >reg2 ;
: to_THREAD  >reg3 ;

: _CALLER    reg0 ;
: _QUEUE     reg1 ;
: _TASKSET   reg2 ;
: _THREAD    reg3 ;

/*----------------------------------------------------------------------------*/
/* dump the ppQueues array                                                    */
/*----------------------------------------------------------------------------*/
: ppQueuesDump

  "{ " .put
  args.nodes 0 do
    I ppQueues @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* dump the cpQueues array                                                    */
/*----------------------------------------------------------------------------*/
: cpQueuesDump

  "{ " .put
  args.nodes 0 do
    I cpQueues @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* dump the pQueues array                                                     */
/*----------------------------------------------------------------------------*/
: pQueuesDump

  "{ " .put
  args.nodes 0 do
    I pQueues @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* dump the senderQueues array                                                */
/*----------------------------------------------------------------------------*/
: senderQDump

  "{ " .put
  args.nodes 0 do
    I senderQueues tp: @ .put " " .put
  loop

  "}" .put .\n
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* append valset onto queue of given task and signal if needed                */
/*----------------------------------------------------------------------------*/
: >taskQueue ( valset task -- )

tp: >taskQueue

  locals| targetTask | ( valset )

  // grab the mutex of target task
  targetTask grabMutex ( valset )

  // append valset onto queue of target task
  targetTask appendQueue ( )

  // signal the target task if it is waiting for a queued valset
  targetTask waiting if
    targetTask signal ( )
  then

  // drop the mutex of target task
  targetTask dropMutex ( )
;

/*----------------------------------------------------------------------------*/
/* append indirect call onto queue of given task, suspend, move from a to p   */
/*----------------------------------------------------------------------------*/
: >taskQueue;a> ( <<call>> task -- <<result>> )

  // set this task to wait for 1 ack
  1 setAcks ( <<call>> task )

tp: require1Ack

  // append indirect call onto queue of given task
  >taskQueue ( )

  // this task suspends till notified. will have indirect result
  suspendTask ( )

tp: resumed

  // move from aux to parameter stack
  a> ( <<result>> )

tp: haveResultSet
;

/*----------------------------------------------------------------------------*/
/* put indirect call onto queue of sender                                     */
/*----------------------------------------------------------------------------*/
: >sndQueue ( <<call>> nodeNo -- )

  // get sender task
  senderTasks @ ( <<call>> task )

tp: sendingViaTask

  // enqueue valset onto queue of task
  >taskQueue
;

/*----------------------------------------------------------------------------*/
/* put indirect call onto queue of sender, suspend, move from a to p          */
/*----------------------------------------------------------------------------*/
: >sndQueue;a> ( <<call>> nodeNo -- )

  // this task to wait for 1 ack
  1 setAcks ( ... wordName #values queue )

  // get sender task
  senderTasks @ ( <<call>> task )

tp: sendingViaTask

  // enqueue valset onto queue of task
  >taskQueue

  // this task suspends till notified. will have indirect result
  suspendTask ( )

tp: resumed

  // move from aux to parameter stack
  a> ( <<result>> )

tp: haveResultSet
;

/*----------------------------------------------------------------------------*/
/* pop value from this tasks queue (this is a blocking call)                  */
/*----------------------------------------------------------------------------*/
: taskQueue> ( -- valset )

//args.node 0 == if traceon then

tp: taskQueue>

  task.this task.thread assert

tp: grabbingMutex
  task.this grabMutex

  getState TS_RUNNING == assert

  popQueue ( value true | false )

  not if

    TS_WAITING setState
tp: nowWaiting

    waitSignal

    TS_RUNNING setState
tp: nowRunning

    popQueue assert

  then

tp: droppingMutex
  task.this dropMutex

tp: haveValset

//args.node 0 == if traceoff then
;

/*----------------------------------------------------------------------------*/
/* push indirect result onto callers aux stack and signal caller              */
/*----------------------------------------------------------------------------*/
: >callerAux ( <<result>> -- )

tp: >callerAux

  // transfer to callers stack
  _CALLER ( <<result>> callingTask )

tp: ontoCallersAux
  >auxStack ( )

  // signal caller
  _CALLER ( caller )
  task.signal ( )
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* set the calling task                                                       */
/*----------------------------------------------------------------------------*/
: setCaller ( caller -- ; reg0 == caller )

  to_CALLER ( )
tp: reg0HasCaller

;

/*----------------------------------------------------------------------------*/
/* set sending node                                                           */
/*----------------------------------------------------------------------------*/
: setSender ( sender -- ; reg1 == sender )

  to_QUEUE ( )                                   //! THIS DOESNT LOOK RIGHT -RAY
tp: reg1HasSender

;

/*----------------------------------------------------------------------------*/
/* pass indirect call onto coordinator proxy                                  */
/*----------------------------------------------------------------------------*/
: passOnToCP

  cpTasks @

  >taskQueue
;

/*----------------------------------------------------------------------------*/
/* pass indirect result back to participant proxy                             */
/*----------------------------------------------------------------------------*/
: passBackToPP ( <<result>> nodeNo -- true )

  reg.push

  ppTasks @ to_CALLER

  >callerAux

  reg.pop

;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* execute indirect call on the stack                                         */
/*----------------------------------------------------------------------------*/
: !indirect ( ... wordName -- ... )

tp: executing...

  // find the word in dic stack
  find ( word )
                                                          //! WHAT IF NOT FOUND?

  // execute it
  execute ( ... )
;

/*----------------------------------------------------------------------------*/
/* convert all values on stack into a result valset                           */
/*----------------------------------------------------------------------------*/
: >result ( ... -- valset )

tp: resultIs

  // put number of values onto stack
  depth ( ... #values )

  // convert to valset
  >valset ( valset )

tp: resultAsValset
;

/*----------------------------------------------------------------------------*/
/* expand valset and execute indirect call                                    */
/*----------------------------------------------------------------------------*/
: exeOne ( <<call*>> )

  valset> ( ... wordName nValues )

  drop ( ... wordName )

  tp: callSetUp

  !indirect ( bool )
;

/*----------------------------------------------------------------------------*/
/* execute all nested valsets                                                 */
/*----------------------------------------------------------------------------*/
: exeAll ( ... valset -- x )

tp: exeAll

  // we exect at least one indirect
  CN_VALSET isType not if assert then

  // execute first indirect
  exeOne

  // execute all other indirects
  begin

    // no more to execute?
    CN_VALSET isType not
    if
      exit
    then

  // execute next indirect
  exeOne

  again
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* add call to send to one participant                                        */
/*----------------------------------------------------------------------------*/
: addSendParticipant ( valset node -- valset )

  "sendParticipant" ( valset node "sendParticipant" )

tp: addingSendP

  $$>valset ( valset )
;

/*----------------------------------------------------------------------------*/
/* add call to send to all participants                                       */
/*----------------------------------------------------------------------------*/
: addSendParticipants ( valset -- valset )

  "sendParticipants" ( valset "sendParticipants" )

tp: addingSendPs

  $$>valset ( valset )
;

/*----------------------------------------------------------------------------*/
/* add call to set caller                                                     */
/*----------------------------------------------------------------------------*/
: addSetCaller ( valset -- valset )

  task.this "setCaller"

tp: addingSetCaller

  $$>valset
;

/*----------------------------------------------------------------------------*/
/* add call to set dic path                                                   */
/*----------------------------------------------------------------------------*/
: addSetDicPath ( valset -- valset )

  // add dicStack! indirect
  seitf.path@ ( valset path... #folders )
  "dicStack!" ( valset path... #folders "dicStack!" )

tp: addingSetDicPath

  $$>valset ( valset )
;

/*----------------------------------------------------------------------------*/
/* add call to set sender                                                     */
/*----------------------------------------------------------------------------*/
: addSetSender ( valset -- valset )

  args.node "setSender"

tp: addingSetSender

  $$>valset
;

/*----------------------------------------------------------------------------*/
/* add call to bass result back to participant proxy                          */
/*----------------------------------------------------------------------------*/
: addPassBackToPP ( valset -- valset )

  args.node "passBackToPP"

  tp: addingPassBackToPP

  $$>valset
;

/*----------------------------------------------------------------------------*/
/* add call to pass call onto coordinator proxy                               */
/*----------------------------------------------------------------------------*/
: addPassOnToCP ( valset -- valset )

  "passOnToCP"

tp: addingPassOnToCP

  $$>valset
;

/*----------------------------------------------------------------------------*/
/* interlinkParts                                                             */
/*----------------------------------------------------------------------------*/
: interlinkParts ( -- )

  // attach queue to task
  _QUEUE ( queue )
  _CALLER ( queue task )
  task.queue! ( )

  // put task in taskset
  _CALLER ( task )
  _TASKSET ( task taskset )
  taskset.append ( )

  // attach taskset to thread
  _TASKSET ( taskset )
  _THREAD ( taskset thread )
  thread.taskset! ( )

  // record taskset in task
  _TASKSET ( taskset )
  _CALLER ( task )
  task.taskset! ( )
;

/*----------------------------------------------------------------------------*/
/* get task of an actor                                                       */
/*----------------------------------------------------------------------------*/
: actor.task ( "<actorNm>" -- task )

  ".task" concat find execute
;

/*----------------------------------------------------------------------------*/
/* get queue of an actor                                                      */
/*----------------------------------------------------------------------------*/
: actor.queue ( "<actorNm>" -- queue )

  ".queue" concat find execute
;

/*----------------------------------------------------------------------------*/
/* get taskset of an actor                                                    */
/*----------------------------------------------------------------------------*/
: actor.taskset ( "<actorNm>" -- taskset )

  ".taskset" concat find execute
;

/*----------------------------------------------------------------------------*/
/* get thread of an actor                                                     */
/*----------------------------------------------------------------------------*/
: actor.thread ( "<actorNm>" -- taskset )

  ".thread" concat find execute
;

/*----------------------------------------------------------------------------*/
/* spawn thread of an actor                                                   */
/*----------------------------------------------------------------------------*/
: actor.spawn ( ... nArgs "<actorNm>" "<loopNm>" -- )

  >r ( ... nArgs "<actorNm>" )

  // seed the task
  r@ actor.task task.seed ( )

  // find the thread
  r@ actor.thread thread.spawn ( )

  rdrop
;

/*----------------------------------------------------------------------------*/
/* create an actor (but don't spawn thread)                                   */
/*----------------------------------------------------------------------------*/
: actor: ( -- )

  // get token from compile stream
  token: ( s )

  reg.push

  dup ".task"    concat :task    execute to_CALLER  // reg0 has task
  dup ".queue"   concat :queue   execute to_QUEUE   // reg1 has queue
  dup ".taskset" concat :taskset execute to_TASKSET // reg2 has taskset
  dup ".thread"  concat :thread  execute to_THREAD  // reg3 has thread

  interlinkParts

  reg.pop

  drop
;

/*----------------------------------------------------------------------------*/
/* create an actor (but don't spawn thread)                                   */
/*----------------------------------------------------------------------------*/
: :actor ( "<actorNm>" -- "<actorNm>" )

  reg.push

  dup ".task"    concat :task    execute to_CALLER  // reg0 has task
  dup ".queue"   concat :queue   execute to_QUEUE   // reg1 has queue
  dup ".taskset" concat :taskset execute to_TASKSET // reg2 has taskset
  dup ".thread"  concat :thread  execute to_THREAD  // reg3 has thread

  interlinkParts

  reg.pop
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* path for SE                                                                */
/*----------------------------------------------------------------------------*/
: SE_PATH "../OS\ X/Build/Products/Debug/SE" ;

/*----------------------------------------------------------------------------*/
/* form the shell command for spawning a node                                 */
/*----------------------------------------------------------------------------*/
: se_command ( nodeNo -- "<command>" )

  dup
  dup

  //  "nohup "
  ""
  SE_PATH concat
  " --start " concat
  " --size " concat args.regionSize >str concat
  //  " --commands /Users/alkayamarti/rapidsSE/rapidsse/Commands" concat
  " --commands /Users/ray/Desktop/rapidsse/Commands" concat
  " --region /SE_" concat  swap >str concat
  " --node  " concat swap >str concat
  " --nodes " concat args.nodes >str concat
  " --partitions " concat args.partitions >str concat
  " --port  " concat args.port  >str concat
  " --sleep " concat args.sleep >str concat
  args.tracepoint if " --tracepoint " concat then
  args.verbose if " --verbose " concat then

  " &" concat
;

/*----------------------------------------------------------------------------*/
/* spawn all other nodes for a grid on this machine                           */
/*----------------------------------------------------------------------------*/
: spawnNodes ( -- )

  // test for single node
  args.nodes 1 == if exit then

  // spawn all other nodes
  args.nodes 1 do

    // form the shell command to spawn node I
    I se_command

    // print the shell command
    dup .

    // execute the shell command
    shell.execute

    // check result
    not assert

  loop

  // set grid as started
  true grid.this grid.started!

;

