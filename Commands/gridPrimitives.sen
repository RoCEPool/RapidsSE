/*============================================================================*/
/* gridPrimitives.sen -- grid testing                                         */
/*============================================================================*/

"gridPrimitives.sen" .putVerbose

: SE_PATH "../OS\ X/Build/Products/Debug/SE" ;

: se_command

    dup

//  "nohup "
    ""
    SE_PATH concat
    " --start --restart --size 4gb " concat
    " --commands /Users/ray/Desktop/rapidsse/Commands" concat
    " --region /SE_" concat
    swap >str concat

    " --node " concat
    swap >str concat

    " --nodes 8" concat

    " &" concat
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: g

  1 se_command dup . shell.execute .
  2 se_command dup . shell.execute .
  3 se_command dup . shell.execute .
  4 se_command dup . shell.execute .
  5 se_command dup . shell.execute .
  6 se_command dup . shell.execute .
  7 se_command dup . shell.execute .
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: gn

  args.nodes 1 do
    I se_command
    dup .
    shell.execute .
  loop
  
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipcChild

  3 sleep

//traceon

  "ipcChild" task.this task.name!

  "ipcChild" .

  task.parent@ task.signal
//traceoff
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipc

//traceon

  3 task.this task.acks!

  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append

  //TS_WAITING task.this task.state!

  task.suspend

  "Parent" .
//traceoff
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* pop indirect valset from queue                                             */
/*----------------------------------------------------------------------------*/
: queue> ( -- valset )

  begin
    task.this task.queue@ queue.pop
    dup not if task.yield /*100 thread.sleep_us*/ then
  until
;

/*----------------------------------------------------------------------------*/
/* convert valset to indirect call                                            */
/*----------------------------------------------------------------------------*/
: >indirect ( valset -- ... wordName ; reg0 == caller )

  valset>  // expand valset into stack values ( ... wordName caller #args )
  drop     // discard the args                ( ... wordName caller )
  >reg0    // put caller into reg0            ( ... wordName )
;

/*----------------------------------------------------------------------------*/
/* execute indirect call on the stack                                         */
/*----------------------------------------------------------------------------*/
: !indirect ( ... wordName -- ... )

  find execute
;

/*----------------------------------------------------------------------------*/
/* convert values on stack into a result valset                               */
/*----------------------------------------------------------------------------*/
: >result ( ... -- valset )

  depth >valset
;

/*----------------------------------------------------------------------------*/
/* push valset onto invoking tasks stack and signal caller                    */
/*----------------------------------------------------------------------------*/
: >caller ( valset -- ; caller -- valset )

  reg0 >stack

  reg0 task.signal
;

/*----------------------------------------------------------------------------*/
/* put request onto queue for processing, suspend for notification            */
/*----------------------------------------------------------------------------*/
: >queue> ( ... wordName #args queue -- result )

  >r                       // save target queue onto rstack

  1 task.this task.acks!   // will wait for 1 ack

  task.this                // this task is the caller

  swap                     // bring #args to top

  1 +                      // valset will be ( args, wordname, caller )

  >valset                  // convert stack values to valset

  r>                       // restore target queue onto stack

  queue.append             // pop valset and append to target queue

  task.suspend             // this task suspends

  valset>                  // convert valset to stack values

  drop                     // discard number of values
;

/*----------------------------------------------------------------------------*/
/* actor formation                                                            */
/*----------------------------------------------------------------------------*/
: actorForm ( ... #args "<loop>" "<actorName>" -- queue )

  reg.push

  >r

  // r0 has <actorName>

  r0 ".task"    concat dup . :task    execute >reg0  // reg0 has task
  r0 ".queue"   concat dup . :queue   execute >reg1  // reg1 has queue
  r0 ".taskset" concat dup . :taskset execute >reg2  // reg2 has taskset
  r0 ".thread"  concat dup . :thread  execute >reg3  // reg3 has thread

  // seed the task
  reg0 task.seed

  // attach queue to task
  reg1 reg0 task.queue!

  // put task in taskset
  reg0 reg2 taskset.append

  // attach taskset to thread
  reg2 reg3 thread.taskset!

  // spawn the os thread
  reg3 thread.spawn

  rdrop

  // leave queue on stack
  reg1

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* execute processing loop                                                    */
/*----------------------------------------------------------------------------*/
: execute.loop

  reg.push

  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack
    >indirect  // convert valset to indirect call

    stk
    !indirect  // execute indirect call
    stk

    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* pass on loop                                                               */
/*----------------------------------------------------------------------------*/
: passOn.loop ( actorNo queue -- )

  reg.push

  >r
  >r
  // r0 has actorNo
  // r1 has queue
  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack
    >indirect  // convert valset to indirect call; reg0 has caller

    stk
    depth r1 >queue>
    stk

    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  rdrop
  rdrop

  reg.pop
;

// for this experiment we will have an array of pp's
args.nodes ptrArray: ppQueues

/*----------------------------------------------------------------------------*/
/* coordinator loop (sends the indrect call to all participant proxies)       */
/*----------------------------------------------------------------------------*/
: c.loop ( -- )

  reg.push

  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack

    args.nodes 0 do

      dup

      >indirect
      depth
      I ppQueues @

      >queue>
      .

    loop

    drop

    "done" 1

    >valset

    >caller    // put indirect result onto stack of caller and signal

  0 until

  reg.pop
;

////////////////////////////////////////////////////////////////////////////////

// Participant
0 "execute.loop" "p" actorForm drop

// Coordinator Proxy
0 p.queue 2 "passOn.loop" "cp" actorForm drop

: createPPs

  args.nodes 0 do
    I cp.queue 2 "passOn.loop" "pp" I >str concat actorForm
    I ppQueues !
  loop

  args.nodes 0 do
    I ppQueues @ .
  loop
;

createPPs

// Coordinator
0 "c.loop" "c"  actorForm drop


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distributed pattern test                                                   */
/*----------------------------------------------------------------------------*/
: d

  1 sleep

  "xyz" "-PONG" "concat" 3
stk
  c.queue >queue> .
stk

;

////////////////////////////////////////////////////////////////////////////////

8 ptrArray: actorQueues

: actor.loop

  1000 sleep
;

: aft

  //"actor.loop" "actor" actorForm .

  8 0 do
    0 "actor.loop"
    "actor" I >str concat actorForm
    I actorQueues !
  loop

  8 0 do
    I actorQueues @ .
  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
