/*============================================================================*/
/* gridPrimitives.sen -- grid testing                                         */
/*============================================================================*/

"gridPrimitives.sen" .putVerbose

: SE_PATH "../OS\ X/Build/Products/Debug/SE" ;

: se_command

    dup

//  "nohup "
    ""
    SE_PATH concat
    " --start --restart --size 4gb " concat
    " --commands /Users/ray/Desktop/rapidsse/Commands" concat
    " --region /SE_" concat
    swap >str concat

    " --node " concat
    swap >str concat

    " --nodes 8" concat

    " &" concat
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: g

  1 se_command dup . shell.execute .
  2 se_command dup . shell.execute .
  3 se_command dup . shell.execute .
  4 se_command dup . shell.execute .
  5 se_command dup . shell.execute .
  6 se_command dup . shell.execute .
  7 se_command dup . shell.execute .
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: gn

  args.nodes 1 do
    I se_command
    dup .
    shell.execute .
  loop
  
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipcChild

  3 sleep

//traceon

  "ipcChild" task.this task.name!

  "ipcChild" .

  task.parent@ task.signal
//traceoff
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipc

//traceon

  3 task.this task.acks!

  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append

  //TS_WAITING task.this task.state!

  task.suspend

  "Parent" .
//traceoff
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////


/*----------------------------------------------------------------------------*/
/* start an actor                                                             */
/*----------------------------------------------------------------------------*/
: actor.start ( "threadName" thread taskset queue ... #args "seedWord" parent )

  reg.push

  task.new  // create a new task ( .etc. -- "threadName" thread taskset queue )

  >reg0     // reg0: task
  >reg1     // reg1: queue
  >reg2     // reg2: taskset
  >reg3     // reg3: thread
  >reg4     // reg4: "threadName"

  reg1 reg0 task.queue!     // set the tasks queue
  reg0 reg2 taskSet.append  // append task to taskset

  reg2 reg3 thread.taskset! // set the threads taskset
  reg4 reg3 thread.name!    // name the thread

  reg3 thread.spawn         // spawn the os thread

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* pop indirect valset from queue                                             */
/*----------------------------------------------------------------------------*/
: queue> ( -- valset )

  begin
    task.this task.queue@ queue.pop
    dup not if task.yield /*100 thread.sleep_us*/ then
  until
;

/*----------------------------------------------------------------------------*/
/* convert valset to indirect call                                            */
/*----------------------------------------------------------------------------*/
: >indirect ( valset -- ... wordName ; reg0 == caller )

  valset>  // expand valset into stack values ( ... wordName caller #args )
  drop     // discard the args                ( ... wordName caller )
  >reg0    // put caller into reg0            ( ... wordName )
;

/*----------------------------------------------------------------------------*/
/* execute indirect call on the stack                                         */
/*----------------------------------------------------------------------------*/
: !indirect ( ... wordName -- ... )

  find execute
;

/*----------------------------------------------------------------------------*/
/* convert values on stack into a result valset                               */
/*----------------------------------------------------------------------------*/
: >result ( ... -- valset )

  depth >valset
;

/*----------------------------------------------------------------------------*/
/* push valset onto invoking tasks stack and signal caller                    */
/*----------------------------------------------------------------------------*/
: >caller ( valset -- ; caller -- valset )

  reg0 >stack

  reg0 task.signal
;

/*----------------------------------------------------------------------------*/
/* put request onto queue for processing, suspend for notification            */
/*----------------------------------------------------------------------------*/
: >queue> ( ... wordName #args queue -- result )

  >r                       // save target queue onto rstack

  1 task.this task.acks!   // will wait for 1 ack

  task.this                // this task is the caller

  swap                     // bring #args to top

  1 +                      // valset will be ( args, wordname, caller )

  >valset                  // convert stack values to valset

  r>                       // restore target queue onto stack

  queue.append             // pop valset and append to target queue

  task.suspend             // this task suspends

  valset>                  // convert valset to stack values

  drop                     // discard number of values
;

////////////////////////////////////////////////////////////////////////////////

// Participant
queue:   p.queue    // create a named queue
taskset: p.taskset  // create a named taskset
thread:  p.thread   // create a named thread

/*----------------------------------------------------------------------------*/
/* participant processing loop                                                */
/*----------------------------------------------------------------------------*/
: p.loop

  "renaming to p.task" .putVerbose

  "p.task" task.this task.name!

  p.queue task.this task.queue!

  reg.push

  begin
    depth 0 != if "stack of p.task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack
    >indirect  // convert valset to indirect call

    stk
    !indirect  // execute indirect call
    stk

    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* start the participant                                                      */
/*----------------------------------------------------------------------------*/
: p.start

/*
  // set up participant task
  0 "p.loop" nullPtr task.new p.taskset taskSet.append

  // set up the participant taskset
  p.taskset p.thread thread.taskset!

  // name the participant thread
  "p.thread" p.thread thread.name!

  // spawn the os thread
  p.thread thread.spawn
*/

  "p.thread" p.thread p.taskset p.queue 0 "p.loop" nullPtr actor.start
;

////////////////////////////////////////////////////////////////////////////////

// Coordinator Proxy
queue:   cp.queue    // create a named queue
taskset: cp.taskset  // create a named taskset
thread:  cp.thread   // create a named thread

/*----------------------------------------------------------------------------*/
/* coordinator proxy processing loop                                          */
/*----------------------------------------------------------------------------*/
: cp.loop

  "renaming to cp.task" .putVerbose

  "cp.task" task.this task.name!

  cp.queue task.this task.queue!

  reg.push

  begin
    depth 0 != if "stack of cp.task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack
    >indirect  // convert valset to indirect call

stk
    depth p.queue >queue>
stk

    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* start the coordinator proxy                                                */
/*----------------------------------------------------------------------------*/
: cp.start

/*
  // set up coordinator proxy task
  0 "cp.loop" nullPtr task.new cp.taskset taskSet.append

  // set up the coordinator proxy taskset
  cp.taskset cp.thread thread.taskset!

  // name the coordinator proxy thread
  "cp.thread" cp.thread thread.name!

  // spawn the os thread
  cp.thread thread.spawn
*/

  "cp.thread" cp.thread cp.taskset cp.queue 0 "cp.loop" nullPtr actor.start
;

////////////////////////////////////////////////////////////////////////////////

// Participant Proxy
queue:   pp.queue    // create a named queue
taskset: pp.taskset  // create a named taskset
thread:  pp.thread   // create a named thread

/*----------------------------------------------------------------------------*/
/* participant proxy processing loop                                          */
/*----------------------------------------------------------------------------*/
: pp.loop

  "renaming to pp.task" .putVerbose

  "pp.task" task.this task.name!

  pp.queue task.this task.queue!

  reg.push

  begin
    depth 0 != if "stack of pp.task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack
    >indirect  // convert valset to indirect call

    stk
    depth cp.queue >queue>
    stk

    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* start the participant proxy                                                */
/*----------------------------------------------------------------------------*/
: pp.start

/*
  // set up participant proxy task
  0 "pp.loop" nullPtr task.new pp.taskset taskSet.append

  // set up the participant proxy taskset
  pp.taskset pp.thread thread.taskset!

  // name the participant proxy thread
  "pp.thread" pp.thread thread.name!

  // spawn the os thread
  pp.thread thread.spawn
*/

  "pp.thread" pp.thread pp.taskset pp.queue 0 "pp.loop" nullPtr actor.start
;

////////////////////////////////////////////////////////////////////////////////

// Coordinator
queue:   c.queue    // create a named queue
taskset: c.taskset  // create a named taskset
thread:  c.thread   // create a named thread

/*----------------------------------------------------------------------------*/
/* coordinator processing loop                                                */
/*----------------------------------------------------------------------------*/
: c.loop_v1

  "renaming to c.task" .putVerbose

  "c.task" task.this task.name!

  c.queue task.this task.queue!

  reg.push

  begin
    depth 0 != if "stack of c.task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack

    >indirect  // convert valset to indirect call
    !indirect  // execute indirect call
    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* coordinator processing loop v2                                             */
/*----------------------------------------------------------------------------*/
: c.loop_v2

  "renaming to c.task" .putVerbose

  "c.task" task.this task.name!

  c.queue task.this task.queue!

  reg.push

  begin
    depth 0 != if "stack of c.task has grown" . debug.trap then

    queue>     // pop valset off queue and push onto this stack
    >indirect  // convert valset to indirect call

    stk
    depth pp.queue >queue>
    stk

    >result    // convert stack contents into indirect result
    >caller    // put indirect result onto stack of caller and signal

  0 until

  reg.pop
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* start the coordinator                                                      */
/*----------------------------------------------------------------------------*/
: c.start

/*
  // set up coordinator task
  0 "c.loop_v2" nullPtr task.new c.taskset taskSet.append

  // set up the coordinator taskset
  c.taskset c.thread thread.taskset!

  // name the coordinator thread
  "c.thread" c.thread thread.name!

  // spawn the os thread
  c.thread thread.spawn
*/

  "c.thread" c.thread c.taskset c.queue 0 "c.loop_v2" nullPtr actor.start
;

/*----------------------------------------------------------------------------*/
/* a simple pong test                                                         */
/*----------------------------------------------------------------------------*/
: pong

  "-PONG" concat
;

////////////////////////////////////////////////////////////////////////////////


/*----------------------------------------------------------------------------*/
/* distributed pattern test                                                   */
/*----------------------------------------------------------------------------*/
: d

  p.start
  cp.start
  pp.start
  c.start

  "xyz" "pong" 2
stk
  c.queue >queue> .
stk

//  "abc" "lmn" "concat" 3
//stk
//  c.queue >queue> .
//stk
;

