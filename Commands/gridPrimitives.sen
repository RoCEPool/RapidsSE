/*----------------------------------------------------------------------------*/
/* distributed pattern test                                                   */
/*----------------------------------------------------------------------------*/
/*
: d

  args.nodes 0 do
    0 I ddlInts !
  loop

  0 grabDDL_n . 0 ddlInts @ .
  0 dropDDL_n . 0 ddlInts @ .

  1 sleep

  "xyz" "-PONG" "concat" 3
stk
  c.queue >queue> .
stk

;
*/

////////////////////////////////////////////////////////////////////////////////

createActors

/*----------------------------------------------------------------------------*/
/* dispatch indirect call to given participant                                */
/*----------------------------------------------------------------------------*/
: dispatch ( ... #args actorNo -- ..result.. )

  // determine which queue to forward to
  dup args.node == if

    // queue will be the participant for this node
    pQueues @    ( ... #args queue )

  else

    // queue will be participant proxy for other node
    ppQueues @   ( ... #args queue )

  then

  // transfer to another actors queue and wait for result
  >queue>        ( ..result.. )
;

/*----------------------------------------------------------------------------*/
/* grab distributed ddl lock                                                  */
/*----------------------------------------------------------------------------*/
: grabDistDDL ( -- true )

  // dispatch grab of lock 0 to node 0

  begin
    0            // participant is to grab lock 0
    "grabDDL_n"  // the word to execute
    2            // there are 2 args now on stack
    0            // dispatch to node 0
                 ( 0 "grabDDL_n" 2 0 )

    dispatch     // send indirect call to node 0

                 ( true | false )
  until

  // dispatch grab of lock I to all other nodes

  args.nodes 1 do
    I            // participant is to grab lock I
    "grabDDL_n"  // the word to execute
    2            // there are 2 args now on stack
    I            // dispatch to node I
                 ( I "grabDDL_n" 2 I )

    dispatch     // send indirect call to node I

    .            // just print the indirect result for the moment

  loop

  true           ( true )
;

/*----------------------------------------------------------------------------*/
/* drop distributed ddl lock                                                  */
/*----------------------------------------------------------------------------*/
: dropDistDDL ( -- true )

  // dispatch drop to all other nodes

  args.nodes 1 do
    I            // participant is to drop lock 0
    "dropDDL_n"  // the word to execute
    2            // there are 2 args now on stack
    I            // dispatch to node I
                 ( I "dropDDL_n" 2 I )

    dispatch     // send indirect call to node I

    .            // just print the indirect result
  loop

  // dispatch drop to node 0

  0              // participant is to drop lock 0
  "dropDDL_n"    // the word to execute
  2              // there are 2 args now on stack
  0              // dispatch to node 0
                 ( 0 "dropDDL_n" 2 0 )

  dispatch       // send indirect call to node 0

  .              // just print the indirect result for the moment

  true           ( true )
;

/*----------------------------------------------------------------------------*/
/* coordinate a dispatch of indirect all to the coordinator                   */
/*----------------------------------------------------------------------------*/
: coordinate ( ... wordName #args -- ..result.. )

  c.queue ( -- ... wordName #args c.queue )
  >queue> ( -- ..result.. )
;

/*----------------------------------------------------------------------------*/
/* distributed lock test                                                      */
/*----------------------------------------------------------------------------*/
: ddlDump

  "{ " .put
  args.nodes 0 do
    I ddlInts @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* distributed lock test                                                      */
/*----------------------------------------------------------------------------*/
: dl

  // coordinate grab of dist ddl lock
  "grabDistDDL" 1  ( "grabDistDdl" 1 )
  coordinate       ( true|false )
  .

  ddlDump

  // coordinate drop of dist ddl lock
  "dropDistDDL" 1 ( "dropDistDdl" 1 )
  coordinate      ( true|false )
  .

  ddlDump

stk
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
