/*============================================================================*/
/* gridPrimitives.sen -- grid testing                                         */
/*============================================================================*/

"gridPrimitives.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* pop indirect valset from this tasks queue (this is a blocking call)        */
/*----------------------------------------------------------------------------*/
: queue> ( -- valset )

  begin

    // attempt to pop value off the tasks queue
    task.this task.queue@ queue.pop ( value | false )

    // test for value
    dup not if
      task.yield /*100 thread.sleep_us*/
    then

    ( value | false )
  until
;

/*----------------------------------------------------------------------------*/
/* expand valset into an indirect call                                        */
/*----------------------------------------------------------------------------*/
: >indirect ( valset -- ... wordName ; reg0 == caller )

  // expand valset into stack values
  valset> ( ... wordName caller #values )

  // discard the number of values
  drop ( ... wordName caller )

  // put caller into reg0
  >reg0 ( ... wordName )
;

/*----------------------------------------------------------------------------*/
/* execute indirect call on the stack                                         */
/*----------------------------------------------------------------------------*/
: !indirect ( ... wordName -- ... )

  // find the word in dic stack
  find ( word )
                                                          //! WHAT IF NOT FOUND?
  // execute it
  execute ( ... )
;

/*----------------------------------------------------------------------------*/
/* convert values on stack into a result valset                               */
/*----------------------------------------------------------------------------*/
: >result ( ... -- valset )

  // put number of values onto stack
  depth ( ... #values )

  // convert to valset
  >valset ( valset )
;

/*----------------------------------------------------------------------------*/
/* push valset onto callers stack and signal caller                           */
/*----------------------------------------------------------------------------*/
: >caller ( valset -- )

  // loop until caller is in the waiting state
  // otherwise transfering to that stack will corrupt the
  // tasks execution

  begin

    // get the callers state
    reg0 ( valset caller )
    task.state@ ( valset state )

    // test if its waiting
    TS_WAITING == ( valset true|false )
  until

  // transfer to callers stack
  reg0 ( valset caller )
  >stack ( )

  // signal caller
  reg0 ( caller )
  task.signal ( )
;

/*----------------------------------------------------------------------------*/
/* append indirect call onto given queue                                      */
/*----------------------------------------------------------------------------*/
: >queue ( ... wordName #values queue -- )

  // save target queue on rstack
  >r ( ... wordName #values )

  // this task is the caller
  task.this ( ... wordName #values caller )

  // bring #values to top
  swap ( ... wordName caller #values )

  // inc #values to now include caller
  inc ( ... wordName caller #values )

  // convert values to valset
  >valset ( valset )

  // restore target queue onto stack
  r> ( valset queue )

  // pop valset and append to target queue
  queue.append ( )
;

/*----------------------------------------------------------------------------*/
/* append indirect call onto given queue, suspend for notification            */
/*----------------------------------------------------------------------------*/
: >queue> ( ... wordName #values queue -- ..result.. )

  // set this task to wait for 1 ack
  1 task.this task.acks! ( ... wordName #values queue )

  // append indirect call onto queue
  >queue ( )

  // this task suspends till notified
  task.suspend ( valset )

  // convert valset to values
  valset> ( ... #values )

  // discard number of values leaving the indirect result
  drop ( ..result.. )
;

/*----------------------------------------------------------------------------*/
/* actor formation                                                            */
/*----------------------------------------------------------------------------*/
: actorForm ( ... #args "<loop>" "<actorName>" -- queue )

  reg.push

  >r ( ... #args "<loop>" ) // r0 has <actorName>

  // create the objects
  r0 ".task"    concat dup . :task    execute >reg0  // reg0 has task
  r0 ".queue"   concat dup . :queue   execute >reg1  // reg1 has queue
  r0 ".taskset" concat dup . :taskset execute >reg2  // reg2 has taskset
  r0 ".thread"  concat dup . :thread  execute >reg3  // reg3 has thread

  ( ... #args "<loop>" )

  // seed the task
  reg0 task.seed ( )

  // attach queue to task
  reg1 ( queue )
  reg0 ( queue task )
  task.queue! ( )

  // put task in taskset
  reg0 ( task )
  reg2 ( task taskset )
  taskset.append ( )

  // attach taskset to thread
  reg2 ( taskset )
  reg3 ( taskset thread )
  thread.taskset! ( )

  // spawn the os thread
  reg3 ( thread )
  thread.spawn ( )

  rdrop ( )

  // leave queue on stack
  reg1 ( queue )

  reg.pop ( queue )
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
