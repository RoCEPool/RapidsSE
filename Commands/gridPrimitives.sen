/*============================================================================*/
/* gridPrimitives.sen -- grid testing                                         */
/*============================================================================*/

"gridPrimitives.sen" .putVerbose

: SE_PATH "../OS\ X/Build/Products/Debug/SE" ;

: se_command

    dup

//  "nohup "
    ""
    SE_PATH concat
    " --start --restart --size 4gb " concat
    " --commands /Users/ray/Desktop/rapidsse/Commands" concat
    " --region /SE_" concat
    swap >str concat

    " --node " concat
    swap >str concat

    " --nodes 8" concat

    " &" concat
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: g

  1 se_command dup . shell.execute .
  2 se_command dup . shell.execute .
  3 se_command dup . shell.execute .
  4 se_command dup . shell.execute .
  5 se_command dup . shell.execute .
  6 se_command dup . shell.execute .
  7 se_command dup . shell.execute .
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: gn

  args.nodes 1 do
    I se_command
    dup .
    shell.execute .
  loop
  
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipcChild

  3 sleep

//traceon

  "ipcChild" task.this task.name!

  "ipcChild" .

  task.parent@ task.signal
//traceoff
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipc

//traceon

  3 task.this task.acks!

  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append

  //TS_WAITING task.this task.state!

  task.suspend

  "Parent" .
//traceoff
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* pop indirect valset from this tasks queue (this is a blocking call)        */
/*----------------------------------------------------------------------------*/
: queue> ( -- valset )

  begin

    // attempt to pop value off the tasks queue
    task.this task.queue@ queue.pop ( value | false )

    // test for value
    dup not if
      task.yield /*100 thread.sleep_us*/
    then
                                    ( value | false )
  until
;

/*----------------------------------------------------------------------------*/
/* expand valset into an indirect call                                        */
/*----------------------------------------------------------------------------*/
: >indirect ( valset -- ... wordName ; reg0 == caller )

  // expand valset into stack values
  valset>  ( ... wordName caller #values )

  // discard the number of values
  drop     ( ... wordName caller )

  // put caller into reg0
  >reg0    ( ... wordName )
;

/*----------------------------------------------------------------------------*/
/* execute indirect call on the stack                                         */
/*----------------------------------------------------------------------------*/
: !indirect ( ... wordName -- ... )

  // find the word in dic stack
  find      ( word )
                                                          //! WHAT IF NOT FOUND?
  // execute it
  execute   ( ... )
;

/*----------------------------------------------------------------------------*/
/* convert values on stack into a result valset                               */
/*----------------------------------------------------------------------------*/
: >result ( ... -- valset )

  // put number of values onto stack
  depth   ( ... #values )

  // convert to valset
  >valset ( valset )
;

/*----------------------------------------------------------------------------*/
/* push valset onto callers stack and signal caller                           */
/*----------------------------------------------------------------------------*/
: >caller ( valset -- )

  // loop until caller is in the waiting state
  // otherwise transfering to that stack will corrupt the
  // tasks execution

  begin

    // get the callers state
    reg0            ( valset task )
    task.state@     ( valset state )

    // test if its waiting
    TS_WAITING ==   ( valset true|false )
  until

  // transfer to callers stack
  reg0              ( valset task )
  >stack            ( )

  // signal caller
  reg0              ( task )
  task.signal       ( )
;

/*----------------------------------------------------------------------------*/
/* append indirect call onto given queue                                      */
/*----------------------------------------------------------------------------*/
: >queue ( ... wordName #values queue -- )

  // save target queue on rstack
  >r  ( ... wordName #values )

  // this task is the caller
  task.this ( ... wordName #values caller )

  // bring #values to top
  swap ( ... wordName caller #values )

  // inc #values to now include caller
  inc  ( ... wordName caller #values )

  // convert values to valset
  >valset ( valset )

  // restore target queue onto stack
  r> ( valset queue )

  // pop valset and append to target queue
  queue.append ( )
;

/*----------------------------------------------------------------------------*/
/* append indirect call onto given queue, suspend for notification            */
/*----------------------------------------------------------------------------*/
: >queue> ( ... wordName #values queue -- ..result.. )

  // set this task to wait for 1 ack
  1 task.this task.acks!  ( ... wordName #values queue )

/*
  // save target queue on rstack
  >r  ( ... wordName #values )

  // this task is the caller
  task.this  ( ... wordName #values caller )

  // bring #values to top
  swap ( ... wordName caller #values )

  // inc #values to now include caller
  inc  ( ... wordName caller #values )

  // convert values to valset
  >valset ( valset )

  // restore target queue onto stack
  r> ( valset queue )

  // pop valset and append to target queue
  queue.append  ( )
*/

  // append request onto queue
  >queue ( )

  // this task suspends till notified
  task.suspend ( valset )

  // convert valset to values
  valset> ( ... #values )

  // discard number of values
  drop ( ... )
;

/*----------------------------------------------------------------------------*/
/* actor formation                                                            */
/*----------------------------------------------------------------------------*/
: actorForm ( ... #args "<loop>" "<actorName>" -- queue )

  reg.push

  >r

  // r0 has <actorName>

  r0 ".task"    concat dup . :task    execute >reg0  // reg0 has task
  r0 ".queue"   concat dup . :queue   execute >reg1  // reg1 has queue
  r0 ".taskset" concat dup . :taskset execute >reg2  // reg2 has taskset
  r0 ".thread"  concat dup . :thread  execute >reg3  // reg3 has thread

  // seed the task
  reg0 task.seed

  // attach queue to task
  reg1 reg0 task.queue!

  // put task in taskset
  reg0 reg2 taskset.append

  // attach taskset to thread
  reg2 reg3 thread.taskset!

  // spawn the os thread
  reg3 thread.spawn

  rdrop

  // leave queue on stack
  reg1

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* execute processing loop                                                    */
/*----------------------------------------------------------------------------*/
: execute.loop

  // push a register frame
  reg.push

  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    // pop valset off queue and push onto this stack
    queue>     ( valset )

    // convert valset to indirect call
    >indirect  ( ..call.. )

    // execute indirect call
    !indirect  ( ..result.. )

    // convert indirect result into valset
    >result    ( valset )

    // put indirect result onto stack of caller and signal
    >caller    ( )

  0 until

  // pop a register frame
  reg.pop
;

/*----------------------------------------------------------------------------*/
/* pass on loop                                                               */
/*----------------------------------------------------------------------------*/
: passOn.loop ( actorNo queue -- )

  // push a register frame
  reg.push

  >r
  >r
  // r0 has actorNo
  // r1 has queue
  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    // pop valset off queue and push onto this stack
    queue>     ( valset )

    // convert valset to indirect call
    >indirect  ( ..call.. )

    depth r1 >queue>

    // convert indirect result into valset
    >result    ( valset )

    // put indirect result onto stack of caller and signal
    >caller    ( )

  0 until

  rdrop
  rdrop

  // pop a register frame
  reg.pop
;

/*----------------------------------------------------------------------------*/
/* pointer arrays                                                             */
/*----------------------------------------------------------------------------*/

args.nodes intArray: ddlInts
args.nodes ptrArray: ppQueues
args.nodes ptrArray: cpQueues
args.nodes ptrArray: pQueues

/*----------------------------------------------------------------------------*/
/* grab ddl lock n                                                            */
/*----------------------------------------------------------------------------*/
: grabDDL_n ( n -- true|false )

  dup                ( n n )

  ddlInts @          ( n v )

  if                 ( n )

   drop              ( )
   false             ( false )

  else               ( n )

   // put 1 into ddlInts[n]

   1                 ( n 1 )
   swap              ( 1 n )
   ddlInts !         ( )
   true              ( true )
  then
;

/*----------------------------------------------------------------------------*/
/* drop ddl lock n                                                            */
/*----------------------------------------------------------------------------*/
: dropDDL_n ( n -- true )

  // put 0 into ddlInts[n]

  0          ( n 0 )
  swap       ( 0 n )
  ddlInts !  ( )

  true       ( true )
;

////////////////////////////////////////////////////////////////////////////////

: createActors

  args.nodes 0 do
    0 I ddlInts !
  loop

  args.nodes 0 do

    // create the participant for this I
    0 "execute.loop" "p" I >str concat actorForm
    I pQueues !

    // create the coordinator proxy for this I
    I I pQueues @ 2 "passOn.loop" "cp" I >str concat actorForm
    I cpQueues !

    // create the partitipant proxy for this I
    I args.node == if
      I I pQueues  @ 2 "passOn.loop" "pp" I >str concat actorForm
      I ppQueues !
    else
      I I cpQueues @ 2 "passOn.loop" "pp" I >str concat actorForm
      I ppQueues !
    then

  loop

  // coordinator
  0 "execute.loop" "c" actorForm drop
;


