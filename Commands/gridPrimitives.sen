/*============================================================================*/
/* gridPrimitives.sen -- grid primitives                                      */
/*============================================================================*/

"gridPrimitives.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* lock and queue arrays                                                      */
/*----------------------------------------------------------------------------*/
args.nodes ptrArray: ppTasks
args.nodes ptrArray: cpTasks
args.nodes ptrArray: pTasks
args.nodes ptrArray: senderTasks

args.nodes ptrArray: ppQueues
args.nodes ptrArray: cpQueues
args.nodes ptrArray: pQueues
args.nodes ptrArray: senderQueues

/*----------------------------------------------------------------------------*/
/* dump the ppQueues array                                                    */
/*----------------------------------------------------------------------------*/
: ppQueuesDump

  "{ " .put
  args.nodes 0 do
    I ppQueues @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* dump the cpQueues array                                                    */
/*----------------------------------------------------------------------------*/
: cpQueuesDump

  "{ " .put
  args.nodes 0 do
    I cpQueues @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* dump the pQueues array                                                     */
/*----------------------------------------------------------------------------*/
: pQueuesDump

  "{ " .put
  args.nodes 0 do
    I pQueues @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* dump the senderQueues array                                                */
/*----------------------------------------------------------------------------*/
: senderQDump

  "{ " .put
  args.nodes 0 do
    I senderQueues tp: @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* append value onto queue of given task                                      */
/*----------------------------------------------------------------------------*/
: >taskQueue ( value task -- )

  task.queue@

  queue.append
;

/*----------------------------------------------------------------------------*/
/* pop value from this tasks queue (this is a blocking call)                  */
/*----------------------------------------------------------------------------*/
: queue> ( -- value )

tp: waitNextValset

  begin

    // attempt to pop value off the tasks queue
    task.this task.queue@ queue.pop ( value | false )

    // test for value
    dup not if
      task.yield
      args.sleep thread.sleep_ms
    then

    ( value | false )
  until

tp: poppedValset
;

/*----------------------------------------------------------------------------*/
/* append indirect call onto queue of given task, suspend, move from a to p   */
/*----------------------------------------------------------------------------*/
: >taskQueue;a> ( <<call*>> queue -- <<result>> )

  // set this task to wait for 1 ack
  1 task.this task.acks! ( << <<call*>> <<caller>> >> queue )

tp: require1Ack

  // append indirect call onto queue
  >taskQueue ( )

  // this task suspends till notified. will have indirect result
  task.suspend ( )

tp: resumed

  // move from aux to parameter stack
  a> ( <<result>> )

tp: haveResultSet
;

/*----------------------------------------------------------------------------*/
/* put indirect call onto queue of sender                                     */
/*----------------------------------------------------------------------------*/
: >node ( valset senderNo -- )

  // get sender task
  senderTasks @ ( valset task )

tp: sendingViaQueue

  // enqueue valset onto queue of task
  >taskQueue
;

/*----------------------------------------------------------------------------*/
/* set the calling task                                                       */
/*----------------------------------------------------------------------------*/
: setCaller ( caller -- ; reg0 == caller )

  >reg0 ( )
tp: reg0HasCaller

  true
;

/*----------------------------------------------------------------------------*/
/* set sending node                                                           */
/*----------------------------------------------------------------------------*/
: setSender ( sender -- ; reg1 == sender )

  >reg1 ( )
tp: reg1HasSender

  true
;

/*----------------------------------------------------------------------------*/
/* execute indirect call on the stack                                         */
/*----------------------------------------------------------------------------*/
: !indirect ( ... wordName -- ... )

tp: executing...
  // find the word in dic stack
  find ( word )
                                                          //! WHAT IF NOT FOUND?
  // execute it
  execute ( ... )
;

/*----------------------------------------------------------------------------*/
/* convert values on stack into a result valset                               */
/*----------------------------------------------------------------------------*/
: >result ( ... -- valset )

tp: resultIs

  // put number of values onto stack
  depth ( ... #values )

  // convert to valset
  >valset ( valset )

tp: resultAsValset
;

/*----------------------------------------------------------------------------*/
/* push valset onto callers aux stack and signal caller                       */
/*----------------------------------------------------------------------------*/
: >caller ( valset -- )

  // loop until caller is in the waiting state
  // otherwise transfering to that stack will corrupt the
  // tasks execution

/*
  begin

    // get the callers state
    reg0 ( valset caller )
    task.state@ ( valset state )

    // test if its suspended
    TS_SUSPENDED == ( valset true|false )
  until
*/

tp: caller

  // transfer to callers stack
  reg0 ( valset caller )

tp: ontoCallerStack
  >auxStack ( )

  // signal caller
  reg0 ( caller )
  task.signal ( )
;

/*----------------------------------------------------------------------------*/
/* add set dic path                                                           */
/*----------------------------------------------------------------------------*/
: addDicPath

  // add dicStack! indirect
  seitf.path@ ( valset path... #folders )
  "dicStack!" ( valset path... #folders "dicStack!" )

tp: layeringDicPath

  $$>valset ( valset )
;

/*----------------------------------------------------------------------------*/
/* add send to participants                                                   */
/*----------------------------------------------------------------------------*/
: addParticipants

  ">participants>" ( valset ">participants>" )

tp: layeringParts

  $$>valset ( valset )
;

/*----------------------------------------------------------------------------*/
/* add send to one participant                                                */
/*----------------------------------------------------------------------------*/
: addParticipant ( valset node -- valset )

  ">participant>" ( valset node ">participant>" )

 tp: layeringPart

  $$>valset ( valset )
;

/*----------------------------------------------------------------------------*/
/* add set caller                                                             */
/*----------------------------------------------------------------------------*/
: addCaller

  task.this "setCaller"

tp: layeringCaller

  $$>valset
;

/*----------------------------------------------------------------------------*/
/* add set sender                                                             */
/*----------------------------------------------------------------------------*/
: addSender

  args.node "setSender"

tp: layeringSender

  $$>valset
;

/*----------------------------------------------------------------------------*/
/* add passOnToCp                                                             */
/*----------------------------------------------------------------------------*/
: addPassOnToCp

  "passOnToCp"

tp: passingOnToCp

  $$>valset
;

/*----------------------------------------------------------------------------*/
/* add notifyPp                                                               */
/*----------------------------------------------------------------------------*/
: addNotifyPp

  args.node "notifyPp"

  tp: notifyingPp

  $$>valset
;

/*----------------------------------------------------------------------------*/
/* pass indirect call to coordinator proxy                                    */
/*----------------------------------------------------------------------------*/
: passOnToCp

  cpTasks @

  >taskQueue

  true
;

/*----------------------------------------------------------------------------*/
/* put indirect call into participant proxy queue                             */
/*----------------------------------------------------------------------------*/
: enqueuePP ( indirect targetNodeNo -- )

  ppTasks @

  >taskQueue

;

/*----------------------------------------------------------------------------*/
/* notifyPp                                                                   */
/*----------------------------------------------------------------------------*/
: notifyPp

  reg.push
  ppTasks @
  >reg0
  >caller
  reg.pop

  true
;

/*----------------------------------------------------------------------------*/
/* remove caller                                                              */
/*----------------------------------------------------------------------------*/
: removeCaller

  valset>
tp: removingCaller

  3 == assert

  "setCaller" streql assert

  drop

tp: removedCaller
;

/*----------------------------------------------------------------------------*/
/* interlinkParts                                                             */
/*----------------------------------------------------------------------------*/
: interlinkParts ( -- )

  // attach queue to task
  reg1 ( queue )
  reg0 ( queue task )
  task.queue! ( )

  // put task in taskset
  reg0 ( task )
  reg2 ( task taskset )
  taskset.append ( )

  // attach taskset to thread
  reg2 ( taskset )
  reg3 ( taskset thread )
  thread.taskset! ( )

  // record taskset in task
  reg2 ( taskset )
  reg0 ( task )
  task.taskset! ( )
;

/*----------------------------------------------------------------------------*/
/* get task of an actor                                                       */
/*----------------------------------------------------------------------------*/
: actor.task ( "<actorNm>" -- task )

  ".task" concat find execute
;

/*----------------------------------------------------------------------------*/
/* get queue of an actor                                                      */
/*----------------------------------------------------------------------------*/
: actor.queue ( "<actorNm>" -- queue )

  ".queue" concat find execute
;

/*----------------------------------------------------------------------------*/
/* get taskset of an actor                                                    */
/*----------------------------------------------------------------------------*/
: actor.taskset ( "<actorNm>" -- taskset )

  ".taskset" concat find execute
;

/*----------------------------------------------------------------------------*/
/* get thread of an actor                                                     */
/*----------------------------------------------------------------------------*/
: actor.thread ( "<actorNm>" -- taskset )

  ".thread" concat find execute
;

/*----------------------------------------------------------------------------*/
/* spawn thread of an actor                                                   */
/*----------------------------------------------------------------------------*/
: actor.spawn ( ... nArgs "<actorNm>" "<loopNm>" -- )

  >r ( ... nArgs "<actorNm>" )

  // seed the task
  r@ actor.task task.seed ( )

  // find the thread
  r@ actor.thread thread.spawn ( )

  rdrop
;

/*----------------------------------------------------------------------------*/
/* create an actor (but don't spawn thread)                                   */
/*----------------------------------------------------------------------------*/
: actor: ( -- )

  // get token from compile stream
  token ( s )

  reg.push

  dup ".task"    concat :task    execute >reg0  // reg0 has task
  dup ".queue"   concat :queue   execute >reg1  // reg1 has queue
  dup ".taskset" concat :taskset execute >reg2  // reg2 has taskset
  dup ".thread"  concat :thread  execute >reg3  // reg3 has thread

  interlinkParts

  reg.pop

  drop
;

/*----------------------------------------------------------------------------*/
/* create an actor (but don't spawn thread)                                   */
/*----------------------------------------------------------------------------*/
: :actor ( "<actorNm>" -- "<actorNm>" )

  reg.push

  dup ".task"    concat :task    execute >reg0  // reg0 has task
  dup ".queue"   concat :queue   execute >reg1  // reg1 has queue
  dup ".taskset" concat :taskset execute >reg2  // reg2 has taskset
  dup ".thread"  concat :thread  execute >reg3  // reg3 has thread

  interlinkParts

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* expand valset and execute indirect call                                    */
/*----------------------------------------------------------------------------*/
: exeOne ( <<call*>> -- true )

  valset> ( ... wordName nValues )

  drop ( ... wordName )

tp: callSetUp

  !indirect ( bool )

  assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute all nested valsets                                                 */
/*----------------------------------------------------------------------------*/
: exeAll ( ... valset -- x )

tp: exeAll

  // we exect at least one indirect
  CN_VALSET isType not if assert then

  // execute first indirect
exeOne assert

  // execute all other indirects
  begin

    // no more to execute?
    CN_VALSET isType not
    if
      // return true
      true exit
    then

    // execute next indirect
    exeOne assert

  0 until
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* path for SE                                                                */
/*----------------------------------------------------------------------------*/
: SE_PATH "../OS\ X/Build/Products/Debug/SE" ;

/*----------------------------------------------------------------------------*/
/* form the shell command for spawning a node                                 */
/*----------------------------------------------------------------------------*/
: se_command

  dup
  dup

  //  "nohup "
  ""
  SE_PATH concat
  " --start " concat
  " --size " concat args.regionSize >str concat
  //  " --commands /Users/alkayamarti/rapidsSE/rapidsse/Commands" concat
  " --commands /Users/ray/Desktop/rapidsse/Commands" concat
  " --region /SE_" concat  swap >str concat
  " --node  " concat swap >str concat
  " --nodes " concat args.nodes >str concat
  " --partitions " concat args.partitions >str concat
  " --partition " concat swap >str concat
  " --port  " concat args.port  >str concat
  " --sleep " concat args.sleep >str concat
  args.tracepoint if " --tracepoint " concat then
  args.verbose if " --verbose " concat then

  " &" concat
;

/*----------------------------------------------------------------------------*/
/* spawn all other nodes for a grid on this machine                           */
/*----------------------------------------------------------------------------*/
: spawnNodes

  // test for single node
  args.nodes 1 == if exit then

  // spawn all other nodes
  args.nodes 1 do

    // form the shell command to spawn node I
    I se_command

    // print the shell command
    dup .

    // execute the shell command
    shell.execute

    // check result
    not assert

  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
