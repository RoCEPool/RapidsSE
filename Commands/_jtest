/*============================================================================*/
/* _jtest -- jtest creation and load etc                                      */
/*============================================================================*/

ping

cd tenants
mkten boray

cd boray
cd catalogs
mkcat borayCatalog

cd borayCatalog
cd schemas
mksch boraySchema

cd boraySchema
cd tables

mktbl j1000
add j1000 j1000_key   "INTEGER NOT NULL"
add j1000 j1000_name  "VARCHAR(32) NOT NULL"
add j1000 j1000_j100  "INTEGER NOT NULL"
add j1000 j1000_j10   "INTEGER NOT NULL"

mktbl j100
add j100 j100_key     "INTEGER NOT NULL"
add j100 j100_name    "VARCHAR(32) NOT NULL"
add j100 j100_j10     "INTEGER NOT NULL"

mktbl j10
add j10 j10_key       "INTEGER NOT NULL"
add j10 j10_name      "VARCHAR(32) NOT NULL"

print "loading j1000.tbl..."
ld j1000 "../JTEST/j1000.csv"

print "loading j100.tbl..."
ld j100 "../JTEST/j100.csv"

print "loading j10.tbl..."
ld j10 "../JTEST/j10.csv"

pwd
ls

