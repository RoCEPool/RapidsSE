/*============================================================================*/
/* _jtest -- jtest creation and load etc                                      */
/*============================================================================*/

ping

cld tenants
mkten boray

cld boray
cld catalogs
mkcat borayCatalog

cld borayCatalog
cld schemas
mksch boraySchema

cld boraySchema
cld tables

create table j1000 (
  j1000_key INTEGER NOT NULL,
  j1000_name  VARCHAR(32) NOT NULL,
  j1000_j100  INTEGER NOT NULL,
  j1000_j10   INTEGER NOT NULL
);


create table j100 (
  j100_key   INTEGER NOT NULL,
  j100_name  VARCHAR(32) NOT NULL,
  j100_j10   INTEGER NOT NULL
);

create table j10 (
  j10_key   INTEGER NOT NULL,
  j10_name  VARCHAR(32) NOT NULL
);

print "loading j1000.tbl..."
ld j1000 "../JTEST/j1000.csv"

print "loading j100.tbl..."
ld j100 "../JTEST/j100.csv"

print "loading j10.tbl..."
ld j10 "../JTEST/j10.csv"

pld
ls

sel j10

cp j10 k10

ex k10 "/tmp/k10.txt"

