/*============================================================================*/
/* _cdt -- candidate path testing                                             */
/*============================================================================*/

create table jCdt (
  jA   INTEGER,
  jB   INTEGER,
  jC   INTEGER,
  jD   INTEGER
);

create index jCdt_idx1 on jCdt (jA);
create index jCdt_idx2 on jCdt (jA,jB);
create index jCdt_idx3 on jCdt (jA,jB,jC);
create index jCdt_idx4 on jCdt (jA,jB,jC,jD);

ld jCdt "../JTEST/jCdt.csv";

//dumpidx jCdt jCdt_idx1;

//print "\nSelecting rows with key <= 7 using idx1 ...\n" ;
//uprselidx jCdt jCdt_idx1 7 ;

lwrselidx jCdt jCdt_idx1 1 ;

// lower bound
fetch jCdt "jA 5 >=" ;

// upper bound
fetch jCdt "jA 5 <=" ;

// exact bound
fetch jCdt "jA 5 ==" ;

// range bound
fetch jCdt "jA 8 <= jA 1 >= and" ;

