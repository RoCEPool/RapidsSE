/*============================================================================*/
/* _cdt -- candidate path testing                                             */
/*============================================================================*/

create table jCdt (
  jA   INTEGER,
  jB   INTEGER,
  jC   INTEGER,
  jD   INTEGER
);

create index jCdt_idx1 on jCdt (jA);
//create index jCdt_idx2 on jCdt (jA,jB);
//create index jCdt_idx3 on jCdt (jA,jB,jC);
//create index jCdt_idx4 on jCdt (jA,jB,jC,jD);

docol stepsReset;
ld jCdt "../JTEST/jCdt.csv";
docol stepsList;

print "dumping hidden index\n" ;

dumpidx jCdt jCdt_idx1;

//print "\nSelecting rows with key <= 7 using idx1 ...\n" ;
fetch jCdt "jA 7 <=";

fetch jCdt "jA 1 >=" ;

// upper bound
fetch jCdt "jA 5 <=" ;

// full table
fetch jCdt "jB 1 >=" ;

//docol epochTake;

// exact bound
fetch jCdt "jA 5 ==" ;

// lower bound
fetch jCdt "jA 5 >=" ;

// range bound
fetch jCdt "jA 1 >= jA 8 <= and" ;
fetch jCdt "jA 8 <= jA 1 >= and" ;

//fetch jCdt "jA 1 >= jA 8 <= or" ;

//docol epochDump;

drop table jCdt;

