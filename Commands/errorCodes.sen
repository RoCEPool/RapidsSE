/*============================================================================*/
/* errorCodes.sen -- error codes for se                                       */
/*============================================================================*/

"seErrorCodes.sen" .

  0  constant  EC_SUCCESS

  1  constant  EC_NOT_IN_TENANTS
  2  constant  EC_NOT_IN_CATALOGS
  3  constant  EC_NOT_IN_SCHEMAS
  4  constant  EC_NOT_IN_TABLES

 11  constant  EC_NO_SUCH_TENANT
 12  constant  EC_NO_SUCH_CATALOG
 13  constant  EC_NO_SUCH_SCHEMA
 14  constant  EC_NO_SUCH_TABLE

 21  constant  EC_NOT_A_TENANT
 22  constant  EC_NOT_A_CATALOG
 23  constant  EC_NOT_A_SCHEMA
 24  constant  EC_NOT_A_TABLE

"success"          constant  EM_SUCCESS

"not in tenants"   constant  EM_NOT_IN_TENANTS
"not in catalogs"  constant  EM_NOT_IN_CATALOGS
"not in schemas"   constant  EM_NOT_IN_SCHEMAS
"not in tables"    constant  EM_NOT_IN_TABLES

"no such tenant"   constant  EM_NO_SUCH_TENANT
"no such catalog"  constant  EM_NO_SUCH_CATALOG
"no such schema"   constant  EM_NO_SUCH_SCHEMA
"no such table"    constant  EM_NO_SUCH_TABLE

"not a tenant"     constant  EM_NOT_A_TENANT
"not a catalog"    constant  EM_NOT_A_CATALOG
"not a schema"     constant  EM_NOT_A_SCHEMA
"not a table"      constant  EM_NOT_A_TABLE

/*----------------------------------------------------------------------------*/
/* convert EC error code to EM error message                                  */
/*----------------------------------------------------------------------------*/
: toEM

  dup EC_SUCCESS == if drop EM_NOT_IN_TENANTS exit then

  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then
  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then
  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then
  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then

  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then
  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then
  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then
  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then

  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then
  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then
  dup EC_NOT_IN_TENANTS == if drop EM_NOT_IN_TENANTS exit then

  "unknown error code " swap concat
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/