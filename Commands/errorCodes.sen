/*============================================================================*/
/* errorCodes.sen -- error codes for se                                       */
/*============================================================================*/

"errorCodes.sen" .putVerbose

  0  constant  EC_SUCCESS

  1  constant  EC_NOT_IN_TENANTS
  2  constant  EC_NOT_IN_CATALOGS
  3  constant  EC_NOT_IN_SCHEMAS
  4  constant  EC_NOT_IN_TABLES

 11  constant  EC_NO_SUCH_TENANT
 12  constant  EC_NO_SUCH_CATALOG
 13  constant  EC_NO_SUCH_SCHEMA
 14  constant  EC_NO_SUCH_TABLE
 15  constant  EC_NO_SUCH_FOLDER

 21  constant  EC_NOT_A_TENANT
 22  constant  EC_NOT_A_CATALOG
 23  constant  EC_NOT_A_SCHEMA
 24  constant  EC_NOT_A_TABLE
 25  constant  EC_NOT_A_FOLDER

 26  constant  EC_CATALOG_EXISTS
 27  constant  EC_SCHEMA_EXISTS
 28  constant  EC_TABLE_EXISTS
 29  constant  EC_TENANT_EXISTS

999  constant  EC_NO_SUCH_WORD
998  constant  EC_NO_COLUMNS_DIC
997  constant  EC_NOT_IN_COLUMNS

"success"            constant  EM_SUCCESS

"not in tenants"     constant  EM_NOT_IN_TENANTS
"not in catalogs"    constant  EM_NOT_IN_CATALOGS
"not in schemas"     constant  EM_NOT_IN_SCHEMAS
"not in tables"      constant  EM_NOT_IN_TABLES

"no such tenant"     constant  EM_NO_SUCH_TENANT
"no such catalog"    constant  EM_NO_SUCH_CATALOG
"no such schema"     constant  EM_NO_SUCH_SCHEMA
"no such table"      constant  EM_NO_SUCH_TABLE
"no such dictionary" constant  EM_NO_SUCH_FOLDER

"not a tenant"       constant  EM_NOT_A_TENANT
"not a catalog"      constant  EM_NOT_A_CATALOG
"not a schema"       constant  EM_NOT_A_SCHEMA
"not a table"        constant  EM_NOT_A_TABLE
"not a dictionary"   constant  EM_NOT_A_FOLDER

"no such word"       constant  EM_NO_SUCH_WORD
"no columns dic"     constant  EM_NO_COLUMNS_DIC
"not in tables"      constant  EM_NOT_IN_COLUMNS

"catalog exists"     constant  EM_CATALOG_EXISTS
"schema exists"      constant  EM_SCHEMA_EXISTS
"table exists"       constant  EM_TABLE_EXISTS
"tenant exists"      constant  EM_TENANT_EXISTS


/*----------------------------------------------------------------------------*/
/* convert EC error code to EM error message                                  */
/*----------------------------------------------------------------------------*/

: toEM

  dup EC_SUCCESS == if drop EM_NOT_IN_TENANTS exit then

  dup EC_NOT_IN_TENANTS     == if drop EM_NOT_IN_TENANTS     exit then
  dup EC_NOT_IN_CATALOGS    == if drop EM_NOT_IN_CATALOGS    exit then
  dup EC_NOT_IN_SCHEMAS     == if drop EM_NOT_IN_SCHEMAS     exit then
  dup EC_NOT_IN_TABLES      == if drop EM_NOT_IN_TABLES      exit then

  dup EC_NO_SUCH_TENANT     == if drop EM_NO_SUCH_TENANT     exit then
  dup EC_NO_SUCH_CATALOG    == if drop EM_NO_SUCH_CATALOG    exit then
  dup EC_NO_SUCH_SCHEMA     == if drop EM_NO_SUCH_SCHEMA     exit then
  dup EC_NO_SUCH_TABLE      == if drop EM_NO_SUCH_TABLE      exit then

  dup EC_NOT_A_TENANT       == if drop EM_NOT_A_TENANT       exit then
  dup EC_NOT_A_CATALOG      == if drop EM_NOT_A_CATALOG      exit then
  dup EC_NOT_A_SCHEMA       == if drop EM_NOT_A_SCHEMA       exit then
  dup EC_NOT_A_TABLE        == if drop EM_NOT_A_TABLE        exit then

  dup EC_NO_SUCH_WORD       == if drop EM_NO_SUCH_WORD       exit then
  dup EC_NO_COLUMNS_DIC     == if drop EM_NO_COLUMNS_DIC     exit then
  dup EC_NOT_IN_COLUMNS     == if drop EM_NOT_IN_COLUMNS     exit then
  dup EC_NO_SUCH_FOLDER     == if drop EM_NO_SUCH_FOLDER     exit then
  dup EC_NOT_A_FOLDER       == if drop EM_NOT_A_FOLDER       exit then

  dup EC_CATALOG_EXISTS     == if drop EM_CATALOG_EXISTS     exit then
  dup EC_SCHEMA_EXISTS      == if drop EM_SCHEMA_EXISTS      exit then
  dup EC_TABLE_EXISTS       == if drop EM_TABLE_EXISTS       exit then
  dup EC_TENANT_EXISTS      == if drop EM_TENANT_EXISTS      exit then

  "unknown error code " swap concat
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/