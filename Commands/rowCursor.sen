/*============================================================================*/
/* rowCursor.sen -- Row Cursor                                                */
/*============================================================================*/

"rowCursor.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create a rowCursor using name from input stream                            */
/*----------------------------------------------------------------------------*/
: rowCursor:
    create
    object!!
    sizeof_rowCursor allot
    word.this >body magic!!
    word.this >body CN_ROWCURSOR class!
    word.this >body rowCursor.init
    does>
;

/*----------------------------------------------------------------------------*/
/* create a rowCursor using name on the stack (leaves on stack)               */
/*----------------------------------------------------------------------------*/
: :rowCursor
    >create
    object!!
    sizeof_rowCursor allot
    word.this >body magic!!
    word.this >body CN_ROWCURSOR class!
    word.this >body rowCursor.init
    word.this
    does>
;

////////////////////////////////////////////////////////////////////////////////

: rowDump ( ^ table )

    "__row_cursor" find dup if else
      drop
      "__row_cursor" :rowCursor
    then
    execute

    >r
    // r0 ^rowCursor

    r0 rowcursor.table!
    partitions 0
    do
      // r2 ^rowCursor
      I r2 rowcursor.begin
      r2 rowcursor.first
      begin
        while
        r2 rowcursor.get
        .
        r2 rowcursor.next
      repeat

      r2 rowCursor.end
    loop

    rdrop

    "__row_cursor" find >forget
;

: cursorTest

    "nation" find execute

    rowDump
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/