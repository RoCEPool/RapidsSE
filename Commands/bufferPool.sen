/*============================================================================*/
/* bufferPool.sen -- bufferPool related tools                                 */
/*============================================================================*/

"bufferPool.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get a snapshot of the buffer pool objects                                  */
/*----------------------------------------------------------------------------*/
: snapshot (  )

  reg.push

  bp.snapshot ( int int .... #classes )

  >valset
  >reg0

  bp.snapshot ( int int .... #classes )

  >valset
  >reg1

  reg1 reg0 vector.diff

  0 do
    I class.name
    "%v %v" str.format .
  loop

  reg.pop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
