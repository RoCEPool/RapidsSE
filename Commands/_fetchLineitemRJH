/*============================================================================*/
/* _fetchLineitemRJH - predicateFetch TPC-H LineItem table                             */
/*============================================================================*/

/api /tags pipeline lineitem_fetch
begin

  stage stageA on origin:
    start | periodicOp once | stageB

  stage stageB on all partitions:
    scan lineitem | stageC

  stage stageC on origin:
    output | sink | stageA

end;

