/*============================================================================*/
/* _fetchLineitemRJH - fetch TPC-H LineItem table                             */
/*============================================================================*/

/api /tags pipeline lineitem_fetch
begin

  stage stageA on origin:
    startOp | periodicOp once | stageB

  stage stageB on all partitions:
    scan lineitem | stageC

  stage stageC on origin:
    output | sinkOp | stageA

end;

