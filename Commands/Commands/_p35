/*============================================================================*/
/* _p35 -- testing of R3.5 partition commands                                 */
/*============================================================================*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// create the four tables

create table tableA (
  col1   INTEGER NOT NULL,
  col2   INTEGER NOT NULL
);

create table tableB (
  col1   INTEGER NOT NULL,
  col2   INTEGER NOT NULL
);

create table tableC (
  col1   INTEGER NOT NULL,
  col2   INTEGER NOT NULL
);

create table tableD (
  col1   INTEGER NOT NULL,
  col2   INTEGER NOT NULL
);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// run four p35 commands, one for each table

print "p35 tableA";
p35 "tableA" &;

print "p35 tableB";
p35 "tableB" &;

print "p35 tableC";
p35 "tableC" &;

print "p35 tableD";
p35 "tableD" &;

