logNote "Running script: _pt";

print "";
print "=====================================================================";
print "removing the pipe...";
print "=====================================================================";
rmfifo "/tmp/a.pipe";
rmfifo "/tmp/b.pipe";
rmfifo "/tmp/c.pipe";

print "";
print "=====================================================================";
print "making the pipe...";
print "=====================================================================";
mkfifo "/tmp/a.pipe";
mkfifo "/tmp/b.pipe";
mkfifo "/tmp/c.pipe";

print "";
print "=====================================================================";
print "piping lineitem.csv...";
print "=====================================================================";

nowait cat "/tpch/SF100/lineitem.csv" "/tmp/a.pipe" ;
nowait cat "/tmp/a.pipe" "/tmp/b.pipe" ;
nowait cat "/tmp/b.pipe" "/tmp/c.pipe" ;
nowait sink "/tmp/c.pipe" stats ;

