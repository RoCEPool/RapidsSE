/*============================================================================*/
/* thread.sen -- thread related words                                         */
/*============================================================================*/

"thread.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create a thread using string from input stream as name                     */
/*----------------------------------------------------------------------------*/

: thread:
    create 
    object!!
    sizeof_thread allot
    word.this >body magic!!
    word.this >body CN_THREAD class!
    word.this >body thread.init
    word.this >body object.wordbody
    does>
;

: :thread
    >create
    object!!
    sizeof_thread allot
    word.this >body magic!!
    word.this >body CN_THREAD class!
    word.this >body thread.init
    word.this >body object.wordbody
    word.this
    does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
