/*============================================================================*/
/* grid.sen -- grid routines                                                  */
/*============================================================================*/

"grid.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* grid is use as a kind of word to identify grids                            */
/*----------------------------------------------------------------------------*/
: grid ;

: isGrid word.kind@ ' grid eql ;

: <SUCCESS_RESULT> args.node true ( v n# true ) ;

: <FAILURE_RESULT> args.node false ( ec n# false ) ;

/*----------------------------------------------------------------------------*/
/* check grid result                                                          */
/*----------------------------------------------------------------------------*/
: checkResult ( v t n# | ec f n# .... nn t/f )

tp: checkResult

  // was the final result true ?
  true == if

    // drop the result
    depth dropN

  else
    // lets see which node failed
    0 do

    false == if

      "Node"  ( .... ec n# "Node" )
      prepend ( ... ec "Node n#" )
      " returned error " concat ( ... ec "Node n# returned error " )
      prepend ( "NODE n# FAILED with ERROR " )
      .
    else

      drop drop
    then

    loop

  then
;
/*----------------------------------------------------------------------------*/
/* create a grid using name from input stream                                 */
/*----------------------------------------------------------------------------*/
: grid:
    create
    object!!
    sizeof_grid allot
    word.this >body magic!!
    word.this >body CN_GRID class!
    word.this >body grid.init
    ' grid word.this word.kind!
    word.this >body object.wordbody
    does>
;

/*----------------------------------------------------------------------------*/
/* create a grid using name on the stack (leaves grid word on stack)          */
/*----------------------------------------------------------------------------*/
: :grid
    >create
    object!!
    sizeof_grid allot
    word.this >body magic!!
    word.this >body CN_GRID class!
    word.this >body grid.init
    ' grid word.this word.kind!
    word.this >body object.wordbody
    word.this
    does>
;

////////////////////////////////////////////////////////////////////////////////

grid: grid.this

0 node.new grid.appendNode

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
