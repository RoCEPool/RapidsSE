/*============================================================================*/
/* _bm_insidx -- insert index benchmark                                       */
/*============================================================================*/

startCluster;

pwf ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_1;
print "** 1/n) run __report setup";

__report

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_2;
print "** 2/n) create ALLCOLS_TABLE table";

trackMemory;

_allCols_Table

lscol ALLCOLS_TABLE;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_3;
print "** 3/n) create ALLCOLS_INDEX_int index on ALLCOLS_TABLE(int) column";

create index ALLCOLS_INDEX_int on ALLCOLS_TABLE(int);

lsidx ALLCOLS_TABLE;

lsidxcol ALLCOLS_TABLE ALLCOLS_INDEX_int;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_4;
print "** 4/n) ";


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_7;
print "** 7/n) drop ALLCOLS_TABLE";

drop table ALLCOLS_TABLE;

memoryLeaks fatal;

print "** 8/8) success _bm_insidx";

