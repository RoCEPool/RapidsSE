/*----------------------------------------------------------------------------*/
/* answer service demon                                                       */
/*----------------------------------------------------------------------------*/
/nowait pipelineLocal answerD

  //tag "<pre_execute>" = "demon::install" endTag

begin

  stage stageA on origin:
  start | answerOP | eatAll | stageA

end;

/*----------------------------------------------------------------------------*/
/* connector service demon                                                    */
/*----------------------------------------------------------------------------*/
/nowait pipelineLocal connectorD

//tag "<pre_execute>" = "demon::install" endTag

begin

  stage stageA on origin:
  start | connectorOP | eatAll | stageA

end;

/*----------------------------------------------------------------------------*/
/* recurring service demon                                                    */
/*----------------------------------------------------------------------------*/
/nowait pipelineLocal recurringD

  //tag "<pre_execute>" = "demon::install" endTag

begin

    stage stageA on origin:
      start | recurring | eatAll | stageA

end;

/*----------------------------------------------------------------------------*/
/* statistics service demon                                                   */
/*----------------------------------------------------------------------------*/
/nowait pipelineLocal statD

  tag "<pre_execute>" = "demon::install" endTag

begin

  stage stageA on origin:
    start | statWrite | eatAll | stageA

end;


