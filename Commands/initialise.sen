/*============================================================================*/
/* initialise.sen -- initialise the dictionary                                */
/*============================================================================*/

"initialise.sen" .

//
// step 1: compile all the words
//

"core.sen" >>:
"common.sen" >>:
"structures.sen" >>:
"tasks.sen" >>:
"threads.sen" >>:
"transactions.sen" >>:
"interface.sen" >>:
"dbobjects.sen" >>:
"gridModel.sen" >>:
"systemObjects.sen" >>:
"actors.sen" >>:
"commands.sen" >>:
"testing.sen" >>:

//
// step 2: spawn the root thread
//

( spawn the posix thread for the root thread )
rootThread thread.spawn

( leave root thread on stack )
rootThread

: __initialised__ ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/