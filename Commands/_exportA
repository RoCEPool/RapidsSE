/*============================================================================*/
/* _exportA - export of TPC-H LineItem table                                  */
/*============================================================================*/

print "\n";
print "**************************************************************************";
print "A) Exporting LineItem";
print "**************************************************************************";

time pipeline exportA
begin
 
  stage scanBuffers on all partitions:

    scanOp LineItem | outputCsv


  stage outputCsv on origin:

    toCsvOp | toFileOp "/tmp/LineItemA.csv" | output
 
end
;

