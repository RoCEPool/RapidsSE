/*============================================================================*/
/* commandSet.sen -- the system command set                                   */
/*============================================================================*/

"commandSet.sen" .

: success 0 2 ;

: failure 2 ;

/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect
    "connected" success
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect
    "disconnected" success
;

/*----------------------------------------------------------------------------*/
/* drop a dictionary                                                          */
/*----------------------------------------------------------------------------*/
: drop_dictionary ( "<dicname>" -- "dropped dictionary" 1 2 )
    find
    dup word.kind@ ' dic eql not if drop "not a dictionary" 1 failure exit then
    >forget
    "dropped dictionary" success
;

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
: create_tenant
    :dic dup ' tenant swap word.kind! execute {{
      "catalogs" :dic drop
    }}
    "created tenant" success
;

/*----------------------------------------------------------------------------*/
/* get list of tenants                                                        */
/*----------------------------------------------------------------------------*/
: list_tenants
  "<tenant-list>" success
;

/*----------------------------------------------------------------------------*/
/* create a catalog                                                           */
/*----------------------------------------------------------------------------*/
: create_catalog
    :dic dup ' catalog swap word.kind! execute {{
      "schemas" :dic drop
    }}
    "created catalog" success
;

/*----------------------------------------------------------------------------*/
/* get list of catalogs                                                       */
/*----------------------------------------------------------------------------*/
: list_catalogs
  "<catalog-list>" success
;

/*----------------------------------------------------------------------------*/
/* create a schema                                                            */
/*----------------------------------------------------------------------------*/
: create_schema
    :dic dup ' schema swap word.kind! execute {{
      "tables" :dic drop
    }}
    "created schema" success
;

/*----------------------------------------------------------------------------*/
/* get list of schemas                                                        */
/*----------------------------------------------------------------------------*/
: list_schemas
  "<schema-list>" success
;

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table
    :table drop
    "created table" success
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables
  "<table-list>" success
;

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns
  "<column-list>" success
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "filename" "tablename" )
    find execute ( "filename" table )
    swap
    "load.sen" >>:
    "loaded table" success
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- "text" n 2 )

    // traceon

    find execute   ( "<to-tableNm>" ^fromTable )

    swap           ( ^fromTable "<to-tableNm>" )

    :table execute ( ^fromTable ^toTable )

    swap           ( ^toTable ^fromTable )

    table.copy     ( )

    "table copied" success

    // traceoff
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "filename" "tablename" )
    find execute ( "filename" table )
    swap
    "export.sen" >>:
    "exported table" success
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "tablename" )
    find execute ( table )
    table.space
    >str success
;

/*----------------------------------------------------------------------------*/
/* get first buffer of table                                                  */
/*----------------------------------------------------------------------------*/
: select_table ( "tablename" )
    find execute ( table )
    table.firstBuffer
    >str success
;

/*----------------------------------------------------------------------------*/
/* get address of table                                                       */
/*----------------------------------------------------------------------------*/
: address_table ( "tablename" )
    find execute ( table )
    >str success
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "tablename" )
    find execute ( table )
    table.truncate
    "table truncated" success
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tablename>" -- "dropped table" 1 2 )
    find
    dup word.kind@ ' table eql not if drop "not a table" 0 2 exit then
    dup execute table.truncate
    >forget
    "dropped table" success
;

/*----------------------------------------------------------------------------*/
/* drop a schema                                                              */
/*----------------------------------------------------------------------------*/
: drop_schema ( "<schemaname> -- "dropped schema" 1 2 )
    find
    dup word.kind@ ' schema eql not if drop "not a schema" 0 2 exit then
    >forget
    "dropped schema" success
;

/*----------------------------------------------------------------------------*/
/* drop a catalog                                                             */
/*----------------------------------------------------------------------------*/
: drop_catalog ( "<catalogname> -- "dropped catalog" 1 2 )
    find
    dup word.kind@ ' catalog eql not if drop "not a catalog" 0 2 exit then
    >forget
    "dropped catalog" success
;

/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
: drop_tenant ( "<tenantname> -- "dropped tenant" 1 2 )
    find
    dup word.kind@ ' tenant eql not if drop "not a tenant" 0 2 exit then
    >forget
    "dropped tenant" success
;

/*----------------------------------------------------------------------------*/
/* change dictionary                                                          */
/*----------------------------------------------------------------------------*/
: cd

    dup ".." streql if
      drop
      dic.drop
    else
      dup "~" streql if
        drop
        begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
      else
        find execute dic.push
      then
    then

    "changed" success
;

/*----------------------------------------------------------------------------*/
/* print working dictionary                                                   */
/*----------------------------------------------------------------------------*/
: pwd
    ""
    dic.count 0 do I dic.pick dic.name concat " " concat loop
    success
;

/*----------------------------------------------------------------------------*/
/* list dictionary contents                                                   */
/*----------------------------------------------------------------------------*/
: ls_old
    word.this
    begin dup
      while
        dup word.kind@ word.name ' word word.name streql not if
          dup nameWord .put " is a " .put dup word.kind@ nameword .put .\n
        then
        prevWord
      repeat
    drop
    "done" success
;

: ls
    ""                             // initial ls string
    word.this dup iterate          // setup iteration of words
      "(" concat                   //
      object@ word.name concat     // add name of the word to ls string
                                   // add word kind to ls string
      " " concat
      object@ word.kind@ word.name concat
                                   // add size of table to ls string
      object@ isTable if
        " " concat
        object@ execute table.space >str concat
      then
      ")\n" concat                 //
      object@ prevWord object!     // step backwards thru words
    next
    success
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping
    "pong" success
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x
    words
    "x" success
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/