/*============================================================================*/
/* commandSet.sen -- the system command set                                   */
/*============================================================================*/

"commandSet.sen" .

/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect
    1 "connected" 2
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect
    1 "disconnected" 2
;

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
: create_tenant
    dic.main {{
      "tenants" find execute {{
        :dic dup ' tenant swap word.kind! execute {{
          "catalogs" :dic drop
        }}
      }}
    }}
    1 "created tenant" 2
;

/*----------------------------------------------------------------------------*/
/* change dictionary                                                          */
/*----------------------------------------------------------------------------*/
: cd
    dup ".." streql if
      dic.drop
    else
      find execute dic.push
    then
    1 "done" 2
;

/*----------------------------------------------------------------------------*/
/* print working dictionary                                                   */
/*----------------------------------------------------------------------------*/
: pwd
    ""
    dic.count 0 do I . I dic.pick dic.name concat " " concat loop
    1 swap 2
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x
    1 "x" 2
;

//------------------------------------------------------------------------------
//------------------------------------------------------------------------------
//------------------------------------------------------------------------------

//------------------------------------------------------------------------------
: create_catalog
    "catalogs" find execute
    {{
      :dic dup ' catalog swap word.kind! execute
      {{
        "schemas" :dic drop
      }}
    }}
    1
;

//------------------------------------------------------------------------------
: create_schema
    "schemas" find execute
    {{
      :dic dup ' schema swap word.kind! execute
      {{
        "tables" :dic drop
      }}
    }}
    1
;

//------------------------------------------------------------------------------
: create_table
    :table drop
;

//------------------------------------------------------------------------------
: drop_tenant
;

//------------------------------------------------------------------------------
: drop_catalog
;

//------------------------------------------------------------------------------
: drop_schema
;

//------------------------------------------------------------------------------
: drop_table
  dup word.kind@ ' table eql not if "not a table" . drop exit then
  dup execute table.truncate
  >forget
;

//------------------------------------------------------------------------------
: use_tenant
    dic.main dic.push
      "tenants" find execute dic.push
         find execute dic.push
;

//------------------------------------------------------------------------------
: use_catalog
    "catalogs" find execute dic.push
      find execute dic.push
;

//------------------------------------------------------------------------------
: use_schema
    "schemas" find execute dic.push
      find execute dic.push
;

//------------------------------------------------------------------------------
: use_table ;

//------------------------------------------------------------------------------
: export
  literal> ( "tableName" ) find execute ( table )
  literal> ( table "fileName" )
  "export.sen" >>:
;

//------------------------------------------------------------------------------
: tbl:
  table:
  "table" find swap word.kind!
;

//------------------------------------------------------------------------------
: rm
  traceon
  literal> find dup word.kind@ word.name
  dup "tenant"  streql if drop drop_tenant  exit then
  dup "catalog" streql if drop drop_catalog exit then
  dup "schema"  streql if drop drop_schema  exit then
  dup "table"   streql if drop drop_table   exit then
  "huh?" . drop
;

//------------------------------------------------------------------------------
: mk
  // traceon
  0 dic.pick dic.name "tenants"  streql if literal> create_tenant  exit then
  0 dic.pick dic.name "catalogs" streql if literal> create_catalog exit then
  0 dic.pick dic.name "schemas"  streql if literal> create_schema  exit then
  0 dic.pick dic.name "tables"   streql if literal> create_table   exit then
  "huh?" . drop
;

//------------------------------------------------------------------------------
: ls
  word.this
  begin dup while
    dup word.kind@ word.name ' word word.name streql not if
      dup nameWord .put " is a " .put dup word.kind@ nameword .put .\n
    then
    prevWord
  repeat
  drop
;

//------------------------------------------------------------------------------
: load
  literal> ( "tableName" ) find execute ( table )
  literal> ( table "fileName" )
  traceoff
  "load.sen" >>:
;

//------------------------------------------------------------------------------
: size
   literal> ( "tableName" ) find execute ( table )
   table.space .
;

//------------------------------------------------------------------------------
: trunc
  literal> ( "tableName" ) find execute ( table )
  table.truncate
;

//------------------------------------------------------------------------------
: help
  "cd   -- change directory" .
  "load -- load table" .
  "ls   -- list directory contents" .
  "mk   -- make tenant/catalog/schema/table" .
  "pwd  -- print working directory" .
  "size -- print size of table" .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/