/*============================================================================*/
/* commandSet.sen -- the system command set                                   */
/*============================================================================*/

"commandSet.sen" .

: success 0 2 ;

: failure 2 ;

: withinTenants
    0 dic.pick dic.name "tenants" streql
;

: withinCatalogs
    0 dic.pick dic.name "catalogs" streql
;

: withinSchemas
    0 dic.pick dic.name "schemas" streql
;

: withinTables
    0 dic.pick dic.name "tables" streql
;

: withinColumns
    0 dic.pick dic.name "columns" streql
;

: checkInTenants
    withinTenants if 1 exit then
    "not in tenants" 1 failure 0
;

: checkInCatalogs
    withinCatalogs if 1 exit then
    "not in catalogs" 1 failure 0
;

: checkInSchemas
    withinSchemas if 1 exit then
    "not in schemas" 1 failure 0
;

: checkInTables
    withinTables if 1 exit then
    "not in tables" 1 failure 0
;

: checkInColumns
    withinColumns if 1 exit then
    "not in columns" 1 failure 0
;

: checkIsKnown ( word )
    dup not if drop "no such word" 1 failure 0 exit then
    1
;

: checkIsDic ( word )

    dup not if drop "no such dictionary" 1 failure 0 exit then

    dup word.kind@ ' dic eql if 1 exit then
    drop
    "not a dictionary" 1 failure 0
;

: checkIsTenant ( word )

    dup not if drop "no such tenant" 1 failure 0 exit then

    dup word.kind@ ' tenant eql if 1 exit then
    drop
    "not a tenant" 1 failure 0
;

: checkIsCatalog ( word )

    dup not if drop "no such catalog" 1 failure 0 exit then

    dup word.kind@ ' catalog eql if 1 exit then
    drop
    "not a catalog" 1 failure 0
;

: checkIsSchema ( word )

    dup not if drop "no such schema" 1 failure 0 exit then

    dup word.kind@ ' schema eql if 1 exit then
    drop
    "not a schema" 1 failure 0
;

: checkIsTable ( word )

    dup not if drop "no such table" 1 failure 0 exit then

    dup word.kind@ ' table eql if 1 exit then
    drop
    "not a table" 1 failure 0
;

: createColumnsDic ( table -- table )
    dup table.dic {{ "columns" :dic drop }}
;

: pushTable ( "<tableName>" -- )

    find checkIsKnown

    not if "no such table" 1 failure 0 exit then

    execute table.dic dic.push

    true
;

: popTable
    dic.drop
;

: pushColumns ( -- )

    "columns" find checkIsKnown

    not if "no columns dic" 1 failure 0 exit then

    execute dic.push

    true
;

: popColumns
    dic.drop
;

: :column ( "<columnType>" "<columnName>" )

    :constant
;

: addColumn ( "<columnType>" "<columnName" -- <result> )

    :column

    true
;


: listColumns ( -- )

  ""                             // initial ls string
  0 dic.pick dic.last            // get last word of current dic
  dup                            // setup iteration of words
  iterate                        //

    object@ word.name            // column name

    " " concat
    object@ execute concat       // column type

    swap

    dup strlen
    if " , " swap concat then         //

    concat                       // prepend column to ls

    object@ prevWord object!     // step backwards thru words

  next                           //

  "\n" concat

;

: tableLoader2 ( "<fileNm>" ^table )

    >r          ( "<fileNm>" ) ( R: ^table )

    file.new >r ( "<fileNm>" ) ( R: ^table ^file )

    0 rpick file.path!

    open_read 0 rpick file.open drop

    0 rpick 1 rpick table.load

    0 rpick file.close

    0 rpick file.delete

    rdrop

    rdrop
;

: tableLoader ( "<fileNm>" ^table )

    load if "loaded!" . else . then
;


: tableExporter ( "<fileNm>" ^table )

    >r          ( "<fileNm>" ) ( R: ^table )

    file.new >r ( "<fileNm>" ) ( R: ^table ^file )

    0 rpick file.path!

    open_write 0 rpick file.open drop

    0 rpick 1 rpick table.export

    0 rpick file.close

    0 rpick file.delete

    rdrop

    rdrop
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*

Connection Commands:

  con     connect
  dis     disconnect

Tenant Commands:

  mkten   create_tenant
  lsten   list_tenants
  rmten   drop_tenant

Catalog Commands:

  mkcat   create_catalog
  lscat   list_catalogs
  rmcat   drop_catalog

Schema Commands:

  mksch   create_schema
  lssch   list_schemas
  rmsch   drop_schema

Table Commands:

  mktbl   create_table
  lstbl   list_tables
  add     add_column
  lscol   list_columns
  ld      load_table
  sel     select_table
  cp      copy_table
  ex      export_table
  sz      size_table
  tr      truncate_table
  rmtbl   drop_table

Dictionary Commands:

  cd      cd ..
          cd ~
          cd
  pwd     pwd
  ls      ls

Misc Commands:

  mon     get_monitor
  ping    ping
  x       x

*/


/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect
    "connected" success
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect
    "disconnected" success
;

/*----------------------------------------------------------------------------*/
/* drop a dictionary                                                          */
/*----------------------------------------------------------------------------*/
: drop_dictionary ( "<dicname>" -- "dropped dictionary" 1 2 )

    find

    checkIsDic not if exit then

    >forget

    "dropped dictionary" success
;

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
: create_tenant

    checkInTenants not if exit then

    :dic dup ' tenant swap word.kind! execute {{
      "catalogs" :dic drop
    }}
    "created tenant" success
;

/*----------------------------------------------------------------------------*/
/* get list of tenants                                                        */
/*----------------------------------------------------------------------------*/
: list_tenants

    checkInTenants not if exit then

    contents_string             // get contents of dic as a string
    success
;

/*----------------------------------------------------------------------------*/
/* create a catalog                                                           */
/*----------------------------------------------------------------------------*/
: create_catalog

    checkInCatalogs not if exit then

    :dic dup ' catalog swap word.kind! execute {{
      "schemas" :dic drop
    }}
    "created catalog" success
;

/*----------------------------------------------------------------------------*/
/* get list of catalogs                                                       */
/*----------------------------------------------------------------------------*/
: list_catalogs

    checkInCatalogs not if exit then

    contents_string             // get contents of dic as a string
    success
;

/*----------------------------------------------------------------------------*/
/* create a schema                                                            */
/*----------------------------------------------------------------------------*/
: create_schema

    checkInSchemas not if exit then

    :dic dup ' schema swap word.kind! execute {{
      "tables" :dic drop
    }}
    "created schema" success
;

/*----------------------------------------------------------------------------*/
/* get list of schemas                                                        */
/*----------------------------------------------------------------------------*/
: list_schemas

    contents_string             // get contents of dic as a string
    success
;

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table

    checkInTables not if exit then

    :table execute createColumnsDic drop

    "created table" success
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables

    checkInTables not if exit then

    contents_string             // get contents of dic as a string
    success
;

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column ( "<columnType>" "<columnName" "<tableName>" -- <response> )

    checkInTables not if exit then

    pushTable not if exit then

    pushColumns not if exit then

    addColumn not if exit then

    popColumns

    popTable

    "created column" success

;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<tableName>" -- <response> )

    checkInTables not if exit then

    pushTable not if exit then

    pushColumns not if exit then

    listColumns

    popColumns

    popTable

    success
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "filename" "tablename" )

    freespace .

    find

    checkIsTable not if exit then

    execute ( "filename" table )

    tableLoader

    freespace .

    "loaded table" success
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "filename" "tablename" )

    find

    checkIsTable not if exit then

    execute ( "filename" table )

    tableExporter

    "exported table" success
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- "text" n 2 )

    find

    checkIsTable not if exit then

    execute        ( "<to-tableNm>" ^fromTable )

    swap           ( ^fromTable "<to-tableNm>" )

    :table execute ( ^fromTable ^toTable )

    swap           ( ^toTable ^fromTable )

    table.copy     ( )

    "table copied" success
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "tablename" )

    find

    checkIsTable not if exit then

    execute ( table )

    table.space
    >str success
;

/*----------------------------------------------------------------------------*/
/* get first buffer of table                                                  */
/*----------------------------------------------------------------------------*/
: select_table ( "tablename" )

traceon

    find

    checkIsTable not if traceoff exit then

    queryCount ++

    execute ( table )

    rowcursor.new dup rot rowcursor.table!

    >str

    success

traceoff
;

/*----------------------------------------------------------------------------*/
/* get address of table                                                       */
/*----------------------------------------------------------------------------*/
: address_table ( "tablename" )

    find

    checkIsTable not if exit then

    execute ( table )

    >str success
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "tablename" )

    find

    checkIsTable not if exit then

    execute ( table )

    table.truncate

    "table truncated" success
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tablename>" -- "dropped table" 1 2 )

    find

    checkIsTable not if exit then

    dup execute table.truncate

    >forget

    "dropped table" success
;

/*----------------------------------------------------------------------------*/
/* drop a schema                                                              */
/*----------------------------------------------------------------------------*/
: drop_schema ( "<schemaname>" -- "dropped schema" 1 2 )

    find

    checkIsSchema not if exit then

    >forget

    "dropped schema" success
;

/*----------------------------------------------------------------------------*/
/* drop a catalog                                                             */
/*----------------------------------------------------------------------------*/
: drop_catalog ( "<catalogname>" -- "dropped catalog" 1 2 )

    find

    checkIsCatalog not if exit then

    >forget

    "dropped catalog" success
;

/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
: drop_tenant ( "<tenantname>" -- "dropped tenant" 1 2 )

    find

    checkIsTenant not if exit then

    >forget

    "dropped tenant" success
;

/*----------------------------------------------------------------------------*/
/* change dictionary                                                          */
/*----------------------------------------------------------------------------*/
: cd

    dup ".." streql if
      drop
      dic.drop
    else
      dup "~" streql if
        drop
        begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
      else
        dup "tenants" streql if
          begin 0 dic.pick dic.name "seitf" streql not while dic.drop repeat
          find
          checkIsKnown not if exit then
          execute dic.push
        else
          find
          checkIsKnown not if exit then
          execute dic.push
        then
      then
    then

    "changed" success
;

/*----------------------------------------------------------------------------*/
/* print working dictionary                                                   */
/*----------------------------------------------------------------------------*/
: pwd

    ""
    dic.count 0 do
      I dic.pick
      dic.name concat
      " " concat
    loop

    success
;

/*----------------------------------------------------------------------------*/
/* list dictionary contents                                                   */
/*----------------------------------------------------------------------------*/
: ls
    ""                             // initial ls string
    word.this dup iterate          // setup iteration of words
      "(" concat                   //
      object@ word.name concat     // add name of the word to ls string
                                   // add word kind to ls string
      " " concat
      object@ word.kind@ word.name concat
                                   // add size of table to ls string
      object@ isTable if
        " " concat
        object@ execute table.space >str concat
      then
      ")\n" concat                 //
      object@ prevWord object!     // step backwards thru words
    next
    success
;

/*----------------------------------------------------------------------------*/
/* get monitor string                                                         */
/*----------------------------------------------------------------------------*/
: get_monitor
    monitorString@ success
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping
    "pong" success
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x
    words
    "x" success
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/