/*============================================================================*/
/* commandSet.sen -- the system command set                                   */
/*============================================================================*/

"commandSet.sen" .

/*----------------------------------------------------------------------------*/
/* connect to SE                                                              */
/*----------------------------------------------------------------------------*/
: connect
    "connected" 1 2
;

/*----------------------------------------------------------------------------*/
/* disconnect from SE                                                         */
/*----------------------------------------------------------------------------*/
: disconnect
    "disconnected" 1 2
;

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
: create_tenant
    :dic dup ' tenant swap word.kind! execute {{
      "catalogs" :dic drop
    }}
    "created tenant" 1 2
;

/*----------------------------------------------------------------------------*/
/* create a catalog                                                           */
/*----------------------------------------------------------------------------*/
: create_catalog
    :dic dup ' catalog swap word.kind! execute {{
      "schemas" :dic drop
    }}
    "created catalog" 1 2
;

/*----------------------------------------------------------------------------*/
/* create a schema                                                            */
/*----------------------------------------------------------------------------*/
: create_schema
    :dic dup ' schema swap word.kind! execute {{
      "tables" :dic drop
    }}
    "created schema" 1 2
;

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table
    :table drop
    "created table" 1 2
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "filename" "tablename" )
    find execute ( "filename" table )
    swap
    "load.sen" >>:
    "loaded table" 1 2
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "filename" "tablename" )
    find execute ( "filename" table )
    swap
    "export.sen" >>:
    "exported table" 1 2
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "tablename" )
    find execute ( table )
    table.space
    >str 1 2
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "tablename" )
    find execute ( table )
    table.truncate
    "table truncated" 1 2
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tablename>" -- "dropped table" 1 2 )
    find
    dup word.kind@ ' table eql not if drop "not a table" 0 2 exit then
    dup execute table.truncate
    >forget
    "dropped table" 1 2
    traceoff
;

/*----------------------------------------------------------------------------*/
/* drop a schema                                                              */
/*----------------------------------------------------------------------------*/
: drop_schema ( "<schemaname> -- "dropped schema" 1 2 )
    find
    dup word.kind@ ' schema eql not if drop "not a schema" 0 2 exit then
    >forget
    "dropped schema" 1 2
;

/*----------------------------------------------------------------------------*/
/* drop a catalog                                                             */
/*----------------------------------------------------------------------------*/
: drop_catalog ( "<catalogname> -- "dropped catalog" 1 2 )
    find
    dup word.kind@ ' catalog eql not if drop "not a catalog" 0 2 exit then
    >forget
    "dropped catalog" 1 2
;

/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
: drop_tenant ( "<tenantname> -- "dropped tenant" 1 2 )
    find
    dup word.kind@ ' tenant eql not if drop "not a tenant" 0 2 exit then
    >forget
    "dropped tenant" 1 2
;

/*----------------------------------------------------------------------------*/
/* change dictionary                                                          */
/*----------------------------------------------------------------------------*/
: cd
    dup ".." streql if
      dic.drop
    else
      find execute dic.push
    then
    "changed" 1 2
;

/*----------------------------------------------------------------------------*/
/* print working dictionary                                                   */
/*----------------------------------------------------------------------------*/
: pwd
    ""
    dic.count 0 do I . I dic.pick dic.name concat " " concat loop
    1 2
;

/*----------------------------------------------------------------------------*/
/* list dictionary contents                                                   */
/*----------------------------------------------------------------------------*/
: ls
    word.this
    begin dup
      while
        dup word.kind@ word.name ' word word.name streql not if
          dup nameWord .put " is a " .put dup word.kind@ nameword .put .\n
        then
        prevWord
      repeat
    drop
    "done" 1 2
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping
    "pong" 1 2
;

/*----------------------------------------------------------------------------*/
/* x test                                                                     */
/*----------------------------------------------------------------------------*/
: x
    words
    "x" 1 2
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/