docol epochTake;

print "";
print "=====================================================================";
print "starting the cluster...";
print "=====================================================================";
_startCluster
waitCluster;

print "";
print "=====================================================================";
print "sleeping for 5 secs...";
print "=====================================================================";
sleep 5;

print "";
print "=====================================================================";
print "creating table lineitem";
print "=====================================================================";
create table lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B
  L_RETURNFLAG    CHAR(1) NOT NULL,         //  8)  2B
  L_LINESTATUS    CHAR(1) NOT NULL,         //  9)  2B
  L_SHIPDATE      TIMESTAMP NOT NULL,       // 10)  8B
  L_COMMITDATE    TIMESTAMP NOT NULL,       // 11)  8B
  L_RECEIPTDATE   TIMESTAMP NOT NULL,       // 12)  8B
  L_SHIPINSTRUCT  CHAR(25) NOT NULL,        // 13) 26B
  L_SHIPMODE      CHAR(10) NOT NULL,        // 14) 11B
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B
);

print "";
print "=====================================================================";
print "loading table lineitem";
print "=====================================================================";
ld lineitem "/tpch/lineitem.tbl" ;

docol epochDump;

