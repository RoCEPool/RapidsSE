/*============================================================================*/
/* monitorTask.sen -- monitor task                                            */
/*============================================================================*/

"monitorTask.sen" .

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

lock:    monitorLock

str:     monitorString

taskset: monitorTaskSet

thread:  monitorThread

/*----------------------------------------------------------------------------*/
/* start the monitor task                                                     */
/*----------------------------------------------------------------------------*/

: monitorStart

     "monitorLoop"  task.new

     monitorTaskSet taskSet.Append

     monitorTaskSet monitorThread  thread.taskset!

     monitorThread  thread.spawn
;

/*----------------------------------------------------------------------------*/
/* monitor task loop                                                          */
/*----------------------------------------------------------------------------*/

: monitorLoop

    "monitorTask" task.this task.name!

    "" monitorString !s

    "Monitor Task running..." .

    begin

      monitorLock lock.grabWrite

        "freespace " freespace >str concat

        monitorString !s

      monitorLock lock.dropWrite

      monitorString @s .

      1 sleep

    0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/