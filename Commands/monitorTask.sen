/*============================================================================*/
/* monitorTask.sen -- monitor task                                            */
/*============================================================================*/

"monitorTask.sen" .

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

lock: monitorLock

str:  monitorString

/*----------------------------------------------------------------------------*/
/* create a file using name from input stream (doesnt leave file on stk)      */
/*----------------------------------------------------------------------------*/
: monitorLoop

    "monitorTask" task.this task.name!

    "" monitorString !s

    "Monitor Task running..." .

    begin

      monitorLock lock.grabWrite

        freespace >str

        monitorString !s

      monitorLock lock.dropWrite

      monitorString @s .

      1 sleep

    0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/