/*============================================================================*/
/* SenderTask.sen -- sender task                                              */
/*============================================================================*/

"SenderTask.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* send valset across the socket                                              */
/*----------------------------------------------------------------------------*/
: >send

tp: sendingValset

  task.this task.socket@  ( valset socket )
  socket.send             ( bool )
  not if
    "send failure" . ( 0/1 )
  then

  //"Node " args.node >str concat " sent word to another node " concat .
;

/*----------------------------------------------------------------------------*/
/* sender task processing                                                     */
/*----------------------------------------------------------------------------*/
: snd.loop ( socket -- )

tp: snd.loop

  task.this task.socket!

  "snd.loop" task.this task.comment!

  senderTaskPrint if "Sender running on node" args.node >str concat . then

  begin
    depth 0 != if "sender task has grown" . debug.trap then

    // pop valset off this tasks queue and push onto this stack
    taskQueue>

tp: poppedValset

    // send the valset across the connection
    >send

  0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
