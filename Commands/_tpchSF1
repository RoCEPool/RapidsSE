/*============================================================================*/
/* _TPCH/SF1-- tpc-h creation, load, fetch and drop for scale factor 1         */
/*============================================================================*/

startCluster;

print "-----------------------------------------------------------------------";
time create table customer (
	C_CUSTKEY       INTEGER NOT NULL,
	C_NAME          VARCHAR(25) NOT NULL,
	C_ADDRESS       VARCHAR(40) NOT NULL,
	C_NATIONKEY     INTEGER NOT NULL,
	C_PHONE         CHAR(15) NOT NULL,
	C_ACCTBAL       DECIMAL(15,2) NOT NULL,
	C_MKTSEGMENT    CHAR(10) NOT NULL,
	C_COMMENT       VARCHAR(117) NOT NULL
);

time create table lineitem (
  L_ORDERKEY      INTEGER NOT NULL,
  L_PARTKEY       INTEGER NOT NULL,
  L_SUPPKEY       INTEGER NOT NULL,
  L_LINENUMBER    INTEGER NOT NULL,
  L_QUANTITY      DECIMAL(15,2) NOT NULL,
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,
  L_TAX           DECIMAL(15,2) NOT NULL,
  L_RETURNFLAG    CHAR(1) NOT NULL,
  L_LINESTATUS    CHAR(1) NOT NULL,
  L_SHIPDATE      DATE NOT NULL,
  L_COMMITDATE    DATE NOT NULL,
  L_RECEIPTDATE   DATE NOT NULL,
  L_SHIPINSTRUCT  CHAR(25) NOT NULL,
  L_SHIPMODE      CHAR(10) NOT NULL,
  L_COMMENT       VARCHAR(44) NOT NULL
);

time create table nation (
  N_NATIONKEY     INTEGER NOT NULL,
  N_NAME          CHAR(25) NOT NULL,
  N_REGIONKEY     INTEGER NOT NULL,
  N_COMMENT       VARCHAR(152)
);

time create table orders (
  O_ORDERKEY      INTEGER NOT NULL,
  O_CUSTKEY       INTEGER NOT NULL,
  O_ORDERSTATUS   CHAR(1) NOT NULL,
  O_TOTALPRICE    DECIMAL(15,2) NOT NULL,
  O_ORDERDATE     DATE NOT NULL,
  O_ORDERPRIORITY CHAR(15) NOT NULL,
  O_CLERK         CHAR(15) NOT NULL,
  O_SHIPPRIORITY  INTEGER NOT NULL,
  O_COMMENT       VARCHAR(79) NOT NULL
);

time create table part (
  P_PARTKEY       INTEGER NOT NULL,
  P_NAME          VARCHAR(55) NOT NULL,
  P_MFGR          CHAR(25) NOT NULL,
  P_BRAND         CHAR(10) NOT NULL,
  P_TYPE          VARCHAR(25) NOT NULL,
  P_SIZE          INTEGER NOT NULL,
  P_CONTAINER     CHAR(10) NOT NULL,
  P_RETAILPRICE   DECIMAL(15,2) NOT NULL,
  P_COMMENT       VARCHAR(23) NOT NULL
);

time create table partsupp (
	PS_PARTKEY      INTEGER NOT NULL,
	PS_SUPPKEY      INTEGER NOT NULL,
	PS_AVAILQTY     INTEGER NOT NULL,
	PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
	PS_COMMENT      VARCHAR(199) NOT NULL
);

time create table region (
  R_REGIONKEY     INTEGER NOT NULL,
  R_NAME          CHAR(25) NOT NULL,
  R_COMMENT       VARCHAR(152)
);

time create table supplier (
  S_SUPPKEY       INTEGER NOT NULL,
  S_NAME          CHAR(25) NOT NULL,
  S_ADDRESS       VARCHAR(40) NOT NULL,
  S_NATIONKEY     INTEGER NOT NULL,
  S_PHONE         CHAR(15) NOT NULL,
  S_ACCTBAL       DECIMAL(15,2) NOT NULL,
  S_COMMENT       VARCHAR(101) NOT NULL
);
print "-----------------------------------------------------------------------";

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "-----------------------------------------------------------------------";
print "loading partsupp.csv..." ;

print "loading customer.csv..." ;

//time ld partsupp "/TPCH/SF1/temp.tbl" field_delimiter "|";

time ld partsupp "/TPCH/SF1/partsupp.tbl" field_delimiter "|";

time ld customer "/TPCH/SF1/customer.tbl" field_delimiter "|";
print "loading lineitem.csv..." ;
time ld lineitem "/TPCH/SF1/lineitem.csv" ;
print "loading nation.csv..." ;
time ld nation "/TPCH/SF1/nation.tbl" field_delimiter "|";
print "loading orders.csv..." ;
time ld orders "/TPCH/SF1/orders.tbl" field_delimiter "|";
print "loading part.csv..." ;
time ld part "/TPCH/SF1/part.tbl" field_delimiter "|";
print "loading region.csv..." ;
time ld region "/TPCH/SF1/region.tbl" field_delimiter "|";
print "loading supplier.csv..." ;
time ld supplier "/TPCH/SF1/supplier.tbl" field_delimiter "|";
print "-----------------------------------------------------------------------";
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "-----------------------------------------------------------------------";
TableSizes;
print "-----------------------------------------------------------------------";

print "-----------------------------------------------------------------------";
print "size customer..." ;
szTbl customer;

print "size lineitem..." ;
szTbl lineitem;

print "size nation..." ;
szTbl nation;

print "size orders..." ;
szTbl orders;

print "size part..." ;
szTbl part;

print "size partsupp..." ;
szTbl partsupp;

print "size region..." ;
szTbl region;

print "size supplier..." ;
szTbl supplier;
print "-----------------------------------------------------------------------";

print "-----------------------------------------------------------------------";
print "fetching customer.csv..." ;
time fetch customer displayOff ;
print "fetching lineitem.csv..." ;
time fetch lineitem displayOff ;
print "fetching nation.csv..." ;
time fetch nation displayOff ;
print "fetching orders.csv..." ;
time fetch orders displayOff ;
print "fetching part.csv..." ;
time fetch part displayOff ;
print "fetching partsupp.csv..." ;
time fetch partsupp displayOff ;
print "fetching region.csv..." ;
time fetch region displayOff ;
print "fetching supplier.csv..." ;
time fetch supplier displayOff ;
print "-----------------------------------------------------------------------";


print "-----------------------------------------------------------------------";
print "fetching customer.csv (noPrint)..." ;
time fetch customer noPrint;
print "fetching lineitem.csv (noPrint)..." ;
time fetch lineitem noPrint;
print "fetching nation.csv (noPrint)..." ;
time fetch nation noPrint;
print "fetching orders.csv (noPrint)..." ;
time fetch orders noPrint;
print "fetching part.csv (noPrint)..." ;
time fetch part noPrint;
print "fetching partsupp.csv (noPrint)..." ;
time fetch partsupp noPrint;
print "fetching region.csv (noPrint)..." ;
time fetch region noPrint;
print "fetching supplier.csv (noPrint)..." ;
time fetch supplier noPrint;
print "-----------------------------------------------------------------------";

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "-----------------------------------------------------------------------";
print "dropping customer.csv..." ;
time drop table customer ;
print "dropping lineitem.csv..." ;
time drop table lineitem ;
print "dropping nation.csv..." ;
time drop table nation ;
print "dropping orders.csv..." ;
time drop table orders ;
print "dropping part.csv..." ;
time drop table part ;
print "dropping partsupp.csv..." ;
time drop table partsupp ;
print "dropping region.csv..." ;
time drop table region ;
print "dropping supplier.csv..." ;
time drop table supplier ;
print "-----------------------------------------------------------------------";


