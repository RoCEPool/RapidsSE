demo select
  O_ORDERPRIORITY,
  count(*) as ORDER_COUNT
from
  ORDERS
where
  O_ORDERDATE >= "1993-07-01"
  and O_ORDERDATE < "1993-10-01" and exists
  (
   select
    *
   from
    LINEITEM
   where
    L_ORDERKEY = O_ORDERKEY
   and L_COMMITDATE < L_RECEIPTDATE
   )
group by O_ORDERPRIORITY 
order by O_ORDERPRIORITY;


