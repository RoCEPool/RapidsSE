/*============================================================================*/
/* participantProxy.sen -- participant proxy                                  */
/*============================================================================*/

"participantProxy.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* participant proxy processing loop                                          */
/*----------------------------------------------------------------------------*/
: pp.loop ( actorNo forwardTask -- )

  "pp.loop" task.this task.comment!

tp: participantProxy

  // push a register frame
  reg.push

  >r ( actorNo )
  >r ( )
  // r0 has actorNo (nodeNo)
  // r1 has forwardTask

  task.this r0 ppTasks !

  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    // pop valset off queue and push onto this stack
    queue> ( valset )

    // set caller into reg0
    exeOne assert

    // set this task to wait for 1 ack
    1 task.this task.acks! ( ... wordName #values queue )

    r0 args.node ==
    if
      // this is pp0 on node 0

      addCaller

      // append indirect call onto queue of p.task
      r1 ( valset task )

      >taskQueue;a>

    else
      // this is pp1 on node 0

      addSender
      r0 addPassOnToCp

      // send to node 1 by appending to snd1.queue
      r0 >node

      // this task suspends till notified
      task.suspend

      // move valset to parameter stack
      a> ( valset )

    then


tp: resumed

    >caller ( )

  0 until

  rdrop
  rdrop

  // pop a register frame
  reg.pop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
