/*============================================================================*/
/* dicInitialise.sen -- initialise the dictionary                             */
/*============================================================================*/

"dicInitialise.sen" .

/*----------------------------------------------------------------------------*/
/* step 1: compile the inital set of high-level words                         */
/*----------------------------------------------------------------------------*/

"core.sen" >>:
"dic.sen" >>:
"file.sen" >>:
"var.sen" >>:
"trace.sen" >>:
"useful.sen" >>:

// compile the runtime words
"runtime.sen" >>:

/*----------------------------------------------------------------------------*/
/* step 2: compile testing                                                    */
/*----------------------------------------------------------------------------*/

"testing.sen" >>:

/*----------------------------------------------------------------------------*/
/* step 3: compile "the system"                                               */
/*----------------------------------------------------------------------------*/

"theSystem.sen" >>:

/*----------------------------------------------------------------------------*/
/* step 4: create the main objects for the system                             */
/*----------------------------------------------------------------------------*/

( tasklist will already exist )

( create the threadList to hold all thread's )
threadlist: threadList

( create the txList to hold all tx's )
txlist: txList

( create the sessionList to hold all session's )
sessionlist: sessionList

( create the task set for the root thread )
taskset: rootTaskSet

( create the root thread and name it )
thread: rootThread "rootThread" rootThread thread.name!

( give root task set to the root thread )
rootTaskSet rootThread thread.taskSet!

( spawn the posix thread for the root thread )
rootThread thread.spawn

( leave root thread on stack )
rootThread

"dicInitialised.sen" >>:

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/