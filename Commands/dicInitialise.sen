/*============================================================================*/
/* dicInitialise.sen -- initialise the dictionary                             */
/*============================================================================*/

"dicInitialise.sen" .

// not the right place
: success 0 2 ;
: failure 2 ;
: checkIsKnown ( word )
    dup not if drop "no such word" 1 failure 0 exit then
    1
;


/*----------------------------------------------------------------------------*/
/* step 1: compile the inital set of high-level words                         */
/*----------------------------------------------------------------------------*/

"core.sen" >>:
"dic.sen" >>:
"file.sen" >>:
"lock.sen" >>:
"timer.sen" >>:
"var.sen" >>:
"trace.sen" >>:
"useful.sen" >>:

// compile the runtime words
"runtime.sen" >>:
"metadata.sen" >>:

/*----------------------------------------------------------------------------*/
/* step 2: compile testing                                                    */
/*----------------------------------------------------------------------------*/

"testing.sen" >>:

/*----------------------------------------------------------------------------*/
/* step 3: create the main objects for the system                             */
/*----------------------------------------------------------------------------*/

( tasklist will already exist )

( create the threadList to hold all thread's )
threadList: threadList

( create the txMap to map tx's )
txMap: txMap

( create the txCollection to hold all tx's )
txCollection: txCollection

( create the seitfList to hold all seitf's )
seitfList: seitfList

( create the task set for the root thread )
taskSet: rootTaskSet

( create the root thread and name it )
thread: rootThread "rootThread" rootThread thread.name!

( give root task set to the root thread )
rootTaskSet rootThread thread.taskSet!

/*----------------------------------------------------------------------------*/
/* step 4: compile "the system"                                               */
/*----------------------------------------------------------------------------*/

"theSystem.sen" >>:

/*----------------------------------------------------------------------------*/
/* step 4: spawn the root thread                                              */
/*----------------------------------------------------------------------------*/

( spawn the posix thread for the root thread )
rootThread thread.spawn

( leave root thread on stack )
rootThread

"dicInitialised.sen" >>:

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/