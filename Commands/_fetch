/*----------------------------------------------------------------------------*/
/* fetch.test -- FETCH tests                                                  */
/*----------------------------------------------------------------------------*/

// strat cluster
startCluster;

// begin tracking memory
trackMemory;

// (1) create a table
create table T1 (
  jidx_key   INTEGER     NOT NULL,
  jidx_name  VARCHAR(32) NOT NULL,
  jidx_100   INTEGER     NOT NULL,
  jidx_10    INTEGER     NOT NULL,
  jidx_int   INTEGER     NOT NULL,
  jidx_flt   FLOAT       NOT NULL,
  jidx_tsp   TIMESTAMP   NOT NULL,
  jidx_dte   DATE        NOT NULL
);

// create indexes
create index T1_idx on T1 (jidx_key);

ld T1 "../DATA/Operators/operators1_1.csv" ;

// fetch rows on all partitions
pipeline _fetch
begin

    stage stageA on origin:
    startOp | periodicOp once | stageB

    stage stageB on all partitions:
    scanOp T1 | stageC

    stage stageC on origin:
    outputOp | sinkOp | stageA

end
;

// fetch rows on partition 0
fetch T1 0;

pipeline fetch
  begin

  stage stageA on origin:
    startOp | periodicOp once | stageB

  stage stageB on partition 0:
    scanOp T1 | stageC

  stage stageC on origin:
    outputOp | sinkOp | stageA

  end
;

 // fetch rows on partition 1
 fetch T1 1;

 pipeline fetch
 begin
 
 stage stageA on origin:
 startOp | periodicOp once | stageB
 
 stage stageB on partition 1:
 scanOp T1 | stageC
 
 stage stageC on origin:
 outputOp | sinkOp | stageA
 
 end
 ;

// fetch rows on partition 2
fetch T1 2;

pipeline fetch
begin

stage stageA on origin:
startOp | periodicOp once | stageB

stage stageB on partition 2:
scanOp T1 | stageC

stage stageC on origin:
outputOp | sinkOp | stageA

end
;

// fetch rows on partition 3
fetch T1 3;

pipeline fetch
begin

stage stageA on origin:
startOp | periodicOp once | stageB

stage stageB on partition 3:
scanOp T1 | stageC

stage stageC on origin:
outputOp | sinkOp | stageA

end
;

