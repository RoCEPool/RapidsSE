create table k100 (
  k100_key        INTEGER NOT NULL,  // 1) 0..99
  j100_1value     INTEGER NOT NULL,  // 2) 0 only
  j100_2values    INTEGER NOT NULL,  // 3) 0,1
  j100_4values    INTEGER NOT NULL,  // 4) 0..3
  j100_5values    INTEGER NOT NULL,  // 5) 0..4
  j100_10values   INTEGER NOT NULL,  // 6) 0..9
  j100_20values   INTEGER NOT NULL,  // 7) 0..19
  j100_50values   INTEGER NOT NULL,  // 8) 0..49
  j100_100values  INTEGER NOT NULL   // 9) 0..99
);

create index idx1 on k100 (k100_key);
create index idx2 on k100 (j100_1value);
create index idx3 on k100 (j100_2values);
create index idx4 on k100 (j100_4values);
create index idx5 on k100 (j100_5values);
create index idx6 on k100 (j100_10values);
create index idx7 on k100 (j100_20values);
create index idx8 on k100 (j100_50values);
create index idx9 on k100 (j100_100values);

print "loading k100.tbl..." ;
ld k100 "../JTEST/k100.csv" ;

fetch k100 ;

