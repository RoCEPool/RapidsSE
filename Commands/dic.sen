/*============================================================================*/
/* dic.sen -- dictionary related words                                        */
/*============================================================================*/

"dic.sen" .

/*----------------------------------------------------------------------------*/
/* dic is use as a kind of word to identify dictionaries                      */
/*----------------------------------------------------------------------------*/
: dic ;

: isDic word.kind@ ' dic eql ;

/*----------------------------------------------------------------------------*/
/* create a dictionary using name from input stream (doesnt leave dic on stk) */
/*----------------------------------------------------------------------------*/
: dic:
    create
    object!!
    sizeof_dictionary allot
    word.this >body magic!!
    word.this >body CN_DICTIONARY class!
    ' dic word.this word.kind!
    word.this >body dic.init
    does>
;

/*----------------------------------------------------------------------------*/
/* create a dictionary using name on the stack (leaves dic on stack)          */
/*----------------------------------------------------------------------------*/
: :dic
    >create
    object!!
    sizeof_dictionary allot
    word.this >body magic!!
    word.this >body CN_DICTIONARY class!
    ' dic word.this word.kind!
    word.this >body dic.init
    word.this
    does>
;


: checkIsDic ( word )

    dup not if drop "no such dictionary" 1 failure 0 exit then
    dup word.kind@ ' dic eql if 1 exit then
    drop
    "not a dictionary" 1 failure 0
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/