dynamic pipeline ray1_dyn
begin

  stage stageA on all partitions:
    scan lineitem | output

end ;

dynamic pipeline ray2_dyn
begin

  stage stageA on all partitions:
    scan lineitem | insert lineitem | output

end ;

dynamic pipeline ray3_dyn
begin

  stage stageA on all partitions:
    scan lineitem | output

end ;

