/*============================================================================*/
/* joinTestData.sen -- generate join test data                                */
/*============================================================================*/

"joinTestData.sen" .

: >DigitWords

  >str ""            ( "TBD"  "<dw>"        )

  0 >r
  begin              ( "TBD"  "<dw>"        )
    swap             ( "<dw>" "TBD"         )
    dup              ( "<dw>" "TBD" "TBD"   )
    strlen           ( "<dw>" "TBD" l       )
    while            ( "<dw>" "TBD"         )
      dup            ( "<dw>" "TBD"  "TBD"  )
      1 0 substr     ( "<dw>" "TBD"  "<d>"  )
      swap           ( "<dw>" "<d>"  "TBD"  )
      1 neg 1 substr ( "<dw>" "<d>"  "BD"   )
      rot            ( "BD"   "<dw>" "<d>"  )
      >int           ( "BD"   "<dw>" d      )
      >digitName     ( "BD"   "<dw>" "name" )

      r> dup inc >r
      if swap " " concat swap then

      concat         ( "BD"   "<dw>"        )
  repeat
  drop               ( "<dw>"               )
  rdrop
;

: joinTestData

//traceon

    1000 0
    do
      I .put

      "|" .put

      I >DigitWords .put

      "|" .put

      I 100 % >DigitWords
      .put

      "|" .put

      I 10 % >DigitWords
      .put

      .\n

    loop

  100 0
  do
    I .put

    "|" .put

    I >DigitWords .put

    "|" .put

    I 10 % >DigitWords
    .put

    .\n

  loop

  10 0
  do
    I .put

    "|" .put

    I >DigitWords .put

    .\n

  loop

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/