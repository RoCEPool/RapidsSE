/*============================================================================*/
/* file.sen -- file related words                                             */
/*============================================================================*/

"file.sen" .

: file:
  create
  object!!
  sizeof_file allot
  word.this >body magic!!
  word.this >body CN_FILE class!
  word.this >body file.init
  does> "file on stk" .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/