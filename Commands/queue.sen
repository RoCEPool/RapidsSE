/*============================================================================*/
/* queue.sen -- a generic queue                                               */
/*============================================================================*/

"queue.sen" .putVerbose

: queue ;

: queue:
    create 
    object!!
    sizeof_queue allot
    word.this >body magic!!
    word.this >body CN_QUEUE class!
   ' queue word.this word.kind!
    word.this >body queue.init
    word.this >body object.wordbody
    does> 
;

: :queue
    >create
    object!!
    sizeof_queue allot
    word.this >body magic!!
    word.this >body CN_QUEUE class!
    ' queue word.this word.kind!
    word.this >body queue.init
    word.this >body object.wordbody
    word.this
    does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
