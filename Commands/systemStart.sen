/*============================================================================*/
/* systemStart.sen -- system start                                            */
/*============================================================================*/

"systemStart.sen" .

: systemStart
  "systemCommands.sen" >>:
  "requestServer.sen"  >>:
  snooze
  "Welcome to RapidsSE" .
  "requestServerStart" find execute
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/