/*============================================================================*/
/* systemStart.sen -- system start                                            */
/*============================================================================*/

"systemStart.sen" .

/*----------------------------------------------------------------------------*/
/* called by RapidsSE::vSystemStart                                           */
/*----------------------------------------------------------------------------*/
: systemStart

  "systemStart" .

  bgtasks if

    snooze listerStart
    snooze monitorStart
    snooze reclaimStart

  then

  "requestServerLoop" find execute

  dic.main true dic.frozen!
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/