/*============================================================================*/
/* _allCols_Table -- create all columns table                                 */
/*============================================================================*/

create table ALLCOLS_TABLE
(
  bcd  DECIMAL   NOT NULL min 0              max 250,
  bol  BOOLEAN   NOT NULL min false          max true,
  dte  DATE      NOT NULL min "2019-01-01"   max "2019-12-31",
  flt  FLOAT     NOT NULL min "1.0"          max "1000.0",
  int  INTEGER   NOT NULL min 1              max 1000,
  ivl  INTERVAL  NOT NULL min "0.0"          max "100.0",
  tme  TIME      NOT NULL min "00:00:00.000" max "23:59:59.999",
//  colH tsp NOT NULL min "2019-01-01 00:00:00.000"
//                          max "2019-12-31 23:59:59.999",
  vch  VARCHAR   NOT NULL min "a"            max "zzzzzzzzz"
)
  rowsize 256
;

/*============================================================================*/
/* end                                                                        */
