/*============================================================================*/
/* AnswerTask.sen -- answer task                                              */
/*============================================================================*/

"AnswerTask.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

queue:   answerQueue

taskset: answerTaskSet

thread:  answerThread

int: connections

/*----------------------------------------------------------------------------*/
/* start the answer task                                                      */
/*----------------------------------------------------------------------------*/
: answerStart

    // set up answer task
    0 "answerLoop" nullPtr task.new answerTaskSet taskSet.append

    // set up the answer thread
    answerTaskSet  answerThread thread.taskset!
    "answerThread" answerThread thread.name!
                   answerThread thread.spawn
;

/*----------------------------------------------------------------------------*/
/* answer loop                                                                */
/*----------------------------------------------------------------------------*/
: answerLoop

    "renaming to Answer Task" .putVerbose

    "answerTask" task.this task.name!

    answerQueue  task.this task.queue!

    answerTaskPrint if "Answer running..." . then

    "waiting for connections on port "  5000 args.node + >str concat .

    5000 args.node + >str "Listening on port " swap concat .
    5000 args.node + socket.listen
    >r

    0 connections !
    begin

      r0 socket.accept
      //"accepted connection on port "  5000 args.node + >str concat .

      // start receiver
      //"starting receiver" .
      connections @          ( connection# )
      >str "receiver" swap concat ( connection# receiverName )
      0 swap "receiver.loop" swap receiverForm

      connections @          ( connection# )
      1 +                    ( connections# 1 )
      dup                    ( connections# connections# )
      connections !          ( connections# )

      1  == if               ( connection# )
        args.node 0 != if
          cs
        then
      then
        
    0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
