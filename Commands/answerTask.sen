/*============================================================================*/
/* AnswerTask.sen -- answer task                                              */
/*============================================================================*/

"AnswerTask.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* define the ans actor (ans.task, ans.queue, ans.taskset, ans.thread)        */
/*----------------------------------------------------------------------------*/
actor: ans

/*----------------------------------------------------------------------------*/
/* declare connections variable to keep the number of connections             */
/*----------------------------------------------------------------------------*/
int: connections

/*----------------------------------------------------------------------------*/
/* start the answer task                                                      */
/*----------------------------------------------------------------------------*/
: answerStart

  0 "ans.loop"

  "ans" actor.spawn
;

/*----------------------------------------------------------------------------*/
/* answer loop                                                                */
/*----------------------------------------------------------------------------*/
: ans.loop

  answerTaskPrint if "Answer running..." . then

  args.verbose if
    "waiting for connections on port "  args.port args.node + >str concat .
    args.port args.node + >str "Listening on port " swap concat .
  then

  args.port args.node + socket.listen
  >r

  0 connections !
  begin

tp: waitingOnAccept
"con.task" find execute tp: con.task drop
    r0 socket.accept
"con.task" find execute tp: con.task drop
tp: socketAccepted

    args.verbose if
      "accepted connection on port "  args.port args.node + >str concat .
    then

  // start receiver
  //"starting receiver" .

ddlLock.grabWrite

    // set up the seed
    1 "rcv.loop" ( socket 1 "rcv.loop" )

    // create the actor
    "rr" connections @ >str concat ( socket 1 "rcv.loop" "rrI" )
    :actor ( socket 1 "rcv.loop" "rrI" )

    // spawn the actors os thread
    actor.spawn

ddlLock.dropWrite

    connections @          ( connection# )
    1 +                    ( connections# 1 )
    dup                    ( connections# connections# )
    connections !          ( connections# )

    1  == if               ( connection# )
      args.node 0 != if
        connectorStart
      then
    then
      
  0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
