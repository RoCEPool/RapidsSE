/*============================================================================*/
/* AnswerTask.sen -- answer task                                              */
/*============================================================================*/

"AnswerTask.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

task:    ans.task
queue:   ans.queue
taskset: ans.taskset
thread:  ans.thread

int: connections

/*----------------------------------------------------------------------------*/
/* start the answer task                                                      */
/*----------------------------------------------------------------------------*/
: answerStart

  // set up answer task
  0 "ans.loop" nullPtr task.new ans.taskset taskSet.append

  // set up the answer thread
  ans.taskset    ans.thread thread.taskset!
  "answerThread" ans.thread thread.name!
                 ans.thread thread.spawn
;

/*----------------------------------------------------------------------------*/
/* answer loop                                                                */
/*----------------------------------------------------------------------------*/
: ans.loop

  "renaming to Answer Task" .putVerbose

  "answerTask" task.this task.name!

  ans.queue  task.this task.queue!

  answerTaskPrint if "Answer running..." . then

  args.verbose if
    "waiting for connections on port "  args.port args.node + >str concat .
    args.port args.node + >str "Listening on port " swap concat .
  then

  args.port args.node + socket.listen
  >r

  0 connections !
  begin


    r0 socket.accept

    args.verbose if
      "accepted connection on port "  args.port args.node + >str concat .
    then

ddlLock.grabWrite

    // start receiver
    //"starting receiver" .
    connections @          ( connection# )
    >str "rr" swap concat ( connection# receiverName )

    1 swap "rcv.loop" swap actorForm

ddlLock.dropWrite

    connections @          ( connection# )
    1 +                    ( connections# 1 )
    dup                    ( connections# connections# )
    connections !          ( connections# )

    1  == if               ( connection# )
      args.node 0 != if
        connectorStart
      then
    then
      
  0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
