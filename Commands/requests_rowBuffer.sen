/*============================================================================*/
/* requests_rowBuffer.sen -- the set of row buffer related requests           */
/*============================================================================*/

"requests_rowBuffer.sen" .verbose

/*----------------------------------------------------------------------------*/
/* print contents of a row buffer on each node                                */
/*----------------------------------------------------------------------------*/
: ~printRB ( )

tp: printRBOnAll

  // set indirect call to be printRB
  $$ swap "printRB"

tp: theIndirectCall

  $$>valset ( valset )

  >>allParticipants> ( bool )

tp: printRBOnAllDone

  checkResult
;

int: countRows

/*----------------------------------------------------------------------------*/
/* print contents of a string sent via a row buffer on each node              */
/*----------------------------------------------------------------------------*/
: pRB ( "filename" )

tp: pRB

  reg.push

  rowBuffer.new >reg0    // reg0 - rowbuffer
  beginTransaction >reg1 // reg1 - txref

/*
  0 countRows !
  begin
  while
    countRows @ >str
    "Hello there " swap str.cat reg1 reg0 rowbuffer.append
    countRows @
    1 +
    countRows !
  repeat
*/

  10 countRows !
  countRows @ 0 do
    "Hello there " I >str str.cat reg1 reg0 rowbuffer.append
  loop

  // commit the transaction
  commitTransaction

  drop

  //reg0 rowbuffer.dump

  reg0

tp: marker

$$>valset

tp: valset

  ~printRB  ( rowbuffer )

  reg.pop

  <OK>
;

/*----------------------------------------------------------------------------*/
/* print contents of a string sent via a row buffer on each node              */
/*----------------------------------------------------------------------------*/
: printRB$ ( rowbuffer )

tp: printRB$

  "PRINTING ROWBUFFER on NODE " args.node >str str.cat .

  rowbuffer.dump

  true ( true )
;

/*----------------------------------------------------------------------------*/
/* print contents of a string sent via a row buffer on each node              */
/*----------------------------------------------------------------------------*/
: printRB (  rowBuffer ... #folders -- true )

  valset>

  drop

  //dup "dicStack.set" str.equal
  //if
//tp: settingDicStack
  //  !indirect drop
  //  then

  printRB$
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
