logSection pipelineFetch;
print section "Pipeline Fetch";

pipeline lineitem_fetch
begin

  stage stageA on origin:
    start | periodicOp once | stageB

  stage stageB on all partitions:
    scan lineitem | stats | toStatDemon | stageC

  stage stageC on origin:
    output | sink | stageA

end;


