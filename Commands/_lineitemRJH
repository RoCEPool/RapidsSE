//CREATE INDEX lineitem_idx3 ON lineitem(L_SUPPKEY);

//nowait monitor 3;

space;
time ld lineitem "/tpch/SF0/lineitem10k.csv" max_errors 100;
//time ld lineitem "/tpch/SF0/lineitem100k.csv" max_errors 100;
//time ld lineitem "/tpch/SF1/lineitem.csv" max_errors 100;
space;
sztbl lineitem;

