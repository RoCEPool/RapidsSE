/*============================================================================*/
/* _lineitemRJH - create and load TPC-H Lineitem table                        */
/*============================================================================*/

startCluster;

time create table lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B   3B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B   3B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B   3B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B   3B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B   3B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B   3B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B   3B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B   3B
  L_RETURNFLAG    CHAR(1) NOT NULL,         //  8)  2B   2B
  L_LINESTATUS    CHAR(1) NOT NULL,         //  9)  2B   2B
  L_SHIPDATE      DATE NOT NULL,            // 10)  8B   8B   TIMESTAMP
  L_COMMITDATE    DATE NOT NULL,            // 11)  8B   8B   TIMESTAMP
  L_RECEIPTDATE   DATE NOT NULL,            // 12)  8B   8B   TIMESTAMP
  L_SHIPINSTRUCT  CHAR(25) NOT NULL,        // 13) 26B  13B   CHAR(25),2
  L_SHIPMODE      CHAR(10) NOT NULL,        // 14) 11B   5B   CHAR(10),5
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B  23B   VARCHAR(44)
  //                                              ---- ----
  // 16 columns                                   174B  91B
  //
);

// sample data:
// 1,155190,7706,1,17,21168.23,0.04,0.02,N,O,1996-03-13,1996-02-12,1996-03-22,DELIVER IN PERSON,TRUCK,egular courts above the,


