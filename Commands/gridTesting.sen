/*============================================================================*/
/* gridTesting.sen -- grid testing                                            */
/*============================================================================*/

"gridTesting.sen" .putVerbose

: SE_PATH "../OS\ X/Build/Products/Debug/SE" ;

: se_command

    dup

//  "nohup "
    ""
    SE_PATH concat
    " --start " concat
    " --size " concat regionSize >str concat
    " --commands /Users/ray/Desktop/rapidsse/Commands" concat
    " --region /SE_" concat  swap >str concat
    " --node  " concat swap >str concat
    " --nodes " concat args.nodes >str concat
    " --port  " concat args.port  >str concat
    " --sleep " concat args.sleep >str concat

    " &" concat
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: g

  1 se_command dup . shell.execute .
  2 se_command dup . shell.execute .
  3 se_command dup . shell.execute .
  4 se_command dup . shell.execute .
  5 se_command dup . shell.execute .
  6 se_command dup . shell.execute .
  7 se_command dup . shell.execute .
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: gn

  args.nodes 1 do
    I se_command
    dup .
    shell.execute .
  loop
  
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipcChild

  3 sleep

//traceon

  "ipcChild" task.this task.name!

  "ipcChild" .

  task.parent@ task.signal
//traceoff
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
: ipc

//traceon

  3 task.this task.acks!

  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append
  0 "ipcChild" task.this task.new rootTaskSet taskSet.Append

  //TS_WAITING task.this task.state!

  task.suspend

  "Parent" .
//traceoff
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* lock array                                                                 */
/*----------------------------------------------------------------------------*/
args.nodes intArray: ddlInts

/*----------------------------------------------------------------------------*/
/* attempt to grab ddl lock n                                                 */
/*----------------------------------------------------------------------------*/
: grabDDL_n ( n -- true|false )

  // test state of ddlInt[n]

  dup ( n n )
  ddlInts @ ( n v )
  if ( n )

   // ddlInt is currently locked

   // drop the subscript
   drop ( )

   // return false
   false ( false )
   exit

  then

  // ddlInt is not  locked

  // put 1 into ddlInts[n]
  1 ( n 1 )
  swap ( 1 n )
  ddlInts ! ( )

  // return true
  true ( true )
;

/*----------------------------------------------------------------------------*/
/* drop ddl lock n                                                            */
/*----------------------------------------------------------------------------*/
: dropDDL_n ( n -- true )

  // put 0 into ddlInts[n]
  0 ( n 0 )
  swap ( 0 n )
  ddlInts ! ( )

  // return true
  true ( true )
;

////////////////////////////////////////////////////////////////////////////////


/*----------------------------------------------------------------------------*/
/* grab distributed ddl lock                                                  */
/*----------------------------------------------------------------------------*/
: grabDistDDL ( -- true )

  // dispatch grab of lock 0 to node 0

  begin
    0            // participant is to grab lock 0
    "grabDDL_n"  // the word to execute
    2            // there are 2 indirect values
    0            // will dispatch to node 0
    ( 0 "grabDDL_n" 2 0 )

    // send indirect call to node 0
    dispatch ( true | false )
  until

  // dispatch grab of lock I to all other nodes

  args.nodes 1 do
    I            // participant is to grab lock I
    "grabDDL_n"  // the word to execute
    2            // there are 2 indirect values
    I            // will dispatch to node I
    ( I "grabDDL_n" 2 I )

    // send indirect call to node I
    dispatch ( true|false )

    // just print the indirect result for the moment
    . ( )
  loop

  true ( true )
;

/*----------------------------------------------------------------------------*/
/* drop distributed ddl lock                                                  */
/*----------------------------------------------------------------------------*/
: dropDistDDL ( -- true )

  // dispatch drop to all other nodes

  args.nodes 1 do
    I            // participant is to drop lock 0
    "dropDDL_n"  // the word to execute
    2            // there are 2 args now on stack
    I            // dispatch to node I
    ( I "dropDDL_n" 2 I )

    // send indirect call to node I
    dispatch ( true|false )

    // just print the indirect result
    .
  loop

  // dispatch drop to node 0

  0              // participant is to drop lock 0
  "dropDDL_n"    // the word to execute
  2              // there are 2 args now on stack
  0              // dispatch to node 0
  ( 0 "dropDDL_n" 2 0 )

  // send indirect call to node 0
  dispatch

  // just print the indirect result for the moment
  .

  true ( true )
;

/*----------------------------------------------------------------------------*/
/* dump the ddlInts array                                                     */
/*----------------------------------------------------------------------------*/
: ddlDump

  "{ " .put
  args.nodes 0 do
    I ddlInts @ .put " " .put
  loop

  "}" .put .\n
;

/*----------------------------------------------------------------------------*/
/* distributed lock test                                                      */
/*----------------------------------------------------------------------------*/
: dl

  // put 0 into all ddlInts
  args.nodes 0 do
    0 I ddlInts !
  loop

  // coordinate grab of dist ddl lock
  "grabDistDDL" 1  ( "grabDistDdl" 1 )
  >coordinator>     ( true|false )
  .

  ddlDump

  // coordinate drop of dist ddl lock
  "dropDistDDL" 1 ( "dropDistDdl" 1 )
  >coordinator>      ( true|false )
  .

  ddlDump

stk
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
