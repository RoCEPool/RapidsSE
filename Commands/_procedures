/*----------------------------------------------------------------------------*/
/* drop table                                                                 */
/*----------------------------------------------------------------------------*/
procedure drop table
  parameters $tableNm
begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    truncateTable $tableNm | stageC

  stage stageC on all nodes :
    dropTable $tableNm | stageD

  stage stageD on origin :
     sink | stageA

end;

