/*----------------------------------------------------------------------------*/
/* export table into csv file                                                 */
/*----------------------------------------------------------------------------*/
procedure export
  parameters $Table $File
begin

  stage stageA on origin:
    startOp | periodicOp once | stageB

  stage stageB on all partitions:
    scan $Table | toCsv | stageC

  stage stageC on origin:
    toFileOp $File | stageD

  stage stageD on origin:
    sink | stageA

end
;

/*----------------------------------------------------------------------------*/
/* check sanity of the grid                                                   */
/*----------------------------------------------------------------------------*/
procedure gridSanity
begin

  stage stageA on origin:
    startOp | periodicOp once | stageB

  stage stageB on all nodes:
    nodeInfo | stageC

  stage stageC on origin:
    gridSanity | output | sink | stageA

end
;

/*----------------------------------------------------------------------------*/
/* load data into a table from a csv file                                     */
/*----------------------------------------------------------------------------*/
procedure load
  parameters $table $file
begin

  stage stageA on origin:
    startOp | periodicOp once | stageB

  stage stageB on origin:
    chunk $file | stageC Robin

  stage stageC on all partitions on origin:
    readChunk $file | toCrwH $table | stageD hashed

  stage stageD on all partitions:
    insert $table | stageE

  stage stageE on origin:
    sink | stageA

end
;

/*----------------------------------------------------------------------------*/
/* list columns of a table                                                    */
/*----------------------------------------------------------------------------*/
procedure lscol
  parameters $table
begin

  stage stageA on origin:
    startOp | periodicOp once | listColumns $table |
      output | sink | stageA
end
;

/*----------------------------------------------------------------------------*/
/* check sanity of the grid                                                   */
/*----------------------------------------------------------------------------*/
procedure nodeInfo
begin

  stage stageA on origin:
    startOp | periodicOp once | stageB

  stage stageB on all nodes:
    nodeInfo | stageC

  stage stageC on origin:
    output | sink | stageA

end
;

/*----------------------------------------------------------------------------*/
/* fetch rows from a partition of a table                                     */
/*----------------------------------------------------------------------------*/
procedure partitionFetch
  parameters $table $partition
begin

  stage stageA on origin:
    startOp | periodicOp once | stageB

  stage stageB on partition $partition:
    scan $table | stageC

  stage stageC on origin:
    output | sink | stageA

end
;

/*----------------------------------------------------------------------------*/
/* stored procedure with two-part name syntax test                            */
/*----------------------------------------------------------------------------*/
procedure Select Table
  parameters $Table
begin

  stage stageA on origin:
  startOp | periodicOp once | stageB

  stage stageB on all partitions:
  scan $Table | stageC

  stage stageC on origin:
  output | sink | stageA

end;

