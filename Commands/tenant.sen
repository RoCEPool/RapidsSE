/*============================================================================*/
/* tenant.sen -- tenant related words                                         */
/*============================================================================*/

"tenant.sen" .

: tenant ;

: :tenant
    :dic dup ' tenant swap word.kind!
;

: withinTenants
    0 dic.pick dic.name "tenants" streql
;

: checkInTenants
    withinTenants if true exit then
    EM_NOT_IN_TENANTS EC_NOT_IN_TENANTS failure false
;

: checkIsTenant ( word )

    dup not if drop EM_NO_SUCH_TENANT EC_NO_SUCH_TENANT failure 0 exit then

    dup word.kind@ ' tenant eql if 1 exit then
    drop
    "not a tenant" 1 failure 0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/