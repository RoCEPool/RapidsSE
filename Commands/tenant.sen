/*============================================================================*/
/* tenant.sen -- tenant related words                                         */
/*============================================================================*/

"tenant.sen" .putVerbose

: tenant ;

: :tenant
    :dic dup ' tenant swap word.kind!
;

: withinTenants
    0 dic.pick dic.name "tenants" streql
;

: checkInTenants
    withinTenants if true exit then
    EC_NOT_IN_TENANTS false
;

: checkIsTenant ( word )

    dup not if drop EC_NO_SUCH_TENANT false exit then

    dup word.kind@ ' tenant eql if true exit then
    drop
    EC_NOT_A_TENANT false
;

: checkIsNotTenant ( word )
  dup find not if true exit then
  EC_TENANT_EXISTS false
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/