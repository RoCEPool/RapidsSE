/*============================================================================*/
/* tenant.sen -- tenant related words                                         */
/*============================================================================*/

"tenant.sen" .

: tenant ;

: withinTenants
    0 dic.pick dic.name "tenants" streql
;

: checkInTenants
    withinTenants if 1 exit then
    "not in tenants" 1 failure 0
;

: checkIsTenant ( word )

    dup not if drop "no such tenant" 1 failure 0 exit then
    dup word.kind@ ' tenant eql if 1 exit then
    drop
    "not a tenant" 1 failure 0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/