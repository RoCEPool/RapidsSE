  L_SHIPDATE2      DATE NOT NULL,            // 26)
  L_COMMITDATE2    DATE NOT NULL,            // 27)
  L_RECEIPTDATE2   DATE NOT NULL,            // 28)
  L_SHIPINSTRUCT2  CHAR(25) NOT NULL,        // 29)
  L_SHIPMODE2      CHAR(10) NOT NULL,        // 30)
  L_COMMENT2       VARCHAR(44) NOT NULL      // 31)
  //                                                ---- ----
  // 32 columns
  //
);

