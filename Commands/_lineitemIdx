/*============================================================================*/
/*  _lineitemIdx - create and load TPC-H Lineitem table for SF1              */
/*============================================================================*/

ping ;

cf ~ ;
cf tenants ;
cf boray ;
cf catalogs ;
cf rapidsse ;
cf schemas ;

create schema tpchSchema;

cf tpchSchema ;
cf tables ;

create table lineitem (
	 L_ORDERKEY      INTEGER NOT NULL,
	 L_PARTKEY       INTEGER NOT NULL,
	 L_SUPPKEY       INTEGER NOT NULL,
	 L_LINENUMBER    INTEGER NOT NULL,
	 L_QUANTITY      DECIMAL(15,2) NOT NULL,
	 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
	 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
	 L_TAX           DECIMAL(15,2) NOT NULL,
	 L_RETURNFLAG    CHAR(1) NOT NULL,
	 L_LINESTATUS    CHAR(1) NOT NULL,
	 L_SHIPDATE      DATE NOT NULL,
	 L_COMMITDATE    DATE NOT NULL,
	 L_RECEIPTDATE   DATE NOT NULL,
	 L_SHIPINSTRUCT  CHAR(25) NOT NULL,
	 L_SHIPMODE      CHAR(10) NOT NULL,
	 L_COMMENT       VARCHAR(44) NOT NULL
);

set am_indexspace 1;

print "loading lineitem.tbl..." ;
ld lineitem "/tpch/lineitem.tbl" ;

create index idx1 on lineitem (L_ORDERKEY);

pwf ;
lf ;

/*----------------------------------------------------------------------------*/
print "----------------------------------------------------------------------";
print "\nExact select from lineitem (idx1) where L_ORDERKEY == 3..." ;
keyselidx lineitem idx1 3 ;

print "----------------------------------------------------------------------";
print "\nLower select from lineitem (idx1) where L_ORDERKEY >= 99720 ..." ;
fetch lineitem "L_ORDERKEY 99720 >=";

print "----------------------------------------------------------------------";
print "\nUpper select from lineitem (idx1) where L_ORDERKEY <= 20 ..." ;
uprselidx lineitem idx1 20 ;

print "----------------------------------------------------------------------";
print "\nRange select from lineitem (idx1) where L_ORDERKEY >= 9972 & <= 9982..." ;
rgeselidx lineitem idx1 9972 9982 ;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
