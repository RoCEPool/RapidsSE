/*============================================================================*/
/* actors.sen -- actors group                                                 */
/*============================================================================*/

"actors.sen" .putVerbose

int: queryCount

"listerTask.sen"  >>:
"monitorTask.sen" >>:
"reclaimTask.sen" >>:
"requestTask.sen" >>:
"receiverTask.sen" >>:
"senderTask.sen"  >>:
"connectorTask.sen" >>:
"answerTask.sen" >>:

"generalThread.sen" >>:

/*----------------------------------------------------------------------------*/
/* called by RapidsSE::vStartActors                                           */
/*----------------------------------------------------------------------------*/
: startActors

  "startActors" .putVerbose

  bgtasks if

    snooze generalThreadStart

    snooze listerStart
    snooze monitorStart
    snooze reclaimStart
    //snooze answerStart

  then

  //dic.main true dic.frozen!

  //  debug.trap

  //  "requestProcessingLoop" find execute

  requestStart
  ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
