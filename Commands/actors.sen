/*============================================================================*/
/* actors.sen -- actors group                                                 */
/*============================================================================*/

"actors.sen" .verbose

"listerTask.sen"  >>:
"monitorTask.sen" >>:
"reclaimTask.sen" >>:
"requestTask.sen" >>:

"generalThread.sen" >>:

/*----------------------------------------------------------------------------*/
/* called by RapidsSE::vStartActors                                           */
/*----------------------------------------------------------------------------*/
: startActors

  "startActors" .verbose

  args.bgtasks if

    snooze generalThreadStart

    snooze listerStart
    snooze monitorStart
    snooze reclaimStart
    snooze answerStart

  then

  //dic.main true dic.frozen!

  requestStart
  ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
