/*============================================================================*/
/* _nationLoad - create and load TPC-H Nation table for SF1                   */
/*============================================================================*/

markjob export on;
markjob;

markres file on;
markres socket on;
markres;

startCluster;

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);

print "loading nation.csv..." ;
ld nation "/tpch/SF1/nation.csv" ;

am "\n##########################################################################################\n\n";
print "exporting nation.csv..." ;
export nation "/tmp/nation_export.csv" ;

activityMap short;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
