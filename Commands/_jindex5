/*============================================================================*/
/* _jindex -- index entry testing                                             */
/*============================================================================*/

create table j5 (
  j5_key   INTEGER NOT NULL,
  j5_name  VARCHAR(32) NOT NULL
);

print "loading j5.csv..." ;
create index idx on j5 (j5_key);
oldLoad j5 "../JTEST/j5.csv" ;

cf indexes ;
pwf ;
dumpidx j5 idx ;
antbl j5;

predicateFetch j5 "j5_key 4 ==";
predicateFetch j5 "j5_key 3 >=";
predicateFetch j5 "j5_key 3 <=";
predicateFetch j5 "j5_key 2 >= j5_key 4 <= and";
predicateFetch j5 "j5_name 4 ==";

