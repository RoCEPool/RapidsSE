/*============================================================================*/
/* munge.sen -- create the .cpp from .sen                                     */
/*============================================================================*/

"munge.sen" .verbose

/*----------------------------------------------------------------------------*/
/* put the variable for the sen file into c++ file                            */
/*----------------------------------------------------------------------------*/
: mungeCppVariable ( cppFile senFile -- )

  locals| senFile cppFile |

  "const char* SEN_" cppFile file.write

  senFile file.path@ str.length 4 - 0 senFile file.path@ str.sub

  cppFile file.write

  " = " cppFile file.write
  "\n" cppFile file.write
;

/*----------------------------------------------------------------------------*/
/* put the variable initialise into c++ file                                  */
/*----------------------------------------------------------------------------*/
: mungeCppInitialise ( cppFile senFile -- )

  "" locals| senLine senFile cppFile |

  begin senFile file.read while

    str.escape to senLine

    "  \""   cppFile file.write
    senLine cppFile file.write
    "\""     cppFile file.write
    "\n"    cppFile file.write

  repeat
;

/*----------------------------------------------------------------------------*/
/* put a ; terminator for statement into c++ file                             */
/*----------------------------------------------------------------------------*/
: mungeCppTerm ( cppFile senFile -- )

  locals| senFile cppFile |

  ";\n" cppFile file.write
;

/*----------------------------------------------------------------------------*/
/* produce a c++ statement for the sen file                                   */
/*----------------------------------------------------------------------------*/
: mungeCppStatement ( cppFile senFile -- )

  locals| senFile cppFile |

  cppFile senFile mungeCppVariable

  cppFile senFile mungeCppInitialise

  cppFile senFile mungeCppTerm
;

/*----------------------------------------------------------------------------*/
/* munge one .sen file                                                        */
/*----------------------------------------------------------------------------*/
: mungeSenFile ( "<fileNm"> cppFile -- )

  file.new locals| senFile cppFile |

  senFile file.path!

  OPEN_READ senFile file.open assert

  cppFile senFile mungeCppStatement

  // close and delete the file accessor
  senFile file.close
  senFile file.delete
;

/*----------------------------------------------------------------------------*/
/* munge all .sen files in the command dir                                    */
/*----------------------------------------------------------------------------*/
: mungeDir ( cppFile commandDir -- )

  locals| commandDir cppFile |

  // read thru directory
  begin commandDir dir.read while

    // ignore entries which aren't regular files
    commandDir dir.entryType DE_REG == not continue

    // ignore entries which aren't .sen files
    4 commandDir dir.entryName str.right ".sen" str.equal not continue
    commandDir dir.entryName .

    // convert to C++
    commandDir dir.entryName cppFile mungeSenFile

  repeat
;

/*----------------------------------------------------------------------------*/
/* munge all .sen files                                                       */
/*----------------------------------------------------------------------------*/
: munge

  // create a directory accessor
  file.new dir.new locals| commandDir cppFile |

  // set path in the directory accessor
  "." commandDir dir.path!

  // open directory
  commandDir dir.open

  // open cpp file
  "../Munge/munge.cpp" cppFile file.path!
  OPEN_WRITE cppFile file.open assert

  // munge the command dir
  cppFile commandDir mungeDir

  // close and delete file accessor
  cppFile file.close
  cppFile file.delete

  // close and delete directory accessor
  commandDir dir.close
  commandDir dir.delete
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
