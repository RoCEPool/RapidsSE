/*============================================================================*/
/* munge.sen -- create the .cpp from .sen                                     */
/*============================================================================*/

"munge.sen" .verbose

: munge

  dir.new locals| commandDir |

  "." commandDir dir.path!

  commandDir dir.open

  begin commandDir dir.read while

    commandDir dir.entryName "." streql continue
    commandDir dir.entryName ".." streql continue

    commandDir dir.entryName .
  repeat

  commandDir dir.close

  commandDir dir.delete
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
