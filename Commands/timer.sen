/*============================================================================*/
/* timer.sen -- timer                                                         */
/*============================================================================*/

"timer.sen" .putVerbose

: timer ;

: timer:
    create 
    WT_OBJECT word.this word.type!
    sizeof_timer allot
    word.this >body magic!!
    word.this >body CN_TIMER class!
   ' timer word.this word.kind!
    word.this >body timer.init
    word.this >body object.wordbody
    does> 
;

: :timer
    >create
    WT_OBJECT word.this word.type!
    sizeof_timer allot
    word.this >body magic!!
    word.this >body CN_TIMER class!
    ' timer word.this word.kind!
    word.this >body timer.init
    word.this >body object.wordbody
    does>
;

timer: testTimer

: timerTest

    testTimer timer.start
    1 sleep
    testTimer timer.update
    testTimer timer.millisecs .
    testTimer timer.microsecs .
    testTimer timer.nanosecs .
    testTimer timer.ticks .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
