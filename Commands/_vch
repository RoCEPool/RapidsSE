ping ;

print "\n- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" ;
print "100 Default formatters\n" ;

create table vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);

print "loading table vch..." ;
ld vch "../JTEST/vch_defaults.csv" ;

fetch vch;
drop table vch;

