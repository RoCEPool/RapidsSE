/*============================================================================*/
/* boot.sen -- high-level boot sequence                                       */
/*============================================================================*/

"boot.sen" .

//------------------------------------------------------------------------------
// step 1: compile the inital set of high-level words

"core.sen" >>:
"dic.sen" >>:
"file.sen" >>:
"var.sen" >>:
"trace.sen" >>:
"useful.sen" >>:

// compile the runtime words
"runtime.sen" >>:

//------------------------------------------------------------------------------
// step 2: compile testing
"testing.sen" >>:

//------------------------------------------------------------------------------
// step 3: compile "the system"
"metadata.sen" >>:
"theSystem.sen" >>:

//------------------------------------------------------------------------------
// step 4:

( create the threadList to hold all thread's )
threadlist: threadList

( create the txList to hold all tx's )
txlist: txList

( create the sessionList to hold all session's )
sessionlist: sessionList

( add this task to task list )
// task.this tasklist tasklist.append

( spawn first 2nd thread and leave on stack )
thread: RootThread
taskset: TaskSet1 TaskSet1 RootThread thread.taskset!
RootThread thread.spawn RootThread

"booted.sen" >>:

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/