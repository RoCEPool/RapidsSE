/*============================================================================*/
/* requestServer.sen -- request server                                        */
/*============================================================================*/

"requestServer.sen" .

//------------------------------------------------------------------------------
( create the parts )
queue:   requestQueue
dic:     tenants

//------------------------------------------------------------------------------
: !req ( process request  )
    valset> stk drop >: >:
;

//------------------------------------------------------------------------------
: req> ( receive request  )
    begin
      task.this task.queue@
      queue.pop
      dup not if 100 thread.sleep_us then
    until
;

//------------------------------------------------------------------------------
: >rsp ( send response    )
    >valset
    "rspque" find execute queue.append
    0 task.this task.seitf!
;

//------------------------------------------------------------------------------
: requestServerLoop ( request server )

    "renaming to Request Server" .

    "requestServer" task.this task.name!

    requestQueue task.this task.queue!

    "Request Server running..." .

    begin
      req>
      !req
      >rsp
    0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/