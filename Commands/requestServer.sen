/*============================================================================*/
/* systemServer.sen -- system server                                          */
/*============================================================================*/

"systemServer.sen" .

//------------------------------------------------------------------------------
( create the parts )
queue:   requestQueue
dic:     tenants

//------------------------------------------------------------------------------
: !req ( process request  )
    valset> drop stk >: stk >: stk
;

//------------------------------------------------------------------------------
: req> ( receive request  )
    begin
      task.this task.queue@
      queue.pop
    until
;

//------------------------------------------------------------------------------
: >rsp ( send response    )
    >valset valset> stk >valset
    "rspque" find execute queue.append
;

//------------------------------------------------------------------------------
: requestServerLoop ( request server )

    "renaming to Request Server" .

    "requestServer" task.this task.name!

    requestQueue task.this task.queue!

    "Request Server running..." .

    begin
      req>
      !req
      >rsp
    0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/