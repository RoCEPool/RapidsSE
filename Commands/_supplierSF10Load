/*============================================================================*/
/* _supplierLoad - create and load TPC-H Supllier table for SF1               */
/*============================================================================*/

cf ~ ;
cf tenants ;
cf boray ;
cf catalogs ;
cf rapidsse ;
cf schemas ;

create schema tpchSchema;

cf tpchSchema ;
cf tables ;

create table supplier (
	 S_SUPPKEY       INTEGER NOT NULL,
	 S_NAME          CHAR(25) NOT NULL,
	 S_ADDRESS       VARCHAR(40) NOT NULL,
	 S_NATIONKEY     INTEGER NOT NULL,
	 S_PHONE         CHAR(15) NOT NULL,
	 S_ACCTBAL       DECIMAL(15,2) NOT NULL,
	 S_COMMENT       VARCHAR(101) NOT NULL
);

print "loading supplier.tbl..." ;
ld supplier "/tpch/SF10/supplier.tbl" ;

pwf ;
lf ;

