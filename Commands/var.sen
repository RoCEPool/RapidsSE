/*============================================================================*/
/* intvar.sen -- integer variable related words                               */
/*============================================================================*/

"intvar.sen" .

/*----------------------------------------------------------------------------*/
/* create int variable in current dictionary using name from input stream     */
/*----------------------------------------------------------------------------*/
: int:
    create 
    object!!
    sizeof_intval allot
    word.this >body magic!!
    word.this >body CN_INTVAL class!
    does>
;

/*----------------------------------------------------------------------------*/
/* create str variable in current dictionary using name from input stream     */
/*----------------------------------------------------------------------------*/
: str:
    create
    object!!
    sizeof_strval sizeof_s256 + allot
    word.this >body magic!!
    word.this >body CN_STRVAL class!
    does>
;

/*----------------------------------------------------------------------------*/
/* create wrd variable in current dictionary using name from input stream     */
/*----------------------------------------------------------------------------*/
: wrdvar:
    create
    object!!
    sizeof_wrdval allot
    word.this >body magic!!
    word.this >body CN_WRDVAL class!
    does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/