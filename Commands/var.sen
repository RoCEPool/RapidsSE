/*============================================================================*/
/* intvar.sen -- integer variable related words                               */
/*============================================================================*/

"intvar.sen" .

: intvar:
    create 
    object!!
    sizeof_intval allot
    word.this >body magic!!
    word.this >body CN_INTVAL class!
    ( word.this >body thread.init )
    does> test
;

: s32var:
    create
    object!!
    sizeof_strval sizeof_s32 + allot
    word.this >body magic!!
    word.this >body CN_STRVAL class!
    ( word.this >body thread.init )
    does> test
;


: wrdvar:
    create
    object!!
    sizeof_wrdval allot
    word.this >body magic!!
    word.this >body CN_WRDVAL class!
    ( word.this >body thread.init )
    does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/