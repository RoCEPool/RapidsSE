/*============================================================================*/
/* listerTask.sen -- task lister                                              */
/*============================================================================*/

"listerTask.sen" .

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

taskset: listerTaskSet

thread:  listerThread

/*----------------------------------------------------------------------------*/
/* start the lister task                                                      */
/*----------------------------------------------------------------------------*/

: listerStart

     "listerLoop"  task.new

     listerTaskSet taskSet.Append

     listerTaskSet listerThread  thread.taskset!

     listerThread  thread.spawn
;

/*----------------------------------------------------------------------------*/
/* lister iteration                                                           */
/*----------------------------------------------------------------------------*/

: iterateTaskList

    "task list..." .

;

/*----------------------------------------------------------------------------*/
/* lister task loop                                                           */
/*----------------------------------------------------------------------------*/

: listerLoop

    "listerTask" task.this task.name!

    "lister Task running..." .

    begin

      iterateTaskList

      3 sleep

    0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/