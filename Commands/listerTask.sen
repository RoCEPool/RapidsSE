/*============================================================================*/
/* listerTask.sen -- task lister                                              */
/*============================================================================*/

"listerTask.sen" .

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

taskset: listerTaskSet

thread:  listerThread

tasklist taskCursor: taskCrs

/*----------------------------------------------------------------------------*/
/* start the lister task                                                      */
/*----------------------------------------------------------------------------*/

: listerStart

     "listerLoop"  task.new

     listerTaskSet taskSet.Append

     listerTaskSet listerThread  thread.taskset!

     listerThread  thread.spawn
;

/*----------------------------------------------------------------------------*/
/* lister iteration                                                           */
/*----------------------------------------------------------------------------*/

: iterateTaskList

    listerTaskPrint if
      "task list..." .
    then

//traceon
  taskcrs taskcrs taskcursor.begin
  iterate

    listerTaskPrint if
      object@ task.dump
    then

    cursor@ taskcursor.next object!

  next

  taskcrs taskcursor.end

;

/*----------------------------------------------------------------------------*/
/* lister task loop                                                           */
/*----------------------------------------------------------------------------*/

: listerLoop

    "listerTask" task.this task.name!

    "lister Task running..." .

    begin

      iterateTaskList

      3 sleep

    0 until
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/