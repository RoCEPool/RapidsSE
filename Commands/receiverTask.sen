/*============================================================================*/
/* ReceiverTask.sen -- receiver task                                          */
/*============================================================================*/

"ReceiverTask.sen" .putVerbose

/*----------------------------------------------------------------------------*/
/* receiver formation                                                         */
/*----------------------------------------------------------------------------*/
: receiverForm ( ... socket #args "<loop>" "<actorName>" -- queue )

    reg.push

    >r

    // r0 has <actorName>

    r0 ".task"    concat dup . :task    execute >reg0  // reg0 has task
    r0 ".queue"   concat dup . :queue   execute >reg1  // reg1 has queue
    r0 ".taskset" concat dup . :taskset execute >reg2  // reg2 has taskset
    r0 ".thread"  concat dup . :thread  execute >reg3  // reg3 has thread

    stk

    // seed the task
    reg0 task.seed

    stk
    // setup the socket in the task
    reg0 task.socket!

    // attach queue to task
    reg1 reg0 task.queue!

    // put task in taskset
    reg0 reg2 taskset.append

    // attach taskset to thread
    reg2 reg3 thread.taskset!

    // spawn the os thread
    reg3 thread.spawn

    rdrop

    reg.pop
;

/*----------------------------------------------------------------------------*/
/* recv valset from the socket                                                */
/*----------------------------------------------------------------------------*/
: !recv

  task.this task.socket@
  socket.recv
  "RECEIVED" .

  // expand valset into stack values
  valset>  ( ... wordName senderNode #values )

  drop // #values

  swap
  "PONG" concat

  stk

  "sending response".

  send

;

/*----------------------------------------------------------------------------*/
/* receiver loop                                                              */
/*----------------------------------------------------------------------------*/
: receiver.loop

    "renaming to Receiver Task" .putVerbose

    "receiver.task" task.this task.name!

    //receiver.queue  task.this task.queue!

    receiverTaskPrint if "Receiver running on node" args.node >str concat . then

    10 sleep

    begin
      !recv
    0 until

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
