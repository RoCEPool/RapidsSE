//tag default <tpch_dir> = "/mnt/disk1" ;
//tag default <suffix>   = "tbl";

tag default <tpch_dir> = "/Users/Shared/tpch/SF1" ;
tag default <suffix>   = "csv";

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// tables

_orders
_lineitem

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// indexes

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// load

/time load orders   "<tpch_dir>/orders.<suffix>"   ;

/******************************************************************************
Q12_0: select
         l_shipmode,
         sum(case when    o_orderpriority ='1-URGENT'
                       or o_orderpriority ='2-HIGH'
                  then 1
                  else 0
             end)                                        as high_line_count,
         sum(case when    o_orderpriority <> '1-URGENT'
                      and o_orderpriority <> '2-HIGH'
                  then 1
                  else 0
             end)                                        as low_line_count

  from Orders, LineItem

 where     o_orderkey    =  l_orderkey
       and l_shipmode    in ('MAIL', 'SHIP')
       and l_commitdate  <  l_receiptdate
       and l_shipdate    <  l_commitdate
       and l_receiptdate >= '1994-01-01 00:00:00'
       and l_receiptdate <  '1995-01-01 00:00:00’

 group by l_shipmode

 order by l_shipmode;
*******************************************************************************/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// pipeline

/time pipeline Q12
begin

  stage first on origin :
    start
    | pulse once
    | next

  //
  // Q12_0:
  /    a) scan Orders   /O_CUSTKEY/   # _custkey    _orderkey
  //   b) join LineItem /L_ORDERKEY/  # _orderkey   _partkey   _suppkey
  //

  // ∀ ORDERS π O_ORDERKEY as _orderkey
  stage Gs_ORDERS on all partitions :
    scan orders
    | project 1 "type INTEGER as _orderkey O_ORDERKEY"
    | debug rowbuffer
    | next

  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =


  stage G_CNT_P on all partitions :
    project 1 " type INTEGER as x_rowCntPtn )  countAll  "
    | next
    
  stage G_CNT_N on all nodes :
    project 1 " type INTEGER as x_rowCntNode )  x_rowCntPtn sum  "
    | next
    
  stage G_CNT_O on origin :
    project 1 " type INTEGER as x_rowCntOrigin )  x_rowCntNode sum  "
    | next

  stage last on origin :
    output
    | debug accum0
    | sink
    | first

end ;


