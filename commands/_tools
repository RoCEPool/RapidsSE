ssnState;     // show session api call state
args;         // show command line args
attachMap;    // dump the attach map
bp;           // show buffer pool
classes;      // generate classes list
config;       // show node information
constants;    // show important constants
date;         // show current date and time
hashdefs;     // show #def's
heapMem;      // information about the heap
indexEntries; // set index entries
locks;        // locks report
masks;        // masks report
numbers;      // show important numbers
olist;        // show originator job list
opsys;        // show infor about operating system
plist;        // show participant job list
sizes;        // show sizes of important objects
threads;      // show information about constants
version       // show SE version

