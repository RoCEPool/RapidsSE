nowait publish lineitem "/tmp/lineitem.rowAgg" ;

nowait repeater "/tpch/SF10/lineitem.csv" "/tmp/lineitem.pipe" stats ;

nowait ingest lineitem "/tmp/lineitem.pipe" stats ;

