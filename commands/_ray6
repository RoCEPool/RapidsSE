_nation
create index IxN_NATIONKEY on nation (n_nationkey);
/time load nation   "<tpch_dir>/nation.<suffix>";

/glean_interactive
/weaved
/weaver2
/optimise_passthru
pipeline _unnamed_
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
    indexScan Nation IxN_NATIONKEY "LBOUND $I1 2 > "
    | project  "type INTEGER as N_NATIONKEY $1 , type VARCHAR as N_NAME $2 , type INTEGER as N_REGIONKEY $3 , type VARCHAR as N_COMMENT $4 "
    | combined  0
    | next

  stage S02 on origin :
      output
    | sink
    | first

end ;


