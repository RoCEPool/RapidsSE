_lineitem

load lineitem "../tpch/SF_0001/lineitem.csv" ;

select
  sum(l_extendedprice * l_discount) as Revenue
  from LineItem
 where
           l_shipdate >= DATE '1994-01-01'
       and l_shipdate <  DATE '1995-01-01'
       and l_discount between 0.05 - 0.01 and 0.06 + 0.01
//     and l_quantity <  24
;

drop table lineitem;

