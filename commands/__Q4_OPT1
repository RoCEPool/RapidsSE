/*============================================================================*/
/* __Q4_OPT1                                                                  */
/*============================================================================*/

// From oroginal weaved :
//   Merged S01 and S02 (early projection)
//   Merged S03, S04 and S05

/keepCodeFile
/optimise_passthru
pipeline Query4
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan orders
    | project "type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
               type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE ,
               type VARCHAR ( 15 ) as O_ORDERPRIORITY O_ORDERPRIORITY"
    | filter " type BOOLEAN O_ORDERDATE DATE '1993-07-01' >=
                            O_ORDERDATE DATE '1993-10-01' < and "
    | hash "type INTEGER ( 19 ) O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    keyExists lineitem IxL_ORDERKEY  "BOUND $I1 O_ORDERKEY =="
                                      "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
    | gbyAgg "groupby type VARCHAR ( 15 ) O_ORDERPRIORITY
              aggregates
              type VARCHAR ( 15 ) as O_ORDERPRIORITY $K1 ,
              type INTEGER ( 19 ) as ORDER_COUNT ) countAll"
    | combined 0
    | next

  stage S03 on all nodes :
    gbyAgg "groupby type VARCHAR ( 0 ) O_ORDERPRIORITY
            aggregates
            type VARCHAR ( 0 ) as O_ORDERPRIORITY $K1 ,
            type INTEGER ( 19 ) as ORDER_COUNT ) ORDER_COUNT sum"
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg "groupby type VARCHAR ( 0 ) O_ORDERPRIORITY
            aggregates
            type VARCHAR ( 0 ) as O_ORDERPRIORITY $K1 ,
            type INTEGER ( 19 ) as ORDER_COUNT ) ORDER_COUNT sum"
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;


