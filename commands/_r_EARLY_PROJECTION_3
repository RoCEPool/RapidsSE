/*============================================================================*/
/* _r_EARLY_PROJECTION_3 -- early projection 3                                */
/*============================================================================*/

// --initial _r_EARLY_PROJECTION_3

tag default <tpch_dir> = "../tpch/sf_0001";
tag default <suffix>   = "csv";

__TPCH_SCHEMA

select * from dummy;

trackMemory;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_EARLY_PROJECTION_3"
select
       o_orderkey,
       avg(l_extendedprice)
  from
       Orders,
       Lineitem
 where
       O_ORDERKEY = L_ORDERKEY
   and
       l_orderkey = (
                       select
                              min(l_orderkey)
                         from
                              Customer,
                              Orders,
                              Lineitem
                        where
                              C_CUSTKEY  = O_CUSTKEY
                          and O_ORDERKEY = L_ORDERKEY

                          and c_custkey > 10
                       )

 group
       by O_ORDERKEY
 order
       by O_ORDERKEY
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

MemoryLeaks;

