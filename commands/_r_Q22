// --initial _r_Q22

_r_schema

create index C_idx0  on Customer (C_CUSTKEY);
create index O_idx0  on Orders   (O_CUSTKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_Q22"
select
  c_phone,
  count(*)       as numcust,
  sum(c_acctbal) as totacctbal
  from
       ( /* Q22_1: */
         select c_phone,
                c_acctbal
           from Customer
          where
                c_acctbal >
                            ( /* Q22_1_1: */
                              select avg(c_acctbal)
                                from Customer
                               where
                                     c_acctbal > 0.00
                            )
                and
                    exists
                            ( /* Q22_1_2: */
                              select *
                                from Orders
                               where O_CUSTKEY = C_CUSTKEY
                               and O_SHIPPRIORITY > 0
                            )
       )

  group by c_phone
  order by c_phone
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

