/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_PARTITIONING"
select count(*)
  from Customer,
       Orders,
       Lineitem,
       Supplier
 where C_CUSTKEY  = O_CUSTKEY
   and L_ORDERKEY = O_ORDERKEY
   and L_SUPPKEY  = S_SUPPKEY
;

