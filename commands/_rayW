tag default <tpch_dir> = "../tpch/sf_0001";
tag default <suffix>   = "csv";

__TPCH_SCHEMA_LOAD_SF0001

select
  ps_partkey,
  sum(ps_supplycost * ps_availqty) as value
from
  partsupp,
  supplier,
  nation
where
  ps_suppkey = s_suppkey
  and s_nationkey = n_nationkey
  and n_name = 'IRAQ'
group by
  ps_partkey having
    sum(ps_supplycost * ps_availqty) >
    (
      select
        sum(ps_supplycost * ps_availqty) * 0.0001
      from
        partsupp,
        supplier,
        nation
      where
        ps_suppkey = s_suppkey
        and s_nationkey = n_nationkey
        and n_name = 'IRAQ'
    )
order by
   value desc;

