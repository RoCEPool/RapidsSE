/*============================================================================*/
/* _rlu - RLU                                                                 */
/*============================================================================*/
create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (a);

print "loading T1.csv..." ;
load T1 "../DATA/Joins/T1.csv" ;

/time pipeline test
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan T1
    | rlu
    | stageC

  stage stageC on origin :
    output
    | sink
    | stageA
end
;

