__TPCH_SCHEMA_LOAD_SF0001

//NOTE: Can the optimiser detect on line 24 that
//     type TIMESTAMP as l_orderdate l_orderdate ,
// should have been :
//     type TIMESTAMP as l_orderdate $K1 ,

/pipeline_def
/weaved
/optimise_passthru
pipeline unnamed
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gj_SCAN on all partitions :
    scan lineitem
    | gbyAgg "groupby type TIMESTAMP l_SHIPDATE
      aggregates
        type TIMESTAMP as l_SHIPDATE l_SHIPDATE ,
        type DECIMAL as amount ) l_discount sum"
    | combined 0
    | next

stage G_SUM_N on all nodes :
    gbyAgg "groupby type TIMESTAMP l_SHIPDATE
    aggregates
      type TIMESTAMP as l_SHIPDATE $K1 ,
      type DECIMAL as amount ) amount sum"
    | combined 0
    | next

stage G_SUM_O on origin :
    gbyAgg "groupby type TIMESTAMP l_SHIPDATE
    aggregates
      type TIMESTAMP as o_year $K1 ,
      type DECIMAL as amount ) amount sum"
    | combined 0
    | next

 stage last on origin :
    output
    | sink
    | first
end ;

