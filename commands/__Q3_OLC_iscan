/*============================================================================*/
/* __Q3_OLC_iscan                                                             */
/*============================================================================*/

/optimise_passthru
pipeline Query3
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
     indexscan ORDERS IxO_ORDERDATE "UBOUND DATE '1995-03-15' < "
     | project   " type DATE as O_ORDERDATE O_ORDERDATE
                  , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                  , type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY
                  , type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY "
    | hash      "type INTEGER O_ORDERKEY"
    | dynamic
    | next      hashcast

  stage S02 on all partitions multiple threads 4 :
    indexJoin Lineitem IxL_ORDERKEY " BOUND $I1 $4 == "
    | project   " type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                , type DATE as L_SHIPDATE L_SHIPDATE
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                , type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY "
    | filter    " type BOOLEAN L_SHIPDATE DATE '1995-03-15' > "
    | project   " type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                , type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY "
    | hash      "type INTEGER O_CUSTKEY"
    | dynamic
    | next      hashcast

  stage S03 on all partitions :
    indexJoin Customer IxC_CUSTKEY " BOUND $I1 O_CUSTKEY == "
    | filter    " type BOOLEAN $13 'BUILDING' == "
    | project   " type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY "
    | gbyAgg    " groupBy
                      type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                    , type DATE as O_ORDERDATE O_ORDERDATE
                    , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                    aggregates
                      type INTEGER ( 19 ) as L_ORDERKEY $K1
                    , type DECIMAL ( 19 2 ) as REVENUE ) L_EXTENDEDPRICE 1.00 L_DISCOUNT - * sum
                    , type DATE as O_ORDERDATE $K2
                    , type INTEGER ( 19 ) as O_SHIPPRIORITY $K3 "
    | dynamic
    | next

  stage S04 on all nodes :
    gbyAgg    " groupBy
                  type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                aggregates
                  type INTEGER ( 19 ) as L_ORDERKEY $K1
                , type DECIMAL ( 19 2 ) as REVENUE ) REVENUE sum
                , type DATE as O_ORDERDATE $K2
                , type INTEGER ( 19 ) as O_SHIPPRIORITY $K3 "
    | dynamic
    | next

  stage S05 on origin :
    gbyAgg    " groupBy
                  type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                aggregates
                  type INTEGER ( 19 ) as L_ORDERKEY $K1
                , type DECIMAL ( 19 2 ) as REVENUE ) REVENUE sum
                , type DATE as O_ORDERDATE $K2
                , type INTEGER ( 19 ) as O_SHIPPRIORITY $K3 "
    | dynamic
    | next

  stage S06 on origin :
    sort      " type DECIMAL ( 19 2 ) REVENUE DESC , type DATE O_ORDERDATE ASC "
    | limit      10
    | dynamic
    | next

  stage S07 on origin :
      output
    | sink
    | first

end ;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
