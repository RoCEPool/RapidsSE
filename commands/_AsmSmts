projection lineitem l_extendedPrice;
projection lineitem as x l_extendedPrice;

projection lineitem l_extendedPrice >= ;
projection lineitem l_shipdate, l_extendedPrice 2 *, l_extendedPrice;
projection lineitem l_extendedPrice, 2;
projection lineitem l_extendedPrice, l_discount, L_COMMENT;



rangeScan lineitem lineitem_idx2 "30 >= 50 <";
rangeScan lineitem lineitem_idx1  "'1994-01-01' >=  '1995-01-01' <";


pipeline singleColumn
begin
  stage stageA on origin :
    start | periodic once | stageB

   stage stageB on all partitions :
     scan lineitem
     | project l_extendedPrice | stage C

   stage stageC on origin :
      output | sink | stageA
end;

   pipeline Query6
   begin
     stage stageA on origin :
       start | periodic once | stageB

      stage stageB on all partitions :
        range 0 lineitem by lineitem_idx1 " '1994-01-01' >=  '1995-01-01' <"
        | filter lineitem "l_discount 0.04 >= <> l_discount 0.06 <= <> l_quantity 24.0 < <>"
        | project 0 "l_extendedPrice l_discount * , l_discount , l_quantity"
        | stageC

      stage stageC on origin :
        output | sink | stageA
   end;

pipeline Query6
begin
  stage stageA on origin :
    start | periodic once | stageB

   stage stageB on all partitions :
     range 0 lineitem by lineitem_idx1 " '1994-01-01' >=  '1995-01-01' <"
     | filter lineitem "l_discount 0.04 >= <> l_discount 0.06 <= <> l_quantity 24.0 < <>"
     | project 0 "l_extendedPrice l_discount * "
     | stageC

   stage stageC on origin :
     output | sink | stageA
end;
