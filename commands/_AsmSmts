pipeline Query6
begin
  stage stageA on origin :
    start | periodic once | stageB

   stage stageB on all partitions :
     range 0 lineitem by lineitem_idx2 x
     | project 0 "l_extendedPrice , l_comment"
     | stageC

   stage stageC on origin :
     output | sink | stageA
end;
