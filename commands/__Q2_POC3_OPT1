/*============================================================================*/
/* __Q2_POC3_OPT1                                                             */
/*============================================================================*/

/optimise_passthru
pipeline Query2
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan part
    | project " type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                type INTEGER ( 19 ) as P_SIZE P_SIZE"
    | filter " type BOOLEAN  }  P_TYPE '%BRASS'  6 matchTrailing P_SIZE 15 == and"
    | indexJoin partsupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project " type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST"
    | hash "type INTEGER ( 19 ) PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S02 on all partitions:
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY "
    | indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as N_REGIONKEY N_REGIONKEY "
    | indexJoin region IxR_REGIONKEY "BOUND $I1 N_REGIONKEY =="
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                           type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                           type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
                           type INTEGER ( 19 ) as N_REGIONKEY N_REGIONKEY ,
                           type VARCHAR ( 0 ) as R_NAME R_NAME "
    | filter " type BOOLEAN  R_NAME 'EUROPE'  == "
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                       type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                       type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST"
    | combined 0
    | next

  stage S03 on all partitions :
    gbyAgg " GroupBy    type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST min "
    | combined 0
    | next

  stage S04 on all nodes :
     gbyAgg " GroupBy     type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min "
    | combined 0
    | next

  stage S05 on origin :
     gbyAgg " GroupBy    type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min "
    | hash "type INTEGER ( 19 ) P_PARTKEY"
    | combined 0
    | next hashcast

  stage S06 on all partitions  multiple threads 4:
    indexJoin partsupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN PS_SUPPLYCOST_MIN ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY"
    | filter "type BOOLEAN PS_SUPPLYCOST_MIN PS_SUPPLYCOST =="
    | indexJoin part IxP_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project " type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                    type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                    type VARCHAR ( 0 ) as P_MFGR P_MFGR"
    | hash "type INTEGER ( 19 ) PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S07 on all partitions:
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project " type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type DECIMAL ( 19  2 ) as S_ACCTBAL S_ACCTBAL ,
                type VARCHAR ( 0 ) as S_NAME S_NAME ,
                type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type VARCHAR ( 0 ) as P_MFGR P_MFGR ,
                type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS ,
                type VARCHAR ( 0 ) as S_PHONE S_PHONE ,
                type VARCHAR ( 0 ) as S_COMMENT S_COMMENT "
    | indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project " type DECIMAL ( 19  2 ) as S_ACCTBAL S_ACCTBAL ,
                type VARCHAR ( 0 ) as S_NAME S_NAME ,
                type VARCHAR ( 0 ) as N_NAME N_NAME ,
                 type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                 type VARCHAR ( 0 ) as P_MFGR P_MFGR ,
                 type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS ,
                 type VARCHAR ( 0 ) as S_PHONE S_PHONE ,
                 type VARCHAR ( 0 ) as S_COMMENT S_COMMENT "
    | sort "type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
            type VARCHAR ( 0 ) N_NAME ASC ,
            type VARCHAR ( 0 ) S_NAME ASC ,
            type INTEGER ( 19 ) P_PARTKEY ASC"
    | limit 100

    | combined 0
    | next

  stage S08 on all nodes :
    sort "type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER ( 19 ) P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S09 on origin :
    sort "type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER ( 19 ) P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
