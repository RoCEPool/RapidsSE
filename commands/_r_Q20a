// --initial _r_Q20a

_r_schema

create index P_idx0  on Part     (P_PARTKEY);
create index PS_idx0 on PartSupp (PS_PARTKEY);
create index S_idx0  on Supplier (S_SUPPKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_Q20a"
select
  s_name,
  s_address
  from Supplier
 where s_suppkey in ( /* Q20_1 */
                      select ps_suppkey
                        from PartSupp
                       where
                             ps_partkey in ( /* Q20_1_1 */
                                             select p_partkey
                                               from Part
                                              where p_name like 'forest%'
                                             )
                       )
;

