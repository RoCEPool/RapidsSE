/*============================================================================*/

// truncate metrics tables
truncate se__jobMetrics;
truncate se__jobOperands;
truncate se__jobOperators;

truncate se__jobNetwork;
truncate se__jobNetDissect;

truncate se__sysMetrics;
truncate se__sysLocks;

// enable metrics
metricsCtl enable;

///////////////////////
// QUERY 7

/jobMetrics
/weaved
select
    supp_nation,
    cust_nation,
    l_year,
    sum(volume) as revenue
from (
    select
       n1.n_name as supp_nation,
       n2.n_name as cust_nation,
       extract(year from l_shipdate) as l_year,
       l_extendedprice * (1 - l_discount) as volume
     from
       supplier,
       lineitem,
       orders,
       customer,
       nation n1,
       nation n2
     where
       s_suppkey = l_suppkey
       and o_orderkey = l_orderkey
       and c_custkey = o_custkey
       and s_nationkey = n1.n_nationkey
       and c_nationkey = n2.n_nationkey
       and ( (n1.n_name = 'FRANCE' and n2.n_name = 'GERMANY')
       or (n1.n_name = 'GERMANY' and n2.n_name = 'FRANCE'))
       and l_shipdate between '1995-01-01' and '1996-12-31'

     ) as shipping
 group by
   supp_nation,
   cust_nation,
   l_year
 order by
   supp_nation,
   cust_nation,
   l_year;

///////////////////////

// disable metrics
metricsCtl disable;

// sleep
sleep 5;

// generate system report data
sysReport;

print "-------------------------------------------";
print "NETWORK FOR QUERY 7.......................";

// get network data
select thisNodeName as thisNode,
     otherNodeName as otherNode,
     sum(sendCount)  as sCount,
     sum(sendBytes)  as sBytes,
     sum(recvCount)  as rCount,
     sum(recvBytes)  as rBytes
  from se__jobNetwork group by thisNodeName, otherNodeName;

print "-------------------------------------------";

