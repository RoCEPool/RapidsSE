/*============================================================================*/
/* _jo1_L_P_PS_Sb -- join order test                                          */
/*============================================================================*/

/weaved
/pipelineName = "_jo1_L_P_PS_Sb"
select
       count(*)
  from
       Lineitem,
       PartSupp,
       Part,
       Supplier
 where
       P_PARTKEY  = PS_PARTKEY
   and L_SUPPKEY  = PS_SUPPKEY
   and PS_SUPPKEY = S_SUPPKEY;

/*============================================================================*/
/* end                                                                        */
