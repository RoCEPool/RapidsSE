           // -- ROWS --       @SF1   @SF10  @SF100   @SF1K  @SF10K  @SF100K
_region    // 5 rows              5       5       5       5       5        5

_nation    // 25 rows            25      25      25      25      25       25

_supplier  // SF * 10K rows     10K    100K      1M     10M    100M       1G

_part      // SF * 200K rows   200K      2M     20M    200M      2G      20G

_partsupp  // SF * 800K rows   800K      8M     80M    800M      8G      80G

_customer  // SF * 150K rows   150K    1.5M     15M    150M    1.5G      15G

_orders    // SF * 1.5M rows   1.5M     15M    150M    1.5G     15G     150G
  
_lineitem  // SF * 6M rows       6M     60M    600M      6G     60G     600G
           //                 -----   -----   -----   -----   -----    -----
           //                  8.6M     86M    860M    8.6G     86G     860G
           // SE inuseSpace     2GB    20GB   200GB     2TB    20TB    200TB

status;

space;

tag default <scale_factor> = "SF1" ;

/time load region   "/Users/Shared/tpch/<scale_factor>/region.csv"   ;
/time load nation   "/Users/Shared/tpch/<scale_factor>/nation.csv"   ;
/time load supplier "/Users/Shared/tpch/<scale_factor>/supplier.csv" ;
/time load part     "/Users/Shared/tpch/<scale_factor>/part.csv"     ;
/time load partsupp "/Users/Shared/tpch/<scale_factor>/partsupp.csv" ;
/time load customer "/Users/Shared/tpch/<scale_factor>/customer.csv" ;
/time load orders   "/Users/Shared/tpch/<scale_factor>/orders.csv"   ;
/time load lineitem "/Users/Shared/tpch/<scale_factor>/lineitem.csv" ;

tableSizes;

space;

