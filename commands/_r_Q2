/*============================================================================*/
/* _r_Q2 -- TCPH query 2 test                                                 */
/*============================================================================*/

trackMemory;

_r_schema

create index P_idx0  on part     (P_PARTKEY  );
create index PS_idx0 on partsupp (PS_PARTKEY );
create index S_idx0  on supplier (S_SUPPKEY  );
create index N_idx0  on nation   (N_NATIONKEY);
create index R_idx0  on region   (R_REGIONKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimise
/glean_cue_from = "vS35X_T10_Push_sqB_Into_mqA"
/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_Q2"
select
  s_acctbal,
  s_name,
  n_name,
  p_partkey,
  p_mfgr,
  s_address,
  s_phone,
  s_comment
from
  part,
  partsupp,
  supplier,
  nation,
  region
where
  p_partkey = ps_partkey
  and s_suppkey = ps_suppkey
  and p_size = 15
  and p_type like '%BRASS'
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'EUROPE'
  and ps_supplycost =
(
  select
    min(ps_supplycost)
  from
    partsupp,
    supplier,
    nation,
    region
  where
    p_partkey = ps_partkey
    and s_suppkey = ps_suppkey
    and s_nationkey = n_nationkey
    and n_regionkey = r_regionkey
    and r_name = 'EUROPE'
  )
order by
  s_acctbal desc,
  n_name,
  s_name,
  p_partkey;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

