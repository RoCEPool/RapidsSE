create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

Load TABLE1 "../DATA/Load/tbl1data.csv" ;

/weaved
/pipeline_def
select sum(cola1), avg(ucol), colb1, ucolvc from table1 group by colb1, ucolvc
  having colb1 = 'black' or ucolvc = 'aaa' order by colb1, ucolvc;

