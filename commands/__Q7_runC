/******************************************************************************
Q07_A: select
         supp_nation,
         cust_nation,
         l_year,
         sum(volume) as Revenue
  from
       ( Q07_0: select n1.n_name                          as supp_nation,
                      n2.n_name                          as cust_nation,
                      extract(year from l_shipdate)      as l_year,
                      l_extendedprice * (1 - l_discount) as volume

           from Supplier, LineItem, Orders, Customer, Nation n1, Nation n2

          where     s_suppkey   = l_suppkey
                and o_orderkey  = l_orderkey
                and c_custkey   = o_custkey
                and s_nationkey = n1.n_nationkey
                and c_nationkey = n2.n_nationkey
                and (    (n1.n_name = 'FRANCE'  and n2.n_name = 'GERMANY')
                      or (n1.n_name = 'GERMANY' and n2.n_name = ‘FRANCE') )
                and l_shipdate  >= '1995-01-01'
                and l_shipdate  <= ‘1996-12-31' ) as shipping

 group by supp_nation, cust_nation, l_year

 order by supp_nation, cust_nation, l_year;



*******************************************************************************/


/time pipeline Q7c
begin

  stage first on origin :
    start
    | pulse once
    | next

  // ∀ CUSTOMER /C_CUSTKEY/ _custkey π _suppkey
  stage Gj_CUSTOMER on all partitions :
    scan Customer
    | filter 2
        "C_NATIONKEY 6 == C_NATIONKEY 7 == or"
    | project 2 expr
        type INTEGER as _custkey    C_CUSTKEY ,
        type INTEGER as C_NATIONKEY C_NATIONKEY
    | combined 0
    | next

//UC

  // ∀ ORDERS /O_CUSTKEY/ π _custkey
  stage Gj_ORDERS on all partitions :
    indexJoin 2 Orders IxO_CUSTKEY expr bound $I1 _custkey ==
    | project 2 expr
        type INTEGER as _orderkey   J1_O_ORDERKEY ,
        type INTEGER as C_NATIONKEY C_NATIONKEY
    | hash 2 expr type INTEGER _orderkey
    | combined 0
    | next hashcast

//HC

  // ∀ LINEITEM /L_ORDERKEY/ π _orderkey
  stage Gs_LINEITEM on all partitions :
    indexJoin 2 Lineitem IxL_ORDERKEY expr bound $I1 _orderkey ==
    | filter 2
        "J1_L_SHIPDATE timestamp '1995-01-01 00:00:00' >=
         J1_L_SHIPDATE timestamp '1996-12-31 00:00:00' <
         and"
    | project 2 expr
        type INTEGER as _suppkey    J1_L_SUPPKEY ,
        type INTEGER as C_NATIONKEY C_NATIONKEY
    | hash 2 expr type INTEGER _suppkey
    | combined 0
    | next hashcast

//HC

  // ⋈ SUPPLIER /C_SUPPKEY/
  stage Gj_SUPPLIER on all partitions :
    indexJoin 2 Supplier IxS_SUPPKEY expr bound $I1 _suppkey ==
    | filter 2
        "C_NATIONKEY 6 == J1_S_NATIONKEY 7 == and
         C_NATIONKEY 7 == J1_S_NATIONKEY 6 == and or"
    | combined 0
    | next

  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

  stage G_AGG_P on all partitions :
    project 2 " type INTEGER as x_rowCntPtn )  countAll  "
    | combined 0
    | next
    
  stage G_AGG_N on all nodes :
    project 2 " type INTEGER as x_rowCntNode )  x_rowCntPtn sum  "
    | combined 0
    | next
    
  stage G_AGG_O on origin :
    project 2 " type INTEGER as x_rowCntOrigin )  x_rowCntNode sum  "
    | combined 0
    | next

  stage last on origin :
    output
    | sink
    | first

end ;



