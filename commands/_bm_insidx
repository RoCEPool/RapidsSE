/*============================================================================*/
/* _bm_insidx -- insert index entry benchmark                                 */
/*============================================================================*/

bc;

heapmem;

bp;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_1;
print "** 1/7) run __report setup";

__report

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_2;
print "** 2/7) create ALLCOLS_TABLE table";

trackMemory;

_allCols_Table

lscol ALLCOLS_TABLE;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_3;
print "** 3/7) create ALLCOLS_INDEX_int index on ALLCOLS_TABLE(int) column";

create index ALLCOLS_INDEX_int on ALLCOLS_TABLE(int);

lsidx ALLCOLS_TABLE;

lsidxcol ALLCOLS_TABLE ALLCOLS_INDEX_int;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_4;
print "** 4/7) execute bm_insidx pipeline";

//stepTiming start;

pipeline bm_insidx
begin
  stage stageA on origin:
    start | periodic once | stageB

  stage stageB on all partitions:
      BM_GenEntOp ALLCOLS_TABLE ALLCOLS_INDEX_int 10
    | burst
    | BM_InsIdxOp ALLCOLS_TABLE ALLCOLS_INDEX_int
    | stageC

  stage stageC on origin:
    report "/tmp/bm_insidx_rep.csv" | output | sink | stageA
end;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_5;
print "** 5/7) information";

//stepTiming write "/tmp/StepTiming.csv";

filecat "/tmp/bm_insidx_rep.csv" 100;

//stepTiming show "vIndexTreeInsEntBuffer";

sizeIndex ALLCOLS_TABLE ALLCOLS_INDEX_int ;

compactIndex ALLCOLS_TABLE ALLCOLS_INDEX_int ;

sizeIndex ALLCOLS_TABLE ALLCOLS_INDEX_int ;

visualizeIndex ALLCOLS_TABLE ALLCOLS_INDEX_int ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_6;
print "** 5/7) drop ALLCOLS_TABLE";

drop table ALLCOLS_TABLE;

memoryLeaks fatal;

heapmem;

bp;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __BM_INSIDX_7;
print "** 6/7) success _bm_insidx";

/*============================================================================*/
/* end                                                                        */
