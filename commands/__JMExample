print "Job Metrics";

//_lineitem;
//load lineitem "<tpch_dir>/lineitem.<suffix>";
__TPCH_SCHEMA;

metricsCtl enable;
///time /jobMetrics select l_returnflag, l_linestatus, sum(l_extendedPrice) from lineitem group by l_returnflag, l_linestatus;

/time /jobMetrics pipeline Query18
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
      indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
     | ordAgg " ordgroupBy  type INTEGER as L_ORDERKEY L_ORDERKEY aggregates type INTEGER as L_ORDERKEY $K1 , type DECIMAL as SUM_QTY )  L_QUANTITY sum  "
     | filter  " type BOOLEAN  SUM_QTY 300.00  >  "
     | combined 0
     | next broadcast

   stage S02 on all partitions :
     indexJoin orders IxO_ORDERKEY "bound $I1 $L1 =="
     | project "type INTEGER as O_CUSTKEY J1_O_CUSTKEY , type INTEGER as O_ORDERKEY J1_O_ORDERKEY , type DATE as O_ORDERDATE J1_O_ORDERDATE , type DECIMAL as O_TOTALPRICE J1_O_TOTALPRICE , type DECIMAL as SUM_QTY SUM_QTY "
     | combined 0
     | next

   stage S03 on all partitions :
     indexJoin customer IxC_CUSTKEY "bound $I1 $L1 =="
     | project "type VARCHAR as C_NAME J1_C_NAME , type INTEGER as C_CUSTKEY J1_C_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY , type DATE as O_ORDERDATE O_ORDERDATE , type DECIMAL as O_TOTALPRICE O_TOTALPRICE , type DECIMAL as SUM_QTY SUM_QTY "
     | combined 0
     | next

   stage S04 on all partitions :
     aggreg " groupBy  type VARCHAR as C_NAME C_NAME , type INTEGER as C_CUSTKEY C_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY , type DATE as O_ORDERDATE O_ORDERDATE , type DECIMAL as O_TOTALPRICE O_TOTALPRICE aggregates type VARCHAR as C_NAME $K1 , type INTEGER as C_CUSTKEY $K2 , type INTEGER as O_ORDERKEY $K3 , type DATE as O_ORDERDATE $K4 , type DECIMAL as O_TOTALPRICE $K5 , type DECIMAL as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S05 on all nodes :
     aggreg " groupBy  type VARCHAR as C_NAME C_NAME , type INTEGER as C_CUSTKEY C_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY , type DATE as O_ORDERDATE O_ORDERDATE , type DECIMAL as O_TOTALPRICE O_TOTALPRICE aggregates type VARCHAR as C_NAME $K1 , type INTEGER as C_CUSTKEY $K2 , type INTEGER as O_ORDERKEY $K3 , type DATE as O_ORDERDATE $K4 , type DECIMAL as O_TOTALPRICE $K5 , type DECIMAL as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S06 on origin :
     aggreg " groupBy  type VARCHAR as C_NAME C_NAME , type INTEGER as C_CUSTKEY C_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY , type DATE as O_ORDERDATE O_ORDERDATE , type DECIMAL as O_TOTALPRICE O_TOTALPRICE aggregates type VARCHAR as C_NAME $K1 , type INTEGER as C_CUSTKEY $K2 , type INTEGER as O_ORDERKEY $K3 , type DATE as O_ORDERDATE $K4 , type DECIMAL as O_TOTALPRICE $K5 , type DECIMAL as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S07 on origin :
     sort " type DECIMAL as O_TOTALPRICE O_TOTALPRICE DESC  , type DATE as O_ORDERDATE O_ORDERDATE ASC  "
     | limit 100
     | combined 0
     | next

   stage S08 on origin :
     output
     | sink
     | first
 end ;

metricsCtl disable;

sleep 15;

sysReport;
select * from se__jobMetrics;
select * from se__jobOperands;
select * from se__jobOperators;

select * from se__jobNetwork;
select * from se__jobNetDissect;

select * from se__sysMetrics;
select * from se__sysLocks;

select count(*) from se__jobMetrics;

select max(responseUS), avg(responseUS), max(responseUS) from se__jobOperators;
select max(newRowBuffers) from se__jobOperators;

export se__jobMetrics "../tmp/jobMetrics.csv";
