print "Job Metrics";

_lineitem;
load lineitem "<tpch_dir>/lineitem.<suffix>";

metricsCtl enable;
/time /jobMetrics select l_returnflag, l_linestatus, sum(l_extendedPrice) from lineitem group by l_returnflag, l_linestatus;
metricsCtl disable;

sleep 5;

sysReport;
select * from se__jobMetrics;
select * from se__jobOperands;
select * from se__jobOperators;

select * from se__jobNetwork;
select * from se__jobNetDissect;

select * from se__sysMetrics;
select * from se__sysLocks;

select count(*) from se__jobMetrics;

select max(responseUS), avg(responseUS), max(responseUS) from se__jobOperators;
select max(newRowBuffers) from se__jobOperators;

export se__jobMetrics "../tmp/jobMetrics.csv";
