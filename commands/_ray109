/optimise_passthru
/keepCodeFile
/optimise_passthru
pipeline Query9
  begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public part
    | filter "type BOOLEAN }  P_NAME '%green%' 5 matchMiddle"
    | project "type INTEGER as P_PARTKEY P_PARTKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "bound $I1 P_PARTKEY =="
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST"
    | hash "type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin supplier IxS_SUPPKEY "bound $I1 PS_SUPPKEY =="
    | project "type INTEGER as S_NATIONKEY S_NATIONKEY ,
               type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST"
    | combined 0
    | next broadcast

  stage S04 on all partitions :
    indexJoin LINEITEM IxL_PARTKEY "bound $I1 P_PARTKEY =="
    | filter "type BOOLEAN L_SUPPKEY PS_SUPPKEY =="
    | project "type INTEGER as L_ORDERKEY L_ORDERKEY ,
               type INTEGER as S_NATIONKEY S_NATIONKEY ,
               type INTEGER as L_SUPPKEY L_SUPPKEY ,
               type DECIMAL as AMOUNT L_EXTENDEDPRICE 1.0 L_DISCOUNT -  *  PS_SUPPLYCOST L_QUANTITY *  - "
    | combined 0
    | next broadcast

  stage S05 on all partitions :
    indexJoin ORDERS IxO_ORDERKEY "bound $I1 L_ORDERKEY =="
    | project "type INTEGER as S_NATIONKEY S_NATIONKEY ,
               type INTEGER as O_YEAR O_ORDERDATE extract_year ,
               type DECIMAL as AMOUNT AMOUNT"
    | combined 0
    | next
.
  stage S06 on all partitions :
    gbyAgg "groupBy    type INTEGER S_NATIONKEY ,
                       type INTEGER O_YEAR
            aggregates type INTEGER as S_NATIONKEY $K1 ,
                       type INTEGER as O_YEAR $K2 ,
                       type DECIMAL as SUM_PROFIT ) AMOUNT sum  "
    | combined 0
    | next

  stage S11 on origin :
    output
    | sink
    | first
  end ;

