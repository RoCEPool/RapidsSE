/*============================================================================*/

__TPCH_SCHEMA

/*
explain stage transliterate
       select l_returnflag, l_linestatus,
               sum(l_quantity) as sum_qty,
               sum(l_extendedprice) as sum_base_price,
               sum(l_extendedprice*(1-l_discount)) as sum_disc_price,
               sum(l_extendedprice*(1-l_discount)*(1+l_tax)) as sum_charge,
               avg(l_quantity) as avg_qty,
               avg(l_extendedprice) as avg_price,
               avg(l_discount) as avg_disc,
               count(*) as count_order
               from lineitem
               where l_shipdate <= DATE '1998-09-01'
               group by l_returnflag, l_linestatus
               order by l_returnflag, l_linestatus;

*/

pipeline scanFile

  begin

    stage S00 on origin :
        start
      | pulse once
      | checkTable lineitem
      | chunk      "<tpch_dir>/lineitem.<suffix>"   // read chunks of file => (seekOffset)
      | rdCsvChunk "<tpch_dir>/lineitem.<suffix>"   // (seekOffset) => (csvBuffer)
      | next localrobin

    stage S01 on all partitions on origin :
        toKeyHshRow_sf lineitem // (csvBuffer) => (rowBuffer w row+keyHash)
      //| toLglPtnRow lineitem // (rowBuffer) => (rowBuffer x logical partitions)
      //| toLglPtnNst          // (rowBuffer) => (rowBuffer w normalised strings)
      //| toLglPtnCrw          // (rowBuffer) => (crwBuffer x logical partitions)
       | next

    stage S02_a on all partitions :
       filter " type BOOLEAN  $11 DATE '1998-09-01'  <=  "
       | gbyAgg " groupBy  type VARCHAR ( 0 ) as l_returnflag $9 , type VARCHAR ( 0 ) as l_linestatus $10 aggregates  type VARCHAR ( 0 ) $K1 , type VARCHAR ( 0 ) $K2 , type DECIMAL )  $5 sum  , type DECIMAL )  $6 sum  , type DECIMAL )  $6 1.00  $7 -  *  sum  , type DECIMAL )  $6 1.00  $7 -  *  1.00  $8 +  *  sum  , type INTEGER )  $5 count  , type INTEGER )  $6 count  , type DECIMAL )  $7 sum  , type INTEGER )  $7 count  , type INTEGER )  countAll  "
       | combined 0
       | next

     stage S02 on all nodes :
       gbyAgg " groupBy  type VARCHAR ( 0 ) as l_returnflag $1 , type VARCHAR ( 0 ) as l_linestatus $2 aggregates  type VARCHAR ( 0 ) $K1 , type VARCHAR ( 0 ) $K2 , type DECIMAL )  $3 sum  , type DECIMAL )  $4 sum  , type DECIMAL )  $5 sum  , type DECIMAL )  $6 sum  , type INTEGER )  $7 sum  , type INTEGER )  $8 sum  , type DECIMAL )  $9 sum  , type INTEGER )  $10 sum  , type INTEGER )  $11 sum  "
       | combined 0
       | next

     stage S03 on origin :
       gbyAgg " groupBy  type VARCHAR ( 0 ) as l_returnflag $1 , type VARCHAR ( 0 ) as l_linestatus $2 aggregates  type VARCHAR ( 0 ) $K1 , type VARCHAR ( 0 ) $K2 , type DECIMAL as sum_qty )  $3 sum  , type DECIMAL as sum_base_price )  $4 sum  , type DECIMAL as sum_disc_price )  $5 sum  , type DECIMAL as sum_charge )  $6 sum  , type INTEGER as count_order )  $11 sum  , type INTEGER )  $7 sum  , type INTEGER )  $8 sum  , type INTEGER )  $10 sum  , type DECIMAL )  $9 sum  "
       | combined 0
       | next

     stage S04 on origin :
       project " type VARCHAR ( 0 ) as l_returnflag $1 , type VARCHAR ( 0 ) as l_linestatus $2 , type DECIMAL as sum_qty $3 , type DECIMAL as sum_base_price $4 , type DECIMAL as sum_disc_price $5 , type DECIMAL as sum_charge $6 , type DECIMAL as avg_qty $3 $8 casttype DECIMAL CAST  /  , type DECIMAL as avg_price $4 $9 casttype DECIMAL CAST  /  , type DECIMAL as avg_disc $11 $10 casttype DECIMAL CAST  /  , type INTEGER as count_order $7 "
       | sort " type VARCHAR ( 0 ) as l_returnflag $1 ASC  , type VARCHAR ( 0 ) as l_linestatus $2 ASC  "
       | combined 0
       | next

    stage S05 on origin :
      output
      | sink
      | first
 end ;
