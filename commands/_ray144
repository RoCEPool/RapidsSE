create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE1_COLA1 on table1(cola1);

Load TABLE1 "../DATA/Load/tbl1data.csv" ;


/optimiser_trace
/transliterated
/pipeline_def
/keepCodeFile
/weaved
select cola1, max(colf1)  from table1 where cola1 > 450 group by cola1 ;

