/*============================================================================*/
/* _ray140                                                                   */
/*============================================================================*/

// NOTE: colInj not correct in stage S01

__TPCH_SCHEMA;

/optimise_passthru
/pipeline_def
/weaved
/keepCodeFile
/pipelineName = "_ray141"
pipeline _ray141
begin

  stage S00 on origin :
     start
   | pulse     once
   | next

  stage S01 on all partitions :
     scan      Nation
   | project "type INTEGER N_NATIONKEY , type VARCHAR N_NAME , type INTEGER N_REGIONKEY"
   | hash "type INTEGER $3"
   | combined 0
   | next hashcast

  stage S02 on all partitions :
     indexJoin Region IxR_REGIONKEY " BOUND $I1 $3 == "
   | combined 0
   | next

  stage S04 on origin :
     output
   | sink
   | first

end ;