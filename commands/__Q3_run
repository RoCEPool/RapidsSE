/*============================================================================*/
/* __Q3_run                                                                   */
/*============================================================================*/

/******************************************************************************
Q03_0: select
         l_orderkey,
         sum(l_extendedprice * (1 - l_discount)) as Revenue,
         o_orderdate,
         o_shippriority

  from Customer, Orders, LineItem
  
 where     c_mktsegment = 'BUILDING'
       and c_custkey    = o_custkey
       and l_orderkey   = o_orderkey
       and o_orderdate  < '1995-03-15'
       and l_shipdate   > ‘1995-03-15'

 group by l_orderkey,   o_orderdate, o_shippriority

 order by Revenue desc, o_orderdate

 limit 10;
*******************************************************************************/


/time pipeline Q3
begin

  stage first on origin :
    start
    | pulse once
    | next
    
  //
  // Q3_0:
  //   a) scan Customer  /C_CUSTKEY/   # _custkey    _nationkey
  //   b) join Orders    /O_CUSTKEY/   # _custkey    _orderkey
  //   c) join LineItem  /L_ORDERKEY/  # _orderkey   _partkey   _suppkey
  //

  // ∀ CUSTOMER π C_CUSTKEY as _custkey
  stage Gs_CUSTOMER on all partitions :
    scan customer
    | project 1 "type INTEGER as _custkey C_CUSTKEY"
    | debug rowbuffer
    | next
    
  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
 
  stage G_CNT_P on all partitions :
    project 1 " type INTEGER as x_rowCntPtn )  countAll  "
    | G_CNT_N
    
  stage G_CNT_N on all nodes :
    project 1 " type INTEGER as x_rowCntNode )  x_rowCntPtn sum  "
    | G_CNT_O
    
  stage G_CNT_O on origin :
    project 1 " type INTEGER as x_rowCntOrigin )  x_rowCntNode sum  "
    | next

  stage last on origin :
    output
    | debug accum0
    | sink
    | first
  
end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
