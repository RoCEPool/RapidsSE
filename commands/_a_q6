/*============================================================================*/
/* _a_q6 -- Query6 (hand coded pipeline)                                      */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select
    sum(l_extendedprice*l_discount) as revenue
from
   lineitem
where
    l_shipdate >= '1994-01-01'
    and l_shipdate < '1995-01-01'
    and l_discount between .06 - 0.01 and .06 + 0.01
    and l_quantity < 24;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : LINEITEM
// JOIN ORDER : NONE
// INDEXES    : IxL_SHIPDATE

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * LITERAL ARITHMETIC UPFRONT
//   * SCAN CHANGED TO AN INDEXSCAN

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * /

// pipeline begin
pipeline Query6
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     indexscan lineitem IxL_SHIPDATE "LBOUND $I1 DATE '1994-01-01' >= UBOUND $I1 DATE '1995-01-01' <"
     | filter " type BOOLEAN  }  0.05 0.07 L_DISCOUNT between L_QUANTITY 24. < and"
     | project " type DECIMAL as REVENUE ) L_EXTENDEDPRICE L_DISCOUNT *  sum  "
     | combined 0
     | next

   stage S02 on all nodes :
     project " type DECIMAL as REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S03 on origin :
     project " type DECIMAL as REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S04 on origin :
     output
     | sink
     | first
end ;
// pipeline end

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
