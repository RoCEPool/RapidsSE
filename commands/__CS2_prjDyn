_nation
/time load nation   "<tpch_dir>/nation.<suffix>";

//explain stage transliterate select n_nationkey, n_name from nation where n_nationkey < 2;

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker0559
  stage stageMarker0559 on all partitions :
    scan rapidsse public Nation
    | filter " type BOOLEAN  $1 2  <  "
    | project " type INTEGER as n_nationkey $1 , type VARCHAR as n_name $2 "
    | dynamic
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end
