// Flattening the positioning in index calls (via function pointers)
//  (also now as function pointer)
// on iMac:
//  SF10-1N-1P : 2.48
//  SF10-1N-4P : 1.33s

/keepCodeFile
/optimise_passthru
/hasCodeFile
/useCodeFile = "unamed_NODE1_2"
pipeline unamed
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
    indexscan lineitem IxL_SHIPDATE "LBOUND $I1 DATE '1994-01-01' >=
                                     UBOUND $I1 DATE '1995-01-01' <"
    |  project   "type DECIMAL ( 15 2 ) as C0_L_QUANTITY $5
                 , type DECIMAL ( 15 2 ) as C0_L_EXTENDEDPRICE $6
                 , type DECIMAL ( 15 2 ) as C1_L_DISCOUNT $7
                 , type DATE as C2_L_SHIPDATE $11"
    | filter    " type BOOLEAN } 0.05 0.07 $3 between $1 24.00 < and "
    | aggreg    "   type DECIMAL ( 19 2 ) as C0_COL0 ) $2 $3 * sum "
    | dynamic
    | next

  stage S04 on all nodes :
    aggreg    "   type DECIMAL ( 19 2 ) as C0_COL0 ) $1 sum "
    | dynamic
    | next

  stage S05 on origin :
    aggreg    "   type DECIMAL ( 19 2 ) as C0_Revenue ) $1 sum "
    | dynamic
    | next

  stage S06 on origin :
      output
    | sink
    | first

end ;


