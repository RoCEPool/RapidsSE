/* __Q9_tst                                                                   */
/*============================================================================*/

//tag default <tpch_dir> = "/mnt/disk1" ;
tag default <tpch_dir> = "/Users/Shared/tpch/SF1" ;

//tag default <suffix> = "tbl";
tag default <suffix> = "csv";

_supplier
create index supplier_supp ON supplier(S_SUPPKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/time load supplier "<tpch_dir>/supplier.<suffix>";

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/time pipeline Q9_chk
begin

  stage stageStart on origin :
    start
    | pulse once
    | G_SUPPLIER
    
  stage G_SUPPLIER on all partitions :
    indexscan 1 supplier supplier_supp "bound $I1 167 =="
    //| debug rowBuffer
    | hash 1 "type INTEGER $1"
    //| debug rowBuffer
    | G_SUPPLIER2 hashCast

  stage G_SUPPLIER2 on all partitions :
    noop
    | debug rowBuffer
    | indexjoin 1 supplier supplier_supp "bound $I1 $L1 =="
    | G_CNT_P

  stage G_CNT_P on all partitions :
    project 1 " type INTEGER )  countAll  "
    | G_CNT_N
    
  stage G_CNT_N on all nodes :
    project 1 " type INTEGER )  $1 sum  "
    | G_CNT_O
    
  stage G_CNT_O on origin :
    project 1 " type INTEGER )  $1 sum  "
    | stageLast

  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;


