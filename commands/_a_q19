/*============================================================================*/
/* _a_q19 -- Query19 (hand coded pipeline)                                    */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select
  sum(l_extendedprice * (1 - l_discount) ) as revenue
from
  lineitem,
  part
where
  (  p_partkey = l_partkey
     and p_brand = 'Brand#12'
     and p_container in ( 'SM CASE', 'M BOX', 'SM PACK', 'SM PKG')
     and l_quantity >= 1 and l_quantity <= 1 + 10
     and p_size between 1 and 5
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' )
  or
  (  p_partkey = l_partkey
     and p_brand = 'Brand#23'
     and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')
     and l_quantity >= 10 and l_quantity <= 10 + 10
     and p_size between 1 and 10
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' )
  or
  ( p_partkey = l_partkey
     and p_brand = 'Brand#34'
     and p_container in ( 'LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')
     and l_quantity >= 20 and l_quantity <= 20 + 10
     and p_size between 1 and 15
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' );

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : LINEITEM, PART
// JOIN ORDER : PART->LINEITEM
// INDEXES    : IxL_PARTKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * PUSH-DOWN FILTERS OF PART TO REDUCE ROWS BEING SELECTED FROM PART
//   * APPLY FILTER AGAIN AFTER JOIN

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//   NONE


* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

// pipeline begin
pipeline Query19
begin
 stage S00 on origin :
   start
   | pulse once
   | next

 stage S01 on all partitions :
   scan rapidsse public part
   | filter " type BOOLEAN P_BRAND 'Brand#12'  ==
                } 'SM CASE'  'M BOX'  'SM PACK'  'SM PKG'  #4  P_CONTAINER in  and
                }  1  5  P_SIZE between  and
                P_BRAND 'Brand#23'  ==
                }  'MED BAG'  'MED BOX'  'MED PKG'  'MED PACK'  #4 P_CONTAINER in and
                }  1  10  P_SIZE between  and  or P_BRAND 'Brand#34'  ==
                }  'LG CASE'  'LG BOX'  'LG PACK'  'LG PKG'  #4  P_CONTAINER in  and
                }  1  15  P_SIZE between  and or  "
   | project " type INTEGER as P_PARTKEY P_PARTKEY ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type VARCHAR ( 0 ) as P_CONTAINER P_CONTAINER ,
               type INTEGER AS P_SIZE P_SIZE"
   | combined 0
   | next broadcast

 stage S02 on all partitions :
   indexJoin lineitem IxL_PARTKEY "BOUND $I1 p_partkey ==" //J1
   | project " type INTEGER as L_PARTKEY j1_l_partkey ,
               type DECIMAL as L_QUANTITY J1_L_QUANTITY ,
               type DECIMAL as L_DISCOUNT J1_L_DISCOUNT ,
               type DECIMAL as l_extendedprice j1_l_extendedprice  ,
               type VARCHAR ( 0 ) as L_SHIPMODE J1_L_SHIPMODE ,
               type VARCHAR ( 0 ) as L_SHIPINSTRUCT J1_L_SHIPINSTRUCT ,
               type INTEGER as P_SIZE P_SIZE ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type varchar ( 0 ) as P_CONTAINER P_CONTAINER"
   | filter " type BOOLEAN P_BRAND 'Brand#12'  ==
                }  'SM CASE'  'M BOX'  'SM PACK'  'SM PKG'  #4  P_CONTAINER in  and
                }  L_QUANTITY 1.0 >= L_QUANTITY 11.0 <= and and
                }  1  5  P_SIZE between  and
                }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and
                L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and
                P_BRAND 'Brand#23'  ==
                }  'MED BAG'  'MED BOX'  'MED PKG'  'MED PACK'  #4 P_CONTAINER in and
                }  L_QUANTITY 10.0 >= L_QUANTITY 20.0 <= and and
                }  1  10  P_SIZE between  and
                }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and  or
                P_BRAND 'Brand#34'  ==
                }  'LG CASE'  'LG BOX'  'LG PACK'  'LG PKG'  #4  P_CONTAINER in  and
                }  L_QUANTITY 20.0 >= L_QUANTITY 30.0 <= and and }  1  15  P_SIZE between  and
                }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and
                L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and  or  "
   | combined 0
   | next

stage S03 on all partitions :
   project " type DECIMAL )  L_EXTENDEDPRICE 1.00  L_DISCOUNT - * sum  "
   | combined 0
   | next

 stage S04 on all nodes :
   project " type DECIMAL )  $1 sum  "
   | combined 0
   | next

 stage S05 on origin :
   project " type DECIMAL as revenue )  $1 sum  "
   | combined 0
   | next

 stage S06 on origin :
   output
   | sink
   | first
end ;
// pipeline end

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
