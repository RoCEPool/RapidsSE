/*============================================================================*/
/* _ray133                                                                    */
/*============================================================================*/

// NOTE : S07 streamDef_emitted should include all columns of the stream_arriving.
//        It does not include any columns of streamDef_arriving.
//        S08 on the other hand does.
//        There is no difference between the two stages.

/*
  stage S07 on all partitions :
  //  indexJoin Orders IxO_ORDERKEY " BOUND $I1 $1 == "
  //| hash      "type INTEGER $1"
      dynamic
    | next      hashcast

  stage S08 on all partitions :
  //  indexJoin Lineitem IxL_ORDERKEY " BOUND $I1 $1 == "
      dynamic
    | next
*/



__TPCH_SCHEMA

/optimiser_trace
/pipeline_def
/weaved
/transliterated
/pipelineName = "_ray133"
select
  c_name,
  c_custkey,
  o_orderkey,
  o_orderdate,
  o_totalprice,
  sum(l_quantity)
from
  orders,
  customer,
  lineitem
where
  o_orderkey in
    (
    select
      l_orderkey
    from
      lineitem
    group by
      l_orderkey
    having
      sum(l_quantity) > 100
    )
  and c_custkey = o_custkey
  and o_orderkey = l_orderkey
group by
  c_name,
  c_custkey,
  o_orderkey,
  o_orderdate,
  o_totalprice
order by
  o_totalprice desc,
  o_orderdate;

_tpchDrop

