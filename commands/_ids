logNote "Running script: _ids";

print "";
print "---------------------------------------------------------------------";
print "starting cluster...";
print "---------------------------------------------------------------------";
bc;

print "";
print "---------------------------------------------------------------------";
print "creating sensorEvents table...";
print "---------------------------------------------------------------------";
_sensorEvents;

print "";
print "---------------------------------------------------------------------";
print "removing pipes...";
print "---------------------------------------------------------------------";
rmfifo "/tmp/sensorEvents.rowAgg";
rmfifo "/tmp/sensorEvents.pipe";

print "";
print "---------------------------------------------------------------------";
print "making pipes...";
print "---------------------------------------------------------------------";
mkfifo "/tmp/sensorEvents.rowAgg";
mkfifo "/tmp/sensorEvents.pipe";

print "";
print "---------------------------------------------------------------------";
print "ingesting sensorEvents table...";
print "---------------------------------------------------------------------";

// /nowait monitor 10;

/nowait purge sensorEvents 30;

/nowait publish sensorEvents "/tmp/sensorEvents.rowAgg" ;

/nowait report sensorEvents "/tmp/sensorEvents.rowAgg" ;

/nowait repeater "/rapids/sensorEvents.csv" "/tmp/sensorEvents.pipe" ;

/nowait ingest sensorEvents "/tmp/sensorEvents.pipe" stats ;

