__TPCH_SCHEMA

// NOTE: Expr in TOP at stage S05 has $b.7

/weaved
/optimiser_trace
/pipeline_def
/pipelineName = "_ray157"
/optimise_passthru
pipeline Q3
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Orders
    | next

  stage S02 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY "BOUND $I1 $1 =="
    | filter "type BOOLEAN L_SHIPDATE TIMESTAMP '1995-03-15 00:00:00' >"

    | gbyAgg expr groupby type INTEGER O_ORDERKEY
       aggregates type INTEGER as _orderkey $K1 , type DECIMAL as Revenue ) L_DISCOUNT sum
    | combined 0
    | next

stage S03 on all nodes :
    top "type DECIMAL Revenue" 10
    | combined 0
    | next

stage S04 on origin :
    top "type DECIMAL Revenue" 10
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first

end ;

