create table T1 (
   a       INTEGER,
   b       INTEGER,
   c       INTEGER,
   d       VARCHAR(15)
) partition by (c);

load T1 "../DATA/Joins/T1.csv" ;

//select * from T1;

create table T2 (
   a       INTEGER,
   b       INTEGER,
   c       INTEGER,
   d       VARCHAR(15)
) partition by (a);

load T2 "../DATA/Joins/T2.csv" ;

//select * from T2;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "scanT1 ----------------------------------------------------------------";
pipeline scanT1
begin
  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_T1 on all partitions :
    scan T1
    | project 1 "type INTEGER $1 , type INTEGER $2 , type INTEGER $3 , type VARCHAR $4  "
    | debug seeRowbuffer
    | next

  stage last on origin :
    //output
    sink
    | first
end ;

print "scanT2-----------------------------------------------------------------";
pipeline scanT2
begin
  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_T2 on all partitions :
    scan T2
    | project 1 "type INTEGER $1 , type INTEGER $2 , type INTEGER $3 , type VARCHAR $4  "
    | debug seeRowbuffer
    | next

  stage last on origin :
    //output
    sink
    | first
end ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

print "loopJoinPart+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++";
pipeline loopJoinPart
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | hash 0 "type INTEGER $1"
    | debug seeRowBuffer
    | stageC hashcast

  stage stageC on all partitions :
    scanRight T2
    | debug seeRowBuffer
    | loopJoin 0 "$L1 $R1 =="
    | stageD

  stage stageD on origin :
    output
    //| debug accum0
    | sink
    | stageA

end ;

