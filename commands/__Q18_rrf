/*============================================================================*/
/* __Q18_run                                                                  */
/*============================================================================*/

/keepCodeFile
/optimise_passthru
pipeline Query18
begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
      //indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
      scan lineitem
     | gbyAgg " groupBy  type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY aggregates  type INTEGER ( 19 ) as L_ORDERKEY $K1 , type DECIMAL ( 19  2 ) as SUM_QTY )  L_QUANTITY sum  "
     | combined 0
     | next

  stage S02 on origin :
     filter  " type BOOLEAN  SUM_QTY 300.00  >  "
     | globalHash ORDERS GxO_ORDERKEY "type INTEGER ( 19 ) L_ORDERKEY"
     | combined 0
     | next hashcast

   stage S03 on all partitions multiple threads 4:
     indexJoin orders IxO_ORDERKEY "bound $I1 $1 =="
     | project "type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
                type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type DATE as O_ORDERDATE O_ORDERDATE ,
                type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE ,
                type DECIMAL ( 19  2 ) as SUM_QTY SUM_QTY "
     | indexJoin customer IxC_CUSTKEY "bound $I1 $1 =="
     | project "type VARCHAR ( 0 ) as C_NAME C_NAME ,
                type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type DATE as O_ORDERDATE O_ORDERDATE ,
                type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE ,
                type DECIMAL ( 19  2 ) as SUM_QTY SUM_QTY "
     | combined 0
     | next

   stage S05 on all partitions :
     gbyAgg " GroupBy type VARCHAR ( 0 ) as C_NAME C_NAME ,
                      type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                      type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                      type DATE as O_ORDERDATE O_ORDERDATE ,
                      type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE
                      aggregates
                      type VARCHAR ( 0 ) as C_NAME $K1 ,
                      type INTEGER ( 19 ) as C_CUSTKEY $K2 ,
                      type INTEGER ( 19 ) as O_ORDERKEY $K3 ,
                      type DATE as O_ORDERDATE $K4 ,
                      type DECIMAL ( 19  2 ) as O_TOTALPRICE $K5 ,
                      type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S06 on all nodes :
     gbyAgg " GroupBy  type VARCHAR ( 0 ) as C_NAME C_NAME ,
                       type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                       type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                       type DATE as O_ORDERDATE O_ORDERDATE ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE
                       aggregates
                       type VARCHAR ( 0 ) as C_NAME $K1 ,
                       type INTEGER ( 19 ) as C_CUSTKEY $K2 ,
                       type INTEGER ( 19 ) as O_ORDERKEY $K3 ,
                       type DATE as O_ORDERDATE $K4 ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE $K5 ,
                       type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S07 on origin :
     gbyAgg " GroupBy  type VARCHAR ( 0 ) as C_NAME C_NAME ,
                       type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                       type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                       type DATE as O_ORDERDATE O_ORDERDATE ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE
                       aggregates
                       type VARCHAR ( 0 ) as C_NAME $K1 ,
                       type INTEGER ( 19 ) as C_CUSTKEY $K2 ,
                       type INTEGER ( 19 ) as O_ORDERKEY $K3 ,
                       type DATE as O_ORDERDATE $K4 ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE $K5 ,
                       type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S08 on origin :
     sort " type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE DESC  , type DATE as O_ORDERDATE O_ORDERDATE ASC  "
     | limit 100
     | combined 0
     | next

   stage S10 on origin :
     output
     | sink
     | first
 end ;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
