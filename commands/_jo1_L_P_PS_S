/* _jo1_L_P_PS_S -- join order test                                           */
/*============================================================================*/

/joWrite
/filterPred
/glean_interactive
/transliterated
/weaved
/pipelineName = "_jo1_L_P_PS_S"
select
       count(*)
  from
       Part,
       Lineitem,
       PartSupp,
       Supplier
 where
       P_PARTKEY  = L_PARTKEY

   and L_SUPPKEY  = PS_SUPPKEY
   and PS_SUPPKEY = S_SUPPKEY;
;

