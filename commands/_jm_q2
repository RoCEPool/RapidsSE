// truncate metrics tables
truncate se__jobMetrics;
truncate se__jobOperands;
truncate se__jobOperators;

truncate se__jobNetwork;
truncate se__jobNetDissect;

truncate se__sysMetrics;
truncate se__sysLocks;

// enable metrics
metricsCtl enable;

///////////////////////
// QUERY 2

/jobMetrics
select
  s_acctbal,
  s_name,
  n_name,
  p_partkey,
  p_mfgr,
  s_address,
  s_phone,
  s_comment
from
  part,
  supplier,
  partsupp,
  nation,
  region
where
  p_partkey = ps_partkey
  and s_suppkey = ps_suppkey
  and p_size = 15
  and p_type like '%BRASS'
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'EUROPE'
  and ps_supplycost =
  (
    select
      min(ps_supplycost)
    from
      partsupp,
      supplier,
      nation,
      region
    where
      p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE' )
order by
  s_acctbal desc,
  n_name,
  s_name,
  p_partkey
limit 100;

///////////////////////


// disable metrics
metricsCtl disable;

// sleep
sleep 5;

// generate system report data
sysReport;

print "-------------------------------------------";
print "NETWORK FOR QUERY 2 .......................";

// get network data
select thisNodeName as thisNode,
     otherNodeName as otherNode,
     sum(sendCount)  as sCount,
     sum(sendBytes)  as sBytes,
     sum(recvCount)  as rCount,
     sum(recvBytes)  as rBytes
  from se__jobNetwork group by thisNodeName, otherNodeName;

print "-------------------------------------------";

