__TPCH_SCHEMA

trackMemory;

/pipeline_def
/weaved
/optimise_passthru
/keepCodeFile
/PipelineName = "ORDAGG"
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    indexScan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | ordAgg " ORDGROUPBY type integer $1
               aggregates type integer $K1 , type decimal as total )  $5 sum  "
    | combined 0
    | next
/*

  stage stageB on all partitions :
    filter " type BOOLEAN  $2 180.0  >  "
    | combined 0
    | next
*/
  stage stageLast on origin :
    output
    | sink
    | first
  end ;

MemoryLeaks;

