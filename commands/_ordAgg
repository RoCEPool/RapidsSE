pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    indexScan lineitem IxL_ORDERKEY "lbound $I1 2 >="
    //| ordAgg " ORDGROUPBY type integer $1
    //           aggregates type integer $K1 , type decimal as total )  $5 sum  "
    | filter "type boolean $1 3 !="
    | gbyAgg " groupby type integer $1
               aggregates type integer $K1 , type decimal as total )  $5 sum  "
    //| aggreg "type decimal as total )  $5 sum"
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
  end ;


