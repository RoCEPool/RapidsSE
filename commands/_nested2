/*============================================================================*/
/* _nested2 - nested pipeline test                                            */
/*============================================================================*/


create table nation (
   N_NATIONKEY       INTEGER NOT NULL,
   N_NAME            CHAR(25) NOT NULL,
   N_REGIONKEY       INTEGER NOT NULL,
   N_COMMENT         VARCHAR(152)
);

print "loading nation.csv..." ;
load nation "../TPCH/SF1/nation.tbl" ;

tablescan nation;



pipeline nestTest
begin

  pipeline nested
  begin

    stage stageA on origin :
      start | pulse once | eachRow | stageB

    stage stageB on origin :
      eachScan Right | filter | eachJoin | stageC

    stage stageC on origin :
      output stageC | sink | stageA

  end

  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan nation | stageC

  stage stageC on origin :
    output | sink | stageA

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -


end ;

