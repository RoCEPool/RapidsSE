_nation;
CREATE INDEX IxN_NATIONKEY ON nation(N_NATIONKEY);
load nation "../TPCH/SF_0001/nation.csv";

/*
/weaved
/pipeline_def
select n_nationkey, max(n_regionkey) from nation where n_nationkey > 3 group by n_nationkey;
*/

/optimiser_trace
/optimise_passthru
/pipeline_def
/keepCodeFile
/pipelineName = "_alka1"
/weaved
pipeline _unnamed_
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
    indexScan Nation IxN_NATIONKEY
              " LBOUND $I1 3 > "
    | project "type INTEGER $1 , type INTEGER $3"
    | combined 0
    | next

  stage S02 on all partitions :
    ordAgg    " OrdGroupBy
                  type INTEGER as C0_n_nationkey $1
                aggregates
                  type INTEGER as C0_COL1 $K1
                , type INTEGER as C1_COL2 ) $2 max "
    | combined 0
    | next

  stage S03 on all nodes :
    gbyAgg    " groupBy
                  type INTEGER as C0_n_nationkey $1
                aggregates
                  type INTEGER as C0_COL1 $K1
                , type INTEGER as C1_COL2 ) $2 max "
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg    " groupBy
                  type INTEGER as C0_n_nationkey $1
                aggregates
                  type INTEGER as C0_COL1 $K1
                , type INTEGER as C1_COL2 ) $2 max "
    | combined 0
    | next

  stage S05 on origin :
      output
    | sink
    | first

end ;


drop table nation;

