create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE1_PCOL1 on table1(pcol1);

create index TABLE1_COLA1 on table1(cola1);

create index TABLE1_COLB1 on table1(colb1);

create index TABLE1_UCOL on table1(ucol);

create index TABLE1_UCOLVC on table1(ucolvc);

select colc1, extract(year from colc1) from table1 where ucol / 5 between 50 and 100;

Load TABLE1 "../DATA/Load/tbl1data.csv" ;

/keepCodeFile
/weaved
/pipeline_def
select colb1, colc1, extract(day from colc1) from table1 where
  colb1 in ('pink','green','indigo','violet','yellow') order by extract(day from colc1);
