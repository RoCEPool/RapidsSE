// NOTE:
// stage S05 : Cols emitted != Cols_sort

create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE1_PCOL1 on table1(pcol1);
create index TABLE1_COLA1 on table1(cola1);
create index TABLE1_COLB1 on table1(colb1);
create index TABLE1_UCOL on table1(ucol);
create index TABLE1_UCOLVC on table1(ucolvc);

Load TABLE1 "../DATA/Load/tbl1data.csv" ;

create table TABLE9 (
  pcol9   INTEGER NOT NULL,
  scol9   INTEGER NOT NULL,
  tcol9   INTEGER NOT NULL,
  colb9   VARCHAR(20),
  cold9   FLOAT,
  cole9   DECIMAL,
  colf9   INTEGER,
  colg9   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index table9_colb9 on table9(colb9);
create index table9_ucol on table9(ucol);
create index table9_ucolvc on table9(ucolvc);
create index table9_pcol9 on table9(pcol9);

Load TABLE9 "../DATA/Load/tbl9data.csv" ;

/optimiser_trace
/weaved
/pipeline_def
/pipelineName = "_ray181"
select pcol1, pcol9, colb1, colb9 from table1
  join table9 on colb1 = colb9 where pcol1=pcol9 and (colb1='green' or colb1='blue') order by pcol1;

//ordered rows:
//  (3, 3, 'green', 'green')

drop table TABLE9;