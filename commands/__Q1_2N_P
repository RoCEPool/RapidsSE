  stage S01 on all partitions : 
      scan      lineitem
  | filter    " type BOOLEAN $11 casttype TIMESTAMP CAST DATE '1998-12-01' INTERVAL_DT 1990656000000007 - <= "
    | dynamic
    | next      

  stage S02 on all partitions : 
    project   "   type VARCHAR ( 1 ) as C0_L_RETURNFLAG $9
                , type VARCHAR ( 1 ) as C1_L_LINESTATUS $10
                , type DECIMAL ( 15 2 ) as C2_L_QUANTITY $5
                , type DECIMAL ( 15 2 ) as C3_L_EXTENDEDPRICE $6
                , type DECIMAL ( 15 2 ) as C4_L_DISCOUNT $7
                , type DECIMAL ( 15 2 ) as C5_L_TAX $8 "
