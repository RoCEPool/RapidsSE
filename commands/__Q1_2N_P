                , type INTEGER ( 19 ) as C9_COL9 ) $5 count
                , type INTEGER ( 19 ) as C10_COL10 ) countAll "
  |  dynamic
    | next      

  stage S04 on all nodes : 
    gbyAgg    " groupBy
                  type VARCHAR $1
                , type VARCHAR $2
                aggregates
                  type VARCHAR as C0_COL0 $K1
                , type VARCHAR as C1_COL1 $K2
                , type DECIMAL ( 19 2 ) as C2_COL2 ) $3 sum
                , type DECIMAL ( 19 2 ) as C3_COL3 ) $4 sum
                , type DECIMAL ( 19 2 ) as C4_COL4 ) $5 sum
                , type DECIMAL ( 19 2 ) as C5_COL5 ) $6 sum
                , type INTEGER ( 19 ) as C6_COL6 ) $7 sum
                , type INTEGER ( 19 ) as C7_COL7 ) $8 sum
                , type DECIMAL ( 19 2 ) as C8_COL8 ) $9 sum
                , type INTEGER ( 19 ) as C9_COL9 ) $10 sum
                , type INTEGER ( 19 ) as C10_COL10 ) $11 sum "
  |  dynamic
    | next      

  stage S05 on origin : 
    gbyAgg    " groupBy
                  type VARCHAR $1
                , type VARCHAR $2
                aggregates
                  type VARCHAR as C0_COL0 $K1
                , type VARCHAR as C1_COL1 $K2
                , type DECIMAL ( 19 2 ) as C2_sum_qty ) $3 sum
                , type DECIMAL ( 19 2 ) as C3_sum_base_price ) $4 sum
                , type DECIMAL ( 19 2 ) as C4_sum_disc_price ) $5 sum
                , type DECIMAL ( 19 2 ) as C5_sum_charge ) $6 sum
                , type INTEGER ( 19 ) as C6_count_order ) $11 sum
                , type INTEGER ( 19 ) as C7_COL7 ) $7 sum
                , type INTEGER ( 19 ) as C8_COL8 ) $8 sum
                , type INTEGER ( 19 ) as C9_COL9 ) $10 sum
                , type DECIMAL ( 19 2 ) as C10_COL10 ) $9 sum "
  |  dynamic
    | next      

  stage S06 on origin : 
    project   "   type VARCHAR as C0_l_returnflag $1
                , type VARCHAR as C1_l_linestatus $2
                , type DECIMAL ( 19 2 ) as C2_sum_qty $3
                , type DECIMAL ( 19 2 ) as C3_sum_base_price $4
                , type DECIMAL ( 19 2 ) as C4_sum_disc_price $5
                , type DECIMAL ( 19 2 ) as C5_sum_charge $6

