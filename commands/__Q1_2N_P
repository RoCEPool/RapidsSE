                , type DECIMAL ( 19 2 ) as C6_avg_qty $3 $8 casttype DECIMAL ( 19 2 ) CAST /
                , type DECIMAL ( 19 2 ) as C7_avg_price $4 $9 casttype DECIMAL ( 19 2 ) CAST /
                , type DECIMAL ( 19 2 ) as C8_avg_disc $11 $10 casttype DECIMAL ( 19 2 ) CAST /
                , type INTEGER ( 19 ) as C9_count_order $7 "
  |  dynamic
    | next      

  stage S07 on origin :
      output
    | sink
