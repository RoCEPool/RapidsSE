// --initial _r_Q20_1ab

_r_schema

create index P_idx0  on Part     (P_PARTKEY);
create index PS_idx0 on PartSupp (PS_PARTKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// explain stage aggregateSplit

/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_Q20_1ab"
select ps_suppkey // board[0]
  from PartSupp
 where
       ps_partkey in ( /* Q20_1_1 -- 52_W_L_NC_I board[2] */
                       select p_partkey
                         from Part
                        where p_name like 'forest%'
                      )
   and
       ps_availqty > ( /* Q20_1_2 -- 24_W_A_C_ro board[1] */
                       select 0.5 * sum(l_quantity)
                         from LineItem
                        where L_PARTKEY = PS_PARTKEY /* outerColNm */
                        //and L_SUPPKEY = PS_SUPPKEY
                          and l_shipdate >= '1994-01-01'
                          and l_shipdate < '1995-01-01'
                      )
;

