//tag default <tpch_dir> = "/mnt/disk1" ;
tag default <tpch_dir> = "/Users/Shared/tpch/SF10" ;

//tag default <suffix> = "tbl";
tag default <suffix> = "csv";

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

_part

_partsupp
create index partsupp_part ON partsupp(PS_PARTKEY);

_supplier
create index supplier_supp ON supplier(S_SUPPKEY);

_lineitem
create index lineitem_part ON lineitem(L_PARTKEY);
create index lineitem_supp ON lineitem(L_SUPPKEY);

_orders
create index orders_order  ON orders(O_ORDERKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/time load part     "<tpch_dir>/part.<suffix>";
/time load partsupp "<tpch_dir>/partsupp.<suffix>";
/time load supplier "<tpch_dir>/supplier.<suffix>";
/time load lineitem "<tpch_dir>/lineitem.<suffix>";
/time load orders   "<tpch_dir>/orders.<suffix>";

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

explain stage transliterate
select count(*)
  from part
 where p_partkey < 12000
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/time pipeline Q9
begin

  stage stageStart on origin :
    start
    | pulse once
    | G_PART

  stage G_PART on all partitions :
    scan rapidsse public part
    | filter  1 " type BOOLEAN  P_PARTKEY 120000  <  "
    | project 1 " type INTEGER as p_partkey P_PARTKEY "
    | G_PARTSUPP

  stage G_PARTSUPP on all partitions :
    indexJoin 1 partsupp partsupp_part "bound $I1 P_PARTKEY =="
    | project 1 " type INTEGER as p_partkey P_PARTKEY , type INTEGER as ps_suppkey $3"
    //| hash 1 "type INTEGER $2"
    //| G_SUPPLIER hashCast
    | G_LINEITEM broadCast
/*
  stage G_SUPPLIER on all partitions :
    indexJoin 1 supplier supplier_supp "bound $I1 ps_suppkey =="
    | project 1 " type INTEGER as p_partkey P_PARTKEY , type INTEGER as ps_suppkey PS_SUPPKEY"
    | G_LINEITEM broadCast
*/
  stage G_LINEITEM on all partitions :
    indexJoin 1 lineitem lineitem_part "bound $I1 p_partkey =="
    | filter 1 "type BOOLEAN $5 $2  =="
    | project 1 " type INTEGER as l_orderkey $3 , type INTEGER as l_partkey $1 , type INTEGER as l_suppkey $2"
    | hash 1 "type INTEGER $1"
    | G_ORDERS hashCast

  stage G_ORDERS on all partitions :
    indexJoin 1 orders orders_order "bound $I1 l_orderkey =="
    | project 1 " type TIMESTAMP as l_orderdate $8"
    | debug rowbuffer
    | G_CNT_P

  stage G_CNT_P on all partitions :
    project 1 " type INTEGER )  countAll  "
    | G_CNT_N
    
  stage G_CNT_N on all nodes :
    project 1 " type INTEGER )  $1 sum  "
    | G_CNT_O
    
  stage G_CNT_O on origin :
    project 1 " type INTEGER )  $1 sum  "
    | stageLast

  stage stageLast on origin :
    output
    | debug accum0
    | sink
    | stageStart
end ;


