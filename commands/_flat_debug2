tag default <tpch_dir> = "../tpch/sf_0001";

tag default <suffix> = "csv";

__TPCH_SCHEMA

/glean_cue_from = "vH60_T10_Produce_maybeIndexJoin_Under_filter"
/glean_cue_trace = "x"
/optimiser_trace
/transliterated
/weaved
  select l_orderkey, sum(l_quantity), sum(l_extendedPrice)
    from lineitem
    group by l_orderkey
    having sum(l_quantity) < (select avg(l_quantity)
                                from lineitem)
      and sum(l_extendedPrice) > 23000.0
  ;

