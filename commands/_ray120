// NOTE: HASHCAST with top

__TPCH_SCHEMA_LOAD_SF0001

/optimiser_trace
/weaved
/pipeline_def
/optimise_passthru
pipeline Query120
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Orders
    | top "type INTEGER O_ORDERKEY " 20
    | hash expr type INTEGER O_CUSTKEY
    | combined 0
    | next hashcast

  stage S08 on origin :
    output
    | sink
    | first
end ;

