_nation
create index IxN_NATIONKEY on nation (n_nationkey);
/time load nation   "<tpch_dir>/nation.<suffix>";

///weaved select n_nationkey from nation where n_nationkey < 2;

/ccode pipeline _unnamed_
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
    indexScan_v2 Nation IxN_NATIONKEY "UBOUND $I1 2 < "
    | project_v2   "type INTEGER as N_NATIONKEY $1 , type VARCHAR as N_NAME $2 , type INTEGER as N_REGIONKEY $3 , type VARCHAR as N_COMMENT $4 "
    | dynamic_v2  0
    | next

  stage S02 on origin :
      output
    | sink
    | first

end ;