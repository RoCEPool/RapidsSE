/*============================================================================*/
/* _a_q3 -- Query3 (hand coded pipeline)                                      */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select l_orderkey,
      sum(l_extendedprice*(1-l_discount)) as revenue,
      o_orderdate,
      o_shippriority
from  customer,
      orders,
      lineitem
where c_mktsegment = 'BUILDING'
      and c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and o_orderdate < '1995-03-15'
      and l_shipdate > '1995-03-15'
group by
     l_orderkey,
     o_orderdate,
     o_shippriority
order by
     revenue desc,
     o_orderdate
limit 10;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : CUSTOMER, ORDERS, LINEITEM
// JOIN ORDER : CUSTOMER->ORDERS->LINEITEM
// INDEXES    : IxO_CUSTKEY
//              IxL_ORDERKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * GROUP BY ONLY ON L_ORDERKEY AS THIS KEY IS UNIQUE.
//   * ADDED A SORT ON O_ORDERKEY IN STAGE S03 AND MODIFIED AGGREG TO ORDAGG
//     REMOVING ALL SUBSEQUENT NODE AND ORIGIN LEVEL AGGREGATES
//   * ADDED STAGE WITH SORT AND LIMIT ON ALL PARTITIONS AND ON ALL NODES.
//     THIS REDUCES THE DATA BEING SORTED AS WE MOVE ALONG

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//   CAN EXPLORE DIFFERENT JOIN ORDERS.

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

// pipeline begin
pipeline Query3
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Customer
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project "type INTEGER as C_CUSTKEY C_CUSTKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
    | filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-03-15' <"
    | project "type INTEGER as O_ORDERKEY J1_O_ORDERKEY ,
               type DATE as O_ORDERDATE J1_O_ORDERDATE ,
               type INTEGER as O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash "type INTEGER O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    sort "type INTEGER O_ORDERKEY ASC"
    | combined 0
    | next

  stage S04 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | filter "type BOOLEAN J1_L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg " ordGroupBy type INTEGER J1_L_ORDERKEY
               aggregates type INTEGER as L_ORDERKEY $K1 ,
                          type DECIMAL as REVENUE ) J1_L_EXTENDEDPRICE 1. J1_L_DISCOUNT -  *  sum  ,
                          type DATE as O_ORDERDATE  O_ORDERDATE ,
                          type INTEGER as O_SHIPPRIORITY O_SHIPPRIORITY "
    | combined 0
    | next

  stage S05 on all partitions :
    sort " type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S06 on all nodes :
    sort " type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S07 on origin :
    sort " type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S08 on origin :
    output
    | sink
    | first
end ;
// pipeline end

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
