__TPCH_SCHEMA;

// NOTE: Stage S03 ordAgg streamDef_emitted has no columns

/pipeline_def
/optimise_passthru
/pipelineName = "_ray172"
pipeline Q3
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    indexScan Customer IxC_CUSTKEY "LBOUND $I1 0 >="
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project expr type INTEGER as _custkey C_CUSTKEY
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin Orders IxO_CUSTKEY "BOUND $I1 _custkey =="
    | filter "type BOOLEAN O_ORDERDATE DATE '1995-03-15' <"
    | project "type INTEGER as _orderkey O_ORDERKEY ,
         type DATE as O_ORDERDATE O_ORDERDATE ,
         type INTEGER as O_SHIPPRIORITY O_SHIPPRIORITY"
    | hash expr type INTEGER _orderkey
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY "BOUND $I1 _orderkey =="
    | filter "type BOOLEAN L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg expr ordgroupby type INTEGER _orderkey
        aggregates type INTEGER as _orderkey $K1 ,
        type DECIMAL as Revenue ) L_EXTENDEDPRICE 1.0 L_DISCOUNT - * sum ,
        type DATE as O_ORDERDATE O_ORDERDATE ,
        type INTEGER as O_SHIPPRIORITY  O_SHIPPRIORITY
    | combined 0
    | next

  stage XYZ on origin :
    top "type DECIMAL Revenue" 10
    | combined 0
    | next


  stage S04 on origin :
    output
    | sink
    | first

end ;

//rows: 10

_tpchDrop;