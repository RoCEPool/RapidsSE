/*============================================================================*/
/* TPCH queries - SF10                                                        */
/*============================================================================*/

/*

ORIGINAL QUERY18

select
  c_name,
  c_custkey,
  o_orderkey,
  o_orderdate,
  o_totalprice,
  sum(l_quantity)
from
  customer,
  orders,
  lineitem
where
  o_orderkey in
    (
    select
      l_orderkey
    from
      lineitem
    group by
      l_orderkey
    having
      sum(l_quantity) > 300
    )
  and c_custkey = o_custkey
  and o_orderkey = l_orderkey
group by
  c_name,
  c_custkey,
  o_orderkey,
  o_orderdate,
  o_totalprice
order by
  o_totalprice desc,
  o_orderdate
limit 100;

*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// lineitem
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
_lineitem
//create index lineitem_ship on lineitem (L_SHIPDATE);
create index lineitem_ord ON lineitem(L_ORDERKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// orders
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
_orders
create index orders_cust ON orders(O_CUSTKEY);
create index orders_ord ON orders(O_ORDERKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// customer
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
_customer
create index customer_cust ON customer(C_CUSTKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// load the tables SF_0001
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/*
/time load lineitem "../TPCH/SF_0001/lineitem.csv";
/time load orders "../TPCH/SF_0001/orders.csv";
/time load customer "../TPCH/SF_0001/customer.csv";
*/

//tag default <tpch_dir> = "/mnt/disk1/sf1" ;
//tag default <tpch_dir> = "../TPCH/SF10" ;

/time load orders   "/mnt/disk1/sf1/orders.tbl";
/time load customer "/mnt/disk1/sf1/customer.tbl";
/time load lineitem "/mnt/disk1/sf1/lineitem.tbl";


./rapidsse --name NODE1 --node NODE1 127.0.0.1 5442 --prompt --start --size 200GB --partitionsPerNode 16 --heartbeat BROADCAST 8888 --munged

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// execute Q18
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/time pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | Q18_0_a
  stage Q18_0_a on all partitions :
    indexscan 2 lineitem lineitem_ord "lbound $I1 0 >="
    | ordAgg 2 " type integer $1 , type decimal )  $5 sum  groupBy  type integer $1 "
    | filter 2 " type BOOLEAN  $2 30000  >  "
    | combined 0
    | stageQ18_1_b broadcast
  stage stageQ18_1_b on all partitions :
    indexJoin 2 orders orders_ord "bound $I1 $L1 =="
    | combined 0
    | stageQ18_1_c broadcast
  stage stageQ18_1_c on all partitions :
    project 1 "type integer as CUSTKEY $4 , type integer as ORDERKEY $1 , type timestamp as ORDERDATE $7 , type decimal as TOTALPRICE $6 , type decimal as SUM_QTY $2 "
    | stageQ18_1_d
  stage stageQ18_1_d on all partitions :
    indexJoin 2 customer customer_cust "bound $I1 $L1 =="
    | combined 0
    | stageQ18_1_e
  stage stageQ18_1_e on all partitions :
    aggreg 1 " type integer as CUSTKEY $1 , type integer as ORDERKEY $2 , type timestamp as ORDERDATE $3 , type decimal as TOTALPRICE $4 , type decimal as SUM_QTY )  $5 sum  groupBy type integer $1 , type integer $2"
    | stageQ18_1_f
  stage stageQ18_1_f on all nodes :
     aggreg 1 " type integer as CUSTKEY $1 , type integer as ORDERKEY $2 , type timestamp as ORDERDATE $3 , type decimal as TOTALPRICE $4 , type decimal as SUM_QTY )  $5 sum  groupBy type integer $1 , type integer $2"
     | stageQ18_1_g
  stage stageQ18_1_g on origin :
    aggreg 1 " type integer as CUSTKEY $1 , type integer as ORDERKEY $2 , type timestamp as ORDERDATE $3 , type decimal as TOTALPRICE $4 , type decimal as SUM_QTY )  $5 sum  groupBy type integer $1 , type integer $2"
    | limit 1 100
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;


