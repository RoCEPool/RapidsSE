// OptQ11

/*
// NOTE : IN S04 ColPpg 0x20494d1d0040
                nArriving 3
                m_axCol[0] : m_i_CellIn [0] -> m_i_StructCell [0] $1 ($1 $1)
                m_axCol[1] : m_i_CellIn [1] -> m_i_StructCell [1] $2 ($2 $2)
                m_axCol[2] : m_i_CellIn [6] -> m_i_StructCell [2] $3 ($7 $3)

should be:
: ColPpg 0x20494d1d0040
             nArriving 3
             m_axCol[0] : m_i_CellIn [0] -> m_i_StructCell [0] $1 ($1 $1)
             m_axCol[1] : m_i_CellIn [1] -> m_i_StructCell [1] $2 ($2 $2)
             m_axCol[2] : m_i_CellIn [2] -> m_i_StructCell [2] $3 ($7 $3)
*/



///optimiser_trace
/transliterated
/pipeline_def
/weaved
/pipelineName = "_ray149"
select
  ps_partkey,
  sum(ps_supplycost * ps_availqty) as value
from
  partsupp,
  supplier,
  nation
where
  ps_suppkey = s_suppkey
  and s_nationkey = n_nationkey
  and n_name = 'IRAQ'
group by
  ps_partkey having
    sum(ps_supplycost * ps_availqty) >
    (
      select
        sum(ps_supplycost * ps_availqty) * 0.0001
      from
        partsupp,
        supplier,
        nation
      where
        ps_suppkey = s_suppkey
        and s_nationkey = n_nationkey
        and n_name = 'IRAQ'
    )
order by
   value desc;

