create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);
Load TABLE1 "../DATA/Load/tbl1data.csv" ;

create table TABLE9 (
  pcol9   INTEGER NOT NULL,
  scol9   INTEGER NOT NULL,
  tcol9   INTEGER NOT NULL,
  colb9   VARCHAR(20),
  cold9   FLOAT,
  cole9   DECIMAL,
  colf9   INTEGER,
  colg9   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE9_PCOL9 on TABLE9(pcol9);
Load TABLE9 "../DATA/Load/tbl9data.csv";

/glean_cue_from = "vH60_T10_Produce_maybeIndexJoin_Under_filter"
/glean_cue_trace = "x"
/glean_interactive
/transliterated
/weaved
select min(cold1) + min(cold9) from table1 join table9 using (ucol);


/******************************************************************
 RAY: The above gets weaved as the following pipleine.
 NOTICE: that stage S01 should be broadcast to StageS02
 as the TABLE 1 and TABLE9 are not partitioned on the join columns
******************************************************************/
