/*============================================================================*/

create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE1_UCOL on table1(ucol);

Load TABLE1 "../DATA/Load/tbl1data.csv" ;


create table TABLE9 (
  pcol9   INTEGER NOT NULL,
  scol9   INTEGER NOT NULL,
  tcol9   INTEGER NOT NULL,
  colb9   VARCHAR(20),
  cold9   FLOAT,
  cole9   DECIMAL,
  colf9   INTEGER,
  colg9   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index table9_pcol9 on table9(pcol9);
create index table9_colb9 on table9(colb9);


Load TABLE9 "../DATA/Load/tbl9data.csv";


/glean_interactive
/transliterated
/weaved
/pipelineName = "_opt_debug1"
select a.colb1, b.colb9, avg(a.colf1 + b.colf9)
  from table1 a join table9 b on pcol1 = pcol9
  where b.colb9 < 'INDIGO' group by a.colb1, b.colb9 order by b.colb9, a.colb1;

