create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);
Load TABLE1 "../DATA/Load/tbl1data.csv" ;


explain stage transliterate
select colb1, cola1, colf1 from table1
  where cola1 / case when colf1 < 5 then cola1 when colf1 >= 5 and colf1 < 8 then 10 when colf1 >= 8 and colf1 < 15 then 2 end > 0 and colb1 in ('orange','violet','purple') order by cola1;


/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_opt_debug"
select colb1, cola1, colf1 from table1
  where cola1 / case when colf1 < 5 then cola1 when colf1 >= 5 and colf1 < 8 then 10 when colf1 >= 8 and colf1 < 15 then 2 end > 0 and colb1 in ('orange','violet','purple') order by cola1;



