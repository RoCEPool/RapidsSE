_nation
create index IxN_NATIONKEY on nation (n_nationkey);
load nation "../DATA/TPCH/nation.tbl";

_region
create index IxR_REGIONKEY on Region (R_REGIONKEY);
create index IxR_NAME on Region (R_NAME);
load Region "../DATA/TPCH/region.tbl";

/glean_interactive
/optimise_passthru
/pipeline_def
/weaved
/optimise_passthru
/optimise_passthru
pipeline _unnamed_
begin

  stage S00 on origin :
     start
   | pulse     once
   | next

  stage S01 on all partitions :
     scan      Nation
   | project "type INTEGER as N_NATIONKEY N_NATIONKEY , type VARCHAR as N_NAME N_NAME , type INTEGER as N_REGIONKEY N_REGIONKEY"
   | dynamic
   | next

  stage S02 on all partitions :
     indexJoin Region IxR_REGIONKEY " BOUND $I1 $3 == "
   | dynamic
   | next

  stage S04 on origin :
     output
   | sink
   | first

end ;


