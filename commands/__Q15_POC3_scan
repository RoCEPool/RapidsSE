/* __Q15_NOT_YET                                                              */
/*============================================================================*/

/pipeline_def
/optimise_passthru
pipeline Query15
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     Scan lineitem
     | project "type INTEGER as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
                type DATE as L_SHIPDATE L_SHIPDATE"
     | filter " type BOOLEAN L_SHIPDATE DATE '1996-01-01' >= L_SHIPDATE DATE '1996-04-01' < and"
     | gbyAgg " GroupBy    type INTEGER ( 19 ) as l_suppkey $3
                aggregates type INTEGER ( 19 ) $K1 ,
                           type DECIMAL ( 19  2 ) as total_revenue )  L_EXTENDEDPRICE 1.00  L_DISCOUNT -  *  sum"
     | combined 0
     | next

   stage S02 on all nodes :
     gbyAgg " GroupBy    type INTEGER ( 19 ) as l_suppkey $1
              aggregates type INTEGER ( 19 ) $K1 ,
                         type DECIMAL ( 19  2 ) as total_revenue )  $2 sum  "
     | combined 0
     | next

   stage S03 on origin :
     gbyAgg " GroupBy    type INTEGER ( 19 ) as l_suppkey $1
              aggregates type INTEGER ( 19 ) as supplier_no $K1 ,
                         type DECIMAL ( 19  2 ) as total_revenue )  $2 sum  "
     | combined 0
     | next

   stage S04 on origin:
     top "type DECIMAL ( 19  2 ) $2" 1
     | hash "type INTEGER ( 19 ) supplier_no"
     | combined 0
     | next hashcast

   stage S05 on all partitions multiple threads 4:
     indexJoin supplier IxS_SuppKey "BOUND $I1 supplier_no ==" //J1
     | Project   "   type INTEGER ( 19 ) as s_suppkey s_suppkey
                   , type VARCHAR ( 25 ) as s_name s_name
                   , type VARCHAR ( 40 ) as s_address s_address
                   , type VARCHAR ( 15 ) as s_phone s_phone
                   , type DECIMAL ( 19  2 ) as total_revenue total_revenue"

     | combined 0
     | next

   stage S06 on origin :
     output
     | sink
     | first
 end ;

