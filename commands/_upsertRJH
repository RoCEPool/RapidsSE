/*============================================================================*/
/* _upsertRJH -- create and generate T table                                  */
/*============================================================================*/

bc;

pwf ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection __READAPI_T;
print "** 1/8) __READAPI_T ";

create table __READAPI_T
(
  ref INTEGER NOT NULL,
  psp INTEGER NOT NULL
)
;

create index __READAPI_I on __READAPI_T (ref,psp);

lsidxcol __READAPI_T __READAPI_I;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection createTable;
print "** 2/8) createTable";

trackMemory;

/time create table T
(
  colA DECIMAL   NOT NULL min 0              max 250,
  colB BOOLEAN   NOT NULL min false          max true,
  colC DATE      NOT NULL min "2019-01-01"   max "2019-12-31",
  colD FLOAT     NOT NULL min "1.0"          max "1000.0",
  colE INTEGER   NOT NULL min 1              max 1000,
  colF INTERVAL  NOT NULL min "0.0"          max "100.0",
  colG TIME      NOT NULL min "00:00:00.000" max "23:59:59.999",
//  colH TIMESTAMP NOT NULL min "2019-01-01 00:00:00.000"
//                          max "2019-12-31 23:59:59.999",
  colI VARCHAR   NOT NULL min "a"            max "zzzzzzzzz"
)
  rowsize 256
;

lscol T;

create index T_Idx_1 on T (colE);

lsidx T;

lsidxcol T T_Idx_1;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection createIndex;
print "** 3/8) createIndex";

//drop index T T_Idx_1;

//drop table T;

//memoryLeaks fatal;

pipeline t_upsert
begin

  stage stageA on origin:
    start | periodic once | stageB

  stage stageB on all partitions:
    genCsv T | toCrw T | upsertOp T | stageC

  stage stageC on origin:
    output | sink | stageA

end;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection t_fetch;
print "** 4/8) t_fetch";

predicateFetch T "colE 100 <";

predicateFetch T;

dumpindex T T_Idx_1;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection scan;
print "** 5/8) scan";

pipeline t_scan
begin

  stage stageA on origin:
    start | periodic once | stageB

  stage stageB on all partitions:
    scan T | toCsv |stageC

  stage stageC on origin:
    output | sink | stageA

end;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection snapshot;
print "** 6/8) snapshot";

pipeline t_snapshot
begin

  stage stageA on origin:
    start | periodic once | stageB

  stage stageB on all partitions:
    snapshot T | stageC

  stage stageC on origin:
    output | sink | stageA

end;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
logSection dropTable;
print "** 7/8) dropTable";

drop table T;

memoryLeaks fatal;

print "** 8/8) success _upsertRJH";

