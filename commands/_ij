create table lt (
  l_key   INTEGER NOT NULL,
  l_name  VARCHAR(32) NOT NULL
);

print "loading lt.csv..." ;
load lt "../JTEST/leftTable.csv" ;

create table rt (
  r_key   INTEGER NOT NULL,
  r_name  VARCHAR(32) NOT NULL
);
create index ri on rt(r_key);

print "loading rt.csv..." ;
load rt "../JTEST/rightTable.csv" ;


pipeline indexJoinExp
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan lt | stageC

  stage stageC on all partitions :
    indexJoin 0 rt ri "EQUAL $I1 $L1 == " | stageD

  stage stageD on origin :
    output | sink | stageA
end;

create table student (
id         INTEGER,
first_name VARCHAR(10),
last_name   VARCHAR(10)
);
create index student_idx on student(id);
load student "../DATA/Joins/student_Dataset.csv" ;


