/* _jo1_C_L_O_P_S -- join order: Customer, Supplier, Orders, Lineitem, Part  */
/*============================================================================*/

/jobMetrics
/joWrite
/filterPred
/glean_interactive
/transliterated
/weaved
/pipelineName = "_jo1_C_L_O_P_S"
select
       count(*)
  from
       Customer, //  29
       Lineitem, // 630
       Orders,   // 181
       Part,     //  29
       Supplier  //   2
 where
       C_CUSTKEY  = O_CUSTKEY
   and O_ORDERKEY = L_ORDERKEY
   and L_PARTKEY  = P_PARTKEY
   and L_SUPPKEY  = S_SUPPKEY
;

