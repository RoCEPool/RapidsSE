_orders
_lineitem

create index IxL_ORDERKEY  ON Lineitem (L_ORDERKEY)  ;

load Orders "../TPCH/SF_0001/orders.csv";
load lineitem "../TPCH/SF_0001/lineitem.csv";

/glean_interactive
/pipeline_def
/weaved
select * from orders where O_ORDERDATE >= TIMESTAMP '1993-07-01 00:00:00';

/glean_interactive
/pipeline_def
/weaved
/optimise_passthru
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan orders
    | filter " type BOOLEAN O_ORDERDATE DATE '1993-07-01' >=
                              O_ORDERDATE DATE '1993-10-01' < and "
    | project "type INTEGER as _orderkey O_ORDERKEY ,
                type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY"
    | keyExists lineitem IxL_ORDERKEY  "BOUND $I1 _orderkey =="
                                       "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

   end ;
