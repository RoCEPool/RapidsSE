/*
// NOTE: the expr in S02 for gbyAgg has expr as :
                  type INTEGER as COL1 $1 $1 sum
                  , type INTEGER as COL2 $2

    Note the $1 $1
*/

/*
ArgDef: [0] expr  groupBy
                    type INTEGER as COL2 $2
                  aggregates
                    type INTEGER as COL1 $1 $1 sum
                  , type INTEGER as COL2 $2
*/

create table datums (
  int_col0   INTEGER NOT NULL,
  int_col1   INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(19,2),
  dec_col7   DECIMAL(19,2),
  flt_col8   FLOAT,
  flt_col9   FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);

load datums "../DATA/Transliterate/groupBy.csv" ;

/glean_interactive
/weaved
/transliterated
/pipeline_def
/optimise_passthru
pipeline _unnamed_
 begin

   stage S00 on origin :
       start
     | pulse     once
     | next

   stage S01 on all partitions :
       scan      datums
     | project   "   type INTEGER as C0_int_col0 $1
                  , type INTEGER as C1_int_col1 $2 "
     | combined 0
     | next

   stage S02 on all partitions :
     gbyAgg    " groupBy
                   type INTEGER as COL2 $2
                 aggregates
                   type INTEGER as COL1 ) $1 sum
                 , type INTEGER as COL2 $K1 "
     | combined 0
     | next

   stage S03 on all nodes :
     gbyAgg    " groupBy
                   type INTEGER as COL2 $2
                 aggregates
                   type INTEGER as COL1 ) $1 sum
                 , type INTEGER as COL2 $K1 "
     | combined 0
     | next

   stage S04 on origin :
     gbyAgg    " groupBy
                   type INTEGER as COL2 $2
                 aggregates
                   type INTEGER as COL1 ) $1 sum
                 , type INTEGER as COL2 $K1 "
     | combined 0
     | next

   stage S05 on origin :
       output
     | sink
     | first

 end ;


