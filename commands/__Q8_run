/* __Q8_run                                                                   */
/*============================================================================*/

/******************************************************************************
Q08_A: select
         o_year,
         sum(case when Nation = 'BRAZIL'
                  then volume
                  else 0
             end) / sum(volume) as mkt_share

  from

       ( Q08_0: select extract(year from o_orderdate)     as o_year,
                      l_extendedprice * (1 - l_discount) as volume,
                      n2.n_name                          as Nation

           from Part, Supplier, LineItem, Orders, Customer, Nation n1, Nation n2, Region

          where     p_partkey      =  l_partkey
                and s_suppkey      =  l_suppkey
                and l_orderkey     =  o_orderkey
                and o_custkey      =  c_custkey
                and c_nationkey    =  n1.n_nationkey
                and n1.n_regionkey =  r_regionkey
                and r_name         =  'AMERICA'
                and s_nationkey    =  n2.n_nationkey
                and o_orderdate    >= '1995-01-01'
                and o_orderdate    <= '1996-12-31'
                and p_type         = 'ECONOMY ANODIZED STEEL' ) as all_nations

 group by o_year

 order by o_year;
*******************************************************************************/


/time pipeline Q8
begin

  stage first on origin :
    start
    | pulse once
    | next
    
  //
  // Q8_0:
  //   a) scan Part      /P_PARTKEY/   # _partkey
  //   b) join Supplier  /S_SUPPKEY/   # _suppkey    _nationkey
  //   c) join LineItem  /L_ORDERKEY/  # _orderkey   _partkey    _suppkey
  //   d) join Orders    /O_CUSTKEY/   # _custkey    _orderkey
  //   e) join Customer  /C_CUSTKEY/   # _customer   _nationkey
  //   f) join Nation n1 /replicated/  # _nationkey  
  //   g) join Nation n2 /replicated/  # _nationkey
  //   h) join Region    /replicated/  # _regionkey
  //

  // ∀ PART π P_PARTKEY as _partkey
  stage Gs_PART on all partitions :
    scan part
    | project 1 "type INTEGER as _partkey P_PARTKEY"
    | debug rowbuffer
    | next

  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

  stage G_CNT_P on all partitions :
    project 1 " type INTEGER as x_rowCntPtn )  countAll  "
    | next
    
  stage G_CNT_N on all nodes :
    project 1 " type INTEGER as x_rowCntNode )  x_rowCntPtn sum  "
    | next
    
  stage G_CNT_O on origin :
    project 1 " type INTEGER as x_rowCntOrigin )  x_rowCntNode sum  "
    | next

  stage last on origin :
    output
    | debug accum0
    | sink
    | first

end ;

