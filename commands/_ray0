/* _ray0                                                                      */
/*============================================================================*/

_nation;
/time load nation   "<tpch_dir>/nation.<suffix>";
create index IxN_NATIONKEY on nation (n_nationkey);
create index IxN_REGIONKEY on nation (N_REGIONKEY);

_region;
/time load region   "<tpch_dir>/region.<suffix>";
create index IxR_REGIONKEY on region (R_REGIONKEY);

/pipeline_def
/weaved
/optimise_passthru
pipeline _unnamed_
begin

  stage S00 on origin :
     start
   | pulse     once
   | next

  stage S01 on all partitions :
     scan      Nation
   | project "type INTEGER N_NATIONKEY , type VARCHAR N_NAME , type INTEGER N_REGIONKEY"
   | hash "type INTEGER $3"
   | combined 0
   | next hashcast

  stage S02 on all partitions :
     indexJoin Region IxR_REGIONKEY " BOUND $I1 $3 == "
   | combined 0
   | next

  stage S04 on origin :
     output
   | sink
   | first

end ;



