/*============================================================================*/
/* _ray0                                                                      */
/*============================================================================*/

//NOTE: OPDEF for IndexScan has: ArgDef: [2] expr  UBOUND $I1 2 >= UBOUND $I1 6 <

_nation;

/glean_interactive
/weaver2
/weaved
/optimise_passthru
pipeline _ray0
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
    indexScan Nation IxN_NATIONKEY "LBOUND $I1 2 >= UBOUND $I1 6 < "
    | project  "type INTEGER as N_NATIONKEY $1 , type VARCHAR as N_NAME $2 , type INTEGER as N_REGIONKEY $3 , type VARCHAR as N_COMMENT $4 "
    | dynamic
    | next

  stage S02 on origin :
      output
    | sink
    | first

end ;

/*============================================================================*/
/* end                                                                        */
