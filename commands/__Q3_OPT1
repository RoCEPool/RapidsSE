/optimise_passthru
pipeline unamed
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
      scan      Orders
  | filter    " type BOOLEAN $5 DATE '1995-03-15' < "
    | dynamic
    | next

  stage S02 on all partitions :
    project   "   type DATE as C0_O_ORDERDATE $5
              , type INTEGER ( 19 ) as C1_O_SHIPPRIORITY $8
              , type INTEGER ( 19 ) as C2_O_CUSTKEY $2
                , type INTEGER ( 19 ) as C3_O_ORDERKEY $1 "
    | hash      "type DATE $1"
    |  dynamic
    | next      hashcast

  stage S03 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY " BOUND $I1 $4 == "
  | filter    " type BOOLEAN $15 DATE '1995-03-15' > "
     | dynamic
    | next

  stage S04 on all partitions :
    project   "   type INTEGER ( 19 ) as C0_L_ORDERKEY $5
                , type DECIMAL ( 15 2 ) as C1_L_EXTENDEDPRICE $10
                , type DECIMAL ( 15 2 ) as C2_L_DISCOUNT $11
                , type DATE as C3_O_ORDERDATE $1
                , type INTEGER ( 19 ) as C4_O_SHIPPRIORITY $2
                , type INTEGER ( 19 ) as C5_O_CUSTKEY $3 "
  | hash      "type INTEGER $1"
     | dynamic
    | next      hashcast

  stage S05 on all partitions :
    indexJoin Customer IxC_CUSTKEY " BOUND $I1 $6 == "
  | filter    " type BOOLEAN $13 'BUILDING' == "
     | dynamic
    | next

  stage S06 on all partitions :
    project   "   type INTEGER ( 19 ) as C0_L_ORDERKEY $1
                , type DECIMAL ( 15 2 ) as C1_L_EXTENDEDPRICE $2
                , type DECIMAL ( 15 2 ) as C2_L_DISCOUNT $3
                , type DATE as C3_O_ORDERDATE $4
                , type INTEGER ( 19 ) as C4_O_SHIPPRIORITY $5 "
    |  dynamic
    | next

  stage S07 on all partitions :
    gbyAgg    " groupBy
                  type INTEGER ( 19 ) as C0_L_ORDERKEY $1
                , type DATE as C1_O_ORDERDATE $4
                , type INTEGER ( 19 ) as C2_O_SHIPPRIORITY $5
                aggregates
                  type INTEGER ( 19 ) as C0_COL0 $K1
                , type DECIMAL ( 19 2 ) as C1_COL1 ) $2 1.00 $3 - * sum
                , type DATE as C2_COL2 $K2
                , type INTEGER ( 19 ) as C3_COL3 $K3 "
    |  dynamic
    | next

  stage S08 on all nodes :
    gbyAgg    " groupBy
                  type INTEGER ( 19 ) $1
                , type DATE $3
                , type INTEGER ( 19 ) $4
                aggregates
                  type INTEGER ( 19 ) as C0_COL0 $K1
                , type DECIMAL ( 19 2 ) as C1_COL1 ) $2 sum
                , type DATE as C2_COL2 $K2
                , type INTEGER ( 19 ) as C3_COL3 $K3 "
   |   dynamic
    | next

  stage S09 on origin :
    gbyAgg    " groupBy
                  type INTEGER ( 19 ) $1
                , type DATE $3
                , type INTEGER ( 19 ) $4
                aggregates
                  type INTEGER ( 19 ) as C0_COL0 $K1
                , type DECIMAL ( 19 2 ) as C1_Revenue ) $2 sum
                , type DATE as C2_COL2 $K2
                , type INTEGER ( 19 ) as C3_COL3 $K3 "
   |   dynamic
    | next

  stage S10 on origin :
    sort      " type DECIMAL ( 19 2 ) $2 DESC , type DATE $3 ASC "
   | limit      10
      dynamic
    | next

  stage S11 on origin :
      output
    | sink
    | first

end ;
