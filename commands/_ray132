// NOTE : In stage S2 the crossJoin has no colInj

__TPCH_SCHEMA

/optimiser_trace
/pipeline_def
/weaved
/transliterated
/pipelineName = "OptQ11"
select
  ps_partkey,
  sum(ps_supplycost * ps_availqty) as value
from
  partsupp,
  supplier,
  nation
where
  ps_suppkey = s_suppkey
  and s_nationkey = n_nationkey
  and n_name = 'IRAQ'
group by
  ps_partkey having
    sum(ps_supplycost * ps_availqty) >
    (
      select
        sum(ps_supplycost * ps_availqty) * 0.0001
      from
        partsupp,
        supplier,
        nation
      where
        ps_suppkey = s_suppkey
        and s_nationkey = n_nationkey
        and n_name = 'IRAQ'
    )
order by
   value desc;


_tpchDrop