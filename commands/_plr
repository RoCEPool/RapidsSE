print "pipeline plan ray..." ;


pipeline ray1_dyn
begin

  stage stageA on all partitions:
    scan lineitem | output

end ;

pipeline ray2_dyn
begin

  stage stageA on all partitions:
    scan lineitem | insert lineitem2 | output

end ;

pipeline ray3_dyn
begin

  stage stageA on all partitions:
    scan lineitem2 | output

end ;

