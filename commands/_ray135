// I think this got fixed by the correction of copy/paste error in vCraftColInj()

__TPCH_SCHEMA

/optimiser_trace
/transliterated
/pipeline_def
/weaved
/pipelineName = "OptQ5"
select
  n_name,
  sum(l_extendedprice * (1 - l_discount)) as revenue
from
  customer,
  orders,
  lineitem,
  supplier,
  nation,
  region
where
  c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and l_suppkey = s_suppkey
  and c_nationkey = s_nationkey
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'AMERICA'
  and o_orderdate >= DATE '1994-01-01'
  and o_orderdate < DATE '1995-01-01'
group by
  n_name
order by
  revenue desc;

_tpchDrop