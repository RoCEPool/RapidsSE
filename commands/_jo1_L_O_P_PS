/jobMetrics
/joWrite
/filterPred
/optimiser_trace
/transliterated
/weaved
/pipelineName = "_jo1_L_O_P_PS"
select
       count(*)
  from
       Lineitem, // 630
       Orders,   // 181
       Part,     //  29
       PartSupp  // 131
 where
       L_ORDERKEY = O_ORDERKEY
   and L_PARTKEY  = P_PARTKEY
   and P_PARTKEY  = PS_PARTKEY
// and L_PARTKEY  = PS_PARTKEY
;

