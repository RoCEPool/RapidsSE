/*============================================================================*/
/* __CS2_antiJoin: Code Synthesizer V2                                        */
/*============================================================================*/
_nation
_region
tag default <tpch_dir> = "../tpch/sf_0001";
tag default <suffix>   = "csv";

load nation "../DATA/TPCH/nation.tbl";
load Region "../DATA/TPCH/region.tbl";

CREATE INDEX IxN_NATIONKEY ON nation (N_NATIONKEY);
CREATE INDEX IxR_REGIONKEY on REGION (R_REGIONKEY);
CREATE INDEX IxR_NAME      on REGION (R_NAME);

//SELECT * FROM NATION WHERE N_REGIONKEY IN (SELECT R_REGIONKEY FROM REGION WHERE R_NAME = 'ASIA');
//SELECT * FROM NATION WHERE N_REGIONKEY NOT IN (SELECT R_REGIONKEY FROM REGION WHERE R_REGIONKEY = N_NATIONKEY);

/glean_interactive
/transliterated
/weaved
/optimise_passthru
pipeline __CS2_antiJoin
begin

 stage S00 on origin :
     start
   | pulse     once
   | next

 stage S01 on all partitions :
     scan Nation
   | project "type INTEGER as N_NATIONKEY N_NATIONKEY , type VARCHAR as N_NAME N_NAME , type INTEGER as N_REGIONKEY N_REGIONKEY"
   | combined  0
   | next

 stage S02 on all partitions :
     keyNotExists Region IxR_REGIONKEY
              " BOUND $I1 $3 == "
              "type BOOLEAN R_REGIONKEY N_NATIONKEY =="
              //"type BOOLEAN R_NAME 'ASIA' =="
   | combined  0
   | next

 stage S04 on origin :
     output
   | sink
   | first

end ;