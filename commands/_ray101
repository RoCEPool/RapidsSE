//NOTE: SORT has a columnName by which to sort

__TPCH_SCHEMA_LOAD_SF0001

/pipeline_def
/weaved
/optimise_passthru
pipeline Query5
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Lineitem
    | project "type INTEGER as L_ORDERKEY L_ORDERKEY ,
               type INTEGER as L_SUPPKEY L_SUPPKEY"
    | combined 0
    | next

  stage S02 on origin :
    sort " type DECIMAL L_SUPPKEY DESC  "
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;


