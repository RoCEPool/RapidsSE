/*============================================================================*/
/* __Q8_OPT1                                                                  */
/*============================================================================*/

 //Merged projects of one stage to an early project in previous stage

 //Alka's iMAC:
 //  SF10-1N1P : 17.62
 //  SF10-1N4P : 4.88

/keepCodeFile
/optimise_passthru
pipeline unamed
begin

  stage S00 on origin : 
      start
    | pulse     once
    | next

  stage S01 on all partitions : 
      scan      region
    | filter    " type BOOLEAN $2 'AMERICA' == "
    | dynamic
    | next      

  stage S02 on all partitions : 
    indexJoin nation IxN_NATIONKEY " BOUND $I1 "
    | filter    " type BOOLEAN $6 $1 == "
    | dynamic
    | next      

  stage S03 on all partitions : 
    indexJoin Customer IxC_CUSTKEY " BOUND $I1 "
    | filter    " type BOOLEAN $11 $4 == "
    | dynamic
    | next      

  stage S04 on all partitions : 
    project   " type INTEGER ( 19 ) as C0_C_CUSTKEY $8 "
    | hash      "type INTEGER $1"
    | dynamic
    | next      hashcast

  stage S05 on all partitions : 
    indexJoin Orders IxO_CUSTKEY " BOUND $I1 $1 == "
    | filter    " type BOOLEAN $6 DATE '1995-01-01' >= $6 DATE '1996-12-31' <= and "
    | dynamic
    | next      

  stage S06 on all partitions : 
    project   "   type DATE as C0_O_ORDERDATE $6
                , type INTEGER ( 19 ) as C1_O_ORDERKEY $2 "
    | hash      "type INTEGER $2"
    | dynamic
    | next      hashcast

  stage S07 on all partitions : 
    indexJoin Lineitem IxL_ORDERKEY " BOUND $I1 $2 == "
    | dynamic
    | next      

  stage S08 on all partitions : 
    project   "   type DATE as C0_O_ORDERDATE $1
                , type DECIMAL ( 15 2 ) as C1_L_EXTENDEDPRICE $8
                , type DECIMAL ( 15 2 ) as C2_L_DISCOUNT $9
                , type INTEGER ( 19 ) as C3_L_PARTKEY $4
                , type INTEGER ( 19 ) as C4_L_SUPPKEY $5 "
    | hash      "type INTEGER $5"
    | dynamic
    | next      hashcast

  stage S09 on all partitions : 
    indexJoin Supplier IxS_SUPPKEY " BOUND $I1 $5 == "
    | dynamic
    | next      

  stage S10 on all partitions : 
    project   "   type DATE as C0_O_ORDERDATE $1
                , type DECIMAL ( 15 2 ) as C1_L_EXTENDEDPRICE $2
                , type DECIMAL ( 15 2 ) as C2_L_DISCOUNT $3
                , type INTEGER ( 19 ) as C3_L_PARTKEY $4
                , type INTEGER ( 19 ) as C4_S_NATIONKEY $9 "
    | dynamic
    | next      

  stage S11 on all partitions : 
    indexJoin nation IxN_NATIONKEY " BOUND $I1 $5 == "
    | dynamic
    | next      

  stage S12 on all partitions : 
    project   "   type DATE as C0_O_ORDERDATE $1
                , type DECIMAL ( 15 2 ) as C1_L_EXTENDEDPRICE $2
                , type DECIMAL ( 15 2 ) as C2_L_DISCOUNT $3
                , type VARCHAR ( 25 ) as C3_N_NAME $7
                , type INTEGER ( 19 ) as C4_L_PARTKEY $4 "
    | hash      "type INTEGER $5"
    | dynamic
    | next      hashcast

  stage S13 on all partitions : 
    indexJoin Part IxP_PARTKEY " BOUND $I1 $5 == "
    | filter    " type BOOLEAN $10 'ECONOMY ANODIZED STEEL' == "
    | dynamic
    | next      

  stage S14 on all partitions : 
    project   "   type INTEGER ( 19 ) as C0_o_year $1 extract_year
                , type DECIMAL ( 19 2 ) as C1_volume $2 1.00 $3 - *
                , type VARCHAR as C2_N_NAME $4 "
    | dynamic
    | next      

  stage S15 on all partitions : 
    gbyAgg    " groupBy
                  type INTEGER ( 19 ) $1
                aggregates
                  type INTEGER ( 19 ) as C0_COL0 $K1
                , type DECIMAL ( 19 2 ) as C1_COL1 ) $2 sum
                , type DECIMAL ( 19 2 ) as C2_COL2 } ) type DECIMAL ( 19 2 ) $3 'BRAZIL' == WHEN $2 THEN 0.00 ELSE ENDIF CASE sum "
    | dynamic
    | next

  stage S16 on all nodes : 
    gbyAgg    " groupBy
                  type INTEGER ( 19 ) $1
                aggregates
                  type INTEGER ( 19 ) as C0_COL0 $K1
                , type DECIMAL ( 19 2 ) as C1_COL1 ) $2 sum
                , type DECIMAL ( 19 2 ) as C2_COL2 ) $3 sum "
    | dynamic
    | next      

  stage S17 on origin : 
    gbyAgg    " groupBy
                  type INTEGER ( 19 ) $1
                aggregates
                  type INTEGER ( 19 ) as C0_COL0 $K1
                , type DECIMAL ( 19 2 ) as C1_COL1 ) $2 sum
                , type DECIMAL ( 19 2 ) as C2_COL2 ) $3 sum "
    | dynamic
    | next      

  stage S18 on origin : 
    project   "   type INTEGER ( 19 ) as C0_o_year $1
                , type DECIMAL ( 19 2 ) as C1_mkt_share $3 $2 / "
    | dynamic
    | next      

  stage S19 on origin :
      output
    | sink
    | first

end ;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
