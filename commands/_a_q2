/*============================================================================*/
/* _a_q1 -- Query1 (hand coded pipeline)                                      */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select
  s_acctbal,
  s_name,
  n_name,
  p_partkey,
  p_mfgr,
  s_address,
  s_phone,
  s_comment
from
  part,
  supplier,
  partsupp,
  nation,
  region
where
  p_partkey = ps_partkey
  and s_suppkey = ps_suppkey
  and p_size = 15
  and p_type like '%BRASS'
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'EUROPE'
  and ps_supplycost =
  (
    select
      min(ps_supplycost)
    from
      partsupp,
      supplier,
      nation,
      region
    where
      p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE' )
order by
  s_acctbal desc,
  n_name,
  s_name,
  p_partkey
limit 100;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : PART, SUPPLIER, PARTSUPP, NATION, REGION
// JOIN ORDER : PART->PARTSUPP->SUPPLIER->REGION->NATION->...PARTSUPP->PART->SUPPLIER->NATION
// INDEXES    : IxPS_PARTKEY
                IxS_SUPPKEY
                IxN_NATIONKEY
                IxR_REGIONKEY
                IxP_PARTKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * FILTER ON PART PULLED FROM OUTER-QUERY INTO SUB-QUERY
//   * REJOIN WITH PART AND SUPPLIER TO GET THE CORRECT SUPPLIER
//   * GET SUPPLIER COLUMNS LATER

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//   NONE


* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
// pipeline begin
pipeline Query2
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan part
    | filter " type BOOLEAN  }  P_TYPE '%BRASS'  6 matchTrailing P_SIZE 15 == and"
    | project " type INTEGER as P_PARTKEY P_PARTKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project " type INTEGER as P_PARTKEY P_PARTKEY ,
                type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY ,
                type DECIMAL as PS_SUPPLYCOST J1_PS_SUPPLYCOST"
    | hash "type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER as S_NATIONKEY J1_S_NATIONKEY "
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER as N_REGIONKEY J1_N_REGIONKEY "
    | combined 0
    | next

  stage S05 on all partitions :
    indexJoin region IxR_REGIONKEY "BOUND $I1 N_REGIONKEY =="
    | filter " type BOOLEAN  J1_R_NAME 'EUROPE'  == "
    | aggreg " GroupBy    type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST min "
    | combined 0
    | next

  stage S06 on all nodes :
     aggreg " GroupBy     type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min "
    | combined 0
    | next

  stage S07 on origin :
     aggreg " GroupBy    type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min "
    | hash "type INTEGER P_PARTKEY"
    | combined 0
    | next hashcast

  stage S08 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | filter "type BOOLEAN PS_SUPPLYCOST_MIN J1_PS_SUPPLYCOST =="
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY"
    | combined 0
    | next

  stage S09 on all partitions :
    indexJoin part IxP_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project " type INTEGER as P_PARTKEY P_PARTKEY ,
                type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                type VARCHAR ( 0 ) as P_MFGR J1_P_MFGR"
    | hash "type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S10 on all partitions :
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project " type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
                type DECIMAL as S_ACCTBAL J1_S_ACCTBAL ,
                type VARCHAR ( 0 ) as S_NAME J1_S_NAME ,
                type INTEGER as P_PARTKEY P_PARTKEY ,
                type VARCHAR ( 0 ) as P_MFGR P_MFGR ,
                type VARCHAR ( 0 ) as S_ADDRESS J1_S_ADDRESS ,
                type VARCHAR ( 0 ) as S_PHONE J1_S_PHONE ,
                type VARCHAR ( 0 ) as S_COMMENT J1_S_COMMENT "
    | combined 0
    | next

  stage S11 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project " type DECIMAL as S_ACCTBAL S_ACCTBAL ,
                type VARCHAR ( 0 ) as S_NAME S_NAME ,
                type VARCHAR ( 0 ) as N_NAME J1_N_NAME ,
                 type INTEGER as P_PARTKEY P_PARTKEY ,
                 type VARCHAR ( 0 ) as P_MFGR P_MFGR ,
                 type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS ,
                 type VARCHAR ( 0 ) as S_PHONE S_PHONE ,
                 type VARCHAR ( 0 ) as S_COMMENT S_COMMENT "
    | sort "type DECIMAL S_ACCTBAL DESC ,
            type VARCHAR ( 0 ) N_NAME ASC ,
            type VARCHAR ( 0 ) S_NAME ASC ,
            type INTEGER P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S12 on all nodes :
    sort "type DECIMAL S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S13 on origin :
    sort "type DECIMAL S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S14 on origin :
    output
    | sink
    | first
end ;
// pipeline end
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
