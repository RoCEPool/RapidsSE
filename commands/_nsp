pipeSee
pipeline nestedPipeTest
begin

  pipeline sp10
  begin
  
    pipeline sp11
    begin
      stage stageA on origin :
        start
      | pulse once
      | echo "sp11"
      | debug all
      | sink
      | stageA
    end

    stage stageA on origin :
      start
    | pulse once
    | echo "sp10"
    | debug all
    | sink
    | stageA
  end

  stage stageA on origin :
      start
    | pulse once
    | echo "pipeTest"
    | debug all
    | sink
    | stageA
end ;


