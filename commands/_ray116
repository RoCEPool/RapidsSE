// NOTE: Optimiser to detect invalid pipeline
//  Stage Gs_ORDERS has no operators to combine.

__TPCH_SCHEMA_LOAD_SF0001

/optimise_passthru
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
   scan orders
    | combined 0
    | next

  stage Gs_ORDERS on all partitions :
    combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;

