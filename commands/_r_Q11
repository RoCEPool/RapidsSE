/*============================================================================*/
/* _r_Q11 -- TCPH query 11 test                                               */
/*============================================================================*/

// /jo_disable
// /ep_disable
/glean_interactive
/filterPred
/jobMetrics
/joWrite
/transliterated
/weaved
/pipelineName = "_r_Q11"
select
  ps_partkey,
  sum(ps_supplycost * ps_availqty) as value
from
  partsupp,
  supplier,
  nation
where
  ps_suppkey = s_suppkey
  and s_nationkey = n_nationkey
  and n_name = 'GERMANY'
group by
  ps_partkey having
    sum(ps_supplycost * ps_availqty) >
    (
      select
        sum(ps_supplycost * ps_availqty) * 0.0001
      from
        partsupp,
        supplier,
        nation
      where
        ps_suppkey = s_suppkey
        and s_nationkey = n_nationkey
        and n_name = 'GERMANY'
    )
order by
   value desc;

