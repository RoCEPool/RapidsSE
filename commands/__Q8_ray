/* __Q8_ray                                                                   */
/*============================================================================*/

print "__Q8_ray";

__Q8_setup

reapCtl disable;

networkReset;

//__Q8_runC
__Q8c_runC

jobReport <LastJobId>;

reap enable;

select stageNo, stageName, opName,
       sum(buffIn)
  from se__jobOperators
 where opName = 'send'
    or opName = 'consumeOp'
 group by stageNo, stageName, opName
;

select stageNo, stageName,
       count(*)        as nOps,
       max(buffIn)     as maxBuffIn,
       sum(responseUS) as maxRspUs,
       max(MaxQs)      as maxQ,
       max(buffOut)    as maxBuffOut
  from se__jobOperators
 group by stageNo, stageName
;

