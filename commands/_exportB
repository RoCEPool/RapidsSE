/*============================================================================*/
/* _exportB - export of TPC-H LineItem table                                  */
/*============================================================================*/

print "\n";
print "**************************************************************************";
print "B) Exporting LineItem";
print "**************************************************************************";

/time pipeline exportB
begin
 
  stage scanBuffers on all partitions:

    scan LineItem | toCsv | outputCsv


  stage outputCsv on origin:

    wrFile "/tmp/LineItemB.csv" | output
 
end
;

