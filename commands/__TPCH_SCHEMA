/time load customer           "<tpch_dir>/customer.<suffix>" ;
/time load part               "<tpch_dir>/part.<suffix>"     ;
/time load partsupp           "<tpch_dir>/partsupp.<suffix>" ;
/time load orders             "<tpch_dir>/orders.<suffix>"   ;
/time load lineitem           "<tpch_dir>/lineitem.<suffix>" ;

