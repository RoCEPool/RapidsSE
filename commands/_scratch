
_lineitem

load lineitem "../TPCH/SF_0001/lineitem.csv";

explain stage transliterate SELECT l_orderkey, l_shipdate from lineitem where
  l_shipdate <= DATE '1998-12-01' - INTERVAL '60' DAY ;

  pipeline unamed
  begin
    stage stageStart on origin :
      start
      | pulse once
      | stageMarker0383
    stage stageMarker0383 on all partitions :
      scan rapids public lineitem
      | filter " type BOOLEAN  $11 DATE '1998-12-01'  1327104000000007  -  <=  "
      | project " type INTEGER as l_orderkey $1 , type DATE as l_shipdate $11 "
      | combined 0
      | stageLast
    stage stageLast on origin :
      output
      | sink
      | stageStart
  end ;