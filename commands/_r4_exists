/*============================================================================*/
/* _r4_exists -- exists sub_query test                                        */
/*============================================================================*/

trackMemory;

_lineItem
create index L_idx0 on lineitem(L_ORDERKEY);

_orders
create index O_idx0 on orders(O_ORDERKEY);

_supplier
create index S_idx0 on supplier(S_SUPPKEY);

load lineItem "../tpch/sf_0001/lineItem.csv" ;
load orders   "../tpch/sf_0001/orders.csv" ;
load supplier "../tpch/sf_0001/supplier.csv" ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimise
/glean_cue_from = "vH55_T10_Collapse_Exists_SubQueries"
/glean_cue_trace = "x"
/optimiser_trace
/transliterated
/weaved
/pipelineName = "r4_exists"
select
  count(*)
   from orders, lineitem
  where L_ORDERKEY = O_ORDERKEY
    and exists ( select *
                   from supplier
                  where S_SUPPKEY = L_SUPPKEY )
;

