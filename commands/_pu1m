/* _pu1m -- pu1m performance unit test                                        */
/*============================================================================*/

create table Pu1m (
    pu1m_1m   integer not null
  , pu1m_100k integer not null
  , pu1m_10k  integer not null
    
  , pu1m_pre  integer not null
  , pu1m_pst  integer not null
    
  , pu1m_int  integer not null
  , pu1m_dte  date    not null
  , pu1m_str  varchar not null
);
create index idx_1m   on Pu1m (pu1m_1m);
create index idx_100k on Pu1m (pu1m_100k);
create index idx_10k  on Pu1m (pu1m_10k);

/time puLoad Pu1m;

//select * from Pu1m;
select count(*) from Pu1m;
select * from Pu1m where pu1m_1m < 10;
select * from Pu1m where pu1m_1m > 1000000 - 10;

