/ccode pipeline unamed
begin
stage S00 on origin :
  start
  | pulse once
  | next
stage S01 on all partitions :
  scan rapidsse public Nation
  | aggreg " type VARCHAR )  $2 max  "
  | dynamic_v2 0
  | next

stage S02 on all nodes :
  aggreg " type VARCHAR )  $1 max  "
  | dynamic_v2 0
  | next
