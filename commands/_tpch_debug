tag default <tpch_dir> = "../tpch/sf_0001";
tag default <suffix>   = "csv";

__TPCH_SCHEMA


// QUERY 2
// modified psize = 15 to psize < 15 for SF0001

trackMemory;

/glean_interactive
/transliterated
/weaved
/pipelineName = "_tpch_debug"
select
  s_acctbal,
  s_name,
  n_name,
  p_partkey,
  p_mfgr,
  s_address,
  s_phone,
  s_comment
from
  part,
  supplier,
  partsupp,
  nation,
  region
where
  p_partkey = ps_partkey
  and s_suppkey = ps_suppkey
  and p_size = 20
  and p_type like '%STEEL'
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'AFRICA'
  and ps_supplycost =
  (
    select
      min(ps_supplycost)
    from
      partsupp,
      supplier,
      nation,
      region
    where
          P_PARTKEY = PS_PARTKEY
      and s_suppkey   = ps_suppkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name      = 'AFRICA' )

order by
  s_acctbal desc,
  n_name,
  s_name,
  p_partkey
limit 100;

MemoryLeaks;

