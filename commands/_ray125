//NOTE: Optimiser cutting sort as data ordered via indexscan
//      But we need sort on all nodes and on origin to sort the data coming from partitions.
//      Data is sorted only on each partition

create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE1_PCOL1 on table1(pcol1);
Load TABLE1 "../DATA/Load/tbl1data.csv" ;

// /KeepCodeFile

/optimiser_trace
/transliterated
/pipeline_def
/weaved
