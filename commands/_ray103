// LEFT FILTER & PROJECT & POST PROJECT
// select c_custkey, c_nationkey, o_custkey from customer inner join orders on customer.c_custkey = orders.o_custkey
//   where c_nationkey >= 4;

/glean_interactive
/optimise_passthru
/pipeline_def
/weaved
pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan customer
    | filter "type boolean $4 4 >= "
    | project "type integer $1 , type integer $4 "
    | combined 0
    | stageC

  stage stageC on all partitions :
    indexJoin orders IxO_CUSTKEY "BOUND $I1 $L1 =="
    | project "type integer $1 , type integer $2 , type integer $4"
    | combined 0
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA
end ;


