_lineitem;
//create        index IxL_ORDERKEY    on Lineitem (L_ORDERKEY);
//load lineitem             "../TPCH/SF_0001/lineitem.csv"   ;

_orders;
create        index IxO_ORDERKEY    on Orders   (O_ORDERKEY);
load orders             "../TPCH/SF_0001/orders.csv"   ;

//select * from lineitem, orders where l_orderkey = o_orderkey;

pipeline scanFile

  begin

    stage S00 on origin :
        start
      | pulse once
      | checkTable lineitem
      | chunk      "../TPCH/SF_0001/lineitem.csv"   // read chunks of file => (seekOffset)
      | rdCsvChunk "../TPCH/SF_0001/lineitem.csv"   // (seekOffset) => (csvBuffer)
      | next localrobin

    stage S01 on all partitions on origin :
        toKeyHshRow_sf lineitem // (csvBuffer) => (rowBuffer w row+keyHash)
      //| toLglPtnRow lineitem // (rowBuffer) => (rowBuffer x logical partitions)
      //| toLglPtnNst          // (rowBuffer) => (rowBuffer w normalised strings)
      //| toLglPtnCrw          // (rowBuffer) => (crwBuffer x logical partitions)
      | next

   stage S02 on all partitions :
       indexJoin Orders IxO_ORDERKEY " BOUND $I1 $1 == "
       | combined  0
       | next

    stage S04 on origin :
      output
      | sink
      | first
 end ;
