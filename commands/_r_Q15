_r_schema

create index C_idx0  on customer (C_CUSTKEY  );
create index L_idx0  on lineitem (L_ORDERKEY );
create index N_idx0  on nation   (N_NATIONKEY);
create index O_idx0  on orders   (O_ORDERKEY );
create index P_idx0  on part     (P_PARTKEY  );
create index PS_idx0 on partsupp (PS_PARTKEY );
create index R_idx0  on region   (R_REGIONKEY);
create index S_idx0  on supplier (S_SUPPKEY  );

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimise
/glean_cue_from = "vS35X_T10_Push_sqB_Into_mqA"
/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_Q15"
create view revenue0 (supplier_no, total_revenue) as
	select
		l_suppkey,
		sum(l_extendedprice * (1 - l_discount))
	from
		lineitem where l_shipdate >= date '1996-01-01'
		and l_shipdate < date '1996-01-01' + interval '3' month
	group by
		l_suppkey;

select
	s_suppkey,
	s_name,
	s_address,
	s_phone,
	total_revenue
from
	supplier,
	revenue0
where
	s_suppkey = supplier_no
	and total_revenue = (
		select
			max(total_revenue)
		from
			revenue0
	)
order by
	s_suppkey;

drop view revenue0;

