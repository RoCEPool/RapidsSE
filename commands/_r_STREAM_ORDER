/*============================================================================*/
/* _r_STREAM_ORDER -- stream order test                                       */
/*============================================================================*/

trackMemory;

_r_schema

create index O_idx0  on Orders   (O_ORDERKEY );
create index L_idx0  on Lineitem (L_ORDERKEY );

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimise
/glean_cue_from = "vSeries_80_Index_Scan"
/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_JOIN_TWO_INDEX"
select o_orderkey, avg(l_extendedprice)
  from Orders, Lineitem
 where
       O_ORDERKEY = L_ORDERKEY
   and o_orderkey < 100
   and o_orderkey > 3
 group by O_ORDERKEY
 order by O_ORDERKEY
;

