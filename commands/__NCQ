/*============================================================================*/
/* __NCsub : Non-Correlated sub queries                                       */
/*============================================================================*/

print "Non-Correlated sub queries";

_lineitem
/time load lineitem "<tpch_dir>/lineitem.<suffix>";


// SELECT L_ORDERKEY from lineitem;

verbose enable;

pipeline __subquery0003
  begin
    stage stageStart on origin :
      start
      | pulse once
      | next

    stage stageMarker0889 on all partitions :
      scan rapidsse public lineitem
      //| project " type INTEGER as l_orderkey $1 "
      //| combined 0
      | next

    stage stageCreateTable on all nodes :
      createTableNC SQTBL
      | next

   stage stageToCrw on origin :
      dupCrw
      | next broadcast

   stage stageInsertTable on all nodes :
     insert SQTBL
     | next

    stage stageLast on origin :
      output
      | sink
      | first
  end ;

