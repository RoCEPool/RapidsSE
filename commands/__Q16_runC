print "Q16";

/******************************************************************************
Q16_0: select
         p_brand,
         p_type,
         p_size,
         count(distinct ps_suppkey) as supplier_cnt

  from PartSupp, Part
 
 where     p_partkey  =  ps_partkey
       and p_brand    <> 'Brand#45'
       and p_type     not like 'MEDIUM POLISHED%'
       and p_size     in (49,14,23,45,19,3,36,9)
       and ps_suppkey not in

             ( select s_suppkey

                 from Supplier
 
                where s_comment like '%Customer%Complaints%' )

 group by p_brand, p_type, p_size

 order by supplier_cnt desc, p_brand, p_type, p_size;
*******************************************************************************/

/*
/time pipeline Q16
begin

  stage G_Start on origin :
    start
    | pulse once
    | G_PART

  //
  // Q16_0:
  //   a) scan PartSupp  /PS_PARTKEY/  # _partkey    _suppkey
  //   b) join Part      /P_PARTKEY/   # _partkey
  //

  stage G_PART on all partitions :
    scan part
    | filter " type BOOLEAN P_BRAND 'Brand#45'  !=
               }  P_TYPE 'MEDIUM POLISHED%'  16 matchLeading  not and
               }  49  14  23  45  19  3  36  9  #8  P_SIZE in and  "

    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
               type INTEGER as P_SIZE P_SIZE"
                   | combined 0
    | next

  stage G_PARTSUPP on all partitions :
    indexJoin partsupp IxPS_PARTKEY "bound $I1 p_partkey =="
    | project "    type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                   type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                   type INTEGER as P_SIZE P_SIZE ,
                   type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY"
    | combined 0
    | next

  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

  stage G_CNT_P on all partitions :
    aggreg " groupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
             type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
             type INTEGER as P_SIZE P_SIZE ,
             type INTEGER as PS_SUPPKEY PS_SUPPKEY
             aggregates
             type VARCHAR ( 0 ) as P_BRAND $K1 ,
             type VARCHAR ( 0 ) as P_TYPE $K2 ,
             type INTEGER as P_SIZE $K3 ,
             type INTEGER as PS_SUPPKEY $K4 "
    | combined 0
    | next

  stage G_CNT_N on all nodes :
    aggreg " groupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                 type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                 type INTEGER as P_SIZE P_SIZE ,
                 type INTEGER as PS_SUPPKEY PS_SUPPKEY
                 aggregates
                  type VARCHAR ( 0 ) as P_BRAND $K1 ,
                  type VARCHAR ( 0 ) as P_TYPE $K2 ,
                  type INTEGER as P_SIZE $K3 ,
                  type INTEGER as PS_SUPPKEY $K4 "
    | combined 0
    | next

  stage G_CNT_O on origin :
    aggreg " groupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                   type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                   type INTEGER as P_SIZE P_SIZE ,
                   type INTEGER as PS_SUPPKEY PS_SUPPKEY
                   aggregates
                    type VARCHAR ( 0 ) as P_BRAND $K1 ,
                    type VARCHAR ( 0 ) as P_TYPE $K2 ,
                    type INTEGER as P_SIZE $K3 ,
                    type INTEGER as PS_SUPPKEY $K4 "
    | hash " type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast
    //| next

  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

  stage G_CNT_DISTINCT_A on all partitions :
     aggreg " groupBy type VARCHAR ( 0 ) P_BRAND ,
                      type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                      type INTEGER as P_SIZE P_SIZE
               aggregates
               type VARCHAR ( 0 ) as P_BRAND $K1 ,
               type VARCHAR ( 0 ) as P_TYPE $K2 ,
               type INTEGER as P_SIZE $K3 ,
               type INTEGER as SUPPLIER_CNT ) $4 COUNT"
  | combined 0
  | next

  stage G_CNT_DISTINCT_B on all nodes :
     aggreg " groupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                      type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                      type INTEGER as P_SIZE P_SIZE
               aggregates
                         type VARCHAR ( 0 ) as P_BRAND $K1 ,
                         type VARCHAR ( 0 ) as P_TYPE $K2 ,
                         type INTEGER as P_SIZE $K3 ,
                         type INTEGER as SUPPLIER_CNT ) $4 SUM"
| combined 0
| next

stage G_CNT_DISTINCT_C on origin :
   aggreg " groupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                         type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                         type INTEGER as P_SIZE P_SIZE
                  aggregates
                            type VARCHAR ( 0 ) as P_BRAND $K1 ,
                            type VARCHAR ( 0 ) as P_TYPE $K2 ,
                            type INTEGER as P_SIZE $K3 ,
                            type INTEGER as SUPPLIER_CNT ) $4 SUM"
| combined 0
| next

  stage G_Last on origin :
    output
    | sink
    | G_Start
    
end ;
*/

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarker2543 on all partitions :
    scan rapidsse public partsupp
    | next

  stage stageMarker2546 on all partitions :
    indexjoin Part IxP_PARTKEY "BOUND $I1 PS_PARTKEY =="  // J1 - PART
    | hash " type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage stageMarker2549 on all partitions :
    filter " type BOOLEAN  J1_P_BRAND 'Brand#45'  !=
                 }  J1_P_TYPE 'MEDIUM POLISHED%'  16 matchLeading  not and
                 }  49  14  23  45  19  3  36  9  #8  J1_P_SIZE in and"
    | keyNotExists SUPPLIER IxS_SUPPKEY  "BOUND $I1 $2 =="
               "type BOOLEAN  }  S_COMMENT '%Customer%Complaints%'  8 10 matchMiddle1"
    | aggreg " groupBy  type VARCHAR ( 0 ) as p_brand $9 ,
               type VARCHAR ( 0 ) as p_type $10 ,
               type INTEGER as p_size $11 ,
               type INTEGER as ps_suppkey $2
               aggregates
               type VARCHAR ( 0 )  as p_brand $K1 ,
               type VARCHAR ( 0 )  as p_type $K2 ,
               type INTEGER  as p_size $K3 ,
               type INTEGER  as ps_suppkey $K4 "
    | combined 0
    | next

  stage stageMarker2552 on all nodes :
    aggreg " groupBy  type VARCHAR ( 0 ) as p_brand $1 ,
                   type VARCHAR ( 0 ) as p_type $2 ,
                   type INTEGER as p_size $3 ,
                   type INTEGER as ps_suppkey $4
                   aggregates
                   type VARCHAR ( 0 )  as p_brand $K1 ,
                   type VARCHAR ( 0 )  as p_type $K2 ,
                   type INTEGER  as p_size $K3 ,
                   type INTEGER  as ps_suppkey $K4 "
    | combined 0
    | next

  stage stageMarker2555 on origin :
    aggreg " groupBy  type VARCHAR ( 0 ) as p_brand $1 ,
                   type VARCHAR ( 0 ) as p_type $2 ,
                   type INTEGER as p_size $3 ,
                   type INTEGER as ps_suppkey $4
                   aggregates
                   type VARCHAR ( 0 )  as p_brand $K1 ,
                   type VARCHAR ( 0 )  as p_type $K2 ,
                   type INTEGER  as p_size $K3 ,
                   type INTEGER  as ps_suppkey $K4 "
    | combined 0
    | next

stage stageMarker2555_b on origin :
    aggreg " groupBy  type VARCHAR ( 0 ) as p_brand $1 ,
                       type VARCHAR ( 0 ) as p_type $2 ,
                       type INTEGER as p_size $3
                       aggregates
                       type VARCHAR ( 0 )  as p_brand $K1 ,
                       type VARCHAR ( 0 )  as p_type $K2 ,
                       type INTEGER  as p_size $K3 ,
                       type INTEGER  as supplier_cnt ) $4 COUNT"
    | combined 0
    | next

  stage stageMarker2555_c on origin :
    sort " type INTEGER $4 DESC  ,
             type VARCHAR ( 0 ) as p_brand $1 ASC  ,
             type VARCHAR ( 0 ) as p_type $2 ASC  ,
             type INTEGER as p_size $3 ASC  "
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

