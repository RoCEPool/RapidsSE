/* _jm_q5 -- Query5                                                           */
/*============================================================================*/

// truncate metrics tables
truncate se__jobMetrics;
truncate se__jobOperands;
truncate se__jobOperators;

truncate se__jobNetwork;
truncate se__jobNetDissect;

truncate se__sysMetrics;
truncate se__sysLocks;

// enable metrics
metricsCtl enable;

///////////////////////
// QUERY 5

/time /jobMetrics
/weaved
select
  n_name,
  sum(l_extendedprice * (1 - l_discount)) as revenue
from customer,
  orders,
  lineitem,
  supplier,
  nation,
  region
where c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and l_suppkey = s_suppkey
  and c_nationkey = s_nationkey
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'ASIA'
  and o_orderdate >= '1994-01-01'
  and o_orderdate < '1995-01-01'
group by
  n_name
order by
  revenue desc;

// disable metrics
metricsCtl disable;

// sleep
sleep 30;

// generate system report data
sysReport;

print "-------------------------------------------";
print "NETWORK FOR QUERY 5.......................";

// get network data
select thisNodeName as thisNode,
     otherNodeName as otherNode,
     sum(sendCount)  as sCount,
     sum(sendBytes)  as sBytes,
     sum(recvCount)  as rCount,
     sum(recvBytes)  as rBytes
  from se__jobNetwork group by thisNodeName, otherNodeName;

print "-------------------------------------------";

