// --initial _r_Q20y

_r_schema

create index N_idx0  on Nation   (N_NATIONKEY);
create index P_idx0  on Part     (P_PARTKEY);
create index PS_idx0 on PartSupp (PS_PARTKEY);
create index PS_idx1 on PartSupp (PS_SUPPKEY);
create index S_idx0  on Supplier (S_SUPPKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimiser_trace
/transliterated
/weaved
/pipelineName = "_r_Q20y"
select s_name,
       s_address,
       n_name
  from Supplier
     , Nation
 where
       s_suppkey in
                    ( /* Q20_1 */
                      select ps_suppkey
                        from PartSupp
                       where
                             ps_partkey in
                                           ( /* Q20_1_1 */
                                             select p_partkey // tblSyn e
                                               from Part
                                              where p_name like 'forest%'
                                           )
                    )
   and
       s_nationkey = n_nationkey
   and
       n_name = 'IRAQ'
 order by s_name
;

