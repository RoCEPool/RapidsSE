// NOTE: trailing (null) in expr

create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE1_PCOL1 on table1(pcol1);
create index TABLE1_COLA1 on table1(cola1);
create index TABLE1_COLB1 on table1(colb1);
create index TABLE1_UCOL on table1(ucol);
create index TABLE1_UCOLVC on table1(ucolvc);
Load TABLE1 "../DATA/Load/tbl1data.csv" ;


// NOTE: Expr in TOP at stage S05 has $b.7

/weaved
/optimiser_trace
/pipeline_def
/pipelineName = "_ray158"
select ucolvc, cola1, colg1, cola1/colg1 from table1
   where cola1 / case when colg1 <= 0 then null else colg1 end > 5;

