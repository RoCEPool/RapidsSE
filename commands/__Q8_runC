/*============================================================================*/
/* __Q8_run                                                                   */
/*============================================================================*/

print "Q8";

/time pipeline Q8
begin

  stage first on origin :
    start
    | pulse once
    | next
    
  // ∀ ORDERS /O_CUSTKEY/ π _custkey _orderkey
  stage Gs_O_u on all partitions :
    scan Orders
    | filter 2
        "O_ORDERDATE timestamp '1995-01-01 00:00:00' >=
         O_ORDERDATE timestamp '1996-12-31 00:00:00' <
         and"
    | project 2 expr
        type INTEGER as _custkey  O_CUSTKEY ,
        type INTEGER as _orderkey O_ORDERKEY
    | combined 0
    | next

//UC

  // ⋈ CUSTOMER /C_CUSTKEY/ _custkey π _orderkey
  stage Gj_C_h on all partitions :
    indexJoin 2 Customer IxC_CUSTKEY expr bound $I1 _custkey ==
    | project 2 expr
        type INTEGER as _orderkey _orderkey
    | hash 2 expr type INTEGER _orderkey
    | combined 0
    | next hashcast
    
//HC

  // ⋈ LINEITEM /L_ORDERKEY/ _orderkey π _suppkey
  stage Gj_L_h on all partitions :
    indexJoin 2 Lineitem IxL_ORDERKEY expr bound $I1 _orderkey ==
    | project 2 expr
        type INTEGER as _partkey J1_L_PARTKEY ,
        type INTEGER as _suppkey J1_L_SUPPKEY
    | hash 2 expr type INTEGER _partkey
    | combined 0
    | next hashcast
    
//HC

  // ⋈ PART /P_PARTKEY/ _partkey π _suppkey
  stage Gj_P_h on all partitions :
    indexJoin 2 Part IxP_PARTKEY expr bound $I1 _partkey ==
    | filter 2
        "J1_P_TYPE 'ECONOMY ANODIZED STEEL' =="
    | project 2 expr
        type INTEGER as _suppkey _suppkey
    | hash 2 expr type INTEGER _suppkey
    | combined 0
    | next hashcast

//HC

  // ⋈ SUPPLIER _suppkey π _suppkey
  stage Gj_S_u  on all partitions :
    indexJoin 2 Supplier IxS_SUPPKEY expr bound $I1 _suppkey ==
    | project 2 expr
        type INTEGER as _suppkey _suppkey
    | combined 0
    | next

  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

  stage G_AGG_P on all partitions :
    project 2 " type INTEGER as x_rowCntPtn )  countAll  "
    | combined 0
    | next
    
  stage G_AGG_N on all nodes :
    project 2 " type INTEGER as x_rowCntNode )  x_rowCntPtn sum  "
    | combined 0
    | next
    
  stage G_AGG_O on origin :
    project 2 " type INTEGER as x_rowCntOrigin )  x_rowCntNode sum  "
    | combined 0
    | next

  stage last on origin :
    output
    | sink
    | first

end ;

/******************************************************************************

Q08_A: select
         o_year,
         sum(case when Nation = 'BRAZIL'
                  then volume
                  else 0
             end) / sum(volume) as mkt_share

  from

       ( Q08_0: select extract(year from o_orderdate)     as o_year,
                      l_extendedprice * (1 - l_discount) as volume,
                      n2.n_name                          as Nation

           from Part, Supplier, LineItem, Orders, Customer,
                Nation n1, Nation n2, Region

          where     p_partkey      =  l_partkey
                and s_suppkey      =  l_suppkey
                and l_orderkey     =  o_orderkey
                and o_custkey      =  c_custkey
                and c_nationkey    =  n1.n_nationkey
                and n1.n_regionkey =  r_regionkey
                and r_name         =  'AMERICA'
                and s_nationkey    =  n2.n_nationkey
                and o_orderdate    >= '1995-01-01'
                and o_orderdate    <= '1996-12-31'
                and p_type         = 'ECONOMY ANODIZED STEEL' ) as all_nations

 group by o_year

 order by o_year;
 
*******************************************************************************/

