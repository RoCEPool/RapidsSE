/*============================================================================*/
/* __Q17_run                                                                  */
/*============================================================================*/

print "Q17";

/******************************************************************************
Q17_0: select
         sum(l_extendedprice) / 7.0 as avg_yearly

  from LineItem, Part
 
 where     p_partkey   = l_partkey
       and p_brand     = 'Brand#23'
       and p_container = 'MED BOX'
       and l_quantity  <

             ( select 0.2 * avg(l_quantity)

                 from LineItem

                where L_PARTKEY = P_PARTKEY );
*******************************************************************************/

/time pipeline Q17
begin

  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageQ17_0 on all partitions :
    scan rapidsse public part
    | filter " type BOOLEAN  $4 'Brand#23'  ==  $7 'MED BOX'  ==  and  "
    | project " type INTEGER as P_PARTKEY $1 "
    | combined 0
    | next broadCast

  stage stageQ17_1_a on all partitions :
    indexJoin lineitem IxL_PARTKEY "bound $I1 $L1 =="
    | ordagg " ordgroupBy type integer $1 aggregates type integer as P_PARTKEY $K1 , type DECIMAL )  $6 sum  , type INTEGER )  $6 count  "
    | combined 0
    | next

  stage stageQ17_1_b on all nodes :
    aggreg " groupBy type integer $1 aggregates type integer as P_PARTKEY $K1 , type DECIMAL )  $2 sum  , type INTEGER )  $3 sum  "
    | combined 0
    | next

  stage stageQ17_1_c on origin :
    aggreg " groupBy type integer $1 aggregates type integer as P_PARTKEY $K1 , type DECIMAL ) $2 sum , type INTEGER ) $3 sum "
    | combined 0
    | next

  stage stageQ17_1_d on origin :
    project " type integer as P_PARTKEY $1 , type DECIMAL as AV $2 $3 casttype DECIMAL cast / "
    | combined 0
    | next broadcast

  stage stageQ17_2_a on all partitions :
    indexJoin lineitem IxL_PARTKEY "bound $I1 $L1 =="
    | filter " type BOOLEAN  $7 $2 <  "
    | project " type decimal as avg_yearly ) $8 sum  "
    | combined 0
    | next

  stage stageQ17_2_b on all nodes :
    project " type decimal as avg_yearly ) $1 sum  "
    | combined 0
    | next

   stage stageQ17_2_c on origin :
    //project " type integer as avg_yearly ) $1 sum"
    project " type DECIMAL as avg_yearly ) $1 sum 7.0 / "
    | combined 0
    | stageLast

  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
