/*============================================================================*/
/* __Q11_SUPPLIER                                                             */
/*============================================================================*/

/optimise_passthru
pipeline Query11
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan supplier
    | project " type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY ,
                type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY"
    | combined 0
    | next broadcast

 stage S02 on all partitions:
    indexJoin partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | project "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
               type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST"
    | indexJoin nation IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | project "type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type VARCHAR ( 0 ) as N_NAME N_NAME"
    | filter " type BOOLEAN N_NAME 'GERMANY'  ==  "
    | aggreg " type DECIMAL ( 19  2 ) )  PS_SUPPLYCOST PS_AVAILQTY casttype DECIMAL ( 19  2 ) CAST  *  sum  "
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg " type DECIMAL ( 19  2 ) as INNERRESULT )  $1 sum  "
    | combined 0
    | next

  stage S04 on origin :
    aggreg " type DECIMAL ( 19  2 ) as INNERRESULT )  $1 sum"
    | combined 0
    | next

  stage S05 on origin :
    aggreg " type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT 0.00001  *  "
    | combined 0
    | next broadcast

  stage S06 on all partitions  multiple threads 4:
    indexJoin nation IxN_NATIONKEY "bound $I1"
    | project " type VARCHAR ( 0 ) as N_NAME N_NAME ,
                type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
                type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT"
    | filter " type BOOLEAN N_NAME 'GERMANY'  ==  "
    | project " type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
                type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT"
    | indexJoin supplier IxS_NATIONKEY "bound $I1 N_NATIONKEY =="
    | project " type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY ,
                type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next broadcast

  stage S07 on all partitions :
    indexJoin partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | gbyAgg " GroupBy    type INTEGER ( 19 ) PS_PARTKEY
               aggregates
                          type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as VALUE ) PS_SUPPLYCOST PS_AVAILQTY casttype DECIMAL ( 19  2 ) CAST  *  sum  ,
                          type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S08 on all nodes :
    gbyAgg " GroupBy    type INTEGER ( 19 ) PS_PARTKEY
             aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                        type DECIMAL ( 19  2 ) as VALUE ) VALUE sum  ,
                        type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S09 on origin :
    gbyAgg " GroupBy    type INTEGER ( 19 ) PS_PARTKEY
             aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                        type DECIMAL ( 19  2 ) as VALUE ) VALUE sum  ,
                        type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S10 on origin :
    filter " type BOOLEAN  value INNERRESULT  >  "
    | project " type INTEGER ( 19 ) as PS_PARTKEY PS_PARTKEY ,
                type DECIMAL ( 19  2 ) as VALUE VALUE"
    | sort " type DECIMAL ( 19  2 ) VALUE DESC  "
    | combined 0
    | next

  stage S11 on origin :
    output
    | sink
    | first
end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
