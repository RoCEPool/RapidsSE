/*============================================================================*/
/* __Q5_OCLSNR_2                                                              */
/*============================================================================*/

/optimise_passthru
pipeline Query5
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions:
    scan Region
    | project "type INTEGER ( 19 ) as R_REGIONKEY R_REGIONKEY ,
               type VARCHAR ( 0 ) as R_NAME R_NAME"
    | filter " type BOOLEAN R_NAME 'ASIA'  ==  "
    | indexJoin Nation IxN_REGIONKEY expr "bound $I1 R_REGIONKEY =="
    | project "type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
               type VARCHAR ( 0 ) as N_NAME N_NAME "
    | combined 0
    | next

stage S03 on all partitions :
   indexJoin Customer IxC_NATIONKEY "BOUND $I1 N_NATIONKEY =="
   | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
              type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
              type VARCHAR ( 0 ) as N_NAME N_NAME"
   | indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
   | project "type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
              type VARCHAR ( 0 ) as N_NAME N_NAME ,
              type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
              type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE"
   | filter " type BOOLEAN O_ORDERDATE DATE '1994-01-01'  >=
                           O_ORDERDATE DATE '1995-01-01'  <  and  "
   | hash "type INTEGER ( 19 ) O_ORDERKEY"
   | combined 0
   | next hashcast

 stage S02 on all partitions multiple threads 4:
    indexJoin Lineitem IxL_ORDERKEY "bound $I1 O_ORDERKEY =="
    | project "type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
               type VARCHAR ( 0 ) as N_NAME N_NAME ,
               type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
               type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT"
    | hash "type INTEGER ( 19 ) L_SUPPKEY"
    | combined 0
    | next hashcast

 stage S02 on all partitions:
    indexJoin Supplier IxS_SUPPKEY expr "bound $I1 L_SUPPKEY =="
    | project "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
               type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
               type VARCHAR ( 0 ) as N_NAME N_NAME ,
               type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT"
    | filter " type BOOLEAN N_NATIONKEY S_NATIONKEY == "
    | gbyAgg " GroupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
                        type DECIMAL ( 19  2 ) as REVENUE )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  "
    | combined 0
    | next

  stage S06 on all nodes :
    gbyAgg " GroupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
                        type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  "
    | combined 0
    | next

  stage S07 on origin :
    gbyAgg " GroupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
             type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  "
    | combined 0
    | next

  stage S08 on origin :
    sort " type DECIMAL ( 19  2 ) REVENUE DESC  "
    | combined 0
    | next

  stage S09 on origin :
    output
    | sink
    | first
end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
