/keepCodeFile
/pipeline_def
/weaved
/optimise_passthru
pipeline XYZ
  begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan LINEITEM
    | project "type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY"
    //| filter "type boolean l_ORDERKEY 3 <"
    | globalHash ORDERS GxO_ORDERKEY "type INTEGER ( 19 ) L_ORDERKEY"
    | combined 0
    | next hashcast

  // L_ORDERKEY , rrf
  stage S02 on all partitions :
    rrfJoin ORDERS "type INTEGER ( 19 ) L_ORDERKEY"
    //indexJoin ORDERS IxO_ORDERKEY " BOUND $I1 L_ORDERKEY == "
    | project "type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
               type DATE as O_ORDERDATE O_ORDERDATE"
    | combined 0
    | next

  stage S03 on all partitions :
    sort " type INTEGER ( 19 ) L_ORDERKEY  "
    | combined 0
    | next

  stage S04 on all nodes :
    sort " type INTEGER ( 19 ) L_ORDERKEY  "
    | combined 0
    | next

  stage S05 on origin :
    sort " type INTEGER ( 19 ) L_ORDERKEY  "
    | combined 0
    | next

  stage S06 on origin :
    output
    | sink
    | first
  end ;

