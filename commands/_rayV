    | top "type DATE $2" 2
    | combined 0
    | next
    /*
  stage stageB on all nodes :
    top "type DATE $2" 2
    | combined 0
    | next
  stage stageC on origin :
    top "type DATE $2" 2
    | combined 0
    | next
    */
  stage stageLast on origin :
    output
    | sink
    | first
end ;

