/*============================================================================*/
/* __Q21                                                                      */
/*============================================================================*/

/keepCodeFile
/optimise_passthru
pipeline Query21
begin
  stage S00 on origin :
    start
    | pulse once
    | next

stage S01 on all partitions :
    scan Orders
    | project " type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type VARCHAR ( 0 ) as O_ORDERSTATUS O_ORDERSTATUS"
    | filter " type BOOLEAN  O_ORDERSTATUS 'F'  == "
    | project " type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY "
    | hash " type INTEGER ( 19 ) O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S02 on all partitions multiple threads 4:
    indexJoin lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | project " type INTEGER ( 19 ) as L1_ORDERKEY L_ORDERKEY ,
                type INTEGER ( 19 ) as L1_SUPPKEY L_SUPPKEY ,
                type DATE ( 0 ) as L_RECEIPTDATE L_RECEIPTDATE ,
                type DATE ( 0 ) as L_COMMITDATE L_COMMITDATE"
    | filter " type BOOLEAN  L_RECEIPTDATE L_COMMITDATE > "
    | project " type INTEGER ( 19 ) as L1_ORDERKEY L1_ORDERKEY ,
                type INTEGER ( 19 ) as L1_SUPPKEY L1_SUPPKEY "
    | hash " type INTEGER ( 19 ) L1_SUPPKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin Supplier IxS_SUPPKEY "BOUND $I1 L1_SUPPKEY =="
    | project " type INTEGER ( 19 ) as L1_ORDERKEY L_ORDERKEY ,
                type INTEGER ( 19 ) as L1_SUPPKEY L_SUPPKEY ,
                type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type VARCHAR ( 0 ) as S_NAME S_NAME "
    | hash " type INTEGER ( 19 ) L1_ORDERKEY"
    | combined 0
    | next hashcast

  stage S04 on all partitions :
    keyExists lineitem IxL_ORDERKEY  "BOUND $I1 L1_ORDERKEY =="
       "type BOOLEAN L1_SUPPKEY L_SUPPKEY != "
    | combined 0
    | next

  stage S05 on all partitions :
    keyNotExists lineitem IxL_ORDERKEY  "BOUND $I1 L1_ORDERKEY =="
       "type BOOLEAN L1_SUPPKEY L_SUPPKEY !=
                     L_RECEIPTDATE L_COMMITDATE > and"
    | project " type INTEGER ( 19 ) as L1_SUPPKEY L1_SUPPKEY  ,
               type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
               type VARCHAR ( 0 ) as S_NAME S_NAME "
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin Nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | filter " type BOOLEAN N_NAME 'SAUDI ARABIA' ==  "
    | ordAgg " ordGroupBy    type VARCHAR ( 0 ) as S_NAME S_NAME
               aggregates type VARCHAR ( 0 ) as S_NAME $K1 ,
                          type INTEGER ( 19 ) )  countAll  "
    | combined 0
    | next

  stage S05 on all nodes :
    gbyAgg " groupBy  type VARCHAR ( 0 ) as S_NAME $1
      aggregates  type VARCHAR ( 0 ) as S_NAME $K1 ,
                  type INTEGER ( 19 ) )  $2 sum  "
    | combined 0
    | next

  stage S06 on origin :
    gbyAgg " groupBy  type VARCHAR ( 0 ) as S_NAME $1
       aggregates  type VARCHAR ( 0 ) as S_NAME $K1 ,
                   type INTEGER ( 19 ) as numwait )  $2 sum  "
    | combined 0
    | next
/*
  stage S05 on all partitions :
      sort " type INTEGER ( 19 ) $2 DESC  ,
             type VARCHAR ( 0 ) as s_name $1 ASC  "
      | combined 0
      | next
*/
  stage S05 on origin :
    sort " type INTEGER ( 19 ) $2 DESC  , type VARCHAR ( 0 ) as s_name $1 ASC  "
    | combined 0
    | next

  stage S07 on origin :
    output
    | sink
    | first
end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
