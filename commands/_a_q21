////// NOT WORKING YET !!!!

pipeline Query21
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public Lineitem
    | filter " type BOOLEAN  $13 $12 > "
    | project " type INTEGER as L_ORDERKEY $1 , type INTEGER as L_SUPPKEY $3 "
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY "BOUND $I1 L_ORDERKEY =="
    | filter " type BOOLEAN  J1_L_SUPPKEY L_SUPPKEY  != "
    | aggreg " groupBy type integer L_ORDERKEY ,
                       type integer L_SUPPKEY
               aggregates type integer as L_ORDERKEY $K1 ,
                          type integer as L_SUPPKEY $K2"
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin Orders IxO_ORDERKEY "BOUND $I1 L_ORDERKEY =="
    | filter " type BOOLEAN  J1_O_ORDERSTATUS 'F'  == "
    | project " type INTEGER as L_SUPPKEY L_SUPPKEY "
    | combined 0
    | next

  stage S03 on all partitions :
    indexJoin Supplier IxS_SUPPKEY "BOUND $I1 L_SUPPKEY =="
    | project " type INTEGER as S_NATIONKEY J1_S_NATIONKEY , type VARCHAR ( 0 ) as S_NAME J1_S_NAME "
    //| hash "type INTEGER S_NATIONKEY"
    | combined 0
    | next //hashcast

  stage S04 on all partitions :
    indexJoin Nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | filter " type BOOLEAN J1_N_NAME 'SAUDI ARABIA' ==  "
    | aggreg " groupBy  type VARCHAR ( 0 ) as S_NAME $2 aggregates  type VARCHAR ( 0 ) $K1 , type INTEGER )  countAll  "
    | combined 0
    | next

  stage S05 on all nodes :
    aggreg " groupBy  type VARCHAR ( 0 ) as s_name $1 aggregates  type VARCHAR ( 0 ) $K1 , type INTEGER )  $2 sum  "
    | combined 0
    | next

  stage S06 on origin :
    aggreg " groupBy  type VARCHAR ( 0 ) as s_name $1 aggregates  type VARCHAR ( 0 ) $K1 , type INTEGER as numwait )  $2 sum  "
    | combined 0
    | next

  stage S05 on all nodes :
    sort " type VARCHAR ( 0 ) as s_name $1 ASC  "
    //sort " type INTEGER $2 DESC  , type VARCHAR ( 0 ) as s_name $1 ASC  "
    //| limit 100
    | combined 0
    | next

stage S05 on all nodes :
    sort " type INTEGER s_nationkey "
    //sort " type INTEGER $2 DESC  , type VARCHAR ( 0 ) as s_name $1 ASC  "
    //| limit 100
    | combined 0
    | next
  stage S07 on origin :
    output
    | sink
    | first
end ;

