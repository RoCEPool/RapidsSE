//////////////
//QUERY 1
/////////////

print "RUNNING QUERY1";

/time pipeline Query1
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public lineitem
    | filter " type BOOLEAN  $11 DATE '1998-10-01'  <=  "
    | aggreg " groupBy  type VARCHAR L_RETURNFLAG , type VARCHAR L_LINESTATUS aggregates type VARCHAR as L_RETURNFLAG $K1 , type VARCHAR as L_LINESTATUS $K2 , type DECIMAL ) as SUM_QTY L_QUANTITY sum  , type DECIMAL ) as SUM_BASE_PRICE L_EXTENDEDPRICE sum  , type DECIMAL ) as SUM_DISC_PRICE L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  , type DECIMAL ) as SUM_CHARGE L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  1.  L_TAX +  *  sum  , type INTEGER ) L_EXTENDEDPRICE count  , type INTEGER ) L_QUANTITY count  , type DECIMAL ) L_DISCOUNT sum  , type INTEGER ) L_DISCOUNT count  , type INTEGER ) countAll  "
    | combined 0
    | next

  stage S02 on all nodes :
    aggreg " groupBy  type VARCHAR L_RETURNFLAG , type VARCHAR L_LINESTATUS aggregates type VARCHAR as L_RETURNFLAG $K1 , type VARCHAR as L_LINESTATUS $K2 , type DECIMAL as SUM_QTY ) SUM_QTY sum , type DECIMAL as SUM_BASE_PRICE ) SUM_BASE_PRICE sum , type DECIMAL as SUM_DISC_PRICE ) SUM_DISC_PRICE sum , type DECIMAL as SUM_CHARGE ) SUM_CHARGE sum , type INTEGER ) $7 sum , type INTEGER ) $8 sum , type DECIMAL ) $9 sum , type INTEGER ) $10 sum , type INTEGER ) $11 sum "
    | combined 0
    | next

  stage S03 on origin :
    aggreg " groupBy  type VARCHAR L_RETURNFLAG , type VARCHAR L_LINESTATUS aggregates type VARCHAR as L_RETURNFLAG $K1 , type VARCHAR as L_LINESTATUS $K2 , type DECIMAL as SUM_QTY ) SUM_QTY sum , type DECIMAL as SUM_BASE_PRICE ) SUM_BASE_PRICE sum , type DECIMAL as SUM_DISC_PRICE ) SUM_DISC_PRICE sum , type DECIMAL as SUM_CHARGE ) SUM_CHARGE sum , type INTEGER ) $7 sum , type INTEGER ) $8 sum , type DECIMAL ) $9 sum , type INTEGER ) $10 sum , type INTEGER as COUNT_ORDER ) $11 sum"
    | combined 0
    | next

  stage S04 on origin :
    project " type VARCHAR as L_RETURNFLAG L_RETURNFLAG , type VARCHAR as L_LINESTATUS L_LINESTATUS , type DECIMAL as SUM_QTY SUM_QTY , type DECIMAL as SUM_BASE_PRICE SUM_BASE_PRICE , type DECIMAL as SUM_DISC_PRICE SUM_DISC_PRICE , type DECIMAL as SUM_CHARGE SUM_CHARGE , type DECIMAL as AVG_QTY SUM_QTY $8 casttype DECIMAL CAST  / , type DECIMAL as AVG_PRICE SUM_BASE_PRICE $7 casttype DECIMAL CAST  / , type DECIMAL as AVG_DISC $9 $10 casttype DECIMAL CAST  / , type INTEGER as COUNT_ORDER COUNT_ORDER "
    | sort " type VARCHAR as L_RETURNFLAG L_RETURNFLAG ASC , type VARCHAR as L_LINESTATUS L_LINESTATUS ASC  "
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;

//////////////
//QUERY 4
/////////////

print "RUNNING QUERY4";

/time pipeline Query4
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan orders
    | filter " type BOOLEAN O_ORDERDATE DATE '1993-07-01' >= O_ORDERDATE DATE '1993-10-01' < and "
    | project "type INTEGER as O_ORDERKEY O_ORDERKEY , type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY"
    | combined 0
    | next

  stage S02 on all partitions :
    keyExists lineitem IxL_ORDERKEY  "BOUND $I1 O_ORDERKEY ==" "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
    | combined 0
    | next

  stage S03 on all partitions :
    aggreg "groupby type VARCHAR O_ORDERPRIORITY aggregates type VARCHAR as O_ORDERPRIORITY $K1 , type INTEGER as ORDER_COUNT ) countAll"
    | combined 0
    | next

  stage S04 on all nodes :
    aggreg "groupby type VARCHAR O_ORDERPRIORITY aggregates type VARCHAR as O_ORDERPRIORITY $K1 , type INTEGER as ORDER_COUNT ) ORDER_COUNT sum"
    | combined 0
    | next

  stage S05 on origin :
    aggreg "groupby type VARCHAR O_ORDERPRIORITY aggregates type VARCHAR as O_ORDERPRIORITY $K1 , type INTEGER as ORDER_COUNT ) ORDER_COUNT sum"
    | combined 0
    | next

  stage S06 on origin :
    output
    | sink
    | first
end ;

//////////////
//QUERY 6
/////////////

print "RUNNING QUERY6";

/time pipeline Query6
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     indexscan lineitem IxL_SHIPDATE "LBOUND $I1 DATE '1994-01-01' >= UBOUND $I1 DATE '1995-01-01' <"
     | filter " type BOOLEAN  }  0.05 0.07 L_DISCOUNT between L_QUANTITY 24. < and"
     | project " type DECIMAL as REVENUE ) L_EXTENDEDPRICE L_DISCOUNT *  sum  "
     | combined 0
     | next

   stage S02 on all nodes :
     project " type DECIMAL as REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S03 on origin :
     project " type DECIMAL as REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S04 on origin :
     output
     | sink
     | first
end ;

