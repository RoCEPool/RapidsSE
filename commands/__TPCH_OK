//////////////
//QUERY 17
/////////////

print "RUNNING QUERY17";

/time pipeline Query17
begin
  stage S00 on origin :
    start
    | pulse once
    | next

 stage S01 on all partitions :
     scan rapidsse public part
     | filter " type BOOLEAN  P_BRAND 'Brand#23'  ==  P_CONTAINER 'MED BOX'  ==  and"
     | project "type INTEGER as P_PARTKEY P_PARTKEY"
     | combined 0
     | next broadcast

  stage S02 on all partitions :
    indexJoin lineitem IxL_PARTKEY "bound $I1 P_PARTKEY =="
    | ordagg " ordgroupBy type integer P_PARTKEY aggregates type integer as P_PARTKEY $K1 , type DECIMAL )  J1_L_QUANTITY sum  , type INTEGER )  J1_L_QUANTITY count  "
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg " groupBy type integer P_PARTKEY aggregates type integer as P_PARTKEY $K1 , type DECIMAL )  $2 sum  , type INTEGER )  $3 sum  "
    | combined 0
    | next

  stage S04 on origin :
    aggreg " groupBy type integer P_PARTKEY aggregates type integer as P_PARTKEY $K1 , type DECIMAL )  $2 sum  , type INTEGER )  $3 sum  "
    | combined 0
    | next

  stage S05 on origin :
    project " type integer as P_PARTKEY P_PARTKEY , type DECIMAL as AV $2 $3 casttype DECIMAL cast / 0.2 *"
    | combined 0
    | next broadcast

  stage S06 on all partitions :
    indexJoin lineitem IxL_PARTKEY "bound $I1 $L1 =="
    | filter " type BOOLEAN  J1_L_QUANTITY AV <  "
    | project " type decimal as avg_yearly ) J1_L_EXTENDEDPRICE sum  "
    | combined 0
    | next

  stage S07 on all nodes :
    project " type decimal as avg_yearly ) $1 sum  "
    | combined 0
    | next

  stage S08 on origin :
    project " type DECIMAL as avg_yearly ) $1 sum 7.0 / "
    | combined 0
    | next

  stage S09 on origin :
    output
    | sink
    | first
end ;

//////////////
//QUERY 18
/////////////

print "RUNNING QUERY18";

/time pipeline Query18
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
      indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
     | ordAgg " ordgroupBy  type INTEGER as L_ORDERKEY L_ORDERKEY aggregates type INTEGER as L_ORDERKEY $K1 , type DECIMAL as SUM_QTY )  L_QUANTITY sum  "
     | filter  " type BOOLEAN  SUM_QTY 300.00  >  "
     | combined 0
     | next

   stage S02 on all partitions :
     indexJoin orders IxO_ORDERKEY "bound $I1 $L1 =="
     | project "type INTEGER as O_CUSTKEY J1_O_CUSTKEY , type INTEGER as O_ORDERKEY J1_O_ORDERKEY , type DATE as O_ORDERDATE J1_O_ORDERDATE , type DECIMAL as O_TOTALPRICE J1_O_TOTALPRICE , type DECIMAL as SUM_QTY SUM_QTY "
     | combined 0
     | next

   stage S03 on all partitions :
     indexJoin customer IxC_CUSTKEY "bound $I1 $L1 =="
     | project "type VARCHAR as C_NAME J1_C_NAME , type INTEGER as C_CUSTKEY J1_C_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY , type DATE as O_ORDERDATE O_ORDERDATE , type DECIMAL as O_TOTALPRICE O_TOTALPRICE , type DECIMAL as SUM_QTY SUM_QTY "
     | combined 0
     | next

   stage S04 on all partitions :
     aggreg " groupBy  type VARCHAR as C_NAME C_NAME , type INTEGER as C_CUSTKEY C_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY , type DATE as O_ORDERDATE O_ORDERDATE , type DECIMAL as O_TOTALPRICE O_TOTALPRICE aggregates type VARCHAR as C_NAME $K1 , type INTEGER as C_CUSTKEY $K2 , type INTEGER as O_ORDERKEY $K3 , type DATE as O_ORDERDATE $K4 , type DECIMAL as O_TOTALPRICE $K5 , type DECIMAL as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S05 on all nodes :
     aggreg " groupBy  type VARCHAR as C_NAME C_NAME , type INTEGER as C_CUSTKEY C_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY , type DATE as O_ORDERDATE O_ORDERDATE , type DECIMAL as O_TOTALPRICE O_TOTALPRICE aggregates type VARCHAR as C_NAME $K1 , type INTEGER as C_CUSTKEY $K2 , type INTEGER as O_ORDERKEY $K3 , type DATE as O_ORDERDATE $K4 , type DECIMAL as O_TOTALPRICE $K5 , type DECIMAL as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S06 on origin :
     aggreg " groupBy  type VARCHAR as C_NAME C_NAME , type INTEGER as C_CUSTKEY C_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY , type DATE as O_ORDERDATE O_ORDERDATE , type DECIMAL as O_TOTALPRICE O_TOTALPRICE aggregates type VARCHAR as C_NAME $K1 , type INTEGER as C_CUSTKEY $K2 , type INTEGER as O_ORDERKEY $K3 , type DATE as O_ORDERDATE $K4 , type DECIMAL as O_TOTALPRICE $K5 , type DECIMAL as SUM_QTY ) SUM_QTY sum  "
     | combined 0
     | next

   stage S07 on origin :
     sort " type DECIMAL as O_TOTALPRICE O_TOTALPRICE ASC  , type DATE as O_ORDERDATE O_ORDERDATE ASC  "
     | limit 100
     | combined 0
     | next

   stage S08 on origin :
     output
     | sink
     | first
 end ;