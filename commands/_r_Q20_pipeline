/* _r_Q20_pipeline -- TCPH query 20 test                                      */
/*============================================================================*/

// --initial _r_Q20

_r_schema

create index L_idx0  on Lineitem (L_PARTKEY);
create index PS_idx0 on PartSupp (PS_SUPPKEY);
create index S_idx0 on Supplier (S_SUPPKEY);
create index N_idx0 on Nation (N_NATIONKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

explain stage transliterate
select s_name,
       s_address
  from Supplier,
       Nation
 where s_suppkey in (
                      select ps_suppkey
                        from PartSupp
                       where
                             ps_partkey in (
                                                 select p_partkey
                                                   from Part
                                                  where p_name like 'forest%'
                                               )
                         and
                             ps_availqty > (
                                             select 0.5 * sum(l_quantity)
                                               from LineItem
                                              where L_PARTKEY = PS_PARTKEY
                                                and L_SUPPKEY = PS_SUPPKEY
                                                and l_shipdate >= '1994-01-01'
                                                and l_shipdate < '1995-01-01'
                                           )
                    )
   and s_nationkey = n_nationkey
   and n_name = 'IRAQ'
 order by s_name
;

/*
select s_name,
       s_address
  from Supplier
 where s_suppkey in (
                      select ps_suppkey
                        from PartSupp
                       where
                             ps_partkey in (
                                                 select p_partkey
                                                   from Part
                                                  where p_name like 'forest%'
                                               )
                         and
                             ps_availqty > (
                                             select 0.5 * sum(l_quantity)
                                               from LineItem
                                              where L_PARTKEY = PS_PARTKEY
                                                and L_SUPPKEY = PS_SUPPKEY
                                                and l_shipdate >= '1994-01-01'
                                                and l_shipdate < '1995-01-01'
                                           )
                    )

 order by s_name
;

*/
pipeline unamed
begin

  //SQY
    stage S00 on origin :
      start
      | pulse once
      | next

    stage S01 on all partitions :
      scan rapidsse public Part
      | filter " type BOOLEAN  }  $2 'forest%'  7 matchLeading "
      | project " type INTEGER as p_partkey $1 "
      | combined 0
      | next

  //SQY
    stage S02 on all partitions :
      indexJoin lineitem L_idx0 "BOUND $I1 P_PARTKEY =="
      | filter " type BOOLEAN  J1_L_SHIPDATE DATE '1994-01-01' >= J1_L_SHIPDATE DATE '1995-01-01'  <  and  "
      | aggreg " groupBy  type integer P_PARTKEY ,
                          type integer J1_L_SUPPKEY
                       aggregates type integer as P_PARTKEY $K1 ,
                                  type integer as L_SUPPKEY $K2 ,
                                  type DECIMAL )  $6 sum"
      | combined 0
      | next

    stage S03 on all nodes :
      aggreg " groupBy type integer P_PARTKEY ,
                       type integer L_SUPPKEY
                  aggregates type integer as P_PARTKEY $K1 ,
                             type integer as L_SUPPKEY $K2 ,
                             type DECIMAL )  $3 sum"
      | combined 0
      | next

    stage S04 on origin :
      aggreg " groupBy type integer P_PARTKEY ,
                       type integer L_SUPPKEY
                   aggregates type integer as P_PARTKEY $K1 ,
                              type integer as L_SUPPKEY $K2 ,
                              type DECIMAL )  $3 sum"
      | combined 0
      | next

    stage S05 on origin :
      project " type integer as P_PARTKEY P_PARTKEY , type integer as L_SUPPKEY L_SUPPKEY , type DECIMAL as sqyResult 0.5  $3 *  "
      | hash "type INTEGER L_SUPPKEY"
      | combined 0
      | next hashcast

   stage S06 on all partitions :
     indexJoin partSupp PS_idx0 "BOUND $I1 L_SUPPKEY =="
     | filter " type BOOLEAN P_PARTKEY J1_PS_PARTKEY == J1_PS_AVAILQTY casttype DECIMAL CAST sqyResult  > and "
     | project " type INTEGER as PS_SUPPKEY $2"
     | combined 0
     | next

   stage S06a on all partitions :
     aggreg " groupBy type integer PS_SUPPKEY
                        aggregates type integer as PS_SUPPKEY $K1"
     | combined 0
     | next

  stage S07 on all partitions :
    indexJoin Supplier S_idx0 "BOUND $I1 PS_SUPPKEY =="
    | project " type INTEGER as S_NATIONKEY J1_S_NATIONKEY , type VARCHAR as S_NAME J1_S_NAME , type VARCHAR as S_ADDRESS J1_S_ADDRESS"
    | combined 0
    | next

  stage S08 on all partitions :
    indexJoin Nation N_idx0 "BOUND $I1 S_NATIONKEY =="
    | filter " type BOOLEAN J1_N_NAME 'CANADA' ==  "
    | project " type VARCHAR as N_NAME J1_N_NAME , type VARCHAR as S_NAME S_NAME , type VARCHAR as S_ADDRESS S_ADDRESS "
    | sort " type VARCHAR S_NAME ASC  "
    | combined 0
    | next

  stage stageMarker1680 on origin :
    sort " type VARCHAR S_NAME ASC  "
    | combined 0
    | next

  stage S07 on origin :
    output
    | sink
    | first
end ;

