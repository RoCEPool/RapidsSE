__TPCH_SCHEMA_LOAD_SF0001
//__TPCH_SCHEMA_LOAD_SF1
//__TPCH_SCHEMA_LOAD_SF10

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// /jo_disable
/ep_enable
/glean_interactive
/filterPred
/joWrite
/transliterated
/weaved
/pipelineName = "_r_Q2a"
select
  s_acctbal,
  s_name,
  n_name,
  p_partkey,
  p_mfgr,
  s_address,
  s_phone,
  s_comment
from
  part,
  partsupp,
  supplier,
  nation,
  region
where
  p_partkey = ps_partkey
  and s_suppkey = ps_suppkey
  and p_size = 15
  and p_type like '%BRASS'
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'EUROPE'
  and ps_supplycost =
(
  select
    min(ps_supplycost)
  from
    partsupp,
    supplier,
    nation,
    region
  where
    p_partkey = ps_partkey
    and s_suppkey = ps_suppkey
    and s_nationkey = n_nationkey
    and n_regionkey = r_regionkey
    and r_name = 'EUROPE'
  )
order by
  s_acctbal desc,
  n_name,
  s_name,
  p_partkey;

