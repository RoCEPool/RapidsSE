create table orders (
O_ORDERKEY        INTEGER NOT NULL,
O_CUSTKEY         INTEGER NOT NULL,
O_ORDERSTATUS     CHAR(1) NOT NULL,
O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
O_ORDERDATE       DATE NOT NULL,
O_ORDERPRIORITY   CHAR(15) NOT NULL,
O_CLERK           CHAR(15) NOT NULL,
O_SHIPPRIORITY    INTEGER NOT NULL,
O_COMMENT         VARCHAR(79) NOT NULL
) partition by (O_CUSTKEY) ;

CREATE INDEX IxO_CUSTKEY ON orders(O_CUSTKEY);
create index IxO_ORDERKEY  ON  Orders (O_ORDERKEY)  ;
create index IxO_ORDERDATE  ON  Orders (O_ORDERDATE)  ;
load orders "../TPCH/SF_0001/orders.tbl";

/keepCodeFile
/optimise_passthru
pipeline Query13
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public customer
    | next

  stage S02 on all partitions :
    indexJoin orders IxO_CUSTKEY "LEFT_OUTER BOUND $I1 $1 =="
           "type BOOLEAN }  O_COMMENT '%special%requests%'  7 8 matchMiddle1  not"
    | combined 0
    | next


  stage S03 on all partitions :
    ordAgg " ordGroupBy  type INTEGER as c_custkey $1
             aggregates  type INTEGER $K1 ,
                         type INTEGER )  $9 count  "
    | combined 0
    | next

  stage S04 on all nodes :
    gbyAgg " groupBy    type INTEGER as c_custkey $1
             aggregates
                        type INTEGER $K1 ,
                        type INTEGER  )  $2 sum  "
    | combined 0
    | next

  stage S05 on origin :
    gbyAgg " groupBy    type INTEGER as c_custkey $1
             aggregates
                        type INTEGER $K1 ,
                        type INTEGER  )  $2 sum  "
    | combined 0
    | next

  stage S06 on origin :
    gbyAgg " groupBy    type INTEGER as c_count $2
             aggregates
                        type INTEGER $K1 ,
                        type INTEGER as custdist )  countAll  "
    | combined 0
    | next

  stage S07 on origin :
    sort " type INTEGER $1  ,
           type INTEGER as c_count $2  "
    | combined 0
    | next

 stage S08 on origin :
   output
   | sink
   | first
 end ;

