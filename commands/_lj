// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// PARTITIONABLE JOIN
// T.a = J.a
// PtnKey[T] = c
// PtnKey[J] = a

drop table  T1;
drop table  T2; 

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);

print "loading nation.csv..." ;
load T1 "../DATA/Joins/T1.csv" ;

create table  T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (a);

print "loading nation.csv..." ;
load  T2 "../DATA/Joins/T2.csv" ;

pipeline loopJoinPart
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T1 | hash 0 "type INTEGER $1" | stageC hashcast

  stage stageC on all partitions :
    scanRight  T2 | loopJoin 0 "$L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink | stageA

end;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// BROADCAST JOIN
// T.a = J.a
// PtnKey[T] = b
// PtnKey[J] = c

drop table  T1;
drop table  T2; 

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (b);

print "loading nation.csv..." ;
load T1 "../DATA/Joins/T1.csv" ;

create table  T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);

print "loading nation.csv..." ;
load  T2 "../DATA/Joins/T2.csv" ;


pipeline loopJoinBroad
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T1 | stageC broadcast

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 "$L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink | stageA

end;



//key 1 T1 P1 .... P3
//key 1 T2 p2 ..... P3

pipeline loopJoinEXPCAST
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T1 | hash 0 "type INTEGER $1" | stageC hashcast

  stage stageC on all partitions :
    scanRight T2 | hashRight 0 "type INTEGER $1" | stageD hashcast

  stage stageD on all partitions :
    loopJoin 0 "leftOuter $L1 $R1 ==" | stageE

  stage stageE on origin :
    output | sink | stageA

end
<vb_op> = 1
;


