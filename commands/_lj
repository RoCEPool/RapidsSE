// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// CO-PARTITIONED JOIN
// T.a = J.a
// PtnKey[T] = a
// PtnKey[J] = a

//drop table  T1;
//drop table  T2; 

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (a);

print "loading T1.csv..." ;
load T1 "../DATA/Joins/T1.csv" ;

create table  T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (a);

print "loading T2.csv..." ;
load  T2 "../DATA/Joins/T2.csv" ;

pipeline loopJoinCo
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T1 | filter 0 "type boolean $2 500 >=  " | stageC

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 " $L1 $R1 == " | stageD

  stage stageD on origin :
    output | sink | stageA
end
 ;

pipeline loopJoinCo
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T1 | stageC

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 "leftOuter $L1 $R1 == " | stageD

  stage stageD on origin :
    output | sink | stageA
end
 ;

pipeline loopJoinCo
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T1 | filter 0 "type boolean $2 500 >=  " | stageC

  stage stageC on all partitions :
    scanRight T2 | filterRight 0 "type boolean $2 500 >= " | loopJoin 0 "leftOuter $L1 $R1 == " | stageD

  stage stageD on origin :
    output | sink | stageA
end
 ;

