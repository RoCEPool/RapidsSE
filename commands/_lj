// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// INDEX JOIN
// T.a = J.a
// PtnKey[T] = c
// PtnKey[J] = c
create table T (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
);

print "loading nation.csv..." ;
load T "../DATA/Joins/T.csv" ;

create table J (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
);

create index jidx on j (a);
print "loading nation.csv..." ;
load J "../DATA/Joins/J.csv" ;

pipeline indexJoinP
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T | stageC

  stage stageC on all partitions :
    indexJoin 0 J jidx "EQUAL $I1 $L1 == " | stageD

  stage stageD on origin :
    output | sink | stageA
end;

