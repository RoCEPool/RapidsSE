pipeline eachRowExp
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T | filter 0 "type boolean $1 5 >=" | eachRow |
    eachScan J | filter 0 "type boolean $1 15 >=" |
    eachJoin 0 "$L1 $R1 ==" | stageC

  stage stageC on origin :
    output | sink | stageA
end;

