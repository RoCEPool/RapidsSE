// --initial _r_Q20

_r_schema

create index P_idx0  on Part     (P_PARTKEY);
create index PS_idx0 on PartSupp (PS_PARTKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_Q20"
select s_name,
       s_address
  from Supplier,
       Nation
 where s_suppkey in ( /* Q20_1 -- ?????? */
                      select ps_suppkey
                        from PartSupp
                       where
                             ps_partkey in ( /* Q20_1_1 -- 32_W_L_NC_I */
                                             select p_partkey
                                               from Part
                                              where p_name like 'forest%'
                                            )
                         and
                             ps_availqty > ( /* Q20_1_2 -- 24_W_A_C_ro */
                                             select 0.5 * sum(l_quantity)
                                               from LineItem
                                              where L_PARTKEY = PS_PARTKEY
                                              //and L_SUPPKEY = PS_SUPPKEY
                                                and l_shipdate >= '1994-01-01'
                                                and l_shipdate < '1995-01-01'
                                            )
                     )
   and s_nationkey = n_nationkey
   and n_name = ‘CANADA'
 order by s_name
;

