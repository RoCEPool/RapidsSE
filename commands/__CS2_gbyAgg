_nation
/time load nation   "<tpch_dir>/nation.<suffix>";

explain stage transliterate select n_regionKey, sum(n_nationKey) from nation group by n_regionKey;

/ccode pipeline unamed
begin
 stage S01 on origin :
   start
   | pulse once
   | next
 stage S02 on all partitions :
   scan rapidsse public Nation
   | gbyagg_v2 " groupBy  type INTEGER as n_regionkey $3 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | combined_v2 0
   | next
/*
 stage S03 on all nodes :
   gbyagg_v2 " groupBy  type INTEGER as n_regionkey $2 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | combined_v2 0
   | next

 stage S04 on origin :
   gbyagg_v2 " groupBy  type INTEGER as n_regionkey $2 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | combined_v2 0
   | next
 stage S05 on origin :
   project_v2 " type INTEGER $1 "
   | combined_v2 0
   | next
  */
 stage S06 on origin :
   output
   | sink
   | first
end ;

