/*============================================================================*/
/* _a_q9 -- Query9 (hand coded pipeline)                                      */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select
  nation,
  o_year,
  sum(amount) as sum_profit
from (
    select
      n_name as nation,
      extract(year from o_orderdate) as o_year,
      l_extendedprice * (1 - l_discount) - ps_supplycost * l_quantity as amount
    from
      part,
      supplier,
      lineitem,
      partsupp,
      orders,
      nation
    where
      s_suppkey = l_suppkey
      and ps_suppkey = l_suppkey
      and ps_partkey = l_partkey
      and p_partkey = l_partkey
      and o_orderkey = l_orderkey
      and s_nationkey = n_nationkey
      and p_name like '%green%' )
    as profit
group by
  nation,
  o_year
order by
  nation,
  o_year desc;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : PART, SUPPLIER, LINEITEM, PARTSUPP, ORDERS, NATION
// JOIN ORDER : PART->PARTSUPP->LINEITEM->SUPPLIER->ORDERS->NATION
// INDEXES    : IxO_ORDERKEY
//              IxL_PARTKEY
//              IxPS_PARKKEY
//              IxS_SUPPKEY
//              IxN_NATIONKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * JUST TRIED A FEW JOIN ORDERS. STARTING WITH PART WORKED BEST.
//     NOT TRIED ALL POSSIBILITIES

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//   CAN EXPLORE DIFFERENT JOIN ORDERS.

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

// pipeline begin
pipeline Query9
  begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public part
    | filter "type BOOLEAN }  P_NAME '%green%' 5 matchMiddle"
    | project "type INTEGER as P_PARTKEY P_PARTKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "bound $I1 P_PARTKEY =="
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST J1_PS_SUPPLYCOST"
    | combined 0
    | next broadcast

  stage S03 on all partitions :
    indexJoin LINEITEM IxL_PARTKEY "bound $I1 P_PARTKEY =="
    | filter "type BOOLEAN J1_L_SUPPKEY PS_SUPPKEY =="
    | project "type INTEGER as L_ORDERKEY J1_L_ORDERKEY ,
               type INTEGER as L_SUPPKEY J1_L_SUPPKEY ,
               type DECIMAL as AMOUNT J1_L_EXTENDEDPRICE 1.0 J1_L_DISCOUNT -  *  PS_SUPPLYCOST J1_L_QUANTITY *  - "
    | hash "type INTEGER L_SUPPKEY"
    | combined 0
    | next hashcast

  stage S04 on all partitions :
    indexJoin supplier IxS_SUPPKEY "bound $I1 L_SUPPKEY =="
    | project "type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
               type INTEGER as L_ORDERKEY L_ORDERKEY ,
               type DECIMAL as AMOUNT AMOUNT "
    | combined 0
    | next broadcast

  stage S05 on all partitions :
    indexJoin ORDERS IxO_ORDERKEY "bound $I1 L_ORDERKEY =="
    | project "type INTEGER as S_NATIONKEY S_NATIONKEY ,
               type INTEGER as O_YEAR J1_O_ORDERDATE extract_year ,
               type DECIMAL as AMOUNT AMOUNT"
    | combined 0
    | next

  stage S06 on all partitions :
    indexJoin NATION IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | project "type VARCHAR as NATION J1_N_NAME ,
               type INTEGER as O_YEAR O_YEAR ,
               type DECIMAL as AMOUNT AMOUNT"
    | combined 0
    | next

  stage S07 on all partitions :
    aggreg "groupBy type VARCHAR NATION ,
                    type INTEGER O_YEAR
            aggregates
                    type VARCHAR as NATION $K1 ,
                    type INTEGER as O_YEAR $K2 ,
                    type DECIMAL as SUM_PROFIT ) AMOUNT sum  "
    | combined 0
    | next

  stage S08 on all nodes :
    aggreg "groupBy type VARCHAR NATION ,
                    type INTEGER O_YEAR
            aggregates
                     type VARCHAR as NATION $K1 ,
                     type INTEGER as O_YEAR $K2 ,
                     type DECIMAL as SUM_PROFIT ) SUM_PROFIT sum  "
    | combined 0
    | next

  stage S09 on origin :
    aggreg "groupBy type VARCHAR NATION ,
                    type INTEGER O_YEAR
            aggregates
                     type VARCHAR as NATION $K1 ,
                     type INTEGER as O_YEAR $K2 ,
                     type DECIMAL as SUM_PROFIT ) SUM_PROFIT sum  "
    | combined 0
    | next

  stage S10 on origin :
    sort "type VARCHAR as NATION NATION ASC ,
          type INTEGER as O_YEAR O_YEAR DESC"
    | combined 0
    | next

  stage S11 on origin :
    output
    | sink
    | first
  end ;
// pipeline end

/*============================================================================*/
/* end                                                                        */
