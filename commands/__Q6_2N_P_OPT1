/*============================================================================*/
/* __Q6_2N_P_OPT1                                                             */
/*============================================================================*/

/optimise_passthru
pipeline Query6
begin

  stage S00 on origin : 
      start
    | pulse     once
    | next

  stage S01 on all partitions : 
      scan      lineitem
    | project   "type DECIMAL ( 15 2 ) as C0_L_QUANTITY $5
                 , type DECIMAL ( 15 2 ) as C0_L_EXTENDEDPRICE $6
                 , type DECIMAL ( 15 2 ) as C1_L_DISCOUNT $7
                 , type DATE as C2_L_SHIPDATE $11"
    | filter    " type BOOLEAN } C2_L_SHIPDATE DATE '1994-01-01' >= C2_L_SHIPDATE DATE '1994-01-01' < and 0.05 0.07 C1_L_DISCOUNT between and C0_L_QUANTITY 24.00 < and "
    | project   " type DECIMAL ( 15 2 ) as C0_L_EXTENDEDPRICE C0_L_EXTENDEDPRICE
                , type DECIMAL ( 15 2 ) as C1_L_DISCOUNT C1_L_DISCOUNT "
    | aggreg    "   type DECIMAL ( 19 2 ) as C0_COL0 ) $1 $2 * sum "
    | dynamic
    | next      

  stage S04 on all nodes : 
    aggreg    "   type DECIMAL ( 19 2 ) as C0_COL0 ) $1 sum "
    | dynamic
    | next      

  stage S05 on origin : 
    aggreg    "   type DECIMAL ( 19 2 ) as C0_revenue ) $1 sum "
    | dynamic
    | next      

  stage S06 on origin :
      output
    | sink
    | first

end ;


