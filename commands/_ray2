// NOTE: m_pColMap_sort : passthru colMap for sort is ok, but non-passthru it is not

_nation
/time load nation   "<tpch_dir>/nation.<suffix>";

// /glean_interactive
/weaved
/weaver2
/optimise_passThru
/pipeline_def
pipeline _ray2
begin
 stage S00 on origin :
   start
   | pulse once
   | next
 stage S01 on all partitions :
   scan rapidsse public Nation
   | project " type INTEGER as n_nationkey $1 "
   | sort " type INTEGER as n_nationkey $1 ASC  "
   | combined 0
   | next
 stage S02 on origin :
   output
   | sink
   | first
end ;

/weaver2 select n_nationkey from nation order by n_nationkey;

