/* _ray2 :                                                                    */
/*============================================================================*/

// NOTE: Need a m_pColMap_sort for the sort OPDEF

_nation
/time load nation   "<tpch_dir>/nation.<suffix>";

/weaved
/weaver2
/optimise_passThru
/glean_interactive
pipeline _ray2
begin
 stage S00 on origin :
   start
   | pulse once
   | next
 stage S01 on all partitions :
   scan rapidsse public Nation
   | project " type INTEGER as n_regionkey $3 , type INTEGER as n_nationkey $1 "
   | sort " type INTEGER as n_nationkey $2 ASC  "
   | combined 0
   | next
 stage S02 on origin :
   output
   | sink
   | first
end ;


