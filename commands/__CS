__TPCH_SCHEMA;

/glean_interactive
/optimise_passthru
/pipeline_def
pipeline Q
begin

 stage first on origin :
   start
   | pulse once
   | next

 stage Gs_ORDERS on all partitions :
   scan orders
   | filter " type BOOLEAN O_ORDERDATE DATE '1993-07-01' >= O_ORDERDATE DATE '1993-10-01' < and "
   | project " type INTEGER as _orderkey O_ORDERKEY ,
               type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY"
   | keyExists lineitem IxL_ORDERKEY  "BOUND $I1 _orderkey =="  "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
   | combined 0
   | next

 stage last on origin :
    output
    | sink
    | first

  end ;

