print "Q3";

/******************************************************************************
Q03_0: select
         l_orderkey,
         sum(l_extendedprice * (1 - l_discount)) as Revenue,
         o_orderdate,
         o_shippriority

  from Customer, Orders, LineItem
  
 where     c_mktsegment = 'BUILDING'
       and c_custkey    = o_custkey
       and l_orderkey   = o_orderkey
       and o_orderdate  < TIMESTAMP '1995-03-15'
       and l_shipdate   > TIMESTAMP '1995-03-15'

 group by l_orderkey, o_orderdate, o_shippriority

 order by Revenue desc, o_orderdate

 limit 10;


 select
          l_orderkey,
          sum(l_extendedprice * (1 - l_discount)) as Revenue

   from Customer, Orders, LineItem

  where     c_mktsegment = 'BUILDING'
        and c_custkey    = o_custkey
        and l_orderkey   = o_orderkey
        and o_orderdate  < TIMESTAMP '1995-03-15 00:00:00'
        and l_shipdate   > TIMESTAMP '1995-03-15 00:00:00'

  group by l_orderkey;


pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker1030
  stage stageMarker1030 on all partitions :
    scan rapidsse public customer
    | stageMarker1033 broadcast
  stage stageMarker1033 on all partitions :
    indexJoin 1 orders IxO_CUSTKEY "BOUND $I1 $L2 =="
    | stageMarker1036 broadcast
  stage stageMarker1036 on all partitions :
    indexjoin 1 lineitem IxL_ORDERKEY "BOUND $I1 $L17 =="
    | stageMarker1039
  stage stageMarker1039 on all partitions :
    filter 1 " type BOOLEAN  $7 'BUILDING'  ==  $1 $10 ==  and  $18 $9 ==  and  $13 TIMESTAMP '1995-03-15 00:00:00'  <  and  $28 TIMESTAMP '1995-03-15 00:00:00'  >  and  "
    | aggreg 0 " type INTEGER as l_orderkey $18 , type DECIMAL )  $23 1  $24 -  *  sum  groupBy  type INTEGER as l_orderkey $18 "
    | stageMarker1042
  stage stageMarker1042 on all nodes :
    aggreg 0 " type INTEGER as l_orderkey $1 , type DECIMAL )  $2 sum  groupBy  type INTEGER as l_orderkey $1 "
    | stageMarker1045
  stage stageMarker1045 on origin :
    aggreg 0 " type INTEGER as l_orderkey $1 , type DECIMAL as Revenue )  $2 sum  groupBy  type INTEGER as l_orderkey $1 "
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;


*******************************************************************************/
  //
  // Q3_0:
  //   a) scan Customer  /C_CUSTKEY/   # _custkey    _nationkey
  //   b) join Orders    /O_CUSTKEY/   # _custkey    _orderkey
  //   c) join LineItem  /L_ORDERKEY/  # _orderkey   _partkey   _suppkey
  //

/time pipeline Q3
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_CUSTOMER on all partitions :
    indexscan 2 Customer IxC_CUSTKEY "LBOUND $I1 0 >="
    | filter 2 "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project 2 expr type INTEGER as _custkey C_CUSTKEY
    | combined 0
    | next

  stage Gj_ORDERS on all partitions :
    indexjoin 2 Orders IxO_CUSTKEY "BOUND $I1 _custkey =="
     | filter 2 "type BOOLEAN J1_O_ORDERDATE TIMESTAMP '1995-03-15 00:00:00' <"
     | project 2 "type INTEGER as _orderkey J1_O_ORDERKEY ,
         type TIMESTAMP as O_ORDERDATE J1_O_ORDERDATE ,
         type INTEGER as O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash 2 expr type INTEGER _orderkey
    | combined 0
    | next hashcast

  stage Gj_LINEITEM on all partitions :
    indexjoin 2 Lineitem IxL_ORDERKEY "BOUND $I1 _orderkey =="
    | filter 2 "type BOOLEAN J1_L_SHIPDATE TIMESTAMP '1995-03-15 00:00:00' >"
    | ordAgg 2 expr type INTEGER as _orderkey _orderkey ,
        type INTEGER as Revenue ) J1_L_EXTENDEDPRICE 1 J1_L_DISCOUNT - * sum ,
        type TIMESTAMP as O_ORDERDATE O_ORDERDATE ,
        type INTEGER as O_SHIPPRIORITY  O_SHIPPRIORITY
        groupby type INTEGER _orderkey
    | combined 0
    | top "Revenue" 10
    | next

  stage last on origin :
    top "Revenue" 10
    | output
    | sink
    | first

end ;

