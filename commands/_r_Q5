/* _r_Q5 -- TCPH query 5 test                                                 */
/*============================================================================*/

trackMemory;

_r_schema

create index C_idx0  on customer (C_CUSTKEY  );
create index O_idx0  on orders   (O_CUSTKEY  );
create index L_idx0  on lineitem (L_ORDERKEY );
create index S_idx0  on supplier (S_SUPPKEY  );
create index N_idx0  on nation   (N_NATIONKEY);
create index R_idx0  on region   (R_REGIONKEY);


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimise
/glean_cue_from = "vS35X_T10_Push_sqB_Into_mqA"
/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_Q5"
select
  n_name,
  sum(l_extendedprice * (1 - l_discount)) as revenue
from
  customer,
  orders,
  lineitem,
  supplier,
  nation,
  region
where
  c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and l_suppkey = s_suppkey
  //and c_nationkey = s_nationkey
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'ASIA'
  and o_orderdate >= DATE '1994-01-01'
  and o_orderdate < DATE '1995-01-01'
group by
  n_name
order by
  revenue desc;


