create table Pu10k (
    pu10k_10k   integer not null

  , pu10k_ft    integer not null
  , pu10k_fj    integer not null

  , pu10k_1000g integer not null
  , pu10k_100g  integer not null
  , pu10k_10g   integer not null
  , pu10k_1g    integer not null

  , pu10k_int   integer not null
  , pu10k_dte   date    not null
  , pu10k_str   varchar not null
);
create index Pu10k_10k on Pu10k (pu10k_10k);

/time puLoad Pu10k;

