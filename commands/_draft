from   customer, orders
where  c_custkey = o_custkey
;




/ruler
pipeline outer
begin

  pipeline inner
  begin
  
    stage stageStart on origin :
        start
      | pulse once
      | stageMarker0212
    
    stage stageMarker0212 on all partitions :
        scan rapidsse public lineitem
      | aggreg 0 " type INTEGER as l_orderkey $1 , type DECIMAL )  $5 sum  groupBy  type INTEGER as l_orderkey $1 "
      | stageMarker0215
    
    stage stageMarker0215 on all nodes :
        aggreg 0 " type INTEGER as l_orderkey $1 , type DECIMAL )  $2 sum  groupBy  type INTEGER as l_orderkey $1 "
      | stageMarker0218
      
    stage stageMarker0218 on origin :
        aggreg 0 " type INTEGER as l_orderkey $1 , type DECIMAL )  $2 sum  groupBy  type INTEGER as l_orderkey $1 "
      | filter 1 " type BOOLEAN  $2 300  >  "
      | stageLast
      
    stage stageLast on origin :
        output
      | sink
      | stageStart
  end

  stage stageStart on origin :
      start
    | pulse once
    | stageMarker0774
    
  stage stageMarker0774 on all partitions :
      scan rapidsse public customer
    | stageMarker0777 broadcast
    
  stage stageMarker0777 on all partitions :
      scanRight rapidsse public orders
    | loopJoin 0 " 1  "
    | stageMarker0780
    
  stage stageMarker0780 on all partitions :
      filter 1 " type BOOLEAN  $1 $10 ==  "
    | project 0 " type INTEGER as c_custkey $1 , type VARCHAR as c_name $2 , type INTEGER as o_orderkey $9 "
    | stageLast
    
  stage stageLast on origin :
      output
    | sink
    | stageStart
    
end
;






