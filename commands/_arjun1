//------------------------------------------------------------------------------
// create table
create table datums (
  int_col0   INTEGER NOT NULL,
  int_col1   INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(19,2),
  dec_col7   DECIMAL(19,2),
  flt_col8   FLOAT,
  flt_col9   FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);


load datums "../DATA/Transliterate/groupBy.csv" ;


//------------------------------------------------------------------------------
select int_col1, sum(int_col0) from datums group by int_col1;


//------------------------------------------------------------------------------
select sum(int_col0), int_col1 from datums group by int_col1;


//------------------------------------------------------------------------------
create table part (
  P_PARTKEY           INTEGER NOT NULL,
  P_NAME              VARCHAR(55) NOT NULL,
  P_MFGR              CHAR(25) NOT NULL,
  P_BRAND             CHAR(10) NOT NULL,
  P_TYPE              VARCHAR(25) NOT NULL,
  P_SIZE              INTEGER NOT NULL,
  P_CONTAINER         CHAR(10) NOT NULL,
  P_RETAILPRICE       DECIMAL(15,2) NOT NULL,
  P_COMMENT           VARCHAR(23) NOT NULL
);


//------------------------------------------------------------------------------
load part "../TPCH/SF_0001/part.tbl";


// create a table
create table partsupp (
PS_PARTKEY      INTEGER NOT NULL,
PS_SUPPKEY      INTEGER NOT NULL,
PS_AVAILQTY     INTEGER NOT NULL,
PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
PS_COMMENT      VARCHAR(199) NOT NULL
);


//------------------------------------------------------------------------------
load partsupp "../TPCH/SF_0001/partsupp.tbl";

select p_mfgr, p_brand,  count(*) from part where p_size < 5 group by p_mfgr, p_brand order by p_mfgr, p_brand;


select p_brand, p_mfgr, count(*) from part where p_size < 5 group by p_mfgr, p_brand;


