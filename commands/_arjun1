select L_ORDERKEY, sum(L_DISCOUNT) from lineitem group by L_ORDERKEY;



//------------------------------------------------------------------------------
select L_LINENUMBER, sum(L_DISCOUNT) , sum(L_LINENUMBER) from lineitem group by L_LINENUMBER;


//------------------------------------------------------------------------------
create table Nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
);


//------------------------------------------------------------------------------
load nation "../DATA/TPCH/nation.tbl";


//------------------------------------------------------------------------------
SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
                                             FROM nation
                                             GROUP BY region
                                             HAVING region > 1;



