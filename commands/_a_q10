/*============================================================================*/
/* _a_q10 -- Query10 (hand coded pipeline)                                    */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select
  c_custkey,
  c_name,
  sum(l_extendedprice * (1 - l_discount)) as revenue,
  c_acctbal,
  n_name,
  c_address,
  c_phone,
  c_comment
from
  customer,
  orders,
  lineitem,
  nation
where
  c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and o_orderdate >= '1993-10-01'
  and o_orderdate < '1994-01-01'
  and l_returnflag = 'R'
  and c_nationkey = n_nationkey
group by
  c_custkey,
  c_name,
  c_acctbal,
  c_phone,
  n_name,
  c_address,
  c_comment
order by
  revenue desc
limit 20;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : CUSTOMER, ORDERS, LINEITEM, NATION
// JOIN ORDER : ORDERS->CUSTOMER->LINEITEM....>CUSTOMER->NATION
// INDEXES    : IxO_ORDERDATE
//              IxC_CUSTKEY
//              IxN_NATIONKEY
//              IxL_ORDERKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * GROUP BY ONLY ON C_CUSTKEY AS THIS KEY IS UNIQUE.
//   * CUSTOMER PROJECTIONS ARE DELAYED
//   * ADDED TOP TO GET TOP REVENUE INTEAD OF SORT DESC WITH LIMIT

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//   CAN EXPLORE DIFFERENT JOIN ORDERS.
//   SPECIFICALLY STARTING WITH LINEITEM

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

// pipeline begin
pipeline Query10
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    indexScan Orders IxO_ORDERDATE "LBOUND date '1993-10-01' >=  UBOUND date '1994-01-01' < "
    | project "type INTEGER as O_CUSTKEY  O_CUSTKEY ,
               type INTEGER as O_ORDERKEY O_ORDERKEY"
    | hash expr type INTEGER O_ORDERKEY
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | filter  "type BOOLEAN J1_L_RETURNFLAG 'R' =="
    | aggreg  "groupby    type INTEGER O_CUSTKEY
               aggregates type INTEGER as O_CUSTKEY $K1 ,
                          type DECIMAL as REVENUE ) J1_L_EXTENDEDPRICE 1.0  J1_L_DISCOUNT -  *  sum "
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg "groupby    type INTEGER O_CUSTKEY
            aggregates type INTEGER as O_CUSTKEY $K1 ,
                       type DECIMAL as REVENUE ) REVENUE  sum "
    | combined 0
    | next

  stage S04 on origin :
    aggreg "groupby    type INTEGER O_CUSTKEY
            aggregates type INTEGER as O_CUSTKEY $K1 ,
                       type DECIMAL as REVENUE ) REVENUE  sum"
    | combined 0
    | next

  stage S05 on origin :
    top " TOP type DECIMAL REVENUE " 20
    | hash expr type INTEGER O_CUSTKEY
    | combined 0
    | next hashcast

  stage S06 on all partitions :
    indexJoin Customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY ,
               type INTEGER as C_NATIONKEY J1_C_NATIONKEY ,
               type VARCHAR ( 0 ) as C_NAME J1_C_NAME ,
               type DECIMAL as REVENUE ) REVENUE ,
               type DECIMAL as C_ACCTBAL J1_C_ACCTBAL ,
               type VARCHAR ( 0 ) as C_ADDRESS J1_C_ADDRESS ,
               type VARCHAR ( 0 ) as C_PHONE J1_C_PHONE ,
               type VARCHAR ( 0 ) as C_COMMENT J1_C_COMMENT"
    | combined 0
    | next

  stage S07 on all partitions :
    indexjoin Nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY =="
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY ,
               type VARCHAR ( 0 ) as C_NAME C_NAME ,
               type DECIMAL as REVENUE ) REVENUE ,
               type DECIMAL as C_ACCTBAL C_ACCTBAL ,
               type VARCHAR ( 0 ) as N_NAME J1_N_NAME ,
               type VARCHAR ( 0 ) as C_ADDRESS C_ADDRESS ,
               type VARCHAR ( 0 ) as C_PHONE C_PHONE ,
               type VARCHAR ( 0 ) as C_COMMENT C_COMMENT"
    | combined 0
    | next

  stage S08 on origin :
    sort " type DECIMAL REVENUE DESC  "
    | combined 0
    | next

  stage S08 on origin :
    output
    | sink
    | first
end ;
// pipeline end

/*============================================================================*/
/* end                                                                        */
