  " type DECIMAL as C0_COL1 $2 DESC "

should have been
 " type DECIMAL as C2_value $3 DESC "

*/


// Query11.test

/pipeline_def
/weaved
/pipelineName = "_ray164"
select
  ps_partkey,
  sum(ps_supplycost * ps_availqty) as value
from
  partsupp,
  supplier,
  nation
where
  ps_suppkey = s_suppkey
  and s_nationkey = n_nationkey
  and n_name = 'IRAQ'
group by
  ps_partkey having
    sum(ps_supplycost * ps_availqty) >
    (
      select
        sum(ps_supplycost * ps_availqty) * 0.0001
      from
        partsupp,
        supplier,
        nation
      where
        ps_suppkey = s_suppkey
        and s_nationkey = n_nationkey
        and n_name = 'IRAQ'
    )
order by
   value desc;

