create table Pu100k (
    pu100k_100k integer not null
  , pu100k_10k  integer not null
  
  , pu100k_pre  integer not null
  , pu100k_pst  integer not null
    
  , pu100k_int  integer not null
  , pu100k_dte  date    not null
  , pu100k_str  varchar not null
);
create index idx_100k on Pu100k (pu100k_100k);
create index idx_10k  on Pu100k (pu100k_10k);

/time puLoad Pu100k;

//select * from Pu100k;
select count(*) from Pu100k;
select * from Pu100k where pu100k_100k < 10;
select * from Pu100k where pu100k_100k > 100000 - 10;

