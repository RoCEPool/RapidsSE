/*============================================================================*/
/* _pu100k -- pu100k performance unit test                                    */
/*============================================================================*/

create table Pu100k (
    pu100k_100k  integer not null // 1..100k
  , pu100k_10k   integer not null // 1..10k
  
  , pu100k_ft    integer not null // rnd(1..1000)
  , pu100k_fj    integer not null // rnd(1..1000)
    
  , pu100k_1g    integer not null // 1
  , pu100k_10g   integer not null // rnd(1..10)
  , pu100k_100g  integer not null // rnd(1..100)
  , pu100k_1000g integer not null // rnd(1..1000)

  , pu100k_int   integer not null //
  , pu100k_dte   date    not null //
  , pu100k_str   varchar not null //
);
create index Pu100k_100k on Pu100k (pu100k_100k);
create index Pu100k_10k  on Pu100k (pu100k_10k);

/time puLoad Pu100k;

//select * from Pu100k;
select count(*) from Pu100k;
select * from Pu100k where pu100k_100k < 10;
select * from Pu100k where pu100k_100k > 100000 - 10;

