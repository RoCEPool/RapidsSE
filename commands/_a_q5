/*============================================================================*/
/* _a_q5 -- Query5 (hand coded pipeline)                                      */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select
  n_name,
  sum(l_extendedprice * (1 - l_discount)) as revenue
from customer,
  orders,
  lineitem,
  supplier,
  nation,
  region
where c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and l_suppkey = s_suppkey
  and c_nationkey = s_nationkey
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'ASIA'
  and o_orderdate >= '1994-01-01'
  and o_orderdate < '1995-01-01'
group by
  n_name
order by
  revenue desc;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : ORDERS, LINEITEM, SUPPLIER, NATION, REGION
// JOIN ORDER : ORDERS->CUSTOMER->LINEITEM->SUPPLIER->NATION->REGION
// INDEXES    : IxC_CUSTKEY
//              IxL_ORDERKEY
//              IxS_SUPPKEY
//              IxN_NATIONKEY
//              IxR_REGIONKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * CHANGED JOIN ORDER
//   * SEPARATE SORT INTO DIFFERENT STAGE THAN AGGREG

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//   NEED TO EXPLORE DIFFERENT JOIN ORDERS.

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * /

// pipeline begin
pipeline Query5
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage S00 on all partitions :
    scan rapidsse public Orders
    | filter " type BOOLEAN O_ORDERDATE DATE '1994-01-01'  >=
                            O_ORDERDATE DATE '1995-01-01'  <  and  "
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY ,
               type INTEGER as O_ORDERKEY O_ORDERKEY"
    | combined 0
    | next

  stage S01 on all partitions :
    indexJoin Customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
    | project "type INTEGER as O_ORDERKEY O_ORDERKEY ,
               type INTEGER as C_NATIONKEY J1_C_NATIONKEY"
    | hash "type INTEGER O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY "bound $I1 O_ORDERKEY =="
    | project "type INTEGER as C_NATIONKEY C_NATIONKEY ,
                   type INTEGER as L_SUPPKEY J1_L_SUPPKEY ,
                   type DECIMAL as L_EXTENDEDPRICE J1_L_EXTENDEDPRICE ,
                   type DECIMAL as L_DISCOUNT J1_L_DISCOUNT"
    | hash "type INTEGER L_SUPPKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin Supplier IxS_SUPPKEY expr "bound $I1 L_SUPPKEY =="
    | filter " type BOOLEAN C_NATIONKEY J1_S_NATIONKEY == "
    | project "type DECIMAL as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL as L_DISCOUNT L_DISCOUNT ,
               type INTEGER as S_NATIONKEY J1_S_NATIONKEY"
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin Nation IxN_NATIONKEY expr "bound $I1 S_NATIONKEY =="
    | project "type DECIMAL as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR ( 0 ) as N_NAME J1_N_NAME ,
               type INTEGER as N_REGIONKEY J1_N_REGIONKEY"
    | combined 0
    | next

  stage S05 on all partitions :
    indexJoin Region IxR_REGIONKEY expr "bound $I1 N_REGIONKEY =="
    | filter " type BOOLEAN J1_R_NAME 'ASIA'  ==  "
    | project "type DECIMAL as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR ( 0 ) as N_NAME N_NAME"
    | combined 0
    | next

  stage S06 on all partitions :
    aggreg " groupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
                        type DECIMAL as REVENUE )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  "
    | combined 0
    | next

  stage S07 on all nodes :
    aggreg " groupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
                        type DECIMAL as REVENUE ) REVENUE sum  "
    | combined 0
    | next

  stage S08 on origin :
    aggreg " groupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
             type DECIMAL as REVENUE ) REVENUE sum  "
    | combined 0
    | next

  stage S09 on origin :
    sort " type DECIMAL REVENUE DESC  "
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;
// pipeline end

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
