tag default <tpch_dir> = "/Users/Shared/tpch/SF10" ;
tag default <suffix>   = "csv";

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// tables

_lineitem

_part
create index IxP_PARTKEY ON part(P_PARTKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/time load lineitem "<tpch_dir>/lineitem.<suffix>";
/time load part     "<tpch_dir>/part.<suffix>";

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/time pipeline Q14
begin

  stage first on origin :
    start
    | pulse once
    | next


  // - - - - - - - - - - - - - - - - -
  // ∀ LINEITEM π L_ORDERKEY as _partkey
  stage Gs_LINEITEM on all partitions :
    scan lineitem
    | project 1 "type INTEGER as _partkey L_PARTKEY"
    | hash 1 "type INTEGER _partkey"
    | G_PART hashCast

  // ⋈ PART IxP_PARTKEY _partkey
  stage Gj_PART on all partitions :
    indexJoin 1 part IxP_PARTKEY "bound $I1 _partkey =="
    | next


  // - - - - - - - - - - - - - - - - -
  stage G_CNT_P on all partitions :
    project 1 " type INTEGER as x_rowCntPtn )  countAll  "
    //| debug streamDef
    | next
    
  stage G_CNT_N on all nodes :
    project 1 " type INTEGER as x_rowCntNode )  x_rowCntPtn sum  "
    | next
    
  stage G_CNT_O on origin :
    project 1 " type INTEGER as x_rowCntOrigin )  x_rowCntNode sum  "
    | next

  stage last on origin :
    output
    | debug accum0
    | sink
    | first
    
end ;

