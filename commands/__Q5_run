/*============================================================================*/
/* __Q5_run                                                                   */
/*============================================================================*/

/******************************************************************************
Q05_0: select
         n_name,
         sum(l_extendedprice * (1 - l_discount)) as Revenue
    
  from Customer, Orders, LineItem, Supplier, Nation, Region

 where     c_custkey   =  o_custkey
       and l_orderkey  =  o_orderkey
       and l_suppkey   =  s_suppkey
       and c_nationkey =  s_nationkey
       and s_nationkey =  n_nationkey
       and n_regionkey =  r_regionkey
       and r_name      =  'ASIA'
       and o_orderdate >= '1994-01-01'
       and o_orderdate <  ‘1995-01-01'

 group by n_name

 order by Revenue desc;
*******************************************************************************/


/time pipeline Q5
begin

  stage first on origin :
    start
    | pulse once
    | next

  //                                               this should be an index scan
  // 4) ∀ ORDERS /O_CUSTKEY/ π _custkey _orderkey
  stage Gs_ORDERS on all partitions :
    scan Orders
    | project 1 expr
        type INTEGER as _custkey  O_CUSTKEY ,
        type INTEGER as _orderkey O_ORDERKEY
    | next

//UC

  // a) ⋈ CUSTOMER /C_CUSTKEY/ _custkey π _orderkey
  stage Gj_CUSTOMER on all partitions :
    indexJoin 1 Customer IxC_CUSTKEY expr bound $I1 _custkey ==
    | project 1 expr
        type INTEGER as _orderkey _orderkey
    | hash 1 expr type INTEGER _orderkey
    | next hashcast

//HC

  //                                                            filter customer
  // to be completed...
  
  // b) ⋈ LINEITEM /L_ORDERKEY/ _orderkey π _suppkey
  stage Gj_LINEITEM on all partitions :
    indexJoin 1 Lineitem IxL_ORDERKEY expr bound $I1 _orderkey ==
    | project 1 expr
        type INTEGER as _suppkey J1_L_SUPPKEY
    | hash 1 expr type INTEGER _suppkey
    | next hashcast
    
  // l) ⋈ SUPPLIER /S_SUPPKEY/ _suppkey π _nationkey
  stage Gj_SUPPLIER  on all partitions :
    indexJoin 1 Supplier IxS_SUPPKEY expr bound $I1 _suppkey ==
    | project 1 expr
        type INTEGER as _nationkey J1_S_NATIONKEY
    | next

  //                                                            filter supplier
  // to be completed...
  
  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

  stage G_CNT_P on all partitions :
    project 1 expr type INTEGER as x_rowCntPtn )  countAll
    | next
    
  stage G_CNT_N on all nodes :
    project 1 expr type INTEGER as x_rowCntNode )  x_rowCntPtn sum
    | next
    
  stage G_CNT_O on origin :
    project 1 expr type INTEGER as x_rowCntOrigin )  x_rowCntNode sum
    | next

  stage last on origin :
    output
    | debug accum0
    | sink
    | first
    
end ;

