/optimise_passthru
pipeline Query3
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Customer
    | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
               type VARCHAR as C_MKTSEGMENT C_MKTSEGMENT "
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY"
    | combined 0
    | next

  stage S02 on all partitions multiple threads 4:
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
    | project "type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
               type DATE as O_ORDERDATE O_ORDERDATE ,
               type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY"
    | filter "type BOOLEAN O_ORDERDATE DATE '1995-03-15' <"
    | hash "type INTEGER ( 19 ) O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    sort "type INTEGER ( 19 ) O_ORDERKEY ASC"
    | combined 0
    | next

  stage S04 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | project "type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
               type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
               type DATE as L_SHIPDATE L_SHIPDATE ,
               type DATE as O_ORDERDATE O_ORDERDATE ,
               type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY"
    | filter "type BOOLEAN L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg " OrdGroupBy type INTEGER ( 19 ) L_ORDERKEY
               aggregates type INTEGER ( 19 ) as L_ORDERKEY $K1 ,
                          type DECIMAL ( 19  2 ) as REVENUE ) L_EXTENDEDPRICE 1. L_DISCOUNT -  *  sum  ,
                          type DATE as O_ORDERDATE  O_ORDERDATE ,
                          type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY "
    | combined 0
    | next

  stage S05 on all partitions :
    sort " type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S06 on all nodes :
    sort " type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S07 on origin :
    sort " type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S08 on origin :
    output
    | sink
    | first
end ;

////create index IxO_ORDERDATE  ON Orders  (O_ORDERDATE)  ;
/******************************************************************************
Q03_0: select
         l_orderkey,
         sum(l_extendedprice * (1 - l_discount)) as Revenue,
         o_orderdate,
         o_shippriority

  from Customer, Orders, LineItem
  
 where     c_mktsegment = 'BUILDING'
       and c_custkey    = o_custkey
       and l_orderkey   = o_orderkey
       and o_orderdate  < DATE '1995-03-15'
       and l_shipdate   > DATE '1995-03-15'

 group by l_orderkey, o_orderdate, o_shippriority

 order by Revenue desc, o_orderdate

 limit 10;
*******************************************************************************/
  //
  // Q3_0:
  //   a) scan Customer  /C_CUSTKEY/   # _custkey    _nationkey
  //   b) join Orders    /O_CUSTKEY/   # _custkey    _orderkey
  //   c) join LineItem  /L_ORDERKEY/  # _orderkey   _partkey   _suppkey
  //

