/*============================================================================*/
/* __CS2_sort : Code Synthesizer V2                                           */
/*============================================================================*/

_nation
/time load nation   "<tpch_dir>/nation.<suffix>";

explain stage transliterate select n_regionkey, n_nationkey from nation order by n_nationkey;

/weaved
/optimise_passThru
pipeline unamed
begin
 stage S00 on origin :
   start
   | pulse once
   | next
 stage S01 on all partitions :
   scan rapidsse public Nation
   | project " type INTEGER as n_regionkey $3 , type INTEGER as n_nationkey $1 "
   | sort " type INTEGER as n_nationkey $2 ASC  "
   | combined 0
   | next
 stage S02 on origin :
   output
   | sink
   | first
end ;
