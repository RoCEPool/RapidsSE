/optimise_passthru
/pipeline_def
/weaved
pipeline _unnamed_
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
      scan      orderby
  | project   "   type VARCHAR as C0_a $1
                , type VARCHAR as C1_b $2
                , type INTEGER as C2_c $3
                , type DECIMAL as C3_d $4
                , type FLOAT as C4_e $5
                , type DATE as C5_f $6
                , type TIME as C6_g $7
                , type TIMESTAMP as C7_h $8
                , type BOOLEAN as C8_i $9
                , type INTEGER as C9_j $10
                , type VARCHAR as C0_COL1 $2 1 1 substring3"
    | dynamic
    | next

  stage S02 on all partitions :
    sort      " type VARCHAR $11 "
     | dynamic
    | next

  stage S03 on all nodes :
    sort      " type VARCHAR $11 "
     | dynamic
    | next

  stage S04 on origin :
    sort      " type VARCHAR $11 "
     | dynamic
    | next

  stage S05 on origin :
      output
    | sink
    | first

end ;


