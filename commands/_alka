/pipeline_def
/optimise_passthru
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    scan nation
    | project "type INTEGER ( 19 ) $1"
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
end ;
