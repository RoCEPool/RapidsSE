file _lineitem;
create index IxL_SUPP_PART_KEY     on Lineitem (L_SUPPKEY, L_PARTKEY);
load lineitem           "../TPCH/SF_0001/lineitem.tbl" ;

/keepCodeFile
/optimise_passthru
pipeline Query9
  begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    indexScan lineitem IxL_SUPP_PART_KEY "UBOUND $I1 5"
    | project "type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
               type INTEGER ( 19 ) as L_PARTKEY L_PARTKEY "
    | combined 0
    | next

 stage S11 on origin :
    output
    | sink
    | first
  end ;