pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker0121
  stage stageMarker0121 on all partitions :
    scan rapidsse public nation
    | aggreg 2 " groupBy  type VARCHAR as n_name $2 aggregates  type VARCHAR $K1 , type INTEGER )  $3 sum  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

