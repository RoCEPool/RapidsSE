/pipeline_def
/keepCodeFile
/weaved
/optimise_passthru
pipeline Query7
begin

  stage S00 on origin :
    start
    | pulse     once
    | next

  stage S01 on all partitions :
    scan      Orders
    | project   "   type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY
                  , type VARCHAR ( 0 ) as O_ORDERPRIORITY O_ORDERPRIORITY "
    | combined 0
    | next

  stage S02 on origin :
      top " type INTEGER ( 19 ) O_CUSTKEY " 2
      | combined 0
      | next hashcast

  stage S15 on origin :
      output
    | sink
    | first

end ;