explain stage aggregateSplit select
  l_returnflag,
  l_linestatus,
  sum(l_quantity) as sum_qty,
  sum(l_extendedprice) as sum_base_price,
  sum(l_extendedprice*(1.0-l_discount)) as sum_disc_price,
  sum(l_extendedprice*(1.0-l_discount)*(1.0+l_tax)) as sum_charge,
  avg(l_quantity) as avg_qty,
  avg(l_extendedprice) as avg_price,
  avg(l_discount) as avg_disc,
  count(*) as count_order
from
  lineitem
where
  l_shipdate <= DATE '1998-09-01'
group by
  l_returnflag,
  l_linestatus;

explain stage aggregateSplit select l_extendedprice/l_orderkey from lineitem;

explain stage transliterate select cast(l_quantity as integer) from lineitem;

select p_Partkey , sum(L_QUANTITY) , count(L_QUANTITY) from part join lineitem on l_partkey = p_Partkey where P_BRAND = 'Brand#23' and P_CONTAINER = 'MED BAG'
group by p_partkey;
