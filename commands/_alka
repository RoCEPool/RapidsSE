pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker0123
  stage stageMarker0123 on all partitions :
    scan rapidsse public nation
    | project 2 " type INTEGER as n_nationkey $1 , type INTEGER as n_regionKey $3 "
    | sort 2 " type INTEGER as n_nationkey $1 ASC "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

