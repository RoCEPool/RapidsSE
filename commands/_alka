pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker0139
  stage stageMarker0139 on all partitions :
    scan rapidsse public nation
    | project 2 " type INTEGER 1  , type INTEGER )  $1 sum  "
    | combined 0
    | stageMarker0142
  stage stageMarker0142 on all nodes :
    project 2 " type INTEGER $1 , type INTEGER )  $2 sum  "
    | combined 0
    | stageMarker0145
  stage stageMarker0145 on origin :
    project 2 " type INTEGER $1 , type INTEGER )  $2 sum  "
    | filter 2 " type BOOLEAN  $2 0  >  "
    | project 2 " type INTEGER $1 "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;



