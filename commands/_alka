_part;
CREATE INDEX orders_idx1 ON orders(O_CUSTKEY);
CREATE INDEX orders_idx2 ON orders(O_ORDERKEY);

create index IxR_REGIONKEY on REGION (R_REGIONKEY);
create index IxR_NAME on REGION (R_NAME);

