_lineitem;

__TPCH_SCHEMA

//explain stage transliterate select O_ORDERKEY, C_CUSTKEY from customer , orders where c_custkey = o_custkey
//  and o_orderkey < 10;

/pipeline_def
/weaved
/keepCodeFile
/optimise_passthru
pipeline unamed
begin

    stage S00 on origin :
      start
      | pulse once
      | next

   stage S01 on all partitions :
      scan rapidsse public orders
      | hash "type INTEGER O_ORDERKEY"
      | combined 0
      | next hashcast

    stage S02 on all partitions :
     keyNotExists lineitem IxL_ORDERKEY  "BOUND $I1 O_ORDERKEY =="
                  "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
      | combined 0
      | next

  stage S03 on origin :
    output
    | sink
    | first
end ;


//rows: (30)


/optimise_passthru
pipeline unamed
begin

    stage S00 on origin :
      start
      | pulse once
      | next

    stage S02 on all partitions :
      scan rapidsse public Customer
      | keyNotExists ORDERS IxO_CUSTKEY  "BOUND $I1 C_CUSTKEY =="
                         "type BOOLEAN O_ORDERSTATUS 'O' =="
      | project " type INTEGER as O_CUSTKEY C_CUSTKEY "
      | combined 0
      | next

  stage S03 on origin :
    output
    | sink
    | first
end ;

