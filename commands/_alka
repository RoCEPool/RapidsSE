/keepCodeFile
/weaved
/optimise_passthru
pipeline Query7
begin

  stage S00 on origin :
    start
    | pulse     once
    | next

  stage S01 on all partitions :
    scan      Orders
    | project   "   type INTEGER ( 19 ) as C0_O_CUSTKEY $2
                  , type INTEGER ( 19 ) as C1_O_ORDERKEY $1 "
    | hash      "type INTEGER ( 19 ) $2"
    | combined 0
    | next      hashcast

  stage S02 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY " BOUND $I1 $2 == " " type BOOLEAN } DATE '1995-01-01' DATE '1996-12-31' $11 between "
    | combined 0
    | next

  stage S15 on origin :
      output
    | sink
    | first

end ;