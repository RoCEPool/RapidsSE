/*============================================================================*/
/* _alka                                                                      */
/*============================================================================*/

__TPCH_SCHEMA;

/time /optimise_passthru
pipeline Q8
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarkerA on all partitions :
    indexScan ${testName2}_orders IxO_ORDERDATE "LBOUND $I1 DATE '1995-01-01' >= UBOUND $I1 DATE '1996-12-31' <="
    | project "type integer ( 19 ) as O_CUSTKEY O_CUSTKEY , type integer ( 19 ) as O_ORDERKEY O_ORDERKEY , type INTEGER ( 19 ) as O_YEAR O_ORDERDATE extract_year"
    | combined 0
    | next

  stage stageMarkerB on all partitions :
    indexJoin ${testName2}_customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
    | project "type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY , type integer ( 19 ) as O_ORDERKEY O_ORDERKEY , type INTEGER ( 19 ) as O_YEAR O_YEAR"
    | combined 0
    | next

  stage stageMarkerC on all partitions :
    indexJoin ${testName2}_nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY =="
    | project "type integer ( 19 ) as N_REGIONKEY N_REGIONKEY , type integer ( 19 ) as O_ORDERKEY O_ORDERKEY , type INTEGER ( 19 ) as O_YEAR O_YEAR"
    | combined 0
    | next

  stage stageMarkerD on all partitions :
    indexJoin ${testName2}_region IxR_REGIONKEY "BOUND $I1 N_REGIONKEY =="
    | filter "type BOOLEAN R_NAME 'AMERICA' =="
    | project "type integer ( 19 ) as R_REGIONKEY R_REGIONKEY , type integer ( 19 ) as O_ORDERKEY O_ORDERKEY , type INTEGER ( 19 ) as O_YEAR O_YEAR"
    | hash "type INTEGER ( 19 ) O_ORDERKEY"
    | combined 0
    | next hashcast

  stage stageMarkerE on all partitions :
    indexJoin ${testName2}_LineItem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | project "type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY , type INTEGER ( 19 ) as L_PARTKEY L_PARTKEY , type INTEGER ( 19 ) as O_YEAR O_YEAR , type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice , type DECIMAL ( 19  2 ) as l_discount l_discount"
    | hash "type INTEGER ( 19 ) L_PARTKEY"
    | combined 0
    | next hashcast

  stage stageMarkerF on all partitions :
    indexJoin ${testName2}_part IxP_PARTKEY "BOUND $I1 L_PARTKEY =="
    | filter "type BOOLEAN P_TYPE 'ECONOMY ANODIZED TIN' =="
    | project "type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY , type INTEGER ( 19 ) as O_YEAR O_YEAR , type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice , type DECIMAL ( 19  2 ) as l_discount l_discount"
    | hash "type INTEGER ( 19 ) L_SUPPKEY"
    | combined 0
    | next hashcast

  stage stageMarkerG on all partitions :
    indexJoin ${testName2}_supplier IxS_SUPPKEY "BOUND $I1 L_SUPPKEY =="
    | project "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY , type INTEGER ( 19 ) as O_YEAR O_YEAR , type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice , type DECIMAL ( 19  2 ) as l_discount l_discount"
    | combined 0
    | next

  stage stageMarkerH on all partitions :
    indexJoin ${testName2}_nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project "type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY , type INTEGER ( 19 ) as O_YEAR O_YEAR , type DECIMAL ( 19  2 ) as VOLUME L_EXTENDEDPRICE 1.00 L_DISCOUNT -  * , type VARCHAR ( 0 ) as NATION N_NAME"
    | combined 0
    | next

  stage stageMarkerI on all partitions :
    gbyAgg " groupBy type INTEGER ( 19 ) O_YEAR aggregates type INTEGER ( 19 ) as O_YEAR $K1 , type DECIMAL ( 19  2 )  ) VOLUME sum  , type DECIMAL ( 19  2 ) )  } type DECIMAL ( 19  2 ) NATION 'BRAZIL'  ==  WHEN  VOLUME THEN  0.00  ELSE  ENDIF  CASE  sum  "
    | combined 0
    | next

  stage stageMarkerJ on all nodes :
    gbyAgg " groupBy type INTEGER ( 19 ) O_YEAR aggregates  type INTEGER ( 19 ) as O_YEAR $K1 , type DECIMAL ( 19  2 ) )  $2 sum  , type DECIMAL ( 19  2 ) )  $3 sum  "
    | combined 0
    | next

  stage stageMarkerK on origin :
    gbyAgg " groupBy  type INTEGER ( 19 ) O_YEAR aggregates  type INTEGER ( 19 ) as O_YEAR $K1 , type DECIMAL ( 19  2 ) )  $2 sum  , type DECIMAL ( 19  2 ) )  $3 sum  "
    | combined 0
    | next

  stage stageMarkerL on origin :
    project " type INTEGER ( 19 ) as O_YEAR O_YEAR , type DECIMAL ( 19  2 ) as mkt_share $3 $2 /  "
    | sort " type INTEGER ( 19 ) as o_year $1 ASC  "
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

