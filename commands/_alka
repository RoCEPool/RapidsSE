create table Nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
create index IxN_NATIONKEY on nation (n_nationkey);

load nation "../DATA/TPCH/nation.tbl";

create table Region (
	 R_REGIONKEY       INTEGER      NOT NULL,
	 R_NAME            CHAR(25)     NOT NULL,
	 R_COMMENT         VARCHAR(152)
);

create index IxR_REGIONKEY on Region (R_REGIONKEY);
create index IxR_NAME on Region (R_NAME);
load Region "../DATA/TPCH/region.tbl";


/optimise_passthru
/pipeline_def
/weaved
pipeline _unnamed_
begin

  stage S00 on origin :
     start
   | pulse     once
   | next

  stage S01 on all partitions :
     scan      Nation
   | project "type INTEGER N_NATIONKEY , type VARCHAR N_NAME , type INTEGER N_REGIONKEY"
   | hash "type INTEGER $3"
   | combined 0
   | next hashcast

  stage S02 on all partitions :
     indexJoin Region IxR_REGIONKEY " BOUND $I1 $3 == "
   | combined 0
   | next

  stage S04 on origin :
     output
   | sink
   | first

end ;

