__TPCH_SCHEMA

//explain stage transliterate select O_ORDERKEY, C_CUSTKEY from customer , orders where c_custkey = o_custkey
//  and o_orderkey < 10;

/pipeline_def
/weaved
/keepCodeFile
/optimise_passthru
pipeline Query5
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage S00 on all partitions :
    scan rapidsse public Orders
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY ,
               type INTEGER as O_ORDERKEY O_ORDERKEY"
    | combined 0
    | next

  stage S01 on all partitions :
    indexJoin Customer IxC_CUSTKEY "LEFT_OUTER BOUND $I1 O_CUSTKEY =="
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY ,
               type INTEGER as O_ORDERKEY O_ORDERKEY"
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;


