// Modified pipeline generated by optimiser
//   -- merged first 3 satges into one.

// OPT2 at :
// on iMac:
//  SF10-1N-1P : 4.91s
//  SF10-1N-4P : 1.74


/keepCodeFile/pipeline_def
/optimise_passthru
pipeline unamed
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
    scan      Lineitem
    | filter    " type BOOLEAN } $11 DATE '1994-01-01' >= $11 DATE '1995-01-01' < and 0.05 0.07 $7 between and $5 24.00 < and "
    |  project   "type DECIMAL ( 15 2 ) as C0_L_QUANTITY $5
                     , type DECIMAL ( 15 2 ) as C0_L_EXTENDEDPRICE $6
                     , type DECIMAL ( 15 2 ) as C1_L_DISCOUNT $7
                     , type DATE as C2_L_SHIPDATE $11"
    | aggreg    "   type DECIMAL ( 19 2 ) as C0_COL0 ) $2 $3 * sum "
    | dynamic
    | next

  stage S04 on all nodes :
    aggreg    "   type DECIMAL ( 19 2 ) as C0_COL0 ) $1 sum "
    | dynamic
    | next

  stage S05 on origin :
    aggreg    "   type DECIMAL ( 19 2 ) as C0_Revenue ) $1 sum "
    | dynamic
    | next

  stage S06 on origin :
      output
    | sink
    | first

end ;

