/*============================================================================*/
/* __Q1_run                                                                   */
/*============================================================================*/

/******************************************************************************
Q01_0: select
         l_returnflag,
         l_linestatus,
         sum(l_quantity)                                     as sum_qty,
         sum(l_extendedprice)                                as sum_base_price,
         sum(l_extendedprice * (1-l_discount))               as sum_disc_price,
         sum(l_extendedprice * (1-l_discount) * (1 + l_tax)) as sum_charge,
         avg(l_quantity)                                     as avg_qty,
         avg(l_extendedprice)                                as avg_price,
         avg(l_discount)                                     as avg_disc,
         count(*)                                            as count_order

  from LineItem

 where l_shipdate <= '1998-12-01 00:00:00’ - interval 60..120 days

 group by l_returnflag, l_linestatus
  
 order by l_returnflag, l_linestatus;
*******************************************************************************/


/time pipeline Q1
begin

  stage first on origin :
    start
    | pulse once
    | next
    
  //
  // Q1_0:
  //   a) scan LineItem /L_ORDERKEY/  # _orderkey _partkey _suppkey
  //

  // ∀ LINEITEM σ L_ORDERKEY as _orderkey
  stage Gs_LINEITEM on all partitions :
    scan lineitem
    | project 1 "type INTEGER as _orderkey L_ORDERKEY"
    | debug rowbuffer
    | next
    
  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = = 

  stage G_CNT_P on all partitions :
    project 1 " type INTEGER as x_rowCntPtn )  countAll  "
    | next
    
  stage G_CNT_N on all nodes :
    project 1 " type INTEGER as x_rowCntNode )  x_rowCntPtn sum  "
    | next
    
  stage G_CNT_O on origin :
    project 1 " type INTEGER as x_rowCntOrigin )  x_rowCntNode sum  "
    | next

  stage last on origin :
    output
    | debug accum0
    | sink
    | first
    
end ;

