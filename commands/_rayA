/*============================================================================*/
/* _rayA :                                                                    */
/*============================================================================*/

tag default <tpch_dir> = "../tpch/sf_0001";
tag default <suffix>   = "csv";

__TPCH_SCHEMA_LOAD_SF0001

/weaver2
/glean_interactive
/transliterated
/weaved
/optimise_passthru
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    scan lineitem
    | project " type integer as orderkey l_orderkey "
    | top "type integer orderkey" 2
    | combined 0
    | next
stage stageA on all nodes :
    top "type integer orderkey" 2
    | combined 0
    | next
stage stageA on origin :
    top "type integer orderkey" 2
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
  end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
