pipeline colMap
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public customer
    | project " type INTEGER as C_CUSTKEY $1 ,
                type INTEGER as C_NATIONKEY $4"
    | combined 0
    | next

  stage S02 on all partitions :
    project " type INTEGER as C_CUSTKEY $1"
    | combined 0
    | next

 stage S03 on origin :
   output
   | sink
   | first
 end ;


