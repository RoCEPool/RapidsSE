/weaved
/pipeline_def
/optimise_passthru
pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan orders
    | hash "type INTEGER $1"
    | combined 0
    | stageC hashcast

  stage stageC on all partitions :
    indexJoin lineitem IxL_ORDERKEY "BOUND $I1 $L1 =="
    | limit 3
    | combined 0
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

end ;

