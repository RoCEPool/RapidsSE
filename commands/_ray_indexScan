tag default <tpch_dir> = "../tpch/sf_0001";
tag default <suffix>   = "csv";

_customer

load customer "<tpch_dir>/customer.<suffix>" ;

create index Ix_CUSTKEY on Customer(C_CUSTKEY);

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimiser_trace
/transliterated
/pipeline_def
/weaved
/OT_DERIVE_STREAMKEY
/OT_SCAN_TO_INDEXSCAN
/pipelineName = "_ray_indexScan"
select C_MKTSEGMENT, C_NATIONKEY, C_CUSTKEY
  from Customer
 where C_CUSTKEY >= 1
   //and C_CUSTKEY <= 10
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

drop table customer;

