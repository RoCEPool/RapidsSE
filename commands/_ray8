tag default <tpch_dir> = "../tpch/sf_0001";
tag default <suffix>   = "csv";

_nation
create index IxN_NATIONKEY on nation (n_nationkey);
/time load nation   "<tpch_dir>/nation.<suffix>";

_region
create index IxR_REGIONKEY on region (r_regionkey);
/time load region   "<tpch_dir>/region.<suffix>";

/weaver2
/glean_interactive
/transliterated
/weaved
/optimise_passthru
pipeline _unnamed_
begin

 stage S00 on origin :
     start
   | pulse     once
   | next

 stage S01 on all partitions :
     scan Nation
   | project "type INTEGER as N_NATIONKEY N_NATIONKEY , type VARCHAR as N_NAME N_NAME , type INTEGER as N_REGIONKEY N_REGIONKEY"
   | combined  0
   | next

 stage S02 on all partitions :
     indexJoin Region IxR_REGIONKEY " BOUND $I1 $3 == "
   | combined  0
   | next

 stage S04 on origin :
     output
   | sink
   | first

end ;

