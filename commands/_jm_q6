/*============================================================================*/
/* _jm_q6 -- Query6                                                           */
/*============================================================================*/

/jobMetrics
/joWrite
/filterPred
/pipelineName = "_jm_q6"
select
    sum(l_extendedprice*l_discount) as revenue
from
   lineitem
where
    l_shipdate >= '1994-01-01'
    and l_shipdate < '1995-01-01'
    and l_discount between .06 - 0.01 and .06 + 0.01
    and l_quantity < 24;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
