__TPCH_SCHEMA

create index IxC_NATIONKEY ON CUSTOMER (C_NATIONKEY)  ;
CREATE INDEX IxN_REGIONKEY ON nation(N_REGIONKEY);
create index IxS_NATIONKEY on supplier (S_NATIONKEY);

/*

// NOTE:
  In Stage S02 ColPpg is not correct.

: StreamDef_arriving 0x20487d200040
            Col [0] : $1 C0_S_SUPPKEY (INTEGER)
            Col [1] : $2 C1_S_NATIONKEY (INTEGER)
: ColPpg 0x2048310b0040
             nArriving 2
             m_axCol[0] : m_i_CellIn [0] -> m_i_StructCell [0] $1 ($1 $1)
             m_axCol[1] : m_i_CellIn [3] -> m_i_StructCell [5] $6 ($4 $6)
*/

/transliterated
/weaved
/pipeline_def
/pipelineName = "OptQ5"
select
  n_name,
  sum(l_extendedprice * (1 - l_discount)) as revenue
from
  customer,
  orders,
  lineitem,
  supplier,
  nation,
  region
where
  c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and l_suppkey = s_suppkey
  and c_nationkey = s_nationkey
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'AMERICA'
  and o_orderdate >= DATE '1994-01-01'
  and o_orderdate < DATE '1995-01-01'
group by
  n_name
order by
  revenue desc;

