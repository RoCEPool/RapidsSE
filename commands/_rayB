_lineitem
_orders

create index IxL_ORDERKEY  on Lineitem (L_ORDERKEY);
create index IxO_ORDERKEY  on Orders   (O_ORDERKEY);

load lineitem "../tpch/SF_0001/lineitem.csv" ;
load orders   "../tpch/SF_0001/orders.csv" ;


/weaver2
/glean_interactive
/transliterated
/weaved
/optimise_passthru
pipeline _unnamed_
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
      scan      Lineitem
    | hash "type INTEGER $1"
    | combined  0
    | next hashcast

  stage S02 on all partitions :
      indexJoin orders IxO_ORDERKEY " BOUND $I1 $1 == "
    | combined  0
    | next

  stage S06 on origin :
      output
    | sink
    | first

end ;


