create table TABLE8 (
  pcol8   INTEGER NOT NULL,
  tcol8   INTEGER NOT NULL,
  cola8   INTEGER,
  colb8   VARCHAR(10),
  ucol    INTEGER,
  ucolvc  VARCHAR(5),
  colh8   INTEGER,
  coli8   VARCHAR(5)
);

create index table8_pcol8 on table8(pcol8);

Load TABLE8 "../DATA/Load/tbl8data.csv";

create table TABLE9 (
  pcol9   INTEGER NOT NULL,
  scol9   INTEGER NOT NULL,
  tcol9   INTEGER NOT NULL,
  colb9   VARCHAR(20),
  cold9   FLOAT,
  cole9   DECIMAL,
  colf9   INTEGER,
  colg9   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index table9_pcol9 on table9(pcol9);
create index table9_ucolvc on table9(ucolvc);
create index table9_colb9 on table9(colb9);

Load TABLE9 "../DATA/Load/tbl9data.csv";
/*
/glean_cue_from = "vH60_T10_Produce_maybeIndexJoin_Under_filter"
/glean_interactive
/transliterated
/weaved
select pcol8, colb8, pcol9, colb9
  from table8 join table9 on colb8 = colb9
  where pcol9 between 219 and 221 order by pcol9, pcol8;
*/

pipeline _unnamed_
  tag <optimised> = 1 endTag
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
      scan      TABLE8
    | next

  stage S02 on all partitions :
      indexJoin TABLE9 table9_colb9 " BOUND $I1 $4 == "
    | combined  0
    | next


  stage S07 on origin :
      output
    | sink
    | first

end ;

