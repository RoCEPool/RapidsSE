create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE1_PCOL1 on table1(pcol1);
create index TABLE1_UCOL on table1(ucol);
create index TABLE1_UCOLVC on table1(ucolvc);
create index TABLE1_COLA1 on table1(cola1);

Load TABLE1 "../DATA/Load/tbl1data.csv";

create table TABLE4 (
  pcol4   INTEGER NOT NULL,
  scol4   INTEGER NOT NULL,
  ucol    INTEGER,
  ucolvc  VARCHAR(5),
  cola4   INTEGER,
  colb4   VARCHAR(10),
  colc4   TIMESTAMP,
  cole4   DECIMAL(15, 2)
);

create index table4_cola4 on table4(cola4);
create index table4_ucol on table4(ucol);

Load TABLE4 "../DATA/Load/tbl4data.csv";

select * from dummy;

trackMemory;

/glean_cue_from = "vH60_T10_Produce_maybeIndexJoin_Under_filter"
/glean_interactive
/transliterated
/weaved
select a.cola1 from table1 a join table4 b on a.cola1 = b.cola4
   where cola1 > 400 // and cola1 < 500
   order by a.cola1;

MemoryLeaks;

