create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);
Load TABLE1 "../DATA/Load/tbl1data.csv" ;

create table TABLE2 (
  pcol2   INTEGER NOT NULL,
  scol2   INTEGER NOT NULL,
  cola2   INTEGER,
  colb2   VARCHAR(10),
  colc2   TIMESTAMP,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE2_PCOL2 on TABLE2 (pcol2);
Load TABLE2 "../DATA/Load/tbl2data.csv" ;

create table TABLE4 (
  pcol4   INTEGER NOT NULL,
  scol4   INTEGER NOT NULL,
  ucol    INTEGER,
  ucolvc  VARCHAR(5),
  cola4   INTEGER,
  colb4   VARCHAR(10),
  colc4   TIMESTAMP,
  cole4   DECIMAL(15, 2)
);

create index TABLE4_PCOL4 on TABLE4 (pcol4);
Load TABLE4 "../DATA/Load/tbl4data.csv" ;


// RAY: I have simplified the statement that was failing.
// It is a 3-way join.
// I see that one of the filters is in the wrong place in the weaved pipeline

/glean_cue_from = "vH60_T10_Produce_maybeIndexJoin_Under_filter"
/glean_cue_trace = "x"
/glean_interactive
/transliterated
