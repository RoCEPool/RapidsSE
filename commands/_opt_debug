/*============================================================================*/
/* _opt_debug -- (join)                                                       */
/*============================================================================*/

create table TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);
Load TABLE1 "../DATA/Load/tbl1data.csv" ;

create table TABLE9 (
  pcol9   INTEGER NOT NULL,
  scol9   INTEGER NOT NULL,
  tcol9   INTEGER NOT NULL,
  colb9   VARCHAR(20),
  cold9   FLOAT,
  cole9   DECIMAL,
  colf9   INTEGER,
  colg9   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);

create index TABLE9_PCOL9 on TABLE9(pcol9);
Load TABLE9 "../DATA/Load/tbl9data.csv";

explain stage transliterate
  select a.colb1, b.colb9, avg(a.colf1 + b.colf9) from table1 a join table9 b on pcol1 = pcol9
    where b.colb9 < 'INDIGO' group by a.colb1, b.colb9
    order by b.colb9, a.colb1;


// RAY: Notice the sort is cut
// the groupby and orderby keys are not in the same order
// I see that Card::bValuesSameRecursive(Card* pCard_b, i8 iDepth, bool bTestL0) is not comparing the coreect things
// the CK_DIECTION's m_sValue needs to match
// and the columns ordinal numbers need to match
// here group by is  a.colb1, b.colb9
//      and order by b.colb9, a.colb1

/weaved
/glean_interactive
/pipelineName = "_r_opt_debug"
select a.colb1, b.colb9, avg(a.colf1 + b.colf9) from table1 a join table9 b on pcol1 = pcol9
  where b.colb9 < 'INDIGO' group by a.colb1, b.colb9
  order by b.colb9, a.colb1;

;

