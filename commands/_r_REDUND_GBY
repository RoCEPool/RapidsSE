/* _r_REDUND_GBY -- redundant group by test                                   */
/*============================================================================*/

trackMemory;

_r_schema

create unique index O_idx0  on Orders   (O_ORDERKEY );
create index L_idx0  on Lineitem (L_ORDERKEY );

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimise
/glean_cue_from = "vSeries_90_Stream_Ordering"
/optimiser_trace
/transliterated
/weaved
/pipelineName = "_r_STREAM_ORDER"
select o_orderkey, o_custkey, avg(l_extendedprice)
  from Orders, Lineitem
 where
       O_ORDERKEY = L_ORDERKEY
   and o_orderkey < 100
   and o_orderkey > 3
   and o_totalPrice > 0.0
   and o_orderStatus = 'F'
 group by O_ORDERKEY, O_CUSTKEY
 order by O_ORDERKEY, O_CUSTKEY
;

