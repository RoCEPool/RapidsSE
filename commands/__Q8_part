/*============================================================================*/
/* __Q8_PART                                                                  */
/*============================================================================*/

/optimise_passthru
 pipeline Q8
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     scan part
     | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type VARCHAR ( 0 ) as P_TYPE P_TYPE"
     | filter "type BOOLEAN P_TYPE 'ECONOMY ANODIZED STEEL' =="
     | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY"
     | combined 0
     | next broadcast

   stage S02 on all partitions multiple threads 4:
     indexJoin LineItem IxL_PARTKEY "BOUND $I1 P_PARTKEY =="
     | project "type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE  ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT "
     | globalHash ORDERS GxO_ORDERKEY "type INTEGER ( 19 ) L_ORDERKEY"
     | combined 0
     | next hashcast

   stage S03 on all partitions :
     rrfJoin ORDERS "type INTEGER ( 19 ) L_ORDERKEY"
     | project "type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
                type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT"

     | filter "type BOOLEAN } DATE '1995-01-01'  DATE '1996-12-31' O_ORDERDATE between"
     | indexJoin customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
     | project "type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY ,
                type INTEGER ( 19 ) as O_YEAR O_ORDERDATE extract_year ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT"

     | indexJoin nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY =="
     | project "type INTEGER ( 19 ) as N_REGIONKEY N_REGIONKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT"

     | indexJoin region IxR_REGIONKEY "BOUND $I1 N_REGIONKEY =="
     | project "type VARCHAR ( 0 ) as R_NAME R_NAME ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT"
     | filter "type BOOLEAN R_NAME 'AMERICA' =="
     | project "type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT"
     | hash "type INTEGER ( 19 ) L_SUPPKEY"
     | combined 0
     | next hashcast

   stage S04 on all partitions :
     indexJoin supplier IxS_SUPPKEY "BOUND $I1 L_SUPPKEY =="
     | project "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT"
     | indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
     | project "type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as VOLUME L_EXTENDEDPRICE 1.00 L_DISCOUNT -  * ,
                type VARCHAR ( 0 ) as NATION N_NAME"
     | gbyAgg " GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 )  ) VOLUME sum  ,
                      type DECIMAL ( 19  2 ) )  } type DECIMAL ( 19  2 ) NATION 'BRAZIL'  ==  WHEN  VOLUME THEN  0.00  ELSE  ENDIF  CASE  sum  "
     | combined 0
     | next

   stage S05 on all nodes :
     gbyAgg " GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 ) )  $2 sum  ,
                      type DECIMAL ( 19  2 ) )  $3 sum  "
     | combined 0
     | next

   stage S06 on origin :
     gbyAgg " GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 ) )  $2 sum  ,
                      type DECIMAL ( 19  2 ) )  $3 sum  "
     | combined 0
     | next

   stage S07 on origin :
     project " type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as mkt_share $3 $2 /  "
     | combined 0
     | next

   stage S08 on origin :
     output
     | sink
     | first
 end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
