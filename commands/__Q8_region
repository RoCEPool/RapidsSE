/*============================================================================*/
/* __Q8_REGION                                                                */
/*============================================================================*/

/optimise_passthru
 pipeline Q8
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     scan rapidsse public region
     | project "type VARCHAR R_NAME as R_NAME ,
                type INTEGER ( 19 ) R_REGIONKEY as R_REGIONKEY"
     | filter "type BOOLEAN R_NAME 'AMERICA' =="
     | indexJoin nation IxN_REGIONKEY "BOUND $I1 R_REGIONKEY =="
     | project "type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY"
     | indexJoin customer IxC_NATIONKEY "BOUND $I1 N_NATIONKEY =="
     | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY"
     | combined 0
     | next

   stage S02 on all partitions:
     indexJoin orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
     | project "type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE ,
                type integer ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE "
     | filter "type BOOLEAN O_ORDERDATE DATE '1995-01-01' >=  O_ORDERDATE DATE '1996-12-31' <= and"
     | project "type integer ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type INTEGER ( 19 ) as O_YEAR O_ORDERDATE extract_year"
     | hash "type INTEGER ( 19 ) O_ORDERKEY"
     | combined 0
     | next hashcast

   stage S03 on all partitions  multiple threads 4:
     indexJoin LineItem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
     | project "type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type INTEGER ( 19 ) as L_PARTKEY L_PARTKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
                type DECIMAL ( 19  2 ) as l_discount l_discount"
     | hash "type INTEGER ( 19 ) L_PARTKEY"
     | combined 0
     | next hashcast

   stage S04 on all partitions :
     indexJoin part IxP_PARTKEY "BOUND $I1 L_PARTKEY =="
     | project "type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                     type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                     type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
                     type DECIMAL ( 19  2 ) as l_discount l_discount ,
                     type VARCHAR ( 0 ) as P_TYPE P_TYPE"
     | filter "type BOOLEAN P_TYPE 'ECONOMY ANODIZED STEEL' =="
     | project "type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
                type DECIMAL ( 19  2 ) as l_discount l_discount"
     | hash "type INTEGER ( 19 ) L_SUPPKEY"
     | combined 0
     | next hashcast

   stage S05 on all partitions :
     indexJoin supplier IxS_SUPPKEY "BOUND $I1 L_SUPPKEY =="
     | project "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
                type DECIMAL ( 19  2 ) as l_discount l_discount"
     | indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
     | project "type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as VOLUME L_EXTENDEDPRICE 1.00 L_DISCOUNT -  * ,
                type VARCHAR ( 0 ) as NATION N_NAME"
     | gbyAgg " GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 )  ) VOLUME sum  ,
                      type DECIMAL ( 19  2 ) )  } type DECIMAL ( 19  2 ) NATION 'BRAZIL'  ==  WHEN  VOLUME THEN  0.00  ELSE  ENDIF  CASE  sum  "
     | combined 0
     | next

   stage S06 on all nodes :
     gbyAgg " GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 ) )  $2 sum  ,
                      type DECIMAL ( 19  2 ) )  $3 sum  "
     | combined 0
     | next

   stage S07 on origin :
     gbyAgg " GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 ) )  $2 sum  ,
                      type DECIMAL ( 19  2 ) )  $3 sum  "
     | combined 0
     | next

   stage S08 on origin :
     project " type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as mkt_share $3 $2 /  "
     | combined 0
     | next

   stage S09 on origin :
     output
     | sink
     | first
 end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
