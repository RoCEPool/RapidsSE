//OPTIMISED QUERY

pipeline unnamed
  begin
    stage S00 on origin :
      start
      | pulse once
      | next

    stage S01 on all partitions :
      scan rapidsse public REGION
      | project " type INTEGER )  $1 max  "
      | combined 0
      | next

    stage S02 on all nodes :
      project " type INTEGER )  $1 max  "
      | combined 0
      | next

    stage S03 on origin :
      project " type INTEGER )  $1 max  "
      | combined 0
      | next broadcast

    stage S04 on all partitions :
      indexJoin NATION IxN_NATIONKEY "BOUND $I1"  // cross join
      | project " type INTEGER as n_nationkey $2 , type INTEGER as regionMax $1  "
      | combined 0
      | next

    stage S05 on origin :
      output
      | sink
      | first
  end ;



