// --initial _jo1_C_L_O_S

__TPCH_SCHEMA

/jobMetrics
/glean_interactive
/transliterated
/weaved
/pipelineName = "_jo1_C_L_O_S"
select
       count(*)
  from
       Customer, //  29
       Lineitem, // 630
       Orders,   // 181
       Supplier  //   2
 where
       C_CUSTKEY  = O_CUSTKEY
   and O_ORDERKEY = L_ORDERKEY
   and L_SUPPKEY  = S_SUPPKEY
;

