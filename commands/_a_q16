/*============================================================================*/
/* _a_q16 -- Query16 (hand coded pipeline)                                    */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select
  p_brand,
  p_type,
  p_size,
  count(distinct ps_suppkey) as supplier_cnt
from
  partsupp,
  part
where
  p_partkey = ps_partkey
  and p_brand <> 'Brand#45'
  and p_type not like 'MEDIUM POLISHED%'
  and p_size in (49,14,23,45,19,3,36,9)
  and ps_suppkey not in
    (
     select
       s_suppkey
     from
       supplier
     where
       s_comment like '%Customer%Complaints%' )
group by
 p_brand,
 p_type,
 p_size
order by
 supplier_cnt desc,
 p_brand,
 p_type,
 p_size;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : PARTSUPP, PART, SUPPLIER
// JOIN ORDER : PART->PARTSUPP
// INDEXES    : IxPS_PARTKEY
//              IxS_SUPPKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * 'NOT IN' IS TRANSFORMED INTO KEYNOTEXISTS OPERATOR
//   * FILTER PUSH-DOWN
//   * CHANGED ORDER OF FILTERS IN THE ORDER OF LEAST SELECTION TO HIGHER.
//   * MINIMAL PROJECTIONS

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//   NONE


* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

// pipeline begin
pipeline Query16
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public part
    | filter " type BOOLEAN }  49  14  23  45  19  3  36  9  #8  P_SIZE in"
    | filter " type BOOLEAN  P_BRAND 'Brand#45' !="
    | filter " type BOOLEAN }  P_TYPE 'MEDIUM POLISHED%'  16 matchLeading not"
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type VARCHAR as P_BRAND P_BRAND ,
               type VARCHAR as P_TYPE P_TYPE ,
               type INTEGER as P_SIZE P_SIZE"
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin PartSupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project "type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY ,
               type VARCHAR as P_BRAND P_BRAND ,
               type VARCHAR as P_TYPE P_TYPE ,
               type INTEGER as P_SIZE P_SIZE"
    | combined 0
    | next

  stage S03 on all partitions :
    aggreg " groupBy type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                     type VARCHAR as P_BRAND P_BRAND ,
                       type VARCHAR as P_TYPE P_TYPE ,
                       type INTEGER as P_SIZE P_SIZE
               aggregates
                       type INTEGER  as PS_SUPPKEY $K1 ,
                       type VARCHAR  as P_BRAND $K2 ,
                       type VARCHAR  as P_TYPE $K3 ,
                       type INTEGER  as P_SIZE $K4 "


    | combined 0
    | next

  stage S04 on all nodes :
    aggreg " groupBy type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                         type VARCHAR as P_BRAND P_BRAND ,
                           type VARCHAR as P_TYPE P_TYPE ,
                           type INTEGER as P_SIZE P_SIZE
                   aggregates
                           type INTEGER  as PS_SUPPKEY $K1 ,
                           type VARCHAR  as P_BRAND $K2 ,
                           type VARCHAR  as P_TYPE $K3 ,
                           type INTEGER  as P_SIZE $K4 "
    | hash " type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S05 on all partitions :
     keyNotExists SUPPLIER IxS_SUPPKEY  "BOUND $I1 PS_SUPPKEY =="
               "type BOOLEAN  }  S_COMMENT '%Customer%Complaints%'  8 10 matchMiddle1"
    | combined 0
    | next

  stage S06 on all partitions :
    aggreg " groupBy  type VARCHAR as P_BRAND P_BRAND ,
                       type VARCHAR as P_TYPE P_TYPE ,
                       type INTEGER as P_SIZE P_SIZE
                       aggregates
                       type VARCHAR  as P_BRAND $K1 ,
                       type VARCHAR  as P_TYPE $K2 ,
                       type INTEGER  as P_SIZE $K3 ,
                       type INTEGER  as supplier_cnt ) PS_SUPPKEY COUNT"
    | combined 0
    | next

  stage S07 on all nodes :
    aggreg " groupBy type VARCHAR as P_BRAND P_BRAND ,
                     type VARCHAR as P_TYPE P_TYPE ,
                     type INTEGER as P_SIZE P_SIZE
                     aggregates
                     type VARCHAR  as P_BRAND $K1 ,
                     type VARCHAR  as P_TYPE $K2 ,
                     type INTEGER  as P_SIZE $K3 ,
                     type INTEGER  as supplier_cnt ) supplier_cnt SUM"
    | combined 0
    | next

  stage S08 on origin :
    aggreg " groupBy  type VARCHAR as P_BRAND P_BRAND ,
                      type VARCHAR as P_TYPE P_TYPE ,
                      type INTEGER as P_SIZE P_SIZE
                      aggregates
                      type VARCHAR  as P_BRAND $K1 ,
                      type VARCHAR  as P_TYPE $K2 ,
                      type INTEGER  as P_SIZE $K3 ,
                      type INTEGER  as supplier_cnt ) supplier_cnt SUM"
    | combined 0
    | next

  stage S09 on origin :
    sort " type INTEGER $4 DESC  ,
           type VARCHAR as P_BRAND P_BRAND ASC ,
           type VARCHAR as P_TYPE P_TYPE ASC ,
           type INTEGER as P_SIZE P_SIZE ASC "
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

// pipeline end

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
