/*============================================================================*/

__TPCH_SCHEMA

metricsCtl enable;

/time /jobMetrics
  select l_returnflag, l_linestatus,
    sum(l_quantity) as sum_qty,
    sum(l_extendedprice) as sum_base_price,
    sum(l_extendedprice*(1-l_discount)) as sum_disc_price,
    sum(l_extendedprice*(1-l_discount)*(1+l_tax)) as sum_charge,
    avg(l_quantity) as avg_qty,
    avg(l_extendedprice) as avg_price,
    avg(l_discount) as avg_disc,
    count(*) as count_order
  from lineitem
  where l_shipdate <= DATE '1998-09-01'
  group by l_returnflag, l_linestatus
 order by l_returnflag, l_linestatus;

metricsCtl disable;

sleep 5;

sysReport;

select thisNodeName as thisNode,
     otherNodeName as otherNode,
     sum(sendCount)  as sCount,
     sum(sendBytes)  as sBytes,
     sum(sendBuffer) as sBuffer,
     sum(recvCount)  as rCount,
     sum(recvBytes)  as rBytes,
     sum(recvBuffer) as rBuffer
  from se__jobNetwork group by thisNodeName, otherNodeName;



