/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
QUERY 3
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

/////////////////////////
//SF001: 82ms          //
/////////////////////////

/time pipeline Query3
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    indexscan Customer IxC_CUSTKEY "LBOUND $I1 0 >="
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project expr type INTEGER as C_CUSTKEY C_CUSTKEY
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
    | filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-03-15' <"
    | project "type INTEGER as O_ORDERKEY J1_O_ORDERKEY , type DATE as O_ORDERDATE J1_O_ORDERDATE , type INTEGER as O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash expr type INTEGER O_ORDERKEY
    | combined 0
    | next hashcast

  stage stageNew2 on all partitions :
    sort "type INTEGER O_ORDERKEY ASC"
    | combined 0
    | next

  stage S03 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | filter "type BOOLEAN J1_L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg " ordGroupBy type INTEGER J1_L_ORDERKEY aggregates type INTEGER as L_ORDERKEY $K1 , type DECIMAL as REVENUE ) J1_L_EXTENDEDPRICE 1. J1_L_DISCOUNT -  *  sum  , type DATE as O_ORDERDATE  O_ORDERDATE , type INTEGER as O_SHIPPRIORITY O_SHIPPRIORITY "
    | combined 0
    | next

   stage S04 on origin :
    top "TOP type DECIMAL Revenue" 10
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;

