_nation
/time load nation   "<tpch_dir>/nation.<suffix>";

/weaver2
/pipeline_def
/weaved
/optimise_passthru
pipeline unamed
begin
  stage S00 on origin :
    start
    | pulse once
    | next
  stage S01 on all partitions :
    scan rapidsse public Nation
    | project " type INTEGER as n_nationkey $1 , type VARCHAR as n_name $2 "
    | combined 0
    | next
  stage S02 on all partitions :
    top "type INTEGER $1" 3
    | combined 0
    | next
  stage S03 on origin :
    output
    | sink
    | first
end ;

