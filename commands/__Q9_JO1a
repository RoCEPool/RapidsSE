/*============================================================================*/
/* __Q9_POC3_P_OPT2                                                           */
/*============================================================================*/

/optimise_passthru
pipeline Query9
  begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions:
    scan orders
   | project "type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
              type INTEGER ( 19 ) as O_YEAR O_ORDERDATE extract_year"
   | hash "type INTEGER ( 19 ) O_ORDERKEY"
   | combined 0
   | next hashcast

 stage S02 on all partitions multiple threads 4:
   indexJoin LINEITEM IxL_ORDERKEY "bound $I1 O_ORDERKEY =="
   | project "type INTEGER ( 19 ) as O_YEAR O_YEAR ,
              type INTEGER ( 19 ) as L_PARTKEY L_PARTKEY ,
              type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
              type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
              type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
              type DECIMAL ( 19 2 ) as L_QUANTITY L_QUANTITY"
   | hash "type INTEGER ( 19 ) L_PARTKEY"
   | combined 0
   | next hashcast

  stage S03 on all partitions :
    indexJoin PART IxP_PARTKEY "bound $I1 L_PARTKEY =="
    | project "type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type INTEGER ( 19 ) as L_PARTKEY L_PARTKEY ,
               type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
               type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
               type DECIMAL ( 19 2 ) as L_QUANTITY L_QUANTITY ,
               type VARCHAR ( 55 ) as P_NAME P_NAME"
    | filter "type BOOLEAN }  P_NAME '%green%' 5 matchMiddle"
    | combined 0
    | next

  stage S03 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "bound $I1 L_PARTKEY =="
    | project "type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
               type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
               type DECIMAL ( 19 2 ) as L_QUANTITY L_QUANTITY ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST"

    | filter "type BOOLEAN L_SUPPKEY PS_SUPPKEY =="
    | hash "type INTEGER ( 19 ) PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S04 on all partitions :
    indexJoin supplier IxS_SUPPKEY "bound $I1 PS_SUPPKEY =="
    | project "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
               type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as AMOUNT L_EXTENDEDPRICE 1.0 L_DISCOUNT -  *  PS_SUPPLYCOST L_QUANTITY *  - "
    | combined 0
    | next

 stage S05 on all partitions :
  gbyAgg "groupBy type INTEGER ( 19 ) S_NATIONKEY ,
                      type INTEGER ( 19 ) O_YEAR
          aggregates
                  type INTEGER ( 19 ) as S_NATIONKEY $K1 ,
                  type INTEGER ( 19 ) as O_YEAR $K2 ,
                  type DECIMAL ( 19  2 ) as SUM_PROFIT ) AMOUNT sum  "
  | combined 0
  | next

stage S06 on all nodes :
  gbyAgg "groupBy type INTEGER ( 19 ) S_NATIONKEY ,
                  type INTEGER ( 19 ) O_YEAR
          aggregates
                   type INTEGER ( 19 ) as S_NATIONKEY $K1 ,
                   type INTEGER ( 19 ) as O_YEAR $K2 ,
                   type DECIMAL ( 19  2 ) as SUM_PROFIT ) SUM_PROFIT sum  "
  | combined 0
  | next

stage S07 on origin :
  gbyAgg "groupBy type INTEGER ( 19 ) S_NATIONKEY ,
                  type INTEGER ( 19 ) O_YEAR
          aggregates
                   type INTEGER ( 19 ) as S_NATIONKEY $K1 ,
                   type INTEGER ( 19 ) as O_YEAR $K2 ,
                   type DECIMAL ( 19  2 ) as SUM_PROFIT ) SUM_PROFIT sum  "
  | hash "type INTEGER ( 19 ) S_NATIONKEY"
  | combined 0
  | next hashcast

stage S08 on all partitions:
  indexJoin NATION IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
  | project "type VARCHAR ( 0 ) as NATION N_NAME ,
             type INTEGER ( 19 ) as O_YEAR O_YEAR ,
             type DECIMAL ( 19  2 ) as SUM_PROFIT SUM_PROFIT"
  | combined 0
  | next

stage S09 on origin :
  sort "type VARCHAR ( 0 ) as NATION NATION ASC ,
          type INTEGER ( 19 ) as O_YEAR O_YEAR DESC"
  | combined 0
  | next

stage S11 on origin :
  output
  | sink
  | first
end ;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
