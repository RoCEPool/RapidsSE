/*============================================================================*/
/* _ray_indexJoin                                                             */
/*============================================================================*/

tag default <tpch_dir> = "../tpch/sf_0001";
tag default <suffix>   = "csv";

_customer
_orders_custkey

load Customer "<tpch_dir>/customer.<suffix>" ;
load Orders "<tpch_dir>/orders.<suffix>" ;

create index Ix_CUSTKEY on Orders(O_CUSTKEY);

/optimiser_trace
/optimise_passthru
/keepCodeFile
/weaved
/pipeline_def
pipeline _ray_indexJoin2
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
      scan      Customer
    | indexJoin Orders Ix_CUSTKEY " BOUND $I1 $1 == "
    | project   "   type VARCHAR as C0_c_mktsegment $7
                  , type INTEGER as C1_c_nationkey $4
                  , type INTEGER as C2_c_custkey $1
                  , type INTEGER as C3_o_custkey $10
                  , type DATE as C4_o_orderdate $13 "
    | combined 0
    | next

  stage S04 on origin :
      output
    | sink
    | first

end ;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

drop table Customer;
drop table Orders;

