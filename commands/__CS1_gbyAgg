_nation
/time load nation   "<tpch_dir>/nation.<suffix>";

//explain stage transliterate select sum(n_nationKey) from nation group by n_regionKey;

/optimise_passthru
pipeline unamed
begin
 stage stageStart on origin :
   start
   | pulse once
   | stageMarker0541

 stage stageMarker0541 on all partitions :
   scan rapidsse public Nation
   | gbyAgg " groupBy  type INTEGER as n_regionkey $3 aggregates  type INTEGER $K1 , type VARCHAR )  $2 max 1 + "
   | combined 0
   | next

 stage stageLast on origin :
   output
   | sink
   | stageStart
end ;