/*============================================================================*/
/* _a_q4 -- Query4 (hand coded pipeline)                                      */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select o_orderpriority,
       count(*) as order_count
from orders
where o_orderdate >= '1993-07-01'
      and o_orderdate < '1993-10-01'
      and exists (
          select *
          from lineitem
          where l_orderkey = o_orderkey
                and l_commitdate < l_receiptdate )
group by
     o_orderpriority
order by
    o_orderpriority;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : ORDERS, LINEITEM
// JOIN ORDER : ORDERS->LINEITEM
// INDEXES    : IxL_ORDERKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * KEYEXISTS
//   * REMOVED SORT AS ORDERBY AND GROUP BY ON SAME COLUMNS

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

// pipeline begin
pipeline Query4
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan orders
    | filter " type BOOLEAN O_ORDERDATE DATE '1993-07-01' >=
                            O_ORDERDATE DATE '1993-10-01' < and "
    | project "type INTEGER as O_ORDERKEY O_ORDERKEY ,
               type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY"
    | hash "type INTEGER O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    keyExists lineitem IxL_ORDERKEY  "BOUND $I1 O_ORDERKEY =="
                                      "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
    | aggreg "groupby type VARCHAR O_ORDERPRIORITY
              aggregates
              type VARCHAR as O_ORDERPRIORITY $K1 ,
              type INTEGER as ORDER_COUNT ) countAll"
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg "groupby type VARCHAR O_ORDERPRIORITY
            aggregates
            type VARCHAR as O_ORDERPRIORITY $K1 ,
            type INTEGER as ORDER_COUNT ) ORDER_COUNT sum"
    | combined 0
    | next

  stage S04 on origin :
    aggreg "groupby type VARCHAR O_ORDERPRIORITY
            aggregates
            type VARCHAR as O_ORDERPRIORITY $K1 ,
            type INTEGER as ORDER_COUNT ) ORDER_COUNT sum"
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;
// pipeline end

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
