/*============================================================================*/
/* OT_RPL_SCAN_BY_INDEXSCAN                                                   */
/* OT_RPL_GBYAGG_BY_ORDAGG                                                    */
/* OT_CUT_SORT                                                                */
/*============================================================================*/

trackMemory;

_customer
_orders_custkey

create index O_idx0  on orders   (O_CUSTKEY);
create index C_idx0  on customer (C_CUSTKEY);

load Customer "../tpch/sf_0001/customer.csv" ;
load Orders   "../tpch/sf_0001/orders.csv"   ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/optimise
/glean_cue_from = "vS35X_T10_Push_sqB_Into_mqA"
/glean_interactive
/transliterated
/weaved
/pipelineName = "_OT_1"

select
  c_custkey,
  count(o_orderkey) as o_count
from
  customer, orders
where
  o_custkey = c_custkey
  and c_custkey < 50
group by
  c_custkey
order by
  c_custkey
;


