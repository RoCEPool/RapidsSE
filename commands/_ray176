/optimise_passthru
/keepCodeFile
/pipelineName = "_ray176"
/pipelineDef
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    indexScan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | ordAgg " ORDGROUPBY type integer $1 , type integer $2
                 aggregates type integer $K2 , type integer $K1 , type decimal as total )  $5 sum  "
    | filter " type BOOLEAN  $2 90.0  >  "
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
  end ;

_tpchDrop;