// Query8

//NOTE: In stageMarkerB : indexJoin customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
// is converted to :  indexJoin customer IxC_CUSTKEY " BOUND $I1 $2 == "
// should have been : indexJoin customer IxC_CUSTKEY " BOUND $I1 $1 == "
//              as $1 is O_CUSTKEY, $2 is O_ORDERKEY


__TPCH_SCHEMA_LOAD_SF0001

/time
/optimise_passthru
/pipeline_def
/weaved
/keepCodeFile
pipeline Q8
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarkerA on all partitions :
    indexScan orders IxO_ORDERDATE "LBOUND $I1 DATE '1995-01-01' >= UBOUND $I1 DATE '1996-12-31' <="
    | project "type integer as O_CUSTKEY O_CUSTKEY , type integer as O_ORDERKEY O_ORDERKEY , type INTEGER as O_YEAR O_ORDERDATE extract_year"
    | combined 0
    | next

  stage stageMarkerB on all partitions :
    indexJoin customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

/*============================================================================*/
/* end                                                                        */
