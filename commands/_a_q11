/*============================================================================*/
/* _a_q11 -- Query11 (hand coded pipeline)                                    */
/*============================================================================*/

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
select
  ps_partkey,
  sum(ps_supplycost * ps_availqty) as value
from
  partsupp,
  supplier,
  nation
where
  ps_suppkey = s_suppkey
  and s_nationkey = n_nationkey
  and n_name = 'GERMANY'
group by
  ps_partkey
having
  sum(ps_supplycost * ps_availqty) > (

    select
      sum(ps_supplycost * ps_availqty) * 0.0000010000
    from
      partsupp,
      supplier,
      nation
    where
      ps_suppkey = s_suppkey
      and s_nationkey = n_nationkey
      and n_name = 'GERMANY' )

order by
  value desc;

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TABLES     : PARTSUPP, SUPPLIER, NATION
// JOIN ORDER : NATION->SUPPLIER->PARTSUPP....->NATION->SUPPLIER->PARTSUPP
// INDEXES    : IxS_NATIONKEY
//              IxPS_SUPPKEY
//              IxN_NATIONKEY

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// TRICKS:
//   * FLATTENING WITH CROSS-JOIN
//   * FILTER PUSH-DOWN
//   * MINIMAL PROJECTION

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

// EXTRA NOTES:
//   CAN EXPLORE DIFFERENT JOIN ORDERS.
//   SHOULD BE REUSING RESULT

* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */

/////////////////////////
//SF001:               //
//SF1:    (.0001/1)    //
//SF10:   (.00001)     //
//SF100:  (.000001)    //
//SF250:  (.0000004)   //
//SF1000: (.0000001)   //
/////////////////////////

// pipeline begin
pipeline Query11
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan supplier
    | project " type INTEGER as S_SUPPKEY S_SUPPKEY ,
                type INTEGER as S_NATIONKEY S_NATIONKEY"
    | combined 0
    | next broadcast

  stage S01 on all partitions :
    indexJoin nation IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | filter " type BOOLEAN J1_N_NAME 'GERMANY'  ==  "
    | project " type INTEGER as S_SUPPKEY S_SUPPKEY"
    | combined 0
    | next

 stage S03 on all partitions :
    indexJoin partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | project " type DECIMAL )  J1_PS_SUPPLYCOST J1_PS_AVAILQTY casttype DECIMAL CAST  *  sum  "
    | combined 0
    | next

  stage S04 on all nodes :
    project " type DECIMAL as INNERRESULT )  $1 sum  "
    | combined 0
    | next

  stage S05 on origin :
    project " type DECIMAL as INNERRESULT )  $1 sum   0.0001  *  "
    | combined 0
    | next broadcast

  stage S07 on all partitions :
    indexJoin supplier IxS_SUPPKEY "bound $I1"
    | project " type INTEGER as S_SUPPKEY J1_S_SUPPKEY ,
                type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
                type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S06 on all partitions :
    indexJoin nation IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | filter " type BOOLEAN J1_N_NAME 'GERMANY'  ==  "
    | project " type INTEGER as S_SUPPKEY S_SUPPKEY ,
                type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next broadcast

  stage S08 on all partitions :
    indexJoin partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | aggreg " groupBy    type INTEGER J1_PS_PARTKEY
               aggregates type INTEGER as PS_PARTKEY $K1 ,
                          type DECIMAL as VALUE )  J1_PS_SUPPLYCOST J1_PS_AVAILQTY casttype DECIMAL CAST  *  sum  ,
                          type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S09 on all nodes :
    aggreg " groupBy    type INTEGER PS_PARTKEY
             aggregates type INTEGER as PS_PARTKEY $K1 ,
                        type DECIMAL as VALUE ) VALUE sum  ,
                        type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S10 on origin :
    aggreg " groupBy    type INTEGER PS_PARTKEY
             aggregates type INTEGER as PS_PARTKEY $K1 ,
                        type DECIMAL as VALUE )  VALUE sum  ,
                        type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S11 on origin :
    filter " type BOOLEAN  value INNERRESULT  >  "
    | project " type INTEGER as PS_PARTKEY PS_PARTKEY ,
                type DECIMAL as VALUE VALUE"
    | sort " type DECIMAL VALUE DESC  "
    | combined 0
    | next

  stage S12 on origin :
    output
    | sink
    | first
end ;

// pipeline end

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
