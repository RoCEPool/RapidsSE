select c_phone,
       c_acctbal
  from Customer
 where
       c_acctbal >
                   ( /* Q22_1_1: */
                     select avg(c_acctbal)
                       from Customer
                      where
                            substring (c_phone from 1 for 2)
                              in ('13','31','23','29','30','18','17')
                    )
;

