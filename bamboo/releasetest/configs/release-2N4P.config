# Example release configuration file.
# This defines what machine type and image is used to build and test the release.
#
# This is an INI-style config file with a header section (in square brackets)
# and key=value pairs underneath. Quotes are NOT necessary around strings.

# Common Fields are described below:

# InstanceType:
#   The name of the AWS instance type to be used.
#   Refer to: https://aws.amazon.com/ec2/instance-types/
#   e.g. r5d.16xlarge
#   InstanceType = r5d.16xlarge
#   InstanceType = t2.nano

# ImageId:
#   The ID of the AMI (Amazon Machine Image) to boot.
#   Typical values include:                 IMAGE_ID:               CREATED:    DESCRIPTION:
#     CentOS 7 (HVM)                      = ami-0aedf6b1cb669b4c7   2022-11-14  CentOS-7-2211-20221114_1.x86_64
#     CentOS Stream 8 (HVM)               = ami-0bcfb18e6b095c3c7   2023-05-30  CentOS Stream 8 x86_64 20230530
#     CentOS Stream 9 (HVM)               = ami-09f0af0be9e0a563b   2023-05-30  CentOS Stream 9 x86_64 20230530
#     AmazonLinux2 AMI (HVM) Kernel 5.10  = ami-0cff7528ff583bf9a   2022-06-15  Amazon Linux 2 Kernel 5.10 AMI 2.0.20220606.1 x86_64 HVM gp2
#     Red Hat Enterprise Linux 8 (HVM)    = ami-0b0af3577fe5e3532   2021-05-18  Provided by Red Hat, Inc.
#     Ubuntu Server 16.04 LTS (HVM)       = ami-0b0ea68c435eb488d   2021-09-28  Canonical, Ubuntu, 16.04 LTS, amd64 xenial image build on 2021-09-28
#     Ubuntu Server Pro 16.04 LTS (HVM)   = ami-0b462727db0fa37c3   2022-06-07  Canonical, Ubuntu Server Pro, 16.04 LTS, amd64 xenial image build on 2022-05-31
#     Ubuntu Server 18.04 LTS (HVM)       = ami-0e081ed4ce61c1fb2   2022-06-16  Canonical, Ubuntu, 18.04 LTS, amd64 bionic image build on 2022-06-16
#     Ubuntu Server 20.04 LTS (HVM)       = ami-0439517b5e436bdab   2022-06-27  Canonical, Ubuntu, 20.04 LTS, amd64 focal image build on 2022-06-27
#     Ubuntu Server 22.04 LTS (HVM)       = ami-0f65ab0fd913bc7be   2022-06-16  Canonical, Ubuntu, 22.04 LTS, amd64 jammy image build on 2022-06-16
#     OpenEuler 22.03                     = ami-0f57c186ec535b8ee   2023-03-01  Hanwei, OpenEuler 22.03 LTS
#     Rocky Linux 8                       = ami-09d91a87b002fc97a   2023-02-15  Rocky-8-EC2-Base-8.7-20230215.0.x86_64
#     Rocky Linux 9                       = ami-09c77dc92e45bc3ea   2023-05-13  Rocky-9-EC2-Base-9.2-20230513.0.x86_64
#     Alma Linux 8                        = ami-0d83ec2cef51c2752   2023-05-24  AlmaLinux OS 8.8.20230524 x86_64
#     Alma Linux 9                        = ami-044bd1c89686ca147   2023-05-13  AlmaLinux OS 9.2.20230513 x86_64
#
# IamRoleName:
#   The name of the AWS IAM role that the instance will take on. This typically gives all
#   processes on the instance more permissions to access or interact with AWS resources,
#   such as reading/writing S3 buckets.
#   This entry can be left with an unset value.
#
#  Notes:
#    1. Ubuntu 14 is not supported - had difficulty setting up the environment.
#    2. I couldn't get the free Ubuntu 16 to boot with a cloud-init script. But the Ubuntu16 Pro
#       does work. This does come at an extra cost, but it is minimal. Unfortunately the
#       Ubuntu 16 Pro doesn't run on the latest machine instances such as c6a.4xlarge
#       (only the older c5 machines). So we will ignore Ubuntu 16 for now.
#    3. I couldn't get the CentOS 7 image ami-002070d43b0a4f171 to run on a c6a instance
#       but it did run on a c6i instance, so swapped to that. The previous CentOS 7 image
#       ami-02358d9f5245918a3 worked fine.
#
#  References:
#    https://centos.org/download/aws-images/
#    https://cloud-images.ubuntu.com/locator/ec2/

# Build section.
# What machine and image are we building the release on?
# Specify one BuildName, one InstanceType, one ImageId and one CloudInit only.
[build]

# c6i.4xlarge is 16 cores, 32GB, EBS only. Costs about $0.68/hour
# We always build on a CentOS 7 image for wide binary compatibility.
BuildName = CentOS 7
InstanceType = c6i.4xlarge
ImageId = ami-0aedf6b1cb669b4c7
CloudInit = cloud-init-centos-7-build.sh
IamRoleName = PerfTest


# Test section.
# What machines and images are we testing the above built release on?
# Specify one InstanceType and one or more quad of TestName, ImageId, CloudInit & ClusterConfig.
# Cloudinit and ClusterConfig paths are relative to this file.
[test]

# c6i.2xlarge is 8 cores, 16GB, EBS only. Costs about $0.34/hour
InstanceType = c6i.2xlarge

TestName = CentOS 7
ImageId = ami-0aedf6b1cb669b4c7
CloudInit = cloud-init-centos-7-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = CentOS Stream 8
ImageId = ami-0bcfb18e6b095c3c7
CloudInit = cloud-init-centos-stream-8-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = CentOS Stream 9
ImageId = ami-09f0af0be9e0a563b
CloudInit = cloud-init-centos-stream-9-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Red Hat Enterprise Linux 8
ImageId = ami-0b0af3577fe5e3532
CloudInit = cloud-init-rhel-8-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Ubuntu 18
ImageId = ami-0e081ed4ce61c1fb2
CloudInit = cloud-init-ubuntu-18.04-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Ubuntu 20
ImageId = ami-0439517b5e436bdab
CloudInit = cloud-init-ubuntu-20.04-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Ubuntu 22
ImageId = ami-0f65ab0fd913bc7be
CloudInit = cloud-init-ubuntu-22.04-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Amazon Linux 2
ImageId = ami-0b5eea76982371e91
CloudInit = cloud-init-amazon-linux-2-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = OpenEuler 22
ImageId = ami-0f57c186ec535b8ee
CloudInit = cloud-init-openeuler-22.03-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Rocky Linux 8
ImageId = ami-09d91a87b002fc97a
CloudInit = cloud-init-rocky-8-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Rocky Linux 9
ImageId = ami-09c77dc92e45bc3ea
CloudInit = cloud-init-rocky-9-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Alma Linux 8
ImageId = ami-0d83ec2cef51c2752
CloudInit = cloud-init-alma-8-test.sh
IamRoleName =
ClusterConfig = 2N4P.config

TestName = Alma Linux 9
ImageId = ami-044bd1c89686ca147
CloudInit = cloud-init-alma-9-test.sh
IamRoleName =
ClusterConfig = 2N4P.config
