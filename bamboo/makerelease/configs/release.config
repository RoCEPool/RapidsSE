# Example release configuration file.
# This defines what machine type and image is used to build and test the release.
#
# This is an INI-style config file with a header section (in square brackets)
# and key=value pairs underneath. Quotes are NOT necessary around strings.

# Common Fields are described below:

# InstanceType:
#   The name of the AWS instance type to be used.
#   Refer to: https://aws.amazon.com/ec2/instance-types/
#   e.g. r5d.16xlarge
#   InstanceType = r5d.16xlarge
#   InstanceType = t2.nano

# ImageId
#   The ID of the AMI (Amazon Machine Image) to boot.
#   Typical values include:                 IMAGE_ID:               CREATED:    DESCRIPTION:
#     AmazonLinux2 AMI (HVM) Kernel 5.10  = ami-033b95fb8079dc481   2022-02-08  Amazon Linux 2 Kernel 5.10 AMI 2.0.20220207.1 x86_64 HVM gp2
#     Red Hat Enterprise Linux 8 (HVM)    = ami-0b0af3577fe5e3532   2021-05-18  Provided by Red Hat, Inc.
#     Ubuntu Server 20.04 LTS (HVM)       = ami-04505e74c0741db8d   2021-11-30  Canonical, Ubuntu, 20.04 LTS, amd64 focal image build on 2021-11-29
#     CentOS 7 (HVM)                      = ami-02358d9f5245918a3   2022-03-31  CentOS-7-2111-20220330_2 (x86_64) for HVM Instances
#     CentOS 7 (HVM)                      = ami-00e87074e52e6c9f9   2020-11-10  CentOS 7.9.2009 x86_64
#     CentOS 8 (HVM)                      = ami-0d6e9a57f6259ba3a   2020-10-09  CentOS 8.2.2004 with Updates HVM
#     CentOS Stream 8 (HVM)               = ami-0ee70e88eed976a1b   2021-08-23  CentOS Stream 8 x86_64 20210603
#     CentOS Stream 9 (HVM)               = ami-085d4bf919813b207   2022-06-07  CentOS Stream 9 x86_64 20220606
#
#  Reference: https://centos.org/download/aws-images/

# Build section.
# What machine and image are we building the release on?
# Specify one InstanceType, one ImageId and one CloudInit only.
[build]

InstanceType = t3.xlarge
ImageId = ami-00e87074e52e6c9f9
CloudInit = cloud-init-centos7-build.sh
# We always build on CentOS 7


# Test section.
# What machines and images are we testing the above built release on?
# Specify one InstanceType and one or more quad of TestName, ImageId, CloudInit & ClusterConfig.
# Cloudinit and ClusterConfig paths are relative to this file.
[test]

# c6a.4xlarge is 16 core, 32GB, EBS only. Costs about $0.612/hour
InstanceType = c6a.4xlarge

TestName = CentOS 7
ImageId = ami-00e87074e52e6c9f9
CloudInit = cloud-init-centos7-test.sh
ClusterConfig = 1N4P.config

# TestName = CentOS 8
# ImageId = ami-0d6e9a57f6259ba3a
# CloudInit = cloud-init-centos8-test.sh
# ClusterConfig = 1N4P.config

# TestName = Ubuntu 20
# ImageId = ami-04505e74c0741db8d
# CloudInit = cloud-init-ubuntu20-test.sh
# ClusterConfig = 1N4P.config
