#!/bin/bash
# This file contains function definitions that are imported and used by
# the Bamboo build/test scripts.

# Guard against this file being executed directly.
if [ "${BASH_SOURCE[0]}" -ef "$0" ]
then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

###############################################################################
### Constants                                                               ###
###############################################################################
# Variable that can be tested to see if we have already sourced this file
readonly __BAMBOO_COMMON_FN=1

# An array of possible places the TPC-H data could be kept, depending on the environment
readonly TPCH_LINK_DESTS=( "/mnt/spinningDisk/bamboo/TPCH"
                           "/opt/TPCH" )

###############################################################################
### Functions                                                               ###
###############################################################################

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Print an error message to stderr and exit,
## Params: 
##   $1 : Error message
##   $2..$n : (optional) other arguments to print.

function errorExit() {
  >&2 echo -e "ERROR: $*"
  exit 1
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Print a warning message to stderr
## Params:
##   $1 : Warning message
##   $2..$n : (optional) other arguments to print.

function printError() {
  >&2 echo -e "ERROR: $*"
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Print a warning message to stderr
## Params:  
##   $1 : Warning message
##   $2..$n : (optional) other arguments to print.
  
function printWarning() {
  >&2 echo -e "WARNING: $*"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

## Prints a given message if debug mode is turned on (i.e., $DEBUG == 1).
## Params:
##  $@ : The arguments to print

function debugPrint() {
  if [ -n "${DEBUG}" ] && [ "${DEBUG}" -eq 1 ]; then
    echo -e "$*"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Kills any rogue instances of rapidsse and seth processes.
## Params: None

function killRogueInstances() {
  # Kill all rapidsse instances
  pkill -u $UID -x rapidsse &>/dev/null || true

  # Kill SE Prompt children of SETH
  { jps | grep Seth | cut -d ' ' -f 1 | xargs -r -n 1 ps -o pid= --ppid | xargs -I{} kill -9 {}; } &>/dev/null  || true

  # Kill all SETH instances
  { jps | grep Seth | cut -d ' ' -f 1 | xargs -r -I{}  kill -9 {}; } &>/dev/null || true
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Compresses any large artifact files that were created by building or
## running the tests.
## Params: None

function compressLargeFiles() {

  if [ "${NO_COMPRESS:+x}" == x ]; then
    echo "Skipping compression of large files."
    return
  fi

  if [ ! -f "${BIN_DIR}" ]; then
    echo "Skipping compression of large files because bin dir doesn't exist."
    return
  fi

  # Run in a subshell so that we can change directory temporarily
  (
    # Compress the binaries
    cd "${BIN_DIR}" || errorExit "Directory does not exist: ${BIN_DIR}"
    local sharedObj

    sharedObj="$(ls lib*.so 2>/dev/null)"

    if [ -f "${sharedObj}" ]; then
      tar cvzf "${sharedObj}.tar.gz" "${sharedObj}" &>/dev/null
      rm "${sharedObj}" &>/dev/null
    fi

    local seBinary="rapidsse"
    if [ -f "${seBinary}" ]; then
      tar cvzf "${seBinary}.tar.gz" "${seBinary}" &>/dev/null
      rm "${seBinary}" &>/dev/null
    fi
  )
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Compiles RapidsSE for a given target.
## Params:
##  $1 : the target to be build ("debug" or "release")

function compileSE() {

  local target="$1"

  if [[ "${target}" != "debug" && "${target}" != "release" ]]; then
    errorExit "Invalid target for building RapidsSE. Must be \"debug\" or \"release\" : ${target}"
  fi

  if [ "${NO_BUILD:+x}" == x ]; then
    echo "Skipping building RapidsSE"
    return
  fi

  echo ""
  echo "********************************************************************************"
  echo "*** Building RapidsSE for ${target}"
  echo "********************************************************************************"
  echo ""

  # Run in a subshell so we can change directories without any consequence.
  (
    cd "${SRC_DIR}" || errorExit "Directory does not exist: ${SRC_DIR}"

    # Enable gcc version 5. Required for antlr.
    local gccVersion
    local hasOldGcc

    gccVersion="$(gcc -dumpversion | cut -f1-2 -d.)"
    hasOldGcc="$(echo "${gccVersion} < 5" | bc)"

    if [ "${hasOldGcc}" -eq 1 ]; then
      # Is the Software Collections (SCL) repository installed?
      if ! which scl &>/dev/null ; then
        errorExit "A more modern c++ compiler is required. Either install a newer version of gcc or install the software collections (SCL) repository to get a newer gcc."
      fi

      local newestGccVer
      newestGccVer=$(scl --list | grep devtoolset | cut -d- -f2 | sort -rn | head -n 1)

      if [ -z "${newestGccVer}" ] || ! [[ ${newestGccVer} =~ ^[0-9]+$ ]]; then
        errorExit "Could not determine the newest version of gcc in SCL library."
      fi

      echo "Using GCC version ${newestGccVer} from SCL"
      scl enable devtoolset-${newestGccVer} "make clean && time make ${target} -j$(nproc)"

    else
      make clean && time make "${target}" "-j$(nproc)"
    fi
  )
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Puts together the installer for SE
## Params: none

function assembleSE() {

  local target="$1"

  if [[ "${target}" != "debug" && "${target}" != "release" ]]; then
    errorExit "Invalid target for building RapidsSE. Must be \"debug\" or \"release\" : ${target}"
  fi

  echo ""
  echo "********************************************************************************"
  echo "*** Creating the RapidsSE installer for ${target}"
  echo "********************************************************************************"
  echo ""

  # Run in a subshell so we can change directories without any consequence.
  (
    cd "${PKG_DIR}" || errorExit "Directory does not exist: ${PKG_DIR}"

    NO_BUILD=1 NO_SHELLCHECK=1 ./package.sh
  ) 

  local installer
  installer="$(ls -1 "${OUT_DIR}"/*.run)" || true

  if [ -z "${installer}" ]; then
    errorExit "RapidsSE installation file was not built."
  fi

  # Simplify the path
  installer="$(realpath "${installer}")"

  echo "RapidsSE installation file built at: ${installer}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Pretty prints a given number of seconds as days/hours/minutes/seconds instead.
## Params:
##  $1 : the total number of seconds

function secondsToTime() {

  local T="$1"
  local D="$((T/60/60/24))"
  local H="$((T/60/60%24))"
  local M="$((T/60%60))"
  local S="$((T%60))"
  (( D > 0 )) && printf '%d days ' "${D}"
  (( H > 0 )) && printf '%d hours ' "${H}"
  (( M > 0 )) && printf '%d minutes ' "${M}"
  (( D > 0 || H > 0 || M > 0 )) && printf 'and '
  printf '%d seconds' "${S}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Looks for the TPC-H SF1 data somewhere on the system.
## Returns a zero exit code if the data is found.
## Writes various information messages along the way.
## Params: None

function findTpchData() {

  for dataDir in "${TPCH_LINK_DESTS[@]}"; do
    if isTpchDir "${dataDir}"; then
      return 0
    fi
  done

  printError "Could not find TPC-H SF1 data necessary for these tests. Tried looking in the following directories:"
  >&2 printf "  %s\n" "${TPCH_LINK_DESTS[@]}"
  exit 1
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Looks for the TPC-H SF1 data somewhere on the system. Writes the path out
## to stdout and returns a zero exit code if the data is found.
## This function differs from findTpchData() because we need to return the
## actual location and suppress any other informational messages.
## Params: None

function getTpchDataDir() {

  for dataDir in "${TPCH_LINK_DESTS[@]}"; do
    if isTpchDir "${dataDir}" "1"; then
      echo "${dataDir}"
      return 0
    fi
  done

  exit 1
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a zero exit code if the given path is a TPCH directory with data.
## Params:
##  $1 - path of the directory
##  $2 - (optional) 1 for quiet operation

function isTpchDir() {

  [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || errorExit "Function isTpchDir() needs to be called with 1 or 2 parameters."

  local tpchDir="$1"
  local isQuiet="${2:-0}"

  if [ ! -e "${tpchDir}" ]; then
    [ "${isQuiet:-0}" -eq 1 ] || echo "Looking for TPC-H data found in path: ${tpchDir}"
    return 1;
  fi

  if [ ! -d "${tpchDir}" ]; then
    [ "${isQuiet:-0}" -eq 1 ] || echo "Path ${tpchDir} is not a TPC-H data directory because it is not a directory."
    return 1;
  fi

  # It must have a SF0 and SF1 subdirectories
  local subdirs=( "SF0" "SF1" )

  for subdir in "${subdirs[@]}"; do
    if [ ! -d "${tpchDir}/${subdir}" ]; then
      [ "${isQuiet:-0}" -eq 1 ] || echo "Path ${tpchDir} is not a TPC-H data directory because it does not have a ${subdir} subdirectory."
      return 1;
    fi
  done

  # Check for data files
  local -a files=( "SF1/customer.tbl"
                   "SF1/lineitem.tbl"
                   "SF1/nation.tbl"
                   "SF1/orders.tbl"
                   "SF1/part.tbl"
                   "SF1/partsupp.tbl"
                   "SF1/region.tbl"
                   "SF1/supplier.tbl" )

  for file in "${files[@]}"; do
    if ! [ -f "${tpchDir}/${file}" ]; then
      [ "${isQuiet:-0}" -eq 1 ] || echo "Path ${tpchDir} is not a TPC-H data directory because it is missing the file: ${file}"
      return 1
    fi
  done

  [ "${isQuiet:-0}" -eq 1 ] || echo "Found TPC-H data at path: ${tpchDir}"
  return 0
}

