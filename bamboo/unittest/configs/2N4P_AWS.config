#!/bin/bash

# Cluster config file for AWS.
# A cluster.config file can be created by hand (see note), or automatically
# via the installation wizard.
#
# Note: This file is a bash script expected to be sourced by other scripts.
#       As such it must be a syntactically valid bash script.

# Guard against direct execution
if [ "${BASH_SOURCE[0]}" -ef "$0" ]; then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

CONFIG_VERSION="2"
CONFIG_CREATED="2021-08-18T12:00:00"

NODE_NAME_PREFIX="2N4P_NODE"
NODE_SEQ_NUM=2

declare -ga NODE_LIST
NODE_LIST=( "2N4P_NODE1" "2N4P_NODE2" )

declare -gA NODE_CFG_2N4P_NODE1
NODE_CFG_2N4P_NODE1["params"]=""
NODE_CFG_2N4P_NODE1["threads"]="10"
NODE_CFG_2N4P_NODE1["host"]="127.0.0.1"
NODE_CFG_2N4P_NODE1["name"]="2N4P_NODE1"
NODE_CFG_2N4P_NODE1["partitions"]="4"
NODE_CFG_2N4P_NODE1["mem"]="3"
NODE_CFG_2N4P_NODE1["dir"]="/mnt/disk1/SE-UT/2N4P/2N4P_NODE1"
NODE_CFG_2N4P_NODE1["port"]="20401"     # Format: (0) <nodes> 0 <partitions> 0 <node_sequence>
NODE_CFG_2N4P_NODE1["heartbeat"]="8888"
NODE_CFG_2N4P_NODE1["clusterid"]="0204" # Format: 0N0P

declare -gA NODE_CFG_2N4P_NODE2
NODE_CFG_2N4P_NODE2["params"]=""
NODE_CFG_2N4P_NODE2["threads"]="10"
NODE_CFG_2N4P_NODE2["host"]="127.0.0.1"
NODE_CFG_2N4P_NODE2["name"]="2N4P_NODE2"
NODE_CFG_2N4P_NODE2["partitions"]="4"
NODE_CFG_2N4P_NODE2["mem"]="3"
NODE_CFG_2N4P_NODE2["dir"]="/mnt/disk1/SE-UT/2N4P/2N4P_NODE2"
NODE_CFG_2N4P_NODE2["port"]="20402"     # Format: (0) <nodes> 0 <partitions> 0 <node_sequence>
NODE_CFG_2N4P_NODE2["heartbeat"]="8888"
NODE_CFG_2N4P_NODE2["clusterid"]="0204" # Format: 0N0P
