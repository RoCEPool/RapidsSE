#!/bin/bash

# Cluster config file.
# A cluster.config file can be created by hand (see note), or automatically
# via the installation wizard.
#
# Note: This file is a bash script expected to be sourced by other scripts.
#       As such it must be a syntactically valid bash script.

# Guard against direct execution
if [ "${BASH_SOURCE[0]}" -ef "$0" ]; then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

CONFIG_VERSION="3"
CONFIG_CREATED="2022-07-14T12:00:00"

NODE_NAME_PREFIX="NODE"
NODE_SEQ_NUM=2

declare -ga NODE_LIST
NODE_LIST=( "NODE1" "NODE2" )

declare -gA NODE_CFG_NODE1
NODE_CFG_NODE1["params"]=""
NODE_CFG_NODE1["threads"]="10"
NODE_CFG_NODE1["host"]="127.0.0.1"
NODE_CFG_NODE1["name"]="NODE1"
NODE_CFG_NODE1["partitions"]="4"
NODE_CFG_NODE1["mem"]="6"
NODE_CFG_NODE1["dir"]="/mnt/spinningDisk/rapidsse/NODE1"
NODE_CFG_NODE1["disk_paths"]="/mnt/spinningDisk/rapidsse/NODE1/data"
NODE_CFG_NODE1["internal_port"]="5541"
NODE_CFG_NODE1["client_port"]="9123"
NODE_CFG_NODE1["heartbeat_port"]="8888"
NODE_CFG_NODE1["heartbeat_address"]="BROADCAST"
NODE_CFG_NODE1["clusterid"]="1234"

declare -gA NODE_CFG_NODE2
NODE_CFG_NODE2["params"]=""
NODE_CFG_NODE2["threads"]="10"
NODE_CFG_NODE2["host"]="127.0.0.1"
NODE_CFG_NODE2["name"]="NODE2"
NODE_CFG_NODE2["partitions"]="4"
NODE_CFG_NODE2["mem"]="6"
NODE_CFG_NODE2["dir"]="/mnt/spinningDisk/rapidsse/NODE2"
NODE_CFG_NODE2["disk_paths"]="/mnt/spinningDisk/rapidsse/NODE2/data"
NODE_CFG_NODE2["internal_port"]="5542"
NODE_CFG_NODE2["client_port"]="29123"
NODE_CFG_NODE2["heartbeat_port"]="8888"
NODE_CFG_NODE2["heartbeat_address"]="BROADCAST"
NODE_CFG_NODE2["clusterid"]="1234"
