#!/bin/bash

# Cluster config file for AWS.
# A cluster.config file can be created by hand (see note), or automatically
# via the installation wizard.
#
# Note: This file is a bash script expected to be sourced by other scripts.
#       As such it must be a syntactically valid bash script.

# Guard against direct execution
if [ "${BASH_SOURCE[0]}" -ef "$0" ]; then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

CONFIG_VERSION="2"
CONFIG_CREATED="2021-08-18T12:00:00"

NODE_NAME_PREFIX="1N1P_NODE"
NODE_SEQ_NUM=1

declare -ga NODE_LIST
NODE_LIST=( "1N1P_NODE1" )

declare -gA NODE_CFG_1N1P_NODE1
NODE_CFG_1N1P_NODE1["params"]=""
NODE_CFG_1N1P_NODE1["threads"]="10"
NODE_CFG_1N1P_NODE1["host"]="127.0.0.1"
NODE_CFG_1N1P_NODE1["name"]="1N1P_NODE1"
NODE_CFG_1N1P_NODE1["partitions"]="1"
NODE_CFG_1N1P_NODE1["mem"]="6"
NODE_CFG_1N1P_NODE1["dir"]="/mnt/disk1/SE-UT/1N1P/1N1P_NODE1"
NODE_CFG_1N1P_NODE1["port"]="10101"     # Format: (0) <nodes> 0 <partitions> 0 <node_sequence>
NODE_CFG_1N1P_NODE1["heartbeat"]="8888"
NODE_CFG_1N1P_NODE1["clusterid"]="0101" # Format: 0N0P
