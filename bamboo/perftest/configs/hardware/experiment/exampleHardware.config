# Example hardware configuration file.
# This is an INI-style config file with a header section (in square brackets)
# and key=value pairs underneath. Quotes are NOT necessary around strings.

[hardware]

# The name of the AWS instance type to be used.
# Refer to: https://aws.amazon.com/ec2/instance-types/
# e.g. r5d.16xlarge
# InstanceType = r5d.16xlarge
# InstanceType = t2.nano
# InstanceType = t3.xlarge
InstanceType = m7i.2xlarge

# The ID of the AMI (Amazon Machine Image) to boot.
# Typical values include:
#   AmazonLinux2 AMI (HVM) Kernel 5.10  = ami-0b5eea76982371e91
#   Red Hat Enterprise Linux 8 (HVM)    = ami-0b0af3577fe5e3532
#   Ubuntu Server 20.04 LTS (HVM)       = ami-04505e74c0741db8d
ImageId = ami-0b5eea76982371e91

# Number of machines of the above instance to create.
NumMachines = 1

# IamRoleName:
#   The name of the AWS IAM role that the instance will take on. This typically gives all
#   processes on the instance more permissions to access or interact with AWS resources,
#   such as reading/writing S3 buckets.
#   This entry can be left with an unset value.
IamRoleName = PerfTest

# Spot or on-demand instances?
# Spot instances are cheaper but can be interrupted at any time.
# On-demand cost more, but can run indefinitely.
# (Optional, default = false)
UseSpotInstances = false

# Do we terminate the machines when the test has finished with them?
# (Optional, default = true)
TerminateOnFinish = true
# TerminateOnFinish = false