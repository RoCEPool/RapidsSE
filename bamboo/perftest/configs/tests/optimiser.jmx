            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="createQ15View" enabled="false">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">create view revenue (supplier_no, total_revenue) as 
select
  l_suppkey,
  sum(l_extendedprice * (1 - l_discount)) 
from
  lineitem 
where
  l_shipdate &gt;= date &apos;1996-01-01&apos;
  and l_shipdate &lt; date &apos;1996-01-01&apos; + interval &apos;3&apos; month 
group by
  l_suppkey;</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Update Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
