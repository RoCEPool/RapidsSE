              <stringProp name="query">pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarker2543 on all partitions :
    scan rapidsse public part
    | next

  stage stageMarker2546 on all partitions :
    indexjoin PartSupp IxPS_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;  // J1 - PARTSUPP
    | hash &quot; type INTEGER J1_PS_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage stageMarker2549 on all partitions :
    filter &quot; type BOOLEAN  P_BRAND &apos;Brand#45&apos;  !=
                 }  P_TYPE &apos;MEDIUM POLISHED%&apos;  16 matchLeading  not and
                 }  49  14  23  45  19  3  36  9  #8  P_SIZE in and&quot;
    | keyNotExists SUPPLIER IxS_SUPPKEY  &quot;BOUND $I1 J1_PS_SUPPKEY ==&quot;
               &quot;type BOOLEAN  }  S_COMMENT &apos;%Customer%Complaints%&apos;  8 10 matchMiddle1&quot;
    | aggreg &quot; groupBy  type VARCHAR ( 0 ) as p_brand P_BRAND ,
               type VARCHAR ( 0 ) as p_type P_TYPE ,
               type INTEGER as p_size P_SIZE ,
               type INTEGER as ps_suppkey J1_PS_SUPPKEY
               aggregates
               type VARCHAR ( 0 )  as p_brand $K1 ,
               type VARCHAR ( 0 )  as p_type $K2 ,
               type INTEGER  as p_size $K3 ,
               type INTEGER  as ps_suppkey $K4 &quot;
    | combined 0
    | next

  stage stageMarker2552 on all nodes :
    aggreg &quot; groupBy  type VARCHAR ( 0 ) as p_brand $1 ,
                   type VARCHAR ( 0 ) as p_type $2 ,
                   type INTEGER as p_size $3 ,
                   type INTEGER as ps_suppkey $4
                   aggregates
                   type VARCHAR ( 0 )  as p_brand $K1 ,
                   type VARCHAR ( 0 )  as p_type $K2 ,
                   type INTEGER  as p_size $K3 ,
                   type INTEGER  as ps_suppkey $K4 &quot;
    | combined 0
    | next

  stage stageMarker2555 on origin :
    aggreg &quot; groupBy  type VARCHAR ( 0 ) as p_brand $1 ,
                   type VARCHAR ( 0 ) as p_type $2 ,
                   type INTEGER as p_size $3 ,
                   type INTEGER as ps_suppkey $4
                   aggregates
                   type VARCHAR ( 0 )  as p_brand $K1 ,
                   type VARCHAR ( 0 )  as p_type $K2 ,
                   type INTEGER  as p_size $K3 ,
                   type INTEGER  as ps_suppkey $K4 &quot;
    | hash &quot; type INTEGER PS_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage CNTDST_a on all partitions :
    aggreg &quot; groupBy  type VARCHAR ( 0 ) as p_brand $1 ,
                       type VARCHAR ( 0 ) as p_type $2 ,
                       type INTEGER as p_size $3
                       aggregates
                       type VARCHAR ( 0 )  as p_brand $K1 ,
                       type VARCHAR ( 0 )  as p_type $K2 ,
                       type INTEGER  as p_size $K3 ,
                       type INTEGER  as supplier_cnt ) $4 COUNT&quot;
    | combined 0
    | next

  stage CNTDST_b on all nodes :
    aggreg &quot; groupBy  type VARCHAR ( 0 ) as p_brand $1 ,
                       type VARCHAR ( 0 ) as p_type $2 ,
                       type INTEGER as p_size $3
                       aggregates
                       type VARCHAR ( 0 )  as p_brand $K1 ,
                       type VARCHAR ( 0 )  as p_type $K2 ,
                       type INTEGER  as p_size $K3 ,
                       type INTEGER  as supplier_cnt ) $4 SUM&quot;
    | combined 0
    | next

  stage CNTDST_c on origin :
    aggreg &quot; groupBy  type VARCHAR ( 0 ) as p_brand $1 ,
                           type VARCHAR ( 0 ) as p_type $2 ,
                           type INTEGER as p_size $3
                           aggregates
                           type VARCHAR ( 0 )  as p_brand $K1 ,
                           type VARCHAR ( 0 )  as p_type $K2 ,
                           type INTEGER  as p_size $K3 ,
                           type INTEGER  as supplier_cnt ) $4 SUM&quot;
    | combined 0
    | next

  stage SORT_a on origin :
      sort &quot; type INTEGER $4 DESC  ,
             type VARCHAR ( 0 ) as p_brand $1 ASC  ,
             type VARCHAR ( 0 ) as p_type $2 ASC  ,
             type INTEGER as p_size $3 ASC  &quot;
      | combined 0
      | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;</stringProp>
