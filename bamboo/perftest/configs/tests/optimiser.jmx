            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q14" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">select 
  100.00 * sum(case when p_type like &apos;PROMO%&apos; then l_extendedprice*(1-l_discount) else 0 end) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue
from 
  lineitem, 
  part
where 
  l_partkey = p_partkey
  and l_shipdate &gt;= &apos;1995-09-01&apos;
  and l_shipdate &lt; &apos;1995-09-01&apos; + interval &apos;1&apos; month;</stringProp>
