              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">select 
  s_suppkey, 
  s_name, 
  s_address, 
  s_phone, 
  total_revenue
from 
  supplier, 
  revenue
where 
  s_suppkey = supplier_no
  and total_revenue &gt;= ( select max(total_revenue) from revenue)
order by 
  s_suppkey;</stringProp>
