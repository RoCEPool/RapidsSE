        <collectionProp name="Arguments.arguments">
          <elementProp name="JDBC_URL" elementType="Argument">
            <stringProp name="Argument.name">JDBC_URL</stringProp>
            <stringProp name="Argument.value">${__P(JDBC_URL,jdbc:rapidsse:/opt/rapidsse/bin/rapidsse?extraargs=&quot;--name NODE1 --sen ../sen --commands ../commands&quot;)}</stringProp>
