              <stringProp name="query">pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarker6340 on all partitions :
    indexscan Customer IxC_CUSTKEY &quot;LBOUND $I1 0 &gt;=&quot;
    | filter &quot;type BOOLEAN C_MKTSEGMENT &apos;BUILDING&apos; ==&quot;
    | project expr type INTEGER as C_CUSTKEY C_CUSTKEY
    | combined 0
    | next

  stage stageMarker6343 on all partitions :
    indexjoin Orders IxO_CUSTKEY &quot;BOUND $I1 C_CUSTKEY ==&quot;   // J1 - Orders
    | filter &quot;type BOOLEAN J1_O_ORDERDATE DATE &apos;1995-03-15&apos; &lt;&quot;
    | project &quot;type INTEGER as J1_O_ORDERKEY J1_O_ORDERKEY ,
               type DATE as J1_O_ORDERDATE J1_O_ORDERDATE ,
               type INTEGER as J1_O_SHIPPRIORITY J1_O_SHIPPRIORITY&quot;
    | hash expr type INTEGER J1_O_ORDERKEY
    | combined 0
    | next hashcast

  stage stageNew2 on all partitions :
    sort &quot;type INTEGER J1_O_ORDERKEY ASC&quot;
    | combined 0
    | next

  stage stageMarker6346 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY &quot;BOUND $I1 J1_O_ORDERKEY ==&quot;  // J2 - Lineitem
    | filter &quot;type BOOLEAN J2_L_SHIPDATE DATE &apos;1995-03-15&apos; &gt;&quot;
    | ordAgg &quot; ordGroupBy type INTEGER J2_L_ORDERKEY
                        aggregates
                        type INTEGER as J2_L_ORDERKEY $K1 ,
                        type DECIMAL as REVENUE )  J2_L_EXTENDEDPRICE 1.  J2_L_DISCOUNT -  *  sum  ,
                        type DATE as J1_O_ORDERDATE  J1_O_ORDERDATE ,
                        type INTEGER as J1_O_SHIPPRIORITY J1_O_SHIPPRIORITY &quot;
    | combined 0
    | next

   stage stageNew on origin :
    top &quot;TOP type DECIMAL Revenue&quot; 10
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;</stringProp>
