pipeline Query3
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions multiple threads 4 :
    scan Lineitem
    | project   &quot; type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                , type DATE as L_SHIPDATE L_SHIPDATE &quot;
    | filter    &quot; type BOOLEAN L_SHIPDATE DATE &apos;1995-03-15&apos; &gt; &quot;
    | project   &quot; type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT&quot;
    | globalHash ORDERS GxO_ORDERKEY &quot;type INTEGER ( 19 ) L_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S02 on all partitions:
    rrfJoin ORDERS &quot;type INTEGER ( 19 ) L_ORDERKEY&quot;
    | project   &quot; type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                    , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                    , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                    , type DATE as O_ORDERDATE O_ORDERDATE
                    , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                    , type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY &quot;
    | filter    &quot; type BOOLEAN O_ORDERDATE DATE &apos;1995-03-15&apos; &lt; &quot;
    | hash      &quot;type INTEGER O_CUSTKEY&quot;
    | dynamic
    | next      hashcast

  stage S03 on all partitions :
    indexJoin Customer IxC_CUSTKEY &quot; BOUND $I1 O_CUSTKEY == &quot;
    | filter    &quot; type BOOLEAN C_MKTSEGMENT &apos;BUILDING&apos; == &quot;
    | project   &quot; type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY &quot;
    | gbyAgg    &quot; groupBy
                  type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                aggregates
                  type INTEGER ( 19 ) as L_ORDERKEY $K1
                , type DECIMAL ( 19 2 ) as REVENUE ) L_EXTENDEDPRICE 1.00 L_DISCOUNT - * sum
                , type DATE as O_ORDERDATE $K2
                , type INTEGER ( 19 ) as O_SHIPPRIORITY $K3 &quot;
    | dynamic
    | next

  stage S04 on all nodes :
    gbyAgg    &quot; groupBy
                  type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                aggregates
                  type INTEGER ( 19 ) as L_ORDERKEY $K1
                , type DECIMAL ( 19 2 ) as REVENUE ) REVENUE sum
                , type DATE as O_ORDERDATE $K2
                , type INTEGER ( 19 ) as O_SHIPPRIORITY $K3 &quot;
    | dynamic
    | next

  stage S05 on origin :
    gbyAgg    &quot; groupBy
                  type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY
                , type DATE as O_ORDERDATE O_ORDERDATE
                , type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY
                aggregates
                  type INTEGER ( 19 ) as L_ORDERKEY $K1
                , type DECIMAL ( 19 2 ) as REVENUE ) REVENUE sum
                , type DATE as O_ORDERDATE $K2
                , type INTEGER ( 19 ) as O_SHIPPRIORITY $K3 &quot;
    | dynamic
    | next

  stage S06 on origin :
    sort      &quot; type DECIMAL ( 19 2 ) REVENUE DESC , type DATE O_ORDERDATE ASC &quot;
    | limit      10
    | dynamic
    | next

  stage S07 on origin :
      output
    | sink
    | first

end ;</stringProp>
