              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q22_co" enabled="true">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query22
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions:
    scan Customer
    | project &quot;type DECIMAL ( 19  2 ) as C_ACCTBAL C_ACCTBAL ,
               type VARCHAR ( 0 ) as C_PHONE C_PHONE&quot;
    | filter &quot; type BOOLEAN  C_ACCTBAL 0.00  &gt; &quot;
    | filter &quot; type BOOLEAN  }  &apos;13&apos;  &apos;31&apos;  &apos;23&apos;  &apos;29&apos;  &apos;30&apos;  &apos;18&apos;  &apos;17&apos;  #7  C_PHONE 1  2  substring3  in &quot;
    | aggreg &quot; type DECIMAL ( 19  2 ) )  C_ACCTBAL sum  , type INTEGER ( 19 ) )  C_ACCTBAL count  &quot;
    | combined 0
    | next

  stage S02 on all nodes :
    aggreg &quot; type DECIMAL ( 19  2 ) )  $1 sum  , type INTEGER ( 19 ) )  $2 sum  &quot;
    | combined 0
    | next

  stage S03 on origin :
    aggreg &quot; type INTEGER ( 19 ) )  $2 sum  , type DECIMAL ( 19  2 ) )  $1 sum  &quot;
    | combined 0
    | next

  stage S04 on origin :
    project &quot; type DECIMAL ( 19  2 ) as acctbal $2 $1 casttype DECIMAL ( 19  2 ) CAST  /  &quot;
    | combined 0
    | next broadcast

  stage S05 on all partitions multiple threads 4:
    indexJoin Customer IxC_CUSTKEY &quot;bound $I1&quot;
    | project &quot;type INTEGER ( 0 ) as C_CUSTKEY C_CUSTKEY ,
               type DECIMAL ( 19  2 ) as C_ACCTBAL C_ACCTBAL ,
               type VARCHAR ( 0 ) as C_PHONE C_PHONE ,
               type DECIMAL ( 19  2 ) as acctbal acctbal&quot;
    | filter &quot; type BOOLEAN C_ACCTBAL acctbal  &gt;&quot;
    | filter &quot; type BOOLEAN }  &apos;13&apos;  &apos;31&apos;  &apos;23&apos;  &apos;29&apos;  &apos;30&apos;  &apos;18&apos;  &apos;17&apos;  #7  C_PHONE 1  2  substring3  in &quot;
    | project &quot; type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                type VARCHAR ( 0 ) as cntrycode C_PHONE 1  2  substring3  ,
                type DECIMAL ( 19  2 ) as C_ACCTBAL C_ACCTBAL &quot;
    | combined 0
    | next

  stage S06 on all partitions :
    keyNotExists ORDERS IxO_CUSTKEY  &quot;BOUND $I1 C_CUSTKEY ==&quot;
                   &quot;type BOOLEAN O_CUSTKEY 0 &gt;&quot;
    | project &quot; type VARCHAR ( 0 ) as cntrycode  cntrycode , type DECIMAL ( 19  2 ) as C_ACCTBAL  C_ACCTBAL&quot;
    | combined 0
    | next

 stage S07 on all partitions :
    gbyAgg &quot; groupBy  type VARCHAR ( 0 ) as cntrycode $1 aggregates  type VARCHAR ( 0 ) as cntrycode $K1 , type INTEGER ( 19 ) )  countAll  , type DECIMAL ( 19  2 ) )  $2 sum  &quot;
    | combined 0
    | next

  stage S08 on all nodes :
    gbyAgg &quot; groupBy  type VARCHAR ( 0 ) as cntrycode $1 aggregates  type VARCHAR ( 0 ) as cntrycode $K1 , type INTEGER ( 19 ) )  $2 sum  , type DECIMAL ( 19  2 ) )  $3 sum  &quot;
    | combined 0
    | next

  stage S09 on origin :
    gbyAgg &quot; groupBy  type VARCHAR ( 0 ) as cntrycode $1 aggregates  type VARCHAR ( 0 ) as cntrycode $K1 , type INTEGER ( 19 ) as numcust )  $2 sum  , type DECIMAL ( 19  2 ) as totacctbal )  $3 sum  &quot;
    | combined 0
    | next

  stage S10 on origin :
    sort &quot; type VARCHAR ( 0 ) as cntrycode $1 ASC  &quot;
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;
</stringProp>
