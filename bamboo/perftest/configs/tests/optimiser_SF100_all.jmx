                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query7
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions  multiple threads 4:
    scan      Orders
    | project   &quot;   type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY
                   , type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY &quot;
    | hash      &quot;type INTEGER O_ORDERKEY&quot;
    | dynamic
    | next      hashcast

  stage S02 on all partitions  multiple threads 4:
    indexJoin Lineitem IxL_ORDERKEY &quot; BOUND $I1 O_ORDERKEY == &quot;
    | project   &quot;   type DATE as L_SHIPDATE L_SHIPDATE
                  , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                  , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                  , type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY
                  , type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY &quot;
    | filter    &quot; type BOOLEAN L_SHIPDATE DATE &apos;1995-01-01&apos; &gt;= L_SHIPDATE DATE &apos;1996-12-31&apos; &lt;= and &quot;
    | hash      &quot;type INTEGER O_CUSTKEY&quot;
    | dynamic
    | next      hashcast

  stage S03 on all partitions :
    indexJoin Customer IxC_CUSTKEY &quot; BOUND $I1 O_CUSTKEY == &quot;
    | project   &quot;   type DATE as L_SHIPDATE L_SHIPDATE
                  , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                  , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                  , type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY
                  , type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY &quot;
    | hash      &quot;type INTEGER L_SUPPKEY&quot;
    | dynamic
    | next      hashcast

  stage S04 on all partitions :
    indexJoin Supplier IxS_SUPPKEY &quot; BOUND $I1 L_SUPPKEY == &quot;
    |  project   &quot;   type DATE as L_SHIPDATE $1
                   , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                   , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                   , type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY
                   , type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY &quot;
    | dynamic
    | next

  stage S05 on all partitions :
    indexJoin nation IxN_NATIONKEY &quot; BOUND $I1 S_NATIONKEY == &quot;
    | project   &quot;   type VARCHAR ( 25 ) as N1_N_NAME N_NAME
                  , type DATE as L_SHIPDATE L_SHIPDATE
                  , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                  , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                  , type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY &quot;
    | dynamic
    | next

  stage S6 on all partitions :
    indexJoin nation IxN_NATIONKEY &quot; BOUND $I1 C_NATIONKEY == &quot;
    | project   &quot; type VARCHAR as N1_N_NAME N1_N_NAME
                , type VARCHAR as N2_N_NAME N_NAME
                , type INTEGER ( 19 ) as YEAR L_SHIPDATE extract_year
                , type DECIMAL ( 19 2 ) as VOLUME L_EXTENDEDPRICE 1.00 L_DISCOUNT - * &quot;
    | filter    &quot; type BOOLEAN N2_N_NAME &apos;GERMANY&apos; == N1_N_NAME &apos;FRANCE&apos; == and N2_N_NAME &apos;FRANCE&apos; == N1_N_NAME &apos;GERMANY&apos; == and or &quot;
    | gbyAgg    &quot; groupBy
                  type VARCHAR ( 0 ) N1_N_NAME
                , type VARCHAR ( 0 ) N2_N_NAME
                , type INTEGER ( 19 ) YEAR
                aggregates
                  type VARCHAR as N1_N_NAME $K1
                , type VARCHAR as N2_N_NAME $K2
                , type INTEGER ( 19 ) as YEAR $K3
                , type DECIMAL ( 19 2 ) as REVENUE ) $4 sum &quot;
    | dynamic
    | next      

  stage S7 on all nodes :
    gbyAgg    &quot; groupBy
                  type VARCHAR ( 0 ) N1_N_NAME
                , type VARCHAR ( 0 ) N2_N_NAME
                , type INTEGER ( 19 ) YEAR
                aggregates
                  type VARCHAR as N1_N_NAME $K1
                , type VARCHAR as N2_N_NAME $K2
                , type INTEGER ( 19 ) as YEAR $K3
                , type DECIMAL ( 19 2 ) as REVENUE ) $4 sum &quot;
    | dynamic
    | next      

  stage S8 on origin :
    gbyAgg &quot; groupBy
                 type VARCHAR ( 0 ) N1_N_NAME
               , type VARCHAR ( 0 ) N2_N_NAME
               , type INTEGER ( 19 ) YEAR
               aggregates
                 type VARCHAR as N1_N_NAME $K1
               , type VARCHAR as N2_N_NAME $K2
               , type INTEGER ( 19 ) as YEAR $K3
               , type DECIMAL ( 19 2 ) as REVENUE ) $4 sum &quot;
    | dynamic
    | next      

  stage S9 on origin :
      output
    | sink
    | first

end ;</stringProp>
