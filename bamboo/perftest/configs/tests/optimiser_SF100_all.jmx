                <stringProp name="query">/optimise_passthru
 pipeline Q8
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     scan rapidsse public region
     | project &quot;type VARCHAR R_NAME as R_NAME ,
                type INTEGER ( 19 ) R_REGIONKEY as R_REGIONKEY&quot;
     | filter &quot;type BOOLEAN R_NAME &apos;AMERICA&apos; ==&quot;
     | indexJoin nation IxN_REGIONKEY &quot;BOUND $I1 R_REGIONKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY&quot;
     | indexJoin customer IxC_NATIONKEY &quot;BOUND $I1 N_NATIONKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY&quot;
     | combined 0
     | next

   stage S02 on all partitions:
     indexJoin orders IxO_CUSTKEY &quot;BOUND $I1 C_CUSTKEY ==&quot;
     | project &quot;type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE ,
                type integer ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE &quot;
     | filter &quot;type BOOLEAN O_ORDERDATE DATE &apos;1995-01-01&apos; &gt;=  O_ORDERDATE DATE &apos;1996-12-31&apos; &lt;= and&quot;
     | project &quot;type integer ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type INTEGER ( 19 ) as O_YEAR O_ORDERDATE extract_year&quot;
     | hash &quot;type INTEGER ( 19 ) O_ORDERKEY&quot;
     | combined 0
     | next hashcast

   stage S03 on all partitions  multiple threads 4:
     indexJoin LineItem IxL_ORDERKEY &quot;BOUND $I1 O_ORDERKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type INTEGER ( 19 ) as L_PARTKEY L_PARTKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
                type DECIMAL ( 19  2 ) as l_discount l_discount&quot;
     | hash &quot;type INTEGER ( 19 ) L_PARTKEY&quot;
     | combined 0
     | next hashcast

   stage S04 on all partitions :
     indexJoin part IxP_PARTKEY &quot;BOUND $I1 L_PARTKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                     type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                     type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
                     type DECIMAL ( 19  2 ) as l_discount l_discount ,
                     type VARCHAR ( 0 ) as P_TYPE P_TYPE&quot;
     | filter &quot;type BOOLEAN P_TYPE &apos;ECONOMY ANODIZED STEEL&apos; ==&quot;
     | project &quot;type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
                type DECIMAL ( 19  2 ) as l_discount l_discount&quot;
     | hash &quot;type INTEGER ( 19 ) L_SUPPKEY&quot;
     | combined 0
     | next hashcast

   stage S05 on all partitions :
     indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 L_SUPPKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
                type DECIMAL ( 19  2 ) as l_discount l_discount&quot;
     | indexJoin nation IxN_NATIONKEY &quot;BOUND $I1 S_NATIONKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as VOLUME L_EXTENDEDPRICE 1.00 L_DISCOUNT -  * ,
                type VARCHAR ( 0 ) as NATION N_NAME&quot;
     | gbyAgg &quot; GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 )  ) VOLUME sum  ,
                      type DECIMAL ( 19  2 ) )  } type DECIMAL ( 19  2 ) NATION &apos;BRAZIL&apos;  ==  WHEN  VOLUME THEN  0.00  ELSE  ENDIF  CASE  sum  &quot;
     | combined 0
     | next

   stage S06 on all nodes :
     gbyAgg &quot; GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 ) )  $2 sum  ,
                      type DECIMAL ( 19  2 ) )  $3 sum  &quot;
     | combined 0
     | next

   stage S07 on origin :
     gbyAgg &quot; GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 ) )  $2 sum  ,
                      type DECIMAL ( 19  2 ) )  $3 sum  &quot;
     | combined 0
     | next

   stage S08 on origin :
     project &quot; type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as mkt_share $3 $2 /  &quot;
     | combined 0
     | next

   stage S09 on origin :
     output
     | sink
     | first
 end ;
</stringProp>
