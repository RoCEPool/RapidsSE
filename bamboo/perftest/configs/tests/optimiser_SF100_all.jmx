              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q8_part" enabled="true">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
 pipeline Q8
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     scan part
     | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type VARCHAR ( 0 ) as P_TYPE P_TYPE&quot;
     | filter &quot;type BOOLEAN P_TYPE &apos;ECONOMY ANODIZED STEEL&apos; ==&quot;
     | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY&quot;
     | combined 0
     | next broadcast

   stage S02 on all partitions multiple threads 4:
     indexJoin LineItem IxL_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE  ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT &quot;
     | globalHash ORDERS GxO_ORDERKEY &quot;type INTEGER ( 19 ) L_ORDERKEY&quot;
     | combined 0
     | next hashcast

   stage S03 on all partitions :
     rrfJoin ORDERS &quot;type INTEGER ( 19 ) L_ORDERKEY&quot;
     | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
                type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT&quot;

     | filter &quot;type BOOLEAN } DATE &apos;1995-01-01&apos;  DATE &apos;1996-12-31&apos; O_ORDERDATE between&quot;
     | indexJoin customer IxC_CUSTKEY &quot;BOUND $I1 O_CUSTKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY ,
                type INTEGER ( 19 ) as O_YEAR O_ORDERDATE extract_year ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT&quot;

     | indexJoin nation IxN_NATIONKEY &quot;BOUND $I1 C_NATIONKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as N_REGIONKEY N_REGIONKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT&quot;

     | indexJoin region IxR_REGIONKEY &quot;BOUND $I1 N_REGIONKEY ==&quot;
     | project &quot;type VARCHAR ( 0 ) as R_NAME R_NAME ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT&quot;
     | filter &quot;type BOOLEAN R_NAME &apos;AMERICA&apos; ==&quot;
     | project &quot;type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT&quot;
     | hash &quot;type INTEGER ( 19 ) L_SUPPKEY&quot;
     | combined 0
     | next hashcast

   stage S04 on all partitions :
     indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 L_SUPPKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT&quot;
     | indexJoin nation IxN_NATIONKEY &quot;BOUND $I1 S_NATIONKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as O_YEAR O_YEAR ,
                type DECIMAL ( 19  2 ) as VOLUME L_EXTENDEDPRICE 1.00 L_DISCOUNT -  * ,
                type VARCHAR ( 0 ) as NATION N_NAME&quot;
     | gbyAgg &quot; GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 )  ) VOLUME sum  ,
                      type DECIMAL ( 19  2 ) )  } type DECIMAL ( 19  2 ) NATION &apos;BRAZIL&apos;  ==  WHEN  VOLUME THEN  0.00  ELSE  ENDIF  CASE  sum  &quot;
     | combined 0
     | next

   stage S05 on all nodes :
     gbyAgg &quot; GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 ) )  $2 sum  ,
                      type DECIMAL ( 19  2 ) )  $3 sum  &quot;
     | combined 0
     | next

   stage S06 on origin :
     gbyAgg &quot; GroupBy type INTEGER ( 19 ) O_YEAR
              aggregates
                      type INTEGER ( 19 ) as O_YEAR $K1 ,
                      type DECIMAL ( 19  2 ) )  $2 sum  ,
                      type DECIMAL ( 19  2 ) )  $3 sum  &quot;
     | combined 0
     | next

   stage S07 on origin :
     project &quot; type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as mkt_share $3 $2 /  &quot;
     | combined 0
     | next

   stage S08 on origin :
     output
     | sink
     | first
 end ;</stringProp>
