pipeline Query4
begin

  stage S00 on origin : 
      start
    | pulse     once
    | next

  stage S01 on all partitions:
    scan      orders
    | project   &quot; type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE
                , type VARCHAR ( 15 ) as O_ORDERPRIORITY O_ORDERPRIORITY
                , type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY &quot;
    | filter    &quot; type BOOLEAN O_ORDERDATE DATE &apos;1993-07-01&apos; &gt;= O_ORDERDATE DATE &apos;1993-10-01&apos;&lt; and &quot;
    | project   &quot; type VARCHAR ( 15 ) as O_ORDERPRIORITY O_ORDERPRIORITY
                , type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY &quot;
    | hash      &quot;type INTEGER O_ORDERKEY&quot;
    | dynamic
    | next      hashcast

  stage S02 on all partitions multiple threads 4:
    keyExists lineitem IxL_ORDERKEY &quot; BOUND $I1 O_ORDERKEY == &quot; &quot; type BOOLEAN L_COMMITDATE L_RECEIPTDATE &lt; &quot;
    | gbyAgg    &quot; groupBy
                  type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY
                aggregates
                  type VARCHAR as O_ORDERPRIORITY $K1
                , type INTEGER ( 19 ) as ORDER_COUNT ) countAll &quot;
    | dynamic
    | next      

  stage S03 on all nodes :
    gbyAgg    &quot; groupBy
                  type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY
                aggregates
                  type VARCHAR as O_ORDERPRIORITY $K1
                , type INTEGER ( 19 ) as ORDER_COUNT ) ORDER_COUNT sum &quot;
    | dynamic
    | next      

  stage S04 on origin :
    gbyAgg    &quot; groupBy
                  type VARCHAR $1
                aggregates
                  type VARCHAR as C0_COL0 $K1
                , type INTEGER ( 19 ) as ORDER_COUNT ) ORDER_COUNT sum &quot;
    | dynamic
    | next      

  stage S05 on origin :
      output
    | sink
    | first

end ;
</stringProp>
