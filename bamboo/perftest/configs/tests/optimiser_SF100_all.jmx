                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
                <stringProp name="queryType">Select Statement</stringProp>
                <stringProp name="resultSetHandler">Store as String</stringProp>
                <stringProp name="resultSetMaxRows"></stringProp>
                <stringProp name="resultVariable"></stringProp>
                <stringProp name="variableNames"></stringProp>
              </JDBCSampler>
              <hashTree/>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q5_oclsnr_1" enabled="false">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query5
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions:
    scan rapidsse public Orders
    | project &quot;type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
               type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE&quot;
    | filter &quot; type BOOLEAN O_ORDERDATE DATE &apos;1994-01-01&apos;  &gt;=
                            O_ORDERDATE DATE &apos;1995-01-01&apos;  &lt;  and  &quot;
    | combined 0
    | next

  stage S02 on all partitions:
    indexJoin Customer IxC_CUSTKEY &quot;BOUND $I1 O_CUSTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
               type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY&quot;
    | hash &quot;type INTEGER ( 19 ) O_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S03 on all partitions multiple threads 4:
    indexJoin Lineitem IxL_ORDERKEY &quot;bound $I1 O_ORDERKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY ,
                   type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                   type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                   type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT&quot;
    | hash &quot;type INTEGER ( 19 ) L_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S04 on all partitions :
    indexJoin Supplier IxS_SUPPKEY expr &quot;bound $I1 L_SUPPKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY ,
               type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT ,
               type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY&quot;
    | filter &quot; type BOOLEAN C_NATIONKEY S_NATIONKEY == &quot;
    | indexJoin Nation IxN_NATIONKEY expr &quot;bound $I1 S_NATIONKEY ==&quot;
    | project &quot;type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR ( 0 ) as N_NAME N_NAME ,
               type INTEGER ( 19 ) as N_REGIONKEY N_REGIONKEY&quot;
    | indexJoin Region IxR_REGIONKEY expr &quot;bound $I1 N_REGIONKEY ==&quot;
    | project &quot;type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                   type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT ,
                   type VARCHAR ( 0 ) as N_NAME N_NAME ,
                   type VARCHAR ( 0 ) as R_NAME R_NAME&quot;
    | filter &quot; type BOOLEAN R_NAME &apos;ASIA&apos;  ==  &quot;
    | gbyAgg &quot; GroupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
                        type DECIMAL ( 19  2 ) as REVENUE )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  &quot;
    | combined 0
    | next

  stage S05 on all nodes :
    gbyAgg &quot; GroupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
                        type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  &quot;
    | combined 0
    | next

  stage S06 on origin :
    gbyAgg &quot; GroupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
             type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  &quot;
    | combined 0
