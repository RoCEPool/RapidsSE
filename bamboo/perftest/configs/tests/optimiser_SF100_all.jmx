                <stringProp name="query">/optimise_passthru
pipeline Query12
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     indexScan lineitem IxL_RECEIPTDATE &quot;LBOUND $I1 DATE &apos;1994-01-01&apos; &gt;= UBOUND $I1 DATE &apos;1995-01-01&apos;  &lt;&quot;
     | project &quot;type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
                type DATE ( 0 ) as L_SHIPDATE L_SHIPDATE ,
                type DATE ( 0 ) as L_COMMITDATE L_COMMITDATE ,
                type DATE ( 0 ) as L_RECEIPTDATE L_RECEIPTDATE ,
                type VARCHAR ( 0 ) as L_SHIPMODE L_SHIPMODE&quot;
     | filter &quot; type BOOLEAN }  &apos;MAIL&apos;  &apos;SHIP&apos;  #2  L_SHIPMODE in&quot;
     | filter &quot; type BOOLEAN L_SHIPDATE L_COMMITDATE &lt; &quot;
     | filter &quot; type BOOLEAN L_COMMITDATE L_RECEIPTDATE &lt;&quot;
     | project &quot;type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
                type VARCHAR ( 0 ) as L_SHIPMODE L_SHIPMODE&quot;
     | combined 0
     | next broadcast

   stage S02 on all partitions multiple threads 4:
     indexJoin Orders IxO_ORDERKEY expr bound $I1 L_ORDERKEY ==   // Orders - J1
     | project &quot;type VARCHAR ( 0 ) as O_ORDERPRIORITY O_ORDERPRIORITY ,
                type VARCHAR ( 0 ) as L_SHIPMODE L_SHIPMODE&quot;
     | gbyAgg &quot; GroupBy type VARCHAR ( 0 ) as L_SHIPMODE L_SHIPMODE
              aggregates type VARCHAR ( 0 ) $K1 ,
                         type INTEGER ( 19 ) ) }  O_ORDERPRIORITY &apos;1-URGENT&apos;  == O_ORDERPRIORITY &apos;2-HIGH&apos;  ==  or WHEN  1 THEN  0  ELSE  ENDIF  CASE  sum  ,
                         type INTEGER ( 19 ) ) }  O_ORDERPRIORITY &apos;1-URGENT&apos;  !=  O_ORDERPRIORITY &apos;2-HIGH&apos;  !=  and  WHEN  1 THEN  0  ELSE  ENDIF  CASE  sum  &quot;
     | combined 0
     | next

   stage S03 on all nodes :
     gbyAgg &quot; GroupBy type VARCHAR ( 0 ) as L_SHIPMODE $1
              aggregates type VARCHAR ( 0 ) $K1 ,
                         type INTEGER ( 19 ) )  $2 sum  ,
                         type INTEGER ( 19 ) )  $3 sum  &quot;
     | combined 0
     | next

   stage S04 on origin :
     gbyAgg &quot; GroupBy type VARCHAR ( 0 ) as L_SHIPMODE $1
              aggregates  type VARCHAR ( 0 ) $K1 ,
                          type INTEGER ( 19 ) as high_line_count )  $2 sum  ,
                          type INTEGER ( 19 ) as low_line_count )  $3 sum  &quot;
     | combined 0
     | next

   stage S05 on origin :
     output
     | sink
     | first
 end ;
</stringProp>
