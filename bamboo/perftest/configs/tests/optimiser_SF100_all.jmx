              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q10" enabled="false">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">select 
  c_custkey, 
  c_name, 
  sum(l_extendedprice * (1 - l_discount)) as revenue,
  c_acctbal, 
  n_name, 
  c_address, 
  c_phone, 
  c_comment
from 
  customer, 
  orders, 
  lineitem, 
  nation
where 
  c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and o_orderdate &gt;= date &apos;1993-10-01&apos;
  and o_orderdate &lt; date &apos;1993-10-01&apos; + interval &apos;3&apos; month
  and l_returnflag = &apos;R&apos;
  and c_nationkey = n_nationkey
group by 
  c_custkey, 
  c_name, 
  c_acctbal, 
  c_phone, 
  n_name, 
  c_address, 
  c_comment
order by 
  revenue desc 
limit 20;</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
                <stringProp name="queryType">Select Statement</stringProp>
                <stringProp name="resultSetHandler">Store as String</stringProp>
                <stringProp name="resultSetMaxRows"></stringProp>
                <stringProp name="resultVariable"></stringProp>
                <stringProp name="variableNames"></stringProp>
              </JDBCSampler>
              <hashTree/>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q10_ocnl_1" enabled="false">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query10
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions:
    scan Orders
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY  O_CUSTKEY ,
                   type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                   type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE&quot;
    | filter &quot; type BOOLEAN O_ORDERDATE date &apos;1993-10-01&apos; &gt;=  O_ORDERDATE date &apos;1994-01-01&apos; &lt; and &quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY  O_CUSTKEY ,
                   type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY&quot;
    | indexJoin Customer IxC_CUSTKEY &quot;BOUND $I1 O_CUSTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY ,
               type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY&quot;
    | indexjoin Nation IxN_NATIONKEY &quot;BOUND $I1 C_NATIONKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
                   type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY&quot;
    | hash expr type INTEGER ( 19 ) O_ORDERKEY
    | combined 0
    | next hashcast

  stage S02 on all partitions multiple threads 4:
    indexJoin Lineitem IxL_ORDERKEY &quot;BOUND $I1 O_ORDERKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR ( 0 ) as L_RETURNFLAG L_RETURNFLAG&quot;
    | filter  &quot;type BOOLEAN L_RETURNFLAG &apos;R&apos; ==&quot;
    | gbyAgg  &quot;groupby    type INTEGER ( 19 ) O_CUSTKEY
               aggregates type INTEGER ( 19 ) as O_CUSTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as REVENUE ) L_EXTENDEDPRICE 1.0  L_DISCOUNT -  *  sum &quot;
    | combined 0
    | next

  stage S03 on all nodes :
    gbyAgg &quot;groupby    type INTEGER ( 19 ) O_CUSTKEY
            aggregates type INTEGER ( 19 ) as O_CUSTKEY $K1 ,
                       type DECIMAL ( 19  2 ) as REVENUE ) REVENUE  sum &quot;
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg &quot;groupby    type INTEGER ( 19 ) O_CUSTKEY
            aggregates type INTEGER ( 19 ) as O_CUSTKEY $K1 ,
                       type DECIMAL ( 19  2 ) as REVENUE ) REVENUE  sum&quot;
    | combined 0
    | next

  stage S05 on origin :
    top &quot; type DECIMAL ( 19  2 ) REVENUE &quot; 20
    | hash expr type INTEGER ( 19 ) O_CUSTKEY
    | combined 0
    | next hashcast

  stage S06 on all partitions multiple threads 4:
    indexJoin Customer IxC_CUSTKEY &quot;BOUND $I1 O_CUSTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type VARCHAR ( 0 ) as C_NAME C_NAME ,
               type DECIMAL ( 19  2 ) as REVENUE ) REVENUE ,
               type DECIMAL ( 19  2 ) as C_ACCTBAL C_ACCTBAL ,
               type VARCHAR ( 0 ) as C_ADDRESS C_ADDRESS ,
               type VARCHAR ( 0 ) as C_PHONE C_PHONE ,
               type VARCHAR ( 0 ) as C_COMMENT C_COMMENT&quot;
    | combined 0
    | next

  stage S07 on origin :
    sort &quot; type DECIMAL ( 19  2 ) REVENUE DESC  &quot;
    | combined 0
    | next

  stage S08 on origin :
    output
    | sink
    | first
end ;
</stringProp>
