              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q21_olsn" enabled="true">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query21
begin
  stage S00 on origin :
    start
    | pulse once
    | next

stage S01 on all partitions :
    scan Orders
    | project &quot; type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type VARCHAR ( 0 ) as O_ORDERSTATUS O_ORDERSTATUS&quot;
    | filter &quot; type BOOLEAN  O_ORDERSTATUS &apos;F&apos;  == &quot;
    | project &quot; type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY &quot;
    | hash &quot; type INTEGER ( 19 ) O_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S02 on all partitions multiple threads 4:
    indexJoin lineitem IxL_ORDERKEY &quot;BOUND $I1 O_ORDERKEY ==&quot;
    | project &quot; type INTEGER ( 19 ) as L1_ORDERKEY L_ORDERKEY ,
                type INTEGER ( 19 ) as L1_SUPPKEY L_SUPPKEY ,
                type DATE ( 0 ) as L_RECEIPTDATE L_RECEIPTDATE ,
                type DATE ( 0 ) as L_COMMITDATE L_COMMITDATE&quot;
    | filter &quot; type BOOLEAN  L_RECEIPTDATE L_COMMITDATE &gt; &quot;
    | project &quot; type INTEGER ( 19 ) as L1_ORDERKEY L1_ORDERKEY ,
                type INTEGER ( 19 ) as L1_SUPPKEY L1_SUPPKEY &quot;
    | hash &quot; type INTEGER ( 19 ) L1_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin Supplier IxS_SUPPKEY &quot;BOUND $I1 L1_SUPPKEY ==&quot;
    | project &quot; type INTEGER ( 19 ) as L1_ORDERKEY L_ORDERKEY ,
                type INTEGER ( 19 ) as L1_SUPPKEY L_SUPPKEY ,
                type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type VARCHAR ( 0 ) as S_NAME S_NAME &quot;
    | hash &quot; type INTEGER ( 19 ) L1_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S04 on all partitions :
    keyExists lineitem IxL_ORDERKEY  &quot;BOUND $I1 L1_ORDERKEY ==&quot;
       &quot;type BOOLEAN L1_SUPPKEY L_SUPPKEY != &quot;
    | combined 0
    | next

  stage S05 on all partitions :
    keyNotExists lineitem IxL_ORDERKEY  &quot;BOUND $I1 L1_ORDERKEY ==&quot;
       &quot;type BOOLEAN L1_SUPPKEY L_SUPPKEY !=
                     L_RECEIPTDATE L_COMMITDATE &gt; and&quot;
   | project &quot; type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type VARCHAR ( 0 ) as S_NAME S_NAME &quot;
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin Nation IxN_NATIONKEY &quot;BOUND $I1 S_NATIONKEY ==&quot;
    | filter &quot; type BOOLEAN N_NAME &apos;SAUDI ARABIA&apos; ==  &quot;
    | gbyAgg &quot; groupBy    type VARCHAR ( 0 ) as S_NAME $2
               aggregates type VARCHAR ( 0 ) $K1 ,
                          type INTEGER ( 19 ) )  countAll  &quot;
    | combined 0
    | next

  stage S05 on all nodes :
    gbyAgg &quot; groupBy  type VARCHAR ( 0 ) as s_name $1 aggregates  type VARCHAR ( 0 ) $K1 , type INTEGER ( 19 ) )  $2 sum  &quot;
    | combined 0
    | next

  stage S06 on origin :
    gbyAgg &quot; groupBy  type VARCHAR ( 0 ) as s_name $1 aggregates  type VARCHAR ( 0 ) $K1 , type INTEGER ( 19 ) as numwait )  $2 sum  &quot;
    | combined 0
    | next

  stage S05 on origin :
    sort &quot; type INTEGER ( 19 ) $2 DESC  , type VARCHAR ( 0 ) as s_name $1 ASC  &quot;
    | combined 0
    | next

  stage S07 on origin :
    output
    | sink
    | first
end ;
</stringProp>
