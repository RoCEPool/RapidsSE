pipeline Query9
  begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public part
    | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type VARCHAR ( 55 ) as P_NAME P_NAME&quot;
    | filter &quot;type BOOLEAN }  P_NAME &apos;%green%&apos; 5 matchMiddle&quot;
    | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY&quot;
    | indexJoin partsupp IxPS_PARTKEY &quot;bound $I1 P_PARTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST&quot;
    | combined 0
    | next broadcast

  stage S02 on all partitions multiple threads 4:
    indexJoin LINEITEM IxL_PARTKEY &quot;bound $I1 P_PARTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19 2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
               type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
               type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
               type DECIMAL ( 19 2 ) as L_QUANTITY L_QUANTITY&quot;
    | filter &quot;type BOOLEAN L_SUPPKEY PS_SUPPKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
               type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
               type DECIMAL ( 19  2 ) as AMOUNT L_EXTENDEDPRICE 1.0 L_DISCOUNT -  *  PS_SUPPLYCOST L_QUANTITY *  - &quot;
    | hash &quot;type INTEGER ( 19 ) $2&quot;
    | combined 0
    | next hashcast

  stage S03 on all partitions multiple threads 4:
    indexJoin supplier IxS_SUPPKEY &quot;bound $I1 L_SUPPKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
               type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
               type DECIMAL ( 19  2 ) as AMOUNT AMOUNT &quot;
    | globalHash ORDERS GxO_ORDERKEY &quot;type INTEGER ( 19 ) L_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S04 on all partitions:
    rrfJoin ORDERS &quot;type INTEGER ( 19 ) L_ORDERKEY&quot;
    | project &quot;type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
               type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
               type DATE as O_ORDERDATE O_ORDERDATE ,
               type DECIMAL ( 19  2 ) as AMOUNT AMOUNT&quot;
    | filter &quot;type BOOLEAN L_ORDERKEY L_ORDERKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
               type INTEGER ( 19 ) as O_YEAR O_ORDERDATE extract_year ,
               type DECIMAL ( 19  2 ) as AMOUNT AMOUNT&quot;
    | combined 0
    | next

  stage S05 on all partitions :
    indexJoin NATION IxN_NATIONKEY &quot;bound $I1 S_NATIONKEY ==&quot;
    | project &quot;type VARCHAR ( 0 ) as NATION N_NAME ,
               type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as AMOUNT AMOUNT&quot;
    | gbyAgg &quot;groupBy type VARCHAR ( 0 ) NATION ,
                    type INTEGER ( 19 ) O_YEAR
            aggregates
                    type VARCHAR ( 0 ) as NATION $K1 ,
                    type INTEGER ( 19 ) as O_YEAR $K2 ,
                    type DECIMAL ( 19  2 ) as SUM_PROFIT ) AMOUNT sum  &quot;
    | combined 0
    | next

  stage S06 on all nodes :
    gbyAgg &quot;groupBy type VARCHAR ( 0 ) NATION ,
                    type INTEGER ( 19 ) O_YEAR
            aggregates
                     type VARCHAR ( 0 ) as NATION $K1 ,
                     type INTEGER ( 19 ) as O_YEAR $K2 ,
                     type DECIMAL ( 19  2 ) as SUM_PROFIT ) SUM_PROFIT sum  &quot;
    | combined 0
    | next

  stage S07 on origin :
    gbyAgg &quot;groupBy type VARCHAR ( 0 ) NATION ,
                    type INTEGER ( 19 ) O_YEAR
            aggregates
                     type VARCHAR ( 0 ) as NATION $K1 ,
                     type INTEGER ( 19 ) as O_YEAR $K2 ,
                     type DECIMAL ( 19  2 ) as SUM_PROFIT ) SUM_PROFIT sum  &quot;
    | combined 0
    | next

  stage S08 on origin :
    sort &quot;type VARCHAR ( 0 ) as NATION NATION ASC ,
          type INTEGER ( 19 ) as O_YEAR O_YEAR DESC&quot;
    | combined 0
    | next

  stage S09 on origin :
    output
    | sink
    | first
  end ;
</stringProp>
