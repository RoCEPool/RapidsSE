pipeline Query13
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public customer
    | project &quot;type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY&quot;
    | next

  stage S02 on all partitions multiple threads 4:
    indexJoin orders IxO_CUSTKEY &quot;LEFT_OUTER BOUND $I1 $1 ==&quot;
           &quot;type BOOLEAN }  O_COMMENT &apos;%special%requests%&apos;  7 8 matchMiddle1  not&quot;
    | gbyAgg &quot; GroupBy     type INTEGER ( 19 ) as c_custkey $1
              aggregates
                         type INTEGER ( 19 ) $K1 ,
                         type INTEGER ( 19 ) )  $9 count  &quot;
    | combined 0
    | next

  stage S03 on origin :
    gbyAgg &quot; GroupBy    type INTEGER ( 19 ) as c_count $2
             aggregates
                        type INTEGER ( 19 ) $K1 ,
                        type INTEGER ( 19 ) as custdist )  countAll  &quot;
    | combined 0
    | next

  stage S04 on origin :
    sort &quot; type INTEGER ( 19 ) as c_count $2  desc ,
           type INTEGER ( 19 ) $1  desc &quot;
    | combined 0
    | next

 stage S05 on origin :
   output
   | sink
   | first
 end ;
</stringProp>
