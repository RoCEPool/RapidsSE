      <stringProp name="TestPlan.comments">DEPENDENCIES:
*****************
1. Must execute on nodes with 2 SSDs at /mnt/disk&lt;1..2&gt;</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="JDBC_URL" elementType="Argument">
            <stringProp name="Argument.name">JDBC_URL</stringProp>
            <stringProp name="Argument.value">${__P(JDBC_URL,jdbc:se://localhost:9123)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SF" elementType="Argument">
            <stringProp name="Argument.name">SF</stringProp>
