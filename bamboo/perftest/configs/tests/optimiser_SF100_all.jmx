                       type INTEGER ( 19 ) as O_ORDERKEY $K3 ,
                       type DATE as O_ORDERDATE $K4 ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE $K5 ,
                       type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum  &quot;
     | combined 0
     | next

   stage S08 on origin :
     sort &quot; type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE DESC  , type DATE as O_ORDERDATE O_ORDERDATE ASC  &quot;
