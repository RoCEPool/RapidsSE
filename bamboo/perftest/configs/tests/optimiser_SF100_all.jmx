                <stringProp name="query">/optimise_passthru
pipeline Query18
begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
      scan lineitem
     | gbyAgg &quot; groupBy  type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY aggregates  type INTEGER ( 19 ) as L_ORDERKEY $K1 , type DECIMAL ( 19  2 ) as SUM_QTY )  L_QUANTITY sum  &quot;
     | combined 0
     | next

    stage S01a on all partitions :
     filter  &quot; type BOOLEAN  SUM_QTY 300.00  &gt;  &quot;
     | combined 0
     | next broadcast

   stage S02 on all partitions  multiple threads 4:
     indexJoin orders IxO_ORDERKEY &quot;bound $I1 $1 ==&quot;
     | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
                type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type DATE as O_ORDERDATE O_ORDERDATE ,
                type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE ,
                type DECIMAL ( 19  2 ) as SUM_QTY SUM_QTY &quot;
     | combined 0
     | next

   stage S03 on all partitions :
     indexJoin customer IxC_CUSTKEY &quot;bound $I1 $1 ==&quot;
     | project &quot;type VARCHAR ( 0 ) as C_NAME C_NAME ,
                type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type DATE as O_ORDERDATE O_ORDERDATE ,
                type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE ,
                type DECIMAL ( 19  2 ) as SUM_QTY SUM_QTY &quot;
     | combined 0
     | next

   stage S04 on all partitions :
     gbyAgg &quot; GroupBy type VARCHAR ( 0 ) as C_NAME C_NAME ,
                      type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                      type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                      type DATE as O_ORDERDATE O_ORDERDATE ,
                      type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE
                      aggregates
                      type VARCHAR ( 0 ) as C_NAME $K1 ,
                      type INTEGER ( 19 ) as C_CUSTKEY $K2 ,
                      type INTEGER ( 19 ) as O_ORDERKEY $K3 ,
                      type DATE as O_ORDERDATE $K4 ,
                      type DECIMAL ( 19  2 ) as O_TOTALPRICE $K5 ,
                      type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum  &quot;
     | combined 0
     | next

   stage S05 on all nodes :
     gbyAgg &quot; GroupBy  type VARCHAR ( 0 ) as C_NAME C_NAME ,
                       type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                       type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                       type DATE as O_ORDERDATE O_ORDERDATE ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE
                       aggregates
                       type VARCHAR ( 0 ) as C_NAME $K1 ,
                       type INTEGER ( 19 ) as C_CUSTKEY $K2 ,
                       type INTEGER ( 19 ) as O_ORDERKEY $K3 ,
                       type DATE as O_ORDERDATE $K4 ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE $K5 ,
                       type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum  &quot;
     | combined 0
     | next

   stage S06 on origin :
     gbyAgg &quot; GroupBy  type VARCHAR ( 0 ) as C_NAME C_NAME ,
                       type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                       type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                       type DATE as O_ORDERDATE O_ORDERDATE ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE
                       aggregates
                       type VARCHAR ( 0 ) as C_NAME $K1 ,
                       type INTEGER ( 19 ) as C_CUSTKEY $K2 ,
                       type INTEGER ( 19 ) as O_ORDERKEY $K3 ,
                       type DATE as O_ORDERDATE $K4 ,
                       type DECIMAL ( 19  2 ) as O_TOTALPRICE $K5 ,
                       type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum  &quot;
     | combined 0
     | next

   stage S07 on origin :
     sort &quot; type DECIMAL ( 19  2 ) as O_TOTALPRICE O_TOTALPRICE DESC  , type DATE as O_ORDERDATE O_ORDERDATE ASC  &quot;
     | limit 100
     | combined 0
     | next

   stage S08 on origin :
     output
     | sink
     | first
 end ;
</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
                <stringProp name="queryType">Select Statement</stringProp>
                <stringProp name="resultSetHandler">Store as String</stringProp>
                <stringProp name="resultSetMaxRows"></stringProp>
                <stringProp name="resultVariable"></stringProp>
                <stringProp name="variableNames"></stringProp>
              </JDBCSampler>
              <hashTree/>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="sleep" enabled="true">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">sleep ${SLEEP_TIME} ;</stringProp>
