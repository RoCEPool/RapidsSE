                <stringProp name="query">/optimise_passthru
pipeline Query19
begin
 stage S00 on origin :
   start
   | pulse once
   | next

 stage S01 on all partitions :
   scan rapidsse public part
   | filter &quot; type BOOLEAN P_BRAND &apos;Brand#12&apos;  ==
                } &apos;SM CASE&apos;  &apos;M BOX&apos;  &apos;SM PACK&apos;  &apos;SM PKG&apos;  #4  P_CONTAINER in  and
                }  1  5  P_SIZE between  and
                P_BRAND &apos;Brand#23&apos;  ==
                }  &apos;MED BAG&apos;  &apos;MED BOX&apos;  &apos;MED PKG&apos;  &apos;MED PACK&apos;  #4 P_CONTAINER in and
                }  1  10  P_SIZE between  and  or P_BRAND &apos;Brand#34&apos;  ==
                }  &apos;LG CASE&apos;  &apos;LG BOX&apos;  &apos;LG PACK&apos;  &apos;LG PKG&apos;  #4  P_CONTAINER in  and
                }  1  15  P_SIZE between  and or  &quot;
   | project &quot; type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type VARCHAR ( 0 ) as P_CONTAINER P_CONTAINER ,
               type INTEGER ( 19 ) AS P_SIZE P_SIZE&quot;
   | combined 0
   | next broadcast

 stage S02 on all partitions multiple threads 4:
   indexJoin lineitem IxL_PARTKEY &quot;BOUND $I1 p_partkey ==&quot; //J1
   | project &quot; type INTEGER ( 19 ) as L_PARTKEY l_partkey ,
               type DECIMAL ( 19  2 ) as L_QUANTITY L_QUANTITY ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT ,
               type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice  ,
               type VARCHAR ( 0 ) as L_SHIPMODE L_SHIPMODE ,
               type VARCHAR ( 0 ) as L_SHIPINSTRUCT L_SHIPINSTRUCT ,
               type INTEGER ( 19 ) as P_SIZE P_SIZE ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type varchar ( 0 ) as P_CONTAINER P_CONTAINER&quot;
   | filter &quot; type BOOLEAN }  &apos;AIR&apos;  &apos;AIR REG&apos;  #2  L_SHIPMODE in
                   L_SHIPINSTRUCT &apos;DELIVER IN PERSON&apos;  ==  and
                   }  L_QUANTITY 1.0 &gt;= L_QUANTITY 30.0 &lt;= and and&quot;
   | filter &quot; type BOOLEAN P_BRAND &apos;Brand#12&apos;  ==
                }  &apos;SM CASE&apos;  &apos;M BOX&apos;  &apos;SM PACK&apos;  &apos;SM PKG&apos;  #4  P_CONTAINER in  and
                }  L_QUANTITY 1.0 &gt;= L_QUANTITY 11.0 &lt;= and and
                }  1  5  P_SIZE between  and
                }  &apos;AIR&apos;  &apos;AIR REG&apos;  #2  L_SHIPMODE in  and
                L_SHIPINSTRUCT &apos;DELIVER IN PERSON&apos;  ==  and
                P_BRAND &apos;Brand#23&apos;  ==
                }  &apos;MED BAG&apos;  &apos;MED BOX&apos;  &apos;MED PKG&apos;  &apos;MED PACK&apos;  #4 P_CONTAINER in and
                }  L_QUANTITY 10.0 &gt;= L_QUANTITY 20.0 &lt;= and and
                }  1  10  P_SIZE between  and
                }  &apos;AIR&apos;  &apos;AIR REG&apos;  #2  L_SHIPMODE in  and L_SHIPINSTRUCT &apos;DELIVER IN PERSON&apos;  ==  and  or
                P_BRAND &apos;Brand#34&apos;  ==
                }  &apos;LG CASE&apos;  &apos;LG BOX&apos;  &apos;LG PACK&apos;  &apos;LG PKG&apos;  #4  P_CONTAINER in  and
                }  L_QUANTITY 20.0 &gt;= L_QUANTITY 30.0 &lt;= and and }  1  15  P_SIZE between  and
                }  &apos;AIR&apos;  &apos;AIR REG&apos;  #2  L_SHIPMODE in  and
                L_SHIPINSTRUCT &apos;DELIVER IN PERSON&apos;  ==  and  or  &quot;
   | aggreg &quot; type DECIMAL ( 19  2 ) )  L_EXTENDEDPRICE 1.00  L_DISCOUNT - * sum  &quot;
   | combined 0
   | next

 stage S04 on all nodes :
   aggreg &quot; type DECIMAL ( 19  2 ) )  $1 sum  &quot;
   | combined 0
   | next

 stage S05 on origin :
   aggreg &quot; type DECIMAL ( 19  2 ) as revenue )  $1 sum  &quot;
   | combined 0
   | next

 stage S06 on origin :
   output
   | sink
   | first
end ;</stringProp>
