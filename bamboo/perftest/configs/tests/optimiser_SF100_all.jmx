                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query15
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     Scan lineitem
      | project &quot;type INTEGER as L_SUPPKEY L_SUPPKEY ,
                 type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
                 type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
                 type DATE as L_SHIPDATE L_SHIPDATE&quot;
      | filter &quot; type BOOLEAN L_SHIPDATE DATE &apos;1996-01-01&apos; &gt;= L_SHIPDATE DATE &apos;1996-04-01&apos; &lt; and&quot;
      | gbyAgg &quot; GroupBy    type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY
                 aggregates type INTEGER ( 19 ) as SUPPKEY_NO $K1 ,
                           type DECIMAL ( 19  2 ) as TOTAL_REVENUE )  L_EXTENDEDPRICE 1.00  L_DISCOUNT -  *  sum&quot;
      | combined 0
      | next

   stage S02 on all nodes :
     gbyAgg &quot; GroupBy    type INTEGER ( 19 ) as SUPPKEY_NO SUPPKEY_NO
              aggregates type INTEGER ( 19 ) as SUPPKEY_NO $K1 ,
                        type DECIMAL ( 19  2 ) as TOTAL_REVENUE )  TOTAL_REVENUE sum  &quot;
     | combined 0
     | next

   stage S03 on origin :
      gbyAgg &quot; GroupBy    type INTEGER ( 19 ) as SUPPKEY_NO SUPPKEY_NO
               aggregates type INTEGER ( 19 ) as SUPPKEY_NO $K1 ,
                            type DECIMAL ( 19  2 ) as TOTAL_REVENUE )  TOTAL_REVENUE sum  &quot;
      | combined 0
      | next

   stage S04 on origin:
     top &quot;type DECIMAL ( 19  2 ) TOTAL_REVENUE&quot; 1
     | hash &quot;type INTEGER ( 19 ) SUPPKEY_NO&quot;
     | combined 0
     | next hashcast

   stage S05 on all partitions multiple threads 4:
     indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 SUPPKEY_NO ==&quot;
     | Project   &quot;   type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY
                  , type VARCHAR ( 25 ) as S_NAME S_NAME
                  , type VARCHAR ( 40 ) as S_ADDRESS S_ADDRESS
                  , type VARCHAR ( 15 ) as S_PHONE S_PHONE
                  , type DECIMAL ( 19  2 ) as TOTAL_REVENUE TOTAL_REVENUE&quot;

     | combined 0
     | next

   stage S06 on origin :
     output
     | sink
     | first
  end ;
</stringProp>
