pipeline Query20
begin

    stage S00 on origin :
      start
      | pulse once
      | next

    stage S01 on all partitions:
      indexScan lineitem IxL_SHIPDATE &quot;LBOUND $I1 DATE &apos;1994-01-01&apos; &gt;= UBOUND $I1 DATE &apos;1995-01-01&apos; &lt;&quot;
      | project &quot;type integer ( 19 ) as L_PARTKEY L_PARTKEY ,
                 type integer ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                 type DECIMAL ( 19 2 ) as L_QUANTITY L_QUANTITY&quot;
      | hash &quot;type INTEGER ( 19 ) L_PARTKEY&quot;
      | combined 0
      | next hashcast

    stage S02 on all partitions multiple threads 4:
      indexJoin part IxP_PARTKEY &quot;BOUND $I1 L_PARTKEY ==&quot;
      | project &quot; type INTEGER ( 19 ) as L_PARTKEY L_PARTKEY ,
                  type integer ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                  type DECIMAL ( 19 2 ) as L_QUANTITY L_QUANTITY ,
                  type VARCHAR ( 0 ) as P_NAME P_NAME&quot;
      | filter &quot; type BOOLEAN  }  P_NAME &apos;forest%&apos;  7 matchLeading &quot;
      | gbyAgg &quot; groupBy  type integer ( 19 ) L_PARTKEY ,
                          type integer ( 19 ) L_SUPPKEY
                     aggregates type integer ( 19 ) as L_PARTKEY $K1 ,
                                type integer ( 19 ) as L_SUPPKEY $K2 ,
                                type DECIMAL ( 19  2 ) )  L_QUANTITY sum&quot;
      | combined 0
      | next

    stage S03 on all nodes :
      gbyAgg &quot; groupBy type integer ( 19 ) L_PARTKEY ,
                       type integer ( 19 ) L_SUPPKEY
                  aggregates type integer ( 19 ) as L_PARTKEY $K1 ,
                             type integer ( 19 ) as L_SUPPKEY $K2 ,
                             type DECIMAL ( 19  2 ) )  $3 sum&quot;
      | combined 0
      | next
    
    stage S04 on origin :
      gbyAgg &quot; groupBy type integer ( 19 ) L_PARTKEY ,
                       type integer ( 19 ) L_SUPPKEY
                   aggregates type integer ( 19 ) as L_PARTKEY $K1 ,
                              type integer ( 19 ) as L_SUPPKEY $K2 ,
                              type DECIMAL ( 19  2 ) )  $3 sum&quot;
      | combined 0
      | next
    
    stage S05 on origin :
      project &quot; type integer ( 19 ) as L_PARTKEY L_PARTKEY ,
                type integer ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type DECIMAL ( 19  2 ) as sqyResult 0.5  $3 *  &quot;
      | combined 0
      | next broadcast
    
    stage S06 on all partitions  multiple threads 4:
      indexJoin partSupp IxPS_SUPPKEY &quot;BOUND $I1 L_SUPPKEY ==&quot;
      | project &quot; type INTEGER ( 19 ) as L_PARTKEY L_PARTKEY ,
                  type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                  type INTEGER ( 19 ) as PS_PARTKEY PS_PARTKEY ,
                  type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
                  type DECIMAL ( 19  2 ) as sqyResult sqyResult&quot;
      | filter &quot; type BOOLEAN L_PARTKEY PS_PARTKEY == PS_AVAILQTY casttype DECIMAL ( 19  2 ) CAST sqyResult &gt; and &quot;
      | project &quot; type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY&quot;
      | hash &quot;type INTEGER ( 19 ) L_SUPPKEY&quot;
      | combined 0
      | next hashcast
    
     stage S07 on all partitions :
       gbyAgg &quot; groupBy type integer ( 19 ) L_SUPPKEY
                          aggregates type integer ( 19 ) as L_SUPPKEY $K1&quot;
       | combined 0
       | next
    
    stage S08 on all partitions :
      indexJoin Supplier IxS_SUPPKEY &quot;BOUND $I1 L_SUPPKEY ==&quot;
      | project &quot; type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                  type VARCHAR ( 0 ) as S_NAME S_NAME ,
                  type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS&quot;
      | indexJoin Nation IxN_NATIONKEY &quot;BOUND $I1 S_NATIONKEY ==&quot;
      | filter &quot; type BOOLEAN N_NAME &apos;CANADA&apos; ==  &quot;
      | project &quot; type VARCHAR ( 0 ) as S_NAME S_NAME ,
                  type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS &quot;
      | sort &quot; type VARCHAR ( 0 ) S_NAME ASC  &quot;
      | combined 0
      | next
    
    stage S09 on origin :
      sort &quot; type VARCHAR ( 0 ) S_NAME ASC  &quot;
      | combined 0
      | next
    
    stage S10 on origin :
       output
       | sink
       | first
      end ;</stringProp>
