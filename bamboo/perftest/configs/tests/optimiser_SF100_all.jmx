                <stringProp name="query">/optimise_passthru
pipeline Query2
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan part
    | project &quot; type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                type INTEGER ( 19 ) as P_SIZE P_SIZE&quot;
    | filter &quot; type BOOLEAN  }  P_TYPE &apos;%BRASS&apos;  6 matchTrailing P_SIZE 15 == and&quot;
    | indexJoin partsupp IxPS_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;
    | project &quot; type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST&quot;
    | hash &quot;type INTEGER ( 19 ) PS_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S02 on all partitions:
    indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 PS_SUPPKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY &quot;
    | indexJoin nation IxN_NATIONKEY &quot;BOUND $I1 S_NATIONKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as N_REGIONKEY N_REGIONKEY &quot;
    | indexJoin region IxR_REGIONKEY &quot;BOUND $I1 N_REGIONKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                           type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                           type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
                           type INTEGER ( 19 ) as N_REGIONKEY N_REGIONKEY ,
                           type VARCHAR ( 0 ) as R_NAME R_NAME &quot;
    | filter &quot; type BOOLEAN  R_NAME &apos;EUROPE&apos;  == &quot;
    | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                       type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                       type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST&quot;
    | combined 0
    | next

  stage S03 on all partitions :
    gbyAgg &quot; GroupBy    type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST min &quot;
    | combined 0
    | next

  stage S04 on all nodes :
     gbyAgg &quot; GroupBy     type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min &quot;
    | combined 0
    | next

  stage S05 on origin :
     gbyAgg &quot; GroupBy    type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min &quot;
    | hash &quot;type INTEGER ( 19 ) P_PARTKEY&quot;
    | combined 0
    | next hashcast

  stage S06 on all partitions  multiple threads 4:
    indexJoin partsupp IxPS_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN PS_SUPPLYCOST_MIN ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY&quot;
    | filter &quot;type BOOLEAN PS_SUPPLYCOST_MIN PS_SUPPLYCOST ==&quot;
    | indexJoin part IxP_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;
    | project &quot; type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                    type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                    type VARCHAR ( 0 ) as P_MFGR P_MFGR&quot;
    | hash &quot;type INTEGER ( 19 ) PS_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S07 on all partitions:
    indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 PS_SUPPKEY ==&quot;
    | project &quot; type DECIMAL ( 19  2 ) as S_ACCTBAL S_ACCTBAL ,
                type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                type VARCHAR ( 0 ) as P_MFGR P_MFGR&quot;
    | sort &quot;type DECIMAL ( 19  2 ) S_ACCTBAL DESC&quot;
    | limit 100
    | combined 0
    | next

  stage S08 on all partitions:
    indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 PS_SUPPKEY ==&quot;
    | project &quot; type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                  type DECIMAL ( 19  2 ) as S_ACCTBAL S_ACCTBAL ,
                  type VARCHAR ( 0 ) as S_NAME S_NAME ,
                  type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                  type VARCHAR ( 0 ) as P_MFGR P_MFGR ,
                  type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS ,
                  type VARCHAR ( 0 ) as S_PHONE S_PHONE ,
                  type VARCHAR ( 0 ) as S_COMMENT S_COMMENT &quot;

    | indexJoin nation IxN_NATIONKEY &quot;BOUND $I1 S_NATIONKEY ==&quot;
    | project &quot;type DECIMAL ( 19  2 ) as S_ACCTBAL S_ACCTBAL ,
               type VARCHAR ( 0 ) as S_NAME S_NAME ,
               type VARCHAR ( 0 ) as N_NAME N_NAME ,
               type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type VARCHAR ( 0 ) as P_MFGR P_MFGR ,
               type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS ,
               type VARCHAR ( 0 ) as S_PHONE S_PHONE ,
               type VARCHAR ( 0 ) as S_COMMENT S_COMMENT &quot;
    | sort &quot;type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER ( 19 ) P_PARTKEY ASC&quot;
    | limit 100
    | combined 0
    | next

  stage S09 on all nodes :
    sort &quot;type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER ( 19 ) P_PARTKEY ASC&quot;
    | limit 100
    | combined 0
    | next

  stage S09 on origin :
    sort &quot;type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER ( 19 ) P_PARTKEY ASC&quot;
    | limit 100
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;</stringProp>
