pipeline Query11
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan partsupp
    | project &quot;type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST&quot;
    | hash &quot;type INTEGER ( 19 ) PS_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S02 on all partitions multiple threads 4:
    indexJoin supplier IxS_SUPPKEY &quot;bound $I1 PS_SUPPKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
                type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY&quot;
    | indexJoin nation IxN_NATIONKEY &quot;bound $I1 S_NATIONKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type VARCHAR ( 0 ) as N_NAME N_NAME&quot;
    | filter &quot; type BOOLEAN N_NAME &apos;GERMANY&apos;  ==  &quot;
    | aggreg &quot; type DECIMAL ( 19  2 ) )  PS_SUPPLYCOST PS_AVAILQTY casttype DECIMAL ( 19  2 ) CAST  *  sum  &quot;
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg &quot; type DECIMAL ( 19  2 ) as INNERRESULT )  $1 sum  &quot;
    | combined 0
    | next

  stage S04 on origin :
    aggreg &quot; type DECIMAL ( 19  2 ) as INNERRESULT )  $1 sum&quot;
    | combined 0
    | next

  stage S05 on origin :
    aggreg &quot; type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT 0.00001  *  &quot;
    | combined 0
    | next broadcast

  stage S05 on all partitions :
    indexJoin partsupp IxPS_PARTKEY &quot;bound $I1&quot;
  | project &quot;type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
             type INTEGER ( 19 ) as PS_PARTKEY PS_PARTKEY ,
             type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
             type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
             type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
  | hash &quot;type INTEGER ( 19 ) PS_SUPPKEY&quot;
  | combined 0
  | next hashcast

  stage S02 on all partitions   multiple threads 4:
    indexJoin supplier IxS_SUPPKEY &quot;bound $I1 PS_SUPPKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as PS_PARTKEY PS_PARTKEY ,
               type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
               type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;

    | indexJoin nation IxN_NATIONKEY &quot;bound $I1 S_NATIONKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as PS_PARTKEY PS_PARTKEY ,
               type INTEGER ( 19 ) as PS_AVAILQTY PS_AVAILQTY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT ,
               type VARCHAR ( 0 ) as N_NAME N_NAME&quot;
    | filter &quot; type BOOLEAN N_NAME &apos;GERMANY&apos;  ==  &quot;
    | gbyAgg &quot; GroupBy    type INTEGER ( 19 ) PS_PARTKEY
                   aggregates
                              type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                              type DECIMAL ( 19  2 ) as VALUE ) PS_SUPPLYCOST PS_AVAILQTY casttype DECIMAL ( 19  2 ) CAST  *  sum  ,
                              type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S08 on all nodes :
    gbyAgg &quot; GroupBy    type INTEGER ( 19 ) PS_PARTKEY
             aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                        type DECIMAL ( 19  2 ) as VALUE ) VALUE sum  ,
                        type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S09 on origin :
    gbyAgg &quot; GroupBy    type INTEGER ( 19 ) PS_PARTKEY
             aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                        type DECIMAL ( 19  2 ) as VALUE ) VALUE sum  ,
                        type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S10 on origin :
    filter &quot; type BOOLEAN  value INNERRESULT  &gt;  &quot;
    | project &quot; type INTEGER ( 19 ) as PS_PARTKEY PS_PARTKEY ,
                type DECIMAL ( 19  2 ) as VALUE VALUE&quot;
    | sort &quot; type DECIMAL ( 19  2 ) VALUE DESC  &quot;
    | combined 0
    | next

  stage S11 on origin :
    output
    | sink
    | first
end ;</stringProp>
