                <stringProp name="query">/optimise_passthru
pipeline Query6
begin

  stage S00 on origin : 
      start
    | pulse     once
    | next

  stage S01 on all partitions  multiple threads 4:
      scan      lineitem
      | project   &quot;type DECIMAL ( 15 2 ) as L_QUANTITY L_QUANTITY
                 , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                 , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT
                 , type DATE as L_SHIPDATE L_SHIPDATE&quot;
      | filter    &quot; type BOOLEAN } L_SHIPDATE DATE &apos;1994-01-01&apos; &gt;= L_SHIPDATE DATE &apos;1995-01-01&apos; &lt; and 0.05 0.07 L_DISCOUNT between and L_QUANTITY 24.00 &lt; and &quot;
      | project   &quot; type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                  , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT &quot;
      | aggreg    &quot;   type DECIMAL ( 19 2 ) as REVENUE ) L_EXTENDEDPRICE L_DISCOUNT * sum &quot;
      | dynamic
      | next

  stage S02 on all nodes :
    aggreg    &quot;   type DECIMAL ( 19 2 ) as REVENUE ) REVENUE sum &quot;
    | dynamic
    | next      

  stage S03 on origin :
    aggreg    &quot;   type DECIMAL ( 19 2 ) as REVENUE ) REVENUE sum &quot;
    | dynamic
    | next      

  stage S04 on origin :
      output
    | sink
    | first

end ;
</stringProp>
