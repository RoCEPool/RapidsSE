pipeline Query6
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     indexscan lineitem IxL_SHIPDATE &quot;LBOUND $I1 DATE &apos;1994-01-01&apos; &gt;= UBOUND $I1 DATE &apos;1995-01-01&apos; &lt;&quot;
     |  project   &quot;type DECIMAL ( 15 2 ) as L_QUANTITY L_QUANTITY
                      , type DECIMAL ( 15 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE
                      , type DECIMAL ( 15 2 ) as L_DISCOUNT L_DISCOUNT&quot;
     | filter &quot; type BOOLEAN  }  0.05 0.07 L_DISCOUNT between L_QUANTITY 24. &lt; and&quot;
     | aggreg &quot; type DECIMAL ( 19  2 ) as REVENUE ) L_EXTENDEDPRICE L_DISCOUNT *  sum  &quot;
     | combined 0
     | next

   stage S02 on all nodes :
     aggreg &quot; type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  &quot;
     | combined 0
     | next

   stage S03 on origin :
     aggreg &quot; type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  &quot;
     | combined 0
     | next

   stage S04 on origin :
     output
     | sink
     | first
end ;
