              <stringProp name="query">pipeline Query13
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public customer
    | next

  stage S02 on all partitions :
    indexJoin orders IxO_CUSTKEY &quot;LEFT_OUTER BOUND $I1 $L1 ==&quot;
        &quot;type BOOLEAN }  J1_O_COMMENT &apos;%special%requests%&apos;  7 8 matchMiddle1  not&quot;
    | project &quot;type INTEGER as C_CUSTKEY C_CUSTKEY ,
               type INTEGER as O_ORDERKEY J1_O_ORDERKEY&quot;
    | combined 0
    | next

  stage S03 on all partitions :
    ordAgg &quot; ordGroupBy  type INTEGER as C_CUSTKEY $1
             aggregates  type INTEGER $K1 ,
                         type INTEGER ) O_ORDERKEY count  &quot;
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg &quot; groupBy    type INTEGER as c_count $2
             aggregates
                        type INTEGER $K1 ,
                        type INTEGER as custdist )  countAll  &quot;
    | combined 0
    | next

  stage S05 on origin :
    sort &quot; type INTEGER $1 DESC ,
           type INTEGER as c_count $2 DESC &quot;
    | combined 0
    | next

 stage S06 on origin :
   output
   | sink
   | first
 end ;</stringProp>
