              <stringProp name="query">pipeline Query5
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage S00 on all partitions :
    scan rapidsse public Orders
    | filter &quot; type BOOLEAN O_ORDERDATE DATE &apos;1994-01-01&apos;  &gt;=
                            O_ORDERDATE DATE &apos;1995-01-01&apos;  &lt;  and  &quot;
    | project &quot;type INTEGER as O_CUSTKEY O_CUSTKEY ,
               type INTEGER as O_ORDERKEY O_ORDERKEY&quot;
    | combined 0
    | next

  stage S01 on all partitions :
    indexJoin Customer IxC_CUSTKEY &quot;BOUND $I1 O_CUSTKEY ==&quot;
    | project &quot;type INTEGER as O_ORDERKEY O_ORDERKEY ,
               type INTEGER as C_NATIONKEY J1_C_NATIONKEY&quot;
    | hash &quot;type INTEGER O_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY &quot;bound $I1 O_ORDERKEY ==&quot;
    | project &quot;type INTEGER as C_NATIONKEY C_NATIONKEY ,
                   type INTEGER as L_SUPPKEY J1_L_SUPPKEY ,
                   type DECIMAL as L_EXTENDEDPRICE J1_L_EXTENDEDPRICE ,
                   type DECIMAL as L_DISCOUNT J1_L_DISCOUNT&quot;
    | hash &quot;type INTEGER L_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin Supplier IxS_SUPPKEY expr &quot;bound $I1 L_SUPPKEY ==&quot;
    | filter &quot; type BOOLEAN C_NATIONKEY J1_S_NATIONKEY == &quot;
    | project &quot;type DECIMAL as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL as L_DISCOUNT L_DISCOUNT ,
               type INTEGER as S_NATIONKEY J1_S_NATIONKEY&quot;
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin Nation IxN_NATIONKEY expr &quot;bound $I1 S_NATIONKEY ==&quot;
    | project &quot;type DECIMAL as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR as N_NAME J1_N_NAME ,
               type INTEGER as N_REGIONKEY J1_N_REGIONKEY&quot;
    | combined 0
    | next

  stage S05 on all partitions :
    indexJoin Region IxR_REGIONKEY expr &quot;bound $I1 N_REGIONKEY ==&quot;
    | filter &quot; type BOOLEAN J1_R_NAME &apos;ASIA&apos;  ==  &quot;
    | project &quot;type DECIMAL as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR as N_NAME N_NAME&quot;
    | combined 0
    | next

  stage S06 on all partitions :
    gbyAgg &quot; groupBy    type VARCHAR as N_NAME N_NAME
             aggregates type VARCHAR as N_NAME $K1 ,
                        type DECIMAL as REVENUE )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  &quot;
    | combined 0
    | next

  stage S07 on all nodes :
    gbyAgg &quot; groupBy    type VARCHAR as N_NAME N_NAME
             aggregates type VARCHAR as N_NAME $K1 ,
                        type DECIMAL as REVENUE ) REVENUE sum  &quot;
    | combined 0
    | next

  stage S08 on origin :
    gbyAgg &quot; groupBy    type VARCHAR as N_NAME N_NAME
             aggregates type VARCHAR as N_NAME $K1 ,
             type DECIMAL as REVENUE ) REVENUE sum  &quot;
    | combined 0
    | next

  stage S09 on origin :
    sort &quot; type DECIMAL REVENUE DESC  &quot;
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;</stringProp>
