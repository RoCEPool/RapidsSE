            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="p14" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query14
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    indexscan lineitem IxL_SHIPDATE &quot;LBOUND DATE &apos;1995-09-01&apos; &gt;= UBOUND DATE &apos;1995-10-01&apos; &lt;&quot;
    | project &quot;type INTEGER as L_PARTKEY L_PARTKEY ,
               type DECIMAL as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL as L_DISCOUNT L_DISCOUNT&quot;
    | hash &quot;type INTEGER L_PARTKEY&quot;
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    indexJoin part IxP_PARTKEY &quot;bound $I1 L_PARTKEY ==&quot;
    | aggreg &quot; type DECIMAL )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  ,
                type DECIMAL )  }  }  J1_P_TYPE &apos;PROMO%&apos;  6 matchLeading WHEN  L_EXTENDEDPRICE 1. L_DISCOUNT -  * THEN  0.  ELSE  ENDIF  CASE  sum  &quot;
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg &quot; type DECIMAL ) $1 sum  ,
              type DECIMAL ) $2 sum  &quot;
    | combined 0
    | next

  stage S04 on origin :
    aggreg &quot; type DECIMAL ) $1 sum  ,
              type DECIMAL ) $2 sum  &quot;
    | combined 0
    | next

  stage S05 on origin :
    project &quot; type DECIMAL as promo_revenue 100.00  $2 *  $1 /  &quot;
    | combined 0
    | next

  stage S06 on origin :
    output
    | sink
    | first
end ;</stringProp>
