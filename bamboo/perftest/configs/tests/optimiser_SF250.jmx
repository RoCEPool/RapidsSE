            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="p1" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query1
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public lineitem
    | filter &quot; type BOOLEAN  $11 DATE &apos;1998-09-01&apos;  &lt;=  &quot;
    | gbyAgg &quot; groupBy  type VARCHAR L_RETURNFLAG , type VARCHAR L_LINESTATUS
      aggregates
      type VARCHAR as L_RETURNFLAG $K1 ,
      type VARCHAR as L_LINESTATUS $K2 ,
      type DECIMAL ) as SUM_QTY L_QUANTITY sum  ,
      type DECIMAL ) as SUM_BASE_PRICE L_EXTENDEDPRICE sum  ,
      type DECIMAL ) as SUM_DISC_PRICE L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  ,
      type DECIMAL ) as SUM_CHARGE L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  1.  L_TAX +  *  sum  ,
      type INTEGER ) L_EXTENDEDPRICE count  ,
      type INTEGER ) L_QUANTITY count  ,
      type DECIMAL ) L_DISCOUNT sum  ,
      type INTEGER ) L_DISCOUNT count  ,
      type INTEGER ) countAll  &quot;
    | combined 0
    | next

  stage S02 on all nodes :
    gbyAgg &quot; groupBy  type VARCHAR L_RETURNFLAG , type VARCHAR L_LINESTATUS
      aggregates
      type VARCHAR as L_RETURNFLAG $K1 ,
      type VARCHAR as L_LINESTATUS $K2 ,
      type DECIMAL as SUM_QTY ) SUM_QTY sum ,
      type DECIMAL as SUM_BASE_PRICE ) SUM_BASE_PRICE sum ,
      type DECIMAL as SUM_DISC_PRICE ) SUM_DISC_PRICE sum ,
      type DECIMAL as SUM_CHARGE ) SUM_CHARGE sum ,
      type INTEGER ) $7 sum ,
      type INTEGER ) $8 sum ,
      type DECIMAL ) $9 sum ,
      type INTEGER ) $10 sum ,
      type INTEGER ) $11 sum &quot;
    | combined 0
    | next

  stage S03 on origin :
    gbyAgg &quot; groupBy  type VARCHAR L_RETURNFLAG , type VARCHAR L_LINESTATUS
      aggregates
      type VARCHAR as L_RETURNFLAG $K1 ,
      type VARCHAR as L_LINESTATUS $K2 ,
      type DECIMAL as SUM_QTY ) SUM_QTY sum ,
      type DECIMAL as SUM_BASE_PRICE ) SUM_BASE_PRICE sum ,
      type DECIMAL as SUM_DISC_PRICE ) SUM_DISC_PRICE sum ,
      type DECIMAL as SUM_CHARGE ) SUM_CHARGE sum ,
      type INTEGER ) $7 sum ,
      type INTEGER ) $8 sum ,
      type DECIMAL ) $9 sum ,
      type INTEGER ) $10 sum ,
      type INTEGER as COUNT_ORDER ) $11 sum&quot;
    | combined 0
    | next

  stage S04 on origin :
    project &quot;
      type VARCHAR as L_RETURNFLAG L_RETURNFLAG ,
      type VARCHAR as L_LINESTATUS L_LINESTATUS ,
      type DECIMAL as SUM_QTY SUM_QTY ,
      type DECIMAL as SUM_BASE_PRICE SUM_BASE_PRICE ,
      type DECIMAL as SUM_DISC_PRICE SUM_DISC_PRICE ,
      type DECIMAL as SUM_CHARGE SUM_CHARGE ,
      type DECIMAL as AVG_QTY SUM_QTY $8 casttype DECIMAL CAST  / ,
      type DECIMAL as AVG_PRICE SUM_BASE_PRICE $7 casttype DECIMAL CAST  / ,
      type DECIMAL as AVG_DISC $9 $10 casttype DECIMAL CAST  / ,
      type INTEGER as COUNT_ORDER COUNT_ORDER &quot;
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;</stringProp>
              <stringProp name="queryArguments"></stringProp>
