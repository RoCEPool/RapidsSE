              </JDBCSampler>
              <hashTree/>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q7_POC3_4mt" enabled="true">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query7
begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     scan nation
     | project &quot;type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N_NAME&quot;
     | filter &quot;type BOOLEAN N2_N_NAME &apos;FRANCE&apos; == N2_N_NAME &apos;GERMANY&apos; == OR&quot;
     | project &quot;type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME&quot;
     | indexJoin customer IxC_NATIONKEY &quot;BOUND $I1 N_NATIONKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME&quot;
     | combined 0
     | next

   stage S03 on all partitions :
     indexJoin orders IxO_CUSTKEY &quot;BOUND $I1 C_CUSTKEY ==&quot;
     | project &quot;type integer ( 19 ) as O_ORDERKEY O_ORDERKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME&quot;
     | hash &quot;type INTEGER ( 19 ) O_ORDERKEY&quot;
     | combined 0
     | next hashcast

   stage S04 on all partitions  multiple threads 4:
     indexJoin LineItem IxL_ORDERKEY &quot;BOUND $I1 O_ORDERKEY ==&quot;
     | project &quot;type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                type DATE ( 0 ) as L_SHIPDATE L_SHIPDATE ,
                type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE  ,
                type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT &quot;
     | filter &quot;type BOOLEAN } DATE &apos;1995-01-01&apos;  DATE &apos;1996-12-31&apos; L_SHIPDATE between&quot;
     | project &quot;type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                type INTEGER ( 19 ) as L_YEAR L_SHIPDATE extract_year ,
                type DECIMAL ( 19  2 ) as volume L_EXTENDEDPRICE 1.00 L_DISCOUNT -  * &quot;
     | hash &quot;type INTEGER ( 19 ) L_SUPPKEY &quot;
     | combined 0
     | next hashcast

   stage S05 on all partitions :
     indexJoin Supplier IxS_SUPPKEY expr bound $I1 L_SUPPKEY ==
     | project &quot;type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                type INTEGER ( 19 ) as L_YEAR L_YEAR ,
                type DECIMAL ( 19  2 ) as VOLUME VOLUME&quot;
     | combined 0
     | next

   stage S06 on all partitions :
     indexJoin Nation IxN_NATIONKEY expr bound $I1 S_NATIONKEY ==
     | project &quot;type VARCHAR ( 0 ) as N1_N_NAME N_NAME ,
                     type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                     type INTEGER ( 19 ) as L_YEAR L_YEAR ,
                     type DECIMAL ( 19  2 ) as VOLUME VOLUME&quot;
     | filter &quot;type BOOLEAN N1_N_NAME &apos;FRANCE&apos; == N2_N_NAME &apos;GERMANY&apos; == and
                            N1_N_NAME &apos;GERMANY&apos; == N2_N_NAME &apos;FRANCE&apos; == and or&quot;
     | gbyAgg &quot; GroupBy type VARCHAR ( 0 ) as N1_N_NAME N1_N_NAME ,
                      type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                      type INTEGER ( 19 ) as L_YEAR L_YEAR aggregates
                      type VARCHAR ( 0 ) as N1_N_NAME $K1 ,
                      type VARCHAR ( 0 ) as N2_N_NAME $K2 ,
                      type INTEGER ( 19 ) as L_YEAR $K3 ,
                      type DECIMAL ( 19  2 ) AS REVENUE ) VOLUME sum  &quot;
     | combined 0
     | next

   stage S08 on all nodes :
    gbyAgg &quot; GroupBy type VARCHAR ( 0 ) as N1_N_NAME N1_N_NAME ,
                     type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                     type INTEGER ( 19 ) as L_YEAR L_YEAR
                     aggregates
                     type VARCHAR ( 0 ) as N1_N_NAME $K1 ,
                     type VARCHAR ( 0 ) as N2_N_NAME $K2 ,
                     type INTEGER ( 19 ) as L_YEAR $K3 ,
                     type DECIMAL ( 19  2 ) AS REVENUE ) REVENUE sum  &quot;
     | combined 0
     | next

   stage S09 on origin :
     gbyAgg &quot; GroupBy type VARCHAR ( 0 ) as SUPP_NATION N1_N_NAME ,
                      type VARCHAR ( 0 ) as CUST_NATION N2_N_NAME ,
                      type INTEGER ( 19 ) as L_YEAR L_YEAR
                      aggregates
                      type VARCHAR ( 0 ) as N1_N_NAME $K1 ,
                      type VARCHAR ( 0 ) as N2_N_NAME $K2 ,
                      type INTEGER ( 19 ) as L_YEAR $K3 ,
                      type DECIMAL ( 19  2 ) AS REVENUE ) REVENUE sum  &quot;
     | combined 0
     | next

   stage S10 on origin :
     output
     | sink
     | first
 end ;
</stringProp>
