                <stringProp name="query">/optimise_passthru
pipeline Query10
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions:
    indexScan Orders IxO_ORDERDATE &quot;LBOUND date &apos;1993-10-01&apos; &gt;=  UBOUND date &apos;1994-01-01&apos; &lt; &quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY  O_CUSTKEY ,
               type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY&quot;
    | indexJoin Customer IxC_CUSTKEY &quot;BOUND $I1 O_CUSTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY&quot;
    | hash expr type INTEGER ( 19 ) O_ORDERKEY
    | combined 0
    | next hashcast

  stage S03 on all partitions  multiple threads 4:
    indexJoin Lineitem IxL_ORDERKEY &quot;BOUND $I1 O_ORDERKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR ( 0 ) as L_RETURNFLAG L_RETURNFLAG&quot;
    | filter  &quot;type BOOLEAN L_RETURNFLAG &apos;R&apos; ==&quot;
    | gbyAgg  &quot;groupby    type INTEGER ( 19 ) O_CUSTKEY
               aggregates type INTEGER ( 19 ) as O_CUSTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as REVENUE ) L_EXTENDEDPRICE 1.0  L_DISCOUNT -  *  sum &quot;
    | combined 0
    | next

  stage S04 on all nodes :
    gbyAgg &quot;groupby    type INTEGER ( 19 ) O_CUSTKEY
            aggregates type INTEGER ( 19 ) as O_CUSTKEY $K1 ,
                       type DECIMAL ( 19  2 ) as REVENUE ) REVENUE  sum &quot;
    | combined 0
    | next

  stage S05 on origin :
    gbyAgg &quot;groupby    type INTEGER ( 19 ) O_CUSTKEY
            aggregates type INTEGER ( 19 ) as O_CUSTKEY $K1 ,
                       type DECIMAL ( 19  2 ) as REVENUE ) REVENUE  sum&quot;
    | combined 0
    | next

  stage S06 on origin :
    top &quot; type DECIMAL ( 19  2 ) REVENUE &quot; 20
    | hash expr type INTEGER ( 19 ) O_CUSTKEY
    | combined 0
    | next hashcast

  stage S07 on all partitions :
    indexJoin Customer IxC_CUSTKEY &quot;BOUND $I1 O_CUSTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY ,
               type VARCHAR ( 0 ) as C_NAME C_NAME ,
               type DECIMAL ( 19  2 ) as REVENUE ) REVENUE ,
               type DECIMAL ( 19  2 ) as C_ACCTBAL C_ACCTBAL ,
               type VARCHAR ( 0 ) as C_ADDRESS C_ADDRESS ,
               type VARCHAR ( 0 ) as C_PHONE C_PHONE ,
               type VARCHAR ( 0 ) as C_COMMENT C_COMMENT&quot;
    | indexjoin Nation IxN_NATIONKEY &quot;BOUND $I1 C_NATIONKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type VARCHAR ( 0 ) as C_NAME C_NAME ,
               type DECIMAL ( 19  2 ) as REVENUE ) REVENUE ,
               type DECIMAL ( 19  2 ) as C_ACCTBAL C_ACCTBAL ,
               type VARCHAR ( 0 ) as N_NAME N_NAME ,
               type VARCHAR ( 0 ) as C_ADDRESS C_ADDRESS ,
               type VARCHAR ( 0 ) as C_PHONE C_PHONE ,
               type VARCHAR ( 0 ) as C_COMMENT C_COMMENT&quot;
    | combined 0
    | next

  stage S09 on origin :
    sort &quot; type DECIMAL ( 19  2 ) REVENUE DESC  &quot;
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;
</stringProp>
