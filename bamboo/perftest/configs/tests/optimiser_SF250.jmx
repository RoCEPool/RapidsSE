            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="p3" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query3
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Customer
    | filter &quot;type BOOLEAN C_MKTSEGMENT &apos;BUILDING&apos; ==&quot;
    | project &quot;type INTEGER as C_CUSTKEY C_CUSTKEY&quot;
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin Orders IxO_CUSTKEY &quot;BOUND $I1 C_CUSTKEY ==&quot;
    | filter &quot;type BOOLEAN J1_O_ORDERDATE DATE &apos;1995-03-15&apos; &lt;&quot;
    | project &quot;type INTEGER as O_ORDERKEY J1_O_ORDERKEY ,
               type DATE as O_ORDERDATE J1_O_ORDERDATE ,
               type INTEGER as O_SHIPPRIORITY J1_O_SHIPPRIORITY&quot;
    | hash &quot;type INTEGER O_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    sort &quot;type INTEGER O_ORDERKEY ASC&quot;
    | combined 0
    | next

  stage S04 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY &quot;BOUND $I1 O_ORDERKEY ==&quot;
    | filter &quot;type BOOLEAN J1_L_SHIPDATE DATE &apos;1995-03-15&apos; &gt;&quot;
    | ordAgg &quot; ordGroupBy type INTEGER J1_L_ORDERKEY
               aggregates type INTEGER as L_ORDERKEY $K1 ,
                          type DECIMAL as REVENUE ) J1_L_EXTENDEDPRICE 1. J1_L_DISCOUNT -  *  sum  ,
                          type DATE as O_ORDERDATE  O_ORDERDATE ,
                          type INTEGER as O_SHIPPRIORITY O_SHIPPRIORITY &quot;
    | combined 0
    | next

  stage S05 on all partitions :
    sort &quot; type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  &quot;
    | limit 10
    | combined 0
    | next

  stage S06 on all nodes :
    sort &quot; type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  &quot;
    | limit 10
    | combined 0
    | next

  stage S07 on origin :
    sort &quot; type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  &quot;
    | limit 10
    | combined 0
    | next

  stage S08 on origin :
    output
    | sink
    | first
end ;</stringProp>
