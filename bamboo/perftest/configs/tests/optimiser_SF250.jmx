              <stringProp name="query">pipeline Query11
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan supplier
    | project &quot; type INTEGER as S_SUPPKEY S_SUPPKEY ,
                type INTEGER as S_NATIONKEY S_NATIONKEY&quot;
    | combined 0
    | next broadcast

  stage S01 on all partitions :
    indexJoin nation IxN_NATIONKEY &quot;bound $I1 S_NATIONKEY ==&quot;
    | filter &quot; type BOOLEAN J1_N_NAME &apos;GERMANY&apos;  ==  &quot;
    | project &quot; type INTEGER as S_SUPPKEY S_SUPPKEY&quot;
    | combined 0
    | next

 stage S03 on all partitions :
    indexJoin partsupp IxPS_SUPPKEY &quot;bound $I1 S_SUPPKEY ==&quot;
    | aggreg &quot; type DECIMAL )  J1_PS_SUPPLYCOST J1_PS_AVAILQTY casttype DECIMAL CAST  *  sum  &quot;
    | combined 0
    | next

  stage S04 on all nodes :
    aggreg &quot; type DECIMAL as INNERRESULT )  $1 sum  &quot;
    | combined 0
    | next

  stage S05 on origin :
    aggreg &quot; type DECIMAL as INNERRESULT )  $1 sum &quot;
    | combined 0
    | next

  stage S06 on origin :
    project &quot; type DECIMAL as INNERRESULT $1 0.0000004  *  &quot;
    | combined 0
    | next broadcast

  stage S07 on all partitions :
    indexJoin supplier IxS_SUPPKEY &quot;bound $I1&quot;
    | project &quot; type INTEGER as S_SUPPKEY J1_S_SUPPKEY ,
                type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
                type DECIMAL as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S06 on all partitions :
    indexJoin nation IxN_NATIONKEY &quot;bound $I1 S_NATIONKEY ==&quot;
    | filter &quot; type BOOLEAN J1_N_NAME &apos;GERMANY&apos;  ==  &quot;
    | project &quot; type INTEGER as S_SUPPKEY S_SUPPKEY ,
                type DECIMAL as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next broadcast

  stage S08 on all partitions :
    indexJoin partsupp IxPS_SUPPKEY &quot;bound $I1 S_SUPPKEY ==&quot;
    | gbyAgg &quot; groupBy    type INTEGER J1_PS_PARTKEY
               aggregates type INTEGER as PS_PARTKEY $K1 ,
                          type DECIMAL as VALUE )  J1_PS_SUPPLYCOST J1_PS_AVAILQTY casttype DECIMAL CAST  *  sum  ,
                          type DECIMAL as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S09 on all nodes :
    gbyAgg &quot; groupBy    type INTEGER PS_PARTKEY
             aggregates type INTEGER as PS_PARTKEY $K1 ,
                        type DECIMAL as VALUE ) VALUE sum  ,
                        type DECIMAL as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S10 on origin :
    gbyAgg &quot; groupBy    type INTEGER PS_PARTKEY
             aggregates type INTEGER as PS_PARTKEY $K1 ,
                        type DECIMAL as VALUE )  VALUE sum  ,
                        type DECIMAL as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S11 on origin :
    filter &quot; type BOOLEAN  value INNERRESULT  &gt;  &quot;
    | project &quot; type INTEGER as PS_PARTKEY PS_PARTKEY ,
                type DECIMAL as VALUE VALUE&quot;
    | sort &quot; type DECIMAL VALUE DESC  &quot;
    | combined 0
    | next

  stage S12 on origin :
    output
    | sink
    | first
end ;</stringProp>
