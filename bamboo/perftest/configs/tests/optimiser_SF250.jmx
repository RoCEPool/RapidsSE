              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q3" enabled="false">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">select 
  l_orderkey,
  sum(l_extendedprice*(1-l_discount)) as revenue,
  o_orderdate,
  o_shippriority
from 
  customer, 
  orders, 
  lineitem
where 
  c_mktsegment = &apos;BUILDING&apos;
  and c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and o_orderdate &lt; &apos;1995-03-15&apos;
  and l_shipdate &gt; &apos;1995-03-15&apos;
group by 
  l_orderkey, 
  o_orderdate, 
  o_shippriority
order by 
  revenue desc, 
  o_orderdate
limit 10;</stringProp>
                <stringProp name="queryArguments"></stringProp>
                <stringProp name="queryArgumentsTypes"></stringProp>
                <stringProp name="queryTimeout"></stringProp>
                <stringProp name="queryType">Select Statement</stringProp>
                <stringProp name="resultSetHandler">Store as String</stringProp>
                <stringProp name="resultSetMaxRows"></stringProp>
                <stringProp name="resultVariable"></stringProp>
                <stringProp name="variableNames"></stringProp>
              </JDBCSampler>
              <hashTree/>
              <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q3_2n_p_4mt" enabled="true">
                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query3
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Customer
    | project &quot;type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
               type VARCHAR as C_MKTSEGMENT C_MKTSEGMENT &quot;
    | filter &quot;type BOOLEAN C_MKTSEGMENT &apos;BUILDING&apos; ==&quot;
    | project &quot;type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY&quot;
    | combined 0
    | next

  stage S02 on all partitions multiple threads 4:
    indexjoin Orders IxO_CUSTKEY &quot;BOUND $I1 C_CUSTKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
               type DATE as O_ORDERDATE O_ORDERDATE ,
               type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY&quot;
    | filter &quot;type BOOLEAN O_ORDERDATE DATE &apos;1995-03-15&apos; &lt;&quot;
    | hash &quot;type INTEGER ( 19 ) O_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    sort &quot;type INTEGER ( 19 ) O_ORDERKEY ASC&quot;
    | combined 0
    | next

  stage S04 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY &quot;BOUND $I1 O_ORDERKEY ==&quot;
    | project &quot;type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
               type DECIMAL ( 19 2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19 2 ) as L_DISCOUNT L_DISCOUNT ,
               type DATE as L_SHIPDATE L_SHIPDATE ,
               type DATE as O_ORDERDATE O_ORDERDATE ,
               type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY&quot;
    | filter &quot;type BOOLEAN L_SHIPDATE DATE &apos;1995-03-15&apos; &gt;&quot;
    | ordAgg &quot; OrdGroupBy type INTEGER ( 19 ) L_ORDERKEY
               aggregates type INTEGER ( 19 ) as L_ORDERKEY $K1 ,
                          type DECIMAL ( 19  2 ) as REVENUE ) L_EXTENDEDPRICE 1. L_DISCOUNT -  *  sum  ,
                          type DATE as O_ORDERDATE  O_ORDERDATE ,
                          type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY &quot;
    | combined 0
    | next

  stage S05 on all partitions :
    sort &quot; type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  &quot;
    | limit 10
    | combined 0
    | next

  stage S06 on all nodes :
    sort &quot; type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  &quot;
    | limit 10
    | combined 0
    | next

  stage S07 on origin :
    sort &quot; type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  &quot;
    | limit 10
    | combined 0
    | next

  stage S08 on origin :
    output
    | sink
    | first
end ;
</stringProp>
