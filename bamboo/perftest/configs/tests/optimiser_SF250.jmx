          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="P2Loop" enabled="true">
            <boolProp name="LoopController.continue_forever">true</boolProp>
            <stringProp name="LoopController.loops">${QUERY_LOOP_COUNT}</stringProp>
          </LoopController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="p2" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query2
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan part
    | filter &quot; type BOOLEAN  }  P_TYPE &apos;%BRASS&apos; 6 matchTrailing P_SIZE 15 == and&quot;
    | project &quot; type INTEGER as P_PARTKEY P_PARTKEY&quot;
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin partsupp IxPS_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;
    | project &quot; type INTEGER as P_PARTKEY P_PARTKEY ,
                type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY ,
                type DECIMAL as PS_SUPPLYCOST J1_PS_SUPPLYCOST&quot;
    | hash &quot;type INTEGER PS_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 PS_SUPPKEY ==&quot;
    | project &quot;type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER as S_NATIONKEY J1_S_NATIONKEY &quot;
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin nation IxN_NATIONKEY &quot;BOUND $I1 S_NATIONKEY ==&quot;
    | project &quot;type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER as N_REGIONKEY J1_N_REGIONKEY &quot;
    | combined 0
    | next

  stage S05 on all partitions :
    indexJoin region IxR_REGIONKEY &quot;BOUND $I1 N_REGIONKEY ==&quot;
    | filter &quot; type BOOLEAN  J1_R_NAME &apos;EUROPE&apos;  == &quot;
    | gbyAgg &quot; GroupBy    type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST min &quot;
    | combined 0
    | next

  stage S06 on all nodes :
     gbyAgg &quot; GroupBy     type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min &quot;
    | combined 0
    | next

  stage S07 on origin :
     gbyAgg &quot; GroupBy    type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min &quot;
    | hash &quot;type INTEGER P_PARTKEY&quot;
    | combined 0
    | next hashcast

  stage S08 on all partitions :
    indexJoin partsupp IxPS_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;
    | filter &quot;type BOOLEAN PS_SUPPLYCOST_MIN J1_PS_SUPPLYCOST ==&quot;
    | project &quot;type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY&quot;
    | combined 0
    | next

  stage S09 on all partitions :
    indexJoin part IxP_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;
    | project &quot; type INTEGER as P_PARTKEY P_PARTKEY ,
                type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                type VARCHAR as P_MFGR J1_P_MFGR&quot;
    | hash &quot;type INTEGER PS_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S10 on all partitions :
    indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 PS_SUPPKEY ==&quot;
    | project &quot; type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
                type DECIMAL as S_ACCTBAL J1_S_ACCTBAL ,
                type VARCHAR as S_NAME J1_S_NAME ,
                type INTEGER as P_PARTKEY P_PARTKEY ,
                type VARCHAR as P_MFGR P_MFGR ,
                type VARCHAR as S_ADDRESS J1_S_ADDRESS ,
                type VARCHAR as S_PHONE J1_S_PHONE ,
                type VARCHAR as S_COMMENT J1_S_COMMENT &quot;
    | combined 0
    | next

  stage S11 on all partitions :
    indexJoin nation IxN_NATIONKEY &quot;BOUND $I1 S_NATIONKEY ==&quot;
    | project &quot; type DECIMAL as S_ACCTBAL S_ACCTBAL ,
                type VARCHAR as S_NAME S_NAME ,
                type VARCHAR as N_NAME J1_N_NAME ,
                 type INTEGER as P_PARTKEY P_PARTKEY ,
                 type VARCHAR as P_MFGR P_MFGR ,
                 type VARCHAR as S_ADDRESS S_ADDRESS ,
                 type VARCHAR as S_PHONE S_PHONE ,
                 type VARCHAR as S_COMMENT S_COMMENT &quot;
    | sort &quot;type DECIMAL S_ACCTBAL DESC ,
            type VARCHAR N_NAME ASC ,
            type VARCHAR S_NAME ASC ,
            type INTEGER P_PARTKEY ASC&quot;
    | limit 100
    | combined 0
    | next

  stage S12 on all nodes :
    sort &quot;type DECIMAL S_ACCTBAL DESC ,
          type VARCHAR N_NAME ASC ,
          type VARCHAR S_NAME ASC ,
          type INTEGER P_PARTKEY ASC&quot;
    | limit 100
    | combined 0
    | next

  stage S13 on origin :
    sort &quot;type DECIMAL S_ACCTBAL DESC ,
          type VARCHAR N_NAME ASC ,
          type VARCHAR S_NAME ASC ,
          type INTEGER P_PARTKEY ASC&quot;
    | limit 100
    | combined 0
    | next

  stage S14 on origin :
    output
    | sink
    | first
end ;</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="variableNames"></stringProp>
              <stringProp name="TestPlan.comments">create index IxPS_PARTKEY  ON partsupp (PS_PARTKEY)  ;
create index IxS_SUPPKEY  ON Supplier  (S_SUPPKEY)  ;
create index IxN_NATIONKEY  ON Nation (N_NATIONKEY)   ;
create index IxR_REGIONKEY  ON Nation (R_REGIONKEY)   ;
create index IxP_PARTKEY  ON part (P_PARTKEY)  ;</stringProp>
