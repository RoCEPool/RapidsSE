                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query11
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan nation
    | filter &quot; type BOOLEAN N_NAME &apos;GERMANY&apos;  ==  &quot;
    | project &quot; type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY&quot;
    | indexJoin supplier IxS_NATIONKEY &quot;bound $I1 N_NATIONKEY ==&quot;
    | project &quot; type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY&quot;
    | combined 0
    | next broadcast

 stage S02 on all partitions:
    indexJoin partsupp IxPS_SUPPKEY &quot;bound $I1 S_SUPPKEY ==&quot;
    | aggreg &quot; type DECIMAL ( 19  2 ) )  PS_SUPPLYCOST PS_AVAILQTY casttype DECIMAL ( 19  2 ) CAST  *  sum  &quot;
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg &quot; type DECIMAL ( 19  2 ) as INNERRESULT )  $1 sum  &quot;
    | combined 0
    | next

  stage S04 on origin :
    aggreg &quot; type DECIMAL ( 19  2 ) as INNERRESULT )  $1 sum&quot;
    | combined 0
    | next

  stage S05 on origin :
    aggreg &quot; type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT 0.00001  *  &quot;
    | combined 0
    | next broadcast

  stage S06 on all partitions  multiple threads 4:
    indexJoin nation IxN_NATIONKEY &quot;bound $I1&quot;
    | filter &quot; type BOOLEAN N_NAME &apos;GERMANY&apos;  ==  &quot;
    | project &quot; type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY ,
                type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
    | indexJoin supplier IxS_NATIONKEY &quot;bound $I1 N_NATIONKEY ==&quot;
    | project &quot; type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY ,
                type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next broadcast

  stage S08 on all partitions :
    indexJoin partsupp IxPS_SUPPKEY &quot;bound $I1 S_SUPPKEY ==&quot;
    | gbyAgg &quot; GroupBy    type INTEGER ( 19 ) PS_PARTKEY
               aggregates
                          type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as VALUE ) PS_SUPPLYCOST PS_AVAILQTY casttype DECIMAL ( 19  2 ) CAST  *  sum  ,
                          type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S09 on all nodes :
    gbyAgg &quot; GroupBy    type INTEGER ( 19 ) PS_PARTKEY
             aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                        type DECIMAL ( 19  2 ) as VALUE ) VALUE sum  , type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S10 on origin :
    gbyAgg &quot; GroupBy    type INTEGER ( 19 ) PS_PARTKEY
             aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                        type DECIMAL ( 19  2 ) as VALUE ) VALUE sum  ,
                        type DECIMAL ( 19  2 ) as INNERRESULT INNERRESULT&quot;
    | combined 0
    | next

  stage S11 on origin :
    filter &quot; type BOOLEAN  value INNERRESULT  &gt;  &quot;
    | project &quot; type INTEGER ( 19 ) as PS_PARTKEY PS_PARTKEY ,
                type DECIMAL ( 19  2 ) as VALUE VALUE&quot;
    | sort &quot; type DECIMAL ( 19  2 ) VALUE DESC  &quot;
    | combined 0
    | next

  stage S12 on origin :
    output
    | sink
    | first
end ;
</stringProp>
