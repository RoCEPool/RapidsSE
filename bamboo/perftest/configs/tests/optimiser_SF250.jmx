            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="p22" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query22
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S02 on all partitions :
    scan Customer
    | filter &quot; type BOOLEAN  C_ACCTBAL 0.00  &gt;
               }  &apos;13&apos;  &apos;31&apos;  &apos;23&apos;  &apos;29&apos;  &apos;30&apos;  &apos;18&apos;  &apos;17&apos;  #7  C_PHONE 1  2  substring3  in  and  &quot;
    | aggreg &quot; type DECIMAL )  C_ACCTBAL sum  ,
                type INTEGER )  C_ACCTBAL count  &quot;
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg &quot; type DECIMAL )  $1 sum  , type INTEGER )  $2 sum  &quot;
    | combined 0
    | next

  stage S04 on origin :
    aggreg &quot; type INTEGER )  $2 sum  , type DECIMAL )  $1 sum  &quot;
    | combined 0
    | next

  stage S05 on origin :
    project &quot; type DECIMAL as acctbal $2 $1 casttype DECIMAL CAST  /  &quot;
    | combined 0
    | next broadcast

  stage S06 on all partitions :
    indexJoin Customer IxC_CUSTKEY &quot;bound $I1&quot;
    | filter &quot; type BOOLEAN  }  &apos;13&apos;  &apos;31&apos;  &apos;23&apos;  &apos;29&apos;  &apos;30&apos;  &apos;18&apos;  &apos;17&apos;  #7  J1_C_PHONE 1  2  substring3  in
              J1_C_ACCTBAL acctbal  &gt;  and &quot;
    | project &quot; type INTEGER as C_CUSTKEY J1_C_CUSTKEY ,
                type VARCHAR as cntrycode J1_C_PHONE 1  2  substring3  ,
                type DECIMAL as C_ACCTBAL J1_C_ACCTBAL &quot;
    | combined 0
    | next

  stage S07 on all partitions :
    keyNotExists ORDERS IxO_CUSTKEY  &quot;BOUND $I1 C_CUSTKEY ==&quot;
                   &quot;type BOOLEAN O_CUSTKEY 0 &gt;&quot;
    | project &quot; type VARCHAR as cntrycode  cntrycode ,
                type DECIMAL as C_ACCTBAL  C_ACCTBAL&quot;
    | combined 0
    | next

 stage S08 on all partitions :
    gbyAgg &quot; groupBy     type VARCHAR as cntrycode $1
             aggregates  type VARCHAR as cntrycode $K1 , type INTEGER )  countAll  ,
                         type DECIMAL )  $2 sum  &quot;
    | combined 0
    | next

  stage S09 on all nodes :
    gbyAgg &quot; groupBy     type VARCHAR as cntrycode $1
             aggregates  type VARCHAR as cntrycode $K1 ,
                         type INTEGER )  $2 sum  ,
                         type DECIMAL )  $3 sum  &quot;
    | combined 0
    | next

  stage S10 on origin :
    gbyAgg &quot; groupBy     type VARCHAR as cntrycode $1
             aggregates  type VARCHAR as cntrycode $K1 ,
                         type INTEGER as numcust )  $2 sum  ,
                         type DECIMAL as totacctbal )  $3 sum  &quot;
    | combined 0
    | next

  stage S11 on origin :
    sort &quot; type VARCHAR as cntrycode $1 ASC  &quot;
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;</stringProp>
