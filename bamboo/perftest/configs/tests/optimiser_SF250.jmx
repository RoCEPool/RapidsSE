              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query12
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     indexScan lineitem IxL_RECEIPTDATE &quot;LBOUND $I1 &gt;= DATE &apos;1994-01-01&apos; UBOUND $I1 DATE &apos;1995-01-01&apos;  &lt;&quot;
     | filter &quot; type BOOLEAN }  &apos;MAIL&apos;  &apos;SHIP&apos;  #2  L_SHIPMODE in&quot;
     | filter &quot; type BOOLEAN L_SHIPDATE L_COMMITDATE &lt; &quot;
     | filter &quot; type BOOLEAN L_COMMITDATE L_RECEIPTDATE &lt;&quot;
     | project &quot;type INTEGER as L_ORDERKEY L_ORDERKEY , type VARCHAR as L_SHIPMODE L_SHIPMODE&quot;
     | combined 0
     | next broadcast

   stage S02 on all partitions :
     indexJoin Orders IxO_ORDERKEY expr bound $I1 L_ORDERKEY ==   // Orders - J1
     | project &quot;type VARCHAR as O_ORDERPRIORITY J1_O_ORDERPRIORITY , type VARCHAR as L_SHIPMODE L_SHIPMODE&quot;
     | combined 0
     | next

   stage S03 on all partitions :
     gbyAgg &quot; groupBy  type VARCHAR as L_SHIPMODE L_SHIPMODE aggregates type VARCHAR $K1 , type INTEGER ) }  O_ORDERPRIORITY &apos;1-URGENT&apos;  == O_ORDERPRIORITY &apos;2-HIGH&apos;  ==  or WHEN  1 THEN  0  ELSE  ENDIF  CASE  sum  , type INTEGER ) }  O_ORDERPRIORITY &apos;1-URGENT&apos;  !=  O_ORDERPRIORITY &apos;2-HIGH&apos;  !=  and  WHEN  1 THEN  0  ELSE  ENDIF  CASE  sum  &quot;
     | combined 0
     | next

   stage S04 on all nodes :
     gbyAgg &quot; groupBy  type VARCHAR as L_SHIPMODE $1 aggregates  type VARCHAR $K1 , type INTEGER )  $2 sum  , type INTEGER )  $3 sum  &quot;
     | combined 0
     | next

   stage S05 on origin :
     gbyAgg &quot; groupBy  type VARCHAR as L_SHIPMODE $1 aggregates  type VARCHAR $K1 , type INTEGER as high_line_count )  $2 sum  , type INTEGER as low_line_count )  $3 sum  &quot;
     | combined 0
     | next

   stage S06 on origin :
     output
     | sink
     | first
 end ;</stringProp>
