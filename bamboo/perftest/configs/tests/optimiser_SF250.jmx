              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query9
  begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public part
    | filter &quot;type BOOLEAN }  P_NAME &apos;%green%&apos; 5 matchMiddle&quot;
    | project &quot;type INTEGER as P_PARTKEY P_PARTKEY&quot;
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin partsupp IxPS_PARTKEY &quot;bound $I1 P_PARTKEY ==&quot;
    | project &quot;type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST J1_PS_SUPPLYCOST&quot;
    | combined 0
    | next broadcast

  stage S03 on all partitions :
    indexJoin LINEITEM IxL_PARTKEY &quot;bound $I1 P_PARTKEY ==&quot;
    | filter &quot;type BOOLEAN J1_L_SUPPKEY PS_SUPPKEY ==&quot;
    | project &quot;type INTEGER as L_ORDERKEY J1_L_ORDERKEY ,
               type INTEGER as L_SUPPKEY J1_L_SUPPKEY ,
               type DECIMAL as AMOUNT J1_L_EXTENDEDPRICE 1.0 J1_L_DISCOUNT -  *  PS_SUPPLYCOST J1_L_QUANTITY *  - &quot;
    | hash &quot;type INTEGER L_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S04 on all partitions :
    indexJoin supplier IxS_SUPPKEY &quot;bound $I1 L_SUPPKEY ==&quot;
    | project &quot;type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
               type INTEGER as L_ORDERKEY L_ORDERKEY ,
               type DECIMAL as AMOUNT AMOUNT &quot;
    | combined 0
    | next broadcast

  stage S05 on all partitions :
    indexJoin ORDERS IxO_ORDERKEY &quot;bound $I1 L_ORDERKEY ==&quot;
    | project &quot;type INTEGER as S_NATIONKEY S_NATIONKEY ,
               type INTEGER as O_YEAR J1_O_ORDERDATE extract_year ,
               type DECIMAL as AMOUNT AMOUNT&quot;
    | combined 0
    | next

  stage S06 on all partitions :
    indexJoin NATION IxN_NATIONKEY &quot;bound $I1 S_NATIONKEY ==&quot;
    | project &quot;type VARCHAR as NATION J1_N_NAME ,
               type INTEGER as O_YEAR O_YEAR ,
               type DECIMAL as AMOUNT AMOUNT&quot;
    | combined 0
    | next

  stage S07 on all partitions :
    gbyAgg &quot;groupBy type VARCHAR NATION ,
                    type INTEGER O_YEAR
            aggregates
                    type VARCHAR as NATION $K1 ,
                    type INTEGER as O_YEAR $K2 ,
                    type DECIMAL as SUM_PROFIT ) AMOUNT sum  &quot;
    | combined 0
    | next

  stage S08 on all nodes :
    gbyAgg &quot;groupBy type VARCHAR NATION ,
                    type INTEGER O_YEAR
            aggregates
                     type VARCHAR as NATION $K1 ,
                     type INTEGER as O_YEAR $K2 ,
                     type DECIMAL as SUM_PROFIT ) SUM_PROFIT sum  &quot;
    | combined 0
    | next

  stage S09 on origin :
    gbyAgg &quot;groupBy type VARCHAR NATION ,
                    type INTEGER O_YEAR
            aggregates
                     type VARCHAR as NATION $K1 ,
                     type INTEGER as O_YEAR $K2 ,
                     type DECIMAL as SUM_PROFIT ) SUM_PROFIT sum  &quot;
    | combined 0
    | next

  stage S10 on origin :
    sort &quot;type VARCHAR as NATION NATION ASC ,
          type INTEGER as O_YEAR O_YEAR DESC&quot;
    | combined 0
    | next

  stage S11 on origin :
    output
    | sink
    | first
  end ;</stringProp>
