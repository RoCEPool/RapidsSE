          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="p7" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query7
begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     scan customer
     | project &quot;type INTEGER as C_CUSTKEY C_CUSTKEY , type INTEGER as C_NATIONKEY C_NATIONKEY&quot;
     | combined 0
     | next

  stage S02 on all partitions :
    indexJoin nation IxN_NATIONKEY &quot;BOUND $I1 C_NATIONKEY ==&quot;
    | filter &quot;type BOOLEAN J1_N_NAME &apos;FRANCE&apos; == J1_N_NAME &apos;GERMANY&apos; == OR&quot;
    | project &quot;type INTEGER as C_CUSTKEY C_CUSTKEY , type VARCHAR as N2_N_NAME J1_N_NAME&quot;
    | combined 0
    | next

   stage S03 on all partitions :
     indexJoin orders IxO_CUSTKEY &quot;BOUND $I1 C_CUSTKEY ==&quot;
     | project &quot;type integer as O_ORDERKEY J1_O_ORDERKEY ,
                type VARCHAR as N2_N_NAME N2_N_NAME&quot;
     | hash &quot;type INTEGER O_ORDERKEY&quot;
     | combined 0
     | next hashcast

   stage S04 on all partitions :
     indexJoin LineItem IxL_ORDERKEY &quot;BOUND $I1 O_ORDERKEY ==&quot;
     | filter &quot;type BOOLEAN } DATE &apos;1995-01-01&apos;  DATE &apos;1996-12-31&apos; J1_L_SHIPDATE between&quot;
     | project &quot;type INTEGER as L_SUPPKEY J1_L_SUPPKEY ,
                type VARCHAR as N2_N_NAME N2_N_NAME ,
                type INTEGER as L_YEAR J1_L_SHIPDATE extract_year ,
                type DECIMAL as volume J1_L_EXTENDEDPRICE 1.00 J1_L_DISCOUNT -  * &quot;
     | hash &quot;type INTEGER L_SUPPKEY &quot;
     | combined 0
     | next hashcast

   stage S05 on all partitions :
     indexJoin Supplier IxS_SUPPKEY expr bound $I1 L_SUPPKEY ==
     | project &quot;type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
                type VARCHAR as N2_N_NAME N2_N_NAME ,
                type INTEGER as L_YEAR L_YEAR ,
                type DECIMAL as VOLUME VOLUME&quot;
     | combined 0
     | next

   stage S06 on all partitions :
     indexJoin Nation IxN_NATIONKEY expr bound $I1 S_NATIONKEY ==
     | filter &quot;type BOOLEAN J1_N_NAME &apos;FRANCE&apos; == N2_N_NAME &apos;GERMANY&apos; == and
                            J1_N_NAME &apos;GERMANY&apos; == N2_N_NAME &apos;FRANCE&apos; == and or&quot;
     | project &quot;type VARCHAR as N1_N_NAME J1_N_NAME ,
                type VARCHAR as N2_N_NAME N2_N_NAME ,
                type INTEGER as L_YEAR L_YEAR ,
                type DECIMAL as VOLUME VOLUME&quot;
     | combined 0
     | next

  stage S07 on all partitions :
     gbyAgg &quot; groupBy type VARCHAR as N1_N_NAME N1_N_NAME ,
                      type VARCHAR as N2_N_NAME N2_N_NAME ,
                      type INTEGER as L_YEAR L_YEAR aggregates
                      type VARCHAR as N1_N_NAME $K1 ,
                      type VARCHAR as N2_N_NAME $K2 ,
                      type INTEGER as L_YEAR $K3 ,
                      type DECIMAL AS REVENUE ) VOLUME sum  &quot;
     | combined 0
     | next

   stage S08 on all nodes :
    gbyAgg &quot; groupBy type VARCHAR as N1_N_NAME N1_N_NAME ,
                     type VARCHAR as N2_N_NAME N2_N_NAME ,
                     type INTEGER as L_YEAR L_YEAR
                     aggregates
                     type VARCHAR as N1_N_NAME $K1 ,
                     type VARCHAR as N2_N_NAME $K2 ,
                     type INTEGER as L_YEAR $K3 ,
                     type DECIMAL AS REVENUE ) REVENUE sum  &quot;
     | combined 0
     | next

   stage S09 on origin :
     gbyAgg &quot; groupBy type VARCHAR as SUPP_NATION N1_N_NAME ,
                      type VARCHAR as CUST_NATION N2_N_NAME ,
                      type INTEGER as L_YEAR L_YEAR
                      aggregates
                      type VARCHAR as N1_N_NAME $K1 ,
                      type VARCHAR as N2_N_NAME $K2 ,
                      type INTEGER as L_YEAR $K3 ,
                      type DECIMAL AS REVENUE ) REVENUE sum  &quot;
     | combined 0
     | next

   stage S10 on origin :
     output
     | sink
     | first
 end ;</stringProp>
