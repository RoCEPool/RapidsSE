              <stringProp name="query">pipeline Query4
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan orders
    | filter &quot; type BOOLEAN O_ORDERDATE DATE &apos;1993-07-01&apos; &gt;=
                            O_ORDERDATE DATE &apos;1993-10-01&apos; &lt; and &quot;
    | project &quot;type INTEGER as O_ORDERKEY O_ORDERKEY ,
               type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY&quot;
    | hash &quot;type INTEGER O_ORDERKEY&quot;
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    keyExists lineitem IxL_ORDERKEY  &quot;BOUND $I1 O_ORDERKEY ==&quot;
                                      &quot;type BOOLEAN L_COMMITDATE L_RECEIPTDATE &lt;&quot;
    | gbyAgg &quot;groupby type VARCHAR O_ORDERPRIORITY
              aggregates
              type VARCHAR as O_ORDERPRIORITY $K1 ,
              type INTEGER as ORDER_COUNT ) countAll&quot;
    | combined 0
    | next

  stage S03 on all nodes :
    gbyAgg &quot;groupby type VARCHAR O_ORDERPRIORITY
            aggregates
            type VARCHAR as O_ORDERPRIORITY $K1 ,
            type INTEGER as ORDER_COUNT ) ORDER_COUNT sum&quot;
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg &quot;groupby type VARCHAR O_ORDERPRIORITY
            aggregates
            type VARCHAR as O_ORDERPRIORITY $K1 ,
            type INTEGER as ORDER_COUNT ) ORDER_COUNT sum&quot;
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;</stringProp>
