              <stringProp name="query">pipeline Query16
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public part
    | filter &quot; type BOOLEAN }  49  14  23  45  19  3  36  9  #8  P_SIZE in&quot;
    | filter &quot; type BOOLEAN  P_BRAND &apos;Brand#45&apos; !=&quot;
    | filter &quot; type BOOLEAN }  P_TYPE &apos;MEDIUM POLISHED%&apos;  16 matchLeading not&quot;
    | project &quot;type INTEGER as P_PARTKEY P_PARTKEY ,
               type VARCHAR as P_BRAND P_BRAND ,
               type VARCHAR as P_TYPE P_TYPE ,
               type INTEGER as P_SIZE P_SIZE&quot;
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin PartSupp IxPS_PARTKEY &quot;BOUND $I1 P_PARTKEY ==&quot;
    | project &quot;type INTEGER as PS_SUPPKEY J1_PS_SUPPKEY ,
               type VARCHAR as P_BRAND P_BRAND ,
               type VARCHAR as P_TYPE P_TYPE ,
               type INTEGER as P_SIZE P_SIZE&quot;
    | combined 0
    | next

  stage S03 on all partitions :
    gbyAgg &quot; groupBy type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                     type VARCHAR as P_BRAND P_BRAND ,
                       type VARCHAR as P_TYPE P_TYPE ,
                       type INTEGER as P_SIZE P_SIZE
               aggregates
                       type INTEGER  as PS_SUPPKEY $K1 ,
                       type VARCHAR  as P_BRAND $K2 ,
                       type VARCHAR  as P_TYPE $K3 ,
                       type INTEGER  as P_SIZE $K4 &quot;


    | combined 0
    | next

  stage S04 on all nodes :
    gbyAgg &quot; groupBy type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                         type VARCHAR as P_BRAND P_BRAND ,
                           type VARCHAR as P_TYPE P_TYPE ,
                           type INTEGER as P_SIZE P_SIZE
                   aggregates
                           type INTEGER  as PS_SUPPKEY $K1 ,
                           type VARCHAR  as P_BRAND $K2 ,
                           type VARCHAR  as P_TYPE $K3 ,
                           type INTEGER  as P_SIZE $K4 &quot;
    | hash &quot; type INTEGER PS_SUPPKEY&quot;
    | combined 0
    | next hashcast

  stage S05 on all partitions :
     keyNotExists SUPPLIER IxS_SUPPKEY  &quot;BOUND $I1 PS_SUPPKEY ==&quot;
               &quot;type BOOLEAN  }  S_COMMENT &apos;%Customer%Complaints%&apos;  8 10 matchMiddle1&quot;
    | combined 0
    | next

  stage S06 on all partitions :
    gbyAgg &quot; groupBy  type VARCHAR as P_BRAND P_BRAND ,
                       type VARCHAR as P_TYPE P_TYPE ,
                       type INTEGER as P_SIZE P_SIZE
                       aggregates
                       type VARCHAR  as P_BRAND $K1 ,
                       type VARCHAR  as P_TYPE $K2 ,
                       type INTEGER  as P_SIZE $K3 ,
                       type INTEGER  as supplier_cnt ) PS_SUPPKEY COUNT&quot;
    | combined 0
    | next

  stage S07 on all nodes :
    gbyAgg &quot; groupBy type VARCHAR as P_BRAND P_BRAND ,
                     type VARCHAR as P_TYPE P_TYPE ,
                     type INTEGER as P_SIZE P_SIZE
                     aggregates
                     type VARCHAR  as P_BRAND $K1 ,
                     type VARCHAR  as P_TYPE $K2 ,
                     type INTEGER  as P_SIZE $K3 ,
                     type INTEGER  as supplier_cnt ) supplier_cnt SUM&quot;
    | combined 0
    | next

  stage S08 on origin :
    gbyAgg &quot; groupBy  type VARCHAR as P_BRAND P_BRAND ,
                      type VARCHAR as P_TYPE P_TYPE ,
                      type INTEGER as P_SIZE P_SIZE
                      aggregates
                      type VARCHAR  as P_BRAND $K1 ,
                      type VARCHAR  as P_TYPE $K2 ,
                      type INTEGER  as P_SIZE $K3 ,
                      type INTEGER  as supplier_cnt ) supplier_cnt SUM&quot;
    | combined 0
    | next

  stage S09 on origin :
    sort &quot; type INTEGER $4 DESC  ,
           type VARCHAR as P_BRAND P_BRAND ASC ,
           type VARCHAR as P_TYPE P_TYPE ASC ,
           type INTEGER as P_SIZE P_SIZE ASC &quot;
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;</stringProp>
