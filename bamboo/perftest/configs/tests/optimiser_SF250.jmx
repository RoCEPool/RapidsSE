              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query17
begin
  stage S00 on origin :
    start
    | pulse once
    | next

 stage S01 on all partitions :
     scan rapidsse public part
     | filter &quot; type BOOLEAN  P_BRAND &apos;Brand#23&apos;  ==  P_CONTAINER &apos;MED BOX&apos;  ==  and&quot;
     | project &quot;type INTEGER as P_PARTKEY P_PARTKEY&quot;
     | combined 0
     | next broadcast

  stage S02 on all partitions :
    indexJoin lineitem IxL_PARTKEY &quot;bound $I1 P_PARTKEY ==&quot;
    | ordagg &quot; ordgroupBy type integer P_PARTKEY
               aggregates type integer as P_PARTKEY $K1 ,
                          type DECIMAL )  J1_L_QUANTITY sum  ,
                          type INTEGER )  J1_L_QUANTITY count  &quot;
    | combined 0
    | next

  stage S03 on all nodes :
    gbyAgg &quot; groupBy    type integer P_PARTKEY
             aggregates type integer as P_PARTKEY $K1 ,
                        type DECIMAL )  $2 sum  ,
                        type INTEGER )  $3 sum  &quot;
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg &quot; groupBy    type integer P_PARTKEY
             aggregates type integer as P_PARTKEY $K1 ,
                        type DECIMAL )  $2 sum  ,
                        type INTEGER )  $3 sum  &quot;
    | combined 0
    | next

  stage S05 on origin :
    project &quot; type integer as P_PARTKEY P_PARTKEY ,
              type DECIMAL as AV $2 $3 casttype DECIMAL cast / 0.2 *&quot;
    | combined 0
    | next broadcast

  stage S06 on all partitions :
    indexJoin lineitem IxL_PARTKEY &quot;bound $I1 $L1 ==&quot;
    | filter &quot; type BOOLEAN  J1_L_QUANTITY AV &lt;  &quot;
    | aggreg &quot; type decimal as avg_yearly ) J1_L_EXTENDEDPRICE sum  &quot;
    | combined 0
    | next

  stage S07 on all nodes :
    aggreg &quot; type decimal as avg_yearly ) $1 sum  &quot;
    | combined 0
    | next

  stage S08 on origin :
    aggreg &quot; type DECIMAL as avg_yearly ) $1 sum &quot;
    | combined 0
    | next

  stage S09 on origin :
    project &quot; type DECIMAL as avg_yearly $1 7.0 / &quot;
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;</stringProp>
