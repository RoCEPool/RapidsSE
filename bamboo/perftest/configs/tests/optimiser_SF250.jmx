              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">pipeline Query18
begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
      indexscan lineitem IxL_ORDERKEY &quot;lbound $I1 0 &gt;=&quot;
     | ordAgg &quot; ordgroupBy  type INTEGER as L_ORDERKEY L_ORDERKEY aggregates  type INTEGER as L_ORDERKEY $K1 , type DECIMAL as SUM_QTY )  L_QUANTITY sum  &quot;
     | filter  &quot; type BOOLEAN  SUM_QTY 300.00  &gt;  &quot;
     | combined 0
     | next broadcast

   stage S02 on all partitions :
     indexJoin orders IxO_ORDERKEY &quot;bound $I1 $L1 ==&quot;
     | project &quot;type INTEGER as O_CUSTKEY J1_O_CUSTKEY ,
                type INTEGER as O_ORDERKEY J1_O_ORDERKEY ,
                type DATE as O_ORDERDATE J1_O_ORDERDATE ,
                type DECIMAL as O_TOTALPRICE J1_O_TOTALPRICE ,
                type DECIMAL as SUM_QTY SUM_QTY &quot;
     | combined 0
     | next

   stage S03 on all partitions :
     indexJoin customer IxC_CUSTKEY &quot;bound $I1 $L1 ==&quot;
     | project &quot;type VARCHAR as C_NAME J1_C_NAME ,
                type INTEGER as C_CUSTKEY J1_C_CUSTKEY ,
                type INTEGER as O_ORDERKEY O_ORDERKEY ,
                type DATE as O_ORDERDATE O_ORDERDATE ,
                type DECIMAL as O_TOTALPRICE O_TOTALPRICE ,
                type DECIMAL as SUM_QTY SUM_QTY &quot;
     | combined 0
     | next

   stage S04 on all partitions :
     gbyAgg &quot; groupBy type VARCHAR as C_NAME C_NAME ,
                      type INTEGER as C_CUSTKEY C_CUSTKEY ,
                      type INTEGER as O_ORDERKEY O_ORDERKEY ,
                      type DATE as O_ORDERDATE O_ORDERDATE ,
                      type DECIMAL as O_TOTALPRICE O_TOTALPRICE
                      aggregates
                      type VARCHAR as C_NAME $K1 ,
                      type INTEGER as C_CUSTKEY $K2 ,
                      type INTEGER as O_ORDERKEY $K3 ,
                      type DATE as O_ORDERDATE $K4 ,
                      type DECIMAL as O_TOTALPRICE $K5 ,
                      type DECIMAL as SUM_QTY ) SUM_QTY sum  &quot;
     | combined 0
     | next

   stage S05 on all nodes :
     gbyAgg &quot; groupBy  type VARCHAR as C_NAME C_NAME ,
                       type INTEGER as C_CUSTKEY C_CUSTKEY ,
                       type INTEGER as O_ORDERKEY O_ORDERKEY ,
                       type DATE as O_ORDERDATE O_ORDERDATE ,
                       type DECIMAL as O_TOTALPRICE O_TOTALPRICE
                       aggregates
                       type VARCHAR as C_NAME $K1 ,
                       type INTEGER as C_CUSTKEY $K2 ,
                       type INTEGER as O_ORDERKEY $K3 ,
                       type DATE as O_ORDERDATE $K4 ,
                       type DECIMAL as O_TOTALPRICE $K5 ,
                       type DECIMAL as SUM_QTY ) SUM_QTY sum  &quot;
     | combined 0
     | next

   stage S06 on origin :
     gbyAgg &quot; groupBy  type VARCHAR as C_NAME C_NAME ,
                       type INTEGER as C_CUSTKEY C_CUSTKEY ,
                       type INTEGER as O_ORDERKEY O_ORDERKEY ,
                       type DATE as O_ORDERDATE O_ORDERDATE ,
                       type DECIMAL as O_TOTALPRICE O_TOTALPRICE
                       aggregates
                       type VARCHAR as C_NAME $K1 ,
                       type INTEGER as C_CUSTKEY $K2 ,
                       type INTEGER as O_ORDERKEY $K3 ,
                       type DATE as O_ORDERDATE $K4 ,
                       type DECIMAL as O_TOTALPRICE $K5 ,
                       type DECIMAL as SUM_QTY ) SUM_QTY sum  &quot;
     | combined 0
     | next

   stage S07 on origin :
     sort &quot; type DECIMAL as O_TOTALPRICE O_TOTALPRICE DESC  , type DATE as O_ORDERDATE O_ORDERDATE ASC  &quot;
     | limit 100
     | combined 0
     | next

   stage S08 on origin :
     output
     | sink
     | first
 end ;</stringProp>
