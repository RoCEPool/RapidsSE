              <stringProp name="query">pipeline Query15
 begin
   stage S01 on origin :
     start
     | pulse once
     | next

   stage S02 on all partitions :
     indexScan lineitem IxL_SHIPDATE &quot;LBOUND $I1 DATE &apos;1996-01-01&apos; &gt;= UBOUND $I1 DATE &apos;1996-04-01&apos; &lt;&quot;
     | gbyAgg &quot; groupBy    type INTEGER as l_suppkey $3
                aggregates type INTEGER $K1 ,
                           type DECIMAL )  $6 1.00  $7 -  *  sum  &quot;
     | combined 0
     | next

   stage S03 on all nodes :
     gbyAgg &quot; groupBy    type INTEGER as l_suppkey $1
              aggregates type INTEGER $K1 ,
                         type DECIMAL )  $2 sum  &quot;
     | combined 0
     | next

   stage S04 on origin :
     gbyAgg &quot; groupBy    type INTEGER as l_suppkey $1
              aggregates type INTEGER as supplier_no $K1 ,
                         type DECIMAL as TOTAL_REVENUE ) $2 sum  &quot;
     | combined 0
     | next

   stage S05 on origin :
     top &quot;TOP type DECIMAL $2&quot; 1
     | hash &quot;type INTEGER supplier_no&quot;
     | combined 0
     | next hashcast

   stage S06 on all partitions :
     indexJoin supplier IxS_SUPPKEY &quot;BOUND $I1 supplier_no ==&quot;
     | project &quot;type INTEGER as S_SUPPKEY J1_S_SUPPKEY ,
                type VARCHAR as S_NAME J1_S_NAME ,
                type VARCHAR as S_ADDRESS J1_S_ADDRESS ,
                type VARCHAR as S_PHONE J1_S_PHONE ,
                type DECIMAL TOTAL_REVENUE &quot;
     | combined 0
     | next

   stage S07 on origin :
     output
     | sink
     | first
 end ;</stringProp>
