                <stringProp name="dataSource">SEConnPool</stringProp>
                <stringProp name="query">/optimise_passthru
pipeline Query17
begin
  stage S00 on origin :
    start
    | pulse once
    | next

 stage S01 on all partitions :
     scan rapidsse public part
     | filter &quot; type BOOLEAN  P_BRAND &apos;Brand#23&apos;  ==  P_CONTAINER &apos;MED BAG&apos;  ==  and&quot;
     | project &quot;type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY&quot;
     | combined 0
     | next broadcast

  stage S02 on all partitions multiple threads 4:
    indexJoin lineitem IxL_PARTKEY &quot;bound $I1 P_PARTKEY ==&quot;
    | ordagg &quot; ordgroupBy type integer ( 19 ) P_PARTKEY
               aggregates type integer ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) )  L_QUANTITY sum  ,
                          type INTEGER ( 19 ) )  L_QUANTITY count  &quot;
    | combined 0
    | next

  stage S03 on all nodes :
    gbyAgg &quot; GroupBy    type integer ( 19 ) P_PARTKEY
             aggregates type integer ( 19 ) as P_PARTKEY $K1 ,
                        type DECIMAL ( 19  2 ) )  $2 sum  ,
                        type INTEGER ( 19 ) )  $3 sum  &quot;
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg &quot; GroupBy    type integer ( 19 ) P_PARTKEY
             aggregates type integer ( 19 ) as P_PARTKEY $K1 ,
                        type DECIMAL ( 19  2 ) )  $2 sum  ,
                        type INTEGER ( 19 ) )  $3 sum  &quot;
    | combined 0
    | next

  stage S05 on origin :
    project &quot; type integer ( 19 ) as P_PARTKEY P_PARTKEY ,
              type DECIMAL ( 19  2 ) as AV $2 $3 casttype DECIMAL ( 19  2 ) cast / 0.2 *&quot;
    | combined 0
    | next broadcast

  stage S06 on all partitions :
    indexJoin lineitem IxL_PARTKEY &quot;bound $I1 $1 ==&quot;
    | filter &quot; type BOOLEAN  L_QUANTITY AV &lt;  &quot;
    | aggreg &quot; type decimal ( 19  2 ) as avg_yearly ) L_EXTENDEDPRICE sum  &quot;
    | combined 0
    | next

  stage S07 on all nodes :
    aggreg &quot; type decimal ( 19  2 ) as avg_yearly ) $1 sum  &quot;
    | combined 0
    | next

  stage S08 on origin :
    aggreg &quot; type DECIMAL ( 19  2 ) as avg_yearly ) $1 sum &quot;
    | combined 0
    | next

  stage S09 on origin :
    project &quot; type DECIMAL ( 19  2 ) as avg_yearly $1 7.0 / &quot;
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;</stringProp>
