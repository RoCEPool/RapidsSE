                <stringProp name="query">/optimise_passthru
pipeline Query4
begin

  stage S00 on origin : 
      start
    | pulse     once
    | next

  stage S01 on all partitions : 
    scan      orders
    | project   &quot; type DATE ( 0 ) as O_ORDERDATE O_ORDERDATE
                , type VARCHAR ( 15 ) as O_ORDERPRIORITY O_ORDERPRIORITY
                , type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY &quot;
    | filter    &quot; type BOOLEAN O_ORDERDATE DATE &apos;1993-07-01&apos; &gt;= O_ORDERDATE DATE &apos;1993-10-01&apos;&lt; and &quot;
    | project   &quot; type VARCHAR ( 15 ) as C0_O_ORDERPRIORITY $2
                , type INTEGER ( 19 ) as C1_O_ORDERKEY $3 &quot;
    | hash      &quot;type INTEGER $2&quot;
    | dynamic
    | next      hashcast

  stage S02 on all partitions  multiple threads 4:
    keyExists lineitem IxL_ORDERKEY &quot; BOUND $I1 $2 == &quot; &quot; type BOOLEAN L_COMMITDATE L_RECEIPTDATE &lt; &quot;
    | project   &quot; type VARCHAR ( 15 ) as C0_O_ORDERPRIORITY $1 &quot;
    | gbyAgg    &quot; groupBy
                  type VARCHAR as C0_O_ORDERPRIORITY $1
                aggregates
                  type VARCHAR as C0_COL0 $K1
                , type INTEGER ( 19 ) as C1_COL1 ) countAll &quot;
    | dynamic
    | next      

  stage S03 on all nodes :
    gbyAgg    &quot; groupBy
                  type VARCHAR $1
                aggregates
                  type VARCHAR as C0_COL0 $K1
                , type INTEGER ( 19 ) as C1_COL1 ) $2 sum &quot;
    | dynamic
    | next      

  stage S04 on origin :
    gbyAgg    &quot; groupBy
                  type VARCHAR $1
                aggregates
                  type VARCHAR as C0_COL0 $K1
                , type INTEGER ( 19 ) as C1_order_count ) $2 sum &quot;
    | dynamic
    | next      

  stage S05 on origin :
      output
    | sink
    | first

end ;
</stringProp>
