#!/bin/bash

###########################################################
## Cluster Configuration:                                ##
## TPC-H Scale Factor 100, 1 Node hardware configuration ##
###########################################################

# A sample cluster config file.
# A cluster.config file can be created by hand (see note), or automatically
# via the installation wizard.
#
# Note: This file is a bash script expected to be sourced by other scripts.
#       As such it must be a syntactically valid bash script.


# Guard against direct execution
if [ "${BASH_SOURCE[0]}" -ef "$0" ]
then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

# The version number of this config so RapidsSE can determine the format of this file.
CONFIG_VERSION="3"
CONFIG_CREATED="2022-07-14T11:58:31"

# The prefix used for naming nodes, and the last sequence number used. This
# is important when nodes are dynamically added.
NODE_NAME_PREFIX="NODE"
NODE_SEQ_NUM=1

# This variable identifies the unique node names of each node in the cluster.
# These node names are used as suffixes in variables below to configure each of them.
declare -ga NODE_LIST
NODE_LIST=("NODE1")

# Definition of node NODE1
declare -gA NODE_CFG_NODE1
NODE_CFG_NODE1["name"]="NODE1"
NODE_CFG_NODE1["heartbeat_port"]="8888"
NODE_CFG_NODE1["heartbeat_address"]="239.255.2.1"
NODE_CFG_NODE1["host"]="host1"
NODE_CFG_NODE1["internal_port"]="5541"
NODE_CFG_NODE1["client_port"]="9123"
NODE_CFG_NODE1["dir"]="/opt/rapidsse"
NODE_CFG_NODE1["disk_paths"]="/mnt/disk1/seData:/mnt/disk2/seData"
NODE_CFG_NODE1["clusterid"]="2223687"
NODE_CFG_NODE1["mem"]="480"
NODE_CFG_NODE1["partitions"]="4"
NODE_CFG_NODE1["threads"]="64"
NODE_CFG_NODE1["params"]="--verbose"

