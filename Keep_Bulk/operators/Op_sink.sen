/*============================================================================*/
/* op_sink.sen -- sink operator                                                */
/*============================================================================*/

" op_sink.sen" .verbose

/*----------------------------------------------------------------------------*/
/* sink the plan                                                              */
/*----------------------------------------------------------------------------*/
: sinkPlan ( pSession profile plan -- )

  // record the plan and profile
  locals| thePlan profile pSession |

  thePlan planList::removePlan

  //"sinking plan" .
  thePlan plan.delete

  //"removed & deleted plan" .
  //planList::show
;

/*----------------------------------------------------------------------------*/
/* sink operator loop                                                         */
/*----------------------------------------------------------------------------*/
: sinkOp operator ( -- NEVER )

  begin

    depth 0 != if "stack of task has grown" . debug::trap then

    // wait for next job
    //jobQueue> ( valset )

    // unpack it
    valset> ( profile planId nValues )
    drop ( profile planId )

    // find plan using planId
    planList::findPlan ( pSession profile plan true )
    assert ( pSession profile plan )

    // sink the plan
    sinkPlan ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
