/*============================================================================*/
/* job_Prompt.sen -- Job Prompt                                               */
/*============================================================================*/

" job_Prompt.sen" .verbose

/*----------------------------------------------------------------------------*/
/* run the prompt                                                             */
/*----------------------------------------------------------------------------*/
: prompt_run ( -- <R> )

  <SEED_RUN>

  0 locals| pPrompt |
  0 locals| pSession |
  0 locals| pCommandProcessor |
  0 locals| eCommand |
  0 locals| pJob |

  prompt::new to pPrompt

  pPrompt prompt.session to pSession
  pSession session.commandProcessor to pCommandProcessor

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin pPrompt prompt.continue while

    // get the next command
    pCommandProcessor commandProcessor.getCommand

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // non-job possibilities

    // check for blank line
    pCommandProcessor commandProcessor.blankLine if
      //"A blank line" .
      ifAgain
    then

    // possible prompt function
    pPrompt prompt.executeFunction if
      //"A prompt function" .
      ifAgain
    then

    // possible command file
    pCommandProcessor commandProcessor.executeFile if
      //"A file executed" .
      ifAgain
    then

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // possible job

    // is this a know job class?
    pCommandProcessor commandProcessor.findJobClass not if
      "error: Unknown command" .
      ifAgain
    then

    // create the job for the command
    pSession pCommandProcessor commandProcessor.preJob to pJob

    // test for error
    pJob job.hasError if
      //"job has error (maybe syntax error)" .
      pSession pCommandProcessor commandProcessor.postJob
      pSession pCommandProcessor commandProcessor.deleteJob
      ifAgain
    then

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // known valid job

    // grab this prompt task's lock
    task::this task.grabLock

    // set 1 ack required from the job
    1 setAcks

    // spawn the job
    pSession pCommandProcessor commandProcessor.spawnJob

    // wait for ack from job
    "prompt waiting for ack" .
    ackWait

    // post process and delete the job
    pSession pCommandProcessor commandProcessor.postJob
    pSession pCommandProcessor commandProcessor.deleteJob

  repeat
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

