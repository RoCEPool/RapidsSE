/*============================================================================*/
/* job_Monitor.sen -- Monitor Job                                             */
/*============================================================================*/

" job_Monitor.sen" .verbose

/*----------------------------------------------------------------------------*/
/* write portrait of system to output                                         */
/*----------------------------------------------------------------------------*/
: Monitor_process ( pJob_Monitor -- )

  params| pJob_Monitor |

  pJob_Monitor job_monitor.begin not if exit then

  begin pJob_Monitor job_monitor.take while repeat

  pJob_Monitor job_monitor.end
;

/*----------------------------------------------------------------------------*/
/* Job_Monitor request (on command node)                                      */
/*----------------------------------------------------------------------------*/
: Monitor_req (  -- <R> )

  >>logEntry <SEED_REQ2>

  job::this locals| pJob_Monitor |

  pJob_Monitor Monitor_process

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
