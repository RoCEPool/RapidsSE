/*============================================================================*/
/* job_SubInflate.sen -- Job SubInflate                                       */
/*============================================================================*/

" job_SubFetch.sen" .verbose

/*----------------------------------------------------------------------------*/
/* SubInflate (on originating node)                                           */
/*----------------------------------------------------------------------------*/
: SubInflate_run ( -- <R> )

  >>logEntry <SEED_RUN2>

  0 0 0 locals| pTask pJob_SubInflate pJob_InflateRows |

  tp: SubFetch
  //"SubFetch_run" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_SubInflate

  // get inflate job
  pJob_SubInflate job_SubInflate.jobInflateRows@ to pJob_InflateRows

  pJob_InflateRows job.task@ locals| pTask_FetchRows |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for acks to be set in the fetch task
  begin
    pTask_FetchRows task.IsAckSet
  not while
    1 thread::sleepMsec
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  //DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop fetch buffers from queue and inflate them
  pJob_SubInflate job_subInflate.inflateRows

  //DdlLock[].testDrop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // notify the fetch job
  pTask_FetchRows task.grabLock
  pTask_FetchRows task.dropLock
  pTask_FetchRows task.ack

  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
