/*============================================================================*/
/* job_StopOp.sen -- Job StopOp                                                 */
/*============================================================================*/

" job_StopOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for stopOp request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: stopOp_req ( -- )

  >>logEntry <SEED_REQ>

  // link stopOp to startOp
  <startOps>  Op.linkStartOp

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_STOPMARKER of
        "Operand:- ZK_STOPMARKER" .verbose
        Operand[].pipeOut
        false
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: stopOp :: stopOp <startOps> ;

jobInfo: stopOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_STOPOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
