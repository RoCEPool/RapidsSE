/*============================================================================*/
/* job_Alarm.sen -- alarm job                                                 */
/*============================================================================*/

" job_Alarm.sen" .verbose

/*----------------------------------------------------------------------------*/
/* alarm loop:                                                                */
/*----------------------------------------------------------------------------*/
: alarm_req ( -- )

  std_entryHook

  "Alarm Job Started" .

  begin

    "Alarm Job" .

    handler::serviceSleepQueue

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard

;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: alarm :: alarm ;

: alarm _info tags{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_NONE
  <ddlLock>  = DL_NONE
  
  //<preCheck> = bClusterStarted
  
  <cmdKind>  = CK_SERVICE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
