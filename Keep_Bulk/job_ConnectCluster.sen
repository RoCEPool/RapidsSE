/*============================================================================*/
/* job_ConnectCluster.sen -- Job Connect Cluster                              */
/*============================================================================*/

" job_ConnectCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::connected ( -- t|f )

  grid::definedNodes 0
  do
    I grid::node node.isConnected not if
    args.verbose if
      I "Node no %v not connected" .printf
    then
      unloop
      false
      exit
    then
  loop

  "All nodes connected" .verbose

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::pause ( -- )

  begin
    grid::connected not
  while
    100 thread::sleepMsec
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridConnected prompt ( -- )

  "gridConnected" .

  grid::pause
  true grid::started!
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridTest

  grid::definedNodes 0
  do
    I grid::node node.isConnected
    I "gridTest: node no %v connected %v " .printf
  loop
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridWait

  grid::pause
;

/*----------------------------------------------------------------------------*/
/* request to connect the cluster (on originating node)                       */
/*----------------------------------------------------------------------------*/
: connectCluster_req ( -- <R> )



  //"grid::setStartNode..." .
  grid::setStartNode

  //"connector::spawn..." .
  connector ;&

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::pause
;

/*----------------------------------------------------------------------------*/
/* execute job_ConnectCluster (on participating node)                         */
/*----------------------------------------------------------------------------*/
: connectCluster::execute _eeh ( -- )

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::pause

;


/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: connectCluster :: connectCluster ;

jobInfo: connectCluster
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_NONE
  <ddlLock>  = DL_NONE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

