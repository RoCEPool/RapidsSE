/*============================================================================*/
/* listerDrone.sen -- task lister drone                                       */
/*============================================================================*/

"listerDrone.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

taskCursor: pTaskCrs

/*----------------------------------------------------------------------------*/
/* spawn the lister drone                                                     */
/*----------------------------------------------------------------------------*/
: spawnListerDrone

  0 "listerLoop" "ListerDrone" TK_LISTER_DRONE spawnDroneActor drop
;

/*----------------------------------------------------------------------------*/
/* task list iteration                                                        */
/*----------------------------------------------------------------------------*/
: iterateTaskList

  listerDronePrint if
    "task list..." .
  then

  pTaskCrs pTaskCrs taskcursor.begin
          pTaskCrs taskcursor.first
  iterate

    listerDronePrint if
      object@ task.dump
    then

    cursor@ taskcursor.next object!

  next

  pTaskCrs taskcursor.end

;

/*----------------------------------------------------------------------------*/
/* lister drone loop                                                          */
/*----------------------------------------------------------------------------*/
: listerLoop

  listerDronePrint if
    task::this task.name@ " running..." str.cat .
  then

  begin

    iterateTaskList

    3 thread.sleep_s

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
