*/


  // create a temporary index buffer for the results
  //"Creating a tempIndexBuffer" .
  iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

  // position in the first index buffer
  iPartitionNo pIndex index.positionFirst
  to indexBuffer

  // get the first entry in the buffer
  indexBuffer entryBuffer.firstEntry
  to entry

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    //"Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    //"Appending last tempEntryBuffer to buffer queue" .
    tempEntryBuffer pBufferQueue queue.append

    // mark that a fetch task has ended
    pSeitf if
      pSeitf seitf.fetchTaskEnded
    then

    //pp: endScanSelectTask
    //"select ended...B" .

    //performancePrint

    exit
  then


  // iterate thru the buffer till no more entries
  begin
  entry
  while
      // insert row from entry in tempEntryBuffer
      //"Inserting row into tempEntryBuffer" .
      pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        //"Inserting row into tempEntryBuffer" .
        tempEntryBuffer pBufferQueue queue.append

        // create another temporary index buffer for the results
        //"Creating a tempIndexBuffer" .
        iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

        // insert row from entry in temporary buffer
        //"Inserting row into tempEntryBuffer" .
        pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry indexBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current indexBuffer
        indexBuffer entryBuffer.nextBuffer to indexBuffer

        indexBuffer if
          entry indexBuffer entryBuffer.nextEntry to entry
        then
      else
        // there is an entry
        // check if seitf exiting
        pSeitf seitf.isExiting if
          0 to entry
        then
      then

      // yield
      //pp: yieldScanSelectTask
      //task.yield
      //pp: yieldDoneScanSelectTask
    repeat

  // mark this buffer as the last buffer
  //"Marking tempEntryBuffer as last buffer" .
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  //"Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer pBufferQueue queue.append

  // mark that a fetch task has ended
  pSeitf if
    pSeitf seitf.fetchTaskEnded
  then

  //pp: endScanSelectTask
  //"select ended...A" .

  //performancePrint
 
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: scanSelectIdxTask ( i_Phrase pPlanner <"key>" "<lower>" "<upper>" pBufferQueue pIndex pSeitf iPartitionNo -- )

  locals| iPartitionNo pSeitf pIndex pBufferQueue upper lower key pPlanner i_Phrase |
  0 0 0 0 locals| count entry tempEntryBuffer indexBuffer |

  tp: scanSelectIdxTask

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  pSeitf task::this task.seitf!

  // now scan the index
  pBufferQueue iPartitionNo pIndex index.scan
;

/*----------------------------------------------------------------------------*/
/* set isUnique property of index                                             */
/*----------------------------------------------------------------------------*/
: setIndexIsUnique allParticipants 2 checkResult ( "<indexNm>" true/false -- )

  assert::stack_2

  locals| sIndexNm bIsUnique |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  bIsUnique ( bIsUnique )

  sIndexNm find execute ( bIsUnique index^ )

  index.isUnique! ( )

  assert::stack_0

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* get size of index                                                          */
/*----------------------------------------------------------------------------*/
: sizeIndex ( "<indexNm>" -- "<size>" )

  find execute ( index^ )

  index.space 0 swap number.magnitude >str
;

/*----------------------------------------------------------------------------*/
/* select using index (called by fetchRowsIndex_req)                          */
/*----------------------------------------------------------------------------*/
: spawnSelectTask ( i_Phrase pPlanner "<sExactKey>" "<sLowerKey>" "<sUpperKey>"
"<sSelectTaskSeed>" "<sIndexNm>" pBufferQueue iSlot --  )

  //debug::trap

  // task is a request server
  //task::this task.kind@ TK_REQUEST_SERVER == assert
  //task::this task.thread thread.actorModel@ AC_SERVER == assert

  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //   and the seitf will have an index
  //   and the seitf will have a bufferQueue
  //
  //assert::stack_5

  // save args
  locals| iSlot pBufferQueue sIndexNm sSelectTaskSeed sUpperKey sLowerKey sExactKey pPlanner i_Phrase |

  // local variables
  0 0 0 0 0 0 0 locals| pIndex iSlots pSeitf pSelectTask nRowCount pIndexBuffer pEntry |

  // increment query count
  queryCount ++

  task::this task.seitf@ to pSeitf

  // push into indexes folder
  pushIndexes assert

  // find the index and put it in the seitf
  sIndexNm find execute to pIndex
  pSeitf if
    pIndex pSeitf seitf.index!
  then

  // pop indexes
  popIndexes

  //args.metadata if
  //  metadata@ "metadata: %v\n" str.format .put
  //then

  // create the buffer queue in the seitf
  //"selectTask.queue" queue::new pSeitf seitf.bufferQueue!

  // set the queue in the seitf
  pSeitf if
    pBufferQueue pSeitf seitf.bufferQueue!
  then

  // create a selectTask to execute the key select on the index for the partition
  i_Phrase pPlanner sExactKey sLowerKey sUpperKey pBufferQueue pIndex pSeitf iSlot 9
  sSelectTaskSeed nullptr "selectTask" TK_SELECT_PART spawnServerTask
  to pSelectTask
;

/*----------------------------------------------------------------------------*/
/* remove an index                                                            */
/*----------------------------------------------------------------------------*/
: removeIndex allParticipants 1 checkResult ( "<indexNm>" -- true n# true )

  tp: removeIndex
  0 locals| pIndexPtr sIndexNm |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index from the table
  sIndexNm find execute to pIndexPtr
  pIndexPtr pIndexPtr index.table@ table.removeIndex

  // forward reference :-(
  sIndexNm "indexTidyUp" find execute

  sIndexNm :forget

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* upper bound select task (sen)                                              */
/*----------------------------------------------------------------------------*/
: upperSelectIdxTaskOLD ( i_Phrase pPlanner <"key>" "<lower>" "<upper>" pIndex pBufferQueue pSeitf partition -- )

  locals| iPartitionNo pSeitf pIndex pBufferQueue upper lower key pPlanner i_Phrase |
  0 0 0 0 locals| upperEntry entry tempEntryBuffer indexBuffer |

  tp: upperSelectIdxTask

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  pSeitf task::this task.seitf!
  //pSeitf seitf.index@ to pIndex

  // create a temporary index buffer for the results
  //"Creating a tempIndexBuffer" .
  iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

  // position in the first index buffer
  iPartitionNo pIndex index.positionFirst
  to indexBuffer

  // get the first entry in the buffer
  indexBuffer entryBuffer.firstEntry
  to entry

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    //"Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    //"Appending tempEntryBuffer to buffer queue" .
    tempEntryBuffer pBufferQueue queue.append

    // mark that a fetch task has ended
    pSeitf if
      pSeitf seitf.fetchTaskEnded
    then

    exit
  then

  // iterate thru the buffer till no more entries
  begin
  entry
  while

    // check against upper entry
    //upperEntry entry entry.same not if
    upper entry iPartitionNo pIndex i_Phrase pPlanner index.upper if
      
      // insert row from entry in tempEntryBuffer
      //"Inserting row into tempEntryBuffer" .
      pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        //"Inserting row into tempEntryBuffer" .
        tempEntryBuffer pBufferQueue queue.append

        // create another temporary index buffer for the results
        //"Creating a tempIndexBuffer" .
        iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

        // insert row from entry in temporary buffer
        //"Inserting row into tempEntryBuffer" .
        pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry indexBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current indexBuffer
        indexBuffer entryBuffer.nextBuffer to indexBuffer

        indexBuffer if
          entry indexBuffer entryBuffer.nextEntry to entry
        then
      then
    else
      // entry beyond upper, null the entry and break from loop
      0  to entry
    then
    // check if seitf exiting
    pSeitf seitf.isExiting if
      0 to entry
    then

    // yield
    //task.yield

  repeat

  //"Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  //"Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer pBufferQueue queue.append

  // mark that a fetch task has ended
  pSeitf if
    pSeitf seitf.fetchTaskEnded
  then
;

/*----------------------------------------------------------------------------*/
/* upper bound select task (c++)                                              */
/*----------------------------------------------------------------------------*/
: upperSelectIdxTask ( i_Phrase pPlanner <"key>" "<lower>" "<upper>" pBufferQueue pIndex pSeitf partition -- )
  locals| iPartitionNo pSeitf pIndex pBufferQueue upper lower key pPlanner i_Phrase |
  0 0 0 locals| entry tempEntryBuffer indexBuffer |

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  pSeitf task::this task.seitf!

  // iterate thru the index and fetch lower bound rows
  upper i_Phrase pPlanner pBufferQueue iPartitionNo pIndex index.upperBound
;


/*----------------------------------------------------------------------------*/
/* verify an index of a table                                                 */
/*----------------------------------------------------------------------------*/
: verifyIndex allParticipants 1 returnResult ( "<indexNm>" -- true n# true )

  tp: verifyIndex

  find execute
  index.verify

  <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

/*----------------------------------------------------------------------------*/
/* fetch rows from buffers from teh buffer queue of the seitf                 */
/*----------------------------------------------------------------------------*/
: groupByQueueBufferRows ( -- )

  0 0 0 0 0 0 0 locals| iSlots nRowCount pIndex pIndexBuffer pSeitf pGroupBy pPartialGroupBy |

  // get the seitf of the task
  task::this task.seitf@ to pSeitf

  // get index
  pSeitf seitf.index@ to pIndex

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  groupBy::new locals| pGroupBy |
  pGroupBy groupBy.start

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  // get slots
  grid.slots to iSlots

  1
  begin
  while

    // attempt to pop buffer off the tasks buffer queue
    pSeitf seitf.bufferQueue@ popBuffer to pIndexBuffer

    // print the rows from the index buffer
    pIndex pIndexBuffer printRows nRowCount + to nRowCount

    // check if last buffer
    pIndexBuffer entryBuffer.isLast@ if

      //"Reached last buffer" .
      iSlots 1 - to iSlots
      0 iSlots == if
        0
      else
        1
      then
    else
      1  // no more entries, move to next buffer
    then

    pIndexBuffer entryBuffer.delete
    //"Deleted buffer" .

  repeat

  // delete the buffer queue from the seitf
  pSeitf seitf.bufferQueue@ queue.delete
  0 pSeitf seitf.bufferQueue!

  args.metadata if
    nRowCount pSeitf seitf.rowsProcessed
  else
    "rows selected"  nRowCount "%v %v\n" str.format .put
  then

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +
  grid.slots 0
  do
    I pSeitf seitf.groupBy@ to pPartialGroupBy
    pPartialGroupBy pGroupby groupBy.applyPartial
    pPartialGroupBy groupBy.delete
  loop
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  // delete groupBy
  pGroupBy groupBy.end
  pGroupBy groupBy.delete

;

/*----------------------------------------------------------------------------*/
/* select using index (called by fetchRowsIndex_req) -- groupBy               */
/*----------------------------------------------------------------------------*/
: spawnGroupByTask ( "<sExactKey>" "<sLowerKey>" "<sUpperKey>"
                   "<sSelectTaskSeed>" "<sIndexNm>" --  )

  tp: selectIndex

  //debug::trap

  // task is a request server
  task::this task.kind@ TK_REQUEST_SERVER == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //
  //assert::stack_5

  // save args
  locals| sIndexNm sSelectTaskSeed sUpperKey sLowerKey sExactKey |

  // local variables
  0 0 0 0 0 0 0 locals| iSlots pSeitf pSelectTask nRowCount pIndexBuffer pEntry pIndex |

  // increment query count
  queryCount ++

  // push into indexes folder
  pushIndexes assert

  // find the index
  sIndexNm find execute to pIndex

  // find the index andput it in the seitf
  task::this task.seitf@ to pSeitf
  pIndex pSeitf seitf.index!

  // pop indexes
  popIndexes

  args.metadata if
    metadata@ "metadata: %v\n" str.format .put
  then

  // create the buffer queue in the seitf
  "selectTask.queue" queue::new pSeitf seitf.bufferQueue!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // for each slot
  grid.slots to iSlots
  iSlots 0
  do

    args.metadata not if
      I grid::toPartition "Partition: %v\n" str.format .put
    then

    // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +
    I groupBy::new pSeitf seitf.groupBy!
    // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

    // create a selectTask to execute the key select on the index for the partition
    sExactKey sLowerKey sUpperKey pSeitf I 5
    sSelectTaskSeed nullptr "selectTask" TK_SELECT_PART spawnServerTask
    to pSelectTask

  loop
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: groupByIdxTask_RH ( i_Phrase pPlanner <"key>" "<lower>" "<upper>" pIndex pBufferQueue pSeitf iPartitionNo -- )

  // save args
  locals| iPartitionNo pSeitf pIndex pBufferQueue sUpper sLower sKey pPlanner i_Phrase |

  // local variables
  0 0 0 0 locals| pUpperEntry pIndexEntry pIndexBuffer pResultBuffer |

  tp: rangeSelectIdxTask

  //debug::trap

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  // save seitf into this task
  pSeitf task::this task.seitf!
  //pSeitf seitf.index@ to pIndex

  // start groupBy operator for this partition
  iPartitionNo pSeitf seitf.groupBy@ locals| pGroupBy |
  pGroupBy groupBy.start

  // create a temporary buffer for the results
  iPartitionNo pIndex entryBuffer::create to pResultBuffer

  iPartitionNo pIndex index.positionFirst to pIndexBuffer
  pIndexBuffer entryBuffer.firstEntry to pIndexEntry

  // did we find an entry ?
  pIndexEntry not if

    // mark this result buffer as the last buffer
    pResultBuffer entryBuffer.isLast!

    pResultBuffer pBufferQueue queue.append

    exit
  then

  pGroupby pIndexEntry pUpperEntry pIndexBuffer entryBuffer.iterate

  // mark this result buffer as the last buffer
  pResultBuffer entryBuffer.isLast!
  pResultBuffer pBufferQueue queue.append
;

