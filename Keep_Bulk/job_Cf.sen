/*============================================================================*/
/* job_Cf.sen -- Job Change Folder                                            */
/*============================================================================*/

" job_Cf.sen" .verbose

/*----------------------------------------------------------------------------*/
/* cf command request                                                         */
/*----------------------------------------------------------------------------*/
: cf_req ( -- <R> )

  >>logEntry <SEED_REQ2>

  0 0 0 0 locals| pCurrentFolder sFolderNm pJob_Cf pTask |

  tp: cf_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob_Cf

  // get the folderNm from the job
  //pJob_Cf job.folderName@ to sFolderNm
  <folderNm> to sFolderNm

  // set task's dictionary stack from path in job
  //pJob_Cf job.pushPath
  //task::dicStack.set


  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a ".." which will go up one folder

  // pop up one folder, but not into tenants
  sFolderNm ".." str.equal if
    pathCurrentFolder dic.name "tenants" str.equal not if pathDrop then
    savePath
    <<logExit <DONE_REQ>
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a "~" will pop folder path till it reaches /tenants

  // pop up to tenants
  sFolderNm "~" str.equal if
    begin pathCurrentFolder dic.name "tenants" str.equal not while pathDrop repeat
    savePath
    <<logExit <DONE_REQ>
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a "tenants" will clear folder path and set to /tenants

  // clear dic path and push tenants
  sFolderNm "tenants" str.equal if
    pathDropAll
    attachmap::tenants@ execute pathPush
    savePath
    <<logExit <DONE_REQ>
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // otherwise we expect a name of a sub-folder to which we push path to
  //  push sub-folder

  sFolderNm findInCurrent to pCurrentFolder
  pCurrentFolder checkIsDic not if pJob_Cf <ERROR_REQUEST> !!logError exit then
  pCurrentFolder execute pathPush
  savePath
  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
