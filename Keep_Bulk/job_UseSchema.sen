/*============================================================================*/
/* job_UseSchema.sen -- Job Use Schema                                        */
/*============================================================================*/

" job_UseSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* use given schema                                                           */
/*----------------------------------------------------------------------------*/
: useSchema ( job_UseSchema --  )

  params| pJob_UseSchema |


  // pop path till we get to tenants
  begin
    folder[] dic.name@ "tenants" str.equal not while path[].discardFolder
  repeat

  // find the boray folder
  "boray" folder[].findSymbol
  execute path[].pushFolder

  // find the catalogs folder
  "catalogs" folder[].findSymbol
  execute path[].pushFolder

  // find the rapidssecatalogs folder
  "rapidsse" folder[].findSymbol
  execute path[].pushFolder

  // find the schemas folder
  "schemas" folder[].findSymbol
  execute path[].pushFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get schema name from job
  //pJob_UseSchema job.schemaName@ to sSchemaNm

  <schemaNm> word::isKnown not if EC_NO_SUCH_SCHEMA pJob_UseSchema ERROR_JOB !!logError exit then

  path[].checkIsSchema not if pJob_UseSchema ERROR_JOB !!logError exit then
  execute path[].pushFolder

  // find the tables folder
  "tables" folder[].findSymbol
  execute path[].pushFolder

  // save the path
  setPath
;

/*----------------------------------------------------------------------------*/
/* Use Schema request (on the originating node)                               */
/*----------------------------------------------------------------------------*/
: useSchema_req ( -- <R> )

  LogEntry SEED_REQ

  0 0 0 locals| sSchemaNm pJob_UseSchema pTask |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task[] to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_UseSchema

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // use schema
  pJob_UseSchema useSchema

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  LogExit DONE_REQ
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: useSchema :: use schema <schemaNm> ;

jobInfo: useSchema
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_JOB_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

