--------------------------------------------------------------------------------
-- query6 tests
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// create table lineitem
create table LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

load lineitem "../DATA/TPCH/lineitem_100k.csv";
success

//------------------------------------------------------------------------------------
select SUM(L_LINENUMBER) from lineitem;
rows:
  (300364)

//------------------------------------------------------------------------------------
select MIN(L_EXTENDEDPRICE) from lineitem;
rows:
  (926.00)

//------------------------------------------------------------------------------------
select MAX(L_EXTENDEDPRICE) from lineitem;
rows:
  (104899.50)

//------------------------------------------------------------------------------------
select SUM(L_SUPPKEY) from lineitem;
rows:
  (501274869)

//------------------------------------------------------------------------------------
select MIN(L_SUPPKEY) from lineitem;
rows:
  (1)

//------------------------------------------------------------------------------------
select MIN(L_PARTKEY) from lineitem;
rows:
  (2)

//
//------------------------------------------------------------------------------------
select -SUM(L_LINENUMBER) / 66 from lineitem;
rows:
  (-4550)

//------------------------------------------------------------------------------------
select MIN(L_EXTENDEDPRICE + 1) * 1 from lineitem;
rows:
  (927.00)

//------------------------------------------------------------------------------------
select MAX(L_EXTENDEDPRICE) * 33 * (-12) from lineitem;
rows:
  (-41540202.00)

/*
//------------------------------------------------------------------------------------
select SUM(L_SUPPKEY) + MIN(L_EXTENDEDPRICE) from lineitem;
rows:
  (501275795.00)

//------------------------------------------------------------------------------------
select MIN(L_SUPPKEY) * MIN(L_PARTKEY) - MAX(L_PARTKEY) from lineitem;
rows:
  (-199998)

//------------------------------------------------------------------------------------
select MIN(L_PARTKEY) / MAX(L_EXTENDEDPRICE) from lineitem;
rows:
  (0.0000)
*/

drop table lineitem;
mute

memoryleaks;
rows: 0

CLEANUP {

  drop table lineitem;
  mute

  bye;
  mute
}