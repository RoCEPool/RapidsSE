
trackMemory;
success

//------------------------------------------------------------------------------
// create table
create table datums (
int_col0   INTEGER,
int_col1  INTEGER,
bol_col2   BOOLEAN,
bol_col3   BOOLEAN,
dte_col4   DATE,
dte_col5   DATE,
dec_col6   DECIMAL(19,2),
dec_col7   DECIMAL(19,2),
flt_col8   FLOAT,
flt_col9  FLOAT,
tme_col10  TIME,
tme_col11  TIME,
tsp_col12  TIMESTAMP,
tsp_col13  TIMESTAMP,
vch_col14  VARCHAR(32),
vch_col15  VARCHAR(32)
);
success

load datums "../DATA/Transliterate/timestamp.csv" ;
success

//--------------------------MIN/MAX INT TESTS---------------------------------------
select MAX(int_col1) from datums;
rows:
(10000)

//------------------------------------------------------------------------------
select MAX(3) from datums;
rows:
(3)

//------------------------------------------------------------------------------
select 3 * MAX(int_col1) from datums;
rows:
(30000)

//------------------------------------------------------------------------------
select MAX(int_col1 + 2) from datums;
rows:
(10002)

//------------------------------------------------------------------------------
select MAX(int_col1) + 2 from datums;
rows:
(10002)

//------------------------------------------------------------------------------
select 44 * (MAX(int_col1) - 22) / 12 from datums;
rows:
(36586)

//------------------------------------------------------------------------------
select MIN(int_col1) from datums;
rows:
(0)

//------------------------------------------------------------------------------
select MIN(3) from datums;
rows:
(3)

//------------------------------------------------------------------------------
select 3 * MIN(int_col1) from datums;
rows:
(0)

//------------------------------------------------------------------------------
select MIN(int_col1 + 2) from datums;
rows:
(2)

//------------------------------------------------------------------------------
select MIN(int_col1) + 2 from datums;
rows:
(2)

//------------------------------------------------------------------------------
select MIN(int_col1 +30 ) * 22 + 2 from datums;
rows:
(662)

//------------------------------------------------------------------------------
select 44 * (MIN(int_col1) - 22) / 12 from datums;
rows:
(-80)

//--------------------------MIN/MAX DECIMAL TESTS---------------------------------
select MAX(dec_col7) from datums;
rows:
(1041.04)

/*
//------------------------------------------------------------------------------
select 3.2 * MAX(dec_col7) from datums;
rows:
(3331.328)

//------------------------------------------------------------------------------
select MAX(dec_col7 + 2.2) from datums;
rows:
(1043.24)

//------------------------------------------------------------------------------
select MAX(dec_col7) + 2.4 from datums;
rows:
(1043.44)

//------------------------------------------------------------------------------
select 44.01 * (MAX(dec_col7) - 22.1) / 12.55 from datums;
rows:
(3573.1911872509960159)
*/

//------------------------------------------------------------------------------
select MIN(dec_col7) from datums;
rows:
(10.04)

//--------------------------MIN/MAX FLOAT TESTS---------------------------------
select MAX(flt_col9) from datums;
rows:
(108.456)

//------------------------------------------------------------------------------
select 3 * MAX(flt_col9) from datums;
rows:
(325.368)

//------------------------------------------------------------------------------
select MAX(flt_col9 + 2) from datums;
rows:
(110.456)

//------------------------------------------------------------------------------
select MIN(flt_col9) from datums;
rows:
(31.456)

//------------------------------------------------------------------------------
select MIN(flt_col9) + 2 from datums;
rows:
(33.456)

//--------------------------MIN/MAX DATE TESTS---------------------------------
select MAX(dte_col5) from datums;
rows:
(DATE '1947-01-01')

//------------------------------------------------------------------------------
select MAX(DATE '2068-10-20') from datums;
rows:
(DATE '2068-10-20')

//------------------------------------------------------------------------------
select MIN(dte_col4) from datums;
rows:
(DATE '1941-01-01')

//------------------------------------------------------------------------------
select MIN(DATE '1941-01-01') from datums;
rows:
(DATE '1941-01-01')

//--------------------------MIN/MAX TIME TESTS---------------------------------
select MAX(tme_col10) from datums;
rows:
(TIME '11:23:31')

//------------------------------------------------------------------------------
select MIN(tme_col10) from datums;
rows:
(TIME '10:23:31')

//--------------------------MIN/MAX TIMESTAMP TESTS---------------------------------
select MAX(tsp_col12) from datums;
rows:
(TIMESTAMP '1972-01-01 12:00:59')

//------------------------------------------------------------------------------
select MIN(tsp_col12) from datums;
rows:
(TIMESTAMP '1941-01-01 00:00:00')

//--------------------------MIN/MAX VARCHAR TESTS---------------------------------
select MAX(vch_col14) from datums;
rows:
('x')

//------------------------------------------------------------------------------
select MIN(vch_col14) from datums;
rows:
('124')

//------------------------------------------------------------------------------
// drop the table
drop table datums;
success;

memoryleaks;
rows: 0

CLEANUP {

  drop table datums;
  mute

  bye;
  mute
}




































