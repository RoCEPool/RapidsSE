SELECT col1, col2, col3, col4, col5, col6, col7, col8 FROM t1
UNION ALL
SELECT col1, col2, col3, col4, col5, col6, col7, col8 FROM t2;
*/


SELECT * FROM t1
UNION ALL CORRESPONDING
SELECT * FROM t2;
