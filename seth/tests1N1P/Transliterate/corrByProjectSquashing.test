//  Project squashing into a post-ProjectOp
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
SELECT col1 as c1, COUNT(col3) FROM t1 GROUP BY c1 HAVING SUM(col2) > 0
UNION ALL CORRESPONDING
SELECT col1 as c1, COUNT(col3) FROM t2 GROUP BY col1 HAVING SUM(col2) > 0;
