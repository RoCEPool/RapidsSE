
//------------------------------------------------------------------------------
// create table
create table datums (
int_col0   INTEGER,
int_col1  INTEGER,
bol_col2   BOOLEAN,
bol_col3   BOOLEAN,
dte_col4   DATE,
dte_col5   DATE,
dec_col6   DECIMAL(19,2),
dec_col7   DECIMAL(19,2),
flt_col8   FLOAT,
flt_col9  FLOAT,
tme_col10  TIME,
tme_col11  TIME,
tsp_col12  TIMESTAMP,
tsp_col13  TIMESTAMP,
vch_col14  VARCHAR(32),
vch_col15  VARCHAR(32)
);
success

load datums "../DATA/Transliterate/groupBy.csv" ;
failure contains: '10 invalid'


//------------------------------------------------------------------------------------
select SUM(int_col1), int_col0 from datums GROUP BY int_col0;
rows:
(0,11)
(8000,9)
(null,3)
(5000,5)
(4000,4)
(0,10)
(5000,6)
(2000,2)
(7000,7)
(5000,1)
(8000,8)

