/*----------------------------------------------------------------------------*/
/* Aggregation syntax & semantics tests                                       */
/*                                                                            */
/* Tests the SQL parser/planner for legitimate SQL statements concerning      */
/* aggregations, grouping, HAVING, etc.                                       */
/*                                                                            */
/* We use EXPLAIN before the queries to avoid actually running these through  */
/* the execution engine.                                                      */
/*----------------------------------------------------------------------------*/

trackMemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

load nation "../DATA/Transliterate/nationAggGby.tbl";
success

SELECT n_nationkey, min(N_REGIONKEY) FROM nation GROUP BY n_nationkey;
rows:
  (0,0)
  (1,1)
  (2,1)
  (3,1)
  (4,2)
  (5,3)
  (6,2)
  (7,4)

SELECT n_nationkey, min(N_REGIONKEY), max(N_REGIONKEY) FROM nation GROUP BY n_nationkey;
rows:
  (0,0,0)
  (1,1,1)
  (2,1,2)
  (3,1,1)
  (4,2,4)
  (5,3,4)
  (6,2,4)
  (7,4,4)

SELECT n_nationkey, SUM(n_regionkey) FROM nation group by n_nationkey;
rows:
  (0,0)
  (1,1)
  (2,3)
  (3,2)
  (4,6)
  (5,7)
  (6,9)
  (7,4)

SELECT n_nationkey, 2*(n_nationkey + 1), SUM(n_regionkey) FROM nation GROUP BY n_nationkey;
rows:
  (0,2,0)
  (1,4,1)
  (2,6,3)
  (3,8,2)
  (4,10,6)
  (5,12,7)
  (6,14,9)
  (7,16,4)

SELECT n_nationkey, 3 + SUM(n_regionkey) FROM nation group by n_nationkey;
rows:
  (0,3)
  (1,4)
  (2,6)
  (3,5)
  (4,9)
  (5,10)
  (6,12)
  (7,7)

SELECT n_nationkey, SUM(n_regionkey) + 3 FROM nation group by n_nationkey;
rows:
  (0,3)
  (1,4)
  (2,6)
  (3,5)
  (4,9)
  (5,10)
  (6,12)
  (7,7)

SELECT n_nationkey, count(N_REGIONKEY) FROM nation GROUP BY n_nationkey;
rows:
  (0,2)
  (1,1)
  (2,2)
  (3,2)
  (4,2)
  (5,2)
  (6,3)
  (7,1)

SELECT n_nationkey, SUM(n_regionkey + 3) FROM nation group by n_nationkey;
rows:
  (0,6)
  (1,4)
  (2,9)
  (3,8)
  (4,12)
  (5,13)
  (6,18)
  (7,7)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

drop table nation;
success

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE nation;
  mute
}