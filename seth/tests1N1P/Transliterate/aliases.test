/*----------------------------------------------------------------------------*/
/* Alias syntax & semantic tests                                              */
/*----------------------------------------------------------------------------*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

-- Cannot enable memory tracking as there are memory leaks in the execution engine
--trackmemory;
--success

load nation "../DATA/Transliterate/nationAggGby.tbl";
success

create table nation2 (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

-- Cannot enable memory tracking as there are memory leaks in the execution engine
trackmemory;
success

load nation2 "../DATA/Transliterate/nationAggGby.tbl";
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Simple aliases
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Columns are named appropriately
-- With the AS keyword
SELECT n_nationkey AS nationkey, n_name AS name FROM nation;
rows:
  (0,'ALGERIA')
  (0,'ETHIOPIA')
  (1,'ARGENTINA')
  (2,'BRAZIL')
  (3,'CANADA')
  (3,'CANADA')
  (4,'EGYPT')
  (6,'FRANCE')
  (5,'GERMANY')
  (2,'INDIA')
  (6,'INDONESIA')
  (6,'IRAN')
  (5,'IRAQ')
  (4,'JAPAN')
  (7,'JORDAN')

-- Without the AS keyword
//SELECT n_nationkey nationkey, n_name name FROM nation;
SELECT n_nationkey nationkey, n_name AS name FROM nation;
rows:
  (0,'ALGERIA')
  (0,'ETHIOPIA')
  (1,'ARGENTINA')
  (2,'BRAZIL')
  (3,'CANADA')
  (3,'CANADA')
  (4,'EGYPT')
  (6,'FRANCE')
  (5,'GERMANY')
  (2,'INDIA')
  (6,'INDONESIA')
  (6,'IRAN')
  (5,'IRAQ')
  (4,'JAPAN')
  (7,'JORDAN')

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Aliases cannot be used below where they are defined in the plan
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

//Removed failure tests

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Aliases can be used above where they are defined in the plan
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- GROUP BY clause
SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region;
rows:
  (3,2)
  (4,4)
  (0,2)
  (2,3)
  (1,4)

-- HAVING clause
/*SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region
HAVING nationcount > 1;*/

SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region
HAVING COUNT(n_nationkey) > 1;
rows:
  (3,2)
  (4,4)
  (0,2)
  (2,3)
  (1,4)

/*SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region
HAVING region > 1;*/

SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY n_regionkey
HAVING n_regionkey > 1;
rows:
  (4,4)
  (3,2)
  (2,3)

/*
-- ORDER BY clause
-- Commented out until ORDER BY is supported in the execution engine
SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region
ORDER BY region;
failure contains: "order by currently not supported";
*/

SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region;
rows:
  (0,2)
  (1,4)
  (2,3)
  (3,2)
  (4,4)

SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region;
rows:
  (3,2)
  (0,2)
  (2,3)
  (4,4)
  (1,4)


-- UNION clause

SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount FROM nation GROUP BY n_regionkey
UNION ALL
SELECT n_regionkey, COUNT(n_nationkey) FROM nation2 GROUP BY n_regionkey;
rows:
  (3,2)
  (4,4)
  (0,2)
  (2,3)
  (1,4)
  (3,2)
  (4,4)
  (0,2)
  (2,3)
  (1,4)


-- ORDER BY above a UNION using an alias
SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount FROM nation GROUP BY n_regionkey
UNION ALL
SELECT n_regionkey, COUNT(n_nationkey) FROM nation2 GROUP BY n_regionkey
ORDER BY region;
rows:
  (0,2)
  (0,2)
  (1,4)
  (1,4)
  (2,3)
  (2,3)
  (3,2)
  (3,2)
  (4,4)
  (4,4)


SELECT n_regionkey, COUNT(n_nationkey) FROM nation GROUP BY n_regionkey
UNION ALL
SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount FROM nation2 GROUP BY n_regionkey;
rows:
  (3,2)
  (4,4)
  (0,2)
  (2,3)
  (1,4)
  (3,2)
  (4,4)
  (0,2)
  (2,3)
  (1,4)


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Aliases can be used in expressions too
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- An alias can be a subset of an expression
/*SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region
HAVING (2*nationcount) > 1;*/

SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY n_regionkey
HAVING (2 * COUNT(n_nationkey)) > 1;
rows:
  (3,2)
  (4,4)
  (0,2)
  (2,3)
  (1,4)

/*SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region
HAVING (nationcount + 1) > 1;*/

SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
FROM nation
GROUP BY region
HAVING (COUNT(n_nationkey) + 1) > 1;
rows:
  (3,2)
  (4,4)
  (0,2)
  (2,3)
  (1,4)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

//memoryleaks;
//rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE nation;
  mute
  DROP TABLE nation2;
  mute
}