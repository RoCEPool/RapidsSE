--------------------------------------------------------------------------------
-- tpch query16
--------------------------------------------------------------------------------

// NOTE: S05 hashcast not ok

/optimise_passthru
pipeline Query16
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public part
    | filter " type BOOLEAN  P_BRAND 'Brand#45' !=
              }  P_TYPE 'MEDIUM POLISHED%'  16 matchLeading not and
              }  49  14  23  45  19  3  36  9  #8  P_SIZE in and"
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
               type INTEGER ( 19 ) as P_SIZE P_SIZE"
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin PartSupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project "type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
               type INTEGER ( 19 ) as P_SIZE P_SIZE"
    | hash " type INTEGER ( 19 ) PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    keyNotExists SUPPLIER IxS_SUPPKEY  "BOUND $I1 PS_SUPPKEY =="
               "type BOOLEAN  }  S_COMMENT '%Customer%Complaints%'  8 10 matchMiddle1"
    | gbyAgg " GroupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                       type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                       type INTEGER ( 19 ) as P_SIZE P_SIZE ,
                       type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY
               aggregates
                       type VARCHAR ( 0 )  as P_BRAND $K1 ,
                       type VARCHAR ( 0 )  as P_TYPE $K2 ,
                       type INTEGER ( 19 )  as P_SIZE $K3 ,
                       type INTEGER ( 19 )  as PS_SUPPKEY $K4"

    | combined 0
    | next

  stage S04 on all nodes :
    gbyAgg " GroupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                     type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                     type INTEGER ( 19 ) as P_SIZE P_SIZE ,
                     type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY
             aggregates
                    type VARCHAR ( 0 )  as P_BRAND $K1 ,
                    type VARCHAR ( 0 )  as P_TYPE $K2 ,
                    type INTEGER ( 19 )  as P_SIZE $K3 ,
                    type INTEGER ( 19 )  as PS_SUPPKEY $K4 "
    | combined 0
    | next

  stage S05 on origin :
    gbyAgg " GroupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                     type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                     type INTEGER ( 19 ) as P_SIZE P_SIZE ,
                     type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY
             aggregates
                    type VARCHAR ( 0 )  as P_BRAND $K1 ,
                    type VARCHAR ( 0 )  as P_TYPE $K2 ,
                    type INTEGER ( 19 )  as P_SIZE $K3 ,
                    type INTEGER ( 19 )  as PS_SUPPKEY $K4 "
    | hash " type INTEGER ( 19 ) PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S06 on all partitions :
    gbyAgg " GroupBy  type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                       type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                       type INTEGER ( 19 ) as P_SIZE P_SIZE
                       aggregates
                       type VARCHAR ( 0 )  as P_BRAND $K1 ,
                       type VARCHAR ( 0 )  as P_TYPE $K2 ,
                       type INTEGER ( 19 )  as P_SIZE $K3 ,
                       type INTEGER ( 19 )  as supplier_cnt ) PS_SUPPKEY COUNT"
    | combined 0
    | next

  stage S07 on all nodes :
    gbyAgg " GroupBy type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                     type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                     type INTEGER ( 19 ) as P_SIZE P_SIZE
                     aggregates
                     type VARCHAR ( 0 )  as P_BRAND $K1 ,
                     type VARCHAR ( 0 )  as P_TYPE $K2 ,
                     type INTEGER ( 19 )  as P_SIZE $K3 ,
                     type INTEGER ( 19 )  as supplier_cnt ) supplier_cnt SUM"
    | combined 0
    | next

  stage S08 on origin :
    gbyAgg " GroupBy  type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
                      type VARCHAR ( 0 ) as P_TYPE P_TYPE ,
                      type INTEGER ( 19 ) as P_SIZE P_SIZE
                      aggregates
                      type VARCHAR ( 0 )  as P_BRAND $K1 ,
                      type VARCHAR ( 0 )  as P_TYPE $K2 ,
                      type INTEGER ( 19 )  as P_SIZE $K3 ,
                      type INTEGER ( 19 )  as supplier_cnt ) supplier_cnt SUM"
    | combined 0
    | next

  stage S09 on origin :
    sort " type INTEGER ( 19 ) $4 DESC  ,
           type VARCHAR ( 0 ) as P_BRAND P_BRAND ASC ,
           type VARCHAR ( 0 ) as P_TYPE P_TYPE ASC ,
           type INTEGER ( 19 ) as P_SIZE P_SIZE ASC "
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;
