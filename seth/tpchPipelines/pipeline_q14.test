--------------------------------------------------------------------------------
-- tpch query14
--------------------------------------------------------------------------------

/optimise_passthru
pipeline Query14
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    indexscan lineitem IxL_SHIPDATE "LBOUND DATE '1995-09-01' >= UBOUND DATE '1995-10-01' <"
    | project "type INTEGER as L_PARTKEY L_PARTKEY ,
               type DECIMAL as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL as L_DISCOUNT L_DISCOUNT"
    | hash "type INTEGER L_PARTKEY"
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    indexJoin part IxP_PARTKEY "bound $I1 L_PARTKEY =="
    | aggreg " type DECIMAL )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  ,
                type DECIMAL )  }  }  P_TYPE 'PROMO%'  6 matchLeading WHEN  L_EXTENDEDPRICE 1. L_DISCOUNT -  * THEN  0.  ELSE  ENDIF  CASE  sum  "
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg " type DECIMAL ) $1 sum  ,
              type DECIMAL ) $2 sum  "
    | combined 0
    | next

  stage S04 on origin :
    aggreg " type DECIMAL ) $1 sum  ,
              type DECIMAL ) $2 sum  "
    | combined 0
    | next

  stage S05 on origin :
    project " type DECIMAL as promo_revenue 100.00  $2 *  $1 /  "
    | combined 0
    | next

  stage S06 on origin :
    output
    | sink
    | first
end ;