--------------------------------------------------------------------------------
-- tpch query15
--------------------------------------------------------------------------------

// NOTE: S07 broadcast not ok
// PARAMETERS

/optimise_passthru
pipeline Query17
begin
  stage S00 on origin :
    start
    | pulse once
    | next

 stage S01 on all partitions :
     scan rapidsse public part
     | filter " type BOOLEAN  P_BRAND 'Brand#23'  ==  P_CONTAINER 'MED BAG'  ==  and"
     | project "type INTEGER as P_PARTKEY P_PARTKEY"
     | combined 0
     | next broadcast

  stage S02 on all partitions :
    indexJoin lineitem IxL_PARTKEY "bound $I1 P_PARTKEY =="
    //| ordagg " ordgroupBy type integer P_PARTKEY
    //           aggregates type integer as P_PARTKEY $K1 ,
    //                      type DECIMAL )  L_QUANTITY sum  ,
    //                      type INTEGER )  L_QUANTITY count  "
    | gbyagg " groupBy type integer P_PARTKEY
               aggregates type integer as P_PARTKEY $K1 ,
                          type DECIMAL )  L_QUANTITY sum  ,
                          type INTEGER )  L_QUANTITY count  "
    | combined 0
    | next

  stage S03 on all nodes :
    gbyAgg " GroupBy    type integer P_PARTKEY
             aggregates type integer as P_PARTKEY $K1 ,
                        type DECIMAL )  $2 sum  ,
                        type INTEGER )  $3 sum  "
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg " GroupBy    type integer P_PARTKEY
             aggregates type integer as P_PARTKEY $K1 ,
                        type DECIMAL )  $2 sum  ,
                        type INTEGER )  $3 sum  "
    | combined 0
    | next

  stage S05 on origin :
    project " type integer as P_PARTKEY P_PARTKEY ,
              type DECIMAL as AV $2 $3 casttype DECIMAL cast / 0.2 *"
    | combined 0
    | next broadcast

  stage S06 on all partitions :
    indexJoin lineitem IxL_PARTKEY "bound $I1 $1 =="
    | filter " type BOOLEAN  L_QUANTITY AV <  "
    | aggreg " type decimal as avg_yearly ) L_EXTENDEDPRICE sum  "
    | combined 0
    | next

  stage S07 on all nodes :
    aggreg " type decimal as avg_yearly ) $1 sum  "
    | combined 0
    | next

  stage S08 on origin :
    aggreg " type DECIMAL as avg_yearly ) $1 sum "
    | combined 0
    | next

  stage S09 on origin :
    project " type DECIMAL as avg_yearly $1 7.0 / "
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;