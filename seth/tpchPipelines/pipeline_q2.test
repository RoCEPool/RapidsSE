--------------------------------------------------------------------------------
-- tpch query2
--------------------------------------------------------------------------------

/optimise_passthru
pipeline Query2
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan part
    | filter " type BOOLEAN  }  P_TYPE '%STEEL'  6 matchTrailing P_SIZE 20 == and"
    | project " type INTEGER as P_PARTKEY P_PARTKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project " type INTEGER as P_PARTKEY P_PARTKEY ,
                type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST"
    | hash "type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER as S_NATIONKEY S_NATIONKEY "
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER as N_REGIONKEY N_REGIONKEY "
    | combined 0
    | next

  stage S05 on all partitions :
    indexJoin region IxR_REGIONKEY "BOUND $I1 N_REGIONKEY =="
    | filter " type BOOLEAN  R_NAME 'AFRICA'  == "
    | gbyAgg " GroupBy    type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST min "
    | combined 0
    | next

  stage S06 on all nodes :
     gbyAgg " GroupBy     type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min "
    | combined 0
    | next

  stage S07 on origin :
     gbyAgg " GroupBy    type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min "
    | hash "type INTEGER P_PARTKEY"
    | combined 0
    | next hashcast

  stage S08 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | filter "type BOOLEAN PS_SUPPLYCOST_MIN PS_SUPPLYCOST =="
    | project "type INTEGER as P_PARTKEY P_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY"
    | combined 0
    | next

  stage S09 on all partitions :
    indexJoin part IxP_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project " type INTEGER as P_PARTKEY P_PARTKEY ,
                type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                type VARCHAR as P_MFGR P_MFGR"
    | hash "type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S10 on all partitions :
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project " type INTEGER as S_NATIONKEY S_NATIONKEY ,
                type DECIMAL as S_ACCTBAL S_ACCTBAL ,
                type VARCHAR as S_NAME S_NAME ,
                type INTEGER as P_PARTKEY P_PARTKEY ,
                type VARCHAR as P_MFGR P_MFGR ,
                type VARCHAR as S_ADDRESS S_ADDRESS ,
                type VARCHAR as S_PHONE S_PHONE ,
                type VARCHAR as S_COMMENT S_COMMENT "
    | combined 0
    | next

  stage S11 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project " type DECIMAL as S_ACCTBAL S_ACCTBAL ,
                type VARCHAR as S_NAME S_NAME ,
                type VARCHAR as N_NAME N_NAME ,
                 type INTEGER as P_PARTKEY P_PARTKEY ,
                 type VARCHAR as P_MFGR P_MFGR ,
                 type VARCHAR as S_ADDRESS S_ADDRESS ,
                 type VARCHAR as S_PHONE S_PHONE ,
                 type VARCHAR as S_COMMENT S_COMMENT "
    | sort "type DECIMAL S_ACCTBAL ASC ,
            type VARCHAR N_NAME ASC ,
            type VARCHAR S_NAME ASC ,
            type INTEGER P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S12 on all nodes :
    sort "type DECIMAL S_ACCTBAL ASC ,
          type VARCHAR N_NAME ASC ,
          type VARCHAR S_NAME ASC ,
          type INTEGER P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S13 on origin :
    sort "type DECIMAL S_ACCTBAL ASC ,
          type VARCHAR N_NAME ASC ,
          type VARCHAR S_NAME ASC ,
          type INTEGER P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S14 on origin :
    output
    | sink
    | first
end ;