--------------------------------------------------------------------------------
-- create customer table
--------------------------------------------------------------------------------

// create a table
create table ${testName}_customer (
C_CUSTKEY       INTEGER NOT NULL,
C_NAME          VARCHAR(25) NOT NULL,
C_ADDRESS       VARCHAR(40) NOT NULL,
C_NATIONKEY     INTEGER NOT NULL,
C_PHONE         CHAR(15) NOT NULL,
C_ACCTBAL       DECIMAL(15,2) NOT NULL,
C_MKTSEGMENT    CHAR(10) NOT NULL,
C_COMMENT       VARCHAR(117) NOT NULL
);
success

//------------------------------------------------------------------------------
// create an index on custkey
create index IxC_CUSTKEY ON ${testName}_customer (C_CUSTKEY)  ;
affected: 0

//------------------------------------------------------------------------------
// create an index on nationkey
create index IxC_NATIONKEY ON ${testName}_customer (C_NATIONKEY)  ;
affected: 0

// load the table
load ${testName}_customer "../TPCH/SF_0001/customer.csv";
success

select count(*) from ${testName}_customer;
rows: (150)

compactidx ${testName}_customer IxC_CUSTKEY;
success

CLEANUP {

  bye;
  mute
}

