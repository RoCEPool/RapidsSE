/*============================================================================*/
/* oneWayJoins -- partitioning test                                           */
/*============================================================================*/

trackMemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// UNICAST
select count(*)
  from ${testName}_customer,
       ${testName}_orders
 where C_CUSTKEY  = O_CUSTKEY;
rows:
  (1500)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// HASHCAST
select count(*)
  from ${testName}_lineitem,
       ${testName}_orders
 where L_ORDERKEY  = O_ORDERKEY;
rows:
  (5996)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// BROADCAST
select count(*)
  from ${testName}_lineitem,
       ${testName}_partSupp
 where L_SUPPKEY  = PS_SUPPKEY;
rows:
 (576000)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
MemoryLeaks;
rows: 0

