// _r_FORM_A / _r_FOLD_10_F (Q7,8,9)
select count(*)
  from (select *
          from ${testName}_orders, ${testName}_lineitem
         where O_ORDERKEY = L_ORDERKEY)
;
rows:
 (5996)

select O_ORDERKEY, O_CUSTKEY
    from ( select O_ORDERKEY, O_CUSTKEY
             from ${testName}_orders
             join ${testName}_lineitem on O_ORDERKEY = L_ORDERKEY) as table1,
         ${testName}_customer
   where table1.O_CUSTKEY = ${testName}_customer.C_CUSTKEY
   and ${testName}_customer.C_CUSTKEY < 4
;

