select PS_PARTKEY,
       sum(ps_supplycost * ps_availqty) as value
  from ${testName}_partsupp, ${testName}_supplier
 where PS_SUPPKEY = S_SUPPKEY
 group by PS_PARTKEY
having sum(ps_supplycost * ps_availqty) >
         (select sum(ps_supplycost * ps_availqty) * 0.000001
            from ${testName}_partsupp, ${testName}_supplier
           where PS_SUPPKEY = S_SUPPKEY)
;
rows: 200


select PS_PARTKEY,
       sum(ps_supplycost * ps_availqty) as value
  from ${testName}_partsupp, ${testName}_supplier
 where PS_SUPPKEY = S_SUPPKEY
 group by PS_PARTKEY
having sum(ps_supplycost * ps_availqty) <=
         (select sum(ps_supplycost * ps_availqty) * 0.000001
            from ${testName}_partsupp, ${testName}_supplier
           where PS_SUPPKEY = S_SUPPKEY)
;
rows : 0

