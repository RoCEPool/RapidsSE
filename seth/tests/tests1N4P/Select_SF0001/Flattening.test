// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Subquery in having clause
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select l_orderkey, sum(l_quantity)
  from ${testName}_lineitem
  group by l_orderkey
  having sum(l_quantity) > (select avg(l_quantity)
                              from ${testName}_lineitem)
;
rows: 1496

select l_orderkey, sum(l_quantity)
  from ${testName}_lineitem
  group by l_orderkey
  having sum(l_quantity) < (select avg(l_quantity)
                              from ${testName}_lineitem)
;
rows:
 (330,21.00)
 (1040,22.00)
 (1339,20.00)
 (1432,16.00)

