// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Join + Project + Filter
select p_partkey, p_mfgr, ps_suppkey, ps_supplycost
  from Part,
       PartSupp
 where p_partkey  = ps_partkey
   and p_brand = 'Brand#44'
   and p_size < 10;
rows:
  (43,'Manufacturer#4',3,307.12)
  (43,'Manufacturer#4',3,493.65)
  (43,'Manufacturer#4',3,493.19)
  (43,'Manufacturer#4',3,805.78)
  (185,'Manufacturer#4',5,510.23)
  (185,'Manufacturer#4',5,426.74)
  (185,'Manufacturer#4',5,213.04)
  (185,'Manufacturer#4',5,538.58)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Join + Project + Filter
select ps_supplycost, p_mfgr, ps_suppkey, p_partkey
  from Part,
       PartSupp
 where p_partkey  = ps_partkey
   and p_brand = 'Brand#44'
   and p_size < 10;
rows:
  (307.12,'Manufacturer#4',3,43)
  (493.65,'Manufacturer#4',3,43)
  (493.19,'Manufacturer#4',3,43)
  (805.78,'Manufacturer#4',3,43)
  (510.23,'Manufacturer#4',5,185)
  (426.74,'Manufacturer#4',5,185)
  (213.04,'Manufacturer#4',5,185)
  (538.58,'Manufacturer#4',5,185)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Join + gbyAgg + Filter
select sum(ps_supplycost)
  from Part,
       PartSupp
 where p_partkey  = ps_partkey
   and p_brand = 'Brand#44'
   and p_size < 10;
rows:
  (3788.33)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Join + AggGby + Filter
select p_partkey, sum(ps_supplycost)
  from Part,
       PartSupp
 where p_partkey  = ps_partkey
   and p_brand = 'Brand#44'
   and p_size < 10
 group by
   p_partkey;
rows:
  (43, 2099.74)
  (185, 1688.59)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Join + AggGby + Filter
select sum(ps_supplycost), p_partkey
  from Part,
       PartSupp
 where p_partkey  = ps_partkey
   and p_brand = 'Brand#44'
   and p_size < 10
 group by
   p_partkey;
rows:
  (2099.74, 43)
  (1688.59, 185)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
MemoryLeaks;
rows: 0

