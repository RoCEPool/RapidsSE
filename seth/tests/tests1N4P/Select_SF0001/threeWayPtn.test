/*============================================================================*/
/* threeWayJoins -- partitioning test                                         */
/*============================================================================*/

trackMemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// UNICAST+HASHCAST+HASHCAST
select count(*)
  from ${testName}_Customer,
       ${testName}_Orders,
       ${testName}_Lineitem,
       ${testName}_Supplier
 where C_CUSTKEY  = O_CUSTKEY
   and L_ORDERKEY = O_ORDERKEY
   and L_SUPPKEY  = S_SUPPKEY;
rows:
  (5996)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// BROADCAST+UNICAST+BROADCAST
select count(*)
  from ${testName}_Lineitem,
       ${testName}_PartSupp,
       ${testName}_Part,
       ${testName}_Supplier
 where P_PARTKEY = PS_PARTKEY
   and L_SUPPKEY  = PS_SUPPKEY
   and PS_SUPPKEY = S_SUPPKEY;
rows:
  (576000)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// BROADCAST+BROADCAST+HASHCAST
select count(*)
  from ${testName}_Part,
       ${testName}_Lineitem,
       ${testName}_PartSupp,
       ${testName}_Supplier
 where P_PARTKEY = L_PARTKEY
   and L_SUPPKEY  = PS_SUPPKEY
   and PS_SUPPKEY = S_SUPPKEY;
rows:
 (576000)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
MemoryLeaks;
rows: 0

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
