/*============================================================================*/
/* twoWayJoins -- partitioning test                                           */
/*============================================================================*/

trackMemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// UNICAST+HASHCAST
select count(*)
  from ${testName}_Customer,
       ${testName}_Orders,
       ${testName}_Lineitem
 where C_CUSTKEY  = O_CUSTKEY
   and L_ORDERKEY = O_ORDERKEY;
rows:
  (5996)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// UNICAST+BROADCAST
select count(*)
  from ${testName}_Lineitem,
       ${testName}_PartSupp,
       ${testName}_Part
 where P_PARTKEY = PS_PARTKEY
   and L_SUPPKEY  = PS_SUPPKEY;
rows:
  (576000)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// HASHCAST+BROADCAST
select count(*)
  from ${testName}_Part,
       ${testName}_Lineitem,
       ${testName}_PartSupp
 where P_PARTKEY = L_PARTKEY
   and L_SUPPKEY  = PS_SUPPKEY;
rows:
 (576000)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
MemoryLeaks;
rows: 0

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
