--------------------------------------------------------------------------------
-- project aggregates tests
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
select sum(L_QUANTITY) from lineitem;
failure contains: "No such table"

//------------------------------------------------------------------------------
// create table lineitem
create table LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

// load data
load lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
select sum(L_DISCOUNT) from lineitem;
rows:
  (0.71)

//------------------------------------------------------------------------------
select sum(L_QUANTITY) from lineitem;
rows:
  (299.00)

//------------------------------------------------------------------------------
select sum(L_ORDERKEY) from lineitem;
rows:
  (17)

//------------------------------------------------------------------------------
select sum(L_LINENUMBER) from lineitem;
rows:
 (28)

//------------------------------------------------------------------------------
select sum(L_LINENUMBER), sum(L_ORDERKEY) from lineitem;
rows:
 (28,17)

//------------------------------------------------------------------------------
select count(L_ORDERKEY) from lineitem;
rows:
 (10)

//------------------------------------------------------------------------------
select count(L_ORDERKEY) from lineitem;
rows:
 (10)

//------------------------------------------------------------------------------
select 1 + sum(L_ORDERKEY) from lineitem;
rows:
 (18)

//------------------------------------------------------------------------------
// sum($1) + 1
select sum(L_ORDERKEY) + 1 from lineitem;
rows:
 (18)

//------------------------------------------------------------------------------
// sum(1+$1)
select sum(L_ORDERKEY+ 1) from lineitem;
rows:
 (27)

//------------------------------------------------------------------------------
// drop the table
drop table lineitem;
success;

MemoryLeaks;
rows: 0

CLEANUP {
  
  drop table lineitem;
  mute
  
  bye;
  mute
}


