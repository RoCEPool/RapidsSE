--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table ${testName2}_region (
R_REGIONKEY       INTEGER NOT NULL,
R_NAME            CHAR(25) NOT NULL,
R_COMMENT         VARCHAR(152)
)
replicated
tablesize 1
;
success

//------------------------------------------------------------------------------
// create the indexes
CREATE INDEX IxR_REGIONKEY ON ${testName2}_region(R_REGIONKEY);
affected: 0


-----------------------------------------------------------------------
// load the table
loadReplicated ${testName2}_region "../TPCH/SF_0001/region.csv";
success

//select count(*) from ${testName2}_region;
//rows: (5)

compactidx ${testName2}_region IxR_REGIONKEY;
success


CLEANUP {

  bye;
  mute
}

