--------------------------------------------------------------------------------
-- tpch query5 (SF_0001)
--------------------------------------------------------------------------------
/*  (original Query)

  select n_name, sum(l_extendedprice * (1 - l_discount)) as revenue
      from customer, orders, lineitem, supplier, nation, region
      where c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and l_suppkey = s_suppkey
      and c_nationkey = s_nationkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'ASIA'
      and o_orderdate >= '1994-01-01'
      and o_orderdate < '1995-01-01'
      group by n_name
      order by revenue asc;

// ASIA to AMERICA for SF0001 datset
select n_name, sum(l_extendedprice * (1 - l_discount)) as revenue
      from customer, orders, lineitem, supplier, nation, region
      where c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and l_suppkey = s_suppkey
      and c_nationkey = s_nationkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'AMERICA'
      and o_orderdate >= '1994-01-01'
      and o_orderdate < '1995-01-01'
      group by n_name
      order by revenue desc;

*/

//------------------------------------------------------------------------------
// pipeline Generated
//------------------------------------------------------------------------------
/*

EXPLAIN STAGE TRANSLITERATE
select n_name, sum(l_extendedprice * (1 - l_discount)) as revenue
      from customer, orders, lineitem, supplier, nation, region
      where c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and l_suppkey = s_suppkey
      and c_nationkey = s_nationkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'AMERICA'
      and o_orderdate >= '1994-01-01'
      and o_orderdate < '1995-01-01'
      group by n_name
      order by revenue desc;

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker10504
  stage stageMarker10504 on all partitions :
    scan rapidsse public customer
    | stageMarker10507 broadcast
  stage stageMarker10507 on all partitions :
    scan rapidsse public orders
    | abstractJoin " 1  "
    | stageMarker10510 broadcast
  stage stageMarker10510 on all partitions :
    scan rapidsse public lineitem
    | abstractJoin " 1  "
    | stageMarker10513 broadcast
  stage stageMarker10513 on all partitions :
    scan rapidsse public supplier
    | abstractJoin " 1  "
    | stageMarker10516 broadcast
  stage stageMarker10516 on all partitions :
    scan rapidsse public nation
    | abstractJoin " 1  "
    | stageMarker10519 broadcast
  stage stageMarker10519 on all partitions :
    scan rapidsse public region
    | abstractJoin " 1  "
    | stageMarker10522
  stage stageMarker10522 on all partitions :
    filter " type BOOLEAN  $1 $10 ==  $18 $9 ==  and  $20 $34 ==  and  $4 $37 ==  and  $37 $41 ==  and  $43 $45 ==  and  $46 ''AMERICA''  ==  and  $13 DATE ''1994-01-01''  >=  and  $13 DATE ''1995-01-01''  <  and  "
    | gbyAgg " groupBy  type VARCHAR as n_name  N_NAME aggregates  type VARCHAR $K1 , type DECIMAL )  $23 1.  $24 -  *  sum  "
    | combined 0
    | stageMarker10525
  stage stageMarker10525 on all nodes :
    gbyAgg " groupBy  type VARCHAR as n_name $1 aggregates  type VARCHAR $K1 , type DECIMAL )  $2 sum  "
    | combined 0
    | stageMarker10528
  stage stageMarker10528 on origin :
    gbyAgg " groupBy  type VARCHAR as n_name $1 aggregates  type VARCHAR $K1 , type DECIMAL as revenue )  $2 sum  "
    | sort " type DECIMAL $2 DESC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;
*/

//------------------------------------------------------------------------------
// OPTIMIZED Q5_v1
// Changed abstractJoins to concrete joins with combinedOp
// removed join columns from the filter
// added hashOP hashcasts where needed
// broadcast from stageMarker10504 removed as co-partitioned join
// ordinals to symbolic
// added next and first
// SORT DESC TO ASC
//------------------------------------------------------------------------------

trackMemory force;
success

/optimise_passthru 
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarker10504 on all partitions :
    scan rapidsse public customer
    | next //broadcast

  stage stageMarker10507 on all partitions :
    //scan rapidsse public orders
    //| abstractJoin " 1  "
    indexJoin Orders IxO_CUSTKEY "bound $I1 C_CUSTKEY =="   // Orders - J1
    | hash "type INTEGER O_ORDERKEY"
    | combined 0
    | next hashcast

  stage stageMarker10510 on all partitions :
    //scan rapidsse public Lineitem
    //| abstractJoin " 1  "
    indexJoin Lineitem IxL_ORDERKEY "bound $I1 O_ORDERKEY =="   // Lineitem - J2
    | hash "type INTEGER L_SUPPKEY"
    | combined 0
    | next hashcast

  stage stageMarker10513 on all partitions :
    //scan rapidsse public Supplier
    //| abstractJoin " 1  "
    indexJoin Supplier IxS_SUPPKEY expr "bound $I1 L_SUPPKEY =="   // Supplier - J3
    | hash "type INTEGER S_NATIONKEY"
    | combined 0
    | next hashcast

  stage stageMarker10516 on all partitions :
    //scan rapidsse public nation
    //| abstractJoin " 1  "
    indexJoin Nation IxN_NATIONKEY expr "bound $I1 S_NATIONKEY =="   // Nation - J4
    | hash "type INTEGER  N_REGIONKEY"
    | combined 0
    | next hashcast

  stage stageMarker10519 on all partitions :
    //scan rapidsse public region
    //| abstractJoin " 1  "
    indexJoin Region IxR_REGIONKEY expr "bound $I1  N_REGIONKEY =="  // REGION - J5
    | combined 0
    | next

  stage stageMarker10522 on all partitions :
    filter " type BOOLEAN C_NATIONKEY S_NATIONKEY ==
                           R_NAME 'AMERICA'  ==  and
                          O_ORDERDATE DATE '1994-01-01'  >=  and
                          O_ORDERDATE DATE '1995-01-01'  <  and  "
    | gbyAgg " groupBy  type VARCHAR as n_name  N_NAME aggregates  type VARCHAR $K1 , type DECIMAL )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  "
    | combined 0
    | next

  stage stageMarker10525 on all nodes :
    gbyAgg " groupBy  type VARCHAR as n_name $1 aggregates  type VARCHAR $K1 , type DECIMAL )  $2 sum  "
    | combined 0
    | next

  stage stageMarker10528 on origin :
    gbyAgg " groupBy  type VARCHAR as n_name $1 aggregates  type VARCHAR $K1 , type DECIMAL as revenue )  $2 sum  "
    | combined 0
    | next

  stage stageNew on origin :
    sort " type DECIMAL $2 DESC  "
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

