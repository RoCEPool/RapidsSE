//------------------------------------------------------------------------------
// OPTIMIZED Q5_v4
// added projections to reduce data flow
//------------------------------------------------------------------------------

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarker10504 on all partitions :
    scan rapidsse public Orders
    | filter " type BOOLEAN O_ORDERDATE DATE '1994-01-01'  >=
                            O_ORDERDATE DATE '1995-01-01'  <  and  "
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY ,
               type INTEGER as O_ORDERKEY O_ORDERKEY"
    | combined 0
    | next

  stage stageMarker10507 on all partitions :
    indexJoin Customer IxC_CUSTKEY "bound $I1 O_CUSTKEY =="   // Customer - J1
    | project "type INTEGER as O_ORDERKEY O_ORDERKEY ,
               type INTEGER as J1_C_NATIONKEY J1_C_NATIONKEY"
    | hash "type INTEGER O_ORDERKEY"
    | combined 0
    | next hashcast

  stage stageMarker10510 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY "bound $I1 O_ORDERKEY =="   // Lineitem - J2
    | project "type INTEGER as J1_C_NATIONKEY J1_C_NATIONKEY ,
                   type INTEGER as J2_L_SUPPKEY J2_L_SUPPKEY ,
                   type DECIMAL as J2_L_EXTENDEDPRICE J2_L_EXTENDEDPRICE ,
                   type DECIMAL as J2_L_DISCOUNT J2_L_DISCOUNT"
    | hash "type INTEGER J2_L_SUPPKEY"
    | combined 0
    | next hashcast

  stage stageMarker10513 on all partitions :
    indexJoin Supplier IxS_SUPPKEY expr "bound $I1 J2_L_SUPPKEY =="   // Supplier - J3
    | filter " type BOOLEAN J1_C_NATIONKEY J3_S_NATIONKEY == "
    | project "type DECIMAL as J2_L_EXTENDEDPRICE J2_L_EXTENDEDPRICE ,
               type DECIMAL as J2_L_DISCOUNT J2_L_DISCOUNT ,
               type INTEGER as J3_S_NATIONKEY J3_S_NATIONKEY"
    | hash "type INTEGER J3_S_NATIONKEY"
    | combined 0
    | next hashcast

  stage stageMarker10516 on all partitions :
    indexJoin Nation IxN_NATIONKEY expr "bound $I1 J3_S_NATIONKEY =="   // Nation - J4
    | project "type DECIMAL as J2_L_EXTENDEDPRICE J2_L_EXTENDEDPRICE ,
               type DECIMAL as J2_L_DISCOUNT J2_L_DISCOUNT ,
               type VARCHAR as J4_N_NAME J4_N_NAME ,
               type INTEGER as J4_N_REGIONKEY J4_N_REGIONKEY"
    | hash "type INTEGER J4_N_REGIONKEY"
    | combined 0
    | next hashcast

  stage stageMarker10519 on all partitions :
    indexJoin Region IxR_REGIONKEY expr "bound $I1 J4_N_REGIONKEY =="  // REGION - J5
    | filter " type BOOLEAN J5_R_NAME 'AMERICA'  ==  "
    | project "type DECIMAL as J2_L_EXTENDEDPRICE J2_L_EXTENDEDPRICE ,
               type DECIMAL as J2_L_DISCOUNT J2_L_DISCOUNT ,
               type VARCHAR as J4_N_NAME J4_N_NAME"
    | combined 0
    | next

  stage stageMarker10522 on all partitions :
    aggreg " groupBy  type VARCHAR as n_name J4_N_NAME aggregates  type VARCHAR $K1 , type DECIMAL )  J2_L_EXTENDEDPRICE 1.  J2_L_DISCOUNT -  *  sum  "
    | combined 0
    | next

  stage stageMarker10525 on all nodes :
    aggreg " groupBy  type VARCHAR as n_name $1 aggregates  type VARCHAR $K1 , type DECIMAL )  $2 sum  "
    | combined 0
    | next

  stage stageMarker10528 on origin :
    aggreg " groupBy  type VARCHAR as n_name $1 aggregates  type VARCHAR $K1 , type DECIMAL as revenue )  $2 sum  "
    | combined 0
    | next

  stage stageNew on origin :
    sort " type DECIMAL $2 ASC  "
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

