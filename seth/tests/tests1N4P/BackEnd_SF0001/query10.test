// TODO V2 : ORDAGG
/*
// with ordAgg and sort; is slower
/optimise_passthru 
pipeline Query10
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    indexScan ${testName2}_Orders IxO_ORDERDATE "LBOUND date '1993-10-01' >=  UBOUND date '1994-01-01' < "
    | project "type INTEGER as O_CUSTKEY  O_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin ${testName2}_Customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY , type INTEGER as O_ORDERKEY O_ORDERKEY"
    | hash expr type INTEGER O_ORDERKEY
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin ${testName2}_Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | filter  "type BOOLEAN L_RETURNFLAG 'R' =="
    | combined 0
    | next

  stage S03_a on all partitions :
     sort " type INTEGER O_CUSTKEY ASC  "
     | combined 0
     | next

   stage S03 on all partitions :
    ordAgg  "ordGroupby    type INTEGER O_CUSTKEY aggregates type INTEGER as O_CUSTKEY $K1 , type DECIMAL as REVENUE ) L_EXTENDEDPRICE 1.0  L_DISCOUNT -  *  sum "
    | combined 0
    | next

  stage S04 on all nodes :
    gbyAgg "groupby    type INTEGER O_CUSTKEY aggregates type INTEGER as O_CUSTKEY $K1 , type DECIMAL as REVENUE ) REVENUE  sum "
    | combined 0
    | next

  stage S05 on origin :
    gbyAgg "groupby    type INTEGER O_CUSTKEY aggregates type INTEGER as O_CUSTKEY $K1 , type DECIMAL as REVENUE ) REVENUE  sum"
    | combined 0
    | next

  stage stageNew on origin :
    top "type DECIMAL REVENUE " 20
    | hash expr type INTEGER O_CUSTKEY
    | combined 0
    | next hashcast

  stage S07 on all partitions :
    indexJoin ${testName2}_Customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY , type INTEGER as C_NATIONKEY C_NATIONKEY , type VARCHAR as C_NAME C_NAME , type DECIMAL as REVENUE ) REVENUE , type DECIMAL as C_ACCTBAL C_ACCTBAL , type VARCHAR as C_ADDRESS C_ADDRESS , type VARCHAR as C_PHONE C_PHONE , type VARCHAR as C_COMMENT C_COMMENT"
    | combined 0
    | next

  stage S08 on all partitions :
    indexjoin ${testName2}_Nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY =="
    | project "type INTEGER as O_CUSTKEY O_CUSTKEY , type VARCHAR as C_NAME C_NAME , type DECIMAL as REVENUE ) REVENUE , type DECIMAL as C_ACCTBAL C_ACCTBAL , type VARCHAR as N_NAME N_NAME , type VARCHAR as C_ADDRESS C_ADDRESS , type VARCHAR as C_PHONE C_PHONE , type VARCHAR as C_COMMENT C_COMMENT"
    | combined 0
    | next

  stage S06 on origin :
    sort " type DECIMAL REVENUE ASC  "
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;
