/optimise_passthru 
pipeline unnamed
    begin

    stage first on origin :
      start
      | pulse once
      | next

    stage Gs_ORDERS on all partitions :
      indexScan ${testName2}_Orders IxO_ORDERDATE
          "lbound date '1993-10-01' >=  ubound date '1994-01-01' < "
      | project
          "type INTEGER as _custkey  O_CUSTKEY , type INTEGER as _orderkey O_ORDERKEY"
      | combined 0
      | next

    stage Gj_CUSTOMER on all partitions :
      indexJoin ${testName2}_Customer IxC_CUSTKEY expr bound $I1 _custkey ==  //J1
      | project expr  type INTEGER as _custkey _custkey ,
                      type INTEGER as _orderkey _orderkey ,
                      type VARCHAR as c_name c_name ,
                      type DECIMAL as c_acctbal C_ACCTBAL ,
                      type INTEGER as C_NATIONKEY c_nationkey ,
                      type VARCHAR as c_address c_address ,
                      type VARCHAR as c_phone c_phone ,
                      type VARCHAR as c_comment c_comment
      | combined 0
      | next

 stage Gj_NATION on all partitions :
    indexjoin ${testName2}_Nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY ==" // J2 - Nation
    | project expr type INTEGER as _custkey _custkey ,
                   type INTEGER as _orderkey _orderkey ,
                   type VARCHAR as c_name c_name ,
                   type DECIMAL as c_acctbal c_acctbal ,
                   type VARCHAR as n_name n_name ,
                   type VARCHAR as c_address c_address ,
                   type VARCHAR as c_phone c_phone ,
                   type VARCHAR as c_comment c_comment
    | hash expr type INTEGER _orderkey
    | combined 0
    | next hashcast

  //HC

    // ⋈ LINEITEM /L_ORDERKEY/ _orderkey π _orderkey
    stage Gj_LINEITEM on all partitions :
      indexJoin ${testName2}_Lineitem IxL_ORDERKEY expr bound $I1 _orderkey ==  //J2
      | filter  "type BOOLEAN L_RETURNFLAG 'R' =="
      | gbyAgg expr groupby type INTEGER _custkey
                     aggregates
                     type INTEGER as _custkey $K1 ,
                     type VARCHAR as c_name c_name ,
                     type DECIMAL as REVENUE ) L_EXTENDEDPRICE 1.0  L_DISCOUNT -  *  sum ,
                     type DECIMAL as c_acctbal c_acctbal ,
                     type VARCHAR as n_name n_name ,
                     type VARCHAR as c_address c_address ,
                     type VARCHAR as c_phone c_phone ,
                     type VARCHAR as c_comment c_comment
      | combined 0
      | next

    // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
    stage G_AGG_N on all nodes :
      gbyAgg expr groupby type INTEGER _custkey
                  aggregates
                  type INTEGER as _custkey $K1 ,
                  type VARCHAR as c_name c_name ,
                  type DECIMAL as REVENUE ) REVENUE  sum ,
                  type DECIMAL as c_acctbal c_acctbal ,
                  type VARCHAR as n_name n_name ,
                  type VARCHAR as c_address c_address ,
                  type VARCHAR as c_phone c_phone ,
                  type VARCHAR as c_comment c_comment
      | combined 0
      | next

    stage G_GAG_O on origin :
      gbyAgg expr groupby type INTEGER _custkey
                  aggregates type INTEGER as _custkey $K1 ,
                  type VARCHAR as c_name c_name ,
                  type DECIMAL as REVENUE ) REVENUE  sum ,
                  type DECIMAL as c_acctbal c_acctbal ,
                  type VARCHAR as n_name n_name ,
                  type VARCHAR as c_address c_address ,
                  type VARCHAR as c_phone c_phone ,
                  type VARCHAR as c_comment c_comment
      | combined 0
      | next

    stage stageNew on origin :
      sort " type DECIMAL $3 ASC  "
      | limit 20
      | combined 0
      | next

    stage last on origin :
      output
      | sink
      | first

  end ;

