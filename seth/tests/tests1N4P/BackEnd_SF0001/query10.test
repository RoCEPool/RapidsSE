//------------------------------------------------------------------------------
// OPTIMIZED Q10_v1
// Changed all pipe to - next and first (makes it easier)
// Changed all Ordinal columns to Symbolic (makes it easier)
// Changed Scans followed by AbstractJoins to concrete joins
// Removed C_CUSTKEY O_CUSTKEY ==  and
//                   L_ORDERKEY O_ORDERKEY ==
//   from filter in stage stageMarker6349 as part of join keys
// Moved SORT to a new stage as CodeSynthesizer does not allow
//     aggregates and sort operators in the same stage
// Modified DESC to ASC as DESC not yet supported
//------------------------------------------------------------------------------

/optimise_passthru 
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageMarker27159 on all partitions :
    scan rapidsse public ${testName2}_customer
    | next

  stage stageMarker27162 on all partitions :
    //scan rapidsse public ${testName2}_orders
    //| abstractJoin " 1  "
    indexjoin ${testName2}_Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="  // J1 - Orders
    | hash "type INTEGER O_ORDERKEY"
    | combined 0
    | next hashcast

  stage stageMarker27165 on all partitions :
    //scan rapidsse public ${testName2}_lineitem
    //| abstractJoin " 1  "
    indexjoin ${testName2}_Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY ==" // J2 - Lineitem
    | hash "type INTEGER C_NATIONKEY"
    | combined 0
    | next hashcast

  stage stageMarker27168 on all partitions :
    //scan rapidsse public ${testName2}_nation
    //| abstractJoin " 1  "
    indexjoin ${testName2}_Nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY ==" // J3 - Nation
    | combined 0
    | next

  stage stageMarker27171 on all partitions :
    filter " type BOOLEAN  //C_CUSTKEY O_CUSTKEY ==
                               //L_ORDERKEY O_ORDERKEY ==  and
                               O_ORDERDATE DATE '1993-10-01'  >=
                               O_ORDERDATE DATE '1994-01-01'  <  and
                               L_RETURNFLAG 'R'  ==  and"
                               //C_NATIONKEY N_NATIONKEY ==  and  "

    | gbyAgg " groupBy  type INTEGER as C_CUSTKEY C_CUSTKEY ,
                        type VARCHAR as C_NAME C_NAME ,
                        type DECIMAL as C_ACCTBAL C_ACCTBAL ,
                        type VARCHAR as C_PHONE C_PHONE ,
                        type VARCHAR as N_NAME N_NAME ,
                        type VARCHAR as C_ADDRESS C_ADDRESS ,
                        type VARCHAR as C_COMMENT C_COMMENT
                        aggregates
                        type INTEGER $K1 ,
                        type VARCHAR $K2 ,
                        type DECIMAL )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  ,
                        type DECIMAL $K3 ,
                        type VARCHAR $K5 ,
                        type VARCHAR $K6 ,
                        type VARCHAR $K4 ,
                        type VARCHAR $K7 "

    | combined 0
    | next

  stage stageMarker27174 on all nodes :
    gbyAgg " groupBy  type INTEGER as C_CUSTKEY $1 ,
                      type VARCHAR as C_NAME $2 ,
                      type DECIMAL as C_ACCTBAL $4 ,
                      type VARCHAR as C_PHONE $7 ,
                      type VARCHAR as N_NAME $5 ,
                      type VARCHAR as C_ADDRESS $6 ,
                      type VARCHAR as C_COMMENT $8
                      aggregates
                      type INTEGER $K1 ,
                      type VARCHAR $K2 ,
                      type DECIMAL )  $3 sum  ,
                      type DECIMAL $K3 ,
                      type VARCHAR $K5 ,
                      type VARCHAR $K6 ,
                      type VARCHAR $K4 ,
                      type VARCHAR $K7 "
    | combined 0
    | next
  stage stageMarker27177 on origin :
    gbyAgg " groupBy  type INTEGER as C_CUSTKEY $1 ,
                      type VARCHAR as C_NAME $2 ,
                      type DECIMAL as C_ACCTBAL $4 ,
                      type VARCHAR as C_PHONE $7 ,
                      type VARCHAR as N_NAME $5 ,
                      type VARCHAR as C_ADDRESS $6 ,
                      type VARCHAR as C_COMMENT $8
                      aggregates
                      type INTEGER $K1 ,
                      type VARCHAR $K2 ,
                      type DECIMAL )  $3 sum  ,
                      type DECIMAL $K3 ,
                      type VARCHAR $K5 ,
                      type VARCHAR $K6 ,
                      type VARCHAR $K4 ,
                      type VARCHAR $K7 "
      | combined 0
       | next
  stage stageNew on origin :
    sort " type DECIMAL $3 ASC  "
    | limit 20
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

