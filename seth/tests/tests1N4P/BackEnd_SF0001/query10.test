--------------------------------------------------------------------------------
-- tpch query10 (SF_0001)
--------------------------------------------------------------------------------
/*  (original Query)

select c_custkey, c_name, sum(l_extendedprice * (1 - l_discount)) as revenue,
     c_acctbal, n_name, c_address, c_phone, c_comment
     from customer, orders, lineitem, nation
     where c_custkey = o_custkey
     and l_orderkey = o_orderkey
     and o_orderdate >= '1993-10-01'
     and o_orderdate < '1994-01-01'
     and l_returnflag = 'R'
     and c_nationkey = n_nationkey
     group by c_custkey, c_name, c_acctbal, c_phone, n_name, c_address, c_comment
     order by revenue desc limit 100;

*/

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------

/*
EXPLAIN STAGE TRANSLITERATE
select c_custkey, c_name, sum(l_extendedprice * (1 - l_discount)) as revenue,
     c_acctbal, n_name, c_address, c_phone, c_comment
     from customer, orders, lineitem, nation
     where c_custkey = o_custkey
     and l_orderkey = o_orderkey
     and o_orderdate >= '1993-10-01'
     and o_orderdate < '1994-01-01'
     and l_returnflag = 'R'
     and c_nationkey = n_nationkey
     group by c_custkey, c_name, c_acctbal, c_phone, n_name, c_address, c_comment
     order by revenue desc limit 100;

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker27159
  stage stageMarker27159 on all partitions :
    scan rapidsse public customer
    | stageMarker27162 broadcast
  stage stageMarker27162 on all partitions :
    scan rapidsse public orders
    | abstractJoin " 1  "
    | stageMarker27165 broadcast
  stage stageMarker27165 on all partitions :
    scan rapidsse public lineitem
    | abstractJoin " 1  "
    | stageMarker27168 broadcast
  stage stageMarker27168 on all partitions :
    scan rapidsse public nation
    | abstractJoin " 1  "
    | stageMarker27171
  stage stageMarker27171 on all partitions :
    filter " type BOOLEAN  $1 $10 ==  $18 $9 ==  and  $13 TIMESTAMP ''1993-10-01 00:00:00''  >=  and  $13 TIMESTAMP ''1994-01-01 00:00:00''  <  and  $26 ''R''  ==  and  $4 $34 ==  and  "
    | aggreg " groupBy  type INTEGER as c_custkey $1 , type VARCHAR as c_name $2 , type DECIMAL as c_acctbal $6 , type VARCHAR as c_phone $5 , type VARCHAR as n_name $35 , type VARCHAR as c_address $3 , type VARCHAR as c_comment $8 aggregates  type INTEGER $K1 , type VARCHAR $K2 , type DECIMAL )  $23 1.  $24 -  *  sum  , type DECIMAL $K3 , type VARCHAR $K5 , type VARCHAR $K6 , type VARCHAR $K4 , type VARCHAR $K7 "
    | combined 0
    | stageMarker27174
  stage stageMarker27174 on all nodes :
    aggreg " groupBy  type INTEGER as c_custkey $1 , type VARCHAR as c_name $2 , type DECIMAL as c_acctbal $4 , type VARCHAR as c_phone $7 , type VARCHAR as n_name $5 , type VARCHAR as c_address $6 , type VARCHAR as c_comment $8 aggregates  type INTEGER $K1 , type VARCHAR $K2 , type DECIMAL )  $3 sum  , type DECIMAL $K3 , type VARCHAR $K5 , type VARCHAR $K6 , type VARCHAR $K4 , type VARCHAR $K7 "
    | combined 0
    | stageMarker27177
  stage stageMarker27177 on origin :
    aggreg " groupBy  type INTEGER as c_custkey $1 , type VARCHAR as c_name $2 , type DECIMAL as c_acctbal $4 , type VARCHAR as c_phone $7 , type VARCHAR as n_name $5 , type VARCHAR as c_address $6 , type VARCHAR as c_comment $8 aggregates  type INTEGER $K1 , type VARCHAR $K2 , type DECIMAL as revenue )  $3 sum  , type DECIMAL $K3 , type VARCHAR $K5 , type VARCHAR $K6 , type VARCHAR $K4 , type VARCHAR $K7 "
    | sort " type DECIMAL $3 DESC  "
    | limit 100
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;
*/

//------------------------------------------------------------------------------
// OPTIMIZED Q3_v1
// Changed all pipe to - next and first (makes it easier)
// Changed all Ordinal columns to Symbolic (makes it easier)
// Changed Scans followed by AbstractJoins to concrete joins
// Removed C_CUSTKEY J1_O_CUSTKEY ==  and
//                   J2_L_ORDERKEY J1_O_ORDERKEY ==
//   from filter in stage stageMarker6349 as part of join keys
// Moved SORT to a new stage as CodeSynthesizer does not allow
//     aggregates and sort operators in the same stage
// Modified DESC to ASC as DESC not yet supported
//------------------------------------------------------------------------------

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageMarker27159 on all partitions :
    scan rapidsse public customer
    | next

  stage stageMarker27162 on all partitions :
    //scan rapidsse public orders
    //| abstractJoin " 1  "
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="  // J1 - Orders
    | hash "type INTEGER J1_O_ORDERKEY"
    | combined 0
    | next hashcast

  stage stageMarker27165 on all partitions :
    //scan rapidsse public lineitem
    //| abstractJoin " 1  "
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 J1_O_ORDERKEY ==" // J2 - Lineitem
    | hash "type INTEGER C_NATIONKEY"
    | combined 0
    | next hashcast

  stage stageMarker27168 on all partitions :
    //scan rapidsse public nation
    //| abstractJoin " 1  "
    indexjoin Nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY ==" // J3 - Nation
    | combined 0
    | next

  stage stageMarker27171 on all partitions :
    filter " type BOOLEAN  //C_CUSTKEY J1_O_CUSTKEY ==
                               //J2_L_ORDERKEY J1_O_ORDERKEY ==  and
                               J1_O_ORDERDATE DATE '1993-10-01'  >=
                               J1_O_ORDERDATE DATE '1994-01-01'  <  and
                               J2_L_RETURNFLAG 'R'  ==  and"
                               //C_NATIONKEY J3_N_NATIONKEY ==  and  "

    | aggreg " groupBy  type INTEGER as C_CUSTKEY C_CUSTKEY ,
                        type VARCHAR as C_NAME C_NAME ,
                        type DECIMAL as C_ACCTBAL C_ACCTBAL ,
                        type VARCHAR as C_PHONE C_PHONE ,
                        type VARCHAR as J3_N_NAME J3_N_NAME ,
                        type VARCHAR as C_ADDRESS C_ADDRESS ,
                        type VARCHAR as C_COMMENT C_COMMENT
                        aggregates
                        type INTEGER $K1 ,
                        type VARCHAR $K2 ,
                        type DECIMAL )  J2_L_EXTENDEDPRICE 1.  J2_L_DISCOUNT -  *  sum  ,
                        type DECIMAL $K3 ,
                        type VARCHAR $K5 ,
                        type VARCHAR $K6 ,
                        type VARCHAR $K4 ,
                        type VARCHAR $K7 "

    | combined 0
    | next

  stage stageMarker27174 on all nodes :
    aggreg " groupBy  type INTEGER as C_CUSTKEY $1 ,
                      type VARCHAR as C_NAME $2 ,
                      type DECIMAL as C_ACCTBAL $4 ,
                      type VARCHAR as C_PHONE $7 ,
                      type VARCHAR as J3_N_NAME $5 ,
                      type VARCHAR as C_ADDRESS $6 ,
                      type VARCHAR as C_COMMENT $8
                      aggregates
                      type INTEGER $K1 ,
                      type VARCHAR $K2 ,
                      type DECIMAL )  $3 sum  ,
                      type DECIMAL $K3 ,
                      type VARCHAR $K5 ,
                      type VARCHAR $K6 ,
                      type VARCHAR $K4 ,
                      type VARCHAR $K7 "
    | combined 0
    | next
  stage stageMarker27177 on origin :
    aggreg " groupBy  type INTEGER as C_CUSTKEY $1 ,
                      type VARCHAR as C_NAME $2 ,
                      type DECIMAL as C_ACCTBAL $4 ,
                      type VARCHAR as C_PHONE $7 ,
                      type VARCHAR as J3_N_NAME $5 ,
                      type VARCHAR as C_ADDRESS $6 ,
                      type VARCHAR as C_COMMENT $8
                      aggregates
                      type INTEGER $K1 ,
                      type VARCHAR $K2 ,
                      type DECIMAL )  $3 sum  ,
                      type DECIMAL $K3 ,
                      type VARCHAR $K5 ,
                      type VARCHAR $K6 ,
                      type VARCHAR $K4 ,
                      type VARCHAR $K7 "
      | combined 0
       | next
  stage stageNew on origin :
    sort " type DECIMAL $3 ASC  "
    | limit 100
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

