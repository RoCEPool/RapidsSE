     from part, supplier, partsupp, nation, region
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and p_size = 15
      and p_type like '%BRASS'
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE'
      and ps_supplycost = (
      select min(ps_supplycost)
      from partsupp, supplier, nation, region
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE' )
       order by s_acctbal desc, n_name, s_name, p_partkey;

  -- verfified
  rows: 0
*/

/*
// modified query for the SF_0001 dataset
// p_size < 15
select s_acctbal, s_name, n_name, p_partkey, p_mfgr, s_address, s_phone, s_comment
     from part, supplier, partsupp, nation, region
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and p_size < 15
      and p_type like '%BRASS'
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE'
      and ps_supplycost = (
      select min(ps_supplycost)
      from partsupp, supplier, nation, region
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE' )
       order by s_acctbal desc, n_name, s_name, p_partkey;

    -- verfified
    rows:
    (6820.35,'Supplier#000000007','UNITED KINGDOM',47,'Manufacturer#4','s:4TicNGB4uO6PaSqNBUq','33-990-965-2201','s unwind silently furiously regular courts. final requests are deposits. requests wake quietly blit')

*/

// Below queries modified for dataset SF0001
// p_size < 15, and NO LIKE

/////////////////////
// Q02_0           //
/////////////////////

/////////////////////
// Q02_1           //
/////////////////////

//------------------------------------------------------------------------------

// OUTER QUERY
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker3905
  stage stageMarker3905 on all partitions :
    scan rapidsse public part
    | stageMarker3908
  stage stageMarker3911 on all partitions :
    indexJoin 1 parsupp IxPS_SUPPKEY "BOUND $I1 $L1 =="
    | stageMarker3914 hashcast
  stage stageMarker3908 on all partitions :
    indexJoin 1 supplier IxS_SUPPKEY "BOUND $I1 $L1 =="
    | hash 2 "type INTEGER _orderkey"
    | stageMarker3911 hashcast
  stage stageMarker3914 on all partitions :
    indexJoin 1 nation IxN_NATIONKEY "BOUND $I1 $L1 =="
    | stageMarker3917 broadcast
  stage stageMarker3917 on all partitions :
    indexJoin 1 region IxR_REGIONKEY "BOUND $I1 $L1 =="
    | stageMarker3920
  stage stageMarker3920 on all partitions :
    filter " type BOOLEAN  $1 $17 ==  $10 $18 ==  and  $6 15  <  and  }  $5 ''%BRASS''  6 matchTrailing  and  $13 $22 ==  and  $24 $26 ==  and  $27 ''EUROPE''  ==  and  /* $20 $1 __subquery0003  ==  and*/  "
    | project " type DECIMAL as s_acctbal $15 , type VARCHAR as s_name $11 , type VARCHAR as n_name $23 , type INTEGER as p_partkey $1 , type VARCHAR as p_mfgr $3 , type VARCHAR as s_address $12 , type VARCHAR as s_phone $14 , type VARCHAR as s_comment $16 "
    | sort " type DECIMAL as s_acctbal $1 DESC  , type VARCHAR as n_name $3 ASC  , type VARCHAR as s_name $2 ASC  , type INTEGER as p_partkey $4 ASC  "
    | combined 0
    | stageMarker3923
  stage stageMarker3923 on all nodes :
    sort " type DECIMAL as s_acctbal $1 DESC  , type VARCHAR as n_name $3 ASC  , type VARCHAR as s_name $2 ASC  , type INTEGER as p_partkey $4 ASC  "
    | combined 0
    | stageMarker3926
  stage stageMarker3926 on origin :
    sort " type DECIMAL as s_acctbal $1 DESC  , type VARCHAR as n_name $3 ASC  , type VARCHAR as s_name $2 ASC  , type INTEGER as p_partkey $4 ASC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

CLEANUP {
  bye;
  mute
}


