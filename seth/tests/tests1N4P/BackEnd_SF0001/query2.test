pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarker4609 on all partitions :
    indexscan partsupp IxPS_PARTKEY "LBOUND $I1 0 >="
    | project " type INTEGER as PS_PARTKEY PS_PARTKEY ,
                type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
                type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST"
    | hash "type INTEGER PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage stageMarker4612 on all partitions :
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project "type INTEGER as PS_PARTKEY PS_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
               type DECIMAL as s_acctbal J1_s_acctbal ,
               type VARCHAR as s_name J1_s_name ,
               type VARCHAR as s_address J1_s_address ,
               type VARCHAR as s_phone J1_s_phone ,
               type VARCHAR as s_comment J1_s_comment "
    | combined 0
    | next

  stage stageMarker4615 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project "type INTEGER as PS_PARTKEY PS_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER as N_REGIONKEY J1_N_REGIONKEY ,
               type DECIMAL as s_acctbal s_acctbal ,
               type VARCHAR as s_name s_name ,
               type VARCHAR as n_name J1_n_name ,
               type VARCHAR as s_address s_address ,
               type VARCHAR as s_phone s_phone ,
               type VARCHAR as s_comment s_comment "

    | combined 0
    | next

  stage stageMarker4618 on all partitions :
    indexJoin region IxR_REGIONKEY "BOUND $I1 N_REGIONKEY =="
    | filter " type BOOLEAN  J1_R_NAME 'AFRICA'  == "
    | project "type INTEGER as PS_PARTKEY PS_PARTKEY ,
               type INTEGER as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type DECIMAL as s_acctbal s_acctbal ,
               type VARCHAR as s_name s_name ,
               type VARCHAR as r_name J1_r_name ,
               type VARCHAR as n_name n_name ,
               type VARCHAR as s_address s_address ,
               type VARCHAR as s_phone s_phone ,
               type VARCHAR as s_comment s_comment "
    | combined 0
    | next

  stage stageMarker4624 on all nodes :
    aggreg " GroupBy type INTEGER as ps_partkey $1
             aggregates
             type INTEGER as ps_partkey $K1 ,
             type DECIMAL as PS_SUPPLYCOST ) PS_SUPPLYCOST min ,
             type DECIMAL as s_acctbal s_acctbal ,
             type VARCHAR as s_name s_name ,
             type VARCHAR as r_name r_name ,
             type VARCHAR as n_name n_name ,
             type VARCHAR as s_address s_address ,
             type VARCHAR as s_phone s_phone ,
             type VARCHAR as s_comment s_comment "
    | hash "type INTEGER ps_partkey"
    | combined 0
    | next hashcast

  stage stageMarker4618 on all partitions :
    indexJoin part IxP_PARTKEY "BOUND $I1 ps_partkey ==" //J1
    | filter " type BOOLEAN  }  J1_P_TYPE '%STEEL'  6 matchTrailing
             J1_P_SIZE 20 == and"
    | project " type DECIMAL as s_acctbal s_acctbal ,
                type VARCHAR as s_name s_name ,
                type VARCHAR as n_name n_name ,
                type INTEGER as p_partkey J1_p_partkey ,
                type VARCHAR as p_mfgr J1_p_mfgr ,
                type VARCHAR as s_address s_address ,
                type VARCHAR as s_phone s_phone ,
                type VARCHAR as s_comment s_comment "

    | sort " type DECIMAL as s_acctbal s_acctbal ASC  ,
             type VARCHAR as n_name n_name ASC  ,
             type VARCHAR as s_name s_name ASC  ,
             type INTEGER as p_partkey p_partkey ASC  "

    | combined 0
    | next

  stage stageMarker4618_a on all nodes :
   sort " type DECIMAL as s_acctbal s_acctbal ASC ,
             type VARCHAR as n_name n_name ASC ,
             type VARCHAR as s_name s_name ASC ,
             type INTEGER as p_partkey p_partkey ASC"
    | combined 0
    | next

  stage stageMarker4618_b on origin :
     sort " type DECIMAL as s_acctbal s_acctbal ASC ,
               type VARCHAR as n_name n_name ASC ,
               type VARCHAR as s_name s_name ASC ,
               type INTEGER as p_partkey p_partkey ASC"
      | combined 0
      | next

  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

