  -- verified
  rows: 4

*/

// Below queries modified for dataset SF0001
// p_size < 15, and NO LIKE

/////////////////////
// Q02_0           //
/////////////////////

//------------------------------------------------------------------------------
// loopJoin running OOM with 5-way join
/*

explain stage transliterate
select s_acctbal, s_name, n_name, p_partkey, p_mfgr, s_address, s_phone, s_comment
     from part, supplier, partsupp, nation, region
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and p_size < 15
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE';

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker10800
  stage stageMarker10800 on all partitions :
    scan rapidsse public part
    | stageMarker10803 broadcast
  stage stageMarker10803 on all partitions :
    scanRight rapidsse public supplier
    | loopJoin 0 " 1  "
    | stageMarker10806 broadcast
  stage stageMarker10806 on all partitions :
    scanRight rapidsse public partsupp
    | loopJoin 0 " 1  "
    | stageMarker10809 broadcast
  stage stageMarker10809 on all partitions :
    scanRight rapidsse public nation
    | loopJoin 0 " 1  "
    | stageMarker10812 broadcast
  stage stageMarker10812 on all partitions :
    scanRight rapidsse public region
    | loopJoin 0 " 1  "
    | stageMarker10815
  stage stageMarker10815 on all partitions :
    filter 1 " type BOOLEAN  $1 $17 ==  $10 $18 ==  and  $6 15  <  and  $13 $22 ==  and  $24 $26 ==  and  $27 'EUROPE'  ==  and  "
    | project 0 " type DECIMAL as s_acctbal $15 , type VARCHAR as s_name $11 , type VARCHAR as n_name $23 , type INTEGER as p_partkey $1 , type VARCHAR as p_mfgr $3 , type VARCHAR as s_address $12 , type VARCHAR as s_phone $14 , type VARCHAR as s_comment $16 "
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;
*/

//------------------------------------------------------------------------------
// 4-way join supplier, partsupp, nation, region
/*
select s_acctbal, s_name, n_name, s_address, s_phone, s_comment
   from supplier, partsupp, nation, region
    where
    s_suppkey = ps_suppkey
    and s_nationkey = n_nationkey
    and n_regionkey = r_regionkey
    and r_name = 'EUROPE';
*/
--verfified
rows: 80

