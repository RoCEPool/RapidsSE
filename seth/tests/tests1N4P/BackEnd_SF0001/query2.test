// Below queries modified for dataset SF0001
// p_size < 15, and NO LIKE

/////////////////////
// Q02_0           //
/////////////////////

//------------------------------------------------------------------------------
// loopJoin running OOM with 5-way join
/*

explain stage transliterate
select s_acctbal, s_name, n_name, p_partkey, p_mfgr, s_address, s_phone, s_comment
     from part, supplier, partsupp, nation, region
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and p_size < 15
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE';

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker10800
  stage stageMarker10800 on all partitions :
    scan rapidsse public part
    | stageMarker10803 broadcast
  stage stageMarker10803 on all partitions :
    scanRight rapidsse public supplier
    | loopJoin 0 " 1  "
    | stageMarker10806 broadcast
  stage stageMarker10806 on all partitions :
    scanRight rapidsse public partsupp
    | loopJoin 0 " 1  "
    | stageMarker10809 broadcast
  stage stageMarker10809 on all partitions :
    scanRight rapidsse public nation
    | loopJoin 0 " 1  "
    | stageMarker10812 broadcast
  stage stageMarker10812 on all partitions :
    scanRight rapidsse public region
    | loopJoin 0 " 1  "
    | stageMarker10815
  stage stageMarker10815 on all partitions :
    filter 1 " type BOOLEAN  $1 $17 ==  $10 $18 ==  and  $6 15  <  and  $13 $22 ==  and  $24 $26 ==  and  $27 'EUROPE'  ==  and  "
    | project 0 " type DECIMAL as s_acctbal $15 , type VARCHAR as s_name $11 , type VARCHAR as n_name $23 , type INTEGER as p_partkey $1 , type VARCHAR as p_mfgr $3 , type VARCHAR as s_address $12 , type VARCHAR as s_phone $14 , type VARCHAR as s_comment $16 "
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

--verfified
rows: 16
*/

//------------------------------------------------------------------------------
// 4-way join supplier, partsupp, nation, region
/*
explain stage transliterate
select s_acctbal, s_name, n_name, s_address, s_phone, s_comment
   from supplier, partsupp, nation, region
    where
    s_suppkey = ps_suppkey
    and s_nationkey = n_nationkey
    and n_regionkey = r_regionkey
    and r_name = 'EUROPE';
*/

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker1935
  stage stageMarker1935 on all partitions :
    scan rapidsse public supplier
    | stageMarker1938 broadcast
  stage stageMarker1938 on all partitions :
    scanRight rapidsse public partsupp
    | loopJoin 0 " 1  "
    | stageMarker1941 broadcast
  stage stageMarker1941 on all partitions :
    scanRight rapidsse public nation
    | loopJoin 0 " 1  "
    | stageMarker1944 broadcast
  stage stageMarker1944 on all partitions :
    scanRight rapidsse public region
    | loopJoin 0 " 1  "
    | stageMarker1947
  stage stageMarker1947 on all partitions :
    filter 1 " type BOOLEAN  $1 $9 ==  $4 $13 ==  and  $15 $17 ==  and  $18 'EUROPE'  ==  and  "
    | project 0 " type DECIMAL as s_acctbal $6 , type VARCHAR as s_name $2 , type VARCHAR as n_name $14 , type VARCHAR as s_address $3 , type VARCHAR as s_phone $5 , type VARCHAR as s_comment $7 "
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

--verfified
rows: 80

//------------------------------------------------------------------------------
// 4-way join part, partsupp, nation, region
/*
explain stage transliterate
select p_partkey, p_mfgr
      from part, partsupp, nation, region
      where p_partkey = ps_partkey
      and p_size = 15
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE';
*/

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker3058
  stage stageMarker3058 on all partitions :
    scan rapidsse public part
    | stageMarker3061 broadcast
  stage stageMarker3061 on all partitions :
    scanRight rapidsse public partsupp
    | loopJoin 0 " 1  "
    | stageMarker3064 broadcast
  stage stageMarker3064 on all partitions :
    scanRight rapidsse public nation
    | loopJoin 0 " 1  "
    | stageMarker3067 broadcast
  stage stageMarker3067 on all partitions :
    scanRight rapidsse public region
    | loopJoin 0 " 1  "
    | stageMarker3070
  stage stageMarker3070 on all partitions :
    filter 1 " type BOOLEAN  $1 $10 ==  $6 15  ==  and  $17 $19 ==  and  $20 'EUROPE'  ==  and  "
    | project 0 " type INTEGER as p_partkey $1 , type VARCHAR as p_mfgr $3 "
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

--verfified
rows: 40

//------------------------------------------------------------------------------
// 4-way join part, supplier, partsupp, nation
/*
explain stage transliterate
select s_acctbal, s_name, p_partkey, p_mfgr, s_address, s_phone, s_comment
     from part, supplier, partsupp, nation
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and p_size = 15
      and s_nationkey = n_nationkey;
*/

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker4464
  stage stageMarker4464 on all partitions :
    scan rapidsse public part
    | stageMarker4467 broadcast
  stage stageMarker4467 on all partitions :
    scanRight rapidsse public supplier
    | loopJoin 0 " 1  "
    | stageMarker4470 broadcast
  stage stageMarker4470 on all partitions :
    scanRight rapidsse public partsupp
    | loopJoin 0 " 1  "
    | stageMarker4473 broadcast
  stage stageMarker4473 on all partitions :
    scanRight rapidsse public nation
    | loopJoin 0 " 1  "
    | stageMarker4476
  stage stageMarker4476 on all partitions :
    filter 1 " type BOOLEAN  $1 $17 ==  $10 $18 ==  and  $6 15  ==  and  $13 $22 ==  and  "
    | project 0 " type DECIMAL as s_acctbal $15 , type VARCHAR as s_name $11 , type INTEGER as p_partkey $1 , type VARCHAR as p_mfgr $3 , type VARCHAR as s_address $12 , type VARCHAR as s_phone $14 , type VARCHAR as s_comment $16 "
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

--verfified
rows: 8

