    | filter " type BOOLEAN  J1_R_NAME 'AFRICA'  == "
    | gbyAgg " GroupBy    type INTEGER as P_PARTKEY P_PARTKEY
               aggregates type INTEGER as P_PARTKEY $K1 ,
                          type DECIMAL as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST min "
    | combined 0
