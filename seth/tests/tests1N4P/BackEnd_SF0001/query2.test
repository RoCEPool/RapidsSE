/*
// modified query for the SF_0001 dataset
// p_size < 15
select s_acctbal, s_name, n_name, p_partkey, p_mfgr, s_address, s_phone, s_comment
     from part, supplier, partsupp, nation, region
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and p_size < 15
      and p_type like '%BRASS'
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE'
      and ps_supplycost = (
      select min(ps_supplycost)
      from partsupp, supplier, nation, region
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE' )
       order by s_acctbal desc, n_name, s_name, p_partkey;

    -- verfified
    rows:
    (6820.35,'Supplier#000000007','UNITED KINGDOM',47,'Manufacturer#4','s:4TicNGB4uO6PaSqNBUq','33-990-965-2201','s unwind silently furiously regular courts. final requests are deposits. requests wake quietly blit')

*/

// Below queries modified for dataset SF0001
// p_size < 15, and NO LIKE

/////////////////////
// Q02_0           //
/////////////////////

/////////////////////
// Q02_1           //
/////////////////////

//------------------------------------------------------------------------------
/*
select min(ps_supplycost)
      from partsupp, supplier, nation, region
      where s_suppkey = ps_suppkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE';
*/

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker5703
  stage stageMarker5703 on all partitions :
    scan rapidsse public partsupp
    | stageMarker5706 broadcast
  stage stageMarker5706 on all partitions :
    scanRight rapidsse public supplier
    | loopJoin 0 " 1  "
    | stageMarker5709 broadcast
  stage stageMarker5709 on all partitions :
    scanRight rapidsse public nation
    | loopJoin 0 " 1  "
    | stageMarker5712 broadcast
  stage stageMarker5712 on all partitions :
    scanRight rapidsse public region
    | loopJoin 0 " 1  "
    | stageMarker5715
  stage stageMarker5715 on all partitions :
    filter 1 " type BOOLEAN  $6 $2 ==  $9 $13 ==  and  $15 $17 ==  and  $18 'EUROPE'  ==  and  "
    | project 0 " type DECIMAL )  $4 min  "
    | stageMarker5718
  stage stageMarker5718 on all nodes :
    project 0 " type DECIMAL )  $1 min  "
    | stageMarker5721
  stage stageMarker5721 on origin :
    project 0 " type DECIMAL )  $1 min  "
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

rows:
--verfified
  (3.14)

CLEANUP {
  bye;
  mute
}


