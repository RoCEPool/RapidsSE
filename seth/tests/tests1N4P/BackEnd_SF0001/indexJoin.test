//------------------------------------------------------------------------------
// LEFT FILTER & PROJECT
// select c_custkey, c_nationkey from customer inner join orders on customer.c_custkey = orders.o_custkey
//   where c_nationkey >= 4;

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan customer
    | filter 1 "type boolean $4 4 >= "
    | project 0 "type integer $1 , type integer $4 "
    | stageC

  stage stageC on all partitions :
    indexJoin 1 orders orders_idx1 "BOUND $I1 $L1 =="
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA
end ;

