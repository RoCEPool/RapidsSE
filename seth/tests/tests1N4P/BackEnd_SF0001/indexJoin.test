begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan customer
    | filter 1 "type boolean $4 4 >= "
    | stageC

  stage stageC on all partitions :
    indexJoin 1 orders orders_idx1 "BOUND $I1 $L1 =="
    | filter 0 "type boolean $9 4 >= "
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA
end ;

