//------------------------------------------------------------------------------
// LEFT FILTER
// select * from customer inner join orders on customer.c_custkey = orders.o_custkey
//   where c_nationkey >= 4;

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan customer
    | filter 2 "type boolean $4 4 >= "
    | combined 0
    | stageC

  stage stageC on all partitions :
    indexJoin 2 orders orders_idx1 "BOUND $I1 $L1 ==" 
    | combined 0
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA
end ;

