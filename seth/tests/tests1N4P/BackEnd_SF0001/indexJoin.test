--------------------------------------------------------------------------------
-- INDEX JOIN tests --- PARTITIONED ON INDEX KEY (UNICAST)
-- verfied test results
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// CO-PARTITIONED INDEXJOIN
// CUSTOMER.C_CUSTKEY = ORDERS.O_CUSTKEY
// PtnKey[CUSTOMER] = C_CUSTKEY
// PtnKey[ORDERS] = O_CUSTKEY
// IdxKey[ORDERS] = O_CUSTKEY

//------------------------------------------------------------------------------
// INDEX JOIN
// select * from customer inner join orders on customer.c_custkey = orders.o_custkey;

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan customer
    | stageC

  stage stageC on all partitions :
    indexJoin 1 orders orders_idx1 "BOUND $I1 $L1 =="
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

end ;

rows: 1500


//------------------------------------------------------------------------------
// LEFT FILTER
// select * from customer inner join orders on customer.c_custkey = orders.o_custkey
//   where c_nationkey >= 4;

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan customer
    | filter 1 "type boolean $4 4 >= "
    | stageC

  stage stageC on all partitions :
    indexJoin 1 orders orders_idx1 "BOUND $I1 $L1 ==" | stageD

  stage stageD on origin :
    output
    | sink
    | stageA
end ;

rows: 1220


//------------------------------------------------------------------------------
// RIGHT FILTER
// select * from customer inner join orders on customer.c_custkey = orders.o_custkey
//   where orders.o_orderkey >= 4;

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan customer
    | stageC

  stage stageC on all partitions :
    indexJoin 1 orders orders_idx1 "BOUND $I1 $L1 =="
    | filter 0 "type boolean $9 4 >= "
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA
end ;

