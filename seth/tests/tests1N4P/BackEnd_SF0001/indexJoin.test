--------------------------------------------------------------------------------
-- INDEX JOIN tests --- PARTITIONED ON INDEX KEY (UNICAST)
-- verfied test results
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// CO-PARTITIONED INDEXJOIN
// CUSTOMER.C_CUSTKEY = ORDERS.O_CUSTKEY
// PtnKey[CUSTOMER] = C_CUSTKEY
// PtnKey[ORDERS] = O_CUSTKEY
// IdxKey[ORDERS] = O_CUSTKEY

//------------------------------------------------------------------------------
// INDEX JOIN
// select * from customer inner join orders on customer.c_custkey = orders.o_custkey;

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan customer
    | stageC

  stage stageC on all partitions :
    indexJoin 2 orders orders_idx1 "BOUND $I1 $L1 =="
    | combined 0
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

end ;

rows: 1500


//------------------------------------------------------------------------------
// INDEX JOIN
// select * from orders join customer on orders.o_custkey = customer.c_custkey;

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan orders
    | stageC

  stage stageC on all partitions :
    indexJoin 2 customer customer_idx1 "BOUND $I1 $L2 =="
    | combined 0
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

end ;

