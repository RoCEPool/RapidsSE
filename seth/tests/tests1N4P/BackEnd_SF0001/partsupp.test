-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table ${testName2}_partsupp (
PS_PARTKEY      INTEGER NOT NULL,
PS_SUPPKEY      INTEGER NOT NULL,
PS_AVAILQTY     INTEGER NOT NULL,
PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
PS_COMMENT      VARCHAR(199) NOT NULL
);
success

//------------------------------------------------------------------------------
// create an index on suppkey
CREATE INDEX IxPS_SUPPKEY ON ${testName2}_partsupp(ps_suppkey);
affected: 0

CREATE INDEX IxPS_PARTKEY ON ${testName2}_partsupp(ps_partkey);
affected: 0

// load the table
load ${testName2}_partsupp "../TPCH/SF_0001/partsupp.tbl";
success

select count(*) from ${testName2}_partsupp;
rows: (800)

compactidx ${testName2}_partsupp IxPS_SUPPKEY;
success

CLEANUP {

  bye;
  mute
}

