--------------------------------------------------------------------------------
-- tpch query6 (SF_0001)
--------------------------------------------------------------------------------
/*  (Query : modified l_discount range for SF0001)

select sum(l_extendedprice*l_discount) as revenue
    from lineitem
    where l_shipdate >= '1994-01-01'
    and l_shipdate < '1995-01-01'
    and l_discount between 1.05 - 0.01 and 1.05 + 0.01
    and l_quantity < 24;

*/

//------------------------------------------------------------------------------
// OPTIMIZED Q6
// SCAN -> INDEXSCAN
// 1.05 - 0.01 -> 1.04
// 1.05 + 0.01 -> 1.06
//------------------------------------------------------------------------------

pipeline unnamed
 begin
   stage stageStart on origin :
     start
     | pulse once
     | next
   stage stageMarker1642 on all partitions :
     indexscan lineitem IxL_SHIPDATE "LBOUND $I1 DATE '1994-01-01' >=
                                      UBOUND $I1 DATE '1995-01-01' <"
     | filter " type BOOLEAN  }  1.04 1.06 $7 between $5 24. < and"
     | project " type DECIMAL )  $6 $7 *  sum  "
     | combined 0
     | next
   stage stageMarker1645 on all nodes :
     project " type DECIMAL )  $1 sum  "
     | combined 0
     | next
   stage stageMarker1648 on origin :
     project " type DECIMAL as revenue )  $1 sum  "
     | combined 0
     | stageLast
   stage stageLast on origin :
     output
     | sink
     | stageStart
 end ;

row: (2141345.51)

CLEANUP {
  bye;
  mute
}


