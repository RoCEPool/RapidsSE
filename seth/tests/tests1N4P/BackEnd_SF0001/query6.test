//------------------------------------------------------------------------------
// Combined filter and project (with aggregate)

  pipeline unnamed
    begin
      stage stageStart on origin :
        start
        | pulse once
        | stageMarker1642
      stage stageMarker1642 on all partitions :
        scan rapidsse public lineitem
        | rlu 0 filter "type BOOLEAN  $11 DATE '1994-01-01'  >=  $11 DATE '1995-01-01'  <  and  $5 24  <  and
          $7 1.06 0.01 - >=  and $7 1.06 0.01 +  <= and" ,
          project "type DECIMAL )  $6 $7 *  sum  "
        | stageMarker1645
      stage stageMarker1645 on all nodes :
        project 0 " type DECIMAL )  $1 sum  "
        | stageMarker1648
      stage stageMarker1648 on origin :
        project 0 " type DECIMAL as revenue )  $1 sum  "
        | stageLast
      stage stageLast on origin :
        output
        | sink
        | stageStart
