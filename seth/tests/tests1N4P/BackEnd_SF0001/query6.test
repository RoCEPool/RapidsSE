//------------------------------------------------------------------------------
// OPTIMIZED Q6
// SCAN -> INDEXSCAN
// 1.05 - 0.01 -> 1.04
// 1.05 + 0.01 -> 1.06
// Need multiple threads per partition to improve performance
//------------------------------------------------------------------------------

/optimise_passthru 
pipeline Query6
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     indexscan ${testName2}_lineitem IxL_SHIPDATE "LBOUND $I1 DATE '1994-01-01' >= UBOUND $I1 DATE '1995-01-01' <"
     | filter " type BOOLEAN  }  1.04 1.06 L_DISCOUNT between L_QUANTITY 24. < and"
     | aggreg " type DECIMAL as REVENUE ) L_EXTENDEDPRICE L_DISCOUNT *  sum  "
     | combined 0
     | next

   stage S02 on all nodes :
     aggreg " type DECIMAL as REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S03 on origin :
     aggreg " type DECIMAL as REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S04 on origin :
     output
     | sink
     | first
end ;

