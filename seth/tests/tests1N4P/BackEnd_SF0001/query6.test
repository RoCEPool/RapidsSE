//------------------------------------------------------------------------------
// OPTIMIZED Q6
// SCAN -> INDEXSCAN
// 1.05 - 0.01 -> 1.04
// 1.05 + 0.01 -> 1.06
// Need multiple threads per partition to improve performance
//------------------------------------------------------------------------------

pipeline unnamed
 begin
   stage stageStart on origin :
     start
     | pulse once
     | next
   stage stageMarker1642 on all partitions :
     indexscan lineitem IxL_SHIPDATE "LBOUND $I1 DATE '1994-01-01' >=
                                      UBOUND $I1 DATE '1995-01-01' <"
     | filter " type BOOLEAN  }  1.04 1.06 $7 between $5 24. < and"
     | project " type DECIMAL )  $6 $7 *  sum  "
     | combined 0
     | next
   stage stageMarker1645 on all nodes :
     project " type DECIMAL )  $1 sum  "
     | combined 0
     | next
   stage stageMarker1648 on origin :
     project " type DECIMAL as revenue )  $1 sum  "
     | combined 0
     | stageLast
   stage stageLast on origin :
     output
     | sink
     | stageStart
 end ;

