--------------------------------------------------------------------------------
-- create customer table
--------------------------------------------------------------------------------

// create a table
create table ${testName2}_customer (
C_CUSTKEY       INTEGER NOT NULL,
C_NAME          VARCHAR(25) NOT NULL,
C_ADDRESS       VARCHAR(40) NOT NULL,
C_NATIONKEY     INTEGER NOT NULL,
C_PHONE         CHAR(15) NOT NULL,
C_ACCTBAL       DECIMAL(15,2) NOT NULL,
C_MKTSEGMENT    CHAR(10) NOT NULL,
C_COMMENT       VARCHAR(117) NOT NULL
);
success

//------------------------------------------------------------------------------
// create an index on custkey
create index IxC_CUSTKEY ON ${testName2}_CUSTOMER (C_CUSTKEY)  ;
affected: 0

// load the table
load ${testName2}_customer "../TPCH/SF_0001/customer.tbl";
success

select count(*) from ${testName2}_customer;
rows: (150)

compactidx ${testName2}_customer IxC_CUSTKEY;
success

CLEANUP {
}

