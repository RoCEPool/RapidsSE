/*  (original Query)
  select l_orderkey,
      sum(l_extendedprice*(1-l_discount)) as revenue,
      o_orderdate,
      o_shippriority
      from customer, orders, lineitem
      where c_mktsegment = 'BUILDING'
      and c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and o_orderdate < '1995-03-15'
      and l_shipdate > '1995-03-15'
      group by l_orderkey, o_orderdate, o_shippriority
      order by revenue desc, o_orderdate
      limit 10;

      select l_orderkey,
            sum(l_extendedprice*(1-l_discount)) as revenue from lineitem , orders where l_orderkey = o_orderkey
            and o_orderdate < '1995-03-15'
            group by l_orderkey;
*/

//------------------------------------------------------------------------------
// pipeline Generated
//------------------------------------------------------------------------------

/*

EXPLAIN STAGE TRANSLITERATE
select l_orderkey,
      sum(l_extendedprice*(1-l_discount)) as revenue,
      o_orderdate,
      o_shippriority
      from customer, orders, lineitem
      where c_mktsegment = 'BUILDING'
      and c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and o_orderdate < '1995-03-15'
      and l_shipdate > '1995-03-15'
      group by l_orderkey, o_orderdate, o_shippriority
      order by revenue desc, o_orderdate
      limit 10;

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker6340
  stage stageMarker6340 on all partitions :
    scan rapidsse public customer
    | stageMarker6343 broadcast
  stage stageMarker6343 on all partitions :
    scan rapidsse public orders
    | abstractJoin " 1  "
    | stageMarker6346 broadcast
  stage stageMarker6346 on all partitions :
    scan rapidsse public lineitem
    | abstractJoin " 1  "
    | stageMarker6349
  stage stageMarker6349 on all partitions :
    filter " type BOOLEAN  $7 ''BUILDING''  ==  $1 $10 ==  and  $18 $9 ==  and  $13 DATE ''1995-03-15''  <  and  $28 DATE ''1995-03-15''  >  and  "
    | gbyAgg " groupBy  type INTEGER as l_orderkey $18 , type DATE as o_orderdate $13 , type INTEGER as o_shippriority $16 aggregates  type INTEGER $K1 , type DECIMAL )  $23 1.  $24 -  *  sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | combined 0
    | stageMarker6352
  stage stageMarker6352 on all nodes :
    gbyAgg " groupBy  type INTEGER as l_orderkey $1 , type DATE as o_orderdate $3 , type INTEGER as o_shippriority $4 aggregates  type INTEGER $K1 , type DECIMAL )  $2 sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | combined 0
    | stageMarker6355
  stage stageMarker6355 on origin :
    gbyAgg " groupBy  type INTEGER as l_orderkey $1 , type DATE as o_orderdate $3 , type INTEGER as o_shippriority $4 aggregates  type INTEGER $K1 , type DECIMAL as revenue )  $2 sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | sort " type DECIMAL $2 DESC  , type DATE as o_orderdate $3 ASC  "
    | limit 10
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

*/

trackMemory;
success

//ORDERS PARTITIONED ON O_CUSTKEY
/optimise_passthru 
pipeline Query3
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Customer
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project "type INTEGER as C_CUSTKEY C_CUSTKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
    | filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-03-15' <"
    | project "type INTEGER as O_ORDERKEY J1_O_ORDERKEY ,
               type DATE as O_ORDERDATE J1_O_ORDERDATE ,
               type INTEGER as O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash "type INTEGER O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    sort "type INTEGER O_ORDERKEY ASC"
    | combined 0
    | next

  stage S04 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | filter "type BOOLEAN J1_L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg " ordGroupBy type INTEGER J1_L_ORDERKEY
               aggregates type INTEGER as L_ORDERKEY $K1 ,
                          type DECIMAL as REVENUE ) J1_L_EXTENDEDPRICE 1. J1_L_DISCOUNT -  *  sum  ,
                          type DATE as O_ORDERDATE  O_ORDERDATE ,
                          type INTEGER as O_SHIPPRIORITY O_SHIPPRIORITY "
    | combined 0
    | next

  stage S05 on all partitions :
    sort " type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S06 on all nodes :
    sort " type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S07 on origin :
    sort " type DECIMAL REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S08 on origin :
    output
    | sink
    | first
end ;
