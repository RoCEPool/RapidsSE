// added a projection to stageMarker6343 (reducing width of data)
// added a hash and hashcast ( as orders (partitioned on custkey) is being joined with lineitem on orderkey)
//------------------------------------------------------------------------------

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarker6340 on all partitions :
    indexscan Customer IxC_CUSTKEY "LBOUND $I1 0 >="
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
