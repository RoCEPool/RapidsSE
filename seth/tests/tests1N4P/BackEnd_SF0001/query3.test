--------------------------------------------------------------------------------
-- tpch query3 (SF_0001)
--------------------------------------------------------------------------------
/*  (original Query)
  select l_orderkey,
      sum(l_extendedprice*(1-l_discount)) as revenue,
      o_orderdate,
      o_shippriority
      from customer, orders, lineitem
      where c_mktsegment = 'BUILDING'
      and c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and o_orderdate < '1995-03-15'
      and l_shipdate > '1995-03-15'
      group by l_orderkey, o_orderdate, o_shippriority
      order by revenue desc, o_orderdate
      limit 10;
*/

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------

/*

// changed desc to asc

EXPLAIN STAGE TRANSLITERATE
select l_orderkey,
      sum(l_extendedprice*(1-l_discount)) as revenue,
      o_orderdate,
      o_shippriority
      from customer, orders, lineitem
      where c_mktsegment = 'BUILDING'
      and c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and o_orderdate < '1995-03-15'
      and l_shipdate > '1995-03-15'
      group by l_orderkey, o_orderdate, o_shippriority
      order by revenue asc, o_orderdate
      limit 10;

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker6340
  stage stageMarker6340 on all partitions :
    scan rapidsse public customer
    | stageMarker6343 broadcast
  stage stageMarker6343 on all partitions :
    scan rapidsse public orders
    | abstractJoin " 1  "
    | stageMarker6346 broadcast
  stage stageMarker6346 on all partitions :
    scan rapidsse public lineitem
    | abstractJoin " 1  "
    | stageMarker6349
  stage stageMarker6349 on all partitions :
    filter " type BOOLEAN  $7 ''BUILDING''  ==  $1 $10 ==  and  $18 $9 ==  and  $13 DATE ''1995-03-15''  <  and  $28 DATE ''1995-03-15''  >  and  "
    | aggreg " groupBy  type INTEGER as l_orderkey $18 , type DATE as o_orderdate $13 , type INTEGER as o_shippriority $16 aggregates  type INTEGER $K1 , type DECIMAL )  $23 1.  $24 -  *  sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | combined 0
    | stageMarker6352
  stage stageMarker6352 on all nodes :
    aggreg " groupBy  type INTEGER as l_orderkey $1 , type DATE as o_orderdate $3 , type INTEGER as o_shippriority $4 aggregates  type INTEGER $K1 , type DECIMAL )  $2 sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | combined 0
    | stageMarker6355
  stage stageMarker6355 on origin :
    aggreg " groupBy  type INTEGER as l_orderkey $1 , type DATE as o_orderdate $3 , type INTEGER as o_shippriority $4 aggregates  type INTEGER $K1 , type DECIMAL as revenue )  $2 sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | sort " type DECIMAL $2 DESC  , type DATE as o_orderdate $3 ASC  "
    | limit 10
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

*/

//------------------------------------------------------------------------------
// OPTIMIZED Q3_v1
// Changed all pipe to - next and first (makes it easier)
// Changed all Ordinal columns to Symbolic (makes it easier)
// Changed Scans followed by AbstractJoins to concrete joins
// Removed C_CUSTKEY J1_O_CUSTKEY ==  and
//                   J2_L_ORDERKEY J1_O_ORDERKEY ==
//   from filter in stage stageMarker6349 as part of join keys
// Moved SORT to a new stage as CodeSynthesizer does not allow
//     aggregates and sort operators in the same stage
// Modified DESC to ASC as DESC not yet supported
//------------------------------------------------------------------------------

trackMemory;
success

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

 stage stageMarker6340 on all partitions :
    scan rapidsse public customer
    | next

  stage stageMarker6343 on all partitions :
    //scan rapidsse public orders
    //| abstractJoin " 1  "
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="  // J1 - Orders
    | hash "type INTEGER J1_O_ORDERKEY"
    | combined 0
    | next hashcast

  stage stageMarker6346 on all partitions :
    //scan rapidsse public lineitem
    //| abstractJoin " 1  "
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 J1_O_ORDERKEY ==" // J2 - Lineitem
    | combined 0
    | next

  stage stageMarker6349 on all partitions :
    filter " type BOOLEAN  C_MKTSEGMENT 'BUILDING'  ==
                           //C_CUSTKEY J1_O_CUSTKEY ==  and
                           //J2_L_ORDERKEY J1_O_ORDERKEY ==  and
                           J1_O_ORDERDATE DATE '1995-03-15'  <  and
                           J2_L_SHIPDATE DATE '1995-03-15'  >  and  "

    | aggreg " groupBy  type INTEGER  J2_L_ORDERKEY ,
                        type DATE J1_O_ORDERDATE ,
                        type INTEGER J1_O_SHIPPRIORITY
                        aggregates
                        type INTEGER as J2_L_ORDERKEY $K1 ,
                        type DECIMAL )  J2_L_EXTENDEDPRICE 1.  J2_L_DISCOUNT -  *  sum  ,
                        type DATE as J1_O_ORDERDATE  $K2 ,
                        type INTEGER as J1_O_SHIPPRIORITY $K3 "

    | combined 0
    | next

  stage stageMarker6352 on all nodes :
    aggreg " groupBy  type INTEGER J2_L_ORDERKEY ,
                      type DATE J1_O_ORDERDATE ,
                      type INTEGER J1_O_SHIPPRIORITY
                      aggregates
                      type INTEGER as J2_L_ORDERKEY $K1 ,
                      type DECIMAL )  $2 sum  ,
                      type DATE as J1_O_ORDERDATE  $K2 ,
                      type INTEGER as J1_O_SHIPPRIORITY $K3 "
    | combined 0
    | next

  stage stageMarker6355 on origin :
    aggreg " groupBy type INTEGER J2_L_ORDERKEY ,
                     type DATE J1_O_ORDERDATE ,
                     type INTEGER J1_O_SHIPPRIORITY
                     aggregates
                     type INTEGER as J2_L_ORDERKEY $K1 ,
                     type DECIMAL )  $2 sum  ,
                     type DATE as J1_O_ORDERDATE  $K2 ,
                     type INTEGER as J1_O_SHIPPRIORITY $K3 "
    | combined 0
    | next

   stage stageNew on origin :
    //| sort " type DECIMAL REVENUE DESC  , type DATE as o_orderdate J1_O_ORDERDATE ASC  "
    sort " type DECIMAL as REVENUE $2 ASC  , type DATE as o_orderdate J1_O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

