    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

rows: 144
*/

//------------------------------------------------------------------------------
// POC pipeline
//------------------------------------------------------------------------------
pipeline Q3
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_CUSTOMER on all partitions :
    indexscan Customer IxC_CUSTKEY "LBOUND $I1 0 >="
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project expr type INTEGER as _custkey C_CUSTKEY
    | combined 0
    | next

  stage Gj_ORDERS on all partitions :
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 _custkey =="
     | filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-03-15' <"
     | project "type INTEGER as _orderkey J1_O_ORDERKEY ,
         type TIMESTAMP as O_ORDERDATE J1_O_ORDERDATE ,
         type INTEGER as O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash expr type INTEGER _orderkey
    | combined 0
    | next hashcast

  stage Gj_ORDERS_1 on all partitions :
    sort "type INTEGER _orderkey ASC"
    | combined 0
    | next

  stage Gj_LINEITEM on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 _orderkey =="
    | filter "type BOOLEAN J1_L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg expr ordgroupby type INTEGER _orderkey
            aggregates
            type INTEGER as _orderkey $K1 ,
            type DECIMAL as Revenue ) J1_L_EXTENDEDPRICE 1.0 J1_L_DISCOUNT - * sum ,
            type DATE as O_ORDERDATE O_ORDERDATE ,
            type INTEGER as O_SHIPPRIORITY  O_SHIPPRIORITY
    | combined 0
    | next

   stage last on origin :
    output
    | sink
    | first

end ;

rows: 144

//------------------------------------------------------------------------------
// limit 10
pipeline Q3
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_CUSTOMER on all partitions :
    indexscan Customer IxC_CUSTKEY "LBOUND $I1 0 >="
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project expr type INTEGER as _custkey C_CUSTKEY
    | combined 0
    | next

  stage Gj_ORDERS on all partitions :
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 _custkey =="
     | filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-03-15' <"
     | project "type INTEGER as _orderkey J1_O_ORDERKEY ,
         type TIMESTAMP as O_ORDERDATE J1_O_ORDERDATE ,
         type INTEGER as O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash expr type INTEGER _orderkey
    | combined 0
    | next hashcast

  stage Gj_ORDERS_1 on all partitions :
    sort "type INTEGER _orderkey ASC"
    | combined 0
    | next

  stage Gj_LINEITEM on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 _orderkey =="
    | filter "type BOOLEAN J1_L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg expr ordgroupby type INTEGER _orderkey
            aggregates
            type INTEGER as _orderkey $K1 ,
            type DECIMAL as Revenue ) J1_L_EXTENDEDPRICE 1.0 J1_L_DISCOUNT - * sum ,
            type DATE as O_ORDERDATE O_ORDERDATE ,
            type INTEGER as O_SHIPPRIORITY  O_SHIPPRIORITY
    | combined 0
    | next

  stage Gj_LINEITEM_TOP on origin :
    top "TOP type DECIMAL Revenue" 10
    | combined 0
    | next

   stage last on origin :
    output
    | sink
    | first

end ;

