    | combined 0
    | stageMarker6352
  stage stageMarker6352 on all nodes :
    aggreg " groupBy  type INTEGER as l_orderkey $1 ,
                      type TIMESTAMP as o_orderdate $3 ,
                      type INTEGER as o_shippriority $4
                      aggregates
                      type INTEGER $K1 ,
                      type DECIMAL )  $2 sum  ,
                      type TIMESTAMP $K2 ,
                      type INTEGER $K3 "
    | combined 0
    | stageMarker6355
  stage stageMarker6355 on origin :
    aggreg " groupBy  type INTEGER as l_orderkey $1 ,
                      type TIMESTAMP as o_orderdate $3 ,
                      type INTEGER as o_shippriority $4
                      aggregates
                      type INTEGER $K1 ,
                      type DECIMAL as revenue )  $2 sum  ,
                      type TIMESTAMP $K2 ,
                      type INTEGER $K3 "
    | sort " type DECIMAL $2 DESC  , type TIMESTAMP as o_orderdate $3 ASC  "
