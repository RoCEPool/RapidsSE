/* ORDERS partitioned on O_ORDERKEY */
/*
//ORDERS->LINEITEM->CUSTOMER
//SF10: 18s
/optimise_passthru 
pipeline Query3
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S02 on all partitions :
    indexScan Orders IxO_ORDERDATE "UBOUND $I1 DATE '1995-03-15' <"
    //| filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-03-15' <"
    | project "type INTEGER as O_ORDERKEY O_ORDERKEY , type INTEGER as O_CUSTKEY O_CUSTKEY , type DATE as O_ORDERDATE O_ORDERDATE , type INTEGER as O_SHIPPRIORITY O_SHIPPRIORITY"
    | combined 0
    | next

  stage S04 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | filter "type BOOLEAN J1_L_SHIPDATE DATE '1995-03-15' >"
    | project "type INTEGER as O_ORDERKEY O_ORDERKEY , type INTEGER as O_CUSTKEY O_CUSTKEY , type DATE as O_ORDERDATE O_ORDERDATE , type INTEGER as O_SHIPPRIORITY O_SHIPPRIORITY , type DECIMAL as L_EXTENDEDPRICE J1_L_EXTENDEDPRICE , type DECIMAL as L_DISCOUNT J1_L_DISCOUNT"
    | hash expr type INTEGER O_CUSTKEY
    | combined 0
    | next hashcast

 stage S01 on all partitions :
    indexJoin Customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
    | filter "type BOOLEAN J1_C_MKTSEGMENT 'BUILDING' =="
    | sort "type INTEGER O_ORDERKEY ASC"
    | combined 0
    | next

stage S03 on all partitions :
    ordAgg " ordGroupBy type INTEGER O_ORDERKEY aggregates type INTEGER as L_ORDERKEY $K1 , type DECIMAL as REVENUE ) L_EXTENDEDPRICE 1. L_DISCOUNT -  *  sum  , type DATE as O_ORDERDATE  O_ORDERDATE , type INTEGER as O_SHIPPRIORITY O_SHIPPRIORITY "
    | combined 0
    | next

   stage S05 on origin :
    top "TOP type DECIMAL Revenue" 10
    | combined 0
    | next

  stage S07 on origin :
    sort "type DECIMAL Revenue ASC"
    | combined 0
    | next

  stage S06 on origin :
    output
    | sink
    | first
end ;

