//------------------------------------------------------------------------------
// OPTIMIZED Q3_v4
// added a new stage stageNew2 to order the orderkey
// merged stage stageMarker6349 into stageMarker6346 replacing aggreg to ordAgg on only ORDERKEY
// removed stages stageMarker6349, stageMarker6352, stageMarker6355 (no longer needed with ordered aggregate)
//------------------------------------------------------------------------------

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageMarker6340 on all partitions :
    indexscan Customer IxC_CUSTKEY "LBOUND $I1 0 >="
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project expr type INTEGER as C_CUSTKEY C_CUSTKEY
    | combined 0
    | next

  stage stageMarker6343 on all partitions :
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="  // J1 - Orders
    | filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-03-15' <"
    | project "type INTEGER as J1_O_ORDERKEY J1_O_ORDERKEY ,
               type DATE as J1_O_ORDERDATE J1_O_ORDERDATE ,
               type INTEGER as J1_O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash expr type INTEGER J1_O_ORDERKEY
    | combined 0
    | next hashcast

  stage stageNew2 on all partitions :
    sort "type INTEGER J1_O_ORDERKEY ASC"
    | combined 0
    | next

  stage stageMarker6346 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 J1_O_ORDERKEY ==" // J2 - Lineitem
    | filter "type BOOLEAN J2_L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg " ordGroupBy type INTEGER J2_L_ORDERKEY
                        //type DATE J1_O_ORDERDATE ,
                        //type INTEGER J1_O_SHIPPRIORITY
                        aggregates
                        type INTEGER as J2_L_ORDERKEY $K1 ,
                        type DECIMAL as REVENUE )  J2_L_EXTENDEDPRICE 1.  J2_L_DISCOUNT -  *  sum  ,
                        type DATE as J1_O_ORDERDATE  J1_O_ORDERDATE ,
                        type INTEGER as J1_O_SHIPPRIORITY J1_O_SHIPPRIORITY "
    | combined 0
    | next

/*
  stage stageMarker6349 on all partitions :
    aggreg " groupBy  type INTEGER  J2_L_ORDERKEY ,
                        type DATE J1_O_ORDERDATE ,
                        type INTEGER J1_O_SHIPPRIORITY
                        aggregates
                        type INTEGER as J2_L_ORDERKEY $K1 ,
                        type DECIMAL as REVENUE )  J2_L_EXTENDEDPRICE 1.  J2_L_DISCOUNT -  *  sum  ,
                        type DATE as J1_O_ORDERDATE  $K2 ,
                        type INTEGER as J1_O_SHIPPRIORITY $K3 "
    | combined 0
    | next

  stage stageMarker6352 on all nodes :
    aggreg " groupBy  type INTEGER J2_L_ORDERKEY ,
                      type DATE J1_O_ORDERDATE ,
                      type INTEGER J1_O_SHIPPRIORITY
                      aggregates
                      type INTEGER as J2_L_ORDERKEY $K1 ,
                      type DECIMAL )  $2 sum  ,
                      type DATE as J1_O_ORDERDATE  $K2 ,
                      type INTEGER as J1_O_SHIPPRIORITY $K3 "
    | combined 0
    | next

  stage stageMarker6355 on origin :
    aggreg " ordGroupBy type INTEGER J2_L_ORDERKEY ,
                     type DATE J1_O_ORDERDATE ,
                     type INTEGER J1_O_SHIPPRIORITY
                     aggregates
                     type INTEGER as J2_L_ORDERKEY $K1 ,
                     type as REVENUE DECIMAL )  $2 sum  ,
                     type DATE as J1_O_ORDERDATE  $K2 ,
                     type INTEGER as J1_O_SHIPPRIORITY $K3 "
    | combined 0
    | next
*/
   stage stageNew on origin :
    sort " type DECIMAL $2 ASC  , type DATE as J1_O_ORDERDATE J1_O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

