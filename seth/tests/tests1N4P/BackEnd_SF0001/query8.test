    | combined 0
    | next

  stage stageMarkerH on all partitions :
    indexJoin ${testName2}_nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project "type INTEGER ( 19 ) as N_NATIONKEY N_NATIONKEY , type INTEGER ( 19 ) as O_YEAR O_YEAR , type DECIMAL ( 19  2 ) as VOLUME L_EXTENDEDPRICE 1.00 L_DISCOUNT -  * , type VARCHAR ( 0 ) as NATION N_NAME"
    | combined 0
    | next

  stage stageMarkerI on all partitions :
    gbyAgg " groupBy type INTEGER ( 19 ) O_YEAR aggregates type INTEGER ( 19 ) as O_YEAR $K1 , type DECIMAL ( 19  2 )  ) VOLUME sum  , type DECIMAL ( 19  2 ) )  } type DECIMAL ( 19  2 ) NATION 'BRAZIL'  ==  WHEN  VOLUME THEN  0.00  ELSE  ENDIF  CASE  sum  "
    | combined 0
