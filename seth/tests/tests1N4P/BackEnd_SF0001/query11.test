/optimise_passthru 
pipeline Query11
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan supplier
     | project " type INTEGER as S_SUPPKEY S_SUPPKEY ,
                type INTEGER as S_NATIONKEY S_NATIONKEY"
    | combined 0
    | next broadcast

  stage S01 on all partitions :
    indexJoin nation IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | filter " type BOOLEAN J1_N_NAME 'IRAQ'  ==  "
    | project " type INTEGER as S_SUPPKEY S_SUPPKEY"
    | combined 0
    | next

 stage S03 on all partitions :
    indexJoin partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | aggreg " type DECIMAL )  J1_PS_SUPPLYCOST J1_PS_AVAILQTY casttype DECIMAL CAST  *  sum  "
    | combined 0
    | next

  stage S04 on all nodes :
    aggreg " type DECIMAL as INNERRESULT )  $1 sum  "
    | combined 0
    | next

  stage S05 on origin :
    aggreg " type DECIMAL as INNERRESULT )  $1 sum "
    | combined 0
    | next broadcast

  stage S05 on origin :
    project " type DECIMAL as INNERRESULT $1 0.000001  *  "
    | combined 0
    | next broadcast

  stage S07 on all partitions :
    indexJoin supplier IxS_SUPPKEY "bound $I1"
    | project " type INTEGER as S_SUPPKEY J1_S_SUPPKEY ,
                type INTEGER as S_NATIONKEY J1_S_NATIONKEY ,
                type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S06 on all partitions :
    indexJoin nation IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | filter " type BOOLEAN J1_N_NAME 'IRAQ'  ==  "
    | project " type INTEGER as S_SUPPKEY S_SUPPKEY ,
                type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next broadcast

  stage S08 on all partitions :
    indexJoin partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | gbyAgg " groupBy    type INTEGER J1_PS_PARTKEY
               aggregates type INTEGER as PS_PARTKEY $K1 ,
                          type DECIMAL as VALUE )  J1_PS_SUPPLYCOST J1_PS_AVAILQTY casttype DECIMAL CAST  *  sum  ,
                          type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S09 on all nodes :
    gbyAgg " groupBy    type INTEGER PS_PARTKEY
             aggregates type INTEGER as PS_PARTKEY $K1 ,
                        type DECIMAL as VALUE ) VALUE sum  ,
                        type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S10 on origin :
    gbyAgg " groupBy    type INTEGER PS_PARTKEY
             aggregates type INTEGER as PS_PARTKEY $K1 ,
                        type DECIMAL as VALUE )  VALUE sum  ,
                        type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S11 on origin :
    filter " type BOOLEAN  value INNERRESULT  >  "
    | project " type INTEGER as PS_PARTKEY PS_PARTKEY ,
                type DECIMAL as VALUE VALUE"
    | sort " type DECIMAL VALUE DESC  "
    | combined 0
    | next

  stage S12 on origin :
    output
    | sink
    | first
end ;
