    | project " type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY , type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY , type DECIMAL ( 17  10 ) as INNERRESULT INNERRESULT "
