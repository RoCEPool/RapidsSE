  stage stageMarkerF on all partitions :
    indexJoin nation IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | filter " type BOOLEAN J1_N_NAME 'IRAQ'  ==  "
    | project " type INTEGER as S_SUPPKEY S_SUPPKEY , type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next broadcast

  stage stageMarkerG on all partitions :
    indexJoin partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | gbyAgg " groupBy type INTEGER J1_PS_PARTKEY aggregates type INTEGER as PS_PARTKEY $K1 , type DECIMAL )  J1_PS_SUPPLYCOST J1_PS_AVAILQTY casttype DECIMAL CAST  *  sum  , type DECIMAL as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage stageMarkerH on all nodes :
