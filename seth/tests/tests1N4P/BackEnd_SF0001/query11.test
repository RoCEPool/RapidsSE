/optimise_passthru 
pipeline Query11
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan ${testName2}_supplier
     | project " type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY ,
                type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY"
    | combined 0
    | next broadcast

  stage S01 on all partitions :
    indexJoin ${testName2}_nation IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | filter " type BOOLEAN N_NAME 'IRAQ'  ==  "
    | project " type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY"
    | combined 0
    | next

 stage S03 on all partitions :
    indexJoin ${testName2}_partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | aggreg " type DECIMAL ( 17  4 ) )  PS_SUPPLYCOST PS_AVAILQTY casttype DECIMAL ( 17  2 ) CAST  *  sum  "
    | combined 0
    | next

  stage S04 on all nodes :
    aggreg " type DECIMAL ( 17  4 ) as INNERRESULT )  $1 sum  "
    | combined 0
    | next

  stage S05 on origin :
    aggreg " type DECIMAL ( 17  24 ) as INNERRESULT )  $1 sum "
    | combined 0
    | next broadcast

  stage S05 on origin :
    project " type DECIMAL ( 17  10 ) as INNERRESULT $1 0.000001  *  "
    | combined 0
    | next broadcast

  stage S07 on all partitions :
    indexJoin ${testName2}_supplier IxS_SUPPKEY "bound $I1"
    | project " type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY ,
                type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
                type DECIMAL ( 17  10 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S06 on all partitions :
    indexJoin ${testName2}_nation IxN_NATIONKEY "bound $I1 S_NATIONKEY =="
    | filter " type BOOLEAN N_NAME 'IRAQ'  ==  "
    | project " type INTEGER ( 19 ) as S_SUPPKEY S_SUPPKEY ,
                type DECIMAL ( 17  10 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next broadcast

  stage S08 on all partitions :
    indexJoin ${testName2}_partsupp IxPS_SUPPKEY "bound $I1 S_SUPPKEY =="
    | gbyAgg " groupBy    type INTEGER ( 19 ) PS_PARTKEY
               aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                          type DECIMAL ( 17  4 ) as VALUE )  PS_SUPPLYCOST PS_AVAILQTY casttype DECIMAL ( 17  2 ) CAST  *  sum  ,
                          type DECIMAL ( 17  10 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S09 on all nodes :
    gbyAgg " groupBy    type INTEGER ( 19 ) PS_PARTKEY
             aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                        type DECIMAL ( 17  4 ) as VALUE ) VALUE sum  ,
                        type DECIMAL ( 17  10 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S10 on origin :
    gbyAgg " groupBy    type INTEGER ( 19 ) PS_PARTKEY
             aggregates type INTEGER ( 19 ) as PS_PARTKEY $K1 ,
                        type DECIMAL ( 17  4 ) as VALUE )  VALUE sum  ,
                        type DECIMAL ( 17  10 ) as INNERRESULT INNERRESULT"
    | combined 0
    | next

  stage S11 on origin :
    filter " type BOOLEAN  value INNERRESULT  >  "
    | project " type INTEGER ( 19 ) as PS_PARTKEY PS_PARTKEY ,
                type DECIMAL ( 17  4 ) as VALUE VALUE"
    | sort " type DECIMAL ( 17  4 ) VALUE DESC  "
    | combined 0
    | next

  stage S12 on origin :
    output
    | sink
    | first
end ;
