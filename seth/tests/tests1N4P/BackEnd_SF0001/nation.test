--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table ${testName}_nation (
N_NATIONKEY       INTEGER NOT NULL,
N_NAME            CHAR(25) NOT NULL,
N_REGIONKEY       INTEGER NOT NULL,
N_COMMENT         VARCHAR(152)
)
replicated
tableSize 1
;
success

//------------------------------------------------------------------------------
// create the indexes
CREATE INDEX IxN_NATIONKEY ON ${testName}_nation(N_NATIONKEY);
affected: 0

CREATE INDEX IxN_REGIONKEY ON ${testName}_nation(N_REGIONKEY);
affected: 0

// load the table
loadReplicated ${testName}_nation "../TPCH/SF_0001/nation.csv";
success

//select count(*) from ${testName}_nation;
//rows: (25)

compactidx ${testName}_nation IxN_NATIONKEY;
success

compactidx ${testName}_nation IxN_REGIONKEY;
success

CLEANUP {
  bye;
  mute
}

