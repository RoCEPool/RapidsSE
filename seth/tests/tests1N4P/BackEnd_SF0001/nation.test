--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table nation (
N_NATIONKEY       INTEGER NOT NULL,
N_NAME            CHAR(25) NOT NULL,
N_REGIONKEY       INTEGER NOT NULL,
N_COMMENT         VARCHAR(152)
);
success

//------------------------------------------------------------------------------
// create an index on suppkey
CREATE INDEX nation_idx1 ON nation(N_NATIONKEY);
affected: 0

// load the table
load nation "../TPCH/SF_0001/nation.csv";
success

select count(*) from nation;
rows: (25)

compactidx nation nation_idx1;
success

CLEANUP {
  bye;
  mute
}

