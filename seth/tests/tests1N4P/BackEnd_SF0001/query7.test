       scan rapidsse public nation
       | abstractJoin " true  "
       | stageMarker2197 broadcast
     stage stageMarker2197 on all partitions :
       scan rapidsse public nation
       | abstractJoin " true  "
       | stageMarker2200
     stage stageMarker2200 on all partitions :
       filter " type BOOLEAN  $1 $10 ==  $24 $8 ==  and  $33 $25 ==  and  $4 $41 ==  and  $36 $45 ==  and  $42 ''IRAN''  ==  $46 ''GERMANY''  ==  and  $42 ''GERMANY''  ==  $46 ''IRAN''  ==  and  or  and  }  DATE ''1995-01-01''  DATE ''1996-12-31''  $18 between  and  "
       | project " type VARCHAR as supp_nation $42 , type VARCHAR as cust_nation $46 , type INTEGER as l_year $18 extract_year  , type DECIMAL as volume $13 1.00  $14 -  *  "
       | combined 0
       | stageMarker2203
     stage stageMarker2203 on all partitions :

       stageLast
     stage stageLast on origin :
       output
       | sink
       | stageStart
   end

   stage stageStart on origin :
     start
     | pulse once
     | stageMarker2206
   stage stageMarker2206 on all partitions :
     call "shipping "
     | gbyAgg " groupBy  type VARCHAR as supp_nation $1 , type VARCHAR as cust_nation $2 , type INTEGER as l_year $3 aggregates  type VARCHAR $K1 , type VARCHAR $K2 , type INTEGER $K3 , type DECIMAL )  $4 sum  "
     | combined 0
     | stageMarker2209
   stage stageMarker2209 on all nodes :
     gbyAgg " groupBy  type VARCHAR as supp_nation $1 , type VARCHAR as cust_nation $2 , type INTEGER as l_year $3 aggregates  type VARCHAR $K1 , type VARCHAR $K2 , type INTEGER $K3 , type DECIMAL )  $4 sum  "
     | combined 0
     | stageMarker2212
   stage stageMarker2212 on origin :
     gbyAgg " groupBy  type VARCHAR as supp_nation $1 , type VARCHAR as cust_nation $2 , type INTEGER as l_year $3 aggregates  type VARCHAR $K1 , type VARCHAR $K2 , type INTEGER $K3 , type DECIMAL as revenue )  $4 sum  "
     | sort " type VARCHAR as supp_nation $1 ASC  , type VARCHAR as cust_nation $2 ASC  , type INTEGER as l_year $3 ASC  "
