--------------------------------------------------------------------------------
-- INDEX SCAN tests ---
-- index orders_idx1 on o_custkey
-- index orders_idx2 pn o_orderkey
-- verfied test results
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// select * from orders where o_orderkey > 5;

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    indexScan 1 orders orders_idx2 "LBOUND $I1 5 >"
    | stageC

  stage stageC on origin :
    output
    | sink
    | stageA

end ;

rows: 1495

//------------------------------------------------------------------------------
// select * from orders where o_orderkey >= 5;

