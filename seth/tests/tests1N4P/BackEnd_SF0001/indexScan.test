--------------------------------------------------------------------------------
-- INDEX SCAN tests ---
-- index IxO_CUSTKEY on o_custkey
-- index IxO_ORDERKEY pn o_orderkey
-- verfied test results
--------------------------------------------------------------------------------

trackmemory force;
success;

//------------------------------------------------------------------------------
// select * from orders where o_orderkey > 5;

/optimise_passthru 
pipeline indexScanTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    indexScan ${testName2}_orders IxO_ORDERKEY "LBOUND $I1 5 >"
    | combined 0
    | stageC

  stage stageC on origin :
    output
    | sink
    | stageA

end ;

rows: 1495

