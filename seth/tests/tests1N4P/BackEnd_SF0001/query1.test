/*  (original Query)
  select l_returnflag, l_linestatus,
        sum(l_quantity) as sum_qty,
        sum(l_extendedprice) as sum_base_price,
        sum(l_extendedprice*(1-l_discount)) as sum_disc_price,
        sum(l_extendedprice*(1-l_discount)*(1+l_tax)) as sum_charge,
        avg(l_quantity) as avg_qty,
        avg(l_extendedprice) as avg_price,
        avg(l_discount) as avg_disc,
        count(*) as count_order
        from ${testName2}_lineitem
        where l_shipdate <= DATE '1998-09-01'
        group by l_returnflag, l_linestatus
        order by l_returnflag, l_linestatus;
*/

//------------------------------------------------------------------------------
// pipeline Generated
//------------------------------------------------------------------------------
/*

EXPLAIN STAGE TRANSLITERATE
select
         l_returnflag,
         l_linestatus,
         sum(l_quantity)                                     as sum_qty,
         sum(l_extendedprice)                                as sum_base_price,
         sum(l_extendedprice * (1-l_discount))               as sum_disc_price,
         sum(l_extendedprice * (1-l_discount) * (1 + l_tax)) as sum_charge,
         avg(l_quantity)                                     as avg_qty,
         avg(l_extendedprice)                                as avg_price,
         avg(l_discount)                                     as avg_disc,
         count(*)                                            as count_order
  from ${testName2}_LineItem where l_shipdate <= TIMESTAMP '1998-09-01 00:00:00'
  group by l_returnflag, l_linestatus
  order by l_returnflag, l_linestatus;

/optimise_passthru 
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker4857
  stage stageMarker4857 on all partitions :
    scan rapidsse public ${testName2}_LineItem
    | filter " type BOOLEAN  $11 casttype TIMESTAMP CAST  TIMESTAMP ''1998-09-01 00:00:00''  <=  "
    | gbyAgg " groupBy  type VARCHAR ( 0 ) as l_returnflag $9 , type VARCHAR ( 0 ) as l_linestatus $10 aggregates  type VARCHAR ( 0 ) $K1 , type VARCHAR ( 0 ) $K2 , type DECIMAL ( 19  2 ) )  $5 sum  , type DECIMAL ( 19  2 ) )  $6 sum  , type DECIMAL ( 19  2 ) )  $6 1.00  $7 -  *  sum  , type DECIMAL ( 19  2 ) )  $6 1.00  $7 -  *  1.00  $8 +  *  sum  , type INTEGER ( 19 ) )  $5 count  , type INTEGER ( 19 ) )  $6 count  , type DECIMAL ( 19  2 ) )  $7 sum  , type INTEGER ( 19 ) )  $7 count  , type INTEGER ( 19 ) )  countAll  "
    | combined 0
    | stageMarker4860
  stage stageMarker4860 on all nodes :
    gbyAgg " groupBy  type VARCHAR ( 0 ) as l_returnflag $1 , type VARCHAR ( 0 ) as l_linestatus $2 aggregates  type VARCHAR ( 0 ) $K1 , type VARCHAR ( 0 ) $K2 , type DECIMAL ( 19  2 ) )  $3 sum  , type DECIMAL ( 19  2 ) )  $4 sum  , type DECIMAL ( 19  2 ) )  $5 sum  , type DECIMAL ( 19  2 ) )  $6 sum  , type INTEGER ( 19 ) )  $7 sum  , type INTEGER ( 19 ) )  $8 sum  , type DECIMAL ( 19  2 ) )  $9 sum  , type INTEGER ( 19 ) )  $10 sum  , type INTEGER ( 19 ) )  $11 sum  "
    | combined 0
    | stageMarker5083
  stage stageMarker5083 on origin :
    gbyAgg " groupBy  type VARCHAR ( 0 ) as l_returnflag $1 , type VARCHAR ( 0 ) as l_linestatus $2 aggregates  type VARCHAR ( 0 ) $K1 , type VARCHAR ( 0 ) $K2 , type DECIMAL ( 19  2 ) as sum_qty )  $3 sum  , type DECIMAL ( 19  2 ) as sum_base_price )  $4 sum  , type DECIMAL ( 19  2 ) as sum_disc_price )  $5 sum  , type DECIMAL ( 19  2 ) as sum_charge )  $6 sum  , type INTEGER ( 19 ) as count_order )  $11 sum  , type INTEGER ( 19 ) )  $7 sum  , type INTEGER ( 19 ) )  $8 sum  , type INTEGER ( 19 ) )  $10 sum  , type DECIMAL ( 19  2 ) )  $9 sum  "
    | combined 0
    | stageMarker4863
  stage stageMarker4863 on origin :
    project " type VARCHAR ( 0 ) as l_returnflag $1 , type VARCHAR ( 0 ) as l_linestatus $2 , type DECIMAL ( 19  2 ) as sum_qty $3 , type DECIMAL ( 19  2 ) as sum_base_price $4 , type DECIMAL ( 19  2 ) as sum_disc_price $5 , type DECIMAL ( 19  2 ) as sum_charge $6 , type DECIMAL ( 19  2 ) as avg_qty $3 $8 casttype DECIMAL ( 19  2 ) CAST  /  , type DECIMAL ( 19  2 ) as avg_price $4 $9 casttype DECIMAL ( 19  2 ) CAST  /  , type DECIMAL ( 19  2 ) as avg_disc $11 $10 casttype DECIMAL ( 19  2 ) CAST  /  , type INTEGER ( 19 ) as count_order $7 "
    | sort " type VARCHAR ( 0 ) as l_returnflag $1 ASC  , type VARCHAR ( 0 ) as l_linestatus $2 ASC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;
*/

trackmemory force;
success

//------------------------------------------------------------------------------
// OPTIMIZED Q1
// next and first
// Need multiple threads per partition to improve performance
//------------------------------------------------------------------------------
/optimise_passthru 
pipeline Query1
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public ${testName2}_lineitem
    | filter " type BOOLEAN  $11 DATE '1998-09-01'  <=  "
    | gbyAgg " groupBy  type VARCHAR ( 0 ) L_RETURNFLAG , type VARCHAR ( 0 ) L_LINESTATUS
      aggregates
      type VARCHAR ( 0 ) as L_RETURNFLAG $K1 ,
      type VARCHAR ( 0 ) as L_LINESTATUS $K2 ,
      type DECIMAL ( 17  2 ) as SUM_QTY ) L_QUANTITY sum  ,
      type DECIMAL ( 17  2 ) as SUM_BASE_PRICE ) L_EXTENDEDPRICE sum  ,
      type DECIMAL ( 17  2 ) as SUM_DISC_PRICE ) L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  ,
      type DECIMAL ( 17  2 ) as SUM_CHARGE ) L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  1.  L_TAX +  *  sum  ,
      type INTEGER ( 19 ) ) L_EXTENDEDPRICE count  ,
      type INTEGER ( 19 ) ) L_QUANTITY count  ,
      type DECIMAL ( 17  2 ) ) L_DISCOUNT sum  ,
      type INTEGER ( 19 ) ) L_DISCOUNT count  ,
      type INTEGER ( 19 ) ) countAll  "
    | combined 0
    | next

  stage S02 on all nodes :
    gbyAgg " groupBy  type VARCHAR ( 0 ) L_RETURNFLAG , type VARCHAR ( 0 ) L_LINESTATUS
      aggregates
      type VARCHAR ( 0 ) as L_RETURNFLAG $K1 ,
      type VARCHAR ( 0 ) as L_LINESTATUS $K2 ,
      type DECIMAL ( 17  2 ) as SUM_QTY ) SUM_QTY sum ,
      type DECIMAL ( 17  2 ) as SUM_BASE_PRICE ) SUM_BASE_PRICE sum ,
      type DECIMAL ( 17  2 ) as SUM_DISC_PRICE ) SUM_DISC_PRICE sum ,
      type DECIMAL ( 17  2 ) as SUM_CHARGE ) SUM_CHARGE sum ,
      type INTEGER ( 19 ) ) $7 sum ,
      type INTEGER ( 19 ) ) $8 sum ,
      type DECIMAL ( 17  2 ) ) $9 sum ,
      type INTEGER ( 19 ) ) $10 sum ,
      type INTEGER ( 19 ) ) $11 sum "
    | combined 0
    | next

  stage S03 on origin :
    gbyAgg " groupBy  type VARCHAR ( 0 ) L_RETURNFLAG , type VARCHAR ( 0 ) L_LINESTATUS
      aggregates
      type VARCHAR ( 0 ) as L_RETURNFLAG $K1 ,
      type VARCHAR ( 0 ) as L_LINESTATUS $K2 ,
      type DECIMAL ( 17  2 ) as SUM_QTY ) SUM_QTY sum ,
      type DECIMAL ( 17  2 ) as SUM_BASE_PRICE ) SUM_BASE_PRICE sum ,
      type DECIMAL ( 17  2 ) as SUM_DISC_PRICE ) SUM_DISC_PRICE sum ,
      type DECIMAL ( 17  2 ) as SUM_CHARGE ) SUM_CHARGE sum ,
      type INTEGER ( 19 ) ) $7 sum ,
      type INTEGER ( 19 ) ) $8 sum ,
      type DECIMAL ( 17  2 ) ) $9 sum ,
      type INTEGER ( 19 ) ) $10 sum ,
      type INTEGER ( 19 ) as COUNT_ORDER ) $11 sum"
    | combined 0
    | next

  stage S04 on origin :
    project "
      type VARCHAR ( 0 ) as L_RETURNFLAG L_RETURNFLAG ,
      type VARCHAR ( 0 ) as L_LINESTATUS L_LINESTATUS ,
      type DECIMAL ( 17  2 ) as SUM_QTY SUM_QTY ,
      type DECIMAL ( 17  2 ) as SUM_BASE_PRICE SUM_BASE_PRICE ,
      type DECIMAL ( 17  2 ) as SUM_DISC_PRICE SUM_DISC_PRICE ,
      type DECIMAL ( 17  2 ) as SUM_CHARGE SUM_CHARGE ,
      type DECIMAL ( 17  2 ) as AVG_QTY SUM_QTY $8 casttype DECIMAL ( 17  0 ) CAST  / ,
      type DECIMAL ( 17  2 ) as AVG_PRICE SUM_BASE_PRICE $7 casttype DECIMAL ( 17  0 ) CAST  / ,
      type DECIMAL ( 17  2 ) as AVG_DISC $9 $10 casttype DECIMAL ( 17  0 ) CAST  / ,
      type INTEGER ( 19 ) as COUNT_ORDER COUNT_ORDER "
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;

