--------------------------------------------------------------------------------
-- tpch query1 (SF_0001)
--------------------------------------------------------------------------------
/*  (original Query)
  select l_returnflag, l_linestatus,
        sum(l_quantity) as sum_qty,
        sum(l_extendedprice) as sum_base_price,
        sum(l_extendedprice*(1-l_discount)) as sum_disc_price,
        sum(l_extendedprice*(1-l_discount)*(1+l_tax)) as sum_charge,
        avg(l_quantity) as avg_qty,
        avg(l_extendedprice) as avg_price,
        avg(l_discount) as avg_disc,
        count(*) as count_order
        from lineitem
        where l_shipdate <= '1998-12-01 00:00:00' - interval'[DELTA]'day(3)
        group by l_returnflag, l_linestatus
        order by l_returnflag, l_linestatus;
*/

//------------------------------------------------------------------------------
// pipeline by compiler
/*
explain stage transliterate
   select l_returnflag, l_linestatus,
      sum(l_quantity) as sum_qty,
      sum(l_extendedprice) as sum_base_price,
      sum(l_extendedprice*(1-l_discount)) as sum_disc_price,
      sum(l_extendedprice*(1-l_discount)*(1+l_tax)) as sum_charge,
      avg(l_quantity) as avg_qty,
      avg(l_extendedprice) as avg_price,
      avg(l_discount) as avg_disc,
      count(*) as count_order
      from lineitem
      where l_shipdate <= DATE '1998-12-01'
      group by l_returnflag, l_linestatus;
*/
pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker1962
  stage stageMarker1962 on all partitions :
    scan rapidsse public lineitem
    | filter " type BOOLEAN  $11 DATE '1998-09-01'  <=  "
    | aggreg " type VARCHAR as l_returnflag $9 , type VARCHAR as l_linestatus $10 , type DECIMAL )  $5 sum  , type DECIMAL )  $6 sum  , type DECIMAL )  $6 1  $7 -  *  sum  , type DECIMAL )  $6 1  $7 -  *  1  $8 +  *  sum  , type INTEGER )  $5 count  , type INTEGER )  $6 count  , type DECIMAL )  $7 sum  , type INTEGER )  $7 count  , type INTEGER )  countAll  groupBy  type VARCHAR as l_returnflag $9 , type VARCHAR as l_linestatus $10 "
    | stageMarker1965
  stage stageMarker1965 on all nodes :
    aggreg " type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 , type DECIMAL )  $3 sum  , type DECIMAL )  $4 sum  , type DECIMAL )  $5 sum  , type DECIMAL )  $6 sum  , type INTEGER )  $7 sum  , type INTEGER )  $8 sum  , type DECIMAL )  $9 sum  , type INTEGER )  $10 sum  , type INTEGER )  $11 sum  groupBy  type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 "
    | stageMarker1968
  stage stageMarker1968 on origin :
    aggreg " type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 , type DECIMAL as sum_qty )  $3 sum  , type DECIMAL as sum_base_price )  $4 sum  , type DECIMAL as sum_disc_price )  $5 sum  , type DECIMAL as sum_charge )  $6 sum  , type INTEGER as count_order )  $11 sum  , type INTEGER )  $7 sum  , type INTEGER )  $8 sum  , type INTEGER )  $10 sum  , type DECIMAL )  $9 sum  groupBy  type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 "
    | aggreg 0 " type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 , type DECIMAL as sum_qty $3 , type DECIMAL as sum_base_price $4 , type DECIMAL as sum_disc_price $5 , type DECIMAL as sum_charge $6 , type DECIMAL as avg_qty $3 $8 /  , type DECIMAL as avg_price $4 $9 /  , type DECIMAL as avg_disc $11 $10 /  , type INTEGER as count_order $7 groupBy  type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 "
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

rows:
  ('N','O',2258.00,3438882.56,-159016.85,-325491.50,24.02,36583.85,1.05,94)

CLEANUP {
  bye;
  mute
}


