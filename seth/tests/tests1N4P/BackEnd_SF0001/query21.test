/*  (original Query)

select
  s_name,
  count(*) as numwait

  from ${testName2}_Supplier, ${testName2}_LineItem l1, ${testName2}_Orders, ${testName2}_Nation

 where     s_suppkey        = l1.l_suppkey
       and o_orderkey       = l1.l_orderkey
       and o_orderstatus    = 'F'
       and l1.l_receiptdate > l1.l_commitdate
       and exists

             ( select *

                 from ${testName2}_LineItem l2

                where     L2.L_ORDERKEY =  L1.L_ORDERKEY
                      and L2.L_SUPPKEY  <> L1.L_SUPPKEY )
                      and not exists

             ( select *

                 from ${testName2}_LineItem l3

                where     L3.L_ORDERKEY    =  L1.L_ORDERKEY
                      and L3.L_SUPPKEY     <> L1.L_SUPPKEY
                      and L3.L_RECEIPTDATE >  L3.L_COMMITDATE )

       and s_nationkey = n_nationkey
       and n_name = 'SAUDI ARABIA'

 group by s_name

 order by numwait desc, s_name
 limit 100;



select

  s_nationkey,
  s_name

  from ${testName2}_Supplier, ${testName2}_LineItem l1, ${testName2}_Orders

 where     s_suppkey        = l1.l_suppkey
       and o_orderkey       = l1.l_orderkey
       and o_orderstatus    = 'F'
       and l1.l_receiptdate > l1.l_commitdate
       and exists

             ( select *

                 from ${testName2}_LineItem l2

                where     L2.L_ORDERKEY =  L1.L_ORDERKEY
                      and L2.L_SUPPKEY  <> L1.L_SUPPKEY )
                      and not exists

             ( select *

                 from ${testName2}_LineItem l3

                where     L3.L_ORDERKEY    =  L1.L_ORDERKEY
                      and L3.L_SUPPKEY     <> L1.L_SUPPKEY
                      and L3.L_RECEIPTDATE >  L3.L_COMMITDATE )


 order by s_nationkey;
*/

