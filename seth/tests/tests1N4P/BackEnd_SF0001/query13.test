/*  (original Query)


select
       c_count,
       count(*) as custdist
from (
       select
              c_custkey,
              count(o_orderkey) as c_count
       from
              ${testName}_customer left outer join ${testName}_orders on
                     c_custkey = o_custkey
              and o_comment not like '%special%requests%'
       group by
              c_custkey

     ) as c_orders (c_custkey, c_count)
group by
     c_count
order by
     c_count,
     custdist
;

--verified
rows:
  (10,135)
  (9,11)
  (8,2)
  (20,1)
  (0,1)

*/

