// added filters earlier
// SF10: 2.9 secs
pipeline unamed
 begin
   stage stageStart on origin :
     start
     | pulse once
     | next

   stage stageMarker2359 on all partitions :
     scan rapidsse public LineItem
     | filter "type BOOLEAN l_quantity 1.00 >= l_quantity 30.00 <= and
               }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and
                L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and"
     | project " type INTEGER as l_partkey l_partkey , type DECIMAL as l_quantity l_quantity , type DECIMAL as l_discount l_discount , type DECIMAL as l_extendedprice l_extendedprice , type VARCHAR as l_shipmode l_shipmode , type VARCHAR as l_shipinstruct l_shipinstruct"
     | hash "type INTEGER l_partkey"
     | combined 0
     | next hashcast

   stage stageMarker2362 on all partitions :
     indexJoin part IxP_PARTKEY "BOUND $I1 l_partkey ==" //J1
     | project " type INTEGER as l_partkey l_partkey , type DECIMAL as l_quantity l_quantity , type DECIMAL as l_discount l_discount , type DECIMAL as l_extendedprice l_extendedprice  , type VARCHAR as l_shipmode l_shipmode , type VARCHAR as l_shipinstruct l_shipinstruct ,
                 type INTEGER as p_size j1_p_size , type VARCHAR as p_brand j1_p_brand , type varchar as p_container j1_p_container"
     | filter " type BOOLEAN
                  P_BRAND 'Brand#12'  ==
                  }  'SM CASE'  'M BOX'  'SM PACK'  'SM PKG'  #4  P_CONTAINER in  and
                  }  L_QUANTITY 1.0 >= L_QUANTITY 11.0 <= and and
                  }  1  5  P_SIZE between  and
                  }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and
                  L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and

                  P_BRAND 'Brand#23'  ==
                  }  'MED BAG'  'MED BOX'  'MED PKG'  'MED PACK'  #4 P_CONTAINER in and
                  }  L_QUANTITY 10.0 >= L_QUANTITY 20.0 <= and and
                  }  1  10  P_SIZE between  and
                  }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and
                  L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and  or

                  P_BRAND 'Brand#34'  ==
                  }  'LG CASE'  'LG BOX'  'LG PACK'  'LG PKG'  #4  P_CONTAINER in  and
                  }  L_QUANTITY 20.0 >= L_QUANTITY 30.0 <= and and
                  }  1  15  P_SIZE between  and
                  }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and
                  L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and  or  "

     | combined 0
     | next

  stage stageMarker2368 on all partitions :
     aggreg " type DECIMAL )  l_extendedprice 1.00  l_discount -  *  sum  "
     | combined 0
     | next

   stage stageMarker2368_a on all nodes :
     aggreg " type DECIMAL )  $1 sum  "
     | combined 0
     | next

   stage stageMarker2371 on origin :
     aggreg " type DECIMAL as revenue )  $1 sum  "
     | combined 0
     | next

   stage stageLast on origin :
     output
     | sink
     | stageStart
 end ;
