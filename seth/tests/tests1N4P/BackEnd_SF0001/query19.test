/*  (original Query)

select sum(l_extendedprice * (1 - l_discount) ) as revenue
     from lineitem, part
     where ( p_partkey = l_partkey
     and p_brand = 'Brand#12'
     and p_container in ( 'SM CASE', 'M BOX', 'SM PACK', 'SM PKG')
     and l_quantity >= 1 and l_quantity <= 1 + 10
     and p_size between 1 and 5
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' )
     or ( p_partkey = l_partkey
     and p_brand = 'Brand#23'
     and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')
     and l_quantity >= 10 and l_quantity <= 10 + 10
     and p_size between 1 and 10
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' )
     or ( p_partkey = l_partkey
     and p_brand = 'Brand#34'
     and p_container in ( 'LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')
     and l_quantity >= 20 and l_quantity <= 20 + 10
     and p_size between 1 and 15
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' );

*/

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------

/*
EXPLAIN STAGE TRANSLITERATE
select sum(l_extendedprice * (1 - l_discount) ) as revenue
     from lineitem, part
     where ( p_partkey = l_partkey
     and p_brand = 'Brand#12'
     and p_container in ( 'SM CASE', 'M BOX', 'SM PACK', 'SM PKG')
     and l_quantity >= 1 and l_quantity <= 1 + 10
     and p_size between 1 and 5
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' )
     or ( p_partkey = l_partkey
     and p_brand = 'Brand#23'
     and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')
     and l_quantity >= 10 and l_quantity <= 10 + 10
     and p_size between 1 and 10
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' )
     or ( p_partkey = l_partkey
     and p_brand = 'Brand#34'
     and p_container in ( 'LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')
     and l_quantity >= 20 and l_quantity <= 20 + 10
     and p_size between 1 and 15
     and l_shipmode in ('AIR', 'AIR REG')
     and l_shipinstruct = 'DELIVER IN PERSON' );


select * from part
     where (p_brand = 'Brand#12'
     and p_container in ( 'SM CASE', 'M BOX', 'SM PACK', 'SM PKG')
     and p_size between 1 and 5
     )
     or (
      p_brand = 'Brand#23'
     and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')

     and p_size between 1 and 10
     )
     or (
      p_brand = 'Brand#34'
     and p_container in ( 'LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')

     and p_size between 1 and 15
      );

pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker2359
  stage stageMarker2359 on all partitions :
    scan rapidsse public LineItem
    | stageMarker2362 broadcast
  stage stageMarker2362 on all partitions :
    scan rapidsse public part
    | abstractJoin "CROSS true  "
    | stageMarker2365
  stage stageMarker2365 on all partitions :
    filter " type BOOLEAN  $17 $2 ==  $20 ''Brand#12''  ==  and  }  ''SM CASE''  ''M BOX''  ''SM PACK''  ''SM PKG''  #4  $23 in  and  $5 1.00  >=  and  $5 1  10  +  casttype DECIMAL CAST  <=  and  }  1  5  $22 between  and  }  ''AIR''  ''AIR REG''  #2  $15 in  and  $14 ''DELIVER IN PERSON''  ==  and  $17 $2 ==  $20 ''Brand#23''  ==  and  }  ''MED BAG''  ''MED BOX''  ''MED PKG''  ''MED PACK''  #4  $23 in  and  $5 10.00  >=  and  $5 10  10  +  casttype DECIMAL CAST  <=  and  }  1  10  $22 between  and  }  ''AIR''  ''AIR REG''  #2  $15 in  and  $14 ''DELIVER IN PERSON''  ==  and  or  $17 $2 ==  $20 ''Brand#34''  ==  and  }  ''LG CASE''  ''LG BOX''  ''LG PACK''  ''LG PKG''  #4  $23 in  and  $5 20.00  >=  and  $5 20  10  +  casttype DECIMAL CAST  <=  and  }  1  15  $22 between  and  }  ''AIR''  ''AIR REG''  #2  $15 in  and  $14 ''DELIVER IN PERSON''  ==  and  or  "
    | aggreg " type DECIMAL )  $6 1.00  $7 -  *  sum  "
    | combined 0
    | stageMarker2368
  stage stageMarker2368 on all nodes :
    aggreg " type DECIMAL )  $1 sum  "
    | combined 0
    | stageMarker2371
  stage stageMarker2371 on origin :
    aggreg " type DECIMAL as revenue )  $1 sum  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

*/

// SF10: 56secs
pipeline unamed
 begin
   stage stageStart on origin :
     start
     | pulse once
     | stageMarker2359
   stage stageMarker2359 on all partitions :
     scan rapidsse public LineItem
     | hash "type INTEGER l_partkey"
     | combined 0
     | next hashcast

   stage stageMarker2362 on all partitions :
     indexJoin part IxP_PARTKEY "BOUND $I1 l_partkey ==" //J1
     | filter " type BOOLEAN
                  $20 'Brand#12'  == }  'SM CASE'  'M BOX'  'SM PACK'  'SM PKG'  #4  $23 in  and  $5 1.00  >=  and  $5 1  10  +  casttype DECIMAL CAST  <=  and  }  1  5  $22 between  and  }  'AIR'  'AIR REG'  #2  $15 in  and  $14 'DELIVER IN PERSON'  ==  and
                  $20 'Brand#23'  == }  'MED BAG'  'MED BOX'  'MED PKG'  'MED PACK'  #4  $23 in  and  $5 10.00  >=  and  $5 10  10  +  casttype DECIMAL CAST  <=  and  }  1  10  $22 between  and  }  'AIR'  'AIR REG'  #2  $15 in  and  $14 'DELIVER IN PERSON'  ==  and  or
                  $20 'Brand#34'  == }  'LG CASE'  'LG BOX'  'LG PACK'  'LG PKG'  #4  $23 in  and  $5 20.00  >=  and  $5 20  10  +  casttype DECIMAL CAST  <=  and  }  1  15  $22 between  and  }  'AIR'  'AIR REG'  #2  $15 in  and  $14 'DELIVER IN PERSON'  ==  and  or  "
     | aggreg " type DECIMAL )  $6 1.00  $7 -  *  sum  "
     | combined 0
     | next

   stage stageMarker2368 on all nodes :
     aggreg " type DECIMAL )  $1 sum  "
     | combined 0
     | next

   stage stageMarker2371 on origin :
     aggreg " type DECIMAL as revenue )  $1 sum  "
     | combined 0
     | next

   stage stageLast on origin :
     output
     | sink
     | stageStart
 end ;

