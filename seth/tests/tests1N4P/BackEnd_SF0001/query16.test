/*  (original Query)

select p_brand, p_type, p_size, count(distinct ps_suppkey) as supplier_cnt
     from ${testName2}_partsupp, ${testName2}_part
     where p_partkey = ps_partkey
     and p_brand <> 'Brand#45'
     and p_type not like 'MEDIUM POLISHED%'
     and p_size in (49,14,23,45,19,3,36,9)
     and ps_suppkey not in
     (
     select s_suppkey
     from ${testName2}_supplier
     where s_comment like '%Customer%Complaints%' )

     group by p_brand, p_type, p_size
     order by supplier_cnt, p_brand, p_type, p_size;

*/


//------------------------------------------------------------------------------
// pipeline Generated
//------------------------------------------------------------------------------
/*

EXPLAIN STAGE TRANSLITERATE
  select p_brand, p_type, p_size, count(distinct ps_suppkey) as supplier_cnt
     from ${testName2}_partsupp, ${testName2}_part
     where p_partkey = ps_partkey
     and p_brand <> 'Brand#45'
     and p_type not like 'MEDIUM POLISHED%'
     and p_size in (49,14,23,45,19,3,36,9)
     and ps_suppkey not in (
     select s_suppkey
     from ${testName2}_supplier
     where s_comment like '%Customer%Complaints%' )
     group by p_brand, p_type, p_size
     order by supplier_cnt desc, p_brand, p_type, p_size;

pipeline unamed
begin
  pipeline __subquery0003
  begin
    stage stageStart on origin :
      start
      | pulse once
      | stageMarker3068
    stage stageMarker3068 on all partitions :
      scan rapidsse public ${testName2}_supplier
      | filter " type BOOLEAN  }  $7 '%Customer%Complaints%'  8 10 matchMiddle1  "
      | project " type INTEGER ( 19 ) as s_suppkey $1 "
      | combined 0
      | stageMarker3071
    stage stageMarker3071 on all partitions :

      stageLast
    stage stageLast on origin :
      output
      | sink
      | stageStart
  end

  stage stageStart on origin :
    start
    | pulse once
    | stageMarker3074
  stage stageMarker3074 on all partitions :
    scan rapidsse public ${testName2}_partsupp
    | stageMarker3077 broadcast
  stage stageMarker3077 on all partitions :
    scan rapidsse public ${testName2}_part
    | abstractJoin " 1  "
    | stageMarker3080
  stage stageMarker3080 on all partitions :
    filter " type BOOLEAN  $6 $1 ==  $9 ''Brand#45''  !=  and  }  $10 ''MEDIUM POLISHED%''  16 matchLeading  not  and  }  49  14  23  45  19  3  36  9  #8  $11 in  and  }  __subquery0003  #1  $2 in  not  and  "
    | combined 0
    | stageMarker3083
  stage stageMarker3083 on origin :
    gbyAgg " groupBy  type VARCHAR as p_brand $9 , type VARCHAR as p_type $10 , type INTEGER ( 19 ) as p_size $11 aggregates  type VARCHAR $K1 , type VARCHAR $K2 , type INTEGER ( 19 ) $K3 , type INTEGER ( 19 ) as supplier_cnt )  $2 countDistinct  "
    | sort " type INTEGER ( 19 ) $4 DESC  , type VARCHAR as p_brand $1 ASC  , type VARCHAR as p_type $2 ASC  , type INTEGER ( 19 ) as p_size $3 ASC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;
*/

trackmemory force;
success

