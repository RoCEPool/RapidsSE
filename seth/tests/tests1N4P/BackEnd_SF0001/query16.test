// Early group by
// best result
/optimise_passthru 
pipeline Query16
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public ${testName2}_part
    | filter " type BOOLEAN }  49  14  23  45  19  3  36  9  #8  P_SIZE in"
    | filter " type BOOLEAN  P_BRAND 'Brand#45' !="
    | filter " type BOOLEAN }  P_TYPE 'MEDIUM POLISHED%'  16 matchLeading not"
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type VARCHAR as P_BRAND P_BRAND ,
               type VARCHAR as P_TYPE P_TYPE ,
               type INTEGER ( 19 ) as P_SIZE P_SIZE"
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin ${testName2}_PartSupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project "type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type VARCHAR as P_BRAND P_BRAND ,
               type VARCHAR as P_TYPE P_TYPE ,
               type INTEGER ( 19 ) as P_SIZE P_SIZE"
    | combined 0
    | next

  stage S03 on all partitions :
    gbyAgg " groupBy type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                     type VARCHAR as P_BRAND P_BRAND ,
                       type VARCHAR as P_TYPE P_TYPE ,
                       type INTEGER ( 19 ) as P_SIZE P_SIZE
               aggregates
                       type INTEGER ( 19 )  as PS_SUPPKEY $K1 ,
                       type VARCHAR  as P_BRAND $K2 ,
                       type VARCHAR  as P_TYPE $K3 ,
                       type INTEGER ( 19 )  as P_SIZE $K4 "


    | combined 0
    | next

  stage S04 on all nodes :
    gbyAgg " groupBy type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                         type VARCHAR as P_BRAND P_BRAND ,
                           type VARCHAR as P_TYPE P_TYPE ,
                           type INTEGER ( 19 ) as P_SIZE P_SIZE
                   aggregates
                           type INTEGER ( 19 )  as PS_SUPPKEY $K1 ,
                           type VARCHAR  as P_BRAND $K2 ,
                           type VARCHAR  as P_TYPE $K3 ,
                           type INTEGER ( 19 )  as P_SIZE $K4 "
    | hash " type INTEGER ( 19 ) PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S05 on all partitions :
     keyNotExists ${testName2}_SUPPLIER IxS_SUPPKEY  "BOUND $I1 PS_SUPPKEY =="
               "type BOOLEAN  }  S_COMMENT '%Customer%Complaints%'  8 10 matchMiddle1"
    | combined 0
    | next

  stage S06 on all partitions :
    gbyAgg " groupBy  type VARCHAR as P_BRAND P_BRAND ,
                       type VARCHAR as P_TYPE P_TYPE ,
                       type INTEGER ( 19 ) as P_SIZE P_SIZE
                       aggregates
                       type VARCHAR  as P_BRAND $K1 ,
                       type VARCHAR  as P_TYPE $K2 ,
                       type INTEGER ( 19 )  as P_SIZE $K3 ,
                       type INTEGER ( 19 )  as supplier_cnt ) PS_SUPPKEY COUNT"
    | combined 0
    | next

  stage S07 on all nodes :
    gbyAgg " groupBy type VARCHAR as P_BRAND P_BRAND ,
                     type VARCHAR as P_TYPE P_TYPE ,
                     type INTEGER ( 19 ) as P_SIZE P_SIZE
                     aggregates
                     type VARCHAR  as P_BRAND $K1 ,
                     type VARCHAR  as P_TYPE $K2 ,
                     type INTEGER ( 19 )  as P_SIZE $K3 ,
                     type INTEGER ( 19 )  as supplier_cnt ) supplier_cnt SUM"
    | combined 0
    | next

  stage S08 on origin :
    gbyAgg " groupBy  type VARCHAR as P_BRAND P_BRAND ,
                      type VARCHAR as P_TYPE P_TYPE ,
                      type INTEGER ( 19 ) as P_SIZE P_SIZE
                      aggregates
                      type VARCHAR  as P_BRAND $K1 ,
                      type VARCHAR  as P_TYPE $K2 ,
                      type INTEGER ( 19 )  as P_SIZE $K3 ,
                      type INTEGER ( 19 )  as supplier_cnt ) supplier_cnt SUM"
    | combined 0
    | next

  stage S09 on origin :
    sort " type INTEGER ( 19 ) $4 DESC  ,
           type VARCHAR as P_BRAND P_BRAND ASC ,
           type VARCHAR as P_TYPE P_TYPE ASC ,
           type INTEGER ( 19 ) as P_SIZE P_SIZE ASC "
    | combined 0
    | next

  stage stageLast on origin :
    output
    | sink
    | first
end ;

