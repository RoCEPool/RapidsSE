--------------------------------------------------------------------------------
-- filter tests
--------------------------------------------------------------------------------

//------------------------------------------------------------------------------
select L_ORDERKEY from lineitem where L_ORDERKEY >= 1;
failure contains: "No such table"

//------------------------------------------------------------------------------
// create table lineitem
create table LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

//------------------------------------------------------------------------------
select l_orderkey from lineitem where l_orderkey >= 2;
rows: 0

// load data
load lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
select l_orderkey from lineitem where l_orderkey >= 2;
rows:
  (2)
  (3)
  (3)
  (3)

//------------------------------------------------------------------------------
select * from lineitem where l_linenumber = 3;
rows:
(1,636998,36999,3,8.00,15479.68,0.10,*,*,*,*,*,*,*,*,*)
(3,1284483,34508,3,22.00,39620.34,0.06,*,*,*,*,*,*,*,*,*)

//------------------------------------------------------------------------------
//select * from lineitem where l_linenumber < 3;
//rows:
//  (2,1061698,11719,1,38.00,63066.32,0.00,*,*,*,*,*,*,*,*,*)

//------------------------------------------------------------------------------
select * from lineitem where  l_linenumber > 3;
rows:
   (1,21315,46316,4,28.00,34616.68,0.09,0.06,'N','O',DATE '1996-04-21',*,*,*,*,*)
   (1,240267,15274,5,24.00,28974.00,0.10,0.04,'N','O',DATE '1996-03-30',*,*,*,*,*)
   (1,156345,6348,6,32.00,44842.88,0.07,0.02,'N','O',DATE '1996-01-30',*,*,*,*,*)


//------------------------------------------------------------------------------
select * from lineitem where  l_linenumber <= 5 and l_linenumber  > 2;
rows:
 (3,1284483,34508,3,22.00,39620.34,0.06,0.07,'A','F',DATE '1994-01-16',*,*,*,*,*)
 (1,636998,36999,3,8.00,15479.68,0.10,0.02,'N','O',DATE '1996-01-29',*,*,*,*,*)
 (1,21315,46316,4,28.00,34616.68,0.09,0.06,'N','O',DATE '1996-04-21',*,*,*,*,*)
 (1,240267,15274,5,24.00,28974.00,0.10,0.04,'N','O',DATE '1996-03-30',*,*,*,*,*)

//------------------------------------------------------------------------------
select * from lineitem where  l_linenumber >= 5 - 1 and l_linenumber <= 5 + 1;
rows:
  (1,21315,46316,4,28.00,34616.68,0.09,0.06,'N','O',DATE '1996-04-21',*,*,*,*,*)
  (1,240267,15274,5,24.00,28974.00,0.10,0.04,'N','O',DATE '1996-03-30',*,*,*,*,*)
  (1,156345,6348,6,32.00,44842.88,0.07,0.02,'N','O',DATE '1996-01-30',*,*,*,*,*)

//------------------------------------------------------------------------------
select * from lineitem where  l_linenumber >= 4 and l_linenumber <= 6 and L_PARTKEY > 150000;
rows:
  (1,240267,15274,5,24.00,28974.00,0.10,0.04,'N','O',DATE '1996-03-30',*,*,*,*,*)
  (1,156345,6348,6,32.00,44842.88,0.07,0.02,'N','O',DATE '1996-01-30',*,*,*,*,*)

//------------------------------------------------------------------------------
// drop the table
drop table lineitem;
success;

CLEANUP {
  
  drop table lineitem;
  mute
  
  bye;
  mute
}


