--------------------------------------------------------------------------------
-- LOOP JOIN tests --- CO-PARTITIONED JOINS (BROADCAST)
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// BROADCAST JOIN (NO LEFT DATA)
// T1.a = T2.a
// PtnKey[T] = b
// PtnKey[J] = c

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (b);
success

create table T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);
success

load T2 "../DATA/Joins/T2.csv" ;
success

select * from T1 join T2 on T1.a = T2.a;
rows: 0

//------------------------------------------------------------------------------
// LEFT FILTER
select * from T1 join T2 on T1.a = T2.a where T1.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// RIGHT FILTER
select * from T1 join T2 on T1.a = T2.a where T2.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER
select * from T1 join T2 on T1.a = T2.a where T1.b >= 500 and T2.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// LEFT FILTER & PROJECT
select T1.a, T1.d, T2.* from T1 join T2 on T1.a = T2.a where T1.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// RIGHT FILTER & PROJECT
select T1.*, T2.a, T2.d from T1 join T2 on T1.a = T2.a where T2.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER & PROJECT
select T1.a, T1.d, T2.a, T2.d from T1 join T2 on T1.a = T2.a where T1.b >=500 and T2.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// CROSS JOIN
SELECT T1.a, T2.a FROM T1, T2;
rows: 0

// drop the tables
drop table T1;
success

drop table T2;
success


