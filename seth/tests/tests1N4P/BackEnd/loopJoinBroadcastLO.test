--------------------------------------------------------------------------------
-- LOOP JOIN tests --- CO-PARTITIONED JOINS (UNICAST)
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// BROADCAST JOIN (NO LEFT AND RIGHT DATA)
// T1.a = T2.a
// PtnKey[T] = b
// PtnKey[J] = c

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (b);
success

create table T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);
success

pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1 | stageC broadcast

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 "leftOuter $L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink2 | stageA

end ;

rows: 0

//------------------------------------------------------------------------------
// LEFT FILTER
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1 | filter 0 "type boolean $2 500 >= " | stageC broadcast

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 "leftOuter $L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink2 | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// RIGHT FILTER
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1 | stageC broadcast

  stage stageC on all partitions :
    scanRight T2
    | filterRight 0 "type boolean $2 500 >= "
    | loopJoin 0 "leftOuter $L1 $R1 =="
    | stageD

  stage stageD on origin :
    output | sink2 | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1 | filter 0 "type boolean $2 500 >= " | stageC broadcast

  stage stageC on all partitions :
    scanRight T2
    | filterRight 0 "type boolean $2 500 >= "
    | loopJoin 0 "leftOuter $L1 $R1 =="
    | stageD

  stage stageD on origin :
    output | sink2 | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// LEFT FILTER & PROJECT
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | filter 0 "type boolean $2 500 >= "
    | project 0 "type integer $1 , type varchar $4 "
    | stageC broadcast

  stage stageC on all partitions :
    scanRight T2
    | loopJoin 0 "leftOuter $L1 $R1 =="
    | stageD

  stage stageD on origin :
    output | sink2 | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// RIGHT FILTER & PROJECT
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1 | stageC broadcast

  stage stageC on all partitions :
    scanRight T2
    | filterRight 0 "type boolean $2 500 >= "
    | projectRight 0 "type integer $1 , type varchar $4 "
    | loopJoin 0 "leftOuter $L1 $R1 =="
    | stageD

  stage stageD on origin :
    output | sink2 | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER & PROJECT
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | filter 0 "type boolean $2 500 >= "
    | project 0 "type integer $1 , type varchar $4 "
    | stageC broadcast

  stage stageC on all partitions :
    scanRight T2
    | filterRight 0 "type boolean $2 500 >= "
    | projectRight 0 "type integer $1 , type varchar $4 "
    | loopJoin 0 "leftOuter $L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink2 | stageA
end ;

rows: 0

// drop the tables
drop table T1;
success

drop table T2;
success

