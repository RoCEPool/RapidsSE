--------------------------------------------------------------------------------
-- aggregGby_I tests
--------------------------------------------------------------------------------

//------------------------------------------------------------------------------
trackMemory;
success;

//------------------------------------------------------------------------------
aggregRows lineitem "type decimal ) $7 sum groupby type integer $1";
failure contains: "Table does not exist"

//------------------------------------------------------------------------------
// create table lineitem
create table LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

//------------------------------------------------------------------------------
//aggregRows lineitem "type decimal ) $7 sum";
//failure contains: "invalid command"

//------------------------------------------------------------------------------
aggregRows lineitem "type integer $1 , type decimal ) $7 sum groupby type integer $1";
rows: 0

// load data
load lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
//aggregRows lineitem "type decimal ) $7 sum group by type integer $1" ;
//failure contains: "invalid command"

//------------------------------------------------------------------------------
aggregRows lineitem "type integer $1 , type decimal ) $7 sum groupby type integer $1" ;
rows:
  (1,0.49)
  (2,0.00)
  (3,0.22)

//------------------------------------------------------------------------------
//aggregRows lineitem "$1 , type varchar ) $16 sum groupby type integer $1";
//failure contains: "invalid command"

//------------------------------------------------------------------------------
aggregRows lineitem "type integer $1 , type integer ) $4 sum groupby type integer $1";
rows:
 (1,21)
 (2,1)
 (3,6)

//------------------------------------------------------------------------------
aggregRows lineitem "type integer $4 , type decimal ) $7 sum , type decimal ) $5 sum groupby type integer $4";
rows:
 (1,0.00,38.00)

 (1,0.04,17.00)
 (2,0.09,36.00)
 (3,0.10,8.00)
 (4,0.09,28.00)
 (5,0.10,24.00)
 (6,0.07,32.00)

 (1,0.06,45.00)
 (2,0.10,49.00)
 (3,0.06,22.00)

//------------------------------------------------------------------------------
// drop the table
drop table lineitem;
success;

MemoryLeaks;
rows: 0

CLEANUP {
  
  drop table lineitem;
  mute
  
  bye;
  mute
}


