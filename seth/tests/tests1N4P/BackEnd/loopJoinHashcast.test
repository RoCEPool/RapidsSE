--------------------------------------------------------------------------------
-- LOOP JOIN tests --- CO-PARTITIONED JOINS (HASHCAST)
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// PARTITIONABLE JOIN (NO LEFT DATA)
// T1.a = T2.a
// PtnKey[T1] = c
// PtnKey[T2] = a

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);
success

create table T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (a);
success

load T2 "../DATA/Joins/T2.csv" ;
success

pipeline loopJoinPart
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1 | hash 0 "type INTEGER $1" | stageC hashcast

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 "$L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink | stageA

end ;
rows: 0

//------------------------------------------------------------------------------
// LEFT FILTER
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | filter 0 "type boolean $2 500 >= "
    | hash 0 "type INTEGER $1"
    | stageC hashcast

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 "$L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// RIGHT FILTER
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | hash 0 "type INTEGER $1"
    | stageC hashcast

  stage stageC on all partitions :
    scanRight T2
    | filterRight 0 "type boolean $2 500 >= "
    | loopJoin 0 "$L1 $R1 =="
    | stageD

  stage stageD on origin :
    output | sink | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | filter 0 "type boolean $2 500 >= "
    | hash 0 "type INTEGER $1"
    | stageC hashcast

  stage stageC on all partitions :
    scanRight T2
    | filterRight 0 "type boolean $2 500 >= "
    | loopJoin 0 "$L1 $R1 =="
    | stageD

  stage stageD on origin :
    output | sink | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// LEFT FILTER & PROJECT
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | filter 0 "type boolean $2 500 >= "
    | project 0 "type integer $1 , type varchar $4 "
    | hash 0 "type INTEGER $1"
    | stageC hashCast

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 "$L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// RIGHT FILTER & PROJECT
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | hash 0 "type INTEGER $1"
    | stageC hashcast

  stage stageC on all partitions :
    scanRight T2
    | filterRight 0 "type boolean $2 500 >= "
    | projectRight 0 "type integer $1 , type varchar $4 "
    | loopJoin 0 "$L1 $R1 =="
    | stageD

  stage stageD on origin :
    output | sink | stageA
end ;

rows: 0

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER & PROJECT
pipeline loopJoinCo
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan T1
    | filter 0 "type boolean $2 500 >= "
    | project 0 "type integer $1 , type varchar $4 "
    | hash 0 "type INTEGER $1"
    | stageC hashCast

  stage stageC on all partitions :
    scanRight T2
    | filterRight 0 "type boolean $2 500 >= "
    | projectRight 0 "type integer $1 , type varchar $4 "
    | loopJoin 0 "$L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink | stageA
end ;

rows: 0

drop table T1;
success

drop table T2;
success

