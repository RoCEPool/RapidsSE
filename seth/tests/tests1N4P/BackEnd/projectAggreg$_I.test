--------------------------------------------------------------------------------
-- projectColumns tests
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
projectColumns lineitem "type decimal ) $7 sum";
failure contains: "Table does not exist"

//------------------------------------------------------------------------------
// create table lineitem
create table LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

//------------------------------------------------------------------------------
//ALKA: UNCOMMENT
//projectColumns lineitem "type integer $1 , type decimal ) $7 sum";
//rows: 0

// load data
load lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
projectColumns lineitem "type decimal ) $7 sum";
rows:
  (0.00)
  (0.22)
  (0.49)

//------------------------------------------------------------------------------
projectColumns lineitem "type integer ) $1 sum";
rows:
  (6)
  (2)
  (9)

//------------------------------------------------------------------------------
projectColumns lineitem "type integer ) $4 sum";
rows:
 (1)
 (6)
 (21)

//------------------------------------------------------------------------------
projectColumns lineitem "type integer ) $4 sum , type integer ) $1 sum";
rows:
 (21,6)
 (6,9)
 (1,2)

//------------------------------------------------------------------------------
projectColumns lineitem "type integer ) $1 count";
rows:
 (6)
 (3)
 (1)

//------------------------------------------------------------------------------
projectColumns lineitem "type integer ) countAll";
rows:
 (6)
 (3)
 (1)

//------------------------------------------------------------------------------
// sum($1)
projectColumns lineitem "type integer ) $1 sum";
rows:
 (6)
 (2)
 (9)

//------------------------------------------------------------------------------
// 1 + sum($1)
projectColumns lineitem "type integer 1 ) $1 sum + ";
rows:
 (7)
 (3)
 (10)

//------------------------------------------------------------------------------
// sum($1) + 1
projectColumns lineitem "type integer ) $1 sum 1 + ";
rows:
 (7)
 (3)
 (10)

//------------------------------------------------------------------------------
// sum(1+$1)
projectColumns lineitem "type integer ) 1 $1 + sum ";
rows:
 (12)
 (3)
 (12)

//------------------------------------------------------------------------------
// drop the table
drop table lineitem;
success;

MemoryLeaks;
rows: 0

CLEANUP {
  
  drop table lineitem;
  mute
  
  bye;
  mute
}


