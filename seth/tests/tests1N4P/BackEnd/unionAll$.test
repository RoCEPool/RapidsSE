--------------------------------------------------------------------------------
-- unionAll tests
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// neither table exists
pipeline unionAll
   begin

  stage stageA on origin :
    start | pulse once | stageB | stageC

  stage stageB on all partitions :
    scan lineitem
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageC on all partitions :
    scan orders
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageD on origin :
    output | sink | stageA

end ;

failure contains: "Table does not exist"

//------------------------------------------------------------------------------
// create table lineitem
create table LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

//------------------------------------------------------------------------------
// one table does not exist
pipeline unionAll
   begin

  stage stageA on origin :
    start | pulse once | stageB | stageC

  stage stageB on all partitions :
    scan lineitem
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageC on all partitions :
    scan orders
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageD on origin :
    output | sink | stageA

end ;
failure contains: "Table does not exist"

//------------------------------------------------------------------------------
create table orders (
   O_ORDERKEY        INTEGER       NOT NULL,  // 0)
   O_CUSTKEY         INTEGER       NOT NULL,  // 1)
   O_ORDERSTATUS     CHAR(1)       NOT NULL,  // 2)
   O_TOTALPRICE      DECIMAL(15,2) NOT NULL,  // 3)
   O_ORDERDATE       DATE          NOT NULL,  // 4)
   O_ORDERPRIORITY   CHAR(15)      NOT NULL,  // 5)
   O_CLERK           CHAR(15)      NOT NULL,  // 6)
   O_SHIPPRIORITY    INTEGER       NOT NULL,  // 7)
   O_COMMENT         VARCHAR(79)   NOT NULL   // 8)
) ;
success

//------------------------------------------------------------------------------
// no data in either table
pipeline unionAll
   begin

  stage stageA on origin :
    start | pulse once | stageB | stageC

  stage stageB on all partitions :
    scan lineitem
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageC on all partitions :
    scan orders
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageD on origin :
    output | sink | stageA

end ;
rows: 0

//------------------------------------------------------------------------------
// load data
load lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
// data in one table
pipeline unionAll
   begin

  stage stageA on origin :
    start | pulse once | stageB | stageC

  stage stageB on all partitions :
    scan lineitem
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageC on all partitions :
    scan orders
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageD on origin :
    output | sink | stageA
end ;

rows:
  (1)
  (1)
  (1)
  (1)
  (1)
  (1)
  (2)
  (3)
  (3)
  (3)

// truncate the lineitem table
truncate lineitem;
success;

// load the orders table
load Orders "../DATA/TPCH/orders10.csv";
failure contains: '4 invalid'

//------------------------------------------------------------------------------
// data in one table
pipeline unionAll
   begin

  stage stageA on origin :
    start | pulse once | stageB | stageC

  stage stageB on all partitions :
    scan lineitem
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageC on all partitions :
    scan orders
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageD on origin :
    output | sink | stageA
end ;
rows:
  (1)
  (2)
  (3)
  (4)
  (5)
  (6)
  (7)
  (32)
  (33)
  (34)

// load data
load lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
// data in both tables
pipeline unionAll
   begin

  stage stageA on origin :
    start | pulse once | stageB | stageC

  stage stageB on all partitions :
    scan lineitem
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageC on all partitions :
    scan orders
    | project  1 "type integer as orderkey $1"
    | stageD

  stage stageD on origin :
    output | sink | stageA
end ;
rows:
