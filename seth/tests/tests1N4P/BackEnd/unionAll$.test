  (33)
  (34)

//------------------------------------------------------------------------------
// drop the table
drop table lineitem;
success;

//------------------------------------------------------------------------------
// drop the table
drop table orders;
success;

MemoryLeaks;
rows: 0

CLEANUP {
  
  drop table lineitem;
  mute

  drop table orders;
  mute

  bye;
  mute
}


