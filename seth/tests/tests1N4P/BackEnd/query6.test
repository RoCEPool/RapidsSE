//------------------------------------------------------------------------------
pipeline Query6
begin
 stage stageA on origin :
   start | pulse once | stageB

  stage stageB on all partitions :
    scan lineitem
    | filter "type boolean $11 DATE '1994-01-01' >=  $11 DATE '1995-01-01' < and "
    | filter "type boolean $7 0.06 0.01 - >= <> $7 0.06 0.01 +  <= <>"
    | aggreg " type decimal as revenue_p ) $6 $7 * sum "
    | combined 0
    | stageC

  stage stageC on origin :
    aggreg " type decimal as revenue $1 "
    | combined 0
    | output | sink | stageA
end;
