--------------------------------------------------------------------------------
-- KEYEXISTS tests --- CO-PARTITIONED
--------------------------------------------------------------------------------

trackmemory force;
success;

create table ${testName2}_LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

create table ${testName2}_orders (
O_ORDERKEY        INTEGER NOT NULL,
O_CUSTKEY         INTEGER NOT NULL,
O_ORDERSTATUS     CHAR(1) NOT NULL,
O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
O_ORDERDATE       DATE NOT NULL,
O_ORDERPRIORITY   CHAR(15) NOT NULL,
O_CLERK           CHAR(15) NOT NULL,
O_SHIPPRIORITY    INTEGER NOT NULL,
O_COMMENT         VARCHAR(79) NOT NULL
) partition by (O_CUSTKEY) ;
success

// create a table
create table ${testName2}_customer (
C_CUSTKEY       INTEGER NOT NULL,
C_NAME          VARCHAR(25) NOT NULL,
C_ADDRESS       VARCHAR(40) NOT NULL,
C_NATIONKEY     INTEGER NOT NULL,
C_PHONE         CHAR(15) NOT NULL,
C_ACCTBAL       DECIMAL(15,2) NOT NULL,
C_MKTSEGMENT    CHAR(10) NOT NULL,
C_COMMENT       VARCHAR(117) NOT NULL
);
success

create index IxO_CUSTKEY on ${testName2}_ORDERS (O_CUSTKEY);
success

create index IxL_ORDERKEY on ${testName2}_LINEITEM (L_ORDERKEY);
success


load ${testName2}_customer           "../TPCH/SF_0001/customer.tbl" ;
success

load ${testName2}_orders             "../TPCH/SF_0001/orders.tbl" ;
success

load ${testName2}_lineitem           "../TPCH/SF_0001/lineitem.tbl" ;
success

//------------------------------------------------------------------------------
// KEY EXISTS
/optimise_passthru 
pipeline unamed
begin

    stage S00 on origin :
      start
      | pulse once
      | next

    stage S02 on all partitions :
      scan rapidsse public ${testName2}_Customer
      | keyExists ${testName2}_ORDERS IxO_CUSTKEY  "BOUND $I1 C_CUSTKEY =="
                         "type BOOLEAN O_ORDERSTATUS 'O' =="
      | project " type INTEGER ( 19 ) as O_CUSTKEY C_CUSTKEY "
      | combined 0
      | next

  stage S03 on origin :
    output
    | sink
    | first
end ;
rows: 149


/optimise_passthru 
pipeline unamed
begin

    stage S00 on origin :
      start
      | pulse once
      | next

    stage S02 on all partitions :
      scan rapidsse public ${testName2}_Customer
      | keyExists ${testName2}_ORDERS IxO_CUSTKEY  "BOUND $I1 C_CUSTKEY =="
                         "type BOOLEAN O_ORDERSTATUS 'F' =="
      | project " type INTEGER ( 19 ) as O_CUSTKEY C_CUSTKEY "
      | combined 0
      | next

  stage S03 on origin :
    output
    | sink
    | first
end ;
rows: 149

/optimise_passthru 
pipeline unamed
begin

    stage S00 on origin :
      start
      | pulse once
      | next

    stage S01 on all partitions :
      scan rapidsse public ${testName2}_orders
      | hash "type INTEGER ( 19 ) O_ORDERKEY"
      | combined 0
      | next hashcast

   stage S02 on all partitions :
     keyExists ${testName2}_lineitem IxL_ORDERKEY  "BOUND $I1 O_ORDERKEY =="
              "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
     | combined 0
     | next

  stage S03 on origin :
    output
    | sink
    | first
end ;
rows: 1470

//------------------------------------------------------------------------------
// KEY NOT EXISTS
/optimise_passthru 
pipeline unamed
begin

    stage S00 on origin :
      start
      | pulse once
      | next

    stage S02 on all partitions :
      scan rapidsse public ${testName2}_Customer
      | keyNotExists ${testName2}_ORDERS IxO_CUSTKEY  "BOUND $I1 C_CUSTKEY =="
                         "type BOOLEAN O_ORDERSTATUS 'O' =="
      | project " type INTEGER ( 19 ) as O_CUSTKEY C_CUSTKEY "
      | combined 0
      | next

  stage S03 on origin :
    output
    | sink
    | first
end ;
rows: (150)

/optimise_passthru 
pipeline unamed
begin

    stage S00 on origin :
      start
      | pulse once
      | next

   stage S01 on all partitions :
      scan rapidsse public ${testName2}_orders
      | hash "type INTEGER ( 19 ) O_ORDERKEY"
      | combined 0
      | next hashcast

    stage S02 on all partitions :
     keyNotExists ${testName2}_lineitem IxL_ORDERKEY  "BOUND $I1 O_ORDERKEY =="
                  "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
      | combined 0
      | next

  stage S03 on origin :
    output
    | sink
    | first
end ;

rows: 30

//------------------------------------------------------------------------------
// drop the tables
drop table ${testName2}_lineitem;
success

drop table ${testName2}_orders;
success

drop table ${testName2}_customer;
success

MemoryLeaks;
rows: 0

CLEANUP {
  
  drop table ${testName2}_lineitem;
  mute

  drop table ${testName2}_orders;
  mute

  drop table ${testName2}_customer;
  mute
}