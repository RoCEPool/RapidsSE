--------------------------------------------------------------------------------
-- INDEX JOIN tests --- PARTITIONED ON INDEX KEYJOINS (UNICAST)
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// CO-PARTITIONED INDEXJOIN ( NO LEFT DATA )
// T1.a = T2.a
// PtnKey[T1] = a
// PtnKey[T2] = a
// IdxKey[T2] = a

create table ${testName2}_T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
);
success

create table ${testName2}_T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
);
success

create index T2_idx on ${testName2}_T2 (a);
success

load ${testName2}_T2 "../DATA/Joins/T2.csv" ;
success

/optimise_passthru 
pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan ${testName2}_T1
    | stageC

  stage stageC on all partitions :
    indexJoin 0 ${testName2}_T2 T2_idx "BOUND $I1 $1 =="
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

end ;

rows: 0

/optimise_passthru/optimise_passthru 
pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan ${testName2}_T1
    | stageC

  stage stageC on all partitions :
    indexJoin 0 ${testName2}_T2 T2_idx "LEFT_OUTER BOUND $I1 $1 =="
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

end ;

rows: 0

