/*----------------------------------------------------------------------------*/
/* gbyAgg.test -- Group by aggregate tests                                    */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory force;
success

//------------------------------------------------------------------------------
// create table lineitem
create table ${testName2}_lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B   3B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B   3B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B   3B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B   3B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B   3B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B   3B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B   3B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B   3B
  L_RETURNFLAG    VARCHAR(1) NOT NULL,      //  8)  2B   2B
  L_LINESTATUS    VARCHAR(1) NOT NULL,      //  9)  2B   2B
  l_SHIPDATE      DATE NOT NULL,            // 10)  8B   8B
  L_COMMITDATE    DATE NOT NULL,            // 11)  8B   8B
  L_RECEIPTDATE   DATE NOT NULL,            // 12)  8B   8B
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,     // 13) 26B  13B
  L_SHIPMODE      VARCHAR(10) NOT NULL,     // 14) 11B   5B
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B  23B
);
success

create index IxL_ORDERKEY  ON ${testName2}_lineitem (L_ORDERKEY)  ;
success

create index IxL_SHIPDATE  ON ${testName2}_lineitem (l_SHIPDATE)  ;
success

create index IxL_ORDER_PART ON ${testName2}_lineitem(L_ORDERKEY, L_PARTKEY);
success

load ${testName2}_lineitem "../TPCH/SF_0001/lineitem.csv";
success

/pipeline_def
/optimise_passthru
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    scan ${testName2}_lineitem
    | project "type INTEGER $1 , type DATE $11"
    | top "type DATE $2" 2
    | combined 0
    | next
  stage stageB on all nodes :
    top "type DATE $2" 2
    | combined 0
    | next
  stage stageC on origin :
    top "type DATE $2" 2
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
end ;

rows:
 (1117,DATE '1998-11-25')
 (221,DATE '1998-11-27')
