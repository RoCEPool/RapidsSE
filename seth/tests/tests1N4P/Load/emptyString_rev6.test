//predicateFetch ${testName2}_t1 "col_id 2 =";
//rows:
//  (2,null,3)

// drop the table
drop table ${testName2}_t1;
success

CLEANUP {
  
  drop table ${testName2}_t1;
  mute

  bye;
  mute
}


