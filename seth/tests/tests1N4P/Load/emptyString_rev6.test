create table ${testName2}_t1 (
col_id       INTEGER,
col_vch      VARCHAR(15),
col_int      INTEGER
);
success

// create an ndex
create index idx on ${testName2}_t1 (col_id) ;
success

// load table T1
Load ${testName2}_t1 "../DATA/Load/emptyString2.csv"
  <enclosed_by_leading> = "{"
  <enclosed_by_trailing> = "}"
;
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 2

predicateFetch ${testName2}_t1 "col_id 1 =";
rows:
  (1,'',3)

predicateFetch ${testName2}_t1 "col_id 2 =";
rows:
  (2,null,3)

export ${testName2}_t1 "/tmp/${testName2}_t1.csv";
success

truncate ${testName2}_t1;
success

select * from ${testName2}_t1;
rows: 0

load ${testName2}_t1 "/tmp/${testName2}_t1.csv";
success

select * from ${testName2}_t1;
rows: 2

