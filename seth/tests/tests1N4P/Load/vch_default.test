drop table ${testName2}_vch;
success

// create the tables
create table ${testName2}_vch (
vch_testno  INTEGER     NOT NULL,
vch_field   VARCHAR(32),
vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on ${testName2}_vch (vch_testno);
success

// load data into the table with \0 as <enclosed_by_leading> = 
Load ${testName2}_vch "../DATA/Load/vch_no_enclosed.csv"
  <enclosed_by_leading> =  "\0"
;
success

