/*----------------------------------------------------------------------------*/
/* vch_term_no_enclosed -- varchar with terminator and no enclosed            */
/*----------------------------------------------------------------------------*/

// create the tables
create table ${testName2}_vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on ${testName2}_vch (vch_testno);
success;

// load data into the table with default formatter settings
Load ${testName2}_vch "../DATA/Load/vch_term_no_enclosed.csv"
  <record_terminator> = ";"
  <escape_char> = "\0" ;
success

//select * from ${testName2}_vch;
//rows: 17

// predicateFetch ${testName2}_vch "vch_testno 601 =";
select * from ${testName2}_vch where vch_testno = 601;
rows:
