/*----------------------------------------------------------------------------*/
/* enclosedBy -- enclosedBy tests                                             */
/*----------------------------------------------------------------------------*/

create table ${testName2}_t1 (
col_id      INTEGER,
col_vch     VARCHAR(15),
col_int     INTEGER NOT NULL,
col_decimal DECIMAL,
col_float   FLOAT NOT NULL,
col_tsp     TIMESTAMP,
col_bool    BOOLEAN,
col_comment VARCHAR(15)
);
success

// create an ndex
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
Load ${testName2}_t1 "../DATA/Load/enclosedBy1.csv" ;
warning contains: '5 rows were invalid'

// predicateFetch rows
select * from ${testName2}_t1;
rows: 2

// predicateFetch ${testName2}_t1 "col_id 1 =";
SELECT * FROM ${testName2}_t1 WHERE col_id = 1;
rows:
  (1,'''DAVE''s DATA''',9,9,9,TIMESTAMP '2018-04-04 09:00:00',true,' valid')

// predicateFetch ${testName2}_t1 "col_id 7 =";
SELECT * FROM ${testName2}_t1 WHERE col_id = 7;
rows:
  (7,'DAVE''s DATA',9,9,9,TIMESTAMP '2018-04-04 09:00:00',true,' valid')

// drop the table
drop table ${testName2}_t1;
success

// create the table
create table ${testName2}_t1 (
col_id      INTEGER,
col_vch     VARCHAR(15),
col_int     INTEGER NOT NULL,
col_decimal DECIMAL,
col_float   FLOAT NOT NULL,
col_tsp     TIMESTAMP,
col_bool    BOOLEAN,
col_comment VARCHAR(15)
);
success

// create an ndex
create index idx on ${testName2}_t1 (col_id);
success

// load table T1 with <enclosed_by_leading> =  '
Load ${testName2}_t1 "../DATA/Load/enclosedBy2.csv" <enclosed_by_leading> = "'" ;
warning contains: '1 rows were invalid'

// predicateFetch rows
select * from ${testName2}_t1;
rows: 2

// predicateFetch ${testName2}_t1 "col_id 1 =";
select * from ${testName2}_t1 where col_id = 1;
rows:
  (1,'DAVE''s DATA',9,9,9,TIMESTAMP '2018-04-04 09:00:00',true,' valid')

// predicateFetch ${testName2}_t1 "col_id 3 =";
select * from ${testName2}_t1 where col_id = 3;
rows:
  (3,' DAVE''s DATA',9,9,9,TIMESTAMP '2018-04-04 09:00:00',true,' valid')

// drop the table
drop table ${testName2}_t1;
success

