/*----------------------------------------------------------------------------*/
/* spaces -- leading and trailing spaces tests                                */
/*----------------------------------------------------------------------------*/

create table ${testName2}_t1 (
  col_id       INTEGER,
  col_vch      VARCHAR(50)
);
success

// create an index
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
load ${testName2}_t1 "../seth/tests/load/terminatorVch_rev6.csv"
  record_terminator "|"
  record_ends "\n"
;
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 1

select * from ${testName2}_t1;
rows:
  (300,'ABC')

// drop the table
drop table ${testName2}_t1;
success

create table ${testName2}_t1 (
  col_id       INTEGER,
  col_int      INTEGER
);
success

// create an index
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
load ${testName2}_t1 ".../DATA/Load/terminatorInt_rev6.csv" record_terminator "|" record_ends "\n";
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 1

// drop the table
drop table ${testName2}_t1;
success


CLEANUP {
  
  drop table ${testName2}_t1;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
