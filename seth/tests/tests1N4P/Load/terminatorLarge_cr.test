/*----------------------------------------------------------------------------*/
/* vch_defaults -- varchar with deafult formatters                            */
/*----------------------------------------------------------------------------*/

// create the table

create table ${testName2}_terminator_cr (
  c1 integer,
  c2 varchar,
  c3 varchar,
  c4 varchar
);
success

// load data into the table with default formatter settings
Load ${testName2}_terminator_cr "../DATA/Load/terminatorLarge_cr.csv"
  <record_ends> = "\r";
success

// create index
create index idx on ${testName2}_terminator_cr(c1);
success

// fetch
predicateFetch ${testName2}_terminator_cr "c1 1 =";
rows:
  (1, 'This is terminatoed by <CR>');

// fetch
select * from ${testName2}_terminator_cr;
rows: 6895

CLEANUP {
  
  drop table ${testName2}_terminator_cr;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
