/*----------------------------------------------------------------------------*/
/* vch_no_term_no_enclosed_no_escape -- varchar term no escape no enclosed    */
/*----------------------------------------------------------------------------*/

// create the tables
create table ${testName2}_vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on ${testName2}_vch (vch_testno);
success;

// load data into the table with default formatter settings
Load ${testName2}_vch "../DATA/Load/vch_term_no_enclosed_no_escape.csv"
  <record_terminator> = ";"
  <enclosed_by_leading> =  "\0"
  <escape_char> = "\0" ;
success

//select * from ${testName2}_vch;
//rows: 16

// predicateFetch ${testName2}_vch "vch_testno 701 =";
select * from ${testName2}_vch where vch_testno = 701;
rows:
  ( 701, 'quick brown fox', *)

// predicateFetch ${testName2}_vch "vch_testno 702 =";
select * from ${testName2}_vch where vch_testno = 702;
rows:
  ( 702, 'quick brown fox''s', *)

// predicateFetch ${testName2}_vch "vch_testno 703 =";
select * from ${testName2}_vch where vch_testno = 703;
