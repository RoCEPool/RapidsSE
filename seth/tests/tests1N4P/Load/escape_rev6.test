/*----------------------------------------------------------------------------*/
/* escape -- escape tests                                                     */
/*----------------------------------------------------------------------------*/

create table ${testName2}_t1 (
  col_id      INTEGER,
  col_vch     VARCHAR(25)
);
success

// create an ndex
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult escape
Load ${testName2}_t1 "../DATA/Load/escape_defaults.csv";
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 9

select * from ${testName2}_t1 ;
rows:
  (1, null)
  (2, 'N')
  (3, 'N not on its own')
  (4, '\N not on its own')
  (5, *)
  (6, 'Addr 1
Addr 2')
  (7, 'Other chars AB')
  (8, 'Part 1, part 2')
  (9, 'Dave''s house')

// drop the table
drop table ${testName2}_t1;
success

create table ${testName2}_t1 (
  col_id      INTEGER,
  col_vch     VARCHAR(25)
);
success

// create an ndex
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult escape
Load ${testName2}_t1 "../DATA/Load/escape_enclosed.csv"
  <enclosed_by_leading> =  "'";
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 9

select * from ${testName2}_t1 ;
rows:
  (1, null)
  (2, 'N')
  (3, 'N not on its own')
  (4, '\N not on its own')
  (5, *)
  (6, 'Addr 1
Addr 2')
  (7, 'Other chars AB')
  (8, 'Part 1, part 2')
  (9, 'Dave''s house')

// drop the table
drop table ${testName2}_t1;
success

create table ${testName2}_t1 (
  col_id      INTEGER,
  col_vch     VARCHAR(25)
);
success

// create an ndex
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult escape
Load ${testName2}_t1 "../DATA/Load/escape_enclosedByCurly.csv"
  <enclosed_by_leading> =  "{"
  <enclosed_by_trailing> = "}";
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 10

select * from ${testName2}_t1 ;
rows:
  (1, null)
  (2, 'N')
  (3, 'N not on its own')
  (4, '\N not on its own')
  (5, *)
  (6, 'Addr 1
Addr 2')
  (7, 'Other chars AB')
  (8, 'Part 1, part 2')
  (9, 'Dave''s house')
  (10, '{My home}')

// drop the table
drop table ${testName2}_t1;
success


CLEANUP {
  
  drop table ${testName2}_t1;
  mute

  bye;
  mute
}


