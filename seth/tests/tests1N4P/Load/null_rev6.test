/*----------------------------------------------------------------------------*/
/* emptyString -- empty string tests                                          */
/*----------------------------------------------------------------------------*/

create table ${testName2}_t1 (
  col_id       INTEGER,
  col_vch      VARCHAR(25),
  col_int      INTEGER
);
success

// create an index
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
Load ${testName2}_t1 "../DATA/Load/null.csv" ;
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 11

select * from ${testName2}_t1;
rows:
  (NULL,null,NULL)
  (null,null,NULL)
  (null,null,null)
  (1,'null',3)
  (2,' null',3)
  (3,'N',null)
  (4,'N is not a null', 3)
  (5,'\N',null)
  (6,'The word null', 3)
  (7,'The word null', 3)
  (8,'null is not null',3)

// drop the table
drop table ${testName2}_t1;
success

create table ${testName2}_t1 (
  col_id       INTEGER,
  col_vch      VARCHAR(25),
  col_int      INTEGER
);
success

// create an index
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
Load ${testName2}_t1 "../DATA/Load/null_enclosedBy.csv"
  <enclosed_by_leading> =  "'" ;
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 11

select * from ${testName2}_t1;
rows:
  (NULL,null,NULL)
  (null,null,NULL)
  (null,null,null)
  (1,'null',3)
  (2,' null',3)
  (3,'N',null)
  (4,'N is not a null', 3)
  (5,'\N',null)
  (6,'The word null', 3)
  (7,'The word null', 3)
  (8,'null is not null',3)

// drop the table
drop table ${testName2}_t1;
success

create table ${testName2}_t1 (
  col_id       INTEGER,
  col_vch      VARCHAR(25),
  col_int      INTEGER
);
success

// create an index
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
Load ${testName2}_t1 "../DATA/Load/null_enclosedByCurly.csv"
  <enclosed_by_leading> =  "{"
  <enclosed_by_trailing> = "}";
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 11

select * from ${testName2}_t1;
rows:
  (NULL,null,NULL)
  (null,null,NULL)
  (null,null,null)
  (1,'null',3)
  (2,' null',3)
  (3,'N',null)
  (4,'N is not a null', 3)
  (5,'\N',null)
  (6,'The word null', 3)
  (7,'The word null', 3)
  (8,'null is not null',3)

// drop the table
drop table ${testName2}_t1;
success


CLEANUP {
  
  drop table ${testName2}_t1;
  mute
}


