/*----------------------------------------------------------------------------*/
/* part_curlyBraces --                                                        */
/*----------------------------------------------------------------------------*/

// create the table
create table ${testName2}_part (
p_partkey INTEGER NOT NULL,
p_name VARCHAR(55),
p_mfgr VARCHAR(25),
p_brand VARCHAR(10),
p_type VARCHAR(25),
p_size INTEGER,
p_container VARCHAR(10),
p_retailprice FLOAT,
p_comment VARCHAR(23)
);
success

create index idx on ${testName2}_part (p_type);

load ${testName2}_part "../DATA/Load/part_curlyBraces.csv"
  <enclosed_by_leading> =  "{"
  <enclosed_by_trailing> = "}"
  <record_ends> = "\n";
success

select * from ${testName2}_part;
rows: 16

CLEANUP {
  
  drop table ${testName2}_part;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
