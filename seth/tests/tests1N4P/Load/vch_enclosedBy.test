/*----------------------------------------------------------------------------*/
/* vch_enclosedBy -- varchar with enclosedBy formatters                       */
/*----------------------------------------------------------------------------*/

// create the tables
create table ${testName2}_vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on ${testName2}_vch (vch_testno);
success;

// load data into the table with default formatter settings
Load ${testName2}_vch "../DATA/Load/vch_enclosedBy.csv"
  <enclosed_by_leading> =  "'"
;
success

select * from ${testName2}_vch;
rows: 21

// predicateFetch ${testName2}_vch "vch_testno 101 ==";
select * from ${testName2}_vch where vch_testno = 101;
rows:
 ( 101, 'quick brown fox', *)

