/*----------------------------------------------------------------------------*/
/* spaces -- leading and trailing spaces tests                                */
/*----------------------------------------------------------------------------*/

create table ${testName2}_t1 (
  col_id       INTEGER,
  col_vch      VARCHAR(50),
  col_int      INTEGER
);
success

// create an index
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
Load ${testName2}_t1 "../DATA/Load/spaces.csv" ;
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 4

select * from ${testName2}_t1;
rows:
  (1,'   3 leading',3)
  (2,'3 leading',3)
  (3,'3 leading,2 trailing' ,3)
  (4,'   3 leading,2 trailing  ',3)

// drop the table
drop table ${testName2}_t1;
success

create table ${testName2}_t1 (
  col_id       INTEGER,
  col_vch      VARCHAR(50),
  col_int      INTEGER
);
success

// create an index
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
Load ${testName2}_t1 "../DATA/Load/spaces_enclosedBy.csv"
  <enclosed_by_leading> =  "'" ;
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 4

select * from ${testName2}_t1;
rows:
  (1,'   3 leading',3)
  (2,'3 leading',3)
  (3,'3 leading,2 trailing',3)
  (4,'   3 leading,2 trailing  ',3)

// drop the table
drop table ${testName2}_t1;
success

create table ${testName2}_t1 (
  col_id       INTEGER,
  col_vch      VARCHAR(25),
  col_int      INTEGER
);
success

// create an index
create index idx on ${testName2}_t1 (col_id);
success

// load T1 with deafult enclosedBy
Load ${testName2}_t1 "../DATA/Load/spaces_enclosedByCurly.csv"
  <enclosed_by_leading> =  "{"
  <enclosed_by_trailing> = "}";
success

// predicateFetch rows
select * from ${testName2}_t1;
rows: 4

select * from ${testName2}_t1;
rows:
  (1,'   3 leading',3)
  (2,'3 leading',3)
  (3,'3 leading,2 trailing',3)
  (4,'   3 leading,2 trailing  ',3)

// drop the table
//drop table ${testName2}_t1;
//success

CLEANUP {
  
  drop table ${testName2}_t1;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
