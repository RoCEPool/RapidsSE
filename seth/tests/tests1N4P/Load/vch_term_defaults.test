/*----------------------------------------------------------------------------*/
/* vch_term_defaults -- varchar with terminated                               */
/*----------------------------------------------------------------------------*/

// create the tables
create table ${testName2}_vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on ${testName2}_vch (vch_testno);
success;

// load data into the table with default formatter settings
Load ${testName2}_vch "../DATA/Load/vch_term_defaults.csv"
  <record_terminator> = ";"
  <enclosed_by_leading> =  "'";
success

select * from ${testName2}_vch;
rows: 18

// predicateFetch ${testName2}_vch "vch_testno 501 ==";
select * from ${testName2}_vch where vch_testno = 501;
rows:
 ( 501, 'quick brown fox', *)

