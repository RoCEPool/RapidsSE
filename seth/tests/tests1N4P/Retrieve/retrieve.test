/*----------------------------------------------------------------------------*/
/* boolean.test -- BOOLEAN DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// (1) create a table
create table retTbl (
dec_col1  DECIMAL(10,3) NOT NULL,
vch_col2  VARCHAR(32) NOT NULL,
int_col3  INTEGER     NOT NULL,
int_col4  INTEGER     NOT NULL,
ivl_col5  DECIMAL(10,2) NOT NULL,
dec_col6  DECIMAL,
tsp_col7  TIMESTAMP   NOT NULL,
bol_col8  BOOLEAN     NOT NULL
);
success

load retTbl "../DATA/Retrieve/retrieve.csv" ;
success

// check no of rows
tableScan retTbl;
rows: 10

predicateFetch retrieve retTbl dec_col1 print;
rows:
  (1007.008)
  (-1008.008)
  (1000.000)
  (1004.003)
  (1002.002)
  (1003.003)
  (1006.006)
  (1001.000)
  (1005.006)
  (1009.009)

predicateFetch retrieve retTbl vch_col2 print;
rows:
  ('one')
  ('five')
  ('nine')
  ('seven')
  ('eight')
  ('zero')
  ('three')
  ('two')
  ('three')
  ('six')

predicateFetch retrieve retTbl int_col3 print;
rows:
  (102)
  (103)
  (106)
  (107)
  (108)
  (100)
  (103)
  (101)
  (105)
  (109)

predicateFetch retrieve retTbl int_col4 print;
rows:
