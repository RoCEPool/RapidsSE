predicateFetch retrieve retTbl bol_col8 print;
rows:
  (false)
  (true)
  (true)
  (false)
  (false)
  (false)
  (false)
  (true)
  (false)
  (true)

// drop the table
drop table retTbl;
success

// check existence of table
lstbl;
rows: 0

CLEANUP {
  
  // drop the table
  drop table retTbl;
  mute
  
  bye;
  mute
}

