  (6.01)
  (0.00)
  (3.00)
  (1.00)
  (5.01)
  (9.01)
  (7.01)
  (8.01)

predicateFetch retrieve retTbl dec_col6 print;
rows:
  (1007)
  (9223372036854776)
  (123456789012345679)
  (null)
  (1002)
  (null)
  (-9223372036854775806)
  (1001)
  (9223372036854775806)
  (-9223372036854776)

predicateFetch retrieve retTbl tsp_col7 print;
rows:
  (TIMESTAMP '1907-01-01 00:00:00')
  (TIMESTAMP '1908-01-01 00:00:00')
  (TIMESTAMP '1902-01-01 00:00:00')
  (TIMESTAMP '1903-01-01 00:00:00')
  (TIMESTAMP '1906-01-01 00:00:00')
  (TIMESTAMP '1901-01-01 00:00:00')
  (TIMESTAMP '1905-01-01 00:00:00')
  (TIMESTAMP '1909-01-01 00:00:00')
  (TIMESTAMP '1900-01-01 00:00:00')
