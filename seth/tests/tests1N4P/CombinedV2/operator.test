     | dynamic_v2 0
     | next

   stage S03 on all nodes :
     gbyagg " groupBy  type INTEGER as n_regionkey $1 aggregates  type INTEGER $K1 , type VARCHAR )  $2 max  "
     | dynamic_v2 0
     | next

   stage S04 on origin :
     gbyagg " groupBy  type INTEGER as n_regionkey $1 aggregates  type INTEGER $K1 , type VARCHAR )  $2 max  "
     | dynamic_v2 0
     | next

   stage S05 on origin :
     output
     | sink
     | first
 end ;

