/optimise_passthru
pipeline _unnamed_
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
    indexScan ${testName2}_Nation IxN_NATIONKEY "UBOUND $I1 2 < "
    | project   "type INTEGER as N_NATIONKEY $1 , type VARCHAR as N_NAME $2 , type INTEGER as N_REGIONKEY $3 , type VARCHAR as N_COMMENT $4 "
    | combined 0
    | next

  stage S02 on origin :
      output
    | sink
    | first

end ;

