create table L (l_int_col0 integer);
create table R(r_int_col0 integer, r_vch_col1 varchar);
create index L_idx on L(l_int_col0);
create index R_idx on R(r_int_col0);

load L "../DATA/Joins/L.csv";
load R "../DATA/Joins/R.csv";

