//------------------------------------------------------------------------------
// AGGREGATE - INTEGER
//------------------------------------------------------------------------------
pipeline unamed
begin
  stage S00 on origin :
    start
    | pulse once
    | next
  stage S01 on all partitions :
    scan rapidsse public Nation
    | filter " type BOOLEAN  $1 5  <  "
    | aggreg " type INTEGER )  $1 sum  "
    | dynamic_v2 0
    | next
  stage S02 on all nodes :
    aggreg " type INTEGER )  $1 sum  "
    | dynamic_v2 0
    | next
  stage S03 on origin :
    aggreg " type INTEGER )  $1 sum  "
    | dynamic_v2 0
    | next
  stage S04 on origin :
    output
    | sink
    | first
end ;

rows:
 (10)

//------------------------------------------------------------------------------
// AGGREGATE - VARCHAR
//------------------------------------------------------------------------------
pipeline unamed
begin
 stage S00 on origin :
   start
   | pulse once
   | next
 stage S01 on all partitions :
   scan rapidsse public Nation
   | aggreg " type VARCHAR )  $2 max  "
   | dynamic_v2 0
   | next
 stage S02 on all nodes :
   aggreg " type VARCHAR )  $1 max  "
   | dynamic_v2 0
   | next
 stage S03 on origin :
   aggreg " type VARCHAR )  $1 max  "
   | dynamic_v2 0
   | next
 stage S04 on origin :
   output
   | sink
   | first
end ;
rows:
  ('VIETNAM')

//------------------------------------------------------------------------------
// GROUP BY AGGREGATE - INTEGER
//------------------------------------------------------------------------------
pipeline unamed
begin
 stage S01 on origin :
   start
   | pulse once
   | next

 stage S02 on all partitions :
   scan rapidsse public Nation
   | gbyagg " groupBy  type INTEGER as n_regionkey $3 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | dynamic_v2 0
   | next

 stage S03 on all nodes :
   gbyagg " groupBy  type INTEGER as n_regionkey $2 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | dynamic_v2 0
   | next

 stage S04 on origin :
   gbyagg " groupBy  type INTEGER as n_regionkey $2 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | dynamic_v2 0
   | next

 stage S06 on origin :
   output
   | sink
   | first
end ;
rows:
  (50,0)
  (47,1)
  (68,2)
  (77,3)
  (58,4)

