create table ${testName2}_L (l_int_col0 integer);
create table ${testName2}_R(r_int_col0 integer, r_vch_col1 varchar);
create index L_idx on ${testName2}_L(l_int_col0);
create index R_idx on ${testName2}_R(r_int_col0);

