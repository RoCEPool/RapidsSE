//------------------------------------------------------------------------------
// SEMI-JOIN
//------------------------------------------------------------------------------
/optimise_passthru
pipeline __CS2_semiJoin
begin

 stage S00 on origin :
     start
   | pulse     once
   | next

 stage S01 on all partitions :
     scan ${testName2}_Nation
   | project "type INTEGER as N_NATIONKEY N_NATIONKEY , type VARCHAR as N_NAME N_NAME , type INTEGER as N_REGIONKEY N_REGIONKEY"
   | hash "type INTEGER $3"
   | combined  0
   | next hashcast

 stage S02 on all partitions :
     keyExists ${testName2}_Region IxR_REGIONKEY
              " BOUND $I1 $3 == "
              "type BOOLEAN R_REGIONKEY N_NATIONKEY =="
   | combined  0
   | next

 stage S04 on origin :
     output
   | sink
   | first

end ;

rows:
 (0,'ALGERIA',0)
 (1,'ARGENTINA',1)
 (4,'EGYPT',4)

 
