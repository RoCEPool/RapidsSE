//------------------------------------------------------------------------------
// AGGREGATE - INTEGER
//------------------------------------------------------------------------------
/weaved
/weaver2
/optimise_passthru
pipeline unamed
begin
  stage S00 on origin :
    start
    | pulse once
    | next
  stage S01 on all partitions :
    scan rapidsse public Nation
    | filter " type BOOLEAN  $1 5  <  "
    | aggreg " type INTEGER )  $1 sum  "
    | combined 0
    | next
  stage S02 on all nodes :
    aggreg " type INTEGER )  $1 sum  "
    | combined 0
    | next
  stage S03 on origin :
    aggreg " type INTEGER )  $1 sum  "
    | combined 0
    | next
  stage S04 on origin :
    output
    | sink
    | first
end ;

rows:
 (10)

