trackmemory force;
success;

create table ${testName2}_Nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

create index IxN_NATIONKEY on ${testName2}_nation (n_nationkey);
success

load ${testName2}_nation "../DATA/TPCH/nation.tbl";
success

create table ${testName2}_Region (
	 R_REGIONKEY       INTEGER      NOT NULL,
	 R_NAME            CHAR(25)     NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

create index IxR_REGIONKEY on ${testName2}_Region (R_REGIONKEY);
success

create index IxR_NAME on ${testName2}_Region (R_NAME);
success

load ${testName2}_Region "../DATA/TPCH/region.tbl";
success

//------------------------------------------------------------------------------
// PROJECT
//------------------------------------------------------------------------------
/optimise_passthru
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker0559
  stage stageMarker0559 on all partitions :
    scan rapidsse public ${testName2}_Nation
    | filter " type BOOLEAN  $1 2  <  "
    | project " type INTEGER as n_nationkey $1 , type VARCHAR as n_name $2 "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;
rows:
  (0,'ALGERIA')
  (1,'ARGENTINA')

