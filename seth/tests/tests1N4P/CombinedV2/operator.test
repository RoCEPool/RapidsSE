//------------------------------------------------------------------------------
// drop the tables

drop table L;
success

drop table R;
success

drop table nation;
success

drop table region;
success

MemoryLeaks;
rows: 0

CLEANUP {

  drop table L;
  success

  drop table R;
  success

  drop table nation;
  mute

  drop table region;
  mute

  bye;
  mute
}