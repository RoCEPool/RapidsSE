/optimise_passthru
pipeline _unnamed_
begin

  stage S00 on origin :
     start
   | pulse     once
   | next

  stage S01 on all partitions :
     scan      ${testName2}_Nation
   | project "type INTEGER N_NATIONKEY , type VARCHAR N_NAME , type INTEGER N_REGIONKEY"
   | hash "type INTEGER $3"
   | combined 0
   | next hashcast

  stage S02 on all partitions :
     indexJoin ${testName2}_Region IxR_REGIONKEY " BOUND $I1 $3 == "
   | combined 0
   | next

  stage S04 on origin :
     output
   | sink
   | first

end ;

