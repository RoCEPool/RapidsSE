/optimise_passthru
pipeline unnamed
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
      scan      ${testName2}_Lineitem
    | project "type INTEGER $1"
    | hash "type INTEGER $1"
    | combined  0
    | next hashcast

  stage S02 on all partitions :
      indexJoin ${testName2}_orders IxO_ORDERKEY " BOUND $I1 $1 == "
    | project "type INTEGER $1 , type INTEGER $2"
    | combined  0
    | next

  stage S06 on origin :
      output
    | sink
    | first

end ;

