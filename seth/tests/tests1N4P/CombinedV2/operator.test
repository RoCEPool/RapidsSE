load ${testName2}_R "../DATA/Joins/R.csv";

//------------------------------------------------------------------------------
// LEFT OUTER JOIN
//------------------------------------------------------------------------------
// LEFT_OUTER with scan

/optimise_passthru
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageMarker0142 on all partitions :
    scan rapidsse public ${testName2}_L
    | indexJoin ${testName2}_R R_idx " LEFT_OUTER BOUND $I1 l_int_col0 =="
    | project " type INTEGER as l_int_col0 $1 , type INTEGER as r_int_col0 $2 , type VARCHAR as r_vch_col1 $3 "
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
end ;
rows: 48


// LEFT_OUTER with indexscan

/optimise_passthru
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageMarker0142 on all partitions :
    indexScan ${testName2}_L L_idx "LBOUND $I1 2 >"
    | indexJoin ${testName2}_R R_idx " LEFT_OUTER BOUND $I1 l_int_col0 ==" //J1
    | project " type INTEGER as l_int_col0 $1 , type INTEGER as r_int_col0 $2 , type VARCHAR as r_vch_col1 $3 "
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
end ;
