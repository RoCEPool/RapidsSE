--------------------------------------------------------------------------------
-- Scan --- Combined Operators
--------------------------------------------------------------------------------

trackMemory;
success;

create table Nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

create index IxN_NATIONKEY on nation (n_nationkey);
success

load nation "../DATA/TPCH/nation.tbl";
success

create table Region (
	 R_REGIONKEY       INTEGER      NOT NULL,
	 R_NAME            CHAR(25)     NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

create index IxR_REGIONKEY on Region (R_REGIONKEY);
success

create index IxR_NAME on Region (R_NAME);
success

load Region "../DATA/TPCH/region.tbl";
success

//------------------------------------------------------------------------------
// PROJECT
//------------------------------------------------------------------------------
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker0559
  stage stageMarker0559 on all partitions :
    scan rapidsse public Nation
    | filter " type BOOLEAN  $1 2  <  "
    | project " type INTEGER as n_nationkey $1 , type VARCHAR as n_name $2 "
    | dynamic_v2 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;
rows:
  (0,'ALGERIA')
  (1,'ARGENTINA')

//------------------------------------------------------------------------------
// INDEXSCAN -
//------------------------------------------------------------------------------
pipeline _unnamed_
begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
    indexScan Nation IxN_NATIONKEY "UBOUND $I1 2 < "
    | project   "type INTEGER as N_NATIONKEY $1 , type VARCHAR as N_NAME $2 , type INTEGER as N_REGIONKEY $3 , type VARCHAR as N_COMMENT $4 "
    | dynamic_v2  0
    | next

  stage S02 on origin :
      output
    | sink
    | first

end ;

rows:
  (0,'ALGERIA',0,' haggle. carefully final deposits detect slyly agai')
  (1,'ARGENTINA',1,'al foxes promise slyly according to the regular accounts. bold requests alon')

//------------------------------------------------------------------------------
// INDEXJOIN -
//------------------------------------------------------------------------------
pipeline _unnamed_
begin

  stage S00 on origin :
     start
   | pulse     once
   | next

  stage S01 on all partitions :
     scan      Nation
   | project "type INTEGER as N_NATIONKEY N_NATIONKEY , type VARCHAR as N_NAME N_NAME , type INTEGER as N_REGIONKEY N_REGIONKEY"
   | dynamic_v2  0
   | next

  stage S02 on all partitions :
     indexJoin Region IxR_REGIONKEY " BOUND $I1 $3 == "
   | dynamic_v2  0
   | next

  stage S04 on origin :
     output
   | sink
   | first

end ;
