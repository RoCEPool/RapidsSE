//------------------------------------------------------------------------------
// GROUP BY AGGREGATE - INTEGER
//------------------------------------------------------------------------------
/weaver2
/optimise_passthru
pipeline unamed
begin
 stage S01 on origin :
   start
   | pulse once
   | next

 stage S02 on all partitions :
   scan rapidsse public Nation
   | gbyagg " groupBy  type INTEGER as n_regionkey $3 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | dynamic 0
   | next

 stage S03 on all nodes :
   gbyagg " groupBy  type INTEGER as n_regionkey $2 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | dynamic 0
   | next

 stage S04 on origin :
   gbyagg " groupBy  type INTEGER as n_regionkey $2 aggregates  type INTEGER )  $1 sum  , type INTEGER $K1 "
   | dynamic 0
   | next

 stage S06 on origin :
   output
   | sink
   | first
end ;
