//------------------------------------------------------------------------------
// SEMI-JOIN
//------------------------------------------------------------------------------

/weaver2
/optimise_passthru
pipeline __CS2_semiJoin
begin

 stage S00 on origin :
     start
   | pulse     once
   | next

 stage S01 on all partitions :
     scan Nation
   | project "type INTEGER as N_NATIONKEY N_NATIONKEY , type VARCHAR as N_NAME N_NAME , type INTEGER as N_REGIONKEY N_REGIONKEY"
   | combined  0
   | next

 stage S02 on all partitions :
     keyExists Region IxR_REGIONKEY
              " BOUND $I1 $3 == "
              "type BOOLEAN R_REGIONKEY N_NATIONKEY =="
   | combined  0
   | next

 stage S04 on origin :
     output
   | sink
   | first

end ;

rows:
 (0,'ALGERIA',0)
 (1,'ARGENTINA',1)
 (4,'EGYPT',4)

 /weaver2
 /optimise_passthru
 pipeline __CS2_semiJoin
 begin

  stage S00 on origin :
      start
    | pulse     once
    | next

  stage S01 on all partitions :
      scan Nation
    | project "type INTEGER as N_NATIONKEY N_NATIONKEY , type VARCHAR as N_NAME N_NAME , type INTEGER as N_REGIONKEY N_REGIONKEY"
    | combined  0
    | next

  stage S02 on all partitions :
      keyExists Region IxR_REGIONKEY
               " BOUND $I1 $3 == "
               "type BOOLEAN R_NAME 'ASIA' =="
    | combined  0
    | next

  stage S04 on origin :
      output
    | sink
    | first

 end ;

