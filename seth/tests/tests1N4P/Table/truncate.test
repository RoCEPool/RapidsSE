/*----------------------------------------------------------------------------*/
/* truncate table tests                                                       */
/*----------------------------------------------------------------------------*/

trackmemory force;
success;

//indexEntries 200;
//success;

// truncate where table does not exist
truncate ${testName2}_noTable;
failure contains: 'Table does not exist'

// create a table
create table ${testName2}_lineitem (
  l_orderkey INTEGER NOT NULL,
  l_partkey INTEGER NOT NULL,
  l_suppkey INTEGER NOT NULL,
  l_linenumber INTEGER,
  l_quantity INTEGER,
  l_extendedprice DECIMAL(15, 2),
  l_discount DECIMAL(15, 2),
  l_tax DECIMAL(15, 2),
  l_returnflag VARCHAR(1),
  l_linestatus VARCHAR(1),
  l_shipdate TIMESTAMP,
  l_commitdate TIMESTAMP,
  l_receiptdate TIMESTAMP,
  l_shipinstruct VARCHAR(25),
  l_shipmode VARCHAR(10),
  l_comment VARCHAR(44)
);
success

//------------------------------------------------------------------------------
// create an index on custkey
CREATE INDEX LINEITEM_IDX1 ON ${testName2}_lineitem(l_orderkey);
affected: 0

// check existence of index
select * from tableIndexes where TableName = '${testName2}_lineitem';
contains rows:
  (*, *, '${testName2}_lineitem', "LINEITEM_IDX1",false,false)

// check columns of index
lsidxcol ${testName2}_lineitem LINEITEM_IDX1;
rows:
  ("l_orderkey", "INTEGER", 19, 0, false, true)

// truncate when table is empty
truncate ${testName2}_lineitem;
success

// fetch
select * from ${testName2}_lineitem;
rows: 0

// load the table
load ${testName2}_lineitem "../DATA/Regression/lineitem.csv";
success

// truncate the table
truncate ${testName2}_lineitem;
success

// fetch
select * from ${testName2}_lineitem;
rows: 0

// now drop the table
drop table ${testName2}_lineitem;
success

// Disabled for antlr command parser
//indexEntries 0;
//success

memoryLeaks;
rows: 0;

CLEANUP {

  drop table ${testName2}_lineitem;
  mute

  indexExtries 0;
  mute
}

