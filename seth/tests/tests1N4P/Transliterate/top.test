
trackmemory force;
success

//------------------------------------------------------------------------------
create table ${testName2}_Lineitem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      TIMESTAMP NOT      NULL,
 L_COMMITDATE    TIMESTAMP NOT      NULL,
 L_RECEIPTDATE   TIMESTAMP NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

CREATE INDEX IxL_ORDERKEY ON ${testName2}_Lineitem(L_ORDERKEY);
success

load ${testName2}_Lineitem "../TPCH/SF_0001/lineitem.csv";
success

//------------------------------------------------------------------------------------
/optimise_passthru
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    indexScan ${testName2}_Lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | project " type integer as orderkey l_orderkey "
    | top "type integer orderkey" 2
    | combined 0
    | next
stage stageA on all nodes :
    top "type integer orderkey" 2
    | combined 0
    | next
stage stageA on origin :
    top "type integer orderkey" 2
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
  end ;
rows:
 (1499)
 (1499)

//------------------------------------------------------------------------------
// drop the table
drop table ${testName2}_Lineitem;
success;

memoryleaks;
rows: 0

CLEANUP {

  drop table ${testName2}_Lineitem;
  mute
}




































