// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Literals in the select list
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

SELECT 1 FROM nation HAVING SUM(n_nationkey) > 0;
rows:
 (1)

SELECT SUM(n_nationkey) from nation HAVING SUM(n_nationkey) > 0;
rows:
 (329)

DROP TABLE nation;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE nation;
  mute
}