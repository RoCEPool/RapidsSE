/*----------------------------------------------------------------------------*/
/* Aggregation syntax & semantics tests                                       */
/*                                                                            */
/* Tests the SQL parser/planner for legitimate SQL statements concerning      */
/* aggregations, grouping, HAVING, etc.                                       */
/*                                                                            */
/* We use EXPLAIN before the queries to avoid actually running these through  */
/* the execution engine.                                                      */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

trackmemory;
success

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

load nation "../DATA/Transliterate/nationAgg.tbl";
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic aggregations and group bys
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- basic select of columnRef 
SELECT n_name FROM nation;
rows: 
  ('BRAZIL')
  ('INDIA')
  ('INDONESIA')
  ('IRAN')
  ('CHINA')
  ('RUSSIA')
  ('UNITED KINGDOM')
  ('UNITED STATES')

  ('ARGENTINA')
  ('ETHIOPIA')
  ('IRAQ')
  ('JAPAN')
  ('JORDAN')
  ('MOZAMBIQUE')
  ('PERU')
  ('ROMANIA')
  ('SAUDI ARABIA')
  ('INDIA')

  ('KENYA')
  ('MOROCCO')
  ('VIETNAM')

  ('ALGERIA')
  ('CANADA')
  ('CANADA')
  ('EGYPT')
  ('FRANCE')
  ('GERMANY')

-- basic select of aggregation
SELECT SUM(n_regionkey) FROM nation;
rows: 
  (53)

-- basic select of grouped columnRef and aggregation
-- we see INDIA twice because they are coming from different partitions (different nationKey)
-- and we don't have a super aggregation in place
-- and we see CANADA once as the 2 rows with CANADA have the same nationKey
-- and are on the same partition.
SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name;
rows:
  ('KENYA',0)
  ('MOROCCO',0)
  ('VIETNAM',2)
 
  ('ALGERIA',0)
  ('CANADA',2)
  ('EGYPT',4)
  ('FRANCE',3)
  ('GERMANY',3)
 
  ('BRAZIL',1)
  ('CHINA',2)
  ('INDIA',4)
  ('INDONESIA',2)
  ('IRAN',4)
  ('RUSSIA',3)
  ('UNITED KINGDOM',3)
  ('UNITED STATES',1)
 
  ('ARGENTINA',1)
  ('ETHIOPIA',0)
  ('IRAQ',4)
  ('JAPAN',2)
  ('JORDAN',4)
  ('MOZAMBIQUE',0)
  ('PERU',1)
  ('ROMANIA',3)
  ('SAUDI ARABIA',4)

-- basic select of two columnRefs with both in GROUP BY. No aggregation

SELECT n_name, n_nationkey FROM nation GROUP BY n_name, n_nationkey;
rows:
 ('MOZAMBIQUE',16)
 ('INDONESIA',9)
 ('VIETNAM',21)
 ('ALGERIA',0)
 ('IRAQ',11)
 ('GERMANY',7)
 ('ARGENTINA',1)
 ('UNITED STATES',24)
 ('UNITED KINGDOM',23)
 ('JORDAN',13)
 ('ETHIOPIA',5)
 ('KENYA',14)
 ('RUSSIA',22)
