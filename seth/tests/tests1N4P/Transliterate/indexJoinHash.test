//------------------------------------------------------------------------------
// INDEX JOIN (NO LEFT AND RIGHT DATA)
// T1.a = T2.a
// PtnKey[T] = b
// PtnKey[J] = c

// T1.a = T2.a
// PtnKey[T] = a
// PtnKey[J] = c

create table ${testName}_t1 (
	 a       INTEGER,
