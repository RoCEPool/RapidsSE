//------------------------------------------------------------------------------
// INDEX JOIN (NO LEFT AND RIGHT DATA)
// T1.a = T2.a
// PtnKey[T] = b
// PtnKey[J] = c

// T1.a = T2.a
// PtnKey[T] = a
// PtnKey[J] = c

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);
success

create table T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
);
success

create index T2_a on T2 (c);
success

