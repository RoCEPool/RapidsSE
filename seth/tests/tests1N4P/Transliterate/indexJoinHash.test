//------------------------------------------------------------------------------
// INDEX JOIN
// T1.a = T2.a
// PtnKey[T] = a
// PtnKey[J] = c

create table ${testName}_t1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);
success

create table ${testName}_t2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
);
success

create index T2_a on ${testName}_t2 (a);
success

load ${testName}_t1 "../DATA/Joins/T1.csv" ;
success

load ${testName}_t2 "../DATA/Joins/T2.csv" ;
success

select * from ${testName}_t1 /*+ joinAlgorithm = index, joinIndex = ${testName}_t2_a, joinRouting = hashcast, hashkey = ${testName}_t1.a */
  join ${testName}_t2 on ${testName}_t1.a = ${testName}_t2.a;
rows:
  (1,1001,1101,'T-ROW1',1,181,111,'J-ROW1')
  (3,303,33993,'T-ROW3',3,3344,333,'J-ROW3a')
  (3,303,33993,'T-ROW3',3,337,3339,'J-ROW3b')
  (4,null,4344,'T-ROW4',4,464,444,'J-ROW4')
  (6,6576,null,'T-ROW6',6,null,666,'J-ROW6')
  (7,727,7377,'T-ROW7',7,7347,null,'J-ROW7')

//------------------------------------------------------------------------------
// LEFT FILTER
select * from ${testName}_t1 /*+ joinAlgorithm = index, joinIndex = ${testName}_t2_a, joinRouting = hashcast, hashkey = ${testName}_t1.a */
  join ${testName}_t2 on ${testName}_t1.a = ${testName}_t2.a where ${testName}_t1.b >= 500;
rows:
  (6,6576,null,'T-ROW6',6,null,666,'J-ROW6')
  (7,727,7377,'T-ROW7',7,7347,null,'J-ROW7')
  (1,1001,1101,'T-ROW1',1,181,111,'J-ROW1')

//------------------------------------------------------------------------------
// RIGHT FILTER
select * from ${testName}_t1 /*+ joinAlgorithm = index, joinIndex = ${testName}_t2_a, joinRouting = hashcast, hashkey = ${testName}_t1.a */
  join ${testName}_t2 on ${testName}_t1.a = ${testName}_t2.a where ${testName}_t2.b >= 500;
rows:
  (3,303,33993,'T-ROW3',3,3344,333,'J-ROW3a')
  (7,727,7377,'T-ROW7',7,7347,null,'J-ROW7')

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER
select * from ${testName}_t1 /*+ joinAlgorithm = index, joinIndex = ${testName}_t2_a, joinRouting = hashcast, hashkey = ${testName}_t1.a */
  join ${testName}_t2 on ${testName}_t1.a = ${testName}_t2.a where ${testName}_t1.b >= 500 and ${testName}_t2.b >= 500;
rows:
 (7,727,7377,'T-ROW7',7,7347,null,'J-ROW7')

//------------------------------------------------------------------------------
// LEFT FILTER & PROJECT
select ${testName}_t1.a, ${testName}_t1.d, ${testName}_t2.* from ${testName}_t1 /*+ joinAlgorithm = index, joinIndex = ${testName}_t2_a, joinRouting = hashcast, hashkey = ${testName}_t1.a */
  join ${testName}_t2 on ${testName}_t1.a = ${testName}_t2.a where ${testName}_t1.b >= 500;
rows:
  (6,'T-ROW6',6,null,666,'J-ROW6')
  (7,'T-ROW7',7,7347,null,'J-ROW7')
  (1,'T-ROW1',1,181,111,'J-ROW1')

//------------------------------------------------------------------------------
// RIGHT FILTER & PROJECT
select ${testName}_t1.*, ${testName}_t2.a, ${testName}_t2.d from ${testName}_t1 /*+ joinAlgorithm = index, joinIndex = ${testName}_t2_a, joinRouting = hashcast, hashkey = ${testName}_t1.a */
  join ${testName}_t2 on ${testName}_t1.a = ${testName}_t2.a where ${testName}_t2.b >= 500;
rows:
  (3,303,33993,'T-ROW3',3,'J-ROW3a')
  (7,727,7377,'T-ROW7',7,'J-ROW7')

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER & PROJECT
select ${testName}_t1.a, ${testName}_t1.d, ${testName}_t2.a, ${testName}_t2.d from ${testName}_t1 /*+ joinAlgorithm = index, joinIndex = ${testName}_t2_a, joinRouting = hashcast, hashkey = ${testName}_t1.a */
  join ${testName}_t2 on ${testName}_t1.a = ${testName}_t2.a where ${testName}_t1.b >=500 and ${testName}_t2.b >= 500;
rows:
  (7,'T-ROW7',7,'J-ROW7')

//------------------------------------------------------------------------------
// drop the tables

drop table ${testName}_t1;
success

drop table ${testName}_t2;
success

MemoryLeaks;
rows: 0

CLEANUP {

  drop table ${testName}_t1;
  mute

  drop table ${testName}_t2;
  mute

  bye;
  mute
}