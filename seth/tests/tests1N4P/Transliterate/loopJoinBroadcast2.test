-> -> -> tableScanOp
         » table: (rapids.public.${testName2}_Region)

-> -> -> tableScanOp
         » table: (rapids.public.${testName2}_Nation)'
)

*/

-- Implicit join types ("JOIN" vs ",")
  -- implicit inner join with the JOIN keyword
SELECT n_name, r_name, s_name
FROM ${testName2}_Region
JOIN ${testName2}_Nation ON r_regionkey = n_regionkey
JOIN ${testName2}_Supplier ON s_nationkey = n_nationkey;
rows: 2000

  -- implicit cross join with the comma table-separator
SELECT n_name, r_name, s_name
FROM ${testName2}_Region, ${testName2}_Nation, ${testName2}_Supplier;
rows: 250000

  -- mixed implicit join types (1)
SELECT n_name, r_name, s_name
FROM ${testName2}_Region
JOIN ${testName2}_Nation ON r_regionkey = n_regionkey
, ${testName2}_Supplier;
rows: 50000

  -- mixed implicit join types (2)
SELECT n_name, r_name, s_name
FROM ${testName2}_Region, ${testName2}_Nation
JOIN ${testName2}_Supplier ON s_nationkey = n_nationkey;
rows: 10000

-- Validate columns returned:
  -- Inner/cross/outer joins return all columns
SELECT *
FROM ${testName2}_t1
INNER JOIN ${testName2}_t2 ON ${testName2}_t1.colA = ${testName2}_t2.colA;
