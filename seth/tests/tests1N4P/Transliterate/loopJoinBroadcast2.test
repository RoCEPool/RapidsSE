   » column: (Expr = rapidsse.public.partsupp.ps_suppkey ; Ordinal Expr = $16)

-> -> abstractJoinOp
      » join type: Cross Join
      » predicate: (true)
      » ordinal predicate: (true)

-> -> -> abstractJoinOp
         » join type: Cross Join
         » predicate: (true)
         » ordinal predicate: (true)

-> -> -> -> abstractJoinOp
            » join type: Cross Join
            » predicate: (true)
            » ordinal predicate: (true)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.region)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.supplier)

-> -> -> tableScanOp
         » table: (rapidsse.public.partsupp)'
)
*/

-- Self join, one table with an alias
SELECT nation.n_name, n2.n_regionkey
FROM nation
JOIN nation n2 ON nation.n_nationkey = n2.n_regionkey;
