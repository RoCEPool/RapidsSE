// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Join predicate tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- JOIN USING
  -- Single USING column
SELECT *
FROM ${testName2}_t1
JOIN ${testName2}_t2 USING (colB);
rows:
  (null,'T1-ROW2',11.32,false,2,'T1-ROW2',11.32,*,*,*)
  (7,'T1-ROW7',10.23,null,7,'T1-ROW7',null,*,*,*)
  (8,'T1-ROW8',13.24,false,8,'T1-ROW8',13.24,*,*,*)

  -- Multiple USING 2 columns
SELECT *
FROM ${testName2}_t1
JOIN ${testName2}_t2 USING (colB, colC);
rows:
  (null,'T1-ROW2',11.32,false,2,'T1-ROW2',11.32,*,*,*)
  (8,'T1-ROW8',13.24,false,8,'T1-ROW8',13.24,*,*,*)

  -- Multiple USING 3 columns
SELECT *
FROM ${testName2}_t1
JOIN ${testName2}_t2 USING (colB, colC, colA);
rows:
  (8,'T1-ROW8',13.24,false,8,'T1-ROW8',13.24,*,*,*)


-- Mixed JOIN ON and JOIN USING
SELECT *
FROM ${testName2}_t1
JOIN ${testName2}_t2 USING (colB, colC)
JOIN ${testName2}_t3 ON (${testName2}_t1.colA = ${testName2}_t3.colC);
rows:
  (8,'T1-ROW8',13.24,false,8,'T1-ROW8',13.24,*,*,*,8,'T3-ROW8',8.00)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

