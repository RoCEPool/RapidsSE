/*----------------------------------------------------------------------------*/
/* Joins tests                                                                */
/*----------------------------------------------------------------------------*/

-- Tests basic join handling


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Create various tables that can be joined
_region;
success

load region "../DATA/TPCH/region.tbl" ;
success

_nation;
success

load nation "../DATA/TPCH/nation.tbl" ;
success

_supplier;
success

load supplier "../DATA/TPCH/supplier_2k.tbl" ;
success

_partsupp;
success

load partsupp "../DATA/TPCH/partsupp_2k.tbl" ;
success

CREATE TABLE t1 (colA INTEGER, colB VARCHAR, colC DECIMAL, colD BOOLEAN);
success

load t1 "../DATA/Transliterate/broadcast_t1.csv" ;
success

CREATE TABLE t2 (colA INTEGER, colB VARCHAR, colC DECIMAL, colX DATE, colY TIME, colZ TIMESTAMP);
success

load t2 "../DATA/Transliterate/broadcast_t2.csv" ;
success

CREATE TABLE t3 (colA INTEGER, colB VARCHAR, colC DECIMAL);
success

load t3 "../DATA/Transliterate/broadcast_t3.csv" ;
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic join tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  n-way join tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
-- Join 2 tables
SELECT n_regionkey, n_name, r_regionkey, r_name
FROM region
JOIN nation ON r_regionkey = n_regionkey;
rows:
 (2,'VIETNAM',2,'ASIA')
 (0,'KENYA',0,'AFRICA')
 (0,'MOROCCO',0,'AFRICA')

 (1,'ARGENTINA',1,'AMERICA')
 (1,'PERU',1,'AMERICA')
 (2,'JAPAN',2,'ASIA')
 (0,'ETHIOPIA',0,'AFRICA')
 (0,'MOZAMBIQUE',0,'AFRICA')
 (3,'ROMANIA',3,'EUROPE')
 (4,'IRAQ',4,'MIDDLE EAST')
 (4,'JORDAN',4,'MIDDLE EAST')
 (4,'SAUDI ARABIA',4,'MIDDLE EAST')

 (1,'BRAZIL',1,'AMERICA')
 (1,'UNITED STATES',1,'AMERICA')
 (2,'INDIA',2,'ASIA')
 (2,'INDONESIA',2,'ASIA')
 (2,'CHINA',2,'ASIA')
 (3,'RUSSIA',3,'EUROPE')
 (3,'UNITED KINGDOM',3,'EUROPE')
 (4,'IRAN',4,'MIDDLE EAST')

 (1,'CANADA',1,'AMERICA')
 (0,'ALGERIA',0,'AFRICA')
 (3,'FRANCE',3,'EUROPE')
 (3,'GERMANY',3,'EUROPE')
 (4,'EGYPT',4,'MIDDLE EAST')

SELECT n_name, r_name FROM region, nation;
rows: 125

-- Join 3 tables
SELECT n_name, r_name, s_name
FROM region
JOIN nation ON r_regionkey = n_regionkey
JOIN supplier ON s_nationkey = n_nationkey;
rows: 2000

SELECT n_name, r_name, s_name FROM region, nation, supplier;
rows: 250000

-- Join 4 tables
SELECT n_name, r_name, s_name, ps_partkey
FROM region
JOIN nation ON r_regionkey = n_regionkey
JOIN supplier ON s_nationkey = n_nationkey
JOIN partsupp ON ps_suppkey = s_suppkey;
rows: 1999

