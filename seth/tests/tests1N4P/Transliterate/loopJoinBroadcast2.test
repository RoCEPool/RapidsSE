» queryText: "SELECT * FROM t1 LEFT OUTER JOIN t2 ON t1.colA = t2.colA"

-> projectOp
   » column: (Alias = colA ; Expr = rapidsse.public.t1.colA ; Ordinal Expr = $1)
   » column: (Alias = colB ; Expr = rapidsse.public.t1.colB ; Ordinal Expr = $2)
   » column: (Alias = colC ; Expr = rapidsse.public.t1.colC ; Ordinal Expr = $3)
   » column: (Alias = colD ; Expr = rapidsse.public.t1.colD ; Ordinal Expr = $4)
   » column: (Alias = colA ; Expr = rapidsse.public.t2.colA ; Ordinal Expr = $5)
   » column: (Alias = colB ; Expr = rapidsse.public.t2.colB ; Ordinal Expr = $6)
   » column: (Alias = colC ; Expr = rapidsse.public.t2.colC ; Ordinal Expr = $7)
   » column: (Alias = colX ; Expr = rapidsse.public.t2.colX ; Ordinal Expr = $8)
   » column: (Alias = colY ; Expr = rapidsse.public.t2.colY ; Ordinal Expr = $9)
   » column: (Alias = colZ ; Expr = rapidsse.public.t2.colZ ; Ordinal Expr = $10)

-> -> abstractJoinOp
      » join type: Left Outer Join
      » predicate: (rapidsse.public.t1.colA = rapidsse.public.t2.colA)
      » ordinal predicate: ($1 = $5)

-> -> -> tableScanOp
         » table: (rapidsse.public.t1)

-> -> -> tableScanOp
         » table: (rapidsse.public.t2)'
)
*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Join predicate tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- JOIN USING
  -- Single USING column
SELECT *
FROM t1
JOIN t2 USING (colB);
rows:
  (null,'T1-ROW2',11.32,false,2,'T1-ROW2',11.32,*,*,*)
  (7,'T1-ROW7',10.23,null,7,'T1-ROW7',null,*,*,*)
  (8,'T1-ROW8',13.24,false,8,'T1-ROW8',13.24,*,*,*)

  -- Multiple USING 2 columns
SELECT *
FROM t1
JOIN t2 USING (colB, colC);
rows:
  (null,'T1-ROW2',11.32,false,2,'T1-ROW2',11.32,*,*,*)
  (8,'T1-ROW8',13.24,false,8,'T1-ROW8',13.24,*,*,*)

  -- Multiple USING 3 columns
SELECT *
FROM t1
JOIN t2 USING (colB, colC, colA);
rows:
  (8,'T1-ROW8',13.24,false,8,'T1-ROW8',13.24,*,*,*)


-- Mixed JOIN ON and JOIN USING
SELECT *
FROM t1
JOIN t2 USING (colB, colC)
JOIN t3 ON (t1.colA = t3.colC);
rows:
  (8,'T1-ROW8',13.24,false,8,'T1-ROW8',13.24,*,*,*,8,'T3-ROW8',8.00)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  drop table nation ;
  mute

  drop table region ;
  mute

  drop table supplier ;
  mute

  drop table partsupp ;
  mute

  drop table t1 ;
  mute

  drop table t2;
  mute

  drop table t3;
  mute
}