LOW_MEMORY
SELECT n_name, r_name, s_name, ps_suppkey
FROM region, nation, supplier, partsupp;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT n_name, r_name, s_name, ps_suppkey FROM region, nation, supplier, partsupp"

-> projectOp
   » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $5)
   » column: (Expr = rapidsse.public.region.r_name ; Ordinal Expr = $2)
