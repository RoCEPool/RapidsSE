SELECT n1.n_name, n2.n_regionkey, r_name
FROM nation n1
JOIN region ON n1.n_regionkey = r_regionkey
JOIN nation n2 ON n2.n_regionkey = r_regionkey;
rows: 125

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Join type tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- explicit join types:
  -- inner join
SELECT n_name, r_name
FROM region
INNER JOIN nation ON r_regionkey = n_regionkey;
rows: 
   ('VIETNAM','ASIA')
   ('KENYA','AFRICA')
   ('MOROCCO','AFRICA')

   ('BRAZIL','AMERICA')
   ('UNITED STATES','AMERICA')
   ('INDIA','ASIA')
   ('INDONESIA','ASIA')
   ('CHINA','ASIA')
   ('RUSSIA','EUROPE')
   ('UNITED KINGDOM','EUROPE')
   ('IRAN','MIDDLE EAST')

   ('ARGENTINA','AMERICA')
   ('PERU','AMERICA')
   ('JAPAN','ASIA')
   ('ETHIOPIA','AFRICA')
   ('MOZAMBIQUE','AFRICA')
   ('ROMANIA','EUROPE')
   ('IRAQ','MIDDLE EAST')
   ('JORDAN','MIDDLE EAST')
   ('SAUDI ARABIA','MIDDLE EAST')

   ('CANADA','AMERICA')
   ('ALGERIA','AFRICA')
   ('FRANCE','EUROPE')
   ('GERMANY','EUROPE')
   ('EGYPT','MIDDLE EAST')

  -- cross join
SELECT n_name, r_name
FROM region
CROSS JOIN nation;
rows: 125

/*
  -- left outer join
EXPLAIN SELECT n_name, r_name
FROM region
LEFT OUTER JOIN nation ON r_regionkey = n_regionkey;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT n_name, r_name FROM region LEFT OUTER JOIN nation ON r_regionkey = n_regionkey"

-> projectOp
   » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $5)
   » column: (Expr = rapidsse.public.region.r_name ; Ordinal Expr = $2)

-> -> abstractJoinOp
      » join type: Left Outer Join
      » predicate: (rapidsse.public.region.r_regionkey = rapidsse.public.nation.n_regionkey)
      » ordinal predicate: ($1 = $6)

-> -> -> tableScanOp
         » table: (rapidsse.public.region)

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)'
)

*/

-- Implicit join types ("JOIN" vs ",")
  -- implicit inner join with the JOIN keyword
SELECT n_name, r_name, s_name
FROM region
JOIN nation ON r_regionkey = n_regionkey
JOIN supplier ON s_nationkey = n_nationkey;
rows: 2000

  -- implicit cross join with the comma table-separator
SELECT n_name, r_name, s_name
FROM region, nation, supplier;
rows: 250000

  -- mixed implicit join types (1)
SELECT n_name, r_name, s_name
FROM region
JOIN nation ON r_regionkey = n_regionkey
, supplier;
rows: 50000

  -- mixed implicit join types (2)
SELECT n_name, r_name, s_name
FROM region, nation
JOIN supplier ON s_nationkey = n_nationkey;
rows: 10000

-- Validate columns returned:
  -- Inner/cross/outer joins return all columns
SELECT *
FROM t1
INNER JOIN t2 ON t1.colA = t2.colA;
rows: 
  (1,'T1-ROW1',10.23,true,1,'T2-ROW1',10.23,*,*,*)
