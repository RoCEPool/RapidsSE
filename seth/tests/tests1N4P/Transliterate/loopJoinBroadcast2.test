-- Self join amongst other joined tables
SELECT n1.n_name, n2.n_regionkey, r_name
FROM nation n1
JOIN nation n2 ON n1.n_nationkey = n2.n_regionkey
JOIN region ON n1.n_regionkey = r_regionkey;
