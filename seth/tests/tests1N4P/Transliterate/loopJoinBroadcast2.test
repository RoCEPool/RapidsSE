SELECT n1.n_name, n2.n_regionkey, r_name
FROM ${testName2}_Nation n1
JOIN ${testName2}_Region ON n1.n_regionkey = r_regionkey
JOIN ${testName2}_Nation n2 ON n2.n_regionkey = r_regionkey;
