// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Join type tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- explicit join types:
  -- inner join
SELECT n_name, r_name
FROM ${testName2}_Region
INNER JOIN ${testName2}_Nation ON r_regionkey = n_regionkey;
rows: 
   ('VIETNAM','ASIA')
   ('KENYA','AFRICA')
   ('MOROCCO','AFRICA')

   ('BRAZIL','AMERICA')
   ('UNITED STATES','AMERICA')
   ('INDIA','ASIA')
   ('INDONESIA','ASIA')
   ('CHINA','ASIA')
   ('RUSSIA','EUROPE')
   ('UNITED KINGDOM','EUROPE')
   ('IRAN','MIDDLE EAST')

   ('ARGENTINA','AMERICA')
   ('PERU','AMERICA')
   ('JAPAN','ASIA')
   ('ETHIOPIA','AFRICA')
   ('MOZAMBIQUE','AFRICA')
   ('ROMANIA','EUROPE')
   ('IRAQ','MIDDLE EAST')
   ('JORDAN','MIDDLE EAST')
   ('SAUDI ARABIA','MIDDLE EAST')

   ('CANADA','AMERICA')
   ('ALGERIA','AFRICA')
   ('FRANCE','EUROPE')
   ('GERMANY','EUROPE')
   ('EGYPT','MIDDLE EAST')

  -- cross join
SELECT n_name, r_name
FROM ${testName2}_Region
CROSS JOIN ${testName2}_Nation;
rows: 125

/*
  -- left outer join
EXPLAIN SELECT n_name, r_name
FROM ${testName2}_Region
LEFT OUTER JOIN ${testName2}_Nation ON r_regionkey = n_regionkey;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT n_name, r_name FROM ${testName2}_Region LEFT OUTER JOIN ${testName2}_Nation ON r_regionkey = n_regionkey"

-> projectOp
   » column: (Expr = rapids.public.${testName2}_Nation.n_name ; Ordinal Expr = $5)
   » column: (Expr = rapids.public.${testName2}_Region.r_name ; Ordinal Expr = $2)

-> -> abstractJoinOp
      » join type: Left Outer Join
