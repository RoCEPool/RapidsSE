/*----------------------------------------------------------------------------*/
/* Joins tests                                                                */
/*----------------------------------------------------------------------------*/

-- Tests basic join handling


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Create various tables that can be joined
create table ${testName2}_Region (
	 R_REGIONKEY       INTEGER      NOT NULL,
	 R_NAME            CHAR(25)     NOT NULL,
	 R_COMMENT         VARCHAR(152)
)
tablesize 1
;
success

load ${testName2}_Region "../DATA/TPCH/region.tbl" ;
success

create table ${testName2}_Nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
)
tablesize 1
;
success

load ${testName2}_Nation "../DATA/TPCH/nation.tbl" ;
success

create table ${testName2}_Supplier (
	 S_SUPPKEY       INTEGER       NOT NULL,
	 S_NAME          CHAR(25)      NOT NULL,
	 S_ADDRESS       VARCHAR(40)   NOT NULL,
	 S_NATIONKEY     INTEGER       NOT NULL,
	 S_PHONE         CHAR(15)      NOT NULL,
	 S_ACCTBAL       DECIMAL(15,2) NOT NULL,
	 S_COMMENT       VARCHAR(101)  NOT NULL
)
tablesize 2
;
success

load ${testName2}_Supplier "../DATA/TPCH/supplier_2k.tbl" ;
success

create table ${testName2}_Partsupp (
	PS_PARTKEY      INTEGER       NOT NULL,
	PS_SUPPKEY      INTEGER       NOT NULL,
	PS_AVAILQTY     INTEGER       NOT NULL,
	PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
	PS_COMMENT      VARCHAR(199)  NOT NULL
)
tablesize 131
;
success

load ${testName2}_Partsupp "../DATA/TPCH/partsupp_2k.tbl" ;
success

CREATE TABLE ${testName2}_t1 (colA INTEGER, colB VARCHAR, colC DECIMAL, colD BOOLEAN);
success

load ${testName2}_t1 "../DATA/Transliterate/broadcast_t1.csv" ;
success

CREATE TABLE ${testName2}_t2 (colA INTEGER, colB VARCHAR, colC DECIMAL, colX DATE, colY TIME, colZ TIMESTAMP);
success

load ${testName2}_t2 "../DATA/Transliterate/broadcast_t2.csv" ;
success

CREATE TABLE ${testName2}_t3 (colA INTEGER, colB VARCHAR, colC DECIMAL);
success

load ${testName2}_t3 "../DATA/Transliterate/broadcast_t3.csv" ;
success

trackmemory force;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic join tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  n-way join tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
-- Join 2 tables
SELECT n_regionkey, n_name, r_regionkey, r_name
FROM ${testName2}_Region
JOIN ${testName2}_Nation ON r_regionkey = n_regionkey;
rows:
 (2,'VIETNAM',2,'ASIA')
 (0,'KENYA',0,'AFRICA')
 (0,'MOROCCO',0,'AFRICA')

 (1,'ARGENTINA',1,'AMERICA')
 (1,'PERU',1,'AMERICA')
 (2,'JAPAN',2,'ASIA')
 (0,'ETHIOPIA',0,'AFRICA')
 (0,'MOZAMBIQUE',0,'AFRICA')
 (3,'ROMANIA',3,'EUROPE')
 (4,'IRAQ',4,'MIDDLE EAST')
 (4,'JORDAN',4,'MIDDLE EAST')
 (4,'SAUDI ARABIA',4,'MIDDLE EAST')

 (1,'BRAZIL',1,'AMERICA')
 (1,'UNITED STATES',1,'AMERICA')
 (2,'INDIA',2,'ASIA')
 (2,'INDONESIA',2,'ASIA')
 (2,'CHINA',2,'ASIA')
 (3,'RUSSIA',3,'EUROPE')
 (3,'UNITED KINGDOM',3,'EUROPE')
 (4,'IRAN',4,'MIDDLE EAST')

 (1,'CANADA',1,'AMERICA')
 (0,'ALGERIA',0,'AFRICA')
 (3,'FRANCE',3,'EUROPE')
 (3,'GERMANY',3,'EUROPE')
 (4,'EGYPT',4,'MIDDLE EAST')

SELECT n_name, r_name FROM ${testName2}_Region, ${testName2}_Nation;
rows: 125

-- Join 3 tables
SELECT n_name, r_name, s_name
FROM ${testName2}_Region
JOIN ${testName2}_Nation ON r_regionkey = n_regionkey
JOIN ${testName2}_Supplier ON s_nationkey = n_nationkey;
rows: 2000

SELECT n_name, r_name, s_name FROM ${testName2}_Region, ${testName2}_Nation, ${testName2}_Supplier;
rows: 250000

-- Join 4 tables
SELECT n_name, r_name, s_name, ps_partkey
FROM ${testName2}_Region
JOIN ${testName2}_Nation ON r_regionkey = n_regionkey
JOIN ${testName2}_Supplier ON s_nationkey = n_nationkey
JOIN ${testName2}_Partsupp ON ps_suppkey = s_suppkey;
rows: 1999

/*
LOW_MEMORY
SELECT n_name, r_name, s_name, ps_suppkey
FROM ${testName2}_Region, ${testName2}_Nation, ${testName2}_Supplier, ${testName2}_Partsupp;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT n_name, r_name, s_name, ps_suppkey FROM ${testName2}_Region, ${testName2}_Nation, ${testName2}_Supplier, ${testName2}_Partsupp"

-> projectOp
   » column: (Expr = rapids.public.${testName2}_Nation.n_name ; Ordinal Expr = $5)
   » column: (Expr = rapids.public.${testName2}_Region.r_name ; Ordinal Expr = $2)
   » column: (Expr = rapids.public.${testName2}_Supplier.s_name ; Ordinal Expr = $9)
   » column: (Expr = rapids.public.${testName2}_Partsupp.ps_suppkey ; Ordinal Expr = $16)

-> -> abstractJoinOp
      » join type: Cross Join
      » predicate: (true)
      » ordinal predicate: (true)

-> -> -> abstractJoinOp
         » join type: Cross Join
         » predicate: (true)
         » ordinal predicate: (true)

-> -> -> -> abstractJoinOp
            » join type: Cross Join
            » predicate: (true)
            » ordinal predicate: (true)

-> -> -> -> -> tableScanOp
               » table: (rapids.public.${testName2}_Region)

-> -> -> -> -> tableScanOp
               » table: (rapids.public.${testName2}_Nation)

-> -> -> -> tableScanOp
            » table: (rapids.public.${testName2}_Supplier)

-> -> -> tableScanOp
         » table: (rapids.public.${testName2}_Partsupp)'
)
*/

-- Self join, one table with an alias
SELECT ${testName2}_Nation.n_name, n2.n_regionkey
FROM ${testName2}_Nation
JOIN ${testName2}_Nation n2 ON ${testName2}_Nation.n_nationkey = n2.n_regionkey;
