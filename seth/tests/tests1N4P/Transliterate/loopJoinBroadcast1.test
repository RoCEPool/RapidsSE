//------------------------------------------------------------------------------
// LEFT FILTER
select * from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t1.b >= 500;
rows:
  (6,6576,null,'T-ROW6',6,null,666,'J-ROW6')
  (7,727,7377,'T-ROW7',7,7347,null,'J-ROW7')
  (1,1001,1101,'T-ROW1',1,181,111,'J-ROW1')

//------------------------------------------------------------------------------
