//------------------------------------------------------------------------------
// BROADCAST JOIN
// T1.a = T2.a
// PtnKey[T] = b
// PtnKey[J] = c

create table ${testName2}_t1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (b);
success

load ${testName2}_t1 "../DATA/Joins/T1.csv" ;
success

