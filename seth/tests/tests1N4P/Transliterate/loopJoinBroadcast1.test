rows:
 (7,727,7377,'T-ROW7',7,7347,null,'J-ROW7')

//------------------------------------------------------------------------------
// LEFT FILTER & PROJECT
select ${testName2}_t1.a, ${testName2}_t1.d, ${testName2}_t2.* from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t1.b >= 500;
rows:
  (6,'T-ROW6',6,null,666,'J-ROW6')
  (7,'T-ROW7',7,7347,null,'J-ROW7')
  (1,'T-ROW1',1,181,111,'J-ROW1')

//------------------------------------------------------------------------------
// RIGHT FILTER & PROJECT
select ${testName2}_t1.*, ${testName2}_t2.a, ${testName2}_t2.d from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t2.b >= 500;
