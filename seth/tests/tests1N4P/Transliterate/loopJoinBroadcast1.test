	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);
success

load ${testName2}_t2 "../DATA/Joins/T2.csv" ;
success

select * from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a;
rows:
  (1,1001,1101,'T-ROW1',1,181,111,'J-ROW1')
  (3,303,33993,'T-ROW3',3,3344,333,'J-ROW3a')
  (3,303,33993,'T-ROW3',3,337,3339,'J-ROW3b')
