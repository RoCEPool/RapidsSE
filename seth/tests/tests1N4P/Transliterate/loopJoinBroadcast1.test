--------------------------------------------------------------------------------
-- LOOP JOIN tests --- CO-PARTITIONED JOINS (BROADCAST)
--------------------------------------------------------------------------------

trackmemory force;
success;

//------------------------------------------------------------------------------
// BROADCAST JOIN (NO LEFT DATA)
// T1.a = T2.a
// PtnKey[T] = b
// PtnKey[J] = c

create table ${testName2}_t1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (b);
success

create table ${testName2}_t2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);
success

load ${testName2}_t2 "../DATA/Joins/T2.csv" ;
success

select * from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a;
rows: 0

//------------------------------------------------------------------------------
// LEFT FILTER
select * from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t1.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// RIGHT FILTER
select * from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t2.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER
select * from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t1.b >= 500 and ${testName2}_t2.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// LEFT FILTER & PROJECT
select ${testName2}_t1.a, ${testName2}_t1.d, ${testName2}_t2.* from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t1.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// RIGHT FILTER & PROJECT
select ${testName2}_t1.*, ${testName2}_t2.a, ${testName2}_t2.d from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t2.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// LEFT and RIGHT FILTER & PROJECT
select ${testName2}_t1.a, ${testName2}_t1.d, ${testName2}_t2.a, ${testName2}_t2.d from ${testName2}_t1 join ${testName2}_t2 on ${testName2}_t1.a = ${testName2}_t2.a where ${testName2}_t1.b >=500 and ${testName2}_t2.b >= 500;
rows: 0

//------------------------------------------------------------------------------
// CROSS JOIN
SELECT ${testName2}_t1.a, ${testName2}_t2.a FROM ${testName2}_t1, ${testName2}_t2;
rows: 0

// drop the tables
drop table ${testName2}_t1;
success

drop table ${testName2}_t2;
success


