/*----------------------------------------------------------------------------*/
/* UNION tests                                                                */
/*----------------------------------------------------------------------------*/

//------------------------------------------------------------------------------
// neither table exists
SELECT l_orderkey FROM ${testName}_Lineitem UNION ALL SELECT o_orderkey FROM ${testName}_Orders;
failure contains: "No such table"

//------------------------------------------------------------------------------
// create table ${testName}_Lineitem
create table ${testName}_Lineitem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

//------------------------------------------------------------------------------
// one table does not exist
SELECT l_orderkey FROM ${testName}_Lineitem UNION ALL SELECT o_orderkey FROM ${testName}_Orders;
failure contains: "No such table"

//------------------------------------------------------------------------------
create table ${testName}_Orders (
   O_ORDERKEY        INTEGER       NOT NULL,  // 0)
   O_CUSTKEY         INTEGER       NOT NULL,  // 1)
   O_ORDERSTATUS     CHAR(1)       NOT NULL,  // 2)
   O_TOTALPRICE      DECIMAL(15,2) NOT NULL,  // 3)
   O_ORDERDATE       DATE          NOT NULL,  // 4)
   O_ORDERPRIORITY   CHAR(15)      NOT NULL,  // 5)
   O_CLERK           CHAR(15)      NOT NULL,  // 6)
   O_SHIPPRIORITY    INTEGER       NOT NULL,  // 7)
   O_COMMENT         VARCHAR(79)   NOT NULL   // 8)
) ;
success

//------------------------------------------------------------------------------
// no data in either table
SELECT l_orderkey FROM ${testName}_Lineitem UNION ALL SELECT o_orderkey FROM ${testName}_Orders;
rows: 0

//------------------------------------------------------------------------------
// load data
load ${testName}_Lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
// data in one table
SELECT l_orderkey FROM ${testName}_Lineitem UNION ALL SELECT o_orderkey FROM ${testName}_Orders;
rows:
  (1)
  (1)
  (1)
  (1)
  (1)
  (1)
  (2)
  (3)
  (3)
  (3)

//------------------------------------------------------------------------------
// data in first table
// truncate the ${testName}_Lineitem table
truncate ${testName}_Lineitem;
success;

//------------------------------------------------------------------------------
// load the ${testName}_Orders table
load ${testName}_Orders "../DATA/TPCH/orders10.csv";
success

//------------------------------------------------------------------------------
// data in second table
SELECT l_orderkey FROM ${testName}_Lineitem UNION ALL SELECT o_orderkey FROM ${testName}_Orders;
rows:
  (1)
  (2)
  (3)
  (4)
  (5)
  (6)
  (7)
  (32)
  (33)
  (34)

//------------------------------------------------------------------------------
// load data
load ${testName}_Lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
// data in both tables
SELECT l_orderkey FROM ${testName}_Lineitem UNION ALL SELECT o_orderkey FROM ${testName}_Orders;
rows:
  (1)
  (1)
  (1)
  (1)
  (1)
  (1)
  (1)
  (2)
  (2)
  (3)
  (3)
  (3)
  (3)
  (4)
  (5)
  (6)
  (7)
  (32)
  (33)
  (34)

//------------------------------------------------------------------------------
SELECT L_PARTKEY, L_ORDERKEY from ${testName}_Lineitem union all select O_ORDERKEY, O_CUSTKEY FROM ${testName}_Orders;
success

/*
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Non-empty CORRESPONDING BY clause with valid columns
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

SELECT * FROM unionTbl1 UNION ALL CORRESPONDING BY (col1, col3) SELECT * FROM unionTbl2;
success

// case insensitive tests
SELECT * FROM unionTbl4 UNION ALL CORRESPONDING BY (alpha, bravo) SELECT * FROM unionTbl5;
success

SELECT * FROM unionTbl4 UNION ALL CORRESPONDING BY (BRAVO, CHARLIE) SELECT * FROM unionTbl5;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Empty CORRESPONDING BY clause with matching column types
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

SELECT * FROM unionTbl1 UNION ALL CORRESPONDING SELECT * FROM unionTbl2;
rows:
  ['col1', 'col2', 'col3']

SELECT * FROM unionTbl4 UNION ALL CORRESPONDING SELECT * FROM unionTbl5;
rows:
  ['alpha', 'bravo', 'charlie']

SELECT * FROM unionTbl6 UNION ALL CORRESPONDING SELECT * FROM unionTbl1;
rows:
  ['col3', 'col1']

SELECT * FROM unionTbl6 UNION ALL CORRESPONDING SELECT * FROM unionTbl4;
rows:
  ['bRaVo']
*/


drop table ${testName}_Lineitem;
success

drop table ${testName}_Orders;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE ${testName}_Lineitem;
  mute

  DROP TABLE ${testName}_Orders;
  mute
}