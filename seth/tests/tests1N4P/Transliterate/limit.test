--------------------------------------------------------------------------------
-- limit tests
--------------------------------------------------------------------------------

//------------------------------------------------------------------------------
// create table lineitem
create table LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

//------------------------------------------------------------------------------
select l_discount from lineitem limit 3;
rows: 0

// load data
load lineitem "../TPCH/SF_0001/lineitem.csv";
success

//------------------------------------------------------------------------------
select l_partkey from lineitem limit 3;
rows: 3

//------------------------------------------------------------------------------
select l_returnflag from lineitem limit 5;
rows: 5

//------------------------------------------------------------------------------
select SUM(l_discount) FROM lineitem WHERE l_orderkey < 20 limit 3;
rows:
  (84.16)

//------------------------------------------------------------------------------
SELECT l_orderkey, SUM(l_discount) FROM lineitem GROUP BY l_orderkey limit 3;
rows:
  (0,4.24)
  (1,4.13)
  (2,4.22)

//------------------------------------------------------------------------------
SELECT l_discount FROM lineitem order by l_discount limit 3;
rows:
  (1.00)
  (1.00)
  (1.00)

//------------------------------------------------------------------------------
SELECT L_QUANTITY FROM lineitem where L_QUANTITY > 10.0 order by L_QUANTITY limit 3;
rows:
  (11.00)
  (11.00)
  (11.00)

//------------------------------------------------------------------------------
SELECT L_QUANTITY FROM lineitem order by L_TAX limit 3;
rows:
  (11.00)
  (11.00)
  (11.00)

//------------------------------------------------------------------------------
SELECT L_QUANTITY FROM lineitem order by L_ORDERKEY limit 8;
rows:
  (6.00)
  (30.00)
  (32.00)
  (24.00)
  (50.00)
  (24.00)
  (36.00)
  (17.00)

//------------------------------------------------------------------------------
// drop the table
drop table lineitem;
success;

CLEANUP {
  
  drop table lineitem;
  mute
  
  bye;
  mute
}