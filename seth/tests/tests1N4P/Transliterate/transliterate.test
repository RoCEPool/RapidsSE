
trackMemory;
success

//------------------------------------------------------------------------------
// create table
create table datums (
int_col0   INTEGER,
int_col1  INTEGER,
bol_col2   BOOLEAN,
bol_col3   BOOLEAN,
dte_col4   DATE,
dte_col5   DATE,
dec_col6   DECIMAL(19,2),
dec_col7   DECIMAL(19,2),
flt_col8   FLOAT,
flt_col9  FLOAT,
tme_col10  TIME,
tme_col11  TIME,
tsp_col12  TIMESTAMP,
tsp_col13  TIMESTAMP,
vch_col14  VARCHAR(32),
vch_col15  VARCHAR(32)
);
success

//------------------------------------------------------------------------------------
explain stage transliterate select int_col1 from datums;
rows: (*,'transliterate','pipeline unnamed
begin
  stage startStage on origin :
    start
    | pulse once
    |     stageMarker4122
  stage stageMarker4122 on all partitions :
    scan rapidsse public datums
    | project 0 " type INTEGER as int_col1 $2 "
    |     stageLast
  stage stageLast on origin :
    output
    | sink
    | startStage
end ;
')

//------------------------------------------------------------------------------------
explain stage transliterate select SUM(int_col1), int_col0 from datums GROUP BY int_col0;
row: (*,'transliterate','pipeline unnamed
begin
  stage startStage on origin :
    start
    | pulse once
    |     stageMarker3358
  stage stageMarker3358 on all partitions :
    scan rapidsse public datums
    | aggreg 1 " type INTEGER )  $2 sum  , type INTEGER $1 as int_col0 groupBy  type INTEGER $1 "
    |     stageLast
  stage stageLast on origin :
    output
    | sink
    | startStage
end ;
')

//------------------------------------------------------------------------------------
explain stage transliterate select SUM(int_col1) + 3, int_col0 from datums GROUP BY int_col0;
row: (*,'transliterate','pipeline unnamed
begin
  stage startStage on origin :
    start
    | pulse once
    |     stageMarker3497
  stage stageMarker3497 on all partitions :
    scan rapidsse public datums
    | aggreg 1 " type INTEGER )  $2 sum  3  +  , type INTEGER $1 as int_col0 groupBy  type INTEGER $1 "
    |     stageLast
  stage stageLast on origin :
    output
    | sink
    | startStage
end ;
')


//------------------------------------------------------------------------------------
explain stage transliterate select SUM(int_col1) + 5 / 60 from datums;
row: (*,'transliterate','pipeline unnamed
begin
  stage startStage on origin :
    start
    | pulse once
    |     stageMarker3917
  stage stageMarker3917 on all partitions :
    scan rapidsse public datums
    | aggreg 1 " type INTEGER )  $2 sum  5  60  /  +  "
    |     stageLast
  stage stageLast on origin :
    output
    | sink
    | startStage
end ;
')


//------------------------------------------------------------------------------------
explain stage transliterate select bol_col2,vch_col14, SUM(dec_col6 / 6) * 6 from datums GROUP BY bol_col2,vch_col14;
row: (*,'transliterate','pipeline unnamed
begin
  stage startStage on origin :
    start
    | pulse once
    |     stageMarker3668
  stage stageMarker3668 on all partitions :
    scan rapidsse public datums
    | aggreg 1 " type BOOLEAN $1 as bol_col2 , type VARCHAR $2 as vch_col14 , type DECIMAL )  $7 6  /  sum  6  *  groupBy  type BOOLEAN $3 , type VARCHAR $15 "
    |     stageLast
  stage stageLast on origin :
    output
    | sink
    | startStage
end ;
')

//------------------------------------------------------------------------------------
explain stage transliterate select int_col0+int_col1, SUM(dec_col6) from datums GROUP BY int_col0+int_col1;
row: (*,'transliterate','pipeline unnamed
begin
  stage startStage on origin :
    start
    | pulse once
    |     stageMarker3212
  stage stageMarker3212 on all partitions :
    scan rapidsse public datums
    | aggreg 1 " type INTEGER $K1 , type DECIMAL )  $7 sum  groupBy  type INTEGER $1 $2 +  "
    |     stageLast
  stage stageLast on origin :
    output
    | sink
    | startStage
end ;
')

//------------------------------------------------------------------------------
// drop the table
drop table datums;
success;

memoryleaks;
rows: 0

CLEANUP {

  drop table datums;
  mute

  bye;
  mute
}




































