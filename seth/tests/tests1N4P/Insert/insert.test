/*----------------------------------------------------------------------------*/
/* insert.test -- insert tests                                                */
/*----------------------------------------------------------------------------*/

// (1) create a table
create table ${testName2}_T1 (
  col0   integer not null,
  col1   varchar(32) not null
);
success

// (2) create an index on the table
create index idx on ${testName2}_T1 (col0);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
  (*, *, '${testName2}_T1', 'idx', false, false)

// check columns of index
select * from indexColumns where TableName = '${testName2}_T1' and IndexName = 'idx';
contains rows:
  (*, *, '${testName2}_T1', 'idx', 'col0', 'INTEGER', 19, 0, false, true)

// (3) now load some data into the table
load ${testName2}_T1 "../seth/tests/Insert/insert.csv" ;
success

// check no of rows
select * from ${testName2}_T1;
rows: 12

// (4) insert some rows into the table

begin insert ${testName2}_T1;
success

insert row "1,abcdef";
success

insert row "2,ghijk";
success

insert row "3,lmno";
success

insert row "4,pqr";
success

insert row "5,stuvw";
success

insert row "6,xyz";
success

insert row "7,abc";
success

insert row "8,defgh";
success

insert row "9,ijk";
success

insert row "10,lmn";
success

end insert;
success

// check no of rows
select * from ${testName2}_T1;
rows: 22

insert row "21,null";
failure: 'Table does not exist'

// (5) insert some invalid row
begin insert ${testName2}_T1;
success

insert row "21,null";
failure: 'invalid value'

insert row "22,ghijk";
success

end insert;
success

// check no of rows
select * from ${testName2}_T1;
rows: 23

CLEANUP {

  drop table ${testName2}_T1;
  mute
}

