--------------------------------------------------------------------------------
-- 3wayJoin_5.test : 3 tables A,B,C where size(A) < size(B) , size(B) > size(C)
--------------------------------------------------------------------------------
trackmemory force;
success

create table ${testName2}_A(A_COL0 integer, A_COL1 integer, A_COL2 integer) tablesize 1000;
success
create table ${testName2}_B(B_COL0 integer, B_COL1 integer, B_COL2 integer) tablesize 10000;
success
create table ${testName2}_C(C_COL0 integer, C_COL1 integer, C_COL2 integer) tablesize 1000;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create index A_COL0  on ${testName2}_A (A_COL0  );
success
create index A_COL1  on ${testName2}_A (A_COL1  );
success
create index A_COL2  on ${testName2}_A (A_COL2  );
success

create index B_COL0  on ${testName2}_B (B_COL0  );
success
create index B_COL1  on ${testName2}_B (B_COL1  );
success
create index B_COL2  on ${testName2}_B (B_COL2  );
success

create index C_COL0  on ${testName2}_C (C_COL0  );
success
create index C_COL1  on ${testName2}_C (C_COL1  );
success
create index C_COL2  on ${testName2}_C (C_COL2  );
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

load ${testName2}_A "../DATA/Select/select.csv";
success
load ${testName2}_B "../DATA/Select/select.csv";
success
load ${testName2}_C "../DATA/Select/select.csv";
success

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 1
//  Partitions = 4
//  size(A) < size(B) , size(B) < size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb == ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from ${testName2}_A
   join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
   join ${testName2}_C on ${testName2}_B.B_COL0 = ${testName2}_C.C_COL0
 ;

Join Permutations:
                                     Network Total  Unicast Total
  A->B (UNICAST)(0) ->C (UNICAST)(0) Total=(0+0)  , 1000+(1000*10000)
  B->A (UNICAST)(0) ->C (UNICAST)(0) Total=(0+0)  , 10000+(10000*1000)
  B->C (UNICAST)(0) ->A (UNICAST)(0) Total=(0+0)  , 10000+(10000*1000)
  C->B (UNICAST)(0) ->A (UNICAST)(0) Total=(0+0)  , 1000+(1000*10000)

Expected join order:
  Either A->B->C or C->B->A
********************************************************************************/

/joinPermutations
select count(*)
  from ${testName2}_A
   join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
   join ${testName2}_C on ${testName2}_B.B_COL0 = ${testName2}_C.C_COL0
 ;
rows:
  ('${testName2}_A UNICAST ${testName2}_B UNICAST ${testName2}_C')
  ('${testName2}_B UNICAST ${testName2}_A UNICAST ${testName2}_C')
  ('${testName2}_B UNICAST ${testName2}_C UNICAST ${testName2}_A')
  ('${testName2}_C UNICAST ${testName2}_B UNICAST ${testName2}_A')


/joinOrder
select count(*)
  from ${testName2}_A
   join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
   join ${testName2}_C on ${testName2}_B.B_COL0 = ${testName2}_C.C_COL0
 ;
rows: ('${testName2}_A UNICAST ${testName2}_B UNICAST ${testName2}_C')

select count(*)
  from ${testName2}_A
   join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
   join ${testName2}_C on ${testName2}_B.B_COL0 = ${testName2}_C.C_COL0
 ;
rows: (138)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 2
//  Partitions = 4
//  size(A) < size(B) , size(B) > size(C)
//  A            ->  B               B          ->  C
//  cola == ptn  ->  colb == ptn     colb = ptn ->  colc != ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from ${testName2}_A
   join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
   join ${testName2}_C on ${testName2}_B.B_COL0 = ${testName2}_C.C_COL1
 ;

Join Permutations:                                        Network Total                  Unicast Total
  A->B (UNICAST)(0)        ->C (BROADCAST) (4*1000*10000) Total=(0+(4*1000*10000))       , 1000
  B->A (UNICAST)(0)        ->C (BROADCAST) (4*10000*1000) Total=(0+(4*10000*1000))       , 10000
  B->C (BROADCAST)(4*10000)->A (HASHCAST)  (10000*1000)   Total=(4*10000+(10000*1000))   , 0
  C->B (HASHCAST)(1000)    ->A (UNICAST)  (0)             Total=(1000+0)                 , 10000*10000

Expected join order:
  Either C->B->A

********************************************************************************/

/joinPermutations
select count(*)
  from ${testName2}_A
  join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
  join ${testName2}_C on ${testName2}_B.B_COL0 = ${testName2}_C.C_COL1
;
rows:
  ('${testName2}_A UNICAST ${testName2}_B BROADCAST ${testName2}_C')
  ('${testName2}_B UNICAST ${testName2}_A BROADCAST ${testName2}_C')
  ('${testName2}_B BROADCAST ${testName2}_C HASHCAST ${testName2}_A')
  ('${testName2}_C HASHCAST ${testName2}_B UNICAST ${testName2}_A')


/joinOrder
select count(*)
  from ${testName2}_A
   join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
   join ${testName2}_C on ${testName2}_B.B_COL0 = ${testName2}_C.C_COL1
 ;
rows: ('${testName2}_C HASHCAST ${testName2}_B UNICAST ${testName2}_A')

select count(*)
  from ${testName2}_A
   join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
   join ${testName2}_C on ${testName2}_B.B_COL0 = ${testName2}_C.C_COL1
 ;
rows: (61)

