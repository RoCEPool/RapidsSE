  B->C (HASHCAST)(10000)  ->A (HASHCAST) (10000*1000)  Total=(10000+(10000*1000))  , 0
  C->B (BROADCAST)(4*1000)->A (UNICAST)  (0)           Total=(4*1000 + 0)            , 1000*10000

Expected join order:
  Either A->B->C

********************************************************************************/

/joinPermutations
select count(*)
  from ${testName2}_A
   join ${testName2}_B on ${testName2}_A.A_COL0 = ${testName2}_B.B_COL0
   join ${testName2}_C on ${testName2}_B.B_COL1 = ${testName2}_C.C_COL0
 ;
rows:
