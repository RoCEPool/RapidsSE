--------------------------------------------------------------------------------
-- 3wayJoin_3.test : 3 tables A,B,C where size(A) = size(B) , size(B) > size(C)
--------------------------------------------------------------------------------
trackmemory force;
success

create table A(A_COL0 integer, A_COL1 integer, A_COL2 integer) tablesize 10000;
success
create table B(B_COL0 integer, B_COL1 integer, B_COL2 integer) tablesize 10000;
success
create table C(C_COL0 integer, C_COL1 integer, C_COL2 integer) tablesize 1000;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create index A_COL0  on A (A_COL0  );
success
create index A_COL1  on A (A_COL1  );
success
create index A_COL2  on A (A_COL2  );
success

create index B_COL0  on B (B_COL0  );
success
create index B_COL1  on B (B_COL1  );
success
create index B_COL2  on B (B_COL2  );
success

create index B_COL0  on C (C_COL0  );
success
create index B_COL1  on C (C_COL1  );
success
create index B_COL2  on C (C_COL2  );
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

load A "../DATA/Select/select.csv";
success
load B "../DATA/Select/select.csv";
success
load C "../DATA/Select/select.csv";
success

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 1
//  Partitions = 4
//  size(A) = size(B) , size(B) > size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb == ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;

Join Permutations:
                                     Network Total  Unicast Total
  A->B (UNICAST)(0) ->C (UNICAST)(0) Total=(0+0)  , 10000+(10000*10000)
  B->A (UNICAST)(0) ->C (UNICAST)(0) Total=(0+0)  , 10000+(10000*10000)
  B->C (UNICAST)(0) ->A (UNICAST)(0) Total=(0+0)  , 10000+(10000*1000)
  C->B (UNICAST)(0) ->A (UNICAST)(0) Total=(0+0)  , 1000+(10000*1000)

Expected join order:
  Either C->B->A
  ********************************************************************************/

/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows: ('C UNICAST B UNICAST A, 0, 10001000')

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows: (138)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 2
//  Partitions = 4
//  size(A) = size(B) , size(B) > size(C)
//  A            ->  B               B          ->  C
//  cola == ptn  ->  colb == ptn     colb = ptn ->  colc != ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL1
 ;

Join Permutations:                                         Network Total                  Unicast Total
  A->B (UNICAST)(0)        ->C (BROADCAST) (4*10000*10000) Total=(0+(4*10000*10000))    , 10000
  B->A (UNICAST)(0)        ->C (BROADCAST) (4*10000*10000) Total=(0+(4*10000*10000))    , 10000
  B->C (BROADCAST)(4*10000)->A (HASHCAST)  (10000*1000)    Total=(4*10000+(10000*1000)) , 0
  C->B (HASHCAST)(1000)    ->A (UNICAST)   (0)             Total=(4*1000+(1000*10000))  , 1000*10000

Expected join order:
  Either C->B-A

********************************************************************************/

/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL1
 ;
rows: ('C BROADCAST B HASHCAST A, 10004000, 0')

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL1
 ;
rows: (61)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 3
//  Partitions = 4
//  size(A) = size(B) , size(B) > size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb != ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL0
 ;

Join Permutations:                                     Network Total                 Unicast Total
  A->B (UNICAST)(0)       ->C (HASHCAST) (10000*10000) Total=(0+(10000*10000))     , 10000
  B->A (UNICAST)(0)       ->C (HASHCAST) (10000*10000) Total=(0+(10000*10000))     , 1000
  B->C (HASHCAST)(10000)  ->A (HASHCAST) (10000*1000)  Total=(10000+(10000*1000))  , 0
  C->B (BROADCAST)(4*1000)->A (UNICAST)  (0)           Total=((4*1000)+0)          , 1000*10000

Expected join order:
  Either C->B->A

********************************************************************************/
/weaved select * from A;
rows: 12

/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL0
 ;
rows: ('C BROADCAST B UNICAST A, 4000, 10000000')

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL0
 ;
rows: (73)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 4
//  Partitions = 4
//  size(A) = size(B) , size(B) > size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb != ptn ->  colc != ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL1
 ;

Join Permutations:                                      Network Total                 Unicast Total
  A->B (UNICAST)(0)        ->C (BROADCAST) (4*1000*1000) Total=(0+(4*1000*1000))        , 1000
  B->A (UNICAST)(0)        ->C (BROADCAST) (4*1000*1000) Total=(0+(4*1000*1000))        , 1000
  B->C (BROADCAST)(4*1000) ->A (HASHCAST)  (1000*1000)   Total=((4*1000)+(1000*1000))   , 0
  C->B (BROADCAST)(4*1000) ->A (UNICAST)   (0)           Total=(4*1000)                 , 1000*1000

Expected join order:
  Either C->B->A

********************************************************************************/

/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL1
 ;
rows: ('C BROADCAST B UNICAST A, 4000, 1000000')

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL1
 ;
rows: (65)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 5
//  Partitions = 4
//  size(A) = size(B) , size(B) > size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb != ptn     colb == ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;

Join Permutations:
                                                      Network Total             Unicast Total
  A->B (BROADCAST)(4*10000) ->C (UNICAST)(0)          Total=((4*10000)+0)     , 10000*10000
  B->A (HASHCAST)(10000)    ->C (UNICAST)(0)          Total=(10000+0)         , 10000*10000
  B->C (UNICAST)(0)         ->A (HASHCAST)(1000*1000) Total=(0+(1000*1000))   , 10000+(10000*1000)
  C->B (UNICAST)(0)         ->A (HASHCAST)(1000*10000) Total=(0+(1000*10000)) , 1000

Expected join order:
  C->B->A

********************************************************************************/
/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;

rows: ('C UNICAST B UNICAST A, 0, 10001000')

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;

rows: (73)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 6
//  Partitions = 4
//  size(A) = size(B) , size(B) > size(C)
//  A            ->  B               B          ->  C
//  cola != ptn  ->  colb == ptn     colb = ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;

Join Permutations:                                        Network Total                Unicast Total
  A->B (HASHCAST) (10000)   ->C (UNICAST)  (0)            Total=(10000+0)            , 10000*10000
  B->A (BROADCAST)(4*10000) ->C (UNICAST)  (0)            Total=((4*10000)+0)        , 10000*10000
  B->C (UNICAST)(0)         ->A (BROADCAST)(4*10000*1000) Total=(0 + (4*10000*1000)) , 10000
  C->B (UNICAST)(0)         ->A (BROADCAST)(4*1000*10000) Total=(0 + (4*1000*10000)) , 1000

Expected join order:
  A->B->C
********************************************************************************/
/joinOrder
select count(*)
  from A
   join B on A.A_COL1 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows: ('A HASHCAST B UNICAST C, 10000, 100000000')

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows: (61)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 7
//  Partitions = 4
//  size(A) = size(B) , size(B) > size(C)
//  A            ->  B               B           ->  C
//  cola != ptn  ->  colb != ptn     colb == ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;

Join Permutations:                                      Network Total             , Unicast Total
  A->B (BROADCAST)(4*10000) ->C (UNICAST)  (0)          Total=((4*10000)+0)       , 10000*10000
  B->A (BROADCAST)(4*10000) ->C (UNICAST)  (0)          Total=((4*10000)+0)       , 10000*10000
  B->C (UNICAST)(0)         ->A (HASHCAST) (10000*1000) Total=(0 + (10000*1000))  , 10000
  C->B (UNICAST)(0)         ->A (HASHCAST) (1000*10000) Total=(0 + (1000*10000))  , 1000

Expected join order:
  Either A->B->C or B->A->C

********************************************************************************/
/joinOrder
select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;
rows: ('A BROADCAST B UNICAST C, 40000, 100000000')

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;
rows: (65)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 8
//  Partitions = 4
//  size(A) = size(B) , size(B) > size(C)
//  A            ->  B               B           ->  C
//  cola != ptn  ->  colb != ptn     colb != ptn ->  colc != ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL1 = C.C_COL1
 ;

Join Permutations:                                          Network Total                     Unicast Total
  A->B (BROADCAST)(4*10000) ->C (BROADCAST) (4*10000*10000) Total=(4*10000+(4*10000*10000)) , 0
  B->A (BROADCAST)(4*10000) ->C (BROADCAST) (4*10000*10000) Total=(4*10000+(4*10000*10000)) , 0
  B->C (BROADCAST)(4*10000) ->A (BROADCAST) (4*10000*1000)  Total=(4*10000+(4*10000*1000))  , 0
  C->B (BROADCAST)(4*1000)  ->A (BROADCAST) (4*1000*10000)  Total=(4*1000+(4*1000*10000))   , 0

Expected join order:
  Either C->B->A
********************************************************************************/

/joinOrder
select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL1 = C.C_COL1
 ;
rows: ('C BROADCAST B BROADCAST A, 40004000, 0')

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL1 = C.C_COL1
 ;
rows: (42)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
drop table A;
drop table B;
drop table C;

MemoryLeaks;
rows: 0

CLEANUP {

  drop table A;
  mute

  drop table B;
  mute

  drop table C;
  mute

  bye;
  mute
}


