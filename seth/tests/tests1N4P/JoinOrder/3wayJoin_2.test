/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 8
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B           ->  C
//  cola != ptn  ->  colb != ptn     colb != ptn ->  colc != ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL1 = C.C_COL1
 ;

Join Permutations:                                         Network Total                   Unicast Total
  A->B (BROADCAST)(4*1000)  ->C (BROADCAST) (4*1000*1000)  Total=(4*1000+(4*1000*1000))  , 0
  B->A (BROADCAST)(4*1000)  ->C (BROADCAST) (4*1000*1000)  Total=(4*1000+(4*1000*1000))  , 0
  B->C (BROADCAST)(4*1000)  ->A (BROADCAST) (4*1000*10000) Total=(4*1000+(4*1000*10000)) , 0
  C->B (BROADCAST)(4*10000) ->A (BROADCAST) (4*10000*1000) Total=(4*1000+(4*10000*1000)) , 0

Expected join order:
  Either A->B-C or B->A->C

********************************************************************************/
/joinPermutations
select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL1 = C.C_COL1
 ;
rows:
  ('A BROADCAST B BROADCAST C')
  ('B BROADCAST A BROADCAST C')
  ('B BROADCAST C BROADCAST A')
  ('C BROADCAST B BROADCAST A')


/joinOrder
select count(*)
  from A
   join B on A.A_COL1 = B.B_COL1
   join C on B.B_COL1 = C.C_COL1
 ;
rows: ('A BROADCAST B BROADCAST C')

select count(*)
