--------------------------------------------------------------------------------
-- 3wayJoin_2.test : 3 tables A,B,C where size(A) = size(B) , size(B) < size(C)
--------------------------------------------------------------------------------
trackMemory;
success

create table A(A_COL0 integer, A_COL1 integer, A_COL2 integer) tablesize 1000;
success
create table B(B_COL0 integer, B_COL1 integer, B_COL2 integer) tablesize 1000;
success
create table C(C_COL0 integer, C_COL1 integer, C_COL2 integer) tablesize 10000;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create index A_COL0  on A (A_COL0  );
success
create index A_COL1  on A (A_COL1  );
success
create index A_COL2  on A (A_COL2  );
success

create index B_COL0  on B (B_COL0  );
success
create index B_COL1  on B (B_COL1  );
success
create index B_COL2  on B (B_COL2  );
success

create index C_COL0  on C (C_COL0  );
success
create index C_COL1  on C (C_COL1  );
success
create index C_COL2  on C (C_COL2  );
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

load A "../DATA/Select/select.csv";
success
load B "../DATA/Select/select.csv";
success
load C "../DATA/Select/select.csv";
success

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 1
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb == ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;

Join Permutations:
                                     Network Total ,  Unicast Total
  A->B (UNICAST)(0) ->C (UNICAST)(0) Total=(0+0)   ,  1000+(1000*1000)
  B->A (UNICAST)(0) ->C (UNICAST)(0) Total=(0+0)   ,  1000+(1000*1000)
  B->C (UNICAST)(0) ->A (UNICAST)(0) Total=(0+0)   ,  1000+(10000*1000)
  C->B (UNICAST)(0) ->A (UNICAST)(0) Total=(0+0)   ,  10000+(1000*1000)

Expected join order:
  A->B->C or B->A->C
********************************************************************************/

/joinPermutations
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows:
  ('A UNICAST B UNICAST C')
  ('B UNICAST A UNICAST C')
  ('B UNICAST C UNICAST A')
  ('C UNICAST B UNICAST A')


/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows: ('A UNICAST B UNICAST C')

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows: (138)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 2
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B          ->  C
//  cola == ptn  ->  colb == ptn     colb = ptn ->  colc != ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL1
 ;

Join Permutations:                                       Network Total                  Unicast Total
  A->B (UNICAST)(0)        ->C (BROADCAST) (4*1000*1000) Total=(0+(4*1000*1000))      , 1000
  B->A (UNICAST)(0)        ->C (BROADCAST) (4*1000*1000) Total=(0+(4*1000*1000))      , 1000
  B->C (BROADCAST)(4*1000) ->A (HASHCAST)  (1000*10000)  Total=(4*1000+(1000*10000))   , 0
  C->B (HASHCAST)(10000)   ->A (UNICAST)   (0)           Total=(10000+0)              , 10000*1000

Expected join order:
  Either C->B->A

********************************************************************************/

/joinPermutations
select count(*)
  from A
  join B on A.A_COL0 = B.B_COL0
  join C on B.B_COL0 = C.C_COL1
;
rows:
  ('A UNICAST B BROADCAST C')
  ('B UNICAST A BROADCAST C')
  ('B BROADCAST C HASHCAST A')
  ('C HASHCAST B UNICAST A')

// CHECK WITH RAY
// A->B->C
/*
/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL1
 ;
rows: ('C HASHCAST B UNICAST A')
*/

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL0 = C.C_COL1
 ;
rows: (61)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 3
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb != ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL0
 ;

Join Permutations:                                     Network Total                  Unicast Total
  A->B (UNICAST)(0)        ->C (HASHCAST) (1000*1000)  Total=(0+(1000*1000))        , 1000
  B->A (UNICAST)(0)        ->C (HASHCAST) (1000*1000)  Total=(0+(1000*1000))        , 1000
  B->C (HASHCAST)(1000)    ->A (HASHCAST) (1000*10000) Total=(1000+(1000*10000))    , 0
  C->B (BROADCAST)(4*10000)->A (UNICAST) (0)           Total=(4*10000+(0))          , 10000*1000

Expected join order:
  Either C->B->A

********************************************************************************/

/joinPermutations
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL0
 ;
rows:
  ('A UNICAST B HASHCAST C')
  ('B UNICAST A HASHCAST C')
  ('B HASHCAST C HASHCAST A')
  ('C BROADCAST B UNICAST A')


// CHECK WITH RAY
// A->B->C
/*
/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL0
 ;
rows: ('C BROADCAST B UNICAST A')
*/

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL0
 ;
rows: (73)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 4
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb != ptn ->  colc != ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL1
 ;

Join Permutations:                                     Network Total                  Unicast Total
  A->B (UNICAST)(0)        ->C (BROADCAST) (4*1000*1000)  Total=(0+(4*1000*1000))       , 1000
  B->A (UNICAST)(0)        ->C (BROADCAST) (4*1000*1000)  Total=(0+(4*1000*1000))       , 1000
  B->C (BROADCAST)(4*1000) ->A (HASHCAST) (1000*10000)    Total=(4*1000 + (1000*10000)) , 0
  C->B (BROADCAST)(4*10000)->A (UNICAST)  (0)             Total=(4*10000)               , 10000*1000

Expected join order:
  C->B->A

********************************************************************************/

/joinPermutations
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL0
   join C on B.B_COL1 = C.C_COL1
 ;
rows:
  ('A UNICAST B BROADCAST C')
  ('B UNICAST A BROADCAST C')
  ('B BROADCAST C HASHCAST A')
  ('C BROADCAST B UNICAST A')


