//  cola == ptn  ->  colb != ptn     colb == ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;

Join Permutations:
                                                     Network Total ,            Unicast Total
  A->B (BROADCAST)(4*1000) ->C (UNICAST)(0)           Total=((4*1000)+0)       , 1000*1000
  B->A (HASHCAST)(1000)    ->C (HASHCAST)(1000*1000)  Total=(1000+(1000*1000)) , 0
  B->C (UNICAST)(0)        ->A (HASHCAST)(1000*10000) Total=(0+(1000*10000))   , 1000
  C->B (UNICAST)(0)        ->A (HASHCAST)(10000*1000) Total=(0+(10000*1000))   , 10000

Expected join order:
  A->B->C

********************************************************************************/
/joinPermutations
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;
rows:
  ('A BROADCAST B UNICAST C')
  ('B HASHCAST A HASHCAST C')
  ('B UNICAST C HASHCAST A')
  ('C UNICAST B HASHCAST A')


/joinOrder
select count(*)
  from A
   join B on A.A_COL0 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;

rows: ('A BROADCAST B UNICAST C')

select count(*)
  from A
   join B on A.A_COL0 = B.B_COL1
   join C on B.B_COL0 = C.C_COL0
 ;

rows: (73)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 6
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B          ->  C
//  cola != ptn  ->  colb == ptn     colb = ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;

Join Permutations:                                      Network Total                  Unicast Total
  A->B (HASHCAST) (1000)  ->C (UNICAST)  (0)            Total=(1000+0)               , 1000*1000
  B->A (BROADCAST)(4*1000)->C (HASHCAST)  (1000*1000)   Total=((4*1000)+(1000*1000)) , 0
  B->C (UNICAST)(0)       ->A (BROADCAST)(4*1000*10000) Total=(0 +(4*1000*10000))    , 1000
  C->B (UNICAST)(0)       ->A (BROADCAST)(4*10000*1000) Total=(0 +(4*10000*1000))    , 10000

Expected join order:
  A->B->C

********************************************************************************/
/joinPermutations
select count(*)
  from A
   join B on A.A_COL1 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows:
  ('A HASHCAST B UNICAST C')
  ('B BROADCAST A HASHCAST C')
  ('B UNICAST C BROADCAST A')
  ('C UNICAST B BROADCAST A')


/joinOrder
select count(*)
  from A
   join B on A.A_COL1 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows: ('A HASHCAST B UNICAST C')

select count(*)
  from A
   join B on A.A_COL1 = B.B_COL0
   join C on B.B_COL0 = C.C_COL0
 ;
rows: (61)

