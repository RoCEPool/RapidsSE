 ;
rows: ('${testName}_C HASHCAST ${testName}_B UNICAST ${testName}_A')
*/

select count(*)
  from ${testName}_A
   join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
   join ${testName}_C on ${testName}_B.B_COL0 = ${testName}_C.C_COL1
 ;
rows: (61)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 3
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb != ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from ${testName}_A
   join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
   join ${testName}_C on ${testName}_B.B_COL1 = ${testName}_C.C_COL0
 ;

Join Permutations:                                     Network Total                  Unicast Total
  A->B (UNICAST)(0)        ->C (HASHCAST) (1000*1000)  Total=(0+(1000*1000))        , 1000
  B->A (UNICAST)(0)        ->C (HASHCAST) (1000*1000)  Total=(0+(1000*1000))        , 1000
  B->C (HASHCAST)(1000)    ->A (HASHCAST) (1000*10000) Total=(1000+(1000*10000))    , 0
  C->B (BROADCAST)(4*10000)->A (UNICAST) (0)           Total=(4*10000+(0))          , 10000*1000

Expected join order:
  Either C->B->A

********************************************************************************/

/joinPermutations
select count(*)
  from ${testName}_A
   join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
   join ${testName}_C on ${testName}_B.B_COL1 = ${testName}_C.C_COL0
 ;
rows:
  ('${testName}_A UNICAST ${testName}_B HASHCAST ${testName}_C')
  ('${testName}_B UNICAST ${testName}_A HASHCAST ${testName}_C')
  ('${testName}_B HASHCAST ${testName}_C HASHCAST ${testName}_A')
  ('${testName}_C BROADCAST ${testName}_B UNICAST ${testName}_A')


