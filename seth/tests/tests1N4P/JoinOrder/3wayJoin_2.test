--------------------------------------------------------------------------------
-- 3wayJoin_2.test : 3 tables A,B,C where size(A) = size(B) , size(B) < size(C)
--------------------------------------------------------------------------------
trackMemory;
success

create table ${testName}_A(A_COL0 integer, A_COL1 integer, A_COL2 integer) tablesize 1000;
success
create table ${testName}_B(B_COL0 integer, B_COL1 integer, B_COL2 integer) tablesize 1000;
success
create table ${testName}_C(C_COL0 integer, C_COL1 integer, C_COL2 integer) tablesize 10000;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create index A_COL0  on ${testName}_A (A_COL0  );
success
create index A_COL1  on ${testName}_A (A_COL1  );
success
create index A_COL2  on ${testName}_A (A_COL2  );
success

create index B_COL0  on ${testName}_B (B_COL0  );
success
create index B_COL1  on ${testName}_B (B_COL1  );
success
create index B_COL2  on ${testName}_B (B_COL2  );
success

create index C_COL0  on ${testName}_C (C_COL0  );
success
create index C_COL1  on ${testName}_C (C_COL1  );
success
create index C_COL2  on ${testName}_C (C_COL2  );
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

load ${testName}_A "../DATA/Select/select.csv";
success
load ${testName}_B "../DATA/Select/select.csv";
success
load ${testName}_C "../DATA/Select/select.csv";
success

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 1
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B           ->  C
//  cola == ptn  ->  colb == ptn     colb == ptn ->  colc == ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from ${testName}_A
   join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
   join ${testName}_C on ${testName}_B.B_COL0 = ${testName}_C.C_COL0
 ;

Join Permutations:
                                     Network Total ,  Unicast Total
  A->B (UNICAST)(0) ->C (UNICAST)(0) Total=(0+0)   ,  1000+(1000*1000)
  B->A (UNICAST)(0) ->C (UNICAST)(0) Total=(0+0)   ,  1000+(1000*1000)
  B->C (UNICAST)(0) ->A (UNICAST)(0) Total=(0+0)   ,  1000+(10000*1000)
  C->B (UNICAST)(0) ->A (UNICAST)(0) Total=(0+0)   ,  10000+(1000*1000)

Expected join order:
  A->B->C or B->A->C
********************************************************************************/

/joinPermutations
select count(*)
  from ${testName}_A
   join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
   join ${testName}_C on ${testName}_B.B_COL0 = ${testName}_C.C_COL0
 ;
rows:
  ('${testName}_A UNICAST ${testName}_B UNICAST ${testName}_C')
  ('${testName}_B UNICAST ${testName}_A UNICAST ${testName}_C')
  ('${testName}_B UNICAST ${testName}_C UNICAST ${testName}_A')
  ('${testName}_C UNICAST ${testName}_B UNICAST ${testName}_A')


/joinOrder
select count(*)
  from ${testName}_A
   join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
   join ${testName}_C on ${testName}_B.B_COL0 = ${testName}_C.C_COL0
 ;
rows: ('${testName}_A UNICAST ${testName}_B UNICAST ${testName}_C')

select count(*)
  from ${testName}_A
   join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
   join ${testName}_C on ${testName}_B.B_COL0 = ${testName}_C.C_COL0
 ;
rows: (138)

/********************************************************************************
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  TEST CASE 2
//  Partitions = 4
//  size(A) = size(B) , size(B) < size(C)
//  A            ->  B               B          ->  C
//  cola == ptn  ->  colb == ptn     colb = ptn ->  colc != ptn
// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select count(*)
  from ${testName}_A
   join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
   join ${testName}_C on ${testName}_B.B_COL0 = ${testName}_C.C_COL1
 ;

Join Permutations:                                       Network Total                  Unicast Total
  A->B (UNICAST)(0)        ->C (BROADCAST) (4*1000*1000) Total=(0+(4*1000*1000))      , 1000
  B->A (UNICAST)(0)        ->C (BROADCAST) (4*1000*1000) Total=(0+(4*1000*1000))      , 1000
  B->C (BROADCAST)(4*1000) ->A (HASHCAST)  (1000*10000)  Total=(4*1000+(1000*10000))   , 0
  C->B (HASHCAST)(10000)   ->A (UNICAST)   (0)           Total=(10000+0)              , 10000*1000

Expected join order:
  Either C->B->A

********************************************************************************/

/joinPermutations
select count(*)
  from ${testName}_A
  join ${testName}_B on ${testName}_A.A_COL0 = ${testName}_B.B_COL0
  join ${testName}_C on ${testName}_B.B_COL0 = ${testName}_C.C_COL1
;
rows:
  ('${testName}_A UNICAST ${testName}_B BROADCAST ${testName}_C')
  ('${testName}_B UNICAST ${testName}_A BROADCAST ${testName}_C')
  ('${testName}_B BROADCAST ${testName}_C HASHCAST ${testName}_A')
  ('${testName}_C HASHCAST ${testName}_B UNICAST ${testName}_A')

// CHECK WITH RAY
// A->B->C
