/*----------------------------------------------------------------------------*/
/* uniBol.test -- BOOLEAN DATUM tests                                         */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table ${testName}_uniBol (
  bol_col BOOLEAN NOT NULL
);
success

load ${testName}_uniBol "../FASTLOAD/Data/uniBol.csv" ;
success

// check no of rows
select * from ${testName}_uniBol;
rows: 4

// check data
select * from ${testName}_uniBol;
rows:
  (true)
  (false)
  (false)
  (true)

// drop the table)
drop table ${testName}_uniBol;
success

// get memory leaks)
memoryLeaks;
rows: 0

CLEANUP {
  // drop the table)
  drop table ${testName}_uniBol;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/

