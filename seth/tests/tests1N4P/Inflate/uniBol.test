/*----------------------------------------------------------------------------*/
/* uniBol.test -- BOOLEAN DATUM tests                                         */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// (1) create a table
create table ${testName2}_uniBol (
  bol_col BOOLEAN NOT NULL
);
success

load ${testName2}_uniBol "../FASTLOAD/Data/uniBol.csv" ;
success

// check no of rows
select * from ${testName2}_uniBol;
rows: 4

// check data
select * from ${testName2}_uniBol;
rows:
  (true)
  (false)
  (false)
  (true)

// drop the table)
drop table ${testName2}_uniBol;
success

// get memory leaks)
memoryLeaks;
rows: 0

CLEANUP {
  // drop the table)
  drop table ${testName2}_uniBol;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/

