/*----------------------------------------------------------------------------*/
/* uniBcd.test -- BCD DATUM tests                                             */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table uniBcd (
  bcd_col  DECIMAL(15,2) NOT NULL
);
success

load uniBcd "../FASTLOAD/Data/uniBcd.csv" ;
success

// check no of rows
tableScan uniBcd;
rows: 40

// check data
tableScan uniBcd;
rows:
  (0.00)
  (0.10)
  (0.20)
  (0.30)
  (0.40)
  (0.50)
  (0.60)
  (0.70)
  (0.80)
  (0.90)
  (1.00)
  (1.10)
  (1.20)
  (1.30)
  (1.40)
  (1.50)
  (1.60)
  (1.70)
  (1.80)
  (1.90)
  (0.12)
  (1.12)
  (21.12)
  (321.12)
  (4321.12)
  (5321.12)
  (654321.12)
  (7654321.12)
  (87654321.12)
