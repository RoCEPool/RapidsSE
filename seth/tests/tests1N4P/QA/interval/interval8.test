select i.*,c+interval '1' year from ${testName2}_interval8 i;
failure contains: "EC_SEMANTIC_ERROR;"
select i.*,d+interval '1-2' year to month from ${testName2}_interval8 i;
failure contains: "EC_SEMANTIC_ERROR;"
select i.*,e+interval '1' day from ${testName2}_interval8 i;
failure contains: "EC_SEMANTIC_ERROR;"
select i.*,h+interval '1 2' day to hour from ${testName2}_interval8 i;
failure contains: "EC_SEMANTIC_ERROR;"
select i.*,i+interval '1 2:3:4' day to second from ${testName2}_interval8 i;
failure contains: "EC_SEMANTIC_ERROR;"
select i.*,j+interval '1:2:12' hour to second from ${testName2}_interval8 i;
failure contains: "EC_SEMANTIC_ERROR;"


