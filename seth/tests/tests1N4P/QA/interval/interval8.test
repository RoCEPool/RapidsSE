
create table ${testName2}_interval8(a date,b timestamp,c decimal,d integer,e float,h varchar,i char(10),j boolean,k timestamp);
success
load ${testName2}_interval8 "../DATA/QA/interval/interval8.csv";
success

select a,b,c,d from ${testName2}_interval8 i where a+interval '21:04:00.123' hour to second=b;
rows:
(date '2022-03-07',timestamp '2022-03-07 21:04:00.123',234.56,1)
(date '2010-10-05',timestamp '2010-10-05 21:04:00.123',3333.98,3)


