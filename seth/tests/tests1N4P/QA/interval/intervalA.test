
create table interval6(a date,b timestamp,c time);
success
load interval6 "../DATA/QA/interval/interval6.csv";
success

select * from interval6 where a+interval '1' month>date '2022-12-31';
rows:
(date '2023-01-31',timestamp '2000-02-28 23:00:00',time '00:00:00')
(date '2023-02-28',timestamp '2023-04-30 21:56:56',time '01:01:01')
(date '2023-04-30',timestamp '2023-01-31 11:02:00',time '01:23:10')

select a+interval '1' month,count(*) from interval6 group by a+interval '1' month;
rows:
(date '2023-02-28',1)
(date '2023-05-30',1)
(date '2023-03-28',1)
(date '2000-03-29',1)
(date '2000-02-29',2)
(date '2021-12-12',1)
(date '2000-03-28',1)

select a+interval '1' month,count(*) from interval6 group by a+interval '1' month having extract(month from a+interval '1' month)=2;
rows:
(date '2000-02-29',2)
(date '2023-02-28',1)

select a+interval '1' month,count(*) from interval6 group by a+interval '1' month having extract(month from a+interval '1' month)=2; // order by a+interval '1' month desc;
rows:
(date '2023-02-28',1)
(date '2000-02-29',2)

select a+interval '1' month,count(*) from interval6 group by a+interval '1' month having extract(month from a+interval '1' month)=2 order by a+interval '1' month desc;
rows:
(date '2023-02-28',1)
(date '2000-02-29',2)

