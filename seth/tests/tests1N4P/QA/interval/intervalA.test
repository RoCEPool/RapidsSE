select * from interval6 where c+interval '1' hour>cast(b as time);
rows:
(date '2000-01-31',timestamp '2022-12-31 01:00:23.000',time '09:02:23')

select * from interval6 where c+interval '600' minute>cast(b as time);
rows:
(date '2023-04-30',timestamp '2023-01-31 11:02:00',time '01:23:10')
(date '2000-01-31',timestamp '2022-12-31 01:00:23',time '09:02:23')
(date '2021-11-12',timestamp '2018-07-28 19:38:23',time '13:36:09')

