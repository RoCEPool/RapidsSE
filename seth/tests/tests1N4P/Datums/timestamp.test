/*============================================================================*/
/* timestamp.test -- TIMESTAMP DATUM tests                                    */
/*============================================================================*/

// begin tracking memory
trackmemory force;
success

create table ${testName2}_tspTbl (
  tsp_col1   TIMESTAMP   NOT NULL,
  vch_col2   VARCHAR(32) NOT NULL,
  int_col3   INTEGER     NOT NULL,
  int_col4   INTEGER     NOT NULL,
  ivl_col5   DECIMAL(10,2) NOT NULL,
  flt_col6   FLOAT       NOT NULL,
  tsp_col7   TIMESTAMP
);
success

// create index tsp_idx1
create index tsp_idx1 on ${testName2}_tspTbl (tsp_col1);
success

// create index tsp_idx2
create index tsp_idx2 on ${testName2}_tspTbl (tsp_col7);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_tspTbl';
contains rows:
(*, *, '${testName2}_tspTbl', 'tsp_idx1', false, false)
(*, *, '${testName2}_tspTbl', 'tsp_idx2', false, false)

// check columns of index
select * from indexColumns where TableName = '${testName2}_tspTbl' and IndexName = 'tsp_idx1';
contains rows:
(*, *, '${testName2}_tspTbl', 'tsp_idx1', 'tsp_col1', 'TIMESTAMP', 0, 0, false, true)

// check columns of index
select * from indexColumns where TableName = '${testName2}_tspTbl' and IndexName = 'tsp_idx2';
contains rows:
(*, *, '${testName2}_tspTbl', 'tsp_idx2', 'tsp_col7', 'TIMESTAMP', 0, 0, true, false)

Load ${testName2}_tspTbl "../DATA/Datums/timestamp.csv" ;
warning contains: '27 rows were invalid'

// check no of rows
select * from ${testName2}_tspTbl;
rows: 100

// dump index tsp_idx1
// dumpidx ${testName2}_tspTbl tsp_idx1;
// success

// dump index tsp_idx2
// dumpidx ${testName2}_tspTbl tsp_idx2;
// success

// fetch
//
//rows:
//  ('1904-01-01 00:00:00',four,104,4,4.004,1004.004,null)

// drop the table
drop table ${testName2}_tspTbl;
success

// check existence of table
lstbl;
does not contain rows: ('${testName2}_tspTbl')

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName2}_tspTbl;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/

