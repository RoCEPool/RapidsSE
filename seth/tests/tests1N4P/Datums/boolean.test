/*----------------------------------------------------------------------------*/
/* boolean.test -- BOOLEAN DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// (1) create a table
create table ${testName2}_bolTbl (
  bol_col1   BOOLEAN     NOT NULL,
  vch_col2   VARCHAR(32) NOT NULL,
  int_col3   INTEGER     NOT NULL,
  int_col4   INTEGER     NOT NULL,
  dec_col5   DECIMAL(10,2) NOT NULL,
  flt_col6   FLOAT       NOT NULL,
  tsp_col7   TIMESTAMP   NOT NULL,
  bol_col8   BOOLEAN
);
success

// create indexes
create index bol_idx1 on ${testName2}_bolTbl (bol_col1);
success

// create indexes
create index bol_idx2 on ${testName2}_bolTbl (bol_col8);
success

// check existence of index
lsidx ${testName2}_bolTbl;
rows:
  ('bol_idx1', false, false)
  ('bol_idx2', false, false)

// check columns of index
lsidxcol ${testName2}_bolTbl bol_idx1;
rows:
  ('bol_col1', 'BOOLEAN', 0, 0, false, true)

// check columns of index
lsidxcol ${testName2}_bolTbl bol_idx2;
rows:
  ('bol_col8', 'BOOLEAN', 0, 0, true, false)

load ${testName2}_bolTbl "../DATA/Datums/boolean.csv" ;
warning contains: '18 rows were invalid'
//failure contains: '18 invalid'

tableSizes;
rows:
  (*, '${testName2}_bolTbl', '1MB');
  
// check no of rows
select * from ${testName2}_bolTbl;
rows: 102

// dump index bol_idx1
// dumpidx ${testName2}_bolTbl bol_idx1;

// dump index bol_idx2
// dumpidx ${testName2}_bolTbl bol_idx2;

// drop the table
drop table ${testName2}_bolTbl;
success

// check existence of table
lstbl;
rows: 0

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName2}_bolTbl;
  mute
}

