/*----------------------------------------------------------------------------*/
/* decimal.test -- DECIMAL DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// (1) create a table
create table ${testName2}_decTbl (
  dec_col1  DECIMAL(10,2) NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  int_col3  INTEGER     NOT NULL,
  int_col4  INTEGER     NOT NULL,
  ivl_col5  DECIMAL(10,2) NOT NULL,
  dec_col6  DECIMAL,
  tsp_col7  TIMESTAMP   NOT NULL,
  bol_col8  BOOLEAN     NOT NULL
);
success

// create indexes
create index dec_idx1 on ${testName2}_decTbl (dec_col1);
success

create index dec_idx2 on ${testName2}_decTbl (dec_col6);
success

// check existence of index
lsidx ${testName2}_decTbl;
rows:
('dec_idx1', false, false)
('dec_idx2', false, false)

// check columns of index
lsidxcol ${testName2}_decTbl dec_idx1;
rows:
('dec_col1', 'DECIMAL', 10, 2, false, true)

// check columns of index
lsidxcol ${testName2}_decTbl dec_idx2;
rows:
('dec_col6', 'DECIMAL',19, 2, true, false)

Load ${testName2}_decTbl "../DATA/Datums/decimal.csv" ;
warning contains: '15 rows were invalid'

// check no of rows
select * from ${testName2}_decTbl;
rows: 101

// dump dec_idx1
// dumpidx ${testName2}_decTbl dec_idx1;
// success

// dump dec_idx2
// dumpidx ${testName2}_decTbl dec_idx2;
// success

// drop the table
drop table ${testName2}_decTbl;
success

// check existence of table
lstbl;
rows: 0

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  // drop the table
  drop table ${testName2}_decTbl;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
