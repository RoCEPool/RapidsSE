/*----------------------------------------------------------------------------*/
/* nulls.test -- NULL values in DATUM tests                                   */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table ${testName}_nulTbl (
  bol_col1   BOOLEAN,
  vch_col2   VARCHAR(32),
  int_col3   INTEGER,
  int_col4   INTEGER,
  dec_col5   DECIMAL(10,2),
  flt_col6   FLOAT,
  tsp_col7   TIMESTAMP ,
  bol_col8   BOOLEAN
);
success

Load ${testName}_nulTbl "../DATA/Datums/nulls.csv" ;
success

// check no of rows
select * from ${testName}_nulTbl;
rows: 50

// drop the table
drop table ${testName}_nulTbl;
success

// check existence of table
lstbl;
rows: 0

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName}_nulTbl;
  mute
  
  bye;
  mute
}

