/*----------------------------------------------------------------------------*/
/* decimal.test -- DECIMAL DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// (1) create a table
create table ${testName2}_fltTbl (
  flt_col1  FLOAT       NOT NULL,
  vch_col1  VARCHAR(32) NOT NULL,
  int_col3  INTEGER     NOT NULL,
  int_col4  INTEGER     NOT NULL,
  ivl_col5  DECIMAL(10,2) NOT NULL,
  flt_col6  FLOAT
);

// create indexes
create index flt_idx1 on ${testName2}_fltTbl (flt_col1);
success

create index flt_idx2 on ${testName2}_fltTbl (flt_col6);
success

// check existence of index
lsidx ${testName2}_fltTbl;
rows:
('flt_idx1', false, false)
('flt_idx2', false, false)

// check columns of index
lsidxcol ${testName2}_fltTbl flt_idx1;
rows:
('flt_col1', 'FLOAT', 19, 0, false, true)

// check columns of index
lsidxcol ${testName2}_fltTbl flt_idx2;
rows:
('flt_col6', 'FLOAT', 19, 0, true, false)

Load ${testName2}_fltTbl "../DATA/Datums/float.csv" ;
failure contains: '15 rows were invalid'

// check no of rows
select * from ${testName2}_fltTbl;
rows: 101

// dump index flt_idx1
// dumpidx ${testName2}_fltTbl flt_idx1;

// dump index flt_idx2
// dumpidx ${testName2}_fltTbl flt_idx2;

// fetch
predicateFetch ${testName2}_fltTbl "flt_col1 1011.011 =";
SELECT * FROM ${testName2}_fltTbl WHERE flt_col1 = 1011.011;
rows:
  (1011.01e0,'oneone',111,1,11.01,null)

// drop the table
drop table ${testName2}_fltTbl;
success

// check existence of table
lstbl;
does not contain rows: ('${testName2}_fltTbl')

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName2}_fltTbl;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
