/*----------------------------------------------------------------------------*/
/* Arithmetic tests                                                           */
/* (mostly for difficult types)                                               */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

trackmemory;
success

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

load nation "../DATA/TPCH/nation.tbl" ;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval + Interval
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// YM interval arithmetic /1 (same type)
SELECT INTERVAL '1' YEAR + INTERVAL '2' YEAR FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '3' YEAR)

// YM interval arithmetic /2 (same type, with negative)
SELECT INTERVAL '1' YEAR + INTERVAL -'2' YEAR FROM nation where n_nationkey = 2;
rows:
  (INTERVAL -'1' YEAR)
         
// YM interval arithmetic /3 (mixed types)
SELECT INTERVAL '1' YEAR + INTERVAL '2' MONTH FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '1-2' YEAR TO MONTH)

// YM interval arithmetic /4 (max)
SELECT INTERVAL '6004799503160660' YEAR + INTERVAL '15' MONTH FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '6004799503160661-3' YEAR TO MONTH)

// YM interval arithmetic /5 (overflow)
SELECT INTERVAL '6004799503160660' YEAR + INTERVAL '25' MONTH FROM nation where n_nationkey = 2;
failure contains: 'EC_INTERVAL_OUT_OF_RANGE'

// DT interval arithmetic of same type /1
SELECT INTERVAL '1' MINUTE + INTERVAL '2' MINUTE FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '3' MINUTE)

// DT interval arithmetic of same type /2
SELECT INTERVAL '1:2:3' HOUR TO SECOND + INTERVAL '4:5:6' HOUR TO SECOND FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '5:7:9' HOUR TO SECOND)

// DT interval arithmetic of mixed types /1
SELECT INTERVAL '1' MINUTE + INTERVAL '2' SECOND FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '1:2' MINUTE TO SECOND)
         
// DT interval arithmetic of mixed types /2
SELECT INTERVAL '1 2' DAY TO HOUR + INTERVAL '3' SECOND FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '1 2:0:3' DAY TO SECOND)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval - Interval
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// YM interval arithmetic /1 (same type)
SELECT INTERVAL '1' YEAR - INTERVAL '2' YEAR FROM nation where n_nationkey = 2;
rows:
  (INTERVAL -'1' YEAR)

// YM interval arithmetic /2 (same type, with negative)
SELECT INTERVAL '1' YEAR - INTERVAL -'2' YEAR FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '3' YEAR)

// YM interval arithmetic /3 (mixed types)
SELECT INTERVAL '1' YEAR - INTERVAL '2' MONTH FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '0-10' YEAR TO MONTH)

// DT interval arithmetic of same type /1
SELECT INTERVAL '1' MINUTE - INTERVAL '2' MINUTE FROM nation where n_nationkey = 2;
rows:
  (INTERVAL -'1' MINUTE)

// DT interval arithmetic of same type /2
SELECT INTERVAL '1:2:3' HOUR TO SECOND - INTERVAL '4:5:6' HOUR TO SECOND FROM nation where n_nationkey = 2;
rows:
  (INTERVAL -'3:3:3' HOUR TO SECOND)

// DT interval arithmetic of mixed types /1
SELECT INTERVAL '1' MINUTE - INTERVAL '2' SECOND FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '0:58' MINUTE TO SECOND)

// DT interval arithmetic of mixed types /2
SELECT INTERVAL '1 2' DAY TO HOUR - INTERVAL '3' SECOND FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '1 1:59:57' DAY TO SECOND)


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval + Date
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Interval YM + date
SELECT INTERVAL '1-2' YEAR TO MONTH + DATE '2000-02-28' FROM nation where n_nationkey = 2;
rows:
  (DATE '2001-04-28')

// Date + Interval YM
SELECT DATE '2000-02-28' + INTERVAL '1-2' YEAR TO MONTH FROM nation where n_nationkey = 2;
rows:
  (DATE '2001-04-28')

// Date + Interval YM
SELECT DATE '2000-02-28' + INTERVAL '1' MONTH FROM nation where n_nationkey = 2;
rows:
  (DATE '2000-03-28')

// Interval DT + date
SELECT INTERVAL '1' DAY + DATE '2000-02-28' FROM nation where n_nationkey = 2;
rows:
  (DATE '2000-02-29')

// Date + Interval DT
SELECT DATE '2000-02-28' + INTERVAL '1' DAY FROM nation where n_nationkey = 2;
rows:
  (DATE '2000-02-29')

// Date + Interval -DT
SELECT DATE '2000-02-28' + INTERVAL '-1' DAY FROM nation where n_nationkey = 2;
rows:
  (DATE '2000-02-27')

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval + time
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Interval HMS + time
SELECT INTERVAL '1:2:3' HOUR TO SECOND + TIME '04:30:56' FROM nation where n_nationkey = 2;
rows:
  (TIME '05:32:59')

// Time + Interval HMS
SELECT TIME '04:30:56' + INTERVAL '1:2:3' HOUR TO SECOND FROM nation where n_nationkey = 2;
rows:
  (TIME '05:32:59')

// Time + Interval HMS (with fractional seconds)
SELECT TIME '04:30:56' + INTERVAL '1:2:3.456' HOUR TO SECOND FROM nation where n_nationkey = 2;
rows:
 (TIME '05:32:59')

SELECT TIME '23:59:01' + INTERVAL '28' HOUR  FROM nation where n_nationkey = 2;
rows:
  (TIME '03:59:01')

SELECT INTERVAL '28' HOUR + TIME '23:59:01' FROM nation where n_nationkey = 2;
rows:
 (TIME '03:59:01')

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Time - Time
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Time subtraction
SELECT TIME '14:30:55' - TIME '04:30:56' FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '9:59:59' HOUR TO SECOND)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Time - Interval
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

SELECT TIME '23:59:01' - INTERVAL '28' HOUR  FROM nation where n_nationkey = 2;
rows:
  (TIME '19:59:01')

SELECT TIME '23:59:01' - INTERVAL '-28' HOUR  FROM nation where n_nationkey = 2;
rows:
  (TIME '03:59:01')

SELECT TIME '23:59:01' - INTERVAL '8:3' HOUR TO MINUTE  FROM nation where n_nationkey = 2;
rows:
  (TIME '15:56:01')

SELECT TIME '23:59:01' - INTERVAL '-3:2:1' HOUR TO SECOND  FROM nation where n_nationkey = 2;
rows:
  (TIME '03:01:02')

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval negation
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Interval negation /1
SELECT -INTERVAL '1 2:3:4.5' DAY TO SECOND FROM nation where n_nationkey = 2;
rows:
  (INTERVAL -'1 2:3:4.500000' DAY TO SECOND)

// Interval negation /2
SELECT -INTERVAL -'1 2:3:4.5' DAY TO SECOND FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '1 2:3:4.500000' DAY TO SECOND)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval + Timestamp
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Timestamp + Interval DT
//SELECT TIMESTAMP '2000-02-28 04:30:56' + INTERVAL '1 2:3:4.5' DAY TO SECOND FROM nation where n_nationkey = 2;
//rows:
//  (TIMESTAMP '2000-02-29 06:34:00.500000')

// Interval DT + timestamp
//SELECT INTERVAL '1 2:3:4.5' DAY TO SECOND + TIMESTAMP '2000-02-28 04:30:56' FROM nation where n_nationkey = 2;
//rows:
//  (TIMESTAMP '2000-02-29 06:34:00.500000')

// Interval YM + timestamp
SELECT INTERVAL '1-2' YEAR TO MONTH + TIMESTAMP '2000-02-28 04:30:56' FROM nation where n_nationkey = 2;
rows:
  (TIMESTAMP '2001-04-28 04:30:56')

// Timestamp + Interval YM
SELECT TIMESTAMP '2000-02-28 04:30:56' + INTERVAL '1-2' YEAR TO MONTH FROM nation where n_nationkey = 2;
rows:
  (TIMESTAMP '2001-04-28 04:30:56')

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Timestamp - Timestamp
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Timestamp subtraction
SELECT TIMESTAMP '2000-03-31 14:30:55' - TIMESTAMP '2000-02-28 04:30:56' FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '32 9:59:59' DAY TO SECOND)

SELECT TIMESTAMP '2000-02-28 04:30:56' - TIMESTAMP '2000-03-31 14:30:55' FROM nation where n_nationkey = 2;
rows:
  (INTERVAL -'32 9:59:59' DAY TO SECOND)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Date - Timestamp
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Subtract dates and timestamp
SELECT DATE '2000-03-31' - TIMESTAMP '2000-02-28 04:30:56' FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '31 19:29:4' DAY TO SECOND)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Date - Date
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Date subtraction gives an interval days
SELECT DATE '2000-03-31' - DATE '2000-02-28' FROM nation where n_nationkey = 2;
rows:
 (INTERVAL '32' DAY)

SELECT DATE '2000-02-28' - DATE '2000-03-31' FROM nation where n_nationkey = 2;
rows:
 (INTERVAL -'32' DAY)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Date - Interval (DAY)
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
SELECT DATE '2000-03-31' - INTERVAL '3' DAY FROM nation where n_nationkey = 2;
rows:
 (DATE '2000-03-28')

SELECT DATE '2000-02-28' - INTERVAL '3' DAY FROM nation where n_nationkey = 2;
rows:
 (DATE '2000-02-25')

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Date - Interval (YEAR MONTH)
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
SELECT DATE '2000-03-31' - INTERVAL '3' YEAR FROM nation where n_nationkey = 2;
rows:
 (DATE '1997-03-31')

SELECT DATE '2000-02-28' - INTERVAL '3' MONTH FROM nation where n_nationkey = 2;
rows:
 (DATE '1999-11-28')

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval * Integer
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Interval multiplication /1 (integer)
SELECT INTERVAL '1-2' YEAR TO MONTH * 2 FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '2-4' YEAR TO MONTH)

// Interval multiplication /4 (integer first)
SELECT 2 * INTERVAL '1' YEAR FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '2' YEAR)

// Interval multiplication /1 (integer)
SELECT INTERVAL '1 2' DAY TO HOUR * 2 FROM nation where n_nationkey = 2;
rows:
  (INTERVAL '2 4' DAY TO HOUR)

// Interval multiplication /4 (integer first)
SELECT 2 * INTERVAL '32 9:59:59' DAY TO SECOND FROM nation where n_nationkey = 2;
rows:
 (INTERVAL '64 19:59:58' DAY TO SECOND)

SELECT 2 * INTERVAL -'32 9:59:59' DAY TO SECOND FROM nation where n_nationkey = 2;
rows:
 (INTERVAL -'64 19:59:58' DAY TO SECOND)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval / Integer
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Interval division /1 (integer)
SELECT INTERVAL '1-2' YEAR TO MONTH / 2 FROM nation where n_nationkey = 2;
rows:
 (INTERVAL '0-7' YEAR TO MONTH)

// Interval division /2 (integer)
SELECT INTERVAL -'32 9:59:59' DAY TO SECOND / 2 FROM nation where n_nationkey = 2;
rows:
 (INTERVAL -'16 4:59:59.500000' DAY TO SECOND)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval Between
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Interval year-month
SELECT INTERVAL '1-2' YEAR TO MONTH BETWEEN INTERVAL '1' YEAR AND INTERVAL '2' YEAR FROM nation where n_nationkey = 2;
rows:
 (true)

SELECT INTERVAL '1-2' YEAR TO MONTH BETWEEN INTERVAL '1' YEAR AND INTERVAL '15' MONTH FROM nation where n_nationkey = 2;
rows:
 (true)

SELECT INTERVAL '1-2' YEAR TO MONTH BETWEEN INTERVAL '1' YEAR AND INTERVAL '14' MONTH FROM nation where n_nationkey = 2;
rows:
  (true)

SELECT INTERVAL '1-2' YEAR TO MONTH BETWEEN INTERVAL '1' YEAR AND INTERVAL '13' MONTH FROM nation where n_nationkey = 2;
rows:
  (false)

// Interval day-second
SELECT INTERVAL -'32 9:59:59' DAY TO SECOND BETWEEN INTERVAL -'32 9' DAY TO HOUR
   AND INTERVAL -'32 10:59:59' DAY TO SECOND FROM nation where n_nationkey = 2;
rows:
 (false)

SELECT INTERVAL '32 9:59:59' DAY TO SECOND BETWEEN INTERVAL '32 8' DAY TO HOUR
   AND INTERVAL '32 10:59:59' DAY TO SECOND FROM nation where n_nationkey = 2;
rows:
 (true)

SELECT INTERVAL '32 9:58' DAY TO MINUTE BETWEEN INTERVAL '32 9:58:59' DAY TO SECOND
   AND INTERVAL '32 10:59:59' DAY TO SECOND FROM nation where n_nationkey = 2;
rows:
 (false)

SELECT INTERVAL '32 9' DAY TO HOUR BETWEEN INTERVAL '32 8' DAY TO HOUR
   AND INTERVAL '32 11' DAY TO HOUR FROM nation where n_nationkey = 2;
rows:
 (true)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval Comparisons
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Interval year-month
SELECT INTERVAL '1-2' YEAR TO MONTH > INTERVAL '1' YEAR FROM nation where n_nationkey = 2;
rows:
  (true)

SELECT INTERVAL '1-2' YEAR TO MONTH = INTERVAL '14' MONTH FROM nation where n_nationkey = 2;
rows:
  (true)

SELECT INTERVAL '1-2' YEAR TO MONTH != INTERVAL '14' MONTH FROM nation where n_nationkey = 2;
rows:
  (false)

// Interval day-second
SELECT INTERVAL '32 9' DAY TO HOUR < INTERVAL '32 8' DAY TO HOUR FROM nation where n_nationkey = 2;
rows:
  (false)

SELECT INTERVAL '32 9' DAY TO HOUR != INTERVAL '32 9' DAY TO HOUR FROM nation where n_nationkey = 2;
rows:
  (false)

SELECT INTERVAL '32 9' DAY TO HOUR = INTERVAL '32 9' DAY TO HOUR FROM nation where n_nationkey = 2;
rows:
  (true)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval in
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -


// year-month
SELECT INTERVAL '1-2' YEAR TO MONTH in (INTERVAL '1-3' YEAR TO MONTH, INTERVAL '1-2' YEAR TO MONTH) FROM nation where n_nationkey = 2;
rows:
 (true)

SELECT INTERVAL '1-2' YEAR TO MONTH in (INTERVAL '1' YEAR , INTERVAL '14' MONTH) FROM nation where n_nationkey = 2;
rows:
 (true)

SELECT INTERVAL '1-2' YEAR TO MONTH in (INTERVAL '1' YEAR , INTERVAL -'14' MONTH) FROM nation where n_nationkey = 2;
rows:
 (false)

SELECT INTERVAL '1-2' YEAR TO MONTH in (INTERVAL '1' YEAR , INTERVAL '15' MONTH) FROM nation where n_nationkey = 2;
rows:
 (false)

// date-time
SELECT INTERVAL '31 5' DAY TO HOUR in (INTERVAL '32 8' DAY TO HOUR , INTERVAL '32 9' DAY TO HOUR)
  FROM nation where n_nationkey = 2;
rows:
  (false)

SELECT INTERVAL '31 5' DAY TO HOUR in (INTERVAL '32 8' DAY TO HOUR , INTERVAL '32 9' DAY TO HOUR , INTERVAL '31 5' DAY TO HOUR)
  FROM nation where n_nationkey = 2;
rows:
  (true)

/*
SELECT INTERVAL '9' HOUR in (INTERVAL '32 8' DAY TO HOUR , INTERVAL '360' MINUTE)
  FROM nation where n_nationkey = 2;
rows:
  (true)

SELECT INTERVAL '9' HOUR in (INTERVAL '32 8' DAY TO HOUR , INTERVAL '360' HOUR, INTERVAL -'360' HOUR)
  FROM nation where n_nationkey = 2;
rows:
  (false)
*/
drop table nation;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE nation;
  mute
}