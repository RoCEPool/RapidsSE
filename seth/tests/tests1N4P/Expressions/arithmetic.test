/*----------------------------------------------------------------------------*/
/* Arithmetic tests                                                           */
/* (mostly for difficult types)                                               */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

trackmemory force;
success

create table ${testName2}_nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

load ${testName2}_nation "../DATA/TPCH/nation.tbl" ;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval + Interval
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// YM interval arithmetic /1 (same type)
SELECT INTERVAL '1' YEAR + INTERVAL '2' YEAR FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '3' YEAR)

// YM interval arithmetic /2 (same type, with negative)
SELECT INTERVAL '1' YEAR + INTERVAL -'2' YEAR FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL -'1' YEAR)
         
// YM interval arithmetic /3 (mixed types)
SELECT INTERVAL '1' YEAR + INTERVAL '2' MONTH FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '1-2' YEAR TO MONTH)

// YM interval arithmetic /4 (max)
SELECT INTERVAL '6004799503160660' YEAR + INTERVAL '15' MONTH FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '6004799503160661-3' YEAR TO MONTH)

// YM interval arithmetic /5 (overflow)
SELECT INTERVAL '6004799503160660' YEAR + INTERVAL '25' MONTH FROM ${testName2}_nation where n_nationkey = 2;
failure contains: 'EC_INTERVAL_OUT_OF_RANGE'

// DT interval arithmetic of same type /1
SELECT INTERVAL '1' MINUTE + INTERVAL '2' MINUTE FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '3' MINUTE)

// DT interval arithmetic of same type /2
SELECT INTERVAL '1:2:3' HOUR TO SECOND + INTERVAL '4:5:6' HOUR TO SECOND FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '5:7:9' HOUR TO SECOND)

// DT interval arithmetic of mixed types /1
SELECT INTERVAL '1' MINUTE + INTERVAL '2' SECOND FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '1:2' MINUTE TO SECOND)
         
// DT interval arithmetic of mixed types /2
SELECT INTERVAL '1 2' DAY TO HOUR + INTERVAL '3' SECOND FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '1 2:0:3' DAY TO SECOND)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval - Interval
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// YM interval arithmetic /1 (same type)
SELECT INTERVAL '1' YEAR - INTERVAL '2' YEAR FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL -'1' YEAR)

// YM interval arithmetic /2 (same type, with negative)
SELECT INTERVAL '1' YEAR - INTERVAL -'2' YEAR FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '3' YEAR)

// YM interval arithmetic /3 (mixed types)
SELECT INTERVAL '1' YEAR - INTERVAL '2' MONTH FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '0-10' YEAR TO MONTH)

// DT interval arithmetic of same type /1
SELECT INTERVAL '1' MINUTE - INTERVAL '2' MINUTE FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL -'1' MINUTE)

// DT interval arithmetic of same type /2
SELECT INTERVAL '1:2:3' HOUR TO SECOND - INTERVAL '4:5:6' HOUR TO SECOND FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL -'3:3:3' HOUR TO SECOND)

// DT interval arithmetic of mixed types /1
SELECT INTERVAL '1' MINUTE - INTERVAL '2' SECOND FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '0:58' MINUTE TO SECOND)

// DT interval arithmetic of mixed types /2
SELECT INTERVAL '1 2' DAY TO HOUR - INTERVAL '3' SECOND FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (INTERVAL '1 1:59:57' DAY TO SECOND)


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Interval + Date
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

select date '2023-02-13' + interval -'1' year from ${testName2}_nation where n_nationkey = 2;
rows:
 (DATE '2022-02-13')

select date '2023-02-13' + interval -'1-2' year to month from ${testName2}_nation where n_nationkey = 2;
rows:
  (DATE '2021-12-13')

select date '2023-02-13' + interval '-1' year from ${testName2}_nation where n_nationkey = 2;
rows:
 (DATE '2022-02-13')

select date '2023-02-13' + interval '-1-2' year to month from ${testName2}_nation where n_nationkey = 2;
rows:
  (DATE '2021-12-13')

// Interval YM + date
SELECT INTERVAL '1-2' YEAR TO MONTH + DATE '2000-02-28' FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (DATE '2001-04-28')

// Date + Interval YM
SELECT DATE '2000-02-28' + INTERVAL '1-2' YEAR TO MONTH FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (DATE '2001-04-28')

// Date + Interval YM
SELECT DATE '2000-02-28' + INTERVAL '1' MONTH FROM ${testName2}_nation where n_nationkey = 2;
rows:
  (DATE '2000-03-28')

// TODO: ALKA
