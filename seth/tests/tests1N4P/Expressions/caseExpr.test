/*----------------------------------------------------------------------------*/
/* General syntax & semantics tests for CASE expressions                      */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

trackmemory;
success

CREATE TABLE ${testName}_nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

CREATE TABLE ${testName}_region (
	 R_REGIONKEY       INTEGER NOT NULL,
	 R_NAME            CHAR(25) NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

create table ${testName}_datums (
  int_col0   INTEGER NOT NULL,
  int_col1   INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(19,2),
  dec_col7   DECIMAL(19,2),
  flt_col8   FLOAT,
  flt_col9   FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);
success

load ${testName}_region "../TPCH/SF_0001/region.csv";
success

load ${testName}_nation "../TPCH/SF_0001/nation.csv";
success

load ${testName}_datums "../DATA/Datums/datums.csv" ;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
