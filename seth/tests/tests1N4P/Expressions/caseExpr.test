// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Simple CASE expr
SELECT CASE n_name
        WHEN 'AUSTRALIA' THEN 'here'
        WHEN 'INDIA' THEN 'there'
        ELSE 'everywhere'
       END
FROM ${testName}_nation;

rows:
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
