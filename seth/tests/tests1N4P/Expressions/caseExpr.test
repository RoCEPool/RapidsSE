  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('over there')
  ('there')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')

CREATE TABLE ${testName}_caseExpr(a varchar,b varchar,c decimal,d decimal,e timestamp,f boolean,g integer);
success

load ${testName}_caseExpr "../DATA/Expressions/caseExpr.csv";
success

select * from ${testName}_caseExpr where case  when true then d<0  end;
