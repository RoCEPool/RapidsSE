  (null)
  (null)
  (null)
  (null)
  (null)
  (null)

// Case with mix of numeric types. Integer (col1) is promoted to a decimal (col9)
SELECT vch_col14, int_col1, dec_col6, CASE vch_col14
        WHEN 'hello' THEN int_col1
        WHEN 'blue'  THEN dec_col6
        ELSE NULL
      END
FROM datums;

rows:
  ('hello',1000,41.04,1000.00)
  ('life',2000,47.04,null)
  ('x',null,41.04,null)
  ('life',4000,null,null)
  ('124',5000,41.04,null)
  ('blue',6000,null,null)
  ('red',7000,41.04,null)
  ('pink',8000,23.04,null)
  (null,9000,4001.04,null)
  ('hello',10000,477.04,10000.00)

// Case with mix of numeric types. decimals (col9) are promoted to a float (col8)
SELECT vch_col14, flt_col8, dec_col6, CASE vch_col14
        WHEN 'hello' THEN flt_col8
        WHEN 'blue'  THEN dec_col6
        ELSE NULL
      END
FROM datums;

rows:
  ('hello',10.22,41.04,10.22)
  ('life',0.22,47.04,null)
  ('x',10.22,41.04,null)
  ('life',0.22,null,null)
  ('124',null,41.04,null)
  ('blue',0.22,null,null)
  ('red',10.22,41.04,null)
  ('pink',0.22,23.04,null)
  (null,10.22,4001.04,null)
  ('hello',0.22,477.04,0.22)

// Case with mix of numeric types. dates are promoted to timestamps
SELECT CASE n_name
        WHEN 'AUSTRALIA' THEN DATE '2000-01-01'
        WHEN 'INDIA' THEN TIMESTAMP '2001-01-01 13:00:00'
        ELSE NULL
      END
FROM nation;

