// Nested CASE
SELECT CASE n_name
        WHEN 'AUSTRALIA' THEN 'here'
        WHEN 'INDIA' THEN 'there'
        ELSE
          CASE n_nationkey
            WHEN 1 THEN 'out there'
            WHEN 2 THEN 'over there'
            ELSE 'everywhere'
          END
       END
FROM nation;

rows:
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('out there')
  ('everywhere')
  ('everywhere')
  ('everywhere')
  ('everywhere')
