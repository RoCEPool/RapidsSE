/*----------------------------------------------------------------------------*/
/* Cast tests                                                                 */
/* Need to do these on column values to test the synthesised code,            */
/* otherwise a cast of a literal is handled in the compiler.                  */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

trackmemory force;
success

create table ${testName2}_test (
   id           INTEGER NOT NULL,
	 intCol       INTEGER,
	 decCol       DECIMAL(17,2),
	 fltCol       FLOAT,
	 vchCol       VARCHAR(50),
	 dteCol       DATE,
	 tmeCol       TIME,
	 tspCol       TIMESTAMP,
	 bolCol       BOOLEAN
);
success

load ${testName2}_test "../DATA/Expressions/cast.csv" ;
warning contains: '1 rows were invalid'

