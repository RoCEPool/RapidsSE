  ('2000-01-01')
  ('1900-01-01')
  ('2155-12-31')
  ('1900-01-01')
  ('1970-01-01')

// cast date to date
SELECT CAST(dteCol AS DATE) FROM ${testName2}_test WHERE id BETWEEN 1 AND 6;
  (null)
  (DATE '2000-01-01')
  (DATE '1900-01-01')
  (DATE '2155-12-31')
  (DATE '1900-01-01')
  (DATE '1970-01-01')

// cast date to tsp
SELECT CAST(dteCol AS TIMESTAMP) FROM ${testName2}_test WHERE id BETWEEN 1 AND 6;
  (null)
  (TIMESTAMP '2000-01-01 00:00:00.000000')
  (TIMESTAMP '1900-01-01 00:00:00.000000')
  (TIMESTAMP '2155-12-31 00:00:00.000000')
  (TIMESTAMP '1900-01-01 00:00:00.000000')
  (TIMESTAMP '1970-01-01 00:00:00.000000')


