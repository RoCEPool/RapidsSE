// cast int to int
SELECT CAST(intCol AS INTEGER) FROM ${testName2}_test WHERE id BETWEEN 1 AND 6;
rows: (null)
      (0)
      (1)
      (-1)
      (-9223372036854775806)
      (9223372036854775806)
      
