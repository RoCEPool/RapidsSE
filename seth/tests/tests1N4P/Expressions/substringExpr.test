select SUBSTRING('ABCDEFGHI',3,3) from ${testName2}_substringTbl where a = 'A';
rows:
 ('CDE')

select SUBSTRING('ABCDEFGHI',6,3) from ${testName2}_substringTbl where a = 'A';
rows:
 ('FGH' )

select SUBSTRING('ABCDEFGHI',0,5) from ${testName2}_substringTbl where a = 'A';
rows:
 ('ABCD')

select SUBSTRING('ABCDEFGHI',1,5) from ${testName2}_substringTbl where a = 'A';
rows:
 ('ABCDE')

select SUBSTRING('ABCDEFGHI',-4,5) from ${testName2}_substringTbl where a = 'A';
 failure contains: 'EC_SEMANTIC_ERROR'

select SUBSTRING('ABCDEFGHI',15,5) from ${testName2}_substringTbl where a = 'A';
rows:
 ('');

select SUBSTRING('ABCDEFGHI',null,5) from ${testName2}_substringTbl where a = 'A';
rows:
 (NULL)

select SUBSTRING('ABCDEFGHI',1,50) from ${testName2}_substringTbl where a = 'A';
rows:
 ('ABCDEFGHI')

select SUBSTRING('ABCDEFGHI',3) from ${testName2}_substringTbl where a = 'A';
rows:
 ('CDEFGHI')

select SUBSTRING('ABCDEFGHI',6) from ${testName2}_substringTbl where a = 'A';
rows:
 ('FGHI' )

select SUBSTRING('ABCDEFGHI',0) from ${testName2}_substringTbl where a = 'A';
rows:
 ('ABCDEFGHI')

select SUBSTRING('ABCDEFGHI',1) from ${testName2}_substringTbl where a = 'A';
rows:
 ('ABCDEFGHI')

select SUBSTRING('ABCDEFGHI',-4) from ${testName2}_substringTbl where a = 'A';
 failure contains: 'EC_SEMANTIC_ERROR'

select SUBSTRING('ABCDEFGHI',15) from ${testName2}_substringTbl where a = 'A';
rows:
 ('');

select SUBSTRING('ABCDEFGHI',null) from ${testName2}_substringTbl where a = 'A';
rows:
 (NULL)

drop table ${testName2}_nation;
success

drop table ${testName2}_substringTbl;
success

