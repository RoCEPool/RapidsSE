// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

load nation "../DATA/TPCH/nation.tbl" ;
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  SUBSTRING expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Extract from a columnRef
SELECT SUBSTRING(n_name, 1, 2) FROM nation;
