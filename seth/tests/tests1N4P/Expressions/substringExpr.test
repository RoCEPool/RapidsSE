memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE nation;
  mute

  DROP TABLE region;
  mute
}