// Leave off the length parameter
SELECT n_name, SUBSTRING(n_name, 2) FROM nation;
rows:
 ('ALGERIA','LGERIA')
 ('ARGENTINA','RGENTINA')
 ('BRAZIL','RAZIL')
 ('CANADA','ANADA')
 ('EGYPT','GYPT')
 ('ETHIOPIA','THIOPIA')
 ('FRANCE','RANCE')
 ('GERMANY','ERMANY')
 ('INDIA','NDIA')
 ('INDONESIA','NDONESIA')
 ('IRAN','RAN')
 ('IRAQ','RAQ')
 ('JAPAN','APAN')
 ('JORDAN','ORDAN')
 ('KENYA','ENYA')
 ('MOROCCO','OROCCO')
 ('MOZAMBIQUE','OZAMBIQUE')
 ('PERU','ERU')
 ('CHINA','HINA')
 ('ROMANIA','OMANIA')
 ('SAUDI ARABIA','AUDI ARABIA')
 ('VIETNAM','IETNAM')
 ('RUSSIA','USSIA')
 ('UNITED KINGDOM','NITED KINGDOM')
 ('UNITED STATES','NITED STATES')


// Test that a zero length returns an empty string
SELECT SUBSTRING(n_name, 1, 0) FROM nation LIMIT 1;
rows: ('')


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
