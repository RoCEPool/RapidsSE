// Test that a zero length returns an empty string
SELECT SUBSTRING(n_name, 1, 0) FROM ${testName2}_nation LIMIT 1;
rows: ('')

// craete table
create table ${testName2}_substringTbl(a varchar,b char);
success

// load the table
load ${testName2}_substringTbl "../DATA/Expressions/subString.csv";
success

select * from ${testName2}_substringTbl where substr(a,1,1)='A';
rows:
 ('A'    ,*)
 ('A01'  ,*)
 ('A0101',*)
 ('A0102',*)
 ('A02'  ,*)
 ('A0201',*)
 ('A0202',*)

select substring(a,4,2),a from ${testName2}_substringTbl;
rows:
 (''    ,'A')
 (''    ,'A01')
 ('01'  ,'A0101')
 ('02'  ,'A0102')
 (''    ,'A02')
 ('01'  ,'A0201')
 ('02'  ,'A0202')
 (''    ,'B')
 (''    ,'B01')
