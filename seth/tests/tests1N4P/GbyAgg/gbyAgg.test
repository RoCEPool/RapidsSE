/*----------------------------------------------------------------------------*/
/* gbyAgg.test -- Group by aggregate tests                                    */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;


//------------------------------------------------------------------------------
// create table
create table ${testName2}_datums (
  int_col0   INTEGER NOT NULL,
  int_col1   INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(19,2),
  dec_col7   DECIMAL(19,2),
  flt_col8   FLOAT,
  flt_col9   FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);


load ${testName2}_datums "../DATA/Transliterate/groupBy.csv" ;


//------------------------------------------------------------------------------
select int_col1, sum(int_col0) from ${testName2}_datums group by int_col1;
rows:
 (null,3)
 (0,21)
 (2000,2)
 (4000,4)
 (5000,12)
 (7000,7)
 (8000,17)

//------------------------------------------------------------------------------
select sum(int_col0), int_col1 from ${testName2}_datums group by int_col1;
rows:
 (3,null)
 (21,0)
 (2,2000)
 (4,4000)
 (12,5000)
 (7,7000)
 (17,8000)

//------------------------------------------------------------------------------
create table ${testName2}_part (
  P_PARTKEY           INTEGER NOT NULL,
  P_NAME              VARCHAR(55) NOT NULL,
  P_MFGR              CHAR(25) NOT NULL,
  P_BRAND             CHAR(10) NOT NULL,
  P_TYPE              VARCHAR(25) NOT NULL,
  P_SIZE              INTEGER NOT NULL,
  P_CONTAINER         CHAR(10) NOT NULL,
  P_RETAILPRICE       DECIMAL(15,2) NOT NULL,
  P_COMMENT           VARCHAR(23) NOT NULL
);


//------------------------------------------------------------------------------
load ${testName2}_part "../TPCH/SF_0001/part.csv";


// create a table
create table ${testName2}_partsupp (
PS_PARTKEY      INTEGER NOT NULL,
PS_SUPPKEY      INTEGER NOT NULL,
PS_AVAILQTY     INTEGER NOT NULL,
PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
PS_COMMENT      VARCHAR(199) NOT NULL
);


//------------------------------------------------------------------------------
load ${testName2}_partsupp "../TPCH/SF_0001/partsupp.csv";


select p_mfgr, p_brand,  count(*) from ${testName2}_part where p_size < 5 group by p_mfgr, p_brand order by p_mfgr, p_brand;
rows:
 ('Manufacturer#1','Brand#13',1)
 ('Manufacturer#1','Brand#11',1)
 ('Manufacturer#2','Brand#25',1)
 ('Manufacturer#2','Brand#24',2)
 ('Manufacturer#2','Brand#22',1)
 ('Manufacturer#2','Brand#21',1)
 ('Manufacturer#3','Brand#33',2)
 ('Manufacturer#3','Brand#32',2)
 ('Manufacturer#4','Brand#45',2)
 ('Manufacturer#4','Brand#44',1)
 ('Manufacturer#4','Brand#43',1)
 ('Manufacturer#5','Brand#55',2)
 ('Manufacturer#5','Brand#53',2)
 ('Manufacturer#5','Brand#52',2)

select p_brand, p_mfgr, count(*) from ${testName2}_part where p_size < 5 group by p_mfgr, p_brand;
rows:
 ('Brand#11','Manufacturer#1',1)
 ('Brand#13','Manufacturer#1',1)
 ('Brand#21','Manufacturer#2',1)
 ('Brand#22','Manufacturer#2',1)
 ('Brand#24','Manufacturer#2',2)
 ('Brand#25','Manufacturer#2',1)
 ('Brand#32','Manufacturer#3',2)
 ('Brand#33','Manufacturer#3',2)
 ('Brand#43','Manufacturer#4',1)
 ('Brand#44','Manufacturer#4',1)
 ('Brand#45','Manufacturer#4',2)
 ('Brand#52','Manufacturer#5',2)
 ('Brand#53','Manufacturer#5',2)
 ('Brand#55','Manufacturer#5',2)

//------------------------------------------------------------------------------
// create table lineitem
create table ${testName2}_LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );


// load data
load ${testName2}_lineitem "../DATA/TPCH/lineitem10.csv";


//------------------------------------------------------------------------------
select L_ORDERKEY, sum(L_LINENUMBER) from ${testName2}_lineitem group by L_ORDERKEY;
rows:
 (1,21)
 (2,1)
 (3,6)

//------------------------------------------------------------------------------
select sum(L_LINENUMBER), L_ORDERKEY from ${testName2}_lineitem group by L_ORDERKEY;
rows:
 (21,1)
 (1,2)
 (6,3)

//------------------------------------------------------------------------------
select L_ORDERKEY, sum(L_DISCOUNT) from ${testName2}_lineitem group by L_ORDERKEY;
rows:
  (1,0.49)
  (2,0.00)
  (3,0.22)


//------------------------------------------------------------------------------
select L_LINENUMBER, sum(L_DISCOUNT) , sum(L_LINENUMBER) from ${testName2}_lineitem group by L_LINENUMBER;
rows:
 (1,0.10,3)
 (2,0.19,4)
 (3,0.16,6)
 (4,0.09,4)
 (5,0.10,5)
 (6,0.07,6)

//------------------------------------------------------------------------------
create table ${testName2}_Nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
);


//------------------------------------------------------------------------------
load ${testName2}_nation "../DATA/TPCH/nation.tbl";


//------------------------------------------------------------------------------
SELECT n_regionkey AS region , COUNT(n_nationkey) AS nationcount
                                             FROM ${testName2}_nation
                                             GROUP BY region
                                             HAVING region > 1;
rows:
  (3,5)
  (4,5)
  (2,5)


// drop the table
drop table ${testName2}_datums;


// drop the table
drop table ${testName2}_lineitem;


// drop the table
drop table ${testName2}_part;


// drop the table
drop table ${testName2}_partsupp;


// drop the table
drop table ${testName2}_nation;


// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName2}_datums;
  mute

  // drop the table
  drop table ${testName2}_lineitem;
  mute

  // drop the table
  drop table ${testName2}_part;
  mute

  // drop the table
  drop table ${testName2}_partsupp;
  mute

  // drop the table
  drop table ${testName2}_nation;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
