//------------------------------------------------------------------------------
count count;
failure contains: "Table does not exist"

lsidx lsidx;
failure contains: "Table does not exist"

// create table with |
create table | (i integer);
failure contains: 'invalid command'

// create a table
create table t (i integer);
success

// no key
create unique index idx on t();
failure contains: 'invalid columns'

// no index
drop index t idx;
failure contains: 'no such index'

// no table / no index
//drop index t1 idx;
//failure contains: 'no such index'

create table;
failure contains: 'invalid command'

create index;
failure contains: 'invalid command'

sleep;
failure contains: 'invalid command'

sleep a;
failure contains: 'invalid command'

drop table t;
success

CLEANUP {

  drop table t;
  mute

  bye;
  mute
}