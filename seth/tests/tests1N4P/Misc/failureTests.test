--------------------------------------------------------------------------------
-- failure tests
--------------------------------------------------------------------------------

//------------------------------------------------------------------------------
count count;
failure contains: "Table does not exist"

lsidx lsidx;
failure contains: "Table does not exist"

// create table with |
create table | (i integer);
failure contains: 'invalid command'

// create a table
create table ${testName}_t (i integer);
success

// no key
create unique index idx on ${testName}_t();
failure contains: 'invalid columns'

// no index
drop index ${testName}_t idx;
failure contains: 'no such index'

// no table / no index
//drop index ${testName}_t1 idx;
//failure contains: 'no such index'

create table;
failure contains: 'invalid command'

create index;
failure contains: 'invalid command'

sleep;
failure contains: 'invalid command'

sleep a;
failure contains: 'invalid command'

drop table ${testName}_t;
success

CLEANUP {

  drop table ${testName}_t;
  mute

  bye;
  mute
}