/*----------------------------------------------------------------------------*/
/* create table query tests                                                   */
/*----------------------------------------------------------------------------*/

// (1) create table test starting character
create table _test (
  jA  INTEGER
);
success

create table 1test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table ~test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table &test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table %test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table ^test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table !test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table *test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table :test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table ?test (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

// (2) create table test special characters within the name

create table t1est (
  jA  INTEGER
);
success

create table t~est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table t&est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table t%est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table t^est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table t!est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table t*est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table t:est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table t?est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table t est (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

// (3) create table test 31 characters and more as table name

// 31 character table name (maximum length allowed)
create table abcabcabcabcabcabcabcabcabcabca (
  jA  INTEGER
);
success

// 32 character table name
create table abcabcabcabcabcabcabcabcabcabcab (
  jA  INTEGER
);
failure contains: 'EC_MAX_TABLE_NAME_LENGTH'

// 0 length for varchar
create table t (
  c VARCHAR(0)) (
);
failure contains: 'EC_SYNTAX_ERROR'

// 0 length for char
create table t (
  c CHAR(0)) (
);
failure contains: 'EC_SYNTAX_ERROR'


// Table name cannot be a reserved word
create table create (col1 INTEGER);
failure contains: 'EC_SYNTAX_ERROR'

create table on (col1 INTEGER);
failure contains: 'EC_SYNTAX_ERROR'

create table JOIN (col1 INTEGER);
failure contains: 'EC_SYNTAX_ERROR'

// case insensitive
create table join (col1 INTEGER);
failure contains: 'EC_SYNTAX_ERROR'


// index names are also checked against the reserved word list
create index left on _test (jA);
failure contains: 'EC_SYNTAX_ERROR'

create index JOIN on _test (jA);
failure contains: 'EC_SYNTAX_ERROR'

create index join on _test (jA);
failure contains: 'EC_SYNTAX_ERROR'


CLEANUP {

  drop table _test;
  drop table t1est;
  drop table abcabcabcabcabcabcabcabcabcabca;
  mute

  bye;
  mute
}

