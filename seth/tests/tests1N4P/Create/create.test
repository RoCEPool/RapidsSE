/*----------------------------------------------------------------------------*/
/* create table query tests                                                   */
/*----------------------------------------------------------------------------*/

// (1) create table test starting character
create table _test_${testName} (
  jA  INTEGER
);
success

create table 1test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table ~test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table &test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table %test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table ^test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table !test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table *test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table :test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

create table ?test_${testName} (
  jA  INTEGER
);
failure contains: 'EC_SYNTAX_ERROR'

// (2) create table test special characters within the name

create table t1est_${testName} (
  jA  INTEGER
);
success

create table t~est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

create table t&est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

create table t%est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

create table t^est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

create table t!est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

create table t*est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

create table t:est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

create table t?est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

create table t est_${testName} (
  jA  INTEGER
);
failure contains: 'EC_INVALID_COMMAND'

// (3) create table test 31 characters and more as table name

// 31 character table name (maximum length allowed)
create table abcabcabcabcabcabcabcabcabcabca (
  jA  INTEGER
);
success

// 32 character table name
create table abcabcabcabcabcabcabcabcabcabcab (
  jA  INTEGER
);
failure contains: 'EC_MAX_TABLE_NAME_LENGTH'

// 0 length for varchar
create table t_${testName} (
  c VARCHAR(0)) (
);
failure contains: 'EC_INVALID_COMMAND'

// 0 length for char
create table t_${testName} (
  c CHAR(0)) (
);
failure contains: 'EC_INVALID_COMMAND'


// Table name cannot be a reserved word
create table create (col1 INTEGER);
failure contains: 'EC_RESERVED_WORD'

create table on (col1 INTEGER);
failure contains: 'EC_RESERVED_WORD'

create table JOIN (col1 INTEGER);
failure contains: 'EC_RESERVED_WORD'

// case insensitive
create table join (col1 INTEGER);
failure contains: 'EC_RESERVED_WORD'


// index names are also checked against the reserved word list
create index left on _test_${testName} (jA);
failure contains: 'EC_RESERVED_WORD'

create index JOIN on _test_${testName} (jA);
failure contains: 'EC_RESERVED_WORD'

create index join on _test_${testName} (jA);
failure contains: 'EC_RESERVED_WORD'


CLEANUP {

  drop table _test_${testName};
  drop table t1est_${testName};
  drop table abcabcabcabcabcabcabcabcabcabca;
  mute

  bye;
  mute
}

