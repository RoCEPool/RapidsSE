/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

// (1) create table jCdt
create table jCdt (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

create index jCdt_idx1 on jCdt (jA);
success

load jCdt "../DATA/Select/range2.csv";
success

//------------------------------------------------------------------------------
// SCAN
select * from jCdt;
rows: 26

//------------------------------------------------------------------------------
// EXACT KEYS for index on jA

select * from jCdt where jA > 19 and jA = 22;
rows: 1

select * from jCdt where jA >= 19 and jA = 22;
rows: 1

select * from jCdt where jA > 10 and jA < 19;
rows: 8

select * from jCdt where jA > 10 and jA <= 19;
rows: 9

select * from jCdt where jA >= 10 and jA < 19;
rows: 9

select * from jCdt where jA >= 10 and jA <= 19;
rows: 10

select * from jCdt where jA > 1 and jA <= 10;
rows: 9

select * from jCdt where jA >= 1 and jA <= 10;
rows: 10

select * from jCdt where jA > -9223372036854775806 and jA < 0;
rows: 0

select * from jCdt where jA > -9223372036854775806 and jA <= 1;
rows: 1

drop table jCdt;
success

CLEANUP {

  drop table jCdt;
  mute

  bye;
  mute
}

