/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

// (1) create table t1
create table ${testName2}_jCdt (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

create index jCdt_idx1 on ${testName2}_jCdt (jA);
success

create index jCdt_idx2 on ${testName2}_jCdt (jA,jB);
success

create index jCdt_idx3 on ${testName2}_jCdt (jA,jB,jC);
success

create index jCdt_idx4 on ${testName2}_jCdt (jA,jB,jC,jD);
success

create index jCdt_idx5 on ${testName2}_jCdt (jE);
success

load ${testName2}_jCdt "../DATA/Select/range.csv";
success

//------------------------------------------------------------------------------
// SCAN
select * from ${testName2}_jCdt;
rows: 16

// this will be a scan because no index with leading col is jB
select * from ${testName2}_jCdt where jB = 24;
rows: 1

//------------------------------------------------------------------------------
// EXACT KEYS
select * from ${testName2}_jCdt where jA = 15;
rows:
  (15,25,35,45,'ff')

select * from ${testName2}_jCdt where jA = 11;
rows:
  (11,21,31,41,'bb1')
  (11,21,31,41,'bb2')
  (11,21,31,41,'bb3')

select * from ${testName2}_jCdt where jA = 15 and jB <= 30;
rows:
  (15,25,35,45,'ff')

