/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

// (1) create table t1
create table ${testName2}_t1 (
  jA  INTEGER NOT NULL,
  jB  INTEGER NOT NULL,
  jC  VARCHAR(10) NOT NULL,
  jD  VARCHAR(10) NOT NULL
);
success

create index T1_idx1 on ${testName2}_t1 (jA, jC);
success

load ${testName2}_t1 "../DATA/Select/rangeCombo.csv";
success

select * from ${testName2}_t1;
rows: 5

select * from ${testName2}_t1 where jA <= 2;
rows: 2

select * from ${testName2}_t1 where jC <= 2;
rows: 5

select * from ${testName2}_t1 where jA >= 4 and jC >= 'ddd';
rows:
  (4,14,'ddd',' mood')
  (5,15,'eee',' boat')

select * from ${testName2}_t1 where jA = 4 and jC = 'ddd';
rows:
  (4,14,'ddd',' mood')

CLEANUP {

  drop table ${testName2}_t1;
  mute

  bye;
  mute
}
