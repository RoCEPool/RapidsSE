/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

create table ${testName}_jCdt (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

create index jCdt_idx1 on ${testName}_jCdt (jA);
success

load ${testName}_jCdt "../DATA/Select/range2.csv";
success

//------------------------------------------------------------------------------
// SCAN
select * from ${testName}_jCdt;
rows: 26

//------------------------------------------------------------------------------
// EXACT KEYS for index on jA

select * from ${testName}_jCdt where jA = 19;
rows: 1

select * from ${testName}_jCdt where jA = 18;
rows:
  (18,18,*,*,*)

select * from ${testName}_jCdt where jA = 17;
rows:
  (17,*,*,*,*)

select * from ${testName}_jCdt where jA = -9223372036854775806;
rows:
  (-9223372036854775806,*,*,*,*)

select * from ${testName}_jCdt where jA = 9223372036854775806;
rows:
  (9223372036854775806,*,*,*,*)

select * from ${testName}_jCdt where jA = 16;
rows:
  (16,*,*,*,*)

select * from ${testName}_jCdt where jA = 15;
rows:
  (15,*,*,*,*)

select * from ${testName}_jCdt where jA = 14;
rows:
  (14,*,*,*,*)

select * from ${testName}_jCdt where jA = 13;
rows:
  (13,*,*,*,*)

select * from ${testName}_jCdt where jA = 12;
rows:
  (12,*,*,*,*)

select * from ${testName}_jCdt where jA = 11;
rows:
  (11,*,*,*,'bb1')

select * from ${testName}_jCdt where jA = 10;
rows:
  (10,*,*,*,*)

drop table ${testName}_jCdt;
success

CLEANUP {

  drop table ${testName}_jCdt;
  mute

  bye;
  mute
}

