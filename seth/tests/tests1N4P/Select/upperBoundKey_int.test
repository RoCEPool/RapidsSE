// (1) create table jCdt
create table ${testName2}_jCdt (
jA  INTEGER,
jB  INTEGER,
jC  INTEGER,
jD  INTEGER,
jE  VARCHAR(32)
);
success

create index jCdt_idx1 on ${testName2}_jCdt (jA);
success

load ${testName2}_jCdt "../DATA/Select/range2.csv";
success

