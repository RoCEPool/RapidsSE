/*----------------------------------------------------------------------------*/
/* gbyAgg.test -- Group by aggregate tests                                    */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory force;
success

//------------------------------------------------------------------------------
create table ${testName2}_nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

//------------------------------------------------------------------------------
load ${testName2}_nation "../TPCH/SF_0001/nation.tbl";
success

//------------------------------------------------------------------------------
SELECT n_regionkey , n_name FROM ${testName2}_nation  where n_regionkey < 2 order by n_name, n_regionKey;
rows:
 (0 ,'ALGERIA')
 (1 ,'ARGENTINA')
 (1 ,'BRAZIL')
 (1 ,'CANADA')
 (0 ,'ETHIOPIA')
 (0 ,'KENYA')
 (0 ,'MOROCCO')
 (0 ,'MOZAMBIQUE')
 (1 ,'PERU')
 (1 ,'UNITED STATES')

SELECT n_name, n_regionkey FROM ${testName2}_nation  where n_regionkey < 2 order by n_name, n_regionKey;
rows:
 ('ALGERIA',0)
 ('ARGENTINA',1)
 ('BRAZIL',1)
 ('CANADA',1)
 ('ETHIOPIA',0)
 ('KENYA',0)
 ('MOROCCO',0)
 ('MOZAMBIQUE',0)
 ('PERU',1)
 ('UNITED STATES',1)

//------------------------------------------------------------------------------
SELECT  n_name, n_regionkey FROM ${testName2}_nation order by n_name, n_regionKey limit 5;
rows:
 ('ALGERIA',0)
 ('ARGENTINA',1)
 ('BRAZIL',1)
 ('CANADA',1)
 ('CHINA',2)

//------------------------------------------------------------------------------
SELECT n_regionkey , COUNT(n_nationkey) FROM ${testName2}_nation GROUP BY n_regionkey order by n_regionkey;
rows:
 (0,5)
 (1,5)
 (2,5)
 (3,5)
 (4,5)

//------------------------------------------------------------------------------
// create table
create table datums (
  int_col0   INTEGER NOT NULL,
  int_col1   INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(17,2),
  dec_col7   DECIMAL(17,2),
  flt_col8   FLOAT,
  flt_col9   FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);
success

load datums "../DATA/DataTypes/dataTypes.csv" ;
success

//------------------------------------------------------------------------------
select dec_col6 + 1.44 from datums order by dec_col6;
rows:
  (null)
  (null)
  (24.48)
  (42.48)
  (42.48)
  (42.48)
  (42.48)
  (48.48)
  (478.48)
  (478.48)
  (478.48)
  (478.48)
  (4002.48)

//------------------------------------------------------------------------------
select flt_col9, flt_col9 / 2 from datums order by flt_col9;
rows:
  (5.111111e+00,2.55555e+00)
  (5.999999e+00,2.999999e+00)
  (31.456000e+00,15.728000e+00)
  (31.456000e+00,15.728000e+00)
  (31.456000e+00,15.728000e+00)
  (31.456000e+00,15.728000e+00)
  (76.456000e+00,38.228000e+00)
  (108.456000e+00,54.228000e+00)
  (108.456000e+00,54.228000e+00)
  (108.456000e+00,54.228000e+00)
  (108.456000e+00,54.228000e+00)
  (108.456000e+00,54.228000e+00)
  (108.456000e+00,54.228000e+00)

// drop the tables
drop table ${testName2}_nation;
success

drop table datums;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName2}_nation;
  mute

  drop table datums;
  mute
}

