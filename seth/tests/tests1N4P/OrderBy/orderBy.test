/*----------------------------------------------------------------------------*/
/* gbyAgg.test -- Group by aggregate tests                                    */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

//------------------------------------------------------------------------------
create table Nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

//------------------------------------------------------------------------------
load nation "../TPCH/SF_0001/nation.csv";
success

//------------------------------------------------------------------------------
SELECT n_regionkey , n_name FROM nation  where n_regionkey < 2 order by n_name, n_regionKey;
rows:
 (0 ,'ALGERIA')
 (1 ,'ARGENTINA')
 (1 ,'BRAZIL')
 (1 ,'CANADA')
 (0 ,'ETHIOPIA')
 (0 ,'KENYA')
 (0 ,'MOROCCO')
 (0 ,'MOZAMBIQUE')
 (1 ,'PERU')
 (1 ,'UNITED STATES')

SELECT n_name, n_regionkey FROM nation  where n_regionkey < 2 order by n_name, n_regionKey;
rows:
 ('ALGERIA',0)
 ('ARGENTINA',1)
 ('BRAZIL',1)
 ('CANADA',1)
 ('ETHIOPIA',0)
 ('KENYA',0)
 ('MOROCCO',0)
 ('MOZAMBIQUE',0)
 ('PERU',1)
 ('UNITED STATES',1)

//------------------------------------------------------------------------------
SELECT  n_name, n_regionkey FROM nation order by n_name, n_regionKey limit 5;
rows:
 ('ALGERIA',0)
 ('ARGENTINA',1)
 ('BRAZIL',1)
 ('CANADA',1)
 ('CHINA',2)

//------------------------------------------------------------------------------
SELECT n_regionkey , COUNT(n_nationkey) FROM nation GROUP BY n_regionkey order by n_regionkey;
rows:
 (0,5)
 (1,5)
 (2,5)
 (3,5)
 (4,5)

// drop the table
drop table nation;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table nation;
  mute
  
  bye;
  mute
}

