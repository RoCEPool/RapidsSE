/*----------------------------------------------------------------------------*/
/* operators.test -- OPERATORS tests                                          */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// (1) create a table
create table ${testName2}_OpTable1 (
  jidx_key   INTEGER     NOT NULL,
  jidx_name  VARCHAR(32) NOT NULL,
  jidx_100   INTEGER     NOT NULL,
  jidx_10    INTEGER     NOT NULL,
  jidx_int   INTEGER     NOT NULL,
  jidx_flt   FLOAT       NOT NULL,
  jidx_tsp   TIMESTAMP   NOT NULL,
  jidx_dte   DATE        NOT NULL
);
success

// create indexes
create index OpTable1_idx on ${testName2}_OpTable1 (jidx_key);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_OpTable1';
contains rows:
(*, *, '${testName2}_OpTable1', 'OpTable1_idx', false, false)

load ${testName2}_OpTable1 "../DATA/Operators/operators1_1.csv" ;
success

// check no of rows
select * from  ${testName2}_OpTable1;
rows: 26

// (1) create a table
create table ${testName2}_OpTable2 (
  jidx_key_2   INTEGER     NOT NULL,
  jidx_name_2  VARCHAR(32) NOT NULL,
  jidx_100_2   INTEGER     NOT NULL,
  jidx_10_2    INTEGER     NOT NULL,
  jidx_int_2   INTEGER     NOT NULL,
  jidx_flt_2   FLOAT       NOT NULL,
  jidx_tsp_2   TIMESTAMP   NOT NULL,
  jidx_dte_2   DATE        NOT NULL
  );
success

// create indexes
create index OpTable2_idx on ${testName2}_OpTable2 (jidx_key_2);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_OpTable2';
contains rows:
(*, *, '${testName2}_OpTable2', 'OpTable2_idx', false, false)

load ${testName2}_OpTable2 "../DATA/Operators/operators1_2.csv" ;
success

// check no of rows
select * from  ${testName2}_OpTable2;
rows: 21

// scan error
select * from  ${testName2}_OpTableXXX;
failure contains: 'No such table'


