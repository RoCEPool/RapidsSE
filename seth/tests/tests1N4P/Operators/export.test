/*----------------------------------------------------------------------------*/
/* operators.test -- OPERATORS tests                                          */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// (1) create a table
create table ${testName2}_OpTable1 (
  jidx_key   INTEGER     NOT NULL,
  jidx_name  VARCHAR(32) NOT NULL,
  jidx_100   INTEGER     NOT NULL,
  jidx_10    INTEGER     NOT NULL,
  jidx_int   INTEGER     NOT NULL,
  jidx_flt   FLOAT       NOT NULL,
  jidx_tsp   TIMESTAMP   NOT NULL,
  jidx_dte   DATE        NOT NULL
);
success

// create indexes
create index OpTable1_idx on ${testName2}_OpTable1 (jidx_key);
success

load ${testName2}_OpTable1 "../DATA/Operators/operators1_1.csv" ;
success

// check no of rows
select * from ${testName2}_OpTable1;
rows: 26

// export to non-existent dir
export ${testName2}_OpTable1 "/noDir/${testName2}_OpTable1.csv";
failure contains: 'File does not exist'

// export a non-existent table
export ${testName2}_OpTable2 "/tmp/${testName2}_OpTable1.csv";
failure contains: 'Table does not exist'

// export a non-existent table to a non-existent dir
export ${testName2}_OpTable2 "/noDir/${testName2}_opTable1.csv";
failure contains: 'does not exist'

export ${testName2}_OpTable1 "/tmp/${testName2}_OpTable1.csv";
success

truncate ${testName2}_OpTable1;
success

load ${testName2}_OpTable1 "/tmp/${testName2}_OpTable1.csv" ;
success

// check no of rows
select * from ${testName2}_OpTable1;
rows: 26

// drop the table
drop table ${testName2}_OpTable1;
success


// check existence of table
//lstbl;
//rows: 0

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  // drop the table
  drop table ${testName2}_OpTable1;
  mute

  // drop the table
  drop table ${testName2}_OpTable2;
  mute

  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
