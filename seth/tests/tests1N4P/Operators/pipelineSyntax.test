/*----------------------------------------------------------------------------*/
/* pipelineSyntax.test -- Pipeline syntax tests                               */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// missing pipeline name
/optimise_passthru
pipeline
begin

  stage stageA on origin :
  start | pulse once | stageB

  stage stageB on all partitions:
  scan ${testName2}_OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

end
;
failure contains: "EC_SYNTAX_ERROR; Line: 3; Column: 0; extraneous input 'begin'"

// missing begin
/optimise_passthru
pipeline testPipeline

  stage stageA on origin :
  start | pulse once | stageB

  stage stageB on all partitions:
  scan ${testName2}_OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

  end
;
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 2; missing BEGIN"

// missing stage
/optimise_passthru
pipeline testPipeline
begin
  stageA on origin :
  start | pulse once | stageB

  stage stageB on all partitions:
  scan ${testName2}_OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

end
;
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 2; mismatched input 'stageA' expecting STAGE"

// missing on
/optimise_passthru
pipeline testPipeline
begin
  stage stageA origin :
  start | pulse once | stageB

  stage stageB on all partitions:
  scan ${testName2}_OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

end
;
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 15; missing ON at 'origin'"

// missing origin/all partitions
/optimise_passthru
pipeline testPipeline
begin
  stage stageA on:
  start | pulse once | stageB

  stage stageB on all partitions:
  scan ${testName2}_OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

end
;
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 17; mismatched input ':'"

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  // drop the table
  drop table ${testName2}_OpTable1;
  mute

  // drop the table
  drop table ${testName2}_OpTable2;
  mute

  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
