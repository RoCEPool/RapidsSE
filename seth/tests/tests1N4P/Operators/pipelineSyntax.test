/*----------------------------------------------------------------------------*/
/* pipelineSyntax.test -- Pipeline syntax tests                               */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// missing pipeline name
/optimise_passthru
pipeline
begin

  stage stageA on origin :
  start | pulse once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

end
;
failure contains: 'invalid command'

// missing begin
/optimise_passthru
pipeline testPipeline

  stage stageA on origin :
  start | pulse once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

  end
;
failure contains: 'invalid command'

// missing stage
/optimise_passthru
pipeline testPipeline
begin
  stageA on origin :
  start | pulse once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

end
;
failure contains: 'invalid command'

// missing on
/optimise_passthru
pipeline testPipeline
begin
  stage stageA origin :
  start | pulse once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

end
;
failure contains: 'invalid command'

// missing origin/all partitions
/optimise_passthru
pipeline testPipeline
begin
  stage stageA on:
  start | pulse once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin :
  output | sink | stageA

end
;
failure contains: 'invalid command'

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  // drop the table
  drop table OpTable1;
  mute

  // drop the table
  drop table OpTable2;
  mute

  bye;
  mute
}

