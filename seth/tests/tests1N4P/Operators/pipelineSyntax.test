/*----------------------------------------------------------------------------*/
/* pipelineSyntax.test -- Pipeline syntax tests                               */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// missing pipeline name
pipeline
begin

  stage stageA on origin:
  start | periodic once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin:
  output | sink | stageA

end
;
failure contains: 'invalid command'

// missing begin
pipeline testPipeline

  stage stageA on origin:
  start | periodic once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin:
  output | sink | stageA

  end
;
failure contains: 'invalid command'

// missing stage
pipeline testPipeline
begin
  stageA on origin:
  start | periodic once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin:
  output | sink | stageA

end
;
failure contains: 'invalid command'

// missing on
pipeline testPipeline
begin
  stage stageA origin:
  start | periodic once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin:
  output | sink | stageA

end
;
failure contains: 'invalid command'

// missing origin/all partitions
pipeline testPipeline
begin
  stage stageA on:
  start | periodic once | stageB

  stage stageB on all partitions:
  scan OpTable | stageC

  stage stageC on origin:
  output | sink | stageA

end
;
failure contains: 'invalid command'

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  // drop the table
  drop table OpTable1;
  mute

  // drop the table
  drop table OpTable2;
  mute

  bye;
  mute
}

