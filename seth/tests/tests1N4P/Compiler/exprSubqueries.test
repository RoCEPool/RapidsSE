// Correlated subquery in WHERE clause with one correlated AliasRef
EXPLAIN SELECT n_nationkey, SUM(n_regionkey) AS regionsum
FROM nation
GROUP BY n_nationkey, n_regionkey
HAVING regionsum >= ( SELECT AVG(r_regionkey) FROM region WHERE r_regionkey = n_regionkey AND regionsum > 0 );

unordered rows: 
  (*, 'explainPlan', '
∆ exprSubquery
  » table alias: __subquery0003
  » correlated columns: (rapidsse.public.nation.n_regionkey, regionsum)

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (rapidsse.public.nation.n_regionkey, regionsum)

-> -> statementMarker: select
      » queryText: "SELECT AVG(r_regionkey) FROM region WHERE r_regionkey = n_regionkey AND regionsum > 0"

-> -> -> projectOp
         » column: (Expr = AVG(rapidsse.public.region.r_regionkey) ; Ordinal Expr = AVG($1))

-> -> -> -> filterOp
            » expr: ((rapidsse.public.region.r_regionkey = rapidsse.public.nation.n_regionkey) AND (regionsum > 0))
            » ordinal expr: (($1 = %1) AND (%2 > 0))

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.region)

∆ mainSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey, SUM(n_regionkey) AS regionsum FROM nation GROUP BY n_nationkey, n_regionkey HAVING regionsum >= ( SELECT AVG(r_regionkey) FROM region WHERE r_regionkey = n_regionkey AND regionsum > 0 )"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
      » column: (Alias = regionsum ; Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (regionsum >= __subquery0003(rapidsse.public.nation.n_regionkey, regionsum))
         » ordinal expr: ($2 >= __subquery0003($3, $2))

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
            » column: (Alias = regionsum ; Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
            » group by: (rapidsse.public.nation.n_nationkey)
            » group by: (rapidsse.public.nation.n_regionkey) ; Ordinal Exprs = ($1) ; Ordinal Exprs = ($3)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)' )


// Cannot correlate an aggregate expression unless it has an alias
EXPLAIN SELECT n_nationkey, SUM(n_regionkey)
FROM nation
GROUP BY n_nationkey
HAVING regionsum >= ( SELECT AVG(r_regionkey) FROM region WHERE r_regionkey = n_regionkey AND SUM(n_regionkey) > 0 );
failure contains: 'Cannot specify an aggregate expression in a WHERE clause'


// Bug fix: when the outer query references a bad column we shouldn't hit an assertion.
EXPLAIN
SELECT n_nationkey, SUM(n_regionkey)
FROM nation
GROUP BY n_nationkey
HAVING badColumn >= ( SELECT AVG(r_regionkey) FROM region HAVING SUM(n_regionkey) > 0 );
failure contains: 'No such column: badColumn'

// An aggregated column is not correlated if it doesn't have an alias.
// Basically the plan sees n_regionkey as being correlated, not SUM(n_regionkey).
EXPLAIN
SELECT n_nationkey, SUM(n_regionkey)
FROM nation
GROUP BY n_nationkey
HAVING SUM(n_regionkey) >= ( SELECT AVG(r_regionkey) FROM region HAVING SUM(n_regionkey) > 0 );
failure contains: 'Expression is not present in the GROUP BY list: rapidsse.public.nation.n_regionkey'


