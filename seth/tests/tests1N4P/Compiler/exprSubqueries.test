// Nested correlated

// Nested correlated where the correlated column comes from a grandparent query
// e.g.
// SELECT n_name FROM nation n1 WHERE n_nationkey > (
//   SELECT MAX(r_regionkey) FROM REGION WHERE r_regionkey IN (
//     SELECT n_regionkey from nation n2 WHERE n1.n_name LIKE 'A%'
//   )
// );

// Nested correlated column used in a table subquery within an expression subquery within a WHERE clause.
EXPLAIN
SELECT n_nationkey, SUM(n_regionkey)
FROM nation
GROUP BY n_nationkey, n_regionkey
HAVING SUM(n_regionkey) >= (
  WITH t1 AS ( SELECT AVG(r_regionkey) FROM region HAVING SUM(n_regionkey) > 0 )
  SELECT * FROM t1
);

