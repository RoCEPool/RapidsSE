// Single expr subquery in WHERE clause
EXPLAIN STAGE partitionExplain
SELECT * FROM nation WHERE n_nationkey > ( SELECT MIN(n_nationkey) FROM nation );

rows: (*,'partitionExplain','
∆ exprSubquery
  » table alias: __subquery0003
  » correlated columns: (none)

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT MIN(n_nationkey) FROM nation"

-> -> -> projectOp
         » location: origin
         » column: (Expr = MIN(MIN(MIN(rapidsse.public.nation.n_nationkey))) ; Ordinal Expr = MIN($1))

-> -> -> -> projectOp
            » location: all nodes
            » column: (Expr = MIN(MIN(rapidsse.public.nation.n_nationkey)) ; Ordinal Expr = MIN($1))

-> -> -> -> -> projectOp
               » column: (Expr = MIN(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = MIN($1))

-> -> -> -> -> -> tableScanOp
                  » location: all partitions
                  » table: (rapidsse.public.nation)

∆ mainSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM nation WHERE n_nationkey > ( SELECT MIN(n_nationkey) FROM nation )"

-> -> projectOp
      » column: (Alias = N_NATIONKEY ; Expr = rapidsse.public.nation.N_NATIONKEY ; Ordinal Expr = $1)
      » column: (Alias = N_NAME ; Expr = rapidsse.public.nation.N_NAME ; Ordinal Expr = $2)
      » column: (Alias = N_REGIONKEY ; Expr = rapidsse.public.nation.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Alias = N_COMMENT ; Expr = rapidsse.public.nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> filterOp
         » expr: (rapidsse.public.nation.n_nationkey > __subquery0003())
         » ordinal expr: ($1 > __subquery0003())

-> -> -> -> tableScanOp
            » location: all partitions
            » table: (rapidsse.public.nation)' )


