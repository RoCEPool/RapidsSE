// Error - expr subquery in WHERE predicate trying to return multiple columns
EXPLAIN STAGE partitionExplain
SELECT * FROM nation WHERE n_nationkey > ( SELECT MIN(n_nationkey), MAX(n_nationkey) FROM nation );
failure contains: 'Subquery cannot project more than one column'


