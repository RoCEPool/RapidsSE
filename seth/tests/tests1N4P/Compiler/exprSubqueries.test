// Nested correlated subquery in a SELECT list
EXPLAIN SELECT
  employee_id,
  first_name,
  last_name,
  department_name,
  salary,
  (
    WITH t1 AS (
      SELECT AVG(salary)
      FROM employees
      WHERE
      department_id = e.department_id
    ) SELECT * FROM t1
  ) avg_salary_in_department
FROM employees e
INNER JOIN departments d ON d.department_id = e.department_id
ORDER BY
  department_name,
  first_name,
  last_name;

