// Correlated subquery in WHERE clause with one *qualified* correlated column
EXPLAIN SELECT * FROM nation n1 WHERE n_nationkey > ( SELECT AVG(n_nationkey) FROM nation WHERE n_regionkey = n1.n_regionkey );

unordered rows: 
  (*, 'explainPlan', '
∆ exprSubquery
  » table alias: __subquery0003
  » correlated columns: (n1.n_regionkey)

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (n1.n_regionkey)

-> -> statementMarker: select
      » queryText: "SELECT AVG(n_nationkey) FROM nation WHERE n_regionkey = n1.n_regionkey"

-> -> -> projectOp
         » column: (Expr = AVG(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = AVG($1))

-> -> -> -> filterOp
            » expr: (rapidsse.public.nation.n_regionkey = n1.n_regionkey)
            » ordinal expr: ($3 = %1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)

∆ mainSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM nation n1 WHERE n_nationkey > ( SELECT AVG(n_nationkey) FROM nation WHERE n_regionkey = n1.n_regionkey )"

-> -> projectOp
      » column: (Alias = N_NATIONKEY ; Expr = n1.N_NATIONKEY ; Ordinal Expr = $1)
      » column: (Alias = N_NAME ; Expr = n1.N_NAME ; Ordinal Expr = $2)
      » column: (Alias = N_REGIONKEY ; Expr = n1.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Alias = N_COMMENT ; Expr = n1.N_COMMENT ; Ordinal Expr = $4)

-> -> -> filterOp
         » expr: (n1.n_nationkey > __subquery0003(n1.n_regionkey))
         » ordinal expr: ($1 > __subquery0003($3))

-> -> -> -> tableScanOp
            » alias: (n1)
            » table: (rapidsse.public.nation)' )


