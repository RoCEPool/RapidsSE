// Negative case - expression subquery refers to a table subquery not in scope
EXPLAIN
WITH t1 AS (SELECT r_name FROM region WHERE r_regionkey = (SELECT * FROM t2)),
     t2 AS (SELECT r_regionkey FROM region LIMIT 1)
SELECT * FROM nation WHERE r_name = ( SELECT * FROM t1 );

