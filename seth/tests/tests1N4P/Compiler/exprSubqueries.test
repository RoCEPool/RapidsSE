// Nested correlated

// Nested correlated where the correlated column comes from a grandparent query
// e.g.
// SELECT n_name FROM nation n1 WHERE n_nationkey > (
//   SELECT MAX(r_regionkey) FROM REGION WHERE r_regionkey IN (
