EXPLAIN SELECT n_name FROM nation WHERE n_nationkey IN (1, (WITH t1 AS (SELECT n_nationkey FROM nation) SELECT * FROM t1));
rows: (*,'explainPlan','
∆ exprSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> tableSubquery
   » table alias: t1
   » correlated columns: (none)
   » recursive: false

-> -> mainSubquery
      » table alias: __subquery0002
      » correlated columns: (none)

-> -> -> statementMarker: select
         » queryText: "SELECT n_nationkey FROM nation"

-> -> -> -> projectOp
            » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)

-> mainSubquery
   » table alias: __subquery0003
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT * FROM t1"

-> -> -> projectOp
         » column: (Expr = t1.n_nationkey ; Ordinal Expr = $1)

-> -> -> -> subqueryRefOp
            » alias: (t1)
            » params: t1()
            » ordinal params: t1()

∆ mainSubquery
  » table alias: __subquery0005
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation WHERE n_nationkey IN (1, (WITH t1 AS (SELECT n_nationkey FROM nation) SELECT * FROM t1))"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (rapidsse.public.nation.n_nationkey IN (1, __subquery0004()))
         » ordinal expr: ($1 IN (1, __subquery0004()))

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)')


EXPLAIN SELECT n_name FROM nation WHERE n_nationkey IN ();
failure contains: 'insufficient expressions specified: IN clause'


