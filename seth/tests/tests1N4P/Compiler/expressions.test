-- Runtime test: that escape works with a subquery (so long as it is one character - a runtime check)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' ESCAPE (SELECT '#' FROM nation LIMIT 1) FROM NATION LIMIT 1;
//rows: (true)

-- Runtime test: that escape gives an error when it is implemented as a subquery
-- that returns multiple rows (a runtime check)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' ESCAPE (SELECT '#' FROM nation LIMIT 2) FROM NATION LIMIT 1;
// TODO: runtime error - more than one row returned for expression subquery

-- Test that escape gives an error when it is implemented as a subquery
-- that returns multiple columns (planner check)
EXPLAIN SELECT 'abc_def' LIKE 'abc#_def' ESCAPE (SELECT '#', n_name FROM nation LIMIT 2) FROM NATION LIMIT 1;
failure contains: 'Subquery cannot project more than one column'

-- Runtime test: that the escape character can be matched by duplicating it (1)
