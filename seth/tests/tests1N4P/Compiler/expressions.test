-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)')



// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  LIKE expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Test empty pattern
// TODO: Enable when supported
//SELECT n_name LIKE '' FROM nation LIMIT 1;
//rows: (false)

-- Test empty predicand
// TODO: Enable when supported
//SELECT '' LIKE 'Australia' FROM nation LIMIT 1;
//rows: (false)

-- Empty predicand and pattern
// TODO: Enable when supported
//SELECT '' LIKE '' FROM nation LIMIT 1;
//rows: (true)

-- Equal predicand and pattern
// TODO: Enable when supported
//SELECT 'abc' LIKE 'abc' FROM nation LIMIT 1;
//rows: (true)

-- Add a trailing space in predicand
// TODO: Enable when supported
//SELECT 'abc ' LIKE 'abc' FROM nation LIMIT 1;
//rows: (false)

-- Add a trailing space in pattern
// TODO: Enable when supported
//SELECT 'abc' LIKE 'abc ' FROM nation LIMIT 1;
//rows: (false)

-- Null predicant should return null
// TODO: Enable when supported
//SELECT NULL LIKE 'abc' FROM NATION LIMIT 1;
//rows: (null)

-- Null pattern should return null
// TODO: Enable when supported
//SELECT n_name LIKE null FROM NATION LIMIT 1;
//rows: (null)

-- Null escape should return null
// TODO: Enable when supported
//SELECT n_name LIKE 'abc' ESCAPE null FROM NATION LIMIT 1;
//rows: (null)

-- Cannot use non-strings in the predicand
EXPLAIN SELECT 1 LIKE 'abc' FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- Cannot use non-strings in the pattern
EXPLAIN SELECT 'abc' LIKE 1 FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- Cannot use non-strings in the escape
EXPLAIN SELECT 'abc' LIKE 'abc' ESCAPE 1 FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- test NOT LIKE
// TODO: Enable when supported
//SELECT 'abc' NOT LIKE 'abc' FROM nation LIMIT 1;
//rows: (false)

-- test '_' matches a single character
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'abc_ef' FROM nation LIMIT 1;
//rows: (true)

-- test multiple '_' matches
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'a_c_ef' FROM nation LIMIT 1;
//rows: (true)

-- test multiple '_' consecutive matches
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'ab__ef' FROM nation LIMIT 1;
//rows: (true)

-- test '%' matches zero or more characters (1)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'ab%ef' FROM nation LIMIT 1;
//rows: (true)

-- test '%' matches zero or more characters (2)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE '%bcdef' FROM nation LIMIT 1;
//rows: (true)

-- test '%' matches zero or more characters (3)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'abcde%' FROM nation LIMIT 1;
//rows: (true)

-- test '%' matches zero or more characters (4)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE '%a%b%c%d%e%f%' FROM nation LIMIT 1;
//rows: (true)

-- test multiple consecutive '%' characters
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'ab%%%ef' FROM nation LIMIT 1;
//rows: (true)

-- test combination of '_' and '%' (1)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'a_c%f' FROM nation LIMIT 1;
//rows: (true)

-- test combination of '_' and '%' (2)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE '%e_' FROM nation LIMIT 1;
//rows: (true)

-- test combination of '_' and '%' (3)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE '%_' FROM nation LIMIT 1;
//rows: (true)

-- Test that escape works with a single character
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' ESCAPE '#' FROM NATION LIMIT 1;
//rows: (true)

-- Test that there is no default escape character if escape is not specified (1)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc\\_def' FROM NATION LIMIT 1;
//rows: (false)

-- Test that there is no default escape character if escape is not specified (2)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' FROM NATION LIMIT 1;
//rows: (false)

-- Test that escape cannot be more than one character
// TODO: Enable when supported
// EXPLAIN SELECT 'abc_def' LIKE 'abc##_def' ESCAPE '##' FROM NATION LIMIT 1;
// TODO: error, escape is more than one character

-- Test that escape works with a columnRef (so long as it is one character - a runtime check)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' ESCAPE '<some_columnRef>' FROM NATION LIMIT 1;
// TODO:

-- Test that escape works with a subquery (so long as it is one character - a runtime check)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' ESCAPE (SELECT '#' FROM nation LIMIT 1) FROM NATION LIMIT 1;
//rows: (true)

-- Test that escape works with a subquery (so long as it is one character - a runtime check)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' ESCAPE (SELECT '#' FROM nation LIMIT 2) FROM NATION LIMIT 1;
// TODO: runtime error - more than one row returned for expression subquery

-- Test that the escape character can be matched by duplicating it (1)
// TODO: Enable when supported
//SELECT 'abc#def' LIKE 'abc##def' ESCAPE '#' FROM NATION LIMIT 1;
//rows: (true)

-- Test that the escape character can be matched by duplicating it (2)
// TODO: Enable when supported
//SELECT 'abc#def' LIKE 'abc##_ef' ESCAPE '#' FROM NATION LIMIT 1;
//rows: (true)

-- test ESCAPE '', which disables any escaping
// TODO: Enable when supported
//SELECT 'abc#def' LIKE 'abc#_ef' ESCAPE '' FROM NATION LIMIT 1;
//rows: (false)

-- Test that LIKE is not case sensitive
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'ABCDEF' FROM NATION LIMIT 1;
//rows: (false)




// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE nation;
  mute
}