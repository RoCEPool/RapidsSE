// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  LIKE expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Runtime test: empty pattern
// TODO: Enable when supported
//SELECT n_name LIKE '' FROM nation LIMIT 1;
//rows: (false)

-- Runtime test:  empty predicand
// TODO: Enable when supported
//SELECT '' LIKE 'Australia' FROM nation LIMIT 1;
//rows: (false)

-- Runtime test: Empty predicand and pattern
// TODO: Enable when supported
//SELECT '' LIKE '' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test: Equal predicand and pattern
// TODO: Enable when supported
//SELECT 'abc' LIKE 'abc' FROM nation LIMIT 1;
//rows: (true)

-- Add a trailing space in predicand
// TODO: Enable when supported
//SELECT 'abc ' LIKE 'abc' FROM nation LIMIT 1;
//rows: (false)

-- Runtime test: Add a trailing space in pattern
// TODO: Enable when supported
//SELECT 'abc' LIKE 'abc ' FROM nation LIMIT 1;
//rows: (false)

-- Runtime test Null predicant should return null
// TODO: Enable when supported
//SELECT NULL LIKE 'abc' FROM NATION LIMIT 1;
//rows: (null)

-- Runtime test Null pattern should return null
// TODO: Enable when supported
//SELECT n_name LIKE null FROM NATION LIMIT 1;
//rows: (null)

-- Runtime test Null escape should return null
// TODO: Enable when supported
//SELECT n_name LIKE 'abc' ESCAPE null FROM NATION LIMIT 1;
//rows: (null)

-- Cannot use non-strings in the predicand
EXPLAIN SELECT 1 LIKE 'abc' FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- Cannot use non-strings in the pattern
EXPLAIN SELECT 'abc' LIKE 1 FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- Cannot use non-strings in the escape
EXPLAIN SELECT 'abc' LIKE 'abc' ESCAPE 1 FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- Runtime test NOT LIKE
// TODO: Enable when supported
//SELECT 'abc' NOT LIKE 'abc' FROM nation LIMIT 1;
//rows: (false)

-- test EXPLAIN output of NOT LIKE
EXPLAIN SELECT 'abc' NOT LIKE 'abc' FROM nation LIMIT 1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT ''abc'' NOT LIKE ''abc'' FROM nation LIMIT 1"

-> -> limitOp
      » limit: (1)

-> -> -> projectOp
         » column: (Expr = NOT (''abc'' LIKE ''abc'') ; Ordinal Expr = NOT (''abc'' LIKE ''abc''))

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)')


-- Runtime test '_' matches a single character
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'abc_ef' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test multiple '_' matches
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'a_c_ef' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test multiple '_' consecutive matches
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'ab__ef' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test '%' matches zero or more characters (1)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'ab%ef' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test '%' matches zero or more characters (2)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE '%bcdef' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test '%' matches zero or more characters (3)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'abcde%' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test '%' matches zero or more characters (4)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE '%a%b%c%d%e%f%' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test multiple consecutive '%' characters
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'ab%%%ef' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test combination of '_' and '%' (1)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE 'a_c%f' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test combination of '_' and '%' (2)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE '%e_' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test combination of '_' and '%' (3)
// TODO: Enable when supported
//SELECT 'abcdef' LIKE '%_' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test that escape works with a single character
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' ESCAPE '#' FROM NATION LIMIT 1;
//rows: (true)

-- Runtime test that there is no default escape character if escape is not specified (1)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc\\_def' FROM NATION LIMIT 1;
//rows: (false)

-- Runtime test that there is no default escape character if escape is not specified (2)
// TODO: Enable when supported
//SELECT 'abc_def' LIKE 'abc#_def' FROM NATION LIMIT 1;
//rows: (false)

-- Test in the EXPLAIN output that there is no default escape character if escape is not specified (3)
EXPLAIN SELECT 'abc_def' LIKE 'abc#_def' FROM NATION LIMIT 1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT ''abc_def'' LIKE ''abc#_def'' FROM NATION LIMIT 1"

-> -> limitOp
      » limit: (1)

-> -> -> projectOp
         » column: (Expr = ''abc_def'' LIKE ''abc#_def'' ; Ordinal Expr = ''abc_def'' LIKE ''abc#_def'')

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)')


-- Test that escape cannot be more than one literal character
EXPLAIN SELECT 'abc_def' LIKE 'abc##_def' ESCAPE '##' FROM NATION LIMIT 1;
failure contains: 'ESCAPE clause can only contain a single character'

-- Test that escape works with a columnRef when explained
EXPLAIN SELECT * FROM likeTest WHERE col1 like 'a_b_c%' ESCAPE col2;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM likeTest WHERE col1 like ''a_b_c%'' ESCAPE col2"

-> -> projectOp
      » column: (Alias = COL1 ; Expr = rapidsse.public.likeTest.COL1 ; Ordinal Expr = $1)
      » column: (Alias = COL2 ; Expr = rapidsse.public.likeTest.COL2 ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (rapidsse.public.likeTest.col1 LIKE ''a_b_c%'' ESCAPE rapidsse.public.likeTest.col2)
         » ordinal expr: ($1 LIKE ''a_b_c%'' ESCAPE $2)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.likeTest)')


