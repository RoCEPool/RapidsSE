//  LIKE expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Runtime test: empty pattern
// TODO: Enable when supported
//SELECT n_name LIKE '' FROM nation LIMIT 1;
//rows: (false)

-- Runtime test:  empty predicand
// TODO: Enable when supported
//SELECT '' LIKE 'Australia' FROM nation LIMIT 1;
//rows: (false)

-- Runtime test: Empty predicand and pattern
// TODO: Enable when supported
//SELECT '' LIKE '' FROM nation LIMIT 1;
//rows: (true)

-- Runtime test: Equal predicand and pattern
// TODO: Enable when supported
//SELECT 'abc' LIKE 'abc' FROM nation LIMIT 1;
//rows: (true)

-- Add a trailing space in predicand
// TODO: Enable when supported
//SELECT 'abc ' LIKE 'abc' FROM nation LIMIT 1;
//rows: (false)

-- Runtime test: Add a trailing space in pattern
// TODO: Enable when supported
//SELECT 'abc' LIKE 'abc ' FROM nation LIMIT 1;
//rows: (false)

-- Runtime test Null predicant should return null
// TODO: Enable when supported
//SELECT NULL LIKE 'abc' FROM NATION LIMIT 1;
//rows: (null)

-- Runtime test Null pattern should return null
// TODO: Enable when supported
//SELECT n_name LIKE null FROM NATION LIMIT 1;
//rows: (null)

-- Runtime test Null escape should return null
// TODO: Enable when supported
//SELECT n_name LIKE 'abc' ESCAPE null FROM NATION LIMIT 1;
//rows: (null)

-- Cannot use non-strings in the predicand
EXPLAIN SELECT 1 LIKE 'abc' FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- Cannot use non-strings in the pattern
EXPLAIN SELECT 'abc' LIKE 1 FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- Cannot use non-strings in the escape
EXPLAIN SELECT 'abc' LIKE 'abc' ESCAPE 1 FROM NATION LIMIT 1;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

-- Runtime test NOT LIKE
// TODO: Enable when supported
//SELECT 'abc' NOT LIKE 'abc' FROM nation LIMIT 1;
//rows: (false)

-- test EXPLAIN output of NOT LIKE
EXPLAIN SELECT 'abc' NOT LIKE 'abc' FROM nation LIMIT 1;
