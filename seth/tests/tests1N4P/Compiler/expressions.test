∆ mainSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation WHERE n_nationkey IN (1, (SELECT n_nationkey FROM nation))"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (rapidsse.public.nation.n_nationkey IN (1, __subquery0003()))
