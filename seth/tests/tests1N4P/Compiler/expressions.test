/*----------------------------------------------------------------------------*/
/* General syntax & semantics tests for expressions                           */
/*                                                                            */
/* This does not include aggregates or expression subqueries as they can be   */
/* found in aggregates.test and exprSubqueries.test.                          */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

// Loads empty table with the following columns
//	 N_NATIONKEY       INTEGER NOT NULL,
//	 N_NAME            CHAR(25) NOT NULL,
//	 N_REGIONKEY       INTEGER NOT NULL,
//	 N_COMMENT         VARCHAR(152)

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  IN expressions without subqueries
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT n_name FROM nation WHERE n_nationkey IN (1, 2, 3, 4);
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation WHERE n_nationkey IN (1, 2, 3, 4)"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (rapidsse.public.nation.n_nationkey IN (1, 2, 3, 4))
         » ordinal expr: ($1 IN (1, 2, 3, 4))

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)')


EXPLAIN SELECT n_name FROM nation WHERE n_nationkey IN (true, false);
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: rapidsse.public.nation.n_nationkey IN (true, false)'


EXPLAIN SELECT n_name FROM nation WHERE n_nationkey IN (1, false);
failure contains: 'Incompatible expression types: IN clause parameters'


EXPLAIN SELECT n_name FROM nation WHERE n_nationkey IN ((SELECT n_nationkey FROM nation));
