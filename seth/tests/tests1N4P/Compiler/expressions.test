-- Runtime test: that the escape character can be matched by duplicating it (2)
// TODO: Enable when supported
//SELECT 'abc#def' LIKE 'abc##_ef' ESCAPE '#' FROM NATION LIMIT 1;
//rows: (true)

-- Runtime test: test ESCAPE '', which disables any escaping
// TODO: Enable when supported
