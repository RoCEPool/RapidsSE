-> -> orderOp
      » order expr: ((rapidsse.public.nation.n_nationkey + 1) DESC)
      » ordinal order expr: (($1 + 1) DESC)

-> -> -> projectOp
         » column: (Alias = N_NATIONKEY ; Expr = rapidsse.public.nation.N_NATIONKEY ; Ordinal Expr = $1)
         » column: (Alias = N_NAME ; Expr = rapidsse.public.nation.N_NAME ; Ordinal Expr = $2)
         » column: (Alias = N_REGIONKEY ; Expr = rapidsse.public.nation.N_REGIONKEY ; Ordinal Expr = $3)
         » column: (Alias = N_COMMENT ; Expr = rapidsse.public.nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)'
)

-- Ordering expressions are not just column references but arbitrary expressions (multiple)
EXPLAIN SELECT * FROM nation ORDER BY n_name desc, n_nationkey + n_regionkey;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM nation ORDER BY n_name desc, n_nationkey + n_regionkey"

-> -> orderOp
      » order expr: ((rapidsse.public.nation.n_name) DESC, (rapidsse.public.nation.n_nationkey + rapidsse.public.nation.n_regionkey) ASC)
      » ordinal order expr: (($2) DESC, ($1 + $3) ASC)

-> -> -> projectOp
         » column: (Alias = N_NATIONKEY ; Expr = rapidsse.public.nation.N_NATIONKEY ; Ordinal Expr = $1)
         » column: (Alias = N_NAME ; Expr = rapidsse.public.nation.N_NAME ; Ordinal Expr = $2)
         » column: (Alias = N_REGIONKEY ; Expr = rapidsse.public.nation.N_REGIONKEY ; Ordinal Expr = $3)
         » column: (Alias = N_COMMENT ; Expr = rapidsse.public.nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)'
)

-- ORDER BY must appear after HAVING and before LIMIT
EXPLAIN SELECT n_name, sum(n_nationkey) as s
FROM nation
GROUP BY n_name
HAVING n_name = 'KENYA'
ORDER BY n_name desc, sum(n_nationkey);
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name, sum(n_nationkey) as s FROM nation GROUP BY n_name HAVING n_name = ''KENYA'' ORDER BY n_name desc, sum(n_nationkey)"

-> -> orderOp
      » order expr: ((rapidsse.public.nation.n_name) DESC, (SUM(rapidsse.public.nation.n_nationkey)) ASC)
      » ordinal order expr: (($1) DESC, ($2) ASC)

-> -> -> filterOp
         » expr: (rapidsse.public.nation.n_name = ''KENYA'')
         » ordinal expr: ($1 = ''KENYA'')

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Alias = s ; Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))
            » group by: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)

EXPLAIN SELECT n_name, sum(n_nationkey) as s
FROM nation
GROUP BY n_name
HAVING n_name = 'KENYA'
ORDER BY n_name desc, sum(n_nationkey)
LIMIT 10;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name, sum(n_nationkey) as s FROM nation GROUP BY n_name HAVING n_name = ''KENYA'' ORDER BY n_name desc, sum(n_nationkey) LIMIT 10"

-> -> limitOp
      » limit: (10)

-> -> -> orderOp
         » order expr: ((rapidsse.public.nation.n_name) DESC, (SUM(rapidsse.public.nation.n_nationkey)) ASC)
         » ordinal order expr: (($1) DESC, ($2) ASC)

-> -> -> -> filterOp
            » expr: (rapidsse.public.nation.n_name = ''KENYA'')
            » ordinal expr: ($1 = ''KENYA'')

-> -> -> -> -> aggregateOp
               » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
               » column: (Alias = s ; Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))
               » group by: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> tableScanOp
                  » table: (rapidsse.public.nation)'
)


-- ORDER BY can be used in set queries but it must use aliases only.
-- This is because we cannot push an ordering expression down through a Set operator
-- so we can only use the projected columns that the set operator gives us.
-- This is a non-trivial issue to fix...
--
-- If we allow resolution down the unionOp's first child then we run the risk of
-- allowing an order by a column that is not being unioned. That column shouldn't
-- be visible.
-- If we try to resolve a column name against qualified columnRefs in the projected
-- columns then we also permit ordering expressions to be specified that aren't equal
-- to or supersets of the projected columns. e.g. projecting (col1 + 1), ordering
-- by (col1 * 2). We would need some additional check to ensure that in the case where
-- an orderOp was above a setOp then the ordering expressions must be equal to
-- or supersets of the projected expressions.
-- Alternatively, we only allow ordering by aliases.
EXPLAIN
SELECT n_nationkey, n_name FROM nation
UNION ALL
SELECT n_regionkey, n_name FROM nation
ORDER BY n_nationkey;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey, n_name FROM nation UNION ALL SELECT n_regionkey, n_name FROM nation ORDER BY n_nationkey"

-> -> orderOp
      » order expr: ((rapidsse.public.nation.n_nationkey) ASC)
      » ordinal order expr: (($1) ASC)

-> -> -> statementMarker: select
         » queryText: "SELECT n_nationkey, n_name FROM nation UNION ALL SELECT n_regionkey, n_name FROM nation"

-> -> -> -> unionOp
            » isDistinct: (false)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT n_nationkey, n_name FROM nation"

-> -> -> -> -> -> projectOp
                  » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
                  » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.nation)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT n_regionkey, n_name FROM nation"

-> -> -> -> -> -> projectOp
                  » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
                  » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.nation)'
)

EXPLAIN
SELECT n_nationkey + 1, n_name FROM nation
UNION ALL
SELECT n_regionkey, n_name FROM nation
ORDER BY n_nationkey;
failure contains: 'Invalid expression because it is not being projected: rapidsse.public.nation.n_nationkey'

EXPLAIN
SELECT n_nationkey + 1, n_name FROM nation
UNION ALL
SELECT n_regionkey, n_name FROM nation
ORDER BY n_nationkey + 1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey + 1, n_name FROM nation UNION ALL SELECT n_regionkey, n_name FROM nation ORDER BY n_nationkey + 1"

-> -> orderOp
      » order expr: ((rapidsse.public.nation.n_nationkey + 1) ASC)
      » ordinal order expr: (($1) ASC)

-> -> -> statementMarker: select
         » queryText: "SELECT n_nationkey + 1, n_name FROM nation UNION ALL SELECT n_regionkey, n_name FROM nation"

-> -> -> -> unionOp
            » isDistinct: (false)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT n_nationkey + 1, n_name FROM nation"

-> -> -> -> -> -> projectOp
                  » column: (Expr = rapidsse.public.nation.n_nationkey + 1 ; Ordinal Expr = $1 + 1)
                  » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.nation)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT n_regionkey, n_name FROM nation"

-> -> -> -> -> -> projectOp
                  » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
                  » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.nation)'
)

-- -- Ordering expression can be a superset of the unionOps first child
EXPLAIN
SELECT n_nationkey, n_name FROM nation
UNION ALL
SELECT n_regionkey, n_name FROM nation
ORDER BY n_nationkey * 2;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey, n_name FROM nation UNION ALL SELECT n_regionkey, n_name FROM nation ORDER BY n_nationkey * 2"

-> -> orderOp
      » order expr: ((rapidsse.public.nation.n_nationkey * 2) ASC)
      » ordinal order expr: (($1 * 2) ASC)

-> -> -> statementMarker: select
         » queryText: "SELECT n_nationkey, n_name FROM nation UNION ALL SELECT n_regionkey, n_name FROM nation"

-> -> -> -> unionOp
            » isDistinct: (false)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT n_nationkey, n_name FROM nation"

-> -> -> -> -> -> projectOp
                  » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
                  » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.nation)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT n_regionkey, n_name FROM nation"

-> -> -> -> -> -> projectOp
                  » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
                  » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.nation)'
)

-- ORDER BY above a SetOp cannot resolve columnRefs unless they are aliases
-- being projected by the SetOp.
-- This shouldn't work because n_regionkey is not being projected by the UnionOp
EXPLAIN
SELECT n_nationkey as nkey, n_name FROM nation
UNION ALL
SELECT n_regionkey, n_name FROM nation
ORDER BY n_regionkey;
failure contains: 'Invalid expression because it is not being projected: rapidsse.public.nation.n_regionkey'


-- Order expr is a superset of projected expression but contains
-- a columnRef that is not being projected.
EXPLAIN
SELECT n_nationkey, n_name FROM nation
UNION ALL
SELECT n_regionkey, n_name FROM nation
ORDER BY n_nationkey + n_regionkey;
failure contains: 'Invalid expression because it is not being projected: rapidsse.public.nation.n_regionkey'


-- ORDER BY expressions can use aliases
EXPLAIN SELECT n_name as name FROM nation ORDER BY name;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name as name FROM nation ORDER BY name"

-> -> orderOp
      » order expr: ((name) ASC)
      » ordinal order expr: (($1) ASC)

-> -> -> projectOp
         » column: (Alias = name ; Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)'
)

-- ORDER BY expressions doesn't have to always refer to the alias
EXPLAIN SELECT n_nationkey + 1 as nkey FROM nation ORDER BY n_nationkey + 1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey + 1 as nkey FROM nation ORDER BY n_nationkey + 1"

-> -> orderOp
      » order expr: ((rapidsse.public.nation.n_nationkey + 1) ASC)
      » ordinal order expr: (($1) ASC)

-> -> -> projectOp
         » column: (Alias = nkey ; Expr = rapidsse.public.nation.n_nationkey + 1 ; Ordinal Expr = $1 + 1)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)'
)

-- ORDER BY expressions can use aliases (reaching through a SetOp to the first branch)
EXPLAIN
SELECT n_nationkey as nkey, n_name FROM nation
UNION ALL
SELECT n_regionkey, n_name FROM nation
ORDER BY nkey;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey as nkey, n_name FROM nation UNION ALL SELECT n_regionkey, n_name FROM nation ORDER BY nkey"

-> -> orderOp
      » order expr: ((nkey) ASC)
      » ordinal order expr: (($1) ASC)

-> -> -> statementMarker: select
         » queryText: "SELECT n_nationkey as nkey, n_name FROM nation UNION ALL SELECT n_regionkey, n_name FROM nation"

-> -> -> -> unionOp
            » isDistinct: (false)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT n_nationkey as nkey, n_name FROM nation"

-> -> -> -> -> -> projectOp
                  » column: (Alias = nkey ; Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
                  » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.nation)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT n_regionkey, n_name FROM nation"

-> -> -> -> -> -> projectOp
                  » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
                  » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.nation)'
)



