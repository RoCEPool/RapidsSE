/*----------------------------------------------------------------------------*/
/* General syntax & semantics tests for CASE expressions                      */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

CREATE TABLE region (
	 R_REGIONKEY       INTEGER NOT NULL,
	 R_NAME            CHAR(25) NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

CREATE TABLE extractTest (
  COL1 INTEGER    NOT NULL,
  COL2 VARCHAR    NOT NULL,
  COL3 DATE       NOT NULL,
  COL4 TIME       NOT NULL,
  COL5 TIMESTAMP  NOT NULL,
//COL6 INTERVAL YEAR TO MONTH NOT NULL,
//COL7 INTERVAL DAY TO TIME NOT NULL,
  COL8 FLOAT      NOT NULL,
  COL9 DECIMAL    NOT NULL,
  COL10 BOOLEAN   NOT NULL,
  COL11 TIMESTAMP // all nulls
);
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  CASE expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Simple CASE expr
EXPLAIN
SELECT CASE n_name
        WHEN 'AUSTRALIA' THEN 'here'
        WHEN 'INDIA' THEN 'there'
        ELSE 'everywhere'
       END
FROM nation;

rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT CASE n_name         WHEN ''AUSTRALIA'' THEN ''here''         WHEN ''INDIA'' THEN ''there''         ELSE ''everywhere''        END FROM nation"

-> -> projectOp
      » column: (Expr = CASE WHEN (rapidsse.public.nation.n_name = ''AUSTRALIA'') THEN ''here'' WHEN (rapidsse.public.nation.n_name = ''INDIA'') THEN ''there'' ELSE ''everywhere'' END ; Ordinal Expr = CASE WHEN ($2 = ''AUSTRALIA'') THEN ''here'' WHEN ($2 = ''INDIA'') THEN ''there'' ELSE ''everywhere'' END)

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)')


