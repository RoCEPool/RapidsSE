EXPLAIN with_types
SELECT CASE n_name
        WHEN 'AUSTRALIA' THEN DATE '2000-01-01'
        WHEN 'INDIA' THEN TIMESTAMP '2001-01-01 13:00:00'
        ELSE NULL
      END
FROM nation;

