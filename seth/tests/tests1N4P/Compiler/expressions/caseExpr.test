// Nested CASE
EXPLAIN
SELECT CASE n_name
        WHEN 'AUSTRALIA' THEN 'here'
        WHEN 'INDIA' THEN 'there'
        ELSE
          CASE n_nationkey
            WHEN 1 THEN 'out there'
            WHEN 2 THEN 'over there'
            ELSE 'everywhere'
          END
       END
FROM nation;

rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT CASE n_name         WHEN ''AUSTRALIA'' THEN ''here''         WHEN ''INDIA'' THEN ''there''         ELSE           CASE n_nationkey             WHEN 1 THEN ''out there''             WHEN 2 THEN ''over there''             ELSE ''everywhere''           END        END FROM nation"

-> -> projectOp
      » column: (Expr = CASE WHEN (rapidsse.public.nation.n_name = ''AUSTRALIA'') THEN ''here'' WHEN (rapidsse.public.nation.n_name = ''INDIA'') THEN ''there'' ELSE (CASE WHEN (rapidsse.public.nation.n_nationkey = 1) THEN ''out there'' WHEN (rapidsse.public.nation.n_nationkey = 2) THEN ''over there'' ELSE ''everywhere'' END) END ; Ordinal Expr = CASE WHEN ($2 = ''AUSTRALIA'') THEN ''here'' WHEN ($2 = ''INDIA'') THEN ''there'' ELSE (CASE WHEN ($1 = 1) THEN ''out there'' WHEN ($1 = 2) THEN ''over there'' ELSE ''everywhere'' END) END)

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)')


