-> -> projectOp
      » column: (Expr = CASE WHEN (rapidsse.public.extractTest.col2 = ''AUSTRALIA'') THEN rapidsse.public.extractTest.col1 WHEN (rapidsse.public.extractTest.col2 = ''INDIA'') THEN rapidsse.public.extractTest.col9 ELSE NULL END ; Ordinal Expr = CASE WHEN ($2 = ''AUSTRALIA'') THEN $1 WHEN ($2 = ''INDIA'') THEN $7 ELSE NULL END) ; type: DECIMAL

-> -> -> tableScanOp
         » table: (rapidsse.public.extractTest)')


