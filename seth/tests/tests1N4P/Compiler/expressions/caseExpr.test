// CASE being part of a larger expression
EXPLAIN
SELECT 1 + CASE n_name
        WHEN 'AUSTRALIA' THEN 2 * n_nationkey
        WHEN 'INDIA' THEN 3 * n_nationkey
        ELSE n_nationkey
      END
FROM nation;

rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

