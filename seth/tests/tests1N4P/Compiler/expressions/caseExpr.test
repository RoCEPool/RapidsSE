   » queryText: "SELECT 1 + CASE n_name         WHEN ''AUSTRALIA'' THEN 2 * n_nationkey         WHEN ''INDIA'' THEN 3 * n_nationkey         ELSE n_nationkey       END FROM nation"

-> -> projectOp
      » column: (Expr = 1 + (CASE WHEN (rapidsse.public.nation.n_name = ''AUSTRALIA'') THEN (2 * rapidsse.public.nation.n_nationkey) WHEN (rapidsse.public.nation.n_name = ''INDIA'') THEN (3 * rapidsse.public.nation.n_nationkey) ELSE rapidsse.public.nation.n_nationkey END) ; Ordinal Expr = 1 + (CASE WHEN ($2 = ''AUSTRALIA'') THEN (2 * $1) WHEN ($2 = ''INDIA'') THEN (3 * $1) ELSE $1 END))

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)')


// Subquery within a CASE
EXPLAIN
SELECT CASE n_name
         WHEN (SELECT n_name FROM nation WHERE n_nationkey = (SELECT MAX(n_nationkey) FROM nation)) THEN 'here'
         WHEN 'INDIA' THEN 'there'
         ELSE 'everywhere'
       END
FROM nation;

