// Case with mix of numeric types. Integer is promoted to a float
EXPLAIN with_types
SELECT CASE n_name
        WHEN 'AUSTRALIA' THEN 1
        WHEN 'INDIA' THEN 1.0e0
        ELSE NULL
      END
FROM nation;

