// Invalid searched CASE expr with non-boolean predicants (1)
EXPLAIN
SELECT CASE
        WHEN n_name THEN 'here'
        WHEN n_name = 'INDIA' THEN 'there'
        ELSE 'everywhere'
       END
FROM nation;
failure contains: 'Predicate expression must have a boolean result : WHEN rapidsse.public.nation.n_name'


// Invalid searched CASE expr with non-boolean predicants (2)
EXPLAIN
SELECT CASE
        WHEN n_name = 'AUSTRALIA' THEN 'here'
        WHEN 'INDIA' THEN 'there'
        ELSE 'everywhere'
       END
FROM nation;
failure contains: 'Predicate expression must have a boolean result : WHEN'


// CASE in a WHERE clause
EXPLAIN
SELECT *
FROM nation
WHERE CASE
        WHEN n_name = 'AUSTRALIA' THEN 'here'
        WHEN n_name = 'INDIA' THEN 'there'
        ELSE 'everywhere'
      END = 'everywhere';

