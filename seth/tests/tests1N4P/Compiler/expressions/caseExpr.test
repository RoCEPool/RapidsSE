-> -> projectOp
      » column: (Expr = CASE WHEN (rapidsse.public.nation.n_name = ''AUSTRALIA'') THEN 1 WHEN (rapidsse.public.nation.n_name = ''INDIA'') THEN 1.000000e+00 ELSE NULL END ; Ordinal Expr = CASE WHEN ($2 = ''AUSTRALIA'') THEN 1 WHEN ($2 = ''INDIA'') THEN 1.000000e+00 ELSE NULL END) ; type: FLOAT

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)')


// Case with mix of numeric types. Integer (col1) is promoted to a decimal (col9)
EXPLAIN with_types
SELECT CASE col2
        WHEN 'AUSTRALIA' THEN col1
        WHEN 'INDIA'     THEN col9
        ELSE NULL
      END
FROM extractTest;

rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

