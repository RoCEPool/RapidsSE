/*----------------------------------------------------------------------------*/
/* General syntax & semantics tests for IN expressions                        */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE ${testName}_nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

CREATE TABLE ${testName}_region (
	 R_REGIONKEY       INTEGER NOT NULL,
	 R_NAME            CHAR(25) NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  IN expressions without subqueries
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT n_name FROM ${testName}_nation WHERE n_nationkey IN (1, 2, 3, 4);
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name FROM ${testName}_nation WHERE n_nationkey IN (1, 2, 3, 4)"

-> -> projectOp
      » column: (Expr = rapidsse.public.${testName}_nation.n_name ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (rapidsse.public.${testName}_nation.n_nationkey IN (1, 2, 3, 4))
         » ordinal expr: ($1 IN (1, 2, 3, 4))

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName}_nation)')


EXPLAIN SELECT n_name FROM ${testName}_nation WHERE n_nationkey IN (true, false);
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (INTEGER IN (BOOLEAN, BOOLEAN)) in expression (rapidsse.public.${testName}_nation.n_nationkey IN (true, false))'


EXPLAIN SELECT n_name FROM ${testName}_nation WHERE n_nationkey IN (1, false);
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'


