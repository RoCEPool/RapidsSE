EXPLAIN SELECT n_name FROM ${testName}_nation WHERE n_nationkey IN (1, (WITH t1 AS (SELECT n_nationkey FROM ${testName}_nation) SELECT * FROM t1));
rows: (*,'explainPlan','
∆ exprSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> tableSubquery
   » table alias: t1
   » correlated columns: (none)
   » recursive: false

-> -> mainSubquery
      » table alias: __subquery0002
      » correlated columns: (none)

-> -> -> statementMarker: select
         » queryText: "SELECT n_nationkey FROM ${testName}_nation"

-> -> -> -> projectOp
            » column: (Expr = rapidsse.public.${testName}_nation.n_nationkey ; Ordinal Expr = $1)

