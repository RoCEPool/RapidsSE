         » ordinal expr: ($1 IN (1, __subquery0004()))

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName}_nation)')


EXPLAIN SELECT n_name FROM ${testName}_nation WHERE n_nationkey IN ();
failure contains: 'insufficient expressions specified: IN clause'


