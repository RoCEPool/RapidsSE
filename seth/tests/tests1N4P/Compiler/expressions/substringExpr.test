// Extract with a float     FROM argument
EXPLAIN SELECT SUBSTRING(n_name, 1.0e0, 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, FLOAT, INTEGER)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1.0000000000e+00, 2))'

// Extract with a decimal   FROM argument
EXPLAIN SELECT SUBSTRING(n_name, 1.0, 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, DECIMAL, INTEGER)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1.0, 2))'

// Extract with a date      FROM argument
EXPLAIN SELECT SUBSTRING(n_name, DATE '2021-11-09', 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, DATE, INTEGER)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, DATE ''2021-11-09'', 2))'

// Extract with a time      FROM argument
EXPLAIN SELECT SUBSTRING(n_name, TIME '16:58:23', 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, TIME, INTEGER)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, TIME ''16:58:23'', 2))'

// Extract with a timestamp FROM argument
EXPLAIN SELECT SUBSTRING(n_name, TIMESTAMP '2021-11-09 16:58:23.123', 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, TIMESTAMP, INTEGER)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, TIMESTAMP ''2021-11-09 16:58:23.123000'', 2))'

// Extract with a string    FROM argument
EXPLAIN SELECT SUBSTRING(n_name, 'abcdef', 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, VARCHAR, INTEGER)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, ''abcdef'', 2))'

