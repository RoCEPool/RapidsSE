failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, BOOLEAN, INTEGER)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, true, 2))'

// Extract with a integer   FROM argument
EXPLAIN SELECT SUBSTRING(n_name, 1, 2) FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
