// Extract with a boolean   LENGTH argument
EXPLAIN SELECT SUBSTRING(n_name, 1, true) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, INTEGER, BOOLEAN)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1, true))'

// Extract with a integer   LENGTH argument
EXPLAIN SELECT SUBSTRING(n_name, 1, 2) FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT SUBSTRING(n_name, 1, 2) FROM ${testName2}_nation"

