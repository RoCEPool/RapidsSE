// Extract with a float     LENGTH argument
EXPLAIN SELECT SUBSTRING(n_name, 1, 2.0e0) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, INTEGER, FLOAT)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1, 2.0000000000e+00))'

// Extract with a decimal   LENGTH argument
EXPLAIN SELECT SUBSTRING(n_name, 1, 2.0) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, INTEGER, DECIMAL)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1, 2.0))'

// Extract with a date      LENGTH argument
EXPLAIN SELECT SUBSTRING(n_name, 1, DATE '2021-11-09') FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, INTEGER, DATE)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1, DATE ''2021-11-09''))'

// Extract with a time      LENGTH argument
EXPLAIN SELECT SUBSTRING(n_name, 1, TIME '16:58:23') FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, INTEGER, TIME)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1, TIME ''16:58:23''))'

// Extract with a timestamp LENGTH argument
EXPLAIN SELECT SUBSTRING(n_name, 1, TIMESTAMP '2021-11-09 16:58:23.123') FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, INTEGER, TIMESTAMP)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1, TIMESTAMP ''2021-11-09 16:58:23.123000''))'

// Extract with a string    LENGTH argument
EXPLAIN SELECT SUBSTRING(n_name, 1, 'abcdef') FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(VARCHAR, INTEGER, VARCHAR)) in expression (SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1, ''abcdef''))'

