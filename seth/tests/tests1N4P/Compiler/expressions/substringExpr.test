// Extract with a NULL FROM argument
// TODO: Enable when SUBSTRING is supported in the execution engine
SELECT SUBSTRING (n_name, NULL, 2) FROM nation LIMIT 1;
rows: (NULL)

// Extract with a NULL LENGTH argument
// TODO: Enable when SUBSTRING is supported in the execution engine
SELECT SUBSTRING (n_name, 1, NULL) FROM nation LIMIT 1;
rows: (NULL)


// Leave off the length parameter
EXPLAIN SELECT SUBSTRING(n_name, 1) FROM nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT SUBSTRING(n_name, 1) FROM nation"

-> -> projectOp
      » column: (Expr = SUBSTRING(rapidsse.public.nation.n_name, 1) ; Ordinal Expr = SUBSTRING($2, 1))

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)')


// Use a negative value for the FROM parameter
EXPLAIN SELECT SUBSTRING(n_name, -1) FROM nation;
failure contains: 'Value is out of range: SUBSTRING FROM value: -1'

EXPLAIN SELECT SUBSTRING(n_name, -10) FROM nation;
failure contains: 'Value is out of range: SUBSTRING FROM value: -10'

// Use a negative value for the length parameter
EXPLAIN SELECT SUBSTRING(n_name, 1, -1) FROM nation;
failure contains: 'Value is out of range: SUBSTRING LENGTH value: -1'

EXPLAIN SELECT SUBSTRING(n_name, 1, -10) FROM nation;
failure contains: 'Value is out of range: SUBSTRING LENGTH value: -10'

// Test that a zero length returns an empty string
// TODO: enable once supported in the execution engine
SELECT SUBSTRING(n_name, 1, 0) FROM nation LIMIT 1;
rows: ('')


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE nation;
  mute

  DROP TABLE region;
  mute
  
  DROP TABLE substringTest;
  mute
}