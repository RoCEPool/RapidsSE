/*----------------------------------------------------------------------------*/
/* General syntax & semantics tests for SUBSTRING expressions                 */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE ${testName2}_nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

CREATE TABLE ${testName2}_region (
	 R_REGIONKEY       INTEGER NOT NULL,
	 R_NAME            CHAR(25) NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

CREATE TABLE substringTest (
  COL1 INTEGER    NOT NULL,
  COL2 VARCHAR    NOT NULL,
  COL3 DATE       NOT NULL,
  COL4 TIME       NOT NULL,
  COL5 TIMESTAMP  NOT NULL,
//COL6 INTERVAL YEAR TO MONTH NOT NULL,
//COL7 INTERVAL DAY TO TIME NOT NULL,
  COL8 FLOAT      NOT NULL,
  COL9 DECIMAL    NOT NULL,
  COL10 BOOLEAN   NOT NULL,
  COL11 TIMESTAMP // all nulls
);
success

load ${testName2}_nation "../DATA/TPCH/nation.tbl" ;
success

trackmemory;
success


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  SUBSTRING expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Extract from a columnRef
EXPLAIN SELECT SUBSTRING(n_name, 1, 2) FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT SUBSTRING(n_name, 1, 2) FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = SUBSTRING(rapidsse.public.${testName2}_nation.n_name, 1, 2) ; Ordinal Expr = SUBSTRING($2, 1, 2))

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')


// Extract from a literal
EXPLAIN SELECT SUBSTRING('abcdef', 1, 2) FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT SUBSTRING(''abcdef'', 1, 2) FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = SUBSTRING(''abcdef'', 1, 2) ; Ordinal Expr = SUBSTRING(''abcdef'', 1, 2))

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')


// Extract from a subquery
EXPLAIN SELECT SUBSTRING((SELECT n_name FROM ${testName2}_nation LIMIT 1), 1, 2) FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ exprSubquery
  » table alias: __subquery0003
  » correlated columns: (none)

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT n_name FROM ${testName2}_nation LIMIT 1"

-> -> -> limitOp
         » limit: (1)

-> -> -> -> projectOp
            » column: (Expr = rapidsse.public.${testName2}_nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.${testName2}_nation)

∆ mainSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT SUBSTRING((SELECT n_name FROM ${testName2}_nation LIMIT 1), 1, 2) FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = SUBSTRING(__subquery0003(), 1, 2) ; Ordinal Expr = SUBSTRING(__subquery0003(), 1, 2))

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')

// Extract from a boolean
EXPLAIN SELECT SUBSTRING(true, 1, 2) FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT SUBSTRING(true, 1, 2) FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = SUBSTRING(''TRUE'', 1, 2) ; Ordinal Expr = SUBSTRING(''TRUE'', 1, 2))

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')

// Substring from a integer
EXPLAIN SELECT SUBSTRING(42, 1, 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(INTEGER, INTEGER, INTEGER)) in expression (SUBSTRING(42, 1, 2))'

// Substring from a float
EXPLAIN SELECT SUBSTRING(42.0e0, 1, 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(FLOAT, INTEGER, INTEGER)) in expression (SUBSTRING(4.2000000000e+01, 1, 2))'

// Substring from a decimal
EXPLAIN SELECT SUBSTRING(42.0, 1, 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(DECIMAL, INTEGER, INTEGER)) in expression (SUBSTRING(42.0, 1, 2))'

// Substring from a date
EXPLAIN SELECT SUBSTRING(DATE '2021-11-09', 1, 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(DATE, INTEGER, INTEGER)) in expression (SUBSTRING(DATE ''2021-11-09'', 1, 2))'

// Substring from a time
EXPLAIN SELECT SUBSTRING(TIME '16:58:23', 1, 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(TIME, INTEGER, INTEGER)) in expression (SUBSTRING(TIME ''16:58:23'', 1, 2))'

// Substring from a timestamp
EXPLAIN SELECT SUBSTRING(TIMESTAMP '2021-11-09 16:58:23.123', 1, 2) FROM ${testName2}_nation;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (SUBSTRING(TIMESTAMP, INTEGER, INTEGER)) in expression (SUBSTRING(TIMESTAMP ''2021-11-09 16:58:23.123000'', 1, 2))'

// Extract from a string
EXPLAIN SELECT SUBSTRING('abcdef', 1, 2) FROM ${testName2}_nation;
