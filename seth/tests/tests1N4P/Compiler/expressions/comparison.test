failure contains: 'Expression type combination is invalid or unsupported'

EXPLAIN WITH_TYPES SELECT INTERVAL '1:2' HOUR TO MINUTE < 40 FROM nation;
failure contains: 'Expression type combination is invalid or unsupported'

EXPLAIN WITH_TYPES SELECT INTERVAL '1:2:3' HOUR TO SECOND < 40 FROM nation;
failure contains: 'Expression type combination is invalid or unsupported'

