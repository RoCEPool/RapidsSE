/*----------------------------------------------------------------------------*/
/* General syntax & semantics tests for CAST expressions                      */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE castTest (
  COL1  BOOLEAN    NOT NULL,
  COL2  INTEGER    NOT NULL,
  COL3  DECIMAL    NOT NULL,
  COL4  FLOAT      NOT NULL,
  COL5  CHAR       NOT NULL,
  COL6  VARCHAR    NOT NULL,
  COL7  DATE       NOT NULL,
  COL8  TIME       NOT NULL,
  COL9  TIMESTAMP  NOT NULL,
//COL10 INTERVAL YEAR TO MONTH NOT NULL,
//COL11 INTERVAL DAY TO TIME NOT NULL,
  COL12 TIMESTAMP // all nulls
);
success

trackmemory;
success


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Explicit CAST expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// *** Cast a BOOLEAN column ***
EXPLAIN with_types SELECT CAST(col1  AS BOOLEAN)      FROM castTest;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT CAST(col1  AS BOOLEAN)      FROM castTest"

-> -> projectOp
      » column: (Expr = CAST(rapidsse.public.castTest.col1 AS BOOLEAN) ; Ordinal Expr = CAST($1 AS BOOLEAN)) ; type: BOOLEAN

-> -> -> tableScanOp
         » table: (rapidsse.public.castTest)')

EXPLAIN with_types SELECT CAST(col1  AS CHAR(10))         FROM castTest;
