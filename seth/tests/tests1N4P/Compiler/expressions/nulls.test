EXPLAIN with_types stage partitionPlan SELECT AVG(1 + NULL) FROM ${testName2}_nation;
rows: (*,'partitionPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT AVG(1 + NULL) FROM ${testName2}_nation"

-> -> projectOp
      » location: origin
      » column: (Expr = (SUM(SUM(SUM(1 + NULL)))) / (CAST(SUM(SUM(COUNT(1 + NULL))) AS NULL)) ; Ordinal Expr = (SUM($1)) / (CAST(SUM($2) AS NULL))) ; type: NULL

-> -> -> projectOp
         » location: all nodes
         » column: (Expr = SUM(SUM(1 + NULL)) ; Ordinal Expr = SUM($1)) ; type: NULL
         » column: (Expr = SUM(COUNT(1 + NULL)) ; Ordinal Expr = SUM($2)) ; type: INTEGER

-> -> -> -> projectOp
            » column: (Expr = SUM(1 + NULL) ; Ordinal Expr = SUM(1 + NULL)) ; type: NULL
            » column: (Expr = COUNT(1 + NULL) ; Ordinal Expr = COUNT(1 + NULL)) ; type: INTEGER

-> -> -> -> -> tableScanOp
               » location: all partitions
               » table: (rapidsse.public.${testName2}_nation)')


