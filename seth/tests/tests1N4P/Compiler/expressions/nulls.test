EXPLAIN with_types stage partitionPlan SELECT SUM(1 + NULL) FROM ${testName2}_nation;
rows: (*,'partitionPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT SUM(1 + NULL) FROM ${testName2}_nation"

-> -> projectOp
      » location: origin
      » column: (Expr = SUM(SUM(SUM(1 + NULL))) ; Ordinal Expr = SUM($1)) ; type: NULL

-> -> -> projectOp
         » location: all nodes
         » column: (Expr = SUM(SUM(1 + NULL)) ; Ordinal Expr = SUM($1)) ; type: NULL

-> -> -> -> projectOp
            » column: (Expr = SUM(1 + NULL) ; Ordinal Expr = SUM(1 + NULL)) ; type: NULL

-> -> -> -> -> tableScanOp
               » location: all partitions
               » table: (rapidsse.public.${testName2}_nation)')


