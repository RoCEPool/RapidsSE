// Invalid interval literals
// -------------------------------------------------------

EXPLAIN SELECT INTERVAL ''   YEAR FROM nation;
failure contains: 'Invalid interval format: interval string is empty'

EXPLAIN SELECT INTERVAL 'aaa'   YEAR FROM nation;
failure contains: 'Invalid interval format: interval string is incomplete'

EXPLAIN SELECT INTERVAL '1a2'   YEAR FROM nation;
failure contains: 'Invalid interval format: non-digit value ''a'' encountered'

EXPLAIN SELECT INTERVAL 'a12'   YEAR FROM nation;
failure contains: 'Invalid interval format: non-digit value ''a'' encountered'

EXPLAIN SELECT INTERVAL '12a'   YEAR FROM nation;
failure contains: 'Invalid interval format: non-digit value ''a'' encountered'

EXPLAIN SELECT INTERVAL '0x1'   YEAR FROM nation;
failure contains: 'Invalid interval format: non-digit value ''x'' encountered'


