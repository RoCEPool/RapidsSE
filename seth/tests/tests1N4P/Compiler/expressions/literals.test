-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')


-- Decimal with mantissa > 100000000000000000
EXPLAIN with_types SELECT 100000000000000000. FROM ${testName2}_nation;
failure contains: 'Value exceeds maximum decimal precision digits'


-- Decimal with mantissa == -36,028,797,018,963,967   (-2^47)
EXPLAIN with_types SELECT -36028797018963967. FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT -36028797018963967. FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = -36028797018963967. ; Ordinal Expr = -36028797018963967.) ; type: DECIMAL

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')


-- Decimal with mantissa < -100000000000000000
EXPLAIN with_types SELECT -100000000000000000. FROM ${testName2}_nation;
failure contains: 'Value exceeds maximum decimal precision digits'


-- Decimal cast to a float is above max float value (1e37)
-- TODO: Currently we cannot test for this because the maximum decimal literal
--       that we can input is limited to a mantissa of 99999999999999999
EXPLAIN with_types SELECT  10000000000000000000000000000000000000. + 1e0 FROM ${testName2}_nation;
failure contains: 'Value exceeds maximum decimal precision digits'


-- Decimal cast to a float is less than min float value (1e37)
-- TODO: Currently we cannot test for this because the minimum decimal literal
--       that we can input is limited to a mantissa of -99999999999999999
EXPLAIN with_types SELECT -10000000000000000000000000000000000000. - 1e0 FROM ${testName2}_nation;
failure contains: 'Value exceeds maximum decimal precision digits'


