/*----------------------------------------------------------------------------*/
/* Expression literals tests                                                  */
/*                                                                            */
/* Various miscellaneous literal tests                                        */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

// Loads empty table with the following columns
//	 N_NATIONKEY       INTEGER NOT NULL,
//	 N_NAME            CHAR(25) NOT NULL,
//	 N_REGIONKEY       INTEGER NOT NULL,
//	 N_COMMENT         VARCHAR(152)

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Decimals
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN with_types SELECT 1. FROM nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT 1. FROM nation"

-> -> projectOp
      » column: (Expr = 1. ; Ordinal Expr = 1.) ; type: DECIMAL

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)')


