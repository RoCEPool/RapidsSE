// Invalid interval literals
// -------------------------------------------------------

EXPLAIN SELECT INTERVAL ''   YEAR FROM ${testName2}_nation;
failure contains: 'Invalid interval format: interval string is empty'

EXPLAIN SELECT INTERVAL 'aaa'   YEAR FROM ${testName2}_nation;
failure contains: 'Invalid interval format: non-digit value ''a'' encountered'

EXPLAIN SELECT INTERVAL '1a2'   YEAR FROM ${testName2}_nation;
failure contains: 'Invalid interval format: unexpected character ''a'' encountered'

EXPLAIN SELECT INTERVAL 'a12'   YEAR FROM ${testName2}_nation;
failure contains: 'Invalid interval format: non-digit value ''a'' encountered'

EXPLAIN SELECT INTERVAL '12a'   YEAR FROM ${testName2}_nation;
failure contains: 'Invalid interval format: unexpected character ''a'' encountered'

EXPLAIN SELECT INTERVAL '0x1'   YEAR FROM ${testName2}_nation;
failure contains: 'Invalid interval format: unexpected character ''x'' encountered'


