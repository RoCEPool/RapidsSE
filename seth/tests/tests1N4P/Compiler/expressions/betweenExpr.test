-- Test for an ambiguous AND operator (1)
-- Note: The syntax makes this ambiguous in the parser. We need to take
-- specific steps to ensure that the AND that immediately follows the BETWEEN
-- token is not interpreted as a separate logical AND expression.
EXPLAIN SELECT n_name FROM nation WHERE n_nationkey BETWEEN 1 AND 2 AND true;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation WHERE n_nationkey BETWEEN 1 AND 2 AND true"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: ((rapidsse.public.nation.n_nationkey BETWEEN 1 AND 2) AND true)
         » ordinal expr: (($1 BETWEEN 1 AND 2) AND true)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)')


-- Test for an ambiguous AND operator (2)
EXPLAIN SELECT n_name FROM nation WHERE true AND n_nationkey BETWEEN 1 AND 2 AND true;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation WHERE true AND n_nationkey BETWEEN 1 AND 2 AND true"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: ((true AND (rapidsse.public.nation.n_nationkey BETWEEN 1 AND 2)) AND true)
         » ordinal expr: ((true AND ($1 BETWEEN 1 AND 2)) AND true)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)')


