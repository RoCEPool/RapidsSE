/*----------------------------------------------------------------------------*/
/* General syntax & semantics tests for BETWEEN expressions                   */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

CREATE TABLE region (
	 R_REGIONKEY       INTEGER NOT NULL,
	 R_NAME            CHAR(25) NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success


trackmemory;
success


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  BETWEEN expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Test explain of a simple BETWEEN expr in WHERE clause
EXPLAIN SELECT n_name FROM nation WHERE n_nationkey BETWEEN 1 AND 2;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation WHERE n_nationkey BETWEEN 1 AND 2"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (rapidsse.public.nation.n_nationkey BETWEEN 1 AND 2)
         » ordinal expr: ($1 BETWEEN 1 AND 2)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)')


