-- Test explain of a BETWEEN expr with invalid types (1)
EXPLAIN SELECT n_name FROM nation WHERE 1 BETWEEN 0 AND true;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'


-- Test explain of a BETWEEN expr with invalid types (2)
EXPLAIN SELECT n_name FROM nation WHERE 'abc' BETWEEN DATE '2021-11-03' AND 1.23e0;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'


