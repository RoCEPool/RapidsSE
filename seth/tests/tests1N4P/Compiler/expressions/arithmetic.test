// YM interval arithmetic /1 (same type)
EXPLAIN WITH_TYPES SELECT INTERVAL '1' YEAR + INTERVAL '2' YEAR FROM nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT INTERVAL ''1'' YEAR + INTERVAL ''2'' YEAR FROM nation"

-> -> projectOp
      » column: (Expr = INTERVAL ''1'' YEAR + INTERVAL ''2'' YEAR ; Ordinal Expr = INTERVAL ''1'' YEAR + INTERVAL ''2'' YEAR) ; type: INTERVAL YEAR

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)')

