/*----------------------------------------------------------------------------*/
/* Implicit coercion syntax & semantics tests                                 */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table ${testName2}_nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

CREATE TABLE ${testName2}_coercionTest (
  COL1 INTEGER    NOT NULL,
  COL2 VARCHAR    NOT NULL,
  COL3 DATE       NOT NULL,
  COL4 TIME       NOT NULL,
  COL5 TIMESTAMP  NOT NULL,
//COL6 INTERVAL YEAR TO MONTH NOT NULL,
//COL7 INTERVAL DAY TO TIME NOT NULL,
  COL8 FLOAT      NOT NULL,
  COL9 DECIMAL    NOT NULL,
  COL10 BOOLEAN   NOT NULL,
  COL11 TIMESTAMP // all nulls
);
success

trackmemory force;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Test out some basic implicit coercions in the projection list
//  (this happens before other expressions are validated)
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// integer + string int
EXPLAIN SELECT  1  + '2' FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT  1  + ''2'' FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = 1 + 2 ; Ordinal Expr = 1 + 2)

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')

// string int + integer
EXPLAIN SELECT '2' +  1  FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT ''2'' +  1  FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = 2 + 1 ; Ordinal Expr = 2 + 1)

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')

// string int + string int
EXPLAIN SELECT '1' + '2' FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT ''1'' + ''2'' FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = 1 + 2 ; Ordinal Expr = 1 + 2)

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')
         
// string date < date
EXPLAIN SELECT '2000-01-01' < DATE '2021-11-29' FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT ''2000-01-01'' < DATE ''2021-11-29'' FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = DATE ''2000-01-01'' < DATE ''2021-11-29'' ; Ordinal Expr = DATE ''2000-01-01'' < DATE ''2021-11-29'')

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')


// date column < timestamp literal
EXPLAIN SELECT col3 < TIMESTAMP '2000-01-01 01:02:03.04' FROM ${testName2}_coercionTest;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT col3 < TIMESTAMP ''2000-01-01 01:02:03.04'' FROM ${testName2}_coercionTest"

-> -> projectOp
      » column: (Expr = (CAST(rapidsse.public.${testName2}_coercionTest.col3 AS TIMESTAMP)) < TIMESTAMP ''2000-01-01 01:02:03.040000'' ; Ordinal Expr = (CAST($3 AS TIMESTAMP)) < TIMESTAMP ''2000-01-01 01:02:03.040000'')

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_coercionTest)')


// Nested expressions requiring coercion
EXPLAIN SELECT
  (col1 + '1' < col8) AND (SUBSTRING(col10 FROM 1 FOR 1) = 'T')
FROM ${testName2}_coercionTest;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT   (col1 + ''1'' < col8) AND (SUBSTRING(col10 FROM 1 FOR 1) = ''T'') FROM ${testName2}_coercionTest"

-> -> projectOp
      » column: (Expr = ((CAST(rapidsse.public.${testName2}_coercionTest.col1 + 1 AS FLOAT)) < rapidsse.public.${testName2}_coercionTest.col8) AND ((SUBSTRING((CAST(rapidsse.public.${testName2}_coercionTest.col10 AS VARCHAR)), 1, 1)) = ''T'') ; Ordinal Expr = ((CAST($1 + 1 AS FLOAT)) < $6) AND ((SUBSTRING((CAST($8 AS VARCHAR)), 1, 1)) = ''T''))

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_coercionTest)')

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Test that implicit coercion works in other operators.
//  (this gets invoked in exprValidate)
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// FilterOp


EXPLAIN SELECT n_nationkey FROM ${testName2}_nation WHERE '1' + n_nationkey < 5;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey FROM ${testName2}_nation WHERE ''1'' + n_nationkey < 5"

-> -> projectOp
      » column: (Expr = rapidsse.public.${testName2}_nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> filterOp
         » expr: ((1 + rapidsse.public.${testName2}_nation.n_nationkey) < 5)
         » ordinal expr: ((1 + $1) < 5)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName2}_nation)')


// coerce string date literal to timestamp
EXPLAIN SELECT col1 FROM ${testName2}_coercionTest WHERE '2000-01-01' < col5;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT col1 FROM ${testName2}_coercionTest WHERE ''2000-01-01'' < col5"

-> -> projectOp
      » column: (Expr = rapidsse.public.${testName2}_coercionTest.col1 ; Ordinal Expr = $1)

-> -> -> filterOp
         » expr: (TIMESTAMP ''2000-01-01 00:00:00'' < rapidsse.public.${testName2}_coercionTest.col5)
         » ordinal expr: (TIMESTAMP ''2000-01-01 00:00:00'' < $5)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName2}_coercionTest)')



// Having clause
// Convert string float value to float literal
EXPLAIN SELECT col1, SUM(col8) FROM ${testName2}_coercionTest GROUP BY col1 HAVING SUM(col8) > '10.0e0';
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT col1, SUM(col8) FROM ${testName2}_coercionTest GROUP BY col1 HAVING SUM(col8) > ''10.0e0''"

-> -> filterOp
      » expr: ((SUM(rapidsse.public.${testName2}_coercionTest.col8)) > 1.0000000000e+01)
      » ordinal expr: ($2 > 1.0000000000e+01)

-> -> -> aggregateOp
         » column: (Expr = rapidsse.public.${testName2}_coercionTest.col1 ; Ordinal Expr = $1)
         » column: (Expr = SUM(rapidsse.public.${testName2}_coercionTest.col8) ; Ordinal Expr = SUM($6))
         » group by: (Expr = rapidsse.public.${testName2}_coercionTest.col1 ; Ordinal Expr = $1)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName2}_coercionTest)')

// cast decimal columnRef to float in having clause
EXPLAIN SELECT col1, col9, SUM(col8) FROM ${testName2}_coercionTest GROUP BY col1, col9 HAVING SUM(col8) > col9;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT col1, col9, SUM(col8) FROM ${testName2}_coercionTest GROUP BY col1, col9 HAVING SUM(col8) > col9"

-> -> filterOp
      » expr: ((SUM(rapidsse.public.${testName2}_coercionTest.col8)) > (CAST(rapidsse.public.${testName2}_coercionTest.col9 AS FLOAT)))
      » ordinal expr: ($3 > (CAST($2 AS FLOAT)))

-> -> -> aggregateOp
         » column: (Expr = rapidsse.public.${testName2}_coercionTest.col1 ; Ordinal Expr = $1)
         » column: (Expr = rapidsse.public.${testName2}_coercionTest.col9 ; Ordinal Expr = $7)
         » column: (Expr = SUM(rapidsse.public.${testName2}_coercionTest.col8) ; Ordinal Expr = SUM($6))
         » group by: (Expr = rapidsse.public.${testName2}_coercionTest.col1 ; Ordinal Expr = $1)
         » group by: (Expr = rapidsse.public.${testName2}_coercionTest.col9 ; Ordinal Expr = $7)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName2}_coercionTest)')


// join predicate
EXPLAIN SELECT n_nationkey
FROM ${testName2}_nation JOIN ${testName2}_coercionTest ON n_nationkey = col8 + 1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey FROM ${testName2}_nation JOIN ${testName2}_coercionTest ON n_nationkey = col8 + 1"

-> -> projectOp
      » column: (Expr = rapidsse.public.${testName2}_nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> abstractJoinOp
         » join type: Inner Join
         » predicate: ((CAST(rapidsse.public.${testName2}_nation.n_nationkey AS FLOAT)) = (rapidsse.public.${testName2}_coercionTest.col8 + 1.0000000000e+00))
         » ordinal predicate: ((CAST($1 AS FLOAT)) = ($10 + 1.0000000000e+00))

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName2}_nation)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName2}_coercionTest)')


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Test out all the supported implicit coercions supported
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Currently supported implicit coercions:
//   current type       -> current type
//   integer            -> decimal
//   integer            -> float
//   decimal            -> float
//   string (integer)   -> integer     (from a literal only)
//   string (integer)   -> decimal     (from a literal only)
//   string (decimal)   -> decimal     (from a literal only)
//   string (integer)   -> float       (from a literal only)
//   string (decimal)   -> float       (from a literal only)
//   string (float)     -> float       (from a literal only)
//   string             -> date        (from a literal only)
//   string             -> time        (from a literal only)
//   string (date)      -> timestamp   (from a literal only)
//   string (timestamp) -> timestamp   (from a literal only)
//   date               -> timestamp
//   boolean            -> string

//   Test integer -> decimal
EXPLAIN SELECT (col1 * 1) + col9 FROM ${testName2}_coercionTest;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT (col1 * 1) + col9 FROM ${testName2}_coercionTest"

-> -> projectOp
      » column: (Expr = (CAST(rapidsse.public.${testName2}_coercionTest.col1 * 1 AS DECIMAL)) + rapidsse.public.${testName2}_coercionTest.col9 ; Ordinal Expr = (CAST($1 * 1 AS DECIMAL)) + $7)

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_coercionTest)')

//   Test integer literal -> decimal
EXPLAIN SELECT (2 * 1) + col9 FROM ${testName2}_coercionTest;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT (2 * 1) + col9 FROM ${testName2}_coercionTest"

-> -> projectOp
      » column: (Expr = (CAST(2 * 1 AS DECIMAL)) + rapidsse.public.${testName2}_coercionTest.col9 ; Ordinal Expr = (CAST(2 * 1 AS DECIMAL)) + $7)

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_coercionTest)')


