// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Test out all the supported implicit coercions supported
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Currently supported implicit coercions:
//   current type -> current type
//   integer -> decimal
//   integer -> float
//   decimal -> float
//   string  -> integer     (from a literal only)
//   string  -> decimal     (from a literal only)
//   string  -> float       (from a literal only)
//   string  -> date        (from a literal only)
//   string  -> time        (from a literal only)
//   string  -> timestamp   (from a literal only)
//   date    -> timestamp
//   boolean -> string


// Test that unsupported coercions are still errros


