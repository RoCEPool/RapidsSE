// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Test that unsupported coercions are still errors
// (not an extensive test of all combinations)
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// integer -> string
EXPLAIN SELECT SUBSTRING(col1, 1, 1) FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// integer literal -> string
EXPLAIN SELECT SUBSTRING(123, 1, 1) FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// integer -> date
EXPLAIN SELECT col1 = col3 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// integer literal -> date
EXPLAIN SELECT 1 = col3 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// integer -> boolean
EXPLAIN SELECT col1 = col10 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// integer literal -> boolean
EXPLAIN SELECT 1 = col10 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// float -> string
EXPLAIN SELECT col8 = col2 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// float literal -> string
EXPLAIN SELECT 1.0e1 = col2 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// float -> timestamp
EXPLAIN SELECT col8 = col5 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// float literal -> timestamp
EXPLAIN SELECT 1.0e1 = col5 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// boolean -> time
EXPLAIN SELECT col10 = col4 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// boolean literal -> time
EXPLAIN SELECT true = col4 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Test invalid literal conversions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// parsing integers
EXPLAIN SELECT '1a' + 1 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '1 ' + 1 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

// Hex numbers not yet supported
EXPLAIN SELECT '0x01' + 1 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT 'x1' + 1 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'


// parsing floats
EXPLAIN SELECT '1.0ee1' + 1 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '1.0a1' + 1 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '1.0e1a' + 1 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '1.0e1 ' + 1 FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'


// TODO: parsing decimals


// parsing dates
EXPLAIN SELECT '2000:01:01' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000:1:1' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000:01:' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-1-1' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-1-' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-01' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-13-01' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-02-30' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-04-31' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '01-01-2000' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '01/01/2000' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000/01/01' = DATE '2000-01-01' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'


// parsing times
EXPLAIN SELECT '12-13-14' = TIME '12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '12:13:14.15' = TIME '12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '12 13 14' = TIME '12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '24:00:00' = TIME '12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '-1:00:00' = TIME '12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'


// parsing timestamps
EXPLAIN SELECT '2000-01-01-12:13:14' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-13-01 12:13:14' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-02-30 12:13:14' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-00-01 12:13:14' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-01-00 12:13:14' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-01-01T12:13:14' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-01-01a12:13:14' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-01-01 12:13:14a' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'

EXPLAIN SELECT '2000-01-01  12:13:14' = TIMESTAMP '2000-01-01 12:13:14' FROM coercionTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator'



// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Test out any additional nested coercions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// The inner nested case should be coerced to return integers.
// The outer nested case should then do the same.
EXPLAIN with_types SELECT
  CASE
    WHEN col1 = 1 THEN '1'
    WHEN col1 = 2 THEN
      CASE
        WHEN col10 = true THEN col1
        ELSE '0'
      END
    ELSE '3'
  END
FROM coercionTest;

rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT   CASE     WHEN col1 = 1 THEN ''1''     WHEN col1 = 2 THEN       CASE         WHEN col10 = true THEN col1         ELSE ''0''       END     ELSE ''3''   END FROM coercionTest"

-> -> projectOp
      » column: (Expr = CASE WHEN (rapidsse.public.coercionTest.col1 = 1) THEN 1 WHEN (rapidsse.public.coercionTest.col1 = 2) THEN (CASE WHEN (rapidsse.public.coercionTest.col10 = true) THEN rapidsse.public.coercionTest.col1 ELSE 0 END) ELSE 3 END ; Ordinal Expr = CASE WHEN ($1 = 1) THEN 1 WHEN ($1 = 2) THEN (CASE WHEN ($8 = true) THEN $1 ELSE 0 END) ELSE 3 END) ; type: INTEGER

-> -> -> tableScanOp
         » table: (rapidsse.public.coercionTest)' )




// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Test out expression operators that have multiple children that aren't of the same type.
//   e.g. SUBSTRING(), CASE(), etc.
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Col10 should be coerced from boolean to string,
// second column should be coerced to an integer.
EXPLAIN with_types SELECT
  SUBSTRING(col10, '1' + '2' + '3')
FROM coercionTest;

rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT   SUBSTRING(col10, ''1'' + ''2'' + ''3'') FROM coercionTest"

-> -> projectOp
      » column: (Expr = SUBSTRING((CAST(rapidsse.public.coercionTest.col10 AS VARCHAR)), ((1 + 2) + 3)) ; Ordinal Expr = SUBSTRING((CAST($8 AS VARCHAR)), ((1 + 2) + 3))) ; type: VARCHAR

-> -> -> tableScanOp
         » table: (rapidsse.public.coercionTest)')



