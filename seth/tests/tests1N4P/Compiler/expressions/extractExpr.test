-> -> -> tableScanOp
         » table: (rapids.public.${testName2}_extractTest)')

// Extract from a subquery
EXPLAIN SELECT EXTRACT (YEAR FROM (SELECT col3 FROM ${testName2}_extractTest WHERE col1 = 0 LIMIT 1)) FROM ${testName2}_extractTest;
rows: (*,'explainPlan','
∆ exprSubquery
  » table alias: __subquery0003
  » correlated columns: (none)

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT col3 FROM ${testName2}_extractTest WHERE col1 = 0 LIMIT 1"

-> -> -> limitOp
         » limit: (1)

-> -> -> -> projectOp
            » column: (Expr = rapids.public.${testName2}_extractTest.col3 ; Ordinal Expr = $3)

-> -> -> -> -> filterOp
               » expr: (rapids.public.${testName2}_extractTest.col1 = 0)
               » ordinal expr: ($1 = 0)

-> -> -> -> -> -> tableScanOp
                  » table: (rapids.public.${testName2}_extractTest)

∆ mainSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT EXTRACT (YEAR FROM (SELECT col3 FROM ${testName2}_extractTest WHERE col1 = 0 LIMIT 1)) FROM ${testName2}_extractTest"

-> -> projectOp
      » column: (Expr = EXTRACT (YEAR FROM __subquery0003()) ; Ordinal Expr = EXTRACT (YEAR FROM __subquery0003()))

-> -> -> tableScanOp
         » table: (rapids.public.${testName2}_extractTest)')

