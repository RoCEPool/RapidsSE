// Cannot extract year from a time
EXPLAIN SELECT EXTRACT (YEAR FROM COL4) FROM ${testName2}_extractTest;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: (EXTRACT (YEAR FROM TIME)) in expression (EXTRACT (YEAR FROM rapids.public.${testName2}_extractTest.COL4))'

// Cannot extract year from an interval_dt
EXPLAIN SELECT EXTRACT (YEAR FROM INTERVAL '1 2' DAY TO HOUR) FROM ${testName2}_extractTest;
failure contains: 'Expression type combination is invalid or unsupported'

