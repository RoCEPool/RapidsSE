            » column: (Expr = rapidsse.public.extractTest.col3 ; Ordinal Expr = $3)

-> -> -> -> -> filterOp
               » expr: (rapidsse.public.extractTest.col1 = 0)
               » ordinal expr: ($1 = 0)

-> -> -> -> -> -> tableScanOp
                  » table: (rapidsse.public.extractTest)

∆ mainSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT EXTRACT (YEAR FROM (SELECT col3 FROM extractTest WHERE col1 = 0 LIMIT 1)) FROM extractTest"

