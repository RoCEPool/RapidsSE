/*----------------------------------------------------------------------------*/
/* General syntax & semantics tests for EXTRACT expressions                   */
/*----------------------------------------------------------------------------*/


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

CREATE TABLE region (
	 R_REGIONKEY       INTEGER NOT NULL,
	 R_NAME            CHAR(25) NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

CREATE TABLE extractTest (
  COL1 INTEGER    NOT NULL,
  COL2 VARCHAR    NOT NULL,
  COL3 DATE       NOT NULL,
  COL4 TIME       NOT NULL,
  COL5 TIMESTAMP  NOT NULL,
//COL6 INTERVAL YEAR TO MONTH NOT NULL,
//COL7 INTERVAL DAY TO TIME NOT NULL,
  COL8 FLOAT      NOT NULL,
  COL9 DECIMAL    NOT NULL,
  COL10 BOOLEAN   NOT NULL,
  COL11 TIMESTAMP // all nulls
);
success

trackmemory;
success


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  EXTRACT expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Extract YEAR
EXPLAIN SELECT COL2 FROM extractTest WHERE EXTRACT (YEAR FROM COL3) = 2021;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT COL2 FROM extractTest WHERE EXTRACT (YEAR FROM COL3) = 2021"

-> -> projectOp
      » column: (Expr = rapidsse.public.extractTest.COL2 ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: ((EXTRACT (YEAR FROM rapidsse.public.extractTest.COL3)) = 2021)
         » ordinal expr: ((EXTRACT (YEAR FROM $3)) = 2021)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.extractTest)')

