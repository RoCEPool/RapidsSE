-- SUBSTRING
EXPLAIN STAGE aggregatesplit SELECT SUBSTR(MAX(n_name), 0, 1) FROM nation;
rows: (*,'aggregateSplit','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> projectOp
      » column: (Expr = SUBSTRING((MAX(MAX(MAX(rapidsse.public.nation.n_name)))), 0, 1) ; Ordinal Expr = SUBSTRING($1, 0, 1))

-> -> -> stageMarker
