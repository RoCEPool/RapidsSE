-- cast of one aggregate in a compound aggregate expression is split
EXPLAIN STAGE aggregateSplit SELECT CAST(SUM(col1) AS DECIMAL) * 1.0 + MAX(col2) FROM t1;
rows: (*,'aggregateSplit','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> projectOp
      » column: (Expr = ((CAST(SUM(SUM(SUM(rapidsse.public.t1.col1))) AS DECIMAL)) * 1.0) + (MAX(MAX(MAX(rapidsse.public.t1.col2)))) ; Ordinal Expr = ((CAST($2 AS DECIMAL)) * 1.0) + $1)

-> -> -> stageMarker
         » location: origin
         » routing: unicast

-> -> -> -> projectOp
            » location: origin
            » column: (Expr = MAX(MAX(MAX(rapidsse.public.t1.col2))) ; Ordinal Expr = MAX($1))
            » column: (Expr = SUM(SUM(SUM(rapidsse.public.t1.col1))) ; Ordinal Expr = SUM($2))

-> -> -> -> -> stageMarker
               » location: all nodes
               » routing: unicast

-> -> -> -> -> -> projectOp
                  » location: all nodes
                  » column: (Expr = MAX(MAX(rapidsse.public.t1.col2)) ; Ordinal Expr = MAX($1))
                  » column: (Expr = SUM(SUM(rapidsse.public.t1.col1)) ; Ordinal Expr = SUM($2))

-> -> -> -> -> -> -> stageMarker
                     » location: all partitions
                     » routing: local node

-> -> -> -> -> -> -> -> projectOp
                        » column: (Expr = MAX(rapidsse.public.t1.col2) ; Ordinal Expr = MAX($2))
                        » column: (Expr = SUM(rapidsse.public.t1.col1) ; Ordinal Expr = SUM($1))

-> -> -> -> -> -> -> -> -> tableScanOp
                           » location: all partitions
                           » table: (rapidsse.public.t1)')


