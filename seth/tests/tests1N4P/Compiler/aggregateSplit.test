-- Grouped aggregations are split with AggregateOps
EXPLAIN STAGE aggregateSplit SELECT SUM(n_nationkey) + COUNT(n_nationkey) FROM nation GROUP BY n_regionkey;
rows:
(*, 'aggregateSplit','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> projectOp
      » column: (Expr = (SUM(SUM(SUM(rapidsse.public.nation.n_nationkey)))) + (SUM(SUM(COUNT(rapidsse.public.nation.n_nationkey)))) ; Ordinal Expr = $1)

-> -> -> stageMarker
         » location: origin
         » routing: unicast

-> -> -> -> projectOp
            » column: (Expr = (SUM(SUM(SUM(rapidsse.public.nation.n_nationkey)))) + (SUM(SUM(COUNT(rapidsse.public.nation.n_nationkey)))) ; Ordinal Expr = $3 + $2)
            » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $1)

-> -> -> -> -> stageMarker
               » location: origin
               » routing: unicast

-> -> -> -> -> -> aggregateOp
                  » location: origin
                  » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
                  » column: (Expr = SUM(SUM(COUNT(rapidsse.public.nation.n_nationkey))) ; Ordinal Expr = SUM($1))
                  » column: (Expr = SUM(SUM(SUM(rapidsse.public.nation.n_nationkey))) ; Ordinal Expr = SUM($2))
                  » group by: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)

-> -> -> -> -> -> -> stageMarker
                     » location: all nodes
                     » routing: unicast

-> -> -> -> -> -> -> -> aggregateOp
                        » location: all nodes
                        » column: (Expr = SUM(COUNT(rapidsse.public.nation.n_nationkey)) ; Ordinal Expr = SUM($1))
                        » column: (Expr = SUM(SUM(rapidsse.public.nation.n_nationkey)) ; Ordinal Expr = SUM($2))
                        » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
                        » group by: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)

-> -> -> -> -> -> -> -> -> stageMarker
                           » location: all partitions
                           » routing: local node

-> -> -> -> -> -> -> -> -> -> aggregateOp
                              » column: (Expr = COUNT(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = COUNT($1))
                              » column: (Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))
                              » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
                              » group by: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)

-> -> -> -> -> -> -> -> -> -> -> tableScanOp
                                 » location: all partitions
                                 » table: (rapidsse.public.nation)'
)


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  An aggregate underneath any parent expression needs to be split.
//  e.g. an aggregate under a +, LIKE, SUBSTRING, etc.
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- cast of an aggregate is split /1
