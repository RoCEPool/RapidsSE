/*----------------------------------------------------------------------------*/
/* Aggregate Splitting semantic tests                                         */
/*----------------------------------------------------------------------------*/

// This tests that ordinal expressions that contain one or more aggregates under
// an expression parent are separated such that they have separate ProjectOp added
// underneath that calculates each aggregate separately.
// e.g. SUM($1)/COUNT($2), SUM($1) + SUM($2)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

create table t1 (
	 col1       INTEGER NOT NULL,
	 col2       DECIMAL NOT NULL,
	 col3       FLOAT NOT NULL,
	 col4       VARCHAR(152)
);
success

trackmemory force;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Basic tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- No change to non-aggregate expressions
EXPLAIN STAGE aggregateSplit SELECT n_nationkey FROM nation;
rows:
(*,'aggregateSplit','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: all partitions
   » routing: unicast

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> tableScanOp
         » location: all partitions
         » table: (rapidsse.public.nation)')


-- No change to simple aggregates
EXPLAIN STAGE aggregateSplit SELECT SUM(n_nationkey) FROM nation;
rows:
( *, 'aggregateSplit','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> projectOp
      » location: origin
      » column: (Expr = SUM(SUM(SUM(rapidsse.public.nation.n_nationkey))) ; Ordinal Expr = SUM($1))

-> -> -> stageMarker
         » location: all nodes
         » routing: unicast

-> -> -> -> projectOp
            » location: all nodes
            » column: (Expr = SUM(SUM(rapidsse.public.nation.n_nationkey)) ; Ordinal Expr = SUM($1))

-> -> -> -> -> stageMarker
               » location: all partitions
               » routing: local node

-> -> -> -> -> -> projectOp
                  » column: (Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))

-> -> -> -> -> -> -> tableScanOp
                     » location: all partitions
                     » table: (rapidsse.public.nation)'
)

-- AVG() is split into a SUM and a COUNT
EXPLAIN STAGE aggregateSplit SELECT AVG(n_nationkey) FROM nation;
rows:
(*,'aggregateSplit','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> projectOp
      » column: (Expr = (CAST(SUM(SUM(SUM(rapidsse.public.nation.n_nationkey))) AS DECIMAL)) / (CAST(SUM(SUM(COUNT(rapidsse.public.nation.n_nationkey))) AS DECIMAL)) ; Ordinal Expr = (CAST($2 AS DECIMAL)) / (CAST($1 AS DECIMAL)))

-> -> -> stageMarker
         » location: origin
         » routing: unicast

-> -> -> -> projectOp
            » location: origin
            » column: (Expr = SUM(SUM(COUNT(rapidsse.public.nation.n_nationkey))) ; Ordinal Expr = SUM($2))
            » column: (Expr = SUM(SUM(SUM(rapidsse.public.nation.n_nationkey))) ; Ordinal Expr = SUM($1))

-> -> -> -> -> stageMarker
               » location: all nodes
               » routing: unicast

-> -> -> -> -> -> projectOp
                  » location: all nodes
                  » column: (Expr = SUM(SUM(rapidsse.public.nation.n_nationkey)) ; Ordinal Expr = SUM($1))
                  » column: (Expr = SUM(COUNT(rapidsse.public.nation.n_nationkey)) ; Ordinal Expr = SUM($2))

-> -> -> -> -> -> -> stageMarker
                     » location: all partitions
                     » routing: local node

-> -> -> -> -> -> -> -> projectOp
                        » column: (Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))
                        » column: (Expr = COUNT(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = COUNT($1))

-> -> -> -> -> -> -> -> -> tableScanOp
                           » location: all partitions
                           » table: (rapidsse.public.nation)'
)


