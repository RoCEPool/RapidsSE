/*----------------------------------------------------------------------------*/
/* UNION syntax & semantic tests                                              */
/*                                                                            */
/* We use EXPLAIN before the queries to avoid actually running these through  */
/* the execution engine.                                                      */
/*----------------------------------------------------------------------------*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE ${testName2}_unionTbl1 (col1 INTEGER, col2 VARCHAR, col3 DATE, col4 BOOLEAN);
success

-- same signature as tbl1
CREATE TABLE ${testName2}_unionTbl2 (col1 INTEGER, col2 VARCHAR, col3 DATE, col4 BOOLEAN);
success

-- same column names as tbl1 but different column types
CREATE TABLE ${testName2}_unionTbl3 (col1 VARCHAR, col2 BOOLEAN, col3 DATE, col4 INTEGER);
success

-- different number of columns as tbl3 and different names
CREATE TABLE ${testName2}_unionTbl4 (alpha VARCHAR, bravo BOOLEAN, charlie DATE);
success

-- same signature as tbl4 but different column name case
CREATE TABLE ${testName2}_unionTbl5 (ALPHA VARCHAR, bRaVo BOOLEAN, CHARlie DATE);
success

-- Mixed column names and types to partially match tbl1 and tbl4
CREATE TABLE ${testName2}_unionTbl6 (bRaVo BOOLEAN, col3 DATE, col1 INTEGER);

-- memory leak testing not enabled due to memory leaks in the transliteration / back end
-- trackmemory force;
-- success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic union all statements
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT col1 FROM ${testName2}_uniontbl1 UNION ALL SELECT col1 FROM ${testName2}_uniontbl2;
success

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION ALL SELECT * FROM ${testName2}_unionTbl2;
success

EXPLAIN SELECT col2, col4, col3 FROM ${testName2}_UNIONTBL1 UNION ALL SELECT col2, col4, col3 FROM ${testName2}_unionTbl2;
success

EXPLAIN SELECT col1, col2 from ${testName2}_uniontbl1 union all select col4, col1 FROM ${testName2}_unionTbl3;
success


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Union distinct not yet implemented
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION DISTINCT SELECT * FROM ${testName2}_unionTbl2;
failure contains: 'Feature not yet implemented: UNION DISTINCT'

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION SELECT * FROM ${testName2}_unionTbl2;
failure contains: 'Feature not yet implemented: UNION DISTINCT'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Union all number of columns not matching
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT * FROM ${testName2}_unionTbl3 UNION ALL SELECT * FROM ${testName2}_unionTbl4;
failure contains: 'The number of columns of each subquery do not match: 4 vs 3, UNION operator'

EXPLAIN select col1, col2 from ${testName2}_unionTbl1 union all select col1 from ${testName2}_unionTbl2;
failure contains: 'The number of columns of each subquery do not match: 2 vs 1, UNION operator'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Union all types not matching
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION ALL SELECT * FROM ${testName2}_unionTbl3;
failure contains: 'Column types do not match: INTEGER vs VARCHAR, column ordinal 1, UNION operator'

EXPLAIN SELECT col1, col2 FROM ${testName2}_unionTbl1 UNION ALL SELECT col1, col2 FROM ${testName2}_unionTbl3;
failure contains: 'Column types do not match: INTEGER vs VARCHAR, column ordinal 1, UNION operator'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Non-empty CORRESPONDING BY clause with valid columns
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION ALL CORRESPONDING BY (col1, col3) SELECT * FROM ${testName2}_unionTbl2;
success

-- case insensitive tests
EXPLAIN SELECT * FROM ${testName2}_unionTbl4 UNION ALL CORRESPONDING BY (alpha, bravo) SELECT * FROM ${testName2}_unionTbl5;
success

EXPLAIN SELECT * FROM ${testName2}_unionTbl4 UNION ALL CORRESPONDING BY (BRAVO, CHARLIE) SELECT * FROM ${testName2}_unionTbl5;
success


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Non-empty CORRESPONDING BY clause with invalid columns
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION ALL CORRESPONDING BY (col1, badColumn) SELECT * FROM ${testName2}_unionTbl2;
failure contains: 'Column in CORRESPONDING BY list is not found in select list: badColumn'

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION ALL CORRESPONDING BY (badColumn, col1) SELECT * FROM ${testName2}_unionTbl2;
failure contains: 'Column in CORRESPONDING BY list is not found in select list: badColumn'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Empty CORRESPONDING BY clause with matching column types
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

SELECT * FROM ${testName2}_unionTbl1 UNION ALL CORRESPONDING SELECT * FROM ${testName2}_unionTbl2;
rows:
  ['col1', 'col2', 'col3', 'col4']

SELECT * FROM ${testName2}_unionTbl4 UNION ALL CORRESPONDING SELECT * FROM ${testName2}_unionTbl5;
rows:
  ['alpha', 'bravo', 'charlie']

SELECT * FROM ${testName2}_unionTbl6 UNION ALL CORRESPONDING SELECT * FROM ${testName2}_unionTbl1;
rows:
  ['col3', 'col1']

SELECT * FROM ${testName2}_unionTbl6 UNION ALL CORRESPONDING SELECT * FROM ${testName2}_unionTbl4;
rows:
  ['bRaVo']


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Empty CORRESPONDING BY clause with non-matching column types
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION ALL CORRESPONDING SELECT * FROM ${testName2}_unionTbl3;
failure contains: 'Column in CORRESPONDING BY list has mismatched types in child queries: col1'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Empty CORRESPONDING BY clause with no common column names
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT * FROM ${testName2}_unionTbl1 UNION ALL CORRESPONDING SELECT * FROM ${testName2}_unionTbl4;
failure contains: 'No common column names of the subqueries could be found for the CORRESPONDING list'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Multiple nested UNIONS
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN
  SELECT * FROM ${testName2}_unionTbl1
UNION ALL
  SELECT * FROM ${testName2}_unionTbl2
UNION ALL
  SELECT * FROM ${testName2}_unionTbl1
;
success


EXPLAIN
  SELECT col4 FROM ${testName2}_unionTbl1
UNION ALL (
  SELECT * FROM ${testName2}_unionTbl4
UNION ALL CORRESPONDING
  SELECT * FROM ${testName2}_unionTbl6 )
;
success


EXPLAIN
  SELECT * FROM ${testName2}_unionTbl4
UNION ALL CORRESPONDING
  SELECT * FROM ${testName2}_unionTbl6
UNION ALL
  SELECT col4 FROM ${testName2}_unionTbl1
;
success


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- memoryleaks;
-- rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE ${testName2}_unionTbl1;
  mute

  DROP TABLE ${testName2}_unionTbl2;
  mute

  DROP TABLE ${testName2}_unionTbl3;
  mute

  DROP TABLE ${testName2}_unionTbl4;
  mute

  DROP TABLE ${testName2}_unionTbl5;
  mute

  DROP TABLE ${testName2}_unionTbl6;
  mute
}