/*----------------------------------------------------------------------------*/
/* Table aliases tests                                                        */
/*----------------------------------------------------------------------------*/

-- TODO: Insert description here


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic table alias tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT * FROM nation n;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT * FROM nation n"

-> -> projectOp
      » column: (Alias = N_NATIONKEY ; Expr = n.N_NATIONKEY ; Ordinal Expr = $1)
      » column: (Alias = N_NAME ; Expr = n.N_NAME ; Ordinal Expr = $2)
      » column: (Alias = N_REGIONKEY ; Expr = n.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Alias = N_COMMENT ; Expr = n.N_COMMENT ; Ordinal Expr = $4)

-> -> -> tableScanOp
         » alias: (n)
         » table: (rapidsse.public.nation)'
)

EXPLAIN SELECT n.* FROM nation n;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n.* FROM nation n"

-> -> projectOp
      » column: (Alias = N_NATIONKEY ; Expr = n.N_NATIONKEY ; Ordinal Expr = $1)
      » column: (Alias = N_NAME ; Expr = n.N_NAME ; Ordinal Expr = $2)
      » column: (Alias = N_REGIONKEY ; Expr = n.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Alias = N_COMMENT ; Expr = n.N_COMMENT ; Ordinal Expr = $4)

-> -> -> tableScanOp
         » alias: (n)
         » table: (rapidsse.public.nation)'
)

EXPLAIN SELECT n_name FROM nation n;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation n"

-> -> projectOp
      » column: (Expr = n.n_name ; Ordinal Expr = $2)

-> -> -> tableScanOp
         » alias: (n)
         » table: (rapidsse.public.nation)'
)

-- Can we fully reference a column name in a SELECT list using a table reference?
EXPLAIN SELECT n.n_name FROM nation n;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n.n_name FROM nation n"

-> -> projectOp
      » column: (Expr = n.n_name ; Ordinal Expr = $2)

-> -> -> tableScanOp
         » alias: (n)
         » table: (rapidsse.public.nation)'
)

-- Can we fully reference a column name in a WHERE clause using a table reference?
EXPLAIN SELECT n.n_name FROM nation n WHERE n.n_nationkey > 0;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n.n_name FROM nation n WHERE n.n_nationkey > 0"

-> -> projectOp
      » column: (Expr = n.n_name ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (n.n_nationkey > 0)
         » ordinal expr: ($1 > 0)

-> -> -> -> tableScanOp
            » alias: (n)
            » table: (rapidsse.public.nation)'
)

-- Can we fully reference a column name in an ORDER clause using a table reference?
EXPLAIN SELECT n.n_name FROM nation n ORDER BY n.n_nationkey;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n.n_name FROM nation n ORDER BY n.n_nationkey"

-> -> projectOp
      » column: (Expr = n.n_name ; Ordinal Expr = $1)

-> -> -> orderOp
         » order expr: ((n.n_nationkey) ASC)
         » ordinal order expr: (($2) ASC)

-> -> -> -> projectOp
            » column: (Expr = n.n_name ; Ordinal Expr = $2)
            » column: (Expr = n.n_nationkey ; Ordinal Expr = $1)

-> -> -> -> -> tableScanOp
               » alias: (n)
               » table: (rapidsse.public.nation)'
)


-- Can have an alias that is the same as the table name
EXPLAIN SELECT * FROM nation nation;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT * FROM nation nation"

-> -> projectOp
      » column: (Alias = N_NATIONKEY ; Expr = nation.N_NATIONKEY ; Ordinal Expr = $1)
      » column: (Alias = N_NAME ; Expr = nation.N_NAME ; Ordinal Expr = $2)
      » column: (Alias = N_REGIONKEY ; Expr = nation.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Alias = N_COMMENT ; Expr = nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> tableScanOp
         » alias: (nation)
         » table: (rapidsse.public.nation)'
)

-- Qualifying the column name with the alias name, which is the same as the
-- underlying table name.
EXPLAIN SELECT nation.n_name FROM nation nation;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT nation.n_name FROM nation nation"

-> -> projectOp
      » column: (Expr = nation.n_name ; Ordinal Expr = $2)

-> -> -> tableScanOp
         » alias: (nation)
         » table: (rapidsse.public.nation)'
)


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Ensure we cannot use the original table name once a table reference is specified.
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Cannot use the original table name in a select list.
EXPLAIN SELECT nation.n_name FROM nation n;
failure contains: 'No such column: nation.n_name'

-- Cannot use the original table name in a column wildcard.
EXPLAIN SELECT nation.* FROM nation n;
failure contains: 'Column wildcard does not resolve to any tables in the query'

-- Alias doesn't resolve with a catalog and schema name in the select list
EXPLAIN SELECT rapidsse.public.n.* FROM nation n;
failure contains: 'Column wildcard does not resolve to any tables in the query'

-- Alias doesn't resolve with a schema name in the select list
EXPLAIN SELECT public.n.* FROM nation n;
failure contains: 'Column wildcard does not resolve to any tables in the query'

-- Alias doesn't resolve with a catalog and schema name in the WHERE clause
EXPLAIN SELECT n.n_name FROM nation n WHERE rapidsse.public.n.n_nationkey > 0;
failure contains: 'No such column: rapidsse.public.n.n_nationkey'

-- Alias doesn't resolve with a schema name in the WHERE clause
EXPLAIN SELECT n.n_name FROM nation n WHERE public.n.n_nationkey > 0;
failure contains: 'No such column: public.n.n_nationkey'

-- Alias doesn't resolve with a catalog and schema name in an ORDER clause
EXPLAIN SELECT n.n_name FROM nation n ORDER BY rapidsse.public.n.n_nationkey;
failure contains: 'No such column: rapidsse.public.n.n_nationkey'

-- Alias doesn't resolve with a schema name in an ORDER clause
EXPLAIN SELECT n.n_name FROM nation n ORDER BY public.n.n_nationkey;
failure contains: 'No such column: public.n.n_nationkey'

-- Cannot use the original table name in a WHERE clause
EXPLAIN SELECT n_name FROM nation n WHERE nation.n_nationkey > 0;
failure contains: 'No such column: nation.n_nationkey'


-- If the alias is the same as the table name then you still can't use
-- a schema or catalog to qualify that alias. Alias's can't be qualified.
-- Try this with a column wildcard.
EXPLAIN SELECT rapidsse.public.nation.* FROM nation nation;
failure contains: 'Column wildcard does not resolve to any tables in the query'

-- Now try this with a column name.
EXPLAIN SELECT rapidsse.public.nation.n_name FROM nation nation;
failure contains: 'No such column: rapidsse.public.nation.n_name'


-- Cannot have two table aliases that are the same




// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  drop table nation ;
  mute
}