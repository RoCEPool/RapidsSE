/*----------------------------------------------------------------------------*/
/* EXPLAIN syntax & semantic tests                                            */
/*----------------------------------------------------------------------------*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Simple explain
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT n_nationkey FROM nation;
rows:
  (*, 'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_nationkey FROM nation"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)' )

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain with errors
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
EXPLAIN SELECT * FROM badTable;
failure contains: 'No such table: badTable'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain format
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
EXPLAIN FORMAT PRETTY SELECT n_nationkey FROM nation;
rows:
  ( *, 'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_nationkey FROM nation"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)' )

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain single stage
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Explain single stage (nums)

EXPLAIN STAGE 2 SELECT n_nationkey FROM nation;
rows:
  ( 2, 'nameValidate',  * )


-- Explain single stage (names)

EXPLAIN STAGE nameValidate SELECT n_nationkey FROM nation;
rows:
  ( 2, 'nameValidate',  * )


-- Explain single stage (names, case insensitive)

EXPLAIN STAGE NAMEVALIDATE SELECT n_nationkey FROM nation;
rows:
  ( 2, 'nameValidate',  * )


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain multiple single stages
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Explain multiple single stages (num)

EXPLAIN STAGE 1,3 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 3, 'exprValidate',  * )


-- (mixed order)

EXPLAIN STAGE 3,1 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 3, 'exprValidate',  * )


-- Explain multiple single stages (names)

EXPLAIN STAGE parser, exprValidate SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 3, 'exprValidate',  * )


-- (mixed order)

EXPLAIN STAGE exprValidate, parser SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 3, 'exprValidate',  * )


-- Explain multiple single stages (mixed)

EXPLAIN STAGE 1, exprValidate SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 3, 'exprValidate',  * )


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain stage range
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Explain stage range (nums)

EXPLAIN STAGE 1-3 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )

EXPLAIN STAGE 1 TO 3 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )


-- Explain stage range (names)

EXPLAIN STAGE parser-exprValidate SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )

EXPLAIN STAGE parser TO exprValidate SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )


-- Explain stage range (mixed)

EXPLAIN STAGE 1-exprValidate SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )


EXPLAIN STAGE parser-3 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain multiple stage ranges
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Explain multiple stage ranges (nums)

EXPLAIN STAGE 1-2, 4-5 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 4, 'setOpValidate', * )
  ( 5, 'postProject',   * )


-- Explain multiple stage ranges (names)

EXPLAIN STAGE parser-nameValidate, setOpValidate-explainPlan SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',         * )
  ( 2, 'nameValidate',   * )
  ( 4, 'setOpValidate',  * )
  ( 5, 'postProject',    * )
  ( 6, 'exprPushdown',   * )
  ( 7, 'projValidation', * )
  ( 8, 'corrBySquash',   * )
  ( 9, 'explainPlan',    * )


-- Explain multiple stage ranges (mixed)

EXPLAIN STAGE 1-nameValidate, setOpValidate-5 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 4, 'setOpValidate', * )
  ( 5, 'postProject',   * )


-- Explain multiple overlapping stage ranges

EXPLAIN STAGE 1-3, 2-4 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )
  ( 4, 'setOpValidate', * )

EXPLAIN STAGE parser-exprValidate, nameValidate-setOpValidate SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )
  ( 4, 'setOpValidate', * )


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain all stages
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN STAGE * SELECT n_nationkey FROM nation;
rows:
  (  1, 'parser',           * )
  (  2, 'nameValidate',     * )
  (  3, 'exprValidate',     * )
  (  4, 'setOpValidate',    * )
  (  5, 'postProject',      * )
  (  6, 'exprPushdown',     * )
  (  7, 'projValidation',   * )
  (  8, 'corrBySquash',     * )
  (  9, 'explainPlan',      * )
  ( 10, 'partitionPlan',    * )
  ( 11, 'projValidation',   * )
  ( 12, 'partitionExplain', * )
  ( 13, 'stageMarkers',     * )
  ( 14, 'aggregateSplit',   * )
  ( 15, 'transliterate',    * )

EXPLAIN STAGE ALL SELECT n_nationkey FROM nation;
rows:
  (  1, 'parser',           * )
  (  2, 'nameValidate',     * )
  (  3, 'exprValidate',     * )
  (  4, 'setOpValidate',    * )
  (  5, 'postProject',      * )
  (  6, 'exprPushdown',     * )
  (  7, 'projValidation',   * )
  (  8, 'corrBySquash',     * )
  (  9, 'explainPlan',      * )
  ( 10, 'partitionPlan',    * )
  ( 11, 'projValidation',   * )
  ( 12, 'partitionExplain', * )
  ( 13, 'stageMarkers',     * )
  ( 14, 'aggregateSplit',   * )
  ( 15, 'transliterate',    * )


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain invalid stage
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Explain invalid stage (nums)

EXPLAIN STAGE -1 SELECT n_nationkey FROM nation;
failure contains: "EC_SYNTAX_ERROR; Line: 1; Column: 14; extraneous input '-'"

EXPLAIN STAGE 1000 SELECT n_nationkey FROM nation;
rows: 0


-- Explain invalid stage (names)

EXPLAIN STAGE badStageName SELECT n_nationkey FROM nation;
rows: 0


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain invalid stage range
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Explain invalid stage range (nums)

EXPLAIN STAGE 3-1 SELECT n_nationkey FROM nation;
rows: 0

EXPLAIN STAGE 1-1000 SELECT n_nationkey FROM nation;
rows: 15


-- Explain invalid stage range (names)
EXPLAIN STAGE exprValidate-parser SELECT n_nationkey FROM nation;
rows: 0

EXPLAIN STAGE parser-badStageName SELECT n_nationkey FROM nation;
rows: 15

EXPLAIN STAGE badStageName-explainPlan SELECT n_nationkey FROM nation;
rows: 0

-- Explain invalid stage range (mixed)

EXPLAIN STAGE badStageName-5 SELECT n_nationkey FROM nation;
rows: 0

EXPLAIN STAGE 1000-explainPlan SELECT n_nationkey FROM nation;
rows: 0


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Explain of an explain
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN EXPLAIN SELECT n_nationkey FROM nation;
rows:
( *, 'explainPlan','
∆ mainSubquery

-> statementMarker: explain
   » queryText: "EXPLAIN SELECT n_nationkey FROM nation"

-> -> explainOp
      » stageRangeList: explainPlan
      » format: PRETTY

-> -> -> mainSubquery

-> -> -> -> statementMarker: select
            » queryText: "SELECT n_nationkey FROM nation"

-> -> -> -> -> projectOp
               » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> -> -> -> tableScanOp
                  » table: (rapidsse.public.nation)' )


EXPLAIN stage 1-3 EXPLAIN SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )


EXPLAIN stage 1-3 EXPLAIN STAGE 2-4 SELECT n_nationkey FROM nation;
rows:
  ( 1, 'parser',        * )
  ( 2, 'nameValidate',  * )
  ( 3, 'exprValidate',  * )


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE nation;
  mute
}