/*----------------------------------------------------------------------------*/
/* Post projection semantic tests                                             */
/*----------------------------------------------------------------------------*/

-- This tests whether a ProjectOp is required to trim away any intermediate
-- or working columns before the columns are returned to the user.
--
-- This tends to happen if a HAVING or ORDER BY clause contain an expression
-- that cannot be calculated from the columns in the select list. It also
-- happens when a GROUP BY expression is a subset of a projected column (because
-- the group by expression will be required later when the query is partitioned
-- and the groups are rolled up at the node and origin levels).
--
-- That is, if the expression in the HAVING/ORDER BY is equal to or a superset
-- of the columns in the select list then a post projection is not required.
-- However, the catch is that if the expression in the HAVING/ORDER BY is an
-- aggregate expression and the matching column in the project list is not
-- an aggregate then this a post projection IS required (because that aggregate
-- expression will be pushed down in the exprPushdown compilation stage).
--
-- Post project also adds in any literal expressions as they usually do not need
-- to be projected from lower in the plan.

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table ${testName2}_nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

trackmemory force;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Post projection required because SUM(n_nationkey) is not being projected (HAVING clause)
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN SELECT n_name FROM ${testName2}_nation GROUP BY n_name HAVING SUM(n_nationkey) > 0;
rows:
(
*,
'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name FROM ${testName2}_nation GROUP BY n_name HAVING SUM(n_nationkey) > 0"

-> -> projectOp
      » column: (Expr = rapids.public.${testName2}_nation.n_name ; Ordinal Expr = $1)

-> -> -> filterOp
         » expr: ((SUM(rapids.public.${testName2}_nation.n_nationkey)) > 0)
         » ordinal expr: ($2 > 0)

-> -> -> -> aggregateOp
            » column: (Expr = rapids.public.${testName2}_nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapids.public.${testName2}_nation.n_nationkey) ; Ordinal Expr = SUM($1))
            » group by: (Expr = rapids.public.${testName2}_nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> tableScanOp
               » table: (rapids.public.${testName2}_nation)'
)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Post projection required because SUM(n_nationkey) is not being projected (ORDER BY clause)
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

