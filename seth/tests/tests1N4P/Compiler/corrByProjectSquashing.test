            » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6 ; Ordinal Expr = $6)
            » column: (Alias = col7 ; Expr = rapidsse.public.t1.col7 ; Ordinal Expr = $7)
            » column: (Alias = col8 ; Expr = rapidsse.public.t1.col8 ; Ordinal Expr = $8)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t1)

-> -> -> statementMarker: select
         » queryText: "SELECT * FROM t2"

-> -> -> -> projectOp
            » column: (Alias = col1 ; Expr = rapidsse.public.t2.col1 ; Ordinal Expr = $1)
            » column: (Alias = col2 ; Expr = rapidsse.public.t2.col2 ; Ordinal Expr = $2)
            » column: (Alias = col3 ; Expr = rapidsse.public.t2.col3 ; Ordinal Expr = $3)
            » column: (Alias = col4 ; Expr = rapidsse.public.t2.col4 ; Ordinal Expr = $4)
            » column: (Alias = col5 ; Expr = rapidsse.public.t2.col5 ; Ordinal Expr = $5)
