// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Nested union all statements
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Here we have a nested union where each individual SELECT statement is selecting
-- more columns than is required. The outer UNION only requires columns 2, 4 and 6.
-- The nested inner union requires columns 2, 4, 6, and 8. Pushing down the
-- CORRESPONDING BY ProjectOps will force inner union to only require columns
-- 2, 4 and 6 (dropping col8) and ultimately each SELECT statement will only
-- select the neccessary columns.
EXPLAIN
SELECT col1, col2, col3, col4, col5, col6, col7, col8 FROM t1
UNION ALL CORRESPONDING BY (col2, col4, col6)
(
  SELECT bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4
  UNION ALL CORRESPONDING BY (col2, col4, col6, col8)
  SELECT * FROM t2
);
