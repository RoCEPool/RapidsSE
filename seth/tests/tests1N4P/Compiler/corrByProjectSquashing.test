// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Project squashing into a post-ProjectOp
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Here each child query is not selecting the expression in the HAVING clause
-- so each child query will generate a post-ProjectOp to filter out that
-- transient column. However the ProjectOp from the CORRESPONDING clause
-- will be pushed down and squashed into this post-ProjectOp.

EXPLAIN
SELECT col1 as c1, COUNT(col3) FROM t1 GROUP BY c1 HAVING SUM(col2) > 0
UNION ALL CORRESPONDING
SELECT col1 as c1, COUNT(col3) FROM t2 GROUP BY col1 HAVING SUM(col2) > 0;
