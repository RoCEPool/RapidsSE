/*----------------------------------------------------------------------------*/
/* ProjectOp Squashing                                                        */
/*                                                                            */
/* This deals with the case of pushing down and squashing ProjectOps that     */
/* are created as children of UnionOps when a CORRESPONDING BY clause is      */
/* specified.                                                                 */
/*----------------------------------------------------------------------------*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE t1 (col1 INTEGER, col2 FLOAT, col3 DECIMAL, col4 VARCHAR, col5 BOOLEAN, col6 DATE, col7 TIME, col8 TIMESTAMP);
success

// same signature as tbl1 but with an extra column
CREATE TABLE t2 (col1 INTEGER, col2 FLOAT, col3 DECIMAL, col4 VARCHAR, col5 BOOLEAN, col6 DATE, col7 TIME, col8 TIMESTAMP, col9 INTEGER);
success

// same column names as t1 but different column types
CREATE TABLE t3 (col1 VARCHAR, col2 BOOLEAN, col3 DATE, col4 TIME, col5 TIMESTAMP, col6 INTEGER, col7 FLOAT, col8 DECIMAL);
success

// same column types as t1 but different column names
CREATE TABLE t4 (alpha INTEGER, bravo FLOAT, charlie DECIMAL, delta VARCHAR, echo BOOLEAN, foxtrot DATE, golf TIME, hotel TIMESTAMP);
success

// same column types as t1 but different column names
CREATE TABLE t5 (colA INTEGER, colB FLOAT, colC DECIMAL, colD VARCHAR, colE BOOLEAN, colF DATE, colG TIME, colH TIMESTAMP);
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic union all statements with CORRESPONDING BY clause
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN
SELECT * FROM t1
UNION ALL CORRESPONDING BY (col2, col4, col6)
SELECT * FROM t2;
rows:
(*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM t1 UNION ALL CORRESPONDING BY (col2, col4, col6) SELECT * FROM t2"

-> -> unionOp
      » isDistinct: (false)

-> -> -> statementMarker: select
         » queryText: "SELECT * FROM t1"

-> -> -> -> projectOp
            » column: (Alias = col2 ; Expr = rapidsse.public.t1.col2 ; Ordinal Expr = $2)
            » column: (Alias = col4 ; Expr = rapidsse.public.t1.col4 ; Ordinal Expr = $4)
            » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6 ; Ordinal Expr = $6)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t1)

-> -> -> statementMarker: select
         » queryText: "SELECT * FROM t2"

-> -> -> -> projectOp
            » column: (Alias = col2 ; Expr = rapidsse.public.t2.col2 ; Ordinal Expr = $2)
            » column: (Alias = col4 ; Expr = rapidsse.public.t2.col4 ; Ordinal Expr = $4)
            » column: (Alias = col6 ; Expr = rapidsse.public.t2.col6 ; Ordinal Expr = $6)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t2)'
)

-- alias in first query
EXPLAIN
SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4
UNION ALL CORRESPONDING BY (col2, col4, col6)
SELECT * FROM t1;
rows:
(*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4 UNION ALL CORRESPONDING BY (col2, col4, col6) SELECT * FROM t1"

-> -> unionOp
      » isDistinct: (false)

-> -> -> statementMarker: select
         » queryText: "SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4"

-> -> -> -> projectOp
            » column: (Alias = col2 ; Expr = rapidsse.public.t4.bravo ; Ordinal Expr = $2)
            » column: (Alias = col4 ; Expr = rapidsse.public.t4.delta ; Ordinal Expr = $4)
            » column: (Alias = col6 ; Expr = rapidsse.public.t4.foxtrot ; Ordinal Expr = $6)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t4)

-> -> -> statementMarker: select
         » queryText: "SELECT * FROM t1"

-> -> -> -> projectOp
            » column: (Alias = col2 ; Expr = rapidsse.public.t1.col2 ; Ordinal Expr = $2)
            » column: (Alias = col4 ; Expr = rapidsse.public.t1.col4 ; Ordinal Expr = $4)
            » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6 ; Ordinal Expr = $6)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t1)'
)

