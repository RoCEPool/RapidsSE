               » queryText: "SELECT bravo AS col2, charlie as col3, delta AS col4, foxtrot AS col6   FROM t4"

-> -> -> -> -> -> projectOp
                  » column: (Alias = col2 ; Expr = rapidsse.public.t4.bravo ; Ordinal Expr = $2)
                  » column: (Alias = col4 ; Expr = rapidsse.public.t4.delta ; Ordinal Expr = $4)
                  » column: (Alias = col6 ; Expr = rapidsse.public.t4.foxtrot ; Ordinal Expr = $6)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.t4)

-> -> -> -> -> statementMarker: select
               » queryText: "SELECT colB, colC, colD, colF   FROM t5"

-> -> -> -> -> -> projectOp
                  » column: (Expr = rapidsse.public.t5.colB ; Ordinal Expr = $2)
                  » column: (Expr = rapidsse.public.t5.colD ; Ordinal Expr = $4)
                  » column: (Expr = rapidsse.public.t5.colF ; Ordinal Expr = $6)

-> -> -> -> -> -> -> tableScanOp
                     » table: (rapidsse.public.t5)'
)


