// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Project squashing into AggregateOps
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Basic group by. Note that the aggregation exprs gets factored
-- out because they don't have a common name because the columnRefs
-- are not symbolically equal. Need to give them an alias for the
-- aggregation exprs to be included (see below).
EXPLAIN
SELECT col1, SUM(col2), COUNT(col3) FROM t1 GROUP BY col1
UNION ALL CORRESPONDING
SELECT col1, SUM(col2), COUNT(col3) FROM t2 GROUP BY col1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT col1, SUM(col2), COUNT(col3) FROM t1 GROUP BY col1 UNION ALL CORRESPONDING SELECT col1, SUM(col2), COUNT(col3) FROM t2 GROUP BY col1"

-> -> unionOp
      » isDistinct: (false)

-> -> -> statementMarker: select
         » queryText: "SELECT col1, SUM(col2), COUNT(col3) FROM t1 GROUP BY col1"

-> -> -> -> aggregateOp
            » column: (Alias = col1 ; Expr = rapidsse.public.t1.col1 ; Ordinal Expr = $1)
            » group by: (rapidsse.public.t1.col1) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t1)

-> -> -> statementMarker: select
         » queryText: "SELECT col1, SUM(col2), COUNT(col3) FROM t2 GROUP BY col1"

-> -> -> -> aggregateOp
            » column: (Alias = col1 ; Expr = rapidsse.public.t2.col1 ; Ordinal Expr = $1)
            » group by: (rapidsse.public.t2.col1) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t2)')

EXPLAIN
SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY col1
UNION ALL CORRESPONDING
SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY col1 UNION ALL CORRESPONDING SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1"

-> -> unionOp
      » isDistinct: (false)

-> -> -> statementMarker: select
         » queryText: "SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY col1"

-> -> -> -> aggregateOp
            » column: (Alias = col1 ; Expr = rapidsse.public.t1.col1 ; Ordinal Expr = $1)
            » column: (Alias = s2 ; Expr = SUM(rapidsse.public.t1.col2) ; Ordinal Expr = SUM($2))
            » group by: (rapidsse.public.t1.col1) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t1)

-> -> -> statementMarker: select
         » queryText: "SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1"

-> -> -> -> aggregateOp
            » column: (Alias = col1 ; Expr = rapidsse.public.t2.col1 ; Ordinal Expr = $1)
            » column: (Alias = s2 ; Expr = SUM(rapidsse.public.t2.col2) ; Ordinal Expr = SUM($2))
            » group by: (rapidsse.public.t2.col1) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t2)'
)


-- AggregateOp with alias in the group by list in the first child query.
-- Here we need to ensure that the alias in the group by list is expanded
-- since the alias is not being projected any more.
EXPLAIN
SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY c1
UNION ALL CORRESPONDING
SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY c1 UNION ALL CORRESPONDING SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1"

-> -> unionOp
      » isDistinct: (false)

-> -> -> statementMarker: select
         » queryText: "SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY c1"

-> -> -> -> aggregateOp
            » column: (Alias = s2 ; Expr = SUM(rapidsse.public.t1.col2) ; Ordinal Expr = SUM($2))
            » group by: (rapidsse.public.t1.col1) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t1)

-> -> -> statementMarker: select
         » queryText: "SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1"

-> -> -> -> aggregateOp
            » column: (Alias = s2 ; Expr = SUM(rapidsse.public.t2.col2) ; Ordinal Expr = SUM($2))
            » group by: (rapidsse.public.t2.col1) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t2)'
)

-- AggregateOp with alias in the group by list in the first child query.
-- Compared the last example, here we will be projected the group by column
-- (and alias) so the alias in the group by list of the first child query
-- can be left as is.
EXPLAIN
SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY c1
UNION ALL CORRESPONDING
SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY c1 UNION ALL CORRESPONDING SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1"

-> -> unionOp
      » isDistinct: (false)

-> -> -> statementMarker: select
         » queryText: "SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY c1"

-> -> -> -> aggregateOp
            » column: (Alias = c1 ; Expr = rapidsse.public.t1.col1 ; Ordinal Expr = $1)
            » column: (Alias = s2 ; Expr = SUM(rapidsse.public.t1.col2) ; Ordinal Expr = SUM($2))
            » group by: (c1) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t1)

-> -> -> statementMarker: select
         » queryText: "SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1"

-> -> -> -> aggregateOp
            » column: (Alias = c1 ; Expr = rapidsse.public.t2.col1 ; Ordinal Expr = $1)
            » column: (Alias = s2 ; Expr = SUM(rapidsse.public.t2.col2) ; Ordinal Expr = SUM($2))
            » group by: (rapidsse.public.t2.col1) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.t2)'
)


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Project squashing above a non-ProjectOp
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- squashing above a filterOp in the first child query
EXPLAIN
SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY c1 HAVING s2 > 0
UNION ALL CORRESPONDING
SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
