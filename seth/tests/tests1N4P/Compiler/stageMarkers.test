/*----------------------------------------------------------------------------*/
/* StageMarker tests                                                          */
/*                                                                            */
/* Tests that StatementMarkers are removed from the plan and StageMarkers are */
/* inserted appropriately.                                                    */
/*----------------------------------------------------------------------------*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE ${testName2}_nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

CREATE TABLE ${testName2}_region (
	 R_REGIONKEY       INTEGER NOT NULL,
	 R_NAME            CHAR(25) NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

create table ${testName2}_supplier (
	 S_SUPPKEY       INTEGER       NOT NULL,
	 S_NAME          CHAR(25)      NOT NULL,
	 S_ADDRESS       VARCHAR(40)   NOT NULL,
	 S_NATIONKEY     INTEGER       NOT NULL,
	 S_PHONE         CHAR(15)      NOT NULL,
	 S_ACCTBAL       DECIMAL(15,2) NOT NULL,
	 S_COMMENT       VARCHAR(101)  NOT NULL
);
success

-- memory leak testing not enabled due to memory leaks in the transliteration / back end
trackmemory force;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Test that a simple plan always starts with a StageMarker
EXPLAIN STAGE stageMarkers SELECT * FROM ${testName2}_nation;
rows: (*,'stageMarkers','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: all partitions
   » routing: unicast

-> -> projectOp
      » column: (Alias = N_NATIONKEY ; Expr = rapidsse.public.${testName2}_nation.N_NATIONKEY ; Ordinal Expr = $1)
      » column: (Alias = N_NAME ; Expr = rapidsse.public.${testName2}_nation.N_NAME ; Ordinal Expr = $2)
      » column: (Alias = N_REGIONKEY ; Expr = rapidsse.public.${testName2}_nation.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Alias = N_COMMENT ; Expr = rapidsse.public.${testName2}_nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> tableScanOp
         » location: all partitions
         » table: (rapidsse.public.${testName2}_nation)'
)


-- Test that the children of a union are always StageMarkers
EXPLAIN STAGE stageMarkers
SELECT n_nationkey, n_name FROM ${testName2}_nation
UNION ALL
SELECT n_regionkey, n_name FROM ${testName2}_nation;
rows: (*,'stageMarkers','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> unionOp
      » location: origin
      » isDistinct: (false)

-> -> -> stageMarker
         » location: origin
         » routing: unicast

-> -> -> -> stageMarker
            » location: all partitions
            » routing: unicast

-> -> -> -> -> projectOp
               » column: (Expr = rapidsse.public.${testName2}_nation.n_nationkey ; Ordinal Expr = $1)
               » column: (Expr = rapidsse.public.${testName2}_nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> tableScanOp
                  » location: all partitions
                  » table: (rapidsse.public.${testName2}_nation)

-> -> -> stageMarker
         » location: origin
         » routing: unicast

-> -> -> -> stageMarker
            » location: all partitions
            » routing: unicast

-> -> -> -> -> projectOp
               » column: (Expr = rapidsse.public.${testName2}_nation.n_regionkey ; Ordinal Expr = $3)
               » column: (Expr = rapidsse.public.${testName2}_nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> tableScanOp
                  » location: all partitions
                  » table: (rapidsse.public.${testName2}_nation)'
)


-- 3-way nested union statement
EXPLAIN STAGE stageMarkers
SELECT n_nationkey, n_name FROM ${testName2}_nation
UNION ALL
SELECT n_regionkey, n_name FROM ${testName2}_nation
UNION ALL
SELECT n_nationkey, n_comment FROM ${testName2}_nation;

rows: (*,'stageMarkers','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> unionOp
      » location: origin
      » isDistinct: (false)

-> -> -> stageMarker
         » location: origin
         » routing: unicast

-> -> -> -> unionOp
            » location: origin
            » isDistinct: (false)

-> -> -> -> -> stageMarker
               » location: origin
               » routing: unicast

-> -> -> -> -> -> stageMarker
                  » location: all partitions
                  » routing: unicast

-> -> -> -> -> -> -> projectOp
                     » column: (Expr = rapidsse.public.${testName2}_nation.n_nationkey ; Ordinal Expr = $1)
                     » column: (Expr = rapidsse.public.${testName2}_nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> -> tableScanOp
                        » location: all partitions
                        » table: (rapidsse.public.${testName2}_nation)

-> -> -> -> -> stageMarker
               » location: origin
               » routing: unicast

-> -> -> -> -> -> stageMarker
                  » location: all partitions
                  » routing: unicast

-> -> -> -> -> -> -> projectOp
                     » column: (Expr = rapidsse.public.${testName2}_nation.n_regionkey ; Ordinal Expr = $3)
                     » column: (Expr = rapidsse.public.${testName2}_nation.n_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> -> tableScanOp
                        » location: all partitions
                        » table: (rapidsse.public.${testName2}_nation)

-> -> -> stageMarker
         » location: origin
         » routing: unicast

-> -> -> -> stageMarker
            » location: all partitions
            » routing: unicast

-> -> -> -> -> projectOp
               » column: (Expr = rapidsse.public.${testName2}_nation.n_nationkey ; Ordinal Expr = $1)
               » column: (Expr = rapidsse.public.${testName2}_nation.n_comment ; Ordinal Expr = $4)

-> -> -> -> -> -> tableScanOp
                  » location: all partitions
                  » table: (rapidsse.public.${testName2}_nation)')



-- Test that the left child of a join is a StageMarker with a routing (single join)
EXPLAIN STAGE stageMarkers
SELECT n_name, r_name
FROM ${testName2}_region, ${testName2}_nation;
rows: (*,'stageMarkers','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: all partitions
   » routing: unicast

-> -> projectOp
      » column: (Expr = rapidsse.public.${testName2}_nation.n_name ; Ordinal Expr = $5)
      » column: (Expr = rapidsse.public.${testName2}_region.r_name ; Ordinal Expr = $2)

-> -> -> stageMarker
         » location: all partitions
         » routing: local partition

-> -> -> -> abstractJoinOp
            » location: all partitions
            » join type: Cross Join
            » predicate: (true)
            » ordinal predicate: (true)

-> -> -> -> -> stageMarker
               » location: all partitions
               » routing: broadcast

-> -> -> -> -> -> tableScanOp
                  » location: all partitions
                  » table: (rapidsse.public.${testName2}_region)

-> -> -> -> -> tableScanOp
               » location: all partitions
               » table: (rapidsse.public.${testName2}_nation)'
)


-- Test that the left child of a join is a StageMarker with a routing (nested join)
-- Also test that the parent of a join is a StageMarker
EXPLAIN STAGE stageMarkers
SELECT n_name, r_name, s_name
FROM ${testName2}_region, ${testName2}_nation
JOIN ${testName2}_supplier ON s_nationkey = n_nationkey;
rows: (*,'stageMarkers','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: all partitions
   » routing: unicast

-> -> projectOp
      » column: (Expr = rapidsse.public.${testName2}_nation.n_name ; Ordinal Expr = $5)
      » column: (Expr = rapidsse.public.${testName2}_region.r_name ; Ordinal Expr = $2)
      » column: (Expr = rapidsse.public.${testName2}_supplier.s_name ; Ordinal Expr = $9)

-> -> -> stageMarker
         » location: all partitions
         » routing: local partition

-> -> -> -> abstractJoinOp
            » location: all partitions
            » join type: Inner Join
            » predicate: (rapidsse.public.${testName2}_supplier.s_nationkey = rapidsse.public.${testName2}_nation.n_nationkey)
            » ordinal predicate: ($11 = $4)

-> -> -> -> -> stageMarker
               » location: all partitions
               » routing: broadcast

-> -> -> -> -> -> abstractJoinOp
                  » location: all partitions
                  » join type: Cross Join
                  » predicate: (true)
                  » ordinal predicate: (true)

-> -> -> -> -> -> -> stageMarker
                     » location: all partitions
                     » routing: broadcast

-> -> -> -> -> -> -> -> tableScanOp
                        » location: all partitions
                        » table: (rapidsse.public.${testName2}_region)

-> -> -> -> -> -> -> tableScanOp
                     » location: all partitions
                     » table: (rapidsse.public.${testName2}_nation)

-> -> -> -> -> tableScanOp
               » location: all partitions
               » table: (rapidsse.public.${testName2}_supplier)'
)

-- Appropriate StageMarkers are set when we have a join with aggregates
EXPLAIN STAGE stageMarkers
SELECT r_name, COUNT(n_name)
FROM ${testName2}_region JOIN ${testName2}_nation ON r_regionkey = n_regionkey
GROUP BY r_name;
rows: (*,'stageMarkers','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> aggregateOp
      » location: origin
      » column: (Expr = rapidsse.public.${testName2}_region.r_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(SUM(COUNT(rapidsse.public.${testName2}_nation.n_name))) ; Ordinal Expr = SUM($2))
      » group by: (Expr = rapidsse.public.${testName2}_region.r_name ; Ordinal Expr = $1)

-> -> -> stageMarker
         » location: all nodes
         » routing: unicast

-> -> -> -> aggregateOp
            » location: all nodes
            » column: (Expr = rapidsse.public.${testName2}_region.r_name ; Ordinal Expr = $1)
            » column: (Expr = SUM(COUNT(rapidsse.public.${testName2}_nation.n_name)) ; Ordinal Expr = SUM($2))
            » group by: (Expr = rapidsse.public.${testName2}_region.r_name ; Ordinal Expr = $1)

-> -> -> -> -> stageMarker
               » location: all partitions
               » routing: local node

-> -> -> -> -> -> aggregateOp
                  » column: (Expr = rapidsse.public.${testName2}_region.r_name ; Ordinal Expr = $2)
                  » column: (Expr = COUNT(rapidsse.public.${testName2}_nation.n_name) ; Ordinal Expr = COUNT($5))
                  » group by: (Expr = rapidsse.public.${testName2}_region.r_name ; Ordinal Expr = $2)

-> -> -> -> -> -> -> stageMarker
                     » location: all partitions
                     » routing: local partition

-> -> -> -> -> -> -> -> abstractJoinOp
                        » location: all partitions
                        » join type: Inner Join
                        » predicate: (rapidsse.public.${testName2}_region.r_regionkey = rapidsse.public.${testName2}_nation.n_regionkey)
                        » ordinal predicate: ($1 = $6)

-> -> -> -> -> -> -> -> -> stageMarker
                           » location: all partitions
                           » routing: broadcast

-> -> -> -> -> -> -> -> -> -> tableScanOp
                              » location: all partitions
                              » table: (rapidsse.public.${testName2}_region)

-> -> -> -> -> -> -> -> -> tableScanOp
                           » location: all partitions
                           » table: (rapidsse.public.${testName2}_nation)'
)


-- Test that we add an extra StageMarker when there are more than one
-- ProjectOps in a StageMarker section
EXPLAIN STAGE stageMarkers
SELECT 1 FROM ${testName2}_nation HAVING sum(n_nationkey) > 0;
rows: (*,'stageMarkers','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> stageMarker
   » location: origin
   » routing: unicast

-> -> projectOp
      » column: (Expr = 1 ; Ordinal Expr = $1)

-> -> -> stageMarker
         » location: origin
         » routing: unicast

-> -> -> -> filterOp
            » expr: ((SUM(SUM(SUM(rapidsse.public.${testName2}_nation.n_nationkey)))) > 0)
            » ordinal expr: ($2 > 0)

-> -> -> -> -> projectOp
               » location: origin
               » column: (Expr = 1 ; Ordinal Expr = $1)
               » column: (Expr = SUM(SUM(SUM(rapidsse.public.${testName2}_nation.n_nationkey))) ; Ordinal Expr = SUM($2))

-> -> -> -> -> -> stageMarker
                  » location: all nodes
                  » routing: unicast

-> -> -> -> -> -> -> projectOp
                     » location: all nodes
                     » column: (Expr = 1 ; Ordinal Expr = $1)
                     » column: (Expr = SUM(SUM(rapidsse.public.${testName2}_nation.n_nationkey)) ; Ordinal Expr = SUM($2))

-> -> -> -> -> -> -> -> stageMarker
                        » location: all partitions
                        » routing: local node

-> -> -> -> -> -> -> -> -> projectOp
                           » column: (Expr = 1 ; Ordinal Expr = 1)
                           » column: (Expr = SUM(rapidsse.public.${testName2}_nation.n_nationkey) ; Ordinal Expr = SUM($1))

-> -> -> -> -> -> -> -> -> -> tableScanOp
                              » location: all partitions
                              » table: (rapidsse.public.${testName2}_nation)'
)


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE ${testName2}_nation;
  mute

  DROP TABLE ${testName2}_region;
  mute

  DROP TABLE ${testName2}_supplier;
  mute
}