/*----------------------------------------------------------------------------*/
/* Joins tests                                                                */
/*----------------------------------------------------------------------------*/

-- Tests basic join handling


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Create various tables that can be joined
CREATE TABLE ${testName}_region (
	 R_REGIONKEY       INTEGER NOT NULL,
	 R_NAME            CHAR(25) NOT NULL,
	 R_COMMENT         VARCHAR(152)
);
success

CREATE TABLE ${testName}_nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

create table ${testName}_supplier (
	 S_SUPPKEY       INTEGER       NOT NULL,
	 S_NAME          CHAR(25)      NOT NULL,
	 S_ADDRESS       VARCHAR(40)   NOT NULL,
	 S_NATIONKEY     INTEGER       NOT NULL,
	 S_PHONE         CHAR(15)      NOT NULL,
	 S_ACCTBAL       DECIMAL(15,2) NOT NULL,
	 S_COMMENT       VARCHAR(101)  NOT NULL
);
success

create table ${testName}_partsupp (
	PS_PARTKEY      INTEGER       NOT NULL,
	PS_SUPPKEY      INTEGER       NOT NULL,
	PS_AVAILQTY     INTEGER       NOT NULL,
	PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
	PS_COMMENT      VARCHAR(199)  NOT NULL
);
success

CREATE TABLE ${testName}_t1 (colA INTEGER, colB VARCHAR, colC DECIMAL, colD BOOLEAN);
success

CREATE TABLE ${testName}_t2 (colA INTEGER, colB VARCHAR, colC DECIMAL, colX DATE, colY TIME, colZ TIMESTAMP);
success

CREATE TABLE ${testName}_t3 (colA INTEGER, colB VARCHAR, colC DECIMAL);
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic join tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- left table doesn't exist
EXPLAIN SELECT *
FROM badTable
JOIN ${testName}_region ON badTable.badCol = r_regionkey;
failure contains: 'No such table: badTable'

EXPLAIN SELECT *
FROM badTable, ${testName}_region;
failure contains: 'No such table: badTable'

-- right table doesn't exist
EXPLAIN SELECT *
FROM ${testName}_region
JOIN badTable ON badTable.badCol = r_regionkey;
failure contains: 'No such table: badTable'

EXPLAIN SELECT *
FROM ${testName}_region, badTable;
failure contains: 'No such table: badTable'

-- Neither left or right tables exist
EXPLAIN SELECT *
FROM badTable1
JOIN badTable2 ON badCol1 = badCol2;
failure contains: 'No such table: badTable1'

EXPLAIN SELECT *
FROM badTable1, badTable2;
failure contains: 'No such table: badTable1'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  n-way join tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Join 2 tables
EXPLAIN SELECT n_name, r_name
FROM ${testName}_region
JOIN ${testName}_nation ON r_regionkey = n_regionkey;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_name, r_name FROM ${testName}_region JOIN ${testName}_nation ON r_regionkey = n_regionkey"

-> -> projectOp
      » column: (Expr = rapidsse.public.${testName}_nation.n_name ; Ordinal Expr = $5)
      » column: (Expr = rapidsse.public.${testName}_region.r_name ; Ordinal Expr = $2)

-> -> -> abstractJoinOp
         » join type: Inner Join
         » predicate: (rapidsse.public.${testName}_region.r_regionkey = rapidsse.public.${testName}_nation.n_regionkey)
         » ordinal predicate: ($1 = $6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName}_region)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.${testName}_nation)'
)

EXPLAIN SELECT n_name, r_name
FROM ${testName}_region, ${testName}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

