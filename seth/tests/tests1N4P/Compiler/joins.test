/*----------------------------------------------------------------------------*/
/* Joins tests                                                                */
/*----------------------------------------------------------------------------*/

-- Tests basic join handling


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Create various tables that can be joined
_region;
success

_nation;
success

_supplier;
success

_partsupp;
success

CREATE TABLE t1 (colA INTEGER, colB VARCHAR, colC DECIMAL, colD BOOLEAN);
success

CREATE TABLE t2 (colA INTEGER, colB VARCHAR, colC DECIMAL, colX DATE, colY TIME, colZ TIMESTAMP);
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic join tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- left table doesn't exist
EXPLAIN SELECT *
FROM badTable
JOIN region ON badTable.badCol = r_regionkey;
failure contains: 'No such table: badTable'

EXPLAIN SELECT *
FROM badTable, region;
failure contains: 'No such table: badTable'

-- right table doesn't exist
EXPLAIN SELECT *
FROM region
JOIN badTable ON badTable.badCol = r_regionkey;
failure contains: 'No such table: badTable'

EXPLAIN SELECT *
FROM region, badTable;
failure contains: 'No such table: badTable'

-- Neither left or right tables exist
EXPLAIN SELECT *
FROM badTable1
JOIN badTable2 ON badCol1 = badCol2;
failure contains: 'No such table: badTable1'

EXPLAIN SELECT *
FROM badTable1, badTable2;
failure contains: 'No such table: badTable1'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  n-way join tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Join 2 tables
EXPLAIN SELECT n_name, r_name
FROM region
JOIN nation ON r_regionkey = n_regionkey;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT n_name, r_name FROM region JOIN nation ON r_regionkey = n_regionkey"

-> projectOp
   » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $5)
   » column: (Expr = rapidsse.public.region.r_name ; Ordinal Expr = $2)

-> -> nestedLoopJoinOp
      » join type: Inner Join
      » predicate: (rapidsse.public.region.r_regionkey = rapidsse.public.nation.n_regionkey)
      » ordinal predicate: ($1 = $6)

-> -> -> tableScanOp
         » table: (rapidsse.public.region)

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)'
)

EXPLAIN SELECT n_name, r_name
FROM region, nation;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT n_name, r_name FROM region, nation"

-> projectOp
   » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $5)
   » column: (Expr = rapidsse.public.region.r_name ; Ordinal Expr = $2)

-> -> nestedLoopJoinOp
      » join type: Cross Join
      » predicate: (true)
      » ordinal predicate: (true)

-> -> -> tableScanOp
         » table: (rapidsse.public.region)

-> -> -> tableScanOp
         » table: (rapidsse.public.nation)'
)


