-- Self join with ambiguous column in select list
EXPLAIN SELECT n_name, n2.n_regionkey
FROM nation n1
JOIN nation n2 ON n1.n_nationkey = n2.n_regionkey;
failure contains: 'Ambiguous column name: n_name'


-- Self join with ambiguous column in JOIN...ON clause
EXPLAIN SELECT n1.n_name, n2.n_regionkey
FROM nation n1
JOIN nation n2 ON n_nationkey = n2.n_regionkey;
