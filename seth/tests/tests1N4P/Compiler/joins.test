-- expression in join predicate must be a boolean expression
EXPLAIN SELECT *
FROM t1
FULL OUTER JOIN t2 ON t1.colA + 5;
failure contains: 'Predicate expression must have a boolean result : rapidsse.public.t1.colA + 5'

-- expression in join predicate must be a valid expression with comparable data types
EXPLAIN SELECT *
FROM t1
FULL OUTER JOIN t2 ON t1.colA = t2.colB;
failure contains: 'Expression type combination is invalid or unsupported for the expression operator: rapidsse.public.t1.colA = rapidsse.public.t2.colB'

-- non-equi-joins not yet supported
EXPLAIN SELECT *
FROM t1
FULL OUTER JOIN t2 ON t1.colA < t2.colA;
failure contains: 'Join predicate expression must be an equi-join'


