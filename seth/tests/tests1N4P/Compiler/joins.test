-- JOIN ON

-- no join predicate is a syntax error
EXPLAIN SELECT *
FROM t1
FULL OUTER JOIN t2;
failure contains: 'EC_SYNTAX_ERROR'

-- expression in join predicate can have an AND
EXPLAIN SELECT *
FROM t1
FULL OUTER JOIN t2 ON t1.colA = t2.colA AND t1.colB = t2.colB;
