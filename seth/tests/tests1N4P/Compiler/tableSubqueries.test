// Test that a table subquery cannot reference itself
EXPLAIN WITH t1 AS (SELECT * FROM t1) SELECT * FROM t1;
failure contains: 'Non-recursive subquery cannot refer to itself: t1'

// Test that two WITH clauses cannot circularly reference each other
EXPLAIN WITH t1 AS (SELECT * FROM t2), t2 AS (SELECT * FROM t1) SELECT * FROM t1;
failure contains: 'Table name refers to a table subquery alias that is not in scope: t2'

// Cannot have two table subqueries with the same table alias
EXPLAIN WITH t1 AS (SELECT * FROM nation), t1 AS (SELECT * FROM region) SELECT * FROM t1;
failure contains: 'Ambiguous alias name in WITH clause: t1'

