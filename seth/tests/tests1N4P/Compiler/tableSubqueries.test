  (*, 'partitionExplain', '
∆ tableSubquery
  » table alias: t1
  » correlated columns: (none)
  » recursive: false

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT COUNT(n_nationkey) FROM nation GROUP BY n_nationkey"

-> -> -> projectOp
         » column: (Expr = SUM(SUM(COUNT(rapidsse.public.nation.n_nationkey))) ; Ordinal Expr = $1)

-> -> -> -> aggregateOp
            » location: origin
            » column: (Expr = SUM(SUM(COUNT(rapidsse.public.nation.n_nationkey))) ; Ordinal Expr = SUM($1))
            » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $2)
            » group by: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $2)

-> -> -> -> -> aggregateOp
               » location: all nodes
               » column: (Expr = SUM(COUNT(rapidsse.public.nation.n_nationkey)) ; Ordinal Expr = SUM($1))
               » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $2)
               » group by: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $2)

-> -> -> -> -> -> aggregateOp
                  » column: (Expr = COUNT(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = COUNT($1))
                  » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
                  » group by: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> -> -> -> -> tableScanOp
                     » location: all partitions
                     » table: (rapidsse.public.nation)

∆ mainSubquery
  » table alias: __subquery0003
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM t1"

-> -> projectOp
      » location: origin
      » column: (Expr = t1.COL1 ; Ordinal Expr = $1)

-> -> -> subqueryRefOp
         » location: origin
         » alias: (t1)
         » params: t1()
         » ordinal params: t1()' )


