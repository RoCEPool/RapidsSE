// Basic table subquery in a set statement
EXPLAIN STAGE partitionExplain
WITH
t1 AS (SELECT n_name FROM nation),
t2 AS (SELECT r_name FROM region)
SELECT * FROM t1
UNION ALL
SELECT * FROM t2;

unordered rows: 
  (*, 'partitionExplain', '
∆ tableSubquery
  » table alias: t1
  » correlated columns: (none)
  » recursive: false

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT n_name FROM nation"

-> -> -> projectOp
         » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)

-> -> -> -> tableScanOp
            » location: all partitions
            » table: (rapidsse.public.nation)

∆ tableSubquery
  » table alias: t2
  » correlated columns: (none)
  » recursive: false

-> mainSubquery
   » table alias: __subquery0003
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT r_name FROM region"

-> -> -> projectOp
         » column: (Expr = rapidsse.public.region.r_name ; Ordinal Expr = $2)

-> -> -> -> tableScanOp
            » location: all partitions
            » table: (rapidsse.public.region)

∆ mainSubquery
  » table alias: __subquery0004
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM t1 UNION ALL SELECT * FROM t2"

-> -> unionOp
      » location: origin
      » isDistinct: (false)

-> -> -> statementMarker: select
         » queryText: "SELECT * FROM t1"

-> -> -> -> projectOp
            » column: (Expr = t1.n_name ; Ordinal Expr = $1)

-> -> -> -> -> subqueryRefOp
               » location: all partitions
               » alias: (t1)
               » params: t1()
               » ordinal params: t1()

-> -> -> statementMarker: select
         » queryText: "SELECT * FROM t2"

-> -> -> -> projectOp
            » column: (Expr = t2.r_name ; Ordinal Expr = $1)

-> -> -> -> -> subqueryRefOp
               » location: all partitions
               » alias: (t2)
               » params: t2()
               » ordinal params: t2()' )


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Partitioning of basic table subquery
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// There are 4 main combinations to test:
//  - Table subquery is partitionable & main subquery is partitionable.
//  - Table subquery is not partitionable & main subquery is partitionable.
//  - Table subquery is partitionable & main subquery is not partitionable.
//  - Table subquery is not partitionable & main subquery is not partitionable.

// Table subquery is partitionable & main subquery is partitionable.
// Table subquery should finish on all partitions and main subquery should start on all partitions.
EXPLAIN stage partitionExplain
WITH t1 as (SELECT * FROM nation)
SELECT n_nationkey FROM t1;

unordered rows: 
  (*, 'partitionExplain', '
∆ tableSubquery
  » table alias: t1
  » correlated columns: (none)
  » recursive: false

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT * FROM nation"

-> -> -> projectOp
         » column: (Alias = N_NATIONKEY ; Expr = rapidsse.public.nation.N_NATIONKEY ; Ordinal Expr = $1)
         » column: (Alias = N_NAME ; Expr = rapidsse.public.nation.N_NAME ; Ordinal Expr = $2)
         » column: (Alias = N_REGIONKEY ; Expr = rapidsse.public.nation.N_REGIONKEY ; Ordinal Expr = $3)
         » column: (Alias = N_COMMENT ; Expr = rapidsse.public.nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> -> tableScanOp
            » location: all partitions
            » table: (rapidsse.public.nation)

∆ mainSubquery
  » table alias: __subquery0003
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT n_nationkey FROM t1"

-> -> projectOp
      » column: (Expr = t1.n_nationkey ; Ordinal Expr = $1)

-> -> -> subqueryRefOp
         » location: all partitions
         » alias: (t1)
         » params: t1()
         » ordinal params: t1()' )


// Table subquery is not partitionable & main subquery is partitionable.
// Table subquery should finish on origin and main subquery should start on origin.
EXPLAIN stage partitionExplain
WITH t1 as (SELECT COUNT(n_nationkey) FROM nation GROUP BY n_nationkey)
SELECT * FROM t1;

