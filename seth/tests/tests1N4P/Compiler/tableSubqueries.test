// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

_nation;
success
  // N_NATIONKEY
  // N_NAME
  // N_REGIONKEY
  // N_COMMENT

_region;
success
  // R_REGIONKEY
  // R_NAME
  // R_COMMENT

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic table subquery examples from WITH clauses
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// Basic positive test
EXPLAIN WITH t1 AS (SELECT * FROM nation) SELECT * FROM t1;

unordered rows: 
  (*, 'explainPlan', '
∆ tableSubquery
  » table alias: t1
  » correlated columns: (none)
  » recursive: false

-> mainSubquery
   » table alias: __subquery0002
   » correlated columns: (none)

-> -> statementMarker: select
      » queryText: "SELECT * FROM nation"

-> -> -> projectOp
         » column: (Alias = N_NATIONKEY ; Expr = rapidsse.public.nation.N_NATIONKEY ; Ordinal Expr = $1)
         » column: (Alias = N_NAME ; Expr = rapidsse.public.nation.N_NAME ; Ordinal Expr = $2)
         » column: (Alias = N_REGIONKEY ; Expr = rapidsse.public.nation.N_REGIONKEY ; Ordinal Expr = $3)
         » column: (Alias = N_COMMENT ; Expr = rapidsse.public.nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.nation)

∆ mainSubquery
  » table alias: __subquery0003
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM t1"

-> -> projectOp
      » column: (Expr = t1.N_NATIONKEY ; Ordinal Expr = $1)
      » column: (Expr = t1.N_NAME ; Ordinal Expr = $2)
      » column: (Expr = t1.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Expr = t1.N_COMMENT ; Ordinal Expr = $4)

-> -> -> subqueryRefOp
         » alias: (t1)
         » params: t1()
         » ordinal params: t1()' )


