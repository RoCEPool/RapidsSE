      » column: (Expr = nation.N_NAME ; Ordinal Expr = $2)
      » column: (Expr = nation.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Expr = nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> subqueryRefOp
         » alias: (nation)
         » params: nation()
         » ordinal params: nation()' )



