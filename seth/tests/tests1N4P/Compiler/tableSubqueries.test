// Test that too many column aliases is an error
EXPLAIN WITH t1 (c1, c2, c3, c4, c5) AS (SELECT * FROM nation) SELECT * FROM t1;
failure contains: 'too many named columns in WITH clause: common table expression t1'


// Test that when the table alias is the same as a real table, the table alias shadows the real table
EXPLAIN WITH nation AS (SELECT * FROM region) SELECT * FROM nation;

