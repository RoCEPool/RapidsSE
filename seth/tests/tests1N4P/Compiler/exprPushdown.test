/*----------------------------------------------------------------------------*/
/* Expr Pushdown semantic tests                                               */
/*----------------------------------------------------------------------------*/

-- This tests whether intermediate (working) columns that are referenced above
-- ProjectOps/AggregateOps are identified and pushed down into the nearest
-- ProjectOp. We already have a post-project stage that stops these intermediate
-- columns from being output, but we need to ensure that these intermediate
-- expressions are calculated and projected for SQL operators upstream to use.
-- This typically occurs in the HAVING or ORDER BY clauses, but can also apply
-- to GROUP BY expressions too (particularly when the plan is partitioned).

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

create table nation (
	 N_NATIONKEY       INTEGER NOT NULL,
	 N_NAME            CHAR(25) NOT NULL,
	 N_REGIONKEY       INTEGER NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success

trackmemory;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Basic tests
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Expr pushdown required because n_nationkey is not being projected (ORDER BY clause)
EXPLAIN SELECT n_name FROM nation ORDER BY n_nationkey;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation ORDER BY n_nationkey"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)

-> -> -> orderOp
         » order expr: ((rapidsse.public.nation.n_nationkey) ASC)
         » ordinal order expr: (($2) ASC)

-> -> -> -> projectOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- OrderOp with more than one order item (both to be pushed down)
EXPLAIN SELECT n_name FROM nation ORDER BY n_nationkey, n_regionkey;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation ORDER BY n_nationkey, n_regionkey"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)

-> -> -> orderOp
         » order expr: ((rapidsse.public.nation.n_nationkey) ASC, (rapidsse.public.nation.n_regionkey) ASC)
         » ordinal order expr: (($2) ASC, ($3) ASC)

-> -> -> -> projectOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
            » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- OrderOp with more than one order item (first to be pushed down)
EXPLAIN SELECT n_name, n_regionkey FROM nation ORDER BY n_nationkey, n_regionkey;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, n_regionkey FROM nation ORDER BY n_nationkey, n_regionkey"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $2)

-> -> -> orderOp
         » order expr: ((rapidsse.public.nation.n_nationkey) ASC, (rapidsse.public.nation.n_regionkey) ASC)
         » ordinal order expr: (($3) ASC, ($2) ASC)

-> -> -> -> projectOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
            » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- OrderOp with more than one order item (last to be pushed down)
EXPLAIN SELECT n_name, n_nationkey FROM nation ORDER BY n_nationkey, n_regionkey;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, n_nationkey FROM nation ORDER BY n_nationkey, n_regionkey"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $2)

-> -> -> orderOp
         » order expr: ((rapidsse.public.nation.n_nationkey) ASC, (rapidsse.public.nation.n_regionkey) ASC)
         » ordinal order expr: (($2) ASC, ($3) ASC)

-> -> -> -> projectOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
            » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)')


-- HAVING expression to be pushed down (1)
EXPLAIN SELECT n_name FROM nation GROUP BY n_name HAVING SUM(n_nationkey) > 0;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name FROM nation GROUP BY n_name HAVING SUM(n_nationkey) > 0"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)

-> -> -> filterOp
         » expr: ((SUM(rapidsse.public.nation.n_nationkey)) > 0)
         » ordinal expr: ($2 > 0)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))
            » group by: (rapidsse.public.nation.n_name) ; Ordinal Exprs = ($2)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- HAVING expression to be pushed down (1)
EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name HAVING SUM(n_nationkey) > 0;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name HAVING SUM(n_nationkey) > 0"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: ((SUM(rapidsse.public.nation.n_nationkey)) > 0)
         » ordinal expr: ($3 > 0)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))
            » group by: (rapidsse.public.nation.n_name) ; Ordinal Exprs = ($2)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- HAVING expression with grand total
EXPLAIN SELECT 1 FROM nation HAVING SUM(n_nationkey) > 0;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT 1 FROM nation HAVING SUM(n_nationkey) > 0"

-> -> projectOp
      » column: (Expr = 1 ; Ordinal Expr = $1)

-> -> -> filterOp
         » expr: ((SUM(rapidsse.public.nation.n_nationkey)) > 0)
         » ordinal expr: ($2 > 0)

-> -> -> -> projectOp
            » column: (Expr = 1 ; Ordinal Expr = 1)
            » column: (Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- Both ORDER BY and HAVING expressions to be pushed down
EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name HAVING SUM(n_nationkey) > 0 ORDER BY SUM(n_nationkey);
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name HAVING SUM(n_nationkey) > 0 ORDER BY SUM(n_nationkey)"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> orderOp
         » order expr: ((SUM(rapidsse.public.nation.n_nationkey)) ASC)
         » ordinal order expr: (($3) ASC)

-> -> -> -> filterOp
            » expr: ((SUM(rapidsse.public.nation.n_nationkey)) > 0)
            » ordinal expr: ($3 > 0)

-> -> -> -> -> aggregateOp
               » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
               » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
               » column: (Expr = SUM(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($1))
               » group by: (rapidsse.public.nation.n_name) ; Ordinal Exprs = ($2)

-> -> -> -> -> -> tableScanOp
                  » table: (rapidsse.public.nation)'
)


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Partial expressions
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- ORDER BY partial expression to be pushed down (1)
-- EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name ORDER BY SUM(n_regionkey);  -- <--- does not leak
EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name ORDER BY SUM(n_regionkey) / COUNT(n_nationkey);
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name ORDER BY SUM(n_regionkey) / COUNT(n_nationkey)"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> orderOp
         » order expr: (((SUM(rapidsse.public.nation.n_regionkey)) / (COUNT(rapidsse.public.nation.n_nationkey))) ASC)
         » ordinal order expr: (($2 / $3) ASC)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = COUNT(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = COUNT($1))
            » group by: (rapidsse.public.nation.n_name) ; Ordinal Exprs = ($2)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- ORDER BY partial expression to be pushed down (2)
EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name ORDER BY COUNT(n_nationkey) * (1 + SUM(n_regionkey));
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name ORDER BY COUNT(n_nationkey) * (1 + SUM(n_regionkey))"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> orderOp
         » order expr: (((COUNT(rapidsse.public.nation.n_nationkey)) * (1 + (SUM(rapidsse.public.nation.n_regionkey)))) ASC)
         » ordinal order expr: (($3 * (1 + $2)) ASC)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = COUNT(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = COUNT($1))
            » group by: (rapidsse.public.nation.n_name) ; Ordinal Exprs = ($2)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- ORDER BY partial expression to be pushed down (3)
EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name ORDER BY SUM(n_regionkey) / ( SUM(n_regionkey) + COUNT(n_nationkey) );
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name ORDER BY SUM(n_regionkey) / ( SUM(n_regionkey) + COUNT(n_nationkey) )"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> orderOp
         » order expr: (((SUM(rapidsse.public.nation.n_regionkey)) / ((SUM(rapidsse.public.nation.n_regionkey)) + (COUNT(rapidsse.public.nation.n_nationkey)))) ASC)
         » ordinal order expr: (($2 / ($2 + $3)) ASC)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = COUNT(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = COUNT($1))
            » group by: (rapidsse.public.nation.n_name) ; Ordinal Exprs = ($2)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- HAVING partial expression to be pushed down (1)
EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name HAVING SUM(n_regionkey) > COUNT(n_nationkey);
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name HAVING SUM(n_regionkey) > COUNT(n_nationkey)"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: ((SUM(rapidsse.public.nation.n_regionkey)) > (COUNT(rapidsse.public.nation.n_nationkey)))
         » ordinal expr: ($2 > $3)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = COUNT(rapidsse.public.nation.n_nationkey) ; Ordinal Expr = COUNT($1))
            » group by: (rapidsse.public.nation.n_name) ; Ordinal Exprs = ($2)

-> -> -> -> -> tableScanOp
