)


-- HAVING partial expression to be pushed down (2)
EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name, n_regionkey, n_nationkey HAVING SUM(n_regionkey) > (n_regionkey + n_nationkey);
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name, n_regionkey, n_nationkey HAVING SUM(n_regionkey) > (n_regionkey + n_nationkey)"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: ((SUM(rapidsse.public.nation.n_regionkey)) > (rapidsse.public.nation.n_regionkey + rapidsse.public.nation.n_nationkey))
         » ordinal expr: ($2 > $3)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = rapidsse.public.nation.n_regionkey + rapidsse.public.nation.n_nationkey ; Ordinal Expr = $3 + $1)
            » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
            » column: (Expr = rapidsse.public.nation.n_nationkey ; Ordinal Expr = $1)
            » group by: (rapidsse.public.nation.n_name)
            » group by: (rapidsse.public.nation.n_regionkey)
            » group by: (rapidsse.public.nation.n_nationkey) ; Ordinal Exprs = ($2) ; Ordinal Exprs = ($3) ; Ordinal Exprs = ($1)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


-- SUM() with two columnRefs
EXPLAIN SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name HAVING SUM(n_regionkey + n_nationkey) > 0;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_name, SUM(n_regionkey) FROM nation GROUP BY n_name HAVING SUM(n_regionkey + n_nationkey) > 0"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: ((SUM(rapidsse.public.nation.n_regionkey + rapidsse.public.nation.n_nationkey)) > 0)
         » ordinal expr: ($3 > 0)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_name ; Ordinal Expr = $2)
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey + rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($3 + $1))
            » group by: (rapidsse.public.nation.n_name) ; Ordinal Exprs = ($2)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)

-- SUM(columnRef1 + columnRef2) + columnRef
EXPLAIN SELECT n_regionkey, SUM(n_regionkey) FROM nation GROUP BY n_regionkey HAVING SUM(n_regionkey + n_nationkey) + n_regionkey> 0;
rows: (*,'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_regionkey, SUM(n_regionkey) FROM nation GROUP BY n_regionkey HAVING SUM(n_regionkey + n_nationkey) + n_regionkey> 0"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $1)
      » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = $2)

-> -> -> filterOp
         » expr: (((SUM(rapidsse.public.nation.n_regionkey + rapidsse.public.nation.n_nationkey)) + rapidsse.public.nation.n_regionkey) > 0)
         » ordinal expr: (($3 + $1) > 0)

-> -> -> -> aggregateOp
            » column: (Expr = rapidsse.public.nation.n_regionkey ; Ordinal Expr = $3)
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey) ; Ordinal Expr = SUM($3))
            » column: (Expr = SUM(rapidsse.public.nation.n_regionkey + rapidsse.public.nation.n_nationkey) ; Ordinal Expr = SUM($3 + $1))
            » group by: (rapidsse.public.nation.n_regionkey) ; Ordinal Exprs = ($3)

-> -> -> -> -> tableScanOp
               » table: (rapidsse.public.nation)'
)


