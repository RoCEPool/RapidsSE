rows:
(
*,
'explainPlan','
∆ mainSubquery

-> statementMarker: select
   » queryText: "SELECT n_nationkey + 1, SUM(n_regionkey) FROM nation GROUP BY n_nationkey"

-> -> projectOp
      » column: (Expr = rapidsse.public.nation.n_nationkey + 1 ; Ordinal Expr = $1)
