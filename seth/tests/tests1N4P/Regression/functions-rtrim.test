// Source file: /home/arjun/qa/queries/functions/rtrim/rrtrim3.sql
// Result file: /home/arjun/qa/queries/functions/rtrim/results/rtrim3.res
select case when colb1 like 'ora%' then rtrim(colb1,'nge') when colb1 like 'ORA%' then rtrim(colb1,'NGE') else colb1 end, colb1 from table1 where colb1 like 'or%' or colb1 like 'OR%' order by pcol1;
ordered rows:
  ('ora', 'orange')
  ('ora', 'orange')
  ('ORA', 'ORANGE')
  ('ora', 'orange')
  ('ORA', 'ORANGE')
  ('ora', 'orange')
  ('ora', 'orange')

