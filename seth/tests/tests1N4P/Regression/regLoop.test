--------------------------------------------------------------------------------
-- regression tests in a loop
--------------------------------------------------------------------------------

// Logging a message
LOG 'Running regression tests in a loop.';

LOOP 1 {

trackMemory;
success;

//------------------------------------------------------------------------------
LOG 'Create schema ...';
INCLUDE 'regrCreateSchema.test';

//------------------------------------------------------------------------------
LOG 'Load data ...';
INCLUDE 'regrLoadData.test';

//LOG 'Running regression tests...';

//------------------------------------------------------------------------------
LOG 'AndOrNot.test ...';
INCLUDE 'AndOrNot.test';

LOG 'inNotIn.test ...';
INCLUDE 'InNotIn.test';

//INCLUDE 'PartKey1way.test';
//INCLUDE 'PartKey2way.test';
//INCLUDE 'Stage9.test';
//INCLUDE 'Using1way.test';

//LOG 'aggs-avg.test ...';
//INCLUDE 'aggs-avg.test';

LOG 'aggs-count.test ...';
INCLUDE 'aggs-count.test';

LOG 'aggs-max.test ...';
INCLUDE 'aggs-max.test';

LOG 'aggs-min.test ...';
INCLUDE 'aggs-min.test';

LOG 'aggs-sum.test ...';
INCLUDE 'aggs-sum.test';

LOG 'alias.test ...';
INCLUDE 'alias.test';

LOG 'aliasSelAll.test ...';
INCLUDE 'aliasSelAll.test';

LOG 'between.test ...';
INCLUDE 'between.test';

LOG 'case.test ...';
INCLUDE 'case.test';


LOG 'cast.test ...';
INCLUDE 'cast.test';


//INCLUDE 'ctas.test';

//INCLUDE 'except.test';
//INCLUDE 'exists.test';
//INCLUDE 'functions-abs.test';
//INCLUDE 'functions-ceil.test';
//INCLUDE 'functions-char.test';
//INCLUDE 'functions-charlen.test';
//INCLUDE 'functions-coal.test';
//INCLUDE 'functions-concat.test';

LOG 'functions-extract.test ...';
INCLUDE 'functions-extract.test';

//INCLUDE 'functions-floor.test';
//INCLUDE 'functions-left.test';
//INCLUDE 'functions-lower.test';
//INCLUDE 'functions-mod.test';
//INCLUDE 'functions-position.test';
//INCLUDE 'functions-power.test';
//INCLUDE 'functions-right.test';
//INCLUDE 'functions-round.test';
//INCLUDE 'functions-rtrim.test';

LOG 'functions-substr.test ...';
INCLUDE 'functions-substr.test';

//INCLUDE 'functions-trim.test';
//INCLUDE 'functions-upper.test';

LOG 'having.test ...';
INCLUDE 'having.test';

//INCLUDE 'intersect.test';
//INCLUDE 'intervals.test';

LOG 'isnull.test ...';
INCLUDE 'isnull.test';

//LOG 'joinTests.test ...';
//INCLUDE 'joinTests.test';

LOG 'like.test ...';
INCLUDE 'like.test';

//INCLUDE 'subqueries-select.test';
//INCLUDE 'subqueries-where-single.test';

//------------------------------------------------------------------------------
LOG 'Drop schema ...';
INCLUDE 'regrDropSchema.test';

MemoryLeaks;
rows: 0

} -- end of loop

CLEANUP {

  drop table ${testName}_TABLE1;
  mute

  drop table ${testName}_TABLE2;
  mute

  drop table ${testName}_TABLE3;
  mute

  drop table ${testName}_TABLE4;
  mute

  drop table ${testName}_TABLE5;
  mute

  drop table ${testName}_TABLE6;
  mute

  drop table ${testName}_TABLE7;
  mute

  drop table ${testName}_TABLE8;
  mute

  drop table ${testName}_TABLE9;
  mute

  drop table ${testName}_CUSTOMERH;
  mute

  drop table ${testName}_ORDERS;
  mute

  drop table ${testName}_LINEITEM;
  mute

  drop table ${testName}_PART;
  mute

  drop table ${testName}_SUPPLIER;
  mute

  drop table ${testName}_PARTSUPP;
  mute

  drop table ${testName}_NATION;
  mute

  drop table ${testName}_REGION;
  mute

  drop table ${testName}_SHIPPING;
  mute

  drop table ${testName}_SHIPADDRESS;
  mute

  drop table ${testName}_MANUFACTURER;
  mute

  drop table ${testName}_RETURNITEMS;
  mute

  bye;
  mute
}

