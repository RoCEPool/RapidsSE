// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// UNICAST
select count(*)
  from Customer,
       Orders
 where C_CUSTKEY  = O_CUSTKEY;
rows:
  (1500)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// HASHCAST
select count(*)
  from Lineitem,
       Orders
 where L_ORDERKEY  = O_ORDERKEY;
rows:
  (5996)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// BROADCAST
select count(*)
  from Lineitem,
       PartSupp
 where L_SUPPKEY  = PS_SUPPKEY;
rows:
 (576000)

