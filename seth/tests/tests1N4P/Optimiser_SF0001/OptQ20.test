--------------------------------------------------------------------------------
-- tpch query20 (SF_0001)
--------------------------------------------------------------------------------

/pipelineName = "OptQ20"
select s_name, s_address
  from ${testName}_supplier, ${testName}_nation
  where s_suppkey in (
    select ps_suppkey
      from ${testName}_partsupp
      where ps_partkey in (
        select p_partkey
          from ${testName}_part
          where p_name like 'forest%' )
     and ps_availqty > (
       select 0.5 * sum(l_quantity)
       from ${testName}_lineitem
       where l_partkey = ps_partkey
         and l_suppkey = ps_suppkey
         and l_shipdate >= '1994-01-01'
         and l_shipdate < '1995-01-01' ) )
  and s_nationkey = n_nationkey
  and n_name = 'IRAQ'
  order by s_name;

rows:
  ('Supplier#000000005','Gcdm2rJRzl5qlTVzc')

CLEANUP {
  bye;
  mute
}


