--------------------------------------------------------------------------------
-- tpch query18 (SF_0001)
--------------------------------------------------------------------------------
trackmemory force;
success

/pipelineName = "OptQ18"
select
  c_name,
  c_custkey,
  o_orderkey,
  o_orderdate,
  o_totalprice,
  sum(l_quantity)
from
  ${testName2}_orders,
  ${testName2}_customer,
  ${testName2}_lineitem
where
  o_orderkey in
    (
    select
      l_orderkey
    from
      ${testName2}_lineitem
    group by
      l_orderkey
    having
      sum(l_quantity) > 100
    )
  and c_custkey = o_custkey
  and o_orderkey = l_orderkey
group by
  c_name,
  c_custkey,
  o_orderkey,
  o_orderdate,
  o_totalprice
order by
  o_totalprice desc,
  o_orderdate;

