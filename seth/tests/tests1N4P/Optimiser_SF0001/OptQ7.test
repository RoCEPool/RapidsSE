--------------------------------------------------------------------------------
-- tpch query7 (SF_0001)
--------------------------------------------------------------------------------
trackmemory force;
success

/pipelineName = "OptQ7"
select supp_nation,
  cust_nation,
  l_year,
  sum(volume) as revenue
from (
  select
    n1.n_name as supp_nation,
    n2.n_name as cust_nation,
    extract(year from l_shipdate) as l_year,
    l_extendedprice * (1 - l_discount) as volume
  from
    ${testName2}_supplier,
    ${testName2}_lineitem,
    ${testName2}_orders,
    ${testName2}_customer,
    ${testName2}_nation n1,
    ${testName2}_nation n2
  where
    s_suppkey = l_suppkey
    and o_orderkey = l_orderkey
    and c_custkey = o_custkey
    and s_nationkey = n1.n_nationkey
    and c_nationkey = n2.n_nationkey
    and (   (n1.n_name = 'IRAN'    and n2.n_name = 'GERMANY')
         or (n1.n_name = 'GERMANY' and n2.n_name = 'IRAN'))
    and l_shipdate between '1995-01-01' and '1996-12-31'
  )as shipping
group by
  supp_nation,
  cust_nation,
  l_year
order by
  supp_nation,
  cust_nation,
  l_year;

rows:
  ('IRAN','GERMANY',1995,-7157.99)
  ('IRAN','GERMANY',1996,-14234.13)

MemoryLeaks;
rows: 0

CLEANUP {
}


