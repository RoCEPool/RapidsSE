--------------------------------------------------------------------------------
-- tpch query4 (SF_0001)
--------------------------------------------------------------------------------
trackmemory force;
success

select o_orderpriority,
  count(*) as order_count
from
  orders
where o_orderdate >= DATE '1993-07-01'
  and o_orderdate < DATE '1993-10-01'
  and
exists (
  select
    *
  from
    lineitem
  where
    l_orderkey = o_orderkey
    and l_commitdate < l_receiptdate
  )
group by
  o_orderpriority
order by
  o_orderpriority;

rows:
 ('1-URGENT',9)
 ('2-HIGH',7)
 ('3-MEDIUM',13)
 ('4-NOT SPECIFIED',8)
 ('5-LOW',12)

MemoryLeaks;
 rows: 0

CLEANUP {
  bye;
  mute
}


