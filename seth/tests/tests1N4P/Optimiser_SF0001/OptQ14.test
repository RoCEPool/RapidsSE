--------------------------------------------------------------------------------
-- tpch query14 (SF_0001)
--------------------------------------------------------------------------------
trackMemory;
success

/optimise
/glean_cue_from = "vS35X_T10_Push_sqB_Into_mqA"
/glean_interactive
/transliterated
/weaved
/pipelineName = "_r_Q14"
select
  100.00 * sum(case
    when p_type like 'PROMO%'
    then l_extendedprice*(1-l_discount)
    else 0
    end) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue
from
  lineitem,
  part
where
  l_partkey = p_partkey
  and l_shipdate >= DATE '1995-09-01'
  and l_shipdate < DATE '1995-10-01';
rows:
  (19.25)

MemoryLeaks;
rows: 0

CLEANUP {
  bye;
  mute
}


