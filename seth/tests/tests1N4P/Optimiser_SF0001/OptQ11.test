--------------------------------------------------------------------------------
-- tpch query11 (SF_0001)
--------------------------------------------------------------------------------
trackmemory force;
success

/pipelineName = "OptQ11"
select
  ps_partkey,
  sum(ps_supplycost * ps_availqty) as value
from
  Optimiser_SF0001_tpchLoop_partsupp,
  Optimiser_SF0001_tpchLoop_supplier,
  Optimiser_SF0001_tpchLoop_nation
where
  ps_suppkey = s_suppkey
  and s_nationkey = n_nationkey
  and n_name = 'IRAQ'
group by
  ps_partkey having
    sum(ps_supplycost * ps_availqty) >
    (
      select
        sum(ps_supplycost * ps_availqty) * 0.0001
      from
        Optimiser_SF0001_tpchLoop_partsupp,
        Optimiser_SF0001_tpchLoop_supplier,
        Optimiser_SF0001_tpchLoop_nation
      where
        ps_suppkey = s_suppkey
        and s_nationkey = n_nationkey
        and n_name = 'IRAQ'
    )
order by
   value desc;

