--------------------------------------------------------------------------------
-- tpch query3 (SF_0001)
--------------------------------------------------------------------------------
trackmemory force;
success

/pipelineName = "OptQ3"
select l_orderkey,
  sum(l_extendedprice*(1-l_discount)) as revenue,
  o_orderdate,
  o_shippriority
from
  ${testName2}_customer,
  ${testName2}_orders,
  ${testName2}_lineitem
where c_mktsegment = 'BUILDING'
  and c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and o_orderdate < '1995-03-15'
  and l_shipdate > '1995-03-15'
group by
  l_orderkey,
  o_orderdate,
  o_shippriority
order by
  revenue desc,
  o_orderdate
limit 10;

