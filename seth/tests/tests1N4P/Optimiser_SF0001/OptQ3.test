  (36,  -12668.14,DATE '1993-06-11',1)
  (498, -11984.95,DATE '1994-05-05',1)
  (673, -11831.49,DATE '1992-04-09',1)
  (381, -11178.56,DATE '1993-07-08',1)
  (1227,-10534.75,DATE '1993-10-18',1)


