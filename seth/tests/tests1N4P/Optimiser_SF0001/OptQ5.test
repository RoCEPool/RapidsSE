--------------------------------------------------------------------------------
-- tpch query5 (SF_0001)
--------------------------------------------------------------------------------
trackmemory force;
success

/pipelineName = "OptQ5"
select
  n_name,
  sum(l_extendedprice * (1 - l_discount)) as revenue
from
  ${testName2}_customer,
  ${testName2}_orders,
  ${testName2}_lineitem,
  ${testName2}_supplier,
  ${testName2}_nation,
  ${testName2}_region
where
  c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and l_suppkey = s_suppkey
  and c_nationkey = s_nationkey
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = 'AMERICA'
  and o_orderdate >= DATE '1994-01-01'
  and o_orderdate < DATE '1995-01-01'
group by
  n_name
order by
  revenue desc;

rows:
 ('PERU',-14237.80)
 ('ARGENTINA',-8058.15)

MemoryLeaks;
rows: 0

CLEANUP {
}


