/*----------------------------------------------------------------------------*/
/* lssch.test -- list schemas                                                 */
/*----------------------------------------------------------------------------*/

// track memory
trackmemory force;

success
pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// list schemas when not in schemas folder
lssch;
failure contains: 'not in schemas'

// cf to tenants
cf "tenants";
success

// list schemas when not in schemas folder
lssch;
failure contains: 'not in schemas'

// cf to boray tenant
cf "boray";
success

// list schemas when not in schemas folder
lssch;
failure contains: 'not in schemas'

// cf to catalogs
cf "catalogs";
success

// list schemas when not in schemas folder
lssch;
failure contains: 'not in schemas'

// cf to catalogs
cf "rapidsse";
success

// list schemas when not in schemas folder
lssch;
failure contains: 'not in schemas'

// cf to schemas
cf "schemas";
success

// list schemas when not in schemas folder
lssch;
rows: ('public')

create schema ${testName2}_mySchema;
success

lssch;
rows:
  ('public')
  ('${testName2}_mySchema')

drop schema ${testName2}_mySchema;
success

create schema ${testName2}_mySchema;
success

lssch;
rows:
('public')
('${testName2}_mySchema')

drop schema ${testName2}_mySchema;
success

create schema ${testName2}_mySchema;
success

lssch;
rows:
('public')
('${testName2}_mySchema')

cf ${testName2}_mySchema;
success

cf tables;
success

create table myTable (c integer);
success

cf "~schemas";
success

pwf;
rows: ('/schemas/rapidsse/catalogs/boray/tenants/')

//! ALKA ENABLE once empty folder test in place
//drop schema ${testName2}_mySchema;
//failure contains: 'folder not empty'

cf ${testName2}_mySchema;
success

cf tables;
success

drop table myTable;
success

cf ..;
success

pwf;
rows: ('/${testName2}_mySchema/schemas/rapidsse/catalogs/boray/tenants/')

cf ..;
success

pwf;
rows: ('/schemas/rapidsse/catalogs/boray/tenants/')

drop schema ${testName2}_mySchema;
success

cf "~tables";
success

pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  drop schema ${testName2}_mySchema;
  mute
  
  cf "~tables";
  mute;
  
  bye;
  mute
}

