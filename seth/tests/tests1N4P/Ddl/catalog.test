/*----------------------------------------------------------------------------*/
/* catalog.test -- list catalogs                                              */
/*----------------------------------------------------------------------------*/

// track memory
trackmemory force;
success

pwf;
rows:
  ('/tables/public/schemas/rapids/catalogs/boray/tenants/')

// list catalogs when not in catalogs folder
//lscat;
//failure contains: 'not in catalogs'

// cf to tenants
cf "~";
success

// list catalogs when not in catalogs folder
//lscat;
//failure contains: 'not in catalogs'

// cf to boray tenant
cf "boray";
success

// list catalogs when not in catalogs folder
//lscat;
//failure contains: 'not in catalogs'

// cf to catalogs
cf "catalogs";
success

// list catalogs when not in catalogs folder
select * from catalog;
contains rows: ('rapidsse')

create catalog ${testName2}_myCatalog;
success

select * from catalog;
contains rows:
  ('rapidsse')
  ('${testName2}_myCatalog')

drop catalog ${testName2}_myCatalog;
success

create catalog ${testName2}_myCatalog;
success

select * from catalog;
contains rows:
  ('rapidsse')
  ('${testName2}_myCatalog')

cf ${testName2}_myCatalog;
success

cf schemas;
success

create schema mySchema;
success

cf "~catalogs";
success

pwf;
rows: ('/catalogs/boray/tenants/')

//! ALKA ENABLE once empty folder test in place
//drop catalog ${testName2}_myCatalog;
//failure contains: 'folder not empty'

cf ${testName2}_myCatalog;
success

cf schemas;
success

drop schema mySchema;
success

cf ..;
success

pwf;
rows: ('/${testName2}_myCatalog/catalogs/boray/tenants/')

cf ..;
success

pwf;
rows: ('/catalogs/boray/tenants/')

drop catalog ${testName2}_myCatalog;
success

cf "~tables";
success

pwf;
rows:
  ('/tables/public/schemas/rapids/catalogs/boray/tenants/')

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  drop catalog ${testName2}_myCatalog;
  mute
  
  cf "~tables";
  mute;
}

