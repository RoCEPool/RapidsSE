/*----------------------------------------------------------------------------*/
/* catalog.test -- list catalogs                                              */
/*----------------------------------------------------------------------------*/

// track memory
trackMemory;
success

pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// list catalogs when not in catalogs folder
lscat;
failure contains: 'not in catalogs'

// cf to tenants
cf "~";
success

// list catalogs when not in catalogs folder
lscat;
failure contains: 'not in catalogs'

// cf to boray tenant
cf "boray";
success

// list catalogs when not in catalogs folder
lscat;
failure contains: 'not in catalogs'

// cf to catalogs
cf "catalogs";
success

// list catalogs when not in catalogs folder
lscat;
rows: ('rapidsse')

create catalog ${testName}_myCatalog;
success

lscat;
rows:
  ('rapidsse')
  ('${testName}_myCatalog')

drop catalog ${testName}_myCatalog;
success

create catalog ${testName}_myCatalog;
success

lscat;
rows:
  ('rapidsse')
  ('${testName}_myCatalog')

cf ${testName}_myCatalog;
success

cf schemas;
success

create schema mySchema;
success

cf "~catalogs";
success

pwf;
rows: ('/catalogs/boray/tenants/')

//! ALKA ENABLE once empty folder test in place
//drop catalog ${testName}_myCatalog;
//failure contains: 'folder not empty'

cf ${testName}_myCatalog;
success

cf schemas;
success

drop schema mySchema;
success

cf ..;
success

pwf;
rows: ('/${testName}_myCatalog/catalogs/boray/tenants/')

cf ..;
success

pwf;
rows: ('/catalogs/boray/tenants/')

drop catalog ${testName}_myCatalog;
success

cf "~tables";
success

pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  drop catalog ${testName}_myCatalog;
  mute
  
  cf "~tables";
  mute;
  
  bye;
  mute
}

