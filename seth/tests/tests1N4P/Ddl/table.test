// (11) create table with two columns that have same name
create table ${testName2}_T1 (
  c1   INTEGER NOT NULL, 
  c1   VARCHAR(32) NOT NULL
);
failure contains: 'duplicate column'

// (12) try create table t1 with no columns
create table ${testName2}_T1 (
);
failure contains: 'invalid command'

// (13) try create table t1 with invalid table name
create table ${testName2}_T1& (
  c1   INTEGER NOT NULL
);
failure contains: 'token recognition error at: ''&'''

// (14) try create table t1 with invalid column name
create table ${testName2}_T1 (
  c1&  INTEGER NOT NULL
);
failure contains: 'token recognition error at: ''&'''

// (15) try create table t1 with invalid column type
create table ${testName2}_T1 (
  c1  NOSUCHTYPE NOT NULL
);
failure contains: 'EC_SYNTAX_ERROR; Line: 2; Column: 6; mismatched input ''NOSUCHTYPE'''

// (16) try create table t1 with invalid null
create table ${testName2}_T1 (
                 c1  integer NOT NUKK
                 );
failure contains: 'EC_SYNTAX_ERROR; Line: 2; Column: 33; mismatched input ''NUKK'' expecting SQL_NULL'

///////////
// lscol //
///////////

// lscol on invalid table
lscol noTable;
failure contains: 'Table does not exist'

// (17) create table t1
create table ${testName2}_T1 (
   key   INTEGER NOT NULL,
   name  VARCHAR(32) NOT NULL
   );
success

// move to tenants
// cf ~;
// success
//
// // lscol not in tables
// lscol ${testName2}_T1;
// failure contains: 'not in tables'
//
// // move to tables folder
// cf "~tables";
// success

// lscol
lscol ${testName2}_T1;
rows:
  ('key','INTEGER',19,0,false,true)
  ('name','VARCHAR',32,null,false,false)

// () drop table t1
drop table ${testName2}_T1 ;
success

///////////////
// lsPtncol //
///////////////

// lsPtncol on invalid table
lsPtncol noTable;
failure contains: 'Table does not exist'

// (17) create table t1
create table ${testName2}_T1 (
   key   INTEGER NOT NULL,
   name  VARCHAR(32) NOT NULL
);
success

// // move to tenants
// cf ~;
// success
//
// // lsPtncol not in tables
// lsPtncol ${testName2}_T1;
// failure contains: 'not in tables'
//
// // move to tables folder
// cf "~tables";
// success

//  // move to tenants
//  cf ~;
//  success
//
//  // lsPtncol not in tables
//  lsPtncol T1;
//  failure contains: 'not in tables'
//
//  // move to tables folder
//  cf "~tables";
//  success

// lsPtncol
lsPtncol ${testName2}_T1;
rows:
 ('key','INTEGER',19,0,false,true)

// () drop table t1
drop table ${testName2}_T1 ;
success

// (17) create table t1
create table ${testName2}_T1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
) partition by (name);
success

// lsPtncol
lsPtncol ${testName2}_T1;
rows:
  ('name','VARCHAR',32,null,false,true)

// () drop table t1
drop table ${testName2}_T1 ;
success

