/*----------------------------------------------------------------------------*/
/* create table tests                                                         */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

//////////////////
// create table //
//////////////////

// (1) create table t1
create table ${testName2}_T1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

// (2) drop table t1
drop table ${testName2}_T1 ;
success

// (3) drop a non-existent table
drop table ${testName2}_T1 ;
failure contains: 'Table does not exist'

// (4) create table t1 again
create table ${testName2}_T1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

// (5) try create table t1 again when t1 exists
create table ${testName2}_T1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
failure contains: 'table exists'

// (6) drop table t1
drop table ${testName2}_T1 ;
success

// the following crashes SE
// create table with an name longer than 32 chars
/*
//(7) create table T1abcdefghijklmnopqrstuvwxyz0123456789 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
);
success
*/

// (8) invalid syntax (missing ',')
create table ${testName2}_T1 (
  key   INTEGER NOT NULL 
  name  VARCHAR(32) NOT NULL
);
failure contains: 'EC_SYNTAX_ERROR; Line: 3; Column: 2; mismatched input ''name'''

// (9) create table with all types
create table ${testName2}_T1 (
  c1  boolean     NOT NULL,
  c2  date        NOT NULL, 
  c3  decimal     NOT NULL, 
  c4  float       NOT NULL, 
  c5  integer     NOT NULL, 
  c6  integer     NOT NULL,  //c6  interval    NOT NULL,
  c7  time        NOT NULL, 
  c8  timestamp   NOT NULL, 
  c9  varchar(32) NOT NULL
);
success

// (10) drop table
drop table ${testName2}_T1 ;
success

// (9) create table with 48 columns
create table ${testName2}_T1 (
c0 boolean NOT NULL,
c1 boolean NOT NULL,
c2 boolean NOT NULL,
c3 boolean NOT NULL,
c4 boolean NOT NULL,
c5 boolean NOT NULL,
c6 boolean NOT NULL,
