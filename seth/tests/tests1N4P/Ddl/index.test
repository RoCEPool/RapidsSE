/*----------------------------------------------------------------------------*/
/* create index tests                                                         */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// (1) create an index (syntax error)
create index on ${testName2}_T1 (key);
failure contains: 'invalid command'

// (2) create an index (syntax error)
create index idx ${testName2}_T1 (key);
failure contains: 'invalid command'

// (3) create an index (syntax error)
create index idx on (key);
failure contains: 'invalid command'

// (4) create an index (syntax error)
//create idx on ${testName2}_T1 (key);
//failure contains: 'invalid command'

//! ALKA : come back to next few tests
//! should be invalid command
// (5) create an index (syntax error)
create index idx on ${testName2}_T1;
failure contains: 'Table does not exist'

// (6) create an index (syntax error)
create index idx on ${testName2}_T1(;
failure contains: 'Table does not exist'

// (7) create an index (syntax error)
create index idx on ${testName2}_T1();
failure contains: 'Table does not exist'

// (8) create an index (syntax error)
create index idx on ${testName2}_T1(key) junk;
failure contains: 'Table does not exist'

// create a table
create table ${testName2}_T1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

// create an index
create index Idx on ${testName2}_T1 (key);
affected: 0

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
  (*, *, '${testName2}_T1', 'Idx', false, false)

// check columns of invalid table
lsidxcol ${testName2}_T2 Idx;
failure contains: 'Table does not exist'

// check columns of invalid index
lsidxcol ${testName2}_T1 Idx2;
failure contains: 'no such index'

// check columns of index when not in tables
cf ~;
success

lsidxcol ${testName2}_T1 Idx1;
failure contains: 'not in tables'

cf "~tables";
success

// check columns of index
lsidxcol ${testName2}_T1 Idx;
rows:
  ('key', 'INTEGER', 19, 0, false, true)

// drop the index
drop index ${testName2}_T1 Idx;
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
rows: 0

// create index where table does not exist
create index Idx on noTable (key);
failure contains: 'Table does not exist'

pwf;
rows:
  ('/tables/public/schemas/rapids/catalogs/boray/tenants/')

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
rows: 0

// create index where key does not exist
create index Idx on ${testName2}_T1 (noKey);
failure contains: 'invalid index column'

pwf;
rows:
  ('/tables/public/schemas/rapids/catalogs/boray/tenants/')

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
rows: 0

// create index once
create index Idx1 on ${testName2}_T1 (key);
affected: 0

// create same index again
create index Idx1 on ${testName2}_T1 (key);
failure contains: 'index exists'

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
 (*, *, '${testName2}_T1', 'Idx1', false, false)

// create another index with same column
create index Idx2 on ${testName2}_T1 (key);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
 (*, *, '${testName2}_T1', 'Idx1',false,false)
 (*, *, '${testName2}_T1', 'Idx2',false,false)

// create index with two columns
create index Idx3 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
rows: 3

// check columns of Idx3
lsidxcol ${testName2}_T1 Idx3;
rows:
 ('key', 'INTEGER', 19, 0, false, true)
 ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx4 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
 (*, *, '${testName2}_T1', 'Idx1',false,false)
 (*, *, '${testName2}_T1', 'Idx2',false,false)
 (*, *, '${testName2}_T1', 'Idx3',false,false)
 (*, *, '${testName2}_T1', 'Idx4',false,false)

// check columns of Idx4
lsidxcol ${testName2}_T1 Idx4;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx5 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1',false,false)
(*, *, '${testName2}_T1', 'Idx2',false,false)
(*, *, '${testName2}_T1', 'Idx3',false,false)
(*, *, '${testName2}_T1', 'Idx4',false,false)
(*, *, '${testName2}_T1', 'Idx5',false,false)

// check columns of Idx5
lsidxcol ${testName2}_T1 Idx5;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx6 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1',false,false)
(*, *, '${testName2}_T1', 'Idx2',false,false)
(*, *, '${testName2}_T1', 'Idx3',false,false)
(*, *, '${testName2}_T1', 'Idx4',false,false)
(*, *, '${testName2}_T1', 'Idx5',false,false)
(*, *, '${testName2}_T1', 'Idx6',false,false)

// check columns of Idx4
lsidxcol ${testName2}_T1 Idx6;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx7 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1',false,false)
(*, *, '${testName2}_T1', 'Idx2',false,false)
(*, *, '${testName2}_T1', 'Idx3',false,false)
(*, *, '${testName2}_T1', 'Idx4',false,false)
(*, *, '${testName2}_T1', 'Idx5',false,false)
(*, *, '${testName2}_T1', 'Idx6',false,false)
(*, *, '${testName2}_T1', 'Idx7',false,false)

// check columns of Idx7
lsidxcol ${testName2}_T1 Idx7;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx8 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1',false,false)
(*, *, '${testName2}_T1', 'Idx2',false,false)
(*, *, '${testName2}_T1', 'Idx3',false,false)
(*, *, '${testName2}_T1', 'Idx4',false,false)
(*, *, '${testName2}_T1', 'Idx5',false,false)
(*, *, '${testName2}_T1', 'Idx6',false,false)
(*, *, '${testName2}_T1', 'Idx7',false,false)
(*, *, '${testName2}_T1', 'Idx8',false,false)

// check columns of Idx8
lsidxcol ${testName2}_T1 Idx8;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx9 on ${testName2}_T1 (key, name);
success

drop table ${testName2}_T1;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName2}_T1;
  mute
}

