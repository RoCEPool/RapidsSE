/*----------------------------------------------------------------------------*/
/* anidx.test -- ANIDX command tests                                          */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// invalid
anidx;
failure contains: "EC_SYNTAX_ERROR; Line: 1; Column: 5; mismatched input ';'"

// invalid
anidx ${testName2}_IntTbl;
failure contains: "mismatched input ';'"

// Table does not exist
anidx ${testName2}_IntTbl int_idx1;
failure contains: "Table does not exist"

// (1) create a table
create table ${testName2}_IntTbl (
  int_col1  INTEGER NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  vch_col3  VARCHAR(32) NOT NULL,
  int_col4  INTEGER
);
success

// invalid
anidx ${testName2}_IntTbl;
failure contains: "mismatched input ';'"

// no such index
anidx ${testName2}_IntTbl int_idx1;
failure contains: "no such index"

// create indexes
create index int_idx1 on ${testName2}_IntTbl (int_col1);
success

// invalid
anidx ${testName2}_IntTbl;
failure contains: "mismatched input ';'"

// invalid
anidx ${testName2}_IntTbl idx1 idx2;
failure contains: "extraneous input 'idx2' expecting ';'"

// invalid
anidx x int_idx1;
failure contains: "Table does not exist"

// success
anidx ${testName2}_IntTbl int_idx1;
rows: 4

load ${testName2}_IntTbl "../DATA/Datums/integer.csv" ;
warning contains: '16 rows were invalid'

// check no of rows
select * from ${testName2}_IntTbl;
rows: 101

// success
anidx ${testName2}_IntTbl int_idx1;
rows: 4

// drop the table
drop table ${testName2}_IntTbl;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName2}_IntTbl;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
