--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table ${testName2}_supplier (
S_SUPPKEY       INTEGER NOT NULL,
S_NAME          VARCHAR(25) NOT NULL,
S_ADDRESS       VARCHAR(40) NOT NULL,
S_NATIONKEY     INTEGER NOT NULL,
S_PHONE         VARCHAR(15) NOT NULL,
S_ACCTBAL       DECIMAL(15,2) NOT NULL,
S_COMMENT       VARCHAR(101) NOT NULL
);
success

// load the table
load ${testName2}_supplier "../TPCH/SF1/supplier.tbl" <field_delimiter> = "|";
success

//------------------------------------------------------------------------------
// create an index on suppkey
create index idx on ${testName2}_supplier (S_SUPPKEY);
affected: 0

// check existence of index
select * from tableIndexes where TableName = '${testName2}_supplier';
contains rows:
  (*, *, '${testName2}_supplier', 'idx',false,false)

// check columns of index
select * from indexColumns where TableName = '${testName2}_supplier' and IndexName = 'idx';
contains rows:
  (*, *, '${testName2}_supplier', 'idx', 'S_SUPPKEY', 'INTEGER', 19, 0, false, true)

compactidx ${testName2}_supplier idx;
success

