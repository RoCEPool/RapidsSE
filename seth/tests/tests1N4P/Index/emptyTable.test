--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table ${testName2}_createT1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

// create an index
create index keyIdx on ${testName2}_createT1 (key);
affected: 0

// check existence of index
lsidx ${testName2}_createT1;
rows:
  ('keyIdx',false,false)

// check columns of index
lsidxcol ${testName2}_createT1 keyIdx;
rows:
  ('key', 'INTEGER', 19, 0, false, true)

// sz of index
szidx ${testName2}_createT1 keyidx;
rows: 1

// lwrsel
predicateFetch ${testName2}_createT1 "key 10 >=";
rows: 0

// uprsel
predicateFetch ${testName2}_createT1 "key 10 <=";
rows: 0

// keysel
predicateFetch ${testName2}_createT1 "key 10 =";
rows: 0

// rgesel
predicateFetch ${testName2}_createT1 "key 10 >= key 20 <= AND";
rows: 0

// drop the index keyIdx;
drop index ${testName2}_createT1 keyIdx;
success

// now drop the table
drop table ${testName2}_createT1;
success

CLEANUP {

  drop table ${testName2}_createT1;
  mute

  bye;
  mute
}

