/*----------------------------------------------------------------------------*/
/* create unqiue index tests                                                  */
/*----------------------------------------------------------------------------*/

trackmemory force;
success

// (1) create an index (syntax error)
///create unqiue index on ${testName2}_T1 (key);
//failure contains: 'invalid command'

// (2) create an index (syntax error)
create unique index idx ${testName2}_T1 (key);
failure contains: 'invalid command'

// (3) create an index (syntax error)
create unique index idx on (key);
failure contains: 'invalid command'

// (4) create an index (syntax error)
//create unique idx on ${testName2}_T1 (key);
//failure contains: 'Unknown command'

// (5) create an index (syntax error)
create unique index idx on ${testName2}_T1;
failure contains: 'Table does not exist'

// (6) create an index (syntax error)
create unique index idx on ${testName2}_T1(;
failure contains: 'Table does not exist'

// (7) create an index (syntax error)
create unique index idx on ${testName2}_T1();
failure contains: 'Table does not exist'

// (8) create an index (syntax error)
create unique index idx on ${testName2}_T1(key) junk;
failure contains: 'Table does not exist'

// create a table
create table ${testName2}_T1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

// create a unqique index
create unique index Idx on ${testName2}_T1 (key);
affected: 0

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
  (*, *, '${testName2}_T1', 'Idx', true, false)

// check columns of index
select * from indexColumns where TableName = '${testName2}_T1' and IndexName = 'Idx';
contains rows:
  (*, *, '${testName2}_T1', 'Idx', 'key', 'INTEGER', 19, 0, false, true)

// drop the index
drop index ${testName2}_T1 Idx;
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
rows: 0

// create index where table does not exist
create unique index Idx on noTable (key);
failure contains: 'Table does not exist'

pwf;
rows:
  ('/tables/public/schemas/rapids/catalogs/boray/tenants/')

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
rows: 0

// create index where key does not exist
create unique index Idx on ${testName2}_T1 (noKey);
failure contains: 'invalid index column'

pwf;
rows:
  ('/tables/public/schemas/rapids/catalogs/boray/tenants/')

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
rows: 0

// create index once
create unique index Idx1 on ${testName2}_T1 (key);
affected: 0

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1', true, false)

// create same index again
create unique index Idx1 on ${testName2}_T1 (key);
failure contains: 'index exists'

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
 (*, *, '${testName2}_T1', 'Idx1', true, false)

// create another index with same column
create unique index Idx2 on ${testName2}_T1 (key);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
 (*, *, '${testName2}_T1', 'Idx1',true,false)
 (*, *, '${testName2}_T1', 'Idx2',true,false)

// create index with two columns
create unique index Idx3 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
rows: 3

// check columns of Idx3
select * from indexColumns where TableName = '${testName2}_T1' and IndexName = 'Idx3';
contains rows:
 (*, *, '${testName2}_createT1', 'Idx3', 'key', 'INTEGER', 19, 0, false, true)
 (*, *, '${testName2}_createT1', 'Idx3', 'name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create unique index Idx4 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
 (*, *, '${testName2}_T1', 'Idx1',true,false)
 (*, *, '${testName2}_T1', 'Idx2',true,false)
 (*, *, '${testName2}_T1', 'Idx3',true,false)
 (*, *, '${testName2}_T1', 'Idx4',true,false)

// check columns of Idx4
select * from indexColumns where TableName = '${testName2}_T1' and IndexName = 'Idx4';
contains rows:
 (*, *, '${testName2}_createT1', 'Idx4', 'key', 'INTEGER', 19, 0, false, true)
 (*, *, '${testName2}_createT1', 'Idx4', 'name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create unique index Idx5 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1',true,false)
(*, *, '${testName2}_T1', 'Idx2',true,false)
(*, *, '${testName2}_T1', 'Idx3',true,false)
(*, *, '${testName2}_T1', 'Idx4',true,false)
(*, *, '${testName2}_T1', 'Idx5',true,false)

// check columns of Idx5
select * from indexColumns where TableName = '${testName2}_T1' IndexName = 'Idx5';
contains rows:
 (*, *, '${testName2}_createT1', 'Idx5', 'key', 'INTEGER', 19, 0, false, true)
 (*, *, '${testName2}_createT1',' Idx5', 'name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create unique index Idx6 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1',true,false)
(*, *, '${testName2}_T1', 'Idx2',true,false)
(*, *, '${testName2}_T1', 'Idx3',true,false)
(*, *, '${testName2}_T1', 'Idx4',true,false)
(*, *, '${testName2}_T1', 'Idx5',true,false)
(*, *, '${testName2}_T1', 'Idx6',true,false)

// check columns of Idx4
select * from indexColumns where TableName = '${testName2}_T1' IndexName = 'Idx6';
contains rows:
 (*, *, '${testName2}_createT1', 'Idx6','key', 'INTEGER', 19, 0, false, true)
 (*, *, '${testName2}_createT1', 'Idx6','name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create unique index Idx7 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1',true,false)
(*, *, '${testName2}_T1', 'Idx2',true,false)
(*, *, '${testName2}_T1', 'Idx3',true,false)
(*, *, '${testName2}_T1', 'Idx4',true,false)
(*, *, '${testName2}_T1', 'Idx5',true,false)
(*, *, '${testName2}_T1', 'Idx6',true,false)
(*, *, '${testName2}_T1', 'Idx7',true,false)

// check columns of Idx7
select * from indexColumns where TableName = '${testName2}_T1' IndexName = 'Idx7';
contains rows:
 (*, *, '${testName2}_createT1', 'Idx7','key', 'INTEGER', 19, 0, false, true)
 (*, *, '${testName2}_createT1', 'Idx7','name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create unique index Idx8 on ${testName2}_T1 (key, name);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_T1';
contains rows:
(*, *, '${testName2}_T1', 'Idx1',true,false)
(*, *, '${testName2}_T1', 'Idx2',true,false)
(*, *, '${testName2}_T1', 'Idx3',true,false)
(*, *, '${testName2}_T1', 'Idx4',true,false)
(*, *, '${testName2}_T1', 'Idx5',true,false)
(*, *, '${testName2}_T1', 'Idx6',true,false)
(*, *, '${testName2}_T1', 'Idx7',true,false)
(*, *, '${testName2}_T1', 'Idx8',true,false)

// check columns of Idx8
select * from indexColumns where TableName = '${testName2}_T1' IndexName = 'Idx8';
contains rows:
 (*, *, '${testName2}_createT1', 'Idx8','key', 'INTEGER', 19, 0, false, true)
 (*, *, '${testName2}_createT1', 'Idx8','name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create unique index Idx9 on ${testName2}_T1 (key, name);
success

drop table ${testName2}_T1;
success

memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table ${testName2}_T1;
  mute
  
  memoryLeaks;
  mute
}

