/*----------------------------------------------------------------------------*/
/* create index in a loop tests                                               */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

-- create a table
create table ${testName}_createT1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

LOOP 10  {

// create an index
create index keyIdx on ${testName}_createT1 (key);
affected: 0

// check existence of index
lsidx ${testName}_createT1;
rows:
  ('keyIdx',false,false)

// check columns of index
lsidxcol ${testName}_createT1 keyIdx;
rows:
  ('key','INTEGER',19,0,false,true)

// drop the index keyIdx;
drop index ${testName}_createT1 keyIdx;
success

} -- end of loop

// now drop the table
drop table ${testName}_createT1;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  drop table ${testName}_createT1;
  mute

  bye;
  mute
}

