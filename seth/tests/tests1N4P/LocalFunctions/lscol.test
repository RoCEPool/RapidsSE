/*----------------------------------------------------------------------------*/
/* listColumns.test -- list columns                                           */
/*----------------------------------------------------------------------------*/

// list all the functions
create table ${testName2}_lstTbl (
  bol_col1   BOOLEAN     NOT NULL,
  vch_col2   VARCHAR(32) NOT NULL,
  int_col3   INTEGER     NOT NULL,
  int_col4   INTEGER     NOT NULL,
  dec_col5   DECIMAL(10,2) NOT NULL,
  flt_col6   FLOAT       NOT NULL,
  tsp_col7   TIMESTAMP   NOT NULL,
  bol_col8   BOOLEAN
);
success

// list columns of the table
select * from columns where TableName = '${testName2}_lstTbl';
contains rows:
  (*, *, '${testName2}_lstTbl', 0, 'bol_col1',  1,'BOOLEAN',0,0,false,true)
  (*, *, '${testName2}_lstTbl', 1, 'vch_col2', 11,'VARCHAR',32,0,false,false)
  (*, *, '${testName2}_lstTbl', 2, 'int_col3',  6,'INTEGER',19,0,false,false)
  (*, *, '${testName2}_lstTbl', 3, 'int_col4',  6,'INTEGER',19,0,false,false)
  (*, *, '${testName2}_lstTbl', 4, 'dec_col5',  4,'DECIMAL',10,2,false,false)
  (*, *, '${testName2}_lstTbl', 5, 'flt_col6',  5,'FLOAT',19,0,false,false)
  (*, *, '${testName2}_lstTbl', 6, 'tsp_col7', 10,'TIMESTAMP',0,0,false,false)
  (*, *, '${testName2}_lstTbl', 7, 'bol_col8',  1,'BOOLEAN',0,0,true,false)

//// change folder
//cf ..;
//success
//
//// list columns
//lscol ${testName2}_lstTbl;
//failure contains: 'not in tables'
//
//// change folder
//cf tables;
//success

// list columns of the table
select * from columns where TableName = '${testName2}_lstTbl';
contains rows:
  (*, *, '${testName2}_lstTbl', 0, 'bol_col1',  1, 'BOOLEAN',0,0,false,true)
  (*, *, '${testName2}_lstTbl', 1, 'vch_col2', 11, 'VARCHAR',32,0,false,false)
  (*, *, '${testName2}_lstTbl', 2, 'int_col3',  6, 'INTEGER',19,0,false,false)
  (*, *, '${testName2}_lstTbl', 3, 'int_col4',  6, 'INTEGER',19,0,false,false)
  (*, *, '${testName2}_lstTbl', 4, 'dec_col5',  4, 'DECIMAL',10,2,false,false)
  (*, *, '${testName2}_lstTbl', 5, 'flt_col6',  5, 'FLOAT',19,0,false,false)
  (*, *, '${testName2}_lstTbl', 6, 'tsp_col7', 10, 'TIMESTAMP',0,0,false,false)
  (*, *, '${testName2}_lstTbl', 7, 'bol_col8',  1, 'BOOLEAN',0,0,true,false)

// drop the table
drop table ${testName2}_lstTbl;
success

CLEANUP {
  
  drop table ${testName2}_lstTbl;
  mute
}

