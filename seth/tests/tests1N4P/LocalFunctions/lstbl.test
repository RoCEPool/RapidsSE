// drop the tables
drop table ${testName2}_lstTbl1;
success

// drop the tables
drop table ${testName2}_lstTbl2;
success

CLEANUP {
  
  drop table ${testName2}_lstTbl1;
  mute

  drop table ${testName2}_lstTbl12;
  mute
}

