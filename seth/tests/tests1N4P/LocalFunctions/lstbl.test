/*----------------------------------------------------------------------------*/
/* lstbl.test -- list tables                                                  */
/*----------------------------------------------------------------------------*/

// create a table
create table ${testName2}_lstTbl1 (
  bol_col1   BOOLEAN     NOT NULL,
  vch_col2   VARCHAR(32) NOT NULL,
  int_col3   INTEGER     NOT NULL,
  int_col4   INTEGER     NOT NULL,
  dec_col5   DECIMAL(10,2) NOT NULL,
  flt_col6   FLOAT       NOT NULL,
  tsp_col7   TIMESTAMP   NOT NULL,
  bol_col8   BOOLEAN
);
success

// list tables
select * from tableOfTables where TableType = 'NORMAL';
contains rows:
  (*, *, '${testName2}_lstTbl1', 'NORMAL', *)

// create aanother table
create table ${testName2}_lstTbl2 (
  bol_col1   BOOLEAN     NOT NULL,
  vch_col2   VARCHAR(32) NOT NULL,
  int_col3   INTEGER     NOT NULL,
  int_col4   INTEGER     NOT NULL,
  dec_col5   DECIMAL(10,2) NOT NULL,
  flt_col6   FLOAT       NOT NULL,
  tsp_col7   TIMESTAMP   NOT NULL,
  bol_col8   BOOLEAN
  );
success

// list tables
select * from tableOfTables where TableType = 'NORMAL';
contains rows:
  (*, *, '${testName2}_lstTbl1', 'NORMAL', *)
  (*, *, '${testName2}_lstTbl2', 'NORMAL', *)

