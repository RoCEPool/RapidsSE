// exception : /0
select (flt_col8/0e0) from datums;
failure contains: 'divide by zero'

// aggregates : sum

select sum(flt_col8) from datums;
rows: (42.64e0)

select 10.44 + sum(flt_col8) from datums;
rows: (53.08e0)

select sum(flt_col8) + 10.44 from datums;
rows: (53.08e0)

select sum(10.1 + flt_col8) from datums;
rows: (163.84e0)

select sum(flt_col8 + 10.1) from datums;
rows: (163.84e0)

select sum(flt_col8 + flt_col8) from datums;
rows: (85.28e0)

select sum(flt_col8) + sum(flt_col8) from datums;
rows: (85.28e0)

// aggregates : min

select min(flt_col8) from datums;
rows: (0.22e0)

select min(flt_col8)-0 from datums;
rows: (0.22e0)

select 10.3 + min(flt_col8) from datums;
rows: (10.52e0)

select min(flt_col8) + 10.3 from datums;
rows: (10.52e0)

select min(10 + flt_col8) from datums;
rows: (10.22e0)

select min(flt_col8 + 10) from datums;
rows: (10.22e0)

select min(flt_col8 + flt_col8) from datums;
rows: (0.44e0)

select min(flt_col8) + min(flt_col8) from datums;
rows: (0.44e0)

// aggregates : max

select max(flt_col8) from datums;
rows: (10.22e0)

select 10 + max(flt_col8) from datums;
rows: (20.22e0)

select max(flt_col8) + 10 from datums;
rows: (20.22e0)

select max(10 + flt_col8) from datums;
rows: (20.22e0)

select max(flt_col8 + 10) from datums;
rows: (20.22)

select max(flt_col8 + flt_col8) from datums;
rows: (20.44)

select max(flt_col8) + max(flt_col8) from datums;
rows: (20.44)

// drop the table
drop table datums;
success

//------------------------------------------------------------------------------
// create table
create table datums (
  int_col0   INTEGER NOT NULL,
  int_col1   INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(19,2),
  dec_col7   DECIMAL(19,2),
  flt_col8   FLOAT,
  flt_col9   FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);
success

load datums "../DATA/DataTypes/dataTypesOver.csv" ;
success

