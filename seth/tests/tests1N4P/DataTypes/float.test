failure contains: 'Arithmetic overflow'
*/
// aggregates : max

select max(int_col0) from datums;
rows: (13)

select 10 + max(int_col0) from datums;
rows: (23)

select max(int_col0) + 10 from datums;
rows: (23)

select max(10 + int_col0) from datums;
rows: (23)

select max(int_col0 + 10) from datums;
rows: (23)

select max(int_col0 + int_col0) from datums;
rows: (26)

select max(int_col0) + max(int_col0) from datums;
rows: (26)

// aggregates : max (with nulls and min/max ints)
/*
select max(int_col1) from datums;
rows: (9223372036854775806)

select 10 + max(int_col1) from datums;
failure contains: 'Arithmetic overflow'

select max(int_col1) + 10 from datums;
failure contains: 'Arithmetic overflow'

select max(10 + int_col1) from datums;
failure contains: 'Arithmetic overflow'

select max(int_col1 + 10) from datums;
failure contains: 'Arithmetic overflow'

select max(int_col1 + int_col1) from datums;
failure contains: 'Arithmetic overflow'

select max(int_col1) + max(int_col1) from datums;
failure contains: 'Arithmetic overflow'
*/

// drop the table
drop table datums;
success

