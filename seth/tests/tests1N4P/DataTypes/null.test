/*----------------------------------------------------------------------------*/
/* integer.test -- INTEGER DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

//------------------------------------------------------------------------------
// create table
create table datums (
  int_col0   INTEGER NOT NULL,
  int_col1   INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(19,2),
  dec_col7   DECIMAL(19,2),
  flt_col8   FLOAT,
  flt_col9   FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);
success

load datums "../DATA/DataTypes/dataTypes.csv" ;
success

//------------------------------------------------------------------------------
select null from datums;
rows:
  (null)
  (null)
  (null)
  (null)
  (null)
  (null)
  (null)
  (null)
  (null)
  (null)
  (null)
  (null)
  (null)

drop table datums;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table datums;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
