//------------------------------------------------------------------------------
select dec_col6 from datums where dec_col6 = 47.04;
rows:
  (47.04)

//------------------------------------------------------------------------------
select dec_col6 from datums where dec_col6 = 41.04;
rows:
  (41.04)
  (41.04)
  (41.04)
  (41.04)

//------------------------------------------------------------------------------
select dec_col6 from datums where dec_col6 >= 41.04 order by dec_col6;
rows:
  (41.04)
  (41.04)
  (41.04)
  (41.04)
  (47.04)
  (477.04)
  (477.04)
  (477.04)
  (477.04)
  (4001.04)

//------------------------------------------------------------------------------
select dec_col6 from datums where dec_col6 <= 41.04 order by dec_col6;
rows:
  (23.04)
  (41.04)
  (41.04)
  (41.04)
  (41.04)

//------------------------------------------------------------------------------
select dec_col6 * 10.10 from datums;
rows:
