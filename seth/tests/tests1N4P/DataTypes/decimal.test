rows: (53.08)

select sum(10.1 + flt_col8) from datums;
rows: (163.84)

select sum(flt_col8 + 10.1) from datums;
rows: (163.84)

select sum(flt_col8 + flt_col8) from datums;
rows: (85.28)

select sum(flt_col8) + sum(flt_col8) from datums;
rows: (85.28)

// aggregates : min

select min(flt_col8) from datums;
rows: (0.22)

select 10.3 + min(flt_col8) from datums;
rows: (10.52)

select min(flt_col8) + 10.3 from datums;
rows: (10.52)

select min(10 + flt_col8) from datums;
rows: (10.22)

select min(flt_col8 + 10) from datums;
rows: (10.22)

select min(flt_col8 + flt_col8) from datums;
rows: (0.44)

select min(flt_col8) + min(flt_col8) from datums;
rows: (0.44)

// aggregates : min (with nulls and min/max ints)

select min(int_col1) from datums;
rows: (-9223372036854775806)

select 10 + min(int_col1) from datums;
rows: (-9223372036854775796)

select min(int_col1) + 10 from datums;
rows: (-9223372036854775796)

select min(10 + int_col1) from datums;
failure contains: 'Arithmetic overflow'

select min(int_col1 + 10) from datums;
failure contains: 'Arithmetic overflow'

select min(int_col1 + int_col1) from datums;
failure contains: 'Arithmetic overflow'

select min(int_col1) + min(int_col1) from datums;
failure contains: 'Arithmetic overflow'

// aggregates : max

select max(flt_col8) from datums;
rows: (10.22)

select 10 + max(flt_col8) from datums;
rows: (20.22)

select max(flt_col8) + 10 from datums;
rows: (20.22)

select max(10 + flt_col8) from datums;
rows: (20.22)

select max(flt_col8 + 10) from datums;
rows: (20.22)

select max(flt_col8 + flt_col8) from datums;
rows: (20.44)

select max(flt_col8) + max(flt_col8) from datums;
rows: (20.44)

// aggregates : max (with nulls and min/max ints)

select max(int_col1) from datums;
rows: (9223372036854775806)
