// exception : /0
select dec_col6/0 from datums;
failure contains: 'divide by zero'

// aggregates : sum
select sum(dec_col6) from datums;
rows: (6143.44)

select 10.44 + sum(dec_col6) from datums;
rows: (6153.88)

select sum(dec_col6) + 10.44 from datums;
rows: (6153.88)

select sum(10.1 + dec_col6) from datums;
rows: (6254.54)

select sum(dec_col6 + 10.1) from datums;
rows: (6254.54)

select sum(dec_col6 + dec_col6) from datums;
rows: (12286.88)

select sum(dec_col6) + sum(dec_col6) from datums;
rows: (12286.88)

// aggregates : min

select min(dec_col6) from datums;
rows: (23.04)

select 10.3 + min(dec_col6) from datums;
rows: (33.34)

select min(dec_col6) + 10.3 from datums;
rows: (33.34)

select min(10 + dec_col6) from datums;
rows: (33.04)

select min(dec_col6 + 10) from datums;
rows: (33.04)

select min(dec_col6 + dec_col6) from datums;
rows: (46.08)

select min(dec_col6) + min(dec_col6) from datums;
rows: (46.08)

