//------------------------------------------------------------------------------
// create table
create table datums (
  int_col0   INTEGER NOT NULL,
  int_col1   INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(19,2),
  dec_col7   DECIMAL(19,2),
  flt_col8   FLOAT,
  flt_col9   FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);
success

load datums "../DATA/Transliterate/groupBy.csv" ;
success

//------------------------------------------------------------------------------
select int_col1, sum(int_col0) from datums group by int_col1;
rows:
 (null,3)
 (0,21)
 (2000,2)
 (4000,4)
 (5000,12)
 (7000,7)
 (8000,17)

//------------------------------------------------------------------------------
select sum(int_col0), int_col1 from datums group by int_col1;
rows:
 (3,null)
 (21,0)
 (2,2000)
 (4,4000)
 (12,5000)
 (7,7000)
 (17,8000)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  between
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select int_col0 from datums where int_col0 between 3 and 10;
rows:
 (3)
 (4)
 (5)
 (6)
 (7)
 (8)
 (9)
 (10)

select int_col0 , int_col0 between 3 and 10 from datums;
rows:
 (1,false)
 (2,false)
 (3,true)
 (4,true)
 (5,true)
 (6,true)
 (7,true)
 (8,true)
 (9,true)
 (10,true)
 (11,false)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  in expr
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select int_col0 from datums where int_col0 in (3,4,5,6);
rows:
 (3)
 (4)
 (5)
 (6)

select int_col0 , int_col0 in (3,4,5,6) from datums;
rows:
 (1,false)
 (2,false)
 (3,true)
 (4,true)
 (5,true)
 (6,true)
 (7,false)
 (8,false)
 (9,false)
 (10,false)
 (11,false)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  extract YEAR
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select tsp_col12, EXTRACT (YEAR FROM tsp_col12) from datums;
rows:
  (1941-01-01 00:00:00,1941)
  (null,null)
  (1944-01-01 12:00:55,1944)
  (1941-01-01 00:00:00,1941)
  (1972-01-01 12:00:02,1972)
  (1972-01-01 10:30:10,1972)
  (1943-01-01 00:00:10,1943)
  (1972-01-01 12:00:01,1972)
  (null,null)
  (1972-01-01 10:30:10,1972)
  (1941-01-01 00:00:00,1941)

select tsp_col12 from datums where EXTRACT (YEAR FROM tsp_col12) = 1941;
rows:
  (1941-01-01 00:00:00)
  (1941-01-01 00:00:00)
  (1941-01-01 00:00:00)

select dte_col4, EXTRACT (YEAR FROM dte_col4) from datums;
rows:
  (DATE '1941-01-01',1941)
  (DATE '1942-01-01',1942)
  (DATE '1941-01-01',1941)
  (DATE '1998-11-02',1998)
  (DATE '1941-01-01',1941)
  (DATE '1941-01-01',1941)
  (DATE '1942-11-01',1942)
  (DATE '1941-01-10',1941)
  (DATE '1942-11-01',1942)
  (DATE '1942-01-19',1942)
  (null,null)

// drop the table
drop table datums;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table datums;
  mute
  
  bye;
  mute
}

