--
-- An example test showing multiple threads and synchronisation between the thread.
--


-- First ensure that the table 'foo' doesn't exist to start with.
drop table ${testName2}_foo;
mute


-- The main thread will then create a couple of child threads, which will
-- execute the block of code below.
CREATE 2 THREADS {
  -- Child threads only execute the commands in this block.

  -- Child threads wait for table and index to be created by main thread.
  SYNCHRONIZE;
  
  select * from tableOfTables where TableType = 'NORMAL';
  contains rows:
    (*, *, '${testName2}_foo', 'NORMAL', *)

  select * from tableIndexes where TableName = '${testName2}_foo';
  contains rows:
    (*, *, '${testName2}_foo', 'fooIdx',false,false)

  select * from indexColumns where TableName = '${testName2}_foo' and IndexName = 'fooIdx';
  contains rows:
    (*, *, '${testName2}_foo', 'fooIdx', 'col0', 'INTEGER', 19, 0, true, true)

  -- Synchronizing here tells the main thread that we are done verifying the table.
  SYNCHRONIZE;

  -- Child threads synchronize again to wait for table to be dropped
  SYNCHRONIZE;

  -- Child threads exit here.
}

-- The main thread keeps running commands from here after creating the child threads..
create table ${testName2}_foo (col0 integer, col1 varchar);
success

create index fooIdx on ${testName2}_foo (col0);
success

-- Unblocks child threads who will verify existence of the table and index.
SYNCHRONIZE;


-- Main thread waits until child threads indicate that they are done verifying table.
SYNCHRONIZE;

drop table ${testName2}_foo;
success

-- Child threads are blocked waiting for the table to be dropped.
SYNCHRONIZE;

CLEANUP {
  drop table ${testName2}_foo;
  mute
}
