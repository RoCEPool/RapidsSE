/*----------------------------------------------------------------------------*/
/* create partition key tests                                                 */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// create a table
create table ${testName2}_boolTable (
  key1   BOOLEAN NOT NULL,
  intVal INTEGER,
  name  VARCHAR(32) NOT NULL
) partition by (key1);
success

// check columns of partition key
select * from columns where TableName = '${testName2}_boolTable' and IsPartitionKey = true;
contains rows:
  (*, *, '${testName2}_boolTable', 0, 'key1', 1,'BOOLEAN',0,0,false,true)

// create an index
create index idx1 on ${testName2}_boolTable (key1);
success;

// load data into the table
load ${testName2}_boolTable "../DATA/PartitionKey/bool.csv";
success

// analyze table
antbl ${testName2}_boolTable1;
failure contains: 'Table does not exist'

// analyze table
antbl ${testName2}_boolTable;
rows:
 (*,*,*,0)
 (*,*,*,5)
 (*,*,*,0)
 (*,*,*,5)

// drop the table
drop table ${testName2}_boolTable;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  drop table ${testName2}_boolTable;
  mute
}

