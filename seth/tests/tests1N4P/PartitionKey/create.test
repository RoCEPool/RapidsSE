contains rows:
 (*, *, '${testName2}_createT1', 0, 'key', 6,'INTEGER',19,0,false,true)
 (*, *, '${testName2}_createT1', 1, 'name', 11,'VARCHAR',32,0,false,true)

-- drop the table
drop table ${testName2}_createT1;
success

create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by (name, key);
success

-- check existence of partition key
select * from columns where TableName = '${testName2}_createT1' and IsPartitionKey = true;
contains rows:
 (*, *, '${testName2}_createT1', 0, 'key', 6,'INTEGER',19,0,false,true)
