create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by (key, name);
failure contains: "EC_MULTIPLE_COLUMN_PARTITION_KEY"

create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by (name, key);
failure contains: "EC_MULTIPLE_COLUMN_PARTITION_KEY"

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  -- Commands in the cleanup section always run, and do so at the end
  -- of a test (whether successful or not). 

  -- Ensure that table  ('keyIdx') is dropped.
  -- We can set the expected result to mute if we don't want to see any warnings.
  drop table ${testName2}_createT1;
  mute
}

