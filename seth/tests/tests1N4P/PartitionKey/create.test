/*----------------------------------------------------------------------------*/
/* create partition key tests                                                 */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

-- create a table
create table ${testName2}_createT1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

-- check columns of partition key
lsPtncol ${testName2}_createT1;
rows:
  ('key','INTEGER',19,0,false,true)

-- drop the table
drop table ${testName2}_createT1;
success

-- check existence of partition key
lsPtncol ${testName2}_createT1;
failure contains: 'Table does not exist'

create table ${testName2}_createT1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
) partition ;
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 12; mismatched input ';' expecting BY"

-- check existence of partition key
lsPtncol ${testName2}_createT1;
failure contains: 'Table does not exist'

create table ${testName2}_createT1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
) partition by;
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 14; mismatched input ';' expecting '('"

-- check existence of partition key
lsPtncol ${testName2}_createT1;
failure contains: 'Table does not exist'

create table ${testName2}_createT1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
) partition by (;
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 16; mismatched input ';'"

create table ${testName2}_createT1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
) partition by ();
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 16; mismatched input ')'"

create table ${testName2}_createT1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
) partition by );
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 15; mismatched input ')' expecting '('"

create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by key;
failure contains: "EC_SYNTAX_ERROR; Line: 4; Column: 15; missing '(' at 'key'"

create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by (xyz);
failure contains: 'invalid partition key'

create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by (key);
success

-- check existence of partition key
lsPtncol ${testName2}_createT1;
rows:
  ('key','INTEGER',19,0,false,true)

-- drop the table
drop table ${testName2}_createT1;
success

create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by (name);
success

-- check existence of partition key
lsPtncol ${testName2}_createT1;
rows:
  ('name','VARCHAR',32,0,false,true)

-- drop the table
drop table ${testName2}_createT1;
success

create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by (key, name);
success

-- check existence of partition key
lsPtncol ${testName2}_createT1;
rows:
 ('key','INTEGER',19,0,false,true)
 ('name','VARCHAR',32,0,false,true)

-- drop the table
drop table ${testName2}_createT1;
success

create table ${testName2}_createT1 (
key   INTEGER NOT NULL,
name  VARCHAR(32) NOT NULL
) partition by (name, key);
success

-- check existence of partition key
lsPtncol ${testName2}_createT1;
rows:
  ('key','INTEGER',19,0,false,true)
  ('name','VARCHAR',32,0,false,true)

-- drop the table
drop table ${testName2}_createT1;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  -- Commands in the cleanup section always run, and do so at the end
  -- of a test (whether successful or not). 

  -- Ensure that table  ('keyIdx') is dropped.
  -- We can set the expected result to mute if we don't want to see any warnings.
  drop table ${testName2}_createT1;
  mute

  bye;
  mute
}

