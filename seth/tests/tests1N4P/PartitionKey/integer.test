--------------------------------------------------------------------------------
-- create partition key tests
--------------------------------------------------------------------------------

// begin tracking memory
trackmemory force;
success

// create a table
create table ${testName2}_dataTable (
  key     INTEGER NOT NULL,
  name    VARCHAR(32) NOT NULL,
  value1  INTEGER,
  value2  INTEGER
) partition by (key);
success

// check columns of partition key
select * from columns where TableName = '${testName2}_dataTable' and IsPartitionKey = true;
contains rows:
  (*, *, '${testName2}_dataTable', 0, 'key', 6,'INTEGER',19,0,false,true)

// load data into the table
load ${testName2}_dataTable "../DATA/PartitionKey/data.csv";
success

// select rows from the table
select * from ${testName2}_dataTable;
rows:
1000

// drop the table
drop table ${testName2}_dataTable;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  drop table ${testName2}_dataTable;
  mute
}

