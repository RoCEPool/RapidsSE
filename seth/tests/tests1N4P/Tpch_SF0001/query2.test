// Below queries modified for dataset SF0001
// p_size < 15 and NO LIKE

/////////////////////
// Q02_0           //
/////////////////////
select min(ps_supplycost)
      from partsupp, supplier, nation, region
      where s_suppkey = ps_suppkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE';
rows:
--verfified
  (3.14)

/////////////////////
// Q02_1           //
/////////////////////

// loopJoin running OOM with 5-way join
/*
select s_acctbal, s_name, n_name, p_partkey, p_mfgr, s_address, s_phone, s_comment
    from part, supplier, partsupp, nation, region
    where p_partkey = ps_partkey
    and s_suppkey = ps_suppkey
    and p_size < 15
    and s_nationkey = n_nationkey
    and n_regionkey = r_regionkey
    and r_name = 'EUROPE';

--verfified
rows: 16
*/

// 4-way join supplier, partsupp, nation, region
select s_acctbal, s_name, n_name, s_address, s_phone, s_comment
   from supplier, partsupp, nation, region
    where
    s_suppkey = ps_suppkey
    and s_nationkey = n_nationkey
    and n_regionkey = r_regionkey
    and r_name = 'EUROPE';
--verfified
rows: 80

// 4-way join part, partsupp, nation, region
select p_partkey, p_mfgr
      from part, partsupp, nation, region
      where p_partkey = ps_partkey
      and p_size = 15
      and n_regionkey = r_regionkey
      and r_name = 'EUROPE';
--verfified
rows: 40

// 4-way join part, supplier, partsupp, nation
select s_acctbal, s_name, p_partkey, p_mfgr, s_address, s_phone, s_comment
     from part, supplier, partsupp, nation
      where p_partkey = ps_partkey
      and s_suppkey = ps_suppkey
      and p_size = 15
      and s_nationkey = n_nationkey;

--verfified
rows: 8

CLEANUP {
  bye;
  mute
}


