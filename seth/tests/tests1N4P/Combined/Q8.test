load ${testName2}_Customer "../TPCH/SF_0001/customer.csv" ;
success

load ${testName2}_lineitem "../TPCH/SF_0001/lineitem.csv";
success

load ${testName2}_Orders   "../TPCH/SF_0001/orders.csv";
success

load ${testName2}_Supplier "../TPCH/SF_0001/supplier.csv";
success

load ${testName2}_Region "../TPCH/SF_0001/region.csv";
success

load ${testName2}_Nation "../TPCH/SF_0001/nation.csv";
success

/optimise_passthru 
pipeline Q7
begin

  stage first on origin :
    start
    | pulse once
    | next

  // ∀ CUSTOMER /C_CUSTKEY/ _custkey π _suppkey
  stage Gj_CUSTOMER on all partitions :
    scan ${testName2}_Customer
    | filter
        "C_NATIONKEY 6 == C_NATIONKEY 7 == or"
    | project expr
        type INTEGER as _custkey    C_CUSTKEY ,
        type INTEGER as C_NATIONKEY C_NATIONKEY
    | combined 0
    | next

//UC

  // ∀ ORDERS /O_CUSTKEY/ π _custkey
  stage Gj_ORDERS on all partitions :
    indexJoin ${testName2}_Orders IxO_CUSTKEY expr bound $I1 _custkey ==
    | project expr
        type INTEGER as _orderkey   O_ORDERKEY ,
        type INTEGER as C_NATIONKEY C_NATIONKEY
    | hash expr type INTEGER _orderkey
    | combined 0
    | next hashcast

//HC

  // ∀ LINEITEM /L_ORDERKEY/ π _orderkey
  stage Gs_LINEITEM on all partitions :
    indexJoin ${testName2}_Lineitem IxL_ORDERKEY expr bound $I1 _orderkey ==
    | filter
        "L_SHIPDATE timestamp '1995-01-01 00:00:00' >=
         L_SHIPDATE timestamp '1996-12-31 00:00:00' <
         and"
    | project expr
        type INTEGER as _suppkey    L_SUPPKEY ,
        type INTEGER as C_NATIONKEY C_NATIONKEY
    | hash expr type INTEGER _suppkey
    | combined 0
    | next hashcast

//HC

  // ⋈ SUPPLIER /C_SUPPKEY/
  stage Gj_SUPPLIER on all partitions :
    indexJoin ${testName2}_Supplier IxS_SUPPKEY expr bound $I1 _suppkey ==
    | filter
        "C_NATIONKEY 6 == S_NATIONKEY 7 == and
         C_NATIONKEY 7 == S_NATIONKEY 6 == and or"
    | combined 0
    | next

  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

  stage G_AGG_P on all partitions :
    aggreg " type INTEGER as x_rowCntPtn )  countAll  "
    | combined 0
    | next

  stage G_AGG_N on all nodes :
    aggreg " type INTEGER as x_rowCntNode )  x_rowCntPtn sum  "
    | combined 0
    | next

  stage G_AGG_O on origin :
    aggreg " type INTEGER as x_rowCntOrigin )  x_rowCntNode sum  "
    | combined 0
    | next

  stage last on origin :
    output
    | sink
    | first

end ;

rows:
  (187739276.85)

