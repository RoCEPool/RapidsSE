--------------------------------------------------------------------------------
-- Query17 --- Combined Operators
--------------------------------------------------------------------------------

trackmemory force;
success;

create table ${testName2}_lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B   3B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B   3B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B   3B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B   3B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B   3B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B   3B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B   3B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B   3B
  L_RETURNFLAG    VARCHAR(1) NOT NULL,      //  8)  2B   2B
  L_LINESTATUS    VARCHAR(1) NOT NULL,      //  9)  2B   2B
  l_SHIPDATE      DATE NOT NULL,            // 10)  8B   8B
  L_COMMITDATE    DATE NOT NULL,            // 11)  8B   8B
  L_RECEIPTDATE   DATE NOT NULL,            // 12)  8B   8B
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,     // 13) 26B  13B
  L_SHIPMODE      VARCHAR(10) NOT NULL,     // 14) 11B   5B
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B  23B
);
success

create index IxL_PARTKEY ON ${testName2}_lineitem(L_PARTKEY);
success

create table ${testName2}_part (
	 P_PARTKEY           INTEGER       NOT NULL,
	 P_NAME              VARCHAR(55)   NOT NULL,
	 P_MFGR              CHAR(25)      NOT NULL,
	 P_BRAND             CHAR(10)      NOT NULL,
	 P_TYPE              VARCHAR(25)   NOT NULL,
	 P_SIZE              INTEGER       NOT NULL,
	 P_CONTAINER         CHAR(10)      NOT NULL,
	 P_RETAILPRICE       DECIMAL(15,2) NOT NULL,
	 P_COMMENT           VARCHAR(23)   NOT NULL
);
success

load ${testName2}_lineitem "../TPCH/SF_0001/lineitem.tbl";
success

load ${testName2}_part "../TPCH/SF_0001/part.tbl";
success

/optimise_passthru 
pipeline Q17
begin

  stage stageStart on origin :
    start
    | pulse once
    | stageQ17_0

  stage stageQ17_0 on all partitions :
    scan rapidsse public ${testName2}_part
    | filter " type BOOLEAN  $4 'Brand#23'  ==  $7 'MED BAG'  ==  and  "
    | project " type INTEGER ( 19 ) as P_PARTKEY $1 "
    | combined 0
    | next broadcast

  stage stageQ17_1_a on all partitions :
    indexJoin ${testName2}_lineitem IxL_PARTKEY "bound $I1 $1 =="
    | gbyAgg " groupBy  type integer ( 19 ) $1 aggregates
               type integer ( 19 ) as P_PARTKEY $K1 ,
               type DECIMAL ( 17  2 ) )  $6 sum  ,
               type INTEGER ( 19 ) )  $6 count   "
    | combined 0
    | next

  stage stageQ17_1_b on all nodes :
    gbyAgg " groupBy  type integer ( 19 ) $1 aggregates type integer ( 19 ) as P_PARTKEY $K1 , type DECIMAL ( 17  2 ) )  $2 sum  , type INTEGER ( 19 ) )  $3 sum   "
    | combined 0
    | next

  stage stageQ17_1_c on origin :
    gbyAgg " groupBy  type integer ( 19 ) $1  aggregates
             type integer ( 19 ) as P_PARTKEY $K1 ,
             type DECIMAL ( 17  2 ) ) $2 sum , type INTEGER ( 19 ) ) $3 sum  "
    | combined 0
    | next

  stage stageQ17_1_d on origin :
    project " type integer ( 19 ) as P_PARTKEY $1 , type DECIMAL ( 17  2 ) as AV 0.20 $2 $3  casttype DECIMAL ( 17  0 ) cast / *"
    | combined 0
    | next broadcast

  stage stageQ17_2_a on all partitions :
    indexJoin ${testName2}_lineitem IxL_PARTKEY "bound $I1 $1 =="
    | filter " type BOOLEAN  $7 $2 <  "
    | aggreg " type DECIMAL ( 17  2 ) as avg_yearly ) $8 sum  "
    | combined 0
    | next

  stage stageQ17_2_b on all nodes :
    aggreg " type DECIMAL ( 17  2 ) as avg_yearly ) $1 sum  "
    | combined 0
    | next

  stage stageQ17_2_c on origin :
    aggreg " type DECIMAL ( 17  2 ) as avg_yearly ) $1 sum "
    | combined 0
    | next

  stage stageQ17_2_d on origin :
    project " type DECIMAL ( 17  4 ) as avg_yearly $1 7.0 / "
    | combined 0
    | stageLast

  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

rows: (2495.310000)

//------------------------------------------------------------------------------
// drop the tables
drop table ${testName2}_lineitem;
success

drop table ${testName2}_part;
success

MemoryLeaks;
rows: 0

CLEANUP {

  drop table ${testName2}_lineitem;
  mute

  drop table ${testName2}_part;
  mute
}