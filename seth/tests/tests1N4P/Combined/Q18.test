--------------------------------------------------------------------------------
-- Query18 --- Combined Operators
--------------------------------------------------------------------------------

trackmemory force;
success;

create table ${testName2}_lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B   3B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B   3B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B   3B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B   3B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B   3B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B   3B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B   3B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B   3B
  L_RETURNFLAG    VARCHAR(1) NOT NULL,      //  8)  2B   2B
  L_LINESTATUS    VARCHAR(1) NOT NULL,      //  9)  2B   2B
  l_SHIPDATE      DATE NOT NULL,            // 10)  8B   8B
  L_COMMITDATE    DATE NOT NULL,            // 11)  8B   8B
  L_RECEIPTDATE   DATE NOT NULL,            // 12)  8B   8B
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,     // 13) 26B  13B
  L_SHIPMODE      VARCHAR(10) NOT NULL,     // 14) 11B   5B
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B  23B
);
success

create index IxL_ORDERKEY ON ${testName2}_lineitem(L_ORDERKEY);
success

create table ${testName2}_orders (
	 O_ORDERKEY        INTEGER NOT NULL,
	 O_CUSTKEY         INTEGER NOT NULL,
	 O_ORDERSTATUS     CHAR(1) NOT NULL,
	 O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
	 O_ORDERDATE       TIMESTAMP NOT NULL,
	 O_ORDERPRIORITY   CHAR(15) NOT NULL,
	 O_CLERK           CHAR(15) NOT NULL,
	 O_SHIPPRIORITY    INTEGER NOT NULL,
	 O_COMMENT         VARCHAR(79) NOT NULL
);
success

create index IxO_ORDERKEY ON ${testName2}_orders(O_ORDERKEY);
success

create table ${testName2}_customer (
	C_CUSTKEY       INTEGER       NOT NULL,  // 0)
	C_NAME          VARCHAR(25)   NOT NULL,  // 1)
	C_ADDRESS       VARCHAR(40)   NOT NULL,  // 2)
	C_NATIONKEY     INTEGER       NOT NULL,  // 3)
	C_PHONE         CHAR(15)      NOT NULL,  // 4)
	C_ACCTBAL       DECIMAL(15,2) NOT NULL,  // 5)
	C_MKTSEGMENT    CHAR(10)      NOT NULL,  // 6)
	C_COMMENT       VARCHAR(117)  NOT NULL   // 7)
);
success

create index IxC_CUSTKEY ON ${testName2}_customer(C_CUSTKEY);
success

load ${testName2}_lineitem "../TPCH/SF_0001/lineitem.tbl";
success

load ${testName2}_orders "../TPCH/SF_0001/orders.tbl";
success

load ${testName2}_customer "../TPCH/SF_0001/customer.tbl";
success

/optimise_passthru 
pipeline Q18
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    indexScan ${testName2}_lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | ordAgg " ordGroupBy  type integer $1 aggregates type integer $K1 , type decimal )  $5 sum  "
    | combined 0
    | next broadcast

  stage S02 on all partitions :
    filter " type BOOLEAN  $2 170.00  >  "
    | indexJoin ${testName2}_orders IxO_ORDERKEY "bound $I1 $1 =="
    | combined 0
    | next broadcast

  stage S03 on all partitions :
    project "type integer as CUSTKEY $4 , type integer as ORDERKEY $1 , type timestamp as ORDERDATE $7 , type decimal as TOTALPRICE $6 , type decimal as SUM_QTY $2 "
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin ${testName2}_customer IxC_CUSTKEY "bound $I1 $1 =="
    | combined 0
    | next

  stage S05 on all partitions :
    gbyAgg " groupBy type integer $1 , type integer $2 aggregates
               type integer as CUSTKEY $K1 ,
               type integer as ORDERKEY $K2 ,
               type timestamp as ORDERDATE $3 ,
               type decimal as TOTALPRICE $4 ,
               type decimal as SUM_QTY )  $5 sum "
    | combined 0
    | next

  stage S06 on all nodes :
     gbyAgg " groupBy type integer $1 , type integer $2 aggregates
                type integer as CUSTKEY $K1 ,
                type integer as ORDERKEY $K2 ,
                type timestamp as ORDERDATE $3 ,
                type decimal as TOTALPRICE $4 ,
                type decimal as SUM_QTY )  $5 sum "
     | combined 0
     | next

  stage S07 on origin :
    gbyAgg " groupBy type integer $1 , type integer $2 aggregates
    type integer as CUSTKEY $K1 ,
    type integer as ORDERKEY $K2 ,
    type timestamp as ORDERDATE $3 ,
    type decimal as TOTALPRICE $4 ,
    type decimal as SUM_QTY )  $5 sum "
    | combined 0
    | next

  stage S08 on origin :
   limit 100
   | combined 0
   | next

  stage S09 on origin :
    output
    | sink
    | first
end ;

