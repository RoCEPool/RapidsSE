  (100,850,TIMESTAMP '1996-05-05 00:00:00',260546.82,173.00)
  (102,552,TIMESTAMP '1995-05-01 00:00:00',331019.93,172.00)
  (114,1464,TIMESTAMP '1994-11-06 00:00:00',110203.10,171.00)
  (136,136,TIMESTAMP '1993-02-17 00:00:00',69323.15,172.00)
  (148,1048,TIMESTAMP '1998-04-19 00:00:00',298397.90,182.00)

//------------------------------------------------------------------------------
// drop the tables
drop table lineitem;
success

drop table orders;
success

drop table customer;
success

MemoryLeaks;
rows: 0

CLEANUP {

  drop table lineitem;
  mute

  drop table orders;
  mute

  drop table customer;
  mute

  bye;
  mute
}