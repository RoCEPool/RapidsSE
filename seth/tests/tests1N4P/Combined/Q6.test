--------------------------------------------------------------------------------
-- Query1 --- Combined Operators
--------------------------------------------------------------------------------

trackMemory;
success;

create table lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B   3B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B   3B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B   3B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B   3B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B   3B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B   3B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B   3B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B   3B
  L_RETURNFLAG    VARCHAR(1) NOT NULL,      //  8)  2B   2B
  L_LINESTATUS    VARCHAR(1) NOT NULL,      //  9)  2B   2B
  l_SHIPDATE      TIMESTAMP NOT NULL,       // 10)  8B   8B
  L_COMMITDATE    TIMESTAMP NOT NULL,       // 11)  8B   8B
  L_RECEIPTDATE   TIMESTAMP NOT NULL,       // 12)  8B   8B
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,     // 13) 26B  13B
  L_SHIPMODE      VARCHAR(10) NOT NULL,     // 14) 11B   5B
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B  23B
);
success

create index IxL_SHIPDATE ON Lineitem (L_SHIPDATE)   ;
success;

load lineitem "../TPCH/SF_0001/lineitem.csv";
success

pipeline Q6
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_LINEITEM on all partitions :
    indexscan 2 lineitem IxL_SHIPDATE "LBOUND $I1 TIMESTAMP '1994-01-01 00:00:00' >=
                                       UBOUND $I1 TIMESTAMP '1995-01-01 00:00:00' <"
    | filter  2 "type BOOLEAN L_DISCOUNT 1.01 0.01 - >=
                              L_DISCOUNT 1.01 0.01 + <=
                              L_QUANTITY 24.0 < and and"
    | project  2 " type DECIMAL as REVENUE ) L_EXTENDEDPRICE L_DISCOUNT * sum "
    | combined 0
    | next

  // = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

  stage G_SUM_P on all partitions :
    project  2 " type DECIMAL as REVENUE ) REVENUE sum "
    | combined 0
    | next

  stage G_SUM_N on all nodes :
    project 2 " type DECIMAL as REVENUE )  REVENUE sum  "
    | combined 0
    | next

   stage G_SUM_O on origin :
     project 2 " type DECIMAL as REVENUE )  REVENUE sum  "
     | combined 0
     | next

   stage last on origin :
     output
     | sink
     | first
end ;

rows:
  (1877392.75)

//------------------------------------------------------------------------------
// drop the tables
drop table lineitem;
success

MemoryLeaks;
rows: 0

CLEANUP {

  drop table lineitem;
  mute

  bye;
  mute
}