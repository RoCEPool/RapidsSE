/*----------------------------------------------------------------------------*/
/* Basic CombinedOP tests                                                     */
/*----------------------------------------------------------------------------*/
trackmemory;
success

create table lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B   3B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B   3B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B   3B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B   3B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B   3B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B   3B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B   3B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B   3B
  L_RETURNFLAG    VARCHAR(1) NOT NULL,      //  8)  2B   2B
  L_LINESTATUS    VARCHAR(1) NOT NULL,      //  9)  2B   2B
  l_SHIPDATE      TIMESTAMP NOT NULL,       // 10)  8B   8B
  L_COMMITDATE    TIMESTAMP NOT NULL,       // 11)  8B   8B
  L_RECEIPTDATE   TIMESTAMP NOT NULL,       // 12)  8B   8B
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,     // 13) 26B  13B
  L_SHIPMODE      VARCHAR(10) NOT NULL,     // 14) 11B   5B
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B  23B
);
success

create index IxL_ORDERKEY  ON Lineitem (l_SHIPDATE)  ;
success;

create table orders (
	 O_ORDERKEY        INTEGER       NOT NULL,
	 O_CUSTKEY         INTEGER       NOT NULL,
	 O_ORDERSTATUS     CHAR(1)       NOT NULL,
	 O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
	 O_ORDERDATE       TIMESTAMP     NOT NULL,
	 O_ORDERPRIORITY   CHAR(15)      NOT NULL,
	 O_CLERK           CHAR(15)      NOT NULL,
	 O_SHIPPRIORITY    INTEGER       NOT NULL,
	 O_COMMENT         VARCHAR(79)   NOT NULL
);
success

create index IxO_ORDERKEY  ON orders (O_ORDERKEY)  ;
success;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// multiple combinedOp's
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan orders
    | combined 0
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// OP after combinedOp
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan orders
    | combined 0
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// No OP after hashOp
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan orders
    | hash 2 "type INTEGER $1"
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// haspOP and no hashcast
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan orders
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | hash 2 "type INTEGER $1"
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// multiple projectOp's
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan orders
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// project after aggregate
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan orders
    | aggreg " groupBy  type INTEGER as l_orderkey $1 aggregates  type INTEGER $K1  , type INTEGER )  $2 sum "
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// scan to be a first OP
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | scan lineitem
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple scanOp's
/*
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan orders
    | scan lineitem
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'
*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// indexScan to be a first OP
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple indexScanOp's
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexscan orders IxO_ORDERKEY "lbound $I1 0 >="
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

DROP TABLE lineitem;
success

DROP TABLE orders;
success

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE lineitem;
  mute

  DROP TABLE orders;
  mute
}