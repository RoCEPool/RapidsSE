DROP TABLE ${testName2}_lineitem;
success

DROP TABLE ${testName2}_orders;
success

DROP TABLE ${testName2}_customer;
success

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {

  DROP TABLE ${testName2}_lineitem;
  mute

  DROP TABLE ${testName2}_orders;
  mute

  DROP TABLE ${testName2}_customer;
  mute
}