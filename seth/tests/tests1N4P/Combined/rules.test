// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// indexScan to be a first OP
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple indexScanOp's
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexscan orders IxO_ORDERKEY "lbound $I1 0 >="
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple indexJoinOp's
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin orders IxO_ORDERKEY "bound $I1 $L1 =="
    | indexJoin customer IxC_CUSTKEY "bound $I1 $L2 =="
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple limitOp's
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin orders IxO_ORDERKEY "bound $I1 $L1 =="
    | limit 3
    | limit 3
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple keyExistsOp's
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
      scan orders
      | filter " type BOOLEAN O_ORDERDATE TIMESTAMP '1993-07-01 00:00:00' >=
                                O_ORDERDATE TIMESTAMP '1993-10-01 00:00:00' < and "
      | project expr type INTEGER as _orderkey O_ORDERKEY ,
                       type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY
      | keyExists lineitem IxL_ORDERKEY  "BOUND $I1 _orderkey =="
                                           "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
      | keyExists lineitem IxL_ORDERKEY  "BOUND $I1 _orderkey =="
                                              "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
      | combined 0
      | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple sortOp's
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin orders IxO_ORDERKEY "bound $I1 $L1 =="
    | sort "type INTEGER L_PARTKEY ASC"
    | sort "type INTEGER L_ORDERKEY ASC"
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple topOp's

pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin orders IxO_ORDERKEY "bound $I1 $L1 =="
    | top "TOP type INTEGER L_PARTKEY" 2
    | top "TOP type INTEGER L_PARTKEY" 2
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Check for memory leaks
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

DROP TABLE lineitem;
success

DROP TABLE orders;
success

DROP TABLE customer;
success

memoryleaks;
rows: 0

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {

  DROP TABLE lineitem;
  mute

  DROP TABLE orders;
  mute

  DROP TABLE customer;
  mute
}