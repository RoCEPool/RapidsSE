// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// multiple projectOp's
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan ${testName2}_orders
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// project after aggregate
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan ${testName2}_orders
    | gbyAgg " groupBy  type INTEGER as l_orderkey $1 aggregates  type INTEGER $K1  , type INTEGER )  $2 sum "
    | project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// scan to be a first OP
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | scan ${testName2}_lineitem
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple scanOp's
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan ${testName2}_orders
    | scan ${testName2}_lineitem
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE'

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// indexScan to be a first OP
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    project " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | indexscan ${testName2}_lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// indexJoin / keyExists allowed in a stage
/optimise_passthru 
pipeline Q
begin

 stage S00 on origin :
   start
   | pulse once
   | next

 stage S01 on all partitions :
   scan ${testName2}_customer
  | next

 stage S02 on all partitions :
   indexJoin ${testName2}_orders IxO_CUSTKEY "bound $I1 $1 =="
   | keyExists ${testName2}_lineitem IxL_ORDERKEY  "BOUND $I1 O_ORDERKEY =="
                                        "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
   | combined 0
   | next

 stage last on origin :
    output
    | sink
    | first

 end ;
failure contains: 'EC_INVALID_PIPELINE' 

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple indexScanOp's
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan ${testName2}_lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexscan ${testName2}_orders IxO_ORDERKEY "lbound $I1 0 >="
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple indexJoinOp's
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan ${testName2}_lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin ${testName2}_orders IxO_ORDERKEY "bound $I1 $1 =="
    | indexJoin ${testName2}_customer IxC_CUSTKEY "bound $I1 $2 =="
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

