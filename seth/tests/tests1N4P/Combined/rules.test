// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple limitOp's
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan ${testName2}_lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin ${testName2}_orders IxO_ORDERKEY "bound $I1 $1 =="
    | limit 3
    | limit 3
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple keyExistsOp's
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
      scan ${testName2}_orders
      | filter " type BOOLEAN O_ORDERDATE TIMESTAMP '1993-07-01 00:00:00' >=
                                O_ORDERDATE TIMESTAMP '1993-10-01 00:00:00' < and "
      | project expr type INTEGER as _orderkey O_ORDERKEY ,
                       type VARCHAR as O_ORDERPRIORITY O_ORDERPRIORITY
      | keyExists ${testName2}_lineitem IxL_ORDERKEY  "BOUND $I1 _orderkey =="
                                           "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
      | keyExists ${testName2}_lineitem IxL_ORDERKEY  "BOUND $I1 _orderkey =="
                                              "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
      | combined 0
      | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple sortOp's
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan ${testName2}_lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin ${testName2}_orders IxO_ORDERKEY "bound $I1 $1 =="
    | sort "type INTEGER L_PARTKEY ASC"
    | sort "type INTEGER L_ORDERKEY ASC"
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Multiple topOp's

/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan ${testName2}_lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin ${testName2}_orders IxO_ORDERKEY "bound $I1 $1 =="
    | top "type INTEGER L_PARTKEY" 2
    | top "type INTEGER L_PARTKEY" 2
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// sort and topOp

/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    indexscan ${testName2}_lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin ${testName2}_orders IxO_ORDERKEY "bound $I1 $1 =="
    | sort "type INTEGER L_PARTKEY ASC"
    | top "type INTEGER L_PARTKEY" 2
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first

end ;
failure contains: 'EC_INVALID_PIPELINE' 

// gbyAgg and sort
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan ${testName2}_orders
    | gbyAgg " groupBy  type INTEGER as l_orderkey $1 aggregates type INTEGER $K1  , type INTEGER )  $2 sum "
    | sort "type INTEGER $1 ASC"
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first
end ;

failure contains: 'EC_ORDERBY_WITH_AGGREGATES'

// gbyAgg and top
/optimise_passthru 
pipeline Q
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_ORDERS on all partitions :
    scan ${testName2}_orders
    | gbyAgg " groupBy  type INTEGER as l_orderkey $1 aggregates type INTEGER $K1  , type INTEGER )  $2 sum "
    | top "type INTEGER $1 ASC" 3
    | combined 0
    | next

  stage last on origin :
     output
     | sink
     | first
end ;

failure contains: 'EC_INVALID_PIPELINE'

