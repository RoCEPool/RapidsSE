  ('N','F',1041.00,1614635.42,-64993.33,-132418.45,27.39,42490.41,1.04,38)
  ('N','O',75062.00,112768276.42,-5569437.53,-11358753.47,25.57,38408.81,1.05,2936)
  ('R','F',36470.00,54082045.78,-2697671.68,-5504499.33,25.05,37144.26,1.05,1456)

//------------------------------------------------------------------------------
// drop the tables
drop table lineitem;
success

//MemoryLeaks;
//rows: 0

CLEANUP {

  drop table lineitem;
  mute

  bye;
  mute
}