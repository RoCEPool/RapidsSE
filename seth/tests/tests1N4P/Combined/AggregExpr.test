   stage stageA on origin :
       aggreg 2 " type INTEGER as COL0 COL0 ,
                    type INTEGER as COL1 COL1 ,
                    type INTEGER as COL2 COL2 ,
                    type INTEGER as COL3 ) COL3 sum ,
                    type INTEGER as COL4 ) COL4 sum ,
                    type INTEGER as COL5 ) COL5 sum 14 +
         groupby type INTEGER COL0"
       | combined 0
       | next
   stage stageLast on origin :
     output
     | sink
     | stageStart
 end ;
