pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    scan rapidsse public part
    | filter 2 " type BOOLEAN  $4 'Brand#23'  ==  $7 'MED BAG'  ==  and  "
    | project " type INTEGER as P_PARTKEY P_PARTKEY"
    | combined 0
    | next broadcast
  stage stageB on all partitions :
    indexJoin 2 lineitem lineitem_part "bound $I1 $L1 =="
    | project " type integer as SUM_PARTKEY ) J1_L_PARTKEY sum"
    | combined 0
    | next
  stage stageC on all nodes :
    project " type integer as SUM_PARTKEY ) SUM_PARTKEY sum"
    | combined 0
    | next
  stage stageD on origin :
    project " type integer as SUM_PARTKEY ) SUM_PARTKEY sum"
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

rows: (3240)

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    scan rapidsse public part
    | filter 2 " type BOOLEAN  $4 'Brand#23'  ==  $7 'MED BAG'  ==  and  "
    | project " type INTEGER as P_PARTKEY P_PARTKEY"
    | combined 0
    | next broadcast
  stage stageB on all partitions :
    indexJoin 2 lineitem lineitem_part "bound $I1 $L1 =="
    | aggreg 2 " groupBy type integer $1 aggregates type integer as P_PARTKEY $K1 , type DECIMAL )  $6 sum  , type INTEGER )  $6 count  "
    | combined 0
    | next
  stage stageC on all nodes :
    aggreg 2 " groupBy  type integer $1 aggregates type integer as P_PARTKEY $K1 , type DECIMAL )  $2 sum  , type INTEGER )  $3 sum "
    | combined 0
    | next
  stage stageD on origin :
    aggreg 2 " groupBy  type integer $1 aggregates type integer as P_PARTKEY $K1 , type DECIMAL )  $2 sum  , type INTEGER )  $3 sum "
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

rows:
  (53,820.00,30)
  (55,773.00,30)

pipeline unnamed
begin

  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
      scan rapidsse public part
      | filter 2 " type BOOLEAN  $4 'Brand#23'  ==  $7 'MED BAG'  ==  and  "
      | project " type INTEGER as P_PARTKEY P_PARTKEY"
      | combined 0
      | next broadcast
  stage stageB on all partitions :
    indexJoin 2 lineitem lineitem_part "bound $I1 $L1 =="
    | aggreg 2 " groupBy type integer P_PARTKEY
                 aggregates type INTEGER as P_PARTKEY $K1 ,
                 type DECIMAL as SUM_EXT )  J1_L_EXTENDEDPRICE sum  ,
                 type INTEGER as CNT_EXT )  J1_L_EXTENDEDPRICE count"
    | combined 0
    | next
  stage stageC on all nodes :
    aggreg 2 " groupBy type integer P_PARTKEY
               aggregates
               type INTEGER as P_PARTKEY $K1 ,
               type DECIMAL as SUM_EXT ) SUM_EXT sum  ,
               type INTEGER as CNT_EXT )  CNT_EXT sum"
    | combined 0
    | next
  stage stageD on origin :
    aggreg 2 " groupBy type integer P_PARTKEY
               aggregates type integer as P_PARTKEY $K1 ,
               type DECIMAL as SUM_EXT ) SUM_EXT sum  ,
               type INTEGER as CNT_EXT )  CNT_EXT sum"
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;
