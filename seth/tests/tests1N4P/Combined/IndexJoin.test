pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker0374
  stage stageMarker0374 on all partitions :
    scan lineitem
    | filter 2 " type BOOLEAN  L_ORDERKEY 1480  >  "
    | indexjoin 2 Orders orders_orderkey "BOUND $I1 L_ORDERKEY =="
    | project 2 " type INTEGER as O_ORDERKEY J1_O_ORDERKEY , type TIMESTAMP as O_ORDERDATE J1_O_ORDERDATE  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
