create table L (l_int_col0 integer);
success

load L "../DATA/Joins/L.csv";
success

create table R(r_int_col0 integer, r_vch_col1 varchar);
success

create index R_idx on R(r_int_col0);
success

// join
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageMarker0142 on all partitions :
    scan rapidsse public L
    | indexJoin R R_idx " BOUND $I1 l_int_col0 ==" //J1
    | project " type INTEGER as l_int_col0 $1 , type INTEGER as J1_r_int_col0 $2 , type VARCHAR as J1_r_vch_col1 $3 "
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
end ;
rows: 0

