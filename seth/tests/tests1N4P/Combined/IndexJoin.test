rows: 76

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    scan rapidsse public part
    | filter 2 " type BOOLEAN  $4 'Brand#23'  ==  $7 'MED BAG'  ==  and  "
    | project 2 " type INTEGER as P_PARTKEY P_PARTKEY"
    | combined 0
    | next broadcast
  stage stageB on all partitions :
    indexJoin 2 lineitem lineitem_part "bound $I1 $L1 =="
    | project 2 " type integer as SUM_PARTKEY ) J1_L_PARTKEY sum"
    | combined 0
    | next
  stage stageC on all nodes :
    project 1 " type integer as SUM_PARTKEY ) SUM_PARTKEY sum"
    | next
  stage stageD on origin :
    project 1 " type integer as SUM_PARTKEY ) SUM_PARTKEY sum"
    | next
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

rows: (3240)

pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    scan rapidsse public part
    | filter 2 " type BOOLEAN  $4 'Brand#23'  ==  $7 'MED BAG'  ==  and  "
    | project 2 " type INTEGER as P_PARTKEY P_PARTKEY"
    | combined 0
    | next broadcast
  stage stageB on all partitions :
    indexJoin 2 lineitem lineitem_part "bound $I1 $L1 =="
    | aggreg 2 " type integer as P_PARTKEY $1 , type DECIMAL )  $6 sum  , type INTEGER )  $6 count  groupBy  type integer $1 "
    | combined 0
    | next
  stage stageC on all nodes :
    aggreg 1 " type integer as P_PARTKEY $1 , type DECIMAL )  $2 sum  , type INTEGER )  $3 sum  groupBy  type integer $1 "
    | next
  stage stageD on origin :
    aggreg 1 " type integer as P_PARTKEY $1 , type DECIMAL )  $2 sum  , type INTEGER )  $3 sum  groupBy  type integer $1 "
    | next
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

rows:
  (53,820.00,30)
  (55,773.00,30)

