--------------------------------------------------------------------------------
-- IndexJoin --- combined Operators
--------------------------------------------------------------------------------

trackMemory;
success;

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
);
success

create table T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
);
success

create index T2_a on T2(a);
success

load T1 "../DATA/Joins/T1.csv" ;
success

load T2 "../DATA/Joins/T2.csv" ;
success

pipeline indexJoinTest
begin
  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan T1
    | indexJoin T2 T2_a "BOUND $I1 a =="
    | combined 0
    | stageD

  stage stageD on origin :
    output | sink | stageA

end ;
