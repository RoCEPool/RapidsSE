 pipeline unnamed
 begin
   stage stageStart on origin :
     start
     | pulse once
     | stageA
   stage stageA on all partitions :
     scan rapidsse public LineItem
     | filter 2 " type BOOLEAN L_ORDERKEY 2 <"
     | project 2 " type INTEGER as L_ORDERKEY L_ORDERKEY , type VARCHAR L_SHIPMODE ,
       type VARCHAR L_COMMENT"
     | combined
     | stageLast
   stage stageLast on origin :
     output
     | sink
     | stageStart
 end ;
 rows:
