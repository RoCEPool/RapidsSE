pipeline Q3
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gj_ORDERS on all partitions :
    scan Orders
    | next

  stage Gj_LINEITEM on all partitions :
    indexjoin 2 Lineitem IxL_ORDERKEY "BOUND $I1 $L1 =="
    | filter 2 "type BOOLEAN J1_L_SHIPDATE TIMESTAMP '1995-03-15 00:00:00' >"

    | aggreg 2 expr groupby type INTEGER O_ORDERKEY
       aggregates type DECIMAL as Revenue ) J1_L_DISCOUNT sum , type INTEGER as _orderkey $K1
    | combined 0
    | next

  stage last on origin :
     output
    | sink
    | first

end ;

