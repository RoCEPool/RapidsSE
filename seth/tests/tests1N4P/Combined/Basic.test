// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  basic index scan
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
pipeline Q
  begin
  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_LINEITEM on all partitions :
    indexscan 2 lineitem IxL_SHIPDATE "LBOUND $I1 TIMESTAMP '1994-01-01 00:00:00' >=
                                       UBOUND $I1 TIMESTAMP '1995-01-01 00:00:00' <"
    //| project 2 "type TIMESTAMP L_SHIPDATE"

    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | first
  end ;

rows: 921

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  basic index join
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageM on all partitions :
    indexscan 2 lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin 2 orders IxO_ORDERKEY "bound $I1 $L1 =="
    | combined 0
    | stageLast

   stage stageLast on origin :
     output
     | sink
     | first
   end ;

rows: 5996

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  basic orderby
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker0143
  stage stageMarker0143 on all partitions :
    scan rapidsse public lineitem
    | project 2 " type INTEGER as l_orderkey $1 , type INTEGER as l_partkey $2 "
    | sort 2 " sort type INTEGER as l_partkey $2 ASC  "
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
end ;

rows: 6000

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  basic top
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    indexscan 2 lineitem IxL_SHIPDATE "lbound $I1 TIMESTAMP '1900-01-01 00:00:00' >= "
    | project 2 "type INTEGER $1 , type TIMESTAMP L_SHIPDATE"
    | top 2 "TOP type TIMESTAMP $2" 2
    | combined 0
    | next
  stage stageB on all nodes :
    top 2 "TOP type TIMESTAMP $2" 2
    | combined 0
    | next
  stage stageC on origin :
    top 2 "TOP type TIMESTAMP $2" 2
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
end ;

