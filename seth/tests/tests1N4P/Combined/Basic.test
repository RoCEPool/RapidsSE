// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  basic ordered aggregate
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    indexscan 2 lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | ordAgg 2 " ORDGROUPBY type integer $1
                 aggregates type integer $K1 , type decimal as total )  $5 sum  "
    | filter 2 " type BOOLEAN  $2 50.0  >  "
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | first
  end ;

