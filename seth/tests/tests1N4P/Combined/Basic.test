// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  basic index scan
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
pipeline Q
  begin
  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_LINEITEM on all partitions :
    indexscan 2 lineitem IxL_SHIPDATE "LBOUND $I1 TIMESTAMP '1994-01-01 00:00:00' >=
                                       UBOUND $I1 TIMESTAMP '1995-01-01 00:00:00' <"
    //| project 2 "type TIMESTAMP L_SHIPDATE"

    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | first
  end ;

rows: 921

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  basic index join
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
pipeline Q
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage stageM on all partitions :
    indexscan 2 lineitem IxL_ORDERKEY "lbound $I1 0 >="
    | indexJoin 2 orders IxO_ORDERKEY "bound $I1 $L1 =="
    | combined 0
    | stageLast

   stage stageLast on origin :
     output
     | sink
     | first
   end ;

rows: 5996

