--------------------------------------------------------------------------------
-- Filter-Join --- combined Operators
--------------------------------------------------------------------------------

trackMemory;
success;

create table ${testName}_lt (
  L_KEY   INTEGER NOT NULL,
  L_NAME  VARCHAR(32) NOT NULL
);
success

load ${testName}_lt "../DATA/Joins/leftTable.csv" ;
success

create table ${testName}_rt (
  R_KEY   INTEGER NOT NULL,
  R_NAME  VARCHAR(32) NOT NULL
);
success

create index ri on ${testName}_rt(r_key);
success

load ${testName}_rt "../DATA/Joins/rightTable.csv" ;
success


/optimise_passthru 
pipeline indexJoinExp
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan ${testName}_lt
    | filter " type BOOLEAN  L_KEY 2 <= "
    | indexJoin ${testName}_rt ri "BOUND $I1 $1 == "
    | combined 0
    | stageC
  stage stageC on origin :
    output | sink | stageA
end ;

rows:
 (1,'A',1,'D')
 (1,'A',1,'B')
 (1,'C',1,'D')
 (1,'C',1,'B')
 (2,'X',2,'F')

/optimise_passthru 
pipeline indexJoinExp
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan ${testName}_lt
    | filter " type BOOLEAN  L_KEY 2 < "
    | indexJoin ${testName}_rt ri "BOUND $I1 $1 == "
    | combined 0
    | stageC
  stage stageC on origin :
    output | sink | stageA
end ;

rows:
 (1,'A',1,'D')
 (1,'A',1,'B')
 (1,'C',1,'D')
 (1,'C',1,'B')

/optimise_passthru 
pipeline indexJoinExp
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan ${testName}_lt
    | filter " type BOOLEAN  L_KEY 2 >= "
    | indexJoin ${testName}_rt ri "BOUND $I1 $1 == "
    | combined 0
    | stageC
  stage stageC on origin :
    output | sink | stageA
end ;

rows:
 (2,'X',2,'F')

/optimise_passthru 
pipeline indexJoinExp
begin
  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan ${testName}_lt
    | filter " type BOOLEAN  L_KEY 2 >= "
    | indexJoin ${testName}_rt ri "BOUND $I1 $1 == "
    | combined 0
    | stageC
  stage stageC on origin :
    output | sink | stageA
end ;

//------------------------------------------------------------------------------
// drop the tables
drop table ${testName}_lt;
success

drop table ${testName}_rt;
success

MemoryLeaks;
rows: 0

CLEANUP {

  //drop table ${testName}_lt;
  //mute

  //drop table ${testName}_rt;
  //mute

  bye;
  mute
}