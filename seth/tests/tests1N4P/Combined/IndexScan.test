pipeline unnamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | next
  stage stageA on all partitions :
    indexScan 2 lineitem lineitem_ord "LBOUND $I1 0 >="
    | indexjoin 2 orders orders_ord "BOUND $I1 L_ORDERKEY =="
    | project 2 " type INTEGER as O_CUSTKEY J1_O_CUSTKEY , type INTEGER as O_ORDERKEY J1_O_ORDERKEY , type TIMESTAMP as O_ORDERDATE J1_O_ORDERDATE  "
    | filter 2 " type BOOLEAN O_CUSTKEY 120 > "
    | combined 0
    | next
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

