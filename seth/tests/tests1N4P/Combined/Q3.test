--------------------------------------------------------------------------------
-- Query1 --- Combined Operators
--------------------------------------------------------------------------------

trackMemory;
success;

create table lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B   3B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B   3B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B   3B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B   3B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B   3B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B   3B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B   3B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B   3B
  L_RETURNFLAG    VARCHAR(1) NOT NULL,      //  8)  2B   2B
  L_LINESTATUS    VARCHAR(1) NOT NULL,      //  9)  2B   2B
  l_SHIPDATE      DATE NOT NULL,            // 10)  8B   8B
  L_COMMITDATE    DATE NOT NULL,            // 11)  8B   8B
  L_RECEIPTDATE   DATE NOT NULL,            // 12)  8B   8B
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,     // 13) 26B  13B
  L_SHIPMODE      VARCHAR(10) NOT NULL,     // 14) 11B   5B
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B  23B
);
success

create index IxL_ORDERKEY  ON Lineitem (L_ORDERKEY)  ;
success;

load lineitem "../TPCH/SF_0001/lineitem.csv";
success

create table customer (
	C_CUSTKEY       INTEGER       NOT NULL,  // 0)
	C_NAME          VARCHAR(25)   NOT NULL,  // 1)
	C_ADDRESS       VARCHAR(40)   NOT NULL,  // 2)
	C_NATIONKEY     INTEGER       NOT NULL,  // 3)
	C_PHONE         CHAR(15)      NOT NULL,  // 4)
	C_ACCTBAL       DECIMAL(15,2) NOT NULL,  // 5)
	C_MKTSEGMENT    CHAR(10)      NOT NULL,  // 6)
	C_COMMENT       VARCHAR(117)  NOT NULL   // 7)
);
success

create index IxC_CUSTKEY  ON Customer (C_CUSTKEY)   ;
success

load customer "../TPCH/SF_0001/customer.csv";
success

create table orders (
	 O_ORDERKEY        INTEGER       NOT NULL,
	 O_CUSTKEY         INTEGER       NOT NULL,
	 O_ORDERSTATUS     CHAR(1)       NOT NULL,
	 O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
	 O_ORDERDATE       TIMESTAMP     NOT NULL,
	 O_ORDERPRIORITY   CHAR(15)      NOT NULL,
	 O_CLERK           CHAR(15)      NOT NULL,
	 O_SHIPPRIORITY    INTEGER       NOT NULL,
	 O_COMMENT         VARCHAR(79)   NOT NULL
) partition by (O_CUSTKEY);
success

create index IxO_CUSTKEY  ON orders  (O_CUSTKEY)  ;
success

load Orders "../TPCH/SF_0001/orders.csv";
success

/time pipeline Q3
begin

  stage first on origin :
    start
    | pulse once
    | next

  stage Gs_CUSTOMER on all partitions :
    indexscan 1 Customer IxC_CUSTKEY "LBOUND $I1 0 >="
    | filter 1 "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project 1 expr type INTEGER as _custkey C_CUSTKEY
    //| combined 0
    | next

  stage Gj_ORDERS on all partitions :
    indexjoin 1 Orders IxO_CUSTKEY "BOUND $I1 _custkey =="
     | filter 1 "type BOOLEAN J1_O_ORDERDATE TIMESTAMP '1995-03-15 00:00:00' <"
     | project 1 "type INTEGER as _orderkey J1_O_ORDERKEY ,
         type TIMESTAMP as O_ORDERDATE J1_O_ORDERDATE ,
         type INTEGER as O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash 1 expr type INTEGER _orderkey
    //| combined 0
    | next hashcast

  stage Gj_LINEITEM on all partitions :
    indexjoin 2 Lineitem IxL_ORDERKEY "BOUND $I1 _orderkey =="
    | filter 2 "type BOOLEAN J1_L_SHIPDATE TIMESTAMP '1995-03-15 00:00:00' >"
    | ordAgg 2 expr type INTEGER as _orderkey _orderkey ,
        type INTEGER as Revenue ) J1_L_EXTENDEDPRICE 1 J1_L_DISCOUNT - * sum ,
        type TIMESTAMP as O_ORDERDATE O_ORDERDATE ,
        type INTEGER as O_SHIPPRIORITY  O_SHIPPRIORITY
        groupby type INTEGER _orderkey
    | combined 0
    | next

  stage last on origin :
    output
    | sink
    | first

end ;

rows: 140

//------------------------------------------------------------------------------
// drop the tables
/*
drop table customer;
success

drop table orders;
success

drop table lineitem;
success
*/
MemoryLeaks;
rows: 0

CLEANUP {
/*
  drop table customer;
  mute

  drop table orders;
  mute

  drop table lineitem;
  mute
*/
  bye;
  mute
}