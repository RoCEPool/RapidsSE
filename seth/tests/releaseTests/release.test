--------------------------------------------------------------------------------
-- release test
--------------------------------------------------------------------------------

//
// This is meant to be a very simple sanity test of some very basic operations:
//   - creating a table
//   - querying metadata about the table
//   - loading data into the table
//   - querying data from the table
//   - dropping the table
//
// It is not intended to be much more than that. We simply want to ensure that the
// release functions on a range of different operating systems.
//


// There should be no tables loaded to start with.
lstbl;
rows: 0


// Create a simple table
create table ${testName2}_nation (
	 N_NATIONKEY       INTEGER      NOT NULL,
	 N_NAME            CHAR(25)     NOT NULL,
	 N_REGIONKEY       INTEGER      NOT NULL,
	 N_COMMENT         VARCHAR(152)
);
success


// Table should exist
lstbl;
rows:
  ('${testName2}_nation')


// Describe the columns in the table
lscol ${testName2}_nation;
unordered rows:
  ('N_NATIONKEY', 'INTEGER', 19,  0, false, true)
  ('N_NAME',      'VARCHAR', 25,  0, false, false)
  ('N_REGIONKEY', 'INTEGER', 19,  0, false, false)
  ('N_COMMENT',   'VARCHAR', 152, 0, true,  false)


// Create an index on the table
CREATE INDEX nation_idx1 ON ${testName2}_nation(n_nationkey, n_regionkey);
success


// Index should exist
lsidx ${testName2}_nation;
rows:
  ('nation_idx1',false,false)


// Index has the right columns
lsidxcol ${testName2}_nation nation_idx1;
rows:
  ('N_NATIONKEY', 'INTEGER', 19, 0, false, true)
  ('N_REGIONKEY', 'INTEGER', 19, 0, false, false)


// Can we explain a SELECT from this table?
EXPLAIN SELECT * FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT * FROM ${testName2}_nation"

-> -> projectOp
      » column: (Alias = N_NATIONKEY ; Expr = rapidsse.public.${testName2}_nation.N_NATIONKEY ; Ordinal Expr = $1)
      » column: (Alias = N_NAME ; Expr = rapidsse.public.${testName2}_nation.N_NAME ; Ordinal Expr = $2)
      » column: (Alias = N_REGIONKEY ; Expr = rapidsse.public.${testName2}_nation.N_REGIONKEY ; Ordinal Expr = $3)
      » column: (Alias = N_COMMENT ; Expr = rapidsse.public.${testName2}_nation.N_COMMENT ; Ordinal Expr = $4)

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')

// Can we run a basic SELECT against this table (no data)?
SELECT * FROM ${testName2}_nation;
rows: 0


// Can we explain a basic aggregate?
EXPLAIN SELECT COUNT(*) FROM ${testName2}_nation;
rows: (*,'explainPlan','
∆ mainSubquery
  » table alias: __subquery0002
  » correlated columns: (none)

-> statementMarker: select
   » queryText: "SELECT COUNT(*) FROM ${testName2}_nation"

-> -> projectOp
      » column: (Expr = COUNT(*) ; Ordinal Expr = COUNT(*))

-> -> -> tableScanOp
         » table: (rapidsse.public.${testName2}_nation)')


// Can we run a basic aggregate (no data)?
SELECT COUNT(*) FROM ${testName2}_nation;
rows:
  (0)


// Now lets load some basic data
load ${testName2}_nation "../DATA/TPCH/nation.tbl";
success


// Can we run a simple SELECT (with data)
SELECT * FROM ${testName2}_nation;
unordered rows:
  (0,'ALGERIA',0,' haggle. carefully final deposits detect slyly agai')
  (1,'ARGENTINA',1,'al foxes promise slyly according to the regular accounts. bold requests alon')
  (2,'BRAZIL',1,'y alongside of the pending deposits. carefully special packages are about the ironic forges. slyly special ')
  (3,'CANADA',1,'eas hang ironic, silent packages. slyly regular packages are furiously over the tithes. fluffily bold')
  (4,'EGYPT',4,'y above the carefully unusual theodolites. final dugouts are quickly across the furiously regular d')
  (5,'ETHIOPIA',0,'ven packages wake quickly. regu')
  (6,'FRANCE',3,'refully final requests. regular, ironi')
  (7,'GERMANY',3,'l platelets. regular accounts x-ray: unusual, regular acco')
  (8,'INDIA',2,'ss excuses cajole slyly across the packages. deposits print aroun')
  (9,'INDONESIA',2,' slyly express asymptotes. regular deposits haggle slyly. carefully ironic hockey players sleep blithely. carefull')
  (10,'IRAN',4,'efully alongside of the slyly final dependencies. ')
  (11,'IRAQ',4,'nic deposits boost atop the quickly final requests? quickly regula')
  (12,'JAPAN',2,'ously. final, express gifts cajole a')
  (13,'JORDAN',4,'ic deposits are blithely about the carefully regular pa')
  (14,'KENYA',0,' pending excuses haggle furiously deposits. pending, express pinto beans wake fluffily past t')
  (15,'MOROCCO',0,'rns. blithely bold courts among the closely regular packages use furiously bold platelets?')
  (16,'MOZAMBIQUE',0,'s. ironic, unusual asymptotes wake blithely r')
  (17,'PERU',1,'platelets. blithely pending dependencies use fluffily across the even pinto beans. carefully silent accoun')
  (18,'CHINA',2,'c dependencies. furiously express notornis sleep slyly regular accounts. ideas sleep. depos')
  (19,'ROMANIA',3,'ular asymptotes are about the furious multipliers. express dependencies nag above the ironically ironic account')
  (20,'SAUDI ARABIA',4,'ts. silent requests haggle. closely express packages sleep across the blithely')
  (21,'VIETNAM',2,'hely enticingly express accounts. even, final ')
  (22,'RUSSIA',3,' requests against the platelets use never according to the quickly regular pint')
  (23,'UNITED KINGDOM',3,'eans boost carefully special requests. accounts are. carefull')
  (24,'UNITED STATES',1,'y final packages. slow foxes cajole quickly. quickly silent platelets breach ironic accounts. unusual pinto be')


// Can we run a basic aggregate (with data)
SELECT COUNT(*) FROM ${testName2}_nation;
rows:
  (25)


// Truncate the table
TRUNCATE ${testName2}_nation;
success


// Validate that there are no more rows in the table
SELECT COUNT(*) FROM ${testName2}_nation;
rows:
  (0)


// Drop an index
DROP INDEX ${testName2}_nation nation_idx1;
success


// Index should no longer exist
lsidx ${testName2}_nation;
rows: 0


// Drop a table
DROP TABLE ${testName2}_nation;
success


// Table should no longer exist
lstbl;
rows: 0


CLEANUP {

  DROP TABLE ${testName2}_nation;
  mute

  // If this release test finishes too quickly then the calling script thinks that
  // Seth had a problem and the test is marked as a failure in Bamboo.
  SLEEP 5 SECONDS;
  mute
}