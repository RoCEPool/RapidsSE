/*----------------------------------------------------------------------------*/
/* uniFlt.test -- FLOAT DATUM tests                                           */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table uniFlt (
  flt_col FLOAT NOT NULL
);
success

load uniFlt "../FASTLOAD/Data/uniFlt.csv" ;
success

// check no of rows
tableScan uniFlt;
rows: 48

// check data
tableScan uniFlt;
rows:
  (0.0)
  (0.1)
  (0.2)
  (0.3)
