/*----------------------------------------------------------------------------*/
/* allTyp.test -- ALL TYPE DATUM tests                                       */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table allTyp (
  int_col1   INTEGER     NOT NULL,
  dec_col2   DECIMAL(10,2) NOT NULL,
  bol_col3   BOOLEAN     NOT NULL,
  dte_col4   TIMESTAMP   NOT NULL,
  flt_col5   FLOAT       NOT NULL,
  dec_col6   DECIMAL(10,2) NOT NULL,
  tme_col7   TIMESTAMP   NOT NULL,
  tsp_col8   TIMESTAMP   NOT NULL,
  vch_col9   VARCHAR(32) NOT NULL
);
success

load allTyp "../FASTLOAD/Data/allTyp.csv" ;
success

// check no of rows
tableScan allTyp;
rows: 4

// check data
tableScan allTyp;
rows:
  (0,0.0,true,DATE '2020-01-01',0.0,1.1,TIME '00:00:00','2020-01-01 00:00:00','1')
  (1,1.618,true,DATE '2020-12-01',1.618,10.01,TIME '06:30:00','2020-12-01 06:30:00','abcdefgh10')
  (2,248,false,DATE '2020-01-31',248,200.002,TIME '12:00:00','2020-01-31 12:00:00','abcdefghijklmnopqrstuvwxyz28')
  (3,3.141,false,DATE '2020-12-31',3.141,3000.0003,TIME '23:59:59','2020-12-31 23:59:59','abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ54')

// drop the table
drop table allTyp;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  // drop the table
  drop table allTyp;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/

