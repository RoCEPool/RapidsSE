/*----------------------------------------------------------------------------*/
/* anidx.test -- ANIDX command tests                                          */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// invalid
anidx;
failure contains: "EC_SYNTAX_ERROR; Line: 1; Column: 5; mismatched input ';'"

// invalid
anidx IntTbl;
failure contains: "EC_SYNTAX_ERROR; Line: 1; Column: 12; mismatched input ';'"

// invalid
anidx IntTbl idx1 idx2;
failure contains: "EC_SYNTAX_ERROR; Line: 1; Column: 18; extraneous input 'idx2'"

// Table does not exist
anidx IntTbl int_idx1;
failure contains: "Table does not exist"

// (1) create a table
create table IntTbl (
  int_col1  INTEGER NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  vch_col3  VARCHAR(32) NOT NULL,
  int_col4  INTEGER
);
success

// invalid
anidx IntTbl;
failure contains: "EC_SYNTAX_ERROR; Line: 1; Column: 12; mismatched input ';'"

// no such index
anidx IntTbl int_idx1;
failure contains: "no such index"

// create indexes
create index int_idx1 on IntTbl (int_col1);
success

// invalid
anidx IntTbl;
failure contains: "Error: EC_SYNTAX_ERROR; Line: 1; Column: 12; mismatched input ';'"

// invalid
anidx x int_idx1;
failure contains: "Table does not exist"

// success
anidx IntTbl int_idx1;
rows: 8

load IntTbl "../DATA/Datums/integer.csv" ;
warning contains: '16 rows were invalid'

// check no of rows
select * from IntTbl;
rows: 101

// success
anidx IntTbl int_idx1;
rows: 8

// drop the table
drop table IntTbl;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table IntTbl;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
