/*----------------------------------------------------------------------------*/
/* integer.test -- INTEGER DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table ${testName}_IntTbl (
  int_col1  INTEGER NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  vch_col3  VARCHAR(32) NOT NULL,
  int_col4  INTEGER
);
success

// create indexes
create index int_idx1 on ${testName}_IntTbl (int_col1);
success

create index int_idx2 on ${testName}_IntTbl (int_col4);
success

// check existence of index
lsidx ${testName}_IntTbl;
rows:
  ('int_idx1', false, false)
  ('int_idx2', false, false)

// check columns of index
lsidxcol ${testName}_IntTbl int_idx1;
rows:
  ('int_col1', 'INTEGER', 19, 0, false, true)

// check columns of index
lsidxcol ${testName}_IntTbl int_idx2;
rows:
  ('int_col4', 'INTEGER', 19, 0, true, false)

load ${testName}_IntTbl "../DATA/Datums/integer.csv" ;
failure contains: '16 invalid'

// check no of rows
select * from ${testName}_IntTbl;
rows: 101

// dump index int_idx1
dumpidx ${testName}_IntTbl int_idx1;
success

// dump index int_idx2
dumpidx ${testName}_IntTbl int_idx2;
success

/*
partitionScan ${testName}_IntTbl 0;
rows: 10

partitionScan ${testName}_IntTbl 1;
rows: 15

partitionScan ${testName}_IntTbl 2;
rows: 13

partitionScan ${testName}_IntTbl 3;
rows: 6

partitionScan ${testName}_IntTbl 4;
rows: 13

partitionScan ${testName}_IntTbl 5;
rows: 16

partitionScan ${testName}_IntTbl 6;
rows: 17

partitionScan ${testName}_IntTbl 7;
rows: 11
*/

// fetch
predicateFetch ${testName}_IntTbl "int_col1 13 =";
rows:
  (13,'one three',113,null)

// fetch
predicateFetch ${testName}_IntTbl "int_col1 14 =";
rows:
  (14,'one four',114,null)

export ${testName}_IntTbl "/tmp/integer.csv";
success

truncate ${testName}_IntTbl;
success

select * from ${testName}_IntTbl;
rows: 0

/*
partitionScan ${testName}_IntTbl 0;
rows: 0

partitionScan ${testName}_IntTbl 1;
rows: 0

partitionScan ${testName}_IntTbl 2;
rows: 0

partitionScan ${testName}_IntTbl 3;
rows: 0

partitionScan ${testName}_IntTbl 4;
rows: 0

partitionScan ${testName}_IntTbl 5;
rows: 0

partitionScan ${testName}_IntTbl 6;
rows: 0

partitionScan ${testName}_IntTbl 7;
rows: 0
*/

// fetch
predicateFetch ${testName}_IntTbl "int_col1 13 =";
rows: 0

// fetch
predicateFetch ${testName}_IntTbl "int_col1 14 =";
rows: 0

// load from exported file
load ${testName}_IntTbl "/tmp/integer.csv" ;
success

// check no of rows
select * from ${testName}_IntTbl;
rows: 101

// dump index int_idx1
dumpidx ${testName}_IntTbl int_idx1;
success

// dump index int_idx2
dumpidx ${testName}_IntTbl int_idx2;
success

/*
partitionScan ${testName}_IntTbl 0;
rows: 10

partitionScan ${testName}_IntTbl 1;
rows: 15

partitionScan ${testName}_IntTbl 2;
rows: 12

partitionScan ${testName}_IntTbl 3;
rows: 7

partitionScan ${testName}_IntTbl 4;
rows: 13

partitionScan ${testName}_IntTbl 5;
rows: 16

