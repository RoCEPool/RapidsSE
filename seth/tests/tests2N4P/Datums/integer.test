rows: 0

// fetch
// predicateFetch ${testName2}_IntTbl "int_col1 14 =";
SELECT * FROM ${testName2}_intTbl WHERE int_col1 = 14;
rows: 0

// load from exported file
load ${testName2}_IntTbl "/tmp/integer.csv" ;
success

// check no of rows
select * from ${testName2}_IntTbl;
rows: 101

// dump index int_idx1
// dumpidx ${testName2}_IntTbl int_idx1;
