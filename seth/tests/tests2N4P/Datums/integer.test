/*----------------------------------------------------------------------------*/
/* integer.test -- INTEGER DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackmemory force;
success

// (1) create a table
create table ${testName2}_IntTbl (
  int_col1  INTEGER NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  vch_col3  VARCHAR(32) NOT NULL,
  int_col4  INTEGER
);
success

// create indexes
create index int_idx1 on ${testName2}_IntTbl (int_col1);
success

create index int_idx2 on ${testName2}_IntTbl (int_col4);
success

// check existence of index
select * from tableIndexes where TableName = '${testName2}_IntTbl';
contains rows:
  (*, *, '${testName2}_IntTbl', 'int_idx1', false, false)
  (*, *, '${testName2}_IntTbl', 'int_idx2', false, false)

// check columns of index
select * from indexColumns where TableName = '${testName2}_IntTbl' and IndexName = 'int_idx1';
contains rows:
  (*, *, '${testName2}_IntTbl', 'int_idx1', 'int_col1', 'INTEGER', 19, 0, false, true)

// check columns of index
select * from indexColumns where TableName = '${testName2}_IntTbl' and IndexName = 'int_idx2';
contains rows:
  (*, *, '${testName2}_IntTbl', 'int_idx2', 'int_col4', 'INTEGER', 19, 0, true, false)

load ${testName2}_IntTbl "../DATA/Datums/integer.csv" ;
warning contains: '16 rows were invalid'

// check no of rows
select * from ${testName2}_IntTbl;
rows: 101

// dump index int_idx1
// dumpidx ${testName2}_IntTbl int_idx1;
// success

// dump index int_idx2
// dumpidx ${testName2}_IntTbl int_idx2;
// success

