rows:
  (13,'one three',113,null)

// fetch
// predicateFetch ${testName2}_IntTbl "int_col1 14 =";
SELECT * FROM ${testName2}_intTbl WHERE int_col1 = 14;
rows:
  (14,'one four',114,null)

export ${testName2}_IntTbl "/tmp/integer.csv";
success

truncate ${testName2}_IntTbl;
success

select * from ${testName2}_IntTbl;
rows: 0

