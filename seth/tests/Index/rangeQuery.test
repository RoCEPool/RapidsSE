/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

// (1) create the table
create table T1 (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

// (2) create an index on one column
create index idx1 on T1 (jA);
success

// (3) create an index on two columns
create index idx2 on T1 (jA,jB);
success

// (4) create an index on three columns
create index idx3 on T1 (jA,jB,jC);
success

// (5) create an index on one column
create index idx4 on T1 (jA,jB,jC,jD);
success

// (6) load the table
load T1 "../DATA/Index/rangeQuery.csv";
success

// (7) create an index on one column after oldLoad
create index T1_idx5 on T1 (jE);
success

// (8) create an index on two columns after oldLoad
create index T1_idx6 on T1 (jE,jA);
success

// exact bound
predicateFetch T1 "jA 5 ==" ;
rows: 0

// exact bound
predicateFetch T1 "jA -10 ==" ;
rows:
 (-10,20,30,40,'aa')

// exact bound
predicateFetch T1 "jA 12 ==" ;
rows:
  (12,22,32,42,'cc')

// exact bound with multiple matching rows
predicateFetch T1 "jA 18 ==" ;
rows:
  (18,28,38,48,'ii')
  (18,18,38,38,'ii')

// upper bound
predicateFetch T1 "jA 7 <=";
rows:
  (null,27,37,47,'hh')
  (-9223372036854775806,27,37,47,'hh')
  (-10,20,30,40,'aa')

// upper bound
predicateFetch T1 "jA 7 <";
rows:
  (null,27,37,47,'hh')
