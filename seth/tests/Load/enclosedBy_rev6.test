/*----------------------------------------------------------------------------*/
/* enclosedBy -- enclosedBy tests                                             */
/*----------------------------------------------------------------------------*/

create table T1 (
col_id      INTEGER,
col_vch     VARCHAR(15),
col_int     INTEGER NOT NULL,
col_decimal DECIMAL,
col_float   FLOAT NOT NULL,
col_tsp     TIMESTAMP,
col_bool    BOOLEAN,
col_comment VARCHAR(15)
);
success

// create an ndex
create index idx on T1 (col_id);
success

// load T1 with deafult enclosedBy
Load T1 "../DATA/Load/enclosedBy1.csv" ;
failure contains: '5 invalid'

// predicateFetch rows
tableScan T1;
rows: 2

predicateFetch T1 "col_id 1 =";
rows:
  (1,'''DAVE''s DATA''',9,9,9,TIMESTAMP '2018-04-04 09:00:00',true,' valid')

predicateFetch T1 "col_id 7 =";
rows:
  (7,'DAVE''s DATA',9,9,9,TIMESTAMP '2018-04-04 09:00:00',true,' valid')

// drop the table
drop table T1;
success

// create the table
create table T1 (
col_id      INTEGER,
col_vch     VARCHAR(15),
col_int     INTEGER NOT NULL,
col_decimal DECIMAL,
col_float   FLOAT NOT NULL,
col_tsp     TIMESTAMP,
col_bool    BOOLEAN,
col_comment VARCHAR(15)
);
success

// create an ndex
create index idx on T1 (col_id);
success

// load table T1 with <enclosed_by_leading> =  '
Load T1 "../DATA/Load/enclosedBy2.csv" <enclosed_by_leading> = "'" ;
failure contains: '1 invalid'

// predicateFetch rows
tableScan T1;
rows: 2

predicateFetch T1 "col_id 1 =";
rows:
  (1,'DAVE''s DATA',9,9,9,TIMESTAMP '2018-04-04 09:00:00',true,' valid')

predicateFetch T1 "col_id 3 =";
rows:
  (3,' DAVE''s DATA',9,9,9,TIMESTAMP '2018-04-04 09:00:00',true,' valid')

// drop the table
drop table T1;
success

