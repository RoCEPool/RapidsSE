stage S03 on all partitions :
  indexJoin supplier IxS_SUPPKEY "bound $I1 PS_SUPPKEY =="
  | project "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
             type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
             type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
             type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST"
  | combined 0
  | next broadcast

stage S04 on all partitions :
  indexJoin LINEITEM IxL_PARTKEY "bound $I1 P_PARTKEY =="
  | filter "type BOOLEAN L_SUPPKEY PS_SUPPKEY =="
  | project "type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY ,
             type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
             type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
             type DECIMAL ( 19  2 ) as AMOUNT L_EXTENDEDPRICE 1.0 L_DISCOUNT -  *  PS_SUPPLYCOST L_QUANTITY *  - "
  | combined 0
  | next broadcast

stage S05 on all partitions :
  indexJoin ORDERS IxO_ORDERKEY "bound $I1 L_ORDERKEY =="
  | project "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ,
             type INTEGER ( 19 ) as O_YEAR O_ORDERDATE extract_year ,
             type DECIMAL ( 19  2 ) as AMOUNT AMOUNT"
  | combined 0
  | next

stage S10 on all partitions :
  sort "type INTEGER ( 19 ) as S_NATIONKEY S_NATIONKEY ASC ,
        type INTEGER ( 19 ) as O_YEAR O_YEAR ASC"
  | combined 0
  | next

stage S07 on all partitions :
  ordAgg "ordGroupBy type INTEGER ( 19 ) S_NATIONKEY ,
                     type INTEGER ( 19 ) O_YEAR
