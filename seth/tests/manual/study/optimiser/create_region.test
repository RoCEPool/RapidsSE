--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

LOG 'Create region ...';

// create a table
create table region (
R_REGIONKEY       INTEGER NOT NULL,
R_NAME            CHAR(25) NOT NULL,
R_COMMENT         VARCHAR(152)
)
replicated
tablesize 1
;
success

//------------------------------------------------------------------------------
// create the indexes
CREATE INDEX IxR_REGIONKEY ON region(R_REGIONKEY);
affected: 0


-----------------------------------------------------------------------
// load the table
loadReplicated region "../TPCH/SF_0001/region.tbl";
success

//select count(*) from region;
//rows: (5)

compactidx region IxR_REGIONKEY;
success


CLEANUP {
}

