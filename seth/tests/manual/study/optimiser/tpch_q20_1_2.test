--------------------------------------------------------------------------------
-- tpch query20_1_2 
--------------------------------------------------------------------------------

LOG 'TPC-H Q20_1_2...';

trackMemory force;
success

/optimiser_trace
/transliterated
/weaved
/pipeline_Def
/pipelineName = "OptQ20_1_2"
select ps_suppkey
  from PartSupp
 where
       ps_availqty > ( select 0.5 * sum(l_quantity)
                         from lineitem
                        where l_partkey  =  ps_partkey
                          and l_suppkey  =  ps_suppkey
                          and l_shipdate >= '1994-01-01'
                          and l_shipdate <  '1995-01-01' )
;
   
rows: 1

MemoryLeaks;
rows: 0

CLEANUP {
}


