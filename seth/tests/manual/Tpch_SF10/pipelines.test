--------------------------------------------------------------------------------
-- TPC-H Setup
--------------------------------------------------------------------------------
INCLUDE FILE 'setup.test'
success

--------------------------------------------------------------------------------
-- PIPELINE QUERIES
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- Q1
--------------------------------------------------------------------------------
LOG 'Running Q1';
success

pipeline Query1
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan rapidsse public lineitem
    | filter " type BOOLEAN  $11 DATE '1998-09-01'  <=  "
    | gbyAgg " groupBy  type VARCHAR ( 0 ) L_RETURNFLAG , type VARCHAR ( 0 ) L_LINESTATUS
      aggregates
      type VARCHAR ( 0 ) as L_RETURNFLAG $K1 ,
      type VARCHAR ( 0 ) as L_LINESTATUS $K2 ,
      type DECIMAL ( 19  2 ) ) as SUM_QTY L_QUANTITY sum  ,
      type DECIMAL ( 19  2 ) ) as SUM_BASE_PRICE L_EXTENDEDPRICE sum  ,
      type DECIMAL ( 19  2 ) ) as SUM_DISC_PRICE L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  ,
      type DECIMAL ( 19  2 ) ) as SUM_CHARGE L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  1.  L_TAX +  *  sum  ,
      type INTEGER ( 19 ) ) L_EXTENDEDPRICE count  ,
      type INTEGER ( 19 ) ) L_QUANTITY count  ,
      type DECIMAL ( 19  2 ) ) L_DISCOUNT sum  ,
      type INTEGER ( 19 ) ) L_DISCOUNT count  ,
      type INTEGER ( 19 ) ) countAll  "
    | combined 0
    | next

  stage S02 on all nodes :
    gbyAgg " groupBy  type VARCHAR ( 0 ) L_RETURNFLAG , type VARCHAR ( 0 ) L_LINESTATUS
      aggregates
      type VARCHAR ( 0 ) as L_RETURNFLAG $K1 ,
      type VARCHAR ( 0 ) as L_LINESTATUS $K2 ,
      type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum ,
      type DECIMAL ( 19  2 ) as SUM_BASE_PRICE ) SUM_BASE_PRICE sum ,
      type DECIMAL ( 19  2 ) as SUM_DISC_PRICE ) SUM_DISC_PRICE sum ,
      type DECIMAL ( 19  2 ) as SUM_CHARGE ) SUM_CHARGE sum ,
      type INTEGER ( 19 ) ) $7 sum ,
      type INTEGER ( 19 ) ) $8 sum ,
      type DECIMAL ( 19  2 ) ) $9 sum ,
      type INTEGER ( 19 ) ) $10 sum ,
      type INTEGER ( 19 ) ) $11 sum "
    | combined 0
    | next

  stage S03 on origin :
    gbyAgg " groupBy  type VARCHAR ( 0 ) L_RETURNFLAG , type VARCHAR ( 0 ) L_LINESTATUS
      aggregates
      type VARCHAR ( 0 ) as L_RETURNFLAG $K1 ,
      type VARCHAR ( 0 ) as L_LINESTATUS $K2 ,
      type DECIMAL ( 19  2 ) as SUM_QTY ) SUM_QTY sum ,
      type DECIMAL ( 19  2 ) as SUM_BASE_PRICE ) SUM_BASE_PRICE sum ,
      type DECIMAL ( 19  2 ) as SUM_DISC_PRICE ) SUM_DISC_PRICE sum ,
      type DECIMAL ( 19  2 ) as SUM_CHARGE ) SUM_CHARGE sum ,
      type INTEGER ( 19 ) ) $7 sum ,
      type INTEGER ( 19 ) ) $8 sum ,
      type DECIMAL ( 19  2 ) ) $9 sum ,
      type INTEGER ( 19 ) ) $10 sum ,
      type INTEGER ( 19 ) as COUNT_ORDER ) $11 sum"
    | combined 0
    | next

  stage S04 on origin :
    project "
      type VARCHAR ( 0 ) as L_RETURNFLAG L_RETURNFLAG ,
      type VARCHAR ( 0 ) as L_LINESTATUS L_LINESTATUS ,
      type DECIMAL ( 19  2 ) as SUM_QTY SUM_QTY ,
      type DECIMAL ( 19  2 ) as SUM_BASE_PRICE SUM_BASE_PRICE ,
      type DECIMAL ( 19  2 ) as SUM_DISC_PRICE SUM_DISC_PRICE ,
      type DECIMAL ( 19  2 ) as SUM_CHARGE SUM_CHARGE ,
      type DECIMAL ( 19  2 ) as AVG_QTY SUM_QTY $8 casttype DECIMAL ( 19  2 ) CAST  / ,
      type DECIMAL ( 19  2 ) as AVG_PRICE SUM_BASE_PRICE $7 casttype DECIMAL ( 19  2 ) CAST  / ,
      type DECIMAL ( 19  2 ) as AVG_DISC $9 $10 casttype DECIMAL ( 19  2 ) CAST  / ,
      type INTEGER ( 19 ) as COUNT_ORDER COUNT_ORDER "
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;


--------------------------------------------------------------------------------
-- Q2
--------------------------------------------------------------------------------
LOG 'Running Q2';
success

pipeline Query2
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan part
    | filter " type BOOLEAN  }  P_TYPE '%BRASS' 6 matchTrailing P_SIZE 15 == and"
    | project " type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project " type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type INTEGER ( 19 ) as PS_SUPPKEY J1_PS_SUPPKEY ,
                type DECIMAL ( 19  2 ) as PS_SUPPLYCOST J1_PS_SUPPLYCOST"
    | hash "type INTEGER ( 19 ) PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as S_NATIONKEY J1_S_NATIONKEY "
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
               type DECIMAL ( 19  2 ) as PS_SUPPLYCOST PS_SUPPLYCOST ,
               type INTEGER ( 19 ) as N_REGIONKEY J1_N_REGIONKEY "
    | combined 0
    | next

  stage S05 on all partitions :
    indexJoin region IxR_REGIONKEY "BOUND $I1 N_REGIONKEY =="
    | filter " type BOOLEAN  J1_R_NAME 'EUROPE'  == "
    | gbyAgg " GroupBy    type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST min "
    | combined 0
    | next

  stage S06 on all nodes :
     gbyAgg " GroupBy     type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min "
    | combined 0
    | next

  stage S07 on origin :
     gbyAgg " GroupBy    type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY
               aggregates type INTEGER ( 19 ) as P_PARTKEY $K1 ,
                          type DECIMAL ( 19  2 ) as PS_SUPPLYCOST_MIN ) PS_SUPPLYCOST_MIN min "
    | hash "type INTEGER ( 19 ) P_PARTKEY"
    | combined 0
    | next hashcast

  stage S08 on all partitions :
    indexJoin partsupp IxPS_PARTKEY "BOUND $I1 P_PARTKEY =="
    | filter "type BOOLEAN PS_SUPPLYCOST_MIN J1_PS_SUPPLYCOST =="
    | project "type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type INTEGER ( 19 ) as PS_SUPPKEY J1_PS_SUPPKEY"
    | combined 0
    | next

  stage S09 on all partitions :
    indexJoin part IxP_PARTKEY "BOUND $I1 P_PARTKEY =="
    | project " type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type INTEGER ( 19 ) as PS_SUPPKEY PS_SUPPKEY ,
                type VARCHAR ( 0 ) as P_MFGR J1_P_MFGR"
    | hash "type INTEGER ( 19 ) PS_SUPPKEY"
    | combined 0
    | next hashcast

  stage S10 on all partitions :
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 PS_SUPPKEY =="
    | project " type INTEGER ( 19 ) as S_NATIONKEY J1_S_NATIONKEY ,
                type DECIMAL ( 19  2 ) as S_ACCTBAL J1_S_ACCTBAL ,
                type VARCHAR ( 0 ) as S_NAME J1_S_NAME ,
                type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                type VARCHAR ( 0 ) as P_MFGR P_MFGR ,
                type VARCHAR ( 0 ) as S_ADDRESS J1_S_ADDRESS ,
                type VARCHAR ( 0 ) as S_PHONE J1_S_PHONE ,
                type VARCHAR ( 0 ) as S_COMMENT J1_S_COMMENT "
    | combined 0
    | next

  stage S11 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project " type DECIMAL ( 19  2 ) as S_ACCTBAL S_ACCTBAL ,
                type VARCHAR ( 0 ) as S_NAME S_NAME ,
                type VARCHAR ( 0 ) as N_NAME J1_N_NAME ,
                 type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
                 type VARCHAR ( 0 ) as P_MFGR P_MFGR ,
                 type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS ,
                 type VARCHAR ( 0 ) as S_PHONE S_PHONE ,
                 type VARCHAR ( 0 ) as S_COMMENT S_COMMENT "
    | sort "type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
            type VARCHAR ( 0 ) N_NAME ASC ,
            type VARCHAR ( 0 ) S_NAME ASC ,
            type INTEGER ( 19 ) P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S12 on all nodes :
    sort "type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER ( 19 ) P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S13 on origin :
    sort "type DECIMAL ( 19  2 ) S_ACCTBAL DESC ,
          type VARCHAR ( 0 ) N_NAME ASC ,
          type VARCHAR ( 0 ) S_NAME ASC ,
          type INTEGER ( 19 ) P_PARTKEY ASC"
    | limit 100
    | combined 0
    | next

  stage S14 on origin :
    output
    | sink
    | first
end ;

--------------------------------------------------------------------------------
-- Q3
--------------------------------------------------------------------------------
LOG 'Running Q3';
success

pipeline Query3
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan Customer
    | filter "type BOOLEAN C_MKTSEGMENT 'BUILDING' =="
    | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexjoin Orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
    | filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-03-15' <"
    | project "type INTEGER ( 19 ) as O_ORDERKEY J1_O_ORDERKEY ,
               type DATE as O_ORDERDATE J1_O_ORDERDATE ,
               type INTEGER ( 19 ) as O_SHIPPRIORITY J1_O_SHIPPRIORITY"
    | hash "type INTEGER ( 19 ) O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    sort "type INTEGER ( 19 ) O_ORDERKEY ASC"
    | combined 0
    | next

  stage S04 on all partitions :
    indexjoin Lineitem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | filter "type BOOLEAN J1_L_SHIPDATE DATE '1995-03-15' >"
    | ordAgg " ordGroupBy type INTEGER ( 19 ) J1_L_ORDERKEY
               aggregates type INTEGER ( 19 ) as L_ORDERKEY $K1 ,
                          type DECIMAL ( 19  2 ) as REVENUE ) J1_L_EXTENDEDPRICE 1. J1_L_DISCOUNT -  *  sum  ,
                          type DATE as O_ORDERDATE  O_ORDERDATE ,
                          type INTEGER ( 19 ) as O_SHIPPRIORITY O_SHIPPRIORITY "
    | combined 0
    | next

  stage S05 on all partitions :
    sort " type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S06 on all nodes :
    sort " type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S07 on origin :
    sort " type DECIMAL ( 19  2 ) REVENUE DESC , type DATE O_ORDERDATE ASC  "
    | limit 10
    | combined 0
    | next

  stage S08 on origin :
    output
    | sink
    | first
end ;

--------------------------------------------------------------------------------
-- Q4
--------------------------------------------------------------------------------
LOG 'Running Q4';
success

pipeline Query4
begin

  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan orders
    | filter " type BOOLEAN O_ORDERDATE DATE '1993-07-01' >=
                            O_ORDERDATE DATE '1993-10-01' < and "
    | project "type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
               type VARCHAR ( 0 ) as O_ORDERPRIORITY O_ORDERPRIORITY"
    | hash "type INTEGER ( 19 ) O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    keyExists lineitem IxL_ORDERKEY  "BOUND $I1 O_ORDERKEY =="
                                      "type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
    | gbyAgg "groupby type VARCHAR ( 0 ) O_ORDERPRIORITY
              aggregates
              type VARCHAR ( 0 ) as O_ORDERPRIORITY $K1 ,
              type INTEGER ( 19 ) as ORDER_COUNT ) countAll"
    | combined 0
    | next

  stage S03 on all nodes :
    gbyAgg "groupby type VARCHAR ( 0 ) O_ORDERPRIORITY
            aggregates
            type VARCHAR ( 0 ) as O_ORDERPRIORITY $K1 ,
            type INTEGER ( 19 ) as ORDER_COUNT ) ORDER_COUNT sum"
    | combined 0
    | next

  stage S04 on origin :
    gbyAgg "groupby type VARCHAR ( 0 ) O_ORDERPRIORITY
            aggregates
            type VARCHAR ( 0 ) as O_ORDERPRIORITY $K1 ,
            type INTEGER ( 19 ) as ORDER_COUNT ) ORDER_COUNT sum"
    | combined 0
    | next

  stage S05 on origin :
    output
    | sink
    | first
end ;

--------------------------------------------------------------------------------
-- Q5
--------------------------------------------------------------------------------
LOG 'Running Q5';
success

pipeline Query5
begin
  stage stageStart on origin :
    start
    | pulse once
    | next

  stage S00 on all partitions :
    scan rapidsse public Orders
    | filter " type BOOLEAN O_ORDERDATE DATE '1994-01-01'  >=
                            O_ORDERDATE DATE '1995-01-01'  <  and  "
    | project "type INTEGER ( 19 ) as O_CUSTKEY O_CUSTKEY ,
               type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY"
    | combined 0
    | next

  stage S01 on all partitions :
    indexJoin Customer IxC_CUSTKEY "BOUND $I1 O_CUSTKEY =="
    | project "type INTEGER ( 19 ) as O_ORDERKEY O_ORDERKEY ,
               type INTEGER ( 19 ) as C_NATIONKEY J1_C_NATIONKEY"
    | hash "type INTEGER ( 19 ) O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S02 on all partitions :
    indexJoin Lineitem IxL_ORDERKEY "bound $I1 O_ORDERKEY =="
    | project "type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY ,
                   type INTEGER ( 19 ) as L_SUPPKEY J1_L_SUPPKEY ,
                   type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE J1_L_EXTENDEDPRICE ,
                   type DECIMAL ( 19  2 ) as L_DISCOUNT J1_L_DISCOUNT"
    | hash "type INTEGER ( 19 ) L_SUPPKEY"
    | combined 0
    | next hashcast

  stage S03 on all partitions :
    indexJoin Supplier IxS_SUPPKEY expr "bound $I1 L_SUPPKEY =="
    | filter " type BOOLEAN C_NATIONKEY J1_S_NATIONKEY == "
    | project "type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT ,
               type INTEGER ( 19 ) as S_NATIONKEY J1_S_NATIONKEY"
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin Nation IxN_NATIONKEY expr "bound $I1 S_NATIONKEY =="
    | project "type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR ( 0 ) as N_NAME J1_N_NAME ,
               type INTEGER ( 19 ) as N_REGIONKEY J1_N_REGIONKEY"
    | combined 0
    | next

  stage S05 on all partitions :
    indexJoin Region IxR_REGIONKEY expr "bound $I1 N_REGIONKEY =="
    | filter " type BOOLEAN J1_R_NAME 'ASIA'  ==  "
    | project "type DECIMAL ( 19  2 ) as L_EXTENDEDPRICE L_EXTENDEDPRICE ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT L_DISCOUNT ,
               type VARCHAR ( 0 ) as N_NAME N_NAME"
    | combined 0
    | next

  stage S06 on all partitions :
    gbyAgg " groupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
                        type DECIMAL ( 19  2 ) as REVENUE )  L_EXTENDEDPRICE 1.  L_DISCOUNT -  *  sum  "
    | combined 0
    | next

  stage S07 on all nodes :
    gbyAgg " groupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
                        type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  "
    | combined 0
    | next

  stage S08 on origin :
    gbyAgg " groupBy    type VARCHAR ( 0 ) as N_NAME N_NAME
             aggregates type VARCHAR ( 0 ) as N_NAME $K1 ,
             type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  "
    | combined 0
    | next

  stage S09 on origin :
    sort " type DECIMAL ( 19  2 ) REVENUE DESC  "
    | combined 0
    | next

  stage S10 on origin :
    output
    | sink
    | first
end ;

--------------------------------------------------------------------------------
-- Q6
--------------------------------------------------------------------------------
LOG 'Running Q6';
success

pipeline Query6
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     indexscan lineitem IxL_SHIPDATE "LBOUND $I1 DATE '1994-01-01' >= UBOUND $I1 DATE '1995-01-01' <"
     | filter " type BOOLEAN  }  0.05 0.07 L_DISCOUNT between L_QUANTITY 24. < and"
     | aggreg " type DECIMAL ( 19  2 ) as REVENUE ) L_EXTENDEDPRICE L_DISCOUNT *  sum  "
     | combined 0
     | next

   stage S02 on all nodes :
     aggreg " type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S03 on origin :
     aggreg " type DECIMAL ( 19  2 ) as REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S04 on origin :
     output
     | sink
     | first
end ;

--------------------------------------------------------------------------------
-- Q7
--------------------------------------------------------------------------------
LOG 'Running Q7';
success

pipeline Query7
begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     scan customer
     | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY , type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY"
     | combined 0
     | next

  stage S02 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY =="
    | filter "type BOOLEAN J1_N_NAME 'FRANCE' == J1_N_NAME 'GERMANY' == OR"
    | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY , type VARCHAR ( 0 ) as N2_N_NAME J1_N_NAME"
    | combined 0
    | next

   stage S03 on all partitions :
     indexJoin orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
     | project "type integer ( 19 ) as O_ORDERKEY J1_O_ORDERKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME"
     | hash "type INTEGER ( 19 ) O_ORDERKEY"
     | combined 0
     | next hashcast

   stage S04 on all partitions :
     indexJoin LineItem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
     | filter "type BOOLEAN } DATE '1995-01-01'  DATE '1996-12-31' J1_L_SHIPDATE between"
     | project "type INTEGER ( 19 ) as L_SUPPKEY J1_L_SUPPKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                type INTEGER ( 19 ) as L_YEAR J1_L_SHIPDATE extract_year ,
                type DECIMAL ( 19  2 ) as volume J1_L_EXTENDEDPRICE 1.00 J1_L_DISCOUNT -  * "
     | hash "type INTEGER ( 19 ) L_SUPPKEY "
     | combined 0
     | next hashcast

   stage S05 on all partitions :
     indexJoin Supplier IxS_SUPPKEY expr bound $I1 L_SUPPKEY ==
     | project "type INTEGER ( 19 ) as S_NATIONKEY J1_S_NATIONKEY ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                type INTEGER ( 19 ) as L_YEAR L_YEAR ,
                type DECIMAL ( 19  2 ) as VOLUME VOLUME"
     | combined 0
     | next

   stage S06 on all partitions :
     indexJoin Nation IxN_NATIONKEY expr bound $I1 S_NATIONKEY ==
     | filter "type BOOLEAN J1_N_NAME 'FRANCE' == N2_N_NAME 'GERMANY' == and
                            J1_N_NAME 'GERMANY' == N2_N_NAME 'FRANCE' == and or"
     | project "type VARCHAR ( 0 ) as N1_N_NAME J1_N_NAME ,
                type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                type INTEGER ( 19 ) as L_YEAR L_YEAR ,
                type DECIMAL ( 19  2 ) as VOLUME VOLUME"
     | combined 0
     | next

  stage S07 on all partitions :
     gbyAgg " groupBy type VARCHAR ( 0 ) as N1_N_NAME N1_N_NAME ,
                      type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                      type INTEGER ( 19 ) as L_YEAR L_YEAR aggregates
                      type VARCHAR ( 0 ) as N1_N_NAME $K1 ,
                      type VARCHAR ( 0 ) as N2_N_NAME $K2 ,
                      type INTEGER ( 19 ) as L_YEAR $K3 ,
                      type DECIMAL ( 19  2 ) AS REVENUE ) VOLUME sum  "
     | combined 0
     | next

   stage S08 on all nodes :
    gbyAgg " groupBy type VARCHAR ( 0 ) as N1_N_NAME N1_N_NAME ,
                     type VARCHAR ( 0 ) as N2_N_NAME N2_N_NAME ,
                     type INTEGER ( 19 ) as L_YEAR L_YEAR
                     aggregates
                     type VARCHAR ( 0 ) as N1_N_NAME $K1 ,
                     type VARCHAR ( 0 ) as N2_N_NAME $K2 ,
                     type INTEGER ( 19 ) as L_YEAR $K3 ,
                     type DECIMAL ( 19  2 ) AS REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S09 on origin :
     gbyAgg " groupBy type VARCHAR ( 0 ) as SUPP_NATION N1_N_NAME ,
                      type VARCHAR ( 0 ) as CUST_NATION N2_N_NAME ,
                      type INTEGER ( 19 ) as L_YEAR L_YEAR
                      aggregates
                      type VARCHAR ( 0 ) as N1_N_NAME $K1 ,
                      type VARCHAR ( 0 ) as N2_N_NAME $K2 ,
                      type INTEGER ( 19 ) as L_YEAR $K3 ,
                      type DECIMAL ( 19  2 ) AS REVENUE ) REVENUE sum  "
     | combined 0
     | next

   stage S10 on origin :
     output
     | sink
     | first
 end ;

--------------------------------------------------------------------------------
-- Q8
--------------------------------------------------------------------------------
LOG 'Running Q8';
success

pipeline Query8
begin
  stage S00 on origin :
    start
    | pulse once
    | next

  stage S01 on all partitions :
    scan customer
    | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
               type INTEGER ( 19 ) as C_NATIONKEY C_NATIONKEY"
    | combined 0
    | next

  stage S02 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 C_NATIONKEY =="
    | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY ,
               type INTEGER ( 19 ) as N_REGIONKEY J1_N_REGIONKEY"
    | combined 0
    | next

  stage S03 on all partitions :
    indexJoin region IxR_REGIONKEY "BOUND $I1 N_REGIONKEY =="
    | filter "type BOOLEAN J1_R_NAME 'AMERICA' =="
    | project "type INTEGER ( 19 ) as C_CUSTKEY C_CUSTKEY"
    | combined 0
    | next

  stage S04 on all partitions :
    indexJoin orders IxO_CUSTKEY "BOUND $I1 C_CUSTKEY =="
    | filter "type BOOLEAN J1_O_ORDERDATE DATE '1995-01-01' >=  J1_O_ORDERDATE DATE '1996-12-31' <= and"
    | project "type integer ( 19 ) as O_ORDERKEY J1_O_ORDERKEY ,
               type INTEGER ( 19 ) as O_YEAR J1_O_ORDERDATE extract_year"
    | hash "type INTEGER ( 19 ) O_ORDERKEY"
    | combined 0
    | next hashcast

  stage S05 on all partitions :
    indexJoin LineItem IxL_ORDERKEY "BOUND $I1 O_ORDERKEY =="
    | project "type INTEGER ( 19 ) as L_SUPPKEY J1_L_SUPPKEY ,
               type INTEGER ( 19 ) as L_PARTKEY J1_L_PARTKEY ,
               type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as l_extendedprice J1_l_extendedprice ,
               type DECIMAL ( 19  2 ) as l_discount J1_l_discount"
    | hash "type INTEGER ( 19 ) L_PARTKEY"
    | combined 0
    | next hashcast

  stage S06 on all partitions :
    indexJoin part IxP_PARTKEY "BOUND $I1 L_PARTKEY =="
    | filter "type BOOLEAN J1_P_TYPE 'ECONOMY ANODIZED STEEL' =="
    | project "type INTEGER ( 19 ) as L_SUPPKEY L_SUPPKEY ,
               type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
               type DECIMAL ( 19  2 ) as l_discount l_discount"
    | hash "type INTEGER ( 19 ) L_SUPPKEY"
    | combined 0
    | next hashcast

  stage S07 on all partitions :
    indexJoin supplier IxS_SUPPKEY "BOUND $I1 L_SUPPKEY =="
    | project "type INTEGER ( 19 ) as S_NATIONKEY J1_S_NATIONKEY ,
               type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as l_extendedprice l_extendedprice ,
               type DECIMAL ( 19  2 ) as l_discount l_discount"
    | combined 0
    | next

  stage S08 on all partitions :
    indexJoin nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | project "type INTEGER ( 19 ) as O_YEAR O_YEAR ,
               type DECIMAL ( 19  2 ) as VOLUME L_EXTENDEDPRICE 1.00 L_DISCOUNT -  * ,
               type VARCHAR ( 0 ) as NATION J1_N_NAME"
    | combined 0
    | next

  stage S09 on all partitions :
    gbyAgg " groupBy    type INTEGER ( 19 ) O_YEAR
             aggregates type INTEGER ( 19 ) as O_YEAR $K1 ,
                        type DECIMAL ( 19  2 )  ) VOLUME sum  ,
                        type DECIMAL ( 19  2 ) )  } type DECIMAL ( 19  2 ) NATION 'BRAZIL'  ==  WHEN  VOLUME THEN  0.00  ELSE  ENDIF  CASE  sum  "
    | combined 0
    | next

  stage S10 on all nodes :
    gbyAgg " groupBy    type INTEGER ( 19 ) O_YEAR
             aggregates type INTEGER ( 19 ) as O_YEAR $K1 ,
                        type DECIMAL ( 19  2 ) )  $2 sum  ,
                        type DECIMAL ( 19  2 ) )  $3 sum  "
    | combined 0
    | next

  stage S11 on origin :
    gbyAgg " groupBy    type INTEGER ( 19 ) O_YEAR
             aggregates type INTEGER ( 19 ) as O_YEAR $K1 ,
                        type DECIMAL ( 19  2 ) )  $2 sum  ,
                        type DECIMAL ( 19  2 ) )  $3 sum  "
    | combined 0
    | next

  stage S12 on origin :
    project " type INTEGER ( 19 ) as O_YEAR O_YEAR ,
              type DECIMAL ( 19  2 ) as mkt_share $3 $2 /  "
    | combined 0
    | next

  stage S13 on origin :
    output
    | sink
    | first
end ;

