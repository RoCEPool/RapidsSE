    | next

  stage S08 on all partitions :
    indexJoin Nation IxN_NATIONKEY "BOUND $I1 S_NATIONKEY =="
    | filter " type BOOLEAN J1_N_NAME 'CANADA' ==  "
    | project " type VARCHAR ( 0 ) as S_NAME S_NAME , type VARCHAR ( 0 ) as S_ADDRESS S_ADDRESS "
    | sort " type VARCHAR ( 0 ) S_NAME ASC  "
    | combined 0
    | next

  stage stageMarker1680 on origin :
    sort " type VARCHAR ( 0 ) S_NAME ASC  "
    | combined 0
    | next

  stage S07 on origin :
    output
    | sink
    | first
end ;

