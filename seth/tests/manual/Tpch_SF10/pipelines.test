-- Q19
--------------------------------------------------------------------------------
LOG 'Running Q19';
success

pipeline Query19
begin
 stage S00 on origin :
   start
   | pulse once
   | next

 stage S01 on all partitions :
   scan rapidsse public part
   | filter " type BOOLEAN P_BRAND 'Brand#12'  ==
                } 'SM CASE'  'M BOX'  'SM PACK'  'SM PKG'  #4  P_CONTAINER in  and
                }  1  5  P_SIZE between  and
                P_BRAND 'Brand#23'  ==
                }  'MED BAG'  'MED BOX'  'MED PKG'  'MED PACK'  #4 P_CONTAINER in and
                }  1  10  P_SIZE between  and  or P_BRAND 'Brand#34'  ==
                }  'LG CASE'  'LG BOX'  'LG PACK'  'LG PKG'  #4  P_CONTAINER in  and
                }  1  15  P_SIZE between  and or  "
   | project " type INTEGER ( 19 ) as P_PARTKEY P_PARTKEY ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type VARCHAR ( 0 ) as P_CONTAINER P_CONTAINER ,
               type INTEGER ( 19 ) AS P_SIZE P_SIZE"
   | combined 0
   | next broadcast

 stage S02 on all partitions :
   indexJoin lineitem IxL_PARTKEY "BOUND $I1 p_partkey ==" //J1
   | project " type INTEGER ( 19 ) as L_PARTKEY j1_l_partkey ,
               type DECIMAL ( 19  2 ) as L_QUANTITY J1_L_QUANTITY ,
               type DECIMAL ( 19  2 ) as L_DISCOUNT J1_L_DISCOUNT ,
               type DECIMAL ( 19  2 ) as l_extendedprice j1_l_extendedprice  ,
               type VARCHAR ( 0 ) as L_SHIPMODE J1_L_SHIPMODE ,
               type VARCHAR ( 0 ) as L_SHIPINSTRUCT J1_L_SHIPINSTRUCT ,
               type INTEGER ( 19 ) as P_SIZE P_SIZE ,
               type VARCHAR ( 0 ) as P_BRAND P_BRAND ,
               type varchar ( 0 ) as P_CONTAINER P_CONTAINER"
   | filter " type BOOLEAN P_BRAND 'Brand#12'  ==
                }  'SM CASE'  'M BOX'  'SM PACK'  'SM PKG'  #4  P_CONTAINER in  and
                }  L_QUANTITY 1.0 >= L_QUANTITY 11.0 <= and and
                }  1  5  P_SIZE between  and
                }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and
                L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and
                P_BRAND 'Brand#23'  ==
                }  'MED BAG'  'MED BOX'  'MED PKG'  'MED PACK'  #4 P_CONTAINER in and
                }  L_QUANTITY 10.0 >= L_QUANTITY 20.0 <= and and
                }  1  10  P_SIZE between  and
                }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and  or
                P_BRAND 'Brand#34'  ==
                }  'LG CASE'  'LG BOX'  'LG PACK'  'LG PKG'  #4  P_CONTAINER in  and
                }  L_QUANTITY 20.0 >= L_QUANTITY 30.0 <= and and }  1  15  P_SIZE between  and
                }  'AIR'  'AIR REG'  #2  L_SHIPMODE in  and
                L_SHIPINSTRUCT 'DELIVER IN PERSON'  ==  and  or  "
   | combined 0
   | next

stage S03 on all partitions :
   aggreg " type DECIMAL ( 19  2 ) )  L_EXTENDEDPRICE 1.00  L_DISCOUNT - * sum  "
   | combined 0
   | next

 stage S04 on all nodes :
   aggreg " type DECIMAL ( 19  2 ) )  $1 sum  "
   | combined 0
   | next

 stage S05 on origin :
   aggreg " type DECIMAL ( 19  2 ) as revenue )  $1 sum  "
   | combined 0
   | next

 stage S06 on origin :
   output
   | sink
   | first
end ;

