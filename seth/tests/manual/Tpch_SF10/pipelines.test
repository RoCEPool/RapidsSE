                     type VARCHAR ( 0 ) as NATION $K1 ,
                     type INTEGER ( 19 ) as O_YEAR $K2 ,
                     type DECIMAL ( 19  2 ) as SUM_PROFIT ) SUM_PROFIT sum  "
    | combined 0
