                type DECIMAL ( 19  2 ) )  }  }  J1_P_TYPE 'PROMO%'  6 matchLeading WHEN  L_EXTENDEDPRICE 1. L_DISCOUNT -  * THEN  0.  ELSE  ENDIF  CASE  sum  "
    | combined 0
    | next

  stage S03 on all nodes :
    aggreg " type DECIMAL ( 19  2 ) ) $1 sum  ,
              type DECIMAL ( 19  2 ) ) $2 sum  "
    | combined 0
    | next

  stage S04 on origin :
    aggreg " type DECIMAL ( 19  2 ) ) $1 sum  ,
              type DECIMAL ( 19  2 ) ) $2 sum  "
    | combined 0
    | next

  stage S05 on origin :
    project " type DECIMAL ( 19  2 ) as promo_revenue 100.00  $2 *  $1 /  "
    | combined 0
    | next

  stage S06 on origin :
    output
    | sink
    | first
end ;

