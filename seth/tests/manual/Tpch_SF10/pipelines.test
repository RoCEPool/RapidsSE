pipeline Query12
 begin
   stage S00 on origin :
     start
     | pulse once
     | next

   stage S01 on all partitions :
     indexScan lineitem IxL_RECEIPTDATE "LBOUND $I1 >= DATE '1994-01-01' UBOUND $I1 DATE '1995-01-01'  <"
     | filter " type BOOLEAN }  'MAIL'  'SHIP'  #2  L_SHIPMODE in"
     | filter " type BOOLEAN L_SHIPDATE L_COMMITDATE < "
     | filter " type BOOLEAN L_COMMITDATE L_RECEIPTDATE <"
     | project "type INTEGER ( 19 ) as L_ORDERKEY L_ORDERKEY , type VARCHAR ( 0 ) as L_SHIPMODE L_SHIPMODE"
     | combined 0
     | next broadcast

   stage S02 on all partitions :
     indexJoin Orders IxO_ORDERKEY expr bound $I1 L_ORDERKEY ==   // Orders - J1
     | project "type VARCHAR ( 0 ) as O_ORDERPRIORITY J1_O_ORDERPRIORITY , type VARCHAR ( 0 ) as L_SHIPMODE L_SHIPMODE"
     | combined 0
     | next

   stage S03 on all partitions :
     gbyAgg " groupBy  type VARCHAR ( 0 ) as L_SHIPMODE L_SHIPMODE aggregates type VARCHAR ( 0 ) $K1 , type INTEGER ( 19 ) ) }  O_ORDERPRIORITY '1-URGENT'  == O_ORDERPRIORITY '2-HIGH'  ==  or WHEN  1 THEN  0  ELSE  ENDIF  CASE  sum  , type INTEGER ( 19 ) ) }  O_ORDERPRIORITY '1-URGENT'  !=  O_ORDERPRIORITY '2-HIGH'  !=  and  WHEN  1 THEN  0  ELSE  ENDIF  CASE  sum  "
     | combined 0
     | next

   stage S04 on all nodes :
     gbyAgg " groupBy  type VARCHAR ( 0 ) as L_SHIPMODE $1 aggregates  type VARCHAR ( 0 ) $K1 , type INTEGER ( 19 ) )  $2 sum  , type INTEGER ( 19 ) )  $3 sum  "
     | combined 0
     | next

   stage S05 on origin :
     gbyAgg " groupBy  type VARCHAR ( 0 ) as L_SHIPMODE $1 aggregates  type VARCHAR ( 0 ) $K1 , type INTEGER ( 19 ) as high_line_count )  $2 sum  , type INTEGER ( 19 ) as low_line_count )  $3 sum  "
     | combined 0
     | next

   stage S06 on origin :
     output
     | sink
     | first
 end ;

