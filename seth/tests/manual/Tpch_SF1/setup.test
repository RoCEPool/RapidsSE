--------------------------------------------------------------------------------
-- Create Tables
--------------------------------------------------------------------------------
LOG 'Creating Tables';
success

create table lineitem (
  L_ORDERKEY      INTEGER       NOT NULL,
  L_PARTKEY       INTEGER       NOT NULL,
  L_SUPPKEY       INTEGER       NOT NULL,
  L_LINENUMBER    INTEGER       NOT NULL,
  L_QUANTITY      DECIMAL(15,2) NOT NULL,
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,
  L_TAX           DECIMAL(15,2) NOT NULL,
  L_RETURNFLAG    CHAR(1)       NOT NULL,
  L_LINESTATUS    CHAR(1)       NOT NULL,
  L_SHIPDATE      DATE          NOT NULL,
  L_COMMITDATE    DATE          NOT NULL,
  L_RECEIPTDATE   DATE          NOT NULL,
  L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
  L_SHIPMODE      CHAR(10)      NOT NULL,
  L_COMMENT       VARCHAR(44)   NOT NULL
);
success

create table orders (
   O_ORDERKEY        INTEGER       NOT NULL,
   O_CUSTKEY         INTEGER       NOT NULL,
   O_ORDERSTATUS     CHAR(1)       NOT NULL,
   O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
   O_ORDERDATE       DATE          NOT NULL,
   O_ORDERPRIORITY   CHAR(15)      NOT NULL,
   O_CLERK           CHAR(15)      NOT NULL,
   O_SHIPPRIORITY    INTEGER       NOT NULL,
   O_COMMENT         VARCHAR(79)   NOT NULL
) partition by (O_CUSTKEY)
;
success

create table partsupp (
  PS_PARTKEY      INTEGER       NOT NULL,
  PS_SUPPKEY      INTEGER       NOT NULL,
  PS_AVAILQTY     INTEGER       NOT NULL,
  PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
  PS_COMMENT      VARCHAR(199)  NOT NULL
);
success

create table part (
   P_PARTKEY           INTEGER       NOT NULL,
   P_NAME              VARCHAR(55)   NOT NULL,
   P_MFGR              CHAR(25)      NOT NULL,
   P_BRAND             CHAR(10)      NOT NULL,
   P_TYPE              VARCHAR(25)   NOT NULL,
   P_SIZE              INTEGER       NOT NULL,
   P_CONTAINER         CHAR(10)      NOT NULL,
   P_RETAILPRICE       DECIMAL(15,2) NOT NULL,
   P_COMMENT           VARCHAR(23)   NOT NULL
);
success

create table customer (
  C_CUSTKEY       INTEGER       NOT NULL,
  C_NAME          VARCHAR(25)   NOT NULL,
  C_ADDRESS       VARCHAR(40)   NOT NULL,
  C_NATIONKEY     INTEGER       NOT NULL,
  C_PHONE         CHAR(15)      NOT NULL,
  C_ACCTBAL       DECIMAL(15,2) NOT NULL,
  C_MKTSEGMENT    CHAR(10)      NOT NULL,
  C_COMMENT       VARCHAR(117)  NOT NULL
);
success

create table supplier (
   S_SUPPKEY       INTEGER       NOT NULL,
   S_NAME          CHAR(25)      NOT NULL,
   S_ADDRESS       VARCHAR(40)   NOT NULL,
   S_NATIONKEY     INTEGER       NOT NULL,
   S_PHONE         CHAR(15)      NOT NULL,
   S_ACCTBAL       DECIMAL(15,2) NOT NULL,
   S_COMMENT       VARCHAR(101)  NOT NULL
);
success

create table nation (
   N_NATIONKEY       INTEGER      NOT NULL,
   N_NAME            CHAR(25)     NOT NULL,
   N_REGIONKEY       INTEGER      NOT NULL,
   N_COMMENT         VARCHAR(152)
)
replicated
tableSize 1
;
success

create table region (
   R_REGIONKEY       INTEGER      NOT NULL,
   R_NAME            CHAR(25)     NOT NULL,
   R_COMMENT         VARCHAR(152)
)
replicated
tableSize 1
;
success


--------------------------------------------------------------------------------
-- Create Indexes
--------------------------------------------------------------------------------
LOG 'Creating Indexes';
success

CREATE INDEX IxL_ORDERKEY     ON lineitem (L_ORDERKEY);
success
CREATE INDEX IxL_PARTKEY      ON lineitem (L_PARTKEY);
success
CREATE INDEX IxL_SHIPDATE     ON lineitem (L_SHIPDATE);
success
CREATE INDEX IxL_SUPPKEY      ON lineitem (L_SUPPKEY);
success
CREATE INDEX IxL_RECEIPTDATE  ON lineitem (L_RECEIPTDATE);
success
CREATE INDEX IxO_CUSTKEY      ON orders   (O_CUSTKEY);
success
CREATE INDEX IxO_ORDERKEY     ON orders   (O_ORDERKEY);
success
CREATE INDEX IxO_ORDERDATE    ON orders   (O_ORDERDATE);
success
CREATE INDEX IxPS_SUPPKEY     ON partsupp (ps_suppkey);
success
CREATE INDEX IxPS_PARTKEY     ON partsupp (ps_partkey);
success
CREATE INDEX IxP_PARTKEY      ON part     (p_partkey);
success
CREATE INDEX IxC_CUSTKEY      ON customer (c_custkey);
success
CREATE INDEX IxC_NATIONKEY    ON customer (c_nationkey);
success
CREATE INDEX IxS_SUPPKEY      ON supplier (S_SUPPKEY);
success
CREATE INDEX IxS_NATIONKEY    ON supplier (S_NATIONKEY);
success
CREATE INDEX IxN_NATIONKEY    ON nation   (N_NATIONKEY);
success
CREATE INDEX IxN_REGIONKEY    ON nation   (N_REGIONKEY);
success
CREATE INDEX IxR_REGIONKEY    ON region   (R_REGIONKEY);
success


--------------------------------------------------------------------------------
-- Load Data & Compact Indexes
--------------------------------------------------------------------------------

-- We do this on a table by table approach so that the compact indexing will
-- reclaim some space.
LOG 'Loading Lineitem';
success
load lineitem "../TPCH/SF1/lineitem.tbl";
success
compact index lineItem IxL_ORDERKEY ;
success
compact index lineItem IxL_PARTKEY ;
success
compact index lineItem IxL_SHIPDATE ;
success
compact index lineItem IxL_SUPPKEY ;
success
compact index lineItem IxL_RECEIPTDATE ;
success

LOG 'Loading Orders';
success
load orders   "../TPCH/SF1/orders.tbl";
success
compact index orders IxO_CUSTKEY ;
success
compact index orders IxO_ORDERKEY ;
success
compact index orders IxO_ORDERDATE ;
success

LOG 'Loading Partsupp';
success
load partsupp "../TPCH/SF1/partsupp.tbl";
success
compact index partsupp IxPS_SUPPKEY ;
success
compact index partsupp IxPS_PARTKEY ;
success

LOG 'Loading Part';
success
load part     "../TPCH/SF1/part.tbl";
success
compact index part IxP_PARTKEY ;
success

LOG 'Loading Customer';
success
load customer "../TPCH/SF1/customer.tbl";
success
compact index customer IxC_CUSTKEY ;
success
compact index customer IxC_NATIONKEY ;
success

LOG 'Loading Supplier';
success
load supplier "../TPCH/SF1/supplier.tbl";
success
compact index supplier IxS_SUPPKEY ;
success
compact index supplier IxS_NATIONKEY ;
success

LOG 'Loading Nation';
success
loadReplicated nation   "../TPCH/SF1/nation.tbl";
success
compact index nation IxN_NATIONKEY ;
success
compact index nation IxN_REGIONKEY ;
success

LOG 'Loading Region';
success
loadReplicated region   "../TPCH/SF1/region.tbl";
success
compact index region IxR_REGIONKEY ;
success


--------------------------------------------------------------------------------
-- Validate Row Counts
--------------------------------------------------------------------------------

LOG 'Validating row counts';
success

SELECT COUNT(*) FROM lineitem;
rows: (6001215)

SELECT COUNT(*) FROM orders;
rows: (1500000)

SELECT COUNT(*) FROM partsupp;
rows: (800000)

SELECT COUNT(*) FROM part;
rows: (200000)

SELECT COUNT(*) FROM customer;
rows: (150000)

SELECT COUNT(*) FROM supplier;
rows: (10000)

