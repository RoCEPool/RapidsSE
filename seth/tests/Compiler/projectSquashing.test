/*----------------------------------------------------------------------------*/
/* ProjectOp Squashing                                                        */
/*                                                                            */
/* This deals with the case of pushing down and squashing ProjectOps that     */
/* are created as children of UnionOps when a CORRESPONDING BY clause is      */
/* specified.                                                                 */
/*----------------------------------------------------------------------------*/

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Setup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CREATE TABLE t1 (col1 INTEGER, col2 FLOAT, col3 DECIMAL, col4 VARCHAR, col5 BOOLEAN, col6 DATE, col7 TIME, col8 TIMESTAMP);
success

// same signature as tbl1 but with an extra column
CREATE TABLE t2 (col1 INTEGER, col2 FLOAT, col3 DECIMAL, col4 VARCHAR, col5 BOOLEAN, col6 DATE, col7 TIME, col8 TIMESTAMP, col9 INTEGER);
success

// same column names as t1 but different column types
CREATE TABLE t3 (col1 VARCHAR, col2 BOOLEAN, col3 DATE, col4 TIME, col5 TIMESTAMP, col6 INTEGER, col7 FLOAT, col8 DECIMAL);
success

// same column types as t1 but different column names
CREATE TABLE t4 (alpha INTEGER, bravo FLOAT, charlie DECIMAL, delta VARCHAR, echo BOOLEAN, foxtrot DATE, golf TIME, hotel TIMESTAMP);
success



// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic union all statements with CORRESPONDING BY clause
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN
SELECT * FROM t1
UNION ALL CORRESPONDING BY (col2, col4, col6)
SELECT * FROM t2;
rows:
(*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT * FROM t1 UNION ALL CORRESPONDING BY (col2, col4, col6) SELECT * FROM t2"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT * FROM t1"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t1.col2)
         » column: (Alias = col4 ; Expr = rapidsse.public.t1.col4)
         » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)

-> -> StatementMarker: select
      » queryText: "SELECT * FROM t2"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t2.col2)
         » column: (Alias = col4 ; Expr = rapidsse.public.t2.col4)
         » column: (Alias = col6 ; Expr = rapidsse.public.t2.col6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t2)'
)

-- alias in first query
EXPLAIN
SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4
UNION ALL CORRESPONDING BY (col2, col4, col6)
SELECT * FROM t1;
rows:
(*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4 UNION ALL CORRESPONDING BY (col2, col4, col6) SELECT * FROM t1"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t4.bravo)
         » column: (Alias = col4 ; Expr = rapidsse.public.t4.delta)
         » column: (Alias = col6 ; Expr = rapidsse.public.t4.foxtrot)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t4)

-> -> StatementMarker: select
      » queryText: "SELECT * FROM t1"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t1.col2)
         » column: (Alias = col4 ; Expr = rapidsse.public.t1.col4)
         » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)'
)

-- alias in second query
EXPLAIN
SELECT * FROM t1
UNION ALL CORRESPONDING BY (col2, col4, col6)
SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT * FROM t1 UNION ALL CORRESPONDING BY (col2, col4, col6) SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT * FROM t1"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t1.col2)
         » column: (Alias = col4 ; Expr = rapidsse.public.t1.col4)
         » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)

-> -> StatementMarker: select
      » queryText: "SELECT alpha as col1, bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t4.bravo)
         » column: (Alias = col4 ; Expr = rapidsse.public.t4.delta)
         » column: (Alias = col6 ; Expr = rapidsse.public.t4.foxtrot)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t4)'


-- alias in both queries
EXPLAIN
SELECT col1 as c1, col2 as c2, col3 as c3, col4 as c4, col5 as c5, col6 as c6, col7 as c7, col8 as c8 FROM t1
UNION ALL CORRESPONDING BY (c2, c4, c6)
SELECT alpha as c1, bravo as c2, charlie as c3, delta as c4, echo as c5, foxtrot as c6, golf as c7, hotel as c8 FROM t4;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT col1 as c1, col2 as c2, col3 as c3, col4 as c4, col5 as c5, col6 as c6, col7 as c7, col8 as c8 FROM t1 UNION ALL CORRESPONDING BY (c2, c4, c6) SELECT alpha as c1, bravo as c2, charlie as c3, delta as c4, echo as c5, foxtrot as c6, golf as c7, hotel as c8 FROM t4"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT col1 as c1, col2 as c2, col3 as c3, col4 as c4, col5 as c5, col6 as c6, col7 as c7, col8 as c8 FROM t1"

-> -> -> projectOp
         » column: (Alias = c2 ; Expr = rapidsse.public.t1.col2)
         » column: (Alias = c4 ; Expr = rapidsse.public.t1.col4)
         » column: (Alias = c6 ; Expr = rapidsse.public.t1.col6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)

-> -> StatementMarker: select
      » queryText: "SELECT alpha as c1, bravo as c2, charlie as c3, delta as c4, echo as c5, foxtrot as c6, golf as c7, hotel as c8 FROM t4"

-> -> -> projectOp
         » column: (Alias = c2 ; Expr = rapidsse.public.t4.bravo)
         » column: (Alias = c4 ; Expr = rapidsse.public.t4.delta)
         » column: (Alias = c6 ; Expr = rapidsse.public.t4.foxtrot)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t4)'
)

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Basic union all statements with just CORRESPONDING clause
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Test these aliases without the BY column list (just the CORRESPONDING clause)
EXPLAIN
SELECT * FROM t1
UNION ALL CORRESPONDING
SELECT * FROM t2;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT * FROM t1 UNION ALL CORRESPONDING SELECT * FROM t2"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT * FROM t1"

-> -> -> projectOp
         » column: (Alias = col1 ; Expr = rapidsse.public.t1.col1)
         » column: (Alias = col2 ; Expr = rapidsse.public.t1.col2)
         » column: (Alias = col3 ; Expr = rapidsse.public.t1.col3)
         » column: (Alias = col4 ; Expr = rapidsse.public.t1.col4)
         » column: (Alias = col5 ; Expr = rapidsse.public.t1.col5)
         » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6)
         » column: (Alias = col7 ; Expr = rapidsse.public.t1.col7)
         » column: (Alias = col8 ; Expr = rapidsse.public.t1.col8)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)

-> -> StatementMarker: select
      » queryText: "SELECT * FROM t2"

-> -> -> projectOp
         » column: (Alias = col1 ; Expr = rapidsse.public.t2.col1)
         » column: (Alias = col2 ; Expr = rapidsse.public.t2.col2)
         » column: (Alias = col3 ; Expr = rapidsse.public.t2.col3)
         » column: (Alias = col4 ; Expr = rapidsse.public.t2.col4)
         » column: (Alias = col5 ; Expr = rapidsse.public.t2.col5)
         » column: (Alias = col6 ; Expr = rapidsse.public.t2.col6)
         » column: (Alias = col7 ; Expr = rapidsse.public.t2.col7)
         » column: (Alias = col8 ; Expr = rapidsse.public.t2.col8)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t2)'
)

-- some aliases in first query
EXPLAIN
SELECT alpha, bravo as col2, charlie, delta as col4, echo, foxtrot as col6, golf, hotel FROM t4
UNION ALL CORRESPONDING
SELECT * FROM t1;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT alpha, bravo as col2, charlie, delta as col4, echo, foxtrot as col6, golf, hotel FROM t4 UNION ALL CORRESPONDING  SELECT * FROM t1"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT alpha, bravo as col2, charlie, delta as col4, echo, foxtrot as col6, golf, hotel FROM t4"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t4.bravo)
         » column: (Alias = col4 ; Expr = rapidsse.public.t4.delta)
         » column: (Alias = col6 ; Expr = rapidsse.public.t4.foxtrot)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t4)

-> -> StatementMarker: select
      » queryText: "SELECT * FROM t1"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t1.col2)
         » column: (Alias = col4 ; Expr = rapidsse.public.t1.col4)
         » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)'
)

-- aliases in second query
EXPLAIN
SELECT * FROM t1
UNION ALL CORRESPONDING
SELECT alpha, bravo as col2, charlie, delta as col4, echo, foxtrot as col6, golf, hotel FROM t4;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT * FROM t1 UNION ALL CORRESPONDING SELECT alpha, bravo as col2, charlie, delta as col4, echo, foxtrot as col6, golf, hotel FROM t4"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT * FROM t1"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t1.col2)
         » column: (Alias = col4 ; Expr = rapidsse.public.t1.col4)
         » column: (Alias = col6 ; Expr = rapidsse.public.t1.col6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)

-> -> StatementMarker: select
      » queryText: "SELECT alpha, bravo as col2, charlie, delta as col4, echo, foxtrot as col6, golf, hotel FROM t4"

-> -> -> projectOp
         » column: (Alias = col2 ; Expr = rapidsse.public.t4.bravo)
         » column: (Alias = col4 ; Expr = rapidsse.public.t4.delta)
         » column: (Alias = col6 ; Expr = rapidsse.public.t4.foxtrot)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t4)'
)

-- aliases in both queries
EXPLAIN
SELECT col1, col2 as c2, col3, col4 as c4, col5, col6 as c6, col7, col8 FROM t1
UNION ALL CORRESPONDING
SELECT alpha as c1, bravo as c2, charlie as c3, delta as c4, echo as c5, foxtrot as c6, golf as c7, hotel as c8 FROM t4;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT col1, col2 as c2, col3, col4 as c4, col5, col6 as c6, col7, col8 FROM t1 UNION ALL CORRESPONDING SELECT alpha as c1, bravo as c2, charlie as c3, delta as c4, echo as c5, foxtrot as c6, golf as c7, hotel as c8 FROM t4"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT col1, col2 as c2, col3, col4 as c4, col5, col6 as c6, col7, col8 FROM t1"

-> -> -> projectOp
         » column: (Alias = c2 ; Expr = rapidsse.public.t1.col2)
         » column: (Alias = c4 ; Expr = rapidsse.public.t1.col4)
         » column: (Alias = c6 ; Expr = rapidsse.public.t1.col6)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)

-> -> StatementMarker: select
      » queryText: "SELECT alpha as c1, bravo as c2, charlie as c3, delta as c4, echo as c5, foxtrot as c6, golf as c7, hotel as c8 FROM t4"

-> -> -> projectOp
         » column: (Alias = c2 ; Expr = rapidsse.public.t4.bravo)
         » column: (Alias = c4 ; Expr = rapidsse.public.t4.delta)
         » column: (Alias = c6 ; Expr = rapidsse.public.t4.foxtrot)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t4)')


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Project squashing into AggregateOps
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Basic group by. Note that the aggregation exprs gets factored
-- out because they don't have a common name because the columnRefs
-- are not symbolically equal. Need to give them an alias for the
-- aggregation exprs to be included (see below).
EXPLAIN
SELECT col1, SUM(col2), COUNT(col3) FROM t1 GROUP BY col1
UNION ALL CORRESPONDING
SELECT col1, SUM(col2), COUNT(col3) FROM t2 GROUP BY col1;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT col1, SUM(col2), COUNT(col3) FROM t1 GROUP BY col1 UNION ALL CORRESPONDING SELECT col1, SUM(col2), COUNT(col3) FROM t2 GROUP BY col1"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT col1, SUM(col2), COUNT(col3) FROM t1 GROUP BY col1"

-> -> -> aggregateOp
         » column: (Alias = col1 ; Expr = rapidsse.public.t1.col1)
         » group by: (rapidsse.public.t1.col1)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)

-> -> StatementMarker: select
      » queryText: "SELECT col1, SUM(col2), COUNT(col3) FROM t2 GROUP BY col1"

-> -> -> aggregateOp
         » column: (Alias = col1 ; Expr = rapidsse.public.t2.col1)
         » group by: (rapidsse.public.t2.col1)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t2)')

EXPLAIN
SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY col1
UNION ALL CORRESPONDING
SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1;
rows: (*,'explainPlan',
'StatementMarker: select
» queryText: "SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY col1 UNION ALL CORRESPONDING SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1"

-> unionOp
   » isDistinct: (false)

-> -> StatementMarker: select
      » queryText: "SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY col1"

-> -> -> aggregateOp
         » column: (Alias = col1 ; Expr = rapidsse.public.t1.col1)
         » column: (Alias = s2 ; Expr = SUM(rapidsse.public.t1.col2))
         » group by: (rapidsse.public.t1.col1)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t1)

-> -> StatementMarker: select
      » queryText: "SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1"

-> -> -> aggregateOp
         » column: (Alias = col1 ; Expr = rapidsse.public.t2.col1)
         » column: (Alias = s2 ; Expr = SUM(rapidsse.public.t2.col2))
         » group by: (rapidsse.public.t2.col1)

-> -> -> -> tableScanOp
            » table: (rapidsse.public.t2)'
)


-- aggregateOp with alias in the group by list in the first child query
EXPLAIN
SELECT col1 as c1, SUM(col2) as s2, COUNT(col3) FROM t1 GROUP BY c1
UNION ALL CORRESPONDING
SELECT col1, SUM(col2) as s2, COUNT(col3) FROM t2 GROUP BY col1;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Project squashing above a non-ProjectOp
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- squashing above a filterOp


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Nested union all statements
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

EXPLAIN
SELECT col1, col2, col3, col4, col5, col6, col7, col8 FROM t1
UNION ALL CORRESPONDING BY (col2, col4, col6)
(
  SELECT bravo as col2, charlie as col3, delta as col4, echo as col5, foxtrot as col6, golf as col7, hotel as col8 FROM t4,
  UNION ALL CORRESPONDING BY (col2, col4, col6, col8)
  SELECT * FROM t2
);
success


// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Cleanup
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

CLEANUP {
  DROP TABLE t1;
  mute

  DROP TABLE t2;
  mute

  DROP TABLE t3;
  mute

  DROP TABLE t4;
  mute
}