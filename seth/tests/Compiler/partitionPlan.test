--  (216) Select with grand total aggregates, WHERE, ORDER BY & LIMIT clauses
EXPLAIN STAGE partitionExplain
SELECT  MAX(c1) AS max1, MIN(c1) AS min1, SUM(c1) AS sum1, COUNT(c1) AS count1, AVG(c1) AS avg1, AVG(c2) AS avg2
