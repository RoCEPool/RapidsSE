// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  GROUP BY SELECTs
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
--  (300) Select with GROUP BY aggregates
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
GROUP BY c1
;
rows: (*, 'partitionExplain', *)

--  (301) Select with GROUP BY aggregates & WHERE clause
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
WHERE    c1 > 0
GROUP BY c1
;
rows: (*, 'partitionExplain', *)

--  (302) Select with GROUP BY aggregates & HAVING clause
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
GROUP BY c1
HAVING   min2 < 0
;
rows: (*, 'partitionExplain', *)

--  (303) Select with GROUP BY aggregates & ORDER BY clause
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
GROUP BY c1
ORDER BY min2
;
rows: (*, 'partitionExplain', *)

--  (304) Select with GROUP BY aggregates & LIMIT clause
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
GROUP BY c1
LIMIT    10
;
rows: (*, 'partitionExplain', *)

--  (305) Select with GROUP BY aggregates, HAVING clause & post-project
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
GROUP BY c1
HAVING   MAX(c1 + c2) > 0
;
rows: (*, 'partitionExplain', *)

--  (306) Select with GROUP BY aggregates, ORDER BY clause & post-project
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
GROUP BY c1
ORDER BY MAX(c1 + c2)
;
rows: (*, 'partitionExplain', *)

--  (307) Select with GROUP BY aggregates, HAVING, ORDER BY clauses & post-project
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
GROUP BY c1
HAVING   MAX(c1 + c2) > 0
ORDER BY min2
;
rows: (*, 'partitionExplain', *)

--  (308) Select with GROUP BY aggregates, WHERE and HAVING clauses
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
WHERE    c2 > 0
GROUP BY c1
HAVING   max2 > 0
;
rows: (*, 'partitionExplain', *)

--  (309) Select with GROUP BY aggregates, WHERE, HAVING clauses & post-project
EXPLAIN STAGE partitionExplain
SELECT   c1, MAX(c2) AS max2, MIN(c2) AS min2, SUM(c2) AS sum2, COUNT(c2) AS count2, AVG(c2) AS avg2
FROM     t1
WHERE    c2 > 0
GROUP BY c1
HAVING   MAX(c1 + c2) > 0
;
rows: (*, 'partitionExplain', *)

