/*----------------------------------------------------------------------------*/
/* integer.test -- INTEGER DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table IntTbl (
  int_col1  INTEGER NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  vch_col3  VARCHAR(32) NOT NULL,
  int_col4  INTEGER
);
success

// create indexes
create index int_idx1 on IntTbl (int_col1);
success

create index int_idx2 on IntTbl (int_col4);
success

// check existence of index
lsidx IntTbl;
rows:
  ('int_idx1', false, false)
  ('int_idx2', false, false)

// check columns of index
lsidxcol IntTbl int_idx1;
rows:
  ('int_col1', 'INTEGER', 19, 0, false, true)

// check columns of index
lsidxcol IntTbl int_idx2;
rows:
  ('int_col4', 'INTEGER', 19, 0, true, false)

Load IntTbl "../DATA/Datums/integer.csv" ;
failure contains: '16 invalid'

// check no of rows
tableScan IntTbl;
rows: 101

// dump index int_idx1
dumpidx IntTbl int_idx1;
success

// dump index int_idx2
dumpidx IntTbl int_idx2;
success

// fetch
predicateFetch intTbl "int_col1 13 =";
rows:
 (13,'one three',113,null)

// fetch
predicateFetch intTbl "int_col1 14 =";
rows:
  (14,'one four',114,null)

// drop the table
drop table IntTbl;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table IntTbl;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
