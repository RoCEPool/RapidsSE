/*----------------------------------------------------------------------------*/
/* lscat.test -- list catalogs                                                */
/*----------------------------------------------------------------------------*/

// track memory
trackMemory;
success

pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// list catalogs when not in catalogs folder
lscat;
failure contains: 'not in catalogs'

// cf to tenants
cf "~";
success

// list catalogs when not in catalogs folder
lscat;
failure contains: 'not in catalogs'

// cf to boray tenant
cf "boray";
success

// list catalogs when not in catalogs folder
lscat;
failure contains: 'not in catalogs'

// cf to catalogs
cf "catalogs";
success

// list catalogs when not in catalogs folder
lscat;
rows: ('rapidsse')

create catalog myCatalog;
success

lscat;
rows:
  ('rapidsse')
  ('myCatalog')

drop catalog myCatalog;
success

create catalog myCatalog;
success

lscat;
rows:
  ('rapidsse')
  ('myCatalog')

cf myCatalog;
success

cf schemas;
success

create schema mySchema;
success

cf "~catalogs";
success

pwf;
rows: ('/catalogs/boray/tenants/')

//! ALKA ENABLE once empty folder test in place
//drop catalog myCatalog;
//failure contains: 'folder not empty'

cf myCatalog;
success

cf schemas;
success

drop schema mySchema;
success

cf ..;
success

pwf;
rows: ('/myCatalog/catalogs/boray/tenants/')

cf ..;
success

pwf;
rows: ('/catalogs/boray/tenants/')

drop catalog myCatalog;
success

cf "~tables";
success

pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  drop catalog myCatalog;
  mute
  
  cf "~tables";
  mute;
  
  bye;
  mute
}

