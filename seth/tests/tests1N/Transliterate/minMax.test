--------------------------------------------------------------------------------
-- select all data types tests
--------------------------------------------------------------------------------

//------------------------------------------------------------------------------
// create table
create table datums (
  int_col0   INTEGER,
  int_col1  INTEGER,
  bol_col2   BOOLEAN,
  bol_col3   BOOLEAN,
  dte_col4   DATE,
  dte_col5   DATE,
  dec_col6   DECIMAL(19,2),
  dec_col7   DECIMAL(19,2),
  flt_col8   FLOAT,
  flt_col9  FLOAT,
  tme_col10  TIME,
  tme_col11  TIME,
  tsp_col12  TIMESTAMP,
  tsp_col13  TIMESTAMP,
  vch_col14  VARCHAR(32),
  vch_col15  VARCHAR(32)
);
success

load datums "../DATA/Datums/datums.csv" ;
success

//------------------------------------------------------------------------------
select min(int_col0) from datums;
rows:
 (1)
 (2)
 (3)

//------------------------------------------------------------------------------
select max(int_col0) from datums;
rows:
 (5)
 (7)
 (10)

//------------------------------------------------------------------------------
select min(dte_col4) from datums;
rows:
 (DATE '1941-01-01')
 (DATE '1941-01-10')
 (DATE '1941-01-01')

//------------------------------------------------------------------------------
select max(dte_col4) from datums;
rows:
 (DATE '1998-11-02')
 (DATE '1942-11-01')
 (DATE '1976-10-20')

//------------------------------------------------------------------------------
select min(dec_col6) from datums;
rows:
 (41.04)
 (41.04)
 (23.04)

//------------------------------------------------------------------------------
select max(dec_col6) from datums;
rows:
  (41.04)
  (4001.04)
  (41.04)

//------------------------------------------------------------------------------
select min(flt_col8) from datums;
rows:
 (10.22)
 (0.22)
 (0.22)

//------------------------------------------------------------------------------
select max(flt_col8) from datums;
rows:
 (10.22)
 (10.22)
 (10.22)

//------------------------------------------------------------------------------
select min(tme_col10) from datums;
rows:
 (TIME '10:23:31')
 (TIME '10:23:31')
 (TIME '10:23:31')

//------------------------------------------------------------------------------
select max(tme_col10) from datums;
rows:
 (TIME '11:23:31')
 (TIME '11:23:31')
 (TIME '10:23:31')

//------------------------------------------------------------------------------
select min(tsp_col12) from datums;
rows:
 (TIMESTAMP '1941-01-01 00:00:00')
 (TIMESTAMP '1941-01-01 00:00:00')
 (TIMESTAMP '1941-01-01 00:00:00')

//------------------------------------------------------------------------------
select max(tsp_col12) from datums;
rows:
 (TIMESTAMP '1972-01-01 12:00:00')
 (TIMESTAMP '1972-01-01 12:00:00')
 (TIMESTAMP '1941-01-01 00:00:00')

//------------------------------------------------------------------------------
// drop the table
drop table datums;
success;

CLEANUP {
  
  drop table datums;
  mute
  
  bye;
  mute
}