/*----------------------------------------------------------------------------*/
/* An example showing looping of commands.                                    */
/*----------------------------------------------------------------------------*/

// First, ensure that the table foo does not exist.
drop table foo;
mute


// Loop for a period of time, executing all the commands in
// the enclosing block below
LOOP FOR 5 SECONDS {

  -- We also accept HOURS, MINUTES, and MILLISECONDS.
  -- We could have also looped for a certain iteration count by 
  -- specifying:  LOOP <iterationCount>
  -- or looping forever:  LOOP


  create table foo (col0 integer, col1 varchar);
  success

  lstbl;
  rows:
    ('foo')

  create index fooIdx on foo (col0);
  success

  lsidx foo;
  rows:
    ('fooIdx',false,false)

  lsidxcol foo fooIdx;
  rows:
    ('col0', 'INTEGER', 19, 0, true, true)

  drop index foo fooIdx;
  success

  drop table foo;
  success

} -- end of loop


CLEANUP {
  drop table foo;
  mute
}
