/*----------------------------------------------------------------------------*/
/* truncate table tests                                                       */
/*----------------------------------------------------------------------------*/

trackMemory;
success;

indexEntries 200;
success;

// truncate where table does not exist
truncate noTable;
failure contains: 'no such table'

// create a table
create table LINEITEM (
  l_orderkey INTEGER NOT NULL,
  l_partkey INTEGER NOT NULL,
  l_suppkey INTEGER NOT NULL,
  l_linenumber INTEGER,
  l_quantity INTEGER,
  l_extendedprice DECIMAL(15, 2),
  l_discount DECIMAL(15, 2),
  l_tax DECIMAL(15, 2),
  l_returnflag VARCHAR(1),
  l_linestatus VARCHAR(1),
  l_shipdate TIMESTAMP,
  l_commitdate TIMESTAMP,
  l_receiptdate TIMESTAMP,
  l_shipinstruct VARCHAR(25),
  l_shipmode VARCHAR(10),
  l_comment VARCHAR(44)
);
success

//------------------------------------------------------------------------------
// create an index on custkey
CREATE INDEX LINEITEM_IDX1 ON LINEITEM(l_orderkey);
affected: 0

// check existence of index
lsidx lineitem;
rows:
  ("LINEITEM_IDX1",false,false)

// check columns of index
lsidxcol lineitem LINEITEM_IDX1;
rows:
  ("l_orderkey", "INTEGER", 19, 0, false, true)

// truncate when table is empty
truncate lineitem;
success

// fetch
tableScan lineitem;
rows: 0

// load the table
load lineitem "../DATA/Regression/lineitem.csv";
success

// truncate the table
truncate lineitem;
success

// fetch
tableScan lineitem;
rows: 0

// now drop the table
drop table lineitem;
success

indexEntries 0;
success

memoryLeaks;
rows: 0;

CLEANUP {

  drop table lineitem;
  mute

  indexExtries 0;
  mute

  bye;
  mute
}

