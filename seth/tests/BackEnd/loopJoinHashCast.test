--------------------------------------------------------------------------------
-- LOOP JOIN tests --- CO-PARTITIONED JOINS (HASHCAST)
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
// PARTITIONABLE JOIN
// T.a = J.a
// PtnKey[T] = c
// PtnKey[J] = a

create table T1 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (c);
success

load T1 "../DATA/Joins/T1.csv" ;
success

create table T2 (
	 a       INTEGER,
	 b       INTEGER,
	 c       INTEGER,
	 d       VARCHAR(15)
) partition by (a);
success

load T2 "../DATA/Joins/T2.csv" ;
success

pipeline loopJoinPart
begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan T1 | hash 0 "type INTEGER $1" | stageC hashcast

  stage stageC on all partitions :
    scanRight T2 | loopJoin 0 "$L1 $R1 ==" | stageD

  stage stageD on origin :
    output | sink | stageA

end;
rows:
  (1,1001,1101,'T-ROW1',1,181,111,'J-ROW1')
  (3,303,33993,'T-ROW3',3,3344,333,'J-ROW3a')
  (3,303,33993,'T-ROW3',3,337,3339,'J-ROW3b')
  (4,null,4344,'T-ROW4',4,464,444,'J-ROW4')
  (6,6576,null,'T-ROW6',6,null,666,'J-ROW6')
  (7,727,7377,'T-ROW7',7,7347,null,'J-ROW7')

drop table T1;
success

drop table T2;
success

MemoryLeaks;
rows: 0

CLEANUP {
  
  drop table T1;
  mute

  drop table T2;
  mute

  bye;
  mute
}