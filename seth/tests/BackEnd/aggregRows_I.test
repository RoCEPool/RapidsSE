--------------------------------------------------------------------------------
-- aggregRows_I tests
--------------------------------------------------------------------------------

trackMemory;
success;

//------------------------------------------------------------------------------
aggregRows_I lineitem "l_discount sum";
failure contains: "EC_NO_SUCH_TABLE"

//------------------------------------------------------------------------------
// create table lineitem
create table LineItem
(
 L_ORDERKEY      INTEGER       NOT NULL,
 L_PARTKEY       INTEGER       NOT NULL,
 L_SUPPKEY       INTEGER       NOT NULL,
 L_LINENUMBER    INTEGER       NOT NULL,
 L_QUANTITY      DECIMAL(15,2) NOT NULL,
 L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
 L_DISCOUNT      DECIMAL(15,2) NOT NULL,
 L_TAX           DECIMAL(15,2) NOT NULL,
 L_RETURNFLAG    CHAR(1)       NOT NULL,
 L_LINESTATUS    CHAR(1)       NOT NULL,
 L_SHIPDATE      DATE NOT      NULL,
 L_COMMITDATE    DATE NOT      NULL,
 L_RECEIPTDATE   DATE NOT      NULL,
 L_SHIPINSTRUCT  CHAR(25)      NOT NULL,
 L_SHIPMODE      CHAR(10)      NOT NULL,
 L_COMMENT       VARCHAR(44)   NOT NULL
 );
success

//------------------------------------------------------------------------------
aggregRows_I lineitem " l_discount * 2";
failure contains: "invalid command"

//------------------------------------------------------------------------------
aggregRows_I lineitem "l_discount sum groupby l_orderkey";
failure contains: "invalid command"

//------------------------------------------------------------------------------
aggregRows_I lineitem "l_orderkey , l_discount sum groupby l_orderkey";
rows: 0

// load data
load lineitem "../DATA/TPCH/lineitem10.csv";
success

//------------------------------------------------------------------------------
aggregRows_I lineitem "l_discount sum";
rows:
  (0.71)

//------------------------------------------------------------------------------
aggregRows_I lineitem "L_COMMENT sum";
failure contains: "invalid command"

//------------------------------------------------------------------------------
aggregRows_I lineitem "L_ORDERKEY sum";
rows:
  (17)

//------------------------------------------------------------------------------
aggregRows_I lineitem "L_LINENUMBER sum";
rows:
 (28)

//------------------------------------------------------------------------------
aggregRows_I lineitem "L_LINENUMBER sum , L_ORDERKEY sum";
rows:
 (28, 17)

//------------------------------------------------------------------------------
aggregRows_I lineitem "L_RETURNFLAG sum";
failure contains: "invalid command"

//------------------------------------------------------------------------------
aggregRows_I lineitem "L_COMMITDATE sum";
failure contains: "invalid command"

//------------------------------------------------------------------------------
aggregRows_I lineitem "L_SHIPINSTRUCT sum";
failure contains: "invalid command"

//------------------------------------------------------------------------------
// drop the table
drop table lineitem;
success;

MemoryLeaks;
rows: 0

CLEANUP {
  
  drop table lineitem;
  mute
  
  bye;
  mute
}


