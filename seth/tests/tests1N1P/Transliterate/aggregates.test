// - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//  Projected superset of group by
// - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- projected ColumnRef is superset of GROUP BY expr
SELECT 2*(n_nationkey + 1), SUM(n_regionkey) FROM nation GROUP BY n_nationkey;
rows:
  (30,0)
  (32,0)
  (44,2)
 
  (2,0)
  (8,2)
  (10,4)
  (14,3)
