#!/bin/bash

# Cluster config file.
# A cluster.config file can be created by hand (see note), or automatically
# via the installation wizard.
#
# Note: This file is a bash script expected to be sourced by other scripts.
#       As such it must be a syntactically valid bash script.

# Guard against direct execution
if [ "${BASH_SOURCE[0]}" -ef "$0" ]; then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

CONFIG_VERSION="1"
CONFIG_CREATED="2021-02-24T11:31:53"

declare -ga NODE_LIST
NODE_LIST=( "NODE0" )

declare -gA NODE_CFG_NODE0
NODE_CFG_NODE0["params"]=""
NODE_CFG_NODE0["threads"]="10"
NODE_CFG_NODE0["host"]="localhost"
NODE_CFG_NODE0["name"]="NODE0"
NODE_CFG_NODE0["partitions"]="4"
NODE_CFG_NODE0["mem"]="6"
NODE_CFG_NODE0["dir"]="/opt/rapidsse/NODE0"
NODE_CFG_NODE0["port"]="5541"
