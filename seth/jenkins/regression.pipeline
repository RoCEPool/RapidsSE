// Jenkins pipeline configuration file for running regression tests.
// N.B.: Thie file is written in groovy syntax. It accepts comments
// in the form of C++ line comments (//) and C block comments (/*..*/).

pipeline {
  agent {
    label 'jenkinsMaster'
  }

  stages {
    stage('Build') {
      steps {
        echo 'Building..'
        sh 'echo "PWD = ${PWD}"'
        // test of a command that returns an error exit code
        false
        cd src

      }
    }

    stage('Install') {
      steps {
        echo 'Installing..'
      }
    }

    stage('Test') {
      steps {
        echo 'Testing..'
      }
    }
  }

}
