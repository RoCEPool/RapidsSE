// Jenkins pipeline configuration file for running regression tests.
// N.B.: Thie file is written in groovy syntax. It accepts comments
// in the form of C++ line comments (//) and C block comments (/*..*/).
// '#' line comments can only be used when inside a shell script
// block (i.e., one that starts with sh 'some_script').
//
// Some syntax support can be found here:
// https://www.jenkins.io/doc/book/pipeline/syntax/#declarative-steps



pipeline {
  agent {
    label 'jenkinsMaster'
  }

  options {
    // Build has failed if it has taken this long
    timeout(time: 1, unit: 'HOURS')

    // Only run one of these builds at a time
    disableConcurrentBuilds()

    // Prepend timestamps to all console output
    timestamps()
  }

  stages {
    stage('Build Release') {
      steps {
        sh 'seth/jenkins/build.sh release'
      }
    }

    stage('Install Release') {
      steps {
        sh 'seth/jenkins/install.sh seth/jenkins/1node.config'
      }
    }

    stage('Start Release') {
      steps {
        sh 'seth/jenkins/start.sh seth/jenkins/1node.config'
      }
    }

    stage('Test Release') {
      steps {
        echo 'Testing..'
        sh 'seth/jenkins/test.sh seth/jenkins/1node.config'
        // capture logs if they are not huge
        // capture test results
      }
    }

    stage('Stop Release') {
      steps {
        sh 'seth/jenkins/stop.sh seth/jenkins/1node.config'
      }
    }

  }


//  post {
    // any steps to run after the stages have completed
    // (successfully or not).
    // e.g. send an email on a change
//  }

}
