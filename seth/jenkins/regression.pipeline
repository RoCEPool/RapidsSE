// Jenkins pipeline configuration file for running regression tests.
// N.B.: Thie file is written in groovy syntax. It accepts comments
// in the form of C++ line comments (//) and C block comments (/*..*/).
// '#' line comments can only be used when inside a shell script
// block (i.e., one that starts with sh 'some_script').
//
// Some syntax support can be found here:
// https://www.jenkins.io/doc/book/pipeline/syntax/#declarative-steps



pipeline {
  agent {
    // Run on the machine with this label
    label 'jenkinsMaster'
  }

  options {
    // Build has failed if it has taken this long
    timeout(time: 90, unit: 'MINUTES')

    // Only run one of these builds at a time
    disableConcurrentBuilds()

    // Prepend timestamps to all console output
    timestamps()
  }

  stages {

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // SINGLE NODE, MULTI-PARTITION (1N4P) - RELEASE 
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    stage('Build: Release') {
      steps {
        sh 'seth/jenkins/build.sh release'
      }
    }

    stage('Install: 1N4P Release') {
      steps {
        sh 'seth/jenkins/install.sh seth/jenkins/1n4p.config'
      }
    }

    stage('Start: 1N4P Release') {
      steps {
        sh 'seth/jenkins/start.sh seth/jenkins/1n4p.config'
      }

      // Stop RapidsSE if this stage was not successful
      post {
        unsuccessful {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/release/1n4p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/release/1n4p/se.log'

          sh 'seth/jenkins/stop.sh seth/jenkins/1n4p.config'
        }
      }
    }

    stage('Test: 1N4P Release') {
      steps {
        sh 'seth/jenkins/test.sh 1N4P_release seth/jenkins/1n4p.config seth/bamboo/allTestsBamboo'
      }

      // Always ensure we have stopped SE and SETH
      post {
        always {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/release/1n4p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/release/1n4p/se.log'
          sh 'ls -l seth/jenkins/results'
          sh 'cp seth/jenkins/results/log-* logs/release/1n4p/seth.log || true'

          // Stop SE and SETH
          sh 'seth/jenkins/stop.sh seth/jenkins/1n4p.config'
        }
      }
    }


    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // SINGLE NODE, SINGLE-PARTITION (1N1P) - RELEASE 
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    stage('Install: 1N1P Release') {
      steps {
        sh 'seth/jenkins/install.sh seth/jenkins/1n1p.config'
      }
    }

    stage('Start: 1N1P Release') {
      steps {
        sh 'seth/jenkins/start.sh seth/jenkins/1n1p.config'
      }

      // Stop RapidsSE if this stage was not successful
      post {
        unsuccessful {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/release/1n1p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/release/1n1p/se.log'

          sh 'seth/jenkins/stop.sh seth/jenkins/1n1p.config'
        }
      }
    }

    stage('Test: 1N1P Release') {
      steps {
        sh 'seth/jenkins/test.sh 1N1P_release seth/jenkins/1n1p.config seth/bamboo/allTestsBamboo1N1P'
      }

      // Always ensure we have stopped SE and SETH
      post {
        always {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/release/1n1p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/release/1n1p/se.log'
          sh 'ls -l seth/jenkins/results'
          sh 'cp seth/jenkins/results/log-* logs/release/1n1p/seth.log || true'

          // Stop SE and SETH
          sh 'seth/jenkins/stop.sh seth/jenkins/1n1p.config'
        }
      }
    }

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // TWO NODE, MULTI-PARTITION (2N4P) - RELEASE
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    // We can skip the build stage so long as we ran the 2 node release
    // test after the 1 node release test

    stage('Install: 2N4P Release') {
      steps {
        sh 'seth/jenkins/install.sh seth/jenkins/2n4p.config'
      }
    }

    stage('Start: 2N4P Release') {
      steps {
        sh 'seth/jenkins/start.sh seth/jenkins/2n4p.config'
      }

      // Stop RapidsSE if this stage was not successful
      post {
        unsuccessful {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/release/2n4p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/release/2n4p/se.NODE0.log || true'
          sh 'cp /opt/rapidsse/NODE1/se.log logs/release/2n4p/se.NODE1.log || true'

          sh 'seth/jenkins/stop.sh seth/jenkins/2n4p.config'
        }
      }
    }

    stage('Test: 2N4P Release') {
      steps {
        sh 'seth/jenkins/test.sh 2N4P_release seth/jenkins/2n4p.config seth/bamboo/allTestsBambooMN'
      }

      // Always ensure we have stopped SE and SETH
      post {
        always {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/release/2n4p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/release/2n4p/se.NODE0.log'
          sh 'cp /opt/rapidsse/NODE1/se.log logs/release/2n4p/se.NODE1.log'
          sh 'ls -l seth/jenkins/results'
          sh 'cp seth/jenkins/results/log-* logs/release/2n4p/seth.log || true'

          // Stop SE and SETH
          sh 'seth/jenkins/stop.sh seth/jenkins/2n4p.config'
        }
      }
    }



    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // SINGLE NODE (1N4P) - DEBUG
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    stage('Build: Debug') {
      steps {
        sh 'seth/jenkins/build.sh debug'
      }
    }

    stage('Install: 1N4P Debug') {
      steps {
        sh 'seth/jenkins/install.sh seth/jenkins/1n4p.config'
      }
    }

    stage('Start: 1N4P Debug') {
      steps {
        sh 'seth/jenkins/start.sh seth/jenkins/1n4p.config'
      }

      // Stop RapidsSE if this stage was not successful
      post {
        unsuccessful {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/debug/1n4p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/debug/1n4p/se.log'

          sh 'seth/jenkins/stop.sh seth/jenkins/1n4p.config'
        }
      }
    }

    stage('Test: 1N4P Debug') {
      steps {
        sh 'seth/jenkins/test.sh 1N4P_debug seth/jenkins/1n4p.config seth/bamboo/allTestsBamboo'
      }

      // Always ensure we have stopped SE and SETH
      post {
        always {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/debug/1n4p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/debug/1n4p/se.log'
          sh 'ls -l seth/jenkins/results'
          sh 'cp seth/jenkins/results/log-* logs/debug/1n4p/seth.log || true'

          // Stop SE and SETH
          sh 'seth/jenkins/stop.sh seth/jenkins/1n4p.config'
        }
      }
    }


    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // SINGLE NODE, SINGLE-PARTITION (1N1P) - DEBUG
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    stage('Install: 1N1P Debug') {
      steps {
        sh 'seth/jenkins/install.sh seth/jenkins/1n1p.config'
      }
    }

    stage('Start: 1N1P Debug') {
      steps {
        sh 'seth/jenkins/start.sh seth/jenkins/1n1p.config'
      }

      // Stop RapidsSE if this stage was not successful
      post {
        unsuccessful {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/debug/1n1p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/debug/1n1p/se.log'

          sh 'seth/jenkins/stop.sh seth/jenkins/1n1p.config'
        }
      }
    }

    stage('Test: 1N1P Debug') {
      steps {
        sh 'seth/jenkins/test.sh 1N1P_debug seth/jenkins/1n1p.config seth/bamboo/allTestsBamboo1N1P'
      }

      // Always ensure we have stopped SE and SETH
      post {
        always {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/debug/1n1p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/debug/1n1p/se.log'
          sh 'ls -l seth/jenkins/results'
          sh 'cp seth/jenkins/results/log-* logs/debug/1n1p/seth.log || true'

          // Stop SE and SETH
          sh 'seth/jenkins/stop.sh seth/jenkins/1n1p.config'
        }
      }
    }


    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // TWO NODE (2N4P) - DEBUG
    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    // We can skip the build stage so long as we ran the 2 node debug
    // test after the 1 node debug test

    stage('Install: 2N4P Debug') {
      steps {
        sh 'seth/jenkins/install.sh seth/jenkins/2n4p.config'
      }
    }

    stage('Start: 2N4P Debug') {
      steps {
        sh 'seth/jenkins/start.sh seth/jenkins/2n4p.config'
      }

      // Stop RapidsSE if this stage was not successful
      post {
        unsuccessful {
          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/debug/2n4p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/debug/2n4p/se.NODE0.log || true'
          sh 'cp /opt/rapidsse/NODE1/se.log logs/debug/2n4p/se.NODE1.log || true'

          sh 'seth/jenkins/stop.sh seth/jenkins/2n4p.config'
        }
      }
    }

    stage('Test: 2N4P Debug') {
      steps {
        sh 'seth/jenkins/test.sh 2N4P_debug seth/jenkins/2n4p.config seth/bamboo/allTestsBambooMN'
      }

      // Always ensure we have stopped SE and SETH
      post {
        always {

          // Copy the log artifacts into the workspace so they can be archived.
          // For some reason it doesn't work if they are outside of the workspace.
          // Wait a few seconds in case log files are still being written to.
          sh 'sleep 5'
          sh 'mkdir -p logs/debug/2n4p'
          sh 'cp /opt/rapidsse/NODE0/se.log logs/debug/2n4p/se.NODE0.log'
          sh 'cp /opt/rapidsse/NODE1/se.log logs/debug/2n4p/se.NODE1.log'
          sh 'ls -l seth/jenkins/results'
          sh 'cp seth/jenkins/results/log-* logs/debug/2n4p/seth.log || true'

          // Stop SE and SETH
          sh 'seth/jenkins/stop.sh seth/jenkins/2n4p.config'
        }
      }
    }



  } // stages


  post {
    // TODO: send an email on a change

    unsuccessful {
      // Capture log artifacts that have been copied back into the workspace
      archiveArtifacts artifacts: 'logs/**/*', allowEmptyArchive: true
    }

    always {
      // Capture all test results
      junit skipPublishingChecks: true, testResults: 'seth/jenkins/results/*.xml'
    }
  }

}
