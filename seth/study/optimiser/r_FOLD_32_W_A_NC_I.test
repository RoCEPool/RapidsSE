/pipelineName = "r_FOLD_32_W_A_NC_I"
select count(*)
  from orders, lineitem
 where O_ORDERKEY = L_ORDERKEY
   and O_ORDERKEY in (select L_ORDERKEY
                        from lineitem
                       group by L_ORDERKEY
                      having sum(l_quantity) > 100)
;

