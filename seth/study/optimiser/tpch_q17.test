--------------------------------------------------------------------------------
-- tpch query17 (SF_0001)
--------------------------------------------------------------------------------

LOG 'TPC-H Q17...';

trackMemory;
success

/pipelineName = "OptQ17"
select
  sum(l_extendedprice) / 7.0 as avg_yearly
from
  lineitem,
  part
where
  p_partkey = l_partkey
  and p_brand = 'Brand#23'
  and p_container = 'MED BAG'
  and l_quantity <
    (
    select
      0.2 * avg(l_quantity)
    from
      lineitem
    where
      l_partkey = p_partkey
    );

rows:
 (2495.31)

MemoryLeaks;
rows: 0

CLEANUP {
  bye;
  mute
}


