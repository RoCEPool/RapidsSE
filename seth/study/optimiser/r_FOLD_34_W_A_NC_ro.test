/*============================================================================*/
/* r_FOLD_34_W_A_NC_ro -- sub-query flattening test : refer Q15               */
/*============================================================================*/

LOG 'r_FOLD_34_W_A_NC_ro...';

trackMemory force;
success

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

/pipelineName = "r_FOLD_34_W_A_NC_ro"
select ps_partkey,
       sum(ps_supplycost * ps_availqty) as value
  from Partsupp, Supplier
 where PS_SUPPKEY = S_SUPPKEY
   and (ps_supplycost * ps_availqty) >= (select avg(ps_supplycost * ps_availqty)
                                           from Partsupp, Supplier
                                          where PS_SUPPKEY = S_SUPPKEY)
 group by ps_partkey
;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

MemoryLeaks;
 rows: 0

CLEANUP {
  bye;
  mute
}


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
