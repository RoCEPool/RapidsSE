/*============================================================================*/
/* _Q13_T                                                                     */
/*============================================================================*/

//------------------------------------------------------------------------------
//  Original Query
//------------------------------------------------------------------------------
select
       c_count,
       count(*) as custdist
from (
       select
              c_custkey,
              count(o_orderkey) as c_count
       from
              customer left outer join orders on
                      c_custkey = o_custkey
                  and o_comment not like '%special%requests%'
       group by
              c_custkey
     ) as c_orders (c_custkey, c_count)
group by
     c_count
order by
     custdist desc,
     c_count desc
;

//------------------------------------------------------------------------------
//  Transliterate Query
//------------------------------------------------------------------------------
EXPLAIN STAGE TRANSLITERATE
select
       c_count,
       count(*) as custdist
from (
       select
              c_custkey,
              count(o_orderkey) as c_count
       from
              customer left outer join orders on
                      c_custkey = o_custkey
                  and o_comment not like '%special%requests%'
       group by
              c_custkey
     ) as c_orders (c_custkey, c_count)
group by
     c_count
order by
     custdist desc,
     c_count desc
;

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------
pipeline unamed
begin
  pipeline c_orders
  begin
    stage stageStart on origin :
      start
      | pulse once
      | stageMarker32010
    stage stageMarker32010 on all partitions :
      scan rapidsse public customer
      | stageMarker32013 broadcast
    stage stageMarker32013 on all partitions :
      scan rapidsse public orders
      | abstractJoin " $L1 $R2 ==  }  $R9 ''%special%requests%''  7 8 matchMiddle1  not  and  "
      | stageMarker32016
    stage stageMarker32016 on all partitions :
      aggreg " groupBy  type INTEGER as c_custkey $1 aggregates  type INTEGER $K1 , type INTEGER )  $9 count  "
      | combined 0
      | stageMarker32019
    stage stageMarker32019 on all nodes :
      aggreg " groupBy  type INTEGER as c_custkey $1 aggregates  type INTEGER $K1 , type INTEGER )  $2 sum  "
      | combined 0
      | stageMarker32022
    stage stageMarker32022 on origin :
      aggreg " groupBy  type INTEGER as c_custkey $1 aggregates  type INTEGER $K1 , type INTEGER as c_count )  $2 sum  "
      | combined 0
      | stageMarker32025
    stage stageMarker32025 on origin :

      stageLast
    stage stageLast on origin :
      output
      | sink
      | stageStart
  end

  stage stageStart on origin :
    start
    | pulse once
    | stageMarker32028
  stage stageMarker32028 on origin :
    call "c_orders "
    | aggreg " groupBy  type INTEGER as c_count $2 aggregates  type INTEGER $K1 , type INTEGER as custdist )  countAll  "
    | sort " type INTEGER $2 DESC  , type INTEGER as c_count $1 DESC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

