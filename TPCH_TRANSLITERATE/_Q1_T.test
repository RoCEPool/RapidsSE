/*============================================================================*/
/* _Q1_T                                                                      */
/*============================================================================*/

//------------------------------------------------------------------------------
//  Original Query
//------------------------------------------------------------------------------
  select l_returnflag, l_linestatus,
        sum(l_quantity) as sum_qty,
        sum(l_extendedprice) as sum_base_price,
        sum(l_extendedprice*(1-l_discount)) as sum_disc_price,
        sum(l_extendedprice*(1-l_discount)*(1+l_tax)) as sum_charge,
        avg(l_quantity) as avg_qty,
        avg(l_extendedprice) as avg_price,
        avg(l_discount) as avg_disc,
        count(*) as count_order
        from lineitem
        where l_shipdate <= '1998-12-01 00:00:00' - interval'[DELTA]'day(3)
        group by l_returnflag, l_linestatus
        order by l_returnflag, l_linestatus;

//--------------------------------------------------------------------------------
//  Transliterate Query
//--------------------------------------------------------------------------------
EXPLAIN STAGE TRANSLITERATE
select
         l_returnflag,
         l_linestatus,
         sum(l_quantity)                                     as sum_qty,
         sum(l_extendedprice)                                as sum_base_price,
         sum(l_extendedprice * (1-l_discount))               as sum_disc_price,
         sum(l_extendedprice * (1-l_discount) * (1 + l_tax)) as sum_charge,
         avg(l_quantity)                                     as avg_qty,
         avg(l_extendedprice)                                as avg_price,
         avg(l_discount)                                     as avg_disc,
         count(*)                                            as count_order
  from LineItem where l_shipdate <= TIMESTAMP '1998-10-01 00:00:00'
  group by l_returnflag, l_linestatus
  order by l_returnflag, l_linestatus;

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker280640
  stage stageMarker280640 on all partitions :
    scan rapidsse public lineitem
    | filter " type BOOLEAN  $11 TIMESTAMP ''1998-10-01 00:00:00''  <=  "
    | aggreg " groupBy  type VARCHAR as l_returnflag $9 , type VARCHAR as l_linestatus $10 aggregates  type VARCHAR $K1 , type VARCHAR $K2 , type DECIMAL )  $5 sum  , type DECIMAL )  $6 sum  , type DECIMAL )  $6 1.  $7 -  *  sum  , type DECIMAL )  $6 1.  $7 -  *  1.  $8 +  *  sum  , type INTEGER )  $5 count  , type INTEGER )  $6 count  , type DECIMAL )  $7 sum  , type INTEGER )  $7 count  , type INTEGER )  countAll  "
    | combined 0
    | stageMarker280643
  stage stageMarker280643 on all nodes :
    aggreg " groupBy  type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 aggregates  type VARCHAR $K1 , type VARCHAR $K2 , type DECIMAL )  $3 sum  , type DECIMAL )  $4 sum  , type DECIMAL )  $5 sum  , type DECIMAL )  $6 sum  , type INTEGER )  $7 sum  , type INTEGER )  $8 sum  , type DECIMAL )  $9 sum  , type INTEGER )  $10 sum  , type INTEGER )  $11 sum  "
    | combined 0
    | stageMarker280814
  stage stageMarker280814 on origin :
    aggreg " groupBy  type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 aggregates  type VARCHAR $K1 , type VARCHAR $K2 , type DECIMAL as sum_qty )  $3 sum  , type DECIMAL as sum_base_price )  $4 sum  , type DECIMAL as sum_disc_price )  $5 sum  , type DECIMAL as sum_charge )  $6 sum  , type INTEGER as count_order )  $11 sum  , type INTEGER )  $7 sum  , type INTEGER )  $8 sum  , type INTEGER )  $10 sum  , type DECIMAL )  $9 sum  "
    | combined 0
    | stageMarker280646
  stage stageMarker280646 on origin :
    aggreg " groupBy  type VARCHAR as l_returnflag $1 , type VARCHAR as l_linestatus $2 aggregates  type VARCHAR $K1 , type VARCHAR $K2 , type DECIMAL as sum_qty $3 , type DECIMAL as sum_base_price $4 , type DECIMAL as sum_disc_price $5 , type DECIMAL as sum_charge $6 , type DECIMAL as avg_qty $3 $8 casttype DECIMAL CAST  /  , type DECIMAL as avg_price $4 $9 casttype DECIMAL CAST  /  , type DECIMAL as avg_disc $11 $10 casttype DECIMAL CAST  /  , type INTEGER as count_order $7 "
    | sort 2 " type VARCHAR as l_returnflag $1 ASC  , type VARCHAR as l_linestatus $2 ASC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

