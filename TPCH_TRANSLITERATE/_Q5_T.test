//------------------------------------------------------------------------------
//  Original Query
//------------------------------------------------------------------------------
  select n_name, sum(l_extendedprice * (1 - l_discount)) as revenue
      from customer, orders, lineitem, supplier, nation, region
      where c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and l_suppkey = s_suppkey
      and c_nationkey = s_nationkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'ASIA'
      and o_orderdate >= '1994-01-01'
      and o_orderdate < '1995-01-01'
      group by n_name
      order by revenue desc;

*/

//--------------------------------------------------------------------------------
EXPLAIN STAGE TRANSLITERATE
select n_name, sum(l_extendedprice * (1 - l_discount)) as revenue
      from customer, orders, lineitem, supplier, nation, region
      where c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and l_suppkey = s_suppkey
      and c_nationkey = s_nationkey
      and s_nationkey = n_nationkey
      and n_regionkey = r_regionkey
      and r_name = 'ASIA'
      and o_orderdate >= '1994-01-01'
      and o_orderdate < '1995-01-01'
      group by n_name
      order by revenue desc;

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker10504
  stage stageMarker10504 on all partitions :
    scan rapidsse public customer
    | stageMarker10507 broadcast
  stage stageMarker10507 on all partitions :
    scan rapidsse public orders
    | abstractJoin " 1  "
    | stageMarker10510 broadcast
  stage stageMarker10510 on all partitions :
    scan rapidsse public lineitem
    | abstractJoin " 1  "
    | stageMarker10513 broadcast
  stage stageMarker10513 on all partitions :
    scan rapidsse public supplier
    | abstractJoin " 1  "
    | stageMarker10516 broadcast
  stage stageMarker10516 on all partitions :
    scan rapidsse public nation
    | abstractJoin " 1  "
    | stageMarker10519 broadcast
  stage stageMarker10519 on all partitions :
    scan rapidsse public region
    | abstractJoin " 1  "
    | stageMarker10522
  stage stageMarker10522 on all partitions :
    filter " type BOOLEAN  $1 $10 ==  $18 $9 ==  and  $20 $34 ==  and  $4 $37 ==  and  $37 $41 ==  and  $43 $45 ==  and  $46 ''ASIA''  ==  and  $13 TIMESTAMP ''1994-01-01 00:00:00''  >=  and  $13 TIMESTAMP ''1995-01-01 00:00:00''  <  and  "
    | aggreg " groupBy  type VARCHAR as n_name $42 aggregates  type VARCHAR $K1 , type DECIMAL )  $23 1.  $24 -  *  sum  "
    | combined 0
    | stageMarker10525
  stage stageMarker10525 on all nodes :
    aggreg " groupBy  type VARCHAR as n_name $1 aggregates  type VARCHAR $K1 , type DECIMAL )  $2 sum  "
    | combined 0
    | stageMarker10528
  stage stageMarker10528 on origin :
    aggreg " groupBy  type VARCHAR as n_name $1 aggregates  type VARCHAR $K1 , type DECIMAL as revenue )  $2 sum  "
    | sort " type DECIMAL $2 DESC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

