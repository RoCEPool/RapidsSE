/*============================================================================*/
/* _Q12_T                                                                     */
/*============================================================================*/

//------------------------------------------------------------------------------
//  Original Query
//------------------------------------------------------------------------------
select l_shipmode,
    sum(case when o_orderpriority ='1-URGENT' or o_orderpriority ='2-HIGH' then 1 else 0 end) as high_line_count,
    sum(case when o_orderpriority <> '1-URGENT' and o_orderpriority <> '2-HIGH' then 1 else 0 end) as low_line_count
    from orders, lineitem
    where o_orderkey = l_orderkey
    and l_shipmode in ('MAIL', 'SHIP')
    and l_commitdate < l_receiptdate
    and l_shipdate < l_commitdate
    and l_receiptdate >= '1994-01-01 00:00:00'
    and l_receiptdate < '1995-01-01 00:00:00'
    group by l_shipmode
    order by l_shipmode;


//------------------------------------------------------------------------------
//  Transliterate Query
//------------------------------------------------------------------------------
EXPLAIN STAGE TRANSLITERATE
select l_shipmode,
    sum(case when o_orderpriority ='1-URGENT' or o_orderpriority ='2-HIGH' then 1 else 0 end) as high_line_count,
    sum(case when o_orderpriority <> '1-URGENT' and o_orderpriority <> '2-HIGH' then 1 else 0 end) as low_line_count
    from orders, lineitem
    where o_orderkey = l_orderkey
    and l_shipmode in ('MAIL', 'SHIP')
    and l_commitdate < l_receiptdate
    and l_shipdate < l_commitdate
    and l_receiptdate >= '1994-01-01 00:00:00'
    and l_receiptdate < '1995-01-01 00:00:00'
    group by l_shipmode
    order by l_shipmode;

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker18574
  stage stageMarker18574 on all partitions :
    scan rapidsse public orders
    | stageMarker18577 broadcast
  stage stageMarker18577 on all partitions :
    scan rapidsse public lineitem
    | abstractJoin 2 " 1  "
    | stageMarker18580
  stage stageMarker18580 on all partitions :
    filter " type BOOLEAN  $1 $10 ==  }  ''MAIL''  ''SHIP''  #2  $24 in  and  $21 $22 <  and  $20 $21 <  and  $22 TIMESTAMP ''1994-01-01 00:00:00''  >=  and  $22 TIMESTAMP ''1995-01-01 00:00:00''  <  and  "
    | aggreg " groupBy  type VARCHAR as l_shipmode $24 aggregates  type VARCHAR $K1 , type INTEGER )  }  $6 ''1-URGENT''  ==  $6 ''2-HIGH''  ==  or WHEN  1 THEN  0  ELSE  ENDIF  CASE  sum  , type INTEGER )  }  $6 ''1-URGENT''  !=  $6 ''2-HIGH''  !=  and WHEN  1 THEN  0  ELSE  ENDIF  CASE  sum  "
    | combined 0
    | stageMarker18583
  stage stageMarker18583 on all nodes :
    aggreg " groupBy  type VARCHAR as l_shipmode $1 aggregates  type VARCHAR $K1 , type INTEGER )  $2 sum  , type INTEGER )  $3 sum  "
    | combined 0
    | stageMarker18586
  stage stageMarker18586 on origin :
    aggreg " groupBy  type VARCHAR as l_shipmode $1 aggregates  type VARCHAR $K1 , type INTEGER as high_line_count )  $2 sum  , type INTEGER as low_line_count )  $3 sum  "
    | sort 2 " type VARCHAR as l_shipmode $1 ASC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

