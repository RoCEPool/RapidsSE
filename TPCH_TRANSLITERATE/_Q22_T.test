/*============================================================================*/
/* _Q22_T                                                                     */
/*============================================================================*/

//--------------------------------------------------------------------------------
//  Original Query
//--------------------------------------------------------------------------------
select cntrycode, count(*) as numcust, sum(c_acctbal) as totacctbal
     from ( select substring(c_phone from 1 for 2) as cntrycode, c_acctbal
              from customer
             where substring(c_phone from 1 for 2) in ('13','31','23','29','30','18','17')
               and c_acctbal > ( select avg(c_acctbal)
                                   from customer
                                  where c_acctbal > 0.00
                                    and substring (c_phone from 1 for 2) in ('13','31','23','29','30','18','17') )
                                    and not exists ( select * from orders where o_custkey = c_custkey )
                                ) as custsale
     group by cntrycode
     order by cntrycode;

//--------------------------------------------------------------------------------
//  Transliterate Query
//--------------------------------------------------------------------------------
EXPLAIN STAGE TRANSLITERATE
select cntrycode, count(*) as numcust, sum(c_acctbal) as totacctbal
     from ( select substring(c_phone from 1 for 2) as cntrycode, c_acctbal
              from customer
             where substring(c_phone from 1 for 2) in ('13','31','23','29','30','18','17')
               and c_acctbal > ( select avg(c_acctbal)
                                   from customer
                                  where c_acctbal > 0.00
                                    and substring (c_phone from 1 for 2) in ('13','31','23','29','30','18','17') )
                                    and not exists ( select * from orders where o_custkey = c_custkey )
                                ) as custsale
     group by cntrycode
     order by cntrycode;

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------
pipeline unamed
begin
  pipeline custsale
  begin
    stage stageStart on origin :
      start
      | pulse once
      | stageMarker1035
    stage stageMarker1035 on all partitions :
      scan rapidsse public orders
      | filter " type BOOLEAN  $2 ==  "
      | project " type INTEGER as O_ORDERKEY $1 , type INTEGER as O_CUSTKEY $2 , type VARCHAR as O_ORDERSTATUS $3 , type DECIMAL as O_TOTALPRICE $4 , type TIMESTAMP as O_ORDERDATE $5 , type VARCHAR as O_ORDERPRIORITY $6 , type VARCHAR as O_CLERK $7 , type INTEGER as O_SHIPPRIORITY $8 , type VARCHAR as O_COMMENT $9 "
      | combined 0
      | stageMarker1038
    stage stageMarker1038 on all partitions :

      stageMarker1041
    stage stageMarker1041 on all partitions :
      scan rapidsse public customer
      | filter " type BOOLEAN  $6 0.00  >  }  ''13''  ''31''  ''23''  ''29''  ''30''  ''18''  ''17''  #7  $5 1  2  substring3  in  and  "
      | project " type DECIMAL )  $6 sum  , type INTEGER )  $6 count  "
      | combined 0
      | stageMarker1044
    stage stageMarker1044 on all nodes :
      project " type DECIMAL )  $1 sum  , type INTEGER )  $2 sum  "
      | combined 0
      | stageMarker1186
    stage stageMarker1186 on origin :
      project " type INTEGER )  $2 sum  , type DECIMAL )  $1 sum  "
      | combined 0
      | stageMarker1047
    stage stageMarker1047 on origin :
      project " type DECIMAL $2 $1 casttype DECIMAL CAST  /  "
      | combined 0
      | stageMarker1050
    stage stageMarker1050 on origin :

      stageMarker1053
    stage stageMarker1053 on all partitions :
      scan rapidsse public customer
      | filter " type BOOLEAN  }  ''13''  ''31''  ''23''  ''29''  ''30''  ''18''  ''17''  #7  $5 1  2  substring3  in  $6 __subquery0003  >  and  $1 __subquery0005  exists  not  and  "
      | project " type VARCHAR as cntrycode $5 1  2  substring3  , type DECIMAL as c_acctbal $6 "
      | combined 0
      | stageMarker1056
    stage stageMarker1056 on all partitions :

      stageLast
    stage stageLast on origin :
      output
      | sink
      | stageStart
  end

  stage stageStart on origin :
    start
    | pulse once
    | stageMarker1059
  stage stageMarker1059 on all partitions :
    call "custsale "
    | aggreg " groupBy  type VARCHAR as cntrycode $1 aggregates  type VARCHAR $K1 , type INTEGER )  countAll  , type DECIMAL )  $2 sum  "
    | combined 0
    | stageMarker1062
  stage stageMarker1062 on all nodes :
    aggreg " groupBy  type VARCHAR as cntrycode $1 aggregates  type VARCHAR $K1 , type INTEGER )  $2 sum  , type DECIMAL )  $3 sum  "
    | combined 0
    | stageMarker1065
  stage stageMarker1065 on origin :
    aggreg " groupBy  type VARCHAR as cntrycode $1 aggregates  type VARCHAR $K1 , type INTEGER as numcust )  $2 sum  , type DECIMAL as totacctbal )  $3 sum  "
    | sort 2 " type VARCHAR as cntrycode $1 ASC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

