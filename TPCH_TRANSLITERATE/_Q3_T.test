/*============================================================================*/
/* _Q3_T                                                                      */
/*============================================================================*/

//------------------------------------------------------------------------------
//  Original Query
//------------------------------------------------------------------------------
  select l_orderkey,
      sum(l_extendedprice*(1-l_discount)) as revenue,
      o_orderdate,
      o_shippriority
      from customer, orders, lineitem
      where c_mktsegment = 'BUILDING'
      and c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and o_orderdate < '1995-03-15'
      and l_shipdate > '1995-03-15'
      group by l_orderkey, o_orderdate, o_shippriority
      order by revenue desc, o_orderdate;

//------------------------------------------------------------------------------
EXPLAIN STAGE TRANSLITERATE
select l_orderkey,
      sum(l_extendedprice*(1-l_discount)) as revenue,
      o_orderdate,
      o_shippriority
      from customer, orders, lineitem
      where c_mktsegment = 'BUILDING'
      and c_custkey = o_custkey
      and l_orderkey = o_orderkey
      and o_orderdate < '1995-03-15'
      and l_shipdate > '1995-03-15'
      group by l_orderkey, o_orderdate, o_shippriority
      order by revenue desc, o_orderdate
      limit 10;

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------
pipeline unamed
begin
  stage stageStart on origin :
    start
    | pulse once
    | stageMarker6340
  stage stageMarker6340 on all partitions :
    scan rapidsse public customer
    | stageMarker6343 broadcast
  stage stageMarker6343 on all partitions :
    scan rapidsse public orders
    | abstractJoin " 1  "
    | stageMarker6346 broadcast
  stage stageMarker6346 on all partitions :
    scan rapidsse public lineitem
    | abstractJoin " 1  "
    | stageMarker6349
  stage stageMarker6349 on all partitions :
    filter " type BOOLEAN  $7 ''BUILDING''  ==  $1 $10 ==  and  $18 $9 ==  and  $13 TIMESTAMP ''1995-03-15 00:00:00''  <  and  $28 TIMESTAMP ''1995-03-15 00:00:00''  >  and  "
    | aggreg " groupBy  type INTEGER as l_orderkey $18 , type TIMESTAMP as o_orderdate $13 , type INTEGER as o_shippriority $16 aggregates  type INTEGER $K1 , type DECIMAL )  $23 1.  $24 -  *  sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | combined 0
    | stageMarker6352
  stage stageMarker6352 on all nodes :
    aggreg " groupBy  type INTEGER as l_orderkey $1 , type TIMESTAMP as o_orderdate $3 , type INTEGER as o_shippriority $4 aggregates  type INTEGER $K1 , type DECIMAL )  $2 sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | combined 0
    | stageMarker6355
  stage stageMarker6355 on origin :
    aggreg " groupBy  type INTEGER as l_orderkey $1 , type TIMESTAMP as o_orderdate $3 , type INTEGER as o_shippriority $4 aggregates  type INTEGER $K1 , type DECIMAL as revenue )  $2 sum  , type TIMESTAMP $K2 , type INTEGER $K3 "
    | sort " type DECIMAL $2 DESC  , type TIMESTAMP as o_orderdate $3 ASC  "
    | limit 10
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

