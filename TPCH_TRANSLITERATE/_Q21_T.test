/*============================================================================*/
/* _Q21_T                                                                     */
/*============================================================================*/

//------------------------------------------------------------------------------
//  Original Query
//------------------------------------------------------------------------------
select s_name,s_address
  from Supplier, Nation
  where     s_suppkey in
             ( select ps_suppkey
                 from partSupp
                 where ps_partkey in
                             ( select p_partkey
                                 from Part
                                 where p_name like 'forest%' )
                       and ps_availqty >
                             ( select 0.5 * sum(l_quantity)
                                 from LineItem
                                where     L_PARTKEY = PS_PARTKEY
                                      and L_SUPPKEY = PS_SUPPKEY
                                      and l_shipdate >= '1994-01-01'
                                      and l_shipdate < '1995-01-01' ) )
       and s_nationkey = n_nationkey
       and n_name = 'CANADA'
 order by s_name;

//------------------------------------------------------------------------------
//  Transliterate Query
//------------------------------------------------------------------------------
EXPLAIN STAGE TRANSLITERATE
select s_name,s_address
  from Supplier, Nation
  where     s_suppkey in
             ( select ps_suppkey
                 from partSupp
                 where ps_partkey in
                             ( select p_partkey
                                 from Part
                                 where p_name like 'forest%' )
                       and ps_availqty >
                             ( select 0.5 * sum(l_quantity)
                                 from LineItem
                                where     L_PARTKEY = PS_PARTKEY
                                      and L_SUPPKEY = PS_SUPPKEY
                                      and l_shipdate >= '1994-01-01'
                                      and l_shipdate < '1995-01-01' ) )
       and s_nationkey = n_nationkey
       and n_name = 'CANADA'
 order by s_name;

//------------------------------------------------------------------------------
// Pipeline Generated
//------------------------------------------------------------------------------
pipeline unamed
begin
  pipeline __subquery0007
  begin
    stage stageStart on origin :
      start
      | pulse once
      | stageMarker3092
    stage stageMarker3092 on all partitions :
      scan rapidsse public part
      | filter " type BOOLEAN  }  $2 ''forest%''  7 matchLeading  "
      | project " type INTEGER as p_partkey $1 "
      | combined 0
      | stageMarker3095
    stage stageMarker3095 on all partitions :

      stageMarker3098
    stage stageMarker3098 on all partitions :
      scan rapidsse public lineitem
      | filter " type BOOLEAN  $2 ==  $3 ==  and  $11 TIMESTAMP ''1994-01-01 00:00:00''  >=  and  $11 TIMESTAMP ''1995-01-01 00:00:00''  <  and  "
      | project " type DECIMAL )  $5 sum  "
      | combined 0
      | stageMarker3101
    stage stageMarker3101 on all nodes :
      project " type DECIMAL )  $1 sum  "
      | combined 0
      | stageMarker3104
    stage stageMarker3104 on origin :
      project " type DECIMAL 0.5  )  $1 sum  *  "
      | combined 0
      | stageMarker3107
    stage stageMarker3107 on origin :

      stageMarker3110
    stage stageMarker3110 on all partitions :
      scan rapidsse public partsupp
      | filter " type BOOLEAN  }  __subquery0003  #1  $1 in  $3 casttype DECIMAL CAST  $1 $2 __subquery0005  >  and  "
      | project " type INTEGER as ps_suppkey $2 "
      | combined 0
      | stageMarker3113
    stage stageMarker3113 on all partitions :

      stageLast
    stage stageLast on origin :
      output
      | sink
      | stageStart
  end

  stage stageStart on origin :
    start
    | pulse once
    | stageMarker3116
  stage stageMarker3116 on all partitions :
    scan rapidsse public supplier
    | stageMarker3119 broadcast
  stage stageMarker3119 on all partitions :
    scan rapidsse public nation
    | abstractJoin 2 " 1  "
    | stageMarker3122
  stage stageMarker3122 on all partitions :
    filter " type BOOLEAN  }  __subquery0007  #1  $1 in  $4 $8 ==  and  $9 ''CANADA''  ==  and  "
    | project " type VARCHAR as s_name $2 , type VARCHAR as s_address $3 "
    | sort 2 " type VARCHAR as s_name $1 ASC  "
    | combined 0
    | stageMarker3125
  stage stageMarker3125 on all nodes :
    sort 2 " type VARCHAR as s_name $1 ASC  "
    | combined 0
    | stageMarker3128
  stage stageMarker3128 on origin :
    sort 2 " type VARCHAR as s_name $1 ASC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
    output
    | sink
    | stageStart
end ;

