      | pulse once
      | stageMarker44404
    stage stageMarker44404 on all partitions :
      scan rapidsse public part
      | filter " type BOOLEAN  }  $2 ''forest%''  7 matchLeading  "
      | project " type INTEGER as p_partkey $1 "
      | combined 0
      | stageMarker44407
    stage stageMarker44407 on all partitions :

      stageMarker44410
    stage stageMarker44410 on all partitions :
      scan rapidsse public lineitem
      | filter " type BOOLEAN  $2 ==  $3 ==  and  $11 TIMESTAMP ''1994-01-01 00:00:00''  >=  and  $11 TIMESTAMP ''1995-01-01 00:00:00''  <  and  "
      | project " type DECIMAL )  $5 sum  "
      | combined 0
      | stageMarker44413
    stage stageMarker44413 on all nodes :
      project " type DECIMAL )  $1 sum  "
      | combined 0
      | stageMarker44416
    stage stageMarker44416 on origin :
      project " type DECIMAL 0.5  )  $1 sum  *  "
      | combined 0
      | stageMarker44419
    stage stageMarker44419 on origin :

      stageMarker44422
    stage stageMarker44422 on all partitions :
      scan rapidsse public partsupp
      | filter " type BOOLEAN  }  __subquery0003  #1  $1 in  $3 casttype DECIMAL CAST  $1 $2 __subquery0005  >  and  "
      | project " type INTEGER as ps_suppkey $2 "
      | combined 0
      | stageMarker44425
    stage stageMarker44425 on all partitions :

      stageLast
    stage stageLast on origin :
      output
      | sink
      | stageStart
  end

  stage stageStart on origin :
    start
    | pulse once
    | stageMarker44428
  stage stageMarker44428 on all partitions :
    scan rapidsse public supplier
    | stageMarker44431 broadcast
  stage stageMarker44431 on all partitions :
    scan rapidsse public nation
    | abstractJoin " 1  "
    | stageMarker44434
  stage stageMarker44434 on all partitions :
    filter " type BOOLEAN  }  __subquery0007  #1  $1 in  $4 $8 ==  and  $9 ''CANADA''  ==  and  "
    | project " type VARCHAR as s_name $2 , type VARCHAR as s_address $3 "
    | sort " type VARCHAR as s_name $1 ASC  "
    | combined 0
    | stageMarker44437
  stage stageMarker44437 on all nodes :
    sort " type VARCHAR as s_name $1 ASC  "
    | combined 0
    | stageMarker44440
  stage stageMarker44440 on origin :
    sort " type VARCHAR as s_name $1 ASC  "
    | combined 0
    | stageLast
  stage stageLast on origin :
