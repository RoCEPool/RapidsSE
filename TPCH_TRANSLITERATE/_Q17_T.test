      | combined 0
      | stageMarker35872
    stage stageMarker35872 on origin :

      stageLast
    stage stageLast on origin :
      output
      | sink
      | stageStart
  end

  stage stageStart on origin :
    start
    | pulse once
    | stageMarker35875
  stage stageMarker35875 on all partitions :
    scan rapidsse public lineitem
    | stageMarker35878 broadcast
  stage stageMarker35878 on all partitions :
    scan rapidsse public part
    | abstractJoin " 1  "
    | stageMarker35881
  stage stageMarker35881 on all partitions :
    filter " type BOOLEAN  $17 $2 ==  $20 ''Brand#23''  ==  and  $23 ''MED BOX''  ==  and  $5 $17 __subquery0003  <  and  "
    | project " type DECIMAL )  $6 sum  "
    | combined 0
    | stageMarker35884
  stage stageMarker35884 on all nodes :
