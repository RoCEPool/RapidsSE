# An example of a Job config file.
# This is an INI-style config file with a header section (in square brackets)
# and key=value pairs underneath. Quotes are NOT necessary around strings.

[job]
# Maximum amount of time this entire job can run for before it is forcefully aborted.
# Value is in minutes.
MaxDuration = 60

# Do we continue on if a test fails?
# If value is true then the next test will be run.
# If value is false then the job is aborted early.
ContinueOnTestFailure = true

# The path of the hardware config file to use.
# If this path is relative then it is considered relative to this file.
HardwareConfigPath = "../hardware/exampleHardware.config"

# The path of the cluster config file to use.
# If this path is relative then it is considered relative to this file.
ClusterConfigPath = ../cluster/exampleCluster.config

# A list of paths to test config files to be executed in this job.
# Specify multiple tests by using the same TestPath key multiple times.
# All paths relative paths are considered relative to this current file.
TestPath = ../tests/createAndDropTables.jmx
TestPath = ../tests/tpch-sf1-1node.jmx


