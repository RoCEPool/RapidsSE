            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q13" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">select 
  c_count, 
  count(*) as custdist
from 
  ( 
    select 
      c_custkey, 
      count(o_orderkey) as c_count
    from 
      customer 
    left outer join 
      orders 
        on c_custkey = o_custkey
        and o_comment not like &apos;%special%requests%&apos;
    group by c_custkey 
  ) as c_orders (c_custkey, c_count)
group by 
  c_count
order by 
  custdist desc, 
  c_count desc;</stringProp>
