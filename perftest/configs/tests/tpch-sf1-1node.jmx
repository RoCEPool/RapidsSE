            <stringProp name="dataSource">SEConnPool</stringProp>
            <stringProp name="query">select 
  100.00 * sum(case when p_type like &apos;PROMO%&apos; then l_extendedprice*(1-l_discount) else 0 end) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue
