          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Q6Loop" enabled="true">
            <boolProp name="LoopController.continue_forever">true</boolProp>
            <stringProp name="LoopController.loops">${QUERY_LOOP_COUNT}</stringProp>
          </LoopController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q6" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">select 
  sum(l_extendedprice*l_discount) as revenue
from 
  lineitem
where 
  l_shipdate &gt;= &apos;1994-01-01&apos;
  and l_shipdate &lt; &apos;1994-01-01&apos; + interval &apos;1&apos; year
  and l_discount between 0.06 - 0.01 and 0.06 + 0.01
  and l_quantity &lt; 24;</stringProp>
              <stringProp name="queryArguments"></stringProp>
