            <boolProp name="LoopController.continue_forever">true</boolProp>
            <stringProp name="LoopController.loops">${QUERY_LOOP_COUNT}</stringProp>
          </LoopController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="q5" enabled="true">
              <stringProp name="dataSource">SEConnPool</stringProp>
              <stringProp name="query">select 
  n_name, 
  sum(l_extendedprice * (1 - l_discount)) as revenue
from 
  customer, 
  orders, 
  lineitem, 
  supplier, 
  nation, 
  region
where 
  c_custkey = o_custkey
  and l_orderkey = o_orderkey
  and l_suppkey = s_suppkey
  and c_nationkey = s_nationkey
  and s_nationkey = n_nationkey
  and n_regionkey = r_regionkey
  and r_name = &apos;ASIA&apos;
  and o_orderdate &gt;= &apos;1994-01-01&apos;
  and o_orderdate &lt; &apos;1994-01-01&apos; + interval &apos;1&apos; year
group by 
  n_name
order by 
  revenue desc;</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
