            <stringProp name="dataSource">SEConnPool</stringProp>
            <stringProp name="query">select 
  sum(l_extendedprice) / 7.0 as avg_yearly
from 
  lineitem, 
  part
where 
  p_partkey = l_partkey
  and p_brand = &apos;Brand#23&apos;
  and p_container = &apos;MED BOX&apos;
  and l_quantity &lt; ( 
    select 
      0.2 * avg(l_quantity) 
    from 
      lineitem 
    where 
      l_partkey = p_partkey 
   )
;</stringProp>
