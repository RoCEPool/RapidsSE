 // removed c_name, o_orderdate, o_totalprice
  select
    c_custkey,
    o_orderkey,
    sum(l_quantity)
  from
    customer,
    orders,
    lineitem
  where
    o_orderkey in
      (
      select
        l_orderkey
      from
        lineitem
      group by
        l_orderkey
      having
        sum(l_quantity) > 300
      )
    and c_custkey = o_custkey
    and o_orderkey = l_orderkey
  group by
    c_custkey,
    o_orderkey
  limit 100;

  rows: 57


create table tempTable as
select
  l_orderkey,
  sum(l_quantity)
from
  lineitem
group by
  l_orderkey
having
  sum(l_quantity) > 300;

select
  c_custkey,
  o_orderkey,
  sum(tempTable.sum)
from
  customer,
  orders,
  tempTable
where
  c_custkey = o_custkey
  and o_orderkey = tempTable.l_orderkey
group by
  c_custkey,
  o_orderkey
limit 100;

