"itf.sen" .

( create the parts )
thread:  requestServerThread
taskset: requestServerTaskSet
queue:   requestQueue
queue:   responseQueue

: itf_init ( configure the system )

  seitf.new task.this task.itf!

  requestQueue  task.this task.itf@ seitf.req!

  responseQueue task.this task.itf@ seitf.rsp!

  "serverLoop" task.new requestServerTaskSet taskset.append

  requestServerTaskSet requestServerThread thread.taskset!

  requestServerThread thread.spawn
;

: >itf ( send request     ) task.this task.itf@ seitf.req@ queue.append ;
: itf> ( receive response ) begin task.this task.itf@ seitf.rsp@ queue.pop until ;
: req> ( receive request  ) begin requestQueue queue.pop until ;
: >rsp ( send response    ) responseQueue queue.append  ;
: !req ( process request  ) >: ;

: serverLoop ( request server ) begin req> !req >rsp 0 until ;

: itf_run ( run test )

  100 0 do

    I >str " " concat I >str concat " +" concat

    >itf itf>
    .
    snooze

  loop
;

: itf ( init and run itf test ) itf_init snooze "boo" . rdtscp . itf_run ;