 endMacro

macro AM_HANDLER_ROWBUFFER_LIMIT
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER_LIMIT                                           //
//----------------------------------------------------------------------------//
  // ROWBUFFER HANDLER
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**HANDLER_ROWBUFFER**\n"
  EO_POP
  EO_ROW_SRC_BEGIN

  // push limit on stack
  EO_INTEGER <limitRows>
  EO_DUMP

  // NEXT_ROW_SRC
  Label NEXT_ROW_SRC

  // check if limit reached
  EO_DUP
  EO_CTR_0_PUSH
  EO_DUMP
  EO_LESSEQUAL
  EO_JMP_TRUE QUERY_DONE

  // increment rows processed
  EO_CTR_0_INC

  EO_ROW_SRC_NEXT
  EO_JMP_FALSE QUERY_DONE
  EO_CALL <rowProcessRoutine>
  EO_JMP NEXT_ROW_SRC
  EO_JMP QUERY_DONE
 endMacro

macro AM_ROW_PROJECT_COLUMNS
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_COLUMNS                                               //
//----------------------------------------------------------------------------//
  // ROW_PROJECT_COLUMNS
  Label ROW_PROJECT_COLUMNS
  EO_SET_ITEMS <projectItems>
  EO_SET_COLUMNS <projectSrcColumns>
  EO_SET_LOCALS_ROW

  //EO_ROW_DST_NEW
  EO_PUSH_DEVROW_DST
  EO_DEVROW_NEW

  //EO_DUMP
endMacro

