/*============================================================================*/
/* AM_RowBuffer.macro -- ASM Macros for ROWBUFFER Handler                     */
/*============================================================================*/

macro AM_HANDLER_ROWBUFFER
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER                                                 //
//----------------------------------------------------------------------------//
  // ROWBUFFER HANDLER
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**HANDLER_ROWBUFFER**\n"
  EO_POP
  //EO_ROW_SRC_BEGIN
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_BEGIN

  // NEXT_ROW_SRC
  Label NEXT_ROW_SRC
  //EO_ROW_SRC_NEXT
  EO_DUMP
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <rowProcessRoutine>  // C_TAG_ROW_PROCESS_ROUTINE
  EO_JMP NEXT_ROW_SRC
  EO_JMP QUERY_DONE
 endMacro

