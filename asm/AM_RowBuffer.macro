/*============================================================================*/
/* AM_RowBuffer.macro -- ASM Macros for ROWBUFFER Handler                     */
/*============================================================================*/

macro AM_HANDLER_ROWBUFFER
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER                                                 //
//----------------------------------------------------------------------------//
  // ROWBUFFER HANDLER
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**HANDLER_ROWBUFFER**\n"
  EO_POP
  EO_ROW_SRC_BEGIN

  // NEXT_ROW_SRC
  Label NEXT_ROW_SRC
  EO_ROW_SRC_NEXT
  EO_JMP_FALSE QUERY_DONE
  EO_CALL <rowProcessRoutine>
  EO_JMP NEXT_ROW_SRC
  EO_JMP QUERY_DONE
 endMacro

macro AM_ROW_PROJECT_COLUMNS
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_COLUMNS                                               //
//----------------------------------------------------------------------------//
  // ROW_PROJECT_COLUMNS
  Label ROW_PROJECT_COLUMNS
  EO_SET_ITEMS <projectItems>
  EO_SET_COLUMNS <projectSrcColumns>
  EO_SET_LOCALS_ROW
  EO_ROW_DST_NEW
  //EO_DUMP
endMacro

macro AM_ROW_PROJECT_NONE
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_NONE                                                  //
//----------------------------------------------------------------------------//
  // ROW_PROJECT_NONE
  Label ROW_PROJECT_NONE
  EO_ROW_DST_NEW
  //EO_DUMP
endMacro

macro AM_ROW_PROJECT_STAR
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_STAR                                                  //
//----------------------------------------------------------------------------//
  // AM_ROW_PROJECT_STAR
  Label ROW_PROJECT_STAR
  EO_ROW_DST_NEW

endMacro

macro AM_ROW_PROJECT_END
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_END                                                   //
//----------------------------------------------------------------------------//
  // PROJECT_END
  EO_ROW_DST_PRINT
  EO_RETURN
endMacro

macro AM_ROW_FILTER_ROWS
//----------------------------------------------------------------------------//
// macro AM_ROW_FILTER_ROWS                                                   //
//----------------------------------------------------------------------------//
  // ROW_FILTER_ROWS
  Label ROW_FILTER_ROWS
  EO_SET_ITEMS <projectItems>
  EO_SET_COLUMNS <projectSrcColumns>
  EO_SET_LOCALS_ROW
endMacro

macro AM_ROW_FILTER_END
//----------------------------------------------------------------------------//
// macro AM_ROW_FILTER_END                                                    //
//----------------------------------------------------------------------------//
  // ROW_FILTER_END
  EO_CALL ROW_PROJECT_STAR
  EO_ROW_DST_PRINT
  Label ROW_FILTER_FALSE
  EO_RETURN
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/