  EO_JMP_FALSE ROW_PROJECT_AGG

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_LOCALS
  //EO_DUMP

  Label ROW_PROJECT_AGG

endMacro

macro AM_ROW_PROJECT_STAR
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_STAR                                                  //
//----------------------------------------------------------------------------//
  // AM_ROW_PROJECT_STAR
  Label ROW_PROJECT_STAR
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_ROW

  EO_RETURN

endMacro

macro AM_ROW_PROJECT_END
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_END                                                   //
//----------------------------------------------------------------------------//
  // PROJECT_END
  EO_RETURN
endMacro

macro AM_ROW_FILTER_BEGIN
//----------------------------------------------------------------------------//
// macro AM_ROW_FILTER_BEGIN                                                  //
//----------------------------------------------------------------------------//
  // ROW_FILTER_BEGIN
  Label ROW_FILTER_BEGIN
  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_LOCALS
endMacro

macro AM_ROW_FILTER_END
//----------------------------------------------------------------------------//
// macro AM_ROW_FILTER_END                                                    //
//----------------------------------------------------------------------------//
  // ROW_FILTER_END
  EO_RETURN_FALSE
  EO_CALL <projectRoutine>

  EO_RETURN
endMacro

macro AM_ROW_HASHROWS_BEGIN
//----------------------------------------------------------------------------//
// macro AM_ROW_HASHROWS_BEGIN                                                //
//----------------------------------------------------------------------------//
  // ROW_HASHROWS_BEGIN
  Label ROW_HASHROWS_BEGIN

  // calc i_Ptn
  EO_PTN_RESET

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_LOCALS

endMacro


//----------------------------------------------------------------------------//
// macro AM_ROW_HASHROWS_END                                                  //
//----------------------------------------------------------------------------//
macro AM_ROW_HASHROWS_END
  // AM_ROW_HASHROWS_END

  EO_PTN_RUNNING
  EO_PTN_CALC

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_ROW

  //EO_PUSH_DEVROW_DST
  //EO_DEVROW_ROW_PRINT
  EO_RETURN
endMacro

macro AM_ROW_INDEXJOIN_BEGIN
//----------------------------------------------------------------------------//
// macro AM_ROW_INDEXJOIN_BEGIN                                               //
//----------------------------------------------------------------------------//
  // ROW_INDEXJOIN_BEGIN
  Label ROW_INDEXJOIN_BEGIN

  // left row
  //EO_PUSH_DEVIXT_LFT
  //EO_DEVIXT_PUSHCOLI <projectSrcColumn>

  Label ROW_INDEXJOIN
endMacro

macro AM_ROW_INDEXJOIN_NEXT
//----------------------------------------------------------------------------//
// macro AM_ROW_INDEXJOIN_NEXT                                                 //
//----------------------------------------------------------------------------//
  // ROW_INDEXJOIN_NEXT
  Label ROW_INDEXJOIN_NEXT

  // fetch next entry from index
  //EO_PUSH_DEVIXT_RHT
  //EO_DEVIXT_IDX_NEXT
  EO_RETURN_FALSE

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_PUSH

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_PUSHUPPER

  EO_EQ_INTINT
  EO_RETURN_TRUE

  // projection
  //EO_CRW_SRC_DEREF
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_DEREF

  EO_CALL <joinRowRoutine>  // C_TAG_JOINROW_ROUTINE
  //EO_ROW_DST_PRINT

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_IDX_NEXT

  EO_JMP ROW_INDEXJOIN_NEXT
  EO_RETURN
endMacro

macro AM_ROW_INDEXJOIN_NEXT_LO
//----------------------------------------------------------------------------//
// macro AM_ROW_INDEXJOIN_NEXT_LO                                             //
//----------------------------------------------------------------------------//
  // ROW_INDEXJOIN_NEXT_LO
  Label ROW_INDEXJOIN_NEXT_LO

  // fetch next entry from index
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_IDX_NEXT

  EO_JMP_FALSE INDEXJOIN_NEXT_LO_RETURN

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_PUSH

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_PUSHUPPER

  EO_EQ_INTINT
  EO_JMP_TRUE INDEXJOIN_NEXT_LO_RETURN

  // projection
  //EO_CRW_SRC_DEREF
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_DEREF

  EO_CALL <joinRowRoutine>  // C_TAG_JOINROW_ROUTINE
  //EO_ROW_DST_PRINT

  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_ROWNO
  EO_RLU_SET_JOINMAP_BYTE

  EO_JMP ROW_INDEXJOIN_NEXT_LO

  Label INDEXJOIN_NEXT_LO_RETURN
  DeleteLabel INDEXJOIN_NEXT_LO_RETURN

  // Left outer rows
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_ROWNO
  EO_PUSH_RLU_JOINMAP_BYTE
  EO_RETURN_TRUE

  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_ROWNO
  EO_CTR_0_POP
  EO_PRINTF "**CALLING JOINROWS_CRWLFT_NULRHT\n"
  EO_CALL JOINROWS_ROWLFT_NULRHT

  EO_RETURN

endMacro

macro AM_ROWBUFFER_TRAVERSAL
//----------------------------------------------------------------------------//
// macro AM_ROWBUFFER_TRAVERSAL                                               //
//----------------------------------------------------------------------------//
  // ROWBUFFER_TRAVERSAL
  Label ROWBUFFER_TRAVERSAL
  EO_PRINTF "**ROWBUFFER_TRAVERSAL**\n"
  EO_POP
  //EO_ROW_DST_BEGIN
  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROWBUF_BEGIN

  // NEXT_ROW_DST
  Label NEXT_ROW_DST
  //EO_ROW_DST_NEXT
  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROWBUF_NEXT

  EO_JMP_FALSE ROWBUFFER_TRAVERSAL_DONE
  EO_CALL <rowProcessRoutine>  // C_TAG_ROW_PROCESS_ROUTINE
  EO_JMP NEXT_ROW_DST
  Label ROWBUFFER_TRAVERSAL_DONE
  EO_RETURN
 endMacro

