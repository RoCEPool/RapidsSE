macro AM_HANDLER_ROWBUFFER_AGG
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER_AGG                                             //
//----------------------------------------------------------------------------//
  // HANDLER_ROWBUFFER_AGG
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**HANDLER_ROWBUFFER**\n"
  EO_POP

  //EO_ROW_DST_TESTROW
  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROW_TEST

  EO_JMP_TRUE HANDLER_ROWBUFFER_AGG_BEGIN

  // new a dst row
  //EO_ROW_DST_NEW
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW
  EO_CALL ROWBUFFER_AGGINIT

  Label HANDLER_ROWBUFFER_AGG_BEGIN
  //EO_ROW_SRC_BEGIN
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_BEGIN

  // NEXT_ROW_SRC
  Label NEXT_ROW_SRC
  //EO_ROW_SRC_NEXT
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <rowProcessRoutine> // C_TAG_ROW_PROCESS_ROUTINE
  EO_JMP NEXT_ROW_SRC
  EO_JMP QUERY_DONE
 endMacro

