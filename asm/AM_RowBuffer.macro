macro AM_HANDLER_ROWBUFFER_AGG_GBY
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER_AGG_GBY                                         //
//----------------------------------------------------------------------------//
  // HANDLER_ROWBUFFER_AGG_GBY
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**HANDLER_ROWBUFFER**\n"
  EO_POP

  Label HANDLER_ROWBUFFER_AGG_GBY_BEGIN
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_BEGIN

  // NEXT_ROW_SRC
  Label NEXT_ROW_SRC
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <rowProcessRoutine> // C_TAG_ROW_PROCESS_ROUTINE
  EO_CALL <payLoadRoutine>  // C_TAG_PAYLOAD_ROUTINE
  EO_JMP NEXT_ROW_SRC
  EO_JMP QUERY_DONE
 endMacro

macro AM_HANDLER_ROWBUFFER_LIMIT
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER_LIMIT                                           //
//----------------------------------------------------------------------------//
  // ROWBUFFER HANDLER
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**HANDLER_ROWBUFFER**\n"
  EO_POP

  EO_POP

  //EO_ROW_SRC_BEGIN
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_BEGIN

  //EO_DUMP

  // NEXT_ROW_SRC
  Label NEXT_ROW_SRC

  // push limit on stack
  EO_INTEGER <limitRows>  // C_TAG_LIMIT_ROWS

  // push the counter
  EO_CTR_0_PUSH
  //EO_DUMP

  // check if limit reached
  EO_LE_INTINT
  EO_JMP_TRUE QUERY_DONE

  //EO_ROW_SRC_NEXT
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE

  // increment rows processed
  EO_CTR_0_INC

  EO_CALL <rowProcessRoutine>  // C_TAG_ROW_PROCESS_ROUTINE
  EO_JMP NEXT_ROW_SRC
  EO_JMP QUERY_DONE
 endMacro

macro AM_HANDLER_ROWBUFFER_RHT
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER_RHT                                             //
//----------------------------------------------------------------------------//
  // HANDLER_ROWBUFFER
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**ROWBUFFER RHT HANDLER**\n"
  EO_POP

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_TEST
  EO_JMP_FALSE ROWLFT_ROWRHT

  EO_CALL JOIN_CRWLFT_ROWRHT
  EO_RETURN

  Label ROWLFT_ROWRHT
  EO_CALL JOIN_ROWLFT_ROWRHT
  EO_RETURN

endMacro

macro AM_JOIN_CRWLFT_ROWRHT
//----------------------------------------------------------------------------//
// macro AM_JOIN_CRWLFT_ROWRHT                                                //
//----------------------------------------------------------------------------//
  // JOIN_CRWLFT_ROWRHT
  Label JOIN_CRWLFT_ROWRHT
  EO_PRINTF "**AM_JOIN_CRWLFT_ROWRHT**\n"
  EO_POP

  // For each row in the left crw buffer
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_LFT
  Label CRWLFT_ROWRHT_NEXT_CRWLFT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_NEXT
  EO_JMP_FALSE QUERY_DONE

  EO_PRINTF "**ROWBUFFER HANDLER GOT LFT**\n"

  // left row
  EO_RLU_SET_ITEMS <projectItems>     // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

  // Now iterate each right buffer
  EO_PUSH_DEVROW_RHT
  EO_DEVROW_ROWBUF_BEGIN

  // CRWLFT_ROWRHT_NEXT_ROWRHT
  Label CRWLFT_ROWRHT_NEXT_ROWRHT

  EO_PUSH_DEVROW_RHT
  EO_DEVROW_ROWBUF_NEXT

  EO_JMP_FALSE CRWLFT_ROWRHT_NEXT_CRWLFT

  EO_PRINTF "**ROWBUFFER HANDLER GOT RHT**\n"

  EO_CALL <crwProcessRoutine>   // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP CRWLFT_ROWRHT_NEXT_ROWRHT
  EO_JMP QUERY_DONE
endMacro

macro AM_JOIN_ROWLFT_ROWRHT
//----------------------------------------------------------------------------//
// macro AM_JOIN_ROWLFT_ROWRHT                                                //
//----------------------------------------------------------------------------//
  // JOIN_ROWLFT_ROWRHT
  Label JOIN_ROWLFT_ROWRHT
  EO_PRINTF "**AM_JOIN_ROWLFT_ROWRHT**\n"
  EO_POP

  // For each row in the left buffer
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_BEGIN

  // NEXT_ROW_LFT
  Label ROWLFT_ROWRHT_NEXT_ROWLFT

  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_NEXT
  EO_JMP_FALSE QUERY_DONE

  EO_PRINTF "**ROWBUFFER HANDLER GOT LFT**\n"

  // left row
  EO_RLU_SET_ITEMS <projectItems>     // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_LOCALS

  // Now iterate each right buffer
  EO_PUSH_DEVROW_RHT
  EO_DEVROW_ROWBUF_BEGIN

  // NEXT_CRW_RHT
  Label ROWLFT_ROWRHT_NEXT_ROWRHT

  EO_PUSH_DEVROW_RHT
  EO_DEVROW_ROWBUF_NEXT

  EO_JMP_FALSE ROWLFT_ROWRHT_NEXT_ROWLFT

  EO_PRINTF "**ROWBUFFER HANDLER GOT RHT**\n"

  EO_CALL <crwProcessRoutine>   // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP ROWLFT_ROWRHT_NEXT_ROWRHT
  EO_JMP QUERY_DONE
endMacro

macro AM_ROW_PROJECT_COLUMNS
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_COLUMNS                                               //
//----------------------------------------------------------------------------//
  // ROW_PROJECT_COLUMNS
  Label ROW_PROJECT_COLUMNS

  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_JMP_FALSE ROW_PROJECT

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_LOCALS

  Label ROW_PROJECT

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  //EO_DUMP
endMacro

macro AM_ROW_PROJECT_COLUMNS_AGG
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_COLUMNS_AGG                                           //
//----------------------------------------------------------------------------//
  // ROW_PROJECT_COLUMNS_AGG
  Label ROW_PROJECT_COLUMNS_AGG

  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_JMP_FALSE ROW_PROJECT_AGG

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_LOCALS
  //EO_DUMP

  Label ROW_PROJECT_AGG

endMacro

macro AM_ROW_PROJECT_STAR
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_STAR                                                  //
//----------------------------------------------------------------------------//
  // AM_ROW_PROJECT_STAR
  Label ROW_PROJECT_STAR
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_ROW

  EO_RETURN

endMacro

macro AM_ROW_PROJECT_END
//----------------------------------------------------------------------------//
// macro AM_ROW_PROJECT_END                                                   //
//----------------------------------------------------------------------------//
  // PROJECT_END
  EO_RETURN
endMacro

macro AM_ROW_FILTER_ROWS
//----------------------------------------------------------------------------//
// macro AM_ROW_FILTER_ROWS                                                   //
//----------------------------------------------------------------------------//
  // ROW_FILTER_ROWS
  Label ROW_FILTER_ROWS
  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_LOCALS
endMacro

macro AM_ROW_FILTER_END
//----------------------------------------------------------------------------//
// macro AM_ROW_FILTER_END                                                    //
//----------------------------------------------------------------------------//
  // ROW_FILTER_END
  EO_RETURN_FALSE
  EO_CALL ROW_PROJECT_STAR

  EO_RETURN
endMacro

