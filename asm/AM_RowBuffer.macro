/*============================================================================*/
/* AM_RowBuffer.macro -- ASM Macros for ROWBUFFER Handler                     */
/*============================================================================*/

macro AM_HANDLER_ROWBUFFER
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER                                                 //
//----------------------------------------------------------------------------//
  // ROWBUFFER HANDLER
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**HANDLER_ROWBUFFER**\n"
  EO_POP
  EO_ROW_SRC_BEGIN

  // NEXT_ROW_SRC
  Label NEXT_ROW_SRC
  EO_ROW_SRC_NEXT
  EO_JMP_FALSE QUERY_DONE
  EO_CALL <rowProcessRoutine>
  EO_JMP NEXT_ROW_SRC
  EO_JMP QUERY_DONE
 endMacro

macro AM_HANDLER_ROWBUFFER_AGG
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ROWBUFFER_AGG                                             //
//----------------------------------------------------------------------------//
  // HANDLER_ROWBUFFER_AGG
  Label HANDLER_ROWBUFFER
  EO_PRINTF "**HANDLER_ROWBUFFER**\n"
  EO_POP

  EO_ROW_DST_TESTROW
  EO_JMP_TRUE HANDLER_ROWBUFFER_AGG_BEGIN

  // new a dst row
  //EO_ROW_DST_NEW
  EO_PUSH_DEVROW_DST
  EO_DEVROW_NEW

  Label HANDLER_ROWBUFFER_AGG_BEGIN
  EO_ROW_SRC_BEGIN

  // NEXT_ROW_SRC
  Label NEXT_ROW_SRC
  EO_ROW_SRC_NEXT
  EO_JMP_FALSE QUERY_DONE
  EO_CALL <rowProcessRoutine>
  EO_JMP NEXT_ROW_SRC
  EO_JMP QUERY_DONE
 endMacro

