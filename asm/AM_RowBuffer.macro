macro AM_ROW_FILTER_ROWS
//----------------------------------------------------------------------------//
// macro AM_ROW_FILTER_ROWS                                                   //
//----------------------------------------------------------------------------//
  // ROW_FILTER_ROWS
  Label ROW_FILTER_ROWS
  EO_SET_ITEMS <projectItems>
  EO_SET_COLUMNS <projectSrcColumns>
  EO_SET_LOCALS_ROW
endMacro

macro AM_ROW_FILTER_END
//----------------------------------------------------------------------------//
// macro AM_ROW_FILTER_END                                                    //
//----------------------------------------------------------------------------//
  // ROW_FILTER_END
  EO_CALL ROW_PROJECT_STAR
 //EO_ROW_DST_PRINT
 EO_PUSH_DEVROW_DST
 EO_DEVROW_PRINT

  EO_RETURN
endMacro

