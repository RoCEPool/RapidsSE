/*============================================================================*/
/* AM_Payload.macro -- ASM Macros for PAYLOAD                                 */
/*============================================================================*/

macro AM_PAYLOAD_GBY
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_GBY                                                       //
//----------------------------------------------------------------------------//
  // AM_PAYLOAD_GBY
  Label PAYLOAD_GBY

  // reset entwrk
  EO_PUSH_RLU_ENTWRK
  EO_ENTWRK_RESET

  EO_CALL <payLoadKey>  // C_TAG_PAYLOAD_KEY

  //EO_DEVIXT_ENT_FINDI
  //EO_JMP_TRUE FOUND

  // find the key in the indexTree
  EO_PUSH_DEVIXT_TMP
  EO_DEVIXT_ENT_POSPRIOR
  EO_JMP_FALSE NOT_FOUND

  EO_PUSH_DEVIXT_TMP
  EO_DEVIXT_ENT_NEXT
  EO_JMP_FALSE NOT_FOUND

  EO_PUSH_DEVIXT_TMP
  EO_PUSH_RLU_ENT
  EO_DEVIXT_ENTKEY_EQUAL
  EO_JMP_TRUE FOUND

  // NOT_FOUND:
  Label NOT_FOUND
  EO_CALL PAYLOAD_STORE
  EO_RETURN

  // FOUND:
  Label FOUND
  EO_CALL PAYLOAD_AGG

  EO_RETURN
endMacro

macro AM_PAYLOAD_KEY
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_KEY                                                       //
//----------------------------------------------------------------------------//
  // AM_PAYLOAD_KEY
  Label PAYLOAD_KEY

endMacro

macro AM_PAYLOAD_KEY_END
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_KEY_END                                                   //
//----------------------------------------------------------------------------//
  // AM_PAYLOAD_KEY_END
  Label PAYLOAD_KEY_END
  EO_RETURN
endMacro

macro AM_PAYLOAD_STORE
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_STORE                                                     //
//----------------------------------------------------------------------------//
  Label PAYLOAD_STORE

  EO_PUSH_RLU_ENTWRK
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ENTWRK_CREATEPAY <payLoadBytes>  // C_TAG_PAYLOAD_BYTES

  EO_PUSH_DEVIXT_TMP
  EO_PUSH_RLU_ENT
  EO_DEVIXT_IDX_INS
  EO_PUSH_DEVIXT_TMP
  EO_PAY_ADDRESS

endMacro

macro AM_PAYLOAD_AGG
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_AGG                                                       //
//----------------------------------------------------------------------------//
  Label PAYLOAD_AGG
  EO_PUSH_DEVIXT_TMP
  EO_PAY_ADDRESS
  //EO_SUPER_Q100 ???? OPTIMIZATION (ALKA: COME BACK TO THIS)
  // sum(L_QUANTITY) -> Q100_SUM_QTY
  //  EO_PAY_FETCH_COLI 2
  //  EO_PUSH_LOCALI 0
  //  EO_ADD
  //  EO_PAY_STORE_COLI 2
endMacro

macro AM_PAYLOAD_END
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_END                                                       //
//----------------------------------------------------------------------------//
 //EO_PUSH_DEVIXT_TMP
 //EO_DEVIXT_IDX_DUMP
 EO_RETURN
endMacro

macro AM_PAYLOAD_TO_BUFFER
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_TO_BUFFER                                                 //
//----------------------------------------------------------------------------//
  // AM_PAYLOAD_TO_BUFFER
  Label PAYLOAD_TO_BUFFER

  // new a dst row
  //EO_ROW_DST_NEW
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVIXT_TMP
  EO_PAY_ADDRESS

endMacro

macro AM_PAYLOAD_TO_BUFFER_END
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_TO_BUFFER_END                                             //
//----------------------------------------------------------------------------//
 // AM_PAYLOAD_TO_BUFFER_END
 Label PAYLOAD_TO_BUFFER_END
 //EO_PUSH_DEVROW_DST
 //EO_DEVROW_ROW_PRINT
 EO_RETURN
endMacro

