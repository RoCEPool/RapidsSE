/*============================================================================*/
/* StartMarker -- ASM StartMarker Macros                                      */
/*============================================================================*/

macro AM_STARTMARKER_HANDLER
//----------------------------------------------------------------------------//
// macro AM_STARTMARKER_HANDLER                                               //
//----------------------------------------------------------------------------//
  // STARTMARKER HANDLER
  Label STARTMARKER_HANDLER
  EO_PRINTF "**STARTMARKER_HANDLER**\n"
  EO_POP
  EO_TABLENM_SRC_SET <srcTableNm>
  EO_INDEXNM_SRC_SET <srcIndexNm>
  EO_TABLENM_ALT_SET <altTableNm>
  EO_INDEXNM_ALT_SET <altIndexNm>

  EO_HANDLER <logicUnitHandler>
  EO_CALLAGAIN
  EO_JMP QUERY_DONE
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/