/*============================================================================*/
/* AM_Index.macro -- ASM Macros for Indexes                                   */
/*============================================================================*/

macro AM_INDEX_TRAVERSAL
//----------------------------------------------------------------------------//
// macro AM_INDEX_TRAVERSAL                                                   //
//----------------------------------------------------------------------------//
  // INDEX TRAVERSAL
  Label INDEX_TRAVERSAL
  EO_PUSH_DEVIXT_TMP
  EO_DEVIXT_IDX_BEGIN
  EO_JMP_FALSE INDEX_TRAVERSAL_END

  Label INDEX_TRAVERSAL_NEXT
  EO_CALL <indexProcessRoutine>  // C_TAG_INDEX_PROCESS_ROUTINE

  // NEXT_IXT_SRC:
  EO_PUSH_DEVIXT_TMP
  EO_DEVIXT_ENT_NEXT
  EO_JMP_TRUE INDEX_TRAVERSAL_NEXT

  Label INDEX_TRAVERSAL_END
  EO_RETURN
endMacro


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/