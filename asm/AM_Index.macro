/*============================================================================*/
/* AM_Index.macro -- ASM Macros for Indexes                                   */
/*============================================================================*/

macro AM_INDEX_TRAVERSAL
//----------------------------------------------------------------------------//
// macro AM_INDEX_TRAVERSAL                                                   //
//----------------------------------------------------------------------------//
  // INDEX TRAVERSAL
  Label INDEX_TRAVERSAL
  EO_PUSH_DEVIXT_TMP
  EO_DEVIXT_IDX_BEGIN
  EO_JMP_FALSE INDEX_TRAVERSAL_END

  Label INDEX_TRAVERSAL_NEXT
  // projection
  EO_CALL <indexProcessRoutine>  // C_TAG_INDEX_PROCESS_ROUTINE

  // NEXT_IXT_SRC:
  EO_PUSH_DEVIXT_TMP
  EO_DEVIXT_ENT_NEXT
  EO_JMP_TRUE INDEX_TRAVERSAL_NEXT

  Label INDEX_TRAVERSAL_END
  EO_RETURN
endMacro

macro AM_INDEX_SCAN
//----------------------------------------------------------------------------//
// macro AM_INDEX_SCAN (with optional Upper/Lower bounds)                     //
//----------------------------------------------------------------------------//
  Label INDEX_SCAN
endMacro


macro AM_INDEX_POSITION_AT_START
//----------------------------------------------------------------------------//
// macro AM_INDEX_POSITION_AT_START                                           //
//----------------------------------------------------------------------------//
  Label INDEX_POSITION_AT_START
  // no lower key position at beginning of index
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_IDX_BEGIN

  // no entry return
  EO_JMP_FALSE INDEX_SCAN_END
endMacro

macro AM_INDEX_TRAVERSE_TILL_END
//----------------------------------------------------------------------------//
// macro AM_INDEX_TRAVERSE_TILL_END                                           //
//----------------------------------------------------------------------------//
  // no upper key traverse till end
  Label INDEX_TRAVERSE_TILL_END
  //EO_PUSH_DEVIXT_LFT
  //EO_DEVIXT_IDX_NEXT
  EO_JMP_FALSE INDEX_SCAN_END

  // projection
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_ENT_DEREF

  EO_CALL <crwProcessRoutine>  // C_TAG_CRW_PROCESS_ROUTINE

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_IDX_NEXT

  EO_JMP INDEX_TRAVERSE_TILL_END
endMacro

macro AM_INDEX_TRAVERSE_TILL_UPPER
//----------------------------------------------------------------------------//
// macro AM_INDEX_TRAVERSE_TILL_UPPER                                         //
//----------------------------------------------------------------------------//
  // traverse the index till we reach upper bound
  Label INDEX_TRAVERSE_TILL_UPPER

  // fetch next entry from index
  //EO_PUSH_DEVIXT_LFT
  //EO_DEVIXT_IDX_NEXT
  EO_JMP_FALSE INDEX_SCAN_END

    // have we reached the upper entry
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_ENT_PUSH

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_ENT_PUSHUPPER

  EO_EQ_INTINT
  EO_JMP_TRUE INDEX_SCAN_END

  // projection
  //EO_CRW_SRC_DEREF
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_ENT_DEREF

  EO_CALL <crwProcessRoutine>  // C_TAG_CRW_PROCESS_ROUTINE

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_IDX_NEXT

  EO_JMP INDEX_TRAVERSE_TILL_UPPER
endMacro

macro AM_INDEX_SCAN_END
//----------------------------------------------------------------------------//
// macro AM_INDEX_SCAN_END                                                    //
//----------------------------------------------------------------------------//
  Label INDEX_SCAN_END
  EO_RETURN
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/