/*============================================================================*/
/* AM_EndRightMarker.macro -- ASM EndRightMarker Handler Macros               */
/*============================================================================*/

macro AM_HANDLER_LEFTOUTER_CRWLFT
//----------------------------------------------------------------------------//
// macro AM_HANDLER_LEFTOUTER_CRWLFT                                          //
//----------------------------------------------------------------------------//
  // HANDLER_LEFTOUTER_CRWLFT
  Label HANDLER_LEFTOUTER_CRWLFT
  EO_PRINTF "**HANDLER_LEFTOUTER_CRWLFT**\n"

  EO_PUSH_0
  EO_CTR_0_POP

  Label HANDLER_LEFTOUTER_CRWLFT_BEGIN

  // get row count of buffer
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // push no of rows in the left buffer
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_ROWCNT

  EO_CTR_0_PUSH
  EO_LE_INTINT
  EO_JMP_TRUE HANDLER_LEFTOUTER_CRWLFT_END

  EO_CTR_0_PUSH
  EO_PUSH_RLU_JOINMAP_BYTE
  EO_JMP_TRUE HANDLER_LEFTOUTER_CRWLFT_NEXT

  EO_PRINTF "**CALLING JOINROWS_CRWLFT_NULRHT\n"
  EO_CALL JOINROWS_CRWLFT_NULRHT

  Label HANDLER_LEFTOUTER_CRWLFT_NEXT
  EO_CTR_0_INC
  EO_JMP HANDLER_LEFTOUTER_CRWLFT_BEGIN

  Label HANDLER_LEFTOUTER_CRWLFT_END
  EO_RLU_RESET_JOINMAP

  EO_RETURN
endMacro

macro AM_HANDLER_LEFTOUTER_ROWLFT
//----------------------------------------------------------------------------//
// macro AM_HANDLER_LEFTOUTER_ROWLFT                                          //
//----------------------------------------------------------------------------//
  // HANDLER_LEFTOUTER_ROWLFT
  Label HANDLER_LEFTOUTER_ROWLFT
  EO_PRINTF "**HANDLER_LEFTOUTER_ROWLFT**\n"

  // get row count of buffer
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_BEGIN

  EO_PUSH_0
  EO_CTR_0_POP

  Label HANDLER_LEFTOUTER_ROWLFT_BEGIN

  // push no of rows in the left buffer
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_ROWCNT

  EO_CTR_0_PUSH
  EO_LE_INTINT
  EO_JMP_TRUE HANDLER_LEFTOUTER_ROWLFT_END

  EO_CTR_0_PUSH
  EO_PUSH_RLU_JOINMAP_BYTE
  EO_JMP_TRUE HANDLER_LEFTOUTER_ROWLFT_NEXT

  EO_PRINTF "**CALLING JOINROWS_ROWLFT_NULRHT\n"
  EO_CALL JOINROWS_ROWLFT_NULRHT

  Label HANDLER_LEFTOUTER_ROWLFT_NEXT
  EO_CTR_0_INC
  EO_JMP HANDLER_LEFTOUTER_ROWLFT_BEGIN

  Label HANDLER_LEFTOUTER_ROWLFT_END
  EO_RLU_RESET_JOINMAP

  EO_RETURN
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
