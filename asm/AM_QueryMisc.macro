/*============================================================================*/
/* AM_QueryMisc.txt -- ASM QUERY Misc Macros                                  */
/*============================================================================*/
macro AM_QUERY_INIT
//----------------------------------------------------------------------------//
// macro AM_QUERY_INIT                                                        //
//----------------------------------------------------------------------------//
  Routine QUERY_<queryNo>  // C_TAG_QUERY_NO
  // initialization   
  EO_INIT             
  EO_ENTER            
  EO_SQL <subQueryNo>  // C_TAG_SUBQUERY_NO

  // check for ZK_DATAPULSE
  EO_DUP                        
  EO_INTEGER ZK_DATAPULSE       
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_DATAPULSE

  // check for ZK_STREAMDEF
  EO_DUP                        
  EO_INTEGER  ZK_STREAMDEF      
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_STREAMDEF

  // check for ZK_CRWBUFFER
  EO_DUP                        
  EO_INTEGER ZK_CRWBUFFER       
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_CRWBUFFER

  // check for ZK_ROWBUFFER
  EO_DUP
  EO_INTEGER ZK_ROWBUFFER
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_ROWBUFFER

  // check for ZK_END_CRWRHTMARKER
  EO_DUP
  EO_INTEGER  ZK_END_CRWRHTMARKER
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_ENDCRW_RHTMARKER

  // check for ZK_EOSMARKER
  EO_DUP                        
  EO_INTEGER  ZK_EOSMARKER      
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_EOSMARKER

  // Never reach
  EO_PRINTF "**NO_HANDLER**\n"
  EO_NEVERREACH
endMacro

macro AM_QUERY_DONE
//----------------------------------------------------------------------------//
// macro AM_QUERY_DONE                                                        //
//----------------------------------------------------------------------------//
  // QUERY_DONE
  Label QUERY_DONE
  EO_EXIT
  EO_RETURN

//----------------------------------------------------------------------------//
// end                                                                        //
//----------------------------------------------------------------------------//
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/