/*============================================================================*/
/* AM_QueryMisc.txt -- ASM QUERY Misc Macros                                  */
/*============================================================================*/
macro AM_QUERY_INIT
//----------------------------------------------------------------------------//
// macro AM_QUERY_INIT                                                        //
//----------------------------------------------------------------------------//
  Routine QUERY_<queryNo>
  // initialization   
  EO_INIT             
  EO_ENTER            
  EO_SQL <subQueryNo>

  // check for ZK_STARTMARKER
  EO_DUP                          
  EO_INTEGER ZK_STARTMARKER       
  EO_EQUAL                        
  EO_JMP_TRUE HANDLER_STARTMARKER

  // check for ZK_DATAPULSE
  EO_DUP                        
  EO_INTEGER ZK_DATAPULSE       
  EO_EQUAL                      
  EO_JMP_TRUE HANDLER_DATAPULSE

  // check for ZK_STREAMDEF
  EO_DUP                        
  EO_INTEGER  ZK_STREAMDEF      
  EO_EQUAL                      
  EO_JMP_TRUE HANDLER_STREAMDEF

  // check for ZK_CRWBUFFER
  EO_DUP                        
  EO_INTEGER ZK_CRWBUFFER       
  EO_EQUAL                      
  EO_JMP_TRUE HANDLER_CRWBUFFER

  // check for ZK_ROWBUFFER
  EO_DUP
  EO_INTEGER ZK_ROWBUFFER
  EO_EQUAL
  EO_JMP_TRUE HANDLER_ROWBUFFER

  // check for ZK_EOSMARKER
  EO_DUP                        
  EO_INTEGER  ZK_EOSMARKER      
  EO_EQUAL                      
  EO_JMP_TRUE HANDLER_EOSMARKER

  // Never reach
  EO_PRINTF "**NO_HANDLER**\n"
  EO_NEVERREACH
endMacro

//----------------------------------------------------------------------------//
// end                                                                        //
//----------------------------------------------------------------------------//
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/