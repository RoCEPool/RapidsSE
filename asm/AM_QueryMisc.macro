/*============================================================================*/
/* AM_QueryMisc.txt -- ASM QUERY Misc Macros                                  */
/*============================================================================*/
macro AM_QUERY_INIT
//----------------------------------------------------------------------------//
// macro AM_QUERY_INIT                                                        //
//----------------------------------------------------------------------------//
  Routine QUERY_<queryNo>  // C_TAG_QUERY_NO
  // initialization   
  EO_INIT             
  EO_ENTER_LU
  EO_SQL <subQueryNo>  // C_TAG_SUBQUERY_NO

  // check for ZK_M_DATAPULSE
  EO_DUP                        
  EO_INTEGER ZK_M_DATAPULSE
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_DATAPULSE

  // check for ZK_D_STREAMDEF
  EO_DUP                        
  EO_INTEGER  ZK_D_STREAMDEF
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_STREAMDEF

  // check for ZK_D_CRWBUFFER
  EO_DUP                        
  EO_INTEGER ZK_D_CRWBUFFER
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_CRWBUFFER

  // check for ZK_D_ROWBUFFER
  EO_DUP
  EO_INTEGER ZK_D_ROWBUFFER
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_ROWBUFFER

  // check for ZK_M_LEFTOUTER_CRWLFT
  EO_DUP
  EO_INTEGER  ZK_M_LEFTOUTER_CRWLFT
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_LEFTOUTER_CRWLFT

  // check for ZK_M_LEFTOUTER_ROWLFT
  EO_DUP
  EO_INTEGER  ZK_M_LEFTOUTER_ROWLFT
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_LEFTOUTER_ROWLFT

  // check for ZK_M_EOS
  EO_DUP                        
  EO_INTEGER  ZK_M_EOS
  EO_EQ_INTINT
  EO_JMP_TRUE HANDLER_EOSMARKER

  // Never reach
  EO_PRINTF "**NO_HANDLER**\n"
  EO_NEVERREACH
endMacro

macro AM_QUERY_DONE
//----------------------------------------------------------------------------//
// macro AM_QUERY_DONE                                                        //
//----------------------------------------------------------------------------//
  // QUERY_DONE
  Label QUERY_DONE
  EO_EXIT_LU
  EO_RETURN

//----------------------------------------------------------------------------//
// end                                                                        //
//----------------------------------------------------------------------------//
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/