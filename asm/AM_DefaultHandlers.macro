macro AM_DEFAULT_HANDLER_STARTMARKER
//----------------------------------------------------------------------------//
// macro AM_DEFAULT_HANDLER_STARTMARKER                                       //
//----------------------------------------------------------------------------//
  // STARTMARKER HANDLER
  Label HANDLER_STARTMARKER
  EO_PRINTF "**HANDLER_STARTMARKER_**\n"
  EO_POP
  EO_EXIT
  EO_RETURN
endMacro

