macro AM_DEFAULT_HANDLER_CRWBUFFER
//----------------------------------------------------------------------------//
// macro AM_DEFAULT_HANDLER_CRWBUFFER                                         //
//----------------------------------------------------------------------------//
  // CRWBUFFER HANDLER
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**HANDLER_CRWBUFFER**\n"
  EO_POP
  EO_JMP QUERY_DONE
endMacro

