macro AM_DEFAULT_STARTMARKER_HANDLER
//----------------------------------------------------------------------------//
// macro AM_DEFAULT_STARTMARKER_HANDLER                                       //
//----------------------------------------------------------------------------//
  // STARTMARKER HANDLER
  Label STARTMARKER_HANDLER
  EO_PRINTF "**STARTMARKER_HANDLER**\n"
  EO_POP
  EO_JMP QRY_DONE
endMacro

