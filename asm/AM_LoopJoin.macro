/*============================================================================*/
/* AM_LoopJoin.macro -- ASM Macros for LOOPJOIN                               */
/*============================================================================*/

macro AM_LOOPJOIN_CRWLFT_CRWRHT
//----------------------------------------------------------------------------//
// macro AM_LOOPJOIN_CRWLFT_CRWRHT                                            //
//----------------------------------------------------------------------------//
  // LOOPJOIN_CRWLFT_CRWRHT
  Label LOOPJOIN_CRWLFT_CRWRHT
  EO_PRINTF "**AM_LOOPJOIN_CRWLFT_CRWRHT**\n"

  // For each row in the left buffer
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_LFT
  Label CRWLFT_CRWRHT_NEXT_CRWLFT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_NEXT
  EO_JMP_FALSE QUERY_DONE

  //EO_PRINTF "**LOOPJOIN_CRWLFT_CRWRHT GOT LFT**\n"

  // left row

  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_JMP_FALSE CRWLFT_CRWRHT_RHT

  EO_RLU_SET_ITEMS <projectItems>     // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

  Label CRWLFT_CRWRHT_RHT

  // Now iterate each right buffer
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_CRWBUF_BEGIN

  // CRWLFT_CRWRHT_NEXT_CRWRHT
  Label CRWLFT_CRWRHT_NEXT_CRWRHT

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE CRWLFT_CRWRHT_NEXT_CRWLFT

  //EO_PRINTF "**LOOPJOIN_CRWLFT_CRWRHT GOT RHT**\n"

  EO_CALL JOINTEST_CRWLFT_CRWRHT
  EO_JMP_FALSE CRWLFT_CRWRHT_NEXT_CRWRHT
  EO_CALL JOINROWS_CRWLFT_CRWRHT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_ROWNO
  EO_RLU_SET_JOINMAP_BYTE

  EO_JMP CRWLFT_CRWRHT_NEXT_CRWRHT
  EO_JMP QUERY_DONE
endMacro

macro AM_LOOPJOIN_CRWLFT_ROWRHT
//----------------------------------------------------------------------------//
// macro AM_LOOPJOIN_CRWLFT_ROWRHT                                            //
//----------------------------------------------------------------------------//
  // LOOPJOIN_CRWLFT_ROWRHT
  Label LOOPJOIN_CRWLFT_ROWRHT
  EO_PRINTF "**AM_LOOPJOIN_CRWLFT_ROWRHT**\n"

  // For each row in the left crw buffer
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_LFT
  Label CRWLFT_ROWRHT_NEXT_CRWLFT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_NEXT
  EO_JMP_FALSE QUERY_DONE

  EO_PRINTF "**LOOPJOIN_CRWLFT_ROWRHT GOT LFT**\n"

  // left row
  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_JMP_FALSE CRWLFT_ROWRHT_RHT

  EO_RLU_SET_ITEMS <projectItems>     // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

  Label CRWLFT_ROWRHT_RHT

  // Now iterate each right buffer
  EO_PUSH_DEVROW_RHT
  EO_DEVROW_ROWBUF_BEGIN

  // CRWLFT_ROWRHT_NEXT_ROWRHT
  Label CRWLFT_ROWRHT_NEXT_ROWRHT

  EO_PUSH_DEVROW_RHT
  EO_DEVROW_ROWBUF_NEXT

  EO_JMP_FALSE CRWLFT_ROWRHT_NEXT_CRWLFT

  EO_PRINTF "**LOOPJOIN_CRWLFT_ROWRHT GOT RHT**\n"

  EO_CALL JOINTEST_CRWLFT_ROWRHT
  EO_JMP_FALSE CRWLFT_ROWRHT_NEXT_ROWRHT
  EO_CALL JOINROWS_CRWLFT_ROWRHT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_ROWNO
  EO_RLU_SET_JOINMAP_BYTE

  EO_JMP CRWLFT_ROWRHT_NEXT_ROWRHT
  EO_JMP QUERY_DONE
endMacro

