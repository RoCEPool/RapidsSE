/*============================================================================*/
/* AM_JoinRows.macro -- ASM Macros for JOINING ROWS                           */
/*============================================================================*/

//----------------------------------------------------------------------------//
// macro AM_JOINROW_CRWLFT_CRWRHT                                             //
//----------------------------------------------------------------------------//
macro AM_JOINROW_CRWLFT_CRWRHT
  // AM_JOINROW_CRWLFT_CRWRHT
  Label JOINROW_CRWLFT_CRWRHT
  EO_PRINTF "**JOINROW_CRWLFT_CRWRHT**\n"

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  // inflate left row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_INTEGER 0
  EO_DEVIXT_COLS_TO_ROW_OFS

  // inflate right row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_RHT
  EO_PUSH_DEVIXT_RHT
  EO_INTEGER <rowOffset>  // C_TAG_ROWOFFSET
  EO_DEVIXT_COLS_TO_ROW_OFS

  //EO_PUSH_DEVROW_DST
  //EO_DEVROW_ROW_PRINT
  EO_RETURN

endMacro

//----------------------------------------------------------------------------//
// macro AM_JOINROW_CRWLFT_ENTRHT                                             //
//----------------------------------------------------------------------------//
macro AM_JOINROW_CRWLFT_ENTRHT
  // JOINROW_CRWLFT_ENTRHT
  Label JOINROW_CRWLFT_ENTRHT
  EO_PRINTF "**JOINROW_CRWLFT_ENTRHT**\n"

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  // inflate left row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_INTEGER 0
  EO_DEVIXT_COLS_TO_ROW_OFS

  // deref the ent
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_DEREF

  // inflate right row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_RHT
  EO_PUSH_DEVIXT_RHT
  EO_INTEGER <rowOffset>  // C_TAG_ROWOFFSET
  EO_DEVIXT_COLS_TO_ROW_OFS

  //EO_PUSH_DEVROW_DST
  //EO_DEVROW_ROW_PRINT
  EO_RETURN

endMacro

