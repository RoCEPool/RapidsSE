  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  // inflate left row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_INTEGER 0
  EO_DEVIXT_COLS_TO_ROW_OFS

  // inflate right row into dst row
