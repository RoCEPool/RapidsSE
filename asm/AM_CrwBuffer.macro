//----------------------------------------------------------------------------//
// macro AM_CRW_JOIN_ROW                                                      //
//----------------------------------------------------------------------------//
macro AM_CRW_JOIN_ROW
  // CRW_JOIN_ROW
  Label CRW_JOIN_ROW

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  // inflate left row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_ROW

  // inflate right row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_RHT
  EO_INTEGER <rowOffset>  // C_TAG_ROWOFFSET
  EO_DEVROW_COLS_TO_ROW_OFS

  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROW_PRINT
  EO_RETURN

endMacro

//----------------------------------------------------------------------------//
// macro AM_ROW_JOIN_CRW                                                      //
//----------------------------------------------------------------------------//
macro AM_ROW_JOIN_CRW
  // ROW_JOIN_CRW
  Label ROW_JOIN_CRW

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  // inflate left row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_ROW

  // inflate right row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVIXT_RHT
  EO_INTEGER <rowOffset>  // C_TAG_ROWOFFSET
  EO_DEVIXT_COLS_TO_ROW_OFS

  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROW_PRINT
  EO_RETURN

endMacro

