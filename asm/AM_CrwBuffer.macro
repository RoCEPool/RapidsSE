/*============================================================================*/
/* AM_CrwBuffer.macro -- ASM Macros for CRWBUFFER Handler                     */
/*============================================================================*/

macro AM_HANDLER_CRWBUFFER
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER                                                 //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP
  EO_CRW_SRC_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC
  EO_CRW_SRC_NEXT
  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_HANDLER_CRWBUFFER_AGG
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER_AGG                                             //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER_AGG
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP

  // new a dst row
  EO_ROW_DST_NEW

  EO_CRW_SRC_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC
  EO_CRW_SRC_NEXT
  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_CRW_PROJECT_COLUMNS
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_COLUMNS                                               //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_COLUMNS
  Label CRW_PROJECT_COLUMNS
  EO_SET_ITEMS <projectItems>
  EO_SET_COLUMNS <projectSrcColumns>
  EO_SET_LOCALS_SRC2
  EO_ROW_DST_NEW
  //EO_DUMP
endMacro

macro AM_CRW_PROJECT_COLUMNS_AGG
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_COLUMNS_AGG                                           //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_COLUMNS_AGG
  Label CRW_PROJECT_COLUMNS_AGG
  EO_SET_ITEMS <projectItems>
  EO_SET_COLUMNS <projectSrcColumns>
  EO_SET_LOCALS_SRC2
  //EO_DUMP
endMacro

macro AM_CRW_PROJECT_NONE
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_NONE                                                  //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_NONE
  Label CRW_PROJECT_NONE
  EO_ROW_DST_NEW
  //EO_DUMP
endMacro

macro AM_CRW_PROJECT_STAR
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_STAR                                                  //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_STAR
  Label CRW_PROJECT_STAR
  EO_ROW_DST_NEW
  EO_COL_SRC_PUSHDST
  EO_ROW_DST_PRINT
  EO_RETURN
endMacro

//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_END                                                   //
//----------------------------------------------------------------------------//
macro AM_CRW_PROJECT_END
  // CRW_PROJECT_END
  EO_ROW_DST_PRINT
  EO_RETURN
endMacro

macro AM_CRW_FILTER_ROWS
//----------------------------------------------------------------------------//
// macro AM_CRW_FILTER_ROWS                                                   //
//----------------------------------------------------------------------------//
  // CRW_FILTER_ROWS
  Label CRW_FILTER_ROWS
  EO_SET_ITEMS <projectItems>
  EO_SET_COLUMNS <projectSrcColumns>
  EO_SET_LOCALS_SRC2
endMacro

//----------------------------------------------------------------------------//
// macro AM_CRW_FILTER_END                                                    //
//----------------------------------------------------------------------------//
macro AM_CRW_FILTER_END
  // CRW_FILTER_END
  EO_CALL CRW_PROJECT_STAR
  EO_ROW_DST_PRINT
  Label CRW_FILTER_FALSE
  EO_RETURN
endMacro

