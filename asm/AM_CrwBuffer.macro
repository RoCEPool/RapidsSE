/*============================================================================*/
/* AM_CrwBuffer.macro -- ASM Macros for CRWBUFFER Handler                     */
/*============================================================================*/

macro AM_HANDLER_CRWBUFFER
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER                                                 //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC

  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>   // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_HANDLER_CRWBUFFER_AGG
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER_AGG                                             //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER_AGG
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP

  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROW_TEST

  EO_JMP_TRUE HANDLER_CRWBUFFER_AGG_BEGIN

  // new a dst row
  //EO_ROW_DST_NEW
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  Label HANDLER_CRWBUFFER_AGG_BEGIN
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>    // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_HANDLER_CRWBUFFER_AGG_GBY
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER_AGG_GBY                                         //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER_AGG_GBY
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP

  Label HANDLER_CRWBUFFER_AGG_GBY_BEGIN
  //EO_CRW_SRC_BEGIN
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC
  //EO_CRW_SRC_NEXT
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>    // C_TAG_CRW_PROCESS_ROUTINE
  EO_CALL <payLoadRoutine>       // C_TAG_PAYLOAD_ROUTINE
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_HANDLER_CRWBUFFER_LIMIT
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER_LIMIT                                           //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_CRWBUF_BEGIN

  // push limit on stack
  EO_INTEGER <limitRows>     // C_TAG_LIMIT_ROWS
  EO_DUMP

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC

  // check if limit reached
  EO_DUP
  EO_CTR_0_PUSH
  EO_DUMP
  EO_LESSEQUAL
  EO_JMP_TRUE QUERY_DONE

  // increment rows processed
  EO_CTR_0_INC

  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>   // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_CRW_PROJECT_COLUMNS
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_COLUMNS                                               //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_COLUMNS
  Label CRW_PROJECT_COLUMNS

  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_JMP_FALSE CRW_PROJECT

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMN
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_SRC
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_COLS_TO_LOCALS

  Label CRW_PROJECT

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  //EO_DUMP
endMacro

macro AM_CRW_PROJECT_COLUMNS_AGG
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_COLUMNS_AGG                                           //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_COLUMNS_AGG
  Label CRW_PROJECT_COLUMNS_AGG

  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_JMP_FALSE CRW_PROJECT_AGG

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMN
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_SRC
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_COLS_TO_LOCALS

  Label CRW_PROJECT_AGG

endMacro

macro AM_CRW_PROJECT_NONE
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_NONE                                                  //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_NONE
  Label CRW_PROJECT_NONE
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

endMacro

macro AM_CRW_PROJECT_STAR
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_STAR                                                  //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_STAR
  Label CRW_PROJECT_STAR
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_COLS_TO_ROW

  //EO_ROW_DST_PRINT
  EO_RETURN
endMacro

macro AM_CRW_PROJECT_END
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_END                                                   //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_END
  //EO_ROW_DST_PRINT
  EO_RETURN
endMacro

macro AM_CRW_FILTER_ROWS
//----------------------------------------------------------------------------//
// macro AM_CRW_FILTER_ROWS                                                   //
//----------------------------------------------------------------------------//
  // CRW_FILTER_ROWS
  Label CRW_FILTER_ROWS

  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_JMP_FALSE CRW_FILTER

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMN
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_SRC
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_COLS_TO_LOCALS

  Label CRW_FILTER
endMacro


//----------------------------------------------------------------------------//
// macro AM_CRW_FILTER_END                                                    //
//----------------------------------------------------------------------------//
macro AM_CRW_FILTER_END
  // CRW_FILTER_END
  EO_CALL CRW_PROJECT_STAR
  //EO_ROW_DST_PRINT
  EO_RETURN
endMacro

