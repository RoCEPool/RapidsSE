endMacro

macro AM_CRW_FILTER_BEGIN
//----------------------------------------------------------------------------//
// macro AM_CRW_FILTER_BEGIN                                                  //
//----------------------------------------------------------------------------//
  // CRW_FILTER_BEGIN
  Label CRW_FILTER_BEGIN

  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
