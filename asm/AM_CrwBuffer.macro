  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

  Label CRW_PROJECT_AGG

endMacro

macro AM_CRW_PROJECT_STAR
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_STAR                                                  //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_STAR
  Label CRW_PROJECT_STAR
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_ROW

  //EO_ROW_DST_PRINT
