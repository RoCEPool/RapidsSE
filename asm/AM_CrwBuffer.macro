endMacro

macro AM_CRW_HASHROWS_BEGIN
//----------------------------------------------------------------------------//
// macro AM_CRW_HASHROWS_BEGIN                                                //
//----------------------------------------------------------------------------//
  // CRW_HASHROWS_BEGIN
  Label CRW_HASHROWS_BEGIN

  // calc i_Ptn
  EO_PTN_RESET

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

endMacro


//----------------------------------------------------------------------------//
// macro AM_CRW_HASHROWS_END                                                  //
//----------------------------------------------------------------------------//
macro AM_CRW_HASHROWS_END
  // CRW_HASHROWS_END

  EO_PTN_RUNNING
  EO_PTN_CALC

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_ROW

  //EO_PUSH_DEVROW_DST
  //EO_DEVROW_ROW_PRINT
  EO_RETURN
endMacro

macro AM_CRW_INDEXJOIN_BEGIN
//----------------------------------------------------------------------------//
// macro AM_CRW_INDEXJOIN_BEGIN                                               //
//----------------------------------------------------------------------------//
  // CRW_INDEXJOIN_BEGIN
  Label CRW_INDEXJOIN_BEGIN

endMacro

macro AM_CRW_INDEXJOIN_NEXT
//----------------------------------------------------------------------------//
// macro AM_CRW_INDEXJOIN_NEXT                                                 //
//----------------------------------------------------------------------------//
  // CRW_INDEXJOIN_NEXT
  Label CRW_INDEXJOIN_NEXT

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_PUSH

  // reached upper bound ?
  EO_EQ_INTINT
  EO_RETURN_TRUE

  // deref index entry
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_DEREF

  EO_CALL <joinRowRoutine>  // C_TAG_JOINROW_ROUTINE

  // fetch next entry from index
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_IDX_NEXT
  EO_RETURN_FALSE

  // push upper bound entry
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_PUSHUPPER

  EO_JMP CRW_INDEXJOIN_NEXT
  EO_RETURN
endMacro

macro AM_CRW_INDEXJOIN_NEXT_LO
//----------------------------------------------------------------------------//
// macro AM_CRW_INDEXJOIN_NEXT_LO                                             //
//----------------------------------------------------------------------------//
  // CRW_INDEXJOIN_NEXT_LO
  Label CRW_INDEXJOIN_NEXT_LO

  // fetch next entry from index
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_IDX_NEXT

  EO_JMP_FALSE INDEXJOIN_NEXT_LO_RETURN

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_PUSH

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_PUSHUPPER

  EO_EQ_INTINT
  EO_JMP_TRUE INDEXJOIN_NEXT_LO_RETURN

  // projection
  //EO_CRW_SRC_DEREF
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_DEREF

  EO_CALL <joinRowRoutine>  // C_TAG_JOINROW_ROUTINE
  //EO_ROW_DST_PRINT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_ROWNO
  EO_RLU_SET_JOINMAP_BYTE

  EO_JMP CRW_INDEXJOIN_NEXT_LO

  Label INDEXJOIN_NEXT_LO_RETURN
  DeleteLabel INDEXJOIN_NEXT_LO_RETURN

  // Left outer rows
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_ROWNO
  EO_PUSH_RLU_JOINMAP_BYTE
  EO_RETURN_TRUE

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_ROWNO
  EO_CTR_0_POP
  EO_PRINTF "**CALLING JOINROWS_CRWLFT_NULRHT\n"
  EO_CALL JOINROWS_CRWLFT_NULRHT

  EO_RETURN

endMacro

