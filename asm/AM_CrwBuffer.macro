//----------------------------------------------------------------------------//
// macro AM_CRW_FILTER_END                                                    //
//----------------------------------------------------------------------------//
macro AM_CRW_FILTER_END
  // CRW_FILTER_END
  EO_RETURN_FALSE
  EO_CALL CRW_PROJECT_STAR
  //EO_ROW_DST_PRINT
  EO_RETURN
endMacro

macro AM_CRW_HASHROWS_BEGIN
//----------------------------------------------------------------------------//
// macro AM_CRW_HASHROWS_BEGIN                                                //
//----------------------------------------------------------------------------//
  // CRW_HASHROWS_BEGIN
  Label CRW_HASHROWS_BEGIN

  // calc i_Ptn
  EO_PTN_RESET

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

endMacro


//----------------------------------------------------------------------------//
// macro AM_CRW_HASHROWS_END                                                  //
//----------------------------------------------------------------------------//
macro AM_CRW_HASHROWS_END
  // CRW_HASHROWS_END

  EO_PTN_RUNNING
  EO_PTN_CALC

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_ROW

  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROW_PRINT
  EO_RETURN
endMacro

macro AM_CRW_INDEXJOIN_BEGIN
