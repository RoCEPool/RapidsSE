//----------------------------------------------------------------------------//
// macro AM_CRW_JOIN_ENT                                                      //
//----------------------------------------------------------------------------//
macro AM_CRW_JOIN_ENT
  // CRW_JOIN_ENT
  Label CRW_JOIN_ENT

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
