  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_INTEGER 0
  EO_DEVIXT_COLS_TO_ROW_OFS

  // deref the ent
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_ENT_DEREF

  // inflate right row into dst row
  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVROW_RHT
  EO_PUSH_DEVIXT_RHT
  EO_INTEGER <rowOffset>  // C_TAG_ROWOFFSET
  EO_DEVIXT_COLS_TO_ROW_OFS

  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROW_PRINT
  EO_RETURN

endMacro

