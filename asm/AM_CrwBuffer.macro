macro AM_CRW_PROJECT_STAR
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_STAR                                                  //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_STAR
  Label CRW_PROJECT_STAR
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  EO_PUSH_DEVROW_DST
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_ROW

  //EO_ROW_DST_PRINT
  EO_RETURN
endMacro

