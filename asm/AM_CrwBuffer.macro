  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

  Label CRW_FILTER
endMacro


//----------------------------------------------------------------------------//
// macro AM_CRW_FILTER_END                                                    //
//----------------------------------------------------------------------------//
macro AM_CRW_FILTER_END
  // CRW_FILTER_END
  EO_RETURN_FALSE
  EO_CALL <projectRoutine>
  //EO_ROW_DST_PRINT
