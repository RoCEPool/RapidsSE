/*============================================================================*/
/* AM_CrwBuffer.macro -- ASM Macros for CRWBUFFER Handler                     */
/*============================================================================*/

macro AM_HANDLER_CRWBUFFER
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER                                                 //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>   // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_HANDLER_CRWBUFFER_RHT
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER_RHT                                             //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER RHT HANDLER**\n"
  EO_POP

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_TEST
  EO_JMP_FALSE ROWLFT_CRWRHT

  EO_CALL JOIN_CRWLFT_CRWRHT
  EO_RETURN

  Label ROWLFT_CRWRHT
  EO_CALL JOIN_ROWLFT_CRWRHT
  EO_RETURN

endMacro

macro AM_JOIN_CRWLFT_CRWRHT
//----------------------------------------------------------------------------//
// macro AM_JOIN_CRWLFT_CRWRHT                                                //
//----------------------------------------------------------------------------//
  // JOIN_CRWLFT_CRWRHT
  Label JOIN_CRWLFT_CRWRHT
  EO_PRINTF "**AM_JOIN_CRWLFT_CRWRHT**\n"
  EO_POP

  // For each row in the left buffer
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_LFT
  Label CRWLFT_CRWRHT_NEXT_CRWLFT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_NEXT
  EO_JMP_FALSE QUERY_DONE

  EO_PRINTF "**CRWBUFFER HANDLER GOT LFT**\n"

  // left row
  EO_RLU_SET_ITEMS <projectItems>     // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

  // Now iterate each right buffer
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_CRWBUF_BEGIN

  // CRWLFT_CRWRHT_NEXT_CRW_RHT
  Label CRWLFT_CRWRHT_NEXT_CRW_RHT

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE CRWLFT_CRWRHT_NEXT_CRWLFT

  EO_PRINTF "**CRWBUFFER HANDLER GOT RHT**\n"

  EO_CALL <crwProcessRoutine>   // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP CRWLFT_CRWRHT_NEXT_CRW_RHT
  EO_JMP QUERY_DONE
endMacro

macro AM_JOIN_ROWLFT_CRWRHT
//----------------------------------------------------------------------------//
// macro AM_JOIN_ROWLFT_CRWRHT                                                //
//----------------------------------------------------------------------------//
  // JOIN_ROWLFT_CRWRHT
  Label JOIN_ROWLFT_CRWRHT
  EO_PRINTF "**AM_JOIN_ROWLFT_CRWRHT**\n"
  EO_POP

  // For each row in the left buffer
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_BEGIN

  // NEXT_ROW_LFT
  Label ROWLFT_CRWRHT_NEXT_ROWLFT

  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_NEXT
  EO_JMP_FALSE QUERY_DONE

  EO_PRINTF "**CRWBUFFER HANDLER GOT LFT**\n"

  // left row
  EO_RLU_SET_ITEMS <projectItems>     // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_COLS_TO_LOCALS

  // Now iterate each right buffer
  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_RHT
  Label ROWLFT_CRWRHT_NEXT_CRWRHT

  EO_PUSH_DEVIXT_RHT
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE ROWLFT_CRWRHT_NEXT_ROWLFT

  EO_PRINTF "**CRWBUFFER HANDLER GOT RHT**\n"

  EO_CALL <crwProcessRoutine>   // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP ROWLFT_CRWRHT_NEXT_CRWRHT
  EO_JMP QUERY_DONE
endMacro

macro AM_HANDLER_CRWBUFFER_AGG
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER_AGG                                             //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER_AGG
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP

  EO_PUSH_DEVROW_DST
  EO_DEVROW_ROW_TEST

  EO_JMP_TRUE HANDLER_CRWBUFFER_AGG_BEGIN

  // new a dst row
  //EO_ROW_DST_NEW
  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW
  EO_CALL ROWBUFFER_AGGINIT

  Label HANDLER_CRWBUFFER_AGG_BEGIN
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>    // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_HANDLER_CRWBUFFER_AGG_GBY
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER_AGG_GBY                                         //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER_AGG_GBY
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP

  Label HANDLER_CRWBUFFER_AGG_GBY_BEGIN
  //EO_CRW_SRC_BEGIN
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC
  //EO_CRW_SRC_NEXT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE
  EO_CALL <crwProcessRoutine>    // C_TAG_CRW_PROCESS_ROUTINE
  EO_CALL <payLoadRoutine>       // C_TAG_PAYLOAD_ROUTINE
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_HANDLER_CRWBUFFER_LIMIT
//----------------------------------------------------------------------------//
// macro AM_HANDLER_CRWBUFFER_LIMIT                                           //
//----------------------------------------------------------------------------//
  // HANDLER_CRWBUFFER
  Label HANDLER_CRWBUFFER
  EO_PRINTF "**CRWBUFFER HANDLER**\n"
  EO_POP
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_BEGIN

  // NEXT_CRW_SRC
  Label NEXT_CRW_SRC

  // push limit on stack
  EO_INTEGER <limitRows>     // C_TAG_LIMIT_ROWS
  //EO_DUMP

  // push the counter
  EO_CTR_0_PUSH
  //EO_DUMP

  // check if limit reached
  EO_LE_INTINT
  EO_JMP_TRUE QUERY_DONE

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_NEXT

  EO_JMP_FALSE QUERY_DONE

  // increment rows processed
  EO_CTR_0_INC

  EO_CALL <crwProcessRoutine>   // C_TAG_CRW_PROCESS_ROUTINE
  EO_JMP NEXT_CRW_SRC
  EO_JMP QUERY_DONE
endMacro

macro AM_CRW_PROJECT_COLUMNS
//----------------------------------------------------------------------------//
// macro AM_CRW_PROJECT_COLUMNS                                               //
//----------------------------------------------------------------------------//
  // CRW_PROJECT_COLUMNS
  Label CRW_PROJECT_COLUMNS

  EO_INTEGER <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_JMP_FALSE CRW_PROJECT

  EO_RLU_SET_ITEMS <projectItems>  // C_TAG_PROJECT_ITEMS
  EO_RLU_SET_COLUMNS <projectSrcColumns>  // C_TAG_PROJECT_SRC_COLUMNS
  EO_PUSH_RLU_LOCALS
  EO_PUSH_RLU_COLSET
  EO_PUSH_DEVROW_LFT
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_COLS_TO_LOCALS

  Label CRW_PROJECT

  EO_PUSH_DEVROW_DST
  EO_PUSH_RLU_POT
  EO_PUSH_RLU_PTN
  EO_DEVROW_ROW_NEW

  //EO_DUMP
endMacro

