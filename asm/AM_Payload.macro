  //  EO_PUSH_LOCALI 0
  //  EO_ADD
  //  EO_PAY_STORE_COLI 2
endMacro

macro AM_PAYLOAD_END
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_END                                                       //
//----------------------------------------------------------------------------//
 EO_IXT_DUMP
 EO_RETURN
endMacro

