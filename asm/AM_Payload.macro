/*============================================================================*/
/* AM_Payload.macro -- ASM Macros for PAYLOAD                                 */
/*============================================================================*/

macro AM_PAYLOAD_GBY
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_GBY                                                       //
//----------------------------------------------------------------------------//
  // AM_PAYLOAD_GBY
  Label PAYLOAD_GBY

  // reset entwrk
  EO_ENTWRK_RESET

  EO_CALL <payLoadKey>

  EO_ENT_FINDI
  EO_JMP_TRUE FOUND

  // find the key in the indexTree
  EO_ENT_POSPRIOR
  EO_JMP_FALSE NOT_FOUND

  EO_ENT_NEXT
  EO_JMP_FALSE NOT_FOUND

  EO_ENT_EQUAL
  EO_JMP_TRUE FOUND

  // NOT_FOUND:
  Label NOT_FOUND
  EO_CALL PAYLOAD_STORE
  EO_RETURN

  // FOUND:
  Label FOUND
  EO_CALL PAYLOAD_ADD

  EO_RETURN
endMacro

macro AM_PAYLOAD_KEY
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_KEY                                                       //
//----------------------------------------------------------------------------//
  // AM_PAYLOAD_KEY
  Label PAYLOAD_KEY
  //EO_PUSH_LOCALS <local>
