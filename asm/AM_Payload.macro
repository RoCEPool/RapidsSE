endMacro

macro AM_PAYLOAD_STORE
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_STORE                                                     //
//----------------------------------------------------------------------------//
  Label PAYLOAD_STORE
  EO_ENTWRK_CREATEPAY <payLoadBytes>
  EO_IXT_INS_ENT
  EO_PAY_ADDRESS
  // store L_RETURNFLAG -> Q100_RETURNFLAG
  //EO_PUSH_LOCALS 4
  //EO_PAY_STORE_COLS 0
endMacro

macro AM_PAYLOAD_ADD
//----------------------------------------------------------------------------//
// macro AM_PAYLOAD_ADD                                                       //
//----------------------------------------------------------------------------//
  Label PAYLOAD_ADD
  EO_PAY_ADDRESS
  //EO_SUPER_Q100 ???? OPTIMIZATION (ALKA: COME BACK TO THIS)
