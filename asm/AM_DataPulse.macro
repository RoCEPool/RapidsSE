/*============================================================================*/
/* AM_DataPulse.macro -- ASM Macros for DataPulse Marker                      */
/*============================================================================*/
macro AM_HANDLER_DATAPULSE
//----------------------------------------------------------------------------//
// macro HANDLER_DATAPULSE                                                    //
//----------------------------------------------------------------------------//
  // DATAPULSE HANDLER
  Label HANDLER_DATAPULSE
  EO_PRINTF "**HANDLER_DATAPULSE**\\n"
  EO_POP

  EO_CALL <dataPulseProcessRoutine>
  EO_JMP QUERY_DONE
endMacro

macro AM_INDEX_RANGE_LOWER_GE
//----------------------------------------------------------------------------//
// macro AM_INDEX_RANGE_LOWER_GE                                              //
//----------------------------------------------------------------------------//
  Label INDEX_RANGE_LOWER_GE
  <lboundType> <lboundLiteral>
  EO_DUMP
  EO_ENTWRK_SETINTELM
  EO_IXT_SRC_LBOUND

  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_ENT_PRINT

  EO_JMP_TRUE DATAPULSE_INDEXRANGE_UPD

  // no lower key start position at beginning of index
  EO_IXT_SRC_BEGIN

  // no entry return
  EO_JMP_FALSE DATAPULSE_INDEXRANGE_DONE

  Label DATAPULSE_INDEXRANGE_UPD
  EO_PUSH_ENTWRK
  EO_ENTWRK_RESET
  <uboundType> <uboundLiteral>
  EO_ENTWRK_SETINTELM
  EO_IXT_SRC_UBOUND_LT
  EO_JMP_TRUE DATAPULSE_INDEXRANGE_TILL_UBD

  // no upper key traverse till end
  Label DATAPULSE_INDEXRANGE_TILL_END
  EO_IXT_SRC_NEXT
  EO_JMP_FALSE DATAPULSE_INDEXRANGE_DONE

  Label DATAPULSE_INDEXRANGE_NEXT
  EO_IXT_SRC_NEXT

  EO_JMP_FALSE DATAPULSE_INDEXRANGE_DONE

  // traverse the index till we reach upper bound
  Label DATAPULSE_INDEXRANGE_TILL_UBD

  // fetch next entry from index
  EO_IXT_SRC_NEXT
  EO_JMP_FALSE DATAPULSE_INDEXRANGE_DONE

    // have we reached the upper entry
  EO_ENT_SRC_PUSH
  EO_ENT_SRC_PUSHUPPER
  EO_EQUAL
  EO_JMP_TRUE DATAPULSE_INDEXRANGE_DONE

  // projection
  //EO_CRW_SRC_DEREF
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_DEREF

  EO_CALL <crwProcessRoutine>

  EO_JMP DATAPULSE_INDEXRANGE_TILL_UBD

  Label DATAPULSE_INDEXRANGE_DONE
  EO_RETURN
endMacro

/*============================================================================*/
/* end                                                                        */
