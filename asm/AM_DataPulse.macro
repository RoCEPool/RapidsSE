/*============================================================================*/
/* AM_DataPulse.macro -- ASM Macros for DataPulse Marker                      */
/*============================================================================*/
macro AM_HANDLER_DATAPULSE
//----------------------------------------------------------------------------//
// macro HANDLER_DATAPULSE                                                    //
//----------------------------------------------------------------------------//
  // DATAPULSE HANDLER
  Label HANDLER_DATAPULSE
  EO_PRINTF "**HANDLER_DATAPULSE**\\n"
  EO_POP

  EO_CALL <dataPulseProcessRoutine>  // C_TAG_DATAPULSE_PROCESS_ROUTINE
  EO_JMP QUERY_DONE
endMacro

macro AM_INDEX_RANGE_LOWER_GE
//----------------------------------------------------------------------------//
// macro AM_INDEX_RANGE_LOWER_GE                                              //
//----------------------------------------------------------------------------//
  Label INDEX_RANGE_LOWER_GE
  <lboundType> <lboundLiteral>  // C_TAG_LBOUND_TYPE , C_TAG_LBOUND_LITERAL
  //EO_DUMP
  EO_PUSH_RLU_ENTWRK
  EO_ENTWRK_SETINTELM_OLD

  EO_PUSH_RLU_ENTWRK
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_LBOUND

  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_ENT_PRINT

  EO_JMP_TRUE DATAPULSE_INDEXRANGE_UPD

  // no lower key start position at beginning of index
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_IDX_BEGIN

  // no entry return
  EO_JMP_FALSE DATAPULSE_INDEXRANGE_DONE

  Label DATAPULSE_INDEXRANGE_UPD
  EO_PUSH_RLU_ENTWRK
  EO_ENTWRK_RESET
  <uboundType> <uboundLiteral>  // C_TAG_UBOUND_TYPE , C_TAG_UBOUND_LITERAL
  EO_PUSH_RLU_ENTWRK
  EO_ENTWRK_SETINTELM_OLD
  EO_PUSH_RLU_ENTWRK
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_UBOUND_LT
  EO_JMP_TRUE DATAPULSE_INDEXRANGE_TILL_UBD

  // no upper key traverse till end
  Label DATAPULSE_INDEXRANGE_TILL_END
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_IDX_NEXT
  EO_JMP_FALSE DATAPULSE_INDEXRANGE_DONE

  Label DATAPULSE_INDEXRANGE_NEXT
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_IDX_NEXT

  EO_JMP_FALSE DATAPULSE_INDEXRANGE_DONE

  // traverse the index till we reach upper bound
  Label DATAPULSE_INDEXRANGE_TILL_UBD

  // fetch next entry from index
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_IDX_NEXT
  EO_JMP_FALSE DATAPULSE_INDEXRANGE_DONE

    // have we reached the upper entry
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_ENT_PUSH

  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_ENT_PUSHUPPER

  EO_EQ_INTINT
  EO_JMP_TRUE DATAPULSE_INDEXRANGE_DONE

  // projection
  //EO_CRW_SRC_DEREF
  EO_PUSH_DEVIXT_SRC
  EO_DEVIXT_ENT_DEREF

  EO_CALL <crwProcessRoutine>  // C_TAG_CRW_PROCESS_ROUTINE

  EO_JMP DATAPULSE_INDEXRANGE_TILL_UBD

  Label DATAPULSE_INDEXRANGE_DONE
  EO_RETURN
endMacro

/*============================================================================*/
/* end                                                                        */
