/*============================================================================*/
/* AM_DataPulse.macro -- ASM Macros for DataPulse Marker                      */
/*============================================================================*/
macro AM_DATAPULSE_HANDLER
//----------------------------------------------------------------------------//
// macro DATAPULSE_HANDLER                                                    //
//----------------------------------------------------------------------------//
  // DATAPULSE HANDLER
  Label DATAPULSE_HANDLER
  EO_PRINTF "**DATAPULSE_HANDLER**\\n"
  EO_POP

  EO_CALL <dataPulseProcessRoutine>
  EO_JMP QUERY_DONE
endMacro

macro AM_INDEX_GE_INTEGER
//----------------------------------------------------------------------------//
// macro AM_INDEX_GE_INTEGER                                                  //
//----------------------------------------------------------------------------//
  Label INDEX_GE_INTEGER
  EO_INTEGER <literalValue>
  EO_ENTWRK_SETINTELM
  EO_IXT_SRC_LBOUND
  EO_IXT_SRC_PRINT

  EO_JMP_TRUE INDEX_GE_INTEGER_NEXT

  // no lower key start position at beginning of index
  EO_IXT_SRC_BEGIN

  // no entry return
  EO_JMP_FALSE INDEX_GE_INTEGER_DONE

  Label INDEX_GE_INTEGER_NEXT
  EO_IXT_SRC_NEXT

  EO_JMP_FALSE INDEX_GE_INTEGER_DONE

  // projection
  EO_CRW_SRC_DEREF
  EO_CALL <crwProjectRoutine>

  EO_JMP INDEX_GE_INTEGER_NEXT

  Label INDEX_GE_INTEGER_DONE
  EO_RETURN
endMacro

macro AM_INDEX_RANGE_ROUTINE
//----------------------------------------------------------------------------//
// macro AM_INDEX_GE_LT_INTEGER                                               //
//----------------------------------------------------------------------------//
  Label INDEX_RANGE_ROUTINE
  EO_INTEGER <lboundValue>
  EO_ENTWRK_SETINTELM
  EO_IXT_SRC_LBOUND
  EO_IXT_SRC_PRINT

  EO_JMP_TRUE INDEX_GE_LT_INTEGER_UPD

  // no lower key start position at beginning of index
  EO_IXT_SRC_BEGIN

  // no entry return
  EO_JMP_FALSE INDEX_GE_LT_INTEGER_DONE

  Label INDEX_GE_LT_INTEGER_UPD
  EO_ENTWRK_RESET
  EO_INTEGER <uboundValue>
  EO_ENTWRK_SETINTELM
  EO_IXT_SRC_UBOUND_LT
  EO_JMP_TRUE TRV_TILL_UPPER

  // no upper key traverse till end
  Label TRV_TILL_END
  EO_IXT_SRC_NEXT
  EO_JMP_FALSE INDEX_GE_LT_INTEGER_DONE

  Label INDEX_GE_LT_INTEGER_NEXT
  EO_IXT_SRC_NEXT

  EO_JMP_FALSE INDEX_GE_LT_INTEGER_DONE

  // traverse the index till we reach upper bound
  Label TRV_TILL_UPPER

  // fetch next entry from index
  EO_IXT_SRC_NEXT
  EO_JMP_FALSE INDEX_GE_LT_INTEGER_DONE

    // have we reached the upper entry
  EO_ENT_SRC_PUSH
  EO_ENT_SRC_PUSHUPPER
  EO_EQUAL
  EO_JMP_TRUE INDEX_GE_LT_INTEGER_DONE


  // projection
  EO_CRW_SRC_DEREF
  EO_CALL <crwProjectRoutine>

  EO_JMP TRV_TILL_UPPER

  Label INDEX_GE_LT_INTEGER_DONE
  EO_RETURN
endMacro

macro AM_TABLE_SCAN
//----------------------------------------------------------------------------//
// macro AM_TABLE_SCAN                                                        //
//----------------------------------------------------------------------------//
  Label TABLE_SCAN
  EO_TABLEPTN_GRABREAD
  EO_REG_PTNSTREAM_NEW
  EO_REG_PTNSTREAM_OPEN

  EO_HANDLER <logicUnitHandler>
  EO_CALLAGAIN

  EO_RETURN
endMacro

