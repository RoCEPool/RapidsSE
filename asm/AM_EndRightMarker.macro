/*============================================================================*/
/* AM_EndRightMarker.macro -- ASM EndRightMarker Handler Macros               */
/*============================================================================*/

macro AM_HANDLER_ENDCRW_RHTMARKER
//----------------------------------------------------------------------------//
// macro AM_HANDLER_ENDCRW_RHTMARKER                                          //
//----------------------------------------------------------------------------//
  // HANDLER_ENDCRW_RHTMARKER
  Label HANDLER_ENDCRW_RHTMARKER
  EO_PRINTF "**HANDLER_ENDCRW_RHTMARKER**\n"

  EO_PUSH_0
  EO_CTR_0_POP

  Label HANDLER_ENDCRW_RHTMARKER_BEGIN

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_TEST
  EO_JMP_FALSE ROWLFT_ROWCNT

  // push no of rows in the left buffer
  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_ROWCNT
  EO_JMP CHECK_ROWCNT

  Label ROWLFT_ROWCNT
  EO_PUSH_DEVROW_LFT
  EO_DEVROW_ROWBUF_ROWCNT

  Label CHECK_ROWCNT
  EO_CTR_0_PUSH
  EO_LE_INTINT
  EO_JMP_TRUE HANDLER_ENDCRW_RHTMARKER_END

  EO_CTR_0_PUSH
  EO_PUSH_RLU_JOINMAP_BYTE
  EO_JMP_TRUE HANDLER_ENDCRW_RHTMARKER_NEXT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_TEST
  EO_JMP_FALSE ROWLFT_NULRHT

  EO_PRINTF "**CALLING JOINROWS_CRWLFT_NULRHT\n"
  EO_CALL JOINROWS_CRWLFT_NULRHT
  EO_JMP HANDLER_ENDCRW_RHTMARKER_NEXT

  Label ROWLFT_NULRHT
  EO_PRINTF "**CALLING JOINROWS_ROWLFT_NULRHT\n"
  EO_CALL JOINROWS_ROWLFT_NULRHT

  Label HANDLER_ENDCRW_RHTMARKER_NEXT
  EO_CTR_0_INC
  EO_JMP HANDLER_ENDCRW_RHTMARKER_BEGIN

  Label HANDLER_ENDCRW_RHTMARKER_END
  EO_RLU_RESET_JOINMAP

  EO_RETURN
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
