/*============================================================================*/
/* AM_EndRightMarker.macro -- ASM EndRightMarker Handler Macros               */
/*============================================================================*/

macro HANDLER_ENDRIGHTMARKER
//----------------------------------------------------------------------------//
// macro HANDLER_ENDRIGHTMARKER                                               //
//----------------------------------------------------------------------------//
  // HANDLER_ENDRIGHTMARKER
  Label HANDLER_ENDRWRIGHTMARKER

  // push no of rows to in the left buffer
  EO_PUSH_RLU_JOINMAP_CNT
  EO_CTR_0_PUSH

  EO_LE_INTINT
  EO_JMP_TRUE HANDLER_ENDRIGHTMARKER_DONE

  EO_CTR_0_PUSH
  EO_PUSH_RLU_JOINMAP_BYTE
  EO_JMP_FALSE HANDLER_ENDRIGHTMARKER_NEXT

  EO_PUSH_DEVIXT_LFT
  EO_DEVIXT_CRWBUF_TEST
  EO_JMP_FALSE ROWLFT_NULRHT

  EO_JOINROWS_CRWLFT_NULRHT
  EO_JMP HANDLER_ENDRIGHTMARKER_NEXT

  Label ROWLFT_NULRHT
  EO_JOINROWS_ROWLFT_NULRHT

  Label HANDLER_ENDRIGHTMARKER_NEXT
  EO_CTR_0_INC
  EO_JMP HANDLER_ENDRIGHTMARKER

  Label HANDLER_ENDRIGHTMARKER_DONE
  EO_RETURN
endMacro

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
