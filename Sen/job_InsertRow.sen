/*============================================================================*/
/* job_InsertRow.sen -- Job Insert Row                                        */
/*============================================================================*/

" job_InsertRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request to insert a row (on originating node)                              */
/*----------------------------------------------------------------------------*/
: insertRow_req ( -- <R> )

  >>logEntry <SEED_REQ>

  0 0 locals| pJob_InsertRow pTask |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_InsertRow

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table name
  //pJob_InsertRow job.objectName@ locals| sTableNm |
  <tableNm> locals| sTableNm |

  // push table dictionary
  //pJob_InsertRow job.pushPath task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - --
  // path checks

  // set task's dictionary stack from path in job
  //pJob_InsertRow job.pushPath task::dicStack.set

  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_InsertRow <ERROR_JOB> !!logError <DONE_REQ> then

  // push table dictionary
  sTableNm pushTable assert

  // check it is a table
  sTableNm checkIsTable not if popTable pJob_InsertRow <ERROR_JOB> !!logError <DONE_REQ> then

  // use table name find and set target table
  sTableNm find execute locals| pTable |

  popTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // new a writeRow job
  pTable pJob_InsertRow job_insertRow.NewJobWriteRow locals| pJob_WriteRow |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // encode the row
  pJob_InsertRow pJob_WriteRow job_writeRow.encodeRow locals| bResult |

  bResult not if EC_INVALID_VALUE pJob_InsertRow <ERROR_JOB> !!logError <DONE_REQ> then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn the writeRow job for the node to which the row hashes to
  pJob_WriteRow pJob_InsertRow Job_InsertRow.spawnJobWriteRow

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob_InsertRow job.distribute

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* insert row (executed on all nodes)                                         */
/*----------------------------------------------------------------------------*/
: insertRow_exe ( pJob_InsertRow -- )

  >>logEntry <SEED_EXE>

  //params| pJob_Space |
  job::this locals| pJob_InsertRow |

  CN_JOB_INSERTROW pJob_InsertRow object.assertClass

  // get table name
  //pJob_InsertRow job.objectName@ locals| sTableNm |
  <tableNm> locals| sTableNm |

  // null the record in the insertJob
  // as its not a valid pointer (and is not needed) in the distributed jobs
  nullptr pJob_InsertRow job_insertRow.record!

  // if job being inserted on this node then wait
  pJob_InsertRow job_insertRow.partition@ locals| iPartition |

  // wait if the row being inserted on this partition
  // writeRow will notify it
  iPartition Grid::toNode Grid::thisNode@ == if
    //task::this iPartition "waiting for ack %v %v" str.format .
    task::this task.grabLock
    1 task::acks!
    task::wait
  then

  pJob_InsertRow job.notice

  pJob_InsertRow job::participantExecuted

  <<logExit <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_InsertRow job check resources                                  */
/*----------------------------------------------------------------------------*/
: insertRow.checkResources ( pJob_InsertRow -- )

  >>logEntry <Check_Resources>

  params| pJob_InsertRow  |

  //pJob_InsertRow job.objectName@ locals| sTableNm |
  <tableNm> locals| sTableNm |

  //checkResources received" .

  //----------------------------------------------------------------------------
  // grab a ddl lock
  DdlLock[].grabRead

  //----------------------------------------------------------------------------
  // path checks

  // set task's dictionary stack from path in job
  //pJob_InsertRow job.pushPath task::dicStack.set
  //pathDump

  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_InsertRow <ERROR_JOB> !!logError exit then
  //sTableNm "In table folder: %v" .printf

  // push table dictionary
  sTableNm pushTable assert
  //pathDump

  // check it is a table
  sTableNm checkIsTable not if popTable pJob_InsertRow <ERROR_JOB> !!logError exit then

  // pop table dictionary
  popTable
  //pathDump

  //----------------------------------------------------------------------------
  // check if we have enough buffers

  node::checkEnoughBuffers not if pJob_InsertRow <ERROR_JOB> !!logError exit then

  <<logExit <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_LoadTable job release resources                                */
/*----------------------------------------------------------------------------*/
: insertRow.releaseResources ( pJob_InsertRow -- )

  >>logEntry <Release_Resources>

  params| pJob_InsertRow  |

  //releaseResources received" .

  <<logExit <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: insertRow_beg ( -- )

  >>logEntry <SEED_BEG>

  job::this locals| pJob_InsertRow |

  pJob_InsertRow job.becomeParticipant

  // check resources
  pJob_InsertRow insertRow.checkResources

  job::participantBegun

  <<logExit <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: insertRow_end ( -- )

  >>logEntry <SEED_END>

  job::this locals| pJob_InsertRow |

  ">> insertRow_end <<" .verbose

  // release resources
  pJob_InsertRow insertRow.releaseResources

  job::participantEnded

  <<logExit <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: insertRow_can ( -- )

  >>logEntry <SEED_CAN>

  ">> insertRow_can <<" .verbose

  job::participantCancelled

  <<logExit <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/


