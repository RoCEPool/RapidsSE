/*============================================================================*/
/* vocab_dic.sen -- dictionary related words                                */
/*============================================================================*/

" vocab_dic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* folder is used as a kind of word to identify folders                       */
/*----------------------------------------------------------------------------*/
: folder ;

: isFolder word.category@ tick folder eql ;

/*----------------------------------------------------------------------------*/
/* create the tenant dictionary using name from input(doesnt leave dic on stk)*/
/*----------------------------------------------------------------------------*/
: dicTenants:

diclock.grabwrite

  createTenants
  WK_OBJECT compiler::current word.kind!
  sizeof_dic allot

  compiler::current word.embObject object.magic!
  CN_DIC compiler::current word.embObject object.class!
  true compiler::current word.embObject object.wordbody!

  compiler::current word.embObject dic.init

  tick folder compiler::current word.category!

  //compiler::current word.name@ "  dic: %v" str.format .

diclock.dropwrite
  does>
;


/*----------------------------------------------------------------------------*/
/* create a dictionary using name from input stream (doesnt leave dic on stk) */
/*----------------------------------------------------------------------------*/
: dic:

diclock.grabwrite

  create
  WK_OBJECT compiler::current word.kind!
  sizeof_dic allot

  compiler::current word.embObject object.magic!
  CN_DIC compiler::current word.embObject object.class!
  true compiler::current word.embObject object.wordbody!

  compiler::current word.embObject dic.init

  tick folder compiler::current word.category!

  //compiler::current word.name@ "  dic: %v" str.format .

diclock.dropwrite
  does>
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: dicPersistent:

diclock.grabwrite

  createPersistent
  WK_OBJECT compiler::current word.kind!
  sizeof_dic allot

  compiler::current word.embObject object.magic!
  CN_DIC compiler::current word.embObject object.class!
  true compiler::current word.embObject object.wordbody!

  compiler::current word.embObject dic.init

  tick folder compiler::current word.category!

  //compiler::current word.name@ "  dic: %v" str.format .

diclock.dropwrite

  does>
;

/*----------------------------------------------------------------------------*/
/* create a dictionary using name on the stack (leaves dic on stack)          */
/*----------------------------------------------------------------------------*/
: :dic

diclock.grabwrite

  :create
  WK_OBJECT compiler::current word.kind!
  sizeof_dic allot

  compiler::current word.embObject object.magic!
  CN_DIC compiler::current word.embObject object.class!
  true compiler::current word.embObject object.wordbody!

  compiler::current word.embObject dic.init

  tick folder compiler::current word.category!

  compiler::current

  //compiler::current word.name@ "  :dic %v" str.format .

diclock.dropwrite
  does>
;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: :dicPersistent

diclock.grabwrite

  >createPersistent
  WK_OBJECT compiler::current word.kind!
  sizeof_dic allot

  compiler::current word.embObject object.magic!
  CN_DIC compiler::current word.embObject object.class!
  true compiler::current word.embObject object.wordbody!

  tick folder compiler::current word.category!
  compiler::current word.embObject dic.init

  compiler::current

  //compiler::current word.name@ "  :dic %v" str.format .

diclock.dropwrite
  does>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: checkIsDic ( word )

  params| pWord |

  pWord not if EC_NO_SUCH_FOLDER false exit_rt then
  pWord word.category@ tick folder eql if true exit_rt then
  EC_NOT_A_FOLDER false
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: dicHasRef ( word )

  dup execute dic.ref
;

/*----------------------------------------------------------------------------*/
/* check dic not in use                                                       */
/*----------------------------------------------------------------------------*/
: checkNotUsed ( dic -- true | error false )

  //dicHasRef " dic ref " .put .put .\n

  dicHasRef if EC_FOLDER_IN_USE false exit_rt then

  true
;

/*----------------------------------------------------------------------------*/
/* check dic is empty                                                         */
/*----------------------------------------------------------------------------*/
: checkIsEmpty ( dic -- true | error false )

  dup execute dic.wordCount if EC_FOLDER_NOT_EMPTY false exit_rt then

  true
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
