/*============================================================================*/
/* OP_readChunk.sen -- Operator readChunk                                     */
/*============================================================================*/

" OP_readChunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_INFOSET ...                                                          */
/*----------------------------------------------------------------------------*/
: readChunk_InfoSet \handler

  Operand[].get to InfoSet[]
  nullptr to Operand[]
  InfoSet[].firstRow to row[]
  begin
    row[].isNull
  not while
    row[].get InfoSet[].readChunk to Operand[]
    Operand[].pipeout
    InfoSet[].nextRow to row[]
  repeat

  InfoSet[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: readChunk_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for reading
  file::new to File0[]
  <fileNm> OPEN_READ File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 nullptr File0[].set EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  then
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STOPMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: readChunk_StopMarker \handler

  //"Operand:- ZK_STOPMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* execute for reachChunk req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : readChunk_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: readChunk_InfoSet     ZK_INFOSET     op[].handler!
  find: readChunk_StartMarker ZK_STARTMARKER op[].handler!
  find: readChunk_StopMarker  ZK_STOPMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: readChunk :: readChunk <fileNm> ;

: readChunk opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
