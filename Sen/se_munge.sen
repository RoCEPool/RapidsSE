/*============================================================================*/
/* se_munge.sen -- create the .cpp from .sen                                  */
/*============================================================================*/

"-se_munge.sen" .verbose

/*----------------------------------------------------------------------------*/
/* write the .cpp header portion of the file                                  */
/*----------------------------------------------------------------------------*/
: mungeCppHeader ( cppFile -- )

  params| cppFile |

  "/*============================================================================*/"
  cppFile file.write "\n" cppFile file.write

  "/* MungedSen.cpp - munged sen files                                           */"
  cppFile file.write "\n" cppFile file.write

  "/*============================================================================*/"
  cppFile file.write "\n" cppFile file.write

  "#include \"StorageEngine.h\"\n" cppFile file.write
  "\n" cppFile file.write
  "void Task::vAddMunged(MP_Task mpTask)\n" cppFile file.write
  "{\n" cppFile file.write
  "  s48K sDefinition;\n" cppFile file.write
;

/*----------------------------------------------------------------------------*/
/* put the variable for the sen file into c++ file                            */
/*----------------------------------------------------------------------------*/
: mungeCppVariable ( cppFile senFile -- )

  params| senFile cppFile |

  "\n" cppFile file.write

  "  // munge of " cppFile file.write
    senFile file.path@ cppFile file.write
    "\n" cppFile file.write

  "  sDefinition =\n" cppFile file.write

;

/*----------------------------------------------------------------------------*/
/* put the variable initialise into c++ file                                  */
/*----------------------------------------------------------------------------*/
: mungeSenText ( cppFile senFile -- )

  params| senFile cppFile |

  "" locals| senLine |

  "    \"\\\"\"\n"   cppFile file.write

  "    \"\\\\\\\"munged " cppFile file.write
  senFile file.path@ cppFile file.write
  " \\\\\\\" .verbose \\n\"\n" cppFile file.write    // change this to verbose

  begin senFile file.read while

    str.escape str.escape to senLine

    senLine ";" str.equal if
      " ;" to senLine
    then

    "    \""  cppFile file.write
    senLine   cppFile file.write
    "\\n\""   cppFile file.write
    "\n"      cppFile file.write

  repeat

  "    \"\\\"\"\n"   cppFile file.write
;

/*----------------------------------------------------------------------------*/
/* put the variable for the sen file into c++ file                            */
/*----------------------------------------------------------------------------*/
: mungeSenConstant ( cppFile senFile -- )

  params| senFile cppFile |

  "  \" CONSTANT " cppFile file.write
  senFile file.path@ cppFile file.write
  "\"_Stz\n" cppFile file.write
;

/*----------------------------------------------------------------------------*/
/* put a ; terminator for statement into c++ file                             */
/*----------------------------------------------------------------------------*/
: mungeCppTerm ( cppFile senFile -- )

  params| senFile cppFile |

  "  ;\n" cppFile file.write

  "\n" cppFile file.write

  "  vCompileConstant(sDefinition);\n" cppFile file.write

;

/*----------------------------------------------------------------------------*/
/* write the .cpp footer portion of the file                                  */
/*----------------------------------------------------------------------------*/
: mungeCppFooter ( cppFile -- )

  params| cppFile |

  "}\n" cppFile file.write
  "\n" cppFile file.write

  "/*============================================================================*/"
  cppFile file.write
  "\n" cppFile file.write

  "/* end                                                                        */"
  cppFile file.write
  "\n" cppFile file.write

  "/*============================================================================*/"
  cppFile file.write
  "\n" cppFile file.write
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* produce a c++ statement for the sen file                                   */
/*----------------------------------------------------------------------------*/
: mungeCppStatement ( cppFile senFile -- )

  params| senFile cppFile |

  cppFile senFile mungeCppVariable

  cppFile senFile mungeSenText

  cppFile senFile mungeSenConstant

  cppFile senFile mungeCppTerm
;

/*----------------------------------------------------------------------------*/
/* munge one .sen file                                                        */
/*----------------------------------------------------------------------------*/
: mungeSenFile ( "<fileNm"> cppFile -- )

  file::new locals| senFile cppFile |

  senFile file.path!

  OPEN_READ senFile file.open assert

  cppFile senFile mungeCppStatement

  // close and delete the file accessor
  senFile file.close
  senFile file.delete
;

/*----------------------------------------------------------------------------*/
/* munge all .sen files in the sen dir                                        */
/*----------------------------------------------------------------------------*/
: mungeDir ( cppFile senDir -- )

  params| senDir cppFile |

  // read thru directory
  begin senDir dir.read while

    // ignore entries which aren't regular files
    senDir dir.entryType DE_REG == not continue

    // ignore entries which aren't .sen files
    4 senDir dir.entryName str.right ".sen" str.equal not continue
    senDir dir.entryName .

    // convert to C++
    senDir dir.entryName cppFile mungeSenFile

  repeat
;

/*----------------------------------------------------------------------------*/
/* munge all .sen files                                                       */
/*----------------------------------------------------------------------------*/
: munge

  // create a directory accessor
  file::new dir::new "" locals| origDir senDir cppFile |

  // save original dir and change to ../Sen
  dir.getCurrent to OrigDir

  "../Sen" dir.changeCurrent
  dir.getCurrent "Current working directory now: %v" str.format .

  // set path in the sen directory accessor
  "." senDir dir.path!

  // open sen directory
  senDir dir.open assert

  // open cpp file
  "../Munge/Task_AddMunged.cpp" cppFile file.path!
  OPEN_WRITE cppFile file.open assert

  cppFile mungeCppHeader

  // munge the command dir
  cppFile senDir mungeDir

  cppFile mungeCppFooter

  // close and delete file accessor
  cppFile file.close
  cppFile file.delete

  // close and delete directory accessor
  senDir dir.close
  senDir dir.delete

  // change back to original dir
  origDir dir.changeCurrent
  dir.getCurrent "Current working directory now: %v" str.format .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
