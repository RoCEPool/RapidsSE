/*============================================================================*/
/* se_munge.sen -- create the .cpp file from all .sen files                   */
/*============================================================================*/

"-se_munge.sen" .verbose

/*----------------------------------------------------------------------------*/
/* write the .cpp header portion of the file                                  */
/*----------------------------------------------------------------------------*/
: munge_WriteCppHeader ( pCppFile -- )

  params| pCppFile |

  "/*============================================================================*/"
  pCppFile file.write "\n" pCppFile file.write

  "/* MungedSen.cpp - munged sen files                                           */"
  pCppFile file.write "\n" pCppFile file.write

  "/*============================================================================*/"
  pCppFile file.write "\n" pCppFile file.write

  "#include \"StorageEngine.h\"\n" pCppFile file.write
  "\n" pCppFile file.write
  "void Task::vAddMunged(MP_Task mpTask)\n" pCppFile file.write
  "{\n" pCppFile file.write
  "  s48K sDefinition;\n" pCppFile file.write
;

/*----------------------------------------------------------------------------*/
/* put the variable for the sen file into c++ file                            */
/*----------------------------------------------------------------------------*/
: munge_WriteCppVariable ( pCppFile pSenFile -- )

  params| pSenFile pCppFile |

  "\n" pCppFile file.write

  "  // munge of " pCppFile file.write
    pSenFile file.path@ pCppFile file.write
    "\n" pCppFile file.write

  "  sDefinition =\n" pCppFile file.write
;

/*----------------------------------------------------------------------------*/
/* put the variable initialise into c++ file                                  */
/*----------------------------------------------------------------------------*/
: munge_WriteSenText ( pCppFile pSenFile -- )

  params| pSenFile pCppFile |

  "" locals| senLine |

  "    \"\\\"\"\n"   pCppFile file.write

  "    \"\\\\\\\"munged " pCppFile file.write
  pSenFile file.path@ pCppFile file.write
  " \\\\\\\" .verbose \\n\"\n" pCppFile file.write    // change this to verbose

  begin pSenFile file.read while

    str.escape str.escape to senLine

    senLine ";" str.equal if
      " ;" to senLine
    then

    "    \""  pCppFile file.write
    senLine   pCppFile file.write
    "\\n\""   pCppFile file.write
    "\n"      pCppFile file.write

  repeat

  "    \"\\\"\"\n"   pCppFile file.write
;

/*----------------------------------------------------------------------------*/
/* put the variable for the sen file into c++ file                            */
/*----------------------------------------------------------------------------*/
: munge_WriteSenConstant ( pCppFile pSenFile -- )

  params| pSenFile pCppFile |

  "  \" CONSTANT " pCppFile file.write
  pSenFile file.path@ pCppFile file.write
  "\"_Stz\n" pCppFile file.write
;

/*----------------------------------------------------------------------------*/
/* put a ; terminator for statement into c++ file                             */
/*----------------------------------------------------------------------------*/
: munge_WriteCppTerm ( pCppFile pSenFile -- )

  params| pSenFile pCppFile |

  "  ;\n" pCppFile file.write

  "\n" pCppFile file.write

  "  vCompileConstant(sDefinition);\n" pCppFile file.write
;

/*----------------------------------------------------------------------------*/
/* write the .cpp footer portion of the file                                  */
/*----------------------------------------------------------------------------*/
: munge_WriteCppFooter ( pCppFile -- )

  params| pCppFile |

  "}\n" pCppFile file.write
  "\n" pCppFile file.write

  "/*============================================================================*/"
  pCppFile file.write
  "\n" pCppFile file.write

  "/* end                                                                        */"
  pCppFile file.write
  "\n" pCppFile file.write

  "/*============================================================================*/"
  pCppFile file.write
  "\n" pCppFile file.write
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* produce a c++ statement for the sen file                                   */
/*----------------------------------------------------------------------------*/
: munge_ProduceCppStatement ( pCppFile pSenFile -- )

  params| pSenFile pCppFile |

  pCppFile pSenFile munge_WriteCppVariable

  pCppFile pSenFile munge_WriteSenText

  pCppFile pSenFile munge_WriteSenConstant

  pCppFile pSenFile munge_WriteCppTerm
;

/*----------------------------------------------------------------------------*/
/* munge one .sen file                                                        */
/*----------------------------------------------------------------------------*/
: munge_ProcessSenFile ( pCppFile sSenFileNm -- )

  params| sSenFileNm pCppFile |

  file::new locals| pSenFile |

  sSenFileNm OPEN_READ pSenFile file.open assert

  pCppFile pSenFile munge_ProduceCppStatement

  // close and delete the file accessor
  pSenFile file.close
  pSenFile file.delete
;

/*----------------------------------------------------------------------------*/
/* munge all .sen files in the sen dir                                        */
/*----------------------------------------------------------------------------*/
: munge_ProcessDir ( pCppFile pSenDir -- )

  params| pSenDir pCppFile |

  // read thru directory
  begin pSenDir dir.read while

    // ignore entries which aren't regular files
    pSenDir dir.entryType DE_REG == not continue

    // ignore entries which aren't .sen files
    4 pSenDir dir.entryName str.right ".sen" str.equal not continue
    pSenDir dir.entryName .

    // convert to C++
    pCppFile pSenDir dir.entryName munge_ProcessSenFile

  repeat
;

/*----------------------------------------------------------------------------*/
/* munge all .sen files                                                       */
/*----------------------------------------------------------------------------*/
: munge prompt

  // create a directory accessor
  file::new dir::new "" locals| origDir pSenDir pCppFile |

  // save original dir and change to ../Sen
  dir::getCurrent to OrigDir

  "../Sen" dir::changeCurrent
  dir::getCurrent "Current working directory now: %v" str.format .

  // open sen directory
  "." pSenDir dir.open assert

  // open cpp file
  "../Munge/Task_AddMunged.cpp" OPEN_WRITE pCppFile file.open assert

  pCppFile munge_WriteCppHeader

  // munge the command dir
  pCppFile pSenDir munge_ProcessDir

  pCppFile munge_WriteCppFooter

  // close and delete file accessor
  pCppFile file.close
  pCppFile file.delete

  // close and delete directory accessor
  pSenDir dir.close
  pSenDir dir.delete

  // change back to original dir
  origDir dir::changeCurrent
  dir::getCurrent "Current working directory now: %v" str.format .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
