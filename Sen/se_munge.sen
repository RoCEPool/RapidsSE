/*============================================================================*/
/* se_munge.sen -- create the .cpp file from all .sen files                   */
/*============================================================================*/

"-se_munge.sen" .verbose

/*----------------------------------------------------------------------------*/
/* put the variable for the sen file into c++ file                            */
/*----------------------------------------------------------------------------*/
: munge_WriteDivider params| pSenFile pCppFile i_File |

  pSenFile file.path@ locals| sFileNm |

  "\n"
  pCppFile file.writeLine
  "  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n"
  pCppFile file.writeLine

  sFileNm i_File "  // munge of [%v] %v\n" str.format
  pCppFile file.writeLine
;

/*----------------------------------------------------------------------------*/
/* put the variable initialise into c++ file                                  */
/*----------------------------------------------------------------------------*/
: munge_WriteSenText params| pSenFile pCppFile i_File |

  pSenFile file.path@ locals| sFileNm |

  "\n"
  pCppFile file.writeLine
  "  sFileContents =\n"
  pCppFile file.writeLine

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "    \"\\\"\"\n" pCppFile file.writeLine

  "    \"\\\\\\\"munged " pCppFile file.writeLine
  sFileNm pCppFile file.writeLine

  " \\\\\\\" .verbose \\n\"\n" pCppFile file.writeLine

  "" locals| sSenLine |
  begin pSenFile file.readLine while

    str.escape str.escape to sSenLine

    sSenLine ";" str.same if
      " ;" to sSenLine
    then

    "    \""  pCppFile file.writeLine
    sSenLine  pCppFile file.writeLine
    "\\n\""   pCppFile file.writeLine
    "\n"      pCppFile file.writeLine

  repeat

  "    \"\\\"\"\n" pCppFile file.writeLine

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  sFileNm "  \" CONSTANT %v \"_Stz\n" str.format pCppFile file.writeLine
  "  ;\n"
  pCppFile file.writeLine

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "\n"
  pCppFile file.writeLine
  "  vCompileMungedColon(sFileContents);\n"
  pCppFile file.writeLine
;
/*----------------------------------------------------------------------------*/
: munge_WriteSenText_v2 params| pSenFile pCppFile i_File |

  pSenFile file.path@ locals| sFileNm |

  "\n"
  pCppFile file.writeLine
  i_File "  gszaMungedText[%v] =\n" str.format
  pCppFile file.writeLine

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //"    \"\\\"\"\n" pCppFile file.writeLine

  sFileNm "    \"\\\" munged %v \\\" .verbose \\n\"\n" str.format
  pCppFile file.writeLine

  "" locals| sSenLine |
  begin pSenFile file.readLine while

    //str.escape
    str.escape to sSenLine

    sSenLine ";" str.same if
      " ;" to sSenLine
    then

    "    \""  pCppFile file.writeLine
    sSenLine  pCppFile file.writeLine
    "\\n\""   pCppFile file.writeLine
    "\n"      pCppFile file.writeLine

  repeat

  "    \"\\n\"\n"
  pCppFile file.writeLine

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

//  sFileNm "  \" CONSTANT %v \"_Stz\n" str.format
//  pCppFile file.writeLine
  "    \"\"_Stz\n" str.format
  pCppFile file.writeLine

  "  ;\n"
  pCppFile file.writeLine

//  "\n"
//  pCppFile file.writeLine
//  i_File "  vCompileMungedColon((i8)%v);\n" str.format
//  pCppFile file.writeLine

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "\n"
  pCppFile file.writeLine
  "  szSubScriptDef ="
  pCppFile file.writeLine

  sFileNm i_File " \" %v CONSTANT %v \"_Stz;\n" str.format
  pCppFile file.writeLine

  "  vCompileMungedColon(szSubScriptDef);\n" str.format
  pCppFile file.writeLine
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* produce a c++ statement for the sen file                                   */
/*----------------------------------------------------------------------------*/
: munge_ProduceCppStatement params| pSenFile pCppFile i_File |

  i_File pCppFile pSenFile munge_WriteDivider

  i_File pCppFile pSenFile munge_WriteSenText_v2
;

/*----------------------------------------------------------------------------*/
/* munge one .sen file                                                        */
/*----------------------------------------------------------------------------*/
: munge_ProcessSenFile params| sSenFileNm pCppFile i_File |

  sSenFileNm file::size locals| nBytes |
  nBytes sSenFileNm i_File "[%v] %v %v bytes" .printf

  file::new locals| pSenFile |

  sSenFileNm OPEN_READ pSenFile file.open assert

  i_File pCppFile pSenFile munge_ProduceCppStatement

  pSenFile file.close
  pSenFile file.delete
;

/*----------------------------------------------------------------------------*/
/* munge all .sen files in the sen dir                                        */
/*----------------------------------------------------------------------------*/
: munge_ProcessDir params| pSenDir pCppFile |

 0 locals| i_File |

  // read thru directory
  begin pSenDir dir.read while

    // ignore entries which aren't regular files
    pSenDir dir.entryType DE_REG == not continue

    // ignore entries which aren't .sen files
    4 pSenDir dir.entryName str.right ".sen" str.same not continue

    // convert to C++
    i_File pCppFile pSenDir dir.entryName munge_ProcessSenFile

    i_File 1 + to i_File
  repeat

  i_File
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* write the .cpp header portion of the file                                  */
/*----------------------------------------------------------------------------*/
: munge_WriteCppHeader params| pCppFile |

  "/*============================================================================*/\n"
  pCppFile file.writeLine
  "/* MungedSen.cpp - munged sen files                                           */\n"
  pCppFile file.writeLine
  "/*============================================================================*/\n"
  pCppFile file.writeLine
  "#include \"StorageEngine.h\"\n"
  pCppFile file.writeLine

  "\n"
  pCppFile file.writeLine
  "Stz* gszaMungedText[1024];\n"
  pCppFile file.writeLine

  "\n"
  pCppFile file.writeLine
  "void Task::vAddMunged(Forth* pForth)\n"
  pCppFile file.writeLine
  "{\n"
  pCppFile file.writeLine
  "  Stz* szSubScriptDef;\n"
  pCppFile file.writeLine
;

/*----------------------------------------------------------------------------*/
/* write the .cpp footer portion of the file                                  */
/*----------------------------------------------------------------------------*/
: munge_WriteCppFooter params| pCppFile |

  "}\n"
  pCppFile file.writeLine
  "\n"
  pCppFile file.writeLine

  "/*============================================================================*/\n"
  pCppFile file.writeLine
  "/* end                                                                        */\n"
  pCppFile file.writeLine
  "/*============================================================================*/\n"
  pCppFile file.writeLine
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* munge all .sen files                                                       */
/*----------------------------------------------------------------------------*/
: munge \prompt

  dir::new  locals| pSenDir |
  file::new locals| pCppFile |

  "munging" .

  // save original dir and change to ../Sen
  dir::getCurrent locals| sOrigDir |
  sOrigDir "Original working directory: %v" .printf

  "../Sen" dir::changeCurrent
  dir::getCurrent "Working directory now: %v" .printf

  // open sen directory
  "." pSenDir dir.open assert

  // open cpp file
  "../Munge/Task_AddMunged.cpp" OPEN_WRITE pCppFile file.open assert

  pCppFile munge_WriteCppHeader

  // munge the command dir
  pCppFile pSenDir munge_ProcessDir locals| nSenProcessed |

  pCppFile munge_WriteCppFooter

  // close and delete file accessor
  pCppFile file.close
  pCppFile file.delete

  pSenDir dir.close
  pSenDir dir.delete

  // change back to original dir
  sOrigDir dir::changeCurrent
  dir::getCurrent "Working directory back to: %v" .printf

  nSenProcessed "munged %v .sen files" .printf
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
