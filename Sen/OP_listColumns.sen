/*============================================================================*/
/* OP_listColumns.sen -- Operator list columns                                */
/*============================================================================*/

" OP_listColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lscol_action

  0 locals| iColumns |

  // find the table
  <tableNm> op__table not if
    false
    exit
  then

  // get the table column count
  table[].columnCount@ to iColumns

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // insert a row in the infoset for each column
  iColumns 0 do
    I table[].column@
    streamSetTable[] StreamSet[].addColumnDef not if
      StreamSet[].pipeout
      streamSetTable[] streamSet[].new
      I table[].column@
      streamSetTable[] StreamSet[].addColumnDef assert
    then
  loop

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lscol :: lscol <tableNm> ;

: lscol _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <localLiteOp> = true
    <streamDef>   = __listColumns
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

