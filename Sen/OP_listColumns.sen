/*============================================================================*/
/* OP_listColumns.sen -- Operator list columns                                */
/*============================================================================*/

" OP_listColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: ListColumns_PulseMarker \handler

  0 locals| iColumns |

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  "ListColumns_PulseMarker A" .

  // get the table column count
  table[].columnCount to iColumns

  // save the table of the base table
  table[] to OperandB[]

  //path[].discardTable
 
  "ListColumns_PulseMarker B" .

path[].toStr .
folder[].contentStr .

  // find the __listColumns table
  C_TDEF_LISTCOLUMNS op__tableDef not if exit then

  "ListColumns_PulseMarker C" .


  // create a new streamDef
  table[] StreamDef[].new

  // create an infoSet operand
  StreamDef[] InfoSet[].new

  "ListColumns_PulseMarker D" .

  iColumns 0 do
    I OperandB[] StreamDef[] InfoSet[].addColumnDef assert
  loop

  "ListColumns_PulseMarker E" .

  // pipeout the streamDef
  StreamDef[].pipeout

  // pipeout the infoset
  InfoSet[].pipeout

  Operand[].newEosMarker
  Operand[].pipeOut

  "ListColumns_PulseMarker F" .

  assert::stack_0

  "ListColumns_PulseMarker G" .


  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: ListColumns_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  <tableNm> op__table if
    Pipein[].pipeout
  then

  assert::stack_0

  true
;


/*----------------------------------------------------------------------------*/
/* execute for TruncateOp req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: ListColumns_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: ListColumns_PulseMarker ZK_PULSEMARKER op[].handler!
  find: ListColumns_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: listColumns :: listColumns <tableNm> ;

: listColumns opInfo tagCopy: localOp_tags
  tags{ <jobDesc>  = "--description of operator--" }
;

    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

