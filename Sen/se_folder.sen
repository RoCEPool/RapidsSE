/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make new folder given name                                                 */
/*----------------------------------------------------------------------------*/
: folder::makeFolder params| sFolderNm |

dicLock.grabwrite

  find: \folder locals| pwFolderCatg |

  sFolderNm dic::new locals| pFolder |

  sFolderNm word::new locals| pwFolder |

  pwFolderCatg pFolder pwFolder word.cppObject!

dicLock.dropwrite

  args.verbose if
    pwFolder word.name@
    path[].toStr
      "Created folder %v/%v" .printf
  then

  //pwFolder word.see

  pwFolder // returns:
;

/*----------------------------------------------------------------------------*/
/* make a sub-folder under given folder                                       */
/*----------------------------------------------------------------------------*/
: folder::makeSubFolder params| pFolder sSubFolderNm |

  pFolder path[].pushFolder

    find: \folder
    sSubFolderNm folder::makeFolder execute dic.kind!

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* remove folder                                                              */
/*----------------------------------------------------------------------------*/
: folder::remove params| sFolderNm |

  sFolderNm find locals| pWord |

  pWord not if exit_rt then

  pWord word.object@ locals| pDic |
  0 pWord word.object!

  pDic dic.delete
 
  sFolderNm :forget
;

/*----------------------------------------------------------------------------*/
/* test name is a known table                                                 */
/*----------------------------------------------------------------------------*/
: name::isSubFolder params| sTableNm | ( t | f )

  sTableNm folder[].findSymbol locals| pwWord |

  pwWord not if false exit then

  pwWord word.category@ find: \folder eql
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* list all words (long form) in the current dictionary                       */
/*----------------------------------------------------------------------------*/
: symbols prompt

  path[].toStr .put "::" .put .\n

  folder[] dic.lastWord
  begin dup while
    dup word.name@ .put " " .put dup word.category@ word.name@ .put .\n
    word.prev
  repeat
  discard
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
