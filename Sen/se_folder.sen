/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make new folder given name (create does> rtn and leave pFolder on stack)   */
/*----------------------------------------------------------------------------*/
//: :makeFolder params| sFolderNm |
//
//diclock.grabwrite
//
//  find: \folder
//  CN_DIC
//  sizeof_dic
//  sFolderNm
//    :createObject
//      locals| pFolder |
//
//  pFolder word.embObject dic.init
//
//diclock.dropwrite
//
//  args.verbose if
//    pFolder word.name@
//    path[].toStr
//      "Created folder %v/%v" .printf
//  then
//
//  pFolder // returns:
//;
/*----------------------------------------------------------------------------*/
: :makeFolder params| sFolderNm |

diclock.grabwrite

  find: \folder
  dic::new
  sFolderNm
    :createCppObject
      locals| pFolder |

  sFolderNm pFolder word.object@ dic.name!

diclock.dropwrite

  args.verbose if
    pFolder word.name@
    path[].toStr
      "Created folder %v/%v" .printf
  then

  pFolder // returns:
;

/*----------------------------------------------------------------------------*/
/* make a sub-folder under given folder                                       */
/*----------------------------------------------------------------------------*/
: :makeSubFolder params| pFolder sSubFolderNm |

  pFolder path[].pushFolder

    find: \folder
    sSubFolderNm :makeFolder execute dic.kind!

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* remove folder                                                              */
/*----------------------------------------------------------------------------*/
: folder::remove params| sFolderNm |

  sFolderNm find locals| pWord |

  pWord not if exit_rt then

  pWord word.object@ locals| pDic |
  0 pWord word.object!

  pDic dic.delete
 
  sFolderNm :forget
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* list all words (long form) in the current dictionary                       */
/*----------------------------------------------------------------------------*/
: symbols prompt

  path[].toStr .put "::" .put .\n

  folder[] dic.lastWord
  begin dup while
    dup word.name@ .put " " .put dup word.category@ word.name@ .put .\n
    word.prev
  repeat
  discard
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
