/*============================================================================*/
/* requests_object.sen -- temporary (to test sending an object)               */
/*============================================================================*/

"requests_object.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get object (run by participant)                                            */
/*----------------------------------------------------------------------------*/
: object$ ( -- <R> )

tp: gettingObject

  args.tracepoint if
    "GETTING OBJECT on NODE "grid.thisNode@ >str str.cat .
  then

  file::new dup
  "pathXYZ" grid.thisNodeName@ str.cat swap file.path!
  >binval

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* have participants run: object$                                             */
/*----------------------------------------------------------------------------*/
: ~object (  )

tp: objectOnAll

  // the indirect word to be called
  "object$"

  tp: theIndirectCall

  >> ( valset )

  // object$ to be executed by all participants
  >>allParticipants> ( bool )

  tp: objectOnAllDone

  printFile

tp: done
;

/*----------------------------------------------------------------------------*/
/* get object                                                                 */
/*----------------------------------------------------------------------------*/
: object_req ( -- <R> )

  ~object ( ) assert::stack_0

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
