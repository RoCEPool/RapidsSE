/*============================================================================*/
/* requests_space.sen -- the set of space related requests                    */
/*============================================================================*/

"requests_space.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get free space in the pool                                                 */
/*----------------------------------------------------------------------------*/
: getFreeSpace ( -- <R> )

  bp::freeSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get inUse space in the pool                                                */
/*----------------------------------------------------------------------------*/
: getInUseSpace ( -- <R> )

  bp::inUseSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get total space in the pool                                                */
/*----------------------------------------------------------------------------*/
: getTotalSpace ( -- <R> )

  bp::totalSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get space in the pool (run by participant)                                 */
/*----------------------------------------------------------------------------*/
: get_space allParticipants 0 returnResult ( -- str n# true )

tp: gettingSpace

  args.tracepoint if
    "GETTING SPACE on NODE "grid::thisNodeName@ str.cat .
  then

  args.metadata if
    "row: ('"
    grid::thisNodeName@ str.cat
    "', '" str.cat
    2 bp::totalSpace number.magnitude str.cat
    "', '" str.cat
    2 bp::inUseSpace number.magnitude str.cat
    "', '" str.cat
    2 bp::freeSpace number.magnitude str.cat
    "')" str.cat

  else
    "Pool - Size(" 2 bp::totalSpace number.magnitude str.cat ")" str.cat
    " InUse(" 2 bp::inUseSpace number.magnitude str.cat ")" str.cat
    " Free(" 2 bp::freeSpace number.magnitude str.cat ")" str.cat
    str.cat str.cat
  then

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* get space in the pool                                                      */
/*----------------------------------------------------------------------------*/
: poolSpace_req ( -- <R> )

  args.metadata if
    "(nodeName VARCHAR, poolSize STRING, inUse VARCHAR, free VARCHAR)"
    metadata!
  then

  get_space ( str )

  not if <NIP+ERROR> else <SUCCESS> then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
