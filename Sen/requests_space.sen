/*============================================================================*/
/* requests_space.sen -- the set of space related requests                    */
/*============================================================================*/

"requests_space.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get free space in the pool                                                 */
/*----------------------------------------------------------------------------*/
: getFreeSpace ( -- <R> )

  bp.freespace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get inUse space in the pool                                                */
/*----------------------------------------------------------------------------*/
: getInUseSpace ( -- <R> )

  bp.inUseSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get total space in the pool                                                */
/*----------------------------------------------------------------------------*/
: getTotalSpace ( -- <R> )

  bp.totalSpace

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get space in the pool (run by participant)                                 */
/*----------------------------------------------------------------------------*/
: get_space allParticipants 0 printResult ( -- str n# true )

tp: gettingSpace

  args.tracepoint if
    "GETTING SPACE on NODE "grid.thisNodeName@ str.cat .
  then

  "Pool - Size(" 2 bp.totalSpace number.magnitude str.cat ")" str.cat
  " InUse(" 2 bp.inUseSpace number.magnitude str.cat ")" str.cat
  " Free(" 2 bp.freespace number.magnitude str.cat ")" str.cat

  str.cat str.cat

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* get space in the pool                                                      */
/*----------------------------------------------------------------------------*/
: space ( -- <R> )

  get_space ( ) assert.stack_0

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
