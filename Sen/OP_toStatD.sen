/*============================================================================*/
/* OP_toStatD.sen -- To StatD Operator                                        */
/*============================================================================*/

" OP_toStatD.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_INFOSET ...                                                          */
/*----------------------------------------------------------------------------*/
: OP_toStatD_InfoSet \handler

  "OP_toStatD_InfoSet +++ +++ +++" .

  operand[].get to infoset[]
  nullptr to operand[]

  infoset[].name .

  infoset[].delete

//  infoset[]
//    "__statD" find word.object@
//    pipeline.pipeout
   
  true
;

/*----------------------------------------------------------------------------*/
/* toStatD request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toStatDOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: OP_toStatD_InfoSet ZK_INFOSET op[].handler!

  op__loop

  "*** toStatDOp_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: toStatDOp :: toStatDOp ;

: toStatDOp opInfo tagCopy: localOp_tags
  tags{ <?jobDesc?>  = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
