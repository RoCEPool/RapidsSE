/*============================================================================*/
/* OP_toStatD.sen -- To StatD Operator                                        */
/*============================================================================*/

" OP_toStatD.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_LOCKSTATS ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_toStatD_LockStats \handler

  "OP_toStatD_LockStats +++ +++ +++" .

  Pipein[] to infoset[]
  nullptr to Pipein[]

  infoset[].name .

  //infoset[].delete

  infoset[]
    "__statD" find dup if
      word.object@
      pipeline.pipeout
      nullptr to infoSet[]
    else
      discard discard
      infoset[].delete
    then

  true
;

/*----------------------------------------------------------------------------*/
/* toStatD request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toStatDOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: OP_toStatD_LockStats ZK_LOCKSTATS op[].handler!

  op__loop

  "*** toStatDOp_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: toStatDOp :: toStatDOp ;

: toStatDOp _info tagCopy: localOp_tags
  tags{ <?jobDesc?>  = "--op desc--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
