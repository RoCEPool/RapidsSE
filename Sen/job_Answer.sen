/*============================================================================*/
/* job_Answer.sen -- answer job                                               */
/*============================================================================*/

" job_Answer.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the answer task                                                      */
/*----------------------------------------------------------------------------*/
: spawn_Answer ( -- )

  0 locals| pJobClass_Answer |
  0 locals| pJob_Answer |

  CN_JOB_ANSWER jobClass::find to pJobClass_Answer

  nullptr pJobClass_Answer jobClass.new to pJob_Answer

  pJob_Answer SEED_RUN job.spawn
;

/*----------------------------------------------------------------------------*/
/* receive node info from node we just answered                               */
/*----------------------------------------------------------------------------*/
: recvNodeInfo ( pSocket -- pAnsweredNode )

  params| pSocket |

  0 locals| pJob_NodeInfo |
  0 locals| pAnsweredNode |

  // receive the node info job
  pSocket socket.recvObject drop to pJob_NodeInfo

  // find the answered node in grid
  pJob_NodeInfo job_NodeInfo.nodeName@ grid::findNode to pAnsweredNode

  // set the receive socket in the answered node
  pSocket pAnsweredNode node.recvSocket!

  // delete the node info job
  pJob_NodeInfo job.delete

  //pAnsweredNode node.name "Answered node %v" str.format .am

  // return the answered node
  pAnsweredNode
;

/*----------------------------------------------------------------------------*/
/* answer loop: accept new sockets, spawn receiver task                       */
/*----------------------------------------------------------------------------*/
: answer_run ( -- )

  >>am <SEED_RUN>

  assertStackDepthZero

  0 locals| iPort |
  0 locals| pListeningSocket |
  0 locals| pAcceptedSocket |
  0 locals| pAnsweredNode |
  0 locals| pConnectorTask |

  0 locals| nConns |

  CN_JOB_ANSWER task::this task.thread thread.dedicated!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the listening port of this node
  grid::thisNode@ grid::node node.port to iPort

  //args.verbose if
  //  iPort "Waiting for connections on port %v" fmt.print
  //then

  // now create a listening socket
  iPort socket::listen to pListeningSocket

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin

    // -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
    // wait for next socket

    assertStackDepthZero

    pListeningSocket socket.accept to pAcceptedSocket

    args.verbose if
      iPort "Answered connection on port %v" fmt.print
    then

    // -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
    // receive node info

    pAcceptedSocket recvNodeInfo to pAnsweredNode

    // -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
    // spawn receiver task for the new socket

    // increment connection counter
    nConns 1 + to nConns

    pAnsweredNode nConns spawn_Receiver

    // -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
    // if first socket on non-start node then start the connector task

    nConns 1 == if
      grid::thisNode@ grid::StartNode@ != if
        spawn_Connector to pConnectorTask
      then
    then

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
