/*============================================================================*/
/* job_Receiver.sen -- receiver job                                           */
/*============================================================================*/

" job_Receiver.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver                                                         */
/*----------------------------------------------------------------------------*/
: spawn_Receiver ( pAnsweredNode pSocket iConnNo -- )

  params| iConnNo |
  params| pSocket |
  params| pAnsweredNode |

  0 locals| pJobClass_Receiver |
  0 locals| pJob_Receiver |

  CN_JOB_RECEIVER jobClass::find to pJobClass_Receiver

  nullptr pJobClass_Receiver jobClass.new to pJob_Receiver

  iConnNo pJob_Receiver job_receiver.connNo!
  pSocket pJob_Receiver job_receiver.socket!

  pJob_Receiver SEED_RUN job.spawn
;

/*----------------------------------------------------------------------------*/
/* receiver init                                                              */
/*----------------------------------------------------------------------------*/
: receiver_init ( -- )

  0 locals| pThisTask |
  0 locals| pJob_Receiver |
  0 locals| pSocket |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  CN_JOB_RECEIVER task::this task.thread thread.dedicated!

  // get the task
  task::this to pThisTask

  // get the job from the task
  pThisTask task.job@ to pJob_Receiver
  //pJob_Receiver pThisTask "receiver_run task: %v job_Receiver %v" fmt.print

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get socket
  pJob_Receiver job_receiver.socket@ to pSocket

  // set socket in task (task socket should go)
  pSocket task::this task.socket!

  // set task comment (this should go, never really used it)
  //"receiver_run" task::this task.comment!

  args.verbose if
    grid::thisNode@ "receiver running on node %v" fmt.print
  then
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job, execute it                                   */
/*----------------------------------------------------------------------------*/
: receiver_loop ( -- )

  0 locals| pJob |
  0 locals| pWorkingBuffer |

  begin

    assertStackDepthZero

    //"receiver_run recv" .

    socket> drop to pJob

    pJob not if
      ifAgain
    then

    pJob job.postRecv

    pJob job.hasWorkingBuffer if
      //"receiver_loop: job has working buffer" .
      socket> drop to pWorkingBuffer
      pWorkingBuffer pJob job.workingBuffer!
    then

    pJob SEED_RCV job.spawn

  again
;

/*----------------------------------------------------------------------------*/
/* receiver seed                                                              */
/*----------------------------------------------------------------------------*/
: receiver_run ( -- )

  <SEED_RUN>

  // initialise
  receiver_init

  // loop, receiving and executing jobs
  receiver_loop

  // should never exit
  hazard

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
