/*============================================================================*/
/* job_Receiver.sen -- receiver job                                           */
/*============================================================================*/

" job_Receiver.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver job (as a dedicated job)                                */
/*----------------------------------------------------------------------------*/
: spawn_Receiver ( pAnsweredNode iConnNo -- )

  params| iConnNo |
  params| pAnsweredNode |

  0 locals| pJobClass_Receiver |
  0 locals| pJob_Receiver |

  CN_JOB_RECEIVER jobClass::find to pJobClass_Receiver

  pJobClass_Receiver jobClass.new to pJob_Receiver

  iConnNo       pJob_Receiver job_receiver.connNo!
  pAnsweredNode pJob_Receiver job_receiver.node!

  pJob_Receiver SEED_RUN job.spawn_dedicated
;

/*----------------------------------------------------------------------------*/
/* receiver init                                                              */
/*----------------------------------------------------------------------------*/
: receiver_init ( -- )

  CN_JOB_RECEIVER task::this task.thread thread.dedicated!

  NS_ACTIVE grid::thisNode@ grid::node node.state!

  args.verbose if
    grid::thisNode@ "receiver running on node %v" fmt.print
  then
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: receiver_loop ( -- )

  0 locals| pReceivedJob |
  0 locals| pOperand     |
  0 locals| pSendWith    |
  0 locals| pOtherNode   |
  0 locals| pSocket      |
  0 locals| bRecvd       |

  job::this locals| pJob_Receiver |

  pJob_Receiver job_Receiver.node@ to pOtherNode

  pOtherNode node.recvSocket@ to pSocket

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    assertStackDepthZero

    // -- -- -- -- -- -- -- --
    // recv job

    pSocket socket.recvObject

    not if
      //ifAgain
      "receiver exiting" .
      exit
    then

    to pReceivedJob

    // -- -- -- -- -- -- -- --
    // log received job

    pReceivedJob job_receiver::jobReceived

    // -- -- -- -- -- -- -- --
    // run post receive function

    pReceivedJob job.postRecv

    // -- -- -- -- -- -- -- --
    // recv operand

    pReceivedJob job.hasOperand if
      pSocket socket.recvObject drop to pOperand
      pOperand pReceivedJob job.operand!
    then

    // -- -- -- -- -- -- -- --
    // examine job
    pReceivedJob job.kind@ JK_GENERIC == if
      "received a generic job" .
      pReceivedJob job.enameSet@ enameSet.asStr .
    then

    // -- -- -- -- -- -- -- --
    // dispatch job

    pReceivedJob job.jobClass CN_JOB_OPERAND == if
      pReceivedJob Job_operand.pipeOut
    else
      pReceivedJob job.seedDecode
      pReceivedJob job.seed!
      pReceivedJob job.spawn
   then

  again
;

/*----------------------------------------------------------------------------*/
/* receiver seed                                                              */
/*----------------------------------------------------------------------------*/
: receiver_run ( -- )

  >>logEntry <SEED_RUN>

  task::this locals| pThisTask |
  job::this  locals| pJob_Receiver |

  // initialise
  receiver_init

  // loop, receiving and executing jobs
  receiver_loop

  // should never exit
  //hazard

  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
