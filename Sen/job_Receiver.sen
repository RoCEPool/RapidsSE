/*============================================================================*/
/* r35ReceiverTask.sen -- R35 receiver task                                   */
/*============================================================================*/

"r35ReceiverTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver task                                                    */
/*----------------------------------------------------------------------------*/
: spawnR35ReceiverTask ( pSocket iConnNo -- )

  params| iConnNo |
  params| pSocket |

  0 locals| sTaskName |

  // form the task name
  iConnNo grid::thisNode@ "Node%v_rr%v" str.format to sTaskName

  // spawn the receiver
    pSocket             // socket
    1                   // no. of args
    "Receiver_seed"     // seed word
    sTaskName           // task name
    TK_RECEIVER_DRONE   // task kind
  spawnR35GeneralTask
;

/*----------------------------------------------------------------------------*/
/* spawn the receiver task                                                    */
/*----------------------------------------------------------------------------*/
: spawnR35ReceiverTask_2 ( pSocket iConnNo -- )

  params| iConnNo |
  params| pSocket |

  0 locals| pJobClass_Receiver |
  0 locals| pJob_Receiver |

  CN_JOB_RECEIVER jobClass::find to pJobClass_Receiver

  nullptr pJobClass_Receiver jobClass.new to pJob_Receiver

  pJob_Receiver job.spawn
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job, execute it                                   */
/*----------------------------------------------------------------------------*/
: Receiver_seed ( pSocket -- )

  tp: Receiver_seed

  params| pSocket |

  assertStackDepthZero

  0 locals| pJob |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set socket in task (task socket should go)
  pSocket task::this task.socketR35!

  // set task comment (this should go, never really used it)
  "Receiver_seed" task::this task.comment!

  args.verbose if
    grid::thisNode@ "Receiver running on node %v" fmt.print
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin

    // check the d-stack depth is zero
    assertStackDepthZero

   "Receiver_seed recv" .
    // receive valset from socket
    socketR35>

    // unpack valset into pJob
    valset> drop to pJob

    // execute received job
    pJob job.execute

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
