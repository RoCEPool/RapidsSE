/*============================================================================*/
/* job_Receiver.sen -- receiver job                                           */
/*============================================================================*/

"job_Receiver.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver                                                         */
/*----------------------------------------------------------------------------*/
: spawn_Receiver ( pSocket iConnNo -- )

  params| iConnNo |
  params| pSocket |

  0 locals| pJobClass_Receiver |
  0 locals| pJob_Receiver |

  CN_JOB_RECEIVER jobClass::find to pJobClass_Receiver

  nullptr pJobClass_Receiver jobClass.new to pJob_Receiver

  iConnNo pJob_Receiver job_receiver.connNo!
  pSocket pJob_Receiver job_receiver.socket!

  pJob_Receiver job.spawn
;

/*----------------------------------------------------------------------------*/
/* receiver init                                                              */
/*----------------------------------------------------------------------------*/
: Receiver_init ( -- )

  0 locals| pThisTask |
  0 locals| pJob_Receiver |.
  0 locals| pSocket |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the task
  task::this to pThisTask

  // get the job from the task
  pThisTask task.job@ to pJob_Receiver
  pJob_Receiver pThisTask "Receiver_seed task: %v job_Receiver %v" fmt.print

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get socket
  pJob_Receiver job_receiver.socket@ to pSocket

  // set socket in task (task socket should go)
  pSocket task::this task.socketR35!

  // set task comment (this should go, never really used it)
  "Receiver_seed" task::this task.comment!

  args.verbose if
    grid::thisNode@ "Receiver running on node %v" fmt.print
  then
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job, execute it                                   */
/*----------------------------------------------------------------------------*/
: Receiver_loop ( -- )

  0 locals| pJob |
  0 locals| eJobClass |

  begin

    // check the d-stack depth is zero
    assertStackDepthZero

    "Receiver_seed recv" .
    // receive valset from socket
    socketValSet>

    // unpack valset into pJob
    valset> drop to pJob

    pJob job.class to eJobClass

    // execute received job
    eJobClass CN_JOB_LOADBUFFER == if
      pJob job.spawn
    else
      pJob job.execute
    then

  again

;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job, execute it                                   */
/*----------------------------------------------------------------------------*/
: Receiver_loop_2 ( -- )

  0 locals| pJob |
  0 locals| eJobClass |

  begin

    assertStackDepthZero

    "Receiver_seed recv" .

    socketObject> drop to pJob

    pJob job.class to eJobClass

    pJob job.execute

  again
;

/*----------------------------------------------------------------------------*/
/* receiver seed                                                              */
/*----------------------------------------------------------------------------*/
: Receiver_seed ( -- )

  // initialise
  Receiver_init

  // loop, receiving and executing jobs
  Receiver_loop_2

  // should never exit
  hazard
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
