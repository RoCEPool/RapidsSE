/*============================================================================*/
/* job_Receiver.sen -- receiver job                                           */
/*============================================================================*/

" job_Receiver.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver                                                         */
/*----------------------------------------------------------------------------*/
: spawn_Receiver ( pAnsweredNode iConnNo -- )

  params| iConnNo |
  params| pAnsweredNode |

  0 locals| pJobClass_Receiver |
  0 locals| pJob_Receiver |

  CN_JOB_RECEIVER jobClass::find to pJobClass_Receiver

  nullptr pJobClass_Receiver jobClass.new to pJob_Receiver

  iConnNo       pJob_Receiver job_receiver.connNo!
  pAnsweredNode pJob_Receiver job_receiver.node!

  pJob_Receiver SEED_RUN job.spawn
;

/*----------------------------------------------------------------------------*/
/* receiver init                                                              */
/*----------------------------------------------------------------------------*/
: receiver_init ( -- )

  CN_JOB_RECEIVER task::this task.thread thread.dedicated!

  args.verbose if
    grid::thisNode@ "receiver running on node %v" fmt.print
  then
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job, execute it                                   */
/*----------------------------------------------------------------------------*/
: receiver_loop ( -- )

  0 locals| pReceivedJob |
  0 locals| pEntryBuffer |
  0 locals| pOtherNode |
  0 locals| pSocket |

  job::this locals| pJob_Receiver |

  pJob_Receiver job_Receiver.node@ to pOtherNode

  pOtherNode node.recvSocket@ to pSocket

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    assertStackDepthZero

    pSocket socket.recvObject drop to pReceivedJob

    pReceivedJob not if
      ifAgain
    then

    pReceivedJob job.postRecv

    pReceivedJob job.hasEntryBuffer if
      pSocket socket.recvObject drop to pEntryBuffer
      pEntryBuffer pReceivedJob job.entryBuffer!
    then

    pReceivedJob SEED_RCV job.spawn

  again
;

/*----------------------------------------------------------------------------*/
/* receiver seed                                                              */
/*----------------------------------------------------------------------------*/
: receiver_run ( -- )

  >>am <SEED_RUN>

  // initialise
  receiver_init

  // loop, receiving and executing jobs
  receiver_loop

  // should never exit
  hazard

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
