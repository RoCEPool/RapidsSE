/*============================================================================*/
/* OP_passThru.sen -- Operator passThru                                       */
/*============================================================================*/

" OP_passThru.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for passThru req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : PassThruOp_req ( -- )

  LogEntry SEED_REQ

  0 locals| bufferCount |
  "__REPORT" locals| sReportTable |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

       ZK_CSVBUFFER of
         //"Operand:- ZK_CSVBUFFER" .verbose
         bufferCount 1 + to bufferCount
         Operand[].delete
         true
      endof

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        Operand[].delete
        Operand[].newCsvBuffer
        Operand[].report
        bufferCount "passThru" "passThru,%v,%v\nn" str.format Operand[].csvAppend
        Operand[].pipeout

        Operand[].newEosMarker
        Operand[].pipeout
        true
      endof

      ZK_PULSEMARKER of

        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut

        // new a stream def
        Operand[].newStreamDef
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose

        sReportTable checkIsValidTable not if
          op.pipelineJob@ ERROR_JOB !!logError
          Operand[].delete
          Operand[].newErrorMarker
        else
          sReportTable pushTable assert
          sReportTable find execute to table[]
        then

        Operand[].pipeOut
        true
      endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: PassThruOp :: PassThruOp ;

jobInfo: PassThruOp
{
  ?<jobDesc>?  = "--description of job--"
  
  ?<jobKind>?  = JK_LOCAL
  ?<rspKind>?  = RS_PARTICIPANT_RESPONSE
  ?<ddlLock>?  = DL_GRAB_READ
  
  ?<preCheck>? = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
