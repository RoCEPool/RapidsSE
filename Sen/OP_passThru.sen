/*============================================================================*/
/* OP_passThru.sen -- Operator passThru                                       */
/*============================================================================*/

" OP_passThru.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: PassThruOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Counter0[] 1 + to  Counter0[]
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: PassThruOp_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  Operand[].delete
  Operand[].newCsvBuffer
  Operand[].report
  Counter0[] "passThru" "passThru,%v,%v\nn" str.format Operand[].csvAppend
  Operand[].pipeout

  Operand[].newEosMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: PassThruOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Operand[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: PassThruOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  "__REPORT" locals| sReportTable |

  sReportTable checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  else
    sReportTable pushTable assert
    sReportTable find execute to table[]
  then

  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for passThru req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : PassThruOp_req \operator

  LogReqEntry SEED_REQ

  0 to Counter0[]

  op__topology

  find: PassThruOp_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: PassThruOp_EosMarker   ZK_EOSMARKER   op[].handler!
  find: PassThruOp_PulseMarker ZK_PULSEMARKER op[].handler!
  find: PassThruOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: PassThruOp :: PassThruOp ;

jobInfo: PassThruOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
