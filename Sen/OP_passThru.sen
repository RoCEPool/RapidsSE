/*============================================================================*/
/* OP_passThru.sen -- Operator passThru                                       */
/*============================================================================*/

" OP_passThru.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: PassThru_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Counter0[] 1 + to  Counter0[]
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: PassThru_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  Pipein[].delete
  Operand[].newCsvBuffer
  Operand[].report
  Counter0[] "passThru" "passThru,%v,%v\nn" str.format Operand[].csvAppend
  Operand[].pipeout

  Operand[].newEosMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: PassThru_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: PassThru_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  "__REPORT" locals| sReportTable |

  sReportTable op__table if
    sReportTable path[].pushNamedTableFolder
    sReportTable find execute to table[]
    Pipein[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for passThru req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : PassThru_req \operator

  LogReqEntry SEED_REQ

  0 to Counter0[]

  op__topology

  find: PassThru_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: PassThru_EosMarker   ZK_EOSMARKER   op[].handler!
  find: PassThru_PulseMarker ZK_PULSEMARKER op[].handler!
  find: PassThru_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: PassThru :: PassThru ;

: PassThru _cmdTags tagCopy: stageOp_tags
  tags{ <jobDesc> = "--op desc--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
