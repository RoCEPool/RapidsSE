/*============================================================================*/
/* r35ReceiverTask.sen -- R35 receiver task                                   */
/*============================================================================*/

"r35ReceiverTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver task                                                    */
/*----------------------------------------------------------------------------*/
: spawnR35ReceiverTask ( pSocket connectionNo -- )

  locals| nConnection |
  locals| pSocket |

  0 locals| sTaskName |

  // form the task name
  nConnection @ grid::thisNode@ "Node%v_rr%v" str.format to sTaskName

  // spawn the receiver
    pSocket             // socket
    1                   // no. of args
    "r35ReceiverLoop"   // seed word
    sTaskName           // task name
    TK_RECEIVER_DRONE   // task kind
  spawnR35GeneralTask
;

/*----------------------------------------------------------------------------*/
/* receiver loop                                                              */
/*----------------------------------------------------------------------------*/
: r35ReceiverLoop ( pSocket -- )

  tp: r35rvc.loop

  locals| pSocket |

  0 locals| pJob |

  // set socket in task (task socket should go)
  pSocket task::this task.socket!

  // set task comment (this should go, never really used it)
  "r35ReceiverLoop" task::this task.comment!

  "Receiver Task R35 running on node" grid::thisNode@ >str str.cat .

  begin

                                                            //! make this a word
    depth 0 != if stk "stack of receiver task has grown" . debug::trap then

    //task::this task.socket@ >str "receiving on socket %v" str.format .
    socketR35>

    valset> drop to pJob

    pJob job.decode

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
