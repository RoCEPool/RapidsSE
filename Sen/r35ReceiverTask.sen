/*============================================================================*/
/* r35ReceiverTask.sen -- R35 receiver task                                   */
/*============================================================================*/

"r35ReceiverTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver task                                                    */
/*----------------------------------------------------------------------------*/
: spawnR35ReceiverTask ( connectionNo -- )

  locals| nConnection |

  // set up the seed
  1 "r35ReceiverLoop" ( socket 1 "receiverLoop" )

  // form name of the receiver
  "node" grid::thisNode@ >str str.cat
   "_rr" str.cat nConnection @ >str str.cat ( socket 1 "r35ReceiverLoop" "rrI" )

  // spawn the actors os thread
  TK_RECEIVER_DRONE spawnR35GeneralTask

;

/*----------------------------------------------------------------------------*/
/* receiver loop                                                              */
/*----------------------------------------------------------------------------*/
: r35ReceiverLoop

  tp: r35rvc.loop

  0 0 locals| pJob pJobBegun |
  task::this task.socket!

  "r35ReceiverLoop" task::this task.comment!

  //receiverDronePrint if "Receiver Drone R35 running on node" grid::thisNode@ >str str.cat . then
  "Receiver Drone R35 running on node" grid::thisNode@ >str str.cat .

  begin
    depth 0 != if stk "stack of receiver task has grown" . debug::trap then

    //task::this task.socket@ >str "receiving on socket %v" str.format .
    socketR35>
    valset> drop

    to pJob

    pJob job.class

    case
      CN_JOB__BEGUN of
        grid::thisNode@ "Node %v CN_JOB__BEGUN" str.format .
        pjob job.id@ pJob job.execute@ find execute
        pjob job.delete
      endof

      CN_JOB__END of
        grid::thisNode@ "Node %v CN_JOB__END"str.format .
        pjob job.id@ pJob job.execute@ find execute
        pjob job.delete
      endof

      CN_JOB__ENDED of
        grid::thisNode@ "Node %v CN_JOB__ENDED"str.format .
        pjob job.id@ pJob job.execute@ find execute
        pjob job.delete
      endof

      CN_JOB__ERROR of
        grid::thisNode@ "Node %v CN_JOB__ERROR"str.format .
        pJob job.id@ pJob job.execute@ find execute
        pjob job.delete
      endof

      CN_JOB__EXECUTE of
        grid::thisNode@ "Node %v CN_JOB__EXECUTE"str.format .
        pjob job.id@ pJob job.execute@ find execute
        pjob job.delete
      endof

      CN_JOB__EXECUTED of
        grid::thisNode@ "Node %v CN_JOB__EXECUTED"str.format .
        pjob job.id@ pJob job.execute@ find execute
        pjob job.delete
      endof

      CN_JOB_G35 of
        grid::thisNode@ "Node %v CN_JOB_G35" str.format .

        // set partcipant node in job
        grid::thisNode@ pJob job.participant!

        // add job as participant job
        pJob job.addParticipant

        // change state of job to begun
        //pJob job.begun

        // new a job__begun
        pJob job.Id@ job.newBegun to pJobBegun

        // set the send node to be the originating node
        pJob job::originator@ grid::node task::this task.sendNode!
        task.send

        // send the begun job
        pJobBegun 1
        >valset
        >socketR35

        // now delete the begun job
        pJobBegun job.delete

      endof
    endcase

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
