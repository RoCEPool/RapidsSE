/*============================================================================*/
/* r35ReceiverTask.sen -- R35 receiver task                                   */
/*============================================================================*/

"r35ReceiverTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver task                                                    */
/*----------------------------------------------------------------------------*/
: spawnR35ReceiverTask ( pSocket connectionNo -- )

  locals| nConnection |
  locals| pSocket |

  0 locals| sTaskName |

  // form the task name
  nConnection @ grid::thisNode@ "Node%v_rr%v" str.format to sTaskName

  // spawn the receiver
    pSocket             // socket
    1                   // no. of args
    "_r35ReceiverLoop_" // seed word
    sTaskName           // task name
    TK_RECEIVER_DRONE   // task kind
  spawnR35GeneralTask
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job, execute it                                   */
/*----------------------------------------------------------------------------*/
: _r35ReceiverLoop_ ( pSocket -- )

  tp: _r35ReceiverLoop_

  locals| pSocket |

  0 locals| pJob |

  // set socket in task (task socket should go)
  pSocket task::this task.socketR35!

  // set task comment (this should go, never really used it)
  "r35ReceiverLoop" task::this task.comment!

  "Receiver Task R35 running on node" grid::thisNode@ >str str.cat .

  begin

                                                            //! make this a word
    depth 0 != if stk "stack of receiverR35 task has grown" . debug::trap then

    //task::this task.socket@ >str "receiving on socket %v" str.format .

   "r35 recv" .
    // receive valset from socket
    socketR35>

    // unpack valset into pJob
    valset> drop to pJob

    // execute received job
    pJob job.execute

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
