/*============================================================================*/
/* r35ReceiverTask.sen -- R35 receiver task                                   */
/*============================================================================*/

"r35ConnectorTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the receiver task                                                    */
/*----------------------------------------------------------------------------*/
: spawnR35ReceiverTask ( connectionNo -- )

  locals| nConnection |

  // set up the seed
  1 "r35ReceiverLoop" ( socket 1 "receiverLoop" )

  // form name of the receiver
  "rr" nConnection @ >str str.cat ( socket 1 "r35ReceiverLoop" "rrI" )

  // spawn the actors os thread
  TK_RECEIVER_DRONE spawnR35GeneralTask

;

/*----------------------------------------------------------------------------*/
/* receiver loop                                                              */
/*----------------------------------------------------------------------------*/
: r35ReceiverLoop

  tp: r35rvc.loop

  task::this task.socket!

  "r35ReceiverLoop" task::this task.comment!

  receiverDronePrint if "Receiver Drone R35 running on node" grid::thisNode@ >str str.cat . then

  begin
    depth 0 != if stk "stack of receiver task has grown" . debug::trap then

    socket>
    valset> drop

    //exeOne
    "received something...%v" str.format .

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
