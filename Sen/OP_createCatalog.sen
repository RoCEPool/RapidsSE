/*============================================================================*/
/* OP_createCatalog.sen -- Operator create catalog                            */
/*============================================================================*/

" OP_createCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is not a catalog                                             */
/*----------------------------------------------------------------------------*/
: checkIsNotCatalog ( word )
  folder[].findSymbol not if true exit then
  EC_CATALOG_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: createCatalog_PulseMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  node::checkEnoughBuffers not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if are in catalogs
  folder[].checkInCatalogs not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if catalog already exits
  <catalogNm> checkIsNotCatalog not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the catalog
  <catalogNm> :makeCatalogFolder ( )

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createCatalog req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: createCatalog_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: createCatalog_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: createCatalog :: createCatalog <catalogNm> ;

: createCatalog opInfo tagCopy: localOp_tags
  tags{
    <jobDesc>   = "--description of operator--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
