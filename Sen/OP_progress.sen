/*============================================================================*/
/* OP_progress.sen -- Operator progress                                       */
/*============================================================================*/

" OP_progress.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PROGRESSUNITS...                                                     */
/*----------------------------------------------------------------------------*/
: progress_ProgressUnits \handler

  0 locals| iPercent |

  //"Operand:- ZK_PROGRESSUNITS" .verbose

  // get operand into InfoSet[]
  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]


  // get first row of InfoSet[]
  Infoset[].firstRow to row[]

  // get 0th Column (ProgressUnits) add to Counter
  0 row[].getIntColumn Counter1[] + to Counter1[]

  // calculat the Load %
  Counter1[] Counter0[] Int.percent to iPercent

  // print the Load %
  iPercent 0 > if
    iPercent 100 > if
      <string> "%v Progress: 100" str.format
      "%" str.cat .
    else
      iPercent <string> "%v Progress: %v" str.format
      "%" str.cat .
    then
  then


  // now delete the InfoSet[]
  InfoSet[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_TOTALUNITS...                                                        */
/*----------------------------------------------------------------------------*/
: progress_TotalUnits \handler

  0 locals| iPercent |

  //"Operand:- ZK_TOTALUNITS" .verbose

  // get operand into InfoSet[]
  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  // get first row of infoSet[]
  Infoset[].firstRow to row[]

  // get 0th column (totalUnits)
  0 row[].getIntColumn to Counter0[]

  // now delete the InfoSet[]
  InfoSet[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : progress_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: Progress_ProgressUnits ZK_PROGRESSUNITS op[].handler!
  find: Progress_TotalUnits    ZK_TOTALUNITS op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: progress :: progress <string> ;

: progress _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
