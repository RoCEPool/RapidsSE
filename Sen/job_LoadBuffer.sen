/*============================================================================*/
/* job_LoadBuffer.sen -- Load Buffer Job                                      */
/*============================================================================*/

"job_LoadBuffer.sen" .verbose

/*----------------------------------------------------------------------------*/
/* LoadBuffer seed                                                             */
/*----------------------------------------------------------------------------*/
: LoadBuffer_seed (  -- <R> )

  0 locals| pTask |
  0 locals| pJob_LoadBuffer  |

  tp: LoadBuffer

  // get the task
  task::this to pTask

  // get the load buffer job from the task
  pTask task.job@ to pJob_LoadBuffer

  pJob_LoadBuffer job.objectName@ locals| sTableNm |

  "LoadBuffer running" .
  pJob_LoadBuffer getPathR35 dicStack.set

  // push table dictionary
  sTableNm pushTable assert
  pathDump

  sTableNm find execute locals| pTable |
  pTable pJob_LoadBuffer Job_LoadBuffer.table!

  pJob_LoadBuffer <DONE_ONESHOT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
