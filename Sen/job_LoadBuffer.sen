/*============================================================================*/
/* job_LoadBuffer.sen -- Load Buffer Job                                      */
/*============================================================================*/

" job_LoadBuffer.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                               on kid node                                  //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* load buffer into table                                                     */
/*----------------------------------------------------------------------------*/
: LoadBuffer.load ( pJob_LoadBuffer -- )

  params| pJob_LoadBuffer |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  0 locals| iLoadJobId      |
  0 locals| pJob_LoadTable  |
  0 locals| pTask_LoadTable |

  0 locals| sTableNm    |
  0 locals| i_Partition |
  0 locals| bAllLoaded  |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "LoadBuffer_kid :" .
  pJob_LoadBuffer job.show

  // get the load table job (participant node)
  pJob_LoadBuffer job_loadBuffer.jobLoadTableId@ to iLoadJobId
  iLoadJobId job::findParticipant to pJob_LoadTable

  // store the load table job in this load buffer job
  pJob_LoadTable pJob_LoadBuffer job_loadBuffer.jobLoadTable!

  // get the load table task
  pJob_LoadTable job_LoadTable.task@ to pTask_LoadTable

    pTask_LoadTable pJob_LoadTable iLoadJobId
    "LoadJobId %v job_LoadTable (node) %v task_LoadTable %v"
  fmt.print

  // get table name
  pJob_LoadBuffer job.objectName@ to sTableNm

  // push table dictionary
  pJob_LoadBuffer getPath dicStack.set
  sTableNm pushTable assert
  //pathDump

  // use table name find and set target table
  sTableNm find execute locals| pTable |
  pTable pJob_LoadBuffer Job_LoadBuffer.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // grab write lock on table partition
  pJob_LoadBuffer Job_LoadBuffer.partition@ to i_Partition
  i_Partition pTable tablePtnGrabWrite

  // now insert the buffer of rows
  pJob_LoadBuffer job_LoadBuffer.insertRows to bAllLoaded

  // drop write lock on table partition
  i_Partition pTable tablePtnDropWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // ack the load table task if all buffers have been loaded
  bAllLoaded if
      pTask_LoadTable
      "All buffers loaded; Would ack task_LoadTable (node) %v"
    fmt.print

    pTask_LoadTable ack
  then

;

/*----------------------------------------------------------------------------*/
/* seed on kid node                                                           */
/*----------------------------------------------------------------------------*/
: LoadBuffer_kid ( -- )

  <SEED_KID>

  job::this locals| pJob_LoadBuffer |

  pJob_LoadBuffer LoadBuffer.load

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //delete_completed_job

  //<DONE_KID>
;


////////////////////////////////////////////////////////////////////////////////
//                            on loading node                                 //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* forward this load buffer job to kid node                                   */
/*----------------------------------------------------------------------------*/
: LoadBuffer.forward ( pJob_LoadBuffer -- )

  params| pJob_LoadBuffer |

  // which partition are we forwarding to?
  pJob_LoadBuffer job_loadBuffer.partition@ locals| i_Partition |

  // convert i_Partition to i_ForwardNode
  i_Partition grid::toNode locals| i_ForwardNode |

  i_Partition i_ForwardNode "loadBuffer_run : Node %v Partition %v" fmt.print

  // send this job to the forward node
  //i_ForwardNode pJob_LoadBuffer job.forward

  // temp
  LoadBuffer_kid
;

/*----------------------------------------------------------------------------*/
/* seed on loading node                                                       */
/*----------------------------------------------------------------------------*/
: loadBuffer_run (  -- )

  <SEED_RUN>

  job::this locals| pJob_LoadBuffer  |

  "loadBuffer_run :" .

  // simply forward this job to kid node
  pJob_LoadBuffer LoadBuffer.forward

  delete_completed_job

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
