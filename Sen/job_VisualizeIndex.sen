/*============================================================================*/
/* job_VisualizeIndex.sen -- Job Visualize Index                              */
/*============================================================================*/

" job_VisualizeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkVisualizeIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if false exit then

  // push table folder
  sTableNm path[].pushTable assert

  sTableNm checkIsTable not if path[].popTable false exit then
  //sTableNm tableInUse if path[].popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    path[].popIndexes
    path[].popTable
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  path[].popIndexes
  path[].popTable

  // assert in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* visualize index request (on originating node)                              */
/*----------------------------------------------------------------------------*/
: visualizeIndex_req ( -- <R> )

  LogEntry SEED_REQ

  0 0 0 0 0 locals| pTask pIndex sTableNm sIndexNm pJob_VisualizeIndex |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task[] to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_VisualizeIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //check if we can visualize index
  sTableNm sIndexNm checkVisualizeIndex not if pJob_VisualizeIndex ERROR_REQUEST !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table and indexes folder
  sTableNm path[].pushTable assert
  path[].pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize 
  sIndexNm find execute index.visualize

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  path[].popIndexes
  path[].popTable

  pJob_VisualizeIndex job.notice

  LogExit DONE_REQ
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: visualizeIndex :: visidx <tableNm> <indexNm> ;
jobSyntax: visualizeIndex :: visualizeIndex <tableNm> <indexNm> ;

jobInfo: visualizeIndex
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_JOB_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
