/*============================================================================*/
/* AnswerDrone.sen -- answer drone                                            */
/*============================================================================*/

"AnswerDrone.sen" .verbose

/*----------------------------------------------------------------------------*/
/* declare connections variable to keep the number of connections             */
/*----------------------------------------------------------------------------*/
int: nConnections

/*----------------------------------------------------------------------------*/
/* spawn the answer drone                                                     */
/*----------------------------------------------------------------------------*/
: answerDroneSpawn

  0 "answerLoop" "AnswerDrone" spawnDroneActor
;

/*----------------------------------------------------------------------------*/
/* accept new sockets, spawning a worker actor for each new socket            */
/*----------------------------------------------------------------------------*/
: answerLoop

  answerDronePrint if
    task::this task.name@ " running..." str.cat .
  then

  // get the listening port of this node
  grid.thisNode@ grid.node node.port locals| iPort |

  args.verbose if
    "waiting for connections on port "  iPort >str str.cat .
    iPort >str "Listening on port " swap str.cat .
  then

  iPort socket.listen locals| pListeningSocket |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  0 nConnections !
  begin

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // wait for next socket

    tp: waitingOnAccept

    pListeningSocket socket.accept

    tp: socketAccepted

    args.verbose if
      "answered connection on port " iPort >str str.cat .
    then

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // start receiver drone for the new socket

    ddlLock::grabWrite

    // set up the seed
    1 "receiverLoop" ( socket 1 "receiverLoop" )

    // form name of the receiver
    "rr" nConnections @ >str str.cat ( socket 1 "receiverLoop" "rrI" )

    // spawn the actors os thread
    spawnDroneActor

    ddlLock::dropWrite

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // increment connection counter

    nConnections @          ( connection# )
    1 +                    ( nConnections# 1 )
    dup                    ( nConnections# nConnections# )
    nConnections !          ( nConnections# )

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // if very first socket start connector drone

    1 == if               ( connection# )
      grid.thisNode@ grid.startNode@ != if
        spawnConnectorDrone
      then
    then
      
  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
