/*============================================================================*/
/* OP_toRsb.sen -- Operator to row slab                                       */
/*============================================================================*/

" OP_toRsb.sen" .verbose

/*----------------------------------------------------------------------------*/
/* toRsb request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toRsb_req \operator

  LogReqEntry SEED_REQ

  op__topology

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toRsb :: toRsb <tableNm> ;

: toRsb _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
