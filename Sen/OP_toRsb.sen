/*============================================================================*/
/* OP_toRsb.sen -- Convert csv buffer to row slab buffer                      */
/*============================================================================*/

" OP_toRsb.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: toRsb_CsvBuffer \handler

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: toRsb_EosMarker \handler

  ToRsb[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: toRsb_PulseMarker \handler

  // pipe out the pulsemarker
  PipeIn[].pipeOut

  // pipe out the stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: toRsb_StartMarker \handler

  <tableNm> op__table if

    ToRsb[].create

    PipeIn[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* toRsb request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toRsb_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toRsb_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: toRsb_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toRsb_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toRsb_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toRsb :: toRsb <tableNm> ;

: toRsb _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
