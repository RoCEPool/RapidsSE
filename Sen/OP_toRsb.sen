/*============================================================================*/
/* OP_toRsb.sen -- Convert csv buffers to row slab buffers                    */
/*============================================================================*/

" OP_toRsb.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toRsb_StartMarker \handler

  // test and create Table[] using <tableNm>
  <tableNm> op__table if

    // create a ToRsb using Table[].streamDef
    ToRsb[].create

    // pipeout the (StartMarker)
    PipeIn[].pipeOut

  else
    
    // delete the (StartMarker)
    PipeIn[].delete

    // pipeout (ErrorMarker)
    EC_INVALID_COMMAND op.pipelineJob@ ERROR_JOB
    Operand[].newErrorMarker
    Operand[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toRsb_PulseMarker \handler

  // pipe out the (PulseMarker)
  PipeIn[].pipeOut

  // new and pipe out (StreamDef)  DOES NOT SET StreamDef[]??
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toRsb_CsvBuffer \handler

  PipeIn[] to Operand[]
  nullptr to PipeIn[]


  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toRsb_EosMarker \handler

  // delete ToRsb
  ToRsb[].delete

  // pipeout the (EosMarker)
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRsb request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toRsb_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toRsb_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: toRsb_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toRsb_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toRsb_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toRsb :: toRsb <tableNm> ;

: toRsb _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
