/*============================================================================*/
/* OP_toRowSlab.sen -- Operator to row slab                                   */
/*============================================================================*/

" OP_toRowSlab.sen" .verbose

/*----------------------------------------------------------------------------*/
/* toRowSlab request                                  (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toRowSlab_req \operator

  LogReqEntry SEED_REQ

  op__topology

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toRowSlab :: toRowSlab <tableNm> ;

: toRowSlab _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
