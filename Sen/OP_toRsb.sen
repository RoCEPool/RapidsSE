/*============================================================================*/
/* OP_toRsb.sen -- Convert csv buffers to row slab buffers                    */
/*============================================================================*/

" OP_toRsb.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toRsb_StartMarker \handler

  // test and create Table[] using <tableNm>
  <tableNm> op__table if

    // create a ToRsb using Table[].streamDef
    ToRsb[].create

    // pipeout the (StartMarker)
    PipeIn[].pipeOut

    // new and pipe out (StreamDef)  DOES NOT SET StreamDef[]??
    Operand[].newStreamDef
    Operand[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toRsb_PulseMarker \handler

  // pipe out the (PulseMarker)
  PipeIn[].pipeOut


  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toRsb_CrwBuffer \handler

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  //Operand[]
  //profile.start

  Operand[].crwToRsb

  //profile.end

  // test for any completed
  ToRsb[].completed to OperandB[]
  begin
    OperandB[].isNull not
  while
    OperandB[].pipeOut
    ToRsb[].completed to OperandB[]
  repeat

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toRsb_CsvBuffer \handler

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  //Operand[]
  //profile.start

  Operand[].csvToRsb

  //profile.end

  // test for any completed
  ToRsb[].completed to OperandB[]
  begin
    OperandB[].isNull not
  while
    OperandB[].pipeOut
    ToRsb[].completed to OperandB[]
  repeat

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toRsb_EosMarker \handler

  // test for any remainders
  ToRsb[].dangling to OperandB[]
  begin
    OperandB[].isNull not
  while
    OperandB[].pipeOut
    ToRsb[].dangling to OperandB[]
  repeat

  // delete ToRsb
  ToRsb[].delete

  // get the profile from the task
  //task[] task.profile@ to Operand[]
  //nullptr task[] task.profile!
  //Operand[].pipeOut

  // pipeout the (EosMarker)
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRsb request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toRsb_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toRsb_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: toRsb_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: toRsb_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toRsb_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toRsb_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toRsb :: toRsb <tableNm> ;

: toRsb _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
