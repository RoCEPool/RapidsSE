/*============================================================================*/
/* OP_dumptbl.sen -- Operator dump table                                      */
/*============================================================================*/

" OP_dumpTbl.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: dumpTbl_action

  <tableNm> op__table if
    table[].dump
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: dumpTbl :: dumpTbl <tableNm> ;

: dumpTbl opInfo tagCopy: localLiteOp_tags
  tags{
    <jobDesc>     = "--description of operator--"
    <localLiteOp> = true
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
