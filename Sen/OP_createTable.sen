/*============================================================================*/
/* OP_createTable.sen -- Operator create table                                */
/*============================================================================*/

" OP_createTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a creatable table                                    */
/*----------------------------------------------------------------------------*/
: createTable::checkCreate2 ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then

  // error if given name already exists
  <tableNm> check::nameIsUnknownTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* create table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: createTable::createNamedTable2

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse cmd and create table definition
  <etc> <tableNm> "create table %v %v ;" str.format
  job[] tableDef::parse locals| pTableDef |

  // check for error while parsing tabledef
  job[] job.hasError if
    DdlLock[].testDrop
    !!logError
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  pTableDef <tableNm> table::createTable locals| pTable |

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: createTable_PulseMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check create table syntax
  <etc> <tableNm> "create table %v %v;" str.format
  TableDef::syntax dup EC_NONE != if  ( errorCode )
    "GOT ERROR" .
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in tables
  folder[].isTables assert

  // grab the ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check there are enough buffers
  node::checkEnoughBuffers not if ( errorCode )
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check ok to create table
  createTable::checkCreate2 not if ( errorCode )
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table
  createTable::createNamedTable2

  // should be in tables
  folder[].isTables assert

  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: createTable2_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: createTable_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: createTable2 :: createTable2 <tableNm> <etc> ;

: createTable2 _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--description of operator--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
