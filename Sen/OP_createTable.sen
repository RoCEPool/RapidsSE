/*============================================================================*/
/* OP_createTable.sen -- Operator create table                                */
/*============================================================================*/

" OP_createTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a creatable table                                    */
/*----------------------------------------------------------------------------*/
: createTable::checkCreate ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then

  // error if given name already exists
  <tableNm> check::nameIsUnknownTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* create table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: createTable::createNamedTable

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse cmd and create table definition
  //<etc> <tableNm> "create table %v %v ;" str.format
  //job[] tableDef::parse locals| pTableDef |

  //pTableDef not if  ( errorCode )
  //  job[] job.error@
  //  false
  //  exit
  //then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  streamDef[] <tableNm> table::createTable to table[]
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: createTable_StreamDef

  // get the stream def
  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  // grab the ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check ok to create table
  createTable::checkCreate not if ( errorCode )
    op.pipelineJob@ ERROR_JOB
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table
  createTable::createNamedTable

  // should be in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: createTable_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: createTable_StreamDef ZK_STREAMDEF op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: createTable :: createTable <tableNm> ;

: createTable _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--description of operator--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
