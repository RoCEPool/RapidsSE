/*============================================================================*/
/* jobInfix.sen -- Job Infixes                                                */
/*============================================================================*/

" jobInfix.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: _lock_exe_

  "ddlLock" <jobNm> findJobClassEnmSet EnameSet.getStr

  "DL_GRAB_WRITE"
  str.equal if
    //"would grab ddl write lock" .
    ddlLock::grabWrite
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: _path_set_

  job::this job.pushPath task::dicStack.set
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

: _req_prep_
;

: _req_post_

  // distribute the job as to all connected node as participants
  job::distribute

  // wait for ack from deciding job__Ended
  task::wait
;

: _exe_prep_
;
: _exe_post_
;
: _beg_prep_
;
: _beg_post_
;
: _end_prep_
;
: _end_post_
;
: _can_prep_
;
: _can_post_
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
