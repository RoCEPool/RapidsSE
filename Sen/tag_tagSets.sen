/*============================================================================*/
/* tag_tagSets.sen -- tag sets                                                */
/*============================================================================*/

" tag_tagSets.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job_tags
  tags{
    <job> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: distJob_tags
  tags{
    <distJob> = 1
    <jobKind>  = JK_DIST2PC
  }
;
        
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: genericJob_tags
  tags{
    <genericJob> = 1
    <jobKind>  = JK_GENERIC
  }
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: opCmd_tags
  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
    <ddlLock>  = DL_GRAB_READ
    
    <op> = true

    <preCheck> = bClusterStarted
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: liteOp_cmdTags tagCopy: opCmd_tags
  tags{
    <liteOp> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localLiteOp_cmdTags tagCopy: opCmd_tags
  tags{
    <localLiteOp> = 1
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
