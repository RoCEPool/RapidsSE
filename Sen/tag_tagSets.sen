/*============================================================================*/
/* tag_tagSets.sen -- tag sets                                                */
/*============================================================================*/

" tag_tagSets.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job_tags
  tags{
    <job> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: distJob_tags
  tags{
    <distJob> = 1
    <jobKind>  = JK_DIST2PC
  }
;
        
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: genericJob_tags
  tags{
    <genericJob> = 1
    <jobKind>  = JK_GENERIC
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localJob_tags
  tags{
    <localJob> = 1
    <jobKind>  = JK_LOCAL
  }
;
        

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: operator_tags
  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
    <ddlLock>  = DL_GRAB_READ
    
    <preCheck> = bClusterStarted
  }
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: op_tags tagCopy: operator_tags
  tags{
    <op> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: liteOp_tags tagCopy: operator_tags
  tags{
    <liteOp> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localLiteOp_tags tagCopy: operator_tags
  tags{
    <localLiteOp> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: serviceOp_tags tagCopy: op_tags
  tags{
    <serviceOp> = 1
    
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
