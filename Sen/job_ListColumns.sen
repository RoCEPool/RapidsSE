/*============================================================================*/
/* job_ListColumns.sen -- Job list Columns                                    */
/*============================================================================*/

" job_ListColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* list columns of a table                                                    */
/*----------------------------------------------------------------------------*/
: listColumns ( "<tableNm>" Job_ListColumns -- )

  params|  pJob_ListColumns sTableNm |

  0 0 0 locals| pColumn iColumns pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table
  sTableNm find execute to pTable

  pTable >str pJob_ListColumns job.response!
;

/*----------------------------------------------------------------------------*/
/* List Columns requests (on the originating node)                            */
/*----------------------------------------------------------------------------*/
: listColumns_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 0 0 locals| sTableNm iCount pJob_ListColumns pTask |

  tp: listColumns_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListColumns

  //----------------------------------------------------------------------------
  // set task's dictionary stack from path in job
  pJob_ListColumns job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab ddl read lock
  ddlLock::grabRead

  //----------------------------------------------------------------------------
  // should be in the tables folder
  checkInTables not if pJob_ListColumns <ERROR_REQUEST> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table name from job
  pJob_ListColumns job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_ListColumns <ERROR_REQUEST> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm checkIsTable not if popTable pJob_ListColumns <ERROR_REQUEST> !!am exit then

  args.metadata if
    "(columnNo INTEGER, columnName VARCHAR, columnType VARCHAR, columnLength INTEGER, columnScale INTEGER, isNull boolean, isPartitionKey boolean)"
        pJob_ListColumns job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list table columns
  sTableNm pJob_ListColumns listColumns

  //----------------------------------------------------------------------------
  // pop table dictionary
  popTable
  assertInTables

  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
