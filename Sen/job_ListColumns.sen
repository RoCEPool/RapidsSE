/*============================================================================*/
/* job_ListColumns.sen -- Job list Columns                                    */
/*============================================================================*/

" job_ListColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* list columns of a table                                                    */
/*----------------------------------------------------------------------------*/
: listColumns ( "<tableNm>" Job_ListColumns -- )

  params|  pJob_ListColumns sTableNm |

  0 0 0 locals| pColumn iColumns pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table
  sTableNm find execute to pTable

  pTable table.columnCount@ to iColumns

  ""                             // initial ls string
  iColumns 0 do
    I pTable table.column@ to pColumn
    pColumn column.isPartitionKey@
    pColumn column.isNullable@
    pColumn column.Scale@
    pColumn column.Length@
    pColumn column.type@
    pColumn column.name@
    "row: ( '%v','%v',%v,%v,%v,%v )\n" str.format
    str.cat
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set response in the job
  pJob_ListColumns job.response!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // sent rows Processed in the job
  iColumns pJob_ListColumns job.rowsProcessed!

;

/*----------------------------------------------------------------------------*/
/* List Columns requests (on the originating node)                            */
/*----------------------------------------------------------------------------*/
: lscol_req ( -- <R> )

  >>logEntry <SEED_REQ>

  0 0 0 0 locals| sTableNm iCount pJob_ListColumns pTask |

  tp: listColumns_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListColumns

  //----------------------------------------------------------------------------
  // should be in the tables folder
  checkInTables not if pJob_ListColumns <ERROR_REQUEST> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table name from job
  //pJob_ListColumns job.objectName@ to sTableNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_ListColumns <ERROR_REQUEST> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm checkIsTable not if popTable pJob_ListColumns <ERROR_REQUEST> !!logError exit then

  args.metadata if
    "(columnNo INTEGER, columnName VARCHAR, columnType VARCHAR, columnLength INTEGER, columnScale INTEGER, isNull boolean, isPartitionKey boolean)"
        pJob_ListColumns job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list table columns
  sTableNm pJob_ListColumns listColumns

  //----------------------------------------------------------------------------
  // pop table dictionary
  popTable
  assertInTables

  <<logExit <DONE_REQ>

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: lscol :: lscol <tableNm> ;

jobInfo: lscol
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_LOCAL_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
