/*============================================================================*/
/* unitTests.sen -- unit testing                                              */
/*============================================================================*/

" unitTests.sen" .verbose

"arithmeticTests.sen" include

"flowTests.sen" include

"logicTests.sen" include

: ut

  "unit testing..." .put .\n

  logicTests

  arithmeticTests

  flowTests

  "unit tests passed" .put .\n
;

