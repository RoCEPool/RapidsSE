/*============================================================================*/
/* OP_spawnNode.sen -- Operator Spawn Node                                    */
/*============================================================================*/

" OP_spawnNode.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: spawnNode_DataPulse \handler
 
  "addNode_DataPulse" .

  false <nodeNm> .formNodeList .spawnNamedNode
   
  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* execute for spawn node                             (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : spawnNode_req \operator
 
  LogReqEntry SEED_REQ

  <nodeNm> .

  op__topology

  find: spawnNode_DataPulse ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: spawnNode :: spawnNode <nodeNm> ;

: spawnNode _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
