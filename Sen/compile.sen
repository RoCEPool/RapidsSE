/*============================================================================*/
/* compile.sen -- compile the dictionary                                      */
/*============================================================================*/

"compile.sen" .verbose

//
// step 1: compile all the words
//

"core.sen" include
"common.sen" include
"structures.sen" include
"tasks.sen" include
"threads.sen" include
"transactions.sen" include
"interface.sen" include
"systemObjects.sen" include
"gridModel.sen" include
"dbobjects.sen" include
"actors.sen" include
"utilities.sen" include
"requests.sen" include
"operators.sen" include
"planners.sen" include
"munge.sen" include
"testing.sen" include
assert.stack_0

//
// step 2: runs some basic tests
//

//ut

assert.stack_0

//
// step 3: spawn the root thread
//

( spawn the posix thread for the root thread )
rootThread thread.spawn

( leave root thread on stack )
rootThread

assert.stack_1

: __compiled__ ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
