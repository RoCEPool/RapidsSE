/*============================================================================*/
/* db_table.sen -- table related words                                        */
/*============================================================================*/

" db_table.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the table category                                                         */
/*----------------------------------------------------------------------------*/
: \table \\category ;

/*----------------------------------------------------------------------------*/
/* check word is not known (specifically not a known table)                EC */
/*----------------------------------------------------------------------------*/
: name::isNotKnownTable params| sTableNm | ( t | ec f )

  sTableNm folder[].findSymbol not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* test if word is a table (is of \table category)                            */
/*----------------------------------------------------------------------------*/
: word.isaTable params| pwTable | ( t | f )

  pwTable word.category@ find: \table eql
;

/*----------------------------------------------------------------------------*/
/* find the named table folder and push it onto task dictionary               */
/*----------------------------------------------------------------------------*/
: path[].pushNamedTableFolder params| sTblFolderNm |

  sTblFolderNm find execute path[].pushFolder
;

/*----------------------------------------------------------------------------*/
/* pop current folder (which was pushed by path[].pushNamedTableFolder)       */
/*----------------------------------------------------------------------------*/
: path[].popNamedTableFolder ( -- )

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* test if current folder has the name "tables" (i.e. is ../tables)           */
/*----------------------------------------------------------------------------*/
: folder[].isTables ( t | f )

  folder[] dic.name@ "tables" str.equal
;

/*----------------------------------------------------------------------------*/
/* check current folder has the name "tables" (i.e. is ../tables)          EC */
/*----------------------------------------------------------------------------*/
: folder[].checkIsTables ( t | ec f )

  folder[].isTables if true exit then

  EC_NOT_IN_TABLES false
;

/*----------------------------------------------------------------------------*/
/* check there is a table folder with given name                           EC */
/*----------------------------------------------------------------------------*/
: folder[].checkNamedTableFolder params| sTblFolderNm | ( t | ec f )

  sTblFolderNm folder[].findSymbol not if EC_NO_SUCH_TABLE false exit then
  true
;

/*----------------------------------------------------------------------------*/
/* check if column is a valid column of the table                          EC */
/*----------------------------------------------------------------------------*/
: name::checkIsColumn params| sTableNm sColumnNm | ( t | ec f )

  0 locals| pTable |

  sTableNm find execute to pTable
  sColumnNm pTable table.isColumn if true exit then

  EC_INVALID_COLUMN false
;

/*----------------------------------------------------------------------------*/
/* check given name is the name of a word of \table category               EC */
/*----------------------------------------------------------------------------*/
: name::checkIsaTable params| sTableNm | ( t | ec f )

  sTableNm find locals| pwTable |

  pwTable not if EC_NO_SUCH_TABLE false exit then

  pwTable word.category@ find: \table eql if true exit then

  EC_NOT_A_TABLE false
;

/*----------------------------------------------------------------------------*/
/* check if given name is a valid table assembly                           EC */
/*----------------------------------------------------------------------------*/
: table::checkValidTableAssembly params| sTableNm | ( t | ec f )

  // check we are in tables folder
  folder[].checkIsTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if discard EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushNamedTableFolder

  // check if sTableNm translates to a word of \table category
  sTableNm name::checkIsaTable not if path[].popNamedTableFolder false exit then
 
  // pop table folder
  path[].popNamedTableFolder

  // assert we are back in tables
  folder[].isTables assert

  true
;

