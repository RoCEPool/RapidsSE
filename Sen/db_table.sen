/*============================================================================*/
/* db_table.sen -- table related words                                        */
/*============================================================================*/

" db_table.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the table category                                                         */
/*----------------------------------------------------------------------------*/
: \table \\category ;

/*----------------------------------------------------------------------------*/
/* test if word is a table (is of \table category)                            */
/*----------------------------------------------------------------------------*/
: word.isaTable params| pwTable | ( t | f )

  pwTable word.category@ find: \table eql
;

/*----------------------------------------------------------------------------*/
/* test if current folder has the name "tables" (i.e. is ../tables)           */
/*----------------------------------------------------------------------------*/
: folder[].isTables ( t | f )

  folder[] dic.name@ "tables" str.same
;

/*----------------------------------------------------------------------------*/
/* find the named table folder and push it onto task dictionary               */
/*----------------------------------------------------------------------------*/
: path[].pushNamedTableFolder params| sTblFolderNm |

  sTblFolderNm find execute path[].pushFolder
;

/*----------------------------------------------------------------------------*/
/* pop current folder (which was pushed by path[].pushNamedTableFolder)       */
/*----------------------------------------------------------------------------*/
: path[].popNamedTableFolder ( -- )

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* check current folder has the name "tables" (i.e. is ../tables)          EC */
/*----------------------------------------------------------------------------*/
: check::folderIsTables ( t | ec f )

  folder[].isTables if true exit then

  EC_NOT_IN_TABLES false
;

/*----------------------------------------------------------------------------*/
/* check there is a table folder with given name                           EC */
/*----------------------------------------------------------------------------*/
: check::folderHasNamedTable params| sTblFolderNm | ( t | ec f )

  sTblFolderNm folder[].findSymbol not if EC_NO_SUCH_TABLE false exit then
  true
;

/*----------------------------------------------------------------------------*/
/* check word is not known (specifically not a known table)                EC */
/*----------------------------------------------------------------------------*/
: check::nameIsUnknownTable params| sTableNm | ( t | ec f )

  sTableNm folder[].findSymbol not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check given name is the name of a word of \table category               EC */
/*----------------------------------------------------------------------------*/
: check::nameIsaTable params| sTableNm | ( t | ec f )

  sTableNm find locals| pwTable |

  pwTable not if EC_NO_SUCH_TABLE false exit then

  pwTable word.category@ find: \table eql if true exit then

  EC_NOT_A_TABLE false
;

/*----------------------------------------------------------------------------*/
/* check if column is a valid column of the table                          EC */
/*----------------------------------------------------------------------------*/
: check::nameIsColumn params| sTableNm sColumnNm | ( t | ec f )

  0 locals| pTable |

  sTableNm find execute to pTable
  sColumnNm pTable table.isColumn if true exit then

  EC_INVALID_COLUMN false
;

/*----------------------------------------------------------------------------*/
/* check if given name is a valid table assembly                           EC */
/*----------------------------------------------------------------------------*/
: check::validTableAssembly params| sTableNm | ( t | ec f )

  // check we are in tables folder
  check::folderIsTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if discard EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushNamedTableFolder

  // check if sTableNm translates to a word of \table category
  sTableNm check::nameIsaTable not if path[].popNamedTableFolder false exit then
 
  // pop table folder
  path[].popNamedTableFolder

  // assert we are back in tables
  folder[].isTables assert

  true
;


/*----------------------------------------------------------------------------*/
/*                          -- Create Table Support --                        */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make the "tables" folder under given named schema folder                   */
/*----------------------------------------------------------------------------*/
: table::makeTablesFolder params| sSchFolderNm |

  args.tracepoint if
    "MAKING TABLES FOLDER FOR SCHEMA " sSchFolderNm str.cat
      " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  sSchFolderNm find execute locals| pwSchemaFolder |
  "tables" pwSchemaFolder folder::makeSubFolder
;

/*----------------------------------------------------------------------------*/
/* make a table folder under a tables folder                                  */
/*----------------------------------------------------------------------------*/
: table::makeNamedTableFolder params| sTblFolderNm |

  args.tracepoint if
    "MAKING TABLE " sTblFolderNm str.cat
     " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // make: ../schemas/public/tables/t \folder
  sTblFolderNm folder[] folder::makeSubFolder
;

/*----------------------------------------------------------------------------*/
/* new a c++ Table instance using given table name                            */
/*----------------------------------------------------------------------------*/
: table::newTable params| sTableNm | ( pTable )

  find: \table locals| pwTableCatg |

  sTableNm table::new locals| pTable |

  sTableNm word::new locals| pwTable |

  pwTableCatg pTable pwTable word.cppObject!

  //pwTable word.see

  pwTable execute locals| pTable |

  pTable
;

/*----------------------------------------------------------------------------*/
/* make a table assembly (along with indexes sub-assembly)                    */
/*----------------------------------------------------------------------------*/
: table::makeTableAssembly params| sTableNm pTableDef | ( pTable )

 sTableNm table::makeNamedTableFolder

 sTableNm path[].pushNamedTableFolder

 sTableNm "index::makeIndexesAssembly" find execute

 sTableNm table::newTable locals| pTable |

 pTableDef pTable table.tableDef!

 pTable table.createPtnDef

 path[].popNamedTableFolder

 pTable
;

/*----------------------------------------------------------------------------*/
/* create a table using given table definition                                */
/*----------------------------------------------------------------------------*/
: table::createTable params| sTableNm pTableDef | ( pTable )

 folder[].isTables assert
 sTableNm name::isSubFolder not assert

 pTableDef sTableNm table::makeTableAssembly locals| pTable |

 folder[].isTables assert
 sTableNm name::isSubFolder assert

 pTable
;


/*----------------------------------------------------------------------------*/
/*                          -- Drop Table Support --                          */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* delete C++ Table object & its forget word                                  */
/*----------------------------------------------------------------------------*/
: table::deleteTable params| sTableNm |

  sTableNm find execute table::delete

  sTableNm :forget
;

/*----------------------------------------------------------------------------*/
/* remove a table assembly (along with indexes sub-assembly)                  */
/*----------------------------------------------------------------------------*/
: table::removeTableAssembly params| sTableNm |

  // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables

  // push to named table folder
  sTableNm path[].pushNamedTableFolder

  // ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++ ++

    // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables/t

    // remove the index sub-assembly for this table
    "index::removeIndexesAssembly" find execute

    // delete c++ Table object and forget the table word
    sTableNm table::deleteTable

    // pop back to table
    path[].popNamedTableFolder

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables

  // forget the named table folder
  sTableNm folder::remove
;


/*----------------------------------------------------------------------------*/
/* drop named table (remove the table assembly and indexes sub-assembly)      */
/*----------------------------------------------------------------------------*/
: table::dropTable params| sTableNm |

  /*
   * This is called from : dropTable_PulseMarker in procedure drop table
   *
   * At this stage the table (and its indexes) will have been truncated
   * All that remains to be done is remove the table and indexes assemblies
   *
   */

  // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables

  sTableNm name::isSubFolder assert

  sTableNm table::removeTableAssembly

  sTableNm name::isSubFolder not assert
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
