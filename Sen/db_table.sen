/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make a tables folder under given named schema                              */
/*----------------------------------------------------------------------------*/
: table::makeTablesFolder params| sSchemaNm |

  args.tracepoint if
    "MAKING TABLES FOR SCHEMA " sSchemaNm str.cat
      " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  sSchemaNm find execute locals| pSchemaFolder |
  "tables" pSchemaFolder folder::makeSubFolder
;

/*----------------------------------------------------------------------------*/
/* make a tableNm folder under tables                                         */
/*----------------------------------------------------------------------------*/
: table::makeTableFolder params| sTableNm |

  args.tracepoint if
    dup "MAKING TABLE " sTableNm str.cat
     " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // make: ../schemas/public/tables/t \folder
  sTableNm folder[] folder::makeSubFolder
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: table::newTableEmbObj params| sTableNm |

  find: \table CN_TABLE sizeof_table sTableNm :createObject locals| pwTable |

  compiler::current@ word.embObject table.init
  true compiler::current@ word.embObject object.wordbody!

  pwTable
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: table::newTablePrpObj params| sTableNm |

  find: \table locals| pTableCatg |

  table::new locals| pTable |

  sTableNm word::new locals| pwTable |

  pTableCatg pTable pwTable word.cppObject!

  pwTable
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: table::newTable params| sTableNm |

  sTableNm table::newTableEmbObj locals| pwTable |

  pwTable execute locals| pTable |

  pTable
;

/*----------------------------------------------------------------------------*/
/* create the table                                                           */
/*----------------------------------------------------------------------------*/
: table::createTable params| sTableNm pTableDef |

 folder[].isTables assert

 sTableNm table::makeTableFolder

 sTableNm path[].pushNamedTableFolder

 sTableNm "index::makeIndexesFolder" find execute

 sTableNm table::newTable locals| pTable |

 pTableDef pTable table.tableDef!

 pTable table.createPtnDef

 pTable
;

/*----------------------------------------------------------------------------*/
/* delete C++ Table object & its forget word                         EMBEDDED */
/*----------------------------------------------------------------------------*/
: table::deleteTableEmbObj params| sTableNm |

  sTableNm :forget
;

/*----------------------------------------------------------------------------*/
/* delete C++ Table object & its forget word                           PROPER */
/*----------------------------------------------------------------------------*/
: table::deleteTablePrpObj params| sTableNm |
 
  0 assert
;

/*----------------------------------------------------------------------------*/
/* delete C++ Table object & its forget word                                  */
/*----------------------------------------------------------------------------*/
: table::deletetable params| sTableNm |

  sTableNm table::deleteTableEmbObj
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: table::dropTable params| sTableNm |

  0 locals| pTable |

  // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables

  // push to table folder
  sTableNm path[].pushNamedTableFolder

  "index::removeIndexesFolder" find execute

  // delete Table object and forget the table word
  sTableNm table::deletetable

  // pop table
  path[].popNamedTableFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables

  // forget the table folder itself
  sTableNm folder::remove
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
