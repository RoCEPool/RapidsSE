/*============================================================================*/
/* db_table.sen -- table related words                                        */
/*============================================================================*/

" db_table.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the table category                                                         */
/*----------------------------------------------------------------------------*/
: \table \\category ;

/*----------------------------------------------------------------------------*/
/* check word is not a known table/symbol                                     */
/*----------------------------------------------------------------------------*/
: name::isNotKnownTable ( "<wordNm>" -- t|f )

  folder[].findSymbol not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* test if word is a table                                                    */
/*----------------------------------------------------------------------------*/
: word.isaTable

  word.category@ find: \table eql
;

/*----------------------------------------------------------------------------*/
/* find the table folder and push it onto task dictionary                     */
/*----------------------------------------------------------------------------*/
: path[].pushNamedTableFolder ( "<tableName>" -- )

  find execute path[].pushFolder
  true
;

/*----------------------------------------------------------------------------*/
/* pop the folder (which was pushed by path[].pushNamedTableFolder)           */
/*----------------------------------------------------------------------------*/
: path[].popNamedTableFolder

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* test if current folder is ../tables                                        */
/*----------------------------------------------------------------------------*/
: folder[].isTables ( -- t|f )

  folder[] dic.name@ "tables" str.equal
;

/*----------------------------------------------------------------------------*/
/* check current folder is ../tables                                          */
/*----------------------------------------------------------------------------*/
: folder[].checkIsTables ( -- t|f )

  folder[].isTables if true exit then

  EC_NOT_IN_TABLES false
;

/*----------------------------------------------------------------------------*/
/* check there is a table folder                                              */
/*----------------------------------------------------------------------------*/
: folder[].checkNamedTableFolder  ( "<tableName>" -- )

  folder[].findSymbol not if EC_NO_SUCH_TABLE false exit then
  true
;

/*----------------------------------------------------------------------------*/
/* check if column is a valid column of the table                             */
/*----------------------------------------------------------------------------*/
: name::checkIsColumn ( "<columnNm>" "<tableNm>" -- t|f )

  params| sTableNm sColumnNm |
  0 locals| pTable |

  sTableNm find execute to pTable
  sColumnNm pTable table.isColumn if true exit then

  EC_INVALID_COLUMN false
;

/*----------------------------------------------------------------------------*/
/* check given name is a table                                                */
/*----------------------------------------------------------------------------*/
: name::checkIsaTable ( "<tableNm>" -- true | errorCode false )

  find ( "<tableNm>" ^w:table )

  dup ( "<tableNm>" ^w:table ^w:table )
  not ( "<tableNm>" ^w:table bool )
  if
    discard ( "<tableNm>" )
    discard ( )
    EC_NO_SUCH_TABLE false ( errorCode false )
    exit
  then

  dup ( "<tableNm>" ^w:table ^w:table )

  word.category@ ( "<tableNm>" ^w:table ^word )
  find: \table ( "<tableNm>" ^w:table ^word ^word )
  eql ( "<tableNm>" ^w:table bool )
  if
    discard ( "<tableNm>" )
    true ( "<tableNm>" true )
    exit
  then

  discard ( "<tableNm>" )
  discard ( )
  EC_NOT_A_TABLE false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check if word is a table                                                   */
/*----------------------------------------------------------------------------*/
: name::checkIsValidTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  folder[].checkIsTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if discard EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushNamedTableFolder assert

  sTableNm name::checkIsaTable not if path[].popNamedTableFolder false exit then
  //sTableNm tableInUse if path[].popNamedTableFolder EC_TABLE_IN_USE false exit then

  // pop table folder
  path[].popNamedTableFolder

  // assert in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* check if sTableNm is a removable table folder                              */
/*----------------------------------------------------------------------------*/
: table::checkRemovableFolder params| sTableNm | ( true | errorCode false )

  // check in tables folder
  folder[].checkIsTables not if "X1" . false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if "X2" . discard EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushNamedTableFolder assert

  sTableNm name::checkIsaTable not if "X3" . path[].popNamedTableFolder false exit then
  //sTableNm tableInUse if path[].popNamedTableFolder EC_TABLE_IN_USE false exit then

  // pop table folder
  path[].popNamedTableFolder

  // assert in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make a tables folder under given named schema                              */
/*----------------------------------------------------------------------------*/
: table::makeTablesFolder ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING TABLES FOR SCHEMA " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "tables"     ( dic "tables" )
  swap         ( "tables" dic )
  folder::makeSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* make a tableNm folder under tables                                         */
/*----------------------------------------------------------------------------*/
: table::makeNamedFolder ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING TABLE DIC " swap str.cat
     " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // make: ../schemas/public/tables/t \folder
  folder[] folder::makeSubFolder
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: table::newTableEmbObj params| sTableNm |

  find: \table CN_TABLE sizeof_table sTableNm :createObject locals| pwTable |

  compiler::current@ word.embObject table.init
  true compiler::current@ word.embObject object.wordbody!

  pwTable
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: table::newTablePrpObj params| sTableNm |

  find: \table locals| pTableCatg |

  table::new locals| pTable |

  sTableNm word::new locals| pwTable |

  pTableCatg pTable pwTable word.cppObject!

  pwTable // returns:
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: table::newTable params| sTableNm |

  sTableNm table::newTableEmbObj locals| pwTable |

  pwTable execute locals| pTable |

  pTable
;

/*----------------------------------------------------------------------------*/
/* make a table (run by all participants)                                     */
/*----------------------------------------------------------------------------*/
: table::makeTable_NEEDS_WORK params| sTableNm |

  args.tracepoint if
    sTableNm "MAKING TABLE " swap str.cat
    " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // make the table dictionary
  sTableNm table::makeNamedFolder

  // make the indexes dictionary
  sTableNm path[].pushNamedTableFolder assert
  sTableNm "index::makeIndexesFolder" find execute

  // create the table
  sTableNm table::newTable locals| pTable |

  // return table pointer
  pTable
;

/*----------------------------------------------------------------------------*/
/* create the table proper                                                    */
/*----------------------------------------------------------------------------*/
: table::createTable params| sTableNm pTableDef |

 sTableNm table::makeTable_NEEDS_WORK locals| pTable |

 pTableDef pTable table.tableDef!

 // add partition columns
 pTable table.createPtnDef
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: table::removeTable_NEEDS_WORK params| sTableNm |

  0 locals| pTable |

//"A" . //symbols
  // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // move to table folder
  sTableNm path[].pushNamedTableFolder assert

//"B" . //symbols
  // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables/t
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // forget the words in the indexes folder
  "indexes" find execute folder.forgetAllWords
//"C1" . //symbols

  // forget the indexes folder itself
  "indexes" folder::remove
//"C2" . //symbols

  // forget the partitions folder itself
  //"partitions" folder::remove
//"C3" . //symbols

  // forget the table itself
  //sTableNm folder::remove
  sTableNm :forget

//"C4" . //symbols

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  path[].popNamedTableFolder

//"D" . //symbols
  // path: /tenants/boray/catalogs/rapidsse/schemas/public/tables

  // forget the table folder itself
  sTableNm folder::remove

//"E" . //symbols
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
