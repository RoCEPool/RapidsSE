/*============================================================================*/
/* db_table.sen -- table related words                                        */
/*============================================================================*/

" db_table.sen" .verbose

/*----------------------------------------------------------------------------*/
/* table is used as a kind of word to identify tables                         */
/*----------------------------------------------------------------------------*/
: table ;

//: makeTables path[].push "tables" :dic find: folder swap execute dic.kind! path[].discard ;

/*----------------------------------------------------------------------------*/
/* make a tables folder under given named schema                              */
/*----------------------------------------------------------------------------*/
: makeTables ( "<schemaNm>" -- )

  args.tracepoint if
    dup "MAKING TABLES FOR SCHEMA " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "tables"     ( dic "tables" )
  swap         ( "tables" dic )
  :createSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* make a tableNm folder under tables                                         */
/*----------------------------------------------------------------------------*/
: makeTableDic ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING TABLE DIC " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  folder[]
  :createSubFolder    ( )
;


: isTable word.category@ find: table eql ;

/*----------------------------------------------------------------------------*/
/* create a table using name from input stream (doesnt leave table on stk)    */
/*----------------------------------------------------------------------------*/
: table:

  createPersistent
  WK_OBJECT compiler::current@ word.kind!
  sizeof_table allot

  compiler::current@ word.embObject object.magic!
  CN_TABLE compiler::current@ word.embObject object.class!

  compiler::current@ word.embObject table.init

  true compiler::current@ word.embObject object.wordbody!
  find: table compiler::current@ word.category!

  does>
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: :table

  >createPersistent
  WK_OBJECT compiler::current@ word.kind!
  sizeof_table allot

  compiler::current@ word.embObject object.magic!
  CN_TABLE compiler::current@ word.embObject object.class!

  compiler::current@ word.embObject table.init

  true compiler::current@ word.embObject object.wordbody!
  find: table compiler::current@ word.category!

  compiler::current@
  does>
;

/*----------------------------------------------------------------------------*/
/* test if this task dic path ends in tables                                  */
/*----------------------------------------------------------------------------*/
: withinTables ( -- t|f )

  folder[] dic.name "tables" str.equal
;

/*----------------------------------------------------------------------------*/
/* assert top of task dictionary stack is tables                              */
/*----------------------------------------------------------------------------*/
: assertInTables ( -- t|f )

  withinTables assert
;

/*----------------------------------------------------------------------------*/
/* check top of task dictionary stack is tables                               */
/*----------------------------------------------------------------------------*/
: checkInTables ( -- t|f )

  withinTables if true exit then

  EC_NOT_IN_TABLES false
;

/*----------------------------------------------------------------------------*/
/* check if column is a valid column of the table                             */
/*----------------------------------------------------------------------------*/
: checkIsColumn ( "<columnNm>" "<tableNm>"-- t|f )

  params| sTableNm sColumnNm |
  0 locals| pTable |

  sTableNm find execute to pTable
  sColumnNm pTable table.isColumn if true exit then

  EC_INVALID_COLUMN false
;

/*----------------------------------------------------------------------------*/
/* test if this task dic path is same name as argument                        */
/*----------------------------------------------------------------------------*/
: withinTable ( "<tableNm>" -- t|f )

  assert::stack_1+
  CN_STZVAL assert::class_0

  // assert dictionary path
  path[].depth assert

  folder[] dic.name str.equal
;

/*----------------------------------------------------------------------------*/
/* check top of task dictionary stack is given table name                     */
/*----------------------------------------------------------------------------*/
: checkInTable ( "<tableNm>" -- t|f )

  withinTable if true exit then

  EC_NOT_IN_TABLE false
;

/*----------------------------------------------------------------------------*/
/* check given name is a table                                                */
/*----------------------------------------------------------------------------*/
: checkIsTable ( "<tableNm>" -- true | errorCode false )

  find ( "<tableNm>" ^w:table )

  dup ( "<tableNm>" ^w:table ^w:table )
  not ( "<tableNm>" ^w:table bool )
  if
    drop ( "<tableNm>" )
    drop ( )
    EC_NO_SUCH_TABLE false ( errorCode false )
    exit
  then

  dup ( "<tableNm>" ^w:table ^w:table )

  word.category@ ( "<tableNm>" ^w:table ^word )
  find: table ( "<tableNm>" ^w:table ^word ^word )
  eql ( "<tableNm>" ^w:table bool )
  if
    drop ( "<tableNm>" )
    true ( "<tableNm>" true )
    exit
  then

  drop ( "<tableNm>" )
  drop ( )
  EC_NOT_A_TABLE false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check there is a table folder                                              */
/*----------------------------------------------------------------------------*/
: checkIsTableFolder  ( "<tableName>" -- )

  findInCurrent not if EC_NO_SUCH_TABLE false exit then
  true
;

/*----------------------------------------------------------------------------*/
/* find the table folder and push it onto task dictionary                     */
/*----------------------------------------------------------------------------*/
: pushTable ( "<tableName>" -- )

  find execute path[].push
  true
;

/*----------------------------------------------------------------------------*/
/* pop the table folder                                                       */
/*----------------------------------------------------------------------------*/
: popTable

  path[].discard
;

/*----------------------------------------------------------------------------*/
/* check if word is a table                                                   */
/*----------------------------------------------------------------------------*/
: checkIsValidTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if drop EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* find table given its name                                                  */
/*----------------------------------------------------------------------------*/
: table::find ( sTableNm -- pTable )

  dup "table::find %v" str.format .logNote

  find execute
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
