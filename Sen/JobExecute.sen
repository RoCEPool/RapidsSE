/*============================================================================*/
/* JobExecute.sen -- Decode and execute received jobs                         */
/*============================================================================*/

"JobExecute.sen" .verbose

1 constant SEED1
2 constant SEED2

/*----------------------------------------------------------------------------*/
/* execute/begin a new job                                                    */
/*----------------------------------------------------------------------------*/
: job.beginExecute ( pJob -- )

  locals| pJob |

  0 0 locals| sCheckResources pJobBegun |

    pJob object.class@ class::name
    grid::thisNode@
    "Node %v Job %v Received"
  fmt.print

  // set participant node in job
  grid::thisNode@ pJob job.participant!

  // add job as participant job
  pJob job.addParticipant

  // change state of job to begun
  //pJob job.begun

  // execute the job's checkResources command
  pJob job.checkResources@ to sCheckResources
  sCheckResources "" str.equal not if
    pJob sCheckResources find execute
  then

  // send job__begun back to originating node
  pJob job.id@ pJob "Job__Begun::send" find execute
;

/*----------------------------------------------------------------------------*/
/* execute generic job                                                        */
/*----------------------------------------------------------------------------*/
: job.genericExecute ( pJob -- )

  params| pJob |

    pJob object.class@ class::name
    grid::thisNode@
  "Node %v %v" fmt.print

  pJob job.id@ pJob pJob
    job.execute@ find execute
    //SEED2 job.spawn

  //pJob job.delete
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* execute job                                                                */
/*----------------------------------------------------------------------------*/
: job.execute ( pJob -- )

  params| pJob |

  0 locals| eJobClass |

  pJob job.class to eJobClass

  eJobClass case

    // specific cases
    CN_JOB__BEGUN     of pJob job.genericExecute pJob jobBegun.delete     endof
    CN_JOB__CANCEL    of pJob job.genericExecute pJob jobCancel.delete    endof
    CN_JOB__CANCELLED of pJob job.genericExecute pJob jobCancelled.delete endof
    CN_JOB__END       of pJob job.genericExecute pJob jobEnd.delete       endof
    CN_JOB__ENDED     of pJob job.genericExecute pJob jobEnded.delete     endof
    CN_JOB__EXECUTE   of pJob job.genericExecute pJob jobExecute.delete   endof
    CN_JOB__EXECUTED  of pJob job.genericExecute pJob jobExecuted.delete  endof

    // load buffer
    CN_JOB_LOADBUFFER of pJob
      pJob SEED2 job.spawn
    endof

    // default case
    pJob job.beginExecute

  endcase
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
