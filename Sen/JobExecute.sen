/*============================================================================*/
/* JobExecute.sen -- Decode and execute received jobs                         */
/*============================================================================*/

"JobExecute.sen" .verbose

1 constant SEED1
2 constant SEED2

/*----------------------------------------------------------------------------*/
/* begin a new job                                                            */
/*----------------------------------------------------------------------------*/
: job.begin ( pJob -- )

  locals| pJob |

  0 locals| sCheckResources |

    pJob object.class@ class::name
    grid::thisNode@
    "Node %v Job %v Received"
  fmt.print

  // set participant node in job
  grid::thisNode@ pJob job.participant!

  // add job as participant job
  pJob job.addParticipant

  // execute the job's checkResources command
  pJob job.checkResources@ to sCheckResources
  sCheckResources "" str.equal not if
    pJob sCheckResources find execute
  then

  // send job__begun back to originating node
  pJob job.id@ pJob "Job__Begun::send" find execute
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* execute job                                                                */
/*----------------------------------------------------------------------------*/
: job.execute ( pJob -- )

  params| pJob |

  0 locals| eJobClass |

  pJob job.class to eJobClass

  eJobClass case

    // specific cases
    CN_JOB__BEGUN     of pJob SEED2 job.spawn endof
    CN_JOB__CANCEL    of pJob SEED2 job.spawn endof
    CN_JOB__CANCELLED of pJob SEED2 job.spawn endof
    CN_JOB__END       of pJob SEED2 job.spawn endof
    CN_JOB__ENDED     of pJob SEED2 job.spawn endof
    CN_JOB__EXECUTE of
      pJob pJob job.execute@ find execute
      pJob job.delete
    endof
    CN_JOB__EXECUTED  of pJob SEED2 job.spawn endof

    // load buffer
    CN_JOB_LOADBUFFER of pJob SEED2 job.spawn endof

    // default case
    pJob job.begin

  endcase
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
