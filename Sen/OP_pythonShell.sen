/*============================================================================*/
/* OP_pythonShell.sen -- Operator pythonShell                                 */
/*============================================================================*/

" OP_pythonShell.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: pythonShell_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Pipein[]

  Operand[].csvData
  <pythonFile> Operand[].invokePythonShell

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
/*
: pythonShell_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  Pipein[].pipeOut

  true
;
*/

/*----------------------------------------------------------------------------*/
/* execute for pythonShell request                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pythonShell_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: pythonShell_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  //find: pythonShell_ErrorMarker ZK_ERRORMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: pythonShell :: pythonShell <pythonFile> ;

: pythonShell _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
