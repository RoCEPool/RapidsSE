/*============================================================================*/
/* OP_pythonShell.sen -- Operator pythonShell                                 */
/*============================================================================*/

" OP_pythonShell.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: pythonShellOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Operand[].csvData
  <pythonFile> Operand[].invokePythonShell

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: pythonShellOp_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: pythonShellOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: pythonShellOp_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for pythonShellOp request                  (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pythonShellOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: pythonShellOp_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: pythonShellOp_ErrorMarker ZK_ERRORMARKER op[].handler!
  find: pythonShellOp_StartMarker ZK_STARTMARKER op[].handler!
  find: pythonShellOp_ExitMarker  ZK_EXITMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: pythonShellOp :: pythonShellOp <pythonFile> ;

: pythonShellOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
