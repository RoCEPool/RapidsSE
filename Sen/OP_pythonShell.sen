/*============================================================================*/
/* OP_pythonShell.sen -- Operator pythonShell                                 */
/*============================================================================*/

" OP_pythonShell.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: pythonShellOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Operand[].csvData
  <pythonFile> Operand[].invokePythonShell

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: pythonShellOp_ErrorMarker \handler

  //"jobOperand::generic:- ZK_ERRORMARKER" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: pythonShellOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: pythonShellOp_StopMarker \handler

  //"Operand:- ZK_STOPMARKER" .verbose
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for pythonShellOp request                  (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pythonShellOp_req ( -- )

  LogReqEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER   of pythonShellOp_CsvBuffer   endof

      ZK_ERRORMARKER of pythonShellOp_ErrorMarker endof

      ZK_STARTMARKER of pythonShellOp_StartMarker endof

      ZK_STOPMARKER  of pythonShellOp_StopMarker  endof

      Operand[].delete
      true
      swap

    endcase

  while assert::stack_0 repeat

  LogReqExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: pythonShellOp :: pythonShellOp <pythonFile> ;

jobInfo: pythonShellOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
