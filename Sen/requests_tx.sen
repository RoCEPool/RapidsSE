/*============================================================================*/
/* requests_tx.sen -- the set of transaction related requests                 */
/*============================================================================*/

"requests_folder.sen" .verbose

/*----------------------------------------------------------------------------*/
/* begin a transaction                                                        */
/*----------------------------------------------------------------------------*/
: txBegin_req ( -- R )

  "begin transaction" .

  tx::begin locals| pTx |

  pTx task::this task.seitf@ seitf.tx!

  <OK>
;

/*----------------------------------------------------------------------------*/
/* commit a transaction                                                       */
/*----------------------------------------------------------------------------*/
: txCommit_req ( -- R )

  "commit transaction" .

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.commit

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end a transaction                                                          */
/*----------------------------------------------------------------------------*/
: txEnd_req ( -- R )

  "end transaction" .

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.free

  nullPtr task::this task.seitf@ seitf.tx!

  <OK>
;

/*----------------------------------------------------------------------------*/
/* rollback a transaction                                                     */
/*----------------------------------------------------------------------------*/
: txRollback_req ( -- R )

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.rollback

  <OK>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* dump all transactions on this node (run by participant)                    */
/*----------------------------------------------------------------------------*/
: dump_all_tx allParticipants 0 checkResult ( -- true n# true )

tp: dump_all_tx

  args.tracepoint if
    "DUMPING TX'S on NODE "grid.thisNodeName@ str.cat .
  then

  tx::dumpAll

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* dump all transactions in the grid                                          */
/*----------------------------------------------------------------------------*/
: txDumpAll_req ( -- <R> )

  "dump all transactions" .

  dump_all_tx

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
