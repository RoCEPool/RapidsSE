/*============================================================================*/
/* requests_tx.sen -- the set of transaction related requests                 */
/*============================================================================*/

"requests_folder.sen" .verbose

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* begin a transaction                                                        */
/*----------------------------------------------------------------------------*/
: txBegin_req ( -- R )

  "begin transaction" .

  txRef::new locals| pTxRef |

  pTxRef task::this task.seitf@ seitf.txRef!

  pTxRef txRef.begin assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  tx::begin locals | pTx |

  pTx task::this task.seitf@ seitf.tx!

  <OK>
  exit
;

/*----------------------------------------------------------------------------*/
/* commit a transaction                                                       */
/*----------------------------------------------------------------------------*/
: txCommit_req ( -- R )

  "commit transaction" .

  task::this task.seitf@ seitf.txRef@ locals| pTxRef |

  pTxRef txRef.end assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.commit

  <OK>
  exit
;

/*----------------------------------------------------------------------------*/
/* end a transaction                                                          */
/*----------------------------------------------------------------------------*/
: txEnd_req ( -- R )

  "commit transaction" .

  task::this task.seitf@ seitf.txRef@ locals| pTxRef |

  pTxRef txRef.end assert

  nullPtr task::this task.seitf@ seitf.txRef!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.free

  nullPtr task::this task.seitf@ seitf.tx!

  <OK>
  exit
;

/*----------------------------------------------------------------------------*/
/* dump transaction                                                           */
/*----------------------------------------------------------------------------*/
: txDump_req ( -- R )

  "dump transaction" .

  task::this task.seitf@ seitf.txRef@ locals| pTxRef |

  pTxRef txRef.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.dump

  <OK>
  exit
;

/*----------------------------------------------------------------------------*/
/* rollback a transaction                                                     */
/*----------------------------------------------------------------------------*/
: txRollback_req ( -- R )

  "rollback transaction" .

  task::this task.seitf@ seitf.txRef@ locals| pTxRef |

  pTxRef txRef.rollback assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.rollback

  <OK>
  exit
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
