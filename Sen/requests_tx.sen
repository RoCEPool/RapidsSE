/*============================================================================*/
/* requests_tx.sen -- the set of transaction related requests                 */
/*============================================================================*/

"requests_folder.sen" .verbose

/*----------------------------------------------------------------------------*/
/* begin a transaction                                                        */
/*----------------------------------------------------------------------------*/
: txBegin_req ( -- R )

  "begin transaction" .

  tx::begin locals| pTx |

  pTx task::this task.seitf@ seitf.tx!

  <OK>
;

/*----------------------------------------------------------------------------*/
/* commit a transaction                                                       */
/*----------------------------------------------------------------------------*/
: txCommit_req ( -- R )

  "commit transaction" .

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.commit

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end a transaction                                                          */
/*----------------------------------------------------------------------------*/
: txEnd_req ( -- R )

  "end transaction" .

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.free

  nullPtr task::this task.seitf@ seitf.tx!

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump transaction                                                           */
/*----------------------------------------------------------------------------*/
: txDump_req ( -- R )

  "dump transaction" .

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.dump

  <OK>
;

/*----------------------------------------------------------------------------*/
/* rollback a transaction                                                     */
/*----------------------------------------------------------------------------*/
: txRollback_req ( -- R )

  task::this task.seitf@ seitf.tx@ locals| pTx |

  pTx tx.rollback

  <OK>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* dump all transactions in the grid                                          */
/*----------------------------------------------------------------------------*/
: txDumpAll_req ( -- <R> )

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
