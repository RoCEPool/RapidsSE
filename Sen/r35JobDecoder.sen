/*============================================================================*/
/* r35Decoder.sen -- Decode and execute received jobs                         */
/*============================================================================*/

"r35Decoder.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute/begin a new job                                                    */
/*----------------------------------------------------------------------------*/
: job.beginExecute ( pJob -- )

  locals| pJob |

  0 locals| pJobBegun |

    pJob object.class@ class::name
    grid::thisNode@
    "Node %v Job %v Received"
  str.format .

  // set partcipant node in job
  grid::thisNode@ pJob job.participant!

  // add job as participant job
  pJob job.addParticipant

  // change state of job to begun
  //pJob job.begun

  // new a job__begun
  pJob job.Id@ job.newBegun to pJobBegun

  // set the send node to be the originating node
  pJob job::originator@ grid::node task::this task.sendNode!
  task.send

  // form the valset to send
  pJobBegun 1 >valset

  // send the begun job
  >socketR35

  // now delete the begun job
  pJobBegun job.delete
;

/*----------------------------------------------------------------------------*/
/* decode job                                                                 */
/*----------------------------------------------------------------------------*/
: job.decode ( pJob -- )

  locals| pJob |

  0 locals| eJobClass |

  pJob job.class to eJobClass

  eJobClass case

   // specific cases
    CN_JOB__BEGUN    of pJob job.genericExecute endof
    CN_JOB__END      of pJob job.genericExecute endof
    CN_JOB__ENDED    of pJob job.genericExecute endof
    CN_JOB__ERROR    of pJob job.genericExecute endof
    CN_JOB__EXECUTE  of pJob job.genericExecute endof
    CN_JOB__EXECUTED of pJob job.genericExecute endof

    // default case
    pJob job.beginExecute
  endcase
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
