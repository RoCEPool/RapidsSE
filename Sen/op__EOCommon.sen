/*============================================================================*/
/* op__common.sen -- operator common words                                    */
/*============================================================================*/

" op__common.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create an (int) index def                                                  */
/*----------------------------------------------------------------------------*/
: idxDef_int

  indexDef[].new
  "idx_int" indexDef[].name!
  CT_INTEGER "intA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create an (int,int) index def                                              */
/*----------------------------------------------------------------------------*/
: idxDef_intInt

  indexDef[].new
  "idx_intInt" indexDef[].name!
  CT_INTEGER "intA" indexDef[].addColumn
  CT_INTEGER "intB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch) index def                                                   */
/*----------------------------------------------------------------------------*/
: idxDef_vch

  indexDef[].new
  "idx_vch" indexDef[].name!
  CT_VARCHAR "vchA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch,vch) index def                                               */
/*----------------------------------------------------------------------------*/
: idxDef_vchVch

  indexDef[].new
  "idx_vchVch" indexDef[].name!
  CT_VARCHAR "vchA" indexDef[].addColumn
  CT_VARCHAR "vchB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* cleanup asm                                                                */
/*----------------------------------------------------------------------------*/
: cleanUpAsm params| bCompile |

  bCompile 1 == if
    LogicCompiler[].delete
  then
;

/*----------------------------------------------------------------------------*/
/* execute asm                                                                */
/*----------------------------------------------------------------------------*/
: executeAsm params| bCompile |

  bCompile 1 == if
    LogicUnit[].dynFun
  else
    LogicUnit[].transform
  then
;

/*----------------------------------------------------------------------------*/
/* execute asm                                                                */
/*----------------------------------------------------------------------------*/
: executeAsmArgs params| bCompile bArg |

  bCompile 1 == if
    bArg 1 LogicUnit[].dynFunArgs
  else
    bArg 1 LogicUnit[].transformArgs
  then
;

/*----------------------------------------------------------------------------*/
/* create a (vch,vch) index def                                               */
/*----------------------------------------------------------------------------*/
: genAsm params| fileName bCompile |

  fileName LogicUnit[].genAsm
  bCompile 1 == if
    LogicCompiler[].new
    LogicCompiler[].compile
  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
