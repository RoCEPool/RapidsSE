/*============================================================================*/
/* OP_compactIndexPtn.sen -- Operator compact partition of index              */
/*============================================================================*/

" OP_compactIndexPtn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: CompactIndexPtn_PulseMarker \handler


  //"Operand:- ZK_PULSEMARKER" .verbose
  PipeIn[].pipeOut

  // compact the index
  index[].compactPtn

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: CompactIndexPtn_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> <indexNm> op__table_index if
    PipeIn[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for compactIndex req                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : CompactIndexPtn_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: CompactIndexPtn_PulseMarker ZK_PULSEMARKER op[].handler!
  find: CompactIndexPtn_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: compactIndexPtn :: compactIndexPtn <tableNm> <indexNm> ;

: compactIndexPtn _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
