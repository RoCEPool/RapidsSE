/*============================================================================*/
/* job_Sanity.sen -- Job Sanity                                               */
/*============================================================================*/

" job_Sanity.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request to get sanity of nodes in the grid (on originating node)           */
/*----------------------------------------------------------------------------*/
: sanity_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: sanity_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(nodeName VARCHAR, sanity VARCHAR)"
  pJob job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_Sanity job                                                     */
/*----------------------------------------------------------------------------*/
: sanity_exe ( pJob_Sanity -- )

  >>am <SEED_EXE>

  //params| pJob_Sanity |
  job::this locals| pJob_Sanity |

  0 0 locals| iSize iPartitions |

  CN_JOB_SANITY pJob_Sanity object.assertClass

  //"GETTING SANITY on NODE " grid::thisNode@ >str str.cat .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the node size of originating node from the job
  pJob_Sanity job.regionSize@ to iSize

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the no of partitions of originating node from the job
  pJob_Sanity job.partitions@ to iPartitions

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  args.tracepoint if
    "GETTING PARTITIONS on NODE " grid::thisNode@ >str str.cat .
  then

  iPartitions node.partitions == not if
    EC_CLUSTER_PARTITIONS_MISMATCH
    pJob_Sanity <ERROR_JOB>
  else

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    args.tracepoint if
      "GETTING SIZE on NODE "grid::thisNode@ >str str.cat .
    then

    iSize node.size == not if
      EC_CLUSTER_SIZE_MISMATCH
      pJob_Sanity <ERROR_JOB>
    else
      "row: ('"
      grid::thisNodeName@ str.cat
       "','sanity check passed')" str.cat
      pJob_Sanity job.response!
    then

  then

  pJob_Sanity job.notice

  pJob_Sanity job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: sanity_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_sanity |

  pJob_sanity job.becomeParticipant

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: sanity_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_sanity |

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: sanity_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_sanity |

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

