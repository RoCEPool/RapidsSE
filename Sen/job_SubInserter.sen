/*============================================================================*/
/* Job_SubInserter.sen -- Job Insert Rows                                      */
/*============================================================================*/

" Job_SubInserter.sen" .verbose

/*----------------------------------------------------------------------------*/
/* job_InsertRow request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: SubInserter_req (  -- <R> )

  >>am <SEED_REQ>

  0 locals| pThisTask |
  0 0 0 locals| pJob_SubInserter sTableNm pTable |

  tp: SubInserter_req

  // get the task
  task::this to pThisTask

  // get the job from the task
  pThisTask task.job@ to pJob_SubInserter
  //pJob_SubInserter pThisTask "InsertRow_req task: %v job_InsertRow %v" fmt.print

  // distribute the job
  //Job_InsertRow job.distribute

  pJob_SubInserter job.objectName@ to sTableNm

  // push table dictionary
  pJob_SubInserter job.pushPath task::dicStack.set
  sTableNm pushTable assert
  //pathDump

  sTableNm find execute locals| pTable |

  pTable pJob_SubInserter Job_SubInserter.begin

  // add job to originator jobs
  //pJob_SubInserter job.addOriginator

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SubInserter job check resources                                 */
/*----------------------------------------------------------------------------*/
: SubInserter.checkResources ( pJob_SubInserter -- )

  >>am <Check_Resources>

  params| pJob_SubInserter  |

  pJob_SubInserter job.objectName@ locals| sTableNm |

  tp: SubInserter.checkResources
  //checkResources received" .

  //----------------------------------------------------------------------------
  // grab a ddl lock
  ddlLock::grabRead

  //----------------------------------------------------------------------------
  // path checks

  // set dictionary stack
  pJob_SubInserter job.pushPath task::dicStack.set
  //pathDump

  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_SubInserter <ERROR_JOB> !!am exit then
  //sTableNm "In table folder: %v" fmt.print

  // push table dictionary
  sTableNm pushTable assert
  //pathDump

  // check it is a table
  sTableNm checkIsTable not if popTable pJob_SubInserter <ERROR_JOB> !!am exit then
  drop

  // pop table dictionary
  popTable
  //pathDump

  //----------------------------------------------------------------------------
  // check if we have enough buffers

  node::checkEnoughBuffers not if pJob_SubInserter <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SubInserter job release resources                               */
/*----------------------------------------------------------------------------*/
: SubInserter.releaseResources ( pJob_SubInserter -- )

  >>am <Release_Resources>

  params| pJob_SubInserter  |

  tp: SubInserter.releaseResources
  //releaseResources received" .

  <<am <Resources_Released>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
