/*============================================================================*/
/* job_Local.sen -- Local Job                                                 */
/*============================================================================*/

" job_Local.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute the job's request seed-word on originating node                    */
/*----------------------------------------------------------------------------*/
: local_req ( -- <R> )

  LogEntry SEED_REQ

  job::</seeFlow/>

  "<preCheck>" job[] job.tagSet@ tagSet.hasName if
    <preCheck> find execute not if 
      task::seedInitially task::doneFinally
      job::error!
    then
  then

  <SeedReq> .executeSeed

  //LogExit DONE_REQ
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
