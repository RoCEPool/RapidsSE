/*============================================================================*/
/* OP_waitPipeline.sen -- Operator Wait on Pipeline                           */
/*============================================================================*/

" OP_waitPL.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: waitPipeline_StartMarker \handler

  0  to Counter0[]
  -1 to Counter1[]

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: waitPipeline_PulseMarker \handler

  PipeIn[].delete
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: waitPipeline_PulsedMarker \handler

  PipeIn[].delete
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: waitPipeline_ReturnPipeline \handler

  "waitPipeline_ReturnPipeline" .

  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  Counter0[] 1 + to Counter0[]

  // find the __returnPipeline table def
  C_TDEF_RETURNPIPELINE "op__tableDef_infoSet" find execute assert

  InfoSet[].firstRow to Row[]
  2 InfoSet[].colVal@ 1 InfoSet[].colVal@ 0 InfoSet[].colVal@
    Counter1[] Counter0[]
    "Got ReturnPipeline %v of %v : [%v.%v] error %v" str.format .
  InfoSet[].delete

  nullptr to InfoSetTable[]

  Operand[].newEosMarker
  Operand[].pipeOut

  Operand[].newPulseMarker
  Operand[].pipeOut

  Operand[].newPulsedMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : waitPipeline_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: waitPipeline_PulseMarker    ZK_PULSEMARKER    op[].handler!
  find: waitPipeline_PulsedMarker   ZK_PULSEDMARKER   op[].handler!
  find: waitPipeline_ReturnPipeline ZK_RETURNPIPELINE op[].handler!
  find: waitPipeline_StartMarker    ZK_STARTMARKER    op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: waitPipeline :: waitPipeline ;

: waitPipeline _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
