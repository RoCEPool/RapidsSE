/*============================================================================*/
/* job__Begun.sen -- generic job related words                                */
/*============================================================================*/

" job__Begun.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job__Begun back to originating node                                   */
/*----------------------------------------------------------------------------*/
: Job__Begun::send ( pJobParticipant -- )

  params| pJobParticipant |

  pJobParticipant job.id@ locals| iJobId |

  0 0 locals| pJob__Begun error |

  // new a temporary Job__Executed
  pJobParticipant job__Begun::new to pJob__Begun

  // get error if any
  grid::thisNode@ pJobParticipant job.error@ to error

  error EC_NONE != if
    // set error in executed job
    //error error.msg "Setting error '%v' in Job__Begun" str.format .
    error pJob__Begun jobBegun.error!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the originator node as the send target node
  //iJobId job::originator@ grid::node task::this task.sendNode!

  // move this task through send state/queue
  //task.send

  // send the begun job
  iJobId job::originator@ pJob__Begun job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete Job__Executed
  pJob__Begun job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job__Begun from partcipating node on originating node         */
/*----------------------------------------------------------------------------*/
: Job__Begun_rcv ( -- )

  >>am <SEED_RCV>
  an::seed_rcv

  //
  // where:  On the originator node.
  // event:  A Job__Begun has been received from a participating node
  //         indicating the job has been received and put into the
  //         participating jobs list.
  // data:   The job will exist in the originating jobs list.
  // action: 1) find the job in the originating list;
  //         2) decrement its ack's remaining
  //         3) if all acks received distribute Job_Execute
  //

  job::this locals| pJob__Begun |

  pJob__Begun job.id@ locals| iJobId |

  0 locals| pJobOriginator  |
  0 0 0 0 locals| bAmDecider error iParticipantNode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the context of this __begun job

  // find the originating job
  iJobId job::findOriginator to pJobOriginator

  // get the participant node from where this job__begun started
  pJob__Begun job.participant@ to iParticipantNode

  // get the error code from job__begun
  pJob__Begun jobBegun.error@ to error

  error EC_NONE != if
    // set the error code in pJobOriginator
    error iParticipantNode pJobOriginator job.error!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // process __begun job on this originating node

  // increment the number of __begun jobs received in api state
  pJobOriginator ApiState::incBegun
  pJobOriginator ApiState::traceSession

  // decrement the acks remaining in the originating job
  pJobOriginator job.decAcksRemaining to bAmDecider

  // if there are acks remaining just exit
  bAmDecider not if
    job::deleteThis
    <DONE_RCV>
    exit                                                         // *EARLY EXIT*
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // all job__begun's have been received, so this job is the decider

  // check if any node returned an error
  grid::nodes 0 do
    I pJobOriginator job.error@ EC_NONE != if
      // distribute Job__Cancel to all participants
      pJobOriginator Job__Cancel::distribute
      unloop
      job::deleteThis
      <DONE_RCV>
      exit                                                       // *EARLY EXIT*
    then
  loop

  // distribute Job__Execute to all participants
  pJobOriginator Job__Execute::distribute

  // delete this completed __begun job
  job::deleteThis

  <DONE_RCV>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
