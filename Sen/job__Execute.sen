/*============================================================================*/
/* job__Execute.sen -- generic job related words                              */
/*============================================================================*/

" job__Execute.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job__Execute to all participants                                */
/*----------------------------------------------------------------------------*/
: Job__Execute::distribute ( pJobOriginator -- )

  //
  // where: on the originator node
  //

  params| pJobOriginator |

  0 locals| pJob__Execute |

  // set the no of acks expected in originator job
  grid::connectedNodes pJobOriginator job.acksRemaining!

  // create a temporary job__execute
  pJobOriginator job__Execute::new to pJob__Execute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send job__execute to all nodes
  grid::definedNodes 0
  do
    I grid::node node.isConnected if
      I pJob__Execute job.forward
    then
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete the temporary job__Execute
  pJob__Execute job.delete
;

/*----------------------------------------------------------------------------*/
/* run received Job__Execute on participating node                            */
/*----------------------------------------------------------------------------*/
: Job__Execute_rcv ( -- )

  >>logEntry <SEED_RCV>
  actLog::seed_rcv

 //
  // where: on the participating node
  //

  job::this locals| pJob__Execute |

  0 locals| pJobParticipant |

  // find the job to be executed in the participating jobs
  pJob__Execute job.id@ locals| iJobId |
  iJobId plist::findJob locals| pJobParticipant |

  // execute the job on this participating node
  pJobParticipant SEED_EXE job.spawn

  JobRef[].return

  job::deleteThis

  <DONE_RCV>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
