/*============================================================================*/
/* job__Execute.sen -- generic job related words                              */
/*============================================================================*/

" job__Execute.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job__Execute to all participants                                */
/*----------------------------------------------------------------------------*/
: Job__Execute::distribute params| pJobOriginator |

  //
  // where: on the originator node
  //

  0 locals| pJob__Execute |

  // create a temporary job__execute
  pJobOriginator job__Execute::new to pJob__Execute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the no of acks expected in originator job
  grid::connectedNodes pJobOriginator job.acksRemaining!

  // send job__execute to all nodes
//  grid::definedNodes 0
//  do
//    I grid::node node.isConnected if
//      I pJob__Execute job.forward
//    then
//  loop

  0 locals| pNode |

  node_I[].new

  begin
    node_I[].node to pNode

    pNode node.isConnected if
      pNode node.no pJob__Execute job.forward
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete the temporary job__execute
  pJob__Execute job.delete
;

/*----------------------------------------------------------------------------*/
/* run received Job__Execute on participating node   recv: job.spawn_received */
/*----------------------------------------------------------------------------*/
: _Execute _run

  //
  // where: on the participating node
  //
  job[] locals| pJob__Execute |

  // find the job to be executed in the participating jobs
  pJob__Execute job.id@ locals| iJobId |
  iJobId plist::findJob discard

  // stall till job's previous phase (task) has completed
  begin
    jobRef[].hasTask
  while
    task::yield
  repeat

  // execute the job on this participating node
  JM_SEED_EXE JobRef[] job.seed!
  JobRef[] job.scheduleNextPhase // job in participant list ; perform next phase
  JobRef[].return
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: _Execute :: _Execute ;

: _Execute _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
