/*============================================================================*/
/* job__End.sen -- generic job related words                                  */
/*============================================================================*/

" job__End.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job__End to all participants                                    */
/*----------------------------------------------------------------------------*/
: Job__End::distribute ( pJobOriginator -- )

  //
  // where:  On the originator node.
  //

  JP_ENDING log::markPhase

  params| pJobOriginator |

  0 locals| pJob__End |

  // set the no of acks expected in originator job
  grid::connectedNodes pJobOriginator job.acksRemaining!

  // new a temporary Job__End
  pJobOriginator job__End::new to pJob__End

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send Job__End to all nodes
  grid::nodes 0
  do
    I grid::node node.isConnected if
      I pJob__End job.forward
    then
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // now delete the end job
  pJob__End job.delete
;

/*----------------------------------------------------------------------------*/
/* run received Job__End on participating node                                */
/*----------------------------------------------------------------------------*/
: Job__End_rcv ( -- )

  >>logEntry <SEED_RCV>
  actLog::seed_rcv

  //
  // where: on the participating node
  //

  job::this locals| pJob__End |

  // find the job to be executed in the participating jobs
  pJob__End job.id@ locals| iJobId |
  iJobId job::findParticipant locals| pJobParticipant |

  // execute the end seed of the job on this participating node
  pJobParticipant SEED_END job.spawn

  job::deleteThis

  <DONE_RCV>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
