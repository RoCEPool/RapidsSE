/*============================================================================*/
/* job__End.sen -- generic job related words                                  */
/*============================================================================*/

"job__End.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distribute Job__End to all participants                                    */
/*----------------------------------------------------------------------------*/
: Job__End::distribute ( pJobOriginator -- )

  //
  // where:  On the originator node.
  //

  params| pJobOriginator |

  0 locals| pJob__End |

  // set the no of acks expected in originator job
  grid::nodes pJobOriginator job.acksRemaining!

  // new a temporary Job__End
  pJobOriginator job.id@ job.newEnd to pJob__End

  // send Job__End to all nodes
  grid::nodes 0
  do
  // set which node this task will to send to
  I grid::node task::this task.sendNode!

  // move this task through send state/queue
  task.send

  // pack Job__End into a valset
  pJob__End
  //1 >valset

  // send the end job
  >socket
  loop

  // now delete the end job
  pJob__End job.delete
;

/*----------------------------------------------------------------------------*/
/* run received Job__End on participating node                                */
/*----------------------------------------------------------------------------*/
: Job__End_rcv ( -- )

  job::this locals| pJob__End |

  0 locals| pJobParticipant |
  0 locals| pJobClass |
  0 locals| sEndSeed |

  // find the job in the participating jobs
  pJob__End job.id@ locals| iJobId |
  iJobId job.findParticipant to pJobParticipant
  pJobParticipant "Job %v" fmt.print

  pJobParticipant job.jobClass to pJobClass
  pJobClass jobClass.name pJobClass "JobClass %v %v" fmt.print

  pJobClass jobClass.seedEnd to sEndSeed

  "" sEndSeed str.equal not if
    sEndSeed find execute
  then

  pJobParticipant Job__Ended::send

  // remove the job from the participant jobs
  pJobParticipant job.removeParticipant

  // delete the job
  pJobParticipant job.delete

  delete_completed_job
;

/*----------------------------------------------------------------------------*/
: Job__End_rcv2 ( -- )

  //
  // where: on the participating node
  //

  job::this locals| pJob__End |

  0 locals| pJobParticipant |

  // find the job to be executed in the participating jobs
  pJob__End job.id@ locals| iJobId |
  iJobId job.findParticipant to pJobParticipant

  // execute the job on this participating node
  pJobParticipant SEED_EXE job.spawn

  delete_completed_job
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
