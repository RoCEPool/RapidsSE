/*============================================================================*/
/* OP_visualizeIndex.sen -- Operator visualize index                          */
/*============================================================================*/

" OP_visualizeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: visidx_action

  <tableNm> <indexNm> op__table_index if
    index[].visualize
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: visidx :: visidx <tableNm> <indexNm> ;

: visidx opInfo tagCopy: localLiteOp_tags
tags{
  <jobDesc>     = "--description of operator--"
  <localLiteOp> = true
  <params>      = 2
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

