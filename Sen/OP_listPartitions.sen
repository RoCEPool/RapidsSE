/*============================================================================*/
/* OP_listPartitions.sen -- Operator list partitions                          */
/*============================================================================*/

" OP_listPartitions.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsparts_action

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeOut

  // create an infoSet operand
  streamSetTable[] streamSet[].new

  grid::slots 0 do

    // add nodeInfo to the infoSet
    I grid::toPartition
    streamSetTable[] streamSet[].addListPartitions  not if
      StreamSet[].pipeOut
      streamSetTable[] streamSet[].new
      I grid::toPartition
      streamSetTable[] StreamSet[].addListPartitions assert
    then


  loop

  // pipeout the infoset
  streamSet[].pipeOut

  true
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsparts :: lsparts ;

: lsparts _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __listPartitions
    <params>    = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
