/*============================================================================*/
/* copier.sen -- table copier                                                 */
/*============================================================================*/

"copier.sen" .verbose

: copy ( ^fromTable ^toTable )

  swap
  >r >r
  // r0 ^toTable
  // r1 ^fromtable

  "__sel_cursor" find dup if else
    drop "__sel_cursor" :selCursor
  then
  execute

  >r

  // r0 ^selCursor
  // r1 ^toTable
  // r2 ^fromTable

  r2 r0 selCursor.table!

  beginTransaction >r
  // r0 ^txRefCursor
  // r1 ^selCursor
  // r2 ^toTable
  // r3 ^fromTable

  args.partitions 0
  do
    // r0 partition
    // r1 partitions
    // r2 ^txRefCursor
    // r3 ^selCursor
    // r4 ^toTable
    // r5 ^fromTable

    I r3 selCursor.begin
    r3 selCursor.first

    begin
      while
      r0 r3 selCursor.get r2 r4 table.insert
      r3 selCursor.next
    repeat

    r3 selCursor.end
  loop

  commitTransaction

  // r0 ^txRefCursor
  // r1 ^selCursor
  // r2 ^toTable
  // r3 ^fromTable

  rdrop rdrop rdrop rdrop

  "__sel_cursor" find word.forget

  true
;

: tableCopier

  find execute   ( "<to-tableNm>" ^fromTable )

  swap           ( ^fromTable "<to-tableNm>" )

  :table execute ( ^fromTable ^toTable )

  // swap        ( ^toTable ^fromTable )

    copy if "copied!" . else . then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
