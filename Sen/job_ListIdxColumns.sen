/*============================================================================*/
/* job_ListColumns.sen -- Job list Columns                                    */
/*============================================================================*/

" job_ListIdxColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* list columns of an index on a table                                        */
/*----------------------------------------------------------------------------*/
: listIdxColumns ( "<indexNm>" Job_ListIdxColumns -- )

  params|  pJob_ListIdxColumns sIndexNm |

  0 0 0 locals| pColumn iColumns pIndex |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get index
  sIndexNm find execute to pIndex

  pIndex index.columnCount@ to iColumns

  ""                             // initial ls string
  iColumns 0 do
    I pIndex index.column@ to pColumn
    pColumn column.isPartitionKey@
    pColumn column.isNullable@
    pColumn column.Scale@
    pColumn column.Length@
    pColumn column.type@
    pColumn column.name@
    "row: ( '%v','%v',%v,%v,%v,%v )\n" str.format
    str.cat
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set response in the job
  grid::thisNode@ pJob_ListIdxColumns job.response!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // sent rows Processed in the job
  iColumns pJob_ListIdxColumns job.rowsProcessed!
;

/*----------------------------------------------------------------------------*/
/* List Index Columns requests (on the originating node)                      */
/*----------------------------------------------------------------------------*/
: listIdxColumns_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 0 0 locals| sTableNm sIndexNm pJob_ListIdxColumns pTask |

  tp: listIdxColumns_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListIdxColumns

  //----------------------------------------------------------------------------
  // set task's dictionary stack from path in job
  pJob_ListIdxColumns job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab ddl read lock
  ddlLock::grabRead

  //----------------------------------------------------------------------------
  // should be in the tables folder
  checkInTables not if pJob_ListIdxColumns <ERROR_REQUEST> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table name from job
  pJob_ListIdxColumns job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_ListIdxColumns <ERROR_REQUEST> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm checkIsTable not if popTable pJob_ListIdxColumns <ERROR_REQUEST> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get index name from job
  pJob_ListIdxColumns job.indexName@ to sIndexNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables pJob_ListIdxColumns <ERROR_REQUEST> !!am exit
  then

  args.metadata if
    "(columnName VARCHAR, columnType VARCHAR, columnLength INTEGER, columnScale INTEGER, isNull boolean, isPartitionKey boolean)"
        pJob_ListIdxColumns job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list table columns
  sIndexNm pJob_ListIdxColumns listIdxColumns

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes folder
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  popTable
  assertInTables

  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
