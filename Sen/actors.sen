"requestTask.sen" include

"generalThreads.sen" include

/*----------------------------------------------------------------------------*/
/* called by RapidsSE::vStartActors                                           */
/*----------------------------------------------------------------------------*/
: startActors

  "startActors" .verbose

  args.bgtasks if

    snooze generalThreadsStart

    snooze listerStart
    snooze monitorStart

    snooze reclaimStart
    snooze answerStart

  then

  //dic.main true dic.frozen!

