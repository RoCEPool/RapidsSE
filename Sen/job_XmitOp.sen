/*============================================================================*/
/* job_XmitOp.sen -- Job XmitOp                                               */
/*============================================================================*/

" job_XmitOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Xmit_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_XmitOp |


   pJob_XmitOp job.opLoop

   //pJob_XmitOp job::participantExecuted

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: Xmit :: Xmit ;

jobInfo: Xmit
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_XMITOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
