/*============================================================================*/
/* job_XmitOp.sen -- Job XmitOp                                               */
/*============================================================================*/

" job_XmitOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : XmitOp_req ( -- )

  >>logEntry <SEED_REQ>

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        //"Operand:- ZK_CRWBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_CSVBUFFER of
        //"Operand:- ZK_CSVBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_ENTBUFFER of
        //"Operand:- ZK_ENTBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        Operand[].pipeOut
        true
     endof

      ZK_IRWBUFFER of
        //"Operand:- ZK_IRWBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        //Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        //Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        Operand[].handleEnd
      endof

      ZK_STREAMDEF of
        //"Operand:- ZK_STREAMDEF" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: XmitOp :: XmitOp <topology> <nextStage> ;

jobInfo: XmitOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_XMITOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
