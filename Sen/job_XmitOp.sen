/*============================================================================*/
/* job_XmitOp.sen -- Job XmitOp                                               */
/*============================================================================*/

" job_XmitOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : XmitOp_req ( -- )

  >>logEntry <SEED_REQ>

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: XmitOp :: XmitOp <topology> <nextStage> <nextOp> ;

jobInfo: XmitOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_XMITOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESULT
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
