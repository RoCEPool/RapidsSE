/*============================================================================*/
/* job_XmitOp.sen -- Job XmitOp                                               */
/*============================================================================*/

" job_XmitOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : XmitOp_req ( -- )

  >>logEntry <SEED_REQ>

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        "Operand:- ZK_CRWBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_CSVBUFFER of
        "Operand:- ZK_CSVBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .
        Operand[].handleEnd
        false
      endof

      ZK_ENTBUFFER of
        "Operand:- ZK_ENTBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_IRWBUFFER of
        "Operand:- ZK_IRWBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: XmitOp :: XmitOp ;

jobInfo: XmitOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_XMITOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
