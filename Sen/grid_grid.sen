/*============================================================================*/
/* grid.sen -- grid routines                                                  */
/*============================================================================*/

" grid_grid.sen" .verbose

/*----------------------------------------------------------------------------*/
/* command path for SE                                                        */
/*----------------------------------------------------------------------------*/
"../OS\\ X/Build/Products/Debug/SE" constant SE_COMMAND
//"../OS\\ X/Build/Products/Release/SE" constant SE_COMMAND

/*----------------------------------------------------------------------------*/
/* form the shell command for spawning and starting a node etc                */
/*----------------------------------------------------------------------------*/
: .formShellCommand ( bAdd sNodeName sNodeList -- "<command>" )

  params| sNodeList |
  params| sNodeName |
  params| bAdd      |

  //  "nohup "
  ""

  SE_COMMAND str.cat
  " --start" str.cat
  bAdd if
    " --addNode" str.cat
  then

  " --name "  str.cat sNodeName str.cat sNodeList str.cat

  " --size "              str.cat args.regionSize        >str   str.cat
  " --regionPrefix "      str.cat args.regionPrefix             str.cat
  " --partitionsPerNode " str.cat args.partitionsPerNode >str   str.cat
  " --subLoaders "        str.cat args.subLoaders        >str   str.cat
  " --maxReadyLP "        str.cat args.maxReadyLP        >str   str.cat
  " --commands /Users/ray/Desktop/rapidsse/Commands"            str.cat
//" --commands /Users/alkayamarti/rapidsSE/rapidsse/Commands"   str.cat

  args.tracepoint  if " --tracepoint"  str.cat then
  args.verbose     if " --verbose"     str.cat then
  args.dontFree    if " --dontFree"    str.cat then
  args.freeCB      if " --freeCB"      str.cat then
  args.metadata    if " --metadata"    str.cat then
  args.log         if " --log"         str.cat then

  " &" str.cat
;

/*----------------------------------------------------------------------------*/
/* form the node list: {--node name ip port}*                                 */
/*----------------------------------------------------------------------------*/
: .formNodeList ( -- sNodeList )

  locals| pNode |

  ""

  grid::definedNodes 0 do

    I grid::node to pNode
    pNode node.port
    pNode node.IP
    pNode node.name
    " --node %v %v %v" str.format
    str.cat

  loop
;

/*----------------------------------------------------------------------------*/
/* spawn a specific node                                                      */
/*----------------------------------------------------------------------------*/
: .spawnNamedNode ( bAdd sNodeName sNodeList -- )

  params| sNodeList |
  params| sNodeName |
  params| bAdd      |

  locals| sShellCommand |

  // form the shell command
  bAdd sNodeName sNodeList .formShellCommand to sShellCommand

  // print the shell command
  sShellCommand .

  // execute the shell command
  sShellCommand shell::execute

  // check result
  not assert
;

/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* spawn all other nodes for a grid on this machine                           */
/*----------------------------------------------------------------------------*/
: grid::spawnOtherNodes ( -- )

  // test for single node grid
  grid::definedNodes 1 == if exit then

  locals| sNodeList |
  locals| sShellCommand |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // form the node list

  .formNodeList to sNodeList

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn all other nodes

  grid::definedNodes 0 do

    // all but this node
    I grid::thisNode@ != if

      // spawn/start node I
      false  I grid::node node.name  sNodeList  .spawnNamedNode

    then

  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  grid::StartNode@ "Cluster Start node: %v" str.format .
;

/*----------------------------------------------------------------------------*/
/* spawn named node being added to a grid on this machine                     */
/*----------------------------------------------------------------------------*/
: grid::spawnAddingNode ( sNodeNm -- )

  params| sNodeNm   |

  locals| sNodeList |

  // form the node list
  .formNodeList to sNodeList

  // spawn/add node sNodeNm
  true   sNodeNm   sNodeList  .spawnNamedNode
;

/*----------------------------------------------------------------------------*/
/* set start node                                                             */
/*----------------------------------------------------------------------------*/
: grid::setStartNode ( -- )

  // set this node as the grid start node
  grid::thisNode@ grid::StartNode!
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
