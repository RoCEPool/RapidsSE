/*============================================================================*/
/* job_PeriodicOp.sen -- Job PeriodicOp                                       */
/*============================================================================*/

" job_PeriodicOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for periodicOp request                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : periodicOp_req ( -- )
 
  >>logEntry <SEED_REQ>

  <minutes> locals| minutes |
  <hours> locals| hours |
  0 locals| elapsed |

  "TOPO" .
  <topology> .
  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  <minutes> .

  hours if
    hours 60 * to minutes
  then

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CANCELMARKER of
        //"Operand:- ZK_CANCELMARKER" .verbose
        "Query being cancelled\n" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        Operand[].delete
        Operand[].newStopMarker
        Operand[].pipeOut
        Op.ackPipelineJob
        false
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut

        minutes if
          begin
/*
            begin
              minutes elapsed >
            while
              "while" .
              task::yield
              assert::stack_0
              "sleeping" .
              60 task::sleepSsec
              "awake" .
              60 elapsed + to elapsed
            repeat
*/
            "sleeping" .
            minutes 5 * thread::sleepSsec
            "awake" .

            Operand[].newPulseMarker
            Operand[].pipeOut
            0 to elapsed
            true
          while assert::stack_0 repeat
        then

        Operand[].newStopMarker
        Operand[].pipeOut
        Op.ackPipelineJob
        false
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        Operand[].pipeOut
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: periodicOp :: periodicOp once <topology> <nextStage> <nextOp> ;
jobSyntax: periodicOp :: periodicOp min <minutes> <topology> <nextStage> <nextOp> ;
jobSyntax: periodicOp :: periodicOp hour <hours> <topology> <nextStage> <nextOp> ;

jobInfo: periodicOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_PERIODICOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
