/*============================================================================*/
/* op__tagSets.sen -- tag sets                                                */
/*============================================================================*/

" op__tagSets.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: localOp_tags
  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
    <ddlLock>  = DL_GRAB_READ
    
    <preCheck> = bClusterStarted
  }
;

//tags_localOp enameset.asStr .

