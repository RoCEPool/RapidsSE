/*============================================================================*/
/* job_TruncateTable.sen -- Job Truncate Table                                */
/*============================================================================*/

" job_TruncateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* truncate table request (on originating node)                               */
/*----------------------------------------------------------------------------*/
: truncateTable_req ( -- <R> )

  0 0 locals| pJob pTask |

  tp: truncateTable
  "truncateTable_req" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  pJob <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute Job_TruncateTable job on a node                                    */
/*----------------------------------------------------------------------------*/
: truncateTable_exe ( Job_TruncateTable -- )

  //params| pJob_TruncateTable |
  job::this locals| pJob_TruncateTable |

  0 0 locals| sTableNm pThisTask |

  tp: truncateTable_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_TRUNCATETABLE pJob_TruncateTable object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pThisTask
  pJob_TruncateTable pThisTask "truncateTable_exe task: %v Job_TruncateTable %v" fmt.print

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_TruncateTable getPath
  dicStack.set

  // store task into Job_LoadTable
  pThisTask pJob_TruncateTable job_truncateTable.task!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab this task's lock
  pThisTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the acks
  grid::slots setAcks

  grid::slots 0
  do
    I "Creating Job_SubTruncate %v" fmt.print
    I pJob_TruncateTable job_truncateTable.spawnSub
  loop

  "truncateTable ack waiting" .
  ackWait
  "truncateTable acked" .

  pJob_TruncateTable job.notice

  pJob_TruncateTable send_job__executed

  nullptr task::this task.job!

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeIndex job check resources                               */
/*----------------------------------------------------------------------------*/
: truncateTable.checkResources ( Job_TruncateTable -- )

  params| pJob_TruncateTable  |
  0 locals| sTableNm |

  tp: truncateTable.checkResources
  "checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_TruncateTable getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  checkInTables not if pJob_TruncateTable <ERROR_JOB> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // there should be a table folder
  pJob_TruncateTable job.objectName@ to sTableNm
  sTableNm checkIsTableFolder not if pJob_TruncateTable <ERROR_JOB> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm checkIsTableR35 not if popTable pJob_TruncateTable <ERROR_JOB> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  popTable

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeIndex job release resources                             */
/*----------------------------------------------------------------------------*/
: truncateTable.releaseResources ( Job_TruncateTable -- )

  params| pJob_TruncateTable  |

  tp: truncateTable.releaseResources
  "releaseResources received" .

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: truncateTable_beg ( -- )

  job::this locals| pJob_truncateTable |

  pJob_truncateTable job.beginParticipant

  // check resources
  pJob_truncateTable truncateTable.checkResources

  job::participantBegun
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: truncateTable_end ( -- )

  job::this locals| pJob_truncateTable |

  pJob_truncateTable truncateTable.releaseResources

  job::participantEnded
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: truncateTable_can ( -- )

  job::this locals| pJob_truncateTable |

  pJob_truncateTable truncateTable.releaseResources

  job::participantCancelled
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
