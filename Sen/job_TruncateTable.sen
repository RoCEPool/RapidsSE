/*============================================================================*/
/* job_TruncateTable.sen -- Job Truncate Table                                */
/*============================================================================*/

" job_TruncateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute Job_TruncateTable job on a node                                    */
/*----------------------------------------------------------------------------*/
: truncateTable::execute _eeh ( -- )

  job::this locals| pJob_TruncateTable |

  0 0 locals| sTableNm pThisTask |

  tp: truncateTable_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pThisTask
  //pJob_TruncateTable pThisTask "truncateTable_exe task: %v Job_TruncateTable %v" fmt.print

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab this task's lock
  pThisTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the acks
  grid::slots task::acks!

  grid::slots 0
  do
    //I "Creating Job_SubTruncate %v" fmt.print
    I pJob_TruncateTable job_truncateTable.spawnSub
  loop

  //"truncateTable ack waiting" .
  task::wait
  //"truncateTable acked" .
;

/*----------------------------------------------------------------------------*/
/* execute Job_TruncateTable job check resources                              */
/*----------------------------------------------------------------------------*/
: truncateTable::checkResources _eeh ( -- )

  job::this locals| pJob_TruncateTable |
  0 locals| sTableNm |

  tp: truncateTable.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  checkInTables not if pJob_TruncateTable <ERROR_JOB> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // there should be a table folder
  <tableNm> to sTableNm
  sTableNm checkIsTableFolder not if pJob_TruncateTable <ERROR_JOB> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm checkIsTable not if popTable pJob_TruncateTable <ERROR_JOB> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  popTable
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: truncateTable :: truncateTable <tableNm> ;
jobSyntax: truncateTable :: trtbl <tableNm> ;

jobInfo: truncateTable
{
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_GRAB_WRITE
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
