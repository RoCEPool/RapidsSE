/*============================================================================*/
/* job_OutputOp.sen -- Job OutputOp                                           */
/*============================================================================*/

" job_OutputOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for outputOp request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : output_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_OutputOp |

   tp: outputOp_req

   pJob_OutputOp job.opLoop

   //pJob_OutputOp job::participantExecuted

  <<logExit <DONE_RUN>
;

: output_rcv ( -- )
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: output :: output ;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobInfo: output
{
  jobKind      = JK_CHILD
  responseKind = RS_NODE_ZERO
  
  exeLock      = DL_GRAB_READ
  preCheck     = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
