/*============================================================================*/
/* job_OutputOp.sen -- Job OutputOp                                           */
/*============================================================================*/

" job_OutputOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for outputOp request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: outputOp_req ( -- )

  >>logEntry <SEED_REQ>

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // link sinkOp to next stage
  op.linkNextStage

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        //"Operand:- ZK_CRWBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeToJob
        true
      endof

      ZK_CSVBUFFER of
        //"Operand:- ZK_CSVBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeToJob
        true
      endof

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        Operand[].pipeToJob
        Operand[].newEosMarker
        Operand[].pipeOut
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        Operand[].pipeToJob
        Operand[].newErrorMarker
        Operand[].pipeOut
        true
      endof

      ZK_ENTBUFFER of
        //"Operand:- ZK_ENTBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeToJob
        true
      endof

      ZK_IRWBUFFER of
        //"Operand:- ZK_IRWBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeToJob
        true
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut
        Operand[].newPulseMarker
        Operand[].pipeToJob
        true
      endof

      ZK_SRTBUFFER of
        //"Operand:- ZK_SRTBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeToJob
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        //origPipelineJob job.signalWaiter
        Operand[].pipeToJob
        Operand[].newStartMarker
        Operand[].pipeOut
        //Operand[].newStartMarker
        //Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        Operand[].pipeOut
        Op.ackPipelineJob
        false
        endof

      ZK_STREAMDEF of
        //"Operand:- ZK_STREAMDEF" .verbose
        Operand[].workDone
        Operand[].pipeToJob
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: outputOp :: outputOp ;
jobSyntax: outputOp :: outputOp <topology> <nextStage> ;

jobInfo: outputOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_OUTPUTOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
