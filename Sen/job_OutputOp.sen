/*============================================================================*/
/* job_OutputOp.sen -- Job OutputOp                                           */
/*============================================================================*/

" job_OutputOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for outputOp request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : output_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_OutputOp |


   begin
     pJob_OutputOp job.LoopOutputOp
     "biding" .
   while
     "continuing" .
     pJob_OutputOp job.LoopOutputOp
   repeat

   //pJob_OutputOp job::participantExecuted

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: output :: output ;

jobInfo: output
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_OUTPUTOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
