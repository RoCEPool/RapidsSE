/*============================================================================*/
/* se_kbase.sen -- kbase primitives                                           */
/*============================================================================*/

" se_kbase.sen" .verbose


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Aha{
  
  input::chars .
  
  input::next .
  input::next .
  input::next .
  input::next . input::isCloseBrace assert

;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Set{
  
  input::chars .
  
  input::next .
  input::next .
  input::next .
  input::next . input::isCloseBrace assert

;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Atr{
  
  input::chars .
  
  begin
  
    input::next .
  
    input::isCloseBrace not
  while repeat
;
    
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tpl{
  
  input::chars .
  
  input::next .
  input::next .
  input::next .
  input::next . input::isCloseBrace assert

;
 
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Ancestory:
  
  input::next .
  input::next .

;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: AtrOf:
  
  input::chars .

  input::next .
  input::next .

;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: ElmOf:
  
  input::chars .

  input::next .
  input::next .

;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: SubOf:
  
  input::chars .

  input::next .
  input::next .

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
