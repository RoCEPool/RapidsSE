/*============================================================================*/
/* se_kbase.sen -- kbase primitives                                           */
/*============================================================================*/

" se_kbase.sen" .verbose


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Aha{
  
  input::chars . // Aha{
  
  input::next .  // [01]
  input::next .  // (address)
  input::next .  // (name)
  input::next .  // }
    input::isCloseBrace assert
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Set{
  
  input::chars . // Set{
  
  input::next .  // [01]
    input::chars str.gleanInt .
  
  input::next .  // (address)
  
  input::next .  // (name)
  
  input::next .  // }
    input::isCloseBrace assert
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Atr{
  
  input::chars . // Atr{
  
  input::next .  // [01]
  
  input::next .  // (address)
  
  input::next .  // (name)

  begin
  
    input::next .
  
    input::isCloseBrace not
  while repeat
;
    
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tpl{
  
  input::chars .  // Tpl{
  
  input::next .   // [01]
  input::next .   // (address)
  input::next .   // (name
  input::next .   // }
    input::isCloseBrace assert
;
 
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Ancestory:
  
  input::next . // Ancestory:
  input::next . // (ancestory)
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: AtrOf:
  
  input::chars . // AtrOf:

  input::next .  // [01]
  input::next .  // (name
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: ElmOf:
  
  input::chars . // ElmOf:

  input::next .  // [01]
  input::next .  // (name
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: SubOf:
  
  input::chars . // SubOf:

  input::next .  // [01]
  input::next .  // (name)
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
