/*============================================================================*/
/* se_kbase.sen -- kbase primitives                                           */
/*============================================================================*/

" se_kbase.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Aha{
  
  input::chars . // Aha{
  
  input::next .  // [01]
  input::next .  // (address)
  input::next .  // (name)
  input::next .  // }
    input::isCloseBrace assert
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Set{
  
  0 0 locals| iFactNo sFactNm |
  
  input::chars . // Set{
  
  input::next .  // [01]
    input::chars str.gleanInt to iFactNo
  
  input::next .  // (address)
  
  input::next .  // (name)
    input::chars to sFactNm
  
  input::next .  // }
    input::isCloseBrace assert
  
  sFactNm iFactNo "-- Set{ %v %v }" .printf
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Atr{
  
  0 0 locals| iFactNo sFactNm |

  input::chars . // Atr{
  
  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (address)
  
  input::next .  // (name)
    input::chars to sFactNm

  begin
  
    input::next .
  
    input::isCloseBrace not
  while repeat
    
  sFactNm iFactNo "-- Atr{ %v %v }" .printf
;
    
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tpl{
  
  0 0 locals| iFactNo sFactNm |

  input::chars .  // Tpl{
  
  input::next .   // [01]
    input::chars str.gleanInt to iFactNo

  input::next .   // (address)
  
  input::next .   // (name)
    input::chars to sFactNm

  input::next .   // }
    input::isCloseBrace assert
  
  sFactNm iFactNo "-- Tpl{ %v %v }" .printf
;
 
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Ancestory:
  
  input::next . // Ancestory:
  input::next . // (ancestory)
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: AtrOf:
  
  0 0 locals| iFactNo sFactNm |

  input::chars . // AtrOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (name)
    input::chars to sFactNm

    sFactNm iFactNo "++ AtrOf: %v %v" .printf
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: ElmOf:
  
  0 0 locals| iFactNo sFactNm |

  input::chars . // ElmOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo
  
  input::next .  // (name)
    input::chars to sFactNm

  sFactNm iFactNo "++ ElmOf: %v %v" .printf
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: SubOf:
  
  0 0 locals| iFactNo sFactNm |
  
  input::chars . // SubOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (name)
    input::chars to sFactNm

  sFactNm iFactNo "++ SubOf: %v %v" .printf
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
