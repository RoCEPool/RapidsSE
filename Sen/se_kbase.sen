/*============================================================================*/
/* se_kbase.sen -- kbase primitives                                           */
/*============================================================================*/

" se_kbase.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Aha{
  
  input::chars . // Aha{
  
  input::next .  // [01]
  input::next .  // (address)
  input::next .  // (name)
  input::next .  // }
    input::isCloseBrace assert
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Set{
  
  0 0 locals| iFactNo sFactNm |
  
  input::chars . // Set{
  
  input::next .  // [01]
    input::chars str.gleanInt to iFactNo
  
  input::next .  // (address)
  
  input::next .  // (name)
    input::chars to sFactNm
  
  input::next .  // }
    input::isCloseBrace assert
  
  sFactNm iFactNo "-- Set{ %v %v }" .printf
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Atr{
  
  0 0 0 0 0 locals| iFactNo sFactNm bIsText iValue sValue |

  input::chars . // Atr{
  
  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (address)
  
  input::next .  // (name)
    input::chars to sFactNm

//  begin
//
//    input::next .
//
//    input::isCloseBrace not
//  while repeat
  
  input::next .  // =
  input::next .  // Int/Text
  input::chars "Int" str.same if
    input::next .  // <value>
    input::chars >int to iValue
    0 to bIsText
  else
    input::chars "Text" str.same if
      input::next .  // <value>
      input::chars to sValue
      1 to bIsText
  else
    "Unknown = type" .
  then then

  input::next .  // }
    input::isCloseBrace assert

  bIsText if
    sValue sFactNm iFactNo "-- Atr{ %v %v = Text %v }" .printf
  else
    iValue sFactNm iFactNo "-- Atr{ %v %v = Int %v }" .printf
  then
;
    
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tpl{
  
  0 0 locals| iFactNo sFactNm |

  input::chars .  // Tpl{
  
  input::next .   // [01]
    input::chars str.gleanInt to iFactNo

  input::next .   // (address)
  
  input::next .   // (name)
    input::chars to sFactNm

  input::next .   // }
    input::isCloseBrace assert
  
  sFactNm iFactNo "-- Tpl{ %v %v }" .printf
;
 
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Ancestory:
  
  input::next . // Ancestory:
  input::next . // (ancestory)
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: AtrOf:
  
  0 0 locals| iFactNo sFactNm |

  input::chars . // AtrOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (name)
    input::chars to sFactNm

    sFactNm iFactNo "++ AtrOf: %v %v" .printf
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: ElmOf:
  
  0 0 locals| iFactNo sFactNm |

  input::chars . // ElmOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo
  
  input::next .  // (name)
    input::chars to sFactNm

  sFactNm iFactNo "++ ElmOf: %v %v" .printf
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: SubOf:
  
  0 0 locals| iFactNo sFactNm |
  
  input::chars . // SubOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (name)
    input::chars to sFactNm

  sFactNm iFactNo "++ SubOf: %v %v" .printf
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
