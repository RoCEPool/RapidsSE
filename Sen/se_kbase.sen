/*============================================================================*/
/* se_kbase.sen -- kbase primitives                                           */
/*============================================================================*/

" se_kbase.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Aha{
  
  input::chars . // Aha{
  
  input::next .  // [01]
  input::next .  // (address)
  input::next .  // (name)
  input::next .  // }
    input::isCloseBrace assert
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Set{
  
  0 0 locals| iFactNo sFactNm |
  
  input::chars . // Set{
  
  input::next .  // [01]
    input::chars str.gleanInt to iFactNo
  
  input::next .  // (address)
  
  input::next .  // (name)
    input::chars to sFactNm
  
  input::next .  // }
    input::isCloseBrace assert
  
  // --
  
  sFactNm iFactNo "-- Set{ %v %v }" .printf
  
  nullptr fact[].set

  sFactNm iFactNo fact[].new
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Atr{
  
  0 0 0 0 0 locals| iFactNo sFactNm bIsText iValue sValue |

  input::chars . // Atr{
  
  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (address)
  
  input::next .  // (name)
    input::chars to sFactNm

//  begin
//
//    input::next .
//
//    input::isCloseBrace not
//  while repeat
  
  input::next .  // =
  input::next .  // Int/Text
  input::chars "Int" str.same if
    input::next .  // <value>
    input::chars >int to iValue
    0 to bIsText
  else
    input::chars "Text" str.same if
      input::next .  // <value>
      input::chars to sValue
      1 to bIsText
  else
    "Unknown = type" .
  then then

  input::next .  // }
    input::isCloseBrace assert
    
  // --

  bIsText if
    sValue sFactNm iFactNo "-- Atr{ %v %v = Text %v }" .printf
    
    nullptr fact[].set
    
    sFactNm iFactNo fact[].new
    
    sValue Fact[].setText
  else
    iValue sFactNm iFactNo "-- Atr{ %v %v = Int %v }" .printf
    
    nullptr fact[].set
    
    sFactNm iFactNo fact[].new
    
    iValue Fact[].setInt
  then
;
    
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tpl{
  
  0 0 locals| iFactNo sFactNm |

  input::chars .  // Tpl{
  
  input::next .   // [01]
    input::chars str.gleanInt to iFactNo

  input::next .   // (address)
  
  input::next .   // (name)
    input::chars to sFactNm

  input::next .   // }
    input::isCloseBrace assert
  
  // --
  
  sFactNm iFactNo "-- Tpl{ %v %v }" .printf
  
  nullptr fact[].set
  
  sFactNm iFactNo fact[].new
;
 
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Ancestory:
  
  input::next . // Ancestory:
  input::next . // (ancestory)
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: AtrOf:
  
  0 0 0 locals| iFactNo sFactNm pAtrOf |

  input::chars . // AtrOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (name)
    input::chars to sFactNm

  // --

  sFactNm iFactNo "++ AtrOf: %v %v" .printf
  
  iFactNo kbase[].findFactNo to pAtrOf
  
  pAtrOf Fact[].atrOf
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: ElmOf:
  
  0 0 0 locals| iFactNo sFactNm pElmOf |

  input::chars . // ElmOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo
  
  input::next .  // (name)
    input::chars to sFactNm

  // --
  
  iFactNo kbase[].findFactNo to pElmOf
  
  kbase[].marker@ if
    
    pElmOf kbase[].marker@ fact.elmOf
    
    nullptr kbase[].marker!
    
  then
  
  // --

  sFactNm iFactNo "++ ElmOf: %v %v" .printf
  
  pElmOf Fact[].elmOf
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: SubOf:
  
  0 0 0 locals| iFactNo sFactNm pSubOf |
  
  input::chars . // SubOf:

  input::next .  // [01]
    input::chars str.gleanInt to iFactNo

  input::next .  // (name)
    input::chars to sFactNm
  
  // --

  sFactNm iFactNo "++ SubOf: %v %v" .printf
  
  iFactNo kbase[].findFactNo to pSubOf
  
  pSubOf Fact[].subOf
;
  
/*----------------------------------------------------------------------------*/
/* add a marker                                                               */
/*----------------------------------------------------------------------------*/
: !Mrk
  
  0 locals| sFactNm |
  
  input::chars . // !Mrk
  
  input::next .  // (name)
    input::chars to sFactNm

  nullptr fact[].set
  
  sFactNm kbase[].markerNew kbase[].marker!
;

/*----------------------------------------------------------------------------*/
/* add a transform                                                            */
/*----------------------------------------------------------------------------*/
: !Trf
  
  input::chars . // !Trf
  
  input::next .  // (name)
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
