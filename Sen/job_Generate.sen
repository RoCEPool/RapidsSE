/*============================================================================*/
/* job_Generate.sen -- Generate Rows Job                                      */
/*============================================================================*/

" job_Generate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Job_Generate request (on command node)                                     */
/*----------------------------------------------------------------------------*/
: Generate_req (  -- <R> )

  >>logEntry <SEED_REQ2>

  0 locals| sTableNm |
  0 locals| pTable |

  job::this locals| pJob_Generate |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  //pJob_Generate job.pushPath
  //task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab ddl read lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  checkInTables not if pJob_Generate <ERROR_REQUEST> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table name from job
  //pJob_Generate job.objectName@ to sTableNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm checkIsTable not if popTable pJob_Generate <ERROR_REQUEST> !!logError exit then

  //----------------------------------------------------------------------------

  // get table
  sTableNm find execute to pTable
  pTable pJob_Generate job_GenData.table!

  pJob_Generate job_genData.generate

  //----------------------------------------------------------------------------

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  popTable
  assertInTables

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
