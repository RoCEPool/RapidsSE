/*============================================================================*/
/* tpl_localLiteOp.sen -- templates for local lite op                         */
/*============================================================================*/

" tpl_localLiteOp.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_PulseMarker

"
  : /localLiteOp/_PulseMarker \\handler

    /localLiteOp/_action if
      Pipein[].pipeout
      Operand[].newEosMarker
      Operand[].pipeOut
    then

    true
  ;
"
;

/*----------------------------------------------------------------------------*/
/* execute for localLiteOp req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_req

"
  : /localLiteOp/_req \\operator

    LogReqEntry SEED_REQ

    op__topology

    find: /localLiteOp/_PulseMarker  ZK_PULSEMARKER op[].handler!

    op__loop

    LogReqExit
    job::deleteThis
    DONE_REQ_OP
  ;
"
;


/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 0 parameters                                   */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_procedure0

"
  procedureLocal /localLiteOp/
  begin

  stage stageA on origin :
    start | periodicOp once | /localLiteOp/ |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 1 parameter                                    */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_procedure1

"
  procedureLocal /localLiteOp/
    parameters $param
  begin

  stage stageA on origin :
    start | periodicOp once | /localLiteOp/ $param |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 2 parameters                                   */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_procedure2

  "
    procedureLocal /localLiteOp/
      parameters $param0 $param1
    begin

    stage stageA on origin :
      start | periodicOp once | /localLiteOp/ $param0 $param1 |
        output | sink | stageA

    end
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
