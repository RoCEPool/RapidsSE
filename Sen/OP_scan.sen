/*============================================================================*/
/* OP_scan.sen -- Operator scan                                               */
/*============================================================================*/

" OP_scan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scanOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Operand[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // pipeout all subsets from tablePtn
  tablePtn[].root to Subset[]
  Subset[]@ to Operand[]
  begin
    Operand[].isNull
  not while
    Operand[].pipeOut
    Subset[].nextBuffer to Operand[]
  repeat

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scanOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  else

    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
  then

  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* scanOp request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scanOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: scanOp_PulseMarker ZK_PULSEMARKER op[].handler!
  find: scanOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: scanOp :: scanOp <tableNm> ;


opInfo: scanOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: xyzOp tagCopy: localOp_tags
  tags{
    <a> = "value a"
    <b> = C_MAGIC
  }
;

xyzOp enameset.asStr .
    
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: abcOp opInfo tagCopy: localOp_tags
;

abcOp_info enameset.asStr .

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
