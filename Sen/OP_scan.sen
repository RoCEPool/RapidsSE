/*============================================================================*/
/* OP_scan.sen -- Operator scan                                               */
/*============================================================================*/

" OP_scan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scanOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Operand[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // pipeout all subsets from tablePtn
  tablePtn[].root to Subset[]
  Subset[]@ to Operand[]
  begin
    Operand[].isNull
  not while
    Operand[].pipeOut
    Subset[].nextBuffer to Operand[]
  repeat

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scanOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  else

    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
  then

  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* scanOp request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scanOp_req ( -- )

  LogReqEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_PULSEMARKER of scanOp_PulseMarker endof

      ZK_STARTMARKER of scanOp_StartMarker endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogReqExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: scanOp :: scanOp <tableNm> ;


jobInfo: scanOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: tags_localOp
  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
    <ddlLock>  = DL_GRAB_READ
    
    <preCheck> = bClusterStarted
  }
;

tags_localOp enameset.asStr .

: xyzOp tagCopy: tags_localOp
  tags{
    <a> = "value a"
    <b> = C_MAGIC
  }
;

xyzOp enameset.asStr .

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
