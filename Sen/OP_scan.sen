/*============================================================================*/
/* OP_scan.sen -- Operator scan                                               */
/*============================================================================*/

" OP_scan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: ScanOp_CancelMarker \handler

  //"ZK_CANCELMARKER_handler" .verbose
  nullptr to Operand[]
  OperandOoO[].pipeOut
  Op.ackPipelineJob
  false

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: scanOp_CrwBuffer \handler

  0 locals| rateSecs |

  "<rateSecs>" job[] job.enameset@ enameset.hasName if
    <rateSecs> >int to rateSecs
  then

  //"Operand:- ZK_CRWBUFFER" .verbose
  Operand[].pipeOut

  // check for rate
  rateSecs if
    rateSecs "ScanOp Pausing for %v secs" str.format .
    rateSecs task::sleepSsec
    "ScanOp awake" .
  then

  Subset[].nextBuffer to Operand[]

  Operand[].isNull if
    Operand[].newEosMarker
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scanOp_PulseMarker \handler

  0 locals| rateSecs |

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // pipeout all subsets from tablePtn
  tablePtn[].root to Subset[]
  Subset[]@ to Operand[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scanOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut

  else

    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* scanOp request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scanOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: scanOp_CancelMarker ZK_CANCELMARKER op[].handler!
  find: scanOp_CrwBuffer    ZK_CRWBUFFER    op[].handler!
  find: scanOp_PulseMarker  ZK_PULSEMARKER  op[].handler!
  find: scanOp_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: scanOp :: scanOp <tableNm> ;
opSyntax: scanOp :: scanOp <tableNm> <rateSecs> ;

//opInfo: scanOp
//{
//  <jobDesc>  = "--description of operator--"
//
//  <jobKind>  = JK_LOCAL
//  <rspKind>  = RS_PARTICIPANT_RESPONSE
//  <ddlLock>  = DL_GRAB_READ
//
//  <preCheck> = bClusterStarted
//}
//;
//

: scanOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;


