/*============================================================================*/
/* OP_scan.sen -- Operator scan                                               */
/*============================================================================*/

" OP_scan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: Scan_CancelMarker \handler

  //"ZK_CANCELMARKER_handler" .verbose
  nullptr to Operand[]
  Pipein[].pipeOut
  Op.ackPipelineJob
  false

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: scan_CrwBuffer \handler

  0 locals| rateSecs |

  "<rateSecs>" job[] job.enameset@ tagSet.hasName if
    <rateSecs> >int to rateSecs
  then

  //"Operand:- ZK_CRWBUFFER" .verbose
  Operand[].pipeOut

  // check for rate
  rateSecs if
    rateSecs "Scan Pausing for %v secs" str.format .
    rateSecs task::sleepSsec
    "Scan awake" .
  then

  Subset[].nextBuffer to Operand[]

  Operand[].isNull if
    Operand[].newEosMarker
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scan_PulseMarker \handler

  0 locals| rateSecs |

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // pipeout all subsets from tablePtn
  tablePtn[].root to Subset[]
  Subset[]@ to Operand[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scan_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  <tableNm> op__table if
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scan_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: scan_CancelMarker ZK_CANCELMARKER op[].handler!
  find: scan_CrwBuffer    ZK_CRWBUFFER    op[].handler!
  find: scan_PulseMarker  ZK_PULSEMARKER  op[].handler!
  find: scan_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: scan :: scan <tableNm> ;
opSyntax: scan :: scan <tableNm> <rateSecs> ;

//opInfo: scan
//{
//  <jobDesc>  = "--description of operator--"
//
//  <jobKind>  = JK_LOCAL
//  <rspKind>  = RS_PARTICIPANT_RESPONSE
//  <ddlLock>  = DL_GRAB_READ
//
//  <preCheck> = bClusterStarted
//}
//;
//

: scan opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;


