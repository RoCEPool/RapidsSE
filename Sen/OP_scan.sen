/*============================================================================*/
/* OP_scan.sen -- Operator scan                                               */
/*============================================================================*/

" OP_scan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: Scan_CancelMarker \handler

  //"ZK_CANCELMARKER_handler" .verbose
  nullptr to Operand[]
  PipeIn[].pipeOut
  Op.ackPipelineJob
  false

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: scan_CrwBuffer \handler

  0 locals| rateSecs |

  "<rateSecs>" job[] job.tagSet@ tagSet.hasName if
    <rateSecs> >int to rateSecs
  then

  //"Operand:- ZK_CRWBUFFER" .verbose

  // get next buffer
  Subset[].nextBuffer to Subset[]

  // pipeout the operand
  Operand[].pipeOut

  // check for rate
  rateSecs if
    rateSecs "Scan Pausing for %v secs" str.format .
    rateSecs task::sleepSsec
    "Scan awake" .
  then

  // move next buffer to Operand -- CHECK: CAUSES THIS HANDLER TO BE CALLED AGAIN
  Subset[] to Operand[]

  Operand[].isNull if
    tablePtn[] tablePtnDropRead
    Operand[].newEosMarker
    Operand[].pipeOut

    false regset::callAgain!
  else
    true regset::callAgain!
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scan_PulseMarker \handler

  0 locals| rateSecs |

  //"Operand:- ZK_PULSEMARKER" .verbose
  PipeIn[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // grab the table ptn read lock
  tablePtn[] tablePtnGrabRead


//  // -- partition stream test --
//  tablePtn[] ptnStream::new to ptnStream[]
//
//  ptnStream[] ptnStream.open if
//
//    begin
//      ptnStream[] ptnStream.read to Operand[]
//      Operand[].isNull not
//    while
//      Operand[].pipeout
//    repeat
//
//    ptnStream[] ptnStream.close
//  then
//
//  ptnStream[] ptnStream.delete
//  nullptr to ptnStream[]
//  // -- end partition stream test --


  // pipeout all subsets from tablePtn
  tablePtn[].root to Subset[]
  Subset[] to Operand[]

  Operand[].isNull if
    tablePtn[] tablePtnDropRead
    Operand[].newEosMarker
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: scan_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  <tableNm> op__table if
    Table[].tablePtn@ to tablePtn[]
    PipeIn[].pipeOut
  then

  1 debug::flag!

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scan_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: scan_CancelMarker ZK_CANCELMARKER op[].handler!
  find: scan_CrwBuffer    ZK_CRWBUFFER    op[].handler!
  find: scan_PulseMarker  ZK_PULSEMARKER  op[].handler!
  find: scan_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: scan :: scan <tableNm> ;
cmdSyntax: scan :: scan <tableNm> <rateSecs> ;

: scan _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
