/*============================================================================*/
/* vocab_log.sen -- log related words                                       */
/*============================================================================*/

" vocab_log.sen" .verbose

/*----------------------------------------------------------------------------*/
/* log cancel seed action                                                     */
/*----------------------------------------------------------------------------*/
: actLog::seed_can immediate

  word::compiling word.name@ ,

  POSTPONE AN_SEED_CAN

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log end seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::seed_end immediate

  word::compiling word.name@ ,

  POSTPONE AN_SEED_END

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log exe seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::seed_exe immediate

  word::compiling word.name@ ,

  POSTPONE AN_SEED_EXE

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log receive seed action                                                    */
/*----------------------------------------------------------------------------*/
: actLog::seed_rcv immediate

  word::compiling word.name@ ,

  POSTPONE AN_SEED_RCV

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log run seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::seed_req immediate

  word::compiling word.name@ ,

  AN_SEED_REQ ,

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log run seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::seed_run immediate

  word::compiling word.name@ ,

  AN_SEED_RCV ,

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log run seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::resources_checked immediate

  word::compiling word.name@ ,

  AN_RESOURCES_CHECKED ,

  POSTPONE Log::markWord
;

/*----------------------------------------------------------------------------*/
/* log run seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::resources_released immediate

  word::compiling word.name@ ,

  AN_RESOURCES_RELEASED ,

  POSTPONE Log::markWord
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* log word entry                                                             */
/*----------------------------------------------------------------------------*/
: >>logEntry immediate

  // format the string to be printed
  word::compiling word.name@ ">>%v" str.format

  // encode push of that string
  ,

  // encode call to markEntry
  POSTPONE Log::markEntry
;
/*----------------------------------------------------------------------------*/
//: >>logEntry immediate
//
//  POSTPONE job::this
//  POSTPONE job.class
//  POSTPONE class::name
//  ">>%v %v" ,
//
//  POSTPONE str.format
//
//  // encode call to markEntry
//  POSTPONE Log::markEntry
//;


/*----------------------------------------------------------------------------*/
/* log word exit                                                              */
/*----------------------------------------------------------------------------*/
: <<logExit immediate

  // format the string to be printed
  word::compiling word.name@ "<<%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE Log::markExit
;

/*----------------------------------------------------------------------------*/
/* log word error                                                             */
/*----------------------------------------------------------------------------*/
: !!logError immediate

  // format the string to be printed
  word::compiling word.name@ "!!%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE Log::markExit
;

/*----------------------------------------------------------------------------*/
/* log general note                                                           */
/*----------------------------------------------------------------------------*/
: .logNote immediate

  // encode call to markEntry
  POSTPONE Log::mark
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
