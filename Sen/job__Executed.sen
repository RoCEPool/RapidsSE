/*============================================================================*/
/* job__Executed.sen -- generic job related words                             */
/*============================================================================*/

" job__Executed.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job__Executed back to originating node                                */
/*----------------------------------------------------------------------------*/
: Job__Executed::send ( pJobParticipant -- )

  params| pJobParticipant |

  pJobParticipant job.id@ locals| iJobId |

  0 0 0 locals| pJob pJob__Executed error |

  // new a temporary Job__Executed
  pJobParticipant job__Executed::new to pJob__Executed

  // get error if any
  grid::thisNode@ pJobParticipant job.error@ to error

  error EC_NONE == if
    // get the response from participant job and set it in executed job
    grid::thisNode@  pJobParticipant job.response@ pJob__Executed job.response!

    // get the no of rows processed from participant job and set it in executed job
    grid::thisNode@
      pJobParticipant job.rowsProcessed@
      pJob__Executed  job.rowsProcessed!

    grid::thisNode@
      pJobParticipant job.rowsInvalid@
      pJob__Executed  job.rowsInvalid!

    grid::thisNode@
      pJobParticipant job.rowsSkipped@
      pJob__Executed  job.rowsSkipped!
  else
     // set error in executed job
     error pJob__Executed job.error!
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the originator node as the send target node
  //iJobId job::originator@ grid::node task::this task.sendNode!

  // move this task through send state/queue
  //task.send

  // send the executed job
  iJobId job::originator@ pJob__Executed job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete Job__Executed
  pJob__Executed job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job__Executed on originating node                             */
/*----------------------------------------------------------------------------*/
: Job__Executed_rcv ( -- )

  >>am <SEED_RCV>
  an::seed_rcv

  job::this locals| pJob__Executed |
  pJob__Executed job.id@ locals| iJobId |

  0 locals| pJobOriginator  |
  0 0 0 0 locals| iParticipantNode error bAmDecider |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the context of this __executed job

  // find the originating job
  iJobId job::findOriginator to pJobOriginator

  // get the participant node from where this job__begun started
  pJob__Executed job.participant@ to iParticipantNode

  // set the participant response in the originator job
  pJob__Executed iParticipantNode pJobOriginator job.participantResponse!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // process __executed job on this originating node

  // increment the number of __executed jobs received in api state
  pJobOriginator ApiState::incExecuted
  pJobOriginator ApiState::traceSession

  // decrement the acks remaining
  pJobOriginator job.decAcksRemaining to bAmDecider

  // if there are acks remaining just exit
  bAmDecider not if
    job::deleteThis
    <DONE_RCV>
    exit                                                         // *EARLY EXIT*
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // all __executed jobs have been received, so this job is the decider

  // send a job__end to all participants
  pJobOriginator Job__End::distribute

  // delete this completed __executed job
  job::deleteThis

  <DONE_RCV>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
