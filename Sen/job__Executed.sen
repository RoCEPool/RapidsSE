/*============================================================================*/
/* job__Executed.sen -- generic job related words                             */
/*============================================================================*/

" job__Executed.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job__Executed back to originating node                                */
/*----------------------------------------------------------------------------*/
: Job__Executed::send ( pJobParticipant -- )

  params| pJobParticipant |

  pJobParticipant job.id@ locals| iJobId |

  0 0 0 locals| pJob pJob__Executed error |

  // new a temporary Job__Executed
  iJobId job.newExecuted to pJob__Executed

  // get error if any
  grid::thisNode@ pJobParticipant job.error@ to error

  error EC_NONE == if
    // get the response from participant job and set it in executed job
    grid::thisNode@  pJobParticipant job.response@ pJob__Executed jobExecuted.response!

    // get the no of rows processed from participant job and set it in executed job
    grid::thisNode@
      pJobParticipant job.rowsProcessed@
      pJob__Executed  jobExecuted.rowsProcessed!

    grid::thisNode@
      pJobParticipant job.rowsInvalid@
      pJob__Executed  jobExecuted.rowsInvalid!

    grid::thisNode@
      pJobParticipant job.rowsSkipped@
      pJob__Executed  jobExecuted.rowsSkipped!
  else
     // set error in executed job
     error pJob__Executed jobExecuted.error!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the originator node as the send target node
  //iJobId job::originator@ grid::node task::this task.sendNode!

  // move this task through send state/queue
  //task.send

  // send the executed job
  //pJob__Executed >socket

  iJobId job::originator@ pJob__Executed job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete Job__Executed
  pJob__Executed job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job__Executed on originating node                             */
/*----------------------------------------------------------------------------*/
: Job__Executed_rcv ( -- )

  <SEED_RCV>

  job::this locals| pJob__Executed |
  pJob__Executed job.id@ locals| iJobId |

  0 locals| pJobOriginator  |
  0 0 0 0 locals| iParticipantNode error iAcksRemaining |

  // find the job in the originator jobs
  iJobId job::findOriginator to pJobOriginator

  // get the participant nodewhere Job__Executed started
  pJob__Executed job.participant@ to iParticipantNode

  // get the error code from job__executed
  pJob__Executed jobExecuted.error@ to error

  error EC_NONE == if

    // get the response string from job__executed and set in pJob
    pJob__Executed jobExecuted.response@ iParticipantNode pJobOriginator job.response!

    // get the rows processed from job__executed and set in pJob
    pJob__Executed jobExecuted.rowsProcessed@
      iParticipantNode pJobOriginator job.rowsProcessed!

    pJob__Executed jobExecuted.rowsInvalid@
      iParticipantNode pJobOriginator job.rowsInvalid!

    pJob__Executed jobExecuted.rowsSkipped@
      iParticipantNode pJobOriginator job.rowsSkipped!

  else

    // set the error code in pJob
    error iParticipantNode pJobOriginator job.error!

  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // decrement the acks remaining
  pJobOriginator job.decAcksRemaining to iAcksRemaining

  // if there are acks remaining just exit
  iAcksRemaining 0 != if
    delete_completed_job
    <DONE_RCV>
    exit                                                         // *EARLY EXIT*
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //"received Job__Executed from all nodes" .

  pJobOriginator Job__End::distribute

  delete_completed_job

  <DONE_RCV>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
