/*============================================================================*/
/* job_ListTables.sen -- Job List Tables                                      */
/*============================================================================*/

" job_ListTables.sen" .verbose

/*----------------------------------------------------------------------------*/
/* List Tables requests (on the originating node)                             */
/*----------------------------------------------------------------------------*/
: lstbl_req ( -- <R> )

  LogEntry SEED_REQ

  0 0 locals| pJob_ListTables pTask |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task[] to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListTables

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(tableName VARCHAR)"
    pJob_ListTables job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  folder[].CheckInTables not if pJob_ListTables ERROR_REQUEST !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list tables folder contents
  pJob_ListTables folder[].listTableContents

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  LogExit DONE_REQ
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: lstbl :: lstbl ;

jobInfo: lstbl
{
  <jobKind> = JK_LOCAL
  <rspKind> = RS_JOB_RESPONSE
  <ddlLock> = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
