/*============================================================================*/
/* db_partition.sen -- partition related words                                */
/*============================================================================*/

" db_partition.sen" .verbose

/*----------------------------------------------------------------------------*/
/* make a partitions folder under given named table                           */
/*----------------------------------------------------------------------------*/
: makePartitions ( "<tableNm>" -- )

  locals| tableNm |

  args.tracepoint if
    tableNm "MAKING PARTITIONS FOR TABLE " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  tableNm find execute ( dic )
  "partitions" ( dic "partitions" )
  swap         ( "partitions" dic )
  :folder      ( )
;

/*----------------------------------------------------------------------------*/
/* check within partitions folder                                             */
/*----------------------------------------------------------------------------*/
: withinPartitions
  pathDepth 1 - pathPick dic.name "partitions" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in partitions folder                                                 */
/*----------------------------------------------------------------------------*/
: checkInPartitions
  withinPartitions if true exit then
  EC_NOT_IN_PARTITIONS false
;

/*----------------------------------------------------------------------------*/
/* find the partitions folder and push it onto task dictionary                */
/*----------------------------------------------------------------------------*/
: pushPartitions ( -- )
  "partitions" find execute pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the partitions folder                                                  */
/*----------------------------------------------------------------------------*/
: popPartitions
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* find the partition sub folder and push it onto task dictionary             */
/*----------------------------------------------------------------------------*/
: pushPartitionSub ( "<tableNm>" -- )
  find execute table.slots slots.subDic pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the partition sub folder                                               */
/*----------------------------------------------------------------------------*/
: popPartitionSub
  pathDrop
;


/*----------------------------------------------------------------------------*/
/* assert top of task dictionary stack is partitions                          */
/*----------------------------------------------------------------------------*/
: assertInPartitions ( -- t|f )
  withinPartitions assert
;

/*----------------------------------------------------------------------------*/
/* tidy up of the partition                                                   */
/*----------------------------------------------------------------------------*/
: partitionTidyUp ( "<tableNm>" -- )

   find execute ( ^tablePtr )
   
   // forget all column names
   dup table.slots slots.subDic
   pathPush
   "columns" find execute forgetAll
   pathDrop

  // forget the sub dictionary
  table.slots slots.subDic forgetAll
;

/*----------------------------------------------------------------------------*/
/* grab read lock on a partition of given table                               */
/*----------------------------------------------------------------------------*/
: tablePtnGrabRead ( i_Partition pTable -- )

  locals| pTable |      // given table
  locals| i_Partition | // which partition

  begin
    i_Partition pTable table.getPtn tablePtn.attemptGrabRead
    not while
      task.yield
  repeat
;

/*----------------------------------------------------------------------------*/
/* grab write lock on a partition of given table                              */
/*----------------------------------------------------------------------------*/
: tablePtnGrabWrite ( i_Partition pTable -- )

  locals| pTable |      // given table
  locals| i_Partition | // which partition

  begin
    i_Partition pTable table.getPtn tablePtn.attemptGrabWrite
    not while
      task.yield
  repeat
;

/*----------------------------------------------------------------------------*/
/* drop read lock on a partition of given table                               */
/*----------------------------------------------------------------------------*/
: tablePtnDropRead ( i_Partition pTable -- )

  locals| pTable |      // given table
  locals| i_Partition | // which partition

  i_Partition pTable table.getPtn tablePtn.dropRead
;

/*----------------------------------------------------------------------------*/
/* drop write lock on a partition of given table                              */
/*----------------------------------------------------------------------------*/
: tablePtnDropWrite ( i_Partition pTable -- )

  locals| pTable |      // given table
  locals| i_Partition | // which partition

  i_Partition pTable table.getPtn tablePtn.dropWrite
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
