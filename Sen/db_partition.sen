/*============================================================================*/
/* db_partition.sen -- partition related words                                */
/*============================================================================*/

" db_partition.sen" .verbose

/*----------------------------------------------------------------------------*/
/* make a partitions folder under given named table                           */
/*----------------------------------------------------------------------------*/
: makePartitions ( "<tableNm>" -- )

  params| tableNm |

  args.tracepoint if
    tableNm "MAKING PARTITIONS FOR TABLE " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  tableNm find execute ( dic )
  "partitions" ( dic "partitions" )
  swap         ( "partitions" dic )
  folder::makeSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* check within partitions folder                                             */
/*----------------------------------------------------------------------------*/
: folder[].isPartitions
  folder[] dic.name@ "partitions" str.same
;

/*----------------------------------------------------------------------------*/
/* check in partitions folder                                                 */
/*----------------------------------------------------------------------------*/
: checkInPartitions
  folder[].isPartitions if true exit then
  EC_NOT_IN_PARTITIONS false
;

/*----------------------------------------------------------------------------*/
/* find the partitions folder and push it onto task dictionary                */
/*----------------------------------------------------------------------------*/
: pushPartitions ( -- )
  "partitions" find execute path[].pushFolder
  true
;

/*----------------------------------------------------------------------------*/
/* pop the partitions folder                                                  */
/*----------------------------------------------------------------------------*/
: popPartitions
  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* pop the partition sub folder                                               */
/*----------------------------------------------------------------------------*/
: popPartitionSub
  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* assert top of task dictionary stack is partitions                          */
/*----------------------------------------------------------------------------*/
: assertInPartitions ( -- t|f )
  folder[].isPartitions assert
;

/*----------------------------------------------------------------------------*/
/* grab write lock on a partition of given table                              */
/*----------------------------------------------------------------------------*/
: tablePtnGrabWrite ( pTablePtn -- )

  params| pTablePtn |   // table partition

  begin
    pTablePtn tablePtn.attemptGrabWrite
  not while
    task::yield
  repeat
;

/*----------------------------------------------------------------------------*/
/* grab write lock on given table ptn (with 1ms sleep loop till grabbed)      */
/*----------------------------------------------------------------------------*/
: tablePtnGrabWrite_msec params| pTablePtn |

  begin
    pTablePtn tablePtn.attemptGrabWrite
  not while
    1 task::sleepMsec
  repeat
;

/*----------------------------------------------------------------------------*/
/* grab read lock on a partition of given table                               */
/*----------------------------------------------------------------------------*/
: tablePtnGrabRead ( pTablePtn -- )

  params| pTablePtn |   // table partition

  begin
    pTablePtn tablePtn.attemptGrabRead
  not while
    task::yield
  repeat
;

/*----------------------------------------------------------------------------*/
/* drop read lock on a partition of given table                               */
/*----------------------------------------------------------------------------*/
: tablePtnDropRead ( pTablePtn -- )

  params| pTablePtn |  // given tablePtn

  pTablePtn tablePtn.dropRead
;

/*----------------------------------------------------------------------------*/
/* drop write lock on a partition of given table                              */
/*----------------------------------------------------------------------------*/
: tablePtnDropWrite ( pTablePtn -- )

  params| pTablePtn |  // given tablePtn

  pTablePtn tablePtn.dropWrite
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
