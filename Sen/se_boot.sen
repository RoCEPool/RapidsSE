/*============================================================================*/
/* se_boot.sen -- compile the dictionary                                      */
/*============================================================================*/

"se_boot.sen" .verbose

"Compilation progress: " .put

9 .put
        "se_categories.sen"  include
8 .put
        "vocab_core.sen"     include
        "vocab_word.sen"     include

        "vocab_str.sen"      include

        "vocab_log.sen"      include
        "vocab_path.sen"     include
        "vocab_object.sen"   include
        "vocab_socket.sen"   include
        "vocab_prompt.sen"   include

7 .put  
6 .put  "gridModel.sen"      include
5 .put  "dbObjects.sen"      include
4 .put  
        "se_categories.sen"  include
        "se_tags.sen"        include
        "se_requests.sen"    include
3 .put  "jobModel.sen"       include
2 .put  "operators.sen"      include
        "testing.sen"        include
1 .put  "se_docols.sen"      include
        "se_munge.sen"       include
        "se_vortex.sen"      include
0 .put

.\n


/*----------------------------------------------------------------------------*/
/* make /tenants/boray/catalogs/rapidsse/schemas/public/tables                */
/*----------------------------------------------------------------------------*/
: makeDefaultFolders ( )

  assert::stack_0

  // make the tenants root folder
  "tenants" :makeFolder attachMap::tenants!

  attachmap::tenants@ execute
  path[].pushFolder

    // make tenant folder:
    //  /tenants/boray
    //  /tenants/boray/catalogs
    "boray" :makeTenantFolder

    "boray" folder[].findSymbol execute
    path[].pushFolder

      "catalogs" folder[].findSymbol execute
      path[].pushFolder

        // make catalog folder:
        //  /tenants/boray/catalogs/rapidsse
        //  /tenants/boray/catalogs/rapidsse/schemas
        "rapidsse" :makeCatalogFolder

          "rapidsse" folder[].findSymbol execute
          path[].pushFolder

            "schemas" folder[].findSymbol execute
            path[].pushFolder

              // make schema folder:
              //  /tenants/boray/catalogs/rapidsse/schemas/public
              //  /tenants/boray/catalogs/rapidsse/schemas/public/tables
              "public" :makeSchemaFolder

            path[].discardFolder
        path[].discardFolder
      path[].discardFolder
    path[].discardFolder

  assert::stack_0
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

"Creating default folders" .verbose

makeDefaultFolders

assert::stack_0

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
