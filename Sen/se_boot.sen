/*============================================================================*/
/* se_boot.sen -- compile the dictionary                                      */
/*============================================================================*/

"se_boot.sen" .verbose

: category immediate

  true
  compiler::current@
  word.immediate!

  compiler::current@ ,
  POSTPONE compiler::current@
  POSTPONE word.category!
;

find: category word.dump
find: category word.see

: procCatg category ;

find: procCatg word.dump
find: procCatg word.see

: testProc procCatg ;

find: testProc word.dump
find: testProc word.see

"SEN: " .put
9 .put  "vocab.sen"     include
8 .put  "tasks.sen"     include
7 .put  "gridModel.sen" include
6 .put  "dbObjects.sen" include
3 .put  "prompt.sen"    include
5 .put  "jobModel.sen"  include
4 .put  "testing.sen"   include
2 .put  "pipelines.sen" include
1 .put  "se.sen"        include  // last
0 .put  .\n

assert::stack_0

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
