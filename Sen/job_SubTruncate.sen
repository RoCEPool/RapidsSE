/*============================================================================*/
/* job_SubTruncate.sen -- Job SubTruncate                                     */
/*============================================================================*/

" job_SubTruncate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* SubTruncate (on each node)                                                 */
/*----------------------------------------------------------------------------*/
: SubTruncate_run ( -- <R> )

  <SEED_RUN>

  0 0 locals| pJob_SubTruncate pTask |
  0 0 0 locals| iSlot pTable sTableNm |
  0 0 0 locals| iTrucateJobId pJob_TruncateTable pTask_TruncateTable |

  tp: SubTruncate
  //"SubTruncate_run" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_SubTruncate

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  //ddlLock::grabWrite

  // get truncate job
  pJob_SubTruncate job_SubTruncate.truncateJobId@ to iTrucateJobId
  pJob_SubTruncate iTrucateJobId job::findParticipant to pJob_TruncateTable
  pJob_TruncateTable job_truncateTable.task@ to pTask_TruncateTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack from truncate (sub has no session)
  pTask_TruncateTable task.job@ getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  pJob_SubTruncate job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the table
  sTableNm find execute to pTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the slot this sub truncate is supposed to work on
  pJob_SubTruncate job_subTruncate.slot@ to iSlot

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // truncate table for iSlot
  iSlot pTable table.truncate

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  popTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // notify the truncate job
  pTask_TruncateTable task.ack

  // null the job in the task
  nullptr pTask task.job!

  // now delete the ended job
  pJob_SubTruncate job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
