/*============================================================================*/
/* job_SubTruncate.sen -- Job SubTruncate                                     */
/*============================================================================*/

" job_SubTruncate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* SubTruncate (on each node)                                                 */
/*----------------------------------------------------------------------------*/
: SubTruncate_run ( -- <R> )

<path> .
  >>logEntry <<SEED_RUN>

  0 0 locals| pJob_SubTruncate pTask |
  0 0 0 locals| iSlot pTable sTableNm |
  0 0 locals| iTrucateJobId pJob_TruncateTable |

  tp: SubTruncate
  //"SubTruncate_run" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_SubTruncate

  // get truncate job
  pJob_SubTruncate job_SubTruncate.truncateJobId@ to iTrucateJobId
  pJob_SubTruncate iTrucateJobId job::waitParticipant to pJob_TruncateTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // first check if the job is executing SS_SEED_EXE
  // then get the task that is executing it
  begin
    pJob_TruncateTable job.IsExecuting
  not while
    1 thread::sleepMsec
  repeat

  pJob_TruncateTable job.task@ locals| pTask_TruncateTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for acks to be set in the truncate task
  begin
    pTask_TruncateTable task.IsAckSet
  not while
    1 thread::sleepMsec
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  <tableNm> to sTableNm

  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the table
  sTableNm find execute to pTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the slot this sub truncate is supposed to work on
  pJob_SubTruncate job_subTruncate.slot@ to iSlot

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // truncate table for iSlot
  iSlot pTable table.truncate

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  popTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // notify the truncate job
  pTask_TruncateTable task.grabLock
  pTask_TruncateTable task.dropLock
  pTask_TruncateTable task.ack

  <DONE_RUN>

  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
