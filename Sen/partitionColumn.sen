/*============================================================================*/
/* partitionColumn.sen -- partition column related words                      */
/*============================================================================*/

"partitionColumn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* partitionColumn is used as a kind of word to identify partition columns    */
/*----------------------------------------------------------------------------*/
: partitionColumn: ;

/*----------------------------------------------------------------------------*/
/* make the partition columns sub folder                                      */
/*----------------------------------------------------------------------------*/
: makePartitionColumns ( "<tableNm>" -- )

  find execute ( dic )
  table.partSubDic pathPush "columns" :dic drop pathDrop
;

/*----------------------------------------------------------------------------*/
/* check within partitions columns folder                                     */
/*----------------------------------------------------------------------------*/
: withinPartitionColumns
    0 pathPick dic.name "columns" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in partitions columns folder                                         */
/*----------------------------------------------------------------------------*/
: checkInPartitionColumns
    withinPartitionColumns if true exit then
    EC_NOT_IN_COLUMNS false
;

/*----------------------------------------------------------------------------*/
/* find the partitions column folder and push it onto task dictionary         */
/*----------------------------------------------------------------------------*/
: pushPartitionColumns ( -- )

    "columns" checkIsWord
    not if EC_NO_COLUMNS_DIC false exit then
    execute pathPush
    true
;

/*----------------------------------------------------------------------------*/
/* pop the partition column folder                                            */
/*----------------------------------------------------------------------------*/
: popPartitionColumns
    pathDrop
;

/*----------------------------------------------------------------------------*/
/* create partition column as a constant                                      */
/*----------------------------------------------------------------------------*/
: :partitionColumn ( "<columnName>" )
  :constant
;

/*----------------------------------------------------------------------------*/
/* check and add a partition column                                           */
/*----------------------------------------------------------------------------*/
: checkAddPartitionColumn ( "<columnName>" "<tableNm>" -- true | eEC false )

  locals| tableNm columnNm |

  // check we are in the partitions folder
  checkInPartitions not if false exit then

  // move out of the partitions folder temporarily
  popPartitions

  // push the table sub folder
  tableNm pushTableSub assert

  // push the table columns folder
  "pushColumns" find execute

  // look for the partition column in the table columns
  columnNm findInCurrent

  // column should exist in table
  not if EC_INVALID_COLUMN false
   "popColumns" find execute popTableSub pushPartitions assert exit
  then

  // pop the columns folder
  "popColumns" find execute

  // pop the tables sub folder
  popTableSub

  // push back the partitions folder
  pushPartitions assert

  // push the partitions sub folder
  tableNm pushPartitionSub assert

  // push the partitions columns folder
  pushPartitionColumns assert // not if false exit then

  // look for the column in the partitions columns
  columnNm findInCurrent

  // column should not already exist
  if EC_DUPLICATE_COLUMN false popPartitionColumns popPartitions exit then

  //pop the partition columns folder
  popPartitionColumns

  // pop the partition sub folder
  popPartitionSub

  assertInPartitions

  true
;

/*----------------------------------------------------------------------------*/
/* list columns of table partitioning                                         */
/*----------------------------------------------------------------------------*/
: listPartitionColumns ( "<tableNm>" -- list )
/*
  find execute ( ^tablePtr )

  0 locals| partitionCols tablePtr |
  tablePtr partition.columnCount to partitionCols

  ""                             // initial ls string
  args.metadata if
    indexCols 0 do
      I tablePtr partition.columnName
      "row: ('%v', '%v')\n" str.format
      str.cat
    loop
    partitionCols task::this task.seitf@ seitf.rowsProcessed
  else

    indexCols 0 do
      I tablePtr partition.columnName
      "%v %v " str.format
      I 1 + partitionCols < if
        swap ", " str.cat
      then
      str.cat
    loop
  then
*/
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* add an index column (run by all participants)                              */
/*----------------------------------------------------------------------------*/
: addPartitionColumn allParticipants 2 checkResult ( "<columnNm>" "<tableNm>" -- <result> )

  locals| tableNm columnNm |

  args.tracepoint if
    "ADDING PARTITION COLUMN " columnNm str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  tp: addingPartitionColumn

  // push the partitions sub folder
  tableNm pushPartitionSub assert

  // push partition columns folder
  pushPartitionColumns assert

  columnNm columnNm    ( "<columnNm>" "<columnNm>" )
  :partitionColumn

  // pop partition columns folder
  popPartitionColumns

  // pop the partitions folder
  popPartitionSub

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* create the column vector of the partition                                  */
/*----------------------------------------------------------------------------*/
: columnVecPartition allParticipants 1 checkResult ( "<tableNm>" -- true n# true )

  0 locals| tablePtr tableNm |

  // get index ptr
  tableNm findInCurrent execute to tablePtr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // double check we can see the index
  //indexPtr find execute stk drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // push the partition sub dic and then the columns sub dic
  tablePtr pushPartitionSub assert

  pushPartitionColumns assert

  // double check the path
  //task::this task.dicStack dicPath.dump

  // iterate contents of columns dictionary 
  0 pathPick dic.lastWord dup
  iterate                        // iterate word cursor
    object@ execute              ( value )
    object@ word.name            ( value wordNm )
    tablePtr                     ( value wordNm ^table )
    table.partColumnVec
    object@ word.prev object!    // advance cursor backwards thru words
  next

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //indexPtr index.showColumnVec

  assert::stack_0

  popPartitionColumns

  popPartitionSub

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
