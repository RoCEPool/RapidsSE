/*============================================================================*/
/* job_Connector.sen -- connector job                                         */
/*============================================================================*/

" job_Connector.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send node info to node we just connected to                                */
/*----------------------------------------------------------------------------*/
: .sendNodeInfo ( pSocket -- )

  params| pSocket |

  0 locals| pJobClass_NodeInfo |
  0 locals| pJob_NodeInfo |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the node info job
  CN_JOB_NODEINFO jobClass::find to pJobClass_NodeInfo
  pJobClass_NodeInfo jobClass.new to pJob_NodeInfo

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // send node info job to the other node
  pSocket socket.grabWrite
  pJob_NodeInfo pSocket socket.sendObject assert
  pSocket socket.dropWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete node info job
  pJob_NodeInfo job.delete
;

/*----------------------------------------------------------------------------*/
/* attempt connect to given node                                              */
/*----------------------------------------------------------------------------*/
: .attemptConnectNode ( pNode -- )

  params| pNode |

  0 locals| pSocket |

  pNode node.no grid::thisNode@ "Node %v connecting to node %v" .printf

  // get the nodes port and IP address
  pNode node.port ( port )
  pNode node.IP   ( port IP )

  // attempt connect to that node
  pNode socket::open socket.connect to pSocket

  pSocket not if
    pNode node.no grid::thisNode@ "Node %v unable to connect to node %v" .printf
    exit
  then

  // set the send socket in the node
  pSocket pNode node.sendSocket!

  grid::incConnectedNodes

  // print connection message
  //args.verbose if
    pNode node.no grid::thisNode@ "Node %v connected to node %v" .printf
  //then

  // send this node's info to the node we just connected to
  pSocket .sendNodeInfo
;

/*----------------------------------------------------------------------------*/
/* one iteration of connector behavior                                        */
/*----------------------------------------------------------------------------*/
: _connectorTake ( -- )

  0 locals| pNode |

  // "_connectorTake" .

  grid::definedNodes 0
  do

    // get node I
    I grid::node to pNode

    // connect to the node
    pNode node.sendSocket@ not if
      pNode .attemptConnectNode
    then

  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set grid as started
  //true grid::started!
;

/*----------------------------------------------------------------------------*/
/* connector loop: establish a connection to all nodes in the grid            */
/*----------------------------------------------------------------------------*/
: connector_req ( -- )

  std_entryHook

  assertStackDepthZero

  0 locals| pThisTask |
  0 locals| pJob_Connector |

  //"connector_run" .

  grid::thisNode@ job::this "Connector %v on node %v running" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the task
  task::this to pThisTask

  // get the connectpr job from the task
  pThisTask task.job@ to pJob_Connector

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin
    _connectorTake
    assertStackDepthZero

    3 thread::sleepSsec
  again

  // print started message
  //grid::thisNodeName@ "Node %v : SE cluster started" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: connector :: connector ;

jobInfo: connector
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NONE
  <?ddlLock?>  = DL_NONE
  
  //<?preCheck?> = bClusterStarted
  
  <?cmdKind?>  = CK_SERVICE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
