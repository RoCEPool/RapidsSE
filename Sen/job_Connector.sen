/*============================================================================*/
/* job_Connector.sen -- connector job                                         */
/*============================================================================*/

" job_Connector.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the connector job (as a dedicated job)                               */
/*----------------------------------------------------------------------------*/
: spawn_Connector ( -- )

  0 locals| pJobClass_Connector |
  0 locals| pJob_Connector |

  CN_JOB_CONNECTOR jobClass::find to pJobClass_Connector

  nullptr pJobClass_Connector jobClass.new to pJob_Connector

  pJob_Connector SEED_RUN job.spawn_dedicated
;

/*----------------------------------------------------------------------------*/
/* send node info to node we just connected to                                */
/*----------------------------------------------------------------------------*/
: sendNodeInfo ( pSocket -- )

  params| pSocket |

  0 locals| pJobClass_NodeInfo |
  0 locals| pJob_NodeInfo |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the node info job
  CN_JOB_NODEINFO jobClass::find to pJobClass_NodeInfo
  nullptr pJobClass_NodeInfo jobClass.new to pJob_NodeInfo

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // send node info job to the other node
  pSocket socket.grabWrite
  pJob_NodeInfo pSocket socket.sendObject assert
  pSocket socket.dropWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete node info job
  pJob_NodeInfo job.delete
;

/*----------------------------------------------------------------------------*/
/* connector loop: establish a connection to all nodes in the grid            */
/*----------------------------------------------------------------------------*/
: connector_run ( -- )

  >>logEntry <SEED_RUN>

  assertStackDepthZero

  0 locals| pThisTask |
  0 locals| pJob_Connector |

  0 locals| pNode |
  0 locals| pSocket |

  //"connector_run" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the task
  task::this to pThisTask

  // get the connectpr job from the task
  pThisTask task.job@ to pJob_Connector

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  grid::nodes 0
  do

    assertStackDepthZero

    // get the node
    I grid::node to pNode

    // get the nodes port and IP address
    pNode node.port ( port pNode )
    pNode node.IP   ( port IP )

    // connect to that node
    socket::open socket.connect to pSocket

    // set the socket in the node
    pSocket pNode node.sendSocket!

    // print connection message
    args.verbose if
      grid::thisNode@ I "Node%v connected to node%v" fmt.print
    then

    // send this node's info to the node we just connected to
    pSocket sendNodeInfo

  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set grid as started
  true grid::started!

  // print started message
  //grid::thisNodeName@ "Node %v : SE cluster started" fmt.print

  assertStackDepthZero

  // null the job in the task
  nullptr pThisTask task.job!

  // now delete the ended job
  pJob_Connector job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
