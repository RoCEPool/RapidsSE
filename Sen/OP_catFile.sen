/*============================================================================*/
/* OP_catFile.sen -- cat file                                                 */
/*============================================================================*/

" OP_catFile.sen" .verbose

/*----------------------------------------------------------------------------*/
/* catFile csvBuffer                                                          */
/*----------------------------------------------------------------------------*/
: catFile_csvBuffer

  false
;

/*----------------------------------------------------------------------------*/
/* catFile action                                                             */
/*----------------------------------------------------------------------------*/
: catFile_action

  file::new to file0[]

  <fileNm> OPEN_READ file0[].get file.open if
    <fileNm> "File %v opened" .printf

    begin
      catFile_csvBuffer
    while repeat

    file0[].get file.close
    <fileNm> "File %v closed" .printf
  then

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: catFile :: catFile <FileNm> ;

: catFile _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
  }
;

// catFile "/Users/Shared/tpch/SF1/nation.csv" ;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
