/*============================================================================*/
/* job_StartCluster.sen -- Job Start Cluster                                  */
/*============================================================================*/

" job_StartCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: node.isConnected ( pNode -- t|f )

  params| pNode |

  pNode node.sendSocket@ if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::connected ( -- t|f )

  grid::definedNodes 0
  do
    I grid::node node.isConnected not if
      args.verbose if
        I "Node no %v not connected" fmt.print
      then
      unloop
      false
      exit
    then
  loop

  "All nodes connected" .verbose

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::pause ( -- )

  begin
    grid::connected not
  while
    100 thread::sleepMsec
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridTest

  grid::definedNodes 0
  do
    I grid::node node.isConnected
    I "gridTest: node no %v connected %v " fmt.print
  loop
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridWait

  grid::pause
;

/*----------------------------------------------------------------------------*/
/* request to wait for cluster to start (on originating node)                 */
/*----------------------------------------------------------------------------*/
: startCluster_req ( -- <R> )

  >>logEntry <SEED_REQ2>

  0 0 locals| pJob pTask |

  tp: startCluster_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get task and job

  task::this to pTask
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // has cluster already been started?

  grid::started@ if
                                             //! how do we set an error message?
    <DONE_REQ>
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn all other nodes

  grid::setStartNode

  grid::spawnOtherNodes

  //connector::spawn

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pause till all nodes connected

  grid::pause

   // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the start cluster job

  pJob job.distribute

  // set grid as started
  true grid::started!
  "Cluster started" .

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute job_StartCluster (on participating node)                           */
/*----------------------------------------------------------------------------*/
: startCluster_exe ( pJob_StartCluster -- )

  >>logEntry <SEED_EXE2>

  //params| pJob_StartCluster |
  job::this locals| pJob_StartCluster |

  pJob_StartCluster job.notice

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::pause

  pJob_StartCluster job::participantExecuted

  <<logExit <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: startCluster_beg ( -- )

"startCluster_beg 0" .
  >>logEntry <SEED_BEG>

"startCluster_beg 1" .
  job::this locals| pJob_status |

"startCluster_beg 2" .
  pJob_status job.becomeParticipant

"startCluster_beg 3" .
  job::participantBegun

"startCluster_beg calling <DONE_BEG>" .

  <<logExit <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: startCluster_end ( -- )

  >>logEntry <SEED_END>

  job::this locals| pJob_status |

  job::participantEnded

  <<logExit <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: startCluster_can ( -- )

  >>logEntry <SEED_CAN>

  job::this locals| pJob_status |

  <<logExit <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

