/*============================================================================*/
/* job_StartCluster.sen -- Job Start Cluster                                  */
/*============================================================================*/

" job_StartCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: node.isConnected ( pNode -- t|f )

  params| pNode |

  pNode node.socket@ if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::connected ( -- t|f )

  grid::nodes 0
  do
    I grid::node node.isConnected not if
      I "Node %v not connected" fmt.print
      unloop
      false
      exit
    then
  loop

  "All nodes connected" .

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::wait ( -- )

  begin
    grid::connected not
  while
    100 thread.sleep_ms
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridTest

  grid::nodes 0
  do
    I grid::node node.isConnected
    I "gridTest: node %v connected %v " fmt.print
  loop
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridWait

  grid::wait
;

/*----------------------------------------------------------------------------*/
/* request to wait for cluster to start (on originating node)                 */
/*----------------------------------------------------------------------------*/
: startCluster_req ( -- <R> )

  0 0 locals| pJob pTask |

  tp: space_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  "spawnNodes..." .
  spawnNodes

  "setStartNode..." .
  setStartNode

  "spawn_Connector..." .
  spawn_Connector

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pTask pJob "job::distribute" find execute

  pJob <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute job_StartCluster (on participating node)                           */
/*----------------------------------------------------------------------------*/
: startCluster_exe ( pJob_StartCluster -- )

  //params| pJob_StartCluster |
  job::this locals| pJob_StartCluster |

  pJob_StartCluster job.notice

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::wait

  pJob_StartCluster send_job__executed

  nullptr task::this task.job!

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: startCluster_beg ( -- )

job::this locals| pJob_status |

pJob_status job.beginParticipant

job::participantBegun
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: startCluster_end ( -- )

job::this locals| pJob_status |

job::participantEnded
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: startCluster_can ( -- )

job::this locals| pJob_status |
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

