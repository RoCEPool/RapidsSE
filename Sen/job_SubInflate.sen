/*============================================================================*/
/* job_SubInflate.sen -- Job SubInflate                                       */
/*============================================================================*/

" job_SubFetch.sen" .verbose

/*----------------------------------------------------------------------------*/
/* SubInflate (on originating node)                                           */
/*----------------------------------------------------------------------------*/
: SubInflate_run ( -- <R> )

  >>am <SEED_RUN>

  0 0 0 locals| pTask pJob_SubInflate pJob_FetchRows |

  tp: SubFetch
  //"SubFetch_run" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_SubInflate

  // get fetch job
  pJob_SubInflate job_SubInflate.jobFetchRows@ to pJob_FetchRows
"t2" .
  pJob_FetchRows job.executingTask@ locals| pTask_FetchRows |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for acks to be set in the fetch task
  begin
    pTask_FetchRows task.IsAckSet
  not while
    1 thread.sleep_ms
  repeat
"t3" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  //ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop fetch buffers from queue and inflate them
  pJob_SubInflate job_subInflate.inflateRows

  //ddlLock::testDrop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // notify the fetch job
  pTask_FetchRows task.grabLock
  pTask_FetchRows task.dropLock
  pTask_FetchRows task.ack

  // null the job in the task
  nullptr pTask task.job!

  // now delete the ended job
  pJob_SubInflate job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
