/*============================================================================*/
/* OP_bufferGen.sen -- Operator bufferGen                                     */
/*============================================================================*/

" OP_bufferGen.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: BufferGen_DataMarker \handler

  "Operand:- ZK_DATAPULSE" .verbose
  PipeIn[].pipeOut

  <nBuffers> 0 do
    I "buffer# %v" .printf

    csvBuffer::new to Operand[]
    Operand[].pipeOut
  loop

  Operand[].newEosMarker
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* BufferGen request                                  (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BufferGen_req \operator

  LogReqEntry SEED_REQ

  <nBuffers> "Number of buffers: %v" .printf

  op__topology

  find: BufferGen_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  "*** BufferGen EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: bufferGen :: bufferGen <nBuffers> ;

: bufferGen _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
