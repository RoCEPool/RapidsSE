/*============================================================================*/
/* OP_bufferGen.sen -- Operator bufferGen                                     */
/*============================================================================*/

" OP_bufferGen.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: BufferGenOp_PulseMarker \handler

  "Operand:- ZK_PULSEMARKER" .verbose
  Operand[].pipeOut

  <nBuffers> 0 do
    I "buffer# %v" .printf

    csvBuffer::new to Operand[]
    Operand[].pipeOut
  loop

  Operand[].newEosMarker
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: BufferGenOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* BufferGen request                                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BufferGenOp_req \operator

  LogReqEntry SEED_REQ

  <nBuffers> "Number of buffers: %v" .printf

  op__topology

  find: BufferGenOp_PulseMarker ZK_PULSEMARKER op[].handler!
  find: BufferGenOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  "*** BufferGen EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: bufferGenOp :: bufferGenOp <nBuffers> ;

: bufferGenOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
