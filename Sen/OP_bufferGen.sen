/*============================================================================*/
/* OP_bufferGen.sen -- Operator bufferGen                                     */
/*============================================================================*/

" OP_bufferGen.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: BufferGen_PulseMarker \handler

  "Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  <nBuffers> 0 do
    I "buffer# %v" .printf

    csvBuffer::new to Operand[]
    Operand[].pipeOut
  loop

  Operand[].newEosMarker
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* BufferGen request                                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BufferGen_req \operator

  LogReqEntry SEED_REQ

  <nBuffers> "Number of buffers: %v" .printf

  op__topology

  find: BufferGen_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  "*** BufferGen EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: bufferGen :: bufferGen <nBuffers> ;

: bufferGen _opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
