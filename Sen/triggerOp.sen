/*============================================================================*/
/* triggerOp.sen -- flow trigger operator                                     */
/*============================================================================*/

"triggerOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* trigger                                                                    */
/*----------------------------------------------------------------------------*/
: triggerPlan ( profile plan -- )

  // record the plan and profile
  locals| thePlan profile |
  0 locals| partitionId |

  thePlan "Triggering plan: %v" str.format .

  // trigger scanOp by piping the plan to it
  grid.slots 0 do

    I grid::toPartition to partitionid

    // << profile plan >> -->> nextOp
    << partitionid "scanOp#%v" str.format thePlan "scanOp.task" >>jobQueue
  loop
;

/*----------------------------------------------------------------------------*/
/* flow trigger operator loop                                                 */
/*----------------------------------------------------------------------------*/
: triggerOp operator ( -- NEVER )

  begin

    // wait for next job
    jobQueue> ( valset )

    // unpack it
    valset> ( profile thePlan nValues )
    drop ( profile thePlan )

    triggerPlan ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
