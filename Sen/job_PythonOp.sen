/*============================================================================*/
/* job_PythonOp.sen -- Job PythonOp                                           */
/*============================================================================*/

" job_PythonOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for pythonOp request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pythonOp_req ( -- )

  >>logEntry <SEED_REQ>

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER of
        //"Operand:- ZK_CSVBUFFER" .verbose
        Operand[].csvData
        <pythonFunction> <pythonFile> Operand[].invokePython
        true
      endof

      ZK_ERRORMARKER of
        //"jobOperand::generic:- ZK_ERRORMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        Operand[].pipeOut
        Op.ackPipelineJob
        false
      endof

      Operand[].delete
      true
      swap

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: pythonOp :: pythonOp <pythonFile> <pythonFunction> <topology> <nextStage> <nextOp> ;

jobInfo: pythonOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_PYTHONOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
