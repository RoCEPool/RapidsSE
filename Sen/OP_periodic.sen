/*============================================================================*/
/* OP_periodic.sen -- Operator periodic                                       */
/*============================================================================*/

" OP_periodic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
/*
: periodicOp_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  Pipein[].delete
  Operand[].newExitMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;
*/
/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: periodicOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

   Counter1[] if
    begin
      begin
         Counter1[]  Counter0[] >
      while
        task::yield
        assert::stack_0
        "sleeping for 1 min" .
        60 task::sleepSsec
        Counter0[] 1 + to Counter0[]
      repeat
      0 to  Counter0[]
       Counter1[] "Sending PULSEMARKER after %v mins" str.format .
      Operand[].newPulseMarker
      Operand[].pipeOut
      true
    while assert::stack_0 repeat
  then

  Operand[].newPulsedMarker
  Operand[].pipeOut
  //Op.ackPipelineJob

  true
;

/*----------------------------------------------------------------------------*/
/* execute for periodicOp request                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : periodicOp_req \operator
 
  LogReqEntry SEED_REQ

  0 locals| hours   |
  0 locals| minutes |

  "<minutes>" job[] job.tagSet@ tagSet.hasName if
    <minutes> >int to minutes
  then

  "<hours>" job[] job.tagSet@ tagSet.hasName if
    <hours> >int to hours
  then

  hours if
    hours 60 * to minutes
  then

  // elapsed
  0 to Counter0[]

  // minutes
  minutes to Counter1[]

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  op__topology

  //find: periodicOp_ErrorMarker ZK_ERRORMARKER op[].handler!
  find: periodicOp_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: periodicOp :: periodicOp once ;
cmdSyntax: periodicOp :: periodicOp min <minutes> ;
cmdSyntax: periodicOp :: periodicOp hour <hours> ;

: periodicOp _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--cmd desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
