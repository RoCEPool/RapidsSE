/*============================================================================*/
/* OP_periodic.sen -- Operator periodic                                       */
/*============================================================================*/

" OP_periodic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: periodicOp_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  Operand[].delete
  Operand[].newStopMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: periodicOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Operand[].pipeOut

   Counter1[] if
    begin
      begin
         Counter1[]  Counter0[] >
      while
        task::yield
        assert::stack_0
        "sleeping for 1 min" .
        60 task::sleepSsec
        Counter0[] 1 + to Counter0[]
      repeat
      0 to  Counter0[]
       Counter1[] "Sending PULSEMARKER after %v mins" str.format .
      Operand[].newPulseMarker
      Operand[].pipeOut
      true
    while assert::stack_0 repeat
  then

  Operand[].newStopMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* execute for periodicOp request                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : periodicOp_req ( -- )
 
  LogReqEntry SEED_REQ

  0 locals| hours   |
  0 locals| minutes |


  "<minutes>" job[] job.enameset@ enameset.hasName if
    <minutes> >int to minutes
  then

  "<hours>" job[] job.enameset@ enameset.hasName if
    <hours> >int to hours
  then

  hours if
    hours 60 * to minutes
  then

  // elapsed
  0 to Counter0[]

  // minutes
  minutes to Counter1[]

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!



  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_ERRORMARKER of periodicOp_ErrorMarker endof

      ZK_PULSEMARKER of periodicOp_PulseMarker endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogReqExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: periodicOp :: periodicOp once ;
opSyntax: periodicOp :: periodicOp min <minutes> ;
opSyntax: periodicOp :: periodicOp hour <hours> ;

jobInfo: periodicOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
