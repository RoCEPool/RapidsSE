/*============================================================================*/
/* OP_toFile.sen -- Operator toFile                                           */
/*============================================================================*/

" OP_toFile.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: toFileOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Pipein[]
  Operand[].writetoFile0
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: toFileOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for writing
  <fileNm> OPEN_WRITE op__file if
    Pipein[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: toFileOp_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then

  Pipein[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for toFileOp req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : toFileOp_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: toFileOp_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: toFileOp_StartMarker ZK_STARTMARKER op[].handler!
  find: toFileOp_ExitMarker  ZK_EXITMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toFileOp :: toFileOp <fileNm> ;

: toFileOp _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
