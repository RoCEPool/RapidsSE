/*============================================================================*/
/* OP_toFile.sen -- Operator toFile                                           */
/*============================================================================*/

" OP_toFile.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ToFileOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Operand[].writeToFile0

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: ToFileOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for writing
  file::new to File0[]
  <fileNm> OPEN_WRITE File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  then
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: ToFileOp_StopMarker \handler

  //"Operand:- ZK_STOPMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then

  Operand[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for toFileOp req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToFileOp_req ( -- )
 
  LogEntry SEED_REQ

  job[] locals| pJob_ToFileOp |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER   of ToFileOp_CsvBuffer endof

      ZK_STARTMARKER of ToFileOp_StartMarker endof

      ZK_STOPMARKER  of ToFileOp_StopMarker endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: ToFileOp :: ToFileOp <fileNm> ;

jobInfo: ToFileOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
