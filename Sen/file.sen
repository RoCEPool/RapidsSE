/*============================================================================*/
/* file.sen -- file related words                                             */
/*============================================================================*/

"file.sen" .verbose

/*----------------------------------------------------------------------------*/
/* file is use as a kind of word to identify files                            */
/*----------------------------------------------------------------------------*/
: file ;

: isFile word.kind@ tick file eql ;

/*----------------------------------------------------------------------------*/
/* create a file using name from input stream (doesnt leave file on stk)      */
/*----------------------------------------------------------------------------*/
: file:

  create
  WT_OBJECT word.this word.type!
  sizeof_file allot
  word.this >body object.magic!
  CN_FILE word.this >body object.class!
  tick file word.this word.kind!
  word.this >body file.init
  true word.this >body object.wordbody!
  does>
;

/*----------------------------------------------------------------------------*/
/* create a file using name on stack (leaves file on stack)                   */
/*----------------------------------------------------------------------------*/
: :file

  >create
  WT_OBJECT word.this word.type!
  sizeof_file allot
  word.this >body object.magic!
  CN_FILE word.this >body object.class!
  tick file word.this word.kind!
  word.this >body file.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* load contents of named file onto stack                                     */
/*----------------------------------------------------------------------------*/
: fileLoad ( "<fileNm>" -- s true | false )

  file::new locals| loadFile |

  loadFile file.path!

  OPEN_READ loadFile file.open
  not if
    loadFile file.path@ "No such file %v" str.format .
    loadFile file.delete
    false
    exit
  then

  ""
  begin loadFile file.read while
    str.cat " " str.cat
  repeat

  loadFile file.delete
  true
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
