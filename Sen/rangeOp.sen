/*============================================================================*/
/* rangeOp.sen -- table range select operator                                 */
/*============================================================================*/

"rangeOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* frame-level variables for range                                            */
/*----------------------------------------------------------------------------*/
common/ range rbCrs /

/*----------------------------------------------------------------------------*/
/* send rows from buffers from teh buffer queue of the seitf                  */
/*----------------------------------------------------------------------------*/
: sendQueueBuffers ( pBufferQueue nLastBuffers pSeitf sProfile planId sNextOp )

  0 0 locals| nRowCount pIndexBuffer sNextOp planId sProfile pSeitf nLastBuffers pBufferQueue |

"sendingBuffers" .

  // loop thru buffers
  true
  begin
    while
    // pop a buffer off the buffer queue
    pBufferQueue popBuffer to pIndexBuffer

    // send the index buffer to next printOp
"sending a buffer" .
    <<   pIndexBuffer true pSeitf sNextOp planId sProfile >>jobQueue
"sent a buffer" .
    // check if last buffer
    pIndexBuffer entryBuffer.isLast@ if

      nLastBuffers 1 - to nLastBuffers
        0 nLastBuffers == if
          false
        else
          true
        then
    else
      true  // no more entries, move to next buffer
    then
    //pIndexBuffer entryBuffer.delete
    //"Deleted buffer" .

  repeat

"no more buffers to send" .
  <<  false pSeitf sNextOp planId sProfile >>jobQueue

  // delete the buffer queue
  pBufferQueue queue.delete

;

/*----------------------------------------------------------------------------*/
/* scan partition of a table                                                  */
/*----------------------------------------------------------------------------*/
: rangePartition subDic range ( pSeitf profile plan -- )

  // record the plan and profile
  0 0 0 0 0 locals| nLastBuffers pTable pBufferQueue bSinglePartition pPlanner thePlan profile pSeitf |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set path (hardcoded for the moment)

  //"tables" "tpchSchema" "schemas" "rapidsse" "catalogs" "boray" "tenants" 7 dicPath.set
  "tenants" 1 dicPath.set

  // [0] push thePlan's dictionary onto path stack
  thePlan plan.dic pathPush

  // [1] find and push opFrame (along with its dictionary onto path stack)
  profile thePlan plan.opFrame? opFrame.push // [1]
  //pathDump

  $$tableNm   locals| tableNm   |
  $$schemaNm  locals| schemaNm  |
  $$catalogNm locals| catalogNm |
  $$where     locals| sWhere |

  sWhere .

  // drop the dictionary path
  pathDrop

  // now create the dictionary path again with the catalog and schemaNm
  "catalogs" "boray" "tenants" 3 dicPath.set

  // push tableNm folder on the dictionary path
  catalogNm find execute
  pathPush

  // push tableNm folder on the dictionary path
  "schemas" find execute
  pathPush

  // push tableNm folder on the dictionary path
  schemaNm find execute
  pathPush

  // push tableNm folder on the dictionary path
  "tables" find execute
  pathPush

  // push tableNm on the dictionary path
  tableNm find execute
  pathPush

  //pathDump

  // [0] push thePlan's dictionary onto path stack
  thePlan plan.dic pathPush

  // [1] find and push opFrame (along with its dictionary onto path stack)
  profile thePlan plan.opFrame? opFrame.push // [1]
/*
  // [2] create a new rowCursor and record in opFrame.rbCrs
  rbCursor::new toCommon rbCrs

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set up table in rowCursor
  $$tableNm find execute rbCrs rbCursor.table!

  // begin scan of partition
  $$partition grid::toSlot rbCrs rbCursor.begin

  // get first rowBuffer of partition
  rbCrs rbCursor.first

  // pipe all rb's of partition
  begin while

  // << rb true profile plan profile >> -->> nextOp
  << rbCrs rbCursor.get true $$nextProfile thePlan plan.id@ $$nextOp >>jobQueue

  // next rowBuffer in partition
  rbCrs rbCursor.next

  repeat

  // end cursored iteration
  rbCrs rbCursor.end

  // pipe EOD to writeOp
  // << false plan >> -->> nextOp
  << false $$nextProfile thePlan plan.Id@ $$nextOp >>jobQueue

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // [2] delete cursor
  rbCrs rbCursor.delete
  0 toCommon rbCrs
  */

  ddlLock::grabRead

  tableNm find execute to pTable

  // get and inc table reference and put into task.seitf.currentTable
  //getTableRef not if <NIP+ERROR> exit then
  //task::this task.seitf@ seitf.table@ assert

"generating plan" .
  // generate plan for the fetch
  sWhere pTable "generatePlan" find execute to pPlanner

  pPlanner planner.phrases@ to nLastBuffers

  // assert we have a plan
  pPlanner assert
  true to bSinglePartition

  // set the no of last buffers to no of phrases in plan
  //pPlanner planner.phrases@ pSeitf seitf.lastBuffers!

"creating bufferQ" .

  // create the buffer queue in the seitf
  "rangeTask.queue" queue::new to pBufferQueue

  $$partition grid::toSlot 0 locals| iSlot bGroupBy |

  pPlanner planner.phrases@ 0
  do
"spawning fetch task" .
    pBufferQueue iSlot bGroupBy I pPlanner "spawnFetch" find execute
  loop

  ddlLock::dropRead

  // wait for all fetch tasks to end
  5 thread.sleep_s

  pBufferQueue nLastBuffers pSeitf $$nextOp thePlan plan.Id@ $$nextProfile
  sendQueueBuffers

  // << false plan >> -->> nextOp
  //<< false pSeitf $$nextProfile thePlan plan.Id@ $$nextOp >>jobQueue

  // [1] discard opFrame (and dictionary)
  opFrame.drop

  // [0] discard thePlan's dictionary from path stack
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* table range select                                                         */
/*----------------------------------------------------------------------------*/
: rangeOp operator

  begin

  depth 0 != if "stack of task has grown" . debug::trap then

  grid.thisNode@ "RANGEOP: NODE %V" str.format .

  // wait for next job
  jobQueue> ( valset )

  grid.thisNode@ "RANGEOP: NODE %V" str.format .

  // unpack it
  valset> ( profile planId nValues )
  drop ( profile planId )

  // find plan using planId
  planList::findPlan ( pSeitf profile plan true )
  assert ( pSeitf profile plan )

  // scan the table partition and pipe to write
  rangePartition ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
