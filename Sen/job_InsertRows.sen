/*============================================================================*/
/* job_InsertRows.sen -- Job Insert Rows                                      */
/*============================================================================*/

" job_InsertRows.sen" .verbose

/*----------------------------------------------------------------------------*/
/* job_InsertRow request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: InsertRows_req (  -- <R> )

  >>am <SEED_REQ>

  0 locals| pThisTask |
  0 0 0 locals| pJob_InsertRows sTableNm pTable |

  tp: InsertRow_req

  // get the task
  task::this to pThisTask

  // get the job from the task
  pThisTask task.job@ to pJob_InsertRows
  //pJob_InsertRows pThisTask "InsertRow_req task: %v job_InsertRow %v" fmt.print

  // distribute the job
  //Job_InsertRow job.distribute

  pJob_InsertRows job.objectName@ to sTableNm

  // push table dictionary
  pJob_InsertRows getPath dicStack.set
  sTableNm pushTable assert
  //pathDump

  sTableNm find execute locals| pTable |
  pTable pJob_InsertRows job_insertRows.table!

  // add job to originator jobs
  //pJob_InsertRows job.addOriginator

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_LoadTable job check resources                                  */
/*----------------------------------------------------------------------------*/
: insertRows.checkResources ( pJob_InsertRows -- )

  >>am <Check_Resources>

  params| pJob_InsertRows  |

  pJob_InsertRows job.objectName@ locals| sTableNm |

  tp: insertRow.checkResources
  //checkResources received" .

  //----------------------------------------------------------------------------
  // grab a ddl lock
  ddlLock::grabRead

  //----------------------------------------------------------------------------
  // path checks

  // set dictionary stack
  pJob_InsertRows getPath dicStack.set
  //pathDump

  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_InsertRows <ERROR_JOB> !!am exit then
  //sTableNm "In table folder: %v" fmt.print

  // push table dictionary
  sTableNm pushTable assert
  //pathDump

  // check it is a table
  sTableNm checkIsTable not if popTable pJob_InsertRows <ERROR_JOB> !!am exit then
  drop

  // pop table dictionary
  popTable
  //pathDump

  //----------------------------------------------------------------------------
  // check if we have enough buffers

  node::checkEnoughBuffers not if pJob_InsertRows <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_LoadTable job release resources                                */
/*----------------------------------------------------------------------------*/
: insertRows.releaseResources ( pJob_InsertRows -- )

  >>am <Release_Resources>

  params| pJob_InsertRows  |

  tp: insertRow.releaseResources
  //releaseResources received" .

  <<am <Resources_Released>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
