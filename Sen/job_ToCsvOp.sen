/*============================================================================*/
/* job_ToCsvOpOp.sen -- Job ToCsvOp                                           */
/*============================================================================*/

" job_ToCsvOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for ToCsvOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCsvOp_req ( -- )

  >>logEntry <SEED_REQ>

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> <nextOp> op.nextStage!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        //"Operand:- ZK_CRWBUFFER" .verbose
        Operand[].crwToCsv
        Operand[].get to Subset[]
        begin
          Operand[].isNull
        not while
          assert::stack_0
          Operand[].pipeOut
          Subset[].nextBuffer to Operand[]
          assert::stack_0
        repeat
        true
      endof

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        Operand[].pipeout
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
      Operand[].pipeOut
      Op.ackPipelineJob
      false
      endof

      ZK_STREAMDEF of
        //"Operand:- ZK_STREAMDEF" .verbose
        Operand[].delete
        StreamDef[].newToCsvStream
        StreamDef[].pipeout
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToCsvOp :: ToCsvOp <topology> <nextStage> <nextOp> ;

jobInfo: ToCsvOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_TOCSVOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
