/*============================================================================*/
/* job_ToCsvOpOp.sen -- Job ToCsvOp                                           */
/*============================================================================*/

" job_ToCsvOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for ToCsvOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCsv_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_ToCsvOp |

   tp: ToCsv_req

   pJob_ToCsvOp job.opLoop

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToCsv :: ToCsv ;

jobInfo: ToCsv
{
  <?jobDesc?>  = "--description of job--"
  
  //<?jobType?>  = JT_TOCSVOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
