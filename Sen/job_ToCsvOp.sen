/*============================================================================*/
/* job_ToCsvOpOp.sen -- Job ToCsvOp                                           */
/*============================================================================*/

" job_ToCsvOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for ToCsvOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCsvOp_req ( -- )

  >>logEntry <SEED_REQ>

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        "Operand:- ZK_CRWBUFFER" .
        Operand[].toCsv
        Operand[].get to Subset[]
        begin
          Operand[].isNull
        not while
          assert::stack_0
          Operand[].pipeOut
          Subset[].nextBuffer to Operand[]
          assert::stack_0
        repeat
        true
      endof

      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .
        Operand[].handleEnd
        false
      endof

      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .
        Operand[].delete
        StreamDef[].newToCsvStream
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToCsvOp :: ToCsvOp ;

jobInfo: ToCsvOp
{
  <?jobDesc?>  = "--description of job--"
  
  //<?jobType?>  = JT_TOCSVOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
