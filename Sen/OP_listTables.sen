/*============================================================================*/
/* OP_listTables.sen -- Operator list tables                                  */
/*============================================================================*/

" OP_listTables.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lstbl_action

  0 0 locals| sTableNm pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  check::folderIsTables not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in teh infoSet for each word

  folder[] dic.lastWord dup
  iterate                          // setup iteration of words

    object@ word.name@ to sTableNm
    sTableNm path[].pushNamedTableFolder
    sTableNm find execute to table[]

    // skip definition only tables
    table[].isDefinitionOnly not if

    sTableNm streamSetTable[] StreamSet[].addListContents  not if
      StreamSet[].pipeout
      streamSetTable[] streamSet[].new
      sTableNm streamSetTable[] StreamSet[].addListContents assert
    then


    then

    "path[].popNamedTableFolder" find execute

    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lstbl :: lstbl ;

: lstbl _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <localLiteOp> = true
    <streamDef>   = __listContents
    <params>      = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
