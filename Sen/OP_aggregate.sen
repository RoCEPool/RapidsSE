/*============================================================================*/
/* OP_aggregate.sen -- aggregate                                              */
/*============================================================================*/

" OP_aggregate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: aggregate_StartMarker \handler

  ProjectRsb[].new
  Pot[].new

  Expr[].new
  "@ 0 # 0 + ! 0" Expr[].source!
  Expr[].compile assert

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: aggregate_PulseMarker \handler

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: aggregate_RsbBuffer \handler

  Operand[].pipeIn
  projectRsb[].agg
  Operand[].delete

  Pot[].pipeoutAllCompleted

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: aggregate_StreamDef \handler

  ": aggregate_StreamDef \handler" .

  Pipein[].delete

  StreamDefOut[].new
  CT_INTEGER "sum" StreamDefOut[].addColumn
  StreamDefOut[] to StreamDef[]
  StreamDef[].duplicate to StreamDef[]
  StreamDef[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: aggregate_EosMarker \handler

  Pot[].pipeoutAllDangling

  ProjectRsb[].delete
  Expr[].delete
  Pot[].delete

  StreamDefOut[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* aggregate request                                                    SPAWN */
/*----------------------------------------------------------------------------*/
: aggregate_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: aggregate_EosMarker   ZK_EOSMARKER   op[].handler!
  find: aggregate_PulseMarker ZK_PULSEMARKER op[].handler!
  find: aggregate_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: aggregate_StartMarker ZK_STARTMARKER op[].handler!
  find: aggregate_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: aggregate :: aggregate <tableNm> <columnNm> ;

: aggregate _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
