/*============================================================================*/
/* se_object.sen -- object words                                              */
/*============================================================================*/

" se_object.sen" .verbose

/*----------------------------------------------------------------------------*/
/* assert that the object is of a particular class                            */
/*----------------------------------------------------------------------------*/
: object.assertClass ( eClassNo pObject -- )

  params| pObject |
  params| eClassNo |

  pObject object.class@ eClassNo !=
  if
      pObject object.class@
      eClassNo
    "Expecting class %v; actual class %v\n" str.format .
    assert
  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
