/*============================================================================*/
/* se_log.sen -- log related words                                            */
/*============================================================================*/

" se_log.sen" .verbose

/*----------------------------------------------------------------------------*/
/* log cancel seed action                                                     */
/*----------------------------------------------------------------------------*/
: actLog::seed_can immediate

  compiler::current@ word.name@ ,

  POSTPONE AN_SEED_CAN

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log end seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::seed_end immediate

  compiler::current@ word.name@ ,

  POSTPONE AN_SEED_END

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log exe seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::seed_exe immediate

  compiler::current@ word.name@ ,

  POSTPONE AN_SEED_EXE

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log receive seed action                                                    */
/*----------------------------------------------------------------------------*/
: actLog::seed_rcv immediate

  compiler::current@ word.name@ ,

  POSTPONE AN_SEED_RCV

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log run seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::seed_req immediate

  compiler::current@ word.name@ ,

  AN_SEED_REQ ,

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log run seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::seed_run immediate

  compiler::current@ word.name@ ,

  AN_SEED_RCV ,

  POSTPONE Log::markSeed
;

/*----------------------------------------------------------------------------*/
/* log run seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::resources_checked immediate

  compiler::current@ word.name@ ,

  AN_RESOURCES_CHECKED ,

  POSTPONE Log::markWord
;

/*----------------------------------------------------------------------------*/
/* log run seed action                                                        */
/*----------------------------------------------------------------------------*/
: actLog::resources_released immediate

  compiler::current@ word.name@ ,

  AN_RESOURCES_RELEASED ,

  POSTPONE Log::markWord
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* log word entry                                                             */
/*----------------------------------------------------------------------------*/
: LogEntry immediate

  // format the string to be printed
  compiler::current@ word.name@ ">>%v" str.format

  // encode push of that string
  ,

  // encode call to markEntry
  POSTPONE Log::markEntry
;
/*----------------------------------------------------------------------------*/
//: LogEntry immediate
//
//  POSTPONE job[]
//  POSTPONE job.class
//  POSTPONE class::name
//  ">>%v %v" ,
//
//  POSTPONE str.format
//
//  // encode call to markEntry
//  POSTPONE Log::markEntry
//;

/*----------------------------------------------------------------------------*/
/* log word exit                                                              */
/*----------------------------------------------------------------------------*/
: LogExit immediate

  // format the string to be printed
  compiler::current@ word.name@ "<<%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE Log::markExit
;

/*----------------------------------------------------------------------------*/
/* log word error                                                             */
/*----------------------------------------------------------------------------*/
: !!logError immediate

  // format the string to be printed
  compiler::current@ word.name@ "!!%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE Log::markExit
;

/*----------------------------------------------------------------------------*/
/* log general note                                                           */
/*----------------------------------------------------------------------------*/
: .logNote immediate

  // encode call to markEntry
  POSTPONE Log::mark
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* unnamed trace point                                                        */
/*----------------------------------------------------------------------------*/
: tp immediate

  "tp"

  ,

  find: tracepoint encode::call
;

/*----------------------------------------------------------------------------*/
/* named trace point                                                          */
/*----------------------------------------------------------------------------*/
: tp: immediate

  next-token

  ,

  find: tracepoint encode::call
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
