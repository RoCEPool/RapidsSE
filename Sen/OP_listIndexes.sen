/*============================================================================*/
/* OP_listIndexes.sen -- Operator list indexes                                */
/*============================================================================*/

" OP_listIndexes.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsidx_action

  0 0 locals| sTableNm pIndex |

  <tableNm> to sTableNm

  sTableNm op__table not if
    false
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushNamedTableFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm check::nameIsaTable not if
    path[].popNamedTableFolder
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
    exit
  then

  // push indexes folder
  path[].pushIndexesFolder

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the infoSet for each word

  folder[] dic.lastWord dup
  iterate                          // setup iteration of words

    object@ word.name@ folder[].findSymbol execute to pIndex

    pIndex streamSetTable[] StreamSet[].addListIndex  not if
      StreamSet[].pipeout
      streamSetTable[] streamSet[].new
      pIndex streamSetTable[] StreamSet[].addListIndex assert
    then

    object@ word.prev object!      // step backwards thru words
  next

  // pop indexes folder
  path[].popIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  path[].popNamedTableFolder
  folder[].isTables assert

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsidx :: lsidx <tableNm> ;

: lsidx _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--cmd desc for op--"
    <localLiteOp> = true
    <streamDef>   = __listIndex
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
