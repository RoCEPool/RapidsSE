/*============================================================================*/
/* OP_rdCsvChunk.sen -- Op Read Csv Chunk                                     */
/*============================================================================*/

" OP_rdCsvChunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_SEEKOFFSETS ...                                                      */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_SeekOffsets \handler

  // 0 ZK_SEEKOFFSETS EG_ZK LogicUnit[].diaryNote

  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  InfoSet[].firstRow to row[]
  begin
    row[].isNull
  not while

   args.operands attachmap::operands@ args.operands > and if
    
      attachmap::operands@ "Queued Operands : %v" .printf
      25 task::sleepMsec
 
   else

      row[].get InfoSet[].rdCsvChunk to Operand[]

      // check for LOW MEMORY
      Operand[].isNull if
        EC_LOW_MEMORY
        op.pipelineJob@ ERROR_JOB
        InfoSet[].delete
        Operand[].newErrorMarker
        Operand[].pipeout
        true
        exit
      else
        Operand[].pipeOut
        InfoSet[].nextRow to row[]
      then

    then

  repeat

  InfoSet[].delete

  // 1 ZK_SEEKOFFSETS EG_ZK LogicUnit[].diaryNote

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // 0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  // open the file for reading
  <fileNm> OPEN_READ op__file if
    PipeIn[].pipeOut
  then

  // 1 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EXITMARKER ...                                                       */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose

  // 0 ZK_EXITMARKER EG_ZK LogicUnit[].diaryNote

  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then
  PipeIn[].pipeOut
  Op.ackPipelineJob

  // 1 ZK_EXITMARKER EG_ZK LogicUnit[].diaryNote

  false
;

/*----------------------------------------------------------------------------*/
/* execute for reachChunk req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : rdCsvChunk_req \operator

  LogReqEntry SEED_REQ

//  "<note>"  job[] job.tagSet@ tagSet.hasName if
//    <note> LogicUnit[].diaryJobNote
//  then
//
//  op.opName@ LogicUnit[].diaryTitle
//  op.opName@ LogicUnit[].diaryName

  op__topology

  find: rdCsvChunk_ExitMarker    ZK_EXITMARKER    op[].handler!
  find: rdCsvChunk_SeekOffsets   ZK_SEEKOFFSETS   op[].handler!
  find: rdCsvChunk_StartMarker   ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rdCsvChunk :: rdCsvChunk <fileNm> ;

: rdCsvChunk _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
