/*============================================================================*/
/* OP_rdCsvChunk.sen -- Op Read Csv Chunk                                     */
/*============================================================================*/

" OP_rdCsvChunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_SEEKOFFSETS ...                                                      */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_SeekOffsets \handler

  Pipein[] to InfoSet[]
  nullptr to Pipein[]

  InfoSet[].firstRow to row[]
  begin
    row[].isNull
  not while
    row[].get InfoSet[].rdCsvChunk to Operand[]
    Operand[].pipeout
    InfoSet[].nextRow to row[]
  repeat

  InfoSet[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for reading
  <fileNm> OPEN_READ op__file if
    Pipein[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EXITMARKER ...                                                       */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then
  Pipein[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* execute for reachChunk req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : rdCsvChunk_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: rdCsvChunk_ExitMarker    ZK_EXITMARKER    op[].handler!
  find: rdCsvChunk_SeekOffsets   ZK_SEEKOFFSETS   op[].handler!
  find: rdCsvChunk_StartMarker   ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rdCsvChunk :: rdCsvChunk <fileNm> ;

: rdCsvChunk _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
