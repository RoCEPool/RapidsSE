/*============================================================================*/
/* OP_toCrwH.sen -- Operator toCrwH                                           */
/*============================================================================*/

" OP_toCrwH.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: toCrwH_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose

  // create a loader
  Loader[].create

  // pipe out the pulsemarker
  Operand[].pipeOut

  // pipe out the stream def
  Operand[].newStreamDef
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: toCrwH_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose

  // use extractRow from register0 and convert csvtoCrw
  Operand[].csvToCrwH

  // pipe out any full buffers
  grid::partitions 0
  do
    I loader[].fullCrwBuffer@ to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].appendClose
      OperandB[].pipeOut
      I loader[].fullCrwBuffer@ to OperandB[]
    repeat
  loop

  Operand[].delete
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: toCrwH_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipe out any dangling buffers

  grid::partitions 0
  do
    I loader[].crwBuffer@ to OperandB[]
    OperandB[].isNull not if
      OperandB[].appendClose
      OperandB[].pipeOut
      nullptr I loader[].crwBuffer!
    then
  loop

  // delete loader
  loader[].delete

  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: toCrwH_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  <tableNm> locals| sTableNm |

  // check if we can scan the table
  sTableNm checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  else
    // move to table folder and find the table and tablePtn
    sTableNm pushTable assert
    sTableNm find execute to table[]
  then

  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* execute for toCrwOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : toCrwH_req ( -- )

  LogReqEntry SEED_REQ

  job[] locals| pJob_ToCrwOp |

  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER of toCrwH_CsvBuffer true endof

      ZK_EOSMARKER of toCrwH_EosMarker true endof

      ZK_PULSEMARKER of toCrwH_PulseMarker true endof

      ZK_STARTMARKER of toCrwH_StartMarker true endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogReqExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: toCrwH :: toCrwH <tableNm> ;

jobInfo: toCrwH
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
