/*============================================================================*/
/* OP_toCrwH.sen -- Operator toCrwH                                           */
/*============================================================================*/

" OP_toCrwH.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: toCrwH_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose

  // pipe out the pulsemarker
  Pipein[].pipeOut

  // pipe out the stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: toCrwH_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose

  Pipein[] to Operand[]
  nullptr to Pipein[]

  // use extractRow from register0 and convert csvtoCrw
  Operand[].csvToCrwH

  // pipe out any full buffers
  grid::partitions 0
  do
    I writeHash[].fullCrwBuffer@ to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].appendClose
      OperandB[].pipeOut
      I writeHash[].fullCrwBuffer@ to OperandB[]
    repeat
  loop

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: toCrwH_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipe out any dangling buffers

  grid::partitions 0
  do
    I writeHash[].crwBuffer@ to OperandB[]
    OperandB[].isNull not if
      OperandB[].appendClose
      OperandB[].pipeOut
      nullptr I writeHash[].crwBuffer!
    then
  loop

  // delete loader
  loader[].delete
  writeHash[].delete

  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: toCrwH_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  <tableNm> locals| sTableNm |

  // check if we can scan the table
  <tableNm> op__table if

    WriteHash[].create

    // create a loader
    Loader[].create not if
      EC_INVALID_COMMAND op.pipelineJob@ ERROR_JOB
      Pipein[].delete
      Operand[].newErrorMarker
      Operand[].pipeout
      writeHash[].delete
    else
      Pipein[].pipeout

    then
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for toCrw req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : toCrwH_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toCrwH_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: toCrwH_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toCrwH_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toCrwH_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toCrwH :: toCrwH <tableNm> ;

: toCrwH _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
