/*============================================================================*/
/* OP_toCrwH.sen -- Operator toCrwH                                           */
/*============================================================================*/

" OP_toCrwH.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: toCrwH_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose

  // create a loader
  Loader[].create

  // pipe out the pulsemarker
  Operand[].pipeOut

  // pipe out the stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: toCrwH_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose

  // use extractRow from register0 and convert csvtoCrw
  Operand[].csvToCrwH

  // pipe out any full buffers
  grid::partitions 0
  do
    I loader[].fullCrwBuffer@ to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].appendClose
      OperandB[].pipeOut
      I loader[].fullCrwBuffer@ to OperandB[]
    repeat
  loop

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: toCrwH_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipe out any dangling buffers

  grid::partitions 0
  do
    I loader[].crwBuffer@ to OperandB[]
    OperandB[].isNull not if
      OperandB[].appendClose
      OperandB[].pipeOut
      nullptr I loader[].crwBuffer!
    then
  loop

  // delete loader
  loader[].delete

  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: toCrwH_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  <tableNm> locals| sTableNm |

  // check if we can scan the table
  sTableNm checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  else
    // move to table folder and find the table and tablePtn
    sTableNm pushTable assert
    sTableNm find execute to table[]
  then

  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for toCrwOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : toCrwH_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toCrwH_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: toCrwH_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toCrwH_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toCrwH_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: toCrwH :: toCrwH <tableNm> ;

jobInfo: toCrwH
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
