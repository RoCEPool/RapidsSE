/*============================================================================*/
/* OP_xmit.sen -- Operator xmit                                               */
/*============================================================================*/

" OP_xmit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for xmit request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Xmit_req \operator

  LogReqEntry SEED_REQ

  // set the xmit kind
  <xmitKind> >int op.xmitKind!

  op__topology

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: Xmit :: Xmit <xmitKind> ;

: Xmit _cmdTags tagCopy: stageOp_tags
  tags{ <jobDesc> = "--op desc--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
