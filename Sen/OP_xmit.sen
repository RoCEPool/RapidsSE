/*============================================================================*/
/* OP_xmit.sen -- Operator xmit                                               */
/*============================================================================*/

" OP_xmit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: xmit_EosMarker \handler

  ZK_EOSMARKER_handler

  // get the profile from the task
  //task[] task.profile@ to Operand[]
  //nullptr task[] task.profile!
  //Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: xmit_StartMarker \handler

  ZK_STARTMARKER_handler
  op.stageName@ "xmit %v" str.format profile.name!
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_RSBBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: xmit_RsbBuffer \handler

  //"ZK_RSBBUFFER_handler" .verbose
  //Pipein[] profile.start
  PipeIn[].pipeOut
  //profile.end

  true
;

/*----------------------------------------------------------------------------*/
/* execute for xmit request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : xmit_req \operator

  LogReqEntry SEED_REQ

  // set the xmit kind
  <xmitKind> >int op.xmitKind!

  op__topology

  find: xmit_EosMarker   ZK_EOSMARKER   op[].handler!
  find: xmit_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: xmit_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: xmit :: xmit <xmitKind> ;

: xmit _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
