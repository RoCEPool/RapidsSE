/*============================================================================*/
/* OP_xmit.sen -- Operator xmit                                               */
/*============================================================================*/

" OP_xmit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for xmit request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : XmitOp_req ( -- )

  LogEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  // set the xmit kind
  <xmitKind> >int op.xmitKind!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: XmitOp :: XmitOp <xmitKind> ;

jobInfo: XmitOp
{
  ?<jobDesc>?  = "--description of job--"
  
  ?<jobKind>?  = JK_LOCAL
  ?<rspKind>?  = RS_PARTICIPANT_RESPONSE
  ?<ddlLock>?  = DL_GRAB_READ
  
  ?<preCheck>? = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
