/*============================================================================*/
/* OP_xmit.sen -- Operator xmit                                               */
/*============================================================================*/

" OP_xmit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for xmit request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : XmitOp_req \operator

  LogReqEntry SEED_REQ

  // set the xmit kind
  <xmitKind> >int op.xmitKind!

  op__topology

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: XmitOp :: XmitOp <xmitKind> ;

opInfo: XmitOp {
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
