/*============================================================================*/
/* test_iData.sen -- generate iTest data                                      */
/*============================================================================*/

" test_iData.sen" .verbose

/*----------------------------------------------------------------------------*/
/* generate a i (integer) data file                                           */
/*----------------------------------------------------------------------------*/
: iDataFile

  params| nRecs |
  params| sFileNm |

  nRecs sFileNm "File: %v nRecs %v" fmt.print

  file::new locals| pFile |

  sFileNm OPEN_WRITE pFile file.open
  not if
    "file not opened" .
    exit
  then

  nRecs 0 > if
    nRecs 0
    do
      //I I "%v,String%v" str.format .
      I I 10 +  I 20 + I 30 + "%v,%v,%v,%v\n" str.format pFile file.write
    loop
  then

  pFile file.close

  pFile file.delete
;

/*----------------------------------------------------------------------------*/
/* generate the i data files                                                  */
/*----------------------------------------------------------------------------*/
: iData

  "/rapids/i/t0.csv"    0      iDataFile
  "/rapids/i/t1.csv"    1      iDataFile
  "/rapids/i/t10.csv"   10     iDataFile
  "/rapids/i/t100.csv"  100    iDataFile
  "/rapids/i/t1K.csv"   C_1K   iDataFile
  "/rapids/i/t10K.csv"  C_10K  iDataFile
  "/rapids/i/t100K.csv" C_100K iDataFile
  "/rapids/i/t1M.csv"   C_1M   iDataFile
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
