/*============================================================================*/
/* job_IndexJoin.sen -- Job Fetch Rows                                        */
/*============================================================================*/

" job_IndexJoin.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn sub join jobs                                                        */
/*----------------------------------------------------------------------------*/
: spawnSubJoin ( Job_IndexJoin -- )

  params| pJob_IndexJoin |

  // spawn a subFetch job for each partition
  grid::slots 0
  do
    //I "Creating Job_SubFJoin %v" fmt.print
    I pJob_IndexJoin job_IndexJoin.spawnSub
  loop

;

/*----------------------------------------------------------------------------*/
/* execute checkIndexJoin                                                     */
/*----------------------------------------------------------------------------*/
: checkIndexJoin ( "<sRightIndexNm" "<sRightTableNm>" "<sLeftIndexNm" "<sLeftTableNm>"  -- true | errorCode false )

  params| sLeftTableNm sLeftIndexNm sRightTableNm sRightIndexNm |
  0 locals| pJob_IndexJoin |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  task::this task.job@ to pJob_IndexJoin

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  checkInTables not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check left table folder exists
  sLeftTableNm checkIsTableFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push left table dictionary
  sLeftTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sLeftTableNm checkIsTable not if popTable false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check left index exists
  sLeftIndexNm checkIsIndex not if
  popIndexes popTable assertInTables false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  popTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check right table folder exists
  sRightTableNm checkIsTableFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push left table dictionary
  sRightTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sRightTableNm checkIsTable not if popTable false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check right index exists
  sRightIndexNm checkIsIndex not if
  popIndexes popTable assertInTables false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* fetch rows table request (on originating node)                             */
/*----------------------------------------------------------------------------*/
: IndexJoin_req ( -- <R> )

  >>am <SEED_REQ>

  100 apiState::senLoc

  0 0 locals| sLeftTableNm sRightTableNm |
  0 0 locals| sLeftIndexNm sRightIndexNm |

  0 0 locals| pLeftTable pRightTable |
  0 0 locals| pLeftIndex pRightIndex |

  0 0 locals| pJob_IndexJoin pTask |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_IndexJoin

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_INDEXJOIN pJob_IndexJoin object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_IndexJoin job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the left table name, left index name
  pJob_IndexJoin job.objectName@ to sLeftTableNm
  pJob_IndexJoin job.indexName@ to sLeftIndexNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the right table name, right index name
  pJob_IndexJoin job_IndexJoin.rightTableName@ to sRightTableNm
  pJob_IndexJoin job_IndexJoin.rightIndexName@ to sRightIndexNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can fetch rows
  sRightTableNm sRightIndexNm sLeftTableNm sLeftIndexNm checkIndexJoin not if pJob_IndexJoin <ERROR_REQUEST> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the left table
  sLeftTableNm pushTable assert
  sLeftTableNm find execute to pLeftTable
  pLeftTable pJob_IndexJoin job_IndexJoin.leftTable!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the left index
  pushIndexes assert
  sLeftIndexNm find execute to pLeftIndex
  pLeftIndex pJob_IndexJoin job_IndexJoin.leftIndex!

  popIndexes
  popTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the right table
  sRightTableNm pushTable assert
  sRightTableNm find execute to pRightTable
  pRightTable pJob_IndexJoin job_IndexJoin.rightTable!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the right index
  pushIndexes assert
  sRightIndexNm find execute to pRightIndex
  pRightIndex pJob_IndexJoin job_IndexJoin.rightIndex!

  popIndexes
  popTable

  // set the no of last buffers to no phrases * slots in the job
  grid::slots * pJob_IndexJoin job_IndexJoin.lastBuffers!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn the sub fetch jobs
  pJob_IndexJoin spawnSub

  pJob_IndexJoin job.notice

  900 apiState::senLoc

  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
