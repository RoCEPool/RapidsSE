/*============================================================================*/
/* wordSet_valset.sen -- valset related words                                 */
/*============================================================================*/

" wordSet_valset.sen" .verbose

/*----------------------------------------------------------------------------*/
/* an end marker                                                              */
/*----------------------------------------------------------------------------*/
: <<
  //1234

  [ word::this encodePushValue ]
;

/*----------------------------------------------------------------------------*/
/* test of end marker                                                         */
/*----------------------------------------------------------------------------*/
: <<test

  << << eql
  if
    "equal" .
  else
    "not equal" .
  then

  "a" << eql
  if
    "equal" .
  else
    "not equal" .
  then

  1 << eql
  if
    "equal" .
  else
    "not equal" .
  then
;

/*----------------------------------------------------------------------------*/
/* get depth of marked stack                                                  */
/*----------------------------------------------------------------------------*/
: $$depth

  // if the stack is empty then there are 0 marked values
  depth 0 == if 0 exit then

  depth 0 do

    // marked values end at a valset
    I stack.class CN_VALSET ==
    if
      I 1+
      unloop
      exit
    then

    // marked values end at <<
    I pick << eql
    if
      I
      unloop
      exit
    then

  loop

  // marked values end at bottom of stack
  depth
;

/*----------------------------------------------------------------------------*/
/* get depth of marked aux stack                                              */
/*----------------------------------------------------------------------------*/
: $$adepth

  // if the stack is empty then there are 0 marked values
  adepth 0 == if 0 exit then

  adepth 0 do

    // marked values end at a valset
    I astack.class CN_VALSET ==
    if
      I 1+
      unloop
      exit
    then

    // marked values end at <<
    I apick << eql
    if
      I
      unloop
      exit
    then

  loop

  // marked values end at bottom of stack
  adepth
;

/*----------------------------------------------------------------------------*/
/* put << at given stack depth                                                */
/*----------------------------------------------------------------------------*/
: put$$ ( atDepth -- )

  << swap roll
;

/*----------------------------------------------------------------------------*/
/* convert contents of marked stack into a valset                             */
/*----------------------------------------------------------------------------*/
: >>

  $$depth
  >valset
  depth 1 > if
    1 pick << eql
    if
      nip
    then
  then
;

/*----------------------------------------------------------------------------*/
/* test marked valset                                                         */
/*----------------------------------------------------------------------------*/
: $$vs

  <<
  1 2 3
tp: a
  >>
tp: b
  "a" "b"
tp: c
  >>
tp: d
  valset>
tp: e
  1 - dropN
  valset>
tp: f
  drop
tp: g
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
