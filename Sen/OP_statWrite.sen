/*============================================================================*/
/* OP_statWrite.sen -- Operator statWrite                                     */
/*============================================================================*/

" OP_statWrite.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: OP_statWrite_InfoSet \handler

  "statWrite_InfoSet --- --- ---" .

  File0[].isNull not if
    "File not null" .
    process::quit
  then

  // open the file for writing
  file::new to File0[]
  "/tmp/SE_Stats.csv" OPEN_APPEND File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  operand[].get to infoset[]
  nullptr to operand[]

  InfoSet[].writeCsv

  infoset[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -


  File0[].get file.close
  File0[].get file.delete

  true

  stk
;

/*----------------------------------------------------------------------------*/
/* execute for statWrite req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : statWrite_req \operator
 
  LogReqEntry SEED_REQ

  C_TDEF_LOCKSTATS op__tableDef assert StreamDef[].new

  op__topology

  find: OP_statWrite_InfoSet ZK_INFOSET op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: statWrite :: statWrite ;

: statWrite opInfo tagCopy: localOp_tags
  tags{ <jobDesc>  = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
