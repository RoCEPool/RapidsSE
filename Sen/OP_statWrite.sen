/*============================================================================*/
/* OP_statWrite.sen -- Operator statWrite                                     */
/*============================================================================*/

" OP_statWrite.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_LOCKSTATS ...                                               */
/*----------------------------------------------------------------------------*/
: OP_statWrite_LockStats \handler

  "statWrite_InfoSet --- --- ---" .

//! ALKA TO CHECK WITH RAY
//  File0[].isNull not if
//    "File not null" .
//    process::quit
//  then
/*
  file::new to File0[]
  "/tmp/SE_Stats.csv" OPEN_APPEND File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  operand[] to infoset[]
  nullptr to operand[]

  InfoSet[].writeCsv

  infoset[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

 File0[].get file.close
 File0[].get file.delete
 */

  // open the file for writing
  "/tmp/SE_Stats.csv" OPEN_APPEND op__file if

    Pipein[] to infoset[]
    nullptr to Pipein[]

    C_TDEF_LOCKSTATS op__tableDef_infoSet assert

    infoSetTable[] InfoSet[].writeCsv

    infoset[].delete

    File0[].get file.close
    File0[].get file.delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for statWrite req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : statWrite_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: OP_statWrite_LockStats ZK_LOCKSTATS op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: statWrite :: statWrite ;

: statWrite _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--cmd desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
