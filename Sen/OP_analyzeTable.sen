/*============================================================================*/
/* OP_analyzeTable.sen -- Operator analyze table                              */
/*============================================================================*/

" OP_analyzeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: antbl_action

  <tableNm> op__table not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // add a row for each slot
  grid::slots 0
  do
    // analyze table
    I table[] streamSetTable[] StreamSet[].addAnalyzeTable  not if
      StreamSet[].pipeout
      streamSetTable[] streamSet[].new
      I table[] streamSetTable[] StreamSet[].addAnalyzeTable assert
    then

  loop

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: antbl :: antbl <tableNm> ;

: antbl _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __analyzeTable
    <params>    = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
