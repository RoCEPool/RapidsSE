/*============================================================================*/
/* OP_defineTable.sen -- Operator define table                                */
/*============================================================================*/

" OP_defineTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a defineTable table                                  */
/*----------------------------------------------------------------------------*/
: defineTable::checkDefine ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then

  // error if given name already exists
  <tableNm> check::nameIsUnknownTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* define table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: defineTable::createDefinedTable

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  streamDef[] <tableNm> table::createTable to table[]
  true table[].isDefinitionOnly!
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: defineTable_StreamDef

  // get the stream def
  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  // grab the ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check ok to create table
  defineTable::checkDefine not if ( errorCode )
    op.pipelineJob@ ERROR_JOB
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table
  defineTable::createDefinedTable

  // should be in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute for defineTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: defineTable_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: defineTable_StreamDef ZK_StreamDef op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: defineTable :: defineTable <tableNm> ;

: defineTable _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--description of operator--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
