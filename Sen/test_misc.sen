/*============================================================================*/
/* test_misc.sen -- miscellaneous testing                                   */
/*============================================================================*/

" test_misc.sen" .verbose

: iftest if "yes" . then ;

: ifelsetest if "yes" . else "no" . then ;

: untiltest 0 begin 1 + dup . dup 10 == until ;

: whiletest 0 begin 1 + dup 10 < while dup . repeat ;

: dotest 10 0 do I . loop ;
: ?dotest 10 0 ?do I . loop 10 10 ?do I . loop ;

: +looptest 10 0 do I . 2 +loop ;

: iterateTest
    word::this word::this iterate // iterate word cursor
      object@ word.name .       // print the name of the word
      object@ word.prev object! // step backwards thru words
    next                        // next iteration
;

: string_blowup

traceon
    "abcdefghijklmnopqrstuvwxyz"
    1000000 0 do
      "abcdefghijklmnopqrstuvwxyz"
      str.cat
    loop
;

: rottest

  2 1 0 rot . . .
;

: invrottest

  2 1 0 -rot . . .
;

/*----------------------------------------------------------------------------*/
/* str.format testing                                                         */
/*----------------------------------------------------------------------------*/
: strFormatTest

  1 "abc%v" str.format .

  "def" "abc%v" str.format .

  "gh" 456 "def" 23 "abc" 1
  "%v %v %v %v %v %v" str.format .
;

/*----------------------------------------------------------------------------*/
/* locals testing                                                             */
/*----------------------------------------------------------------------------*/
: lt

  789 456 123 locals| a b c |

  a . b . c .

  321 to a
  654 to b
  789 to c 

  a . b . c .
;

/*----------------------------------------------------------------------------*/
/* postpone testing                                                           */
/*----------------------------------------------------------------------------*/
: callTest immediate

  test
;

: postponeTest

  postpone callTest
;

/*----------------------------------------------------------------------------*/
/* string replacement                                                         */
/*----------------------------------------------------------------------------*/
: srepl

  "this" "that" "abcthisdef" str.replace .

  "this" "that" "abcthidef" str.replace .

  "this" "that" "abcthisdefthis" str.replace .
  "this" "that" "abcthisthisdefthis" str.replace .
  "this" "that" "thisthiabcthisthisdefthis" str.replace .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: whereAmI

  "whereAmI?" .
;


/*----------------------------------------------------------------------------*/
/* group by testing                                                           */
/*----------------------------------------------------------------------------*/
: gby

  groupBy::new locals| pGroupBy |

  pGroupBy groupby.start
  pGroupBy groupby.applyBuffer
  pGroupBy groupby.end
  pGroupBy groupby.delete
;

/*----------------------------------------------------------------------------*/
/* locks                                                                      */
/*----------------------------------------------------------------------------*/
: locksReset
  lockTracker::reset
;

: locksList
  lockTracker::list
;

/*----------------------------------------------------------------------------*/
/* yield testing                                                              */
/*----------------------------------------------------------------------------*/
: yieldTest

  10 0 do
    I .
    task.yield
  loop
;

/*----------------------------------------------------------------------------*/
/* unknown word during boot                                                   */
/*----------------------------------------------------------------------------*/
: unknownDuringBoot

  // anUnknownWord
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
