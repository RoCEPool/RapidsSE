/*============================================================================*/
/* OP_status.sen -- Operator status                                           */
/*============================================================================*/

" OP_status.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: status_action

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] streamSet[].new

  // add nodeStatus to the infoSet
  streamSetTable[] streamSet[].addNodeStatus assert

  // pipeout the infoset
  streamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: status :: status ;

: status _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __status
    <params>    = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
