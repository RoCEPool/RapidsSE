/*============================================================================*/
/* OP_supervisor.sen -- Operator supervisor                                   */
/*============================================================================*/

" OP_supervisor.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add peridiodic activity here                                               */
/*----------------------------------------------------------------------------*/
: supervisor::activity ( -- )

  "Supervisor Activity" .
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: supervisorOP_StartMarker \handler

    "Supervisor Job Started" .

    begin

        supervisor::activity
        args.supervisorSleep thread::sleepSsec

    again

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    // should never exit
    hazard
;

/*----------------------------------------------------------------------------*/
/* execute for supervisor req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : supervisorOP_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: supervisorOP_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: supervisorOP :: supervisorOP ;

: supervisorOP _cmdTags

  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
