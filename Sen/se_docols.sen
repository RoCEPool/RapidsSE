/*============================================================================*/
/* se_docols.sen -- docol shorthands                                          */
/*============================================================================*/

" se_docols.sen" .verbose

: schemaTest "" utility::schemaTest ;

: schemaTestAll

  "A" utility::schemaTest
  "B" utility::schemaTest
  "C" utility::schemaTest
  "D" utility::schemaTest
  "E" utility::schemaTest
  "F" utility::schemaTest
  "G" utility::schemaTest
  "H" utility::schemaTest
  "I" utility::schemaTest
  "J" utility::schemaTest
;

: test0 test::test0 ;
: test1 test::test1 ;
: test2 test::test2 ;
: test3 test::test3 ;
: test4 test::test4 ;
: test5 test::test5 ;
: test6 test::test6 ;
: test7 test::test7 ;
: test8 test::test8 ;
: test9 test::test9 ;

: llc test::test0 ;

: stepTimingReset stepTracker::reset ;
: stepTimingStart stepTracker::start ;
: stepTimingWrite stepTracker::write ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
