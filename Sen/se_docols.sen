/*============================================================================*/
/* se_docols.sen -- docol shorthands                                          */
/*============================================================================*/

" se_docols.sen" .verbose

: schemaTest "" utility::schemaTest ;

: schemaTestAll

  "A" utility::schemaTest
  "B" utility::schemaTest
  "C" utility::schemaTest
  "D" utility::schemaTest
  "E" utility::schemaTest
  "F" utility::schemaTest
  "G" utility::schemaTest
  "H" utility::schemaTest
  "I" utility::schemaTest
  "J" utility::schemaTest
;

: test0 prompt test::test0 ;
: test1 prompt test::test1 ;
: test2 prompt test::test2 ;
: test3 prompt test::test3 ;
: test4 prompt test::test4 ;
: test5 prompt test::test5 ;
: test6 prompt test::test6 ;
: test7 prompt test::test7 ;
: test8 prompt test::test8 ;
: test9 prompt test::test9 ;
: test10 prompt test::test10 ;
: test11 prompt test::test11 ;
: test12 prompt test::test12 ;

: llc test::test0 ;

: stepTimingReset StepTiming::reset ;
: stepTimingStart StepTiming::start ;
: stepTimingWrite StepTiming::write ;

: memoryReset memory::reset ;
: memoryStats memory::statistics ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
