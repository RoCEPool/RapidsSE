/*============================================================================*/
/* wordSet_log.sen -- log related words                                       */
/*============================================================================*/

" wordSet_log.sen" .verbose

/*----------------------------------------------------------------------------*/
/* mark cancel seed action                                                    */
/*----------------------------------------------------------------------------*/
: actLog::seed_can immediate

  word::this word.name ,

  POSTPONE AN_SEED_CAN

  POSTPONE ActLog::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark end seed action                                                       */
/*----------------------------------------------------------------------------*/
: actLog::seed_end immediate

  word::this word.name ,

  POSTPONE AN_SEED_END

  POSTPONE ActLog::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark exe seed action                                                       */
/*----------------------------------------------------------------------------*/
: actLog::seed_exe immediate

  word::this word.name ,

  POSTPONE AN_SEED_EXE

  POSTPONE ActLog::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark receive seed action                                                   */
/*----------------------------------------------------------------------------*/
: actLog::seed_rcv immediate

  word::this word.name ,

  POSTPONE AN_SEED_RCV

  POSTPONE ActLog::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark run seed action                                                       */
/*----------------------------------------------------------------------------*/
: actLog::seed_req immediate

  word::this word.name ,

  AN_SEED_REQ ,

  POSTPONE ActLog::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark run seed action                                                       */
/*----------------------------------------------------------------------------*/
: actLog::seed_run immediate

  word::this word.name ,

  AN_SEED_RCV ,

  POSTPONE ActLog::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark run seed action                                                       */
/*----------------------------------------------------------------------------*/
: actLog::resources_checked immediate

  word::this word.name ,

  AN_RESOURCES_CHECKED ,

  POSTPONE ActLog::markWord
;

/*----------------------------------------------------------------------------*/
/* mark run seed action                                                       */
/*----------------------------------------------------------------------------*/
: actLog::resources_released immediate

  word::this word.name ,

  AN_RESOURCES_RELEASED ,

  POSTPONE ActLog::markWord
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* word entry mark                                                            */
/*----------------------------------------------------------------------------*/
: >>logEntry immediate

  // format the string to be printed
  word::this word.name ">>%v" str.format

  // encode push of that string
  ,

  // encode call to markEntry
  POSTPONE Log::markEntry
;
/*----------------------------------------------------------------------------*/
//: >>logEntry immediate
//
//  POSTPONE job::this
//  POSTPONE job.class
//  POSTPONE class::name
//  ">>%v %v" ,
//
//  POSTPONE str.format
//
//  // encode call to markEntry
//  POSTPONE Log::markEntry
//;


/*----------------------------------------------------------------------------*/
/* word exit mark                                                             */
/*----------------------------------------------------------------------------*/
: <<logExit immediate

  // format the string to be printed
  word::this word.name "<<%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE Log::markExit
;

/*----------------------------------------------------------------------------*/
/* word error mark                                                            */
/*----------------------------------------------------------------------------*/
: !!logError immediate

  // format the string to be printed
  word::this word.name "!!%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE Log::markExit
;

/*----------------------------------------------------------------------------*/
/* activity mark                                                              */
/*----------------------------------------------------------------------------*/
: .logNote immediate

  // encode call to markEntry
  POSTPONE Log::mark
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
