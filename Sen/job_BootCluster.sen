/*============================================================================*/
/* job_StartCluster.sen -- Job Start Cluster                                  */
/*============================================================================*/

" job_StartCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: node.isConnected ( pNode -- t|f )

  params| pNode |

  pNode node.sendSocket@ if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::connected ( -- t|f )

  grid::definedNodes 0
  do
    I grid::node node.isConnected not if
      args.verbose if
        I "Node no %v not connected" .printf
      then
      unloop
      false
      exit
    then
  loop

  "All nodes connected" .verbose

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::pause ( -- )

  begin
    grid::connected not
  while
    100 thread::sleepMsec
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridTest

  grid::definedNodes 0
  do
    I grid::node node.isConnected
    I "gridTest: node no %v connected %v " .printf
  loop
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridWait

  grid::pause
;

/*----------------------------------------------------------------------------*/
/* request to wait for cluster to boot (on originating node)                  */
/*----------------------------------------------------------------------------*/
: bootCluster_req ( -- <R> )


  task::seedInitially

  // [ compiler::current@ word.name@ encode::push ] .
  // <jobNm> .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // has cluster already been started?

  grid::started@ if
                                             //! how do we set an error message?
    DONE_REQ
    exit
  then

  job::becomeOriginator

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn all other nodes

  grid::setStartNode

  grid::spawnOtherNodes

  //connector::spawn

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pause till all nodes connected

  grid::pause

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the start cluster job

  job::distributeConnected

  // wait for the signal from deciding job__ended/cancelled
  task::wait

  // set grid as started
  true grid::started!
  "Cluster started" .

  task::doneFinally

  //"Signalling waiting thread" .
  job::informInvokerOfCompletion

  // task has no job
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute job_BootCluster (on participating node)                            */
/*----------------------------------------------------------------------------*/
: bootCluster::execute _eeh ( -- )

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::pause

  true grid::started!
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: bootCluster :: bootCluster ;

: bootCluster _cmdTags tagCopy: distJob_tags
  tags{
    <rspKind>  = RS_NONE
    <ddlLock>  = DL_NONE
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

