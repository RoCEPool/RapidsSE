/*============================================================================*/
/* OP_vfyidx.sen -- Operator verify index                                     */
/*============================================================================*/

" OP_vfyidx.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: vfyidx_action

  <tableNm> <indexNm> op__table_index not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  index[].verify

  // insert index verify
  index[].get streamSetTable[] StreamSet[].addVerifyIndex assert

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: vfyidx :: vfyidx <tableNm> <indexNm> ;

: vfyidx opInfo tagCopy: liteOp_tags
  tags{
    <jobDesc>   = "--description of operator--"
    <liteOp>    = true
    <streamDef> = __verifyIndex
    <params>    = 2
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
