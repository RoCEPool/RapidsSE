/*============================================================================*/
/* db_schema.sen -- schema related words                                      */
/*============================================================================*/

" db_schema.sen" .verbose

: schema ;

//: :makeSchemasFolder path[].pushFolder "schemas" :dic find: folder swap execute dic.kind! path[].discardFolder ;


/*----------------------------------------------------------------------------*/
/* create a new schema folder                                                  */
/*----------------------------------------------------------------------------*/
: :createSchema
    :makeFolder
         //dup find: schema swap word.category!
         dup find: schema swap execute dic.kind!
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: folder[].isSchemas
    folder[] dic.name "schemas" str.equal
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: checkInSchemas
    folder[].isSchemas if true exit then
    EC_NOT_IN_SCHEMAS false
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: checkIsSchema ( word )

    dup word.category@ find: \folder eql not if EC_NOT_A_FOLDER false exit then
    dup execute dic.kind@ find: schema eql if true exit then
    EC_NOT_A_SCHEMA false
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make a schema folder                                                       */
/*----------------------------------------------------------------------------*/
: :makeSchemaFolder ( "<schemaNm>" --  )
 

  params| sSchemaNm |

  args.tracepoint if
    sSchemaNm "MAKING SCHEMA " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make the schema
 sSchemaNm :createSchema ( ^schema )
 drop

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make tables folder
 sSchemaNm :makeTablesSubFolder
;

/*----------------------------------------------------------------------------*/
/* make a schemas folder under given named catalog                            */
/*----------------------------------------------------------------------------*/
: :makeSchemasFolder ( "<catalogNm>" -- )

  args.tracepoint if
    dup "MAKING SCHEMAS FOR CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "schemas"    ( dic "schemas" )
  swap         ( "schemas" dic )
  :makeSubFolder   ( )
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
