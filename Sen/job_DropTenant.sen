/*============================================================================*/
/* job_DropTenant.sen -- Job Drop Tenant                                      */
/*============================================================================*/

" job_DropTenant.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable tenant folder                                 */
/*----------------------------------------------------------------------------*/
: checkRemoveTenant ( "<tenantNm>" -- true | errorCode false )

  params| sTenantNm |

  folder[].checkInTenants  not if false exit then ( "<tenantNm>" word )
  sTenantNm word::isKnown  not if EC_NO_SUCH_Tenant false exit then ( "<tenantNm>" word )
  path[].checkIsTenant   not if false exit then ( "<tenantNm>" word )
  folder.isEmpty    not if false exit then ( "<tenantNm>" word )
  folder.notUsed    not if false exit then ( "<tenantNm>" word )

  true
;

/*----------------------------------------------------------------------------*/
/* remove a tenant folder                                                     */
/*----------------------------------------------------------------------------*/
: removeTenant ( "<tenantNm>" --  )


  args.tracepoint if
  dup "REMOVING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  :forget ( )
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTenant job on a node                                       */
/*----------------------------------------------------------------------------*/
: dropTenant::execute _eeh ( -- )

  job[] locals| pJob_DropTenant |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  <tenantNm> removeTenant
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTenant job check resources                                 */
/*----------------------------------------------------------------------------*/
: dropTenant::checkResources _eeh ( -- )

  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - --
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the tenant
  <tenantNm> checkRemoveTenant not if job[] ERROR_JOB !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: dropTenant :: drop tenant <tenantNm> ;

jobInfo: dropTenant
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
