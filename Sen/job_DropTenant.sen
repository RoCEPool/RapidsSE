/*============================================================================*/
/* job_DropTenant.sen -- Job Drop Tenant                                      */
/*============================================================================*/

" job_DropTenant.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable tenant folder                                 */
/*----------------------------------------------------------------------------*/
: checkRemoveTenant ( "<tenantNm>" -- true | errorCode false )

  params| sTenantNm |

  checkInTenants  not if false exit then ( "<tenantNm>" word )
  sTenantNm checkIsWord  not if EC_NO_SUCH_Tenant false exit then ( "<tenantNm>" word )
  checkIsTenant   not if false exit then ( "<tenantNm>" word )
  checkIsEmpty    not if false exit then ( "<tenantNm>" word )
  checkNotUsed    not if false exit then ( "<tenantNm>" word )

  true
;

/*----------------------------------------------------------------------------*/
/* remove a tenant folder                                                     */
/*----------------------------------------------------------------------------*/
: removeTenant ( "<tenantNm>" --  )

  tp: removetenant

  args.tracepoint if
  dup "REMOVING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  :forget ( )
;

/*----------------------------------------------------------------------------*/
/* drop tenant request (on originating node)                                  */
/*----------------------------------------------------------------------------*/
: dropTenant_req ( -- <R> )

  <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: dropTenant_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTenant job on a node                                       */
/*----------------------------------------------------------------------------*/
: dropTenant_exe ( pJob_DropTenant -- )

  <SEED_EXE>

  //params| pJob_DropTenant |
  job::this locals| pJob_DropTenant |

  tp: dropTenant_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_DROPTENANT pJob_DropTenant object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grad a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_DropTenant getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  pJob_DropTenant job.objectName@   ( catalogNm )
  removeTenant

  pJob_DropTenant job.notice

  pJob_DropTenant send_job__executed

  nullptr task::this task.job!

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTenant job check resources                                 */
/*----------------------------------------------------------------------------*/
: dropTenant.checkResources ( Job_DropTenant -- )

  params| pJob_DropTenant  |

  tp: dropTenant.checkResources
  "checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - --
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_DropTenant getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the catalog
  pJob_DropTenant job.objectName@
  checkRemoveTenant not if pJob_DropTenant <ERROR_JOB> exit then

  ddlLock::dropWrite
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropCatalog job release resources                              */
/*----------------------------------------------------------------------------*/
: dropTenant.releaseResources ( Job_DropTenant -- )

  params| pJob_DropTenant  |

  tp: dropTenant.releaseResources
  "releaseResources received" .
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: dropTenant_beg ( -- )

  <SEED_BEG>

  job::this locals| pJob_dropTenant |

  pJob_dropTenant job.beginParticipant

  // check resources
  pJob_dropTenant dropTenant.checkResources

  job::participantBegun

  <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: dropTenant_end ( -- )

  <SEED_END>

  job::this locals| pJob_dropTenant |

  pJob_dropTenant dropTenant.releaseResources

  job::participantEnded

  <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: dropTenant_can ( -- )

  <SEED_CAN>

  job::this locals| pJob_dropTenant |

  // check resources
  pJob_dropTenant dropTable.releaseResources

  job::participantCancelled

  <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
