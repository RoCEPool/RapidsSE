/*============================================================================*/
/* op_tagSets.sen -- tag sets                                                 */
/*============================================================================*/

" op_tagSets.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: opCmd_tags
  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
    <ddlLock>  = DL_GRAB_READ
    
    <op> = true

    <preCheck> = bClusterStarted
  }
;

: liteOp_cmdTags tagCopy: opCmd_tags
  tags{
    <liteOp> = 1
  }
;

: localLiteOp_cmdTags tagCopy: opCmd_tags
  tags{
    <localLiteOp> = 1
  }
;

: generic_tags
  tags{
    <genericJob> = 1
    
    <jobKind>  = JK_GENERIC
  }
;
        
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
