/*============================================================================*/
/* op_tagSets.sen -- tag sets                                                 */
/*============================================================================*/

" op_tagSets.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: stageOp_tags
  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
    <ddlLock>  = DL_GRAB_READ
    
    <preCheck> = bClusterStarted
  }
;

: liteOp_tags tagCopy: stageOp_tags
  tags{
    <liteOp> = 1
  }
;

: localLiteOp_tags tagCopy: stageOp_tags
  tags{
    <localLiteOp> = 1
  }
;
        
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
