/*============================================================================*/
/* requests_misc.sen -- the set of miscellaneous related requests             */
/*============================================================================*/

"requests_misc.sen" .verbose

/*----------------------------------------------------------------------------*/
/* docol command request                                                      */
/*----------------------------------------------------------------------------*/
: docol_req ( "command" -- <R> )

//checkIsWord not if <NIP+ERROR> exit then
  //execute

  >:

  begin
  depth while drop
  repeat

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get monitor string                                                         */
/*----------------------------------------------------------------------------*/
: getMonitor_req ( -- <R> )

  monitorString@

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get version                                                                */
/*----------------------------------------------------------------------------*/
: getVersion_req ( -- <R> )

  args.metadata if
    "(version VARCHAR)" metadata!
    "')" version "row: ('" "%v%v%v\n" str.format
    1 task::this task.seitf@ seitf.rowsProcessed
  else
    version
  then

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping_req ( -- <R> )

  "pong"

  <SUCCESS>
/*
  0 100000 locals| loopCount i |

  begin
    i 1 + to i
    pp: count
    i loopCount < while
  repeat

  performancePrint

  "pong"
  <SUCCESS>
*/
;

