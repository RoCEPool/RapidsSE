/*============================================================================*/
/* requests_misc.sen -- the set of miscellaneous related requests             */
/*============================================================================*/

"requests_misc.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get monitor string                                                         */
/*----------------------------------------------------------------------------*/
: getMonitor_req ( -- <R> )

  monitorString@

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get version                                                                */
/*----------------------------------------------------------------------------*/
: getVersion_req ( -- <R> )

  args.metadata if
    "(version VARCHAR)" metadata!
    "')" version "row: ('" "%v%v%v\n" str.format
    1 task::this task.seitf@ seitf.rowsProcessed
  else
    version
  then

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* ping test                                                                  */
/*----------------------------------------------------------------------------*/
: ping_req ( -- <R> )

  "pong"

  <SUCCESS>
/*
  0 100000 locals| loopCount i |

  begin
    i 1 + to i
    pp: count
    i loopCount < while
  repeat

  performancePrint

  "pong"
  <SUCCESS>
*/
;

/*----------------------------------------------------------------------------*/
/* R3.5 node-level command test                                               */
/*----------------------------------------------------------------------------*/
: n35_req ( -- <R> )

  "- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" .
  "n35_req entry" .
  "" .

  r35_node_e1
  r35_node_e2
  r35_node_e3
  r35_node_e4
  r35_node_e5
  r35_node_e6

  "- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" .
  "n35_req exits" .
  "" .

  "n35"

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* R3.5 grid-level command test                                               */
/*----------------------------------------------------------------------------*/
: g35_req ( -- <R> )

  0 0 locals| pJob pTask |

  "pSEitf: " .put task::this task.seitf@ .put .\n

  "g35"

  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob
  pJob .

  // add job to originator jobs
  pJob job.addOriginator

  // set the no of acks expected in originator job to nodes in the grid
  grid::nodes pJob job.acksRemaining!

  // send the job to each node in the grid
  grid::nodes 0 do

    // set the send node
    I grid::node pTask task.sendNode!
    task.send

    // send job to each node
    pJob 1
    >valset
    >socketR35

  loop

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* R3.5 partition-level command test                                          */
/*----------------------------------------------------------------------------*/
: p35_req ( sTableNm -- <R> )

  locals| sTableNm |
  //1000000 task.sleep

  "- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" .
  "p35_req entry" .
  "" .

  //r35_partition_e1
  sTableNm r35_partition_e2

  "- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" .
  "p35_req exits" .
  "" .

  "p35"

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* displayOff : set display off                                               */
/*----------------------------------------------------------------------------*/
: displayOff_req ( -- )

  0 task::this task.seitf@ seitf.display!

  <OK>
;

/*----------------------------------------------------------------------------*/
/* displayOn : set display on                                                 */
/*----------------------------------------------------------------------------*/
: displayOn_req ( -- )

  1 task::this task.seitf@ seitf.display!

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get : get attach map member value                                          */
/*----------------------------------------------------------------------------*/
: getAttachMap_req ( am_member -- value )

  find
  dup not if EC_INVALID_PARAMETER <NIP+ERROR> exit then
  execute
  attachmap::attachmap@ .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* set : set attach map member value                                          */
/*----------------------------------------------------------------------------*/
: setAttachMap_req ( am_member -- )

  swap
  find
  dup not if EC_INVALID_PARAMETER <NIP+ERROR>  exit then
  execute
  attachmap::attachmap!

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
