  "n35"

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* R3.5 grid-level command test                                               */
/*----------------------------------------------------------------------------*/
: g35_req ( -- <R> )

  "g35"

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* R3.5 partition-level command test                                          */
/*----------------------------------------------------------------------------*/
: p35_req ( -- <R> )

  "parent spawning children" .

  // spawn n35 children
  p35spawnPartitionChildren

  "parent waiting for acks" .

  // wait for child tasks to complete
  ackWait

  "p35"

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* displayOff : set display off                                               */
/*----------------------------------------------------------------------------*/
: displayOff_req ( -- )

  0 task::this task.seitf@ seitf.display!

  <OK>
;

/*----------------------------------------------------------------------------*/
/* displayOn : set display on                                                 */
/*----------------------------------------------------------------------------*/
: displayOn_req ( -- )

  1 task::this task.seitf@ seitf.display!

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get : get attach map member value                                          */
/*----------------------------------------------------------------------------*/
: getAttachMap_req ( am_member -- value )

  find
  dup not if EC_INVALID_PARAMETER <NIP+ERROR> exit then
  execute
  attachmap::attachmap@ .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* set : set attach map member value                                          */
/*----------------------------------------------------------------------------*/
: setAttachMap_req ( am_member -- )

  swap
  find
  dup not if EC_INVALID_PARAMETER <NIP+ERROR>  exit then
  execute
  attachmap::attachmap!

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
