/*============================================================================*/
/* job_SortExp.sen -- Job Sort Experiment                                     */
/*============================================================================*/

" job_SortExp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* sort request                                                               */
/*----------------------------------------------------------------------------*/
: sortExp_req ( -- <R> )

  >>logEntry <SEED_REQ>

  100 apiState::senLoc

  ": sortExp_req" .

  task::this      locals| pTask |
  pTask task.job@ locals| pJob_SortExp |
  0               locals| sTableNm |
  0               locals| pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
/*
  // set dic stack
  pJob_SortExp job.pushPath task::dicStack.set

  // grab a ddl lock
  ddlLock::grabRead

  // get table name
  pJob_SortExp job.objectName@ to sTableNm

  // find table
  sTableNm pushTable assert
  sTableNm find execute to pTable
  pTable pJob_SortExp jobMark2.table!

  popIndexes
  popTable
*/
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pTask task.grabLock
  //1 task::acks!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_SortExp job_sortExp.begin
  pJob_SortExp job_sortExp.execute
  pJob_SortExp job_sortExp.end

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::wait

  //": sort_req SLEEP" .  10000 task::sleepSsec


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ": sortExp_req END" .

  900 apiState::senLoc

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
