/*============================================================================*/
/* job_Alarm.sen -- alarm job                                                 */
/*============================================================================*/

" job_Alarm.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the alarm job (as a dedicated job)                                   */
/*----------------------------------------------------------------------------*/
: alarm::spawn ( -- )

  0 locals| pJobClass_Alarm |
  0 locals| pJob_Alarm |

  CN_JOB_ALARM jobClass::find to pJobClass_Alarm

  pJobClass_Alarm jobClass.new to pJob_Alarm

  pJob_Alarm SEED_RUN job.spawn_dedicated
;

/*----------------------------------------------------------------------------*/
/* alarm loop:                                                                */
/*----------------------------------------------------------------------------*/
: alarm_run ( -- )

  >>logEntry <SEED_RUN>

  "Alarm Job Started" .

  begin

    "Alarm Job" .

    handler::serviceSleepQueue

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
