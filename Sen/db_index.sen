//  path[].discardTableFolder
//
//  pwIndexTest // return:
//;

/*----------------------------------------------------------------------------*/
/* tidy up of the index                                                       */
/*----------------------------------------------------------------------------*/
: index.tidyUp params| pIndex |

  // truncate the index
  pIndex index.truncate
;

/*----------------------------------------------------------------------------*/
/* delete all index objects                                                   */
/*----------------------------------------------------------------------------*/
: deleteIndexObjects

  "indexes" find execute locals| pFolder |

  pFolder path[].pushFolder

  folder[] dic.lastWord dup
  iterate
    object@ discard

    object@ word.prev object!
  next

  path[].discardFolder
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeIndex params| sTableNm sIndexNm |

"in removeIndex" .

symbols

sTableNm .
sIndexNm .

"A" .

  0 locals| pIndex |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushTableFolder assert
"B" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexesFolder assert
"C" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index from the table
  sIndexNm find execute to pIndex
"D" .
  pIndex pIndex index.table@ table.removeIndex
"E" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up the index and forget it
  pIndex index.tidyUp
"F" .
  sIndexNm :forget
"G" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes folder
  path[].discardIndexesFolder
"H" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  path[].discardTableFolder
"I" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
