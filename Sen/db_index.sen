/*============================================================================*/
/* db_index.sen -- index related words                                        */
/*============================================================================*/

" db_index.sen" .verbose

/*----------------------------------------------------------------------------*/
/* \index is the category to identify indexes                                 */
/*----------------------------------------------------------------------------*/
: \index \\category ;

/*----------------------------------------------------------------------------*/
/* test if word is an index (is of \index category)                           */
/*----------------------------------------------------------------------------*/
: word.isaIndex params| pwIndex |

  pwIndex word.category@ find: \index eql
;

/*----------------------------------------------------------------------------*/
/* test if current folder has the name "indexes" (i.e. is ../indexes)          */
/*----------------------------------------------------------------------------*/
: folder[].isIndexes ( t | f )

  folder[] dic.name@ "indexes" str.same
;

/*----------------------------------------------------------------------------*/
/* find the indexes folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: path[].pushIndexesFolder ( -- )

  "indexes" find execute path[].pushFolder
;

/*----------------------------------------------------------------------------*/
/* pop the indexes folder (which was pushed by path[].pushIndexesFolder)      */
/*----------------------------------------------------------------------------*/
: path[].popIndexesFolder ( -- )

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* check if in an indexes folder                                              */
/*----------------------------------------------------------------------------*/
: check::folderIsIndexes ( t | ec f )

  folder[].isIndexes if true exit then

  EC_NOT_IN_INDEXES false
;

/*----------------------------------------------------------------------------*/
/* check word is not known (specifically not a known index)                   */
/*----------------------------------------------------------------------------*/
: check::nameIsUnknownIndex params| sIndexNm | ( t | ec f )

  sIndexNm folder[].findSymbol not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check given name is the name of a word of \index category               EC */
/*----------------------------------------------------------------------------*/
: check::nameIsaIndex params| sIndexNm | ( t | ec f )

  sIndexNm find locals| pwIndex |

  pwIndex not if EC_NO_SUCH_INDEX false exit then

  pwIndex word.category@ find: \index eql if true exit then

  EC_NOT_AN_INDEX false
;

/*----------------------------------------------------------------------------*/
/* check if sTableNm . sIndexNm is a valid index assembly                     */
/*----------------------------------------------------------------------------*/
: check::validIndexAssembly params| sTableNm sIndexNm |  ( t | ec f )

  // should be in the tables folder
  check::folderIsTables not if false exit then

  // there should be a table folder
  sTableNm check::folderHasNamedTable not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushNamedTableFolder

// push indexes folder
  path[].pushIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm check::nameIsaIndex not if
    path[].popIndexesFolder
    path[].popNamedTableFolder
    folder[].isTables assert
    false
    exit
  then

  path[].popIndexesFolder
  path[].popNamedTableFolder
  folder[].isTables assert

  true
;


/*----------------------------------------------------------------------------*/
/*                   -- Supplemental Create Table Support --                  */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make an indexes folder under given named table foler                       */
/*----------------------------------------------------------------------------*/
: index::makeIndexesAssembly params| sTableNm |

/*
 * called from : table::makeTableAssembly
 */

  args.tracepoint if
    "MAKING INDEXES FOR TABLE " sTableNm str.cat
      " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  sTableNm find execute locals| pTableFolder |
  "indexes" pTableFolder folder::makeSubFolder
;


/*----------------------------------------------------------------------------*/
/*                          -- Create Index Support --                        */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* new a C++ Index instance using given table name                   EMBEDDED */
/*----------------------------------------------------------------------------*/
: index::newIndex params| sIndexNm |

  folder[].isIndexes assert

  find: \index locals| pwIndexCatg |

  sIndexNm index::new locals| pIndex |

  sIndexNm word::new locals| pwIndex |

  pwIndexCatg pIndex pwIndex word.cppObject!

  //pwIndex word.see

  pwIndex execute locals| pIndex |

  pIndex
;

/*----------------------------------------------------------------------------*/
/* make an index assembly for given table                                     */
/*----------------------------------------------------------------------------*/
: index::makeIndexAssembly params| pTable sIndexNm pIndexDef |

  sIndexNm index::newIndex locals| pIndex |

  pIndexDef pIndex index.indexDef!
  pTable pIndex index.table!

  pIndex pTable table.addIndex

  pIndex
;

/*----------------------------------------------------------------------------*/
/* create an index using given index definition                               */
/*----------------------------------------------------------------------------*/
: index::createIndex params| pTable sIndexNm pIndexDef |

  folder[].isIndexes assert

  pIndexDef sIndexNm pTable index::makeIndexAssembly locals| pIndex |

  pIndex
;


/*----------------------------------------------------------------------------*/
/*                           -- Drop Index Support --                         */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* delete C++ Index object & its forget word                                  */
/*----------------------------------------------------------------------------*/
: index::deleteIndex params| sIndexNm |

  sIndexNm find execute index::delete

  sIndexNm :forget
;

/*----------------------------------------------------------------------------*/
/* drop an index (delete index tress in table, and forget word)               */
/*----------------------------------------------------------------------------*/
: index::removeIndexAssembly params| sTableNm sIndexNm |

  0 locals| pIndex |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index from the table
  sIndexNm find execute to pIndex
  pIndex pIndex index.table@ table.deleteIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up the index and forget it
  sIndexNm index::deleteIndex
;

/*----------------------------------------------------------------------------*/
/* drop an index (delete index tress in table, and forget word)               */
/*----------------------------------------------------------------------------*/
: index::dropIndex params| sTableNm sIndexNm |

  // push table dictionary
  sTableNm path[].pushNamedTableFolder

  // push indexes folder
  path[].pushIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  sIndexNm sTableNm index::removeIndexAssembly

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // pop indexes folder
  path[].popIndexesFolder

  // pop table folder
  path[].popNamedTableFolder
;

/*----------------------------------------------------------------------------*/
/*                    -- Supplemental Drop Table Support --                   */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* delete all the indexes of a table                                          */
/*----------------------------------------------------------------------------*/
: index::deleteAllIndexes params| pFolder |

  0 locals| sIndexNm |

  pFolder dic.lastWord not if  exit_rt then

  pFolder path[].pushFolder

  begin

    pFolder dic.lastWord word.name@ to sIndexNm

    // delete Index object and forget index word
    sIndexNm index::deleteIndex
 
    pFolder dic.lastWord not until

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* remove the indexes folder (and contents) for assumed table                 */
/*----------------------------------------------------------------------------*/
: index::removeIndexesAssembly

 /*
  * This wil be called from : table::removeTableAssembly
  *
  * At this stage the table (and its indexes) will have been truncated
  */

  // delete and forget all indexes
  "indexes" find execute index::deleteAllIndexes

  // forget the indexes folder itself
  "indexes" folder::remove
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
