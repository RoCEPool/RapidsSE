/*============================================================================*/
/* db_index.sen -- index related words                                        */
/*============================================================================*/

" db_index.sen" .verbose

/*----------------------------------------------------------------------------*/
/* index is used as a kind of word to identify indexes                        */
/*----------------------------------------------------------------------------*/
: \index ;

/*----------------------------------------------------------------------------*/
/* test if word is a table                                                    */
/*----------------------------------------------------------------------------*/
: word.isIndex

  word.category@ find: \index eql
;

/*----------------------------------------------------------------------------*/
/* find the indexes folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: path[].pushIndexesFolder ( -- )

  "indexes" find execute path[].pushFolder
  true
;

/*----------------------------------------------------------------------------*/
/* pop the indexes folder                                                     */
/*----------------------------------------------------------------------------*/
: path[].discardIndexesFolder

  path[].discardFolder
;

/*----------------------------------------------------------------------------*/
/* check within indexes folder                                                */
/*----------------------------------------------------------------------------*/
: folder[].isIndexes

  folder[] dic.name@ "indexes" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: folder[].checkInIndexes

  folder[].isIndexes if true exit then

  EC_NOT_IN_INDEXES false
;

/*----------------------------------------------------------------------------*/
/* check word is an index                                                     */
/*----------------------------------------------------------------------------*/
: name::checkIsIndex ( "<indexNm>" -- true | errorCode false )

  0 locals| indexPtr indexNm |

  indexNm find ( indexPtr )
  to indexPtr

  indexPtr
  not ( indexPtr bool )

  if
    EC_NO_SUCH_INDEX false ( errorCode false )
  exit
  then

  indexPtr ( indexPtr )
  word.category@ ( ^word )
  find: \index ( ^word ^word )
  eql ( bool )
  if
    true ( true )
    exit
  then


  EC_NOT_AN_INDEX false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: checkIsNotIndex ( "<word>" )

  folder[].findSymbol not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable index                                          */
/*----------------------------------------------------------------------------*/
: checkMakeIndex ( "<tableNm>" "<indexNm>"  --  true | errorCode false )

  params| sTableNm sIndexNm |
  0 locals|  pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check in tables folder
  folder[].checkInTables not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check there is a table folder
  sTableNm folder[].checkIsTablesFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  sTableNm path[].pushTableFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if max indexes already on table
  sTableNm find execute to pTable
  pTable table.indexCount
  C_MAX_INDEXES == if
    EC_MAX_INDEXES
    path[].discardTableFolder
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes
  path[].pushIndexesFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check index already exists
  sIndexNm checkIsNotIndex not if
    path[].discardIndexesFolder
    path[].discardTableFolder
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes
  path[].discardIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  path[].discardTableFolder

  folder[].isTables assert

  true
;
/*----------------------------------------------------------------------------*/
/* check if word is a removable index folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveIndex ( "<tableNm>" "<indexNm" -- true | errorCode false )

  params| sTableNm sIndexNm |

  // should be in the tables folder
  folder[].checkInTables not if false exit then

  // there should be a table folder
  sTableNm folder[].checkIsTablesFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushTableFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexesFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm name::checkIsIndex not if
    path[].discardIndexesFolder
    path[].discardTableFolder
    folder[].isTables assert
    false
    exit
  then

  path[].discardIndexesFolder
  path[].discardTableFolder

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make an indexes folder under given named table                             */
/*----------------------------------------------------------------------------*/
: :makeIndexesSubFolder ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING INDEXES FOR TABLE " swap str.cat
      " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "indexes"    ( dic "indexes" )
  swap         ( "indexes" dic )
  :makeSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* create an index using name on the stack (leaves index on stack)            */
/*----------------------------------------------------------------------------*/
: :createIndexEmbObj params| sIndexNm |

  find: \index CN_INDEX sizeof_index sIndexNm :createObject

  compiler::current@ word.embObject index.init
  true compiler::current@ word.embObject object.wordbody!
;

/*----------------------------------------------------------------------------*/
/* create the c++ index object given its name (returns pIndex)                */
/*----------------------------------------------------------------------------*/
: :createIndexObject params| sIndexNm |

  find: \index
  index::new
  sIndexNm
    :createCppObject
      locals| pwIndex |

  pwIndex // returns:
;

/*----------------------------------------------------------------------------*/
/* make an index (run by all participants)                                     */
/*----------------------------------------------------------------------------*/
: index::make params| sTableNm sIndexNm |

  // push folders to ../t/indexes
  sTableNm path[].pushTableFolder assert
  path[].pushIndexesFolder assert

  // create the name index (word & object)
  sIndexNm :createIndexEmbObj locals| pwIndexTest |

  path[].discardIndexesFolder
  path[].discardTableFolder

  pwIndexTest // return:
;
/*----------------------------------------------------------------------------*/
//: index::make params| sTableNm sIndexNm |
//
//  // push folders to ../t/indexes
//  sTableNm path[].pushTableFolder assert
//  path[].pushIndexesFolder assert
//
