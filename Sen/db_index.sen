/*============================================================================*/
/* db_index.sen -- index related words                                        */
/*============================================================================*/

" db_index.sen" .verbose

/*----------------------------------------------------------------------------*/
/* \index is the category to identify indexes                                 */
/*----------------------------------------------------------------------------*/
: \index \\category ;

/*----------------------------------------------------------------------------*/
/* check word is not a known index/symbol                                     */
/*----------------------------------------------------------------------------*/
: name::isNotKnownIndex params| sIndexNm | ( t | ec f )

  sIndexNm folder[].findSymbol not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* test if word is an index                                                   */
/*----------------------------------------------------------------------------*/
: word.isaIndex params| pwIndex |

  pwIndex word.category@ find: \index eql
;

/*----------------------------------------------------------------------------*/
/* find the indexes folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: path[].pushIndexesFolder ( -- )

  "indexes" find execute path[].pushFolder
;

/*----------------------------------------------------------------------------*/
/* pop the indexes folder (which was pushed by path[].pushIndexesFolder)      */
/*----------------------------------------------------------------------------*/
: path[].popIndexesFolder ( -- )

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* test if in an indexes folder                                               */
/*----------------------------------------------------------------------------*/
: folder[].isIndexes ( t | f )

  folder[] dic.name@ "indexes" str.equal
;

/*----------------------------------------------------------------------------*/
/* check if in an indexes folder                                              */
/*----------------------------------------------------------------------------*/
: folder[].checkIsIndexes ( t | ec f )

  folder[].isIndexes if true exit then

  EC_NOT_IN_INDEXES false
;

/*----------------------------------------------------------------------------*/
/* check word is of \index category                                           */
/*----------------------------------------------------------------------------*/
: name::checkIsaIndex ( "<indexNm>" -- true | errorCode false )

  0 locals| indexPtr indexNm |

  indexNm find ( indexPtr )
  to indexPtr

  indexPtr
  not ( indexPtr bool )

  if
    EC_NO_SUCH_INDEX false ( errorCode false )
  exit
  then

  indexPtr ( indexPtr )
  word.category@ ( ^word )
  find: \index ( ^word ^word )
  eql ( bool )
  if
    true ( true )
    exit
  then


  EC_NOT_AN_INDEX false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check if sTableNm . sIndexNm is a removable index folder                   */
/*----------------------------------------------------------------------------*/
: index::checkRemovableFolder params| sTableNm sIndexNm |  ( t | ec f )

  // should be in the tables folder
  folder[].checkIsTables not if false exit then

  // there should be a table folder
  sTableNm folder[].checkNamedTableFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushNamedTableFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm name::checkIsaIndex not if
    path[].popIndexesFolder
    path[].popNamedTableFolder
    folder[].isTables assert
    false
    exit
  then

  path[].popIndexesFolder
  path[].popNamedTableFolder

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make an indexes folder under given named table foler                       */
/*----------------------------------------------------------------------------*/
: index::makeIndexesAssembly params| sTableNm |

  args.tracepoint if
    "MAKING INDEXES FOR TABLE " sTableNm str.cat
      " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  sTableNm find execute locals| pTableFolder |
  "indexes" pTableFolder folder::makeSubFolder
;

/*----------------------------------------------------------------------------*/
/* create an index using name on the stack (leaves index on stack)            */
/*----------------------------------------------------------------------------*/
: index::newIndexEmbObj params| sIndexNm |

  find: \index CN_INDEX sizeof_index sIndexNm :createObject locals| pwIndex |

  compiler::current@ word.embObject index.init
  true compiler::current@ word.embObject object.wordbody!

  pwIndex
;

/*----------------------------------------------------------------------------*/
/* create the c++ index object given its name (returns pIndex)                */
/*----------------------------------------------------------------------------*/
: index::newIndexPrpObj params| sIndexNm |

  find: \index locals| pIndexCatg |

  index::new locals| pIndex |

  sIndexNm word::new locals| pwIndex |

  pIndexCatg pIndex pwIndex word.cppObject!

  pwIndex
;

/*----------------------------------------------------------------------------*/
/* new a C++ Index object                                                     */
/*----------------------------------------------------------------------------*/
: index::newIndex params| sIndexNm |

  folder[].isIndexes assert

  sIndexNm index::newIndexEmbObj locals| pwIndex |

  pwIndex execute locals| pIndex |

  pIndex
;

/*----------------------------------------------------------------------------*/
/* create the index proper                                                    */
/*----------------------------------------------------------------------------*/
: index::createIndex params| pTable sIndexNm pIndexDef |

  folder[].isIndexes assert

  sIndexNm index::newIndex locals| pIndex |

  pIndexDef pIndex index.indexDef!
  pTable pIndex index.table!

  pIndex pTable table.addIndex

  pIndex
;

/*----------------------------------------------------------------------------*/
/* delete C++ Index object & its forget word                                  */
/*----------------------------------------------------------------------------*/
: index::deleteIndexEmbObj params| sIndexNm |

  sIndexNm :forget
;

/*----------------------------------------------------------------------------*/
/* delete C++ Index object & its forget word                                  */
/*----------------------------------------------------------------------------*/
: index::deleteIndexPrpObj params| sIndexNm |

  0 assert
;

/*----------------------------------------------------------------------------*/
/* delete C++ Index object & its forget word                                  */
/*----------------------------------------------------------------------------*/
: index::deleteIndex params| sIndexNm |

  sIndexNm index::deleteIndexEmbObj
;

/*----------------------------------------------------------------------------*/
/* forget all words in given dictionary                                       */
/*----------------------------------------------------------------------------*/
: folder.forgetAllWords params| pFolder |

  0 locals| sIndexNm |

  pFolder dic.lastWord not if  exit_rt then

  pFolder path[].pushFolder

  begin

    pFolder dic.lastWord word.name@ to sIndexNm

    // delete Index object and forget index word
    sIndexNm index::deleteIndex
 
    pFolder dic.lastWord not until

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* remove the indexes folder (and contents) for named table                   */
/*----------------------------------------------------------------------------*/
: index::removeIndexesFolder

  // forget the words in the indexes folder
  "indexes" find execute folder.forgetAllWords

  // forget the indexes folder itself
  "indexes" folder::remove
;

/*----------------------------------------------------------------------------*/
/* drop an index (delete index tress in table, and forget word)               */
/*----------------------------------------------------------------------------*/

/*
 * this is a compound action. prefer splitting it apart
 */

: index::dropIndex params| sTableNm sIndexNm |

  0 locals| pIndex |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushNamedTableFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index from the table
  sIndexNm find execute to pIndex
  pIndex pIndex index.table@ table.deleteIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up the index and forget it
  sIndexNm :forget

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes folder
  path[].popIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  path[].popNamedTableFolder
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
