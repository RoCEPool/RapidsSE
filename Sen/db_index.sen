/*============================================================================*/
/* db_index.sen -- index related words                                        */
/*============================================================================*/

" db_index.sen" .verbose

/*----------------------------------------------------------------------------*/
/* index is used as a kind of word to identify indexes                        */
/*----------------------------------------------------------------------------*/
: \index ;

/*----------------------------------------------------------------------------*/
/* test if word is a table                                                    */
/*----------------------------------------------------------------------------*/
: word.isIndex

  word.category@ find: \index eql
;

/*----------------------------------------------------------------------------*/
/* find the indexes folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: path[].pushIndexesFolder ( -- )

  "indexes" find execute path[].pushFolder
  true
;

/*----------------------------------------------------------------------------*/
/* pop the indexes folder                                                     */
/*----------------------------------------------------------------------------*/
: path[].discardIndexesFolder

  path[].discardFolder
;

/*----------------------------------------------------------------------------*/
/* check within indexes folder                                                */
/*----------------------------------------------------------------------------*/
: folder[].isIndexes

  folder[] dic.name@ "indexes" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: folder[].checkInIndexes

  folder[].isIndexes if true exit then

  EC_NOT_IN_INDEXES false
;

/*----------------------------------------------------------------------------*/
/* check word is an index                                                     */
/*----------------------------------------------------------------------------*/
: name::checkIsIndex ( "<indexNm>" -- true | errorCode false )

  0 locals| indexPtr indexNm |

  indexNm find ( indexPtr )
  to indexPtr

  indexPtr
  not ( indexPtr bool )

  if
    EC_NO_SUCH_INDEX false ( errorCode false )
  exit
  then

  indexPtr ( indexPtr )
  word.category@ ( ^word )
  find: \index ( ^word ^word )
  eql ( bool )
  if
    true ( true )
    exit
  then


  EC_NOT_AN_INDEX false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make an indexes folder under given named table                             */
/*----------------------------------------------------------------------------*/
: :makeIndexesSubFolder ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING INDEXES FOR TABLE " swap str.cat
      " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "indexes"    ( dic "indexes" )
  swap         ( "indexes" dic )
  :makeSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* create an index using name on the stack (leaves index on stack)            */
/*----------------------------------------------------------------------------*/
: :createIndex params| sIndexNm |

  find: \index CN_INDEX sizeof_index sIndexNm :createObject

  compiler::current@ word.embObject index.init
  true compiler::current@ word.embObject object.wordbody!
;

