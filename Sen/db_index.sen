/*----------------------------------------------------------------------------*/
/* tidy up of the index                                                       */
/*----------------------------------------------------------------------------*/
: indexTidyUp ( "<indexNm>" -- )

  params| sIndexNm |
  0 locals| pIndex |

  // find the index
  sIndexNm find execute to pIndex

  // truncate the index
  pIndex index.truncate
;

/*----------------------------------------------------------------------------*/
/* delete all index objects                                                   */
/*----------------------------------------------------------------------------*/
: deleteIndexObjects

  "indexes" find execute locals| pFolder |

  pFolder path[].pushFolder

  folder[] dic.lastWord dup
  iterate
    object@ drop

    object@ word.prev object!
  next

  path[].discardFolder
;


/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeIndex params| sTableNm sIndexNm |

"in removeIndex" .

symbols

sTableNm .
sIndexNm .

"A" .

  0 locals| pIndex |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushTableFolder assert
"B" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexesFolder assert
"C" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index from the table
  sIndexNm find execute to pIndex
"D" .
  pIndex pIndex index.table@ table.removeIndex
"E" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up the index and forget it
  sIndexNm indexTidyUp
"F" .
  sIndexNm :forget
"G" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes folder
  path[].discardIndexesFolder
"H" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  path[].discardTableFolder
"I" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* get size of named index                                                    */
/*----------------------------------------------------------------------------*/
: index::size params| sTableNm sIndexNm |

  // push table and indexes folder
  sTableNm path[].pushTableFolder assert

  path[].pushIndexesFolder assert

  // get pointer to c++ index object
  sIndexNm find execute locals| pIndex |

  // get size (in bytes) of index
  pIndex index.space locals| iSize |

  // pop indexes and table folder
  path[].discardIndexesFolder
  path[].discardTableFolder

  iSize // returns:
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
