/*============================================================================*/
/* jobMarkers.sen -- Job <Marker> words                                       */
/*============================================================================*/

" jobMarkers.sen" .verbose

0 constant SEED_RUN
1 constant SEED_REQ
2 constant SEED_RCV
3 constant SEED_EXE
4 constant SEED_END
5 constant SEED_CAN


/*----------------------------------------------------------------------------*/
/* done executing a beg seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_BEG> ( --  )

  // the job remains in the participant list
  // the task exits and gets deleted
  nullptr task::this task.job!

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* done executing a can seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_CAN> ( --  )

  // delete the job
  job::this "delete_completed_job" find execute

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* done executing a end seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_END> ( --  )

  // delete the job
  job::this "delete_completed_job" find execute

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* return from job execution on node                                          */
/*----------------------------------------------------------------------------*/
: <DONE_EXE> ( --  )

  ddlLock::testDrop

  nullptr task::this task.job!

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* done executing a kid seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_KID> ( --  )

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* done executing a rcv seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_RCV> ( --  )

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* done executing a req seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_REQ> ( --  )

  job::this locals| pJob |

  ddlLock::testDrop

  // null the job in the task
  nullptr task::this task.job!

  //"Signalling connector thread" .
  pJob job.signalConnector

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* done executing a run seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_RUN> ( --  )

  ::task_exit
;

: <SEED_BEG> ;
: <SEED_CAN> ;
: <SEED_END> ;
: <SEED_EXE> ;
: <SEED_KID> ;
: <SEED_RCV> ;
: <SEED_REQ> ;
: <SEED_RUN> ;

/*----------------------------------------------------------------------------*/
/* return from chcek resources                                                */
/*----------------------------------------------------------------------------*/
: <Check_Resources> ( --  )

;

/*----------------------------------------------------------------------------*/
/* return from chcek resources                                                */
/*----------------------------------------------------------------------------*/
: <Resources_Checked> ( --  )

  ddlLock::testDrop
;

/*----------------------------------------------------------------------------*/
/* return from cehcek resources                                              */
/*----------------------------------------------------------------------------*/
: <Release_Resources> ( --  )

;

/*----------------------------------------------------------------------------*/
/* return from cehcek resources                                              */
/*----------------------------------------------------------------------------*/
: <Resources_Released> ( --  )

;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_JOB> ( errorCode pJob -- )

  params| pJob errorCode |

  ddlLock::testDrop

  //errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode grid::thisNode@ pJob job.error!
;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_REQUEST> ( errorCode pJob -- )

  params| pJob errorCode |

  ddlLock::testDrop

  // null the job in the task
  nullptr task::this task.job!

  //errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode grid::thisNode@ pJob job.error!

  //"Signalling connector thread" .
  pJob job.signalConnector

  ::task_exit
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
