/*============================================================================*/
/* jobMarkers.sen -- Job <Marker> words                                       */
/*============================================================================*/

" jobMarkers.sen" .verbose

0 constant SEED_RUN
1 constant SEED_REQ
2 constant SEED_RCV
3 constant SEED_EXE
4 constant SEED_END
5 constant SEED_CAN


/*----------------------------------------------------------------------------*/
/* done executing a beg seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_BEG> ( --  )

  ddlLock::testDrop

  JP_BEGUN job::this job.phase!

  task::delete
;

/*----------------------------------------------------------------------------*/
/* done executing a can seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_CAN> ( --  )

  ddlLock::testDrop

  JP_CANCELED job::this job.phase!

  job::completed
;

/*----------------------------------------------------------------------------*/
/* done executing a end seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_END> ( --  )

  ddlLock::testDrop

  JP_ENDED job::this job.phase!

  job::completed
;

/*----------------------------------------------------------------------------*/
/* return from job execution on node                                          */
/*----------------------------------------------------------------------------*/
: <DONE_EXE> ( --  )

  ddlLock::testDrop

  JP_EXECUTED job::this job.phase!

  task::delete
;

/*----------------------------------------------------------------------------*/
/* done executing a kid seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_KID> ( --  )

  ddlLock::testDrop

  task::delete
;

/*----------------------------------------------------------------------------*/
/* done executing a rcv seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_RCV> ( --  )

  ddlLock::testDrop

  JobRef[].return

  task::delete
;

/*----------------------------------------------------------------------------*/
/* done executing a req seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_REQ> ( --  )

  ddlLock::testDrop

  //"Signalling the thread waiting on job completion" .
  job::this job.signalWaiter
;

/*----------------------------------------------------------------------------*/
/* done executing a run seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_RUN> ( --  )

  ddlLock::testDrop

  task::delete
;




/*----------------------------------------------------------------------------*/
/* seed begin                                                                 */
/*----------------------------------------------------------------------------*/
: <SEED_BEG>

  SS_SEED_BEG log::jobSeed

  JP_BEGINNING job::this job.phase!
;

/*----------------------------------------------------------------------------*/
/* seed cancel                                                                */
/*----------------------------------------------------------------------------*/
: <SEED_CAN>

  SS_SEED_CAN log::jobSeed

  JP_BEGINNING job::this job.phase!
;

/*----------------------------------------------------------------------------*/
/* seed end                                                                   */
/*----------------------------------------------------------------------------*/
: <SEED_END>

  SS_SEED_END log::jobSeed

  JP_CANCELING job::this job.phase!
;

/*----------------------------------------------------------------------------*/
/* seed execute                                                               */
/*----------------------------------------------------------------------------*/
: <SEED_EXE>

  SS_SEED_EXE log::jobSeed

  JP_EXECUTING job::this job.phase!
;

/*----------------------------------------------------------------------------*/
/* seed execute                                                               */
/*----------------------------------------------------------------------------*/
: <SEED_EXE2>

  SS_SEED_EXE log::jobSeed

  JP_EXECUTING job::this job.phase!

  // ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !
  // set task's dictionary stack from path in job

  <path> str.toStrVec task::dicStack.set
  //task::dump
;

/*----------------------------------------------------------------------------*/
/* seed kid                                                                   */
/*----------------------------------------------------------------------------*/
: <SEED_KID>

  SS_SEED_KID log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* seed receive                                                               */
/*----------------------------------------------------------------------------*/
: <SEED_RCV>

  SS_SEED_RCV log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* seed request                                                               */
/*----------------------------------------------------------------------------*/
: <SEED_REQ>

  SS_SEED_REQ log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* seed request                                                               */
/*----------------------------------------------------------------------------*/
: <SEED_REQ2>

  SS_SEED_REQ log::jobSeed

  // ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !
  // set <path> from job
  //job::this job.pushPath strVec::toPath to <path>
  pushPath strVec::toPath to <path>
  <path> str.toStrVec task::dicStack.set
  //task::dump
;

/*----------------------------------------------------------------------------*/
/* seed run                                                                   */
/*----------------------------------------------------------------------------*/
: <SEED_RUN>

  SS_SEED_RUN log::jobSeed
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* return from chcek resources                                                */
/*----------------------------------------------------------------------------*/
: <Check_Resources> ( --  )

;

/*----------------------------------------------------------------------------*/
/* return from chcek resources                                                */
/*----------------------------------------------------------------------------*/
: <Resources_Checked> ( --  )

  ddlLock::testDrop
;

/*----------------------------------------------------------------------------*/
/* return from cehcek resources                                              */
/*----------------------------------------------------------------------------*/
: <Release_Resources> ( --  )

;

/*----------------------------------------------------------------------------*/
/* return from cehcek resources                                              */
/*----------------------------------------------------------------------------*/
: <Resources_Released> ( --  )

;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_JOB> ( errorCode pJob -- )

  params| pJob errorCode |

  ddlLock::testDrop

  //errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode pJob job.error!
;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_REQUEST> ( errorCode pJob -- )

  params| pJob errorCode |

  ddlLock::testDrop
 
  //errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode pJob job.error!

  //"Signalling the thread waiting on job completion" .
  pJob job.signalWaiter

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
