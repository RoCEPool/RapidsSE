/*============================================================================*/
/* jobMarkers.sen -- Job Seed <Marker> words                                  */
/*============================================================================*/

" jobMarkers.sen" .verbose

0 constant SEED_RUN
1 constant SEED_REQ
2 constant SEED_RCV
3 constant SEED_EXE
4 constant SEED_END
5 constant SEED_CAN


/******************************************************************************/
/***                              Done Markers                              ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* done executing any seed                                                    */
/*----------------------------------------------------------------------------*/
: <done_finally> ( -- )

  // check this task has no job reference
  JobRef[].none

  // check this task has no ddl lock
  DdlLock[].none

  task::doneFinally
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* done executing a beg seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_BEG> ( -- )

  DdlLock[].testDrop

  JP_BEGUN job::this job.phase!

  <done_finally>
  task::delete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a can seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_CAN> ( -- )

  DdlLock[].testDrop

  JP_CANCELED job::this job.phase!

  <done_finally>
  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a end seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_END> ( -- )

  DdlLock[].testDrop

  JP_ENDED job::this job.phase!

  <done_finally>
  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* return from job execution on node                                          */
/*----------------------------------------------------------------------------*/
: <DONE_EXE> ( -- )

  DdlLock[].testDrop

  JP_EXECUTED job::this job.phase!

  <done_finally>
  task::delete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a kid seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_KID> ( -- )

  DdlLock[].testDrop

  <done_finally>
  task::delete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a rcv seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_RCV> ( -- )

  DdlLock[].testDrop

  <done_finally>
  task::delete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a req seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_REQ> ( -- )

  DdlLock[].testDrop

  //"Signalling the thread waiting on job completion" .
  <done_finally>

  job::this job.signalWaiter

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a run seed                                                  */
/*----------------------------------------------------------------------------*/
: <DONE_RUN> ( -- )

  DdlLock[].testDrop

  <done_finally>
  task::delete

  HAZARD
;


/******************************************************************************/
/***                              Seed Markers                              ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* check ready to execute any seed                                            */
/*----------------------------------------------------------------------------*/
: <seed_initially> ( -- )

  task::seedInitially
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* seed begin                                                                 */
/*----------------------------------------------------------------------------*/
: <SEED_BEG>

  SS_SEED_BEG log::jobSeed

  JP_BEGINNING job::this job.phase!

  <path> str.toStrVec task::dicStack.set

  <seed_initially>

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed cancel                                                                */
/*----------------------------------------------------------------------------*/
: <SEED_CAN>

  SS_SEED_CAN log::jobSeed

  JP_CANCELING job::this job.phase!

  <seed_initially>

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed end                                                                   */
/*----------------------------------------------------------------------------*/
: <SEED_END>

  SS_SEED_END log::jobSeed

  JP_ENDING job::this job.phase!

  <seed_initially>

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed execute                                                               */
/*----------------------------------------------------------------------------*/
: <SEED_EXE>

  SS_SEED_EXE log::jobSeed

  JP_EXECUTING job::this job.phase!

  // ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !
  // set task's dictionary stack from path in job

  <path> str.toStrVec task::dicStack.set
  //task::dump

  <seed_initially>

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed receive                                                               */
/*----------------------------------------------------------------------------*/
: <SEED_RCV>

  SS_SEED_RCV log::jobSeed

  <seed_initially>

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed request                                                               */
/*----------------------------------------------------------------------------*/
: <SEED_REQ>

  SS_SEED_REQ log::jobSeed

  // use the <path> from <ename-set>
  <path> str.toStrVec task::dicStack.set

  <seed_initially>

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed run                                                                   */
/*----------------------------------------------------------------------------*/
: <SEED_RUN>

  SS_SEED_RUN log::jobSeed

  <path> str.toStrVec task::dicStack.set

  <seed_initially>

  job::</seeFlow/>
;


/******************************************************************************/
/***                                  Misc                                  ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* return from chcek resources                                                */
/*----------------------------------------------------------------------------*/
: <Check_Resources> ( -- )

;

/*----------------------------------------------------------------------------*/
/* return from chcek resources                                                */
/*----------------------------------------------------------------------------*/
: <Resources_Checked> ( -- )

  DdlLock[].testDrop
;

/*----------------------------------------------------------------------------*/
/* return from cehcek resources                                              */
/*----------------------------------------------------------------------------*/
: <Release_Resources> ( -- )

;

/*----------------------------------------------------------------------------*/
/* return from cehcek resources                                               */
/*----------------------------------------------------------------------------*/
: <Resources_Released> ( -- )

;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_JOB> ( errorCode pJob -- )

  params| pJob errorCode |

  DdlLock[].testDrop

  //errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode pJob job.error!
;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_REQUEST> ( errorCode pJob -- )

  params| pJob errorCode |

  DdlLock[].testDrop
 
  //errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode pJob job.error!

  <done_finally>

  //"Signalling the thread waiting on job completion" .
  pJob job.signalWaiter

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
