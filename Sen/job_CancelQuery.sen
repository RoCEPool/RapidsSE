/*============================================================================*/
/* job_CancelQuery.sen -- Job Cancel Query                                    */
/*============================================================================*/

" job_CancelQuery.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                       (on each participating node) */
/*----------------------------------------------------------------------------*/
 : cancelQuery_exe ( -- )
 
   >>logEntry <SEED_EXE>

   job[] locals| pJob_CancelQuery |

   0 0 locals| sJobId iJobId |


   //----------------------------------------------------------------------------
   // grab a ddl lock
   DdlLock[].grabRead

   <jobId> to sJobId

  //----------------------------------------------------------------------------

  // check if we can find the query associated with the job
  // <jobId> plist::findJob not if job[] <ERROR_JOB> !!logError exit then

  sJobId str.tailInt drop to iJobId
  iJobId  plist::findJob drop

  // cancel the query
  JobRef[] Job_Pipeline.cancel
  JobRef[].return

  pJob_CancelQuery job::participantExecuted

  <<logExit DONE_EXE
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: 
  cancelQuery :: cancel query <jobId> {name:value}
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobInfo: cancelQuery
{
  ?<jobDesc>?  = "--description of job--"
  
  ?<jobKind>?  = JK_DIST2PC
  ?<rspKind>?  = RS_PARTICIPANT_RESPONSE
  ?<ddlLock>?  = DL_GRAB_WRITE

  ?<preCheck>? = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
