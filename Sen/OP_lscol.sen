/*============================================================================*/
/* OP_lscol.sen -- Operator list columns                                      */
/*============================================================================*/

" OP_lscol.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lscol_action

  0 locals| iColumns |

  // find the table
  <tableNm> op__table not if
    false
    exit
  then

  // get the table column count
  table[].columnCount@ to iColumns

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  infoSetTable[] StreamDef[].new

  // create an infoSet operand
  StreamDef[] InfoSet[].new

  // insert a row in the infoset for each column
  iColumns 0 do
    I table[].column@
    StreamDef[] InfoSet[].addColumnDef assert
  loop

  // pipeout the streamDef
  StreamDef[].pipeout

  // pipeout the infoset
  InfoSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: lscol :: lscol <tableNm> ;

: lscol opInfo tagCopy: localLiteOp_tags
  tags{
    <jobDesc>     = "--description of operator--"
    <localLiteOp> = true
    <streamDef>   = __listColumns
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

