/*============================================================================*/
/* r35Sockets.sen -- R35 socket related tasks                                 */
/*============================================================================*/

"r35Sockets.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send valset across the socket                                              */
/*----------------------------------------------------------------------------*/
: >socketR35 ( valset -- )

  task::this task.sendNode@ node.socket@

  tp: sending

  socket.send ( bool )

  not if
  "send failure" . ( 0/1 )
  then
;

/*----------------------------------------------------------------------------*/
/* recv valset from the socket                                                */
/*----------------------------------------------------------------------------*/
: socketR35> ( -- valset )

  task::this task.socket@

  tp: receiving

  socket.recv

  tp: received
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
