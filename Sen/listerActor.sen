/*============================================================================*/
/* listerActor.sen -- task lister actor                                       */
/*============================================================================*/

"listerTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

taskCursor: pTaskCrs

/*----------------------------------------------------------------------------*/
/* start the lister task                                                      */
/*----------------------------------------------------------------------------*/
: listerStart

  0 "lis.loop" nullptr "ListerActor" spawnActorTask drop
;

/*----------------------------------------------------------------------------*/
/* lister iteration                                                           */
/*----------------------------------------------------------------------------*/
: iterateTaskList

  listerTaskPrint if
    "task list..." .
  then

  pTaskCrs pTaskCrs taskcursor.begin
          pTaskCrs taskcursor.first
  iterate

    listerTaskPrint if
      object@ task.dump
    then

    cursor@ taskcursor.next object!

  next

  pTaskCrs taskcursor.end

;

/*----------------------------------------------------------------------------*/
/* lister task loop                                                           */
/*----------------------------------------------------------------------------*/
: lis.loop

  "listerTask" task::this task.name!

  listerTaskPrint if "lister Task running..." . then

  begin

    iterateTaskList

    3 thread.sleep_s

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
