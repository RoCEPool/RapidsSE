/*============================================================================*/
/* op__common.sen -- operator common words                                    */
/*============================================================================*/

" op__common.sen" .verbose

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm>                                         */
/*----------------------------------------------------------------------------*/
: op__table

  "op__table (Table A)" .

  // check in tables folder
  checkInTables not if false exit then

  "op__table (Table B)" .

  // table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB
    Operand[].delete
    Operand[].newErrorMarker
    exit
  then

  "op__table (Table C)" .

  // move to table folder and find the table
  <tableNm> pushTable assert
  <tableNm> find execute to table[]

  "op__table (Table D)" .

  // cross-check
  table[].get assert

;


/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm>, then to <indexNm>                      */
/*----------------------------------------------------------------------------*/
: op__table_index

  "op__table_index (Table A)" .
  op__table

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "op__table_index (Index A)" .

  // move to indexes folder
  pushIndexes assert

  "op__table_index (Index B)" .

  <indexNm> checkIsIndex not if
    op.pipelineJob@ ERROR_JOB
    Operand[].delete
    Operand[].newErrorMarker
    exit
  then

  "op__table_index (Index C)" .

  <IndexNm> find execute to index[]

  "op__table_index (Index D)" .

  // cross-check
  index[].get assert

  //pathStr .
;

/*----------------------------------------------------------------------------*/
/* set operator topology, next stage and op                                   */
/*----------------------------------------------------------------------------*/
: op__topology

  op[].init

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!
;

/*----------------------------------------------------------------------------*/
/* default operator loop                                                      */
/*----------------------------------------------------------------------------*/
: op__loop

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // execute the operator's handler for the operand
    Operand[].kind op[].handler@ execute

  while assert::stack_0 repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: opSyntax:

  // create a word using next token from input source as the word name

  next-token locals| sOpNm |

  sOpNm series-name "_syntax" str.cat :create

  // set the word category to be jobSyntax
  //[ compiler::current@ , ] compiler::current@ word.category!
  find: jobSyntax: compiler::current@ word.category!

  // attach an ename set to the word being created
  EnameSet::new locals| pEnameSet |

  pEnameSet compiler::current@ word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__name__" sOpNm
    pEnameSet EnameSet.addStr

  // skip the :: token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__job__" "CN_JOB_UNIVERSAL"
  pEnameSet EnameSet.addStr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till ';', build ename set representing the syntax
  begin
    next-token
    dup ";" str.equal not
    while

      dup str.isMetaToken if
        // dup "%v is a meta token" .printf
        // add ("*",meta,TN_STRING) in ename set
        "__meta__" swap pEnameSet EnameSet.addStr

      else dup str.isJsonToken if
        // dup "%v is a json token" .printf
        // add ("*",json,TN_STRING) in ename set
        "__json__" swap pEnameSet EnameSet.addStr

      else dup "__etc__" str.equal if
        "__etc__"  swap pEnameSet EnameSet.addStr

      else
        // dup "%v is a normal token" .printf
        // add (word,"",TN_STRING) in ename set
        dup pEnameSet EnameSet.addStr

      then then then
  repeat

  // drop the ";" from dstack
  drop

  // pEnameSet EnameSet.asStr .

  does>
    // ..to be written
    drop
;



/*----------------------------------------------------------------------------*/
/* the op info compiler                                                       */
/*----------------------------------------------------------------------------*/
: opInfo:

  0 0 0 0 locals| pWord sEname sEvalue pEnameSet |

  // create a word using next token from input source as the word name
  next-token "_info" str.cat :create

  compiler::current@ to pWord

  // set the word kind to be jobClass
  //[ compiler::current@ , ] compiler::current@ word.category!
  [ compiler::current@ , ] pWord word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet

  pEnameSet pWord word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<jobNm>" pWord word.name_trunc pEnameSet EnameSet.addStr

  // skip the "{" token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    next-token
    dup "}" str.equal not
  while
    to sEname
    next-token drop
    next-token to sEvalue
    sEname sEvalue pWord jobInfo::addEname
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // complete the ename-set

  pWord .fillOutEnameSet

  //pEnameSet EnameSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* the op info compiler                                                       */
/*----------------------------------------------------------------------------*/
: opInfo immediate

  0 0 0 0 locals| pWord sEname sEvalue pEnameSet |

  compiler::current@ to pWord

  // set the name of the word to be _info
  pWord word.name@
    "_info" str.cat
    pWord word.name!

  // set the word category to be opInfo:
  // this should be opInfo
  find: opInfo: pWord word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet
    pEnameSet pWord word.EnameSet!

  // add <jobNm> tag
  "<jobNm>" pWord word.name_trunc pEnameSet EnameSet.addStr

  pWord ,
    POSTPONE word.enameset@

  //does>
;

/*----------------------------------------------------------------------------*/
/* the op info compiler                                                       */
/*----------------------------------------------------------------------------*/
: opFill immediate

  compiler::current@ .fillOutEnameSet
;

/*----------------------------------------------------------------------------*/
/* complete the info for all ops                                              */
/*----------------------------------------------------------------------------*/
: fillOutOps

  find: opInfo: locals| pOpInfo: |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor
    //object@ word.category@ pOpInfo: eql if
    object@ word.name@  "scanOp_info" str.equal if
      object@ word.dump
      object@ .fillOutEnameSet
    then

    object@ word.prev object!             // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerNew

  timer::new    to timer[]
  aggTimer::new to aggTimer[]
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerBegin

  timer[] timer.start
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerUpdate

  timer[] timer.update

  timer[] timer.ticks aggTimer[] aggTimer.add
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
