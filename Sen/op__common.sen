/*============================================================================*/
/* op__common.sen -- operator common words                                    */
/*============================================================================*/

" op__common.sen" .verbose

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__file ( fileNm mode -- )

  params| mode sFileNm |

  // open the file for reading
  file::new to File0[]
  sfileNm mode File0[].get file.open
  if
    true
  else
    File0[].get file.delete assert::stack_0 nullptr File0[].set EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
  then
  ;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__tableDef_infoSet ( tableNm -- )

  params| sTableNm |

  // save current path
  path[].save

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec path[].set

  // table
  sTableNm name::checkIsValidTable assert

  // move to table folder and find the table
  sTableNm path[].pushTableFolder assert
  sTableNm find execute to infoSetTable[]

  // cross-check
  infoSetTable[] assert

  path[].discardTableFolder

  // restore path
  path[].restore

  true
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__tableDef_streamSet ( tableNm -- )

  params| sTableNm |

  // save current path
  path[].save

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec path[].set

  // table
  sTableNm name::checkIsValidTable assert

  // move to table folder and find the table
  sTableNm path[].pushTableFolder assert
  sTableNm find execute to streamSetTable[]

  // cross-check
  streamSetTable[] assert

  path[].discardTableFolder

  // restore path
  path[].restore

  true
  ;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm>                                         */
/*----------------------------------------------------------------------------*/
: op__table ( tableNm -- )

  params| sTableNm |

  // check in tables folder
  folder[].checkInTables not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
    exit
  then

  // table
  sTableNm name::checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
    exit
  then

  // move to table folder and find the table
  <tableNm> path[].pushTableFolder assert
  <tableNm> find execute to table[]
  path[].discardTableFolder

  // cross-check
  table[] assert

  true
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm>, then to <indexNm>                      */
/*----------------------------------------------------------------------------*/
: op__table_index ( tableNm indexNm )

  params| sIndexNm sTableNm |

  // check in tables folder
  folder[].checkInTables not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
    exit
  then

  // table
  sTableNm name::checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
  exit
  then

  // move to table folder and find the table
  <tableNm> path[].pushTableFolder assert
  <tableNm> find execute to table[]

  // cross-check
  table[] assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // move to indexes folder
  path[].pushIndexesFolder assert

  sIndexNm name::checkIsIndex not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    path[].discardTableFolder
    path[].discardIndexesFolder
    false
    exit
  then

  sIndexNm find execute to index[]

  // cross-check
  index[].get assert

  path[].discardTableFolder
  path[].discardIndexesFolder

  //pathStr .
  true
;

/*----------------------------------------------------------------------------*/
/* set operator topology, next stage and op                                   */
/*----------------------------------------------------------------------------*/
: op__topology

  op[].init

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!
;

/*----------------------------------------------------------------------------*/
/* default operator loop                                                      */
/*----------------------------------------------------------------------------*/
: op__loop

  begin

    Operand[].isNull if

      // bide till next operand is available
      Pipein[].bide

      // pop next operand from queue into Pipein[]
      Pipein[].next

      // execute the operator's handler for the operand
      Pipein[].kind op[].handler@ execute

    else

      // get the Out-of_Order Operand
      OperandOoO[].next if

        OperandOoO[] to Pipein[]
        nullptr to OperandOoO[]

        // execute the operator's handler for the Out-of_Order operand
        Pipein[].kind op[].handler@ execute

        // assert Operand is null
        Operand[].isNull assert

      else

        // execure operand handler
        Operand[].kind op[].handler@ execute

      then

    then

  while assert::stack_0 repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: opSyntax:

  // create a word using next token from input source as the word name

  input::next locals| sOpNm |

  sOpNm series-name "_syntax" str.cat :create

  // set the word category to be jobSyntax
  //[ compiler::current@ , ] compiler::current@ word.category!
  find: jobSyntax: compiler::current@ word.category!

  // attach an ename set to the word being created
  EnameSet::new locals| pEnameSet |

  pEnameSet compiler::current@ word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__name__" sOpNm
    pEnameSet enameSet.appendStr

  // skip the :: token from input source
  input::next drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__job__" "CN_JOB_UNIVERSAL"
  pEnameSet enameSet.appendStr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till ';', build ename set representing the syntax
  begin
    input::next
    dup ";" str.equal not
    while

      dup str.isMetaToken if
        // dup "%v is a meta token" .printf
        // add ("*",meta,TN_STRING) in ename set
        "__meta__" swap pEnameSet enameSet.appendStr

      else dup str.isJsonToken if
        // dup "%v is a json token" .printf
        // add ("*",json,TN_STRING) in ename set
        "__json__" swap pEnameSet enameSet.appendStr

      else dup "__etc__" str.equal if
        "__etc__"  swap pEnameSet enameSet.appendStr

      else
        // dup "%v is a normal token" .printf
        // add (word,"",TN_STRING) in ename set
        dup pEnameSet enameSet.appendStr

      then then then
  repeat

  // drop the ";" from dstack
  drop

  // pEnameSet EnameSet.asStr .

  does>
    // ..to be written
    drop
;



/*----------------------------------------------------------------------------*/
/* the op info compiler                                                       */
/*----------------------------------------------------------------------------*/
: opInfo:

  0 0 0 0 locals| pWord sEname sEvalue pEnameSet |

  // create a word using next token from input source as the word name
  input::next "_info" str.cat :create

  compiler::current@ to pWord

  // set the word kind to be jobClass
  //[ compiler::current@ , ] compiler::current@ word.category!
  [ compiler::current@ encode::push ] pWord word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet

  pEnameSet pWord word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<jobNm>" pWord word.name_trunc pEnameSet enameSet.insertStr

  // skip the "{" token from input source
  input::next drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    input::next
    dup "}" str.equal not
  while
    to sEname
    input::next drop
    input::next to sEvalue
    sEname sEvalue pWord jobInfo::addEname
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  input::next drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // complete the ename-set

  pWord .fillOutEnameSet

  //pEnameSet EnameSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* the op info compiler                                                       */
/*----------------------------------------------------------------------------*/
: opInfo immediate

  0 0 0 0 locals| pWord sEname sEvalue pEnameSet |

  compiler::current@ to pWord

  // set the name of the word to be _info
  pWord word.name@
    "_info" str.cat
    pWord word.name!

  // set the word category to be opInfo:
  // this should be opInfo
  find: opInfo: pWord word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet
    pEnameSet pWord word.EnameSet!

  // add <jobNm> tag
  "<jobNm>" pWord word.name_trunc pEnameSet enameSet.insertStr

  pWord encode::call
    POSTPONE word.enameset@

  //does>
;

/*----------------------------------------------------------------------------*/
/* the op info compiler                                                       */
/*----------------------------------------------------------------------------*/
: opFill immediate

  compiler::current@ .fillOutEnameSet
;

/*----------------------------------------------------------------------------*/
/* complete the info for all ops                                              */
/*----------------------------------------------------------------------------*/
: fillOutOps

  find: opInfo: locals| pOpInfo: |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor
    object@ word.category@ pOpInfo: eql if
      // object@ word.dump
      // object@ word.enameSet@ enameSet.asStr .
      object@ .fillOutEnameSet
    then

    object@ word.prev object!             // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerNew

  timer::new    to timer[]
  aggTimer::new to aggTimer[]
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerBegin

  timer[] timer.start
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerUpdate

  timer[] timer.update

  timer[] timer.ticks aggTimer[] aggTimer.add
;

/*============================================================================*/
/* end                                                                        */
