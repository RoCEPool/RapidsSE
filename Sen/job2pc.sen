/*============================================================================*/
/* job2pc.sen -- Distributed 2PC Job related words                            */
/*============================================================================*/

" job2pc.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distribute current originating job to all participating nodes              */
/*----------------------------------------------------------------------------*/
: job::distributeConnected ( -- )

  job::this locals| pJob |

  // set the no of acks expected by originator job
  //   to be the number of connected nodes in the grid
  grid::connectedNodes pJob job.acksRemaining!

  // grab this task's lock
  task::this task.grabLock

  // set acks for originator task
  1 task::acks!

  // send the job to each connected node in the grid
  grid::definedNodes 0 do

    I grid::node node.sendSocket@ if
      I pJob job.forward
    then

  loop

  // create the response vector in the orginating job to receive responses
  pJob job.createResponseVec
;


/*----------------------------------------------------------------------------*/
/* send job__begun back to originating node                                   */
/*----------------------------------------------------------------------------*/
: 2pcReply::job__begun ( -- )

  job::this "Job__Begun::send" find execute
;

/*----------------------------------------------------------------------------*/
/* send job__executed back to originating node                                */
/*----------------------------------------------------------------------------*/
: 2pcReply::job__executed ( -- )

  job::this "Job__Executed::send" find execute
;

/*----------------------------------------------------------------------------*/
/* ended a job on participant node                                            */
/*----------------------------------------------------------------------------*/
: 2pcReply::job__ended ( -- )

  job::this "Job__Ended::send" find execute
;

/*----------------------------------------------------------------------------*/
/* cancelled a job on participant node                                        */
/*----------------------------------------------------------------------------*/
: 2pcReply::job__cancelled ( -- )

  job::this "Job__Cancelled::send" find execute
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
