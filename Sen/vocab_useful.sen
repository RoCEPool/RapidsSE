/*============================================================================*/
/* vocab_useful.sen -- misc useful stuff                                      */
/*============================================================================*/

" vocab_useful.sen" .verbose

/*----------------------------------------------------------------------------*/
/* snooze briefly                                                             */
/*----------------------------------------------------------------------------*/
: snooze ( -- )

  C_1M thread::sleepNsec
;

/*----------------------------------------------------------------------------*/
/* put task into infinite snooze loop                                         */
/*----------------------------------------------------------------------------*/
: snoozeLoop

  begin
    "snoozing..." . snooze task::yield
  again
;

/*----------------------------------------------------------------------------*/
/* hello world                                                                */
/*----------------------------------------------------------------------------*/
: helloWorld

  "Hello World!" .
;

/*----------------------------------------------------------------------------*/
/* print arg                                                                  */
/*----------------------------------------------------------------------------*/
: printArg

  .
;

/*----------------------------------------------------------------------------*/
/* conver into into a string of digit names                                   */
/*----------------------------------------------------------------------------*/
: >digitWords ( i -- s )

  >str locals| sDecodeMe |

  "" "" 0 locals| iDigit sDigitName sDecodedTo |

  // loop for 0 to length of sDecodeMe - 1
  sDecodeMe str.length 0
  do
    // concat " " to end of decoded string
    I if sDecodedTo " " str.cat to sDecodedTo then

    // clip out digit I, convert it to a str
    1 I sDecodeMe str.sub >int >digitName to sDigitName

    // append digit name to the decoded string
    sDecodedTo sDigitName str.cat to sDecodedTo
  loop

  // return decode string
  sDecodedTo
;

/*----------------------------------------------------------------------------*/
/* formatted print                                                            */
/*----------------------------------------------------------------------------*/
: fmt.print

  str.format .
;

/*----------------------------------------------------------------------------*/
/* formatted print     https://en.wikipedia.org/wiki/Printf_format_string     */
/*----------------------------------------------------------------------------*/
: .printf

  str.format .
;

/*----------------------------------------------------------------------------*/
/* formatted put                                                              */
/*----------------------------------------------------------------------------*/
: fmt.put

  str.format .put
;

/*----------------------------------------------------------------------------*/
/* stack should have zero values                                              */
/*----------------------------------------------------------------------------*/
: assertStackDepthZero

  depth 0 == if exit_rt then

  task::this task.name@ "Stack of task %v has grown" fmt.print

  debug::trap
;

/*----------------------------------------------------------------------------*/
/* include a sub dir of sen files                                             */
/*----------------------------------------------------------------------------*/
: include-subdir

  params| sSubDir |

  0 locals| sFilePath |

  input.push

  args.senDir sSubDir str.cat dup

  "Would include .sen files from sub-dir %v" fmt.print

  dir::new locals| pSubDir |

  pSubDir dir.open if

    begin
      pSubDir dir.read
    while
      pSubDir dir.entryName "Entry %v" fmt.print

      4 pSubDir dir.entryName str.right ".sen" str.equal if
        pSubDir dir.entryName "Would parse %v" fmt.print

        args.senDir sSubDir str.cat
          "/" str.cat
          pSubDir dir.entryName str.cat
          to sFilePath
        sFilePath "Would open %v" fmt.print

        sFilePath input.open docol input.close

      then

    repeat

    pSubDir dir.close
  then

  pSubDir dir.delete

  input.pop

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
