/*============================================================================*/
/* job_subPurger.sen -- Job SubPurge                                          */
/*============================================================================*/

" job_SubPurger.sen" .verbose

/*----------------------------------------------------------------------------*/
/* subpurger logic                                                            */
/*----------------------------------------------------------------------------*/
: SubPurger_process ( pTable pJob_SubPurger -- )

  params| pJob_SubPurger pTable |

  locals| iSlot |

  pJob_SubPurger job_subPurger.begin not if exit then

  begin pTable pJob_SubPurger job_subPurger.chunk while repeat

  pJob_SubPurger job_subPurger.end

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the slot this sub purge is supposed to work on
  //pJob_SubPurger job_subPurger.slot@ to iSlot

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // purge table for iSlot
  //iSlot pTable table.purge
;

/*----------------------------------------------------------------------------*/
/* SubPurger (on each node)                                                   */
/*----------------------------------------------------------------------------*/
: SubPurger_run ( -- <R> )

  >>logEntry <SEED_RUN>

  0 0 locals| pJob_SubPurger pTask |
  0 0 locals| pTable sTableNm |
  0 0 locals| iPurgeJobId pJob_Purge |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_SubPurger

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  //DdlLock[].grabWrite

  // get purge job
  pJob_SubPurger job_subPurger.purgeJobId@ to iPurgeJobId
  pJob_SubPurger iPurgeJobId job::waitParticipant to pJob_Purge

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // first check if the job is executing SS_SEED_EXE
  // then get the task that is executing it
  begin
    pJob_Purge job.IsExecuting
  not while
    1 thread::sleepMsec
  repeat

  pJob_Purge job.task@ locals| pTask_Purge |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for acks to be set in the purge task
  begin
    pTask_Purge task.IsAckSet
  not while
    1 thread::sleepMsec
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  <tableNm> to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the table
  sTableNm find execute to pTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  pTable pJob_SubPurger SubPurger_process

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  popTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // notify the purge job
  pTask_Purge task.grabLock
  pTask_Purge task.dropLock
  pTask_Purge task.ack

  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
