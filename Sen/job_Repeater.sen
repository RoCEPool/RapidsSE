/*============================================================================*/
/* job_Repeater.sen -- Repeater Job                                           */
/*============================================================================*/

" job_Repeater.sen" .verbose

/*----------------------------------------------------------------------------*/
/* read chunks from input, write them to output                               */
/*----------------------------------------------------------------------------*/
: Repeater_process ( pJob_Repeater -- )

  params| pJob_Repeater |

  pJob_Repeater job_repeater.begin not if exit then

  begin pJob_Repeater job_repeater.chunk while repeat

  pJob_Repeater job_repeater.end
;

/*----------------------------------------------------------------------------*/
/* Job_Repeater request (on command node)                                     */
/*----------------------------------------------------------------------------*/
: Repeater_req (  -- <R> )

  >>logEntry <SEED_REQ2>

  job::this locals| pJob_Repeater |

  pJob_Repeater Repeater_process

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
