/*============================================================================*/
/* job_SubLoader.sen -- Job Table SubLoader                                   */
/*============================================================================*/

"job_SubLoader.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send working buffer to node                                                */
/*----------------------------------------------------------------------------*/
: SubLoader_sendBuffer ( bFinal pLoaderSub -- )

  params| pLoaderSub  |
  params| bFinal  |

  bFinal pLoaderSub loaderSub.spawnLoadBuffer
;

/*----------------------------------------------------------------------------*/
/* test for dangling buffers                                                  */
/*----------------------------------------------------------------------------*/
: SubLoader_testDangling ( pLoaderSub -- )

  params| pLoaderSub  |

  // calculate total partitions in the cluster
  grid::slots grid::nodes * locals| nTotalPartitions |

    // check for dangling buffers
    nTotalPartitions 0 do

    // set the partition we are using
    I pLoaderSub loaderSub.partition!

    // test for a dangling row buffer for parition I
    pLoaderSub loaderSub.workingBuffer@

    if
      I "DANGLING %v" fmt.print

      true pLoaderSub SubLoader_sendBuffer

    then

  loop
;

/*----------------------------------------------------------------------------*/
/* read records from file, create working buffers, send to node               */
/*----------------------------------------------------------------------------*/
: SubLoader_process ( pLoaderSub -- )

  params| pLoaderSub |

  begin pLoaderSub loaderSub.processRecords while

    false pLoaderSub SubLoader_sendBuffer

  repeat
;

/*----------------------------------------------------------------------------*/
/* SubLoader seed                                                             */
/*----------------------------------------------------------------------------*/
: SubLoader_seed ( -- )

  0 locals| pTask |
  0 locals| pJob_SubLoader  |
  0 locals| pLoaderSub  |

  tp: SubLoader

  "SubLoader running" .

  // get the task
  task::this to pTask

  // get the sub-loader job from the task
  pTask task.job@ to pJob_SubLoader

  // get the loaderSub object from the sub-loader job
  pJob_SubLoader job.ancilliary@ to pLoaderSub

  pLoaderSub loaderSub.begin

  pLoaderSub SubLoader_process

  pLoaderSub SubLoader_testDangling

  pLoaderSub loaderSub.end

  pJob_SubLoader <DONE_CHILD>

  // now delete the ended job
  pJob_SubLoader job.delete
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
