/*============================================================================*/
/* job_SubLoader.sen -- Job Table SubLoader                                   */
/*============================================================================*/

"job_SubLoader.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Job_SubLoader request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: SubLoader_req (  -- <R> )

  0 locals| pTask |
  0 locals| pJob  |

  tp: loadTable_req

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  "SubLoader_req running" .

  //pJob <DONE_REQUEST>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
