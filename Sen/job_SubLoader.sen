/*============================================================================*/
/* job_SubLoader.sen -- Job Table SubLoader                                   */
/*============================================================================*/

" job_SubLoader.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send working buffer to node                                                */
/*----------------------------------------------------------------------------*/
: SubLoader_sendBuffer ( bFinal pSubLoader -- )

  params| pSubLoader  |
  params| bFinal  |

bFinal pSubLoader job_loadBuffer::spawn
;

/*----------------------------------------------------------------------------*/
/* send working buffer to node                                                */
/*----------------------------------------------------------------------------*/
: SubLoader_sendBuffer2 ( bFinal pSubLoader -- )

  params| pSubLoader  |
  params| bFinal  |

  0 locals| pJobClass_LoadBuffer |
  0 locals| pJob_LoadBuffer |

  CN_JOB_LOADBUFFER jobClass::find to pJobClass_LoadBuffer

  nullptr pJobClass_LoadBuffer jobClass.new to pJob_LoadBuffer

  pJob_LoadBuffer SEED_RUN job.spawn
;

/*----------------------------------------------------------------------------*/
/* send last buffers to all partitions                                        */
/*----------------------------------------------------------------------------*/
: SubLoader_sendLast (  pSubLoader pJob_SubLoader -- )

  params| pJob_SubLoader |
  params| pSubLoader  |

  // calculate total partitions in the cluster
  grid::slots grid::nodes * locals| nTotalPartitions |

  // for all partitions
  nTotalPartitions 0 do

    //I "LAST BUFFER for partition %v" fmt.print

    // set the partition we are using
    I pJob_SubLoader job_subLoader.partition!

    // ensure there's a dangling buffer for partition I
    pSubLoader subLoader.danglingBuffer

    // send last buffer to node
    true pSubLoader SubLoader_sendBuffer

  loop
;

/*----------------------------------------------------------------------------*/
/* read records from file, create working buffers, send to node               */
/*----------------------------------------------------------------------------*/
: SubLoader_process (  pSubLoader pJob_SubLoader -- )

  params| pJob_SubLoader |
  params| pSubLoader |

  begin pSubLoader subLoader.processRecords while

    false pSubLoader SubLoader_sendBuffer

  repeat

  pSubLoader pJob_SubLoader SubLoader_sendLast
;

/*----------------------------------------------------------------------------*/
/* SubLoader seed                                                             */
/*----------------------------------------------------------------------------*/
: subLoader_run ( -- )

  <SEED_RUN>

  0 locals| pThisTask |
  0 locals| pJob_SubLoader |
  0 0 locals| pJobLoadTable_Originator pJobLoadTable_Participant |
  0 0 locals| pSubLoader iLoadTableJobId |

  tp: SubLoader
  //"SubLoader running" .

  // get the task
  task::this to pThisTask
  //pThisTask "subLoader_run task: %v" fmt.print

  // get the sub-loader job from the task
  pThisTask task.job@ to pJob_SubLoader

  // get the loaderSub object from the sub-loader job
  pJob_SubLoader job.ancilliary@ to pSubLoader

  pSubLoader subLoader.begin

  pSubLoader pJob_SubLoader SubLoader_process

  // get the job_loader from subLoader
  pJob_SubLoader job_subLoader.jobLoadTable@ to pJobLoadTable_Participant
  pJobLoadTable_Participant job.id@ to iLoadTableJobId

  // now find the job_loadTable again in origintor
  iLoadTableJobId job::findOriginator to pJobLoadTable_Originator

  // get the valid/invalid rows loaded from subloader
  //pSubLoader subLoader.recordsValid .
  pJob_SubLoader job_subLoader.recordsValid   pJobLoadTable_Originator job_loadTable.addValidRows
  pJob_SubLoader job_subLoader.recordsInvalid pJobLoadTable_Originator job_loadTable.addInvalidRows

  pSubLoader subLoader.end

  // now delete the ended job
  pJob_SubLoader job.delete

  // null the job in the task
  nullptr pThisTask task.job!

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
