/*============================================================================*/
/* job_SubLoader.sen -- Job Table SubLoader                                   */
/*============================================================================*/

" job_SubLoader.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send working buffer to node                                                */
/*----------------------------------------------------------------------------*/
: SubLoader_sendBuffer ( bFinal pJob_SubLoader -- )

  params| pJob_SubLoader |
  params| bFinal  |

  bFinal pJob_SubLoader job_writeBuffer::spawnLoad
;

/*----------------------------------------------------------------------------*/
/* send last buffers to all partitions                                        */
/*----------------------------------------------------------------------------*/
: SubLoader_sendLast (  pJob_SubLoader -- )

  params| pJob_SubLoader |

  // calculate total partitions in the cluster
  grid::slots grid::nodes * locals| nTotalPartitions |

  // examine the state of the working buffer set
  // nTotalPartitions 0 do
  //  I pJob_SubLoader job_subLoader.workingBuffer dup
  //  if workingBuffer.show else drop then
  // loop

  // for all partitions
  nTotalPartitions 0 do

    //I "LAST BUFFER for partition %v" fmt.print

    // set the partition we are using
    I pJob_SubLoader job_subLoader.partition!

    // ensure there's a dangling buffer for partition I
    pJob_SubLoader job_subLoader.danglingBuffer

    // send last buffer to node
    true pJob_SubLoader SubLoader_sendBuffer

  loop
;

/*----------------------------------------------------------------------------*/
/* read records from file, create working buffers, send to node               */
/*----------------------------------------------------------------------------*/
: SubLoader_process ( pJob_SubLoader -- )

  params| pJob_SubLoader |
  0 locals| pJobLoadTable_Participant |

  //begin pJob_SubLoader job_subLoader.processRecords while

  //  false pJob_SubLoader SubLoader_sendBuffer

  //repeat

  pJob_SubLoader job_subLoader.processRecords

  // get the job_loader from subLoader
  pJob_SubLoader job_subLoader.jobLoadTable@ to pJobLoadTable_Participant

  // get the valid/invalid rows loaded from subloader
  pJob_SubLoader job_subLoader.recordsInvalid pJobLoadTable_Participant job_loadTable.addInvalidRows

  pJob_SubLoader SubLoader_sendLast
;

/*----------------------------------------------------------------------------*/
/* SubLoader seed                                                             */
/*----------------------------------------------------------------------------*/
: subLoader_run ( -- )

  >>am <SEED_RUN>

  0 locals| pThisTask |
  0 locals| pJob_SubLoader |

  tp: SubLoader
  //"SubLoader running" .

  // get the task
  task::this to pThisTask
  //pThisTask "subLoader_run task: %v" fmt.print

  // get the sub-loader job from the task
  pThisTask task.job@ to pJob_SubLoader

  pJob_SubLoader job_subLoader.begin

  pJob_SubLoader SubLoader_process

  pJob_SubLoader job_subLoader.end

  // null the job in the task
  nullptr pThisTask task.job!

  // now delete the ended job
  pJob_SubLoader job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
