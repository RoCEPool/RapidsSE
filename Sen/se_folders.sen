/*============================================================================*/
/* se_folders.sen -- the set of folder related requests                       */
/*============================================================================*/

" se_folders.sen" .verbose


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


//
// create the root /tenants folder
//
:createTenantsFolder


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* create /tenants/boray/catalogs/rapidsse                                    */
/*----------------------------------------------------------------------------*/
: createDefaultFolders ( )

  assert::stack_0

  //tenants::new tenants.delete
  //dic::new dic.delete

  // push tenants folder
  //"tenants" find execute
  attachmap::tenants@ execute
  path[].push

    // create tenant boray (and catalogs sub-folder)
    "boray" "makeTenant" find execute

    // push boray folder
    "boray" findInCurrent execute
    path[].push

      // push catalogs folder
      "catalogs" findInCurrent execute
      path[].push

        // create catalog rapidsse (and schemas sub-folder)
        "rapidsse" "makeCatalog" find execute

          // push rapidsse folder
          "rapidsse" findInCurrent execute
          path[].push

          // push schemas folder
          "schemas" findInCurrent execute
          path[].push

          // create schema public (and tables sub-folder)
          "public" "makeSchema" find execute

          path[].discard
      path[].discard
    path[].discard
  path[].discard

  assert::stack_0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
