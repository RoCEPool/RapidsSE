/*============================================================================*/
/* se_folders.sen -- the set of folder related requests                       */
/*============================================================================*/

" se_folders.sen" .verbose

/*----------------------------------------------------------------------------*/
/* make a schema folder                                                       */
/*----------------------------------------------------------------------------*/
: :makeSchemaFolder ( "<schemaNm>" --  )
 

  params| sSchemaNm |

  args.tracepoint if
    sSchemaNm "MAKING SCHEMA " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make the schema
 sSchemaNm :createSchema ( ^schema )
 drop

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make tables folder
 sSchemaNm :makeTablesSubFolder
;

/*----------------------------------------------------------------------------*/
/* make a schemas folder under given named catalog                            */
/*----------------------------------------------------------------------------*/
: :makeSchemasFolder ( "<catalogNm>" -- )

  args.tracepoint if
    dup "MAKING SCHEMAS FOR CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "schemas"    ( dic "schemas" )
  swap         ( "schemas" dic )
  :makeSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* make a named catalog folder (run by participant)                           */
/*----------------------------------------------------------------------------*/
: :makeCatalogFolder ( "<catalogNm>" -- )


  params| sCatalogNm |

  args.tracepoint if
   sCatalogNm "MAKING CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the catalog
  sCatalogNm :createCatalog ( ^catalog )
  drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make schemas folder
  sCatalogNm :makeSchemasFolder ( )
;

/*----------------------------------------------------------------------------*/
/* make a catalogs folder under given named tenant                            */
/*----------------------------------------------------------------------------*/
: :makeCatalogsFolder ( "<tenantNm>" -- )

  args.tracepoint if
    dup "MAKING CATALOGS FOR TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "catalogs"   ( dic "catalogs" )
  swap         ( "catalogs" dic )
  :makeSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* make a tenant folder (run by participant)                                  */
/*----------------------------------------------------------------------------*/
: :makeTenantFolder ( "<tenantNm>" -- )


  params| sTenantNm |

  args.tracepoint if
    sTenantNm "MAKING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the tenant
  sTenantNm :createTenant ( ^tenant )
  drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make catalogs folder
  sTenantNm :makeCatalogsFolder ( )
;

/*----------------------------------------------------------------------------*/
/* make /tenants/boray/catalogs/rapidsse/schemas/public/tables                */
/*----------------------------------------------------------------------------*/
: makeDefaultFolders ( )

  assert::stack_0

  // make the tenants root folder
  "tenants" :makeFolder attachMap::tenants!

  attachmap::tenants@ execute
  path[].pushFolder

    // make tenant folder:
    //  /tenants/boray
    //  /tenants/boray/catalogs
    "boray" :makeTenantFolder

    "boray" folder[].findSymbol execute
    path[].pushFolder

      "catalogs" folder[].findSymbol execute
      path[].pushFolder

        // make catalog folder:
        //  /tenants/boray/catalogs/rapidsse
        //  /tenants/boray/catalogs/rapidsse/schemas
        "rapidsse" :makeCatalogFolder

          "rapidsse" folder[].findSymbol execute
          path[].pushFolder

            "schemas" folder[].findSymbol execute
            path[].pushFolder

              // make schema folder:
              //  /tenants/boray/catalogs/rapidsse/schemas/public
              //  /tenants/boray/catalogs/rapidsse/schemas/public/tables
              "public" :makeSchemaFolder

            path[].discard
        path[].discard
      path[].discard
    path[].discard

  assert::stack_0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
