/*============================================================================*/
/* se_path.sen -- dictionary related words                                    */
/*============================================================================*/

" se_path.sen" .verbose

/*----------------------------------------------------------------------------*/
/* drop all folders from path stack                                           */
/*----------------------------------------------------------------------------*/
: path[].discardFolderAll ( -- )

  path[].depth 0 ?do
    path[].discardFolder
  loop
;

/*----------------------------------------------------------------------------*/
/* set path from string vector                                                */
/*----------------------------------------------------------------------------*/
: path[].set ( ... #dics -- )

  // this word puts the folder path on the stack into task dictionary stack
  // ( ... "<subFolderC>"  "<subFolderB>"  "<subFolderA>" "main" 4 )


  path[].discardFolderAll

  dup not if drop exit_rt then

  0 do

    // dup "path[].set %v" .printf

    dup "__dicRoot" str.equal if
      drop
      dic::root
      path[].pushFolder
    else

      dup "session" str.equal if
        drop
      else

        dup "tenants" str.equal if
          drop attachmap::tenants@ execute path[].pushFolder
        else

          find
          execute
          path[].pushFolder
        then

      then

    then

  loop
;

/*----------------------------------------------------------------------------*/
/* get current folder path as string                                          */
/*----------------------------------------------------------------------------*/
: path[].toStr ( -- s )

  "/"

  // iterate thru each folder in path and concat to end
  path[].depth 0 ?do

    I if "/" str.cat then

    // compute the path subscript
    //path[].depth 1 - I -
    I

    // pick the path, get its name and concat name to working string
    path[].pick dic.name str.cat

  loop
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: word.isFolder params| pWord |

  pWord not if EC_NO_SUCH_FOLDER false exit_rt then

  pWord word.category@ find: \folder eql if true exit_rt then

  EC_NOT_A_FOLDER false
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
