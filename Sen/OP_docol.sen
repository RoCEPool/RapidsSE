/*============================================================================*/
/* OP_docol.sen -- Operator docol                                             */
/*============================================================================*/

" OP_docol.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: docol_action

  <routineNm>
  >interpret

  begin
    depth while discard
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: docol :: docol <routineNm> ;

: docol _cmdTags tagCopy: localLiteOp_cmdTags
  tags{
    <jobDesc>     = "--description of operator--"
    <localLiteOp> = true
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
