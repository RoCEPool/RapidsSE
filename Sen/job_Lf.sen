/*============================================================================*/
/* job_Lf.sen -- Job list folder                                              */
/*============================================================================*/

" job_Lf.sen" .verbose

/*----------------------------------------------------------------------------*/
/* list folders requests (on originating node)                                */
/*----------------------------------------------------------------------------*/
: lf_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 0 locals| iCount pJob_Lf pTask |

  tp: lf_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_Lf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_Lf getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab ddl read lock
  ddlLock::grabRead

  args.metadata if
    "(name VARCHAR, type VARCHAR)" pJob_Lf job.metadata!
  then

  ""
  pathDepth 1 - pathPick dic.lastWord dup iterate
  1 iCount + to iCount
  "row: ('" str.cat

  object@ word.name str.cat

  "', " str.cat

  object@ isTable if
    "'table'" str.cat
  then

  object@ isIndex if
    "'index'" str.cat
  then

  object@ isFolder if
    "'" str.cat
    object@ execute dic.kind@ word.name str.cat
    "'" str.cat
  then

  iCount if
    ")\n" str.cat
  then

  object@ word.prev object!

  next

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set response in job
  grid::thisNode@ pJob_Lf job.response!
  iCount grid::thisNode@ pJob_Lf job.rowsProcessed!

  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
