/*============================================================================*/
/* job_Lf.sen -- Job list folder                                              */
/*============================================================================*/

"job_Lf.sen" .verbose

/*----------------------------------------------------------------------------*/
/* list folders requests (on originating node)                                */
/*----------------------------------------------------------------------------*/
: lf_req ( -- <R> )

  0 0 0 locals| iCount pJob_Lf pTask |

  tp: lf_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_Lf

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_Lf getPathR35
  dicStack.set

  args.metadata if
    "(name VARCHAR, type VARCHAR)" pJob_Lf job.metadata!
  then

  ""
  0 pathPick dic.lastWord dup iterate
  1 iCount + to iCount
  "row: ('" str.cat

  object@ word.name str.cat

  "', " str.cat

  object@ isTable if
    "'table'" str.cat
  then

  object@ isIndex if
    "'index'" str.cat
  then

  object@ isFolder if
    "'" str.cat
    object@ execute dic.kind@ word.name str.cat
    "'" str.cat
  then

  iCount if
    ")\n" str.cat
  then

  object@ word.prev object!

  next

  iCount task::this task.seitf@ seitf.rowsProcessed

  grid::thisNode@ pJob_Lf job.response!
  1 grid::thisNode@ pJob_Lf job.rowsProcessed!

  pJob_Lf <DONE_REQUEST>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
