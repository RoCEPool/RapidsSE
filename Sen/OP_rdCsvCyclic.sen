/*============================================================================*/
/* OP_rdCsvCyclic.sen -- read csv cyclically                                  */
/*============================================================================*/

" OP_rdCsvCyclic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: rdCsvCyclic_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: rdCsvCyclic_PulseMarker \handler

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: rdCsvCyclic_CsvBuffer \handler

  ZK_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: rdCsvCyclic_EosMarker \handler

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* rdCsvCyclic request                                                  SPAWN */
/*----------------------------------------------------------------------------*/
: rdCsvCyclic_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: rdCsvCyclic_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: rdCsvCyclic_EosMarker   ZK_EOSMARKER   op[].handler!
  find: rdCsvCyclic_PulseMarker ZK_PULSEMARKER op[].handler!
  find: rdCsvCyclic_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rdCsvCyclic :: rdCsvCyclic ;

: rdCsvCyclic _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
