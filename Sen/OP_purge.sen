/*============================================================================*/
/* OP_purge.sen -- Operator purge                                             */
/*============================================================================*/

" OP_purge.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: Purge_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // PURGE
  tablePtn[].get tablePtnGrabWrite2
  tablePtn[].purge
  tablePtn[].get tablePtnDropWrite2
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: Purge_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
  else

    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  true

;


/*----------------------------------------------------------------------------*/
/* Purge request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: Purge_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: Purge_PulseMarker ZK_PULSEMARKER op[].handler!
  find: Purge_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: Purge :: Purge <tableNm> ;

: Purge opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
