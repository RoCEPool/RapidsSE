/*============================================================================*/
/* column.sen -- column related words                                         */
/*============================================================================*/

"column.sen" .verbose

: column: ;

: makeColumns ( "<tableNm>" -- )

  find execute ( dic )
  table.subDic pathPush "columns" :dic drop pathDrop
;

: withinColumns
    0 pathPick dic.name "columns" str.equal
;

: checkInColumns
    withinColumns if true exit then
    EC_NOT_IN_COLUMNS false
;

: pushColumns ( -- )

    "columns" checkIsWord

    not if EC_NO_COLUMNS_DIC false exit then

    execute pathPush

    true
;

: popColumns
    pathDrop
;

: :column ( "<columnType>" "<columnName>" )

    :constant
;

: checkAddColumn ( "<columnName>" "<tableNm>" -- true | eEC false )

  locals| tableNm columnNm |

  tableNm checkInTable not if false exit then

  tableNm
  pushTableSub   assert // not if false exit then

  columnNm
  pushColumns assert // not if false exit then

  // column should not already exist
  findInCurrent
  if EC_DUPLICATE_COLUMN false popColumns popTable exit then

  popColumns

  popTableSub

  true
;

/*----------------------------------------------------------------------------*/
/* list columns of a table                                                    */
/*----------------------------------------------------------------------------*/
: listColumns ( -- )

  pushTableSub  assert
  pushColumns   assert

  ""                             // initial ls string
  0 pathPick dic.lastWord            // get last word of current dic
  dup                            // setup iteration of words
  iterate                        //

    object@ word.name            // column name

    " " str.cat
    object@ execute str.cat       // column type

    swap

    dup str.length
    if " , " str.prepend then     //

    str.cat                       // append column to ls

    object@ word.prev object!     // step backwards thru words

  next                            //

  //"\n" str.cat

  popColumns
  popTableSub
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* add a column (run by all participants)                                     */
/*----------------------------------------------------------------------------*/
: addColumn allParticipants 3 checkResult ( "<columnType>" "<columnNm>" "<tableNm>" -- <result> )

  args.tracepoint if
    dup "ADDING COLUMN " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  tp: addingColumn
  pushTableSub   assert // not if false exit then

  pushColumns assert // not if false exit then

  :column

  popColumns

  popTableSub

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* create the column vector of the table                                      */
/*----------------------------------------------------------------------------*/
: columnVecTable allParticipants 1 checkResult ( "<tableNm>" -- true n# true )

  0 locals| tablePtr tableNm |

  //"columnVecTable" . tableNm .

  // get table ptr
  tableNm find execute to tablePtr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // double check we can see the table
  //tableNm find execute stk drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // push the table sub dic and then the columns sub dic
  tableNm pushTableSub  assert
  pushColumns assert

  // double check the path
  //task.this task.dicStack dicPath.dump

  // iterate contents of columns dictionary 
  0 pathPick dic.lastWord dup
  iterate                        // iterate word cursor
    object@ execute              ( value )
    object@ word.name            ( value wordNm )
    tablePtr                     ( value wordNm ^table )
    //stk
    table.createColumnVec
    object@ word.prev object!    // advance cursor backwards thru words
  next

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  tablePtr table.showColumnVec

  assert.stack_0

  popColumns

  popTableSub

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
