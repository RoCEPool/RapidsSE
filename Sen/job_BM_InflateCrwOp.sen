/*============================================================================*/
/* job_BM_InflateCrwOp.sen -- Job BM_InfrlateCrwOp                            */
/*============================================================================*/

" job_BM_InflateCrwOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerNew
  
  timer::new    to timer[]
  aggTimer::new to aggTimer[]
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerBegin
  
  timer[] timer.start
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerUpdate
  
  timer[] timer.update

  timer[] timer.ticks aggTimer[] aggTimer.add
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_Report

  Operand[].newCsvBuffer
  Operand[].report

  // csv report for bm_insidx
  aggTimer[] aggTimer.reportStr
    "BM_InsIdx,Elapsed Time,%v\n" str.format Operand[].csvAppend

  counter0[].get
    "BM_InsIdx,Number of EntBuffers,%v\n" str.format Operand[].csvAppend

  counter1[].get
    "BM_InsIdx,Total Number of Entries,%v\n" str.format Operand[].csvAppend

  aggTimer[] aggTimer.nanosecs counter1[].get /
    "BM_InsIdx,Average Time per Entry,%vns\n" str.format Operand[].csvAppend
  
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_CrwBuffer

  "BM_InflateCrw_CrwBuffer" .

  // get table partition for current partition
  table[].tablePtn@ to tablePtn[]

  BM_TimerBegin

  // Inflate the entries from the crwBuffer
  //   NB: registers are available in the step!!
  //tablePtn[].inflateCrwBuffer // <- focal pt of bm
  //  counter1[] + to counter1[]

  counter0[] 1 + to counter0[]

  BM_TimerUpdate

  Operand[].delete
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_EosMarker

  Operand[].delete

  BM_InflateCrwOp_Report

  Operand[].newEosMarker
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_StartMarker

  // table folder push
  op__table

  folderPath.str "Folder path: %v" .printf

  BM_TimerNew

  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* execute for BM_InflateCrwOp                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_req ( -- )
 
  >>logEntry <SEED_REQ>

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

    ZK_CRWBUFFER   of BM_InflateCrwOp_CrwBuffer   true endof

    ZK_EOSMARKER   of BM_InflateCrwOp_EosMarker   true endof

    ZK_STARTMARKER of BM_InflateCrwOp_StartMarker true endof

    jobOperand::generic swap

    endcase

  while assert::stack_0 repeat

  "*** BM_InsIdxOp EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: BM_InflateCrwOp :: BM_InflateCrwOp <tableNm> <topology> <nextStage> <nextOp> ;

jobInfo: BM_InflateCrwOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
