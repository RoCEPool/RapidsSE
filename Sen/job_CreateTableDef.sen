/*============================================================================*/
/* job_CreateTableDef.sen -- Job Create Table Definition                      */
/*============================================================================*/

" job_CreateTableDef.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a creatable table                                    */
/*----------------------------------------------------------------------------*/
: createTableDef::checkCreate ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then
  
  // error if given name already exists
  <tableNm> check::nameIsUnknownTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* create table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: createTableDef::createNamedTbl

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse cmd and create table definition

  <cmd> job[] tableDef::parse locals| pTableDef |

  // check for error while parsing tabledef
  job[] job.hasError if
    DdlLock[].testDrop
    !!logError
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  pTableDef <tableNm> table::createTable locals| pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* check resources for Job_CreateTableDef                                     */
/*----------------------------------------------------------------------------*/
: createTableDef::checkResources

  // grab the ddl lock
  DdlLock[].grabRead

  // check there are enough buffers
  node::checkEnoughBuffers not if ( errorCode )
    job::error!
    !!logError
    exit
  then

  // check ok to create table
  createTableDef::checkCreate not if ( errorCode )
    job::error!
    !!logError
    exit
  then

  // drop the ddl lock
  //DdlLock[].dropRead
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTableDef on origin                                       */
/*----------------------------------------------------------------------------*/
: createTableDef_req _eeh ( -- )

  // check create table syntax
  <cmd> TableDef::syntax dup EC_NONE != if  ( errorCode )
    job::error!
    !!logError
  else
    discard
  then

  createTableDef::checkResources

  // should be in tables
  folder[].isTables assert

  // create the table
  createTableDef::createNamedTbl

  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/*                              - Definition -                                */
/*----------------------------------------------------------------------------*/
cmdSyntax: createTableDef :: create _table definition <tableNm> etc ;

: createTableDef _cmdTags tags{
  <cmdDesc>  = "--cmd desc for job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_JOB_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
