/*============================================================================*/
/* OP_etcTest.sen -- etc test operator                                        */
/*============================================================================*/

" OP_etcTest" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: etcTest_DataMarker \handler

  //"Operand:- ZK_DATAPULSE" .verbose
  PipeIn[].pipeOut
  <etc> <arg2> <arg1> "etcTest : arg1 = %v arg2 = %v etc = %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/* etcTest request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: etcTest_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: etcTest_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: etcTest :: etcTest <arg1> <arg2> <etc> ;

: etcTest _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>     = "--desc for op--"
  }
;
    

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
