/*============================================================================*/
/* OP_etcTest.sen -- etc test operator                                        */
/*============================================================================*/

" OP_etc" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: etcTest_action

  <arg1> "etcTest : arg1 = %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: etcTest :: etcTest <arg1> ;

: etcTest _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
