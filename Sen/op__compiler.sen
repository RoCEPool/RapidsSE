/*============================================================================*/
/* op__compiler.sen -- operator compiler words                                */
/*============================================================================*/

" op__compiler.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: opSyntax:

  // create a word using next token from input source as the word name

  input::next locals| sOpNm |

  sOpNm series-name "_syntax" str.cat :create

  // set the word category to be jobSyntax
  //[ compiler::current@ , ] compiler::current@ word.category!
  find: jobSyntax: compiler::current@ word.category!

  // attach an ename set to the word being created
  tagSet::new locals| pTagSet |

  pTagSet compiler::current@ word.TagSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__name__" sOpNm
    pTagSet tagSet.appendStr

  // skip the :: token from input source
  input::next discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__job__" "CN_JOB_UNIVERSAL"
  pTagSet tagSet.appendStr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till ';', build ename set representing the syntax
  begin
    input::next
    dup ";" str.equal not
    while

      dup str.isMetaToken if
        // dup "%v is a meta token" .printf
        // add ("*",meta,TN_STRING) in ename set
        "__meta__" swap pTagSet tagSet.appendStr

      else dup str.isJsonToken if
        // dup "%v is a json token" .printf
        // add ("*",json,TN_STRING) in ename set
        "__json__" swap pTagSet tagSet.appendStr

      else dup "__etc__" str.equal if
        "__etc__"  swap pTagSet tagSet.appendStr

      else
        // dup "%v is a normal token" .printf
        // add (word,"",TN_STRING) in ename set
        dup pTagSet tagSet.appendStr

      then then then
  repeat

  // discard the ";" from dstack
  discard

  // pTagSet tagSet.asStr .

  does>
    // ..to be written
    discard
;



/*----------------------------------------------------------------------------*/
/* the op info compiler                                                       */
/*----------------------------------------------------------------------------*/
: opInfo:

  0 0 0 0 locals| pWord sEname sEvalue pTagSet |

  // create a word using next token from input source as the word name
  input::next "_info" str.cat :create

  compiler::current@ to pWord

  // set the word kind to be jobClass
  //[ compiler::current@ , ] compiler::current@ word.category!
  [ compiler::current@ encode::push ] pWord word.category!

  // attach an ename set to the word being created
  tagSet::new to pTagSet

  pTagSet pWord word.TagSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<jobNm>" pWord word.name_trunc pTagSet tagSet.insertStr

  // skip the "{" token from input source
  input::next discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    input::next
    dup "}" str.equal not
  while
    to sEname
    input::next discard
    input::next to sEvalue
    sEname sEvalue pWord jobInfo::addEname
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // discard the "}" from dstack
  discard

  // get and discard ";"
  input::next discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // complete the ename-set

  pWord fillOut.tagSet_ofInfoWord

  //pTagSet tagSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* the op info compiler                                                       */
/*----------------------------------------------------------------------------*/
: opInfo immediate

  0 0 0 0 locals| pWord sEname sEvalue pTagSet |

  compiler::current@ to pWord

  // set the name of the word to be _info
  pWord word.name@
    "_info" str.cat
    pWord word.name!

  // set the word category to be opInfo
  find: opInfo pWord word.category!

  // attach an ename set to the word being created
  tagSet::new to pTagSet
    pTagSet pWord word.TagSet!

  // add <jobNm> tag
  "<jobNm>" pWord word.name_trunc pTagSet tagSet.insertStr

  pWord encode::call
    POSTPONE word.tagSet@

  //does>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* complete the info for all ops                                              */
/*----------------------------------------------------------------------------*/
: fillOut::ops

  find: opInfo locals| pOpInfo |

  // iterate thru all opSynatx: words

  dic::root dic.lastWord dup
  iterate                                // iterate word cursor

    object@ word.category@ pOpInfo eql if
      // object@ word.dump
      // object@ word.tagSet@ tagSet.asStr .

      object@ word.name@ "Filling out: %v" .printf
      
      object@ fillOut.tagSet_ofInfoWord  // fill out the tag set of the op
    then

    object@ word.prev object!            // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: wordCats prompt

  0 0 locals| pWord pCatg |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor

    object@ to pWord

    pWord word.show

    object@ word.prev object!             // advance cursor backwards thru words
  next
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
