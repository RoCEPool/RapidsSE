/*============================================================================*/
/* op__compiler.sen -- operator compiler words                                */
/*============================================================================*/

" op__compiler.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the op syntax definer. creates a syntax definition for an operator cmd     */
/*----------------------------------------------------------------------------*/

: opSyntax:

  jobSyntax:
;

/*----------------------------------------------------------------------------*/
/* promote current word to be an _info word                                   */
/*----------------------------------------------------------------------------*/
: _info immediate

  compiler::current@ locals| pWord |

  // set the name of the word to be _info
  pWord word.name@
    "_info" str.cat
    pWord word.name!

  // set the word category to be _info
  find: _info pWord word.category!

  // attach an ename set to the word being created
  tagSet::new locals| pWordTagSet |
  pWordTagSet pWord word.TagSet!

  // add <jobNm> tag
  "<jobNm>" pWord word.name_trunc pWordTagSet tagSet.insertStr

  pWord encode::call
    POSTPONE word.tagSet@

  //does>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_all_cmd

  find: _info locals| pOpInfo |

  // iterate thru all pOpInfo words

  dic::root dic.lastWord dup
  iterate                                // iterate word cursor

    object@ word.category@ pOpInfo eql if
      // object@ word.dump
      // object@ word.tagSet@ tagSet.asStr .

      object@ word.name@ "Filling out: %v" .printf
      
      object@ cmd::fillOut_a_cmd  // fill out the tag set of the op
    then

    object@ word.prev object!            // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: wordCats prompt

  0 0 locals| pWord pCatg |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor

    object@ to pWord

    pWord word.show

    object@ word.prev object!             // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/* show all words that of given catg                                          */
/*----------------------------------------------------------------------------*/
: wordsOf params| pCatg |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor

    object@ locals| pWord |

    pWord word.category@ pCatg eql if
      pWord word.show
    then

    object@ word.prev object!             // advance cursor backwards thru words
  next
;



/*----------------------------------------------------------------------------*/
/* show all words that are of _info                                         */
/*----------------------------------------------------------------------------*/
: opInfos prompt

  find: _info wordsof
;

/*----------------------------------------------------------------------------*/
/* show all words that are of jobSyntax:                                      */
/*----------------------------------------------------------------------------*/
: jobSyntaxs prompt

  find: jobSyntax: wordsof
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
