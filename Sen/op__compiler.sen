/*============================================================================*/
/* op__compiler.sen -- operator compiler words                                */
/*============================================================================*/

" op__compiler.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the op syntax definer. creates a syntax definition for an operator cmd     */
/*----------------------------------------------------------------------------*/
: opSyntax:

  // create a word using next token from input source as the word name

  input::next locals| sOpNm |

  sOpNm series-name-op "_syntax" str.cat :create

  // set the word category to be jobSyntax
//find: opSyntax:                     compiler::current@ word.category!
  [ compiler::current@ encode::push ] compiler::current@ word.category!

  // attach  tag set to hold syntax to the word being created
  tagSet::new locals| pSynTags |

  pSynTags compiler::current@ word.TagSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__name__" sOpNm pSynTags tagSet.appendStr

  // skip the :: token from input source
  input::next discard

  "__job__" "CN_JOB_UNIVERSAL"
  pSynTags tagSet.appendStr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till ';', building tag set representing the syntax

  begin

    input::next
    dup ";" str.equal not
    while

      dup str.isMetaToken if
         "__meta__" swap pSynTags tagSet.appendStr

      else dup str.isJsonToken if
        "__json__" swap pSynTags tagSet.appendStr

      else dup "__etc__" str.equal if
        "__etc__"  swap pSynTags tagSet.appendStr

      else
        dup pSynTags tagSet.appendStr

      then then then
  repeat

  // discard the ";" from dstack
  discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // pTagSet tagSet.asStr .

  does>
    // ..to be written
    discard
;

/*----------------------------------------------------------------------------*/
/* promote current word to be an _info word                                   */
/*----------------------------------------------------------------------------*/
: _info immediate

  compiler::current@ locals| pWord |

  // set the name of the word to be _info
  pWord word.name@
    "_info" str.cat
    pWord word.name!

  // set the word category to be _info
  find: _info pWord word.category!

  // attach an ename set to the word being created
  tagSet::new locals| pWordTagSet |
  pWordTagSet pWord word.TagSet!

  // add <jobNm> tag
  "<jobNm>" pWord word.name_trunc pWordTagSet tagSet.insertStr

  pWord encode::call
    POSTPONE word.tagSet@

  //does>
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_all_cmd

  find: _info locals| pOpInfo |

  // iterate thru all pOpInfo words

  dic::root dic.lastWord dup
  iterate                                // iterate word cursor

    object@ word.category@ pOpInfo eql if
      // object@ word.dump
      // object@ word.tagSet@ tagSet.asStr .

      object@ word.name@ "Filling out: %v" .printf
      
      object@ cmd::fillOut_a_cmd  // fill out the tag set of the op
    then

    object@ word.prev object!            // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: wordCats prompt

  0 0 locals| pWord pCatg |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor

    object@ to pWord

    pWord word.show

    object@ word.prev object!             // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/* show all words that of given catg                                          */
/*----------------------------------------------------------------------------*/
: wordsOf params| pCatg |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor

    object@ locals| pWord |

    pWord word.category@ pCatg eql if
      pWord word.show
    then

    object@ word.prev object!             // advance cursor backwards thru words
  next
;



/*----------------------------------------------------------------------------*/
/* show all words that are of _info                                         */
/*----------------------------------------------------------------------------*/
: opInfos prompt

  find: _info wordsof
;

/*----------------------------------------------------------------------------*/
/* show all words that are of jobSyntax:                                      */
/*----------------------------------------------------------------------------*/
: jobSyntaxs prompt

  find: jobSyntax: wordsof
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
