/*============================================================================*/
/* vocab_word.sen -- additional word related words                          */
/*============================================================================*/

" vocab_word.sen" .verbose

/*----------------------------------------------------------------------------*/
/* return word name with any suffix removed                                   */
/*----------------------------------------------------------------------------*/
: word.name_trunc params| pWord |

  "_" pWord word.name@ str.removeSuffix
;

/*----------------------------------------------------------------------------*/
/* list all words in the current dictionary                                   */
/*----------------------------------------------------------------------------*/
: words prompt

  //folder[] dic.lastWord dup
  dic::root dic.lastWord dup
  iterate                        // iterate word cursor
    object@ word.name@ .         // print the name of the word
    object@ word.prev object!    // advance cursor backwards thru words
  next
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
