/*============================================================================*/
/* writeOp.sen -- write rows to file operator                                 */
/*============================================================================*/

"writeOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* open file for writing                                                      */
/*----------------------------------------------------------------------------*/
: writeOpenFile ( -- )

  ": writeOpenFile" .
;

/*----------------------------------------------------------------------------*/
/* close file for writing                                                     */
/*----------------------------------------------------------------------------*/
: writeCloseFile ( -- )

  ": writeCloseFile" .

  // drop dummy plan
  drop ( rb )
;

/*----------------------------------------------------------------------------*/
/* write row buffer to file                                                   */
/*----------------------------------------------------------------------------*/
: writeToFile ( rb plan -- )

  ": writeToFile" .

  // drop dummy plan
  drop ( rb )

  // declare rowCrs variable
  rowCursor.new locals| rowCrs |

  // set row bufferin cursor
  rowCrs rowCursor.rowBuffer!

  // iterate the row buffer
  rowCrs rowCursor.first
  begin while
    rowCrs rowCursor.row .
    rowCrs rowCursor.next
  repeat
;

/*----------------------------------------------------------------------------*/
/* file write                                                                 */
/*----------------------------------------------------------------------------*/
: writeOp operator ( -- NEVER )

  ": writeOp" .

  false locals| fileOpen |

  begin

    jobQueue> ( valset )

    valset> ( rowBuffer nValues )

    drop ( rowBuffer )

    fileOpen not if
      writeOpenFile
      true to fileOpen
    then

    if
      writeToFile
    else
      writeCloseFile
      false to fileOpen
    then

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
