/*============================================================================*/
/* writeOp.sen -- write rows to file operator                                 */
/*============================================================================*/

"writeOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* file write                                                                 */
/*----------------------------------------------------------------------------*/
: writeOp operator

  "writeOp" .

  //999999 thread.sleep_s

  begin

    jobQueue> ( valset )

    valset> ( rowBuffer nValues )

    drop ( rowBuffer )

    stk drop

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
