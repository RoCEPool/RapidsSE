/*============================================================================*/
/* writeOp.sen -- write rows to file operator                                 */
/*============================================================================*/

"writeOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* file write                                                                 */
/*----------------------------------------------------------------------------*/
: writeOp operator

/*
  // set path
  "tables" "tpchSchema" "schemas" "rapidsse" "catalogs" "boray" "tenants" 7 dicPath.set

  // dump path
  pathDump

  selCursor.new locals| rowCrs |

  "part" rowCrs selCursor.table!

  0 rowCrs selCursor.begin


  rowCrs selCursor.end
*/

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
