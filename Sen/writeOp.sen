/*============================================================================*/
/* writeOp.sen -- write rows to file operator                                 */
/*============================================================================*/

"writeOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* plan common variables for write                                            */
/*----------------------------------------------------------------------------*/
common/ write filePointer /

/*----------------------------------------------------------------------------*/
/* open file for writing                                                      */
/*----------------------------------------------------------------------------*/
: writeOpenFile subDic write ( plan -- )

  ": writeOpenFile" .

  locals| thePlan  |

  // open new file?
  filePointer not if

    // get file name
    thePlan plan.dic task.this task.dicStack dicPath.push
    $$fileNm@@ dup .
    task.this task.dicStack dicPath.drop

    // create a file pointer
    file.new toCommon filePointer

    // set file path
    filePointer file.path!

    // open file for writing
    OPEN_READ_WRITE_CREATE filePointer file.open
    false == if
      0 toCommon filePointer
      filePointer file.delete EC_INVALID_FILE
    else
      ": writeOpenFile opened file" .
      EC_NONE
    then

  else
    // nothing to do, file already open
    EC_NONE

  then

;

/*----------------------------------------------------------------------------*/
/* close file for writing                                                     */
/*----------------------------------------------------------------------------*/
: writeCloseFile subDic write ( -- )

  ": writeCloseFile" .

  filePointer file.close
  filePointer file.delete

  0 toCommon filePointer
;

/*----------------------------------------------------------------------------*/
/* sink plan                                                                  */
/*----------------------------------------------------------------------------*/
: writePipeSink ( <<job>> -- )

  ": writePipeSink" .

  "sinkOp.task" find execute >jobqueue
;

/*----------------------------------------------------------------------------*/
/* write row buffer to file                                                   */
/*----------------------------------------------------------------------------*/
: writeToFile subDic write ( rowBuffer -- )

  ": writeToFile" .

  // declare rowCrs variable
  rowCursor.new locals| rowCrs |

  // set row buffer in cursor
  rowCrs rowCursor.rowBuffer!

  // iterate the row buffer
  rowCrs rowCursor.first
  begin while
    rowCrs rowCursor.row
    filePointer file.write
    rowCrs rowCursor.next
  repeat

;

/*----------------------------------------------------------------------------*/
/* file write                                                                 */
/*----------------------------------------------------------------------------*/
: writeOp operator subDic write ( -- NEVER )

  ": writeOp" .

  0 0 locals| thePlan profile |

  begin

    // get next job
    jobQueue> ( valset )

    // unpack it
    valset> ( [ rowBuffer ] flag profile plan nValues )
    drop    ( [ rowBuffer ] flag profile plan )

    // save the plan and profile
    to thePlan ( rowBuffer flag profile )
    to profile ( rowBuffer flag )

    // push the reg frame for this writeOp
    profile thePlan plan.regFrame? common.push

    // open the file
    thePlan writeOpenFile ( plan [ rowBuffer ] )

    // did we manage to open the file ?
    dup EC_NONE != if ( [ rowBuffer ] EC )

      // got an error
      error.msg .
      if ( [ rowBuffer ] )
        drop
      else
        thePlan writePipeSink
      then

    else

      drop ( [ rowBuffer ] )

      // write or close file & sink plan?
      if ( [ rowBuffer ] )
        writeToFile
      else
        writeCloseFile
        << profile thePlan >> writePipeSink
      then

    then

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
