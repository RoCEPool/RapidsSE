/*============================================================================*/
/* writeOp.sen -- write rows to file operator                                 */
/*============================================================================*/

"writeOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* open file for writing                                                      */
/*----------------------------------------------------------------------------*/
: writeOpenFile ( -- )

  ": writeOpenFile" .
;

/*----------------------------------------------------------------------------*/
/* close file for writing                                                     */
/*----------------------------------------------------------------------------*/
: writeCloseFile ( -- )

  ": writeCloseFile" .
;

/*----------------------------------------------------------------------------*/
/* sink plan                                                                  */
/*----------------------------------------------------------------------------*/
: writePipeSink ( plan -- )

  ": writePipeSink" .

  $$ swap $$>valset // << plan >>
  "sinkOp.task" find execute >jobqueue
;

/*----------------------------------------------------------------------------*/
/* write row buffer to file                                                   */
/*----------------------------------------------------------------------------*/
: writeToFile ( rowBuffer -- )

  ": writeToFile" .

  // declare rowCrs variable
  rowCursor.new locals| rowCrs |

  // set row bufferin cursor
  rowCrs rowCursor.rowBuffer!

  // iterate the row buffer
  rowCrs rowCursor.first
  begin while
    rowCrs rowCursor.row .
    rowCrs rowCursor.next
  repeat
;

/*----------------------------------------------------------------------------*/
/* file write                                                                 */
/*----------------------------------------------------------------------------*/
: writeOp operator ( -- NEVER )

  ": writeOp" .

  false locals| fileOpen |
  0     locals| thePlan  |

  begin

    // get next job
    jobQueue> ( valset )

    // unpack it
    valset> ( [ rowBuffer ] flag plan nValues )
    drop    ( [ rowBuffer ] flag plan )

    // save the plan
    to thePlan ( rowBuffer flag )

    // open new file?
    fileOpen not if ( [ rowBuffer ] flag )
      writeOpenFile
      true to fileOpen
    then

    // write or close file & sink plan?
    if ( [ rowBuffer ] )
      writeToFile
    else
      writeCloseFile
      false to fileOpen

      thePlan writePipeSink
    then

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
