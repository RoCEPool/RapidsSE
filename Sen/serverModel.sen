/*============================================================================*/
/* serverModel.sen -- server actor model                                      */
/*============================================================================*/

" serverModel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* compute the number of server processing threads to be created              */
/*----------------------------------------------------------------------------*/
: nServerThreads ( memorySize -- nThreads )

  // the number of query threads is computed based on the
  // size of the region

  // there will be 1 query thread per GB
  // the number of threads will be limited to 80% of the number of cores

  C_1GB / locals| nThreads |

//1 exit // temp

  nThreads 0 <= if
    1
  else
    nThreads CORE_COUNT 6 * 10 / > if
      CORE_COUNT 6 * 10 / to nThreads
    then
  then

  nThreads
;

/*----------------------------------------------------------------------------*/
/* define the N_SERVER_THREADS constant                                       */
/*----------------------------------------------------------------------------*/
args.regionSize nServerThreads constant N_SERVER_THREADS
//2 constant N_SERVER_THREADS

/*----------------------------------------------------------------------------*/
/* create and spawn the server processing threads                             */
/*----------------------------------------------------------------------------*/
: >serverNm ( i -- s ) "serverThread" swap >str str.cat ;

: :serverThread ( i -- w ) >serverNm :thread    ;

: startServerThreads

  0 locals| pServerThread |

  args.progress if
    N_SERVER_THREADS "Server threads: %v" str.format .
  then

  args.verbose if
    "N_SERVER_THREADS " .put N_SERVER_THREADS .put .\n
  then

  N_SERVER_THREADS 0 do

    // create a thread
    I :serverThread execute to pServerThread

    // set the threads name
    //I >serverNm pServerThread thread.name!

    // set actor model in the thread
    //AC_SERVER pServerThread thread.actorModel!

    // spawn os thread
    //pServerThread thread.spawn_server

  loop
;

/*----------------------------------------------------------------------------*/
/* create a task using given arguments and append to server task queue        */
/*----------------------------------------------------------------------------*/
: spawnServerTask ( ... nArgs sSeedWord pParentTask sTaskNm eTaskKind -- pTask )

  nullptr locals| pTask eTaskKind sTaskNm pParent sSeedWord nArgs |

  // create a task
  //nArgs sSeedWord pParent AC_SERVER sTaskNm eTaskKind task::new to pTask

  // append task onto server task queue
  //pTask scheduler::server serverScheduler.enqueueTask

  pTask  // return the task
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
