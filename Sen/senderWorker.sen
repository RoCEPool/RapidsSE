/*============================================================================*/
/* SenderWorker.sen -- sender worker                                          */
/*============================================================================*/

"SenderWorker.sen" .verbose

/*
 *  A sender worker is spawned by the answer drone when it gets a new socket
 */

/*----------------------------------------------------------------------------*/
/* send valset across the socket                                              */
/*----------------------------------------------------------------------------*/
: >socket ( valset -- )

  task::this task.socket@

  tp: sending

  socket.send ( bool )

  not if
    "send failure" . ( 0/1 )
  then

  //"Node " grid.thisNode@ >str str.cat " sent word to another node " str.cat .
;

/*----------------------------------------------------------------------------*/
/* sender task processing loop                                                */
/*----------------------------------------------------------------------------*/
: senderLoop ( socket -- )

tp: senderLoop

  task::this task.socket!

  "senderLoop" task::this task.comment!

  senderTaskPrint if "Sender running on node" grid.thisNode@ >str str.cat . then

  begin
    depth 0 != if "sender task has grown" . debug.trap then

    // pop valset off this tasks job queue
    jobQueue>

tp: poppedValset

    // send the valset across the connection
    >socket

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
