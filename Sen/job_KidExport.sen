/*============================================================================*/
/* job_KidExport.sen -- Kid Export Job                                        */
/*============================================================================*/

" job_KidExport.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participant node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* seed on kid node                                                           */
/*----------------------------------------------------------------------------*/
: kidExport_kid ( -- )

  >>am <SEED_KID>

  job::this locals| pJob_KidExport |

  pJob_KidExport job_kidExport.exportOrigin locals| i_ExportNode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // send this kid to the export node
  i_ExportNode pJob_KidExport job.forward

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  <<am
  delete_completed_job

  <DONE_KID>
;

////////////////////////////////////////////////////////////////////////////////
//                            on originator node                              //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* seed on export node                                                        */
/*----------------------------------------------------------------------------*/
: kidExport_rcv (  -- )

  >>am <SEED_RCV>

  job::this locals| pJob_KidExport  |

  pJob_KindExport job_kidExport.exportJobId locals| i_ExportJobId |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  i_ExportJobId job::findOriginator locals| pJob_Export |

  pJob_Export pJob_KidExport job_kidExport.writeKidBuffer

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  delete_completed_job

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
