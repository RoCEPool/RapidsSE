/*============================================================================*/
/* job_KidExport.sen -- Kid Export Job                                        */
/*============================================================================*/

" job_KidExport.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participant node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run KE run seed on participant node                    [E](`E)SE:(`E)SE,KE */
/*----------------------------------------------------------------------------*/
: kidExport_kid ( -- )

  >>am <SEED_KID>

  job::this locals| pJob_KidExport |

  pJob_KidExport job_kidExport.exportOrigin locals| i_ExportNode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // send a `KE kid to the export node:                   `KE[E](`E)SE:(`E)SE,KE
  i_ExportNode pJob_KidExport job.forward

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete this KE kid on this participant node:         `KE[E](`E)SE:(`E)SE,xx
  <<am job::deleteThis

  <DONE_KID>
;

////////////////////////////////////////////////////////////////////////////////
//                            on originator node                              //
////////////////////////////////////////////////////////////////////////////////


/*----------------------------------------------------------------------------*/
/* handle the tap of export job                        [SE]-(E,SE,{`KE})-[SE] */
/*----------------------------------------------------------------------------*/
: kidExport.tapExport ( pJob_Export )

  params| pJob_Export |

  pJob_Export job.originatingTask@ locals| pExportTask |

  pExportTask task.grabLock

  pJob_Export job_export.twiddling@ if
    "Export is twiddling" .
    pExportTask task.dropLock
    pExportTask job.originatingTask@ task.ack
  else
    "Export is not twiddling" .
    pExportTask task.dropLock
  then

;

/*----------------------------------------------------------------------------*/
/* run `KE rcv seed on originating export node E          `KE[E](`E)SE:(`E)SE */
/*----------------------------------------------------------------------------*/
: kidExport_rcv (  -- )

  >>am <SEED_RCV>

  job::this locals| pJob_KidExport  |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // kid export 'KE on originator node finds export job [E]
  pJob_KidExport job_kidExport.exportJobId locals| i_ExportJobId |
  i_ExportJobId job::findOriginator locals| pJob_Export |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // kid export 'KE writes ExportBuffer to export job [E].m_oCsvFile
  false locals| bLastWrite |
  pJob_Export pJob_KidExport job_kidExport.writeExportBuffer to bLastWrite


  // ? ? ?
  bLastWrite if
    "`KE last write" .
    pJob_Export job_export.decTapper if
      "`KE is the tapper" .
      pJob_Export kidExport.tapExport
    then
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete this kid export `KE on this originator node:      xx[E](`E)SE:(`E)SE
  job::deleteThis

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
