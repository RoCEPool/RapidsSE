/*============================================================================*/
/* job_KidExport.sen -- Kid Export Job                                        */
/*============================================================================*/

" job_KidExport.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participant node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* seed on kid node                                                           */
/*----------------------------------------------------------------------------*/
: kidExport_kid ( -- )

  >>am <SEED_KID>

  job::this locals| pJob_KidExport |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  <<am
  delete_completed_job

  <DONE_KID>
;

////////////////////////////////////////////////////////////////////////////////
//                            on originator node                              //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* seed on writing node                                                       */
/*----------------------------------------------------------------------------*/
: kidExport_rcv (  -- )

  >>am <SEED_RCV>

  job::this locals| pJob_KidExport  |

  delete_completed_job

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
