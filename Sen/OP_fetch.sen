/*============================================================================*/
/* OP_fetch.sen -- Operator fetch                                             */
/*============================================================================*/

" OP_fetch.sen" .verbose

/*----------------------------------------------------------------------------*/
/* position and begin fetch                                                   */
/*----------------------------------------------------------------------------*/
: positionBeginFetch ( "iPhrase" "lowerKey" "upperKey" )

  params| upperKey lowerKey iPhrase |
  0 locals| sIndexNm |

  // find the index
  iPhrase planner[].indexNm@ to sIndexNm
  <tableNm> sIndexNm op__index assert

  // grab the table ptn read lock
  tablePtn[] tablePtnGrabRead

  // position in the index
  iPhrase  // phrase
  lowerKey // lower
  upperKey // upper
  planner[] tablePtn[] index[].position

  // fetch next buffer
  rowOnce[].isNull if
    nullptr
  else
    rowOnce[]
  then
  tablePtn[] index[].fetchNext
;

/*----------------------------------------------------------------------------*/
/* fetch first buffer for phrase                                              */
/*----------------------------------------------------------------------------*/
: fetchFirstBuffer ( iPhrase -- )

  params| iPhrase |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the fetch technique
  iPhrase planner[].fetchTechnique@

  case

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an exact select using index
    AT_EXACT of
      "*exact*" .verbose

      iPhrase                  // phrase
      iPhrase planner[].key@   // lower key
      iPhrase planner[].key@   // upper key
      positionBeginFetch to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // lower bound select using index
    AT_LOWER of
      "*lower*" .verbose

      iPhrase                     // phrase
      iPhrase planner[].lowKey@   // lower key
      ""                          // upper key
      positionBeginFetch to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an upper bound select using index
    AT_UPPER of
      "*upper*" .verbose

      iPhrase                     // phrase
      ""                          // lower key
      iPhrase planner[].upperKey@ // upper key
      positionBeginFetch to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // a range select using index
    AT_RANGE of
      "*range" .verbose

      iPhrase                     // phrase
      iPhrase planner[].lowKey@   // lower key
      iPhrase planner[].upperKey@ // upper key
      positionBeginFetch to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // full scan (no index)
    AT_SCAN of
      "*scan*" .verbose
      // now get excat key rows from index
      tablePtn[] tablePtnGrabRead
      tablePtn[].root to Subset[]
      Subset[] to Operand[]
    endof

  endcase
;

/*----------------------------------------------------------------------------*/
/* generate plan for the fetch                                                */
/*----------------------------------------------------------------------------*/
: generatePlan ( -- )

  0 locals| sPredicate |

  //sWhere "generatePlan" "%v %v" str.format .

  ( cdt_0 ) planner[].new
  ( cdt_1 ) table[] Planner[].table!

  ( cdt_2 ) <predicate> Planner[].parseWhere  //"parseWheres" .

  ( cdt_3 ) Planner[].genPaths           //"genPaths" .
  ( cdt_4 ) Planner[].scorePaths         //"scorePaths" .
  //( cdt_5 ) Planner[].showPaths

  ( cdt_6 ) Planner[].matchPaths         //"matchPaths" .
  //( cdt_6 ) Planner[].showPaths

  ( cdt_7 ) Planner[].choosePaths        //"choosePaths" .
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: fetch_CancelMarker \handler

  //"ZK_CANCELMARKER_handler" .verbose
  nullptr to Operand[]
  Pipein[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: fetch_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose

  // pipeout the Operand
  Operand[].pipeOut

  // get the fetchTechnique
  Counter1[] planner[].fetchTechnique@
  case
    AT_SCAN of
      Subset[].nextBuffer to Operand[]
    endof

    // all other types of fetches, just fetchNext
    rowOnce[].isNull if
      nullptr
    else
      rowOnce[]
    then
    tablePtn[] index[].fetchNext to Operand[]

  endcase

  // no more data for counter1[] phrase ?
  Operand[].isNull if

    // any more phrases ?
    Counter1[] 1 + to Counter1[]
    Counter1[] Counter0[] >= if
      // all done
      tablePtn[] tablePtnDropRead

      // delete the planner
      planner[].delete

      // delete the rowOnce skipList
      rowOnce[].isNull not if
      rowOnce[].delete
      then

      // pipeout an eosMarker
      Operand[].newEosMarker
      Operand[].pipeOut
    else
      // position and fetch first buffer for next phrase
      Counter1[] fetchFirstBuffer
    then
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: fetch_PulseMarker \handler

  0 locals| iPhrases |

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get no of phrases
  planner[].phrases@ to Counter0[]

  // if multiple phrases create a rowOnce skipList
  Counter0[] 1 > if
    RowOnce[].new
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert we have at least one phrase
  Counter0[] 1 >= assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set counter1[] to 0
  0 to Counter1[]

  // position and fetch the first buffer for the first phrase
  Counter1[] fetchFirstBuffer

  // any data ?
  Operand[].isNull if
    tablePtn[] tablePtnDropRead

    // delete the planner
    planner[].delete

    // delete the rowOnce skipList
    rowOnce[].isNull not if
      rowOnce[].delete
    then

    // pipeout an eosMarker
    Operand[].newEosMarker
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: fetch_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  0 locals| iPhrases |

  <tableNm> op__table if
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the plan for the fetch
  generatePlan

  //planner[].showPaths

  // assert we have a plan
  planner[].isNull not assert

  true
;

/*----------------------------------------------------------------------------*/
/* fetch request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: fetch_req \operator

  LogReqEntry SEED_REQ
  //<tableNm> <predicate> "PARAMETERS %v %v" str.format .

  op__topology

  find: fetch_CancelMarker ZK_CANCELMARKER op[].handler!
  find: fetch_CrwBuffer    ZK_CRWBUFFER    op[].handler!
  find: fetch_PulseMarker  ZK_PULSEMARKER  op[].handler!
  find: fetch_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: fetch :: fetch <tableNm> <predicate> ;

: fetch _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
