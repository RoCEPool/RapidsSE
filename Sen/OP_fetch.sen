/*============================================================================*/
/* OP_fetch.sen -- Operator fetch                                             */
/*============================================================================*/

" OP_fetch.sen" .verbose

/*----------------------------------------------------------------------------*/
/* generate plan for the fetch                                                */
/*----------------------------------------------------------------------------*/
: generatePlan ( -- )

  0 locals| sPredicate |

  //sWhere "generatePlan" "%v %v" str.format .

  ( cdt_0 ) planner[].new
  ( cdt_1 ) table[] Planner[].table!

  ( cdt_2 ) <predicate> Planner[].parseWhere  //"parseWheres" .

  ( cdt_3 ) Planner[].genPaths           //"genPaths" .
  ( cdt_4 ) Planner[].scorePaths         //"scorePaths" .
  //( cdt_5 ) Planner[].showPaths

  ( cdt_6 ) Planner[].matchPaths         //"matchPaths" .
  //( cdt_6 ) Planner[].showPaths

  ( cdt_7 ) Planner[].choosePaths        //"choosePaths" .
;

/*----------------------------------------------------------------------------*/
/* position and begin fetch                                                   */
/*----------------------------------------------------------------------------*/
: positionBeginFetch ( "lowerKey" "upperKey" )

  params| upperKey lowerKey |
  0 locals| sIndexNm |

  // find the index
  0 planner[].indexNm@ to sIndexNm
  <tableNm> sIndexNm op__index assert

  // grab the table ptn read lock
  tablePtn[].get tablePtnGrabRead2

  // position in the index
  lowerKey upperKey
  planner[] tablePtn[].get index[].position

  // fetch next buffer
  tablePtn[].get index[].fetchNext
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: fetch_CancelMarker \handler

  //"ZK_CANCELMARKER_handler" .verbose
  nullptr to Operand[]
  Pipein[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: fetch_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose

  // pipeout the Operand
  Operand[].pipeOut

  // get the fetchTechnique
  0 planner[].fetchTechnique@
  case
    AT_SCAN of
      Subset[].nextBuffer to Operand[]
    endof

    // all other types of fetches, just fetchNext
    tablePtn[].get index[].fetchNext to Operand[]

  endcase

  // no more data ?
  Operand[].isNull if
    tablePtn[].get tablePtnDropRead2
    planner[].delete
    Operand[].newEosMarker
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: fetch_PulseMarker \handler

  0 locals| iPhrases |

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be one phrase
  planner[].phrases@ to iPhrases
  iPhrases 1 == assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the fetch technique
  0 planner[].fetchTechnique@
  case

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an exact select using index
    AT_EXACT of
     "*exact*" .verbose

      0 planner[].key@ 0 planner[].key@
      positionBeginFetch to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // lower bound select using index
    AT_LOWER of
      "*lower*" .verbose

      0 planner[].lowKey@ ""
      positionBeginFetch to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an upper bound select using index
    AT_UPPER of
      "*upper*" .verbose

      "" 0 planner[].upperKey@
      positionBeginFetch to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // a range select using index
    AT_RANGE of
      "*range" .verbose

      0 planner[].lowKey@ 0 planner[].upperKey@
      positionBeginFetch to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // full scan (no index)
    AT_SCAN of
      "*scan*" .verbose
      // now get excat key rows from index
      tablePtn[].get tablePtnGrabRead2
      tablePtn[].root to Subset[]
      Subset[]@ to Operand[]
    endof

  endcase

  // any data ?
  Operand[].isNull if
    tablePtn[].get tablePtnDropRead2
    planner[].delete
    Operand[].newEosMarker
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: fetch_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  0 locals| iPhrases |

  <tableNm> op__table if
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the plan for the fetch
  generatePlan

  //planner[].showPaths

  // assert we have a plan
  planner[].isNull not assert

  true
;

/*----------------------------------------------------------------------------*/
/* fetch request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: fetch_req \operator

  LogReqEntry SEED_REQ
  <tableNm> <predicate> "PARAMETERS %v %v" str.format .

  op__topology

  find: fetch_CancelMarker ZK_CANCELMARKER op[].handler!
  find: fetch_CrwBuffer    ZK_CRWBUFFER    op[].handler!
  find: fetch_PulseMarker  ZK_PULSEMARKER  op[].handler!
  find: fetch_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: fetch :: fetch <tableNm> <predicate> ;

: fetch _info tagCopy: stageOp_tags
  tags{ <jobDesc> = "--op desc--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
