/*============================================================================*/
/* OP_fetch.sen -- Operator fetch                                             */
/*============================================================================*/

" OP_fetch.sen" .verbose

/*----------------------------------------------------------------------------*/
/* generate plan for the fetch                                                */
/*----------------------------------------------------------------------------*/
: generatePlan ( -- )

  0 locals| sPredicate |

  //sWhere "generatePlan" "%v %v" str.format .

  ( cdt_0 ) planner[].new
  ( cdt_1 ) table[] Planner[].table!

  ( cdt_2 ) <predicate> Planner[].parseWhere  //"parseWheres" .

  ( cdt_3 ) Planner[].genPaths           //"genPaths" .
  ( cdt_4 ) Planner[].scorePaths         //"scorePaths" .
  //( cdt_5 ) Planner[].showPaths

  ( cdt_6 ) Planner[].matchPaths         //"matchPaths" .
  ( cdt_6 ) Planner[].showPaths

  ( cdt_7 ) Planner[].choosePaths        //"choosePaths" .
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: fetchOP_CancelMarker \handler

  //"ZK_CANCELMARKER_handler" .verbose
  nullptr to Operand[]
  Pipein[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: fetchOP_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose

  begin
    Operand[].isNull
  not while
    Operand[].pipeout
    tablePtn[].get index[].fetchNext to Operand[]
  repeat

  tablePtn[].get tablePtnDropRead2

  // new an eos marker
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: fetchOP_PulseMarker \handler

  0 0 locals| iPhrases sIndexNm |

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  planner[].phrases@ to iPhrases

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the fetch technique
  iPhrases "iPhrases %v" str.format .
  iPhrases 1 == assert
  0 planner[].fetchTechnique@
  case

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an exact select using index
    AT_EXACT of
     "*exact*" .
      0 assert
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // lower bound select using index
    AT_LOWER of
      "*lower*" .
      // find the index
      0 planner[].indexNm@ to sIndexNm
      <tableNm> sIndexNm op__index assert

      // now get excat key rows from index
      tablePtn[].get tablePtnGrabRead2

      0 planner[].lowKey@
      planner[] tablePtn[].get index[].positionLower

      tablePtn[].get index[].fetchNext to Operand[]

    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an upper bound select using index
    AT_UPPER of
      "*upper*" .
      // find the index
      0 planner[].indexNm@ to sIndexNm
      <tableNm> sIndexNm op__index assert

      // now get excat key rows from index
      tablePtn[].get tablePtnGrabRead2

      0 planner[].upperKey@
      planner[] tablePtn[].get index[].positionUpper

      tablePtn[].get index[].fetchNext to Operand[]
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // a range select using index
    AT_RANGE of
      0 assert
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // full scan (no index)
    AT_SCAN of
      "*scan*" .
      0 assert
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: fetchOP_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  0 locals| iPhrases |

  <tableNm> op__table if
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the plan for the fetch
  generatePlan

  //planner[].showPaths

  // assert we have a plan
  planner[].isNull not assert

  true
;

/*----------------------------------------------------------------------------*/
/* fetch request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: fetchOP_req \operator

  LogReqEntry SEED_REQ
  <tableNm> <predicate> "PARAMETERS %v %v" str.format .

  op__topology

  find: fetchOP_CancelMarker ZK_CANCELMARKER op[].handler!
  find: fetchOP_CrwBuffer    ZK_CRWBUFFER    op[].handler!
  find: fetchOP_PulseMarker  ZK_PULSEMARKER  op[].handler!
  find: fetchOP_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: fetchOP :: fetchOP <tableNm> <predicate> ;

: fetchOP opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
