/*============================================================================*/
/* OP_lsidx.sen -- Operator list indexes                                      */
/*============================================================================*/

" OP_lsidx.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsidx_action

  0 0 locals| sTableNm pIndex |

  <tableNm> to sTableNm

  sTableNm op__table not if
    false
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushTableFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm name::checkIsTable not if
    path[].discardTableFolder
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
    exit
  then

  // push indexes folder
  path[].pushIndexesFolder assert

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  infoSetTable[] StreamDef[].new

  // create an infoSet operand
  StreamDef[] InfoSet[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the infoSet for each word

  folder[] dic.lastWord dup
  iterate                          // setup iteration of words

    object@ word.name@ folder[].findSymbol execute to pIndex

    pIndex StreamDef[] InfoSet[].addListIndex assert

    object@ word.prev object!      // step backwards thru words
  next

  // pop indexes folder
  path[].discardIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  path[].discardTableFolder
  folder[].isTables assert

  // pipeout the streamDef
  StreamDef[].pipeout

  // pipeout the infoset
  InfoSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: lsidx :: lsidx <tableNm> ;

: lsidx opInfo tagCopy: localLiteOp_tags
  tags{
    <jobDesc>     = "--description of operator--"
    <localLiteOp> = true
    <streamDef>   = __listIndex
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
