" job_NetHog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Job_NetHog request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: NetHog_req (  -- <R> )

  >>am <SEED_REQ>

  job::this locals| pJob_NetHog |

  <<am <DONE_REQ>
;

