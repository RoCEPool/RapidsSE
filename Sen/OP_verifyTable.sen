/*============================================================================*/
/* OP_verifyTable.sen -- Operator verify table                                */
/*============================================================================*/

" OP_verifyTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: vfytbl_action

  <tableNm> op__table not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  table[].verify

  // insert index verify
  table[] streamSetTable[] StreamSet[].addVerifyTable assert

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: vfytbl :: vfytbl <tableNm> ;

: vfytbl _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __verifyTable
    <params>    = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
