/*============================================================================*/
/* jobSuffix.sen -- Job Suffixes                                              */
/*============================================================================*/

" jobSuffix.sen" .verbose

/*----------------------------------------------------------------------------*/
/* append a suffix to name of word being compiled                             */
/*----------------------------------------------------------------------------*/
: word::addSuffix params| sSuffix |

  compiler::current word.name@ sSuffix str.cat compiler::current word.name!
;

/*----------------------------------------------------------------------------*/
/* category of words which are seeds                                          */
/*----------------------------------------------------------------------------*/
: seed

;

/*----------------------------------------------------------------------------*/
/* sets the category of word being being compiled as seed                     */
/*----------------------------------------------------------------------------*/
: word::seed#

  tick seed compiler::current word.category!
;

/*----------------------------------------------------------------------------*/
/* suffix sets the category of word being being compiled as suffix            */
/*----------------------------------------------------------------------------*/
: suffix immediate

  tick suffix compiler::current word.category!
;

/*----------------------------------------------------------------------------*/
/* _req makes the word being compile a request seed with name: <wordNm>_req   */
/*----------------------------------------------------------------------------*/
: _req immediate suffix

  // append _req to name of word being compiled
  "_req" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "req_exitHook" compiler::current word.exitHook!

  // add call to req_entryHook into word being compiled
  POSTPONE req_entryHook
;

/*----------------------------------------------------------------------------*/
/* _beg makes the word being compile a seed with name: <wordNm>_beg           */
/*----------------------------------------------------------------------------*/
: _beg immediate suffix

  // append _beg to name of word being compiled
  "_beg" word::addSuffix

  // the compiled word is a seed
  tick seed compiler::current word.category!

  word::seed#

  // set exit hook of word being compiled
  "beg_exitHook" compiler::current word.exitHook!

  // add call to beg_entryHook into word being compiled
  POSTPONE beg_entryHook
;

/*----------------------------------------------------------------------------*/
/* _exe makes the word being compile a seed with name: <wordNm>_exe           */
/*----------------------------------------------------------------------------*/
: _exe immediate suffix

  // append _exe to name of word being compiled
  "_exe" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "exe_exitHook" compiler::current word.exitHook!

  // add call to exe_entryHook into word being compiled
  POSTPONE exe_entryHook
;

/*----------------------------------------------------------------------------*/
/* _end makes the word being compile a end seed with name: <wordNm>_end       */
/*----------------------------------------------------------------------------*/
: _end immediate suffix

  // append _end to name of word being compiled
  "_end" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "end_exitHook" compiler::current word.exitHook!

  // add call to end_entryHook into word being compiled
  POSTPONE end_entryHook
;

/*----------------------------------------------------------------------------*/
/* _can makes the word being compile a cancel seed with name: <wordNm>_can    */
/*----------------------------------------------------------------------------*/
: _can immediate suffix

  // append _can to name of word being compiled
  "_can" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "can_exitHook" compiler::current word.exitHook!

  // add call to can_entryHook into word being compiled
  POSTPONE can_entryHook
;

/*----------------------------------------------------------------------------*/
/* _act makes the word being compile a seed with name: <wordNm>_act           */
/*----------------------------------------------------------------------------*/
: _act immediate suffix

  // append _beg to name of word being compiled
  "_act" word::addSuffix

  // the compiled word is a seed
  tick seed compiler::current word.category!

  word::seed#

  // set exit hook of word being compiled
  "act_exitHook" compiler::current word.exitHook!

  // add call to beg_entryHook into word being compiled
  POSTPONE act_entryHook
;

/*----------------------------------------------------------------------------*/
/* adds a standard entry and exit hook to word being compiled                 */
/*----------------------------------------------------------------------------*/
: _eeh immediate suffix

  "std_exitHook" compiler::current word.exitHook!

  // add call to std_entryHook into word being compiled
  POSTPONE std_entryHook
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
