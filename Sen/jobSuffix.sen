/*============================================================================*/
/* jobSuffix.sen -- Job Suffixes                                              */
/*============================================================================*/

" jobSuffix.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: _req immediate

  word::this word.name@ "_req" str.cat word::this word.name!
  "req_exitHook" word::this word.exitHook!

  POSTPONE <SEED_REQ>

  word::this word.name@ ,
  POSTPONE log::markEntry
;

: _beg immediate

  word::this word.name@ "_beg" str.cat word::this word.name!
  "beg_exitHook" word::this word.exitHook!

  word::this word.name@ ,
    POSTPONE log::markEntry

  POSTPONE <SEED_BEG>
  POSTPONE _path_set_

  // add this job to the participants list
  POSTPONE job::becomeParticipant
;

: _exe immediate

  word::this word.name@ "_exe" str.cat word::this word.name!
  "exe_exitHook" word::this word.exitHook!

  word::this word.name@ ,
    POSTPONE log::markEntry

  POSTPONE <SEED_EXE>
  POSTPONE _lock_exe_
;

: _end immediate

  word::this word.name@ "_end" str.cat word::this word.name!
  "end_exitHook" word::this word.exitHook!

  word::this word.name@ ,
    POSTPONE log::markEntry

  POSTPONE <SEED_END>
;

: _can immediate

  word::this word.name@ "_can" str.cat word::this word.name!
  "can_exitHook" word::this word.exitHook!

  word::this word.name@ ,
    POSTPONE log::markEntry

  POSTPONE <SEED_CAN>
;

: _std immediate

  "std_exitHook" word::this word.exitHook!

  word::this word.name@ ,
  POSTPONE log::markEntry
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
