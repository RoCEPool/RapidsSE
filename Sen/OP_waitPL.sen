/*============================================================================*/
/* OP_waitPL.sen -- Operator Wait on Pipeline                                 */
/*============================================================================*/

" OP_waitPL.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : waitPL_req \operator

  LogReqEntry SEED_REQ

  op__topology


  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: waitPL :: waitPL ;

: waitPL _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
