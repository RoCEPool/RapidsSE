/*============================================================================*/
/* OP_output.sen -- Operator output                                           */
/*============================================================================*/

" OP_output.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: outputOp_CrwBuffer \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: outputOp_CsvBuffer \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: outputOp_EntBuffer \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: outputOp_EosMarker \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: outputOp_ErrorMarker \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_INFOSET ...                                                 */
/*----------------------------------------------------------------------------*/
: outputOp_InfoSet \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_IRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: outputOp_IrwBuffer \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: outputOp_PulseMarker \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_SRTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: outputOp_SrtBuffer \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: outputOp_StartMarker \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: outputOp_StopMarker \handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: outputOp_StreamDef\handler

;

/*----------------------------------------------------------------------------*/
/* execute for outputOp request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: outputOp_req ( -- )

  LogEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        //"Operand:- ZK_CRWBUFFER" .verbose
        Operand[].pipeToJob
        true
      endof

      ZK_CSVBUFFER of
        //"Operand:- ZK_CSVBUFFER" .verbose
        Operand[].pipeToJob
        true
      endof

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        Operand[].pipeToJob
        Operand[].newEosMarker
        Operand[].pipeOut
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        Operand[].pipeToJob
        Operand[].newErrorMarker
        Operand[].pipeOut
        true
      endof

      ZK_ENTBUFFER of
        //"Operand:- ZK_ENTBUFFER" .verbose
        Operand[].pipeToJob
        true
      endof

      ZK_INFOSET of
      //"Operand:- ZK_INFOSET" .verbose
      Operand[].pipeToJob
      true
      endof

      ZK_IRWBUFFER of
        //"Operand:- ZK_IRWBUFFER" .verbose
        Operand[].pipeToJob
        true
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut
        Operand[].newPulseMarker
        Operand[].pipeToJob
        true
      endof

      ZK_SRTBUFFER of
        //"Operand:- ZK_SRTBUFFER" .verbose
        Operand[].pipeToJob
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        Operand[].pipeToJob
        Operand[].newStartMarker
        Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        Operand[].pipeOut
        Op.ackPipelineJob
        false
        endof

      ZK_STREAMDEF of
        //"Operand:- ZK_STREAMDEF" .verbose
        Operand[].pipeToJob
        true
      endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: outputOp :: outputOp ;

jobInfo: outputOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
