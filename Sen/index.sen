/*============================================================================*/
/* index.sen -- index related words                                           */
/*============================================================================*/

"index.sen" .verbose

/*----------------------------------------------------------------------------*/
/* index is used as a kind of word to identify indexes                        */
/*----------------------------------------------------------------------------*/
: index ;

/*----------------------------------------------------------------------------*/
/* make an indexes folder under given named table                             */
/*----------------------------------------------------------------------------*/
: makeIndexes ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING INDEXES FOR TABLE " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  find execute ( dic )
  "indexes"     ( dic "indexes" )
  swap         ( "indexes" dic )
  :folder      ( )
;

: isIndex word.kind@ tick index eql ;

/*----------------------------------------------------------------------------*/
/* create an index using name from input stream (doesnt leave index on stk)   */
/*----------------------------------------------------------------------------*/
: index:

  create
  WT_OBJECT word.this word.type!
  sizeof_index allot
  word.this >body object.magic!
  CN_INDEX word.this >body object.class!
  word.this >body index.init
  true word.this >body object.wordbody!
  tick index word.this word.kind!
  does>
;

/*----------------------------------------------------------------------------*/
/* create an index using name on the stack (leaves index on stack)             */
/*----------------------------------------------------------------------------*/
: :index

  >create
  WT_OBJECT word.this word.type!
  sizeof_index allot
  word.this >body object.magic!
  CN_INDEX word.this >body object.class!
  word.this >body index.init
  true word.this >body object.wordbody!
  tick index word.this word.kind!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* check within indexes folder                                                */
/*----------------------------------------------------------------------------*/
: withinIndexes
  0 pathPick dic.name "indexes" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: checkInIndexes
  withinIndexes if true exit then
  EC_NOT_IN_INDEXES false
;

/*----------------------------------------------------------------------------*/
/* assert top of task dictionary stack is indexes                              */
/*----------------------------------------------------------------------------*/
: assertInIndexes ( -- t|f )
  withinIndexes assert
;

/*----------------------------------------------------------------------------*/
/* check word is an index                                                     */
/*----------------------------------------------------------------------------*/
: checkIsIndex ( "<indexNm>" -- true | errorCode false )

  0 locals| indexPtr indexNm |

  indexNm find ( indexPtr )
  to indexPtr

  indexPtr
  not ( indexPtr bool )

  if
    EC_NO_SUCH_INDEX false ( errorCode false )
  exit
  then

  indexPtr ( indexPtr )
  word.kind@ ( ^word )
  tick index ( ^word ^word )
  eql ( bool )
  if
    //indexPtr execute index.isHidden@ if
    //  EC_NO_SUCH_INDEX false ( errorCode false )
    //  exit
    //then

    true ( true )
    exit
  then


  EC_NOT_AN_INDEX false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: checkIsNotIndex ( "<word>" )

  findInCurrent not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* find the index sub folder and push it onto task dictionary                 */
/*----------------------------------------------------------------------------*/
: pushIndexSub ( "<indexNm>" -- )
  dup checkIsIndex not if EC_NO_SUCH_INDEX false exit then
  find execute index.subDic pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the index sub folder                                                   */
/*----------------------------------------------------------------------------*/
: popIndexSub
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* find the indexes folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: pushIndexes ( -- )
  "indexes" find execute pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the indexes folder                                                     */
/*----------------------------------------------------------------------------*/
: popIndexes
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable index                                          */
/*----------------------------------------------------------------------------*/
: checkMakeIndex ( "<indexNm>" "<tableNm>" --  true | errorCode false )

  locals| tableNm indexNm |

  checkInTables not if false exit then

  tableNm checkIsTableFolder not if false exit then

  tableNm pushTable assert

  tableNm find execute table.indexCount
  C_INDEXES_PER_TABLE == if EC_MAX_INDEXES popTable assertInTables false exit then

  pushIndexes assert

  indexNm checkIsNotIndex not if popIndexes popTable assertInTables false exit then

  popIndexes
  popTable

  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable index folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveIndex ( "<indexNm>" "<tableNm>" -- true | errorCode false )

  locals| tableNm indexNm |

  // should be in the tables folder
  checkInTables       not if false exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if false exit then

  true ( "<indexNm>" true )
;

/*----------------------------------------------------------------------------*/
/* tidy up of the index                                                       */
/*----------------------------------------------------------------------------*/
: indexTidyUp ( "<indexNm>" -- )

   find execute ( ^indexPtr )

   // truncate the index
   dup index.truncate
   
   // forget all column names
   dup index.subDic
   pathPush
   "columns" find execute forgetAll
   pathDrop

  // forget the sub dictionary
   index.subDic forgetAll
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* analyze an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyzeIndex allParticipants 2 returnResult ( detailed "<indexNm>" -- true n# true )

  tp: analyzeIndex

  find execute
  index.analyze

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* get index pointer and put into task.seitf.currentIndex                     */
/*----------------------------------------------------------------------------*/
: getIndex ( "<indexNm>" "<tableNm>" -- <R> )

  locals| sTableNm sIndexNm |

pathDump
  assertInTables

  // push table folder
  sTableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  // get index ptr
  sIndexNm findInCurrent execute

  task::this task.seitf@ seitf.index!

  // pop indexes folder
  popIndexes

  // pop table folder
  popTable

  true
;

/*----------------------------------------------------------------------------*/
/* clear task.seitf.currentIndex                                              */
/*----------------------------------------------------------------------------*/
: returnIndex ( )

  nullptr task::this task.seitf@ seitf.index!

  true
;

/*----------------------------------------------------------------------------*/
/* make_index (invoked from makeIndex)                                        */
/*----------------------------------------------------------------------------*/
: make_index ( "<tableNm>" "<indexNm>" -- )

  0 0 locals| indexPtr tablePtr indexNm tableNm |

  pushIndexes assert

  // create the index
  indexNm ( "<indexNm>" )
  :index ( ^index )

  // drop the index word
  drop (  )

  // make index columns
  indexNm "makeIndexColumns" find execute

  indexNm ( "<indexNm>" )

  // find the index
  find execute ( ^index )
  to indexPtr

  // find the table
  tableNm find execute
  to tablePtr

  // push the table and index
  tablePtr indexPtr ( ^index ^table )

  // set the table in the index
  index.table! (  )

  // add the index in the table
  indexPtr tablePtr table.addIndex

  popIndexes
;

/*----------------------------------------------------------------------------*/
/* make an index (run by participant)                                         */
/*----------------------------------------------------------------------------*/
: makeIndex allParticipants 2 checkResult ( "<tableNm>" "<indexNm>"  -- true n# true )

tp: makingIndex

  locals| indexNm tableNm |

  args.tracepoint if
  "MAKING INDEX " indexNm str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  tableNm
  pushTable assert

  tableNm indexNm make_index

  popTable

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by keySelectIndex request)    */
/*----------------------------------------------------------------------------*/
: exactSelectIdxTask ( <"key>" "<lower>" "<upper>" pSeitf iPartitionNo -- )

  0 0 0 0 locals| entry pTempEntryBuffer pEntryBuffer pIndex iPartitionNo pSeitf upper lower key |

  tp: keySelectIdx

  //"fetchTask started" .
  
  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  pSeitf task::this task.seitf!
  pSeitf seitf.index@ to pIndex

  // create a temporary index buffer for the results
  //"Creating a tempEntryBuffer" .
  iPartitionNo pIndex entryBuffer::create to pTempEntryBuffer

  // get the entryBuffer looking for the key
  key iPartitionNo pIndex index.buffer ( pEntryBuffer )
  to pEntryBuffer

  // did we get an index buffer ?
  pEntryBuffer if
    // position in the index buffer at the key
    key pEntryBuffer pIndex index.position
    to entry
  then

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    //"Marking tempEntryBuffer as last buffer" .
    pTempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    pTempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

    // mark that a fetch task has ended
    pSeitf seitf.fetchTaskEnded

    exit
  then

  // iterate thru the buffer till no key match
  begin
    entry
    while

    // check if exact key match
    key pIndex entry entry.matches if

      // insert row from entry in tempEntryBuffer
      //"Inserting row into tempEntryBuffer" .
      pIndex entry entry.toDataRow pTempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        pTempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

        // create another temporary index buffer for the results
        //"Creating a tempEntryBuffer" .
        iPartitionNo pIndex entryBuffer::create to pTempEntryBuffer

        // insert row from entry in temporary buffer
        //"Inserting row into tempEntryBuffer" .
        pIndex entry entry.toDataRow pTempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry pEntryBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current entryBuffer
        pEntryBuffer entryBuffer.nextBuffer to pEntryBuffer

        pEntryBuffer if
          entry pEntryBuffer entryBuffer.nextEntry to entry
        then
      then
    else
      // entry did not match the key, null the entry and break from loop
      0  to entry
    then
  repeat

  //"Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  pTempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  pTempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

  // mark that a fetch task has ended
  pSeitf seitf.fetchTaskEnded
;

/*----------------------------------------------------------------------------*/
/* make an index (run by participant)                                         */
/*----------------------------------------------------------------------------*/
: loadIndexes allParticipants 0 checkResult ( -- true n# true )

tp: loadIndexes

  args.tracepoint if
    "LOADING INDEXES on NODE " grid.thisNode@ >str str.cat .
  then

  "indexes"
  find execute pathPush

  0 pathPick dic.lastWord dup
    iterate
    object@ word.name
    find execute ( ^index )

    // populate only non-hidden indexes
    dup index.isHidden@ not if
      index.populate
    then

    object@ word.prev object!
  next

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: lowerSelectIdxTask ( <"key>" "<lower>" "<upper>" pSeitf partition -- )

  0 0 0 0 locals| pIndex entry tempEntryBuffer indexBuffer iPartitionNo pSeitf upper lower key |

  tp: lowerSelectIdxTask

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  pSeitf task::this task.seitf!
  pSeitf seitf.index@ to pIndex

  // create a temporary index buffer for the results
  //"Creating a tempIndexBuffer" .
  iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

  // get the indexBuffer looking for the lower key
  lower iPartitionNo pIndex index.buffer ( indexBuffer )
  to indexBuffer

  // did we get an index buffer ?
  indexBuffer if
    // position in the index buffer at the lower key
    lower indexBuffer pIndex index.position
    to entry
  then

  // did we find an entry ?
  entry not if
    
    // mark this buffer as the last buffer
    //"Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    //"Appending tempEntryBuffer to buffer queue" .
    tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

    // mark that a fetch task has ended
    pSeitf seitf.fetchTaskEnded

   // mark that a fetch task has ended
   pSeitf seitf.fetchTaskEnded

    exit
  then

  // iterate thru the buffer till no more entries
  begin
  entry
  while
    
    // insert row from entry in tempEntryBuffer
    //"Inserting row into tempEntryBuffer" .
    pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow

    // check if we managed to insert the entry
    not if
      // buffer must be full
      // put this tempEntryBuffer in seitf bufferQueue
      //"Inserting row into tempEntryBuffer" .
      tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

      // create another temporary index buffer for the results
      //"Creating a tempIndexBuffer" .
      iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

      // insert row from entry in temporary buffer
      //"Inserting row into tempEntryBuffer" .
      pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow
      assert
    then

    // move to next entry in the buffer
    entry indexBuffer entryBuffer.nextEntry to entry

    entry not if
      // get next buffer from the current indexBuffer
      indexBuffer entryBuffer.nextBuffer to indexBuffer

      indexBuffer if
        entry indexBuffer entryBuffer.nextEntry to entry
      then
    then

  repeat

  //"Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  //"Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

  // mark that a fetch task has ended
  pSeitf seitf.fetchTaskEnded
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: rangeSelectIdxTask ( <"key>" "<lower>" "<upper>" pSeitf iPartitionNo -- )

//"rangeSelectIdxTask" .

  // save args
  locals| iPartitionNo pSeitf sUpper sLower sKey |

  // local variables
  0 0 0 0 0 locals| pIndex pUpperEntry pIndexEntry pIndexBuffer pResultBuffer |

  tp: rangeSelectIdxTask

  //debug::trap

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  // save seitf into this task
  pSeitf task::this task.seitf!
  pSeitf seitf.index@ to pIndex

  // create a temporary buffer for the results
  iPartitionNo pIndex entryBuffer::create to pResultBuffer

  // get the indexBuffer looking for the lower key
  sLower iPartitionNo pIndex index.buffer to pIndexBuffer

  // did we get an index buffer ?
  pIndexBuffer if
    // position in the index buffer at the lower key
    sLower pIndexBuffer pIndex index.position to pIndexEntry
  then

  // did we find an entry ?
  pIndexEntry not if

    // mark this result buffer as the last buffer
    pResultBuffer entryBuffer.isLast!

    // return the empty result buffer
    pResultBuffer pSeitf seitf.bufferQueue@ queue.append

    // mark that a fetch task has ended
    pSeitf seitf.fetchTaskEnded

    exit
  then

  // iterate thru the index buffer till no more index entries
  begin
  pIndexEntry
  while

    // check against upper bound
    sUpper pIndexEntry iPartitionNo pIndex index.upper if
      
      // look up data row and insert row into result buffer
      pIndex pIndexEntry entry.toDataRow pResultBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this result buffer in seitf buffer queue
        pResultBuffer pSeitf seitf.bufferQueue@ queue.append

        // create another result buffer
        iPartitionNo pIndex entryBuffer::create to pResultBuffer

        // look up data row and insert row into result buffer
        pIndex pIndexEntry entry.toDataRow pResultBuffer entryBuffer.insertRow
        assert
      then

      // move to next index entry in the index buffer
      pIndexEntry pIndexBuffer entryBuffer.nextEntry to pIndexEntry

      pIndexEntry not if
        // get next index buffer from the current index buffer
        pIndexBuffer entryBuffer.nextBuffer to pIndexBuffer

        pIndexBuffer if
         pIndexEntry pIndexBuffer entryBuffer.nextEntry to pIndexEntry
        then
      then
    else
      // entry beyond upper, null the entry and break from loop
      0  to pIndexEntry
    then
  repeat

  // mark this result buffer as the last buffer
  pResultBuffer entryBuffer.isLast!

  // put the result buffer in the seitf buffer queue
  pResultBuffer pSeitf seitf.bufferQueue@ queue.append

  // mark that a fetch task has ended
  pSeitf seitf.fetchTaskEnded
;

/*----------------------------------------------------------------------------*/
/* print rows from entries of an index buffer                                 */
/*----------------------------------------------------------------------------*/
: printRows ( ^pIndex ^pIndexBuffer --  )

  0 0 locals| nRowCount pEntry pIndexBuffer pIndex iPartitionNo |

  // get the partitionNo
  pIndexBuffer entryBuffer.partition@ to iPartitionNo

  // get the entry
  pIndexBuffer entryBuffer.firstEntry to pEntry

  begin
    pEntry
    while

      display@ if
        args.metadata if
          pIndex pEntry entry.embeddedRow
          iPartitionNo grid::toPartition
          "row: (%v,%v)\n" str.format .put
        else
          pIndex pEntry entry.embeddedRow "row: (%v)\n" str.format .put
        then
      then
      1 nRowCount + to nRowCount
      pEntry pIndexBuffer entryBuffer.nextEntry to pEntry

    repeat

    // return nRowCount
    nRowCount
;

/*----------------------------------------------------------------------------*/
/* pop buffer off the buffer queue                                            */
/*----------------------------------------------------------------------------*/
: popBuffer ( ^pBufferQueue --  )

  locals| pBufferQueue |

  begin
    pBufferQueue queue.pop ( value true | false )

    // try again if no value
    not while
      //REQUST_LOOP2
      //task.yield
      args.sleep thread.sleep_ms
  repeat
;

/*----------------------------------------------------------------------------*/
/* populate the index with data                                               */
/*----------------------------------------------------------------------------*/
: populateIndex allParticipants 1 checkResult ( "<indexNm>" -- true n# true )

  0 locals| pIndex sIndexNm |

  // get index ptr
  sIndexNm findInCurrent execute to pIndex

  pIndex index.populate

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* fetch rows from buffers from teh buffer queue of the seitf                 */
/*----------------------------------------------------------------------------*/
: fetchQueueBufferRows ( -- )

  0 0 0 0 0 locals| nLastBuffers nRowCount pIndex pIndexBuffer pSeitf |

  // get the seitf of the task
  task::this task.seitf@ to pSeitf

  // get index
  pSeitf seitf.index@ to pIndex

  // get number of last buffers
  pSeitf seitf.lastbuffers@ to nLastBuffers

  // loop thru buffers
  true
  begin
  while

    // pop a buffer off the seitf buffer queue
    pSeitf seitf.bufferQueue@ popBuffer to pIndexBuffer

    // print the rows from the index buffer
    pIndex pIndexBuffer printRows nRowCount + to nRowCount

    // check if last buffer
    pIndexBuffer entryBuffer.isLast@ if

      nLastBuffers 1 - to nLastBuffers
      0 nLastBuffers == if
        false
      else
        true
      then
    else
      true  // no more entries, move to next buffer
    then

    pIndexBuffer entryBuffer.delete
    //"Deleted buffer" .

  repeat

  // delete the buffer queue from the seitf
  pSeitf seitf.bufferQueue@ queue.delete
  0 pSeitf seitf.bufferQueue!

  args.metadata if
    nRowCount pSeitf seitf.rowsProcessed
  else
    "rows selected"  nRowCount "%v %v\n" str.format .put
  then

;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: scanSelectIdxTask ( <"key>" "<lower>" "<upper>" pSeitf iPartitionNo -- )

  0 0 0 0 locals| pIndex entry tempEntryBuffer indexBuffer iPartitionNo pSeitf upper lower key |

  tp: scanSelectIdxTask

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  pSeitf task::this task.seitf!
  pSeitf seitf.index@ to pIndex

  // create a temporary index buffer for the results
  //"Creating a tempIndexBuffer" .
  iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

  // position in the first index buffer
  iPartitionNo pIndex index.positionFirst
  to indexBuffer

  // get the first entry in the buffer
  indexBuffer entryBuffer.firstEntry
  to entry

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    //"Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    //"Appending last tempEntryBuffer to buffer queue" .
    tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

    // mark that a fetch task has ended
    pSeitf seitf.fetchTaskEnded

    exit
  then

  // iterate thru the buffer till no more entries
  begin
  entry
  while
      // insert row from entry in tempEntryBuffer
      //"Inserting row into tempEntryBuffer" .
      pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        //"Inserting row into tempEntryBuffer" .
        tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

        // create another temporary index buffer for the results
        //"Creating a tempIndexBuffer" .
        iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

        // insert row from entry in temporary buffer
        //"Inserting row into tempEntryBuffer" .
        pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry indexBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current indexBuffer
        indexBuffer entryBuffer.nextBuffer to indexBuffer

        indexBuffer if
          entry indexBuffer entryBuffer.nextEntry to entry
        then
      else
        // there is an entry
        // check if seitf exiting
        pSeitf seitf.isExiting if
          0 to entry
        then
      then
    repeat

  // mark this buffer as the last buffer
  //"Marking tempEntryBuffer as last buffer" .
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  //"Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

  // mark that a fetch task has ended
  pSeitf seitf.fetchTaskEnded
;

/*----------------------------------------------------------------------------*/
/* set isUnique property of index                                             */
/*----------------------------------------------------------------------------*/
: setIndexIsUnique allParticipants 2 checkResult ( "<indexNm>" true/false -- )

  assert::stack_2

  locals| sIndexNm bIsUnique |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  bIsUnique ( bIsUnique )

  sIndexNm find execute ( bIsUnique index^ )

  index.isUnique! ( )

  assert::stack_0

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* get size of index                                                          */
/*----------------------------------------------------------------------------*/
: sizeIndex ( "<indexNm>" -- "<size>" )

  find execute ( index^ )

  index.space 0 swap number.magnitude >str
;

/*----------------------------------------------------------------------------*/
/* select using index (called by fetchRowsIndex_req)                          */
/*----------------------------------------------------------------------------*/
: spawnSelectTask ( "<sExactKey>" "<sLowerKey>" "<sUpperKey>"
"<sSelectTaskSeed>" "<sIndexNm>" pBufferQueue <bSinglePartition> --  )

tp: selectIndex

  //debug::trap

  // task is a request server
  task::this task.kind@ TK_REQUEST_SERVER == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //   and the seitf will have an index
  //   and the seitf will have a bufferQueue
  //
  //assert::stack_5

  // save args
  locals| bSinglePartition pBufferQueue sIndexNm sSelectTaskSeed sUpperKey sLowerKey sExactKey |

  // local variables
  0 0 0 0 0 0 0 locals| pIndex iSlots pSeitf pSelectTask nRowCount pIndexBuffer pEntry |

  // increment query count
  queryCount ++

  task::this task.seitf@ to pSeitf

  // push into indexes folder
  pushIndexes assert

  // find the index and put it in the seitf
  sIndexNm find execute to pIndex
  pIndex pSeitf seitf.index!

  // pop indexes
  popIndexes

  args.metadata if
    metadata@ "metadata: %v\n" str.format .put
  then

  // create the buffer queue in the seitf
  //"selectTask.queue" queue::new pSeitf seitf.bufferQueue!

  // set the queue in the seitf
  pBufferQueue pSeitf seitf.bufferQueue!

  bSinglePartition if

    0 0 locals| iSlot iPartition |
    pSeitf seitf.slot@ to iSlot
    pSeitf seitf.partition@ to iPartition

    //args.metadata not if
    //  iPartition "Partition: %v\n" str.format .put
    //then

    // create a selectTask to execute the key select on the index for the partition
    sExactKey sLowerKey sUpperKey pSeitf iSlot 5
    sSelectTaskSeed nullptr "selectTask" TK_SELECT_PART spawnServerTask
    to pSelectTask

  else
    // for each slot
    grid.slots to iSlots
    iSlots 0
    do

      //args.metadata not if
      //  I grid::toPartition "Partition: %v\n" str.format .put
      //then

      // create a selectTask to execute the key select on the index for the partition
      sExactKey sLowerKey sUpperKey pSeitf I 5
      sSelectTaskSeed nullptr "selectTask" TK_SELECT_PART spawnServerTask
      to pSelectTask

    loop
  then
;


/*----------------------------------------------------------------------------*/
/* remove an index                                                            */
/*----------------------------------------------------------------------------*/
: removeIndex allParticipants 1 checkResult ( "<indexNm>" -- true n# true )

  tp: removeIndex
  locals| indexNm |

  // forward reference :-(
  indexNm "indexTidyUp" find execute

  indexNm :forget

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: upperSelectIdxTask ( <"key>" "<lower>" "<upper>" pSeitf partition -- )

  0 0 0 0 0 locals| pIndex upperEntry entry tempEntryBuffer indexBuffer iPartitionNo pSeitf upper lower key |

  tp: upperSelectIdxTask

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  pSeitf task::this task.seitf!
  pSeitf seitf.index@ to pIndex

  // create a temporary index buffer for the results
  //"Creating a tempIndexBuffer" .
  iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

  // position in the first index buffer
  iPartitionNo pIndex index.positionFirst
  to indexBuffer

  // get the first entry in the buffer
  indexBuffer entryBuffer.firstEntry
  to entry

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    //"Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    //"Appending tempEntryBuffer to buffer queue" .
    tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

    // mark that a fetch task has ended
    pSeitf seitf.fetchTaskEnded

    exit
  then

  // iterate thru the buffer till no more entries
  begin
  entry
  while

    // check against upper entry
    //upperEntry entry entry.same not if
    upper entry iPartitionNo pIndex index.upper if
      
      // insert row from entry in tempEntryBuffer
      //"Inserting row into tempEntryBuffer" .
      pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        //"Inserting row into tempEntryBuffer" .
        tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

        // create another temporary index buffer for the results
        //"Creating a tempIndexBuffer" .
        iPartitionNo pIndex entryBuffer::create to tempEntryBuffer

        // insert row from entry in temporary buffer
        //"Inserting row into tempEntryBuffer" .
        pIndex entry entry.toDataRow tempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry indexBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current indexBuffer
        indexBuffer entryBuffer.nextBuffer to indexBuffer

        indexBuffer if
          entry indexBuffer entryBuffer.nextEntry to entry
        then
      then
    else
      // entry beyond upper, null the entry and break from loop
      0  to entry
    then
  repeat

  //"Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  //"Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer pSeitf seitf.bufferQueue@ queue.append

  // mark that a fetch task has ended
  pSeitf seitf.fetchTaskEnded
;

/*----------------------------------------------------------------------------*/
/* verify an index of a table                                                 */
/*----------------------------------------------------------------------------*/
: verifyIndex allParticipants 1 returnResult ( "<indexNm>" -- true n# true )

  tp: verifyIndex

  find execute
  index.verify

  <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

/*----------------------------------------------------------------------------*/
/* fetch rows from buffers from teh buffer queue of the seitf                 */
/*----------------------------------------------------------------------------*/
: groupByQueueBufferRows ( -- )

  0 0 0 0 0 0 0 locals| iSlots nRowCount pIndex pIndexBuffer pSeitf pGroupBy pPartialGroupBy |

  // get the seitf of the task
  task::this task.seitf@ to pSeitf

  // get index
  pSeitf seitf.index@ to pIndex

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  groupBy::new locals| pGroupBy |
  pGroupBy groupBy.start

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  // get slots
  grid.slots to iSlots

  1
  begin
  while

    // attempt to pop buffer off the tasks buffer queue
    pSeitf seitf.bufferQueue@ popBuffer to pIndexBuffer

    // print the rows from the index buffer
    pIndex pIndexBuffer printRows nRowCount + to nRowCount

    // check if last buffer
    pIndexBuffer entryBuffer.isLast@ if

      //"Reached last buffer" .
      iSlots 1 - to iSlots
      0 iSlots == if
        0
      else
        1
      then
    else
      1  // no more entries, move to next buffer
    then

    pIndexBuffer entryBuffer.delete
    //"Deleted buffer" .

  repeat

  // delete the buffer queue from the seitf
  pSeitf seitf.bufferQueue@ queue.delete
  0 pSeitf seitf.bufferQueue!

  args.metadata if
    nRowCount pSeitf seitf.rowsProcessed
  else
    "rows selected"  nRowCount "%v %v\n" str.format .put
  then

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +
  grid.slots 0
  do
    I pSeitf seitf.groupBy@ to pPartialGroupBy
    pPartialGroupBy pGroupby groupBy.applyPartial
    pPartialGroupBy groupBy.delete
  loop
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  // delete groupBy
  pGroupBy groupBy.end
  pGroupBy groupBy.delete

;

/*----------------------------------------------------------------------------*/
/* select using index (called by fetchRowsIndex_req) -- groupBy               */
/*----------------------------------------------------------------------------*/
: spawnGroupByTask ( "<sExactKey>" "<sLowerKey>" "<sUpperKey>"
                   "<sSelectTaskSeed>" "<sIndexNm>" --  )

  tp: selectIndex

  //debug::trap

  // task is a request server
  task::this task.kind@ TK_REQUEST_SERVER == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //
  //assert::stack_5

  // save args
  locals| sIndexNm sSelectTaskSeed sUpperKey sLowerKey sExactKey |

  // local variables
  0 0 0 0 0 0 0 locals| iSlots pSeitf pSelectTask nRowCount pIndexBuffer pEntry pIndex |

  // increment query count
  queryCount ++

  // push into indexes folder
  pushIndexes assert

  // find the index
  sIndexNm find execute to pIndex

  // find the index andput it in the seitf
  task::this task.seitf@ to pSeitf
  pIndex pSeitf seitf.index!

  // pop indexes
  popIndexes

  args.metadata if
    metadata@ "metadata: %v\n" str.format .put
  then

  // create the buffer queue in the seitf
  "selectTask.queue" queue::new pSeitf seitf.bufferQueue!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // for each slot
  grid.slots to iSlots
  iSlots 0
  do

    args.metadata not if
      I grid::toPartition "Partition: %v\n" str.format .put
    then

    // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +
    I groupBy::new pSeitf seitf.groupBy!
    // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

    // create a selectTask to execute the key select on the index for the partition
    sExactKey sLowerKey sUpperKey pSeitf I 5
    sSelectTaskSeed nullptr "selectTask" TK_SELECT_PART spawnServerTask
    to pSelectTask

  loop
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: groupByIdxTask_RH ( <"key>" "<lower>" "<upper>" pSeitf iPartitionNo -- )

  // save args
  locals| iPartitionNo pSeitf sUpper sLower sKey |

  // local variables
  0 0 0 0 0 locals| pIndex pUpperEntry pIndexEntry pIndexBuffer pResultBuffer |

  tp: rangeSelectIdxTask

  //debug::trap

  // task is a select participant running on server thread
  task::this task.kind@ TK_SELECT_PART == assert
  task::this task.thread thread.actorModel@ AC_SERVER == assert

  // save seitf into this task
  pSeitf task::this task.seitf!
  pSeitf seitf.index@ to pIndex

  // start groupBy operator for this partition
  iPartitionNo pSeitf seitf.groupBy@ locals| pGroupBy |
  pGroupBy groupBy.start

  // create a temporary buffer for the results
  iPartitionNo pIndex entryBuffer::create to pResultBuffer

  iPartitionNo pIndex index.positionFirst to pIndexBuffer
  pIndexBuffer entryBuffer.firstEntry to pIndexEntry

  // did we find an entry ?
  pIndexEntry not if

    // mark this result buffer as the last buffer
    pResultBuffer entryBuffer.isLast!

    pResultBuffer pSeitf seitf.bufferQueue@ queue.append

    exit
  then

  pGroupby pIndexEntry pUpperEntry pIndexBuffer entryBuffer.iterate

  // mark this result buffer as the last buffer
  pResultBuffer entryBuffer.isLast!
  pResultBuffer pSeitf seitf.bufferQueue@ queue.append
;

