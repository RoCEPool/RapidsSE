/*============================================================================*/
/* index.sen -- index related words                                           */
/*============================================================================*/

"index.sen" .verbose

/*----------------------------------------------------------------------------*/
/* index is used as a kind of word to identify indexes                        */
/*----------------------------------------------------------------------------*/
: index ;

/*----------------------------------------------------------------------------*/
/* make an indexes folder under given named table                             */
/*----------------------------------------------------------------------------*/
: makeIndexes ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING INDEXES FOR TABLE " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  find execute ( dic )
  "indexes"     ( dic "indexes" )
  swap         ( "indexes" dic )
  :folder      ( )
;

: isIndex word.kind@ ' index eql ;

/*----------------------------------------------------------------------------*/
/* create an index using name from input stream (doesnt leave index on stk)   */
/*----------------------------------------------------------------------------*/
: index:

  create
  WT_OBJECT word.this word.type!
  sizeof_index allot
  word.this >body object.magic!
  CN_INDEX word.this >body object.class!
  word.this >body index.init
  true word.this >body object.wordbody!
  ' index word.this word.kind!
  does>
;

/*----------------------------------------------------------------------------*/
/* create an index using name on the stack (leaves index on stack)             */
/*----------------------------------------------------------------------------*/
: :index

  >create
  WT_OBJECT word.this word.type!
  sizeof_index allot
  word.this >body object.magic!
  CN_INDEX word.this >body object.class!
  word.this >body index.init
  true word.this >body object.wordbody!
  ' index word.this word.kind!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* check within indexes folder                                                */
/*----------------------------------------------------------------------------*/
: withinIndexes
  0 pathPick dic.name "indexes" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: checkInIndexes
  withinIndexes if true exit then
  EC_NOT_IN_INDEXES false
;

/*----------------------------------------------------------------------------*/
/* assert top of task dictionary stack is indexes                              */
/*----------------------------------------------------------------------------*/
: assertInIndexes ( -- t|f )
  withinIndexes assert
;

/*----------------------------------------------------------------------------*/
/* check word is an index                                                     */
/*----------------------------------------------------------------------------*/
: checkIsIndex ( "<indexNm>" -- true | errorCode false )

  0 locals| indexPtr indexNm |

  indexNm find ( indexPtr )
  to indexPtr

  indexPtr
  not ( indexPtr bool )

  if
    EC_NO_SUCH_INDEX false ( errorCode false )
  exit
  then

  indexPtr ( indexPtr )
  word.kind@ ( ^word )
  ' index ( ^word ^word )
  eql ( bool )
  if
    //indexPtr execute index.isHidden@ if
    //  EC_NO_SUCH_INDEX false ( errorCode false )
    //  exit
    //then

    true ( true )
    exit
  then


  EC_NOT_AN_INDEX false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: checkIsNotIndex ( "<word>" )

  findInCurrent not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* find the index sub folder and push it onto task dictionary                 */
/*----------------------------------------------------------------------------*/
: pushIndexSub ( "<indexNm>" -- )
  dup checkIsIndex not if EC_NO_SUCH_INDEX false exit then
  find execute index.subDic pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the index sub folder                                                   */
/*----------------------------------------------------------------------------*/
: popIndexSub
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* find the indexes folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: pushIndexes ( -- )
  "indexes" find execute pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the indexes folder                                                     */
/*----------------------------------------------------------------------------*/
: popIndexes
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable index                                          */
/*----------------------------------------------------------------------------*/
: checkMakeIndex ( "<indexNm>" "<tableNm>" --  true | errorCode false )

  locals| tableNm indexNm |

  checkInTables not if false exit then

  tableNm checkIsTableFolder not if false exit then

  tableNm pushTable assert
  pushIndexes assert

  indexNm checkIsNotIndex not if popIndexes popTable assertInTables false exit then

  popIndexes
  popTable

  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable index folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveIndex ( "<indexNm>" "<tableNm>" -- true | errorCode false )

  locals| tableNm indexNm |

  // should be in the tables folder
  checkInTables       not if false exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if false exit then

  true ( "<indexNm>" true )
;

/*----------------------------------------------------------------------------*/
/* tidy up of the index                                                       */
/*----------------------------------------------------------------------------*/
: indexTidyUp ( "<indexNm>" -- )

"indextdyup" .
dup .
   find execute ( ^indexPtr )

   // truncate the index
   dup index.truncate
   
   // forget all column names
   dup index.subDic
   pathPush
   "columns" find execute forgetAll
   pathDrop

  // forget the sub dictionary
   index.subDic forgetAll
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* analyze an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyzeIndex allParticipants 2 returnResult ( detailed "<indexNm>" -- true n# true )

  tp: analyzeIndex

  find execute
  index.analyze

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* get index pointer and put into task.seitf.currentIndex                     */
/*----------------------------------------------------------------------------*/
: getIndex ( "<indexNm>" -- <R> )

  checkInIndexes not if drop false exit then

  // get index ptr
  findInCurrent execute

  task::this task.seitf@ seitf.indexGet

  true
;

/*----------------------------------------------------------------------------*/
/* clear task.seitf.currentIndex                                              */
/*----------------------------------------------------------------------------*/
: returnIndex ( )

  task::this task.seitf@ seitf.indexReturn

  true
;


/*----------------------------------------------------------------------------*/
/* make_index (invoked from makeIndex)                                        */
/*----------------------------------------------------------------------------*/
: make_index ( "<tableNm>" "<indexNm>" -- )

  0 0 locals| indexPtr tablePtr indexNm tableNm |

  pushIndexes

  // create the index
  indexNm ( "<indexNm>" )
  :index ( ^index )

  // drop the index word
  drop (  )

  // make index columns
  indexNm "makeIndexColumns" find execute

  indexNm ( "<indexNm>" )

  // find the index
  find execute ( ^index )
  to indexPtr

  // find the table
  tableNm find execute
  to tablePtr

  // push the table and index
  tablePtr indexPtr ( ^index ^table )

  // set the table in the index
  index.table! (  )

  // add the index in the table
  indexPtr tablePtr table.addIndex

  popIndexes
;

/*----------------------------------------------------------------------------*/
/* make an index (run by participant)                                         */
/*----------------------------------------------------------------------------*/
: makeIndex allParticipants 2 checkResult ( "<tableNm>" "<indexNm>"  -- true n# true )

tp: makingIndex

  locals| indexNm tableNm |

  args.tracepoint if
  "MAKING INDEX " indexNm str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  tableNm ( "<tableNm>" )
  find execute pathPush

  tableNm indexNm make_index

  popTable

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by keySelectIndex request)    */
/*----------------------------------------------------------------------------*/
: keySelectIdxTask ( <"key>" "<lower>" "<upper>" ^indexPtr seitf -- )

  0 0 0 locals| entry tempEntryBuffer indexBuffer seitf indexPtr upper lower key |

  tp: keySelectIdx

  seitf task::this task.seitf!

  // create a temporary index buffer for the results
 "Creating a tempIndexBuffer" .
  indexPtr entryBuffer::create to tempEntryBuffer

  // get the indexBuffer looking for the key
  key indexPtr index.buffer ( indexBuffer )
  to indexBuffer

  // position in the index buffer at the key
  key indexBuffer indexPtr index.position
  to entry

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    "Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    "Appending tempEntryBuffer to buffer queue" .
    tempEntryBuffer seitf seitf.bufferQueue@ queue.append

    exit
  then

  // iterate thru the buffer till no key match
  begin
    entry
    while

    // check if exact key match
    key indexPtr entry entry.matches if

      // insert row from entry in tempEntryBuffer
      "Inserting row into tempEntryBuffer" .
      indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        "Inserting row into tempEntryBuffer" .
        tempEntryBuffer seitf seitf.bufferQueue@ queue.append

        // create another temporary index buffer for the results
        "Creating a tempIndexBuffer" .
        indexPtr entryBuffer::create to tempEntryBuffer

        // insert row from entry in temporary buffer
        "Inserting row into tempEntryBuffer" .
        indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry indexBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current indexBuffer
        indexBuffer entryBuffer.nextBuffer to indexBuffer

        indexBuffer if
          entry indexBuffer entryBuffer.nextEntry to entry
        then
      then
    else
      // entry did not match the key, null the entry and break from loop
      0  to entry
    then
  repeat

  "Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  "Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer seitf seitf.bufferQueue@ queue.append
;

/*----------------------------------------------------------------------------*/
/* make an index (run by participant)                                         */
/*----------------------------------------------------------------------------*/
: loadIndexes allParticipants 0 checkResult ( -- true n# true )

tp: loadIndexes

  args.tracepoint if
    "LOADING INDEXES on NODE " grid.thisNode@ >str str.cat .
  then

  "indexes"
  find execute pathPush

  0 pathPick dic.lastWord dup
    iterate
    object@ word.name
    find execute ( ^index )

    // populate only non-hidden indexes
    dup index.isHidden@ not if
      index.populate
    then

    object@ word.prev object!
  next

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: lowerSelectIdxTask ( <"key>" "<lower>" "<upper>" ^indexPtr seitf -- )

  0 0 0 locals| entry tempEntryBuffer indexBuffer seitf indexPtr upper lower key |

  tp: lowerSelectIdxTask

  seitf task::this task.seitf!

  // create a temporary index buffer for the results
  "Creating a tempIndexBuffer" .
  indexPtr entryBuffer::create to tempEntryBuffer

  // get the indexBuffer looking for the lower key
  lower indexPtr index.buffer ( indexBuffer )
  to indexBuffer

  // position in the index buffer at the lower key
  lower indexBuffer indexPtr index.position
  to entry

  // did we find an entry ?
  entry not if
    
    // mark this buffer as the last buffer
    "Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    "Appending tempEntryBuffer to buffer queue" .
    tempEntryBuffer seitf seitf.bufferQueue@ queue.append

    exit
  then

  // iterate thru the buffer till no more entries
  begin
  entry
  while
    
    // insert row from entry in tempEntryBuffer
    //"Inserting row into tempEntryBuffer" .
    indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow

    // check if we managed to insert the entry
    not if
      // buffer must be full
      // put this tempEntryBuffer in seitf bufferQueue
      //"Inserting row into tempEntryBuffer" .
      tempEntryBuffer seitf seitf.bufferQueue@ queue.append

      // create another temporary index buffer for the results
      "Creating a tempIndexBuffer" .
      indexPtr entryBuffer::create to tempEntryBuffer

      // insert row from entry in temporary buffer
      //"Inserting row into tempEntryBuffer" .
      indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow
      assert
    then

    // move to next entry in the buffer
    entry indexBuffer entryBuffer.nextEntry to entry

    entry not if
      // get next buffer from the current indexBuffer
      indexBuffer entryBuffer.nextBuffer to indexBuffer

      indexBuffer if
        entry indexBuffer entryBuffer.nextEntry to entry
      then
    then

  repeat

  "Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  "Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer seitf seitf.bufferQueue@ queue.append
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: rangeSelectIdxTask ( <"key>" "<lower>" "<upper>" ^indexPtr seitf -- )

  0 0 0 locals| entry tempEntryBuffer indexBuffer seitf indexPtr upper lower key |

  tp: rangeSelectIdxTask

  seitf task::this task.seitf!

  // create a temporary index buffer for the results
  "Creating a tempIndexBuffer" .
  indexPtr entryBuffer::create to tempEntryBuffer

  // get the indexBuffer looking for the lower key
  lower indexPtr index.buffer ( indexBuffer )
  to indexBuffer

  // position in the index buffer at the lower key
  lower indexBuffer indexPtr index.position
  to entry

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    "Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    "Appending tempEntryBuffer to buffer queue" .
    tempEntryBuffer seitf seitf.bufferQueue@ queue.append

    exit
  then

  // iterate thru the buffer till no more entries
  begin
  entry
  while

    // check against upper bound
    upper entry indexPtr index.upper if

      // insert row from entry in tempEntryBuffer
      //"Inserting row into tempEntryBuffer" .
      indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        //"Inserting row into tempEntryBuffer" .
        tempEntryBuffer seitf seitf.bufferQueue@ queue.append

        // create another temporary index buffer for the results
        "Creating a tempIndexBuffer" .
        indexPtr entryBuffer::create to tempEntryBuffer

        // insert row from entry in temporary buffer
        //"Inserting row into tempEntryBuffer" .
        indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry indexBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current indexBuffer
        indexBuffer entryBuffer.nextBuffer to indexBuffer

        indexBuffer if
         entry indexBuffer entryBuffer.nextEntry to entry
        then
      then
    else
      // entry beyond upper, null the entry and break from loop
      0  to entry
    then
  repeat

  "Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  "Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer seitf seitf.bufferQueue@ queue.append
;

/*----------------------------------------------------------------------------*/
/* select for index ( called by lower_select_index request)                   */
/*----------------------------------------------------------------------------*/
: selectIndex ( "<key>" "<lower>" "<upper>" "<selectTaskRequest>" "<index>" --  )

  tp: selectIndex
  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //
  //assert::stack_5

  0 0 0 0 0 0 locals| seitf selectTask rowCount indexBuffer entry
    indexPtr indexNm selectTaskRequest upper lower key |

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  groupBy::new locals| pGroupBy |
  pGroupBy groupBy.start

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  // increment query count
  queryCount ++

  // push indexes
  pushIndexes assert

  // find the index
  indexNm find execute ( index^ )
  to indexPtr

  args.metadata if
  metadata@ "metadata: %v\n" str.format .put
  then

  task::this task.seitf@ to seitf

  // create the buffer queue in the seitf
  //"selectTask.queue" queue::new execute task::this task.seitf@ seitf.bufferQueue!
  "selectTask.queue" queue::new seitf seitf.bufferQueue!

  // for each slot
  grid.slots 0
  do

    args.metadata not if
    I grid::toPartition "Partition: %v\n" str.format .put
    then

    // put the partition in this tasks seitf
    I seitf seitf.partition!

    // create a selectTask to execute the key select on the index for the partition
    key lower upper indexPtr seitf 5
      selectTaskRequest nullptr "selectTask" TK_SELECT_PART spawnServerActor
        to selectTask

    1
    begin
    while  // first while
      
      begin
        // attempt to pop buffer off the tasks buffer queue
        seitf seitf.bufferQueue@  queue.pop ( value true | false )

        // try again if no value
        not while
          //REQUST_LOOP2
          //task.yield
        args.sleep thread.sleep_ms
      repeat
      to indexBuffer

      // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +
      indexBuffer pGroupby groupBy.applyBuffer
      // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

      "Popped tempEntryBuffer from buffer queue" .
      indexBuffer entryBuffer.firstEntry to entry

      begin
        entry
        while // second while
          
          //"Get an entry from the tempEntryBuffer" .
          display@ if
            args.metadata if
              entry entry.embeddedRow
              I grid::toPartition
              "row: (%v '%v')\n" str.format .put
            else
              entry entry.embeddedRow "\n" str.cat .put
            then
          then
          1 rowCount + to rowCount
          entry indexBuffer entryBuffer.nextEntry to entry
      repeat  // end of second while

      indexBuffer entryBuffer.isLast@ if
        "Reached last buffer" .
        0
      else
        1  // no more entries, move to next buffer
      then

      indexBuffer entryBuffer.delete
      "Deleted buffer" .
    repeat  // end of first while
  loop

  // delete the buffer queue from the seitf
  seitf seitf.bufferQueue@ queue.delete
  0 seitf seitf.bufferQueue!

  // pop indexes
  popIndexes

  args.metadata if
    rowCount seitf seitf.rowsProcessed
  else
    "rows selected"  rowCount "%v %v\n" str.format .put
  then

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +

  pGroupBy groupBy.end
  pGroupBy groupBy.delete

  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +
;

/*----------------------------------------------------------------------------*/
/* range select for index ( called by rangeSelectTable request)               */
/*----------------------------------------------------------------------------*/
: rangeSelectIdx2 ( ^indexPtr ^indexBuffer ^entry "<lower>" "<upper>"-- <entry> )

  0 locals| row upper lower entry indexBuffer indexPtr |

  tp: rangeSelectIdx

  indexBuffer not if
    0 to entry
  else

    entry not if
      // position in the index buffer
      lower indexBuffer indexPtr index.position
      to entry
    else
      entry indexBuffer entryBuffer.nextEntry to entry
    then

    entry not if

      // we may not find an entry , so need to move to next buffer
      indexBuffer entryBuffer.nextBuffer to indexBuffer

      indexBuffer not if
        0 to entry
      else
        // get next entry from the current indexBuffer
        entry indexBuffer entryBuffer.nextEntry to entry
      then
    then

  then

  // return indexBuffer and entry
  indexBuffer entry

;

/*----------------------------------------------------------------------------*/
/* range select cursor for index ( called by range_select_index request)      */
/*----------------------------------------------------------------------------*/
: rangeSelectIndex2 ( "<upper>" "<lower>" "<index>" --  )

  tp: rangeSelectIndex2

  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //
  assert::stack_3

  0 0 0 0 locals| rowCount indexBuffer entry indexPtr indexNm lower upper |

  // increment query count
  queryCount ++

  // push indexes
  pushIndexes assert

  // find the index
  indexNm find execute ( index^ )
  to indexPtr

  args.metadata if
    metadata@ "metadata: %v\n" str.format .put
  then

  // for each slot
  grid.slots 0
  do

    args.metadata not if
      I grid::toPartition "Partition: %v\n" str.format .put
    then

    // put the partition in this tasks seitf
    I task::this task.seitf@ seitf.partition!

    // get the indexBuffer at the lowerBound
    lower indexPtr index.buffer ( indexBuffer )
    to indexBuffer

    1
    begin

      while

      indexPtr indexBuffer entry lower upper
      rangeSelectIdx2  ( indexPtr indexBuffer entry lower upper )
      to entry
      to indexBuffer

      // check if entry is null ?
      entry if
        // check against upper bound
        upper entry indexPtr index.upper
        if
          display@ if
            args.metadata if
              indexPtr entry entry.row row.string
              I grid::toPartition
              "row: (%v '%v')\n" str.format .put
            else
              indexPtr entry entry.row row.string "\n" str.cat .put
            then
          then
          1 rowCount + to rowCount
          1
        else
          0 to entry
          0
        then
      else
        0
      then

    repeat

  loop

  // pop indexes
  popIndexes

  args.metadata if
    rowCount task::this task.seitf@ seitf.rowsProcessed
  else
    "rows selected"  rowCount "%v %v\n" str.format .put
  then
;

/*----------------------------------------------------------------------------*/
/* position scan select cursor for table (called by scanSelectIndex request)*/
/*----------------------------------------------------------------------------*/
: scanSelectIdx ( ^indexPtr ^indexBuffer ^entry -- <entry> )

  0 locals| row entry indexBuffer indexPtr |

  tp: scanSelectIdx

  indexBuffer not if
    0 to entry
  else

    entry not if
      // position in the index buffer
      indexBuffer entryBuffer.firstEntry
      to entry
    else
      // get next entry from the current indexBuffer
      entry indexBuffer entryBuffer.nextEntry to entry
    then

    entry not if
      // we may not find an entry , so need to move to next buffer
      indexBuffer entryBuffer.nextBuffer to indexBuffer

      indexBuffer not if
        0 to entry
      else
        entry indexBuffer entryBuffer.nextEntry to entry
      then
    then

  then

  // return indexBuffer and entry
  indexBuffer entry

;


/*----------------------------------------------------------------------------*/
/* scan select for index ( called by scan_select_index request)               */
/*----------------------------------------------------------------------------*/
: scanSelectIndex2 ( "<index>" --  )

  "scanSelectIndex (a)" .

  tp: scanSelectIndex
  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //

  assert::stack_1

  0 0 0 0 locals| rowCount indexBuffer entry indexPtr sIndexNm |

  "scanSelectIndex (b)" .

  // increment query count
  queryCount ++

  // push indexes
  pushIndexes assert

  // find the index
  sIndexNm find execute ( index^ )
  to indexPtr

  args.metadata if
    metadata@ "metadata: %v\n" str.format .put
  then

  // for each slot
  grid.slots 0
  do
    args.metadata not if
      I grid::toPartition "Partition: %v\n" str.format .put
    then

    // put the partition in this tasks seitf
    I task::this task.seitf@ seitf.partition!

    // get the first indexBuffer
    indexPtr index.positionFirst ( indexBuffer )
    to indexBuffer

    1
    begin

      while

      indexPtr indexBuffer entry
      scanSelectIdx  ( indexPtr indexBuffer entry )
      to entry
      to indexBuffer

      // check if entry is null ?
      entry if
        display@ if
          args.metadata if
            indexPtr entry entry.row row.string
            I grid::toPartition
            "row: (%v '%v')\n" str.format .put
          else
            indexPtr entry entry.row row.string "\n" str.cat .put
          then
        then
          1 rowCount + to rowCount
          1
      else
        // null entry means done with this partition
      0
      then

    repeat

  loop

  // pop indexes
  popIndexes

  args.metadata if
    rowCount task::this task.seitf@ seitf.rowsProcessed
  else
    "rows selected"  rowCount "%v %v\n" str.format .put
  then
;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: scanSelectIdxTask ( <"key>" "<lower>" "<upper>" ^indexPtr seitf -- )

  0 0 0 locals| entry tempEntryBuffer indexBuffer seitf indexPtr upper lower key |

  tp: scanSelectIdxTask

  seitf task::this task.seitf!

  // create a temporary index buffer for the results
  "Creating a tempIndexBuffer" .
  indexPtr entryBuffer::create to tempEntryBuffer

  // position in the first index buffer
  indexPtr index.positionFirst
  to indexBuffer

  // get the first entry in the buffer
  indexBuffer entryBuffer.firstEntry
  to entry

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    "Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    "Appending tempEntryBuffer to buffer queue" .
    tempEntryBuffer seitf seitf.bufferQueue@ queue.append

    exit
  then

  // iterate thru the buffer till no more entries
  begin
  entry
  while
      // insert row from entry in tempEntryBuffer
      //"Inserting row into tempEntryBuffer" .
      indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        //"Inserting row into tempEntryBuffer" .
        tempEntryBuffer seitf seitf.bufferQueue@ queue.append

        // create another temporary index buffer for the results
        "Creating a tempIndexBuffer" .
        indexPtr entryBuffer::create to tempEntryBuffer

        // insert row from entry in temporary buffer
        //"Inserting row into tempEntryBuffer" .
        indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry indexBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current indexBuffer
        indexBuffer entryBuffer.nextBuffer to indexBuffer

        indexBuffer if
          entry indexBuffer entryBuffer.nextEntry to entry
        then
      then
    repeat

  "Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  "Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer seitf seitf.bufferQueue@ queue.append
;

/*----------------------------------------------------------------------------*/
/* remove an index                                                            */
/*----------------------------------------------------------------------------*/
: removeIndex allParticipants 1 checkResult ( "<indexNm>" -- true n# true )

  tp: removeIndex
  locals| indexNm |

  indexNm dup .
  // forward reference :-(
  "indexTidyUp" find execute

  indexNm :forget

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* set isUnique property of index                                             */
/*----------------------------------------------------------------------------*/
: setIndexIsUnique allParticipants 2 checkResult ( "<indexNm>" true/false -- )

  assert::stack_2

  locals| sIndexNm bIsUnique |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  bIsUnique ( bIsUnique )

    sIndexNm find execute ( bIsUnique index^ )

  index.isUnique! ( )

  assert::stack_0

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* get size of index                                                          */
/*----------------------------------------------------------------------------*/
: sizeIndex ( "<indexNm>" -- "<size>" )

  find execute ( index^ )

  index.space 0 swap number.magnitude >str
;

/*----------------------------------------------------------------------------*/
/* position for upper select for table (called by upperSelectIndex request)   */
/*----------------------------------------------------------------------------*/
: upperSelectIdx2 ( ^indexPtr ^indexBuffer ^entry -- <entry> )

  0 locals| row entry indexBuffer indexPtr |

  tp: upperSelectIdx

  indexBuffer not if
    0 to entry
  else

    entry not if
     // position in the index buffer
     indexBuffer entryBuffer.firstEntry
     to entry
   else
      // get next entry from the current indexBuffer
      entry indexBuffer entryBuffer.nextEntry to entry
    then

    entry not if
      // we may not find an entry , so need to move to next buffer
      indexBuffer entryBuffer.nextBuffer to indexBuffer

      indexBuffer not if
        0 to entry
      else
        entry indexBuffer entryBuffer.nextEntry to entry
      then
    then

  then

  // return indexBuffer and entry
  indexBuffer entry

;

/*----------------------------------------------------------------------------*/
/* position key select cursor for table (called by selectIndex request)       */
/*----------------------------------------------------------------------------*/
: upperSelectIdxTask ( <"key>" "<lower>" "<upper>" ^indexPtr seitf -- )

  0 0 0 locals| entry tempEntryBuffer indexBuffer seitf indexPtr upper lower key |

  tp: rangeSelectIdxTask

  seitf task::this task.seitf!

  // create a temporary index buffer for the results
  "Creating a tempIndexBuffer" .
  indexPtr entryBuffer::create to tempEntryBuffer

  // position in the first index buffer
  indexPtr index.positionFirst
  to indexBuffer

  // get the first entry in the buffer
  indexBuffer entryBuffer.firstEntry
  to entry

  // did we find an entry ?
  entry not if

    // mark this buffer as the last buffer
    "Marking tempEntryBuffer as last buffer" .
    tempEntryBuffer entryBuffer.isLast!

    // return the empty tempEntryBuffer
    "Appending tempEntryBuffer to buffer queue" .
    tempEntryBuffer seitf seitf.bufferQueue@ queue.append

    exit
  then

  // iterate thru the buffer till no more entries
  begin
  entry
  while

    // check against upper bound
    upper entry indexPtr index.upper if

      // insert row from entry in tempEntryBuffer
      //"Inserting row into tempEntryBuffer" .
      indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow

      // check if we managed to insert the entry
      not if
        // buffer must be full
        // put this tempEntryBuffer in seitf bufferQueue
        //"Inserting row into tempEntryBuffer" .
        tempEntryBuffer seitf seitf.bufferQueue@ queue.append

        // create another temporary index buffer for the results
        "Creating a tempIndexBuffer" .
        indexPtr entryBuffer::create to tempEntryBuffer

        // insert row from entry in temporary buffer
        //"Inserting row into tempEntryBuffer" .
        indexPtr entry entry.row row.string tempEntryBuffer entryBuffer.insertRow
        assert
      then

      // move to next entry in the buffer
      entry indexBuffer entryBuffer.nextEntry to entry

      entry not if
        // get next buffer from the current indexBuffer
        indexBuffer entryBuffer.nextBuffer to indexBuffer

        indexBuffer if
          entry indexBuffer entryBuffer.nextEntry to entry
        then
      then
    else
      // entry beyond upper, null the entry and break from loop
      0  to entry
    then
  repeat

  "Marking tempEntryBuffer as last buffer" .
  // mark this buffer as the last buffer
  tempEntryBuffer entryBuffer.isLast!

  // put the buffer in the seitf bufferQueue
  "Appending tempEntryBuffer to buffer queue" .
  tempEntryBuffer seitf seitf.bufferQueue@ queue.append
;

/*----------------------------------------------------------------------------*/
/* upper select for index ( called by lower_select_index request)             */
/*----------------------------------------------------------------------------*/
: upperSelectIndex ( "<upper>" "<index>" --  )

  tp: upperSelectIndex
  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //
  assert::stack_2

  0 0 0 0 locals| rowCount indexBuffer entry indexPtr indexNm upper |

  // increment query count
  queryCount ++

  // push indexes
  pushIndexes assert

  // find the index
  indexNm find execute ( index^ )
  to indexPtr

  args.metadata if
    metadata@ "metadata: %v\n" str.format .put
  then

  // for each slot
  grid.slots 0
  do

    args.metadata not if
      I grid::toPartition "Partition: %v\n" str.format .put
    then

    // put the partition in this tasks seitf
    I task::this task.seitf@ seitf.partition!

    // get the first indexBuffer
    indexPtr index.positionFirst ( indexBuffer )
    to indexBuffer

    1
    begin

      while

      indexPtr indexBuffer entry
      upperSelectIdx2  ( indexPtr indexBuffer entry upper )
      to entry
      to indexBuffer

      // check if entry is null ?
      entry if
        // check against upper bound
        upper entry indexPtr index.upper
        if

          display@ if
            args.metadata if
              indexPtr entry entry.row row.string
              I grid::toPartition
              "row: (%v '%v')\n" str.format .put
            else
              indexPtr entry entry.row row.string "\n" str.cat .put
            then
          then
          1 rowCount + to rowCount
          1
        else
          0 to entry
          0
        then
      else
       0
      then

    repeat

  loop

  // pop indexes
  popIndexes

  args.metadata if
    rowCount task::this task.seitf@ seitf.rowsProcessed
  else
    "rows selected"  rowCount "%v %v\n" str.format .put
  then
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
