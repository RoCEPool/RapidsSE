/*============================================================================*/
/* index.sen -- index related words                                           */
/*============================================================================*/

"index.sen" .verbose

/*----------------------------------------------------------------------------*/
/* index is use as a kind of word to identify indexes                          */
/*----------------------------------------------------------------------------*/
: index ;

/*----------------------------------------------------------------------------*/
/* make an indexes folder under given named table                             */
/*----------------------------------------------------------------------------*/
: makeIndexes ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING INDEXES FOR TABLE " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  find execute ( dic )
  "indexes"     ( dic "indexes" )
  swap         ( "indexes" dic )
  :folder      ( )
;

: isIndex word.kind@ ' index eql ;

/*----------------------------------------------------------------------------*/
/* create an index using name from input stream (doesnt leave index on stk)   */
/*----------------------------------------------------------------------------*/
: index:

  create
  WT_OBJECT word.this word.type!
  sizeof_index allot
  word.this >body object.magic!
  CN_INDEX word.this >body object.class!
  word.this >body index.init
  true word.this >body object.wordbody!
  ' index word.this word.kind!
  does>
;

/*----------------------------------------------------------------------------*/
/* create an index using name on the stack (leaves index on stack)             */
/*----------------------------------------------------------------------------*/
: :index

  >create
  WT_OBJECT word.this word.type!
  sizeof_index allot
  word.this >body object.magic!
  CN_INDEX word.this >body object.class!
  word.this >body index.init
  true word.this >body object.wordbody!
  ' index word.this word.kind!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* check within indexes folder                                                */
/*----------------------------------------------------------------------------*/
: withinIndexes

  0 pathPick dic.name "indexes" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in indexes                                                           */
/*----------------------------------------------------------------------------*/
: checkInIndexes

  withinIndexes if true exit then

  EC_NOT_IN_INDEXES false
;

/*----------------------------------------------------------------------------*/
/* check word is an index                                                     */
/*----------------------------------------------------------------------------*/
: checkIsIndex ( "<indexNm>" -- "<indexNm>" true | errorCode false )

  dup ( "<indexNm>" "<indexNm>" )

  find ( "<indexNm>" ^w:index )

  dup ( "<indexNm>" ^w:index ^w:index )
  not ( "<indexNm>" ^w:index bool )
  if
    drop ( "<indexNm>" )
    drop ( )
    EC_NO_SUCH_INDEX false ( errorCode false )
  exit
  then

  dup ( "<indexNm>" ^w:index ^w:index )

  word.kind@ ( "<indexNm>" ^w:index ^word )
  ' index ( "<indexNm>" ^w:index ^word ^word )
  eql ( "<indexNm>" ^w:index bool )
  if
    drop ( "<indexNm>" )
    true ( "<indexNm>" true )
    exit
  then

  drop ( "<indexNm>" )
  drop ( )
  EC_NOT_AN_INDEX false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check word is not an index                                                 */
/*----------------------------------------------------------------------------*/
: checkIsNotIndex ( word )
  dup findInCurrent not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
: pushIndex ( "<indexNm>" -- )

  checkIsIndex not if EC_NO_SUCH_INDEX false exit then

  find execute pathPush

  true
;

/*----------------------------------------------------------------------------*/
: popIndex
    pathDrop
;

/*----------------------------------------------------------------------------*/
: pushIndexSub ( "<indexNm>" -- )

  checkIsIndex not if EC_NO_SUCH_INDEX false exit then

  find execute index.subDic pathPush

  true
;

/*----------------------------------------------------------------------------*/
: popIndexSub
  pathDrop
;

/*----------------------------------------------------------------------------*/
/*
: getIndexRef ( "<indexNm>" -- <R> )

  checkInIndex not if false exit then

  checkIsIndex not if EC_NO_SUCH_INDEX false exit then

  find execute ( index )

  task.this task.seitf@ seitf.indexRef

    true
;

?*----------------------------------------------------------------------------*?
: returnIndexRef ( )

  task.this task.seitf@ seitf.indexRef

  true
;
*/

/*----------------------------------------------------------------------------*/
/* any outstanding index references                                           */
/*----------------------------------------------------------------------------*/
: IndexInUse ( "<indexNm>" -- <R> )

  find execute

  //index.ref
  if true else false then
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable table                                          */
/*----------------------------------------------------------------------------*/
: checkMakeIndex ( "<indexNm>" -- "<indexNm>" true | "<indexNm>" errorCode false )

  //checkInIndexes  not if false exit then
  checkIsNotIndex not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable index folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveIndex ( "<indexNm>" -- "<indexNm>" true | "<indexNm>" errorCode false )

  checkInIndexes not if false exit then ( "<indexNm>" )
  checkIsIndex not if false exit then ( "<indexNm>" )
  //dup indexInUse if EC_INDEX_IN_USE false exit then ( "<indexNm>" )

  true ( "<indexNm>" true )
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* make an index (run by participant)                                         */
/*----------------------------------------------------------------------------*/
: makeIndex allParticipants 2 checkResult ( "<tableNm>" "<indexNm>"  -- true n# true )

tp: makingIndex

  0 0 locals| indexPtr tablePtr indexNm tableNm |

  args.tracepoint if
  "MAKING INDEX " indexNm str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  tableNm ( "<tableNm>" )
  find execute pathPush

  indexNm ( "<indexNm>" )

  "indexes"
  find execute pathPush

  // create the index
  :index ( ^index )

  // drop the index word
  drop (  )

  // make index columns
  indexNm "makeIndexColumns" find execute

  indexNm ( "<indexNm>" )

  // find the index
  find execute ( ^index )
  to indexPtr

  // find the table
  tableNm find execute
  to tablePtr

  // push the table and index
  tablePtr indexPtr ( ^index ^table )

  // set the table in the index
  index.table! (  )

  // add the index in the table
  //index table table.addIndex

  // now populate the index
  indexPtr ( ^index )
  index.populate

  true <SUCCESS_RESULT>
;


/*----------------------------------------------------------------------------*/
/* make an index (run by participant)                                         */
/*----------------------------------------------------------------------------*/
: loadIndexes allParticipants 0 checkResult ( -- true n# true )

tp: loadIndexes

  args.tracepoint if
    "LOADING INDEXES on NODE " grid.thisNode@ >str str.cat .
  then

  "indexes"
  find execute pathPush

  0 pathPick dic.lastWord dup
    iterate
    object@ word.name
    find execute ( ^index )
    index.populate
    object@ word.prev object!
  next

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* remove an index                                                            */
/*----------------------------------------------------------------------------*/
: removeIndex allParticipants 1 checkResult ( "<indexNm>" -- true n# true )

  tp: removeIndex
  locals| indexNm |

  indexNm find execute ( ^index )

  dup ( ^index ^index )

  // forget the columns dictionary in the table sub-dictionary
  index.subDic forgetAll

  index.truncate

  indexNm :forget

  true <SUCCESS_RESULT>
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
