/*============================================================================*/
/* job_ScanOp.sen -- Job ScanOp                                               */
/*============================================================================*/

" job_ScanOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* scanOp request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scanOp_req ( -- )

  >>logEntry <SEED_REQ>

  0 locals| pTable |

  job::this locals| pJob_ScanOp |
  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> <nextOp> op.nextStage!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_PULSEMARKER of

        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut

        // new a stream def
        Operand[].newStreamDef
        Operand[].pipeOut

        // pipeout all subsets from tablePtn
        tablePtn[].root to Subset[]
        Subset[]@ to Operand[]
        begin
          Operand[].isNull
        not while
          Operand[].pipeOut
          Subset[].nextBuffer to Operand[]
        repeat

        Operand[].newEosMarker
        Operand[].pipeOut
        true

      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose

        // check if we can scan the table
        sTableNm checkIsValidTable not if
          op.pipelineJob@ <ERROR_JOB> !!logError
          Operand[].delete
          Operand[].newErrorMarker
        else

          // move to table folder and find the table and tablePtn
          sTableNm pushTable assert
          sTableNm find execute to table[]
          table[].tablePtn@ to tablePtn[]
        then

        Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        "Operand:- ZK_STOPMARKER*****" .verbose
        popTable
        Operand[].pipeOut
        Op.ackPipelineJob
        false
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: scanOp :: scanOp <tableNm> <topology> <nextStage> <nextOp> ;

jobInfo: scanOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SCANOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
