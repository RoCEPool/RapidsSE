/*============================================================================*/
/* job_ScanOp.sen -- Job ScanOp                                               */
/*============================================================================*/

" job_ScanOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a scannable table folder                                  */
/*----------------------------------------------------------------------------*/
: checkScanTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if drop EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* scanOp request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scanOp_req ( -- )

  >>logEntry <SEED_REQ>

  job::this locals| pJob_ScanOp |
  0 0 locals| sTableNm pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_PULSEMARKER of

        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut

        // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        // move to table folder and find the table and tablePtn
        sTableNm pushTable assert
        sTableNm find execute to table[]

        pJob_ScanOp table[].tablePtn@ to tablePtn[]

        // new a stream def
        Operand[].newStreamDef
        Operand[].pipeOut

        // pipeout all subsets from tablePtn
        tablePtn[].root to Subset[]
        Subset[]@ to Operand[]
        begin
        Operand[].isNull
        not while
        Operand[].pipeOut
        Subset[].nextBuffer to Operand[]
        repeat

        Operand[].newEosMarker
        Operand[].pipeOut
        popTable
        true

      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        // check if we can scan the table
        <tableNm> to sTableNm
        sTableNm checkScanTable not if
          op.pipelineJob@ <ERROR_JOB>
          Operand[].delete
          Operand[].newErrorMarker
        then
        Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        "Operand:- ZK_STOPMARKER*****" .verbose
        Operand[].handleEnd
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: scanOp :: scanOp <tableNm> ;

jobInfo: scanOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SCANOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
