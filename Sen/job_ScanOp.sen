/*============================================================================*/
/* job_ScanOp.sen -- Job ScanOp                                               */
/*============================================================================*/

" job_ScanOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : scan_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_ScanOp |

   tp: scanOp_run

   pJob_ScanOp job.opLoop

   //pJob_ScanOp job::participantExecuted

  <<logExit <DONE_RUN>
;

: scan_rcv ( -- )
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: scan :: scan;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobInfo: scan
{
  jobKind      = JK_CHILD
  responseKind = RS_NODE_ZERO
  
  exeLock      = DL_GRAB_READ
  preCheck     = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
