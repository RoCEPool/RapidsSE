/*============================================================================*/
/* job_ScanOp.sen -- Job ScanOp                                               */
/*============================================================================*/

" job_ScanOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a scannable table folder                                  */
/*----------------------------------------------------------------------------*/
: checkScanTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* execute for scanOp                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : scan_req ( -- )
 
  >>logEntry <SEED_REQ>

  job::this locals| pJob_ScanOp |
  0 0 locals| sTableNm pTable |


  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can scan the table
  //pJob_ScanOp job.objectName@ to sTableNm
  <tableNm> to sTableNm

  sTableNm checkScanTable not if
    pJob_ScanOp <ERROR_JOB> !!logError
  else

    //----------------------------------------------------------------------------
    // move to table folder
    sTableNm pushTable assert

    //----------------------------------------------------------------------------
    // find the table
    sTableNm find execute pJob_ScanOp job.opTable!
  then

  pJob_ScanOp job.opLoop

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: scan :: scan ;

jobInfo: scan
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SCANOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
