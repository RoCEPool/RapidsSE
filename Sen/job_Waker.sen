/*============================================================================*/
/* job_Waker.sen -- Waker Job                                                 */
/*============================================================================*/

" job_Waker.sen" .verbose

/*----------------------------------------------------------------------------*/
/* waker loop:                                                                */
/*----------------------------------------------------------------------------*/
: waker_req ( -- )

  std_entryHook

  begin

    1 thread::sleepSsec

    // "checking..." .

    queues::checkSleeping

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: waker :: waker ;

jobInfo: waker
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NONE
  <?ddlLock?>  = DL_NONE
  
  //<?preCheck?> = bClusterStarted
  
  <?cmdKind?>  = CK_SERVICE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
