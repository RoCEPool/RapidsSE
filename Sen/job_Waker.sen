/*============================================================================*/
/* job_Waker.sen -- Waker Job                                                 */
/*============================================================================*/

" job_Waker.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the waker job                                                        */
/*----------------------------------------------------------------------------*/
: spawn_Waker ( -- )

  0 locals| pJobClass_Waker |
  0 locals| pJob_Waker |

  CN_JOB_WAKER jobClass::find to pJobClass_Waker

  nullptr pJobClass_Waker jobClass.new to pJob_Waker

  pJob_Waker SEED_RUN job.spawn
;

/*----------------------------------------------------------------------------*/
/* waker loop:                                                                */
/*----------------------------------------------------------------------------*/
: waker_run ( -- )

  >>am <SEED_RUN>

  begin

    1 thread::sleepSsec

    // "checking..." .

    queues::checkSleeping

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
