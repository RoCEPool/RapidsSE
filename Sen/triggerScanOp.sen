/*============================================================================*/
/* triggerScanOp.sen -- flow trigger operator                                 */
/*============================================================================*/

"triggerScanOp.sen" .verbose
common/ triggerScan rbCrs /
/*----------------------------------------------------------------------------*/
/* trigger                                                                    */
/*----------------------------------------------------------------------------*/
: triggerScanPlan ( profile plan -- )

  // record the plan and profile
  locals| thePlan profile |
  0 locals| partitionId |

  //thePlan plan.id@ "Triggering plan: %v" str.format .

  // trigger scanOp by piping the plan to it
  grid.slots 0 do

    I grid::toPartition to partitionid

    // << profile plan >> -->> nextOp
    << partitionid "scanOp#%v" str.format thePlan plan.id@ "scanOp.task" >>jobQueue
  loop
;

/*----------------------------------------------------------------------------*/
/* triggerPlan_distributed                                                    */
/*----------------------------------------------------------------------------*/
: triggerScanPlan_distributed subDic triggerScan ( profile plan -- )

  // record the plan and profile
  locals| thePlan profile sNextOp |

  //thePlan plan.id@ "Triggering plan: %v" str.format .

  // trigger scanOp by piping the plan to it
  grid.partitions 0 do

  // << profile plan >> -->> nextOp
  << I "scanOp#%v" str.format thePlan plan.id@ "scanOp.task" >>jobQueue
  //<< I "rangeOp#%v" str.format thePlan plan.id@ "rangeOp.task" >>jobQueue
  loop
;

/*----------------------------------------------------------------------------*/
/* flow trigger operator loop                                                 */
/*----------------------------------------------------------------------------*/
: triggerScanOp operator ( -- NEVER )

"tp: triggerScanOp" .

  begin

    depth 0 != if "stack of task has grown" . debug::trap then

    // wait for next job
    jobQueue> ( valset )

    // unpack it
    valset> ( nextOp profile planId nValues )
    drop ( nextOp profile planId )
    // find plan using planId
    planList::findPlan ( profile plan true )
    assert ( profile plan )

    // trigger the plan
    triggerScanPlan_distributed ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
