/*============================================================================*/
/* job_Mark2Op.sen -- Mark II Operator Experiment                             */
/*============================================================================*/

" job_Mark2Op.sen" .verbose

/*----------------------------------------------------------------------------*/
/* mark2op request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : mark2op_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pMark2Op |

   begin

    // bide till next operand is available
    "bide operand" .
    pMark2Op job.bideOperand

    // pop next operand from queue into Operand[]
    "next operand" .
    pMark2Op job.nextOperand

    // decode
    Operand[].decode "Operand Kind: %v" .printf
    Operand[].decode case
      ZK_CRWBUFFER of
        "Operand:- ZK_CRWBUFFER" .
        pMark2Op job.dealOperand
        Operand[].pipeOut
      endof
      ZK_CSVBUFFER of
        "Operand:- ZK_CSVBUFFER" .
        pMark2Op job.dealOperand
        Operand[].pipeOut
      endof
      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .
        pMark2Op job.dealOperand
        // *does not pipeout*
      endof
      ZK_ENTBUFFER of
        "Operand:- ZK_ENTBUFFER" .
        pMark2Op job.dealOperand
        Operand[].pipeOut
      endof
      ZK_IRWBUFFER of
        "Operand:- ZK_IRWBUFFER" .
        pMark2Op job.dealOperand
        Operand[].pipeOut
      endof
      ZK_SRTBUFFER of
        "Operand:- ZK_SRTBUFFER" .
        pMark2Op job.dealOperand
        Operand[].pipeOut
      endof
      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .
        pMark2Op job.dealOperand
        Operand[].pipeOut
      endof
    endcase

    // process operand
    // "deal operand" .
    // pMark2Op job.dealOperand

   while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: mark2op :: mark2op ;

jobInfo: mark2op
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_OUTPUTOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
