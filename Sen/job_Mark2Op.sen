/*============================================================================*/
/* job_Mark2Op.sen -- Mark II Operator Experiment                             */
/*============================================================================*/

" job_Mark2Op.sen" .verbose

/*----------------------------------------------------------------------------*/
/* mark2op request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : mark2op_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pMark2Op |

   begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        "Operand:- ZK_CRWBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_CSVBUFFER of
        "Operand:- ZK_CSVBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .
        Operand[].handleEnd
        // *does not pipeout*
        false
      endof

      ZK_ENTBUFFER of
        "Operand:- ZK_ENTBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_IRWBUFFER of
        "Operand:- ZK_IRWBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_SRTBUFFER of
        "Operand:- ZK_SRTBUFFER" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

    endcase

   while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: mark2op :: mark2op ;

jobInfo: mark2op
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_OUTPUTOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
