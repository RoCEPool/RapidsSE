/*============================================================================*/
/* partitionModel.sen -- Partition Actor Model                                */
/*============================================================================*/

"partitionModel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* compute the number of partition threads to be created                      */
/*----------------------------------------------------------------------------*/

: nPartitionThreads ( -- nThreads )

  // 1 thread per partition
  args.partitionsPerNode locals| nThreads |

  //1 exit // temp

  nThreads 0 <= if
    1
  then

  nThreads
;

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

/*
: nPartitionThreads ( -- nThreads )

  args.regionSize C_1GB / locals| nThreads |

  //1 exit // temp

  nThreads 0 <= if
    1 to nThreads
  else
    nThreads CORE_COUNT 8 * 10 / > if
      CORE_COUNT 8 * 10 / to nThreads
    then
  then

  nThreads
;
*/

/*----------------------------------------------------------------------------*/
/* define the N_PARTITION_THREADS constant                                    */
/*----------------------------------------------------------------------------*/
nPartitionThreads constant N_PARTITION_THREADS

/*----------------------------------------------------------------------------*/
/* create and start the partition processing threads                          */
/*----------------------------------------------------------------------------*/
: >partitionThreadNm ( i -- s ) >str "partitionThread" str.prepend ;

: :partitionThread ( i -- w ) >partitionThreadNm :thread    ;

: startPartitionThreads

  0 locals| pPartitionThread |

//args.progress if
//  N_SERVER_THREADS "Partition threads: %v" str.format .
//then

  args.verbose if
    "N_PARTITION_THREADS " .put N_PARTITION_THREADS .put .\n
  then

  N_PARTITION_THREADS 0 do

    // create a thread called partitionThreadI
    I :partitionThread execute to pPartitionThread

    // set the threads name
    //I >partitionThreadNm pPartitionThread thread.name!

    // set the threads partition no
    I pPartitionThread thread.partition!

    // set the actor model
    //AC_PARTITION pPartitionThread thread.actorModel!

    //pPartitionThread thread.taskqueue@
    //  I scheduler::partition partitionScheduler.taskFifo!

    // spawn os thread
    //pPartitionThread thread.spawn_partition

  loop
;

/*----------------------------------------------------------------------------*/
/* create and dispatch task to partition for execution within given partition */
/*----------------------------------------------------------------------------*/
: spawnPartitionTask ( ... nArgs sSeed iPtnNo sTaskNm eTaskKind )

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
