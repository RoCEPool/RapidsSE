/*============================================================================*/
/* partitionModel.sen -- Partition Actor Model                                */
/*============================================================================*/

"partitionModel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* compute the number of partition threads to be created                      */
/*----------------------------------------------------------------------------*/

: nPartitionThreads ( -- nThreads )

  // 1 thread per partition
  args.partitionsPerNode locals| nThreads |

  //1 exit // temp

  nThreads 0 <= if
    1
  then

  nThreads
;

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

/*
: nPartitionThreads ( -- nThreads )

  args.regionSize C_1GB / locals| nThreads |

  //1 exit // temp

  nThreads 0 <= if
    1 to nThreads
  else
    nThreads CORE_COUNT 8 * 10 / > if
      CORE_COUNT 8 * 10 / to nThreads
    then
  then

  nThreads
;
*/

/*----------------------------------------------------------------------------*/
/* define the N_PARTITION_THREADS constant                                    */
/*----------------------------------------------------------------------------*/
nPartitionThreads constant N_PARTITION_THREADS


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
