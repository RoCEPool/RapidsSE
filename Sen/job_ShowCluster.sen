/*============================================================================*/
/* job_ShowCluster.sen -- Show Cluster                                        */
/*============================================================================*/

" job_ShowCLuster.sen" .verbose

/*----------------------------------------------------------------------------*/
/* show cluster command request                                               */
/*----------------------------------------------------------------------------*/
: showCluster_req ( -- )

  >>logEntry <SEED_REQ>

  "ShowCluster ..." .

  grid::show

  <<logExit DONE_REQ
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

opSyntax: showCluster :: showCluster ;

jobInfo: showCluster
{
  ?<jobDesc>?  = "--description of job--"
  
  ?<jobKind>?  = JK_LOCAL
  ?<rspKind>?  = RS_NONE
  ?<ddlLock>?  = DL_NONE
  
  ?<preCheck>? = bClusterStarted
}
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
