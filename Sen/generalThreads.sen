/*============================================================================*/
/* generalThreads.sen -- General Processing Threads                           */
/*============================================================================*/

"generalThreads.sen" .verbose

/*----------------------------------------------------------------------------*/
/* compute the number of general processing threads to be created             */
/*----------------------------------------------------------------------------*/
: noGeneralThreads ( memorySize -- noThreads )

  // the number of query threads is computed based on the
  // size of the region

  // there will be 1 query thread per GB
  // the number of threads will be limited to 80% of the number of cores

  C_1GB / locals| noThreads |

//1 exit // temp

  noThreads 0 <= if
    1
  else
    noThreads CORE_COUNT 8 * 10 / > if
      CORE_COUNT 8 * 10 / to noThreads
    then
  then

  noThreads
;

/*----------------------------------------------------------------------------*/
/* define the N_GENERAL_THREADS constant                                      */
/*----------------------------------------------------------------------------*/
args.regionSize noGeneralThreads constant N_GENERAL_THREADS

/*----------------------------------------------------------------------------*/
/* create and spawn the query processing threads                              */
/*----------------------------------------------------------------------------*/
: >generalThreadNm ( i -- s ) "queryThread"    swap >str str.cat ;
: :generalThread   ( i -- w ) >generalThreadNm    :thread    ;

: generalThreadsStart

  0 locals| pGeneralThread |

  args.progress if
    N_GENERAL_THREADS "General threads: %v" str.format .
  then

  args.verbose if
    "N_GENERAL_THREADS " .put N_GENERAL_THREADS .put .\n
  then

  N_GENERAL_THREADS 0 do

    // create a thread called queryThreadI
    I :generalThread execute to pGeneralThread

    // set the threads name
    I >generalThreadNm pGeneralThread thread.name!

    // give it a private taskset
    taskset::new pGeneralThread thread.taskset!

    // spawn os thread
    pGeneralThread thread.spawn_general

  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
