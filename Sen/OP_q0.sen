/*============================================================================*/
/* OP_q0.sen -- q0 testing                                                    */
/*============================================================================*/

" OP_q0.sen" .verbose

/*----------------------------------------------------------------------------*/
/* troll the kbase                                                            */
/*----------------------------------------------------------------------------*/
: q0_troll

  "Trolling..." .

  begin
    kbase[].troll
  while repeat
;

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: q0_action

  "q0 Testing" .

  "Kbase-Name" kbase[].new

  "/tmp/kbase_test.txt" kbase[].print

  kbase[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: q0 :: q0 ;

: q0 _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
