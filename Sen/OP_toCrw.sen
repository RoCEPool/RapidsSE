/*============================================================================*/
/* OP_toCrw.sen -- Operator toCrw                                             */
/*============================================================================*/

" OP_toCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ToCrwOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  // use extractRow from register0 and convert csvtoCrw
  Operand[].csvToCrw
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: ToCrwOp_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  writeBehind[].handleDangling

  // delete writeBehind
  writeBehind[].delete

  // deelete extractRow from reister0
  extractRow.delete

  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: ToCrwOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  // create a write behind
  writeBehind[].create

  // create an extractRow and put it in register 0
  extractRow.create to register0[]

  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: ToCrwOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  // check if we can scan the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  else
    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
  then

  Operand[].pipeout
  
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: ToCrwOp_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Operand[].delete
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for ToCrwOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCrwOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: ToCrwOp_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: ToCrwOp_EosMarker   ZK_EOSMARKER   op[].handler!
  find: ToCrwOp_PulseMarker ZK_PULSEMARKER op[].handler!
  find: ToCrwOp_StartMarker ZK_STARTMARKER op[].handler!
  find: ToCrwOp_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_RUN
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: ToCrwOp :: ToCrwOp <tableNm> ;

jobInfo: ToCrwOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
