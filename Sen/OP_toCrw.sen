/*============================================================================*/
/* OP_toCrw.sen -- Operator toCrw                                             */
/*============================================================================*/

" OP_toCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: toCrw_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  // use extractRow from register0 and convert csvtoCrw
  Pipein[] to Operand[]
  nullptr to Pipein[]

  Operand[].csvtoCrw
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: toCrw_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  writeBehind[].handleDangling

  // delete writeBehind
  writeBehind[].delete

  // deelete extractRow from reister0
  extractRow.delete

  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: toCrw_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  // create a write behind
  writeBehind[].create

  // create an extractRow and put it in register 0
  extractRow.create to register0[]

  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: toCrw_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  // check if we can scan the table
  <tableNm> op__table if
    // move to table folder and find the table and tablePtn
    Pipein[].pipeout
  then
  
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: toCrw_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Pipein[].delete
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for toCrw req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : toCrw_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toCrw_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: toCrw_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toCrw_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toCrw_StartMarker ZK_STARTMARKER op[].handler!
  find: toCrw_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toCrw :: toCrw <tableNm> ;

: toCrw _cmdTags tagCopy: opCmd_tags
  tags{ <cmdDesc> = "--cmd desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
