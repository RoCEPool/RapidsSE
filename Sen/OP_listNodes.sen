/*============================================================================*/
/* OP_listNodes.sen -- Operator list nodes                                    */
/*============================================================================*/

" OP_listNodes.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsNodes_action

  0 locals| iCursor |

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeOut

  begin
    streamSetTable[] StreamSet[].new
    iCursor grid::listNodes to iCursor
  
    iCursor while
      StreamSet[].pipeOut
  repeat

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsNodes :: lsNodes ;

: lsNodes _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listNodes
    <params>      = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
