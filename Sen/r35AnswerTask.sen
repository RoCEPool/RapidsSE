/*============================================================================*/
/* r35AnswerTask.sen -- R35 answer task                                       */
/*============================================================================*/

"r35AnswerTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the answer task                                                      */
/*----------------------------------------------------------------------------*/
: spawnR35AnswerTask

  0 "r35answerLoop" "AnswerDrone" TK_ANSWER_DRONE spawnR35GeneralTask
;

/*----------------------------------------------------------------------------*/
/* start R35 socket tasks                                                     */
/*----------------------------------------------------------------------------*/
: startR35Sockets

  "startR35Sockets" .

  spawnR35AnswerTask
;

/*----------------------------------------------------------------------------*/
/* accept new sockets, ???                                                    */
/*----------------------------------------------------------------------------*/
: r35answerLoop

  0 locals| iPort |
  0 locals| pListeningSocket |

  answerDronePrint if
    task::this task.name@ " running..." str.cat .
  then

  // get the listening port of this node
  grid::thisNode@ grid::node node.port to iPort

  args.verbose if
    "Waiting for connections on port "  iPort >str str.cat .
  then

  // now create a listening socket
  iPort socket.listen to pListeningSocket

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  0 nConnections !
  begin

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // wait for next socket

    tp: waitingOnAccept

    pListeningSocket socket.accept

    tp: socketAccepted

    args.verbose if
      "answered connection on port " iPort >str str.cat .
    then

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // start receiver drone for the new socket

    ddlLock::grabWrite

    nConnections spawnR35ReceiverTask

    ddlLock::dropWrite

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // increment connection counter

    nConnections @          ( connection# )
    1 +                     ( nConnections# 1 )
    dup                     ( nConnections# nConnections# )
    nConnections !          ( nConnections# )

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // if very first socket start connector drone

    1 == if               ( connection# )
      grid::thisNode@ grid::startNode@ != if
        spawnR35ConnectorTask
      then
    then

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
