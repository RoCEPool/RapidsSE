"r35AnswerTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the answer task                                                      */
/*----------------------------------------------------------------------------*/
: spawnR35AnswerTask

  0 "r35answerLoop" "AnswerDrone" TK_ANSWER_DRONE spawnDroneActor
;

/*----------------------------------------------------------------------------*/
/* accept new sockets, ???                                                    */
/*----------------------------------------------------------------------------*/
: r35answerLoop

  begin

  again
;

