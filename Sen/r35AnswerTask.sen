/*============================================================================*/
/* r35AnswerTask.sen -- R35 answer task                                       */
/*============================================================================*/

"r35AnswerTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the answer task                                                      */
/*----------------------------------------------------------------------------*/
: spawnR35AnswerTask ( -- )

    0                  // no. of args
    "r35answerLoop"    // seed word
    "AnswerTask"       // task name
    TK_ANSWER_DRONE    // task kind
  spawnR35GeneralTask
;

/*----------------------------------------------------------------------------*/
/* start R35 socket tasks                                                     */
/*----------------------------------------------------------------------------*/
: startR35Sockets ( -- )

  "startR35Sockets" .

  spawnR35AnswerTask
;

/*----------------------------------------------------------------------------*/
/* answer loop: accept new sockets, spawn receiver task                       */
/*----------------------------------------------------------------------------*/
: r35answerLoop ( -- )

  0 locals| iPort |
  0 locals| pListeningSocket |
  0 locals| pAcceptedSocket |
  0 locals| pReceiverTask |
  0 locals| pConnectorTask |

  answerDronePrint if
    task::this task.name@ " running..." str.cat .
  then

  // get the listening port of this node
  grid::thisNode@ grid::node node.port to iPort

  args.verbose if
    "Waiting for connections on port " iPort >str str.cat .
  then

  // now create a listening socket
  iPort socket::listen to pListeningSocket

  // number of connections to be zero
  0 nConnections !

  begin

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // wait for next socket

    tp: waitingOnAccept

    depth 0 != if "Stack of task has grown" . debug::trap then

    pListeningSocket socket.accept to pAcceptedSocket

    tp: socketAccepted

    args.verbose if
      "Answered connection on port " iPort >str str.cat .
    then

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // spawn receiver task for the new socket

    ddlLock::grabWrite

    pAcceptedSocket nConnections spawnR35ReceiverTask to pReceiverTask

    ddlLock::dropWrite

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // increment connection counter

    nConnections @          ( connection# )
    1 +                     ( nConnections# 1 )
    nConnections !          ( nConnections# )

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // if first socket on non-start node then start the connector task

    nConnections @ 1 == if
      grid::thisNode@ grid::startNode@ != if
        spawnR35ConnectorTask to pConnectorTask
      then
    then

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
