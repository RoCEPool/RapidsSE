/*============================================================================*/
/* OP_toHshCrw.sen -- Convert ptn nst rsb buffers to hashed crw buffers       */
/*============================================================================*/

" OP_toHshCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toHshCrw_StartMarker \handler

  ToHshCrw[].create

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toHshCrw_PulseMarker \handler

  ZK_PULSEMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toHshCrw_RsbBuffer \handler

  PipeIn[] ToHshCrw[].convert

  grid::partitions 0
  do

    I ToHshCrw[].completed to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].pipeOut
      I ToHshCrw[].completed to OperandB[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toHshCrw_EosMarker \handler

  grid::partitions 0
  do

    I ToHshCrw[].dangling to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].pipeOut
      I ToHshCrw[].dangling to OperandB[]
    repeat

  loop

  ToHshCrw[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRsb request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toHshCrw_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toHshCrw_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toHshCrw_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toHshCrw_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: toHshCrw_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toHshCrw :: toHshCrw ;

: toHshCrw _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
