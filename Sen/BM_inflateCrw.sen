/*============================================================================*/
/* BM_inflateCrw.sen -- Benchmark Operator inflateCrw                         */
/*============================================================================*/

" BM_inflateCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_Report

  Operand[].newCsvBuffer
  Operand[].report

  // csv report for bm_insidx
  aggTimer[] aggTimer.reportStr
    "BM_InflateCrw,Elapsed Time,%v\n" str.format Operand[].csvAppend

  counter0[].get
    "BM_InflateCrw,Number of CrwBuffers,%v\n" str.format Operand[].csvAppend

  counter1[].get
    "BM_InflateCrw,Total Number of Compact Rows,%v\n" str.format Operand[].csvAppend

  aggTimer[] aggTimer.nanosecs counter1[].get /
    "BM_InflateCrw,Average Time per Compact Row,%vns\n" str.format Operand[].csvAppend
  
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_CrwBuffer \handler

  //"BM_InflateCrw_CrwBuffer" .

  // get table partition for current partition
  table[].tablePtn@ to tablePtn[]

  BM_TimerBegin

  // Inflate the entries from the crwBuffer
  //   NB: registers are available in the step!!
  tablePtn[].inflateCrwBuffer // <- focal pt of bm
    counter1[] + to counter1[]

  counter0[] 1 + to counter0[]

  BM_TimerUpdate

  Operand[].delete
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_EosMarker \handler

  Operand[].delete

  BM_InflateCrwOp_Report

  Operand[].newEosMarker
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_StartMarker \handler

  // table folder push
  op__table

  folderPath.str "Folder path: %v" .printf

  BM_TimerNew

  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* execute for BM_InflateCrwOp                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_req ( -- )
 
  LogEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

    ZK_CRWBUFFER   of BM_InflateCrwOp_CrwBuffer   true endof

    ZK_EOSMARKER   of BM_InflateCrwOp_EosMarker   true endof

    ZK_STARTMARKER of BM_InflateCrwOp_StartMarker true endof

    jobOperand::generic swap

    endcase

  while assert::stack_0 repeat

  "*** BM_InflateRowOp EXITS" .
  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: BM_InflateCrwOp :: BM_InflateCrwOp <tableNm> ;

jobInfo: BM_InflateCrwOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
