/*============================================================================*/
/* BM_inflateCrw.sen -- Benchmark Operator inflateCrw                         */
/*============================================================================*/

" BM_inflateCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_Report

  Operand[].newCsvBuffer
  Operand[].report

  // csv report for bm_insidx
  aggTimer[] aggTimer.reportStr
    "BM_InflateCrw,Elapsed Time,%v\n" str.format Operand[].csvAppend

  counter0[].get
    "BM_InflateCrw,Number of CrwBuffers,%v\n" str.format Operand[].csvAppend

  counter1[].get
    "BM_InflateCrw,Total Number of Compact Rows,%v\n" str.format Operand[].csvAppend

  aggTimer[] aggTimer.nanosecs counter1[].get /
    "BM_InflateCrw,Average Time per Compact Row,%vns\n" str.format Operand[].csvAppend
  
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_CrwBuffer \handler

  //"BM_InflateCrw_CrwBuffer" .

  // get table partition for current partition
  table[].tablePtn@ to tablePtn[]

  BM_TimerBegin

  // Inflate the entries from the crwBuffer
  //   NB: registers are available in the step!!
  tablePtn[].inflateCrwBuffer // <- focal pt of bm
    counter1[] + to counter1[]

  counter0[] 1 + to counter0[]

  BM_TimerUpdate

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_EosMarker \handler

  Pipein[].delete

  BM_InflateCrwOp_Report

  Operand[].newEosMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_StartMarker \handler

  // table folder push
  <tableNm> op__table if

    path[].toStr "Folder path: %v" .printf

    BM_TimerNew

    Pipein[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for BM_InflateCrwOp                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_InflateCrwOp_req\operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: BM_InflateCrwOp_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: BM_InflateCrwOp_EosMarker   ZK_EOSMARKER   op[].handler!
  find: BM_InflateCrwOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  "*** BM_InflateRowOp EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: BM_InflateCrwOp :: BM_InflateCrwOp <tableNm> ;

: BM_InflateCrwOp _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
