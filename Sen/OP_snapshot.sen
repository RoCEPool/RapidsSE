/*============================================================================*/
/* OP_snapshot.sen -- Operator snapshot                                       */
/*============================================================================*/

" OP_snapshot.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: Snapshot_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // grab a read lock onn the table ptn
  tablePtn[].get tablePtnGrabRead2

  // begin a read transaction
  tx[].begin

  // pipeout all subsets from tablePtn
  tablePtn[].root to Subset[]
  Subset[]@ to Operand[]
  begin
    Operand[].isNull
  not while
    Operand[].get crwBuffer.snapshot Op::pipeOut
    nullptr Operand[].set
    Subset[].nextBuffer to Operand[]
  repeat

  // end a read transaction
  tx[].commit

  // discard the read lock on the table ptn
  tablePtn[].get tablePtnDropRead2

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: Snapshot_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> op__table if
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* Snapshot request                                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: Snapshot_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: Snapshot_PulseMarker ZK_PULSEMARKER op[].handler!
  find: Snapshot_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: Snapshot :: Snapshot <tableNm> ;

: Snapshot opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
