/*============================================================================*/
/* OP_snapshot.sen -- Operator snapshot                                       */
/*============================================================================*/

" OP_snapshot.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: SnapshotOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // grab a read lock onn the table ptn
  tablePtn[].get tablePtnGrabRead2

  // begin a read transaction
  tx[].begin

  // pipeout all subsets from tablePtn
  tablePtn[].root to Subset[]
  Subset[]@ to Operand[]
  begin
    Operand[].isNull
  not while
    Operand[].get crwBuffer.snapshot Op::pipeOut
    nullptr Operand[].set
    Subset[].nextBuffer to Operand[]
  repeat

  // end a read transaction
  tx[].commit

  // drop the read lock on the table ptn
  tablePtn[].get tablePtnDropRead2

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: SnapshotOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
  else

    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* SnapshotOp request                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
: SnapshotOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: SnapshotOp_PulseMarker ZK_PULSEMARKER op[].handler!
  find: SnapshotOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: SnapshotOp :: SnapshotOp <tableNm> ;

: SnapshotOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
