/*============================================================================*/
/* job_DropTable.sen -- Job Drop Table                                        */
/*============================================================================*/

"job_DropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job check resources                                  */
/*----------------------------------------------------------------------------*/
: dropTable_checkResources ( Job_DropTable -- )

  params| pJob_DropTable  |

  "checkResources received" .
  tp: pJob_DropTable

  ddlLock::grabWrite

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_DropTable getPathR35
  dicStack.set

  // get the table name from the job
  pJob_DropTable job.objectName@

  checkRemoveTable not if pJob_DropTable <ERROR_JOB> exit then

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job release resources                                */
/*----------------------------------------------------------------------------*/
: dropTable_releaseResources ( Job_DropTable -- )

  params| pJob_DropTable  |

  "releaseResources received" .

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeTable ( "<tableNm>" )

  tp: removeTable

  params| sTableNm |
  0 locals| pTable |

  sTableNm pushTable assert
  sTableNm find execute to pTable

  //----------------------------------------------------------------------------
  // drop all rows
  //pTable table.truncate ( ^table )

  //----------------------------------------------------------------------------
  // drop all indexes
  "indexes" find execute pathPush

  // iterate thru all indexes and tidyUp
  0 pathPick dic.lastWord dup
  iterate                        // setup iteration of words
  object@ word.name
  dup .
  // forward reference :-(
  "indexTidyUp" find execute

  object@ word.prev object!     // step backwards thru words
  next

  pathDrop

  // forget the indexes in the indexes dictionary
  "indexes" find execute forgetAll

  // forget the indexes dictionary itself
  "indexes" :forget

  //----------------------------------------------------------------------------
  // drop all partition keys etc

  // forget all column names in the columns dictionary of partitions sub-dictionary
  //dup table.slots slots.subDic
  //pathPush
  //"columns" find execute forgetAll
  //pathDrop

  //dup table.slots slots.subDic forgetAll

  // forget the partitions in the partitions dictionary
  //"partitions" find execute forgetAll

  // forget the partitions dictionary itself
  "partitions" :forget

  //----------------------------------------------------------------------------
  // drop all table columns etc
  // forget all column names in the columns dictionary of table sub-dictionary
  //dup table.subDic
  //pathPush
  //"columns" find execute forgetAll
  //pathDrop

  // forget the columns dictionary in the table sub-dictionary
  //table.subDic forgetAll

  sTableNm :forget

  popTable

  sTableNm :forget
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: dropTable_req ( -- <R> )

  0 0 locals| pJob pTask |
  "dropTable_req" .

  tp: droTable

  //ddlLock::grabWrite

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  // distribute the job
  pTask pJob "job::distribute" find execute

  pJob <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job                                                  */
/*----------------------------------------------------------------------------*/
: DropTable_node ( pJob_DropTable -- )

  params| pJob_DropTable |

  CN_JOB_DROPTABLE pJob_DropTable object.assertClass

  ddlLock::grabWrite

  pJob_DropTable getPathR35
  dicStack.set
  pJob_DropTable job.objectName@   ( tableNm )

  removeTable ( )  not if "got error" . exit then

  ddlLock::testDrop

  pJob_DropTable job.notice
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
