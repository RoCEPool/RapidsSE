/*============================================================================*/
/* job_DropTable.sen -- Job Drop Table                                        */
/*============================================================================*/

" job_DropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable table folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  folder[].checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushTableFolder assert

  sTableNm name::checkIsTable not if path[].discardTableFolder false exit then
  //sTableNm tableInUse if path[].discardTableFolder EC_TABLE_IN_USE false exit then

  // pop table folder
  path[].discardTableFolder

  // assert in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* check resources for dropTable                 (on each participating node) */
/*----------------------------------------------------------------------------*/
: dropTable::checkResources _eeh ( -- )


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  <tableNm> checkRemoveTable not if job[] ERROR_JOB !!logError exit then
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job on a node                                        */
/*----------------------------------------------------------------------------*/
: dropTable::execute _eeh ( -- )


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  <tableNm> removeTable
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: dropTable :: drop table <tableNm> ;

jobInfo: dropTable
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
