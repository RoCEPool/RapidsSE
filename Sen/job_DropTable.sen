/*============================================================================*/
/* job_DropTable.sen -- Job Drop Table                                        */
/*============================================================================*/

" job_DropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable table folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeTable ( "<tableNm>" )

  tp: removeTable

  //test::test7

  params| sTableNm |
  0 locals| pTable |

  //----------------------------------------------------------------------------
  // move to table folder
  sTableNm pushTable assert

  //----------------------------------------------------------------------------
  // find the table
  sTableNm find execute to pTable

  //----------------------------------------------------------------------------
  // truncate the table
  args.partitionsPerNode 0
  do
    I pTable table.truncate
  loop

  //----------------------------------------------------------------------------
  // forget the indexes in the indexes dictionary
  "indexes" find execute forgetAll

  //----------------------------------------------------------------------------
  // forget the indexes dictionary itself
  "indexes" :forget

  //----------------------------------------------------------------------------
  // forget the partitions dictionary itself
  "partitions" :forget

  //----------------------------------------------------------------------------
  // forget the table dictionary itself
  sTableNm :forget

  //----------------------------------------------------------------------------
  // pop table
  popTable

  sTableNm :forget

;

/*----------------------------------------------------------------------------*/
/* check resources for dropTable                 (on each participating node) */
/*----------------------------------------------------------------------------*/
: dropTable::checkResources _eeh ( -- )

  tp: dropTable.checkResources

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  <tableNm> checkRemoveTable not if job::this <ERROR_JOB> !!logError exit then
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job on a node                                        */
/*----------------------------------------------------------------------------*/
: dropTable::execute _eeh ( -- )

  tp: dropTable_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  <tableNm> removeTable
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: dropTable :: drop table <tableNm> ;

jobInfo: dropTable
{
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_WRITE
  
  <?preCheck?> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
