/*============================================================================*/
/* job_DropTable.sen -- Job Drop Table                                        */
/*============================================================================*/

"job_DropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable table folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWordR35 not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTableR35 not if popTable false exit then
  sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeTable ( "<tableNm>" )

  tp: removeTable

  params| sTableNm |
  0 0 locals| sIndexNm pTable |

  //----------------------------------------------------------------------------
  // move to table folder
  sTableNm pushTable assert

  //----------------------------------------------------------------------------
  // find the table
  sTableNm find execute to pTable

  //----------------------------------------------------------------------------
  // push indexes folder
  pushIndexes assert

  //----------------------------------------------------------------------------
  // iterate thru all indexes and tidyUp
  0 pathPick dic.lastWord dup
  iterate                        // setup iteration of words

    object@ word.name to sIndexNm

    //sIndexNm "Deleting index %v" str.format .

    // forward reference :-(
    sIndexNm "indexTidyUp" find execute

    object@ word.prev object!     // step backwards thru words

  next

  //----------------------------------------------------------------------------
  // pop indexes folder
  popIndexes

  //----------------------------------------------------------------------------
  // forget the indexes in the indexes dictionary
  "indexes" find execute forgetAll

  //----------------------------------------------------------------------------
  // forget the indexes dictionary itself
  "indexes" :forget

  //----------------------------------------------------------------------------
  // forget the partitions dictionary itself
  "partitions" :forget

  //----------------------------------------------------------------------------
  // forget the table dictionary itself
  sTableNm :forget

  //----------------------------------------------------------------------------
  // pop table
  popTable

  sTableNm :forget

;

/*----------------------------------------------------------------------------*/
/* drop table request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: dropTable_req ( -- <R> )

  0 0 locals| pJob pTask |
  "dropTable_req" .

  tp: droTable

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  // distribute the job
  pTask pJob "job::distribute" find execute

  pJob <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job on a node                                        */
/*----------------------------------------------------------------------------*/
: DropTable_node ( pJob_DropTable -- )

  params| pJob_DropTable |

  tp: DropTable_node

  //----------------------------------------------------------------------------
  // assert correct job
  CN_JOB_DROPTABLE pJob_DropTable object.assertClass

  //----------------------------------------------------------------------------
  // grad a ddl lock
  ddlLock::grabWrite

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_DropTable getPathR35
  dicStack.set

  //----------------------------------------------------------------------------
  // remove table
  pJob_DropTable job.objectName@   ( tableNm )
  removeTable

  pJob_DropTable job.notice

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job check resources                                  */
/*----------------------------------------------------------------------------*/
: dropTable_checkResources ( Job_DropTable -- )

  params| pJob_DropTable  |

  tp: dropTable_checkResources
  "checkResources received" .

  //----------------------------------------------------------------------------
  // grad a ddl lock
  ddlLock::grabWrite

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_DropTable getPathR35
  dicStack.set

  //----------------------------------------------------------------------------
  // check if we can remove the table
  pJob_DropTable job.objectName@
  checkRemoveTable not if pJob_DropTable <ERROR_JOB> exit then

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job release resources                                */
/*----------------------------------------------------------------------------*/
: dropTable_releaseResources ( Job_DropTable -- )

  params| pJob_DropTable  |

  tp: dropTable_releaseResources
  "releaseResources received" .

  <DONE_NODE>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
