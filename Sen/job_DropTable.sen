/*============================================================================*/
/* job_DropTable.sen -- Job Drop Table                                        */
/*============================================================================*/

"job_DropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: dropTableR35_req ( "<tableNm>" -- <R> )

  0 0 locals| pJob pTask |

  tp: droTable

  //ddlLock::grabWrite

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  // NOTE: needs to go in check resources
  // get the table name from the job
  //pJob job.objectName@
  //checkRemoveTable not if "<NIP+ERROR>" exit then
  //drop // tableNm on stack

  // distribute the job
  pTask pJob "job::distribute" find execute

  // ack the waiting prompt task
  "Acking parent" .
  pJob job.promptTask@ ack
  "Acked parent" .

  <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropTable job                                                  */
/*----------------------------------------------------------------------------*/
: Job_DropTable_node ( pJob_DropTable -- )

  params| pJob_DropTable |

  CN_JOB_DROPTABLE pJob_DropTable object.assertClass

  ddlLock::grabWrite

  pJob_DropTable getPathR35
  dicStack.set
  pJob_DropTable job.objectName@   ( tableNm )

  removeTableR35 ( )  not if "got error" . exit then

  ddlLock::testDrop

  pJob_DropTable job.notice
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
