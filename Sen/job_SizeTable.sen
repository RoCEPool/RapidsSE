/*============================================================================*/
/* job_SizeTable.sen -- Job Size Table                                        */
/*============================================================================*/

" job_SizeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkSizeTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeTable job on a node                                        */
/*----------------------------------------------------------------------------*/
: sizeTable::execute _eeh ( -- )

  job::this locals| pJob_SizeTable |

  0 0 0 locals| sTableNm pTable iSize |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table name
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table folder
  sTableNm pushTable assert

  sTableNm find execute to pTable
  pTable table.space 0 swap number.magnitude to iSize

  iSize grid::thisNodeName@ "row: ( %v, %v )" str.format

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  popTable

  pJob_SizeTable job.response!
  1 pJob_SizeTable job.rowsProcessed!
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeTable job check resources                                  */
/*----------------------------------------------------------------------------*/
: sizeTable::checkResources _eeh ( -- )

  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  <tableNm>
  checkSizeTable not if job::this <ERROR_JOB> !!logError exit then

  <<logExit <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: sizeTable :: sizeTable <tableNm> ;
jobSyntax: sizeTable :: szTbl <tableNm> ;

jobInfo: sizeTable
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SIZETABLE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
