/*============================================================================*/
/* job_SizeTable.sen -- Job Size Table                                        */
/*============================================================================*/

" job_SizeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkSizeTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* size table request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: sizeTable_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: sizeTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(nodeName VARCHAR, size VARCHAR)" 
    pJob job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeTable job on a node                                        */
/*----------------------------------------------------------------------------*/
: sizeTable_exe ( Job_SizeTable -- )

  >>am <SEED_EXE>

  //params| pJob_SizeTable |
  job::this locals| pJob_SizeTable |

  0 0 0 locals| sTableNm pTable iSize |

  tp: sizeTable_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_SIZETABLE pJob_SizeTable object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_SizeTable job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  pJob_SizeTable job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table folder
  sTableNm pushTable assert

  sTableNm find execute to pTable
  pTable table.space 0 swap number.magnitude to iSize

  iSize grid::thisNodeName@ "row: ( %v, %v )" str.format

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  popTable

  pJob_SizeTable job.response!
  1 pJob_SizeTable job.rowsProcessed!

  pJob_SizeTable job.notice

  pJob_SizeTable job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeTable job check resources                                  */
/*----------------------------------------------------------------------------*/
: sizeTable.checkResources ( Job_SizeTable -- )

  >>am <Check_Resources>

  params| pJob_SizeTable  |

  tp: sizeTable.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_SizeTable job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  pJob_SizeTable job.objectName@
  checkSizeTable not if pJob_SizeTable <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeTable job release resources                                */
/*----------------------------------------------------------------------------*/
: sizeTable.releaseResources ( Job_SizeTable -- )

  >>am <Release_Resources>

  params| pJob_SizeTable  |

  tp: sizeTable.releaseResources
  //releaseResources received" .

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: sizeTable_beg ( -- )

  >>am <SEED_BEG>

 job::this locals| pJob_sizeTable |

  pJob_sizeTable job.becomeParticipant

  pJob_sizeTable sizeTable.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: sizeTable_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_sizeTable |

  pJob_sizeTable sizeTable.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: sizeTable_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_sizeTable |

  pJob_sizeTable sizeTable.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
