/*============================================================================*/
/* OP_lsten.sen -- Operator list tenants                                      */
/*============================================================================*/

" OP_lsten.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsten_action

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tenants folder
  folder[].checkInTenants not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  StreamSetTable[] StreamDef[].new

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in teh infoSet for each word

  folder[] dic.lastWord dup
  iterate                          // setup iteration of words
    object@ word.name@ StreamDef[] StreamSet[].addListContents assert
    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the streamDef
  StreamDef[].pipeout

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: lsten :: lsten ;

: lsten opInfo tagCopy: localLiteOp_tags
  tags{
    <jobDesc>     = "--description of operator--"
    <localLiteOp> = true
    <streamDef>   = __listContents
    <params>      = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
