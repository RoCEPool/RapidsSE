/*============================================================================*/
/* job_2pcReply.sen -- Distributed 2PC Job related words                      */
/*============================================================================*/

" job_2pcReply.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distribute current originating job to all participating nodes              */
/*----------------------------------------------------------------------------*/
: job::distributeConnected ( -- )

  job[] locals| pJob |

  // create the response vector in the orginating job to receive responses
  pJob job.createResponseVec

  // create the buffer queue in the orginating job to receive buffers
  pJob job.createBufferQueue

  // set the no of acks expected by originator job
  //   to be the number of defined nodes in the grid
  grid::definedNodes pJob job.acksRemaining!

  // grab this task's lock
  task[] task.grabLock

  // set acks for originator task
  1 task::acks!

  // send the job to each connected node in the grid
//  grid::definedNodes 0 do
//
//    I grid::node node.sendSocket@ if
//      I pJob job.forward
//    then
//
//  loop

  0 locals| pNode |

  node_I[].new

  begin
    node_I[].node to pNode

    pNode node.sendSocket@ if
      pNode node.no pJob job.forward
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete
;

/*----------------------------------------------------------------------------*/
/* send job__begun back to originating node                                   */
/*----------------------------------------------------------------------------*/
: 2pcReply::job__begun ( -- )

  job[] "Job__Begun::send" find execute
;

/*----------------------------------------------------------------------------*/
/* send job__executed back to originating node                                */
/*----------------------------------------------------------------------------*/
: 2pcReply::job__executed ( -- )

  job[] "Job__Executed::send" find execute
;

/*----------------------------------------------------------------------------*/
/* ended a job on participant node                                            */
/*----------------------------------------------------------------------------*/
: 2pcReply::job__ended ( -- )

  job[] "Job__Ended::send" find execute
;

/*----------------------------------------------------------------------------*/
/* cancelled a job on participant node                                        */
/*----------------------------------------------------------------------------*/
: 2pcReply::job__cancelled ( -- )

  job[] "Job__Cancelled::send" find execute
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
