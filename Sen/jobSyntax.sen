/*============================================================================*/
/* jobSyntax.sen -- Job Syntax Compiler                                       */
/*============================================================================*/

" jobSyntax.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .isMetaToken ( str -- t|f )

  dup 1 swap str.left  "<" str.equal not if drop false exit then

  1 swap str.right ">" str.equal not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .isJsonToken ( str -- t|f )

  "{name:value}" str.equal 
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobSyntax:

  // create a word using next token from input source as the word name
  create

  // set the word kind to be jobSyntax
  [ word::this , ] word::this word.kind!

  // attach an ename set to the word being created
  enmSet::new word::this word.enmSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  next-token find execute >str "__job__" swap
    word::this word.enmSet@ enmSet.addStr

  // skip the :: token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till ';', build ename set representing the syntax
  begin
    next-token
    dup ";" str.equal not
    while
      dup .isMetaToken if
        // dup "%v is a meta token" fmt.print
        // add ("*",meta,TN_STRING) in ename set
        "__meta__" swap word::this word.enmSet@ enmSet.addStr

      else dup .isJsonToken if
        // dup "%v is a json token" fmt.print
        // add ("*",json,TN_STRING) in ename set
        "__json__" swap word::this word.enmSet@ enmSet.addStr
      else
        // dup "%v is a normal token" fmt.print
        // add (word,"",TN_STRING) in ename set
        dup word::this word.enmSet@ enmSet.addStr
      then then
  repeat

  // drop the ";" from dstack
  drop


  does>
    // ..to be written
    drop
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: defineNode_syn CN_JOB_DEFINENODE
        :: define node <nodeNm> {name:value} ;

jobSyntax: forgetNode_syn CN_JOB_UNIVERSAL
        :: forget node <nodeNm> ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
