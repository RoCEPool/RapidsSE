/*============================================================================*/
/* planTesting.sen -- plan tests                                              */
/*============================================================================*/

"planTest.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distributed export plan test                                               */
/*----------------------------------------------------------------------------*/
: dexPlanTest

  0 locals| dexPlan |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // prepare plan
  "part" "/tmp/part.csv" dexPlanner to dexPlan

  // set this task as the executing task in the plan
  task::this dexPlan plan.executingTask!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute (and compile) the plan
  dexPlan distributePlan

  // this task to wait for 1 ack
  1 setAcks

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // execute the plan
  dexPlan executePlan

  //"PlanTest waiting for ack" .

  // this task waits till ack'd by the responseOp
  ackWait

  //"PlanTest got ack" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reap the plan
  //dexPlan reapPlan
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
