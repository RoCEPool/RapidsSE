/*============================================================================*/
/* planTesting.sen -- plan tests                                              */
/*============================================================================*/

"planTest.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distributed export plan test                                               */
/*----------------------------------------------------------------------------*/
: dexPlanTest

  0 locals| dexPlan |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // prepare plan
  "part" "/tmp/part.csv" dexPlanner to dexPlan

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the plan
  dexPlan compilePlan

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // trigger scanOp by piping the plan to it
  args.partitions 0 do
    << I "scanOp#%v" str.format dexPlan >>
    "scanOp.task" find execute >jobQueue
  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
