/*============================================================================*/
/* planTesting.sen -- plan tests                                              */
/*============================================================================*/

"planTest.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distributed export plan test                                               */
/*----------------------------------------------------------------------------*/
: dexPlanTest

  0 locals| dexPlan |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // prepare plan
  "part" "/tmp/part.csv" dexPlanner to dexPlan

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the plan
  dexPlan distributePlan
  planList::show

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the plan
  dexPlan compilePlan

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // execute the plan
  dexPlan executePlan
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
