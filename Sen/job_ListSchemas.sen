/*============================================================================*/
/* job_ListSchemas.sen -- Job List Schemas                                    */
/*============================================================================*/

" job_ListSchemas.sen" .verbose

/*----------------------------------------------------------------------------*/
/* List Schemas requests (on the originating node)                            */
/*----------------------------------------------------------------------------*/
: lssch_req ( -- <R> )

  >>logEntry <SEED_REQ2>

  0 0 locals| pJob_ListSchemas pTask |

  tp: listSchemas_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListSchemas

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the schemas folder
  checkInSchemas not if pJob_ListSchemas <ERROR_REQUEST> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list tables folder contents
  pJob_ListSchemas listContents

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: lssch :: lssch ;

jobInfo: lssch
{
  jobKind      = JK_LOCAL
  responseKind = RS_LOCAL_ERRORS
  
  exeLock      = DL_GRAB_READ
  preCheck     = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

