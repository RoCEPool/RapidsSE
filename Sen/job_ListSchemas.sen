/*============================================================================*/
/* job_ListSchemas.sen -- Job List Schemas                                    */
/*============================================================================*/

" job_ListSchemas.sen" .verbose

/*----------------------------------------------------------------------------*/
/* find the schemas folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: pushSchemas ( -- )
  "schemas" find execute pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the scehams folder                                                     */
/*----------------------------------------------------------------------------*/
: popSchemas
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* within a catalog folder ?                                                  */
/*----------------------------------------------------------------------------*/
: withinCatalog
  1 pathPick dic.name "catalogs" str.equal
;

/*----------------------------------------------------------------------------*/
/* check if in a catalog folder ?                                             */
/*----------------------------------------------------------------------------*/
: checkInCatalog
  withinCatalog if true exit then
  EC_NOT_IN_A_CATALOG false
;

/*----------------------------------------------------------------------------*/
/* List Schemas requests (on the originating node)                            */
/*----------------------------------------------------------------------------*/
: listSchemas_req ( -- <R> )

  0 0 locals| pJob_ListSchemas pTask |

  tp: listSchemas_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListSchemas

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_ListSchemas getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab ddl read lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the schemas folder
  checkInCatalog not if pJob_ListSchemas <ERROR_REQUEST> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list tables folder contents
  pushSchemas
  pJob_ListSchemas listContents
  popSchemas

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  pJob_ListSchemas <DONE_REQUEST>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

