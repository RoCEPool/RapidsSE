/*============================================================================*/
/* job_ListCatalogs.sen -- Job List Catalogs                                  */
/*============================================================================*/

" job_ListCatalogs.sen" .verbose


/*----------------------------------------------------------------------------*/
/* List Catalogs requests (on the originating node)                           */
/*----------------------------------------------------------------------------*/
: listCatalogs_req ( -- <R> )

  >>logEntry <SEED_REQ2>

  0 0 locals| pJob_ListCatalogs pTask |

  tp: listCatalogs_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListCatalogs

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  //pJob_ListCatalogs job.pushPath
  //task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab ddl read lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the catalogs folder
  checkInCatalogs not if pJob_ListCatalogs <ERROR_REQUEST> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list catalogs folder contents
  pJob_ListCatalogs listContents

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

