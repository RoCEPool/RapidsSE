/*============================================================================*/
/* job_ListCatalogs.sen -- Job List Catalogs                                  */
/*============================================================================*/

" job_ListCatalogs.sen" .verbose

/*----------------------------------------------------------------------------*/
/* find the catalogs folder and push it onto task dictionary                  */
/*----------------------------------------------------------------------------*/
: pushCatalogs ( -- )
  "catalogs" find execute pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the catalogs folder                                                    */
/*----------------------------------------------------------------------------*/
: popCatalogs
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* within a teanant folder ?                                                  */
/*----------------------------------------------------------------------------*/
: withinTenant
  1 pathPick dic.name "tenants" str.equal
;

/*----------------------------------------------------------------------------*/
/* check if in a teanant folder ?                                             */
/*----------------------------------------------------------------------------*/
: checkInTenant
  withinTenant if true exit then
  EC_NOT_IN_A_TENANT false
;

/*----------------------------------------------------------------------------*/
/* List Catalogs requests (on the originating node)                           */
/*----------------------------------------------------------------------------*/
: listCatalogs_req ( -- <R> )

  0 0 locals| pJob_ListCatalogs pTask |

  tp: listCatalogs_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListCatalogs

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_ListCatalogs getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab ddl read lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the catalogs folder
  checkInTenant not if pJob_ListCatalogs <ERROR_REQUEST> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list tables folder contents
  pushCatalogs
  pJob_ListCatalogs listContents
  popCatalogs

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  pJob_ListCatalogs <DONE_REQUEST>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

