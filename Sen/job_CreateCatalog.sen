/*============================================================================*/
/* job_CreateCatalog.sen -- Job Create Catalog                                */
/*============================================================================*/

"job_CreateCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a makeable tenant folder                                  */
/*----------------------------------------------------------------------------*/
: checkMakeCatalog ( "<catalogNm>" -- "<catalogNm>" true | "<catalogNm>" errorCode false )

  checkInCatalogs   not if false exit then
  checkIsNotCatalog not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* make a named catalog folder (run by participant)                           */
/*----------------------------------------------------------------------------*/
: makeCatalog ( "<catalogNm>" -- )

  tp: makeCatalog

  params| sCatalogNm |

  args.tracepoint if
    dup "MAKING CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  //----------------------------------------------------------------------------
  // make the catalog
  sCatalogNm :catalog ( ^catalog )

  //----------------------------------------------------------------------------
  // make schemas folder
  makeSchemas ( )
;

/*----------------------------------------------------------------------------*/
/* create catalog request (on originating node)                               */
/*----------------------------------------------------------------------------*/
: createCatalog_req ( -- )

  0 0 locals| pJob pTask |

  tp: createCatalog

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  // distribute the job
  pTask pJob "job::distribute" find execute

  pJob <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job on a node                                    */
/*----------------------------------------------------------------------------*/
: createCatalog_node ( pJob_CreateCatalog -- )

  params| pJob_CreateCatalog |

  0 locals| sCatalogNm |

  tp: createCatalog_node

  params| pJob_CreateCatalog |

  //----------------------------------------------------------------------------
  // grad a ddl lock
  ddlLock::grabWrite

  CN_JOB_CREATECATALOG pJob_CreateCatalog object.assertClass
  pJob_CreateCatalog job.objectName@  to sCatalogNm

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_CreateCatalog getPathR35
  dicStack.set

  //----------------------------------------------------------------------------
  // make he catalog
  makeCatalog ( )

  //----------------------------------------------------------------------------
  // should be in tables
  assertInTables
  pJob_CreateCatalog job.notice

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job check resources                              */
/*----------------------------------------------------------------------------*/
: createCatalog_checkResources ( pJob_CreateCatalog -- )

  params| pJob_CreateCatalog  |

  tp: createCatalog_checkResources
  "checkResources received" .

  //----------------------------------------------------------------------------
  // grad a ddl lock
  ddlLock::grabWrite

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_CreateTable getPathR35
  dicStack.set

  //----------------------------------------------------------------------------
  // check if we have enough buffers
  checkEnoughBuffersR35 not if pJob_CreateCatalog <ERROR_JOB> exit then


  //----------------------------------------------------------------------------
  // check if we can make the catalog
  pJob_CreateTable job.objectName@
  checkMakeCatalog not if pJob_CreateCatalog <ERROR_JOB> exit then

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job release resources                            */
/*----------------------------------------------------------------------------*/
: createCatalog_releaseResources ( pJob_CreateCatalog -- )

  params| pJob_CreateCatalog  |

  tp: createCatalog_releaseResources
  "releaseResources received" .

  <DONE_NODE>
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

