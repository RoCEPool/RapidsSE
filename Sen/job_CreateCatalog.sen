/*============================================================================*/
/* job_CreateCatalog.sen -- Job Create Catalog                                */
/*============================================================================*/

" job_CreateCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is not a catalog                                             */
/*----------------------------------------------------------------------------*/
: checkIsNotCatalog ( word )
  findInCurrent not if true exit then
  EC_CATALOG_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable tenant folder                                  */
/*----------------------------------------------------------------------------*/
: checkMakeCatalog ( "<catalogNm>" -- true | errorCode false )

  checkInCatalogs   not if false exit then
  checkIsNotCatalog not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* make a named catalog folder (run by participant)                           */
/*----------------------------------------------------------------------------*/
: makeCatalog ( "<catalogNm>" -- )

  tp: makeCatalog

  params| sCatalogNm |

  args.tracepoint if
   sCatalogNm "MAKING CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the catalog
  sCatalogNm :catalog ( ^catalog )
  drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make schemas folder
  sCatalogNm makeSchemas ( )
;


/*----------------------------------------------------------------------------*/
/* create catalog request (on originating node)                               */
/*----------------------------------------------------------------------------*/
: createCatalog_req ( -- )

  <SEED_REQ>

  0 0 locals| pJob_CreateCatalog pTask |

  tp: createCatalog_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_CreateCatalog

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob_CreateCatalog job.distribute

  <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job on a node                                    */
/*----------------------------------------------------------------------------*/
: createCatalog_exe ( pJob_CreateCatalog -- )

  <SEED_EXE>

  //params| pJob_CreateCatalog |
  job::this locals| pJob_CreateCatalog |

  0 locals| sCatalogNm |

  tp: createCatalog_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  CN_JOB_CREATECATALOG pJob_CreateCatalog object.assertClass
  pJob_CreateCatalog job.objectName@ to sCatalogNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_CreateCatalog getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the catalog
  sCatalogNm makeCatalog ( )

  pJob_CreateCatalog job.notice

  pJob_CreateCatalog send_job__executed

  nullptr task::this task.job!

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job check resources                              */
/*----------------------------------------------------------------------------*/
: createCatalog.checkResources ( pJob_CreateCatalog -- )

  params| pJob_CreateCatalog  |

  tp: createCatalog.checkResources
  "checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grad a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_CreateCatalog getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  checkEnoughBuffers not if pJob_CreateCatalog <ERROR_JOB> exit then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can make the catalog
  pJob_CreateCatalog job.objectName@
  checkMakeCatalog not if pJob_CreateCatalog <ERROR_JOB> exit then

  ddlLock::dropWrite
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job release resources                            */
/*----------------------------------------------------------------------------*/
: createCatalog.releaseResources ( pJob_CreateCatalog -- )

  params| pJob_CreateCatalog  |

  tp: createCatalog.releaseResources
  "releaseResources received" .
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: createCatalog_beg ( -- )

  <SEED_BEG>

  job::this locals| pJob_createCatalog |

  pJob_createCatalog job.beginParticipant

  // check resources
  pJob_createCatalog createCatalog.checkResources

  job::participantBegun

  <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: createCatalog_end ( -- )

  <SEED_END>

  job::this locals| pJob_createCatalog |

  pJob_createCatalog createCatalog.releaseResources

  job::participantEnded

  <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: createCatalog_can ( -- )

  <SEED_CAN>

  job::this locals| pJob_createCatalog |

  pJob_createCatalog createCatalog.releaseResources

  job::participantCancelled

  <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

