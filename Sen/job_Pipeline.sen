/*============================================================================*/
/* job_Pipeline.sen -- Job Pipeline                                           */
/*============================================================================*/

" job_Pipeline.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Pipeline command request (on originating node)                             */
/*----------------------------------------------------------------------------*/
: pipeline_req ( -- <R> )

  >>logEntry <SEED_REQ2>

  100 ssn::senLoc

  0 0 locals| pJob_pipeline pTask |

  //": pipeline_req" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_pipeline

  //pJob_pipeline "Job %v on originating node" str.format .

  // distribute the job
  pJob_pipeline job.distribute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ": pipeline_req END" .

  900 ssn::senLoc

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_Pipeline job on a node                                         */
/*----------------------------------------------------------------------------*/
: pipeline_exe ( Job_pipeline -- )

  >>logEntry <SEED_EXE2>

  task::this locals| pTask |
  job::this  locals| pJob_pipeline |

  //pJob_pipeline "Job %v on participant node" str.format .
  tp: pipeline_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  //----------------------------------------------------------------------------
  // set task's dictionary stack from path in job
  //pJob_pipeline job.pushPath
  //task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin the pipeline job
  pJob_pipeline job_Pipeline.begin

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // execute the pipeline job
  pJob_pipeline job_Pipeline.execute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // end the pipeline job
  pJob_pipeline job_Pipeline.end

  pJob_pipeline job.notice

  pJob_pipeline job::participantExecuted

  <<logExit <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: pipeline_beg ( -- )

  >>logEntry <SEED_BEG>

  job::this locals| pJob_pipeline |

  pJob_pipeline job.becomeParticipant

  job::participantBegun

  <<logExit <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: pipeline_end ( -- )

  >>logEntry <SEED_END>

  job::participantEnded

  <<logExit <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: pipeline_can ( -- )

  >>logEntry <SEED_CAN>

  job::participantCancelled

  <<logExit <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
