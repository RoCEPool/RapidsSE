/*============================================================================*/
/* job_Pipeline.sen -- Job Pipeline                                           */
/*============================================================================*/

" job_Pipeline.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute Job_Pipeline job on a node                                         */
/*----------------------------------------------------------------------------*/
: pipeline::execute _eeh ( -- )

  task::this locals| pTask |
  job::this  locals| pJob_pipeline |

  tp: pipeline_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline command
  <cmd> job_Pipeline::compile

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin the pipeline job
  pJob_pipeline job_Pipeline.begin

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // execute the pipeline job
  pJob_pipeline job_Pipeline.execute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // end the pipeline job
  pJob_pipeline job_Pipeline.end
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: pipeline :: pipeline <pipelineNm> etc ;

jobInfo: pipeline
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_QUEUE_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
