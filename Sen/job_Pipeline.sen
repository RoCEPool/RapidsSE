/*============================================================================*/
/* job_Pipeline.sen -- Job Pipeline                                           */
/*============================================================================*/

" job_Pipeline.sen" .verbose

/*----------------------------------------------------------------------------*/
/* pipeline request (on originating node)                                     */
/*----------------------------------------------------------------------------*/
: pipeline::request _eeh ( -- <R> )

  job[] locals| pJob_pipeline |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline command
  <cmd> job_Pipeline::compile dup
  EC_NONE != if
    job[] <ERROR_JOB> !!logError exit
  else
    job_Pipeline::deleteDynamo
    drop
  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_Pipeline job on a node                                         */
/*----------------------------------------------------------------------------*/
: pipeline::execute _eeh ( -- )

  task[] locals| pTask |
  job[]  locals| pJob_pipeline |


  // run <pre_execute>

  "<pre_execute>"
  job[] job.enameSet@ enameSet.hasName if
    "<pre_execute>"
    job[] job.enameSet@ enameSet.getStr locals| sPreExe |
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
      process::quit
    then
      execute
  else
    <pipelineNm> "No pre execute word for pipeline: %v" .printf
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab the task lock
  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // execute the pipeline job (send startmarker to startOp)
  <pipelineNm> "%v execute" .printf
  pJob_pipeline job_Pipeline.execute if

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // wait for operators to finish
    <pipelineNm> "%v waiting on task::wait" .printf
    task::wait
    <pipelineNm> "%v running" .printf

 then
;

/*----------------------------------------------------------------------------*/
/* execute Job_pipeline job check resources                                   */
/*----------------------------------------------------------------------------*/
: pipeline::checkResources _eeh ( -- )

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline command
  <cmd> job_Pipeline::compile
  EC_NONE == assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin the pipeline job (spawning jobs for ops etc)
  job[] job_Pipeline.begin
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

opSyntax: pipeline :: pipeline <pipelineNm> etc ;

jobInfo: pipeline
{
  ?<jobDesc>?  = "--description of job--"
  
  ?<jobKind>?  = JK_DIST2PC
  ?<rspKind>?  = RS_PARTICIPANT_ERROR
  ?<ddlLock>?  = DL_GRAB_READ
  
  ?<preCheck>? = bClusterStarted
}
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
