/*============================================================================*/
/* job_DefineNode.sen -- Job Define Node                                      */
/*============================================================================*/

" job_DefineNode.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Job_DefineNode request (on originating node)                               */
/*----------------------------------------------------------------------------*/
: defineNode::request _eeh (  -- <R> )

  <nodeNm> "<nodeNm> : %v" .printf
;

/*----------------------------------------------------------------------------*/
/* execute Job_DefineNode job on each node                                    */
/*----------------------------------------------------------------------------*/
: defineNode::execute _eeh ( -- )

  0 locals| pNode |


  //----------------------------------------------------------------------------
  // make Node
  <nodeNm> node::new to pNode
;

/*----------------------------------------------------------------------------*/
/* execute Job_DefineNode job check resources                                 */
/*----------------------------------------------------------------------------*/
: defineNode::checkResources _eeh ( -- )

  //"checkResources received" .

  job[] locals| pJob_DefineNode |

  //----------------------------------------------------------------------------
  // grab a ddl lock
  DdlLock[].grabRead

  //----------------------------------------------------------------------------
  // check if we have enough buffers
  node::checkEnoughBuffers not if pJob_DefineNode ERROR_JOB !!logError exit then

  //----------------------------------------------------------------------------
  // check if we can make the Node
  //pJob_DefineNode job.nodeName@
  <nodeNm> checkMakeNode not if pJob_DefineNode ERROR_JOB !!logError exit then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

cmdSyntax: defineNode :: define node <nodeNm> {name:value} ;

: defineNode _cmdTags tagCopy: distJob_tags

  tags{
    <cmdDesc>  = "--cmd desc for job--"
  
    <rspKind>  = RS_PARTICIPANT_RESPONSE
    <ddlLock>  = DL_GRAB_WRITE
  
    <preCheck> = bClusterStarted
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
