/*============================================================================*/
/* job_DefineNode.sen -- Job Define Node                                      */
/*============================================================================*/

" job_DefineNode.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check word is not a Node                                                   */
/*----------------------------------------------------------------------------*/
: checkIsNotNode ( "<NodeNm>" -- t|f )

  grid::findNode not if true exit then

  EC_NODE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable Node                                           */
/*----------------------------------------------------------------------------*/
: checkMakeNode ( "<NodeNm>" -- true | errorCode false )

  checkIsNotNode not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* make a Node (run by all participants)                                      */
/*----------------------------------------------------------------------------*/
: makeNode ( "<NodeNm>" )

  params| sNodeNm |
  0 locals| pNode |

  sNodeNm node::new to pNode

  // return Node pointer
  pNode
;

/*----------------------------------------------------------------------------*/
/* Job_DefineNode request (on originating node)                               */
/*----------------------------------------------------------------------------*/
: defineNode_req (  -- <R> )

  >>logEntry <SEED_REQ>

  JP_BEGINNING log::markPhase

  0 0 locals| pJob pTask |

  tp: createNode

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  <nodeNm> "<nodeNm> : %v" fmt.print

  // distribute the job
  pJob job.distribute

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DefineNode job on each node                                    */
/*----------------------------------------------------------------------------*/
: defineNode_exe ( pJob_DefineNode -- )

  >>logEntry <SEED_EXE>

  //params| pJob_DefineNode |
  job::this locals| pJob_DefineNode |

  0 0 locals| pNode sNodeNm |

  tp: defineNode_exe

  //----------------------------------------------------------------------------
  // assert correct job
  //CN_JOB_DEFINENODE pJob_DefineNode object.assertClass

  //----------------------------------------------------------------------------
  // grab a ddl lock
  ddlLock::grabWrite

  //----------------------------------------------------------------------------
  // set task's dictionary stack from path in job
  pJob_DefineNode job.pushPath
  task::dicStack.set

  //----------------------------------------------------------------------------
  // make Node
  <nodeNm> to sNodeNm
  sNodeNm makeNode to pNode


  pJob_DefineNode job::participantExecuted

  <<logExit <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DefineNode job check resources                                 */
/*----------------------------------------------------------------------------*/
: createNode.checkResources ( pJob_DefineNode -- )

  >>logEntry <Check_Resources>

  params| pJob_DefineNode  |

  tp: createNode.checkResources
  //"checkResources received" .

  //----------------------------------------------------------------------------
  // grab a ddl lock
  ddlLock::grabRead

  //----------------------------------------------------------------------------
  // set task's dictionary stack from path in job
  pJob_DefineNode job.pushPath
  task::dicStack.set

  //----------------------------------------------------------------------------
  // check if we have enough buffers
  node::checkEnoughBuffers not if pJob_DefineNode <ERROR_JOB> !!logError exit then

  //----------------------------------------------------------------------------
  // check if we can make the Node
  pJob_DefineNode job.nodeName@
  checkMakeNode not if pJob_DefineNode <ERROR_JOB> !!logError exit then

  <<logExit <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DefineNode job release resources                               */
/*----------------------------------------------------------------------------*/
: createNode.releaseResources ( pJob_DefineNode -- )

  >>logEntry <Release_Resources>

  params| pJob_DefineNode  |

  tp: createNode.releaseResources
  //"releaseResources received" .

  <<logExit <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: defineNode_beg ( -- )

  >>logEntry <SEED_BEG>

  job::this locals| pJob_DefineNode |

  //">> defineNode_beg <<" .

  // add this job to the participants list
  pJob_DefineNode job.becomeParticipant

  // check resources
  pJob_DefineNode createNode.checkResources

  // this job has begun
  job::participantBegun

  <<logExit <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: defineNode_end ( -- )

  >>logEntry <SEED_END>

  job::this locals| pJob_DefineNode |

  //">> defineNode_end <<" .

  // release resources
  pJob_DefineNode createNode.releaseResources

  job::participantEnded

  <<logExit <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: defineNode_can ( -- )

  >>logEntry <SEED_CAN>

  job::this locals| pJob_DefineNode |

  pJob_DefineNode createNode.releaseResources

  job::participantCancelled

  <<logExit <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
