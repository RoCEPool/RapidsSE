/*============================================================================*/
/* job_Docol.sen -- Job Docol                                                 */
/*============================================================================*/

" job_Docol.sen" .verbose

/*----------------------------------------------------------------------------*/
/* docol command request                                                      */
/*----------------------------------------------------------------------------*/
: docol_req ( -- <R> )

  >>logEntry <SEED_REQ>

  0 0 locals| pJob_Docol pTask |


  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob_Docol

  // get the routine from the job
  //pJob_Docol job.routineName@
  <routineNm>
  >:

  begin
    depth while drop
  repeat

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

opSyntax: docol :: docol <routineNm> ;

jobInfo: docol
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_JOB_RESPONSE
  <?ddlLock?>  = DL_NONE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
