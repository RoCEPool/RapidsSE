/*============================================================================*/
/* job_Docol.sen -- Job Docol                                                 */
/*============================================================================*/

"job_Docol.sen" .verbose

/*----------------------------------------------------------------------------*/
/* docol command request                                                      */
/*----------------------------------------------------------------------------*/
: docol_req ( -- <R> )

  0 0 locals| pJob_Docol pTask |

  tp: poolSpaceR35_req

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob_Docol

  // get the objectName (command) from the job
  pJob_Docol job.objectName@

  >:

  begin
  depth while drop
  repeat

  pJob_Docol <DONE_REQUEST>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
