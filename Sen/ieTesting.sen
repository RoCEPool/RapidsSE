/*============================================================================*/
/* ieTesting.sen -- index entry tests                                         */
/*============================================================================*/

"ieTest.sen" .verbose

/*----------------------------------------------------------------------------*/
/* index entry test                                                           */
/*----------------------------------------------------------------------------*/
: ieTest

  "IE testing" .

  index::ibNew locals| ib |

  // generate a row, calling entry test
  50 0 do

    16 str.random I 10 + "%v|%v|" str.format

    ib

    index::entryTest

  loop

  ib

  index::ibDump
;

/*----------------------------------------------------------------------------*/
/* index entry test                                                           */
/*----------------------------------------------------------------------------*/
: ieTestSeq

  "IE testing" .

  index::ibNew locals| ib |

  // generate a row, calling entry test
  1000 0 do

    16 str.random I 10 + "%v|%v|" str.format

    ib

    index::entryTest

  loop

  ib

  index::ibDump
;

/*----------------------------------------------------------------------------*/
/* index column test                                                          */
/*----------------------------------------------------------------------------*/
: icTest

  "Index column testing" .

  index::columnTest
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
