/*============================================================================*/
/* ieTesting.sen -- index entry tests                                         */
/*============================================================================*/

"ieTest.sen" .verbose

/*----------------------------------------------------------------------------*/
/* index entry test                                                           */
/*----------------------------------------------------------------------------*/
: ieTest

  "IE testing" .

  index::ibNew locals| ib |

  // generate rows, calling entry test
  10 0 do

    16 str.random I 10 + "%v|%v|" str.format

    ib

    index::entryTest

  loop

  ib

  index::ibDump
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
