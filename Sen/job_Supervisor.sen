/*============================================================================*/
/* job_Supervisor.sen -- supervisor job                                       */
/*============================================================================*/

" job_Supervisor.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the supervisor job (as a dedicated job)                              */
/*----------------------------------------------------------------------------*/
: supervisor::spawn ( -- )

  0 locals| pJobClass_Supervisor |
  0 locals| pJob_Supervisor |

  CN_JOB_SUPERVISOR jobClass::find to pJobClass_Supervisor

  pJobClass_Supervisor jobClass.new to pJob_Supervisor

  pJob_Supervisor SEED_RUN job.spawn_dedicated
;

/*----------------------------------------------------------------------------*/
/* add peridiodic activity here                                               */
/*----------------------------------------------------------------------------*/
: supervisor_activity ( -- )

  "Supervisor Activity" .

;

/*----------------------------------------------------------------------------*/
/* supervisor loop:                                                           */
/*----------------------------------------------------------------------------*/
: supervisor_run ( -- )

  >>logEntry <SEED_RUN>

  // "Supervisor Job Started" .

  CN_JOB_SUPERVISOR task::this task.thread thread.dedicated!


  begin

    args.supervisorSleep thread::sleepSsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
