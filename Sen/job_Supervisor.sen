/*============================================================================*/
/* job_Supervisor.sen -- supervisor job                                       */
/*============================================================================*/

" job_Supervisor.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add peridiodic activity here                                               */
/*----------------------------------------------------------------------------*/
: supervisor::activity ( -- )

  "Supervisor Activity" .

;

/*----------------------------------------------------------------------------*/
/* supervisor loop:                                                           */
/*----------------------------------------------------------------------------*/
: supervisor_req ( -- )

  std_entryHook

   "Supervisor Job Started" .

  begin

    supervisor::activity
    args.supervisorSleep thread::sleepSsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

opSyntax: supervisor :: supervisor ;

jobInfo: supervisor
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NONE
  <?ddlLock?>  = DL_NONE
  
  //<?preCheck?> = bClusterStarted
  
  <?cmdKind?>  = CK_SERVICE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
