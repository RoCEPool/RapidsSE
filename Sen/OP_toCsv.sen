/*============================================================================*/
/* OP_toCsv.sen -- Operator toCsv                                             */
/*============================================================================*/

" OP_toCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ToCsvOp_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  Operand[].crwToCsv
  Operand[].get to Subset[]
  begin
    Operand[].isNull
  not while
    assert::stack_0
    Operand[].pipeOut
    Subset[].nextBuffer to Operand[]
    assert::stack_0
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: ToCsvOp_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Operand[].delete
  StreamDef[].newToCsvStream
  StreamDef[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for ToCsvOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCsvOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: ToCsvOp_CrwBuffer  ZK_CRWBUFFER op[].handler!
  find: ToCsvOp_StreamDef  ZK_STREAMDEF op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: ToCsvOp :: ToCsvOp ;

opInfo: ToCsvOp {
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
