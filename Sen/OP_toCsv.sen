/*============================================================================*/
/* OP_toCsv.sen -- Operator toCsv                                             */
/*============================================================================*/

" OP_toCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ToCsv_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Pipein[]

  Operand[].crwToCsv
  Operand[].get to Subset[]
  begin
    Operand[].isNull
  not while
    assert::stack_0
    Operand[].pipeOut
    Subset[].nextBuffer to Operand[]
    assert::stack_0
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: ToCsv_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Pipein[].delete
  streamDef[].newToCsvStream
  streamDef[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for ToCsv req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCsv_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: ToCsv_CrwBuffer  ZK_CRWBUFFER op[].handler!
  find: ToCsv_StreamDef  ZK_STREAMDEF op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: ToCsv :: ToCsv ;

: ToCsv opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
