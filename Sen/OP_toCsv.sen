/*============================================================================*/
/* OP_toCsv.sen -- Operator toCsv                                             */
/*============================================================================*/

" OP_toCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: toCsv_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  Operand[].crwtoCsv
  Operand[] to Subset[]

  begin
    Operand[].isNull

  not while

    assert::stack_0

    // get the next buffer
    Subset[].nextBuffer to Subset[]

    // now pipeout the Operand
    Operand[].pipeOut

    // move Subset to Operand
    Subset[] to Operand[]

    assert::stack_0
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: toCsv_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  PipeIn[].delete
  streamDef[].newtoCsvStream
  streamDef[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for toCsv req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : toCsv_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toCsv_CrwBuffer  ZK_CRWBUFFER op[].handler!
  find: toCsv_StreamDef  ZK_STREAMDEF op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toCsv :: toCsv ;

: toCsv _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
