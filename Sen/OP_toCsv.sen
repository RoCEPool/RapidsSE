/*============================================================================*/
/* OP_toCsv.sen -- Operator toCsv                                             */
/*============================================================================*/

" OP_toCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for ToCsvOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCsvOp_req ( -- )

  LogEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        //"Operand:- ZK_CRWBUFFER" .verbose
        Operand[].crwToCsv
        Operand[].get to Subset[]
        begin
          Operand[].isNull
        not while
          assert::stack_0
          Operand[].pipeOut
          Subset[].nextBuffer to Operand[]
          assert::stack_0
        repeat
        true
      endof

      ZK_STREAMDEF of
        //"Operand:- ZK_STREAMDEF" .verbose
        Operand[].delete
        StreamDef[].newToCsvStream
        StreamDef[].pipeout
        true
      endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogExit
  job::deleteThis
  DONE_RUN
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: ToCsvOp :: ToCsvOp ;

jobInfo: ToCsvOp
{
  ?<jobDesc>?  = "--description of job--"
  
  ?<jobKind>?  = JK_LOCAL
  ?<rspKind>?  = RS_PARTICIPANT_RESPONSE
  ?<ddlLock>?  = DL_GRAB_READ
  
  ?<preCheck>? = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
