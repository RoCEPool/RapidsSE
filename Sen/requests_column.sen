/*============================================================================*/
/* requests_column.sen -- the set of column related requests                  */
/*============================================================================*/

" requests_column.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: addColumn_req ( "<columnTy>" "<sColumnNm>" "<sTableNm>" -- <R> )

  locals| sTableNm sColumnNm |

  assertInTables

  // push table folder
  sTableNm pushTable assert

  sColumnNm sTableNm
  checkAddColumn not if <NIP+ERROR> popTable exit then

  sColumnNm sTableNm
  addColumn ( ) assert::stack_0

  // pop table folder
  popTable

  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* add an index column                                                        */
/*----------------------------------------------------------------------------*/
: addIdxColumn_req ( "<sColumnNm>" "<sIndexNm>" "<sTableNm>" -- <R> )

  locals| sTableNm sIndexNm sColumnNm  |

  assertInTables

  // push table folder
  sTableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  sColumnNm sIndexNm sTableNm
  checkAddIndexColumn not if <NIP+ERROR> popIndexes popTable exit then

  sColumnNm sIndexNm
  addIndexColumn ( ) assert::stack_0

  // pop indexs folder
  popIndexes

  // pop table folder
  popTable

  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* add a partition column                                                     */
/*----------------------------------------------------------------------------*/
: addPartColumn_req ( "<sColumnNm>" "<sTableNm>" -- <R> )

  locals| sTableNm sColumnNm  |

  assertInTables

  // push table folder
  sTableNm pushTable assert

  // push partitions folder
  pushPartitions

  sColumnNm sTableNm
  checkAddPartitionColumn not if <NIP+ERROR> popPartitions popTable exit then

  sColumnNm sTableNm
  addPartitionColumn ( ) assert::stack_0

  // pop partitions folder
  popPartitions

  // pop table folder
  popTable

  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
/*
: listColumns_req ( "<sTableNm>" -- <R> )

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if popTable <NIP+ERROR> exit then

  args.metadata if
    "(columnDefinition VARCHAR)" metadata!
  then

  listColumns

  // pop table dictionary
  popTable

  <SUCCESS>
