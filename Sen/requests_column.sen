/*============================================================================*/
/* requests_column.sen -- the set of column related requests                  */
/*============================================================================*/

"requests_column.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column ( "<columnTy>" "<sColumnNm>" "<sTableNm>" -- <R> )

  locals| sTableNm sColumnNm |

  sColumnNm sTableNm
  checkAddColumn not if <NIP+ERROR> exit then

  sColumnNm sTableNm
  addColumn ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* add an index column                                                        */
/*----------------------------------------------------------------------------*/
: add_idxcolumn ( "<sColumnNm>" "<sIndexNm>" "<sTableNm>" -- <R> )

  locals| sTableNm sIndexNm sColumnNm  |

  sColumnNm sIndexNm sTableNm
  checkAddIndexColumn not if <NIP+ERROR> exit then

  sColumnNm sIndexNm
  addIndexColumn ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* add a partition column                                                     */
/*----------------------------------------------------------------------------*/
: add_partcolumn ( "<sColumnNm>" "<sTableNm>" -- <R> )

  locals| sTableNm sColumnNm  |

  sColumnNm sTableNm
  //checkAddPartColumn not if <NIP+ERROR> exit then

  sColumnNm
  //addPartColumn ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<sTableNm>" -- <R> )

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if popTable <NIP+ERROR> exit then

  args.metadata if
    "(columnDefinition VARCHAR)" metadata!
  then

  listColumns

  // pop table dictionary
  popTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get list of index columns                                                  */
/*----------------------------------------------------------------------------*/
: list_indexcolumns ( "<sTableNm" "<sIndexNm>" -- <R> )

  locals| sIndexNm sTableNm |

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  // check it is an index
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  args.metadata if
    "(columnName VARCHAR, columnType VARCHAR)" metadata!
  then

  sIndexNm listIndexColumns

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <SUCCESS>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
