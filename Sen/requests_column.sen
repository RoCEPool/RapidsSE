/*============================================================================*/
/* requests_column.sen -- the set of column related requests                  */
/*============================================================================*/

"requests_column.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add a column                                                               */
/*----------------------------------------------------------------------------*/
: add_column ( "<columnTy>" "<columnNm>" "<tableNm>" -- <R> )

  locals| tableNm columnNm |

  columnNm tableNm
  checkAddColumn not if <NIP+ERROR> exit then

  columnNm tableNm
  addColumn ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* add an index column                                                        */
/*----------------------------------------------------------------------------*/
: add_idxcolumn ( "<columnNm>" "<indexNm>" "<tableNm>" -- <R> )

  locals| tableNm indexNm columnNm  |

  columnNm indexNm tableNm
  checkAddIndexColumn not if <NIP+ERROR> exit then

  columnNm indexNm
  addIndexColumn ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of columns                                                        */
/*----------------------------------------------------------------------------*/
: list_columns ( "<tableNm>" -- <R> )

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  args.metadata if
    "(columnDefinition VARCHAR)" metadata!
  then

  listColumns

  // pop table dictionary
  popTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get list of index columns                                                  */
/*----------------------------------------------------------------------------*/
: list_indexcolumns ( "<tableNm" "<indexNm>" -- <R> )

  locals| indexNm tableNm |

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  // check it is an index
  indexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  args.metadata if
    "(columnName VARCHAR, columnType VARCHAR)" metadata!
  then

  indexNm listIndexColumns

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <SUCCESS>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
