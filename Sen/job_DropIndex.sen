/*============================================================================*/
/* job_DropIndex.sen -- Job Index Table                                       */
/*============================================================================*/

" job_DropIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable index folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveIndex ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // should be in the tables folder
  folder[].checkInTables not if false exit then

  // there should be a table folder
  sTableNm folder[].checkIsTablesFolder not if false exit then

  true 
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropIndex job on a node                                        */
/*----------------------------------------------------------------------------*/
: dropIndex::execute _eeh ( -- )

  job[] locals| pJob_DropIndex |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  pJob_DropIndex removeIndex
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropIndex job check resources                                  */
/*----------------------------------------------------------------------------*/
: dropIndex::checkResources _eeh ( -- )

  0 0 locals| sIndexNm sTableNm |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check remove index
  sTableNm checkRemoveIndex not if job[] ERROR_JOB !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm path[].pushTableFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexesFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm name::checkIsIndex not if
    path[].discardIndexesFolder
    path[].discardTableFolder
    folder[].isTables assert
    job[] ERROR_JOB !!logError exit
  then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: dropIndex :: drop index <tableNm> <indexNm> ;

jobInfo: dropIndex
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
