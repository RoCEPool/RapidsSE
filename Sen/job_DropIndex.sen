/*============================================================================*/
/* job_DropIndex.sen -- Job Index Table                                       */
/*============================================================================*/

" job_DropIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* tidy up of the index                                                       */
/*----------------------------------------------------------------------------*/
: indexTidyUp ( "<indexNm>" -- )

  params| sIndexNm |
  0 locals| pIndex |

  // find the index
  sIndexNm find execute to pIndex

  // truncate the index
  pIndex index.truncate
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable index folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveIndex ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // should be in the tables folder
  checkInTables not if false exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if false exit then

  true 
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeIndex ( Job_DropIndex )

  params| pJob_DropIndex |
  0 0 0 locals| pIndex sIndexNm sTableNm |

  pJob_DropIndex job.indexName@ to sIndexNm
  pJob_DropIndex job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index from the table
  sIndexNm find execute to pIndex
  pIndex pIndex index.table@ table.removeIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up the index and forget it
  sIndexNm indexTidyUp
  sIndexNm :forget

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes folder
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  popTable
;

/*----------------------------------------------------------------------------*/
/* drop index request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: dropIndex_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: dropIndex_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropIndex job on a node                                        */
/*----------------------------------------------------------------------------*/
: dropIndex_exe ( Job_DropIndex -- )

  >>am <SEED_EXE>

  //params| pJob_DropIndex |
  job::this locals| pJob_DropIndex |

  tp: dropIndex_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_DROPINDEX pJob_DropIndex object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_DropIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  pJob_DropIndex removeIndex
  assertInTables

  pJob_DropIndex job.notice

  pJob_DropIndex job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropIndex job check resources                                  */
/*----------------------------------------------------------------------------*/
: dropIndex.checkResources ( Job_DropIndex -- )

  >>am <Check_Resources>

  params| pJob_DropIndex  |
  0 0 locals| sIndexNm sTableNm |

  tp: dropIndex.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_DropIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  pJob_DropIndex job.indexName@ to sIndexNm
  pJob_DropIndex job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check remove index
  sTableNm checkRemoveIndex not if pJob_DropIndex <ERROR_JOB> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables pJob_DropIndex <ERROR_JOB> !!am exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // cannot drop hidden index
  sIndexNm "hidden" str.equal if
    popIndexes popTable assertInTables EC_NO_SUCH_INDEX pJob_DropIndex <ERROR_JOB> !!am exit
  then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropIndex job release resources                                */
/*----------------------------------------------------------------------------*/
: dropIndex.releaseResources ( Job_DropIndex -- )

  >>am <Release_Resources>

  params| pJob_DropIndex  |

  tp: dropIndex.releaseResources
  //releaseResources received" .

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: dropIndex_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_dropIndex |

  pJob_dropIndex job.becomeParticipant

  // check resources
  pJob_dropIndex dropIndex.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: dropIndex_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_dropIndex |

  pJob_dropIndex dropIndex.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: dropIndex_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_dropIndex |

  pJob_dropIndex dropIndex.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
