/*============================================================================*/
/* job_DropIndex.sen -- Job Index Table                                       */
/*============================================================================*/

" job_DropIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* tidy up of the index                                                       */
/*----------------------------------------------------------------------------*/
: indexTidyUp ( "<indexNm>" -- )

  params| sIndexNm |
  0 locals| pIndex |

  // find the index
  sIndexNm find execute to pIndex

  // truncate the index
  pIndex index.truncate
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable index folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveIndex ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // should be in the tables folder
  checkInTables not if false exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if false exit then

  true 
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeIndex ( Job_DropIndex )

  params| pJob_DropIndex |
  0 0 0 locals| pIndex sIndexNm sTableNm |

  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index from the table
  sIndexNm find execute to pIndex
  pIndex pIndex index.table@ table.removeIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up the index and forget it
  sIndexNm indexTidyUp
  sIndexNm :forget

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes folder
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  popTable
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropIndex job on a node                                        */
/*----------------------------------------------------------------------------*/
: dropIndex::execute _eeh ( -- )

  job::this locals| pJob_DropIndex |

  tp: dropIndex_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  pJob_DropIndex removeIndex
  assertInTables

;

/*----------------------------------------------------------------------------*/
/* execute Job_DropIndex job check resources                                  */
/*----------------------------------------------------------------------------*/
: dropIndex::checkResources _eeh ( -- )

  0 0 locals| sIndexNm sTableNm |

  tp: dropIndex.checkResources

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check remove index
  sTableNm checkRemoveIndex not if job::this <ERROR_JOB> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
  popIndexes popTable assertInTables job::this <ERROR_JOB> !!logError exit
  then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: dropIndex :: drop index <tableNm> <indexNm> ;

jobInfo: dropIndex
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_WRITE
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
