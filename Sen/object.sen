/*============================================================================*/
/* object.sen -- object words                                                 */
/*============================================================================*/

" object.send" .verbose

/*----------------------------------------------------------------------------*/
/* create a node using name on the stack (leaves node word on stack)          */
/*----------------------------------------------------------------------------*/
: object.assertClass ( eClassNo pObject -- )

  locals| pObject |
  locals| eClassNo |

  pObject object.class@ eClassNo !=
  if
      pObject object.class@
      eClassNo
    "Expecting class %v; actual class %v\n" str.format .
    assert
  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
