/*============================================================================*/
/* OP_chunk.sen -- Operator chunk                                             */
/*============================================================================*/

" OP_chunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_PulseMarker \handler

  0 locals| iRowSize |

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // find the __seekOffsets table
  C_TDEF_SEEKOFFSETS op__tableDef assert

  // create a new streamDef
  StreamDef[].new

  // get row size from streamDef
  StreamDef[].rowSize to iRowSize

  // pipeout the streamDef
  StreamDef[].pipeout

  // set eof location in counter0
  File0[].getEofLocation to counter1[]

  // set chunk location in counter1 to 0
  0 to counter0[]

  begin
    counter1[] counter0[] >
  while
    // create an infoSet operand
    iRowSize InfoSet[].newInfoSet
    InfoSet[].chunkFile
    InfoSet[].pipeOut
  repeat

  nullptr to Operand[]

  // send EOSMARKER
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for reading
  file::new to File0[]
  <fileNm> OPEN_READ File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 nullptr File0[].set EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
  else
    Pipein[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EXITMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: chunk_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then

  Pipein[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for chunk req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Chunk_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: chunk_PulseMarker ZK_PULSEMARKER op[].handler!
  find: chunk_StartMarker ZK_STARTMARKER op[].handler!
  find: chunk_ExitMarker  ZK_EXITMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: Chunk :: Chunk <fileNm> ;

: Chunk opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
