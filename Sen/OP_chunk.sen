/*============================================================================*/
/* OP_chunk.sen -- Operator chunk                                             */
/*============================================================================*/

" OP_chunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // find the __seekOffsets table
  C_TDEF_SEEKOFFSETS op__tableDef assert

  // create a new streamDef and save it in Operand
  table[] StreamDef[].new
  StreamDef[] to Operand[]
  nullptr to StreamDef[]

  // create the streamDef to be piped out
  table[] StreamDef[].new

  // pipeout the streamDef
  StreamDef[].pipeout

  // set eof location in counter0
  File0[].getEofLocation to counter1[]

  // set chunk location in counter1 to 0
  0 to counter0[]

  begin
    counter1[] counter0[] >
  while
    // create an infoSet operand
    Operand[] InfoSet[].new
    InfoSet[].chunkFile
    InfoSet[].pipeOut
  repeat

  Operand[].delete

  // send EOSMARKER
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  0 locals| iFileSize |

  // open the file for reading
  <fileNm> OPEN_READ op__file if
    Pipein[].pipeout
  then
/*
  // get size of file
  //File0[].getSize to iFileSize
  10 to iFileSize

  C_TDEF_TOTALUNITS op__tableDef assert
  table[] StreamDef[].new

  // create an infoSet operand
  StreamDef[] InfoSet[].new

  StreamDef[] C_1Mb iFileSize / InfoSet[].addTotalUnits assert

  // pipeout the streamDef
  StreamDef[].pipeout

  // pipeout the infoset
  InfoSet[].pipeout
*/
  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EXITMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: chunk_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then

  Pipein[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for chunk req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Chunk_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: chunk_PulseMarker ZK_PULSEMARKER op[].handler!
  find: chunk_StartMarker ZK_STARTMARKER op[].handler!
  find: chunk_ExitMarker  ZK_EXITMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: Chunk :: Chunk <fileNm> ;

: Chunk opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
