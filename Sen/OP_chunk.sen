/*============================================================================*/
/* OP_chunk.sen -- Operator chunk                                             */
/*============================================================================*/

" OP_chunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                        */
/*----------------------------------------------------------------------------*/
: chunk_DataMarker \handler

  //"Operand:- ZK_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // find the __seekOffsets table
  C_TDEF_SEEKOFFSETS op__tableDef_infoSet assert

  // set eof location in counter0
  File0[].getEofLocation to counter1[]

  // set chunk location in counter1 to 0
  0 to counter0[]

  begin
    counter1[] counter0[] >
  while
    //counter1[] "counter1 %v" .printf
    //counter0[] "counter0 %v" .printf

    // create an infoSet operand
    infoSetTable[] InfoSet[].new
    InfoSet[].chunkFile
    InfoSet[].pipeOut
  repeat

  // send EOSMARKER
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  0 locals| iFileSizeMb |

  // open the file for reading
  <fileNm> OPEN_READ op__file if

    PipeIn[].pipeOut

    // get size of file
    File0[].size C_1Mb / to iFileSizeMb

    // create a streamDef for C_TDEF_TOTALUNITS
    C_TDEF_TOTALUNITS op__tableDef_infoSet assert

    // create an infoSet operand for C_TDEF_TOTALUNITS
    infoSetTable[] InfoSet[].new

    // add fileSize to the infoset
    <fileNm> iFileSizeMb infoSetTable[] InfoSet[].addTotalUnits assert

    // pipeout the infoset
    InfoSet[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EXITMARKER ...                                                       */
/*----------------------------------------------------------------------------*/
: chunk_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then

  PipeIn[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for chunk req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : chunk_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: chunk_DataMarker ZK_DATAPULSE op[].handler!
  find: chunk_StartMarker ZK_STARTMARKER op[].handler!
  find: chunk_ExitMarker  ZK_EXITMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: chunk :: chunk <fileNm> ;

: chunk _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
