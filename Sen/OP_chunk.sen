/*============================================================================*/
/* OP_chunk.sen -- Operator chunk                                             */
/*============================================================================*/

" OP_chunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_PulseMarker

  //"Operand:- ZK_PULSEMARKER" .verbose
  Operand[].pipeOut

  // set eof location in counter0
  File0[].getEofLocation to counter1[]

  // set chunk location in counter1 to 0
  0 to counter0[]

  begin
    counter1[] counter0[] >
  while
    // create a seekOffset operand
    Operand[].newSeekOffsets
    Operand[].chunkFile
    Operand[].pipeOut
  repeat

  // send EOSMARKER
  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_StartMarker

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for reading
  file::new to File0[]
  <fileNm> OPEN_READ File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 nullptr File0[].set EC_INVALID_FILE
    op.pipelineJob@ <ERROR_JOB> !!logError
    Operand[].delete
    Operand[].newErrorMarker
  then
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STOPMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: chunk_StopMarker

  //"Operand:- ZK_STOPMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then

  Operand[].pipeOut
  Op.ackPipelineJob
;

/*----------------------------------------------------------------------------*/
/* execute for chunk req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Chunk_req ( -- )
 
  >>logEntry <SEED_REQ>

  job[] locals| pJob_ToFileOp |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_PULSEMARKER of chunk_PulseMarker true endof

      ZK_STARTMARKER of chunk_StartMarker true endof

      ZK_STOPMARKER of chunk_StopMarker false endof

      // handle other operand as generic operands
      jobOperand::generic swap

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: Chunk :: Chunk <fileNm> ;

jobInfo: Chunk
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
