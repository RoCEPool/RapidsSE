/*============================================================================*/
/* OP_chunk.sen -- Operator chunk                                             */
/*============================================================================*/

" OP_chunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Operand[].pipeOut

  // set eof location in counter0
  File0[].getEofLocation to counter1[]

  // set chunk location in counter1 to 0
  0 to counter0[]

  begin
    counter1[] counter0[] >
  while
    // create an infoSet operand
    2 InfoSet[].newInfoSet
    InfoSet[].chunkFile
    InfoSet[].pipeOut
  repeat

  // send EOSMARKER
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for reading
  file::new to File0[]
  <fileNm> OPEN_READ File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 nullptr File0[].set EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  then
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STOPMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: chunk_StopMarker \handler

  //"Operand:- ZK_STOPMARKER" .verbose
  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then

  Operand[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for chunk req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Chunk_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: chunk_PulseMarker ZK_PULSEMARKER op[].handler!
  find: chunk_StartMarker ZK_STARTMARKER op[].handler!
  find: chunk_StopMarker  ZK_STOPMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: Chunk :: Chunk <fileNm> ;

jobInfo: Chunk
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
