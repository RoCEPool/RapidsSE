/*============================================================================*/
/* OP_compactIndex.sen -- Operator compact index                              */
/*============================================================================*/

" OP_compactIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: compactIdx_action

  <tableNm> <indexNm> op__table_index if
    index[].compact
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: compactIdx :: compactIdx   <tableNm> <indexNm> ;

: compactIdx opInfo tagCopy: liteOp_tags
  tags{
    <jobDesc>   = "--description of operator--"
    <liteOp>    = true
    <params>    = 2
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
