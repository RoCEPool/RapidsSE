/*============================================================================*/
/* indexDefn.sen -- index definition related words                            */
/*============================================================================*/

"indexDefn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* index definition is used as a kind of word to identify index definitions   */
/*----------------------------------------------------------------------------*/
: indexDefn ;

/*----------------------------------------------------------------------------*/
/* create an indexDefn (doesnt leave index on stk)                            */
/*----------------------------------------------------------------------------*/
: indexDefn:

  create
  WT_OBJECT word.this word.type!
  sizeof_indexDefn allot
  word.this >body object.magic!
  CN_INDEXDEFN word.this >body object.class!
  word.this >body indexDefn.init
  true word.this >body object.wordbody!
  ' indexDefn word.this word.kind!
  does>
;

/*----------------------------------------------------------------------------*/
/* create an index definition (leaves index on stack)                         */
/*----------------------------------------------------------------------------*/
: :indexDefn

  >create
  WT_OBJECT word.this word.type!
  sizeof_indexDefn allot
  word.this >body object.magic!
  CN_INDEXDEFN word.this >body object.class!
  word.this >body indexDefn.init
  true word.this >body object.wordbody!
  ' indexDefn word.this word.kind!
  word.this
  does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
