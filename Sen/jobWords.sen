/*============================================================================*/
/* jobWords.sen -- Job related words                                          */
/*============================================================================*/

"jobWords.sen" .verbose

/*----------------------------------------------------------------------------*/
/* print job notice                                                           */
/*----------------------------------------------------------------------------*/
: job.notice ( pJob -- )

  params| pJob |

    pJob job.participant@
    pJob job.Id@
    pJob object.class@ class::name
  "NOTICE: %v jobId %v executed on node %v" fmt.print
;

/*----------------------------------------------------------------------------*/
/* return from job execution on origin                                        */
/*----------------------------------------------------------------------------*/
: <DONE_REQUEST> ( --  )

  // push "<ok>" as the return str
  "<ok>"

  // push 0 to indicate success / no error
  0

  // there are two return arguments
  2

;

/*----------------------------------------------------------------------------*/
/* return from job execution on node                                          */
/*----------------------------------------------------------------------------*/
: <DONE_NODE> ( --  )

  ddlLock::testDrop
;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_JOB> ( errorCode pJob -- )

  locals| pJob errorCode |

  errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode grid::thisNode@ pJob job.error!

  ddlLock::testDrop
;

/*----------------------------------------------------------------------------*/
/* check system has enough buffers                                            */
/*----------------------------------------------------------------------------*/
: checkEnoughBuffersR35

  // return true if enough buffers, others return error code
  bp::freeBuffers 100 >
  if
    true exit
  else
    EC_LOW_BUFFERS false
  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
