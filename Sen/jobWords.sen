/*============================================================================*/
/* jobWords.sen -- Job related words                                          */
/*============================================================================*/

" jobWords.sen" .verbose

0 constant SEED_RUN
1 constant SEED_REQ
2 constant SEED_RCV
3 constant SEED_EXE
4 constant SEED_END
5 constant SEED_CAN

/*----------------------------------------------------------------------------*/
/* begin a new job on participant node                                        */
/*----------------------------------------------------------------------------*/
: job.beginParticipant ( pJob -- )

  params| pJob |

    grid::thisNode@
    pJob object.class@ class::name
    "Participant Job %v Received Node %v "
  fmt.print

  // set participant node in job
  grid::thisNode@ pJob job.participant!

  // add job as participant job
  pJob job.addParticipant
;

/*----------------------------------------------------------------------------*/
/* begun a job on participant node                                            */
/*----------------------------------------------------------------------------*/
: job::participantBegun ( -- )

  job::this locals| pJob |

  // send job__begun back to originating node
  pJob "Job__Begun::send" find execute

  // the job remains in the participant list
  // the task exits and gets deleted
  nullptr task::this task.job!
;

/*----------------------------------------------------------------------------*/
/* ended a job on participant node                                            */
/*----------------------------------------------------------------------------*/
: job::participantEnded ( -- )

  job::this locals| pJobParticipant |

  pJobParticipant "Job__Ended::send" find execute

  // remove the job from the participant jobs
  pJobParticipant job.removeParticipant

  // delete the job
  "delete_completed_job" find execute

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* cancelled a job on participant node                                        */
/*----------------------------------------------------------------------------*/
: job::participantCancelled ( -- )

  job::this locals| pJobParticipant |

  pJobParticipant "Job__Cancelled::send" find execute

  // remove the job from the participant jobs
  pJobParticipant job.removeParticipant

  // delete the job
  "delete_completed_job" find execute

  ::task_exit
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* delete this task's job (it's completed)                                    */
/*----------------------------------------------------------------------------*/
: delete_completed_job ( -- )

  0 locals| pThisTask |
  0 locals| pThisJob  |

  // get this task and job
  task::this to pThisTask
  pThisTask task.job@ to pThisJob

  // now delete the ended job
  nullptr pThisTask task.job!
  pThisJob job.delete
;

/*----------------------------------------------------------------------------*/
/* call Job__Executed::send for the current job                               */
/*----------------------------------------------------------------------------*/
: send_job__executed ( pJobParticipant -- )

  params| pJobParticipant  |

  pJobParticipant "Job__Executed::send" find execute
;

/*----------------------------------------------------------------------------*/
/* print job notice                                                           */
/*----------------------------------------------------------------------------*/
: job.notice ( pJob -- )

  params| pJob |

    pJob job.participant@
    pJob job.Id@
    pJob object.class@ class::name
  "NOTICE: %v jobId %v executed on node %v" fmt.print
;

/*----------------------------------------------------------------------------*/
/* return from job execution on origin                                        */
/*----------------------------------------------------------------------------*/
: <DONE_REQ> ( --  )

  job::this locals| pJob |

  ddlLock::testDrop

  // null the job in the task
  nullptr task::this task.job!

  pJob job.isPromptCommand true == if
    "Acking prompt task" .
    pJob job.promptTask@ ack
  else
    "Signalling connector thread" .
    pJob job.signalConnector
  then
;

/*----------------------------------------------------------------------------*/
/* return from job execution on node                                          */
/*----------------------------------------------------------------------------*/
: <DONE_EXE> ( --  )

  ddlLock::testDrop

  ::task_exit
;

/*----------------------------------------------------------------------------*/
/* return from oneshot execution                                              */
/*----------------------------------------------------------------------------*/
: <DONE_ONESHOT> ( pJob --  )

  params| pJob |
;

/*----------------------------------------------------------------------------*/
/* return from child job execution                                            */
/*----------------------------------------------------------------------------*/
: <DONE_CHILD> ( pJob --  )

  params| pJob |

  task::this task.parent@ ack
;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_JOB> ( errorCode pJob -- )

  params| pJob errorCode |

  ddlLock::testDrop

  errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode grid::thisNode@ pJob job.error!
;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: <ERROR_REQUEST> ( errorCode pJob -- )

  params| pJob errorCode |

  ddlLock::testDrop

  // null the job in the task
  nullptr task::this task.job!

  errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode grid::thisNode@ pJob job.error!

  pJob job.isPromptCommand true == if
    "Acking prompt task" .
    pJob job.promptTask@ ack
  else
    "Signalling connector thread" .
    pJob job.signalConnector
  then

;

/*----------------------------------------------------------------------------*/
/* check system has enough buffers                                            */
/*----------------------------------------------------------------------------*/
: checkEnoughBuffersR35

  // return true if enough buffers, others return error code
  bp::freeBuffers 100 >
  if
    true exit
  else
    EC_LOW_BUFFERS false
  then
;

/*----------------------------------------------------------------------------*/
/* send object across the socket                                              */
/*----------------------------------------------------------------------------*/
: >socketObject ( pObject -- )

  task::this task.sendNode@ node.socket@

  tp: sending

  socket.sendObject ( bool )

  not if
    "send failure" .
  then
;

/*----------------------------------------------------------------------------*/
/* send valset across the socket                                              */
/*----------------------------------------------------------------------------*/
: >socketValSet ( valset -- )

  task::this task.sendNode@ node.socket@

  tp: sending

  socket.sendValSet ( bool )

  not if
    "send failure" . ( 0/1 )
  then
;

/*----------------------------------------------------------------------------*/
/* recv object from the socket                                                */
/*----------------------------------------------------------------------------*/
: socketObject> ( -- pObject )

  task::this task.socket@

  tp: receiving

  socket.recvObject

  tp: received
;

/*----------------------------------------------------------------------------*/
/* recv valset from the socket                                                */
/*----------------------------------------------------------------------------*/
: socketValSet> ( -- valset )

  task::this task.socket@

  tp: receiving

  socket.recvValSet

  tp: received
;

/*----------------------------------------------------------------------------*/
/* send across the socket                                                     */
/*----------------------------------------------------------------------------*/
: >socket ( x -- )

  >socketObject
;

/*----------------------------------------------------------------------------*/
/* recv from the socket                                                       */
/*----------------------------------------------------------------------------*/
: socket> ( -- x )

  socketObject>
;

/*----------------------------------------------------------------------------*/
/* distribute the job to all the nodes                                        */
/*----------------------------------------------------------------------------*/
: job.distribute ( pJob -- )

  params| pJob |

  // set originating task
  task::this pJob job.originatingTask!

  // add job to originator jobs
  pJob job.addOriginator

  // set the no of acks expected in originator job to nodes in the grid
  grid::nodes pJob job.acksRemaining!

  // grab this task's lock
  task::this task.grabLock

  // set acks for originator task
  1 setAcks

  // send the job to each node in the grid
  grid::nodes 0 do

    // set the send node
    I grid::node task::this task.sendNode!

    task.send

    pJob job.preSend

    // send job
    pJob >socket

  loop

  // wait for ack from deciding job__Ended
  ackWait
;

/*----------------------------------------------------------------------------*/
/* copy dictionary path from job to datastack                                 */
/*----------------------------------------------------------------------------*/
: getPath ( pJob -- )

  0 0 locals| pDicPathJob pDicStackTask pJob |

  // get job dic path
  pJob job.dicPath to pDicPathJob

  // get task dic stack
  task::this task.dicStack to pDicStackTask

  // copy the path from job dic path onto data stack
  pDicPathJob dicPath.depth 0 ?do
    I pDicPathJob dicPath.pick
  loop

  pDicPathJob dicPath.depth
;

/*----------------------------------------------------------------------------*/
/* set dictionary path of this task back into seitf                           */
/*----------------------------------------------------------------------------*/
: savePath ( -- )

  0 0 locals| pDicStackSEitf pDicStackTask |

  // get seitf dic stack
  task::this task.seitf@ seitf.dicStack to pDicStackSEitf

  // get task dic stack
  task::this task.dicStack to pDicStackTask

  // copy the path from task dic stack onto data stack
  pDicStackTask dicStack.depth 0 ?do
    I pDicStackTask dicStack.pick
  loop

  // clear seitf dic stack
  pDicStackSEitf dicStack.dropAll

  // copy the path from data stack onto seitf dic stack
  pDicStackTask dicStack.depth 0 ?do
    pDicStackSEitf dicStack.push
  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
