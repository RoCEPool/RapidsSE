/*============================================================================*/
/* jobWords.sen -- Job related words                                          */
/*============================================================================*/

" jobWords.sen" .verbose

/*----------------------------------------------------------------------------*/
/* set dictionary path of this task back into session                         */
/*----------------------------------------------------------------------------*/
: setPath ( -- )

  0 0 locals| pDicStackTask |

  // get task dic stack
  task::this task.dicStack to pDicStackTask

  // copy the path from task dic stack onto data stack
  pDicStackTask dicStack.depth 0 ?do
    pDicStackTask dicStack.depth 1 - I - pDicStackTask dicStack.pick dic.name
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // store path into the sessions <path>=<...>
  pDicStackTask dicStack.depth strVec::toPath to /session <path>
;


/*----------------------------------------------------------------------------*/
/* job becomes a participant on participant node                              */
/*----------------------------------------------------------------------------*/
: job.becomeParticipant ( pJob -- )

  params| pJob |

 //   grid::thisNode@
 //   pJob object.class@ class::name
 //   "Participant Job %v Received Node %v "
 // fmt.print

  // set participant node in job
  grid::thisNode@ pJob job.participant!

  // add job as participant job
  pJob job.addParticipant
;

/*----------------------------------------------------------------------------*/
/* job becomes a participant on participant node                              */
/*----------------------------------------------------------------------------*/
: job::becomeParticipant ( -- )

  job::this locals| pJob |

  // set participant node in job
  grid::thisNode@ pJob job.participant!

  // add job to participant job list
  pJob job.addParticipant
;

/*----------------------------------------------------------------------------*/
/* begun a job on participant node                                            */
/*----------------------------------------------------------------------------*/
: job::participantBegun ( -- )

  job::this locals| pJob |

  // send job__begun back to originating node
  pJob "Job__Begun::send" find execute
;

/*----------------------------------------------------------------------------*/
/* ended a job on participant node                                            */
/*----------------------------------------------------------------------------*/
: job::participantEnded ( -- )

  job::this locals| pJobParticipant |

  pJobParticipant job.removeParticipant

  pJobParticipant "Job__Ended::send" find execute
;

/*----------------------------------------------------------------------------*/
/* cancelled a job on participant node                                        */
/*----------------------------------------------------------------------------*/
: job::participantCancelled ( -- )

  job::this locals| pJobParticipant |

  pJobParticipant job.removeParticipant

  pJobParticipant "Job__Cancelled::send" find execute
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* delete this task's job (it's completed)                                    */
/*----------------------------------------------------------------------------*/
: job::deleteThis ( -- )

  0 locals| pThisTask |
  0 locals| pThisJob  |

  // get this task and job
  task::this to pThisTask
  pThisTask task.job@ to pThisJob

  // now delete the ended job
  nullptr pThisTask task.job!

  //pThisJob job.id@ pThisJob "job::deleteThis %v %v" fmt.print

  pThisJob job.delete
;

/*----------------------------------------------------------------------------*/
/* call Job__Executed::send for the current job                               */
/*----------------------------------------------------------------------------*/
: job::participantExecuted ( pJobParticipant -- )

  params| pJobParticipant  |

  pJobParticipant "Job__Executed::send" find execute
;

/*----------------------------------------------------------------------------*/
/* print job notice                                                           */
/*----------------------------------------------------------------------------*/
: job.notice ( pJob -- )

  params| pJob |

 //   pJob job.participant@
 //   pJob job.Id@
 //   pJob object.class@ class::name
 // "NOTICE: %v jobId %v executed on node %v" fmt.print
;

/*----------------------------------------------------------------------------*/
/* send job (to the node which is in task)                                    */
/*----------------------------------------------------------------------------*/
: job.send ( pJob -- )

  params| pJob |

  task::sendSocket@ locals| pSocket |

  pJob job.preSend

  task::socketLock

    pJob pSocket socket.sendObject drop

    pJob job.hasOperand if
      //"job.send: Job has crs buffer" .
       pJob job.operand@ pSocket socket.sendObject drop
    then

  task::socketUnlock
;

/*----------------------------------------------------------------------------*/
/* send job to given participating node                                       */
/*----------------------------------------------------------------------------*/
: job.forward ( i_Node pJob -- )

  params| pJob |
  params| i_Node |

  i_Node grid::node task::this task.sendNode!

  pJob job.send
;

/*----------------------------------------------------------------------------*/
/* send job back to originating node                                          */
/*----------------------------------------------------------------------------*/
: job.reply ( i_Node pJob -- )

  params| pJob |
  params| i_Node |

  i_Node grid::node task::this task.sendNode!

  pJob job.send
;

/*----------------------------------------------------------------------------*/
/* add this job into originator list                                          */
/*----------------------------------------------------------------------------*/
: job::becomeOriginator ( -- )

   // set originating task
  task::this job::this job.originatingTask!

  job::this job.id@ job::this job.originatingId!

  // add job to originator jobs
  job::this job.addOriginator
;

/*----------------------------------------------------------------------------*/
/* distribute the job to all participating nodes                              */
/*----------------------------------------------------------------------------*/
: job.distribute ( pJob -- )

  params| pJob |

  // set originating task
  task::this pJob job.originatingTask!

  job::this job.id@ job::this job.originatingId!

  // add job to originator jobs
  pJob job.addOriginator

  // set the no of acks expected in originator job to nodes in the grid
  grid::connectedNodes pJob job.acksRemaining!

  // grab this task's lock
  task::this task.grabLock

  // set acks for originator task
  1 task::acks!

  // send the job to each node in the grid
  grid::definedNodes 0 do

    I grid::node node.sendSocket@ if

      I pJob job.forward
    then

  loop

  // create the response vector in the orginating job to receive responses
  pJob job.createResponseVec

  // wait for ack from deciding job__Ended
  task::wait
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: job::acquireDdlLock

  "<?ddlLock?>" <jobNm> findJobClassEnmSet EnameSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  dup DL_GRAB_WRITE
  == if
    drop
    // "job::acquireDdlLock - grabbing ddl write lock" .
    DdlLock[].grabWrite
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  dup DL_GRAB_READ
  == if
    drop
    // "job::acquireDdlLock - grabbing ddl read lock" .
    DdlLock[].grabRead
    exit
  then

  drop
;

/*----------------------------------------------------------------------------*/
/* test if this job has </flow/> and if so print the jobs ename set           */
/*----------------------------------------------------------------------------*/
: job::</seeFlow/>

  "</flow/>"
    job::this job.enameSet@ enameSet.hasName
  if

    r@ locate .
    job::this job.enameSet@ enameSet.asStr .

  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
