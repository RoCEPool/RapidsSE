/*============================================================================*/
/* jobWords.sen -- Job related words                                          */
/*============================================================================*/

"jobWords.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute generic job                                                        */
/*----------------------------------------------------------------------------*/
: job.genericExecute ( pJob -- )

  locals| pJob |

    pJob object.class@ class::name
    grid::thisNode@
  "Node %v %v" str.format .

  pJob job.id@ pJob job.execute@ find execute

  pJob job.delete
;

/*----------------------------------------------------------------------------*/
/* print job notice                                                           */
/*----------------------------------------------------------------------------*/
: job.notice ( pJob -- )

  locals| pJob |

    pJob job.participant@
    pJob job.Id@
    pJob object.class@ class::name
  "NOTICE: %v jobId %v executed on node %v" str.format .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
