/*============================================================================*/
/* common_trace.sen -- trace file related words                               */
/*============================================================================*/

" common_trace.sen" .verbose

/*----------------------------------------------------------------------------*/
/* define the trace file                                                      */
/*----------------------------------------------------------------------------*/

file: trace_file

/*----------------------------------------------------------------------------*/
/* attempt to open the trace file                                             */
/*----------------------------------------------------------------------------*/
: open_trace

  "/tmp/se_trace.txt" trace_file file.path!
  open_read_write_create trace_file file.open
  if
    args.verbose if
      " ** trace file opened" .
      trace_file file.path@ .
    then
  else
    " ** trace file not opened" .
    trace_file file.path@ .
  then
;

open_trace

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
