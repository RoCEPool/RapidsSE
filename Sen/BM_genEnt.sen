/*============================================================================*/
/* BM_genEnt.sen -- Benchmark Operator genEnt                                 */
/*============================================================================*/

" BM_genEnt.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
//: BM_GenEnt_PulseMarker \handler
//
//  // pipe out the pulse marker to the next operator
//  Operand[].pipeOut
//
//  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//
//  // new a stream def
//  Operand[].newStreamDef
//
//  Operand[].pipeOut
//
//  // generate the ent buffer's
//  <nBuffers> index[].genEntBuffers to Operand[]
//  Operand[].pipeOutSet
//
//  Operand[].newEosMarker
//  Operand[].pipeOut
//
//  true
//;
/*----------------------------------------------------------------------------*/
: BM_GenEnt_PulseMarker \handler

  // pipe out the pulse marker to the next operator
  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipeout a new stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the ent buffer's
  <nBuffers> >int 0 do
    index[].genEntBuffer to Operand[]
    Operand[].pipeOut
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipeout a new eos marker

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenEnt_StartMarker \handler

  "BM_GenEnt_StartMarker" .

  <tableNm> <indexNm> op__table_index if

    path[].toStr     "Folder path: %v" .printf
    folder[].contentStr "contains: %v" .printf

    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* BM_GenEntOp request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_GenEntOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: BM_GenEnt_PulseMarker ZK_PULSEMARKER op[].handler!
  find: BM_GenEnt_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  "*** BM_GenEntOp EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: BM_GenEntOp :: BM_GenEntOp <tableNm> <indexNm> <nBuffers> ;

: BM_GenEntOp _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
