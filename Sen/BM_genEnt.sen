/*============================================================================*/
/* BM_genEnt.sen -- Benchmark Operator genEnt                                 */
/*============================================================================*/

" BM_genEnt.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenEnt_PulseMarker

  // pipe out the pulse marker to the next operator
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // new a stream def
  Operand[].newStreamDef

  Operand[].pipeOut

  // generate the ent buffer's
  <nBuffers> index[].genEntBuffers to Operand[]
  Operand[].pipeoutSet

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenEnt_StartMarker

  "BM_GenEnt_StartMarker" .

  op__table_index

  folderPath.str     "Folder path: %v" .printf
  folderContents.str "contains: %v" .printf

  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* BM_GenEntOp request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_GenEntOp_req ( -- )

  >>logEntry <SEED_REQ>

  // set topology, next stage and op
  op__topology

  find: BM_GenEnt_PulseMarker ZK_PULSEMARKER op[].handler!
  find: BM_GenEnt_StartMarker ZK_STARTMARKER op[].handler!

  //op_generic

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode operand kind
    //Operand[].kind case
    //  ZK_PULSEMARKER of BM_GenEnt_PulseMarker true endof
    //  ZK_STARTMARKER of BM_GenEnt_StartMarker true endof
    //  jobOperand::generic swap
    //endcase

    Operand[].kind op[].handler@ execute

  while assert::stack_0 repeat

  "*** BM_GenEntOp EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: BM_GenEntOp :: BM_GenEntOp <tableNm> <indexNm> <nBuffers> ;

jobInfo: BM_GenEntOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
