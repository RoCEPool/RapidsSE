/*============================================================================*/
/* BM_genEnt.sen -- Benchmark Operator genEnt                                 */
/*============================================================================*/

" BM_genEnt.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
//: BM_GenEnt_PulseMarker \handler
//
//  // pipe out the pulse marker to the next operator
//  Operand[].pipeOut
//
//  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//
//  // new a stream def
//  Operand[].newStreamDef
//
//  Operand[].pipeOut
//
//  // generate the ent buffer's
//  <nBuffers> index[].genEntBuffers to Operand[]
//  Operand[].pipeoutSet
//
//  Operand[].newEosMarker
//  Operand[].pipeOut
//
//  true
//;
/*----------------------------------------------------------------------------*/
: BM_GenEnt_PulseMarker \handler

  // pipe out the pulse marker to the next operator
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipeout a new stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the ent buffer's
  <nBuffers> >int 0 do
    index[].genEntBuffer to Operand[]
    Operand[].pipeout
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipeout a new eos marker

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenEnt_StartMarker \handler

  "BM_GenEnt_StartMarker" .

  op__table_index

  folderPath.str     "Folder path: %v" .printf
  folderContents.str "contains: %v" .printf

  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* BM_GenEntOp request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_GenEntOp_req \operator

  LogEntry SEED_REQ

  // set topology, next stage and op
  op__topology

  find: BM_GenEnt_PulseMarker ZK_PULSEMARKER op[].handler!
  find: BM_GenEnt_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  "*** BM_GenEntOp EXITS" .
  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: BM_GenEntOp :: BM_GenEntOp <tableNm> <indexNm> <nBuffers> ;

jobInfo: BM_GenEntOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
