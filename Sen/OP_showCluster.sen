/*============================================================================*/
/* OP_showCuster.sen -- Operator show cluster                                 */
/*============================================================================*/

" OP_showCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: showCluster_action

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipeout the streamDef
  streamDef[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create an infoSet operand
  streamSetTable[] streamSet[].new

//  grid::bootNodes 0 do
//
//    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//    // insert a row in the infoSet for the defined node
//    I streamSetTable[] streamSet[].addShowCluster  not if
//      StreamSet[].pipeOut
//      streamSetTable[] streamSet[].new
//      I streamSetTable[] StreamSet[].addShowCluster assert
//    then
//
//  loop

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.no streamSetTable[] streamSet[].addShowCluster  not if
      StreamSet[].pipeOut
      streamSetTable[] streamSet[].new
      pNode node.no streamSetTable[] StreamSet[].addShowCluster assert
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipeout the infoset
  streamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: showCluster :: showCluster ;

: showCluster _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __showCluster
    <params>      = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
