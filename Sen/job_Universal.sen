/*============================================================================*/
/* job_Universal.sen -- Universal Job                                         */
/*============================================================================*/

" job_Universal.sen" .verbose

/*----------------------------------------------------------------------------*/
/* translate seed ename, find word matching translated value and execute it   */
/*----------------------------------------------------------------------------*/
: .executeSeed params| sSeedWordNm |

  // find the word mathcing the seed name
  sSeedWordNm find locals| pWord |

  pWord not if
    sSeedWordNm "Unable to find seed word: %v" .printf
    process::quit
  then

  // execute the word
  pWord execute
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

: bClusterStarted
  grid::started@ if
    true
  else
    EC_CLUSTER_NOT_CONNECTED false
  then
;

/*----------------------------------------------------------------------------*/
/* execute the job's request seed-word on originating node                    */
/*----------------------------------------------------------------------------*/
: universal_req ( -- <R> )

  job::</seeFlow/>

  "<preCheck>" job[] job.enameSet@ tagSet.hasName if
    <preCheck> find execute not if
      task::seedInitially task::doneFinally
      job[] ERROR_JOB
    then
  then

  <SeedReq> .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's begin seed-word on each participating node               */
/*----------------------------------------------------------------------------*/
: universal_beg ( -- )

  job::</seeFlow/>

  <SeedRcv> .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's execute seed-word on each participating node             */
/*----------------------------------------------------------------------------*/
: universal_exe ( pJob_Universal -- )

  job::</seeFlow/>

  <SeedExe> .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's end seed-word on each participating node                 */
/*----------------------------------------------------------------------------*/
: universal_end ( -- )

  job::</seeFlow/>

  <SeedEnd> .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's cancel seed-word on each participating node              */
/*----------------------------------------------------------------------------*/
: universal_can ( -- )

  job::</seeFlow/>

  <SeedCan> .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's run seed-word on each participating node                 */
/*----------------------------------------------------------------------------*/
: universal_run ( -- )

  job::</seeFlow/>

  <SeedRun> .executeSeed
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
