/*============================================================================*/
/* job_Universal.sen -- Universal Job                                         */
/*============================================================================*/

" job_Universal.sen" .verbose

/*----------------------------------------------------------------------------*/
/* translate seed ename, find word matching translated value and execute it   */
/*----------------------------------------------------------------------------*/
: .executeSeed params| sSeedEname |

  // get the job-class ename-set
  <jobNm> findJobClassEnmSet locals| pEnameSet |

  // translate seed ename
  sSeedEname pEnameSet EnameSet.getStr locals| sWordNm |

  // find the word mathcing the translated name
  sWordNm find locals| pWord |

  // execute the word
  pWord execute
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

: bClusterStarted

  grid::started@ if
    true
  else
    EC_CLUSTER_NOT_CONNECTED false
  then
;

/*----------------------------------------------------------------------------*/
/* execute the job's request seed-word on originating node                    */
/*----------------------------------------------------------------------------*/
: universal_req ( -- <R> )

  "++++ universal_req ++++" .
  job::this job.enameSet@ enameSet.asStr .
  jobInfo::enameSet@ enameSet.asStr .
  <?jobKind?> .
  <?rspKind?> .
  <?ddlLock?> .

  "<?preCheck?>" jobInfo::enameSet@ enameSet.hasName if
    <?preCheck?> find execute not if
      task::seedInitially task::doneFinally
      job::this <ERROR_REQUEST>
    then
  then

  "<?SeedReq?>" .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's begin seed-word on each participating node               */
/*----------------------------------------------------------------------------*/
: universal_beg ( -- )

  "<?SeedRcv?>" .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's execute seed-word on each participating node             */
/*----------------------------------------------------------------------------*/
: universal_exe ( pJob_Universal -- )

  "<?SeedExe?>" .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's end seed-word on each participating node                 */
/*----------------------------------------------------------------------------*/
: universal_end ( -- )

  "<?SeedEnd?>" .executeSeed
;

/*----------------------------------------------------------------------------*/
/* execute the job's cancel seed-word on each participating node              */
/*----------------------------------------------------------------------------*/
: universal_can ( -- )

  "<?SeedCan?>" .executeSeed
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
