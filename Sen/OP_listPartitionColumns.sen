/*============================================================================*/
/* OP_listPartitionColumns.sen -- Operator list partition columns             */
/*============================================================================*/

" OP_listPartitionColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lspartcol_action

  0 locals| nPtnCols |

  // find the table
  <tableNm> op__table not if
    false
    exit
  then

  // find the streamSet table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeOut

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // get the ptn stream def from the table
  Table[].ptnStreamDef@ to streamDef[]
  streamDef[].columnCount@ to nPtnCols

  // insert a row in the infoset for each column
  nPtnCols 0 do
    I streamDef[].column@
    streamSetTable[] StreamSet[].addColumnDef  not if
      StreamSet[].pipeOut
      streamSetTable[] streamSet[].new
      I streamDef[].column@
      streamSetTable[] StreamSet[].addColumnDef assert
    then
  loop

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lspartcol :: lspartcol <tableNm> ;

: lspartcol _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listColumns
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

