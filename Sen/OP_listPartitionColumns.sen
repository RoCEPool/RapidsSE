/*============================================================================*/
/* OP_listPartitionColumns.sen -- Operator list partition columns             */
/*============================================================================*/

" OP_listPartitionColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lspartcol_action

  0 0 locals| iPartitionCols pSlots |

  // find the table
  <tableNm> op__table not if
    false
    exit
  then

  // get the table column count
  table[].slots@ to pSlots
  pSlots slots.columnCount@ to iPartitionCols

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // insert a row in the infoset for each column
  iPartitionCols 0 do
    I pSlots slots.column@
    streamSetTable[] StreamSet[].addColumnDef  not if
      StreamSet[].pipeout
      streamSetTable[] streamSet[].new
      I pSlots slots.column@
      streamSetTable[] StreamSet[].addColumnDef assert
    then
  loop

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: lspartcol :: lspartcol <tableNm> ;

: lspartcol opInfo tagCopy: localLiteOp_tags
  tags{
    <jobDesc>     = "--description of operator--"
    <localLiteOp> = true
    <streamDef>   = __listColumns
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

