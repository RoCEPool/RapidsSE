/*============================================================================*/
/* OP_visualizeTable.sen -- Operator visualize table                          */
/*============================================================================*/

" OP_visualizeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: vistbl_action

  <tableNm> op__table if
    table[].visualize
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: vistbl :: vistbl <tableNm> ;

: vistbl _opInfo tagCopy: localLiteOp_tags
  tags{
    <jobDesc>     = "--op desc--"
    <localLiteOp> = true
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
