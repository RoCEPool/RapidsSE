/*============================================================================*/
/* OP_visualizeTable.sen -- Operator visualize table                          */
/*============================================================================*/

" OP_visualizeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: vistbl_action

  <tableNm> op__table if
    table[].visualize
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: vistbl :: vistbl <tableNm> ;

: vistbl _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--cmd desc for op--"
    <localLiteOp> = true
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
