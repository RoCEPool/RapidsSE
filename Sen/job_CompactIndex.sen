/*============================================================================*/
/* job_CompactIndex.sen -- Job Compact Index                                  */
/*============================================================================*/

" job_CompactIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid index                                             */
/*----------------------------------------------------------------------------*/
: checkCompactIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check in tables folder
  folder[].CheckInTables not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if EC_NO_SUCH_TABLE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table folder
  sTableNm path[].pushTable assert

  sTableNm checkIsTable not if path[].popTable false exit then
  //sTableNm tableInUse if path[].popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    path[].popIndexes path[].popTable
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  path[].popIndexes
  path[].popTable

  // assert in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute Job_CompactIndex job on a node                                     */
/*----------------------------------------------------------------------------*/
: compactIndex::execute _eeh ( -- )

  job[] locals| pJob_CompactIndex |

  0 0 0 0 locals| pIndex iSize sTableNm sIndexNm |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table and indexes folder
  <tableNm> path[].pushTable assert
  path[].pushIndexes assert

  <indexNm> find execute to pIndex
  pIndex index.compact

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  path[].popIndexes
  path[].popTable
;

/*----------------------------------------------------------------------------*/
/* execute Job_CompactIndex job check resources                               */
/*----------------------------------------------------------------------------*/
: compactIndex::checkResources _eeh ( -- )

  0 0 locals| sIndexNm sTableNm |

  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  <tableNm> <indexNm> checkCompactIndex not if job[] ERROR_JOB !!logError exit then

;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: compactIndex :: compactIndex <tableNm> <indexNm> ;
jobSyntax: compactIndex :: compactIdx   <tableNm> <indexNm> ;

jobInfo: compactIndex
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
