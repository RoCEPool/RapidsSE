/*============================================================================*/
/* job_CompactIndex.sen -- Job Compact Index                                  */
/*============================================================================*/

" job_CompactIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid index                                             */
/*----------------------------------------------------------------------------*/
: checkCompactIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check in tables folder
  checkInTables not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* size index request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: compactIndex_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: compactIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CompactIndex job on a node                                     */
/*----------------------------------------------------------------------------*/
: compactIndex_exe ( Job_CompactIndex -- )

  >>am <SEED_EXE>

  //params| pJob_CompactIndex |
  job::this locals| pJob_CompactIndex |

  0 0 0 0 locals| pIndex iSize sTableNm sIndexNm |

  tp: compactIndex_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_COMPACTINDEX pJob_CompactIndex object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_CompactIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  pJob_CompactIndex job.indexName@ to sIndexNm
  pJob_CompactIndex job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table and indexes folder
  sTableNm pushTable assert
  pushIndexes assert

  sIndexNm find execute to pIndex
  pIndex index.compact

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  pJob_CompactIndex job.notice

  pJob_CompactIndex job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CompactIndex job check resources                               */
/*----------------------------------------------------------------------------*/
: compactIndex.checkResources ( Job_CompactIndex -- )

  >>am <Check_Resources>

  params| pJob_CompactIndex  |
  0 0 locals| sIndexNm sTableNm |

  tp: compactIndex.checkResources
  //checkResources received" .
//
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_CompactIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get index and table name
  pJob_CompactIndex job.indexName@ to sIndexNm
  pJob_CompactIndex job.objectName@ to sTableNm

  sTableNm sIndexNm checkCompactIndex not if pJob_CompactIndex <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeTable job release resources                                */
/*----------------------------------------------------------------------------*/
: compactIndex.releaseResources ( Job_CompactIndex -- )

  >>am <Release_Resources>

  params| pJob_CompactIndex  |

  tp: compactIndex.releaseResources
  //"releaseResources received" .

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: compactIndex_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_compactIndex |

  pJob_compactIndex job.becomeParticipant

  // check resources
  pJob_compactIndex compactIndex.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: compactIndex_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_compactIndex |

  pJob_compactIndex compactIndex.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: compactIndex_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_compactIndex |

  pJob_compactIndex compactIndex.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
