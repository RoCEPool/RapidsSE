/*============================================================================*/
/* requests_grid.sen -- the set of grid related requests                      */
/*============================================================================*/

"requests_grid.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get status of nodes in the grid (run by participant)                       */
/*----------------------------------------------------------------------------*/
/*
: get_status allParticipants 0 returnResult ( -- str n# true )

tp: gettingStatus

  args.tracepoint if
  "GETTING STATUS on NODE "grid::thisNode@ >str str.cat .
  then

  node.status

  <SUCCESS_RESULT>
;
*/
/*----------------------------------------------------------------------------*/
/* get partitions of nodes in the grid (run by participant)                   */
/*----------------------------------------------------------------------------*/
: check_sanity allParticipants 2 returnResult ( size partitions -- true n# true )

tp: gettingPartitions

  locals| iPartitions iSize |

  args.tracepoint if
    "GETTING PARTITIONS on NODE " grid::thisNode@ >str str.cat .
  then

  iPartitions node.partitions == not if
    EC_CLUSTER_PARTITIONS_MISMATCH <FAILURE_RESULT>
  else

    args.tracepoint if
      "GETTING SIZE on NODE "grid::thisNode@ >str str.cat .
    then

    iSize node.size == not if
      EC_CLUSTER_SIZE_MISMATCH <FAILURE_RESULT>
    else
      grid::thisNode@ >str "NODE %v: sanity check passed" str.format
      <SUCCESS_RESULT>
    then
    
  then
;

/*----------------------------------------------------------------------------*/
/* check sanity of the nodes                                                  */
/*----------------------------------------------------------------------------*/
: nodeSanity_req ( -- <R> )

  node.size node.partitions check_sanity ( bool )

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* check sanity of the nodes                                                  */
/*----------------------------------------------------------------------------*/
: nodeSanityR35_req ( -- <R> )

  0 0 locals| pJob pTask |

  tp: nodeSanityR35_req

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  pTask pJob job::distribute

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get status of the nodes                                                    */
/*----------------------------------------------------------------------------*/
: nodeStatus_req ( -- <R> )

  args.metadata if
    "(nodeName VARCHAR, instanceName VARCHAR, status VARCHAR)"  metadata!
  then

  get_status ( str )

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* get status of the nodes                                                    */
/*----------------------------------------------------------------------------*/
: nodeStatusR35_req ( -- <R> )

  0 0 locals| pJob pTask |

  tp: nodeStatusR35_req

  //ddlLock::grabWrite

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  pTask pJob job::distribute

  //wait for job to finish

  //grid::nodes 0
  //do
  //  I pJob job.response@ .
  //loop

  // remove the job from the originator jobs
  //pJob job.removeOriginator

  // delete the job
  //pJob job.delete

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
