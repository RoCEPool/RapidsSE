/*============================================================================*/
/* OP_dumpIndex.sen -- Operator dump index                                    */
/*============================================================================*/

" OP_dumpIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: dumpIdx_action

  <tableNm> <indexNm> op__table_index if
    index[].dump
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: dumpIdx :: dumpIdx <tableNm> <indexNm> ;

: dumpIdx opInfo tagCopy: localLiteOp_tags
tags{
  <jobDesc>     = "--description of operator--"
  <localLiteOp> = true
  <params>      = 2
  }
;
  
  /*============================================================================*/
  /* end                                                                        */
  /*============================================================================*/

