/*============================================================================*/
/* OP_dumpIndex.sen -- Operator dump index                                    */
/*============================================================================*/

" OP_dumpIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: dumpIdx_action

  <tableNm> <indexNm> op__table_index if
    index[].dump
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dumpIdx :: dumpIdx <tableNm> <indexNm> ;

: dumpIdx _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 2
  }
;
  
  /*============================================================================*/
  /* end                                                                        */
  /*============================================================================*/

