/*============================================================================*/
/* timer.sen -- timer                                                         */
/*============================================================================*/

" timer.sen" .verbose

: timer ;

: timer:

  create
  WT_OBJECT word.this word.type!
  sizeof_timer allot
  word.this >body object.magic!
  CN_TIMER word.this >body object.class!
  tick timer word.this word.kind!
  word.this >body timer.init
  true word.this >body object.wordbody!
  does> 
;

: :timer

  >create
  WT_OBJECT word.this word.type!
  sizeof_timer allot
  word.this >body object.magic!
  CN_TIMER word.this >body object.class!
  tick timer word.this word.kind!
  word.this >body timer.init
  true word.this >body object.wordbody!
  does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
