/*============================================================================*/
/* planTest.sen -- plan tests                                                 */
/*============================================================================*/

"planTest.sen" .verbose

/*----------------------------------------------------------------------------*/
/* plan test                                                                  */
/*----------------------------------------------------------------------------*/
: planTest

  0 locals| dexPlan |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // prepare plan
  "part" "/tmp/part.csv" dexPlanner to dexPlan

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the plan
  dexPlan compilePlan

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // trigger scanOp by piping the plan to it
  << "scanOp#" dexPlan >>
  "scanOp.task" find execute >jobQueue
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
