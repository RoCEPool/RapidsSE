/*============================================================================*/
/* OP_sanity.sen -- Operator sanity                                           */
/*============================================================================*/

" OP_sanity.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_INFOSET ...                                                          */
/*----------------------------------------------------------------------------*/
: GridSanity_InfoSet \handler

  //"Operand:- ZK_INFOSET" .verbose
  0 0 locals| iRowSize nodeInfo |

  Operand[] to InfoSet[]
  InfoSet[].firstRow to row[]

  // get row size from streamDef
  StreamDef[].rowSize to iRowSize

  nullptr to InfoSet[]

  // create an infoSet operand
  iRowSize InfoSet[].newInfoSet

  // add nodeInfo to the infoSet
  row[].get StreamDef[] InfoSet[].addGridSanity assert

  // pipeout the infoset
  InfoSet[].pipeout

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: GridSanity_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  Pipein[].pipeOut

  // find the __nodeInfo table
  C_TDEF_GRIDSANITY op__tableDef

  // create a new stream defnition as per the nodeinfo being sent
  StreamDef[].new

  // pipeout the streamDef
  StreamDef[].pipeout

  StreamDef[].new

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: GridSanity_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose

  Pipein[].pipeout

  StreamDef[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                                        */
/*----------------------------------------------------------------------------*/
: GridSanity_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* execute for chunk req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : GridSanity_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: GridSanity_InfoSet     ZK_INFOSET op[].handler!
  find: GridSanity_StartMarker ZK_STARTMARKER op[].handler!
  find: GridSanity_EosMarker   ZK_EOSMARKER op[].handler!
  find: GridSanity_StreamDef   ZK_STREAMDEF op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: GridSanity :: GridSanity ;

: GridSanity opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
