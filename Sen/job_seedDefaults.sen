/*============================================================================*/
/* job_seedDefaults.sen -- Default Job Seeds                                  */
/*============================================================================*/

" job_seedDefaults.sen" .verbose


/******************************************************************************/
/**                                LOCAL JOBS                                **/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* request default                                      (on originating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedLocal _req ( -- )

  task::seedInitially

  [ compiler::current@ word.name@ encode::push ] .
  <jobNm> .

  //debug::breakPoint

  <path> str.toStrVec path[].set

  job::acquireDdlLock

  <jobNm> "::request" str.cat find dup if
    execute
  else
    discard
  then

  DdlLock[].testDrop

  task::doneFinally

  //"Signalling waiting thread" .
  job::informInvokerOfCompletion
  // task has no job
  task::scheduledelete

  HAZARD
;


/******************************************************************************/
/**                             DISTRIBUTED JOBS                             **/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/***                          - Originating Node -                          ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* request default                                      (on originating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _req ( -- )

  task::seedInitially

  "<preCheck>" job[] job.tagSet@ tagSet.hasName if
    <preCheck> find execute not if
      task::seedInitially task::doneFinally
      job::error!
    then
  then

  // [ compiler::current@ word.name@ encode::push ] .
  // <jobNm> .

  job::becomeOriginator

  <jobNm> "::request" str.cat find dup if
    execute
  else
    discard
  then

  job[] job.hasError not if

    // distribute the job
    job::distributeConnected

    // wait for the signal from deciding job__ended/cancelled
    task::wait

  else
    job[] job.removeOriginator  // this is currently being done by job_ended
  then

  task::doneFinally

  //"Signalling waiting thread" .
  job::informInvokerOfCompletion

  // task has no job
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                       - Participating Nodes -                          ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* begin default                                 (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _beg ( -- )

  task::seedInitially

  // [ compiler::current@ word.name@ encode::push ] .

  JP_BEGINNING job[] job.phase!

  <path> str.toStrVec path[].set

  job::becomeParticipant

  <jobNm> "::checkResources" str.cat find dup if
    execute

  else
    discard
  then

  JP_BEGUN job[] job.phase!

  2pcReply::job__begun

  task::doneFinally
;

/*----------------------------------------------------------------------------*/
/* execute default                               (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _exe

  task::seedInitially

  // [ compiler::current@ word.name@ encode::push ] .

  JP_EXECUTING job[] job.phase!

  // ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !
  // set task's dictionary stack from path in job

  <path> str.toStrVec path[].set
  //task::dump

  job::acquireDdlLock

  <jobNm> "::execute" str.cat find dup if
    execute
  else
    discard
  then

  JP_EXECUTED job[] job.phase!

  2pcReply::job__executed

  task::doneFinally
;

/*----------------------------------------------------------------------------*/
/* end default                                   (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _end ( -- )

  task::seedInitially

  // [ compiler::current@ word.name@ encode::push ] .

  //grid::thisNodeName@ "(%v) defaultSeedDist _end" .printf

  JP_ENDING job[] job.phase!

  <jobNm> "::releaseResources" str.cat find dup if
    execute
  else
    discard
  then

  JP_ENDED job[] job.phase!

  job[] job.removeParticipant

  2pcReply::job__ended

  task::doneFinally
;

/*----------------------------------------------------------------------------*/
/* cancel default                                (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _can ( -- )

  task::seedInitially

  // [ compiler::current@ word.name@ encode::push ] .

  JP_CANCELING job[] job.phase!

  <jobNm> "::releaseResources" str.cat find dup if
    execute
  else
    discard
  then

  JP_CANCELED job[] job.phase!

  job[] job.removeParticipant

  2pcReply::job__cancelled

  task::doneFinally
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
