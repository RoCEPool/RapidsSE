/*============================================================================*/
/* job_SuperCountOp.sen -- Job SuperCountOp                                               */
/*============================================================================*/

" job_SuperCountOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : SuperCount_req ( -- )
 
   >>logEntry <SEED_REQ2>

   job::this locals| pJob_SuperCountOp |

   tp: SuperCountOp_run

   pJob_SuperCountOp job.opLoop

   //pJob_SuperCountOp job::participantExecuted

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: SuperCount :: SuperCount ;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobInfo: SuperCount
{
  <?jobKind?>  = JK_OP
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  preCheck = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
