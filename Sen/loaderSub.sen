/*============================================================================*/
/* loaderSub.sen -- Parallel Table Loader Sub                                 */
/*============================================================================*/

"loaderSub.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a sub loader using name on the stack (leaves loader on stack)       */
/*----------------------------------------------------------------------------*/
: :loaderSub

  >create
  WT_OBJECT word.this word.type!
  sizeof_loader allot
  word.this >body object.magic!
  CN_LOADERSUB word.this >body object.class!
  word.this >body loaderSub.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* form loader sub name                                                       */
/*----------------------------------------------------------------------------*/
: >loadSubNm ( i -- s )

  "sl" swap >str str.cat ".task" str.cat
;

/*----------------------------------------------------------------------------*/
/* form partition task name                                                   */
/*----------------------------------------------------------------------------*/
: >partitionTaskNm ( i -- s )

  "PT" swap >str str.cat ".task" str.cat
;

/*----------------------------------------------------------------------------*/
/* append row buffer to partition of given named table                        */
/*----------------------------------------------------------------------------*/
/*
: loadAppendBuffer$ ( pLoaderSEitf iLoaderNode iDistTxId rowBuffer isLast partitionNo "<indexNm>" "<tableNm>" -- true )

//"loadAppendBuffer$" .

tp: loadAppendBuffer$
  0 0 locals| pIndex pTable sTableNm sIndexNm iPartitionNo bIsLast pRowBuffer
              iDistTxId iLoaderNode pLoaderSEitf |

  //"loadAppendBuffer$..." .
  //pLoaderSEitf .
  //iLoaderNode .

  // why:
  //   loaderSub has forwarded a full rowBuffer which needs to be
  //   appended to partition of table

  // where:
  //   in participant task running pLoop on participant thread;

  // what:
  //   find named table to get pointer to table
  //   then append row buffer to partition of table

  1 task::this task.thread thread.name@ str.left "p" str.equal assert

  args.tracepoint if
    sTableNm "APPENDING ROWBUFFER " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  // get ^table
  sTableNm find execute ( rb ptn table )
  to pTable

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // get index
  sIndexNm find execute
  to pIndex

  // restore path
  popIndexes popTable assertInTables                                // ../tables

  // set the index in the row buffer
  pIndex pRowBuffer entryBuffer.index!

  // set the partition in the row buffer
  iPartitionNo pRowBuffer entryBuffer.partition!

  bIsLast if
   pRowBuffer entryBuffer.isLast!
  then

  pLoaderSEitf iLoaderNode  pRowBuffer iDistTxId iPartitionNo  pTable    ( rb ptn tablePtr )

  6 "partitionAppendBuffer" iPartitionNo grid::toSlot dup >partitionTaskNm
  TK_LOADSUB_PART

  //"loadAppendBuffer$ spawning partition task" .
  spawnPartitionTask

  true <SUCCESS_RESULT>
;
*/

/*----------------------------------------------------------------------------*/
/* forward insert of workingbuffer to participant for partition               */
/*----------------------------------------------------------------------------*/
: ~loadInsertBufferEntries ( pLoaderSEitf pLoaderSub -- )

tp: ~loadInsertBufferEntries

   0 locals| pWorkingBuffer pLoaderSub pLoaderSEitf |

  // why:
  //   loaderSub has a full workingBuffer which needs to be sent to participant
  //   to be appended to partition of table

  // where:
  //   in loadSub task running loadSub on general thread;
  //   parent task is req.task running tableLoader;
  //   reg0 has ^loaderSub

  // what:
  //   we need to have the coordinator send the insertBufferEntries$ indirect call
  //   to the participant via a sendParticipant call

  //13 task::this task.thread thread.name@ str.left "generalThread" str.equal assert
  task.parent@ task.name@ "req.task" str.equal assert

  //
  // a) form the indirect call of loadAppendBuffer
  //

  pLoaderSub loaderSub.workingBuffer@ to pWorkingBuffer
  //pRowBuffer entryBuffer.dump

  //"~loadAppendBuffer" .
  //pLoaderSEitf .
  //grid.thisNode@ .

  // get tx id from loader
  pLoaderSub loaderSub.loader@ loader.seitf@ seitf.tx@ tx.id locals| iDistTxId |

  <<
    pLoaderSEitf
    grid.thisNode@
    pWorkingBuffer                                    ( << rb )
    pWorkingBuffer workingBuffer.isLast@
    pLoaderSub loaderSub.partition@               ( << rb ptn )
    pLoaderSub loaderSub.table table.name         ( << rb ptn "<tableNm>" )
    "insertBufferEntries$"                        ( << rb ptn "<tableNm>" "insertBufferEntries$" )

tp: theIndirectCall

  >>                       ( <<loadAppendBuffer$>> )

  nullPtr pLoaderSub loaderSub.workingBuffer!  // set working buffer to null

  //
  // b) <<loadAppendBuffer$>> to be forwarded to one participant
  //    via sendParticipant in the coordinatoor
  //

  //"buffer sent to node" .
  //pLoaderSub loaderSub.hashPartition .

  // to which node/participant
  pLoaderSub loaderSub.hashPartition  ( <<loadAppendBuffer$>> node )

  // forward to coordinator and wait
  >>oneParticipant> ( bool )

tp: theIndirectResult

  // we expect loadAppendBuffer$ to return true
  //assert

  checkResult
;

