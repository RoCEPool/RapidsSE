/*============================================================================*/
/* loaderSub.sen -- Parallel Table Loader Sub                                 */
/*============================================================================*/

"loaderSub.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a sub loader using name on the stack (leaves loader on stack)       */
/*----------------------------------------------------------------------------*/
: :loaderSub

  >create
  WT_OBJECT word.this word.type!
  sizeof_loader allot
  word.this >body object.magic!
  CN_LOADERSUB word.this >body object.class!
  word.this >body loaderSub.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* form loader sub name                                                       */
/*----------------------------------------------------------------------------*/
: >loadSubNm ( i -- s )

  "sl" swap >str str.cat ".task" str.cat
;

/*----------------------------------------------------------------------------*/
/* form partition task name                                                   */
/*----------------------------------------------------------------------------*/
: >partitionTaskNm ( i -- s )

  "PT" swap >str str.cat ".task" str.cat
;

/*----------------------------------------------------------------------------*/
/* append row buffer to partition of given named table                        */
/*----------------------------------------------------------------------------*/
: loadAppendBuffer$ ( pLoaderSEitf iLoaderNode rowBuffer isLast partitionNo "<indexNm>" "<tableNm>" -- true )

//"loadAppendBuffer$" .

tp: loadAppendBuffer$
  0 0 locals| pIndex pTable sTableNm sIndexNm iPartitionNo bIsLast pRowBuffer
              iLoaderNode pLoaderSEitf |

  //"loadAppendBuffer$..." .
  //pLoaderSEitf .
  //iLoaderNode .

  // why:
  //   loaderSub has forwarded a full rowBuffer which needs to be
  //   appended to partition of table

  // where:
  //   in participant task running pLoop on participant thread;

  // what:
  //   find named table to get pointer to table
  //   then append row buffer to partition of table

  1 task::this task.thread thread.name@ str.left "p" str.equal assert

  args.tracepoint if
    sTableNm "APPENDING ROWBUFFER " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  // get ^table
  sTableNm find execute ( rb ptn table )
  to pTable

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // get index
  sIndexNm find execute
  to pIndex

  // restore path
  popIndexes popTable assertInTables                                // ../tables

  // set the index in the row buffer
  pIndex pRowBuffer entryBuffer.index!

  // set the partition in the row buffer
  iPartitionNo pRowBuffer entryBuffer.partition!

  bIsLast if
   pRowBuffer entryBuffer.isLast!
  then

  pLoaderSEitf iLoaderNode pRowBuffer iPartitionNo  pTable    ( rb ptn tablePtr )

  5 "partitionAppendBuffer" iPartitionNo grid::toSlot dup >partitionTaskNm
  TK_LOADSUB_PART

  spawnPartitionTask

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* forward append of rowbuffer to participant for partition                   */
/*----------------------------------------------------------------------------*/
: ~loadAppendBuffer ( pLoaderSEitf pLoaderSub -- )

//"~loadAppendBuffer" .

tp: ~loadAppendBuffer

   0 locals| pRowBuffer pLoaderSub pLoaderSEitf |

  // why:
  //   loaderSub has a full rowBuffer which needs to be sent to participant
  //   to be appended to partition of table

  // where:
  //   in loadSub task running loadSub on general thread;
  //   parent task is req.task running tableLoader;
  //   reg0 has ^loaderSub

  // what:
  //   we need to have the coordinator send the loadAppendBuffer$ indirect call
  //   to the participant via a sendParticipant call

  //13 task::this task.thread thread.name@ str.left "generalThread" str.equal assert
  task.parent@ task.name@ "req.task" str.equal assert

  //
  // a) form the indirect call of loadAppendBuffer
  //

  pLoaderSub loaderSub.rowBuffer@ to pRowBuffer
  //pRowBuffer entryBuffer.dump

  //"~loadAppendBuffer" .
  //pLoaderSEitf .
  //grid.thisNode@ .
  <<
    pLoaderSEitf
    grid.thisNode@
    pRowBuffer                                    ( << rb )
    pRowBuffer entryBuffer.isLast@
    nullPtr pLoaderSub loaderSub.rowBuffer!  // set working row buffer to null
    pLoaderSub loaderSub.partition@               ( << rb ptn )
    pRowBuffer entryBuffer.index@ index.name@     ( << rb ptn "<tableNm>" )
    pLoaderSub loaderSub.table table.name         ( << rb ptn "<tableNm>" )
    "loadAppendBuffer$"                           ( << rb ptn "<tableNm>" "loadAppendBuffer$" )

tp: theIndirectCall

  >>                       ( <<loadAppendBuffer$>> )

  //
  // b) <<loadAppendBuffer$>> to be forwarded to one participant
  //    via sendParticipant in the coordinatoor
  //

  //"buffer sent to node" .
  //pLoaderSub loaderSub.hashPartition .

  // to which node/participant
  pLoaderSub loaderSub.hashPartition  ( <<loadAppendBuffer$>> node )

  // forward to coordinator and wait
  >>oneParticipant> ( bool )

tp: theIndirectResult

  // we expect loadAppendBuffer$ to return true
  //assert

  checkResult
;

/*----------------------------------------------------------------------------*/
/* parallel sub-loading of file into table                                    */
/*----------------------------------------------------------------------------*/
: loadSub ( ^loaderSub -- )

  // this is being run by a general thread on the originator node

  // first set the taskset in this task
  // needed when being resumed by coordinator
  0 0 0 0 0 locals| iPartitionNo ploaderSub iTotalPartitions pLoaderSEitf iTxId |

  task::this task.thread thread.taskset@
  task::this task.taskset!

  // expand dic stack valset and set
  valset> drop dicPath.set

  // expand args valset
  valset> drop
  to pLoaderSub
  to pLoaderSEitf

  //"loadSub pLoaderSEitf ..." .
  //pLoaderSEitf .

  // get table, tx and load map from parent loader
  //   open the chunked file
  //   read first chunk
  pLoaderSub loaderSub.begin

  pLoaderSub loaderSub.fetchRecord

  if 
    // fill a buffer
    begin

      pLoaderSub loaderSub.loadData

      while

       // append row buffer to table/partition/strand
       pLoaderSEitf pLoaderSub ~loadAppendBuffer

     repeat
  then

  // calculate total partitions in the cluster
  grid.slots grid.nodes *
  to iTotalPartitions

  // check for dangling buffers
  iTotalPartitions 0 do

    // set the partition we are using
    I pLoaderSub loaderSub.partition!

    // test for a dangling row buffer for parition I
    pLoaderSub loaderSub.rowBuffer@
    if
      //"DANGLING" .
      // get the buffer
      pLoaderSub loaderSub.rowBuffer@

      // mark as last buffer
      entryBuffer.isLast!

      // append row buffer to table/partition/strand
      pLoaderSEitf pLoaderSub ~loadAppendBuffer

    else

      //"NO DANGLING" .

      // check if loader sub fetched any records
      //pLoaderSub loaderSub.recordsFetched if

        // create a new row buffer
        pLoaderSub loaderSub.newRowBuffer

        // get the buffer
        pLoaderSub loaderSub.rowBuffer@

        // mark as last buffer
        entryBuffer.isLast!

        // append row buffer to table/partition/strand
        pLoaderSEitf pLoaderSub ~loadAppendBuffer
      //then

    then

  loop

  // close the file
  pLoaderSub loaderSub.end

  // this sub has completed, ack the parent loader
  //task::this task.name@ "%v acking parent" str.format .
  task.parent@ ack
;

/*----------------------------------------------------------------------------*/
/* partition task appends the row buffer to the table                         */
/*----------------------------------------------------------------------------*/
: partitionAppendBuffer ( pLoaderSEitf iLoaderNode rowBuffer partitionNo table^ -- )

tp: partitionAppendBuffer
  locals| pTable iPartitionNo pRowBuffer iLoaderNode pLoaderSEitf |

  //"partitionAppendBuffer pLoaderSEitf ..." .
  //pLoaderSEitf .

  //pRowBuffer entryBuffer.isLast@ if
  //  iPartitionNo "appending last buffer for partition " "%v %v" str.format .
  //then

  pRowBuffer iPartitionNo pTable table.appendBuffer ( )

  //iPartitionNo task::this task.thread thread.partitionNo == assert
  //task::breakPoint

  not if exit then
  //drop exit


  //"sending got..." .

  <<
  pLoaderSEitf  ( << pLoaderSEitf )
  "ackSEitf$"   ( << pLoaderSEitf "ackSEitf$" )

  tp: theIndirectCall

  >>            ( <<ackSEitf$>> )


  // to which node/participant
  iLoaderNode  ( <<ackSEitf$>> node )

  //"forwarding ackSEitf$ to coordinator..." .
  // forward to coordinator and wait
  >>oneParticipant> ( bool )
  //"got reply from ackSEitf$..." .

  checkResult
;

/*----------------------------------------------------------------------------*/
/* ackSEitf$                                                                  */
/*----------------------------------------------------------------------------*/
: ackSEitf$ ( pSEitf )

  locals| pSEitf |

  //"ackSEitf$ got..." .

  //pSEitf .

  pSEitf SEitf.acksRemainingDec

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
