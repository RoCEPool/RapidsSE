/*----------------------------------------------------------------------------*/
/* parallel sub-loading of file into table                                    */
/*----------------------------------------------------------------------------*/
: loadSub ( ^loaderSub -- )

  // this is being run by a general thread on the originator node

  // first set the taskset in this task
  // needed when being resumed by coordinator
  0 0 0 0 0 locals| iPartitionNo ploaderSub iTotalPartitions pLoaderSEitf iTxId |

  task::this task.thread thread.taskset@
  task::this task.taskset!

  // expand dic stack valset and set
  valset> drop dicPath.set

  // expand args valset
  valset> drop
  to pLoaderSub
  to pLoaderSEitf

  //"loadSub pLoaderSEitf ..." .
  //pLoaderSEitf .

  // get table, tx and load map from parent loader
  //   open the chunked file
  //   read first chunk
  pLoaderSub loaderSub.begin

  pLoaderSub loaderSub.fetchRecord

  if
    // fill a buffer
    begin

    pLoaderSub loaderSub.loadData

    while

      // insert working buffer entries into table/partition/strand
      pLoaderSEitf pLoaderSub ~loadInsertBufferEntries

    repeat
  then

  // calculate total partitions in the cluster
  grid.slots grid.nodes *
  to iTotalPartitions

  // check for dangling buffers
  iTotalPartitions 0 do

    // set the partition we are using
    I pLoaderSub loaderSub.partition!

    // test for a dangling row buffer for parition I
    pLoaderSub loaderSub.workingBuffer@
    if
      //"DANGLING" .
      // get the buffer
      pLoaderSub loaderSub.workingBuffer@

      // mark as last buffer
      workingBuffer.isLast!

      // insert working buffer entries into table/partition/strand
      pLoaderSEitf pLoaderSub ~loadInsertBufferEntries

    else

      //"NO DANGLING" .

      // check if loader sub fetched any records
      //pLoaderSub loaderSub.recordsFetched if

      // create a new working buffer
      pLoaderSub loaderSub.newWorkingBuffer

      // get the buffer
      pLoaderSub loaderSub.workingBuffer@

      // mark as last buffer
      workingBuffer.isLast!

      // insert working buffer entries into table/partition/strand
      pLoaderSEitf pLoaderSub ~loadInsertBufferEntries

    then

  loop

  // add the valid/invalid records to loader
  pLoaderSub loaderSub.recordsValid pLoaderSub loaderSub.loader@ loader.addRecordsValid
  pLoaderSub loaderSub.recordsInvalid pLoaderSub loaderSub.loader@ loader.addRecordsInvalid

  // close the file
  pLoaderSub loaderSub.end

  // this sub has completed, ack the parent loader
  //task::this task.name@ "%v acking parent" str.format .
  task.parent@ ack
;

/*----------------------------------------------------------------------------*/
/* partition task appends the row buffer to the table                         */
/*----------------------------------------------------------------------------*/
/*
: partitionAppendBuffer ( pLoaderSEitf iLoaderNode iDistTxId rowBuffer iDistTxId partitionNo table^ -- )

tp: partitionAppendBuffer

  //"partitionAppendBuffer..." .


  locals| pTable iPartitionNo iDistTxId pRowBuffer iLoaderNode pLoaderSEitf |

  //"partitionAppendBuffer pLoaderSEitf ..." .
  //pLoaderSEitf .

  //pRowBuffer entryBuffer.isLast@ if
  //  iPartitionNo "appending last buffer for partition " "%v %v" str.format .
  //then

  iDistTxId tx::testDist locals| pDistTx |

  pRowBuffer iPartitionNo pTable table.appendBuffer ( )

  //iPartitionNo task::this task.thread thread.partitionNo == assert
  //task::breakPoint

  not if exit then
  //drop exit

//  pDistTx tx.counterDec not if
//    "tidying up distTx..." .
//    pDistTx tx.commit
//    pDistTx tx.free
//  then

  //"sending got..." .

  <<
  23
  pLoaderSEitf  >str ( << pLoaderSEitf )
  grid.thisNode@
  "ackSEitf$"   ( << pLoaderSEitf "ackSEitf$" )

  tp: theIndirectCall

  >>            ( <<ackSEitf$>> )


  // to which node/participant
  iLoaderNode  ( <<ackSEitf$>> node )

  //"forwarding ackSEitf$ to coordinator..." .
  // forward to coordinator and wait
  >>oneParticipant> ( bool )
  //"got reply from ackSEitf$..." .

  checkResult
;
*/

/*----------------------------------------------------------------------------*/
/* parallel sub-loading of file into table                                    */
/*----------------------------------------------------------------------------*/
/*
: senderTask ( pSEitf sTableNm pBufferQueue nLastBuffers -- )

tp: senderTask

  0 0 0 0 0 locals| pBufferQueue nLastBuffers pBufferQueue sTableNm pSEitf |

  //"senderTask started" .

  task::this task.thread thread.taskset@
  task::this task.taskset!

  // expand dic stack valset and set
  valset> drop dicPath.set

  to nLastBuffers
  to pBufferQueue
  to sTableNm
  to pSEitf

  // get the buffer queue from the seitf
  //pSEitf seitf.bufferQueue@ to pBufferQueue

  0 0 locals| bIsLast pIndexBuffer |

  // loop thru buffers
  //"senderTask looping thru buffers" .
  true
  begin

    while
      // pop a buffer off the buffer queue
     pBufferQueue popBuffer to pIndexBuffer

     // is it a last buffer
     pIndexBuffer entryBuffer.isLast@ to bIsLast

     // append buffer
     pSEitf pIndexBuffer sTableNm ~loadAppendBuffer2

     //nLastBuffers "waiting for %v last buffers" str.format .

     // check if last buffer
     bIsLast if

       nLastBuffers 1 - to nLastBuffers
       
       0 nLastBuffers == if
         false
       else
         true
       then

     else
       true
     then

  repeat

1 setAcks
ackWait

  //"sender acking parent".
  // ack the parent
  task.parent@ ack

;
*/
/*----------------------------------------------------------------------------*/
/* ackSEitf$                                                                  */
/*----------------------------------------------------------------------------*/
: ackSEitf$ ( iNo pSEitf iNode -- true )

  locals| iNode pSEitf iNo |

  //"ackSEitf$ got..." .

  //pSEitf .

  pSEitf >int >ptr SEitf.acksRemainingDec

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* commit (and free) the given dist tx on this node                           */
/*----------------------------------------------------------------------------*/
: txDistCommit allParticipants 1 checkResult ( iDistTxId -- true n# true )

  locals| iDistTxId |

  //"txDistCommit$ got..." .

  //iDistTxId .

  //tx::dumpAll

  iDistTxId tx::testDist locals| pDistTx |

  pDistTx not if
    "dist tx does not exist on this node" .
    true <SUCCESS_RESULT>
    exit
  then

  //"tidying up distTx..." .
  pDistTx tx.commit
  //pDistTx tx.dump
  pDistTx tx.free

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* prepare the dist tx on this node                                           */
/*----------------------------------------------------------------------------*/
: txDistPrepare allParticipants 1 checkResult ( iDistTxId -- true n# true )

  locals| iDistTxId |

  //"txDistPrepare$ got..." .

   //iDistTxId .

  //tx::dumpAll

  iDistTxId tx::testDist locals| pDistTx |

  pDistTx not if
    "dist tx does not exist on this node" .
    true <SUCCESS_RESULT>
    exit
  then

  //"preparing distTx..." .
  pDistTx tx.prepare
  //pDistTx tx.dump

  true <SUCCESS_RESULT>
;

