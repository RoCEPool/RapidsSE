/*============================================================================*/
/* jobSymbols.sen -- Meta Symbols                                             */
/*============================================================================*/

" jobSymbols.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the ename word kind                                                        */
/*----------------------------------------------------------------------------*/
: <<metaSymbol>>> immediate ( -- )

  [ compiler::current , ]

  compiler::current word.category!
;

/*----------------------------------------------------------------------------*/
/* push value of <catalogNm> from job's ename-set                             */
/*----------------------------------------------------------------------------*/
: <catalogNm> <<metaSymbol>>> ( -- "<catalogNm>" )

  [ compiler::current word.name@ , ] job::this job.ename@
;

