/*============================================================================*/
/* jobSymbols.sen -- Meta Symbols                                             */
/*============================================================================*/

" jobSymbols.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the ename word kind                                                        */
/*----------------------------------------------------------------------------*/
: <<metaSymbol>>> immediate ( -- )

  [ word::compiling , ]

  word::compiling word.category!
;

/*----------------------------------------------------------------------------*/
/* push value of <catalogNm> from job's ename-set                             */
/*----------------------------------------------------------------------------*/
: <catalogNm> <<metaSymbol>>> ( -- "<catalogNm>" )

  [ word::compiling word.name@ , ] job::this job.ename@
;

/*----------------------------------------------------------------------------*/
/* push value of <folderNm> from job's ename-set                              */
/*----------------------------------------------------------------------------*/
: <folderNm> <<metaSymbol>>> ( -- "<folderNm>" )

