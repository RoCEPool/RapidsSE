/*============================================================================*/
/* job_Status.sen -- Job Status                                               */
/*============================================================================*/

" job_Status.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get status of a node (executed on all nodes)                               */
/*----------------------------------------------------------------------------*/
: status::execute _eeh ( -- )

  job[] locals| pJob_Status |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the status of this node
  node.status

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the status string in job response
  pJob_Status job.response!
  1 pJob_Status job.rowsProcessed!
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

opSyntax: status :: status ;

jobInfo: status
{
  <jobDesc>  = "--description of job--"
  
  ?<jobKind>?  = JK_DIST2PC
  ?<rspKind>?  = RS_PARTICIPANT_RESPONSE
  ?<ddlLock>?  = DL_NONE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
