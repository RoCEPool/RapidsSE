/*============================================================================*/
/* job_Status.sen -- Job Status                                               */
/*============================================================================*/

"job_Status.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request to get status of all the nodes (on originating node)               */
/*----------------------------------------------------------------------------*/
: status_req ( -- <R> )

  0 0 locals| pJob pTask |

  tp: status_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(nodeName VARCHAR, instanceName VARCHAR, status VARCHAR)"
    pJob job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pTask pJob "job::distribute" find execute

  pJob <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* get status of a node (executed on all nodes)                               */
/*----------------------------------------------------------------------------*/
: status_exe ( pJob_Status -- )

  params| pJob_Status |
  // job::this locals| pJob__Begun |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert its the status job
  CN_JOB_STATUS pJob_Status object.assertClass

  "GETTING STATUS on NODE " grid::thisNode@ >str str.cat .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the status of this node
  node.status

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the status string in job response
  grid::thisNode@ pJob_Status job.response!
  1 grid::thisNode@ pJob_Status job.rowsProcessed!

  pJob_Status job.notice

  pJob_Status send_job__executed
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: status_beg ( -- )

  job::this locals| pJob_status |

  pJob_status job.beginParticipant

  job::participantBegun
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: status_end ( -- )

  job::this locals| pJob_status |

  job::participantEnded
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: status_can ( -- )

  job::this locals| pJob_status |
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

