/*============================================================================*/
/* job_Walk.sen -- Job Walk                                                   */
/*============================================================================*/

" job_Walk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn sub-walkers on particpating node                                     */
/*----------------------------------------------------------------------------*/
: walk.spawnSubWalkers ( pJob_Walk -- )

  params| pJob_Walk |

  task::this task.grabLock

  grid::slots task::acks!

  grid::slots 0
  do
    I pJob_Walk job_subWalker::spawn
  loop

  task::wait
;

/*----------------------------------------------------------------------------*/
/* export on this participant node (same as originator)                       */
/*----------------------------------------------------------------------------*/
: walk.export ( pJob_Walk --  )

  params| pJob_Walk |

  0 locals| sTableNm  |
  0 locals| pTable    |

  "walk_export: export on this node" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set path
  pJob_Walk job.pushPath task::dicStack.set

  // set table dictionary
  pJob_Walk job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get table pointer
  sTableNm table::find to pTable

  pTable pJob_Walk job_walk.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_Walk job_walk.begin

  pJob_Walk walk.spawnSubWalkers

  pJob_Walk job_walk.end
;


////////////////////////////////////////////////////////////////////////////////


/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: walk.checkTable ( sTableNm -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* check resources                                                            */
/*----------------------------------------------------------------------------*/
: walk.checkResources ( pJob_Walk -- )

  >>am <Check_Resources>

  params| pJob_Walk  |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_Walk job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can export the table
  pJob_Walk job.objectName@ walk.checkTable
  not if
  pJob_Walk
  <ERROR_JOB>
  !!am exit
  then

  <<am <Resources_Checked>
  an::resources_checked
;

/*----------------------------------------------------------------------------*/
/* release resources                                                          */
/*----------------------------------------------------------------------------*/
: walk.releaseResources ( pJob_Walk -- )

  >>am <Release_Resources>

  params| pJob_Walk  |

  <<am <Resources_Released>
  an::resources_released
;


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* export command request on originating node                                 */
/*----------------------------------------------------------------------------*/
: walk_req ( -- <R> )

  >>am <SEED_REQ>
  an::seed_req

  job::this locals| pJob_Walk |

  pJob_Walk job.distribute

  <<am <DONE_REQ>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* begin Job_Walk on participating node                                       */
/*----------------------------------------------------------------------------*/
: walk_beg ( -- )

  >>am <SEED_BEG>
  an::seed_rcv

  job::this locals| pJob_Walk |

  pJob_Walk job.beginParticipant

  pJob_Walk walk.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* execute Job_Walk on participating node                                     */
/*----------------------------------------------------------------------------*/
: walk_exe ( pJob_Walk -- )

  >>am <SEED_EXE>
  an::seed_exe

  job::this locals| pJob_Walk |


  pJob_Walk walk.export

  pJob_Walk job.notice

  // delete_completed_job

  pJob_Walk send_job__executed

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* end Job_Walk on participating node                                         */
/*----------------------------------------------------------------------------*/
: walk_end ( -- )

  >>am <SEED_END>
  an::seed_end

  job::this locals| pJob_Walk |

  pJob_Walk walk.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel Job_Walk on participating node                                      */
/*----------------------------------------------------------------------------*/
: walk_can ( -- )

  >>am <SEED_CAN>
  an::seed_can

  job::this locals| pJob_Walk |

  pJob_Walk walk.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
