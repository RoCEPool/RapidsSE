/*============================================================================*/
/* job_ChangeFolder.sen -- Job ChangeFolder                                   */
/*============================================================================*/

"job_ChangeFolder.sen" .verbose

/*----------------------------------------------------------------------------*/
/* docol command request                                                      */
/*----------------------------------------------------------------------------*/
: cf_req ( -- <R> )

  0 0 0 0 locals| pCurrentFolder sFolderNm pJob_ChangeFolder pTask |

  tp: cf_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ChangeFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the objectName (folderNm) from the job
  pJob_ChangeFolder job.objectName@ to sFolderNm

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_ChangeFolder getPathR35
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test for a ".." which will go up one folder

  // pop up one folder, but not into tenants
  sFolderNm ".." str.equal if
  0 pathPick dic.name "tenants" str.equal not if pathDrop then
  pJob_ChangeFolder <DONE_REQUEST>
  exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test for a "~" will pop folder path till it reaches /tenants

  // pop up to tenants
  sFolderNm "~" str.equal if
  begin 0 pathPick dic.name "tenants" str.equal not while pathDrop repeat
  pJob_ChangeFolder <DONE_REQUEST>
  exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test for a "tenants" will clear folder path and set to /tenants

  // clear dic path and push tenants
  sFolderNm "tenants" str.equal if
  pathDropAll
  attachmap::tenants@ execute pathPush
  pJob_ChangeFolder <DONE_REQUEST>
  exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // otherwise we expect a name of a sub -folder to which we push path to
  // push sub-folder
  sFolderNm findInCurrent to pCurrentFolder
  pCurrentFolder checkIsDicR35 not if pJob_ChangeFolder <ERROR_REQUEST> exit then
  pCurrentFolder execute pathPush

  pJob_ChangeFolder <DONE_REQUEST>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
