/*============================================================================*/
/* OP_upsert.sen -- Operator upsert                                           */
/*============================================================================*/

" OP_upsert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for insertOp                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : UpsertOp_req ( -- )
 
  >>logEntry <SEED_REQ>
  job[] locals| pJob_UpsertOp |

  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

    ZK_CRWBUFFER of
      //"Operand:- ZK_CRWBUFFER" .verbose
      tx[].begin
      tablePtn[].get tablePtnGrabWrite2
      Operand[].upsertIntoTable
      tablePtn[].get tablePtnDropWrite2
      tx[].commit
      Operand[].delete
      true
    endof

    ZK_STARTMARKER of
      //"Operand:- ZK_STARTMARKER" .verbose
      // check if we can insert into the table
      sTableNm checkIsValidTable not if
        op.pipelineJob@ <ERROR_JOB> !!logError
        Operand[].delete
        Operand[].newErrorMarker
      else
        // move to table folder and find the table and tablePtn
        sTableNm pushTable assert
        sTableNm find execute to table[]
        table[].tablePtn@ to tablePtn[]
      then

      Operand[].pipeout
      true
    endof

    ZK_STREAMDEF of
      //"Operand:- ZK_STREAMDEF" .verbose
      Operand[].delete
      Operand[].newStreamDef
      Operand[].pipeOut
      true
    endof

    // handle other operand as generic operands
    jobOperand::generic
    swap

    endcase

    while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: UpsertOp :: UpsertOp <tableNm> ;

jobInfo: UpsertOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
