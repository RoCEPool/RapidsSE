/*============================================================================*/
/* OP_upsert.sen -- Operator upsert                                           */
/*============================================================================*/

" OP_upsert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: UpsertOp_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  tx[].begin
  tablePtn[].get tablePtnGrabWrite2
  Operand[].upsertIntoTable
  tablePtn[].get tablePtnDropWrite2
  tx[].commit
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: UpsertOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  // check if we can insert into the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  else
    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
  then

  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: UpsertOp_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Operand[].delete
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for insertOp                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : UpsertOp_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: UpsertOp_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: UpsertOp_StartMarker ZK_STARTMARKER op[].handler!
  find: UpsertOp_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: UpsertOp :: UpsertOp <tableNm> ;

: UpsertOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of job--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
