/*============================================================================*/
/* OP_createSchema.sen -- Operator create schema                              */
/*============================================================================*/

" OP_createSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is not a schema                                              */
/*----------------------------------------------------------------------------*/
: checkIsNotSchema ( word )
  folder[].findSymbol not if true exit then
  EC_SCHEMA_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: createSchema_PulseMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  node::checkEnoughBuffers not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if are in schemas
  folder[].checkIsSchemas not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if schema already exits
  <schemaNm> checkIsNotSchema not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the schema
  <schemaNm> :makeSchemaFolder ( )

  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createSchema req                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: createSchema_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: createSchema_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: createSchema :: createSchema <schemaNm> ;

: createSchema _info tagCopy: stageOp_tags
  tags{
    <jobDesc>   = "--op desc--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
