/*============================================================================*/
/* job_ConnectCluster.sen -- Job Connect Cluster                              */
/*============================================================================*/

" job_ConnectCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: node.isConnected ( pNode -- t|f )

  params| pNode |

  pNode node.sendSocket@ if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::connected ( -- t|f )

  grid::nodes 0
  do
    I grid::node node.isConnected not if
      args.verbose if
        I "Node no %v not connected" fmt.print
      then
      unloop
      false
      exit
    then
  loop

  "All nodes connected" .verbose

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::wait ( -- )

  begin
    grid::connected not
  while
    100 thread.sleep_ms
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridTest

  grid::nodes 0
  do
    I grid::node node.isConnected
    I "gridTest: node no %v connected %v " fmt.print
  loop
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridWait

  grid::wait
;

/*----------------------------------------------------------------------------*/
/* request to connect the cluster (on originating node)                       */
/*----------------------------------------------------------------------------*/
: connectCluster_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: connectCluster_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  //"grid::setStartNode..." .
  grid::setStartNode

  //"spawn_Connector..." .
  spawn_Connector

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute job_ConnectCluster (on participating node)                         */
/*----------------------------------------------------------------------------*/
: connectCluster_exe ( -- )

  >>am <SEED_EXE>

  //params| pJob_ConnectCluster |
  job::this locals| pJob_ConnectCluster |

  pJob_ConnectCluster job.notice

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::wait

  pJob_ConnectCluster send_job__executed

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: connectCluster_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_status |

  pJob_status job.beginParticipant

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: connectCluster_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_status |

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: connectCluster_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_status |

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

