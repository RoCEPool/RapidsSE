/*============================================================================*/
/* job_ConnectCluster.sen -- Job Connect Cluster                              */
/*============================================================================*/

" job_ConnectCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::connected ( -- t|f )

  grid::definedNodes 0
  do
    I grid::node node.isConnected not if
      args.verbose if
        I "Node no %v not connected" fmt.print
      then
      unloop
      false
      exit
    then
  loop

  "All nodes connected" .verbose

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::pause ( -- )

  begin
    grid::connected not
  while
    100 thread::sleepMsec
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridConnected prompt ( -- )

  "gridConnected" .

  grid::pause
  true grid::started!
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridTest

  grid::definedNodes 0
  do
    I grid::node node.isConnected
    I "gridTest: node no %v connected %v " fmt.print
  loop
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: gridWait

  grid::pause
;

/*----------------------------------------------------------------------------*/
/* request to connect the cluster (on originating node)                       */
/*----------------------------------------------------------------------------*/
: connectCluster_req ( -- <R> )

  task::seedInitially

  [ compiler::current word.name@ , ] .

  <jobNm> .

  job::becomeOriginator

  tp: connectCluster_req

  //"grid::setStartNode..." .
  grid::setStartNode

  //"connector::spawn..." .
  connector::spawn

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::pause

  job::distributeConnected

  // wait for the signal from deciding job__ended/cancelled
  task::wait

  //job::this job.removeOriginator  // this is currently being done by job_ended

  task::doneFinally

  //"Signalling waiting thread" .
  job::this job.signalWaiter

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute job_ConnectCluster (on participating node)                         */
/*----------------------------------------------------------------------------*/
: connectCluster::execute _eeh ( -- )

  job::this locals| pJob_ConnectCluster |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::pause
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: connectCluster :: connectCluster ;

jobInfo: connectCluster
{
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_NONE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

