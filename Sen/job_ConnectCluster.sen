/*============================================================================*/
/* job_ConnectCluster.sen -- Job Connect Cluster                              */
/*============================================================================*/

" job_ConnectCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: bClusterStarted
  grid::started@ if
    true
  else
    EC_CLUSTER_NOT_CONNECTED false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: node.isConnected ( pNode -- t|f )

  params| pNode |

  pNode node.sendSocket@ if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
//: grid::connected ( -- t|f )
//
//  grid::bootNodes 0
//  do
//    I grid::node node.isConnected not if
//      args.verbose if
//        I "Node no %v not connected" .printf
//      then
//      unloop
//      false
//      exit
//    then
//  loop
//
//  "All nodes connected" .verbose
//
//  true
//;
/*----------------------------------------------------------------------------*/
: grid::connected ( -- t|f )

  0 locals| pNode |

  0 node_I[].new

  begin
    node_I[].node to pNode

    pNode node.isConnected not if
      args.verbose if
        pNode node.no "Node no %v not connected" .printf
        node_I[].delete
        false
        exit
      then
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete

  "All nodes connected" .verbose

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: grid::pause ( -- )

  begin
    grid::connected not
  while
    100 thread::sleepMsec
  repeat
;

/*----------------------------------------------------------------------------*/
/* request to wait for cluster to connect (on originating node)               */
/*----------------------------------------------------------------------------*/
: connectCluster_req ( -- <R> )


  task::seedInitially

  // [ compiler::current@ word.name@ encode::push ] .
  // <jobNm> .

  job::becomeOriginator

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // has cluster already been started?

  grid::started@ if
                                             //! how do we set an error message?
    DONE_REQ
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn all other nodes

  grid::setStartNode

  //grid::spawnOtherNodes

  //connector::spawn

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pause till all nodes connected

  grid::pause

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the start cluster job

  job::distributeConnected

  // wait for the signal from deciding job__ended/cancelled
  task::wait

  // set grid as started
  true grid::started!
  "Cluster started" .

  task::doneFinally

  //"Signalling waiting thread" .
  job::informInvokerOfCompletion
  // task has no job
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute job_ConnectCluster (on participating node)                         */
/*----------------------------------------------------------------------------*/
: connectCluster::execute _eeh ( -- )

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::pause

  true grid::started!
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: connectCluster :: connectCluster ;

: connectCluster _cmdTags tagCopy: distJob_tags
  tags{
    <rspKind>  = RS_NONE
    <ddlLock>  = DL_NONE
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

