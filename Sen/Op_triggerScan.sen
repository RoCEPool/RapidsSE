/*============================================================================*/
/* Op_triggerScan.sen -- flow trigger operator                                 */
/*============================================================================*/

" Op_triggerScan.sen" .verbose
common/ triggerScan rbCrs /
/*----------------------------------------------------------------------------*/
/* trigger                                                                    */
/*----------------------------------------------------------------------------*/
: triggerScanPlan ( pSeitf profile plan -- )

  // record the plan and profile
  locals| thePlan profile pSeitf |
  0 locals| partitionId |

  //thePlan plan.id@ "Triggering plan: %v" str.format .

  // trigger scanOp by piping the plan to it
  grid::slots 0 do

    I grid::toPartition to partitionid

    // << profile plan >> -->> nextOp
    //<< pSeitf partitionid "scanOp#%v" str.format thePlan plan.id@ "scanOp.task" >>jobQueue
  loop
;

/*----------------------------------------------------------------------------*/
/* triggerPlan_distributed                                                    */
/*----------------------------------------------------------------------------*/
: triggerScanPlan_distributed subDic triggerScan ( pSeitf profile plan -- )

  // record the plan and profile
  locals| thePlan profile pSeitf |

  //thePlan plan.id@ "Triggering plan: %v" str.format .

  // trigger scanOp by piping the plan to it
  grid::partitions 0 do

  // << profile plan >> -->> nextOp
  //<< pSeitf I "scanOp#%v" str.format thePlan plan.id@ "scanOp.task" >>jobQueue
  //<< I "rangeOp#%v" str.format thePlan plan.id@ "rangeOp.task" >>jobQueue
  loop
;

/*----------------------------------------------------------------------------*/
/* flow trigger operator loop                                                 */
/*----------------------------------------------------------------------------*/
: triggerScanOp operator ( -- NEVER )

  begin

    depth 0 != if "stack of task has grown" . debug::trap then

    // wait for next job
    //jobQueue> ( valset )

    // unpack it
    valset> ( nextOp profile planId nValues )
    drop ( nextOp profile planId )
    // find plan using planId
    planList::findPlan ( pSeitf profile plan true )
    assert ( pSeitf profile plan )

    // trigger the plan
    triggerScanPlan_distributed ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
