/*============================================================================*/
/* job_Service.sen -- Example Service Job                                     */
/*============================================================================*/

" job_Serice.sen" .verbose


/*----------------------------------------------------------------------------*/
/* activity                                                                   */
/*----------------------------------------------------------------------------*/
: service::activity ( -- )

  "Service Activity" .
;

/*----------------------------------------------------------------------------*/
/* request run loop                                                           */
/*----------------------------------------------------------------------------*/
: service_req ( -- )

  std_entryHook

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin

    task::yield

    service::activity

    assert::stack_0

    1 task::sleepSsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: service :: service ;

jobInfo: service
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NONE
  <?ddlLock?>  = DL_NONE
  
  // <?preCheck?> = bClusterStarted
}
;

/*----------------------------------------------------------------------------*/
/***                              - Command -                               ***/
/*----------------------------------------------------------------------------*/
: service& immediate

  0 locals| nArgs |

  begin
    next-token
    dup "&" str.equal not
  while
    nArgs ++ to nArgs
  repeat

  // drop the "&" from dstack
  drop

  nArgs

  "would spawn service" .

  DropN

  assert::stack_0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
