/*============================================================================*/
/* job_Service.sen -- Example Service Job                                     */
/*============================================================================*/

" job_Service.sen" .verbose


/*----------------------------------------------------------------------------*/
/* activity                                                                   */
/*----------------------------------------------------------------------------*/
: service::activity ( -- )

  "Service Activity" .
;

/*----------------------------------------------------------------------------*/
/* request run loop                                                           */
/*----------------------------------------------------------------------------*/
: service_req ( -- )

  std_entryHook

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin

    task::yield

    service::activity

    assert::stack_0

    1 task::sleepSsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: service :: service ;

jobInfo: service
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_NONE
  <ddlLock>  = DL_NONE
  
  // <preCheck> = bClusterStarted
  
  <cmdKind>  = CK_SERVICE
}
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/***                              - Command -                               ***/
/*----------------------------------------------------------------------------*/
: serviceXXXX immediate

  0 locals| nArgs |

  begin
    input::next
  dup ";&" str.equal not
  while
    nArgs ++ to nArgs
  repeat

  // drop the ";&" from dstack
  drop

  nArgs

  // "would spawn service" .

  dropN

  //compiler::current@ word.name@ ,

  "service" encode::push

  find: job::spawnUniversal encode::call

  //find: drop encode::call

  assert::stack_0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
