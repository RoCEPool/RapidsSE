/*============================================================================*/
/* job_LoadTable.sen -- Job Load Table                                        */
/*============================================================================*/

" job_LoadTable.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* read chunks from input, write them to output                               */
/*----------------------------------------------------------------------------*/
: LoadTable_process ( pJob_LoadTable -- )

  params| pJob_LoadTable |

  pJob_LoadTable job_loadTable.begin not if exit then

  begin pJob_LoadTable job_loadTable.chunk while repeat

  pJob_LoadTable job_loadTable.end
;

/*----------------------------------------------------------------------------*/
/* execute load table on this participant node (same as originator)           */
/*----------------------------------------------------------------------------*/
: LoadTable_executeLoad ( pJob_LoadTable --  )

  params| pJob_LoadTable |

  0 locals| sTableNm  |
  0 locals| pTable    |

  //"LoadTable_executeLoad: Executing loader on this node" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // initialise

  // set path
  pJob_LoadTable getPath dicStack.set

  // set table dictionary
  pJob_LoadTable job.objectName@ to sTableNm
  sTableNm pushTable assert

  // get table
  sTableNm find execute to pTable
  pTable pJob_LoadTable Job_LoadTable.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // chunk the file being loaded

  pJob_LoadTable LoadTable_process

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn and wait for sub-loaders

  task::this task.grabLock

  grid::slots task::acks!

  args.subLoaders 0
  do
    pJob_LoadTable job_subLoader::spawn
  loop

  task::wait
;

/*----------------------------------------------------------------------------*/
/* this table load job waits for an ack only                                  */
/*----------------------------------------------------------------------------*/
: LoadTable_waitOnly ( pJob_LoadTable --  )

  task::this task.grabLock
  grid::slots task::acks!
  task::wait
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* Job_LoadTable request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: LoadTable_req (  -- <R> )

  >>am <SEED_REQ>

  job::this locals| pJob_LoadTable |

  // add job to originator list and distribute
  pJob_LoadTable job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_LoadTable job (on each participating node)                     */
/*----------------------------------------------------------------------------*/
: loadTable_exe ( -- )

  >>am <SEED_EXE>

  job::this locals| pJob_LoadTable |

  0 locals| iOriginNode |

  pJob_LoadTable job.id@ job::originator@ to iOriginNode

  iOriginNode node::isOrigin if
    pJob_LoadTable LoadTable_executeLoad
  else
    LoadTable_waitOnly
  then

  pJob_LoadTable send_job__executed

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* check resources (on participating nodes)                                   */
/*----------------------------------------------------------------------------*/
: loadTable.checkResources ( pJob_LoadTable -- )

  >>am <Check_Resources>

  params| pJob_LoadTable  |

  0 locals| pFile |
  0 locals| iOriginNode |

  pJob_LoadTable job.objectName@ locals| sTableNm |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check for sufficient memory

  node::checkEnoughBuffers not if pJob_LoadTable <ERROR_JOB> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if file exists (SHOULDN"T THIS BE ONLY ON ORIGINATING NODE?)

  pJob_LoadTable job.id@ job::originator@ to iOriginNode

  iOriginNode node::isOrigin if

    file::new to pFile

    pJob_LoadTable job_LoadTable.filePath@ OPEN_READ pFile file.open
    not if
       pFile file.delete assert::stack_0 EC_INVALID_FILE pJob_LoadTable <ERROR_JOB> !!am exit
    then

    pFile file.close pFile file.delete assert::stack_0

  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // path checks

  // set dictionary stack
  pJob_LoadTable getPath dicStack.set
  //pathDump

  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_LoadTable <ERROR_JOB> !!am exit then
  //sTableNm "In table folder: %v" fmt.print

  // push table dictionary
  sTableNm pushTable assert
  //pathDump

  // check it is a table
  sTableNm checkIsTable not if popTable pJob_LoadTable <ERROR_JOB> !!am exit then

  // pop table dictionary
  popTable
  //pathDump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers

  node::testEnoughBuffers not if pJob_LoadTable <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* release resources (on participating nodes)                                 */
/*----------------------------------------------------------------------------*/
: loadTable.releaseResources ( pJob_LoadTable -- )

  >>am <Release_Resources>

  params| pJob_LoadTable  |

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job (on participating nodes)                                         */
/*----------------------------------------------------------------------------*/
: loadTable_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_LoadTable |

  pJob_LoadTable job.beginParticipant

  pJob_LoadTable loadTable.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job (on participating nodes)                                           */
/*----------------------------------------------------------------------------*/
: loadTable_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_LoadTable |

  pJob_loadTable loadTable.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job (on participating nodes)                                         */
/*----------------------------------------------------------------------------*/
: loadTable_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_LoadTable |

  pJob_LoadTable loadTable.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
