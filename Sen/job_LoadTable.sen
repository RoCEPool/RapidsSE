/*============================================================================*/
/* job_LoadTable.sen -- Job Load Table                                        */
/*============================================================================*/

" job_LoadTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute loader on this node                                                */
/*----------------------------------------------------------------------------*/
: LoadTable_executeLoader ( pJob_LoadTable --  )

  params| pJob_LoadTable |
  0 locals| pThisTask |

  //"LoadTable_executeLoader: Executing loader on this node" .

  task::this to pThisTask

  pJob_LoadTable loadTable::new locals| pLoadTable |

  // initialise table loader
  pJob_LoadTable job.objectName@ locals| sTableNm |
  //sTableNm "TableNm: %v" fmt.print

  // push table dictionary
  pJob_LoadTable getPath dicStack.set
  sTableNm pushTable assert
  //pathDump

  sTableNm find execute locals| pTable |
  pTable pLoadTable loadTable.table!

  pLoadTable loadTable.chunkFile

  //pLoadTable loadTable.dumpMap

  // grab this task's lock
  pThisTask task.grabLock

  grid::slots setAcks

  args.subLoaders 0
  do
    //I "Creating Job_SubLoader %v" fmt.print
    pLoadTable loadTable.spawnSubLoader
  loop

  //"LoadTable_executeLoader ack waiting" .
  ackWait
  //"LoadTable_executeLoader acked" .

  pLoadTable loadTable.delete
;

/*----------------------------------------------------------------------------*/
/* wait for ack only                                                          */
/*----------------------------------------------------------------------------*/
: LoadTable_waitOnly ( pJob_LoadTable --  )

  task::this locals| pThisTask |

  // grab this task's lock
  pThisTask task.grabLock

  grid::slots setAcks

  "LoadTable_waitOnly waiting" .
  ackWait
  "LoadTable_waitOnly acked" .
;

/*----------------------------------------------------------------------------*/
/* Job_LoadTable request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: LoadTable_req (  -- <R> )

  <SEED_REQ>

  0 locals| pThisTask |
  0 locals| pJob_LoadTable  |

  tp: loadTable_req

  // get the task
  task::this to pThisTask

  // get the job from the task
  pThisTask task.job@ to pJob_LoadTable
  //pJob_LoadTable pThisTask "LoadTable_req task: %v job_LoadTable %v" fmt.print

  // distribute the job
  pJob_LoadTable job.distribute

  <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_LoadTable job on each node                                     */
/*----------------------------------------------------------------------------*/
: loadTable_exe ( -- )

  <SEED_EXE>

  job::this locals| pJob_LoadTable |

  0 locals| pThisTask |

  // get the task
  task::this to pThisTask
  //pJob_LoadTable pThisTask "LoadTable_exe task: %v job_LoadTable %v" fmt.print

  // store task into Job_LoadTable
  pThisTask pJob_LoadTable job_loadTable.task!

  pJob_LoadTable job.id@ job::originator@ locals| iOriginNode |
  grid::thisNode@ locals| iThisNode |

  //iThisNode iOriginNode "Originating node %v; this node %v" fmt.print

  iThisNode iOriginNode == if
    //"LoadTable is executing on this node" .
    pJob_LoadTable LoadTable_executeLoader
  else
    //"LoadTable is not executed on this node" .
    LoadTable_waitOnly
  then

  pJob_LoadTable send_job__executed

  nullptr task::this task.job!

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_LoadTable job check resources                                  */
/*----------------------------------------------------------------------------*/
: loadTable.checkResources ( pJob_LoadTable -- )

  params| pJob_LoadTable  |

  pJob_LoadTable job.objectName@ locals| sTableNm |

  tp: loadTable.checkResources
  //checkResources received" .

  //----------------------------------------------------------------------------
  // check if file exists
  file::new locals| fp |
  pJob_LoadTable job_LoadTable.filePath@ fp file.path!

  OPEN_READ fp file.open ( t|f )
  not if
     fp file.delete assert::stack_0 EC_INVALID_FILE pJob_LoadTable <ERROR_JOB> exit
  then

  fp file.close fp file.delete assert::stack_0

  //----------------------------------------------------------------------------
  // grad a ddl lock

  ddlLock::grabWrite

  //----------------------------------------------------------------------------
  // path checks

  // set dictionary stack
  pJob_LoadTable getPath dicStack.set
  //pathDump

  // there should be a table folder

  sTableNm checkIsTableFolder not if pJob_LoadTable <ERROR_JOB> exit then
  //sTableNm "In table folder: %v" fmt.print

  // push table dictionary
  sTableNm pushTable assert
  //pathDump

  // check it is a table
  sTableNm checkIsTable not if popTable pJob_LoadTable <ERROR_JOB> exit then

  // pop table dictionary
  popTable
  //pathDump

  //----------------------------------------------------------------------------
  // check if we have enough buffers

  checkEnoughBuffers not if pJob_LoadTable <ERROR_JOB> exit then

  ddlLock::dropWrite
;

/*----------------------------------------------------------------------------*/
/* execute Job_LoadTable job release resources                                */
/*----------------------------------------------------------------------------*/
: loadTable.releaseResources ( pJob_LoadTable -- )

  params| pJob_LoadTable  |

  tp: loadTable.releaseResources
  //releaseResources received" .
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: loadTable_beg ( -- )

  <SEED_BEG>

  job::this locals| pJob_LoadTable |

  //">> loadTable_beg <<" .

  // add this job to the participants list
  pJob_LoadTable job.beginParticipant

  // check resources
  pJob_LoadTable loadTable.checkResources

  // this job has begun
  job::participantBegun

  <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: loadTable_end ( -- )

  <SEED_END>

  job::this locals| pJob_LoadTable |

  //">> loadTable_end <<" .

  // release resources
  pJob_loadTable loadTable.releaseResources

  job::participantEnded

  <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: loadTable_can ( -- )

  <SEED_CAN>

  job::this locals| pJob_LoadTable |

  pJob_LoadTable loadTable.releaseResources

  job::participantCancelled

  <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
