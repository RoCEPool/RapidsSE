/*============================================================================*/
/* job_Pwf.sen -- Job Present Working Folder                                  */
/*============================================================================*/

" job_Pwf.sen" .verbose

/*----------------------------------------------------------------------------*/
/* pwf command request                                                        */
/*----------------------------------------------------------------------------*/
: pwf_req ( -- <R> )

  >>logEntry <SEED_REQ>
  //">>pwf_req" log::mark

  100 ssn::senLoc

  0 0 0 0 locals| pJob_Pwf pTask |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_Pwf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(path VARCHAR)" pJob_Pwf job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // start of working string
  "row: ('/"

  // iterate thru each folder in path and concat to end
  pathDepth 0 do
    // compute the path subscript
    pathDepth 1 - I -
    // pick the path, get its name and concat name to working string
    pathPick dic.name str.cat
    // concat "/" to end of working string
    "/" str.cat
  loop

  // end working string
  "')\n" str.cat

  pJob_Pwf job.response!
  1 pJob_Pwf job.rowsProcessed!

  900 ssn::senLoc

  //"<<pwf_req" log::mark
    <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: pwf :: pwf ;

jobInfo: pwf
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_PWF
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_LOCAL_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
