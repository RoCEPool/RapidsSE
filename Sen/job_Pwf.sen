/*============================================================================*/
/* job_Pwf.sen -- Job Present Working Folder                                  */
/*============================================================================*/

" job_Pwf.sen" .verbose

/*----------------------------------------------------------------------------*/
/* pwf command request                                                        */
/*----------------------------------------------------------------------------*/
: pwf_req ( -- <R> )

  >>am <SEED_REQ>
  //">>pwf_req" activityMap::mark

  100 apiState::setPosition

  0 0 0 0 locals| pJob_Pwf pTask |

  tp: cf_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_Pwf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_Pwf job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(path VARCHAR)" pJob_Pwf job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // start of working string
  "row: ('/"

  // iterate thru each folder in path and concat to end
  pathDepth 0 do
    // compute the path subscript
    pathDepth 1 - I -
    // pick the path, get its name and concat name to working string
    pathPick dic.name str.cat
    // concat "/" to end of working string
    "/" str.cat
  loop

  // end working string
  "')\n" str.cat

  grid::thisNode@ pJob_Pwf job.response!
  1 grid::thisNode@ pJob_Pwf job.rowsProcessed!

  900 apiState::setPosition

  //"<<pwf_req" activityMap::mark
    <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
