/*============================================================================*/
/* OP_sizeIndex.sen -- Operator size index                                    */
/*============================================================================*/

" OP_sizeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: szidx_action

  <tableNm> <indexNm> op__table_index not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  0 index[].size number.magnitude >str

  // insert index size
  streamSetTable[] StreamSet[].addSizeIndex assert

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: szidx :: szidx <tableNm> <indexNm> ;

: szidx _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--cmd desc for op--"
    <liteOp>    = true
    <streamDef> = __sizeIndex
    <params>    = 2
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
