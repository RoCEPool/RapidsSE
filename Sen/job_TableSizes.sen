/*============================================================================*/
/* job_TableSizes.sen -- Job Table Sizes                                      */
/*============================================================================*/

" job_TableSizes.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute Job_TableSizes job on a node                                       */
/*----------------------------------------------------------------------------*/
: tableSizes::execute _eeh ( -- )

  job::this locals| pJob_TableSizes |

  0 0 0 0 locals| pIndex iSize iCount sTableNm |

  tp: tableSizes_exe

  ""
  pathCurrentFolder dic.lastWord dup
  iterate
    1 iCount + to iCount
    grid::thisNodeName@ "row: ('%v', '" str.format str.cat

    object@ word.name@ to sTableNm
    sTableNm str.cat

    "', '" str.cat

    // push table dictionary
    sTableNm pushTable assert

    // check it is a table
    sTableNm checkIsTable not if drop pJob_TableSizes <ERROR_JOB> !!logError exit then

    // get size ofthe table
    sTableNm find execute table.space 0 swap number.magnitude to iSize
    iSize >str
    str.cat

    // pop table folder
    popTable

    "')\n" str.cat

    object@ word.prev object!

  next

  pJob_TableSizes job.response!
  iCount pJob_TableSizes job.rowsProcessed!
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeTable job check resources                                  */
/*----------------------------------------------------------------------------*/
: tableSizes::checkResources _eeh ( -- )

  tp: tableSizes.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  checkInTables not if job::this <ERROR_JOB> !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: tableSizes :: tableSizes ;

jobInfo: tableSizes
{
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
