/*============================================================================*/
/* job__Cancel.sen -- generic job related words                               */
/*============================================================================*/

" job__Cancel.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job__Cancel to all participants                                 */
/*----------------------------------------------------------------------------*/
: Job__Cancel::distribute params| pJobOriginator |

  //
  // where:  On the originator node.
  //

  JP_CANCELING log::markPhase

  0 locals| pJob__Cancel |

  // create a temporary Job__Cancel
  pJobOriginator job__cancel::new to pJob__Cancel

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the no of acks expected in originator job
  grid::connectedNodes pJobOriginator job.acksRemaining!

  // send job__cancel to all nodes
//  grid::definedNodes 0
//  do
//    I grid::node node.isConnected if
//      I pJob__Cancel job.forward
//    then
//  loop

  0 locals| pNode |

  node_I[].new

  begin
    node_I[].node to pNode

    pNode node.isConnected if
      pNode node.no pJob__Cancel job.forward
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete the temporary job__cancel
  pJob__Cancel job.delete
;

/*----------------------------------------------------------------------------*/
/* run received Job__Cancel on participating node    recv: job.spawn_received */
/*----------------------------------------------------------------------------*/
: _Cancel _run

  //
  // where: on the participating node
  //
  job[] locals| pJob__Cancel |

  // find the job to be executed in the participating jobs
  pJob__Cancel job.id@ locals| iJobId |
  iJobId plist::findJob discard

  // stall till job's previous phase (task) has completed
  begin
    jobRef[].hasTask
  while
    task::yield
  repeat

  // execute the cancel seed of the job on this participating node
  JM_SEED_CAN JobRef[] job.seed!
  JobRef[] job.scheduleNextPhase
  JobRef[].return
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: _Cancel :: _Cancel ;

: _Cancel _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
  }
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
