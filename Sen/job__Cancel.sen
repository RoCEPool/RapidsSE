/*============================================================================*/
/* job__Cancel.sen -- generic job related words                               */
/*============================================================================*/

"job__Cancel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distribute Job__Cancel to all participants                                 */
/*----------------------------------------------------------------------------*/
: Job__Cancel::distribute ( pJobOriginator -- )

  //
  // where:  On the originator node.
  //

  params| pJobOriginator |

  0 locals| pJob__Cancel |

  // set the no of acks expected in originator job
  grid::nodes pJobOriginator job.acksRemaining!

  // create a new Job__Cancel
  pJobOriginator job.id@ job.newCancel to pJob__Cancel

  // send job__execute to all nodes
  grid::nodes 0
  do
    // set which node this task will to send to
    I grid::node task::this task.sendNode!

    // move this task through send state/queue
    task.send

    // pack Job__Cancel into a valset
    pJob__Cancel
    //1 >valset

    // send the execute job
    >socket
  loop

  // now delete the cancel job
  pJob__Cancel job.delete
;

/*----------------------------------------------------------------------------*/
/* run received Job__Cancel on participating node                             */
/*----------------------------------------------------------------------------*/
: Job__Cancel_rcv ( -- )

  job::this locals| pJob__Cancel |
  pJob__Cancel job.id@ locals| iJobId |

  0 0 0 locals| sReleaseResources pJobParticipant pJobCancelled |

  // find the job in the participating jobs
  iJobId job.findParticipant to pJobParticipant

  // execute the job's releaseResources command
  pJobParticipant job.releaseResources@ to sReleaseResources
  sReleaseResources "" str.equal not if 
    pJobParticipant sReleaseResources find execute
  else
    0 assert
  then

  // send job__executed back to originating node
  iJobId pJobParticipant Job__Cancelled::send

  delete_completed_job
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
