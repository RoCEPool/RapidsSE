/*============================================================================*/
/* job__Cancel.sen -- generic job related words                               */
/*============================================================================*/

" job__Cancel.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job__Cancel to all participants                                 */
/*----------------------------------------------------------------------------*/
: Job__Cancel::distribute ( pJobOriginator -- )

  //
  // where:  On the originator node.
  //

  JP_CANCELING log::markPhase

  params| pJobOriginator |

  0 locals| pJob__Cancel |

  // set the no of acks expected in originator job
  grid::nodes pJobOriginator job.acksRemaining!

  // create a new Job__Cancel
  pJobOriginator job__cancel::new to pJob__Cancel

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send job__cancel to all nodes
  grid::nodes 0
  do
    I grid::node node.isConnected if
      I pJob__Cancel job.forward
    then
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // now delete the cancel job
  pJob__Cancel job.delete
;

/*----------------------------------------------------------------------------*/
/* run received Job__Cancel on participating node                             */
/*----------------------------------------------------------------------------*/
: Job__Cancel_rcv ( -- )

  >>logEntry <SEED_RCV>
  actLog::seed_rcv

  //
  // where: on the participating node
  //

  job::this locals| pJob__Cancel |

  // find the job to be executed in the participating jobs
  pJob__Cancel job.id@ locals| iJobId |
  iJobId job::findParticipant locals| pJobParticipant |

  // execute the cancel seed of the job on this participating node
  pJobParticipant SEED_CAN job.spawn

  job::deleteThis

  <DONE_RCV>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
