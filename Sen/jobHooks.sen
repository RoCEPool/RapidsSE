/*============================================================================*/
/* jobHooks.sen -- Job Hooks                                                  */
/*============================================================================*/

" jobHooks.sen" .verbose


/*----------------------------------------------------------------------------*/
/***                             - Entry Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* entry hook for request seed                                                */
/*----------------------------------------------------------------------------*/
: req_entryHook

  "req_entryHook" .

  r@ locate log::markEntry

  SS_SEED_REQ log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* entry hook for begin seed                                                  */
/*----------------------------------------------------------------------------*/
: beg_entryHook

  "beg_entryHook" .

  r@ locate log::markEntry

  SS_SEED_BEG log::jobSeed

  JP_BEGINNING job::this job.phase!

  job::pathSet

  // add this job to the participants list
  job::becomeParticipant
;

/*----------------------------------------------------------------------------*/
/* entry hook for execute seed                                                */
/*----------------------------------------------------------------------------*/
: exe_entryHook

  "exe_entryHook" .

  r@ locate log::markEntry

  SS_SEED_EXE log::jobSeed

  JP_EXECUTING job::this job.phase!

  job::lockExe
;

/*----------------------------------------------------------------------------*/
/* entry hook for end seed                                                    */
/*----------------------------------------------------------------------------*/
: end_entryHook

  "end_entryHook" .

  r@ locate log::markEntry

  SS_SEED_END log::jobSeed

  JP_ENDING job::this job.phase!
;

/*----------------------------------------------------------------------------*/
/* entry hook for cancel seed                                                 */
/*----------------------------------------------------------------------------*/
: can_entryHook

  "can_entryHook" .

  r@ locate log::markEntry

  SS_SEED_CAN log::jobSeed

  JP_CANCELING job::this job.phase!
;

/*----------------------------------------------------------------------------*/
/* entry hook for standard parts                                              */
/*----------------------------------------------------------------------------*/
: std_entryHook

  "std_entryHook" .

  r@ locate log::markEntry
;

/*----------------------------------------------------------------------------*/
/***                              - Exit Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* exit hook for request seed                                                 */
/*----------------------------------------------------------------------------*/
: req_exitHook

  "req_exitHook" .

  r@ locate log::markExit

  job::this locals| pJob |

  ddlLock::testDrop

  // null the job in the task
  nullptr task::this task.job!

  //"Signalling connector thread" .
  pJob job.signalWaiter

  //task::delete
;

/*----------------------------------------------------------------------------*/
/* exit hook for begin request                                                */
/*----------------------------------------------------------------------------*/
: beg_exitHook

   "beg_exitHook" .

  job::participantBegun

  r@ locate log::markExit

  ddlLock::testDrop

  JP_BEGUN job::this job.phase!

  task::delete
;

/*----------------------------------------------------------------------------*/
/* exit hook for execute seed                                                 */
/*----------------------------------------------------------------------------*/
: exe_exitHook

  "exe_exitHook" .

  job::this job::participantExecuted

  r@ locate log::markExit

  ddlLock::testDrop

  JP_EXECUTED job::this job.phase!

  task::delete
;

/*----------------------------------------------------------------------------*/
/* exit hook for end request                                                  */
/*----------------------------------------------------------------------------*/
: end_exitHook

  "end_exitHook" .

  job::participantEnded

  r@ locate log::markExit

  JP_ENDED job::this job.phase!

  // delete the job
  job::this "job::deleteThis" find execute

  task::delete
;

/*----------------------------------------------------------------------------*/
/* exit hook for cancel request                                               */
/*----------------------------------------------------------------------------*/
: can_exitHook

  "can_exitHook" .

  job::participantCancelled

   r@ locate log::markExit

  JP_CANCELED job::this job.phase!

  // delete the job
  job::this "job::deleteThis" find execute

  task::delete
;

/*----------------------------------------------------------------------------*/
/* exit hook for standard parts                                               */
/*----------------------------------------------------------------------------*/
: std_exitHook

  "std_exitHook" .

  r@ locate log::markExit
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
