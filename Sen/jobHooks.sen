/*============================================================================*/
/* jobHooks.sen -- Job Hooks                                                  */
/*============================================================================*/

" jobHooks.sen" .verbose


/*----------------------------------------------------------------------------*/
/***                             - Entry Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* entry hook for request seed                                                */
/*----------------------------------------------------------------------------*/
: req_entryHook

  "req_entryHook" .

  r@ locate log::markEntry

  <SEED_REQ>
;

/*----------------------------------------------------------------------------*/
/* entry hook for begin seed                                                  */
/*----------------------------------------------------------------------------*/
: beg_entryHook

  "beg_entryHook" .

  r@ locate log::markEntry

  <SEED_BEG>

  job::pathSet

  // add this job to the participants list
  job::becomeParticipant
;

/*----------------------------------------------------------------------------*/
/* entry hook for execute seed                                                */
/*----------------------------------------------------------------------------*/
: exe_entryHook

  "exe_entryHook" .

  r@ locate log::markEntry
;

/*----------------------------------------------------------------------------*/
/* entry hook for end seed                                                    */
/*----------------------------------------------------------------------------*/
: end_entryHook

  "end_entryHook" .

  r@ locate log::markEntry
;

/*----------------------------------------------------------------------------*/
/* entry hook for cancel seed                                                 */
/*----------------------------------------------------------------------------*/
: can_entryHook

  "can_entryHook" .

  r@ locate log::markEntry
;

/*----------------------------------------------------------------------------*/
/***                              - Exit Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* exit hook for request seed                                                 */
/*----------------------------------------------------------------------------*/
: req_exitHook

  "req_exitHook" .

  r@ locate log::markExit

  <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* exit hook for begin request                                                */
/*----------------------------------------------------------------------------*/
: beg_exitHook

   "beg_exitHook" .

  job::participantBegun

  r@ locate log::markExit

  ddlLock::testDrop

  <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* exit hook for execute seed                                                 */
/*----------------------------------------------------------------------------*/
: exe_exitHook

  "exe_exitHook" .

  job::this job::participantExecuted

  r@ locate log::markExit

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* exit hook for end request                                                  */
/*----------------------------------------------------------------------------*/
: end_exitHook

  "end_exitHook" .

  job::participantEnded

   r@ locate log::markExit

  <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* exit hook for cancel request                                               */
/*----------------------------------------------------------------------------*/
: can_exitHook

  "can_exitHook" .

  job::participantCancelled

   r@ locate log::markExit

  <DONE_CAN>
;

/*----------------------------------------------------------------------------*/
/* exit hook for ???                                                          */
/*----------------------------------------------------------------------------*/
: std_exitHook

  "std_exitHook" .

  r@ locate log::markExit
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
