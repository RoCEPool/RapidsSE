/*============================================================================*/
/* jobHooks.sen -- Job Hooks                                                  */
/*============================================================================*/

" jobHooks.sen" .verbose


/*----------------------------------------------------------------------------*/
/***                             - Entry Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* entry hook for request seed                                                */
/*----------------------------------------------------------------------------*/
: req_entryHook

  "req_entryHook" .

  r@ locate log::markEntry

  SS_SEED_REQ log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* entry hook for begin seed                                                  */
/*----------------------------------------------------------------------------*/
: beg_entryHook

  "beg_entryHook" .

  r@ locate log::markEntry

  SS_SEED_BEG log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* entry hook for execute seed                                                */
/*----------------------------------------------------------------------------*/
: exe_entryHook

  "exe_entryHook" .

  r@ locate log::markEntry

  SS_SEED_EXE log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* entry hook for end seed                                                    */
/*----------------------------------------------------------------------------*/
: end_entryHook

  "end_entryHook" .

  r@ locate log::markEntry

  SS_SEED_END log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* entry hook for cancel seed                                                 */
/*----------------------------------------------------------------------------*/
: can_entryHook

  "can_entryHook" .

  r@ locate log::markEntry

  SS_SEED_CAN log::jobSeed
;

/*----------------------------------------------------------------------------*/
/* entry hook for standard parts                                              */
/*----------------------------------------------------------------------------*/
: std_entryHook

  "std_entryHook" .

  r@ locate log::markEntry
;

/*----------------------------------------------------------------------------*/
/***                              - Exit Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* exit hook for request seed                                                 */
/*----------------------------------------------------------------------------*/
: req_exitHook

  "req_exitHook" .

  r@ locate log::markExit

  ddlLock::testDrop
;

/*----------------------------------------------------------------------------*/
/* exit hook for begin request                                                */
/*----------------------------------------------------------------------------*/
: beg_exitHook

   "beg_exitHook" .

  r@ locate log::markExit

  ddlLock::testDrop

  task::delete
;

/*----------------------------------------------------------------------------*/
/* exit hook for execute seed                                                 */
/*----------------------------------------------------------------------------*/
: exe_exitHook

  "exe_exitHook" .

  r@ locate log::markExit

  ddlLock::testDrop

  task::delete
;

/*----------------------------------------------------------------------------*/
/* exit hook for end request                                                  */
/*----------------------------------------------------------------------------*/
: end_exitHook

  "end_exitHook" .

  r@ locate log::markExit

  ddlLock::testDrop

  job::completed
;

/*----------------------------------------------------------------------------*/
/* exit hook for cancel request                                               */
/*----------------------------------------------------------------------------*/
: can_exitHook

  "can_exitHook" .

  r@ locate log::markExit

  job::completed
;

/*----------------------------------------------------------------------------*/
/* exit hook for standard parts                                               */
/*----------------------------------------------------------------------------*/
: std_exitHook

  "std_exitHook" .

  r@ locate log::markExit
;

/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception hook                                                    */
/*----------------------------------------------------------------------------*/
: std_exceptionHook

  "std_exceptionHook" .

  r@ locate log::markExit

  process::quit
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
