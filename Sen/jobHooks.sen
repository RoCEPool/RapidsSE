/*============================================================================*/
/* jobHooks.sen -- Job Hooks                                                  */
/*============================================================================*/

" jobHooks.sen" .verbose


/*----------------------------------------------------------------------------*/
/***                             - Entry Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* entry hook for request seed                                                */
/*----------------------------------------------------------------------------*/
: req_entryHook

  // "req_entryHook" .

  r@ locate log::markEntry

  SS_SEED_REQ log::jobSeed

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* entry hook for begin seed                                                  */
/*----------------------------------------------------------------------------*/
: beg_entryHook

  // "beg_entryHook" .

  r@ locate log::markEntry

  SS_SEED_BEG log::jobSeed

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* entry hook for execute seed                                                */
/*----------------------------------------------------------------------------*/
: exe_entryHook

  // "exe_entryHook" .

  r@ locate log::markEntry

  SS_SEED_EXE log::jobSeed

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* entry hook for end seed                                                    */
/*----------------------------------------------------------------------------*/
: end_entryHook

  // "end_entryHook" .

  r@ locate log::markEntry

  SS_SEED_END log::jobSeed

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* entry hook for cancel seed                                                 */
/*----------------------------------------------------------------------------*/
: can_entryHook

  // "can_entryHook" .

  r@ locate log::markEntry

  SS_SEED_CAN log::jobSeed

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* entry hook for standard parts                                              */
/*----------------------------------------------------------------------------*/
: std_entryHook

  // "std_entryHook" .

  r@ locate log::markEntry

  job::assertCorrectness

  <seed_initially>
;

/*----------------------------------------------------------------------------*/
/***                              - Exit Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* exit hook for request seed                                                 */
/*----------------------------------------------------------------------------*/
: req_exitHook

  // "req_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* exit hook for begin request                                                */
/*----------------------------------------------------------------------------*/
: beg_exitHook

  // "beg_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  task::delete

  HAZARD

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* exit hook for execute seed                                                 */
/*----------------------------------------------------------------------------*/
: exe_exitHook

  // "exe_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  task::delete

  HAZARD

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* exit hook for end request                                                  */
/*----------------------------------------------------------------------------*/
: end_exitHook

  // "end_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  job::completed

  HAZARD
  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* exit hook for cancel request                                               */
/*----------------------------------------------------------------------------*/
: can_exitHook

  // "can_exitHook" .

  r@ locate log::markExit

  job::completed

  HAZARD

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* exit hook for standard parts                                               */
/*----------------------------------------------------------------------------*/
: std_exitHook

  // "std_exitHook" .

  r@ locate log::markExit

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception hook                                                    */
/*----------------------------------------------------------------------------*/
: std_exceptionHook

  // "std_exceptionHook" .

  process::quit

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
