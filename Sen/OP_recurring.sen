/*============================================================================*/
/* OP_recurring.sen -- Operator recurring                                     */
/*============================================================================*/

" OP_recurring.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add recurring activity here                                                */
/*----------------------------------------------------------------------------*/
: recurring_activity ( -- )

  "Recurring Activity" .
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: recurring_StartMarker \handler

  begin

    task::yield

    // "periodic sleeping..." .
    60 task::sleepSsec

    recurring_activity

  again
;

/*----------------------------------------------------------------------------*/
/* execute for recurring req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : recurring_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: recurring_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: recurring :: recurring ;

: recurring _cmdTags

  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
