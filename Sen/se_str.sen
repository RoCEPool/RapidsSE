/*============================================================================*/
/* se_str.sen -- additional str words                                         */
/*============================================================================*/

" se_str.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: str.isMetaToken ( s -- t|f )

  dup 1 swap str.left  "<" str.same not if discard false exit_rt then

  1 swap str.right ">" str.same not if false exit_rt then

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: str.isJsonToken ( s -- t|f )

  "{name:value}" str.same
;

/*----------------------------------------------------------------------------*/
/* convert str vector to path string                                          */
/*----------------------------------------------------------------------------*/
: strVec::toPath ( s s s... n -- s )

  // push initial result string
  "" swap

  ( n ) 0 ?do

    "/" str.cat

    swap str.cat

  loop
;

/*----------------------------------------------------------------------------*/
/* conver into into a string of digit names                                   */
/*----------------------------------------------------------------------------*/
: >digitWords ( i -- s )

  >str locals| sDecodeMe |

  "" "" 0 locals| iDigit sDigitName sDecodedTo |

  // loop for 0 to length of sDecodeMe - 1
  sDecodeMe str.length 0
  do
    // concat " " to end of decoded string
    I if sDecodedTo " " str.cat to sDecodedTo then

    // clip out digit I, convert it to a str
    1 I sDecodeMe str.sub >int >digitName to sDigitName

    // append digit name to the decoded string
    sDecodedTo sDigitName str.cat to sDecodedTo
  loop

  // return decode string
  sDecodedTo
;

/*----------------------------------------------------------------------------*/
/* formatted print                                                            */
/*----------------------------------------------------------------------------*/
: fmt.print

  str.format .
;

/*----------------------------------------------------------------------------*/
/* formatted put                                                              */
/*----------------------------------------------------------------------------*/
: fmt.put

  str.format .put
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
