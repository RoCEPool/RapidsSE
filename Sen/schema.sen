;
*/

/*----------------------------------------------------------------------------*/
/* remove a schema folder                                                     */
/*----------------------------------------------------------------------------*/
: removeSchema allParticipants 1 checkResult ( "<schemaNm>" -- true n# true )

tp: removeSchema

  args.tracepoint if
    dup "REMOVING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  :forget ( )

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* remove a schema folder                                                     */
/*----------------------------------------------------------------------------*/
: removeSchemaR35 ( "<schemaNm>" -- true/false )

  tp: removeSchema

  args.tracepoint if
    dup "REMOVING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  :forget ( )

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
