/*============================================================================*/
/* schema.sen -- schema related words                                         */
/*============================================================================*/

"schema.sen" .verbose

: schema ;

//: makeSchemas pathPush "schemas" :dic tick folder swap execute dic.kind! pathDrop ;


: :schema
    :dic
         //dup tick schema swap word.kind!
         dup tick schema swap execute dic.kind!
;

: withinSchemas
    0 pathPick dic.name "schemas" str.equal
;

: checkInSchemas
    withinSchemas if true exit then
    EC_NOT_IN_SCHEMAS false
;

: checkIsSchema ( word )

    dup word.kind@ tick folder eql not if EC_NOT_A_FOLDER false exit then
    dup execute dic.kind@ tick schema eql if true exit then
    EC_NOT_A_SCHEMA false
;



/*----------------------------------------------------------------------------*/
/* make a schemas folder under given named catalog                            */
/*----------------------------------------------------------------------------*/
: makeSchemas ( "<catalogNm>" -- )

  args.tracepoint if
    dup "MAKING SCHEMAS FOR CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "schemas"    ( dic "schemas" )
  swap         ( "schemas" dic )
  :folder      ( )
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable schema folder                                 */
/*----------------------------------------------------------------------------*/
: checkRemoveSchema ( "<schemaNm>" -- "<schemaNm>" true | "<schemaNm>" errorCode false )

  dup ( "<schemaNm>" "<schemaNm>" )

  checkInSchemas not if false exit then ( "<schemaNm>" word )
  checkIsWord    not if false exit then ( "<schemaNm>" word )
  checkIsSchema  not if false exit then ( "<schemaNm>" word )
  checkIsEmpty   not if false exit then ( "<schemaNm>" word )
  checkNotUsed   not if false exit then ( "<schemaNm>" word )

  drop ( "<schemaNm>" )

  true ( "<schemaNm>" true )
;

////////////////////////////////////////////////////////////////////////////////

