/*============================================================================*/
/* job_BM_GenEntOp.sen -- Generate Entry Operator                             */
/*============================================================================*/

" job_BM_GenEntOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenEnt_PulseMarker

  // pipe out the pulse marker to the next operator
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // new a stream def
  Operand[].newStreamDef

  Operand[].pipeOut

  // generate ent buffer's
  index[].get index.genEntBuffer to Operand[]
debug::breakPoint
  Operand[].pipeOut

  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenEnt_StartMarker

  "BM_GenEnt_StartMarker (Table A)" .

  // check in tables folder
  checkInTables not if false exit then

  "BM_GenEnt_StartMarker (Table B)" .

  // table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ <ERROR_JOB>
    Operand[].delete
    Operand[].newErrorMarker
    exit
  then

  "BM_GenEnt_StartMarker (Table C)" .

  // move to table folder and find the table
  <tableNm> pushTable assert
  <tableNm> find execute to table[]

  "BM_GenEnt_StartMarker (Table D)" .

  // cross-check
  table[].get assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "BM_GenEnt_StartMarker (Index A)" .

  // move to indexes folder
  pushIndexes assert

  "BM_GenEnt_StartMarker (Index B)" .

  <indexNm> checkIsIndex not if
    op.pipelineJob@ <ERROR_JOB>
    Operand[].delete
    Operand[].newErrorMarker
    exit
  then

  "BM_GenEnt_StartMarker (Index C)" .

  <IndexNm> find execute to index[]

  "BM_GenEnt_StartMarker (Index D)" .

  // cross-check
  index[].get assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* BM_GenEntOp request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_GenEntOp_req ( -- )

  >>logEntry <SEED_REQ>

  job::this locals| pJob_BM_GenEntOp |
  0 locals| pTable |

  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode operand kind
    Operand[].kind case

      ZK_PULSEMARKER of BM_GenEnt_PulseMarker true endof

      ZK_STARTMARKER of BM_GenEnt_StartMarker true endof

      jobOperand::generic swap

    endcase

  while assert::stack_0 repeat

  "*** BM_GenEntOp EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: BM_GenEntOp :: BM_GenEntOp <tableNm> <indexNm> <nBuffers>
                                      <topology> <nextStage> <nextOp> ;

jobInfo: BM_GenEntOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
