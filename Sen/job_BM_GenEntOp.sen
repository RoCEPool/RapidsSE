/*============================================================================*/
/* job_BM_GenEntOp.sen -- Generate Entry Operator                             */
/*============================================================================*/

" job_BM_GenEntOp.sen" .verbose

//---------------------
: BM_GenEnt_StartMarker

  sTableNm checkIsValidTable not if
    op.pipelineJob@ <ERROR_JOB>
    Operand[].delete
    Operand[].newErrorMarker
    exit_rt
  then

  // move to table folder and find the table
  sTableNm pushTable assert
  sTableNm find execute to table[]
;

//---------------------
: BM_GenEnt_PulseMarker

  Operand[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // pipeout a single generated csv buffer
  //begin
  table[].get table.genCsvBuffer to Operand[]
  Operand[].pipeOut
  //false
  //while repeat

  Operand[].newEosMarker
;

/*----------------------------------------------------------------------------*/
/* BM_GenEntOp request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_GenEntOp_req ( -- )

  >>logEntry <SEED_REQ>

  job::this locals| pJob_BM_GenEntOp |
  0 locals| pTable |

  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode operand kind
    Operand[].kind case

      ZK_PULSEMARKER of
        BM_GenEnt_PulseMarker
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        BM_GenEnt_StartMarker
        Operand[].pipeOut
        true
      endof

      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  "*** BM_GenEntOp EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: BM_GenEntOp :: BM_GenEntOp <tableNm> <indexNm> <topology> <nextStage> <nextOp> ;

jobInfo: BM_GenEntOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
