/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: startOp_StartedMarker \handler

  //"Operand:- ZK_STARTEDMARKER" .verbose
  Operand[].delete
  Operand[].newPulseMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPPEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: startOp_StoppedMarker \handler

  //"Operand:- ZK_STOPPEDMARKER" .verbose
  Operand[].delete
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* execute for startOp request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : startOp_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: startOp_StartedMarker ZK_STARTEDMARKER op[].handler!
  find: startOp_StoppedMarker ZK_STOPPEDMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: startOp :: startOp ;

jobInfo: startOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
