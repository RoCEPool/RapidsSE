/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose

  // check if start has already been pulsed
  Job_Pipeline::isPulsed if
    PipeIn[].delete
  else
    // mark pipeline as being cancelled
    true Job_Pipeline::cancelled

    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELLEDMARKER ...                                         */
/*----------------------------------------------------------------------------*/
: start_CancelledMarker \handler

  //"ZK_CANCELLEDMARKER_handler" .verbose
  PipeIn[].pipeOut
  Op.ackPipelineJob
  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: start_CrwBuffer \handler

  //"ZK_CRWBUFFER_handler" .verbose
  PipeIn[].delete

  // start operator should never get a CRWBUFFER
  EC_PIPELINE_PROTOCOL_ERROR op.pipelineJob@ ERROR_JOB !!logError
  Operand[].newErrorMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: start_CsvBuffer \handler

  //"ZK_CSVBUFFER_handler" .verbose
  PipeIn[].delete

  // start operator should never get a CSVBUFFER
  EC_PIPELINE_PROTOCOL_ERROR op.pipelineJob@ ERROR_JOB !!logError
  Operand[].newErrorMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: start_EntBuffer \handler

  //"ZK_ENTBUFFER_handler" .verbose
  PipeIn[].delete

  // start operator should never get an ENTBUFFER
  EC_PIPELINE_PROTOCOL_ERROR op.pipelineJob@ ERROR_JOB !!logError
  Operand[].newErrorMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERROREDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: start_ErroredMarker \handler

  //"Operand:- ZK_ERROREDMARKER" .verbose
  PipeIn[].delete

  // now pipeout an exit marker
  Operand[].newCancelMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_ExitedMarker \handler

  //"Operand:- ZK_EXITEDMARKER" .verbose
  PipeIn[].delete
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_PulsedMarker \handler

  //"Operand:- ZK_PULSEDMARKER" .verbose
  PipeIn[].delete

  // check if start has already been cancelled
  Job_Pipeline::isCancelled not if

    // check if start has already been exited
    Job_Pipeline::isErrored not if

      // mark pipeline as being pulsed
      true Job_Pipeline::pulsed

      // now pipeout an exit marker
      Operand[].newExitMarker
      Operand[].pipeOut

    then

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_RSBBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: start_RsbBuffer \handler

  //"ZK_RSBBUFFER" .verbose
  PipeIn[].delete

  // start operator should never get an RSBBUFFER
  EC_PIPELINE_PROTOCOL_ERROR op.pipelineJob@ ERROR_JOB !!logError
  Operand[].newErrorMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: start_StartedMarker \handler

  //"Operand:- ZK_STARTEDMARKER" .verbose
  PipeIn[].delete
  Operand[].newPulseMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: start_StreamDef \handler

  //"ZK_STREAMDEF" .verbose
  PipeIn[].delete

  // start operator should never get a STREAMDEF
  EC_PIPELINE_PROTOCOL_ERROR op.pipelineJob@ ERROR_JOB !!logError
  Operand[].newErrorMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for start request                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : start_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: start_CancelMarker    ZK_CANCELMARKER    op[].handler!
  find: start_CancelledMarker ZK_CANCELLEDMARKER op[].handler!
  find: start_CrwBuffer       ZK_CRWBUFFER       op[].handler!
  find: start_CsvBuffer       ZK_CSVBUFFER       op[].handler!
  find: start_EntBuffer       ZK_ENTBUFFER       op[].handler!
  find: start_ErroredMarker   ZK_ERROREDMARKER   op[].handler!
  find: start_ExitedMarker    ZK_EXITEDMARKER    op[].handler!
  find: start_PulsedMarker    ZK_PULSEDMARKER    op[].handler!
  find: start_RsbBuffer       ZK_RSBBUFFER       op[].handler!
  find: start_StartedMarker   ZK_STARTEDMARKER   op[].handler!
  find: start_StreamDef       ZK_STREAMDEF       op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: start :: start ;

: start _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
