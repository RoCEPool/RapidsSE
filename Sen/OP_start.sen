/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose

  // check if start has already been pulsed
  Job_Pipeline::isPulsed if
    Pipein[].delete
  else
    // mark pipeline as being cancelled
    true Job_Pipeline::cancelled

    Pipein[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERROREDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: start_ErroredMarker \handler

  //"Operand:- ZK_ERROREDMARKER" .verbose
  Pipein[].delete

  // now pipeout an exit marker
  Operand[].newExitMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_ExitedMarker \handler

  //"Operand:- ZK_EXITEDMARKER" .verbose
  Pipein[].delete
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_PulsedMarker \handler

  //"Operand:- ZK_PULSEDMARKER" .verbose
  Pipein[].delete

  // check if start has already been cancelled
  Job_Pipeline::isCancelled not if

    // check if start has already been exited
    Job_Pipeline::isErrored not if

      // mark pipeline as being pulsed
      true Job_Pipeline::pulsed

      // now pipeout an exit marker
      Operand[].newExitMarker
      Operand[].pipeout

    then

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: start_StartedMarker \handler

  //"Operand:- ZK_STARTEDMARKER" .verbose
  Pipein[].delete
  Operand[].newPulseMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for start request                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : start_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: start_CancelMarker  ZK_CANCELMARKER  op[].handler!
  find: start_ErroredMarker ZK_ERROREDMARKER  op[].handler!
  find: start_ExitedMarker  ZK_EXITEDMARKER  op[].handler!
  find: start_PulsedMarker  ZK_PULSEDMARKER  op[].handler!
  find: start_StartedMarker ZK_STARTEDMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: start :: start ;

: start _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--cmd desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
