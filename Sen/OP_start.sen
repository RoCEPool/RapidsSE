/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: startOp_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose
  Pipein[].pipeout
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: startOp_StartedMarker \handler

  //"Operand:- ZK_STARTEDMARKER" .verbose
  Pipein[].delete
  Operand[].newPulseMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: startOp_ExitedMarker \handler

  //"Operand:- ZK_EXITEDMARKER" .verbose
  Pipein[].delete
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* execute for startOp request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : startOp_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: startOp_ExitedMarker  ZK_EXITEDMARKER  op[].handler!
  find: startOp_CancelMarker  ZK_CANCELMARKER  op[].handler!
  find: startOp_StartedMarker ZK_STARTEDMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: startOp :: startOp ;

: startOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
