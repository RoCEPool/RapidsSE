/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: startOp_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose

  // check if startOp has already been pulsed
  Job_Pipeline::isPulsed if
    Pipein[].delete
  else
    // mark pipeline as being cancelled
    true Job_Pipeline::cancelled

    Pipein[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERROREDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: startOp_ErroredMarker \handler

  //"Operand:- ZK_ERROREDMARKER" .verbose
  Pipein[].delete

  // now pipeout an exit marker
  Operand[].newExitMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: startOp_ExitedMarker \handler

  //"Operand:- ZK_EXITEDMARKER" .verbose
  Pipein[].delete
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: startOp_PulsedMarker \handler

  //"Operand:- ZK_PULSEDMARKER" .verbose
  Pipein[].delete

  // check if startOp has already been cancelled
  Job_Pipeline::isCancelled not if

    // mark pipeline as being pulsed
    true Job_Pipeline::pulsed

    // now pipeout an exit marker
    Operand[].newExitMarker
    Operand[].pipeout

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: startOp_StartedMarker \handler

  //"Operand:- ZK_STARTEDMARKER" .verbose
  Pipein[].delete
  Operand[].newPulseMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for startOp request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : startOp_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: startOp_CancelMarker  ZK_CANCELMARKER  op[].handler!
  find: startOp_ErroredMarker ZK_ERROREDMARKER  op[].handler!
  find: startOp_ExitedMarker  ZK_EXITEDMARKER  op[].handler!
  find: startOp_PulsedMarker  ZK_PULSEDMARKER  op[].handler!
  find: startOp_StartedMarker ZK_STARTEDMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: startOp :: startOp ;

: startOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
