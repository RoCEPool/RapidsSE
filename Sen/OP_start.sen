/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: startOp_StartedMarker \handler

  //"Operand:- ZK_STARTEDMARKER" .verbose
  Operand[].delete
  Operand[].newPulseMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPPEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: startOp_StoppedMarker \handler

  //"Operand:- ZK_STOPPEDMARKER" .verbose
  Operand[].delete
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* execute for startOp request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : startOp_req ( -- )
 
  LogEntry SEED_REQ

  job[] job.enameSet@ enameSet.asStr .

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_STARTEDMARKER of startOp_StartedMarker endof

      ZK_STOPPEDMARKER of startOp_StoppedMarker endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: startOp :: startOp ;

jobInfo: startOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
