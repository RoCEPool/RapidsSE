/*============================================================================*/
/* BM_insIdx.sen -- Benchmark Operator insIdx                                 */
/*============================================================================*/

" BM_insIdx.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_Report

  Operand[].newCsvBuffer
  Operand[].report

  now[] now.asOf

  now[] now.timestampStr locals| sTsp |
  now[] now.sinceEpoch   locals| iNow |

  // csv report for bm_insidx
  aggTimer[] aggTimer.reportStr
    iNow
    sTsp
    "BM_InsIdx,%v,%v,Elapsed Time,%v\n"
    str.format Operand[].csvAppend

  counter0[].get
    iNow
    sTsp
    "BM_InsIdx,%v,%v,Number of EntBuffers,%v\n"
    str.format Operand[].csvAppend

  counter1[].get
    iNow
    sTsp
    "BM_InsIdx,%v,%v,Total Number of Entries,%v\n"
    str.format Operand[].csvAppend

  aggTimer[] aggTimer.nanosecs counter1[].get /
    iNow
    sTsp
    "BM_InsIdx,%v,%v,Average Time per Entry,%vns\n"
    str.format Operand[].csvAppend
  
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_ENTBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_EntBuffer

  "BM_InsIdx_EntBuffer" .

  // get index partition for current partition
  index[].get index.IndexPtn to IndexPtn[] // indexPtn

  BM_TimerBegin

  // insert all the entries into tree
  //   NB: registers are available in the step!!
  Operand[].get IndexPtn[].get IndexPtn.insEntBuffer // <- focal pt of bm
    counter1[] + to counter1[]

  counter0[] 1 + to counter0[]

  BM_TimerUpdate

  Operand[].delete
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_EosMarker

  Operand[].delete

  BM_InsIdx_Report

  Operand[].newEosMarker
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_StartMarker

  now[] now.asOf now[] now.timestampStr .
  now[] now.sinceEpoch "SinceEpoch: %vs" .printf

  // table index folder push
  op__table_index

  folderPath.str "Folder path: %v" .printf

  BM_TimerNew

  //Task_Interpreter

  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* execute for insertOp                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_InsIdxOp_req ( -- )
 
  >>logEntry <SEED_REQ>
//
  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  true "BM_InsIdx_StartMarker" find word.breakPt!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

    ZK_ENTBUFFER   of BM_InsIdx_EntBuffer   true endof

    ZK_EOSMARKER   of BM_InsIdx_EosMarker   true endof

    ZK_STARTMARKER of BM_InsIdx_StartMarker true endof

    jobOperand::generic swap

    endcase

  while assert::stack_0 repeat

  "*** BM_InsIdxOp EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: BM_InsIdxOp :: BM_InsIdxOp <tableNm> <indexNm> <topology> <nextStage> <nextOp> ;

jobInfo: BM_InsIdxOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
