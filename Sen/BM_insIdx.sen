/*============================================================================*/
/* BM_insIdx.sen -- Benchmark Operator insIdx                                 */
/*============================================================================*/

" BM_insIdx.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_Report

  Operand[].newCsvBuffer
  Operand[].report

  now[] now.asOf

  now[] now.timestampStr locals| sTsp |
  now[] now.sinceEpoch   locals| iNow |

  // csv report for bm_insidx
  aggTimer[] aggTimer.reportStr
    iNow
    sTsp
    "BM_InsIdx,%v,%v,Elapsed Time,%v\n"
    str.format Operand[].csvAppend

  counter0[].get
    iNow
    sTsp
    "BM_InsIdx,%v,%v,Number of EntBuffers,%v\n"
    str.format Operand[].csvAppend

  counter1[].get
    iNow
    sTsp
    "BM_InsIdx,%v,%v,Total Number of Entries,%v\n"
    str.format Operand[].csvAppend

  aggTimer[] aggTimer.nanosecs counter1[].get /
    iNow
    sTsp
    "BM_InsIdx,%v,%v,Average Time per Entry,%vns\n"
    str.format Operand[].csvAppend
  
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_ENTBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_EntBuffer \handler

  "BM_InsIdx_EntBuffer" .

  // get index partition for current partition
  index[] index.IndexTree to IndexTree[] // IndexTree

  BM_TimerBegin

  // insert all the entries into tree
  //   NB: registers are available in the step!!
  Operand[] IndexTree[].get IndexTree.insEntBuffer // <- focal pt of bm
    counter1[] + to counter1[]

  counter0[] 1 + to counter0[]

  BM_TimerUpdate

  Operand[].delete
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_EosMarker \handler

  Pipein[].delete

  BM_InsIdx_Report

  Operand[].newEosMarker
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_StartMarker \handler

  now[] now.asOf now[] now.timestampStr .
  now[] now.sinceEpoch "SinceEpoch: %vs" .printf

  // table index folder push
  <tableNm> <indexNm> op__table_index if

    path[].toStr "Folder path: %v" .printf

    BM_TimerNew

    //Task_Interpreter

    Pipein[].pipeout
  then
;

/*----------------------------------------------------------------------------*/
/* execute for insIdx                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_InsIdxOp_req \operator
 
  LogReqEntry SEED_REQ

  true "BM_InsIdx_StartMarker" find word.breakPt!

  op__topology

  find: BM_InsIdx_EntBuffer   ZK_ENTBUFFER   op[].handler!
  find: BM_InsIdx_EosMarker   ZK_EOSMARKER   op[].handler!
  find: BM_InsIdx_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  "*** BM_InsIdxOp EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: BM_InsIdxOp :: BM_InsIdxOp <tableNm> <indexNm> ;

: BM_InsIdxOp _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
