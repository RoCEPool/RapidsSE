/*============================================================================*/
/* operators.sen -- the operators                                             */
/*============================================================================*/

"operators.sen" .verbose

"operator.sen" include

"symbolicArgs.sen" include

"aggregateOp.sen" include
"deciderOp.sen" include
"distinctOp.sen" include
"emitOp.sen" include
"fanOp.sen" include
"fetchOp.sen" include
"filterOp.sen" include
"joinOp.sen" include
"limitOp.sen" include
"markOp.sen" include
"mergeOp.sen" include
"nextOp.sen" include
"printOp.sen" include
"projectOp.sen" include
"rangeOp.sen" include
"readOp.sen" include
"recvOp.sen" include
"responseOp.sen" include
"scanOp.sen" include
"sendOp.sen" include
"sinkOp.sen" include
"sortOp.sen" include
"teeOp.sen" include
"triggerRangeOp.sen" include
"triggerScanOp.sen" include
"writeOp.sen" include

/*----------------------------------------------------------------------------*/
/* create the operator actors                                                 */
/*----------------------------------------------------------------------------*/
: createOpActors

  // "createOpActors" .

  0 "printOp"        dup :createWorkerActor spawnWorkerActor
  0 "responseOp"     dup :createWorkerActor spawnWorkerActor
  0 "rangeOp"        dup :createWorkerActor spawnWorkerActor
  0 "scanOp"         dup :createWorkerActor spawnWorkerActor
  0 "sinkOp"         dup :createWorkerActor spawnWorkerActor
  0 "triggerRangeOp" dup :createWorkerActor spawnWorkerActor
  0 "triggerScanOp"  dup :createWorkerActor spawnWorkerActor
  0 "writeOp"        dup :createWorkerActor spawnWorkerActor
;

////////////////////////////////////////////////////////////////////////////////

createOpActors

