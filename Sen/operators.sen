/*============================================================================*/
/* operators.sen -- the operators                                             */
/*============================================================================*/

"-operators.sen" .verbose

"operator.sen" include

"symbolicArgs.sen" include

"Op_aggregate.sen" include
"Op_decider.sen" include
"Op_distinct.sen" include
"Op_emit.sen" include
"Op_fan.sen" include
"Op_fetch.sen" include
"Op_filter.sen" include
"Op_join.sen" include
"Op_limit.sen" include
"Op_mark.sen" include
"Op_merge.sen" include
"Op_next.sen" include
"Op_print.sen" include
"Op_project.sen" include
"Op_range.sen" include
"Op_read.sen" include
"Op_recv.sen" include
"Op_response.sen" include
"Op_scan.sen" include
"Op_send.sen" include
"Op_sink.sen" include
"Op_sort.sen" include
"Op_tee.sen" include
"Op_triggerRange.sen" include
"Op_triggerScan.sen" include
"Op_write.sen" include

/*----------------------------------------------------------------------------*/
/* create the operator actors                                                 */
/*----------------------------------------------------------------------------*/
: createOpActors

  // "createOpActors" .

  0 "printOp"        dup :createWorkerActor spawnWorkerActor
  0 "responseOp"     dup :createWorkerActor spawnWorkerActor
  0 "rangeOp"        dup :createWorkerActor spawnWorkerActor
  0 "scanOp"         dup :createWorkerActor spawnWorkerActor
  0 "sinkOp"         dup :createWorkerActor spawnWorkerActor
  0 "triggerRangeOp" dup :createWorkerActor spawnWorkerActor
  0 "triggerScanOp"  dup :createWorkerActor spawnWorkerActor
  0 "writeOp"        dup :createWorkerActor spawnWorkerActor
;

////////////////////////////////////////////////////////////////////////////////

createOpActors

/*============================================================================*/
/* end                                                                        */
