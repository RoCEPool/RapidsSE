"operators.sen" .verbose

"symbolicArgs.sen" include

"operator.sen" include

"aggregateOp.sen" include
"deciderOp.sen" include
"distinctOp.sen" include
"emitOp.sen" include
"fanOp.sen" include
"fetchOp.sen" include
"filterOp.sen" include
"joinOp.sen" include
"limitOp.sen" include
"markOp.sen" include
"mergeOp.sen" include
"nextOp.sen" include
"projectOp.sen" include
"rangeOp.sen" include
"readOp.sen" include
"recvOp.sen" include
"scanOp.sen" include
"sendOp.sen" include
"sinkOp.sen" include
"sortOp.sen" include
"teeOp.sen" include
"triggerOp.sen" include
"writeOp.sen" include

/*----------------------------------------------------------------------------*/
/* create the operator actors                                                 */
/*----------------------------------------------------------------------------*/
: createOpActors

  "createOpActors" .

  0 "scanOp"  dup :actor actor.spawn
  0 "sinkOp"  dup :actor actor.spawn
  0 "writeOp" dup :actor actor.spawn
;

////////////////////////////////////////////////////////////////////////////////

createOpActors

