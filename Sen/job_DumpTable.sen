/*============================================================================*/
/* job_DumpTable.sen -- Job Dump Table                                        */
/*============================================================================*/

" job_DumpTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkDumpTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushTable assert

  sTableNm checkIsTable not if path[].popTable false exit then
  //sTableNm tableInUse if path[].popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  path[].popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* dump table request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: dumpTable_req ( -- <R> )

  LogEntry SEED_REQ

  0 0 0 0 locals| pTask sTableNm sIndexNm pJob_DumpTable |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task[] to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_DumpTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table name
  //pJob_DumpTable job.objectName@ to sTableNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //check if we can dump the table
  sTableNm checkDumpTable not if pJob_DumpTable ERROR_REQUEST !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table folder
  sTableNm path[].pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize
  sTableNm find execute table.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop itable folder
  path[].popTable

  pJob_DumpTable job.notice

  LogExit DONE_REQ
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: dumptable :: dumptable <tableNm> ;
jobSyntax: dumptable :: dumptbl <tableNm> ;

jobInfo: dumptable
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_JOB_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
