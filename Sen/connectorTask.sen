/*============================================================================*/
/* connectorTask.sen -- connector task                                        */
/*============================================================================*/

"connectorTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* define the con actor (con.task, con.queue, con.taskset, con.thread)        */
/*----------------------------------------------------------------------------*/
job: con

/*----------------------------------------------------------------------------*/
/* start the connector task                                                   */
/*----------------------------------------------------------------------------*/
: connectorStart

tp: connectorStart

  0 "con.loop" nullPtr "connectorTask" spawnActorTask
;

/*----------------------------------------------------------------------------*/
/* connector loop                                                             */
/*----------------------------------------------------------------------------*/
: con.loop

  connectorTaskPrint if "Connector running..." . then

  grid.nodes 0 do

    I grid.thisNode@ == if

      nullptr I senderQueues !
      nullptr I senderTasks  !

    else

      I grid.node     ( ^node )
      dup             ( ^node ^node )
      node.port swap  ( port ^node )
      node.IP         ( port IP )

      socket.open  socket.connect

      args.verbose if
        "Node" grid.thisNode@ >str str.cat
        " connected to node" str.cat
        I >str str.cat
        .
      then

      // start sender
      //"starting sender" .

ddlLock::grabWrite

     // set up the seed
      1 "snd.loop" ( socket 1 "snd.loop" )

      // create the actor
      "sr" I >str str.cat :job ( socket 1 "snd.loop" "srI" )

      // record the senderQueue
      dup job.queue I senderQueues ! ( socket 1 "snd.loop" "srI" )
      dup job.task  I senderTasks  ! ( socket 1 "snd.loop" "srI" )

      // spawn the actors os thread
      job.spawn

ddlLock::dropWrite

    then

  loop

  // set grid as started
  true grid.started!
  grid.thisNodeName@ "Node %v : SE cluster started" str.format .

  //1000000 thread.sleep_s

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
