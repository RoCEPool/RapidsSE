/*============================================================================*/
/* job__Cancelled.sen -- generic job related words                            */
/*============================================================================*/

" job__Cancelled.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job__Cancelled back to originating node                               */
/*----------------------------------------------------------------------------*/
: Job__Cancelled::send ( pJobParticipant -- )

  params| pJobParticipant iJobId |

  pJobParticipant job.id@ locals| iJobId |

  0 0 0 locals| pJob pJob__Cancelled error |

  // new a temporary Job__Cancelled
  iJobId job.newCancelled to pJob__Cancelled

  // get error if any
  grid::thisNode@ pJobParticipant job.error@ to error

  error EC_NONE != if
    // set error in executed job
    error pJob__Cancelled jobCancelled.error!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the originator node as the send target node
  //iJobId job::originator@ grid::node task::this task.sendNode!

  // move this task through send state/queue
  //ask.send

  // send the cancelled job
  iJobId job::originator@ locals| iOriginator |
  //iOriginator pJob__Cancelled jobCancelled.cancelOriginator!

  iOriginator pJob__Cancelled job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete Job__Cancelled
  pJob__Cancelled job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run recieved Job__Cancelled on originating node                            */
/*----------------------------------------------------------------------------*/
: Job__Cancelled_rcv ( -- )

  >>am <SEED_RCV>

  job::this locals| pJob__Cancelled |
  pJob__Cancelled job.id@ locals| iJobId |

  0 locals| pJobOriginator |
  0 0 0 0 locals| bAmDecider error iParticipantNode |

  // ": Job__Cancelled_rcv" .

  // find the job in the originator jobs
  iJobId job::findOriginator to pJobOriginator

  // get the error code from job__executed
  pJob__Cancelled jobCancelled.error@ to error

  // get the participant nodewhere job__begun started
  pJob__Cancelled job.participant@ to iParticipantNode

  // set the error code in pJob
  error iParticipantNode pJobOriginator job.error!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // decrement the acks remaining
  pJobOriginator job.decAcksRemaining to bAmDecider

  // if there are acks remaining just exit
  bAmDecider not if
    delete_completed_job
    <DONE_RCV>
    exit                                                         // *EARLY EXIT*
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is the decider

  //"received Job_Cancelled from all nodes" .

  // remove the job from the originator jobs
  pJobOriginator job.removeOriginator

  // notify the originating task
  pJobOriginator job.originatingTask@ task.ack

  //"All Done" .

  delete_completed_job

  <DONE_RCV>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
