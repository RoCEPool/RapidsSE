"plan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distribute plan to all nodes                                               */
/*----------------------------------------------------------------------------*/
: distPlan allParticipants 1 checkResult ( ??? -- true n# true )

tp: distPlan

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* reap plan on all nodes                                                     */
/*----------------------------------------------------------------------------*/
: reapPlan allParticipants 1 checkResult ( ??? -- true n# true )

tp: reapPlan

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
