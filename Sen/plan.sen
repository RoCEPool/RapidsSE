/*============================================================================*/
/* plan.sen -- plan related words                                             */
/*============================================================================*/

"plan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* unpack job and enque on operator queue                                     */
/*----------------------------------------------------------------------------*/
: enqueOnOp ( <<job>> taskNm -- true )

tp: enqueOnOp

  grid.thisNodeName@ .
  task.this task.name@ .

  locals| op.task | ( <<job>> )

  //valset> ( << ..job.. >> )
  op.task .

  // find task and put job onto its jobQueue
  op.task find execute >jobQueue

  true
;

/*----------------------------------------------------------------------------*/
/* add call to enque job on operator queue                                    */
/*----------------------------------------------------------------------------*/
: addEnqueOnOp ( valset taskNm -- valset )

tp: addEnqueOnOp

  "enqueOnOp" ( valset taskNm "enqueOnOp" )
  stk
  tp: addingEnqueOnOp

  >> ( valset )
;

/*----------------------------------------------------------------------------*/
/* pipe to job queue on same node                                             */
/*----------------------------------------------------------------------------*/
: >>jobQueue_sameNode ( << [ rb true | false ] profile planId op.task -- )

  "same node" .

  locals| op.task | ( << [ rb true | false ] profile planId )

  // convert job to valset
  >>

  // find task and put onto it's job queue

  op.task find execute >jobQueue
;

/*----------------------------------------------------------------------------*/
/* pipe to job queue on other node                                            */
/*----------------------------------------------------------------------------*/
: >>jobQueue_otherNode ( << [ rb true | false ] profile planId op.task nodeNo -- )

tp: >>jobQueue_otherNode
  "other node" .

  locals| nodeNo op.task | ( << [ rb true | false ] profile plan )

  nodeNo "jobQueue_otherNode NODE %V" str.format .

  // translate plan to planId
  //plan.id@ ( << [ rb true | false ] profile planId )

  // convert job to valset
  >>

  // add enqueOnOp which has op.task as a parameter
  op.task addEnqueOnOp ( <<call>> )

  // get sender task
  nodeNo senderTasks @ ( <<call>> task )

  // put on senders job queue
  >jobQueue
;

/*----------------------------------------------------------------------------*/
/* network aware pipe                                                         */
/*----------------------------------------------------------------------------*/
: >>jobQueue ( << [ rb true | false ] profile planId op.task -- )

  // << false profile plan op.task

  // record the op.task
  locals| op.task | ( << [ rb true | false ] profile planId )

  // partition
  0 0 "" locals| profile partitionId nodeNo |

  // the profile contains partition information
  over to profile

  profile str.tailInt
  if
    // profile has a #partitionId

    to partitionId
    partitionId grid::toNode to nodeNo

    nodeNo partitionId profile "Profile %v: partition %v on node %v" str.format .

    nodeNo grid.thisNode@ ==
    if
      op.task >>jobQueue_sameNode
    else
      op.task nodeNo >>jobQueue_otherNode
    then

    else
    // profile is # only

    profile "Profile %v: on originating node" str.format .

    grid.thisNode@ 0==
    if
      op.task >>jobQueue_sameNode
    else
      op.task >>jobQueue_otherNode
    then

  then
;

/*----------------------------------------------------------------------------*/
/* compile the plan                                                           */
/*----------------------------------------------------------------------------*/
: compilePlan ( plan -- )

  dup task.this task.plan!

  dup ( plan plan )

  plan.dic task.this task.dicStack dicPath.push ( plan )
  pathDump
  plan.lambda@ dup . >:
  task.this task.dicStack dicPath.drop

  0 task.this task.plan!
;

/*----------------------------------------------------------------------------*/
/* execute the plan                                                           */
/*----------------------------------------------------------------------------*/
: executePlan ( plan -- )

  // record the plan and profile
  locals| thePlan profile |

  // trigger triggerOp by piping the plan to it
  //<< "triggerOp" thePlan >>
  //"triggerOp.task" find execute >jobQueue

  << "triggerOp" thePlan plan.id@ "triggerOp.task" >>jobQueue
;

/*----------------------------------------------------------------------------*/
/* distribute plan (multi-node version)                                       */
/*----------------------------------------------------------------------------*/
: distributePlan allParticipants 1 checkResult ( plan -- true n# true )

tp: distributePlan

  locals| thePlan |

  // add plan to plan list
  thePlan planList::addPlan

tp: distPlanDone

  "NODE %V" grid.thisNodeName@ str.format .

  planList::show

  // compile the plan
  thePlan compilePlan

tp: cplPlanDone

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* reap plan on all nodes                                                     */
/*----------------------------------------------------------------------------*/
: reapPlan allParticipants 1 checkResult ( ??? -- true n# true )

tp: reapPlan

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
