/*============================================================================*/
/* job_Start.sen -- Start System                                              */
/*============================================================================*/

" job_Start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* start alarm                                                                */
/*----------------------------------------------------------------------------*/
: start_alarm ( -- )

  "start_alarm" .verbose

  spawn_Alarm
;

/*----------------------------------------------------------------------------*/
/* start periodic                                                             */
/*----------------------------------------------------------------------------*/
: start_periodic ( -- )

  "start_periodic" .verbose

  spawn_Periodic
;

/*----------------------------------------------------------------------------*/
/* start socket tasks                                                         */
/*----------------------------------------------------------------------------*/
: start_sockets ( -- )

  "start_sockets" .verbose

  spawn_Answer
;

/*----------------------------------------------------------------------------*/
/* start supervisor                                                           */
/*----------------------------------------------------------------------------*/
: start_supervisor ( -- )

  "start_supervisor" .verbose

  spawn_Supervisor
;

/*----------------------------------------------------------------------------*/
/* start waker                                                                */
/*----------------------------------------------------------------------------*/
: start_waker ( -- )

  "start_waker" .verbose

  spawn_Waker
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  >>am <SEED_RUN>

  task::this           locals| pThisTask |
  pThisTask task.job@  locals| pThisJob  |

  "start_run" .verbose

  snooze start_supervisor
  snooze start_sockets
  snooze start_periodic
  snooze start_waker

  nullptr pThisTask task.job!

  pThisJob job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
