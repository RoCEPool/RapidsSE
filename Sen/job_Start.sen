/*============================================================================*/
/* job_Start.sen -- Start System                                              */
/*============================================================================*/

" job_Start.sen" .verbose


/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  >>logEntry <SEED_RUN>

  nullptr locals| pParentJob |

  "start_run" .verbose

  //supervisor ;&
  periodic ;&
  snooze waker::spawn

  answer ;&
  connector ;&

  //service egArgA egArgB egArgC ;&

  "end start_run" .verbose

  <DONE_RUN>
  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
