/*============================================================================*/
/* job_Start.sen -- Start System                                              */
/*============================================================================*/

" job_Start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* start alarm                                                                */
/*----------------------------------------------------------------------------*/
: start_alarm ( -- )

  "start_alarm" .verbose

  spawn_Alarm
;

/*----------------------------------------------------------------------------*/
/* start answer                                                               */
/*----------------------------------------------------------------------------*/
: start_answer ( -- )

  "start_answer" .verbose

  spawn_Answer
;

/*----------------------------------------------------------------------------*/
/* start connector                                                            */
/*----------------------------------------------------------------------------*/
: start_connector ( -- )

  "start_connector" .verbose

  spawn_Connector
;

/*----------------------------------------------------------------------------*/
/* start periodic                                                             */
/*----------------------------------------------------------------------------*/
: start_periodic ( -- )

  "start_periodic" .verbose

  spawn_Periodic
;

/*----------------------------------------------------------------------------*/
/* start supervisor                                                           */
/*----------------------------------------------------------------------------*/
: start_supervisor ( -- )

  "start_supervisor" .verbose

  spawn_Supervisor
;

/*----------------------------------------------------------------------------*/
/* start waker                                                                */
/*----------------------------------------------------------------------------*/
: start_waker ( -- )

  "start_waker" .verbose

  spawn_Waker
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  >>logEntry <SEED_RUN>

  task::this           locals| pThisTask |
  pThisTask task.job@  locals| pThisJob  |

  "start_run" .verbose

  snooze start_supervisor
  snooze start_periodic
  snooze start_waker

  snooze start_answer
  snooze start_connector


  nullptr pThisTask task.job!

  pThisJob job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
