/*============================================================================*/
/* job_Start.sen -- Start System                                              */
/*============================================================================*/

" job_Start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* start periodic                                                             */
/*----------------------------------------------------------------------------*/
: start_periodic ( -- )

  "start_periodic" .verbose

  spawn_Periodic
;

/*----------------------------------------------------------------------------*/
/* start socket tasks                                                         */
/*----------------------------------------------------------------------------*/
: start_sockets ( -- )

  "start_sockets" .verbose

  spawn_Answer
;

/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  >>am <SEED_RUN>

  task::this           locals| pThisTask |
  pThisTask task.job@  locals| pThisJob  |

  "start_run" .verbose

  snooze start_sockets
  //snooze start_periodic

  nullptr pThisTask task.job!

  pThisJob job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
