/*============================================================================*/
/* job_Start.sen -- Start System                                              */
/*============================================================================*/

" job_Start.sen" .verbose


/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  >>logEntry <SEED_RUN>

  task::this           locals| pThisTask |
  pThisTask task.job@  locals| pThisJob  |

  "start_run" .verbose

  snooze supervisor::spawn
  snooze periodic::spawn
  snooze waker::spawn

  snooze answer::spawn
  snooze connector::spawn


  //nullptr pThisTask task.job!

  //pThisJob job.delete


  job::completed
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
