/*============================================================================*/
/* se_vortex.sen -- parse the .hpp files                                      */
/*============================================================================*/

"-se_vortex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* process all files in the ../Source dir                                     */
/*----------------------------------------------------------------------------*/
: vortex_ProcessDir ( pSeSourceDir -- )

  params| pSeSourceDir |

  vortex::new locals| pVortex |

  "/tmp/vortex.txt" pVortex vortex.open assert

  // read thru directory
  begin pSeSourceDir dir.read while

    // ignore entries which aren't regular files
    pSeSourceDir dir.entryType DE_REG == not continue

    // ignore entries which aren't .sen files
    4 pSeSourceDir dir.entryName str.right ".hpp" str.equal if

      //pSeSourceDir dir.entryName .

      pSeSourceDir dir.entryName pVortex vortex.processHpp

    else
    2 pSeSourceDir dir.entryName str.right ".h" str.equal if

      //pSeSourceDir dir.entryName .

      pSeSourceDir dir.entryName pVortex vortex.processH
    then then

  repeat

  pVortex vortex.close
  pVortex vortex.delete
;

/*----------------------------------------------------------------------------*/
/* munge all .hpp files                                                       */
/*----------------------------------------------------------------------------*/
: vortex prompt

  // create a directory accessor
  dir::new locals| pSeSourceDir |

  // save original dir and change to ../Sen
  dir::getCurrent locals| pOrigDir |

  // change to source director
  "../Source" dir::changeCurrent
  dir::getCurrent "Current working directory now: %v" fmt.print

  // open directory accessor
  "." pSeSourceDir dir.open assert

  "..vortex.." .

  pSeSourceDir vortex_ProcessDir

  // close and delete directory accessor
  pSeSourceDir dir.close
  pSeSourceDir dir.delete


  // change back to original dir
  pOrigDir dir::changeCurrent
  dir::getCurrent "Current working directory now: %v" fmt.print

  "Vortexed" .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
