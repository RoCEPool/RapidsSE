/*============================================================================*/
/* OP_truncate.sen -- Operator truncate                                       */
/*============================================================================*/

" OP_truncate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: TruncateOp_PulseMarker \handler


  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  //Operand[].newStreamDef
  //Operand[].pipeOut

  // truncate the buffers of the tablePtn
  tablePtn[].truncate
/*
  Subset[]@ to Operand[]
  begin
    Operand[].isNull
  not while
    Operand[].pipeOut
    Subset[].nextBuffer to Operand[]
  repeat
*/
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: TruncateOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
  else

    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
    Pipein[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for TruncateOp req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : TruncateOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: TruncateOp_PulseMarker ZK_PULSEMARKER op[].handler!
  find: TruncateOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: truncateOp :: truncateOp <tableNm> ;

: truncateOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc>  = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
