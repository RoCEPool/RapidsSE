/*============================================================================*/
/* job_DumpIndex.sen -- Job Dump Table                                        */
/*============================================================================*/

" job_DumpIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkDumpIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  folder[].checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushTableFolder assert

  sTableNm name::checkIsTable not if path[].discardTableFolder false exit then
  //sTableNm tableInUse if path[].discardTableFolder EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexesFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm name::checkIsIndex not if
    path[].discardIndexesFolder
    path[].discardTableFolder
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  path[].discardIndexesFolder
  path[].discardTableFolder

  // assert in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* dump index request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: dumpIndex_req ( -- <R> )

  LogEntry SEED_REQ

  0 0 0 0 0 locals| pTask pIndex sTableNm sIndexNm pJob_DumpIndex |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task[] to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_DumpIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  //pJob_DumpIndex job.indexName@ to sIndexNm
  //pJob_DumpIndex job.objectName@ to sTableNm
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //check if we can dump the index
  sTableNm sIndexNm checkDumpIndex not if pJob_DumpIndex ERROR_REQUEST !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table and indexes folder
  sTableNm path[].pushTableFolder assert
  path[].pushIndexesFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize
  sIndexNm find execute index.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  path[].discardIndexesFolder
  path[].discardTableFolder

  pJob_DumpIndex job.notice

  LogExit DONE_REQ
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: dumpIndex :: dumpIndex <tableNm> <indexNm> ;
jobSyntax: dumpIndex :: dumpIdx <tableNm> <indexNm> ;

jobInfo: dumpIndex
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_JOB_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
