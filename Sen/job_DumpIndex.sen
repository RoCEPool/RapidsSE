/*============================================================================*/
/* job_DumpIndex.sen -- Job Dump Table                                        */
/*============================================================================*/

" job_DumpIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkDumpIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* dump index request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: dumpIndex_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 0 0 0 locals| pTask pIndex sTableNm sIndexNm pJob_DumpIndex |

  tp: dumpIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_DumpIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_DUMPINDEX pJob_DumpIndex object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_DumpIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  pJob_DumpIndex job.indexName@ to sIndexNm
  pJob_DumpIndex job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //check if we can dump the index
  sTableNm sIndexNm checkDumpIndex not if pJob_DumpIndex <ERROR_REQUEST> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table and indexes folder
  sTableNm pushTable assert
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize
  sIndexNm find execute index.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  pJob_DumpIndex job.notice

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DumpIndex job check resources                                  */
/*----------------------------------------------------------------------------*/
: dumpIndex.checkResources ( Job_DumpIndex -- )

  params| pJob_DumpIndex  |
  0 0 locals| sIndexNm sTableNm |

  tp: dumpIndex.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_DumpIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get index and table name
  pJob_DumpIndex job.indexName@ to sIndexNm
  pJob_DumpIndex job.objectName@ to sTableNm

  sTableNm sIndexNm checkDumpIndex not if pJob_DumpIndex <ERROR_JOB> !!am exit then

  ddlLock::dropWrite
;

/*----------------------------------------------------------------------------*/
/* execute Job_DumpIndexTable job release resources                           */
/*----------------------------------------------------------------------------*/
: dumpIndex.releaseResources ( Job_DumpIndex -- )

  params| pJob_DumpIndex  |

  tp: dumpIndex.releaseResources
  //releaseResources received" .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
