/*============================================================================*/
/* requests_folder.sen -- the set of folder related requests                  */
/*============================================================================*/

"requests_folder.sen" .verbose

/*----------------------------------------------------------------------------*/
/* remove a folder                                                            */
/*----------------------------------------------------------------------------*/
: removeFolder allParticipants 1 checkResult ( "<folderNm>" -- true n# true )

tp: removeFolder

  :forget

  true <SUCCESS_RESULT>
;

/////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* change folder to given folder name                                         */
/*----------------------------------------------------------------------------*/
: cf ( "<sFolderNm>" -- R )

  locals| sFolderNm |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test for a ".." which will go up one folder

  // pop up one folder, but not into tenants
  sFolderNm ".." str.equal if
    0 pathPick dic.name "tenants" str.equal not if pathDrop then
    //"After cf .." . PATHDUMP
    <OK>
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test for a "~" will pop folder path till it reaches /tenants

  // pop up to tenants
  sFolderNm "~" str.equal if
    begin 0 pathPick dic.name "tenants" str.equal not while pathDrop repeat
    //"After cf ~" . PATHDUMP
    <OK>
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test for a "tenants" will clear folder path and set to /tenants

  // clear dic path and push tenants
  sFolderNm "tenants" str.equal if
    //begin 0 pathPick dic.name "<main>" str.equal not while pathDrop repeat
    pathDropAll
    sFolderNm checkIsWord not if <NIP+ERROR> exit then
    execute pathPush
    //"After cf tenants" . PATHDUMP
   <OK>
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // otherwise we expect a name of a sub -folder to which we push path to

  // push sub-folder
  sFolderNm findInCurrent
  checkIsDic not if <NIP+ERROR> exit then
  execute pathPush
  //"After cf <dicNm>" . PATHDUMP
  <OK>
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable folder                                        */
/*----------------------------------------------------------------------------*/
: checkRemoveFolder ( "<folderNm>" -- "<folderNm>" true | "<folderNm>" errorCode false )

  dup ( "<folderNm>" "<folderNm>" )

  checkIsWord     not if false exit then ( "<folderNm>" word )
  checkIsEmpty    not if false exit then ( "<folderNm>" word )
  checkNotUsed    not if false exit then ( "<folderNm>" word )

  drop ( "<folderNm>" )

  true ( "<folderNm>" true )
;


/*----------------------------------------------------------------------------*/
/* remove a folder                                                            */
/*----------------------------------------------------------------------------*/
: remove_folder ( "<folderNm>" -- <R> )

tp: dropDic

ddlLock::grabWrite

  checkRemoveFolder not if <NIP+ERROR> exit then

  removeFolder ( ) assert::stack_0

tp: droppedDic

  <OK>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf

  0 locals| iCount |

  args.metadata if
    "(name VARCHAR, type VARCHAR)" metadata!
    ""
    0 pathPick dic.lastWord dup iterate
    //dup str.length if "\n" str.cat then
    1 iCount + to iCount
    "row: ('" str.cat

    object@ word.name str.cat

    "', " str.cat

    object@ isTable if
      "'table'" str.cat
      //object@ execute table.space bytes.magnitude str.cat
    then

    object@ isIndex if
      "'index'" str.cat
      //object@ execute table.space bytes.magnitude str.cat
    then

    object@ isFolder if
      "'" str.cat
      object@ execute dic.kind@ word.name str.cat
      "'" str.cat
    then

    iCount if
      ")\n" str.cat
    then

    object@ word.prev object!

    next
    iCount task::this task.seitf@ seitf.rowsProcessed
  else
    ""
    0 pathPick dic.lastWord dup iterate

      dup str.length if "\n" str.cat then

      object@ word.name 12 str.pad str.cat
      1 iCount + to iCount
      "(" str.cat

      object@ isTable if
        "table " str.cat
        //object@ execute table.space bytes.magnitude str.cat
      then

      object@ isIndex if
        "index" str.cat
        //object@ execute table.space bytes.magnitude str.cat
      then

      object@ isFolder if
        object@ execute dic.kind@ word.name str.cat
      then

      object@ word.prev object!

    next
    iCount if
      ")" str.cat
    then
  then

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: ~lf ( )

tp: lfOnAll

  // set indirect call to be lf_
  << "lf_"

  tp: theIndirectCall

  >> ( valset )

  >>allParticipants> ( bool )

tp: lfOnAllDone

  checkResult
;

/*----------------------------------------------------------------------------*/
/* list folder contents across the grid                                       */
/*----------------------------------------------------------------------------*/
: lfG

  ~lf

  <OK>
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf$ ( )

tp: lf

  "LISTING FOLDER on NODE " grid.thisNode@ >str str.cat .

  ""
  0 pathPick dic.lastWord dup iterate

  dup str.length if "\n" str.cat then

  object@ word.name 12 str.pad str.cat

  "(" str.cat

  object@ isTable if
  "table " str.cat
  object@ execute table.space bytes.magnitude str.cat
  then

  object@ isFolder if
  object@ execute dic.kind@ word.name str.cat
  then

  ")" str.cat

  object@ word.prev object!

  next

  .

  //drop ( "<tenantNm>" )

  true ( true )
;

/*----------------------------------------------------------------------------*/
/* list folder contents                                                       */
/*----------------------------------------------------------------------------*/
: lf_ (  #folders -- true )

  depth 0 != if
    "dicPath.set" str.equal
    if
  tp: settingDicStack
    !indirect drop
    then
  then

  lf$
;

/*----------------------------------------------------------------------------*/
/* print working folder                                                       */
/*----------------------------------------------------------------------------*/

: pwf

  args.metadata if
    "(path VARCHAR)" metadata!
    "row: ('/"
    pathDepth 0 do
    pathDepth 1 - I -
    pathPick dic.name str.cat
    "/" str.cat
    loop
    "')\n" str.cat
    1 task::this task.seitf@ seitf.rowsProcessed
  else
    "/"
    pathDepth 0 do
    pathDepth 1 - I -
    pathPick dic.name str.cat
    "/" str.cat
    loop
  then

  <SUCCESS>
;

/////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* create /tenants/boray/catalogs/rapidsse                                    */
/*----------------------------------------------------------------------------*/
: createDefaultFolders localCalls ( )

  assert::stack_0

  // push tenants folder
  "tenants" find execute
  pathPush

    // create tenant boray (and catalogs sub-folder)
    "boray" makeTenant drop drop drop

    // push boray folder
    "boray" findInCurrent execute
    pathPush

      // push catalogs folder
      "catalogs" findInCurrent execute
      pathPush

        // create catalog rapidsse (and schemas sub-folder)
        "rapidsse" makeCatalog drop drop drop

          // push rapidsse folder
          "rapidsse" findInCurrent execute
          pathPush

          // push schemas folder
          "schemas" findInCurrent execute
          pathPush

          // create schema public (and tables sub-folder)
          "public" makeSchema drop drop drop

          pathDrop
      pathDrop
    pathDrop
  pathDrop

  assert::stack_0
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
