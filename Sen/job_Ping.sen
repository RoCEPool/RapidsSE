/*============================================================================*/
/* job_Ping.sen -- Job Ping                                                   */
/*============================================================================*/

" job_Ping.sen" .verbose

/*----------------------------------------------------------------------------*/
/* ping requests (on originating node)                                        */
/*----------------------------------------------------------------------------*/
: ping_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 0 locals| iCount pJob_Ping pTask |

  tp: ping_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  "ping sleeps" .
  1 thread.sleep_s
  "ping wakes" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_Ping

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the metadata
  args.metadata if
    "(string VARCHAR)" pJob_Ping job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set response in job
  "row: ( 'pong' )\n" pJob_Ping job.response!
  iCount pJob_Ping job.rowsProcessed!

  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
