/*============================================================================*/
/* job_Ping.sen -- Job Ping                                                   */
/*============================================================================*/

" job_Ping.sen" .verbose

/*----------------------------------------------------------------------------*/
/* ping requests (on originating node)                                        */
/*----------------------------------------------------------------------------*/
: ping_req ( -- <R> )

  >>logEntry <SEED_REQ2>

  0 0 locals| pJob_Ping pTask |

  tp: ping_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  "ping sleeps" .
  1 thread::sleepSsec
  "ping wakes" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_Ping

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the metadata
  args.metadata if
    "(string VARCHAR)" pJob_Ping job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set response in job
  "row: ( 'pong' )\n" pJob_Ping job.response!
  1 pJob_Ping job.rowsProcessed!

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: ping :: ping ;

jobInfo: ping
{
  jobKind  = JK_LOCAL
  rspKind  = RS_LOCAL_ROWS
  ddlLock  = DL_GRAB_READ
  
  preCheck = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
