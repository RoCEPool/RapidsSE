/*============================================================================*/
/* r35ConnectorTask.sen -- R35 connector task                                 */
/*============================================================================*/

"r35ConnectorTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the connector task                                                   */
/*----------------------------------------------------------------------------*/
: spawnR35ConnectorTask

  0 "r35connectorLoop" "ConnectorDrone" TK_CONNECTOR_DRONE spawnR35GeneralTask
;

/*----------------------------------------------------------------------------*/
/* connector loop                                                             */
/*----------------------------------------------------------------------------*/
: r35connectorLoop

  0 locals| pSocket |

  connectorDronePrint if
    task::this task.name@ " running..." str.cat .
  then

  grid::nodes 0 do

    I grid.thisNode@ == if

      nullptr I senderQueues !
      nullptr I senderTasks  !

    else

      I grid.node     ( ^node )
      dup             ( ^node ^node )
      node.port swap  ( port ^node )
      node.IP         ( port IP )

      socket::open socket.connect to pSocket

      args.verbose if
        "Node" grid.thisNode@ >str str.cat
        " connected to node" str.cat
        I >str str.cat
        .
      then

      // set the socket in the grid
      pSocket I grid.socket!

      // start sender
      //"starting sender" .
/*
      ddlLock::grabWrite

      // set up the seed
      1 "senderLoop" ( socket 1 "senderLoop" )

      // create the actor
      "sr" I >str str.cat :createWorkerActor ( socket 1 "senderLoop" "srI" )

      // record the senderQueue
      dup findActorQueue I senderQueues ! ( socket 1 "senderLoop" "srI" )
      dup findActorTask  I senderTasks  ! ( socket 1 "senderLoop" "srI" )

      // spawn the actors os thread
      spawnWorkerActor

      ddlLock::dropWrite
*/
    then

  loop

  // set grid as started
  true grid.started!
  grid.thisNodeName@ "Node %v : SE cluster started" str.format .

  //1000000 thread.sleep_s

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
