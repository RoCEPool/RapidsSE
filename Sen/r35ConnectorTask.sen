/*============================================================================*/
/* r35ConnectorTask.sen -- R35 connector task                                 */
/*============================================================================*/

"r35ConnectorTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn the connector task                                                   */
/*----------------------------------------------------------------------------*/
: spawnR35ConnectorTask

    0                    // no. of args
    "r35connectorLoop"   // seed word
    "ConnectorTask"      // task name
    TK_CONNECTOR_DRONE   // task kind
  spawnR35GeneralTask
;

/*----------------------------------------------------------------------------*/
/* connector loop                                                             */
/*----------------------------------------------------------------------------*/
: r35connectorLoop

  0 locals| pNode |
  0 locals| pSocket |

  connectorDronePrint if
    task::this task.name@ " running..." str.cat .
  then

  grid::nodes 0
  do

    // get the node
    I grid::node to pNode

    // get the nodes port and IP address
    pNode node.port ( port ^node )
    pNode node.IP   ( port IP )

    // connect to that node
    socket::open socket.connect to pSocket

    // set the socket in the node
    pSocket pNode node.socket!

    // print connection message
    args.verbose if
      grid::thisNode@ I "Node%v connected to node%v" str.format .
    then

  loop

  // set grid as started
  true grid::started!

  // print started message
  grid::thisNodeName@ "Node %v : SE cluster started" str.format .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
