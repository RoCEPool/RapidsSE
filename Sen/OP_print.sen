/*============================================================================*/
/* OP_print.sen -- Operator print                                             */
/*============================================================================*/

" OP_print.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: printOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut
  <string> .

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: printOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  Pipein[].pipeOut

  true
;


/*----------------------------------------------------------------------------*/
/* printnOp request                                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: printOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: printOp_PulseMarker ZK_PULSEMARKER op[].handler!
  find: printOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: printOp :: printOp <string> ;

: printOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
