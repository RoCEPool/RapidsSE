/*============================================================================*/
/* OP_print.sen -- Operator print                                             */
/*============================================================================*/

" OP_print.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: print_DataMarker \handler

  //"Operand:- ZK_DATAPULSE" .verbose
  PipeIn[].pipeOut
  <string> .

  true
;

/*----------------------------------------------------------------------------*/
/* printn request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: print_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: print_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: print :: print <string> ;

: print _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
