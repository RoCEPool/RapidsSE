/*============================================================================*/
/* OP_print.sen -- Operator print                                             */
/*============================================================================*/

" OP_print.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: print_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut
  <string> .

  true
;

/*----------------------------------------------------------------------------*/
/* printn request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: print_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: print_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: print :: print <string> ;

: print _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--cmd desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
