/*============================================================================*/
/* OP_dumpTable.sen -- Operator dump table                                    */
/*============================================================================*/

" OP_dumpTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: dumpTbl_action

  <tableNm> op__table if
    table[].dump
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dumpTbl :: dumpTbl <tableNm> ;

: dumpTbl _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
