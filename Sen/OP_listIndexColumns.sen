/*============================================================================*/
/* OP_listIndexColumns.sen -- Operator list index columns                             */
/*============================================================================*/

" OP_listIndexColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsidxcol_action

  0 locals| iColumns |

  // find the table
  <tableNm> <indexNm> op__table_index not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // get no of columns in the index
  index[].columnCount@ to iColumns

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the infoSet for each index column
  iColumns 0 do
    I index[].column@
    streamSetTable[] StreamSet[].addColumnDef  not if
      StreamSet[].pipeout
      streamSetTable[] streamSet[].new
      I index[].column@
      streamSetTable[] StreamSet[].addColumnDef assert
    then
  loop

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsidxcol :: lsidxcol <tableNm> <indexNm> ;

: lsidxcol _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--cmd desc for op--"
    <localLiteOp> = true
    <streamDef>   = __listColumns
    <params>      = 2
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
