/*============================================================================*/
/* test_encodingData.sen -- generate encoding tests data                      */
/*============================================================================*/

" test_encodingData.sen" .verbose

/*----------------------------------------------------------------------------*/
/* generate integer data file                                                 */
/*----------------------------------------------------------------------------*/
: integerDataFile

  params| nRecs |
  params| sFileNm |

  nRecs sFileNm "File: %v nRecs %v" fmt.print

  file::new locals| pFile |

  sFileNm OPEN_WRITE pFile file.open
  not if
    "file not opened" .
    exit
  then

  nRecs 0 > if
    nRecs 0
    do
      //I I "%v,String%v" str.format .
      I I 10 +  I 20 + I 30 + "%v,%v,%v,%v\n" str.format pFile file.write
    loop
  then

  pFile file.close

  pFile file.delete
;

/*----------------------------------------------------------------------------*/
/* generate the i data files                                                  */
/*----------------------------------------------------------------------------*/
: integerData

  "../DATA/Encoding/integer.csv"    100      integerDataFile

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
