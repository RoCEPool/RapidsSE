/*============================================================================*/
/* OP_consume.sen -- Operator consume                                         */
/*============================================================================*/

" OP_consume.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: consumeOp_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose
  xmits[].handleCancel if
    PipeIn[].pipeOut
    Op.ackPipelineJob
    false
  else
    PipeIn[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  xmits[].handleEos if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;
/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
/*
: consumeOp_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  xmits[].handleError if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;
*/

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_DataPulse \handler

  //"Operand:- ZK_DATAPULSE" .verbose
  xmits[].handlePulse if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

