/* handler for ZK_DESTROYMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: consumeOp_DESTROYMARKER \handler

  //"Operand:- ZK_DESTROYMARKER" .verbose
  xmits[].handleDestroy if
    PipeIn[].pipeOut
  else
