/*============================================================================*/
/* OP_consume.sen -- Operator consume                                         */
/*============================================================================*/

" OP_consume.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for consumeOp req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: consumeOp_req \operator

  LogReqEntry SEED_REQ

  <consumeXmits> >int to Counter0[]

  0 0 0 0 locals| start pulse pulsed def |
  Counter0[] Counter0[] locals| exit eos |

  <consumeXmits> >int op.leftEosMarkers!

  // set topology, next stage and op
  op__topology

  begin

    // bide till next operand is available
    Pipein[].bide

    // pop next operand from queue into Operand[]
    Pipein[].next

      // decode kind
      Pipein[].kind case

      ZK_CANCELMARKER of
        "CONSUMEOP: Operand:- ZK_CANCELMARKER" .verbose
        exit 1 - to exit
        exit 0 == if
          Pipein[].pipeOut
          Op.ackPipelineJob
          false
        else
          Pipein[].delete
        true
        then

        exit Counter0[] > if
        Counter0[] Counter0[] exit - "Warning: ConsumeOp ZK_CANCELMARKER received %v; expected %v" str.format .
        then

      endof

        ZK_EOSMARKER of
          //"Operand:- ZK_EOSMARKER" .verbose
          eos 1 - to eos
          eos 0 == if
            Counter0[] to eos
            Pipein[].pipeOut
          else
            Counter0[] to eos
            Pipein[].delete
          then

          true
        endof

        ZK_ERRORMARKER of
          //"Operand:- ZK_ERRORMARKER" .verbose
          eos 1 - to eos
          eos 0 == if
            Counter0[] to eos
            Pipein[].pipeOut
          else
            Pipein[].delete
          then

          true
        endof

        ZK_PULSEMARKER of
          //"Operand:- ZK_PULSEMARKER" .verbose
          pulse 0 == if
            Pipein[].pipeOut
          else
            Pipein[].delete
          then
          pulse 1 + to pulse
          // reset pulse to allow fow periodic pulses to come
          pulse Counter0[] == if
            0 to pulse
          then
          true
        endof

      ZK_PULSEDMARKER of
        //"Operand:- ZK_PULSEDMARKER" .verbose
        pulsed 0 == if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
          pulsed 1 + to pulsed
        true
      endof

        ZK_STARTMARKER of
          //"Operand:- ZK_STARTMARKER" .verbose
          // pipeout first STARTMARKER
          start 0 == if
            Pipein[].pipeOut
          else
            // drop other STARTMARKERS
            Pipein[].delete
          then
          start 1 + to start
          start Counter0[] > if
            start .
            Counter0[] start "Warning: ConsumeOp ZK_STARTMARKER received %v; expected %v" str.format .
          then
          true
        endof

        ZK_EXITMARKER of
        //"Operand:- ZK_EXITMARKER" .verbose
        exit 1 - to exit
        exit 0 == if
          Pipein[].pipeOut
          Op.ackPipelineJob
          false
        else
          Pipein[].delete
          true
        then

        exit Counter0[] > if
          Counter0[] Counter0[] exit - "Warning: ConsumeOp ZK_EXITMARKER received %v; expected %v" str.format .
        then

        endof

        ZK_STREAMDEF of
          //"Operand:- ZK_STREAMDEF" .verbose
          def 0 == if
            Pipein[].pipeOut
          else
            Pipein[].delete
          then
          def 1 + to def
          true
        endof

        // handle other operand as generic operands
        jobOperand::generic
        swap

      endcase

  while assert::stack_0 repeat

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: ConsumeOp :: ConsumeOp <consumeXmits> ;

: ConsumeOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
