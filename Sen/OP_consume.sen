/*============================================================================*/
/* OP_consume.sen -- Operator consume                                         */
/*============================================================================*/

" OP_consume.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for consumeOp req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: consumeOp_req ( -- )

  >>logEntry <SEED_REQ>

  <consumeXmits> locals| xmits |

  0 0 0 locals| start pulse def |
  xmits xmits locals| stop eos |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  <consumeXmits> op.leftEosMarkers!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

      // decode kind
      Operand[].kind case

        ZK_EOSMARKER of
          //"Operand:- ZK_EOSMARKER" .verbose
          eos 1 - to eos
          eos 0 == if
            xmits to eos
            Operand[].pipeOut
          else
            xmits to eos
            Operand[].delete
          then

          true
        endof

        ZK_ERRORMARKER of
          //"Operand:- ZK_ERRORMARKER" .verbose
          eos 1 - to eos
          eos 0 == if
            xmits to eos
            Operand[].pipeOut
          else
            Operand[].delete
          then

          true
        endof

        ZK_PULSEMARKER of
          //"Operand:- ZK_PULSEMARKER" .verbose
          pulse 0 == if
            Operand[].pipeOut
          else
            Operand[].delete
          then
          pulse 1 + to pulse
          // reset pulse to allow fow periodic pulses to come
          pulse xmits == if
            0 to pulse
          then
          true
        endof

        ZK_STARTMARKER of
          //"Operand:- ZK_STARTMARKER" .verbose
          // pipeout first STARTMARKER
          start 0 == if
            Operand[].pipeOut
          else
            // drop other STARTMARKERS
            Operand[].delete
          then
          start 1 + to start
          start xmits > if
            start .
            xmits start "Warning: ConsumeOp ZK_STARTMARKER received %v; expected %v" str.format .
          then
          true
        endof

        ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        stop 1 - to stop
        stop 0 == if
          Operand[].pipeOut
          Op.ackPipelineJob
          false
        else
          Operand[].delete
          true
        then

        stop xmits > if
          xmits xmits stop - "Warning: ConsumeOp ZK_STOPMARKER received %v; expected %v" str.format .
        then

        endof

        ZK_STREAMDEF of
          //"Operand:- ZK_STREAMDEF" .verbose
          def 0 == if
            Operand[].pipeOut
          else
            Operand[].delete
          then
          def 1 + to def
          true
        endof

        // handle other operand as generic operands
        jobOperand::generic
        swap

      endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ConsumeOp :: ConsumeOp <consumeXmits> <topology> <nextStage> <nextOp> ;

jobInfo: ConsumeOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
