/*============================================================================*/
/* OP_consume.sen -- Operator consume                                         */
/*============================================================================*/

" OP_consume.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: consumeOp_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose
  consumeXmits[].cancel if
    Pipein[].pipeOut
    Op.ackPipelineJob
    consumeXmits[].delete
    false
  else
    Pipein[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  consumeXmits[].eos if
    Pipein[].pipeOut
  else
    Pipein[].delete
  then
  true
;
/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  consumeXmits[].error if
    Pipein[].pipeOut
  else
    Pipein[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: consumeOp_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  consumeXmits[].exit if
    Pipein[].pipeOut
    Op.ackPipelineJob
    consumeXmits[].delete
    false
  else
    Pipein[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  consumeXmits[].pulse if
    Pipein[].pipeOut
  else
    Pipein[].delete
  then
  true
;
/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEDMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_PulsedMarker \handler

  //"Operand:- ZK_PULSEDMARKER" .verbose
  consumeXmits[].pulsed if
    Pipein[].pipeOut
  else
    Pipein[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  consumeXmits[].start if
    Pipein[].pipeOut
  else
    Pipein[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  consumeXmits[].streamDef if
    Pipein[].pipeOut
  else
    Pipein[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* execute for consumeOp req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: consumeOp_req \operator

  LogReqEntry SEED_REQ

  <consumeXmits> >int consumeXmits[].new

  // set topology, next stage and op
  op__topology

  find: consumeOp_CancelMarker ZK_CANCELMARKER op[].handler!
  find: consumeOp_EosMarker    ZK_EOSMARKER    op[].handler!
  find: consumeOp_ErrorMarker  ZK_ERRORMARKER  op[].handler!
  find: consumeOp_ExitMarker   ZK_EXITMARKER   op[].handler!
  find: consumeOp_PulseMarker  ZK_PULSEMARKER  op[].handler!
  find: consumeOp_PulsedMarker ZK_PULSEDMARKER op[].handler!
  find: consumeOp_StartMarker  ZK_STARTMARKER  op[].handler!
  find: consumeOp_StreamDef    ZK_STREAMDEF    op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP

;
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: ConsumeOp :: ConsumeOp <consumeXmits> ;

: ConsumeOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
