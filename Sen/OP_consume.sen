/*============================================================================*/
/* OP_consume.sen -- Operator consume                                         */
/*============================================================================*/

" OP_consume.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for consumeOp req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: consumeOp_req \operator

  LogReqEntry SEED_REQ

  <consumeXmits> >int to Counter0[]

  0 0 0 0 0 0 locals| start pulse pulsed def exit eos |

  <consumeXmits> >int op.leftEosMarkers!
  consumeXmits[].new

  // set topology, next stage and op
  op__topology

  begin

    // bide till next operand is available
    Pipein[].bide

    // pop next operand from queue into Operand[]
    Pipein[].next

    // decode kind
    Pipein[].kind case

      ZK_CANCELMARKER of
        "CONSUMEOP: Operand:- ZK_CANCELMARKER" .verbose
        consumeXmits[].cancel if
          Pipein[].pipeOut
          Op.ackPipelineJob
          consumeXmits[].delete
          false
        else
          Pipein[].delete
          true
        then
/*
        exit 1 + to exit
        exit Counter0[] == if
          Pipein[].pipeOut
          Op.ackPipelineJob
          false
        else
          Pipein[].delete
          true
        then

        exit Counter0[] > if
          Counter0[] exit "Warning: ConsumeOp ZK_CANCELMARKER received %v; expected %v" str.format .
        then
*/
      endof

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        consumeXmits[].eos if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        consumeXmits[].eos if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
        true
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        consumeXmits[].pulse if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
        true
/*
        pulse 0 == if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
        pulse 1 + to pulse

        pulse Counter0[] > if
          Counter0[] start "Warning: ConsumeOp ZK_PULSEMARKER received %v; expected %v" str.format .
        then

        // reset pulse to allow for periodic pulses to come
        pulse Counter0[] == if
          0 to pulse
        then
        true
 */
      endof

      ZK_PULSEDMARKER of
        //"Operand:- ZK_PULSEDMARKER" .verbose
        consumeXmits[].pulsed if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
        true
/*
        pulsed 0 == if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
        pulsed 1 + to pulsed

        pulsed Counter0[] > if
          Counter0[] start "Warning: ConsumeOp ZK_PULSEDMARKER received %v; expected %v" str.format .
        then
        true
 */
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        // pipeout first STARTMARKER
        consumeXmits[].start if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
        true
/*
        start 0 == if
          Pipein[].pipeOut
        else
          Pipein[].delete
        then
        start 1 + to start

        start Counter0[] > if
          Counter0[] start "Warning: ConsumeOp ZK_STARTMARKER received %v; expected %v" str.format .
        then

        true
*/
      endof

      ZK_EXITMARKER of
        //"Operand:- ZK_EXITMARKER" .verbose
        consumeXmits[].exit if
          Pipein[].pipeOut
          Op.ackPipelineJob
          consumeXmits[].delete
          false
        else
          Pipein[].delete
          true
        then
/*
        exit 1 + to exit
        exit Counter0[] == if
          Pipein[].pipeOut
          Op.ackPipelineJob
          false
        else
          Pipein[].delete
          true
        then

        exit Counter0[] > if
          Counter0[] exit "Warning: ConsumeOp ZK_EXITMARKER received %v; expected %v" str.format .
        then
*/
      endof

        ZK_STREAMDEF of
          //"Operand:- ZK_STREAMDEF" .verbose
          consumeXmits[].streamDef if
            Pipein[].pipeOut
          else
            Pipein[].delete
          then
          true
        endof
/*
          def 0 == if
            Pipein[].pipeOut
          else
            Pipein[].delete
          then
          def 1 + to def
          true
        endof

        exit Counter0[] > if
          Counter0[] def "Warning: ConsumeOp ZK_STREAMDEF received %v; expected %v" str.format .
        then
*/
        // handle other operand as generic operands
        jobOperand::generic
        swap

      endcase

  while assert::stack_0 repeat

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: ConsumeOp :: ConsumeOp <consumeXmits> ;

: ConsumeOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
