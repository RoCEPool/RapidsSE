/*============================================================================*/
/* job_EndOp.sen -- Job EndOp                                                 */
/*============================================================================*/

" job_EndOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for endOp request                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: endOp_req ( -- )

  >>logEntry <SEED_REQ>

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .
        Operand[].handleEnd
        false
      endof

      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .
        Operand[].workDone
        Operand[].pipeToJob
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: endOp :: endOp ;

jobInfo: endOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_ENDOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
