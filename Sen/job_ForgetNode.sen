/*============================================================================*/
/* job_ForgetNode.sen -- Job Forget Node                                      */
/*============================================================================*/

" job_ForgetNode.sen" .verbose

/*----------------------------------------------------------------------------*/
/***                              - Words -                                 ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* check resources for forgetNode                (on each participating node) */
/*----------------------------------------------------------------------------*/
: forgetNode::checkResources _std ( -- )

  "forgetNode::checkResources" .

  ddlLock::grabRead

  <nodeNm> grid::findNode not if
    EC_NO_SUCH_NODE job::this job.error! exit
  then
;

/*----------------------------------------------------------------------------*/
/* execute for forgetNode                        (on each participating node) */
/*----------------------------------------------------------------------------*/
: forgetNode::execute _std ( -- )

  "forgetNode::execute" .

  <nodeNm> grid::forgetNode
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: forgetNode :: forget node <nodeNm> ;
jobSyntax: forgetNode :: fgnde <nodeNm> ;

jobInfo: forgetNode
{
  jobKind      = JK_DIST2PC
  responseKind = RS_NODE_ZERO
  
  ddlLock      = DL_GRAB_WRITE
  preCheck     = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
