/*============================================================================*/
/* job_ForgetNode.sen -- Job Create Node                                      */
/*============================================================================*/

" job_ForgetNode.sen" .verbose


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: req_exitHook

  "req_exitHook" .

  r@ locate log::markExit

  <DONE_REQ>
;

: exe_exitHook

  "exe_exitHook" .

  job::this job::participantExecuted

  r@ locate log::markExit

  <DONE_EXE>
;

: beg_exitHook

  "beg_exitHook" .

  job::participantBegun

  r@ locate log::markExit

  <DONE_BEG>
;

: end_exitHook

  "end_exitHook" .

  job::participantEnded

   r@ locate log::markExit

  <DONE_END>
;

: can_exitHook

  "can_exitHook" .

  job::participantCancelled

   r@ locate log::markExit

  <DONE_CAN>
;

: std_exitHook

  "std_exitHook" .

  r@ locate log::markExit
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: _LOCK_EXE_

  "ddlLock" <jobNm> findJobClassEnmSet EnameSet.getStr

  "DL_GRAB_WRITE"
  str.equal if
    //"would grab ddl write lock" .
    ddlLock::grabWrite
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: _PATH_SET_

  job::this job.pushPath task::dicStack.set
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: _req immediate

  word::this word.name@ "_req" str.cat word::this word.name!
  "req_exitHook" word::this word.exitHook!

  POSTPONE <SEED_REQ>

  word::this word.name@ ,
  POSTPONE log::markEntry
;

: _beg immediate

  word::this word.name@ "_beg" str.cat word::this word.name!
  "beg_exitHook" word::this word.exitHook!

  word::this word.name@ ,
  POSTPONE log::markEntry

  POSTPONE <SEED_BEG>
  POSTPONE _PATH_SET_

  // add this job to the participants list
  POSTPONE job::becomeParticipant
;

: _exe immediate

  word::this word.name@ "_exe" str.cat word::this word.name!
  "exe_exitHook" word::this word.exitHook!

  word::this word.name@ ,
    POSTPONE log::markEntry

  POSTPONE <SEED_EXE>
  POSTPONE _LOCK_EXE_
;

: _end immediate

  word::this word.name@ "_end" str.cat word::this word.name!
  "end_exitHook" word::this word.exitHook!

  word::this word.name@ ,
    POSTPONE log::markEntry

  POSTPONE <SEED_END>
;

: _can immediate

  word::this word.name@ "_can" str.cat word::this word.name!
  "can_exitHook" word::this word.exitHook!

  word::this word.name@ ,
    POSTPONE log::markEntry

  POSTPONE <SEED_CAN>
;

: _std immediate

  "std_exitHook" word::this word.exitHook!

  word::this word.name@ ,
  POSTPONE log::markEntry
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

: _req_prep_
;

: _req_post_

  // distribute the job as to all connected node as participants
  job::distribute

  // wait for ack from deciding job__Ended
  task::wait
;

: _exe_prep_
;
: _exe_post_
;
: _beg_prep_
;
: _beg_post_
;
: _end_prep_
;
: _end_post_
;
: _can_prep_
;
: _can_post_
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

jobSyntax: forgetNode_syn CN_JOB_UNIVERSAL
        :: forget node <nodeNm> ;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobClass: forgetNode_cls
{
  jobKind      = JK_DIST2PC
  responseKind = RS_NODE_ZERO
  
  ddlLock      = DL_GRAB_WRITE
  preCheck     = bClusterStarted
}
;



/*----------------------------------------------------------------------------*/
/* check word is a Node                                                       */
/*----------------------------------------------------------------------------*/
: .checkIsNode ( "<NodeNm>" -- t|f )

  grid::findNode if true exit then

  EC_NO_SUCH_NODE false
;

/*----------------------------------------------------------------------------*/
/* check if word is a forgetable Node                                         */
/*----------------------------------------------------------------------------*/
: .checkForgetNode ( "<NodeNm>" -- true | errorCode false )

  .checkIsNode not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* check job resources (on each participating node)                           */
/*----------------------------------------------------------------------------*/
: forgetNode::checkResources _std ( -- )

  <Check_Resources>

  // grab a ddl lock
  ddlLock::grabRead

  //----------------------------------------------------------------------------
  // check if we can forget the Node

  <nodeNm> .checkforgetNode not if
    job::this <ERROR_JOB> !!logError exit
  then

  <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* release job resources (on each participating node)                         */
/*----------------------------------------------------------------------------*/
: forgetNode::releaseResources _std ( -- )

  <Release_Resources>

  <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* request forget node on originating node                                    */
/*----------------------------------------------------------------------------*/
: forgetNode _req
  _req_prep_

  _req_post_
;

/*----------------------------------------------------------------------------*/
/* begin forget node (on each participating node)                             */
/*----------------------------------------------------------------------------*/
: forgetNode _beg ( -- )
  _beg_prep_
    forgetNode::checkResources
  _beg_post_
;

/*----------------------------------------------------------------------------*/
/* execute forget node on each participating node                             */
/*----------------------------------------------------------------------------*/
: forgetNode _exe
  _exe_prep_
    <nodeNm> grid::forgetNode
  _exe_post_
;

/*----------------------------------------------------------------------------*/
/* end forget node (on each participating node)                               */
/*----------------------------------------------------------------------------*/
: forgetNode _end ( -- )
  _end_prep_
    forgetNode::releaseResources
  _end_post_
;

/*----------------------------------------------------------------------------*/
/* cancel forget node (on each participating node)                            */
/*----------------------------------------------------------------------------*/
: forgetNode _can ( -- )
  _can_prep_
    forgetNode::releaseResources
  _can_post_
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
