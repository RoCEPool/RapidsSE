/*============================================================================*/
/* OP_space.sen -- Operator space                                             */
/*============================================================================*/

" OP_space.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: space_action

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] streamSet[].new

  // add nodeInfo to the infoSet
  streamSetTable[] streamSet[].addSpaceInfo assert

  // pipeout the infoset
  streamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: space :: space ;

: space opInfo tagCopy: liteOp_tags
  tags{
    <jobDesc>   = "--description of operator--"
    <liteOp>    = true
    <streamDef> = __space
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
