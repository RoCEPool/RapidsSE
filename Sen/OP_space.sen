/*============================================================================*/
/* OP_space.sen -- Operator space                                             */
/*============================================================================*/

" OP_space.sen" .verbose

/*----------------------------------------------------------------------------*/
/* preliminary setup                                                          */
/*----------------------------------------------------------------------------*/
: space_setup

  job[] job.enameSet@ enameSet.asStr .

  // find the __nodeInfo table
  <streamDef> op__tableDef

  // create a new streamDef
  StreamDef[].new

  true
;

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: space_action

  0 locals| iRowSize |

  // get row size from streamDef
  StreamDef[].rowSize to iRowSize

  // create an infoSet operand
  iRowSize InfoSet[].newInfoSet

  // add nodeInfo to the infoSet
  StreamDef[] InfoSet[].addSpaceInfo assert

  // pipeout the streamDef
  StreamDef[].pipeout

  // pipeout the infoset
  InfoSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: space_PulseMarker \handler
  //"Operand:- ZK_PULSEMARKER" .verbose

  0 locals| iRowSize |

  // pipeout the pulse marker
  Pipein[].pipeout

  space_setup  assert
  space_action assert

  // pipe out a EOS marker
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for space req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : space_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: space_PulseMarker  ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: space :: space ;

: space opInfo tagCopy: liteOp_tags
  tags{
    <jobDesc>   = "--description of operator--"
    <streamDef> = __space
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
