/*============================================================================*/
/* OP_space.sen -- Operator space                                             */
/*============================================================================*/

" OP_space.sen" .verbose

/*----------------------------------------------------------------------------*/
/* preliminary setup                                                          */
/*----------------------------------------------------------------------------*/
//: space_setup
//
//  job[] job.enameSet@ enameSet.asStr .
//
//  // find the __nodeInfo table
//  <streamDef> op__tableDef
//
//  // create a new streamDef
//  StreamDef[].new
//
//  true
//;

/*----------------------------------------------------------------------------*/
/* preliminary setup                                                          */
/*----------------------------------------------------------------------------*/
: __liteOp_SetUp

"
: /liteOp/_setup

  job[] job.enameSet@ enameSet.asStr .

  // find the __ table
  <streamDef> op__tableDef

  // create a new streamDef
  StreamDef[].new

  true
;
"
;
    

"/liteOp/" "space" __liteop_Setup str.replace compile

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: space_action

  0 locals| iRowSize |

  // get row size from streamDef
  StreamDef[].rowSize to iRowSize

  // create an infoSet operand
  iRowSize InfoSet[].newInfoSet

  // add nodeInfo to the infoSet
  StreamDef[] InfoSet[].addSpaceInfo assert

  // pipeout the streamDef
  StreamDef[].pipeout

  // pipeout the infoset
  InfoSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: space_PulseMarker \handler

  Pipein[].pipeout

  space_setup  assert
  space_action assert
 
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
//: __liteOp_PulseMarker
//
//"
//: /liteOp/_PulseMarker \\handler
//
//  Pipein[].pipeout
//
//  /liteOp/_setup  assert
//  /liteOp/_action assert
//
//  Operand[].newEosMarker
//  Operand[].pipeOut
//
//  true
//;
//"
//;

//"/liteOp/" "space" __liteOp_PulseMarker str.replace .
//"/liteOp/" "space" __liteOp_PulseMarker str.replace compile

/*----------------------------------------------------------------------------*/
/* execute for space req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : space_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: space_PulseMarker  ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: space :: space ;

: space opInfo tagCopy: liteOp_tags
  tags{
    <jobDesc>   = "--description of operator--"
    <liteOp>    = true
    <streamDef> = __space
  }
;
    

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

    
    
/*----------------------------------------------------------------------------*/
/* execute for space req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
: __liteOp_req

"
 : /liteOp/_req \\operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: /liteOp/_PulseMarker  ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
"
;


// "/liteOp/" "space" __liteop_Setup       str.replace compile
// "/liteOp/" "space" __liteOp_PulseMarker str.replace .
// "/liteOp/" "space" __liteOp_req         str.replace .

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
