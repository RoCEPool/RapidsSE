/*============================================================================*/
/* job_Periodic.sen -- periodic job                                           */
/*============================================================================*/

" job_Periodic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add peridiodic activity here                                               */
/*----------------------------------------------------------------------------*/
: periodic_activity ( -- )

  "Periodic Activity" .

  args::oscillate
;

/*----------------------------------------------------------------------------*/
/* periodic loop:                                                             */
/*----------------------------------------------------------------------------*/
: periodic_req ( -- )

  std_entryHook

  // "Periodic Job Started" .

  begin

    task::yield

    // "periodic sleeping..." .
    args.periodicSleep task::sleepSsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard

;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: periodic :: periodic ;

jobInfo: periodic
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NONE
  <?ddlLock?>  = DL_NONE
  
  //<?preCheck?> = bClusterStarted
  
  <?cmdKind?>  = CK_SERVICE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
