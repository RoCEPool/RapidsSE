/*============================================================================*/
/* OP_kbase.sen -- kbase testing                                              */
/*============================================================================*/

" OP_kbase.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: kbase_action

  "Kbase Testing" .

  "Kbase-Name" kbase[].new

  kbase[].test

  "/tmp/kbase_test.txt" kbase[].print

  kbase[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  file::new to file0[]

  "/tmp/kbase_test.txt" OPEN_READ file0[] file.open if

    "FILE OPENED" .
    
    begin
      file0[] file.readLine
    while
      .
    repeat

    file0[] file.close

  then

  File0[] file.delete
  nullptr File0[].set

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: kbase :: kbase ;

: kbase _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
