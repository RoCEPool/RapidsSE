/*============================================================================*/
/* OP_kbase.sen -- kbase testing                                              */
/*============================================================================*/

" OP_kbase.sen" .verbose

/*----------------------------------------------------------------------------*/
/* troll the kbase                                                            */
/*----------------------------------------------------------------------------*/
: kbase_troll

  "Trolling..." .
  kbase[].troll
;

/*----------------------------------------------------------------------------*/
/* import the kbase                                                           */
/*----------------------------------------------------------------------------*/
: kbase_import

  tokenVec::new locals| pTknVec |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  file::new to file0[]

  "/tmp/kbase_test.txt" OPEN_READ file0[] file.open if

    "FILE OPENED" .

    file0[] file.path@ file::modTime .
    
    
    begin
      file0[] file.readLine
    while
      dup dup .
      pTknVec tokenVec.tokenise
      pTknVec tokenVec.dump
      >interpret
    repeat

    file0[] file.close

  then

  File0[] file.delete
  nullptr File0[].set

  pTknVec tokenVec::delete

;

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: kbase_action

//  "Kbase Testing" .
//
//  tokenVec::new locals| pTknVec |
//
//  "Kbase-Name" kbase[].new
//
//  kbase[].test
//
//  "/tmp/kbase_test.txt" kbase[].print
//
//  kbase[].delete
//
//  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
//
//  file::new to file0[]
//
//  "/tmp/kbase_test.txt" OPEN_READ file0[] file.open if
//
//    "FILE OPENED" .
//
//    file0[] file.path@ file::modTime .
//
//
//    begin
//      file0[] file.readLine
//    while
//      dup dup .
//      pTknVec tokenVec.tokenise
//      pTknVec tokenVec.dump
//      >interpret
//    repeat
//
//    file0[] file.close
//
//  then
//
//  File0[] file.delete
//  nullptr File0[].set
//
//  pTknVec tokenVec::delete

  0 0 locals| iModTime iPrevTime |

  "Kbase Testing" .

  "Kbase-Name" kbase[].new

  kbase[].test

  "/tmp/kbase_test.txt" kbase[].print

  "/tmp/kbase_test.txt" file::modTime to iPrevTime
  

  begin
    true
  while

    "/tmp/kbase_test.txt" file::modTime to iModTime

    iModTime iPrevTime == if
      100 thread::sleepMsec
    else
      iModTime to iPrevTime
      kbase[].trim

      kbase_import

      kbase_troll

      "/tmp/kbase_test.txt" kbase[].print

      "/tmp/kbase_test.txt" file::modTime to iPrevTime

    then

  repeat


  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: kbase :: kbase ;

: kbase _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
