/*============================================================================*/
/* job_WaitCluster.sen -- Job Wait CLuster                                    */
/*============================================================================*/

" job_WaitCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request to wait for cluster to start (on originating node)                 */
/*----------------------------------------------------------------------------*/
: waitCluster_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: space_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute job_WaitCluster (on participating node)                            */
/*----------------------------------------------------------------------------*/
: waitCluster_exe ( pJob_WaitCluster -- )

  >>am <SEED_EXE>

  //params| pJob_WaitCluster |
  job::this locals| pJob_WaitCluster |

  pJob_WaitCluster job.notice

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait till all nodes connected
  grid::wait

  pJob_WaitCluster send_job__executed

  nullptr task::this task.job!

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: waitCluster_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_WaitCluster |

  pJob_WaitCluster job.beginParticipant

  job::participantBegun

  <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: waitCluster_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_WaitCluster |

  job::participantEnded

  <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: waitCluster_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_WaitCluster |

  job::participantCancelled

  <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

