/*============================================================================*/
/* op__liteOp.sen -- Lite Op Words                                            */
/*============================================================================*/

" op__liteOp.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: __liteOp_PulseMarker

"
: /liteOp/_PulseMarker \\handler

  /liteOp/_action if
    Pipein[].pipeout
    Operand[].newEosMarker
    Operand[].pipeOut
  then

  true
;
"
;

/*----------------------------------------------------------------------------*/
/* execute for liteOp req                             (on node where spawned) */
/*----------------------------------------------------------------------------*/
: __liteOp_req

"
: /liteOp/_req \\operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: /liteOp/_PulseMarker  ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;
"
;


/*----------------------------------------------------------------------------*/
/* liteOp procedure with 0 parameters                                         */
/*----------------------------------------------------------------------------*/
: __liteOp_procedure0

"
procedure /liteOp/
begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    /liteOp/ | stageC

  stage stageC on origin :
    output | sink | stageA

end
"
;
    
/*----------------------------------------------------------------------------*/
/* liteOp procedure with 1 parameter                                          */
/*----------------------------------------------------------------------------*/
: __liteOp_procedure1

"
  procedure /liteOp/
    parameters $param
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    /liteOp/ $param | stageC

  stage stageC on origin :
    output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* liteOp procedure with 2 parameters                                         */
/*----------------------------------------------------------------------------*/
: __liteOp_procedure2

"
  procedure /liteOp/
    parameters $param0 $param1
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    /liteOp/ $param0 $param1 | stageC

  stage stageC on origin :
    output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: __localLiteOp_PulseMarker

"
  : /localLiteOp/_PulseMarker \\handler

    /localLiteOp/_action if
      Pipein[].pipeout
      Operand[].newEosMarker
      Operand[].pipeOut
    then

    true
  ;
"
;

/*----------------------------------------------------------------------------*/
/* execute for localLiteOp req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: __localLiteOp_req

"
  : /localLiteOp/_req \\operator

    LogReqEntry SEED_REQ

    op__topology

    find: /localLiteOp/_PulseMarker  ZK_PULSEMARKER op[].handler!

    op__loop

    LogReqExit
    job::deleteThis
    DONE_REQ_OP
  ;
"
;


/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 0 parameters                                   */
/*----------------------------------------------------------------------------*/
: __localLiteOp_procedure0

"
  procedure /localLiteOp/
  begin

  stage stageA on origin :
    start | periodicOp once | /localLiteOp/ |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 1 parameter                                    */
/*----------------------------------------------------------------------------*/
: __localLiteOp_procedure1

"
  procedure /localLiteOp/
    parameters $param
  begin

  stage stageA on origin :
    start | periodicOp once | /localLiteOp/ $param |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 2 parameters                                   */
/*----------------------------------------------------------------------------*/
: __localLiteOp_procedure2

  "
    procedure /localLiteOp/
      parameters $param0 $param1
    begin

    stage stageA on origin :
      start | periodicOp once | /localLiteOp/ $param0 $param1 |
        output | sink | stageA

    end
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
