/*============================================================================*/
/* se_word.sen -- additional word related words                               */
/*============================================================================*/

" se_word.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check for known word                                                       */
/*----------------------------------------------------------------------------*/
: word::isKnown ( <"wordNm"> )
  find
  not if EC_NO_SUCH_WORD false exit_rt then
  true
;

/*----------------------------------------------------------------------------*/
/* return word name with any suffix removed                                   */
/*----------------------------------------------------------------------------*/
: word.name_trunc params| pWord |

  "_" pWord word.name@ str.removeSuffix
;

/*----------------------------------------------------------------------------*/
/* show details of given word                                                 */
/*----------------------------------------------------------------------------*/
: word.show params| pWord |

  pWord word.name@     locals| sWordName |
  pWord word.category@ locals| pCatg |
  pCatg word.name@     locals| sCatgName |

  sCatgName sWordName
    "Word: %24v Category: %16v" .printf
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* list all words in the current dictionary                                   */
/*----------------------------------------------------------------------------*/
: words prompt

  //folder[] dic.lastWord dup
  dic::root dic.lastWord dup
  iterate                        // iterate word cursor
    object@ word.name@ .         // print the name of the word
    object@ word.prev object!    // advance cursor backwards thru words
  next
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
