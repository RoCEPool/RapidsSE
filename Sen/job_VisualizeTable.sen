/*============================================================================*/
/* job_VisualizeTable.sen -- Job Visualize Table                              */
/*============================================================================*/

" job_VisualizeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkVisualizeTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  folder[].checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if false exit then

  // push table folder
  sTableNm path[].pushTable assert

  sTableNm checkIsTable not if path[].discardTable false exit then
  //sTableNm tableInUse if path[].discardTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  path[].discardTable

  // assert in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* visualize table request (on originating node)                              */
/*----------------------------------------------------------------------------*/
: visualizeTable_req ( -- <R> )

  LogEntry SEED_REQ

  0 0 0 0 0 locals| pTask pIndex sTableNm sIndexNm pjob_VisualizeTable |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task[] to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pjob_VisualizeTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table name
  //pjob_VisualizeTable job.objectName@ to sTableNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can visualize table
  sTableNm checkVisualizeTable not if pjob_VisualizeTable ERROR_REQUEST !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table folder
  sTableNm path[].pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize 
  sTableNm find execute table.visualize

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  path[].discardTable

  pjob_VisualizeTable job.notice

  LogExit DONE_REQ
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: visualizeTable :: vistbl <tableNm> ;

jobInfo: visualizeTable
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_JOB_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
