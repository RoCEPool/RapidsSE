/*============================================================================*/
/* OP_changeFolder.sen -- Operator change flolder                             */
/*============================================================================*/

" OP_changeFolder.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: cf_action

  0 0 locals| pCurrentFolder sFolderNm |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the folderNm from the the tag
  <folderNm> to sFolderNm

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a ".." which will go up one folder

  // pop up one folder, but not into tenants
  sFolderNm ".." str.equal if
    folder[] dic.name@ "tenants" str.equal not if path[].popFolder then
    setPath
    true
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a "~" will pop folder path till it reaches /tenants

  // pop up to tenants
  sFolderNm "~" str.equal if
    begin folder[] dic.name@ "tenants" str.equal not while path[].popFolder repeat
    setPath
    true
    exit                                                         // *EARLY EXIT*
  then

  // set default catalogs
  sFolderNm "~catalogs" str.equal if
    setCatalogs
    true
    exit                                                         // *EARLY EXIT*
  then

  // set default schemas
  sFolderNm "~schemas" str.equal if
    setSchemas
    true
    exit                                                         // *EARLY EXIT*
  then

  // set default tables
  sFolderNm "~tables" str.equal if
    setTables
    true
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a "tenants" will clear folder path and set to /tenants

  // clear dic path and push tenants
  sFolderNm "tenants" str.equal if
    path[].popAllFolders
    attachmap::tenants@ execute path[].pushFolder
    setPath
    true
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // otherwise we expect a name of a sub-folder to which we push path to
  //  push sub-folder

  sFolderNm folder[].findSymbol to pCurrentFolder

  pCurrentFolder word.checkIsAFolder not if
    op.pipelineJob@ ERROR_JOB
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  pCurrentFolder execute path[].pushFolder
  setPath

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: cf :: cf <folderNm> ;

: cf _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
