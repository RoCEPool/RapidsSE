/*============================================================================*/
/* table.sen -- table related words                                           */
/*============================================================================*/

"table.sen" .verbose

int: queryCount

/*----------------------------------------------------------------------------*/
/* table is use as a kind of word to identify tables                          */
/*----------------------------------------------------------------------------*/
: table ;

//: makeTables pathPush "tables" :dic ' folder swap execute dic.kind! pathDrop ;

/*----------------------------------------------------------------------------*/
/* make a tables folder under given named schema                              */
/*----------------------------------------------------------------------------*/
: makeTables ( "<schemaNm>" -- )

  args.tracepoint if
    dup "MAKING TABLES FOR SCHEMA " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  find execute ( dic )
  "tables"     ( dic "tables" )
  swap         ( "tables" dic )
  :folder      ( )
;

/*----------------------------------------------------------------------------*/
/* make a tableNm folder under tables                                         */
/*----------------------------------------------------------------------------*/
: makeTableDic ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING TABLE DIC " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  0 pathPick
  :folder      ( )
;


: isTable word.kind@ ' table eql ;

/*----------------------------------------------------------------------------*/
/* create a table using name from input stream (doesnt leave table on stk)    */
/*----------------------------------------------------------------------------*/
: table:

  create
  WT_OBJECT word.this word.type!
  sizeof_table allot
  word.this >body object.magic!
  CN_TABLE word.this >body object.class!
  word.this >body table.init
  true word.this >body object.wordbody!
  ' table word.this word.kind!
  does>
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: :table

  >create
  WT_OBJECT word.this word.type!
  sizeof_table allot
  word.this >body object.magic!
  CN_TABLE word.this >body object.class!
  word.this >body table.init
  true word.this >body object.wordbody!
  ' table word.this word.kind!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* check within tables                                                        */
/*----------------------------------------------------------------------------*/
: withinTables

  0 pathPick dic.name "tables" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in tables                                                            */
/*----------------------------------------------------------------------------*/
: checkInTables

  withinTables if true exit then

  EC_NOT_IN_TABLES false
;

/*----------------------------------------------------------------------------*/
/* check within a table                                                       */
/*----------------------------------------------------------------------------*/
: withinTable

  0 pathPick dic.name str.equal
;

/*----------------------------------------------------------------------------*/
/* check in table                                                             */
/*----------------------------------------------------------------------------*/
: checkInTable

  withinTable if true exit then

  EC_NOT_IN_TABLE false
;

/*----------------------------------------------------------------------------*/
/* check word is a table                                                      */
/*----------------------------------------------------------------------------*/
: checkIsTable ( "<tableNm>" -- "<tableNm>" true | errorCode false )

  dup ( "<tableNm>" "<tableNm>" )

  find ( "<tableNm>" ^w:table )

  dup ( "<tableNm>" ^w:table ^w:table )
  not ( "<tableNm>" ^w:table bool )
  if
    drop ( "<tableNm>" )
    drop ( )
    EC_NO_SUCH_TABLE false ( errorCode false )
  exit
  then

  dup ( "<tableNm>" ^w:table ^w:table )

  word.kind@ ( "<tableNm>" ^w:table ^word )
  ' table ( "<tableNm>" ^w:table ^word ^word )
  eql ( "<tableNm>" ^w:table bool )
  if
    drop ( "<tableNm>" )
    true ( "<tableNm>" true )
    exit
  then

  drop ( "<tableNm>" )
  drop ( )
  EC_NOT_A_TABLE false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check word is not a table                                                  */
/*----------------------------------------------------------------------------*/
: checkIsNotTable ( word )
  dup findInCurrent not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check there is a table folder                                              */
/*----------------------------------------------------------------------------*/
: checkIsTableFolder  ( "<tableName>" -- )
  findInCurrent not if EC_NO_SUCH_TABLE false exit then
  true
;


/*----------------------------------------------------------------------------*/
: pushTable ( "<tableName>" -- )

  find execute pathPush

  true
;

/*----------------------------------------------------------------------------*/
: popTable
  pathDrop
;


/*----------------------------------------------------------------------------*/
: pushTableSub ( "<tableName>" -- )

  checkIsTable not if EC_NO_SUCH_TABLE false exit then

  find execute table.subDic pathPush

  true
;

/*----------------------------------------------------------------------------*/
: popTableSub
    pathDrop
;

/*----------------------------------------------------------------------------*/
: getTableRef ( "<tableNm>" -- <R> )

  dup checkInTable not if false exit then

  checkIsTable not if EC_NO_SUCH_TABLE false exit then

  find execute ( table )

  task.this task.seitf@ seitf.tableRef

    true
;

/*----------------------------------------------------------------------------*/
: returnTableRef ( )

  task.this task.seitf@ seitf.tableDeref

  true
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: tableInUse ( "<tableNm>" -- <R> )

  find execute

  table.ref
  if true else false then
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable table                                          */
/*----------------------------------------------------------------------------*/
: checkMakeTable ( "<tableNm>" -- "<tableNm>" true | "<tableNm>" errorCode false )

  checkInTables   not if false exit then
  checkIsNotTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable table folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveTable ( "<tableNm>" -- "<tableNm>" true | "<tableNm>" errorCode false )

  checkInTables not if false exit then ( "<tableNm>" )

  dup checkIsWord not if EC_NO_SUCH_TABLE false exit then ( "<tableNm>" )
  drop

  // push table dictionary
  dup pushTable assert

  checkIsTable not if false exit then ( "<tableNm>" )
  dup tableInUse if EC_TABLE_IN_USE false exit then ( "<tableNm>" )

  popTable

  true ( "<tableNm>" true )
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: sizeTable ( "<tableNm>" -- "<size>" )

  find execute ( table )

  table.space >str
;

////////////////////////////////////////////////////////////////////////////////

: dumpTable ( "<tableNm>" )

  find execute ( table )

  "__row_cursor" find dup
  if
  else
    drop
    "__row_cursor" :selCursor
  then
  execute

  >r
  // r0 ^selCursor

  r0 selCursor.table!
  grid.slots 0
  do
    // r2 ^selCursor
    I r2 selCursor.begin
    r2 selCursor.first
    begin
      while
      r2 selCursor.get
      .
      r2 selCursor.next
      repeat

      r2 selCursor.end
  loop

  rdrop

  "__row_cursor" find word.forget
;

/*----------------------------------------------------------------------------*/
/* get select cursor for table                                                */
/*----------------------------------------------------------------------------*/
: selecttable ( "<tableNm>" -- <selCursor> )

  queryCount ++

  task.this task.seitf@ seitf.table@

  selCursor.new dup -rot selCursor.table!

  >str
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncateTable ( "<tableNm>" -- )

  find execute ( table )

  table.truncate
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* analyze a table                                                            */
/*----------------------------------------------------------------------------*/
: analyzeTable allParticipants 1 returnResult ( "<tableNm>" -- true n# true )

tp: analyzeTable

  find execute

  0 table.analyze

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* analyze a table                                                            */
/*----------------------------------------------------------------------------*/
: danalyzeTable allParticipants 1 returnResult ( "<tableNm>" -- true n# true )

  tp: danalyzeTable

  find execute

  1 table.analyze

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* make a table (run by participant)                                          */
/*----------------------------------------------------------------------------*/
: makeTable allParticipants 1 checkResult ( "<tableNm>" -- true n# true )

tp: makingTable

  args.tracepoint if
  dup "MAKING TABLE " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  dup dup
  makeTableDic

  dup
  find execute pathPush
  dup

  "makeIndexes" find execute

  :table ( "<tableNm>" ^table )

  drop ( "<tableNm>" )


  // forward reference :-(
  "makeColumns" find execute

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeTable allParticipants 1 checkResult ( "<tableNm>" -- true n# true )

tp: removeTable

//traceon

  locals| tableNm |

  tableNm pushTable assert
  tableNm find execute ( ^table )

  // drop all rows
  dup table.truncate ( ^table )

  // drop all indexes
  //"indexes"
  //find execute pathPush

  // forget the indexes dictionary
  "indexes" :forget

  // forget all column names in the columns dictionary of table sub-dictionary
  dup table.subDic
  pathPush
    "columns" find execute forgetAll
  pathDrop


  // forget the columns dictionary in the table sub-dictionary
  table.subDic forgetAll

  tableNm :forget

  popTable

  tableNm :forget

//traceoff

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
