/*============================================================================*/
/* table.sen -- table related words                                           */
/*============================================================================*/

"table.sen" .verbose

int: queryCount

/*----------------------------------------------------------------------------*/
/* table is used as a kind of word to identify tables                         */
/*----------------------------------------------------------------------------*/
: table ;

//: makeTables pathPush "tables" :dic ' folder swap execute dic.kind! pathDrop ;

/*----------------------------------------------------------------------------*/
/* make a tables folder under given named schema                              */
/*----------------------------------------------------------------------------*/
: makeTables ( "<schemaNm>" -- )

  args.tracepoint if
    dup "MAKING TABLES FOR SCHEMA " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  find execute ( dic )
  "tables"     ( dic "tables" )
  swap         ( "tables" dic )
  :folder      ( )
;

/*----------------------------------------------------------------------------*/
/* make a tableNm folder under tables                                         */
/*----------------------------------------------------------------------------*/
: makeTableDic ( "<tableNm>" -- )

  args.tracepoint if
    dup "MAKING TABLE DIC " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  0 pathPick
  :folder      ( )
;


: isTable word.kind@ ' table eql ;

/*----------------------------------------------------------------------------*/
/* create a table using name from input stream (doesnt leave table on stk)    */
/*----------------------------------------------------------------------------*/
: table:

  create
  WT_OBJECT word.this word.type!
  sizeof_table allot
  word.this >body object.magic!
  CN_TABLE word.this >body object.class!
  word.this >body table.init
  true word.this >body object.wordbody!
  ' table word.this word.kind!
  does>
;

/*----------------------------------------------------------------------------*/
/* create a table using name on the stack (leaves table on stack)             */
/*----------------------------------------------------------------------------*/
: :table

  >create
  WT_OBJECT word.this word.type!
  sizeof_table allot
  word.this >body object.magic!
  CN_TABLE word.this >body object.class!
  word.this >body table.init
  true word.this >body object.wordbody!
  ' table word.this word.kind!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* test if this task dic path ends in tables                                  */
/*----------------------------------------------------------------------------*/
: withinTables ( -- t|f )

  0 pathPick dic.name "tables" str.equal
;

/*----------------------------------------------------------------------------*/
/* assert top of task dictionary stack is tables                              */
/*----------------------------------------------------------------------------*/
: assertInTables ( -- t|f )

  withinTables assert
;

/*----------------------------------------------------------------------------*/
/* check top of task dictionary stack is tables                               */
/*----------------------------------------------------------------------------*/
: checkInTables ( -- t|f )

  withinTables if true exit then

  EC_NOT_IN_TABLES false
;

/*----------------------------------------------------------------------------*/
/* test if this task dic path is same name as argument                        */
/*----------------------------------------------------------------------------*/
: withinTable ( "<tableNm>" -- t|f )

  assert::stack_1+
  CN_STRVAL assert::class_0

  // assert dictionary path
  task::this task.dicStack dicPath.depth assert

  0 pathPick dic.name str.equal
;

/*----------------------------------------------------------------------------*/
/* check top of task dictionary stack is given table name                     */
/*----------------------------------------------------------------------------*/
: checkInTable ( "<tableNm>" -- t|f )

  withinTable if true exit then

  EC_NOT_IN_TABLE false
;

/*----------------------------------------------------------------------------*/
/* check given name is a table                                                */
/*----------------------------------------------------------------------------*/
: checkIsTable ( "<tableNm>" -- "<tableNm>" true | errorCode false )

  dup ( "<tableNm>" "<tableNm>" )

  find ( "<tableNm>" ^w:table )

  dup ( "<tableNm>" ^w:table ^w:table )
  not ( "<tableNm>" ^w:table bool )
  if
    drop ( "<tableNm>" )
    drop ( )
    EC_NO_SUCH_TABLE false ( errorCode false )
  exit
  then

  dup ( "<tableNm>" ^w:table ^w:table )

  word.kind@ ( "<tableNm>" ^w:table ^word )
  ' table ( "<tableNm>" ^w:table ^word ^word )
  eql ( "<tableNm>" ^w:table bool )
  if
    drop ( "<tableNm>" )
    true ( "<tableNm>" true )
    exit
  then

  drop ( "<tableNm>" )
  drop ( )
  EC_NOT_A_TABLE false ( errorCode false )
;

/*----------------------------------------------------------------------------*/
/* check word is not a table                                                  */
/*----------------------------------------------------------------------------*/
: checkIsNotTable ( "<wordNm" -- t|f )
  dup findInCurrent not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check there is a table folder                                              */
/*----------------------------------------------------------------------------*/
: checkIsTableFolder  ( "<tableName>" -- )
  findInCurrent not if EC_NO_SUCH_TABLE false exit then
  true
;


/*----------------------------------------------------------------------------*/
/* find the table folder and push it onto task dictionary                     */
/*----------------------------------------------------------------------------*/
: pushTable ( "<tableName>" -- )
  find execute pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the table folder                                                       */
/*----------------------------------------------------------------------------*/
: popTable
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* find the table sub folder and push it onto task dictionary                 */
/*----------------------------------------------------------------------------*/
: pushTableSub ( "<tableName>" -- )
  checkIsTable not if EC_NO_SUCH_TABLE false exit then
  find execute table.subDic pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the table sub folder                                                   */
/*----------------------------------------------------------------------------*/
: popTableSub
    pathDrop
;

/*----------------------------------------------------------------------------*/
/* get and inc table reference and put into task.seitf.currentTable           */
/*----------------------------------------------------------------------------*/
: getTableRef ( "<tableNm>" -- <R> )

  dup checkInTable not if false exit then

  checkIsTable not if EC_NO_SUCH_TABLE false exit then

  find execute ( table )

  task::this task.seitf@ seitf.tableRef

  true
;

/*----------------------------------------------------------------------------*/
/* dec and return table reference and clear task.seitf.currentTable           */
/*----------------------------------------------------------------------------*/
: returnTableRef ( )

  task::this task.seitf@ seitf.tableDeref

  true
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: tableInUse ( "<tableNm>" -- <R> )

  find execute

  table.ref
  if true else false then
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable table                                          */
/*----------------------------------------------------------------------------*/
: checkMakeTable ( "<tableNm>" -- "<tableNm>" true | "<tableNm>" errorCode false )

  checkInTables   not if false exit then
  checkIsNotTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable table folder                                  */
/*----------------------------------------------------------------------------*/
: checkRemoveTable ( "<tableNm>" -- "<tableNm>" true | "<tableNm>" errorCode false )

  checkInTables not if false exit then ( "<tableNm>" )

  dup checkIsWord not if EC_NO_SUCH_TABLE false exit then ( "<tableNm>" )
  drop

  // push table dictionary
  dup pushTable assert

  checkIsTable not if false exit then ( "<tableNm>" )
  dup tableInUse if EC_TABLE_IN_USE false exit then ( "<tableNm>" )

  popTable

  true ( "<tableNm>" true )
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: sizeTable ( "<tableNm>" -- "<size>" )

  find execute ( table )

  table.space >str
;

////////////////////////////////////////////////////////////////////////////////

: dumpTable ( "<tableNm>" )

  find execute ( table )

  "__row_cursor" find dup
  if
  else
    drop
    "__row_cursor" :selCursor
  then
  execute

  >r
  // r0 ^selCursor

  r0 selCursor.table!
  grid.slots 0
  do
    // r2 ^selCursor
    I r2 selCursor.begin
    r2 selCursor.first

    begin

      while

      r2 selCursor.get
      .
      r2 selCursor.next

      repeat

      r2 selCursor.end
  loop

  rdrop

  "__row_cursor" find word.forget
;

/*----------------------------------------------------------------------------*/
/* get lower select cursor for table ( called by range_select_table request)  */
/*----------------------------------------------------------------------------*/
: lowerSelectTable ( "<lower>" --  )

  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //

  assert::stack_1

  0 0 locals| selCursor selectTask lower |

  // for the moment just discard lower and upper
  //stk drop

  // increment query count
  queryCount ++

  // push task.seitf.table
  task::this task.seitf@ seitf.table@ ( ^table )

  // create a selCursor
  selCursor.new ( ^table ^selCursor )
  to selCursor

  // store table into selCursor
  selCursor selCursor.table!

  grid.slots 0
  do

   I selCursor selCursor.begin
   selCursor selCursor.first

   begin
     while
       // create a task to execute the lower bound select
       selCursor lower 2 "lowerSelect" task::this task::new to selectTask
       task::this task.seitf@ selectTask task.seitf!

       I selectTask task.seitf@ seitf.partition!

       1 setAcks

       selectTask task::this task.taskSet@
       taskSet.Append

       ackWait

       selCursor selCursor.hasRow if
         selCursor selCursor.get .
         selCursor selCursor.next
       else
         0
       then

    repeat

  loop

  // delete the selcursor
  //selCursor selCursor.delete

  //1 "helloWorld" nullPtr task::new to selectTask
  //selectTask task::this task.taskset@
  //taskSet.Append

  // convert address of selCursor into string
  //selCursor CN_SELCURSOR assert::class
  //>str ( "<^selCursor>")

  "ALL DONE" .
;

/*----------------------------------------------------------------------------*/
/* position lower select cursor for table ( called by lowerSelectTable request)*/
/*----------------------------------------------------------------------------*/
 : lowerSelect ( ^selCursor "<lower>" -- <selCursor> )
 
   0 locals| row lower selCursor |

   selCursor selCursor.hasRow
   begin
     while
        selCursor selCursor.get
       
       to row
       row 1 swap str.clip str.tailint assert
       lower str.tailint assert >= if
         0
       else
         selCursor selCursor.next
       then

   repeat

   // signal the parent task
   //"acking" .
   task::this task.parent@ task.ack
;

/*----------------------------------------------------------------------------*/
/* position lower select cursor for table ( called by lowerSelectTable request)*/
/*----------------------------------------------------------------------------*/
/*
: lowerSelect ( ^selCursor "<lower>" -- <selCursor> )

  0 locals| row lower selCursor |

  grid.slots 0
  do
    I selCursor selCursor.begin
    selCursor selCursor.first

    begin
    while
      selCursor selCursor.get

      to row
      row 1 swap str.clip str.tailint assert
      lower str.tailint assert >= if row .
      then

      selCursor selCursor.next
    repeat

  loop

  selCursor selCursor.end

  // signal the parent task
  task::this task.parent@ task.ack
;
*/

/*----------------------------------------------------------------------------*/
/* position lower select cursor for table ( called by lowerSelectTable request)*/
/*----------------------------------------------------------------------------*/
: lowerSelect ( ^selCursor "<lower>" -- <selCursor> )

  0 locals| row lower selCursor |

  selCursor selCursor.hasRow
  begin
    while
    selCursor selCursor.get

    to row
    row str.firstCsv str.tailint assert
    lower str.tailint assert >= if
      0
    else
      selCursor selCursor.next
    then

  repeat

  // signal the parent task
  //"acking" .
  task::this task.parent@ task.ack
;


/*----------------------------------------------------------------------------*/
/* get range select cursor for table ( called by range_select_table request)  */
/*----------------------------------------------------------------------------*/
: rangeSelectTable ( "<upper>" "<lower>" -- <selCursor> )

  //
  // execution context:
  //   this task will have a seitf
  //   and the seitf will have a table
  //

  assert::stack_2

  // for the moment just discard lower and upper
  drop drop

  // increment query count
  queryCount ++

  // push task.seitf.table
  task::this task.seitf@ seitf.table@ ( ^table )

  // create a selCursor
  selCursor.new ( ^table ^selCursor )

  // store table into selCursor
  dup -rot selCursor.table! ( ^selCursor )

  // convert address of selCursor into string
  CN_SELCURSOR assert::class
  >str ( "<^selCursor>")
;

/*----------------------------------------------------------------------------*/
/* get select cursor for table ( called by select_table request)              */
/*----------------------------------------------------------------------------*/
: selectTable ( -- "<^selCursor>" ) ( Task.seitf.table )

  //
  // at this point this task will have a seitf
  // and the seitf will have a table
  //

  assert::stack_0

  // increment query count
  queryCount ++

  // push task.seitf.table
  task::this task.seitf@ seitf.table@ ( ^table )

  // create a selCursor
  selCursor.new ( ^table ^selCursor )

  // store table into selCursor
  dup -rot selCursor.table! ( ^selCursor )

  // convert address of selCursor into string
  CN_SELCURSOR assert::class
  >str ( "<^selCursor>")
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncateTable ( "<tableNm>" -- )

  find execute ( table )

  table.truncate
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* analyze a table                                                            */
/*----------------------------------------------------------------------------*/
: analyzeTable allParticipants 1 returnResult ( "<tableNm>" -- true n# true )

tp: analyzeTable

  find execute

  0 table.analyze

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* analyze a table (detail analysis)                                          */
/*----------------------------------------------------------------------------*/
: danalyzeTable allParticipants 1 returnResult ( "<tableNm>" -- true n# true )

  tp: danalyzeTable

  find execute

  1 table.analyze

  <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* make a table (run by participant)                                          */
/*----------------------------------------------------------------------------*/
: makeTable allParticipants 1 checkResult ( "<tableNm>" -- true n# true )

tp: makingTable

  args.tracepoint if
  dup "MAKING TABLE " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  dup dup
  makeTableDic

  dup
  find execute pathPush
  dup

  "makeIndexes" find execute

  :table ( "<tableNm>" ^table )

  drop ( "<tableNm>" )

  // forward reference :-(
  "makeColumns" find execute

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* remove a table folder                                                      */
/*----------------------------------------------------------------------------*/
: removeTable allParticipants 1 checkResult ( "<tableNm>" -- true n# true )

tp: removeTable

  locals| tableNm |

  tableNm pushTable assert
  tableNm find execute ( ^table )

  // drop all rows
  dup table.truncate ( ^table )

  "indexes" find execute pathPush

  // iterate thru all indexes and tidyUp
  0 pathPick dic.lastWord dup
    iterate                        // setup iteration of words
    object@ word.name

    // forward reference :-(
    "indexTidyUp" find execute

    object@ word.prev object!     // step backwards thru words
  next

  pathDrop

  // forget the indexes in the indexes dictionary
  "indexes" find execute forgetAll

  // forget the indexes dictionary itself
  "indexes" :forget

  // forget all column names in the columns dictionary of table sub-dictionary
  dup table.subDic
  pathPush
    "columns" find execute forgetAll
  pathDrop

  // forget the columns dictionary in the table sub-dictionary
  table.subDic forgetAll

  tableNm :forget

  popTable

  tableNm :forget

  true <SUCCESS_RESULT>
;

