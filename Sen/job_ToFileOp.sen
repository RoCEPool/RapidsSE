/*============================================================================*/
/* job_ToFileOp.sen -- Job ToFileOp                                           */
/*============================================================================*/

" job_ToFileOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for toFileOp req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToFileOp_req ( -- )
 
  >>logEntry <SEED_REQ>

  job::this locals| pJob_ToFileOp |

  // open the file for writing
  file::new locals| pFile |
  <fileNm> OPEN_WRITE pFile file.open
  pFile to file0[]

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER of
        "Operand:- ZK_CSVBUFFER" .
        file0[].get Operand[].writeToFile0
        true
      endof

      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .
        Operand[].handleEnd
        false
      endof

      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .
        Operand[].delete
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToFileOp :: ToFileOp <fileNm> ;

jobInfo: ToFileOp
{
  <?jobDesc?>  = "--description of job--"
  
  //<?jobType?>  = JT_CONSUMEOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
