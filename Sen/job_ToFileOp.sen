/*============================================================================*/
/* job_ToFileOp.sen -- Job ToFileOp                                           */
/*============================================================================*/

" job_ToFileOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for toFileOp req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToFileOp_req ( -- )
 
  >>logEntry <SEED_REQ>

  job::this locals| pJob_ToFileOp |

  // open the file for writing
  pJob_ToFileOp job.openToFile

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER of
        "Operand:- ZK_CSVBUFFER" .
        Operand[].writeToFile
        true
      endof

      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .
        Operand[].handleEnd
        false
      endof

      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .
        Operand[].delete
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToFile :: ToFile ;

jobInfo: ToFileOp
{
  <?jobDesc?>  = "--description of job--"
  
  //<?jobType?>  = JT_CONSUMEOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
