/*============================================================================*/
/* job_ToFileOp.sen -- Job ToFileOp                                           */
/*============================================================================*/

" job_ToFileOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for toFileOp req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToFile_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_ToFileOp |


   pJob_ToFileOp job.opLoop

   //pJob_ConsumeOp job::participantExecuted

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToFile :: ToFile ;

jobInfo: ToFileOp
{
  <?jobDesc?>  = "--description of job--"
  
  //<?jobType?>  = JT_CONSUMEOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
