/*============================================================================*/
/* job_SubExporter.sen -- Job Table SubExporter                               */
/*============================================================================*/

" job_SubExported.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participant node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* sprint rows from table partition into export buffers, KE` drags to origin  */
/*----------------------------------------------------------------------------*/
: SE.export ( pJob_SE -- )

  params| pJob_SE |

  pJob_SE job_subExporter.begin not if exit then             // [E](E`)SE:(E`)SE

  begin                                             // KE`[E](E`)SE,KE:(E`)SE,KE
    CN_JOB_EXPORT job::stateDiagram .
    pJob_SE job_subExporter.chunk
  while repeat

  pJob_SE job_subExporter.end
;

/*----------------------------------------------------------------------------*/
/* run seed for SE sub-exporter on participant node          [E](E`)SE:(E`)SE */
/*----------------------------------------------------------------------------*/
: subExporter_run ( -- )

  >>am <SEED_RUN>
  an::seed_run

  job::this locals| pJob_SE |
  pJob_SE job.assertNeutral

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // perform SE.export

  pJob_SE job_subExporter.exportJob@ locals| pJob_(E`)  |
  pJob_(E`) job.assertParticipant

  pJob_SE SE.export

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // ack the (E`) on this node                  // KE`[E](E`)<-SE,KE:(E`)<-SE,KE

  pJob_(E`) job.executingTask@ locals| pTask_(E`) |
  pTask_(E`) task.ack

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // null the job in the task and delete ended job

  nullptr task::this task.job!
  pJob_SE job.delete                                      // KE`[E](E`)KE:(E`)KE

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
