/*============================================================================*/
/* job_SubExporter.sen -- Job Table SubExporter                               */
/*============================================================================*/

" job_SubExported.sen" .verbose

/*----------------------------------------------------------------------------*/
/* read records from file, create working buffers, send to node               */
/*----------------------------------------------------------------------------*/
: subExporter.export ( pJob_SubExporter -- )

  params| pJob_SubExporter |

  pJob_SubExporter job_subExporter.begin not if exit then

  begin pJob_SubExporter job_subExporter.chunk while repeat

  pJob_SubExporter job_subExporter.end
;

/*----------------------------------------------------------------------------*/
/* SubExporter seed                                                           */
/*----------------------------------------------------------------------------*/
: subExporter_run ( -- )

  >>am <SEED_RUN>
  an::seed_run

  task::this locals| pThisTask |
  job::this  locals| pJob_SubExporter |
  pJob_SubExporter job_subExporter.exportJob@ locals| pJob_Export |
  pJob_Export job.executingTask@ locals| pTask_Export |

  pJob_SubExporter subExporter.export

  pTask_Export task.ack

  // null the job in the task and delete ended job
  nullptr pThisTask task.job!
  pJob_SubExporter job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
