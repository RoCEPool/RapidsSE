/*============================================================================*/

" jobEnames.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the ename word kind                                                        */
/*----------------------------------------------------------------------------*/
: <<ename>> immediate ( -- )

  [ word::this , ]

  word::this word.category!
;

/*----------------------------------------------------------------------------*/
/* push value of <catalogNm> from JobEnmSet                                   */
/*----------------------------------------------------------------------------*/
: <catalogNm> <<ename>> ( -- "<catalogNm>" )

  [ word::this word.name@ , ] job::this job.ename@
;

