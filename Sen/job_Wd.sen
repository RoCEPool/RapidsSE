/*============================================================================*/
/* job_wd.sen -- Job Word Dump                                                */
/*============================================================================*/

" job_Wd.sen" .verbose

/*----------------------------------------------------------------------------*/
/* word dump                                                                  */
/*----------------------------------------------------------------------------*/
: wd_req ( -- )

  >>logEntry <SEED_REQ>

<wordNm> "Dumping word: %v" fmt.print

  <<logExit <DONE_REQ>

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: wd :: wd <wordNm> ;

jobInfo: wd
{
  <?jobDesc?>  = "dump word"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NONE
  <?ddlLock?>  = DL_NONE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
