/*============================================================================*/
/* job_wd.sen -- Job Word Dump                                                */
/*============================================================================*/

" job_Wd.sen" .verbose

/*----------------------------------------------------------------------------*/
/* word dump                                                                  */
/*----------------------------------------------------------------------------*/
: wd_req ( -- )

  >>logEntry <SEED_REQ>

<wordNm> "Dumping word: %v" fmt.print

  <wordNm> find dup if
    word.see
  else
    drop
  then

  <<logExit <DONE_REQ>

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: wd :: wd <wordNm> ;

jobInfo: wd
{
  <?jobDesc?>  = "dump word"
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
