/*============================================================================*/
/* job_GenCsvOp.sen -- Job GenCsvOp                                           */
/*============================================================================*/

" job_GenCsvOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a table folder                                            */
/*----------------------------------------------------------------------------*/
: checkGenTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if drop EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* genCsvOp request                                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: genCsvOp_req ( -- )

  >>logEntry <SEED_REQ>

  job::this locals| pJob_GenCsvOp |
  0 locals| pTable |

  <tableNm> locals| sTableNm |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut

        // new a stream def
        Operand[].newStreamDef
        Operand[].pipeOut

        // pipeout a single generated csv buffer
        //begin
        table[].get table.genCsvBuffer to Operand[]
        Operand[].pipeOut
        //false
        //while repeat

        Operand[].newEosMarker
        //Operand[].handleEnd
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        // check if table exits
        sTableNm checkGenTable not if
          op.pipelineJob@ <ERROR_JOB>
          Operand[].delete
          Operand[].newErrorMarker
        else
          // move to table folder and find the table
          sTableNm pushTable assert
          sTableNm find execute to table[]
        then

        Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        Operand[].handleEnd
      endof

    endcase

  while assert::stack_0 repeat

  "*** GENCSVOP EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: genCsvOp :: genCsvOp <tableNm> ;

jobInfo: genCsvOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SCANOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
