/*============================================================================*/
/* r35Jobs.sen -- R35 job related words                                       */
/*============================================================================*/

"r35Jobs.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Job_G35_Exe job                                                            */
/*----------------------------------------------------------------------------*/
: Job_G35_Exe ( job -- )

  locals| pJob |

  pJob job.participant@ pJob job.Id@ "Job_G35_Exe jobId %v executed on node %v" str.format .
;

/*----------------------------------------------------------------------------*/
/* begun job                                                                  */
/*----------------------------------------------------------------------------*/
: Job__Begun_Exe ( jobId -- )

  0 0 0 locals| iAcksRemaining pJob pJobExecute iJobId |

  //iJobId "excuting Job__Begun_Exe %v" str.format .

  // find the job in the originator jobs
  iJobId job.findOriginator to pJob

  // decrement the acks remaining
  pJob job.decAcksRemaining to iAcksRemaining

  // if received all acks
  iAcksRemaining 0 == if 

    "received job__begun from all nodes" .

    // received job__begun from all nodes
    // this is the decider job

    // set the no of acks expected in originator job
    grid::nodes pJob job.acksRemaining!

    // new job__execute
    iJobId job.newExecute to pJobExecute

    // send job__execute to all nodes
    grid::nodes 0 do
      I grid::node task::this task.sendNode!
      task.send

      // send the execute job
      pJobExecute 1
      >valset
      >socketR35
    loop

  // now delete the execute job
  pJobExecute job.delete

  then
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: Job__End_Exe ( jobId -- )

  0 0 locals| pJob pJobEnded iJobId |

   // find the job in the participating jobs
   iJobId job.findParticipant to pJob

  // remove the job from the participant jobs
  pJob job.removeParticipant

  // delete the job
  iJobId job::originator@ grid::thisNode@ != if
    pJob job.delete
  then

  // send ended to originating node
  iJobId job.newEnded to pJobEnded

  // send job__end to originating node
  iJobId job::originator@ grid::node task::this task.sendNode!
  task.send

  // send the ended job
  pJobEnded 1
  >valset
  >socketR35

  // now delete the ended job
  pJobEnded job.delete

;

/*----------------------------------------------------------------------------*/
/* ended job                                                                  */
/*----------------------------------------------------------------------------*/
: Job__Ended_Exe ( jobId -- )

  0 0 locals| pJob iAcksRemaining iJobId |

  // find the job in the originator jobs
  iJobId job.findOriginator to pJob

  // decrement the acks remaining
  pJob job.decAcksRemaining to iAcksRemaining

  // if there are acks remaining just exit
  iAcksRemaining 0 != if exit then

  "received Job__Ended_Exe from all nodes" .

  // remove the job from the originator jobs
  pJob job.removeOriginator

  // delete the job
  pJob job.delete

  "All Done" .
;

/*----------------------------------------------------------------------------*/
/* execute job                                                                */
/*----------------------------------------------------------------------------*/
: Job__Execute_Exe ( jobId -- )

  0 0 locals| pJob pJobExecuted iJobId |

  // find the job in the participating jobs
  iJobId job.findParticipant to pJob

  // execute the job
  pJob pJob job.execute@ find execute

  // new a job__executed
  iJobId job.newExecuted to pJobExecuted

  // send job__executed back to the originator
  iJobId job::originator@ grid::node task::this task.sendNode!
  task.send

  // send the executed job
  pJobExecuted 1
  >valset
  >socketR35

  // now delete the executed job
  pJobExecuted job.delete
;

/*----------------------------------------------------------------------------*/
/* executed job                                                               */
/*----------------------------------------------------------------------------*/
: Job__Executed_Exe ( jobId -- )

  0 0 0 locals| pJob pJobEnd iAcksRemaining iJobId |

  // find the job in the originator jobs
  iJobId job.findOriginator to pJob

  // decrement the acks remaining
  pJob job.decAcksRemaining to iAcksRemaining

  // if there are acks remaining just exit
  iAcksRemaining 0 != if exit then

  "received Job__Executed_Exe from all nodes" .

  // set the no of acks expected in originator job
  grid::nodes pJob job.acksRemaining!

  // send end to other node
  iJobId job.newEnd to pJobEnd

  // set the send node to all the nodes
  grid::nodes 0 do
    I grid::node task::this task.sendNode!
    task.send

    // send the end job
    pJobEnd 1
    >valset
    >socketR35
  loop

  // now delete the end job
  pJobEnd job.delete
;

////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* received job__begun                                                        */
/*----------------------------------------------------------------------------*/
: job__begun_received ( pJob -- )

  locals| pJob |

  grid::thisNode@ "Node %v CN_JOB__BEGUN" str.format .
  pJob job.id@ pJob job.execute@ find execute
  pJob job.delete
;

/*----------------------------------------------------------------------------*/
/* received job__end                                                          */
/*----------------------------------------------------------------------------*/
: job__end_received ( pJob -- )

  locals| pJob |

  grid::thisNode@ "Node %v CN_JOB__END"str.format .
  pJob job.id@ pJob job.execute@ find execute
  pJob job.delete
;

/*----------------------------------------------------------------------------*/
/* received job__ended                                                        */
/*----------------------------------------------------------------------------*/
: job__ended_received ( pJob -- )

  locals| pJob |

  grid::thisNode@ "Node %v CN_JOB__ENDED"str.format .
  pJob job.id@ pJob job.execute@ find execute
  pJob job.delete
;

/*----------------------------------------------------------------------------*/
/* received job__error                                                        */
/*----------------------------------------------------------------------------*/
: job__error_received ( pJob -- )

  locals| pJob |

  grid::thisNode@ "Node %v CN_JOB__ERROR"str.format .
  pJob job.id@ pJob job.execute@ find execute
  pJob job.delete
;

/*----------------------------------------------------------------------------*/
/* received job__execute                                                      */
/*----------------------------------------------------------------------------*/
: job__execute_received ( pJob -- )

  locals| pJob |

  grid::thisNode@ "Node %v CN_JOB__EXECUTE"str.format .
  pJob job.id@ pJob job.execute@ find execute
  pJob job.delete
;

/*----------------------------------------------------------------------------*/
/* received job__executed                                                     */
/*----------------------------------------------------------------------------*/
: job__executed_received ( pJob -- )

  locals| pJob |

  grid::thisNode@ "Node %v CN_JOB__EXECUTED"str.format .
  pJob job.id@ pJob job.execute@ find execute
  pJob job.delete
;

/*----------------------------------------------------------------------------*/
/* received an actual job                                                     */
/*----------------------------------------------------------------------------*/
: job_job_received ( pJob -- )

  locals| pJob |

  0 locals| pJobBegun |

  grid::thisNode@ "Node %v Job JOB Recieved" str.format .

  // set partcipant node in job
  grid::thisNode@ pJob job.participant!

  // add job as participant job
  pJob job.addParticipant

  // change state of job to begun
  //pJob job.begun

  // new a job__begun
  pJob job.Id@ job.newBegun to pJobBegun

  // set the send node to be the originating node
  pJob job::originator@ grid::node task::this task.sendNode!
  task.send

  // send the begun job
  pJobBegun 1
  >valset
  >socketR35

  // now delete the begun job
  pJobBegun job.delete
;

/*----------------------------------------------------------------------------*/
/* decode job                                                                 */
/*----------------------------------------------------------------------------*/
: jobDecode ( pJob -- )

  locals| pJob |

  0 locals| eJobClass |

  pJob job.class to eJobClass

  eJobClass case

   // specific cases
    CN_JOB__BEGUN    of pJob job__begun_received    endof
    CN_JOB__END      of pJob job__end_received      endof
    CN_JOB__ENDED    of pJob job__ended_received    endof
    CN_JOB__ERROR    of pJob job__error_received    endof
    CN_JOB__EXECUTE  of pJob job__execute_received  endof
    CN_JOB__EXECUTED of pJob job__executed_received endof

    // default case
    pJob job_job_received
  endcase
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
