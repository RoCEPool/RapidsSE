/*============================================================================*/
/* job__compiler.sen -- Job Compiler                                          */
/*============================================================================*/

" job__compiler.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* test if the word is info about a distributed job                           */
/*----------------------------------------------------------------------------*/
: word.isDistJob_info params| pWord |

  pWord word.TagSet@ locals| pWordTagSet |

  "<jobKind>" pWordTagSet tagSet.getInt JK_DIST2PC == if
    true exit
  else
    false exit
  then
;

/*----------------------------------------------------------------------------*/
/* test if the word is info about a generic job                               */
/*----------------------------------------------------------------------------*/
: word.isGenericJob_info params| pWord |

  pWord word.TagSet@ locals| pWordTagSet |

  "<jobKind>" pWordTagSet tagSet.getInt JK_GENERIC == if
    true exit
  else
    false exit
  then
;

/*----------------------------------------------------------------------------*/
/* test if the word is info about a local job                                 */
/*----------------------------------------------------------------------------*/
: word.isLocalJob_info params| pWord |

  pWord word.TagSet@ locals| pWordTagSet |

  "<jobKind>" pWordTagSet tagSet.getInt JK_LOCAL == if
    true exit
  else
    false exit
  then
;

/*----------------------------------------------------------------------------*/
/* test if the word is info about a lite op                                   */
/*----------------------------------------------------------------------------*/
: word.isLiteOp_info params| pWord |

  pWord word.TagSet@ locals| pWordTagSet |

  "<liteOp>" pWordTagSet tagSet.hasName if
    true exit
  else
    false exit
  then
;

/*----------------------------------------------------------------------------*/
/* test if the word is info about a local lite op                             */
/*----------------------------------------------------------------------------*/
: word.isLocalLiteOp_info params| pWord |

  pWord word.TagSet@ locals| pWordTagSet |

  "<localLiteOp>" pWordTagSet tagSet.hasName if
    true exit
  else
    false exit
  then
;

/*----------------------------------------------------------------------------*/
/* test if the word is info about a service command                           */
/*----------------------------------------------------------------------------*/
: word.isServiceCmd_info params| pWord |

  pWord word.TagSet@ locals| pWordTagSet |

  "<cmdKind>" pWordTagSet tagSet.getInt JK_DIST2PC  == if
    true exit
  else
    false exit
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedExists? params| pWord sSuffix |

  pWord word.name_trunc sSuffix str.cat
    find if true else false then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedEnameAdd params| pWord sDefaultSeed sSuffix sSeedEname |

  pWord word.TagSet@ locals| pWordTagSet |

  sSuffix pWord seedExists?
    if pWord word.name_trunc else sDefaultSeed then
    sSuffix str.cat locals| pWordName |

  sSeedEname pWordName pWordTagSet tagSet.insertStr
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add missing/default tags to an info word                                   */
/*----------------------------------------------------------------------------*/
: fillOut::addDefaultTags params| pWord |

  pWord word.tagSet@ locals| pWordTagSet |

  // test and add default for: command kind
  "<cmdKind>" pWordTagSet tagSet.hasName not if
    "<cmdKind>" "CK_COMMAND" pWordTagSet tagSet.addTag
  then

  // test and add default for: ddl lock
  "<ddlLock>" pWordTagSet tagSet.hasName not if
    "<ddlLock>" "DL_NONE" pWordTagSet tagSet.addTag
  then

  // test and add default for: job desc
  "<jobDesc>" pWordTagSet tagSet.hasName not if
    "<jobDesc>" "--description of job--" pWordTagSet tagSet.addTag
  then

  // test and add default for: job kind
  "<jobKind>" pWordTagSet tagSet.hasName not if
    "<jobKind>" "JK_LOCAL" pWordTagSet tagSet.addTag
  then

  // test and add default for:  priority
  "<priority>" pWordTagSet tagSet.hasName not if
    "<priority>" "PY_NORMAL" pWordTagSet tagSet.addTag
  then

  // test and add default for:  response kind
  "<rspKind>" pWordTagSet tagSet.hasName not if
    "<rspKind>" "RS_NONE" pWordTagSet tagSet.addTag
  then
;

/*----------------------------------------------------------------------------*/
/* add default seed tags to a distributed info word                           */
/*----------------------------------------------------------------------------*/
: fillOut::addSeedsFor_distJob params| pWord |

  "<SeedReq>" "_req" "defaultSeedDist" pWord seedEnameAdd

  "<SeedRcv>" "_beg" "defaultSeedDist" pWord seedEnameAdd

  "<SeedExe>" "_exe" "defaultSeedDist" pWord seedEnameAdd

  "<SeedEnd>" "_end" "defaultSeedDist" pWord seedEnameAdd

  "<SeedCan>" "_can" "defaultSeedDist" pWord seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* add default seed tags to a generic info word                               */
/*----------------------------------------------------------------------------*/
: fillOut::addSeedsFor_genericJob params| pWord |

  "<SeedReq>" "_run" "defaultSeedLocal" pWord seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* add default seed tags to a local op word                                   */
/*----------------------------------------------------------------------------*/
: fillOut::addSeedsFor_localOp params| pWord |

  "<SeedReq>" "_req" "defaultSeedLocal" pWord seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* create a procedure for given lite op info word                             */
/*----------------------------------------------------------------------------*/
: fillOut::procFor_liteOp params| pWord |

  pWord word.name_trunc locals| sWordNm_trunc |
  pWord word.tagSet@    locals| pWordTagSet   |

  0 locals| iParams |

  sWordNm_trunc "LiteOP: %v" .printf

  "/liteOp/" sWordNm_trunc __liteOp_PulseMarker str.replace >interpret
  "/liteOp/" sWordNm_trunc __liteOp_req         str.replace >interpret

  // add procedure depending on no of parameters
  "<params>" pWordTagSet tagSet.hasName assert
  "<params>" pWordTagSet tagSet.getStr >int to iParams

  iParams 2 == if
    "/liteOp/" sWordNm_trunc __liteOp_procedure2 str.replace procedure::add
  else
  iParams 1 == if
    "/liteOp/" sWordNm_trunc __liteOp_procedure1 str.replace procedure::add
  else
    iParams 0 == assert
    "/liteOp/" sWordNm_trunc __liteOp_procedure0 str.replace procedure::add
  then then

  pWord fillOut::addSeedsFor_localOp
;

/*----------------------------------------------------------------------------*/
/* create a procedure for given local lite op info word                       */
/*----------------------------------------------------------------------------*/
: fillOut::procFor_localLiteOp params| pWord |

  pWord word.name_trunc locals| sWordNm_trunc |
  pWord word.tagSet@    locals| pWordTagSet   |

  0 locals| iParams |

  sWordNm_trunc "LocalLiteOP: %v" .printf

  "/localLiteOp/" sWordNm_trunc __localLiteOp_PulseMarker str.replace >interpret

  "/localLiteOp/" sWordNm_trunc __localLiteOp_req         str.replace >interpret

  // add procedure depending on no of parameters
  "<params>" pWordTagSet tagSet.hasName assert
  "<params>" pWordTagSet tagSet.getStr >int to iParams

  iParams 2 == if
    "/localLiteOp/" sWordNm_trunc __localLiteOp_procedure2   str.replace procedure::add
  else
  iParams 1 == if
    "/localLiteOp/" sWordNm_trunc __localLiteOp_procedure1   str.replace procedure::add
  else
    iParams 0 == assert
    "/localLiteOp/" sWordNm_trunc __localLiteOp_procedure0   str.replace procedure::add
  then  then

  pWord fillOut::addSeedsFor_localOp
;

/*----------------------------------------------------------------------------*/
/* populate the JobInfo ename-set with the names of the seeds for the job     */
/* being compiled.  Use default seeds where appropropriate                    */
/*----------------------------------------------------------------------------*/

: fillOut::an_info params| pWord |

  pWord fillOut::addDefaultTags

       pWord word.isGenericJob_info  if pWord fillOut::addSeedsFor_genericJob
  else pWord word.isDistJob_info     if pWord fillOut::addSeedsFor_distJob
  else pWord word.isLiteOp_info      if pWord fillOut::procFor_liteOp
  else pWord word.isLocalLiteOp_info if pWord fillOut::procFor_localLiteOp
  else                                  pWord fillOut::addSeedsFor_localOp
  then then then then

  // pWordTagSet tagSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* consume service arguments                                                  */
/*----------------------------------------------------------------------------*/
: .consumeArgs

  0 locals| nArgs |

  //".consumeArgs" .

  begin
    input::next
    dup ";&" str.equal not
  while
    nArgs 1 + to nArgs
  repeat

  // discard the ";&" from dstack
  discard

  nArgs

  // for the moment we discard the arg vector from the data stack
  dropN
;

/*----------------------------------------------------------------------------*/
/* generate two words, one which parses and another which spawns a service    */
/*----------------------------------------------------------------------------*/
: .generateService

  // calc the name of the service
  "_" compiler::current@ word.name@ str.removeSuffix locals| sServiceNm |

  // calc the name of the spawner
  sServiceNm "_spawner" str.cat locals| sSpawnerNm |


  //----------------------------------------------------------------------------
  // SPAWNER

  // create a word by the spawner name
  sSpawnerNm :create
  compiler::current@ locals| pSpawnerWd |

  // debug
  //pSpawnerWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service spawning word -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // sServiceNm encode::push "++ this is service spawner for: %v" encode::push POSTPONE .printf

  sServiceNm encode::push POSTPONE job::spawnUniversal

  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pSpawnerWd word.dump


  //----------------------------------------------------------------------------
  // PARSER

  // create an immediate word by the service name

  sServiceNm :create
  compiler::current@ locals| pServiceWd |
  true pServiceWd word.immediate!

  // debug
  //pServiceWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service parsing word  -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // in : <serviceNm> add call(.printf)
  // sServiceNm encode::push "++ this is the service parser for: %v" encode::push POSTPONE .printf

  // in : <serviceNm> add call(.consumeArgs)
  POSTPONE .consumeArgs

  // in : <serviceNm> add code which adds call(` pSpawnerWd) in caller of service
  pSpawnerWd encode::push POSTPONE encode::call

  // in : <serviceNm> add exit
  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pServiceWd word.dump
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* the job info compiler                                                      */
/*----------------------------------------------------------------------------*/
: jobInfo:

  0 0 0 0 locals| pWord sEname sEvalue pWordTagSet |

  // create a word using next token from input source as the word name
  input::next "_info" str.cat :create

  compiler::current@ to pWord

  // set the word kind to be jobClass
  [ compiler::current@ encode::push ] pWord word.category!

  // attach an ename set to the word being created
  tagSet::new to pWordTagSet

  pWordTagSet pWord word.TagSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<jobNm>" pWord word.name_trunc pWordTagSet tagSet.insertStr

  // skip the "{" token from input source
  input::next discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    input::next
    dup "}" str.equal not
  while
    to sEname
    input::next discard
    input::next to sEvalue
    sEname sEvalue pWord word.TagSet@ tagSet.addTag
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // discard the "}" from dstack
  discard

  // get and discard ";"
  input::next discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // complete the ename-set

  //pWordTagSet tagSet.asStr .

  pWord fillOut::an_info

  //pWordTagSet tagSet.asStr .

  pWord word.isServiceCmd_info if .generateService then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
