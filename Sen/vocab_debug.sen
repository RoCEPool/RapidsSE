/*============================================================================*/
/* wordSet_debug.sen -- debugging related words                               */
/*============================================================================*/

" wordSet_debug.sen" .verbose

/*----------------------------------------------------------------------------*/
/* unnamed trace point                                                        */
/*----------------------------------------------------------------------------*/
: tp immediate

  "tp"

  ,

  tick tracepoint compile,
;

/*----------------------------------------------------------------------------*/
/* named trace point                                                          */
/*----------------------------------------------------------------------------*/
: tp: immediate

  next-token

  ,

  tick tracepoint compile,
;

/*----------------------------------------------------------------------------*/
/* dump the data stack                                                        */
/*----------------------------------------------------------------------------*/
/*
: stk

  "data stack " .

  depth not if drop then

  depth 0 do
    I pick dump
  loop
;
*/

/*----------------------------------------------------------------------------*/
/* dump the auxiliary stack                                                   */
/*----------------------------------------------------------------------------*/
/*
: astk

  "auxiliary stack" .

  adepth not if drop exit_rt then

  adepth 0 do
    I apick dump
  loop
;
*/

/*----------------------------------------------------------------------------*/
/* dump the return stack                                                      */
/*----------------------------------------------------------------------------*/
: rstk

  "return stack" .
  rdepth dup not if drop exit_rt then
  0 do
    I 2 + rpick
    dup .put
    " ".put
    locate
    dup if .put else drop then
    .\n
  loop
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* interpret string on stack                                                  */
/*----------------------------------------------------------------------------*/
: >: input.push input.text docol input.pop ;

/*----------------------------------------------------------------------------*/
/* check for known word                                                       */
/*----------------------------------------------------------------------------*/
: checkIsWord ( <"wordNm"> )
  find
  not if EC_NO_SUCH_WORD false exit_rt then
  true
;

/*----------------------------------------------------------------------------*/
/* test type of top stack value                                               */
/*----------------------------------------------------------------------------*/
: isType ( CN_ -- bool )

  // false if stack empty
  depth 2 >= not if drop false exit_rt then

  // no more if not indirect
  1 stack.class ==
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
