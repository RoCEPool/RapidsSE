/*============================================================================*/
/* requests_task.sen -- the set of task related requests                      */
/*============================================================================*/

"requests_task.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get a new task                                                             */
/*----------------------------------------------------------------------------*/
: get_task ( -- <R> )

  0       // no args
  ""      // no seed
  0 >ptr  // no parent
  AC_NONE // no model
  ""      // no name
  TK_NONE // no kind

  task::new

  >str

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* return a task                                                              */
/*----------------------------------------------------------------------------*/
: return_task ( "<taskAddr>" -- <R> )

  stk
  >int >ptr
  CN_TASK assert::class
  stk

  task.delete

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
