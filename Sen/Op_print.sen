/*============================================================================*/
/* Op_print.sen -- print rows on console                                       */
/*============================================================================*/

" Op_print.sen" .verbose

/*----------------------------------------------------------------------------*/
/* frame common variables for write                                           */
/*----------------------------------------------------------------------------*/
common/ print nFetchPartitions /

/*----------------------------------------------------------------------------*/
/* print rows from row buffer                                                 */
/*----------------------------------------------------------------------------*/
: printRb subDic print

  // record the plan and profile
  0 0 locals| pIndexBuffer pBufferQueue bFetchStarted thePlan profile pSeitf |

  "tenants" 1 dicStack.set

  // [0] push thePlan's dictionary onto path stack
  thePlan plan.dic pathPush

  // push the op frame for this writeOp
  profile thePlan plan.opFrame? opFrame.push

  //----------------------------------------------------------------------------
  // has fetch just started ?
  bFetchStarted not if

    pSeitf >str "Appending buffers to bufferQueue of seitf %v" str.format .

    // create the buffer queue in the seitf
    "selectTask.queue" queue::new to pBufferQueue

    pBufferQueue pSeitf seitf.bufferQueue!

    // set the no of fetch tasks in nFetchPartitions
    $$nPartitions toCommon nFetchPartitions
    //nFetchPartitions "setting nFetchPartitions %v" str.format .

    // mark fetch as started
    1 to bFetchStarted
  else
    pSeitf seitf.bufferQueue@ to pBufferQueue
  then

  ( [ rowBuffer ] )

  // write or close file & sink plan?
  if ( [ rowBuffer ] )

     to pIndexBuffer

     if ( bIsLast )
        pIndexBuffer entryBuffer.isLast!
     then

     //pSeitf >str "appending rowBuffer to seitf %v queue" str.format .
     pIndexBuffer pBufferQueue queue.append

  else
     // didn't get a rowBuffer, this fetch partition has ended
     nFetchPartitions 1- toCommon nFetchPartitions

     pSeitf seitf.fetchTaskEnded

     // have all the fetch tasks ended ?
     nFetchPartitions 0 == if

       // << $$nextProfile thePlan >> -->> $$nextOp
       << pSeitf $$nextProfile thePlan plan.id@ $$nextOp >>jobqueue

       // mark fetch as not started so next fetch can execute
       0 to bFetchStarted
    then
  then

  opFrame.drop

  // first pop the plan dic as plan may have gotten deleted
  dicStack.pop

  dicStack.clear

  // return fetch started
  bFetchStarted
;

/*----------------------------------------------------------------------------*/
/* print operator loop                                                        */
/*----------------------------------------------------------------------------*/
: printOp operator ( -- NEVER )

  0 locals| bFetchStarted |

  begin

    depth 0 != if "stack of task has grown" . debug::trap then

    // wait for next job
    jobQueue> ( valset )

    // unpack it
    valset> ( profile planId nValues )
    drop ( profile planId )

    // find plan using planId
    planList::findPlan ( profile plan true )

    assert ( profile plan )

    // print row buffer rows
    bFetchStarted ( pSeitf profile plan bFetchStarted )
    printRb ( bFetchStarted )

    // set fetch started
    to bFetchStarted

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
