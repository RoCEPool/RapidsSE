/*============================================================================*/
/* job_seedMarkers.sen -- Job Seed Marker words                               */
/*============================================================================*/

" job_seedMarkers.sen" .verbose

0 constant JM_SEED_RUN
1 constant JM_SEED_REQ
2 constant JM_SEED_RCV
3 constant JM_SEED_EXE
4 constant JM_SEED_END
5 constant JM_SEED_CAN


/******************************************************************************/
/***                              Done Markers                              ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* done executing any seed                                                    */
/*----------------------------------------------------------------------------*/
: Done_Finally ( -- )

  // check this task has no job reference
  JobRef[].none

  // check this task has no ddl lock
  DdlLock[].none

  task::doneFinally
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* done executing a beg seed                                                  */
/*----------------------------------------------------------------------------*/
: DONE_BEG ( -- )

  DdlLock[].testDrop

  JP_BEGUN job[] job.phase!

  Done_Finally
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a can seed                                                  */
/*----------------------------------------------------------------------------*/
: DONE_CAN ( -- )

  DdlLock[].testDrop

  JP_CANCELED job[] job.phase!

  Done_Finally
  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a end seed                                                  */
/*----------------------------------------------------------------------------*/
: DONE_END ( -- )

  DdlLock[].testDrop

  JP_ENDED job[] job.phase!

  Done_Finally
  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* return from job execution on node                                          */
/*----------------------------------------------------------------------------*/
: DONE_EXE ( -- )

  DdlLock[].testDrop

  JP_EXECUTED job[] job.phase!

  Done_Finally
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a kid seed                                                  */
/*----------------------------------------------------------------------------*/
: DONE_KID ( -- )

  DdlLock[].testDrop

  Done_Finally
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a rcv seed                                                  */
/*----------------------------------------------------------------------------*/
: DONE_RCV ( -- )

  DdlLock[].testDrop

  Done_Finally
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a req seed                                                  */
/*----------------------------------------------------------------------------*/
: DONE_REQ ( -- )

  DdlLock[].testDrop

  //"Signalling the thread waiting on job completion" .
  Done_Finally

  job::informInvokerOfCompletion

  // task has no job 
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a run seed                                                  */
/*----------------------------------------------------------------------------*/
: DONE_RUN ( -- )

  DdlLock[].testDrop

  Done_Finally
  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* done executing a run seed                                                  */
/*----------------------------------------------------------------------------*/
: DONE_REQ_OP ( -- )

  DdlLock[].testDrop

  Done_Finally
  task::scheduledelete

  HAZARD
;


/******************************************************************************/
/***                              Seed Markers                              ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* check ready to execute any seed                                            */
/*----------------------------------------------------------------------------*/
: Seed_Initially ( -- )

  task::seedInitially
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* seed begin                                                                 */
/*----------------------------------------------------------------------------*/
: SEED_BEG

  SS_SEED_BEG log::jobSeed

  JP_BEGINNING job[] job.phase!

  <path> str.toStrVec path[].set

  Seed_Initially

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed cancel                                                                */
/*----------------------------------------------------------------------------*/
: SEED_CAN

  SS_SEED_CAN log::jobSeed

  JP_CANCELING job[] job.phase!

  Seed_Initially

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed end                                                                   */
/*----------------------------------------------------------------------------*/
: SEED_END

  SS_SEED_END log::jobSeed

  JP_ENDING job[] job.phase!

  Seed_Initially

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed execute                                                               */
/*----------------------------------------------------------------------------*/
: SEED_EXE

  SS_SEED_EXE log::jobSeed

  JP_EXECUTING job[] job.phase!

  // ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !
  // set task's dictionary stack from path in job

  <path> str.toStrVec path[].set
  //task::dump

  Seed_Initially

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed receive                                                               */
/*----------------------------------------------------------------------------*/
: SEED_RCV

  SS_SEED_RCV log::jobSeed

  Seed_Initially

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed request                                                               */
/*----------------------------------------------------------------------------*/
: SEED_REQ

  SS_SEED_REQ log::jobSeed

  // use the <path> from <ename-set>
  <path> str.toStrVec path[].set

  Seed_Initially

  job::</seeFlow/>
;

/*----------------------------------------------------------------------------*/
/* seed run                                                                   */
/*----------------------------------------------------------------------------*/
: SEED_RUN

  SS_SEED_RUN log::jobSeed

  <path> str.toStrVec path[].set

  Seed_Initially

  job::</seeFlow/>
;


/******************************************************************************/
/***                                  Misc                                  ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* return from chcek resources                                                */
/*----------------------------------------------------------------------------*/
: Check_Resources ( -- )

;

/*----------------------------------------------------------------------------*/
/* return from chcek resources                                                */
/*----------------------------------------------------------------------------*/
: Resources_Checked ( -- )

  DdlLock[].testDrop
;

/*----------------------------------------------------------------------------*/
/* return from cehcek resources                                              */
/*----------------------------------------------------------------------------*/
: Release_Resources ( -- )

;

/*----------------------------------------------------------------------------*/
/* return from cehcek resources                                               */
/*----------------------------------------------------------------------------*/
: Resources_Released ( -- )

;


/*----------------------------------------------------------------------------*/
/* job has encountered an error                                               */
/*----------------------------------------------------------------------------*/
: job::error! params| errorCode |

  DdlLock[].testDrop

  errorCode job[] job.error!
;


/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: ERROR_JOB params| pJob errorCode |

  DdlLock[].testDrop

  //errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode pJob job.error!
;

/*----------------------------------------------------------------------------*/
/* return an error response                                                   */
/*----------------------------------------------------------------------------*/
: ERROR_REQUEST params| pJob errorCode |

  DdlLock[].testDrop
 
  //errorCode error.msg "Setting error '%v' in job" str.format .
  errorCode pJob job.error!

  Done_Finally

  //"Signalling the thread waiting on job completion" .
  job::informInvokerOfCompletion

  // task has no job
  task::scheduledelete

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
