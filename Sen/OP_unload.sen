/*============================================================================*/
/* OP_unload.sen -- unload                                                    */
/*============================================================================*/

" OP_unload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: unload_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: unload_DataMarker \handler

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: unload_CsvBuffer \handler

  ZK_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: unload_EosMarker \handler

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* unload request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: unload_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: unload_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: unload_EosMarker   ZK_EOSMARKER   op[].handler!
  find: unload_DataMarker ZK_DATAPULSE op[].handler!
  find: unload_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: unload :: unload ;

: unload _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
