/*============================================================================*/
/* job_SubPublish.sen -- Job SubPublish                                       */
/*============================================================================*/

" Job_SubPublish.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: SubPublish_process ( pJob_SubPublish -- )

  params| pJob_SubPublish |

  pJob_SubPublish job_subPublish.begin not if exit then

  begin pJob_SubPublish job_subPublish.chunk while repeat

  pJob_SubPublish job_subPublish.end
;

/*----------------------------------------------------------------------------*/
/* SubPublish (on each node)                                                  */
/*----------------------------------------------------------------------------*/
: SubPublish_run ( -- <R> )

  >>am <SEED_RUN>

  0 0 locals| pJob_SubPublish pTask |
  0 0 0 locals| iSlot pTable sTableNm |
  0 0 locals| iPublishJobId pJob_Publish |

  tp: SubPublish
  //"SubPublish_run" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_SubPublish

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  //ddlLock::grabWrite

  // get publish job
  pJob_SubPublish Job_SubPublish.publishJobId@ to iPublishJobId
  pJob_SubPublish iPublishJobId job::waitParticipant to pJob_Publish

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // first check if the job is executing SS_SEED_EXE
  // then get the task that is executing it
  begin
    pJob_Publish job.IsExecuting
  not while
    1 thread.sleep_ms
  repeat

  pJob_Publish job.executingTask@ locals| pTask_Publish |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for acks to be set in the publish task
  begin
    pTask_Publish task.IsAckSet
  not while
    1 thread.sleep_ms
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job from publish (sub has no session)
  pTask_Publish task.job@ job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  pJob_SubPublish job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the table
  sTableNm find execute to pTable

  pTable pJob_SubPublish Job_SubPublish.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the slot this sub publish is supposed to work on
  pJob_SubPublish Job_SubPublish.slot@ to iSlot

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // publish table for iSlot
  pJob_SubPublish SubPublish_process

  // iSlot pTable table.publish

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  popTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // notify the publish job
  pTask_Publish task.grabLock
  pTask_Publish task.dropLock
  pTask_Publish task.ack

  // null the job in the task
  nullptr pTask task.job!

  // now delete the ended job
  pJob_SubPublish job.delete

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
