/*============================================================================*/
/* job_Xmit.sen -- Xmit Job                                                   */
/*============================================================================*/

" Job_Xmit.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                               on kid node                                  //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* seed on kid node                                                           */
/*----------------------------------------------------------------------------*/
: xmit_kid ( -- )

  >>logEntry <SEED_KID>

  job::this locals| pJob_Xmit |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check there is enough Rows and load

  // node::checkEnoughRows if
  //pJob_Xmit writeRow.insert
  //then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  <<logExit
  job::deleteThis

  <DONE_KID>
;

////////////////////////////////////////////////////////////////////////////////
//                            on xmitted node                                 //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* forward this xmit job to kid node                                          */
/*----------------------------------------------------------------------------*/
: Xmit.forward ( pJob_Xmit -- )

  params| pJob_Xmit |

  // which node are we forwarding to?
  pJob_Xmit Job_Xmit.node@ locals| i_ForwardNode |

  i_ForwardNode "Xmit.forward : Node %v" fmt.print

  // send this job to the forward node
  i_ForwardNode pJob_Xmit job.forward
;

/*----------------------------------------------------------------------------*/
/* seed on xmitting node                                                      */
/*----------------------------------------------------------------------------*/
: xmit_run (  -- )

  >>logEntry <SEED_RUN>

  job::this locals| pJob_Xmit  |

  "xmit_run :" .verbose

  // simply forward this job to kid node
  pJob_Xmit xmit.forward

  job::deleteThis

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
