/*============================================================================*/
/* taskQueue.sen -- task Queue related words                                      */
/*============================================================================*/

"taskQueue.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a task Queue using string from input stream as name                   */
/*----------------------------------------------------------------------------*/

: scheduler:

  create
  WT_OBJECT word.this word.type!
  sizeof_scheduler allot
  word.this >body object.magic!
  CN_SCHEDULER word.this >body object.class!
  word.this >body scheduler.init
  true word.this >body object.wordbody!
  does>
;

: :scheduler

  >create
  WT_OBJECT word.this word.type!
  sizeof_scheduler allot
  word.this >body object.magic!
  CN_SCHEDULER word.this >body object.class!
  word.this >body scheduler.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
