/*============================================================================*/
/* listerDrone.sen -- task lister drone                                       */
/*============================================================================*/

"listerDrone.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

taskCursor: pTaskCrs

/*----------------------------------------------------------------------------*/
/* start the lister drone                                                     */
/*----------------------------------------------------------------------------*/
: spawnListerDrone

  0 "listerLoop" nullptr "ListerActor" spawnDroneActor drop
;

/*----------------------------------------------------------------------------*/
/* task list iteration                                                        */
/*----------------------------------------------------------------------------*/
: iterateTaskList

  listerDronePrint if
    "task list..." .
  then

  pTaskCrs pTaskCrs taskcursor.begin
          pTaskCrs taskcursor.first
  iterate

    listerDronePrint if
      object@ task.dump
    then

    cursor@ taskcursor.next object!

  next

  pTaskCrs taskcursor.end

;

/*----------------------------------------------------------------------------*/
/* lister drone loop                                                          */
/*----------------------------------------------------------------------------*/
: listerLoop

  "listerDrone" task::this task.name!

  listerDronePrint if "Lister Drone running..." . then

  begin

    iterateTaskList

    3 thread.sleep_s

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
