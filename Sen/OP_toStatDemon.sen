/*============================================================================*/
/* OP_toStatDemon.sen -- To Stat demon Operator                               */
/*============================================================================*/

" OP_toStatDemon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_LOCKSTATS ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_toStatDemon_LockStats \handler

  "OP_toStatD_LockStats +++ +++ +++" .

  Pipein[] to infoset[]
  nullptr to Pipein[]

  infoset[].name .

  //infoset[].delete

  infoset[]
    "__statDemon" find dup if
      word.object@
      pipeline.pipeout
      nullptr to infoSet[]
    else
      discard discard
      infoset[].delete
    then

  true
;

/*----------------------------------------------------------------------------*/
/* toStatD request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toStatDemon_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: OP_toStatDemon_LockStats ZK_LOCKSTATS op[].handler!

  op__loop

  "*** toStatDOp_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toStatDemon :: toStatDemon ;

: toStatDemon _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
