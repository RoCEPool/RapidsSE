/*============================================================================*/
/* OP_report.sen -- Operator report                                           */
/*============================================================================*/

" OP_report.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: reportOp_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: reportOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: reportOp_EntBuffer \handler

  //"Operand:- ZK_ENTBUFFER" .verbose
  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: reportOp_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  File0[].get file.close
  File0[].get file.delete
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_IRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: reportOp_IrwBuffer \handler

  //"Operand:- ZK_IRWBUFFER" .verbose
  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then
 
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_SRTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: reportOp_SrtBuffer \handler

  //"Operand:- ZK_SRTBUFFER" .verbose
  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: reportOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for writing
  file::new to File0[]
  <fileNm> OPEN_WRITE File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  then

  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: reportOp_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for reportOp request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: reportOp_req ( -- )

  LogEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of reportOp_CrwBuffer endof

      ZK_CSVBUFFER of reportOp_CsvBuffer endof

      ZK_ENTBUFFER of reportOp_EntBuffer endof

      ZK_EOSMARKER of reportOp_EosMarker endof

      ZK_IRWBUFFER of reportOp_IrwBuffer endof

      ZK_SRTBUFFER of reportOp_SrtBuffer endof

      ZK_STARTMARKER of reportOp_StartMarker endof

      ZK_STREAMDEF of reportOp_StreamDef endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: reportOp :: reportOp <fileNm> ;

jobInfo: reportOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
