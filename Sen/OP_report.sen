/*============================================================================*/
/* OP_report.sen -- Operator report                                           */
/*============================================================================*/

" OP_report.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: report_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Operand[]

  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: report_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Operand[]

  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: report_EntBuffer \handler

  //"Operand:- ZK_ENTBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Operand[]

  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: report_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  File0[].get file.close
  File0[].get file.delete
  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_IRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: report_IrwBuffer \handler

  //"Operand:- ZK_IRWBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Operand[]

  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then
 
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_SRTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: report_SrtBuffer \handler

  //"Operand:- ZK_SRTBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Operand[]

  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: report_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // open the file for writing
  file::new to File0[]
  <fileNm> OPEN_WRITE File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
  else
    Pipein[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for report request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: report_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: report_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: report_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: report_EntBuffer   ZK_ENTBUFFER   op[].handler!
  find: report_EosMarker   ZK_EOSMARKER   op[].handler!
  find: report_IrwBuffer   ZK_IRWBUFFER   op[].handler!
  find: report_SrtBuffer   ZK_SRTBUFFER   op[].handler!
  find: report_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: report :: report <fileNm> ;

: report opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
