/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose

timer: selectTimer

/*----------------------------------------------------------------------------*/
/* analyse a table                                                            */
/*----------------------------------------------------------------------------*/
: analyze_table ( "<tableNm>" -- <R> )

tp: analyzeTable

ddlLock::grabWrite

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable not if <NIP+ERROR> popTable assertInTables exit then     //REVIEW

  tp ( "<tableNm>" )

  args.metadata if
    "(nodeName VARCHAR, partition INTEGER, strands INTEGER, buffers INTEGER, rowCount INTEGER)"
      metadata!
  then

  analyzeTable ( )

  // set no of rows processed equal to total no of partitions
  grid.partitions task::this task.seitf@ seitf.rowsProcessed

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  tp: analyzedTable

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* detailed analysis of a table                                               */
/*----------------------------------------------------------------------------*/
: danalyze_table ( "<tableNm>" -- <R> )

  tp: danalyze_table

  ddlLock::grabWrite

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> popTable assertInTables exit then

  tp ( "<tableNm>" )

  danalyzeTable ( )

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  tp: danalyzedTable

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* append row buffer into table                                               */
/*----------------------------------------------------------------------------*/
: append_table ( "table", "buffer", "partition" -- <R> )

ddlLock::grabRead

  table.append

  <OK>
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- <R> )

ddlLock::grabRead

  checkEnoughBuffers not if <NIP+ERROR> exit then

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> popTable assertInTables exit then

  //bp::freeSpace .

  tableCopier

  //bp::freeSpace .

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table ( "<tableNm>" -- <R> )

ddlLock::grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeTable     not if <NIP+ERROR> exit then

  makeTable ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* distributed export of a table                                              */
/*----------------------------------------------------------------------------*/
: dist_export_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  // call the distributed exporter
  distTableExporter not if <NIP+ERROR> exit then

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tableNm>" -- <R> )

tp: dropTable

ddlLock::grabWrite

  checkRemoveTable not if <NIP+ERROR> exit then

  tp ( "<tableNm>" )

  removeTable ( ) assert::stack_0

  tp: droppedTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dump_table ( "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> exit then

  dumpTable

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create table sequence                                               */
/*----------------------------------------------------------------------------*/
: end_create_table ( "<tableNm>" -- <R> )

tp: end_create_table

ddlLock::grabWrite

  dup
  checkInTable not if <NIP+ERROR> exit then
  checkIsTable not if <NIP+ERROR> exit then

  //"end_create_table" .

  // create column vector of table and partition
  columnVecTable

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> exit then

  tableExporter not if popTable <NIP+ERROR> exit then

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get a table ref                                                            */
/*----------------------------------------------------------------------------*/
: get_table ( "<tableNm>" -- <R> )

  getTableRef not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables ( -- <R> )

ddlLock::grabRead

  checkInTables not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  //bp::freeSpace .

snap0:

  tableLoader   not if popTable <NIP+ERROR> exit then
  loadIndexes

  //bp::freeSpace .

  // pop table dictionary
  popTable

snap1:
  printClassCounts
  <OK>
;

/*----------------------------------------------------------------------------*/
/* load a table from a stream                                                 */
/*----------------------------------------------------------------------------*/
: load_table_stream ( "<fileNm>" "<tableNm>" -- <R> )

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  //bp::freeSpace .

  tableLoaderStream2 not if <NIP+ERROR> exit then

  //bp::freeSpace .

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* return a table ref                                                         */
/*----------------------------------------------------------------------------*/
: return_table ( -- <R> )

  assert::stack_0

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get sel cursor for sel of table                                            */
/*----------------------------------------------------------------------------*/
: select_table ( "<tableNm>" -- <R> )

  assert::stack_1
  CN_STRVAL assert::class_0

ddlLock::grabRead

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then ( "<tableNm>" )

  // check "<tableNm>" is a table folder within ../tables
  dup checkIsTableFolder not if <NIP+ERROR> exit then ( "<tableNm>" )

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<tableNm>
  dup pushTable assert  ( "<tableNm>" )

  // check "<tablenm"> is a table in ../tables/<tableNm>
  checkIsTable not if <NIP+ERROR> exit then ( "<tableNm>" )

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then ( "<tableNm>" )
  task::this task.seitf@ seitf.table@ assert

  // set the metadata string
  args.metadata if
    "(partition INTEGER, data VARCHAR)" metadata!
  then

  // get a select cursor
  selectTable ( "^selCursor" )

  // pop named table folder off path
  // i.e. task.dicStack will now be back to ../tables
  popTable ( "^selCursor" )
  withinTables assert ( "^selCursor" )

  assert::stack_1
  CN_STRVAL assert::class

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get sel cursor for rgesel of table                                         */
/*----------------------------------------------------------------------------*/
: range_select_table ( "<upper>" "<lower>" "<tableNm>" -- <R> )

  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_STRVAL assert::class_2

ddlLock::grabRead

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then ( "<tableNm>" )

  // check "<tableNm>" is a table folder within ../tables
  dup checkIsTableFolder not if <NIP+ERROR> exit then ( "<tableNm>" )

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<tableNm>
  dup pushTable assert  ( "<tableNm>" )

  // check "<tablenm"> is a table in ../tables/<tableNm>
  checkIsTable not if <NIP+ERROR> exit then ( "<tableNm>" )

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then ( "<tableNm>" )
  task::this task.seitf@ seitf.table@ assert

  // get a select cursor
  rangeSelectTable ( "<^selCursor>" )

  // pop named table folder off path
  // i.e. task.dicStack will now be back to ../tables
  popTable ( "<^selCursor>" )
  withinTables assert ( ^selCursor )

  assert::stack_1
  CN_STRVAL assert::class

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* select from table using index given lower bound                            */
/*----------------------------------------------------------------------------*/
: lower_select_table ( "<lower>" "<tableNm>" -- <R> )

  assert::stack_2
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1

  selectTimer timer.start

  ddlLock::grabRead

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then ( "<tableNm>" )

  // check "<tableNm>" is a table folder within ../tables
  dup checkIsTableFolder not if <NIP+ERROR> exit then ( "<tableNm>" )

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<tableNm>
  dup pushTable assert  ( "<tableNm>" )

  // check "<tablenm"> is a table in ../tables/<tableNm>
  checkIsTable not if <NIP+ERROR> exit then ( "<tableNm>" )

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then ( "<tableNm>" )
  task::this task.seitf@ seitf.table@ assert

  // select with lower bound
  lowerSelectTable

  // pop named table folder off path
  // i.e. task.dicStack will now be back to ../tables
  popTable
  withinTables assert

  selectTimer timer.update
  "select time " .put
  selectTimer timer.millisecs .put "ms" .put .\n

  <OK>
;

/*----------------------------------------------------------------------------*/
/* fetch rows from table using given where string                             */
/*----------------------------------------------------------------------------*/
: fetch_rows_table ( "<where>" "<tableNm>" -- <R> )

  assert::stack_2
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1

  selectTimer timer.start

  ddlLock::grabRead

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then ( "<tableNm>" )

  // check "<tableNm>" is a table folder within ../tables
  dup checkIsTableFolder not if <NIP+ERROR> exit then ( "<tableNm>" )

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<tableNm>
  dup pushTable assert  ( "<tableNm>" )

  // check "<tablenm"> is a table in ../tables/<tableNm>
  checkIsTable not if <NIP+ERROR> exit then ( "<tableNm>" )

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then ( "<tableNm>" )
  task::this task.seitf@ seitf.table@ assert

  // fetch rows from table
  fetchRowsTable

  // pop named table folder off path
  // i.e. task.dicStack will now be back to ../tables
  popTable
  withinTables assert

  selectTimer timer.update
  "fetch time " .put
  selectTimer timer.millisecs .put "ms" .put .\n

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "<tableNm>" -- <R> )

ddlLock::grabWrite

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  sizeTable ( "<size>" )

  args.metadata if
    "(size INTEGER)" metadata!
    display@ if
      "row: (" swap str.cat
      ")\n" str.cat
    then
    1 task::this task.seitf@ seitf.rowsProcessed
  then

  // pop table folder
  popTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get size of tables in the tables folder                                    */
/*----------------------------------------------------------------------------*/
: size_tables (  )

  0 locals| iCount |

  ddlLock::grabWrite

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  args.metadata if
    "(tableName VARCHAR, size VARCHAR)" metadata!

    ""
    0 pathPick dic.lastWord dup iterate
    1 iCount + to iCount
    "row: ('" str.cat

    object@ word.name str.cat

    "', '" str.cat

    // push table dictionary
    object@ word.name pushTable assert

    // check it is a table
    object@ word.name
    checkIsTable  not if <NIP+ERROR> exit then

    find execute
    table.space bytes.magnitude str.cat
    "')" str.cat

    // pop table dictionary
    popTable

    "\n" str.cat

    object@ word.prev object!

    next
    iCount task::this task.seitf@ seitf.rowsProcessed
  else
    ""
    0 pathPick dic.lastWord dup iterate

      dup str.length if "\n" str.cat then

      object@ word.name 12 str.pad str.cat

      "(" str.cat

      "table " str.cat

      // push table dictionary
      object@ word.name pushTable assert

      // check it is a table
      object@ word.name
      checkIsTable  not if <NIP+ERROR> exit then

      find execute
      table.space bytes.magnitude str.cat

      ")" str.cat

      // pop table dictionary
      popTable

      object@ word.prev object!

    next
  then

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  truncateTable

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: table_inuse ( "<tableNm>" -- <R> )

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  tableInUse
  if
    "table in use" .
  else
    "table not in use" .
  then

  // pop table dictionary
  popTable

   <OK>
;

