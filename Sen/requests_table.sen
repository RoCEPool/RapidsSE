/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose

/*----------------------------------------------------------------------------*/
/* analyse a table                                                            */
/*----------------------------------------------------------------------------*/
: analyze_table ( "<tableNm>" -- <R> )

tp: dropTable

ddlLock.grabWrite

  dup
  checkInTable      not if <NIP+ERROR> exit then
  checkIsTable       not if <NIP+ERROR> exit then

  tp ( "<tableNm>" )

  analyzeTable ( )

  tp: analyzedTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* detailed analysis of a table                                               */
/*----------------------------------------------------------------------------*/
: danalyze_table ( "<tableNm>" -- <R> )

  tp: dropTable

  ddlLock.grabWrite

  dup
  checkInTable       not if <NIP+ERROR> exit then
  checkIsTable       not if <NIP+ERROR> exit then

  tp ( "<tableNm>" )

  danalyzeTable ( )

  tp: danalyzedTable

  <SUCCESS>
;


/*----------------------------------------------------------------------------*/
/* append row buffer into table                                               */
/*----------------------------------------------------------------------------*/
: append_table ( "table", "buffer", "partition" -- <R> )

ddlLock.grabRead

  table.append

  <OK>
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copy_table ( "<to-tableNm>" "<from-tableNm>" -- <R> )

ddlLock.grabRead

  checkEnoughBuffers not if <NIP+ERROR> exit then
  dup
  checkInTable      not if <NIP+ERROR> exit then
  checkIsTable       not if <NIP+ERROR> exit then

  //bp.freespace .

  tableCopier

  //bp.freespace .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: create_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeTable     not if <NIP+ERROR> exit then

  makeTable ( ) assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* distributed export of a table                                              */
/*----------------------------------------------------------------------------*/
: dist_export_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

  dup
  checkInTable  not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  distTableExporter not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: drop_table ( "<tableNm>" -- <R> )

tp: dropTable

ddlLock.grabWrite

  checkRemoveTable not if <NIP+ERROR> exit then

  tp ( "<tableNm>" )

  removeTable ( ) assert.stack_0

  tp: droppedTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dump_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

  dup
  checkInTable not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  dumpTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create table sequence                                               */
/*----------------------------------------------------------------------------*/
: end_create_table ( "<tableNm>" -- <R> )

tp: end_create_table

ddlLock.grabWrite

  dup
  checkInTable not if <NIP+ERROR> exit then
  checkIsTable not if <NIP+ERROR> exit then

  "end_create_table" .
  dup .

  columnVecTable

  assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: export_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

  dup
  checkInTable not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  tableExporter not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get a table ref                                                            */
/*----------------------------------------------------------------------------*/
: get_table ( "<tableNm>" -- <R> )

  getTableRef not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: list_tables ( -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: load_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock.grabRead

  dup
  checkInTable  not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  //bp.freespace .

snap0:

  tableLoader   not if <NIP+ERROR> exit then
  loadIndexes

  //bp.freespace .

snap1:
  printClassCounts
  <OK>
;

/*
: load_table ( "<fileNm>" "<tableNm>" -- <R> )

  ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  //bp.freespace .

  tableLoader   not if <NIP+ERROR> exit then

  //bp.freespace .

  <OK>
;
*/

/*----------------------------------------------------------------------------*/
/* load a table from a stream                                                 */
/*----------------------------------------------------------------------------*/
: load_table_stream ( "<fileNm>" "<tableNm>" -- <R> )

  ddlLock.grabRead

  dup
  checkInTable  not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  //bp.freespace .

  tableLoaderStream2 not if <NIP+ERROR> exit then

  //bp.freespace .

  <OK>
;

/*----------------------------------------------------------------------------*/
/* return a table ref                                                         */
/*----------------------------------------------------------------------------*/
: return_table ( )

  returnTableRef not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get row cursor for table                                                   */
/*----------------------------------------------------------------------------*/
: select_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

  getTableRef not if <NIP+ERROR> exit then

  selectTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get row cursor for table                                                   */
/*----------------------------------------------------------------------------*/
: range_select_table ( "<tableNm>" -- <R> )

  ddlLock.grabRead

  getTableRef not if <NIP+ERROR> exit then

  selectTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: size_table ( "<tableNm>" -- <R> )

ddlLock.grabWrite

  dup
  checkInTable  not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  sizeTable ( "<size>" )

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncate_table ( "<tableNm>" -- <R> )

ddlLock.grabRead

  dup
  checkInTable  not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  truncateTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: table_inuse ( "<tableNm>" -- <R> )

  dup
  checkInTable  not if <NIP+ERROR> exit then
  checkIsTable  not if <NIP+ERROR> exit then

  tableInUse
  if
    "table in use" .
  else
    "table not in use" .
  then

   <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
