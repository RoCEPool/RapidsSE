/*----------------------------------------------------------------------------*/
/* parallel load a table                                                      */
/*----------------------------------------------------------------------------*/
: distParallelLoadTable_req ( "<sameMachine>" "<fileNm>" "<tableNm>" -- <R> )

  ddlLock::grabRead

  0 locals| pSEitf sTableNm sFileNm sSameMachine |

tp: distParallelLoadTable_req

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert

  // check it is a table
  sTableNm checkIsTable  not if <NIP+ERROR> exit then
  drop

  // get this tasks seitf
  task::this task.seitf@ to pSEitf

  // push originating tasks seitf
  pSEitf >str ( "seitf" )

  // push originating node no
  grid::thisNode@ ( "seitf" iNode )

  // push field delimiter
  pSEitf seitf.fieldDelimiter@ ( "seitf" iNode "<fieldDelimiter>" )

  // push file path
  sFileNm  ( "seitf" iNode "<fieldDelimiter>" "<fileNm>" )

  // push whether running on same machine ?
  sSameMachine  ( "seitf" iNode "<fieldDelimiter>" "<fileNm>" "<sameMachine>")

  // push table name
  sTableNm ( "seitf" iNode "<fieldDelimiter>" "<fileNm>" "<sameMachine>" "<tableNm>" )

  // push schema name
  2 pathPick dic.name  ( "seitf" iNode "<fieldDelimiter>" "<fileNm>" "<sameMachine>" "<tableNm>" "<schemaNm>" )

  // push catalog name
  4 pathPick dic.name  ( "seitf" iNode "<fieldDelimiter>" "<fileNm>" "<sameMachine>" "<tableNm>" "<schemaNm>" "<catalogNm>" )

  // set acks remaining to be no of nodes
  grid::nodes pSEitf seitf.acksRemaining!

  // invoke the disParallelTableLoader that spawn the parallel loader on each node
  distParallelTableLoader

  // wait for all distributed loaders to finish and ack
  begin
    pSEitf seitf.acksRemaining@
    while
      1 thread.sleep_s
  repeat

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* return a table ref                                                         */
/*----------------------------------------------------------------------------*/
: returnTable_req ( -- <R> )

  assert::stack_0

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: sizeTable_req ( "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then
  drop

  sizeTable ( "<size>" )

  args.metadata if
    "(size INTEGER)" metadata!
    display@ if
      "row: (" swap str.cat
      ")\n" str.cat
    then
    1 task::this task.seitf@ seitf.rowsProcessed
  then

  // pop table folder
  popTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get size of tables in the tables folder                                    */
/*----------------------------------------------------------------------------*/
: sizeTables_req (  )

  0 locals| iCount |

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  args.metadata if
    "(tableName VARCHAR, size VARCHAR)" metadata!

    ""
    0 pathPick dic.lastWord dup iterate
    1 iCount + to iCount
    "row: ('" str.cat

    object@ word.name str.cat

    "', '" str.cat

    // push table dictionary
    object@ word.name pushTable assert

    // check it is a table
    object@ word.name
    checkIsTable  not if <NIP+ERROR> exit then
    drop

    // push indexes folder
    pushIndexes assert

    //get size of hidden index
    "hidden" sizeIndex str.cat

    // pop indexes folder
    popIndexes

    // pop table folder
    popTable

    "')\n" str.cat

    object@ word.prev object!

    next
    iCount task::this task.seitf@ seitf.rowsProcessed
  else

    ""
    0 pathPick dic.lastWord dup iterate

      dup str.length if "\n" str.cat then

      object@ word.name 12 str.pad str.cat

      "(" str.cat

      "table " str.cat

      // push table dictionary
      object@ word.name pushTable assert

      // check it is a table
      object@ word.name
      checkIsTable  not if <NIP+ERROR> exit then
      drop

      // push indexes folder
      pushIndexes assert

      // get size if hidden index
      "hidden" sizeIndex str.cat

      // pop indexes folder
      popIndexes

      // pop table dictionary
      popTable

      ")" str.cat

      object@ word.prev object!

    next
  then

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncateTable_req ( "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  truncateTable assert::stack_0

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: tableInuse_req ( "<tableNm>" -- <R> )

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  tableInUse
  if
    "table in use" .
  else
    "table not in use" .
  then

  // pop table dictionary
  popTable

   <OK>
;

