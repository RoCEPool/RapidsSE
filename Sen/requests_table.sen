/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: loadTable_req ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  locals| sTableNm sFileNm |

  //sRT "record terminator %v" str.format .
  //sFS "field separator %v" str.format .
  //sENC "enclosed by %v" str.format .
  //sESC "escape character %v" str.format .

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert

  // check it is a table
  sTableNm checkIsTable  not if <NIP+ERROR> exit then
  drop

  //bp::freeSpace .

snap0:
 
   sFileNm sTableNm tableLoader not if popTable <NIP+ERROR> exit then
  //loadIndexes

  //bp::freeSpace .

  // pop table dictionary
  popTable

snap1:
  printClassCounts
  <OK>
;

