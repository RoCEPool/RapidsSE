/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose

timer: selectTimer

/*----------------------------------------------------------------------------*/
/* analyse a table                                                            */
/*----------------------------------------------------------------------------*/
: analyzeTable_req ( "<tableNm>" -- <R> )

tp: analyzeTable

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable not if <NIP+ERROR> popTable assertInTables exit then     //REVIEW

  tp ( "<tableNm>" )

  args.metadata if
    args.metadata if
       "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, entries INTEGER)"
       metadata!
    then
  then

  analyzeTable ( )

  // set no of rows processed equal to total no of partitions
  grid.partitions task::this task.seitf@ seitf.rowsProcessed

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  tp: analyzedTable

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* detailed analysis of a table                                               */
/*----------------------------------------------------------------------------*/
: danalyzeTable_req ( "<tableNm>" -- <R> )

  tp: danalyzeTable_req

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> popTable assertInTables exit then

  tp ( "<tableNm>" )

  danalyzeTable ( )

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  tp: danalyzedTable

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* insert entries from row buffer into table                                  */
/*----------------------------------------------------------------------------*/
: insertTableEntries_req ( "table", "buffer", "partition" -- <R> )

ddlLock::grabRead

  table.insertEntries

  <OK>
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copyTable_req ( "<to-tableNm>" "<from-tableNm>" -- <R> )

ddlLock::grabRead

  checkEnoughBuffers not if <NIP+ERROR> exit then

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> popTable assertInTables exit then

  //bp::freeSpace .

  tableCopier

  //bp::freeSpace .

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: createTable_req ( "<tableNm>" -- <R> )

ddlLock::grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeTable     not if <NIP+ERROR> exit then

  makeTable ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* distributed export of a table                                              */
/*----------------------------------------------------------------------------*/
: distExport_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  // call the distributed exporter
  distTableExporter not if <NIP+ERROR> exit then

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: dropTable_req ( "<tableNm>" -- <R> )

tp: dropTable

ddlLock::grabWrite

  checkRemoveTable not if <NIP+ERROR> exit then

  tp ( "<tableNm>" )

  removeTable ( ) assert::stack_0

  tp: droppedTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dumpTable_req ( "<tableNm>" -- <R> )

  locals| sTableNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump index

  "hidden" find execute
  index.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: dumpedTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create table sequence                                               */
/*----------------------------------------------------------------------------*/
: endCreateTable_req ( "<tableNm>" -- <R> )

tp: endCreateTable_req

ddlLock::grabWrite

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> popTable exit then

  //"endCreateTable_req" .

  // create column vector of table and partition
  columnVecTable

  assert::stack_0

  // pop table dictionary
  popTable

  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: exportTable_req ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> exit then

  tableExporter not if popTable <NIP+ERROR> exit then

  // pop table dictionary
  popTable

  <OK>
;

