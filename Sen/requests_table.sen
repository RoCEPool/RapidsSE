/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose

timer: selectTimer

/*----------------------------------------------------------------------------*/
/* analyse a table                                                            */
/*----------------------------------------------------------------------------*/
: analyzeTable_req ( "<tableNm>" -- <R> )

tp: analyzeTable

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable not if <NIP+ERROR> popTable assertInTables exit then     //REVIEW

  tp ( "<tableNm>" )

  args.metadata if
    args.metadata if
       "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, entries INTEGER)"
       metadata!
    then
  then

  analyzeTable ( )

  // set no of rows processed equal to total no of partitions
  grid.partitions task::this task.seitf@ seitf.rowsProcessed

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  tp: analyzedTable

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* detailed analysis of a table                                               */
/*----------------------------------------------------------------------------*/
: danalyzeTable_req ( "<tableNm>" -- <R> )

  tp: danalyzeTable_req

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> popTable assertInTables exit then

  tp ( "<tableNm>" )

  danalyzeTable ( )

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  tp: danalyzedTable

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* insert entries from row buffer into table                                  */
/*----------------------------------------------------------------------------*/
: insertTableEntriesSlot_req ( tablePtr, bufferPtr, slot -- <R> )

  ddlLock::grabRead

  table.insertEntries

  <OK>
;

/*----------------------------------------------------------------------------*/
/* insert buffer entries to partition of given named table                    */
/*----------------------------------------------------------------------------*/
: insertBufferEntries$ ( pSEitf iNode entryBuffer bIsLast partitionNo "<tableNm>" -- true )

tp: insertBufferEntries$
  0 locals| pTable sTableNm iPartitionNo bIsLast pEntryBuffer iNode pSEitf |

  // why:
  //   we have forwarded a full entryBuffer whose entries need to be
  //   inserted to partition of table

  // where:
  //   in participant task running pLoop on participant thread;

  // what:
  //   find named table to get pointer to table
  //   then append row buffer to partition of table

  //1 task::this task.thread thread.name@ str.left "p" str.equal assert

  args.tracepoint if
    sTableNm "INSERTING ENTRYBUFFER ENTRIES" swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  //"insertBufferEntries$" .
  //pEntryBuffer .

  // get ^table
  sTableNm pushTable assert
  sTableNm find execute ( rb ptn table )
  to pTable
  popTable

  // is it the last buffer ?
  bIsLast if
    pEntryBuffer entryBuffer.isLast!
  then

  // set the partition in the row buffer
  iPartitionNo pEntryBuffer entryBuffer.partition!

  pSEitf iNode pEntryBuffer iPartitionNo pTable    ( rb ptn tablePtr )

  5 "partitionInsertBufferEntries" iPartitionNo grid::toSlot dup >partitionTaskNm
  TK_LOADSUB_PART

  spawnPartitionTask

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* partition task inserts the entry buffer entries to the table               */
/*----------------------------------------------------------------------------*/
: partitionInsertBufferEntries ( pSEitf iNode entryBuffer partitionNo table^ -- )

  tp: partitionInsertBufferEntries
  0 locals| bIsLast pTable iPartitionNo pEntryBuffer iNode pSEitf |

  //"partitionInsertBufferEntries" .
  //pEntryBuffer .

  pEntryBuffer entryBuffer.isLast@ to bIsLast

  iPartitionNo grid::toSlot >str pEntryBuffer >str pTable >str table.insertEntries ( )

  bIsLast not if exit then
  //drop exit


  //"sending got for last buffer..." .
  //iPartitionNo grid::toSlot .

  <<
  pSEitf        ( << pSEitf )
  "ackSEitf$"   ( << pSEitf "ackSEitf$" )

  tp: theIndirectCall

  >>            ( <<ackSEitf$>> )


  // to which node/participant
  iNode  ( <<ackSEitf$>> node )

  //"forwarding ackSEitf$ to coordinator..." .
  // forward to coordinator and wait
  >>oneParticipant> ( bool )
  //"got reply from ackSEitf$..." .

  checkResult

;

/*----------------------------------------------------------------------------*/
/* insert entries from row buffer into table                                  */
/*----------------------------------------------------------------------------*/
: insertTableEntries_req ( partition, entryBuffer, tableName -- <R> )

  0 0 locals| pEntryBuffer iPartitionNo pTableName sEntryBuffer sPartitionNo |

tp: insertTableEntries_req

  sPartitionNo str.tailInt assert to iPartitionNo

  sEntryBuffer EntryBuffer::toEntryBuffer to pEntryBuffer

  //"insertTableEntries_req" .
  //iPartitionNo .
  //pEntryBuffer .

  <<
  task::this task.seitf@ 
  grid.thisNode@

      ( << rb )
  pEntryBuffer
  pEntryBuffer entryBuffer.isLast@
  iPartitionNo                       ( << rb ptn )
  pTableName                         ( << rb ptn "<tableNm>" )
  "insertBufferEntries$"             ( << rb ptn "<tableNm>" "insertBufferEntries$" )

  tp: theIndirectCall

  >>                       ( <<insertBufferEntries$>> )

  //
  // b) <<insertBufferEntries$>> to be forwarded to one participant
  //    via sendParticipant in the coordinatoor
  //

  // to which node/participant
  iPartitionNo grid::toNode  ( <<insertBufferEntries$>> node )

  // forward to coordinator and wait
  >>oneParticipant> ( bool )

  tp: theIndirectResult

  checkResult

  <OK>
;

/*----------------------------------------------------------------------------*/
/* copy a table. from-table must exist & to-table is created                  */
/*----------------------------------------------------------------------------*/
: copyTable_req ( "<to-tableNm>" "<from-tableNm>" -- <R> )

ddlLock::grabRead

  checkEnoughBuffers not if <NIP+ERROR> exit then

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> popTable assertInTables exit then

  //bp::freeSpace .

  tableCopier

  //bp::freeSpace .

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* create a table                                                             */
/*----------------------------------------------------------------------------*/
: createTable_req ( "<tableNm>" -- <R> )

ddlLock::grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeTable     not if <NIP+ERROR> exit then

  makeTable ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* distributed export of a table                                              */
/*----------------------------------------------------------------------------*/
: distExport_table ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  // call the distributed exporter
  distTableExporter not if <NIP+ERROR> exit then

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop a table                                                               */
/*----------------------------------------------------------------------------*/
: dropTable_req ( "<tableNm>" -- <R> )

tp: dropTable

ddlLock::grabWrite

  checkRemoveTable not if <NIP+ERROR> exit then

  tp ( "<tableNm>" )

  removeTable ( ) assert::stack_0

  tp: droppedTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump table                                                                 */
/*----------------------------------------------------------------------------*/
: dumpTable_req ( "<tableNm>" -- <R> )

  locals| sTableNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump index

  "hidden" find execute
  index.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: dumpedTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create table sequence                                               */
/*----------------------------------------------------------------------------*/
: endCreateTable_req ( "<tableNm>" -- <R> )

tp: endCreateTable_req

ddlLock::grabWrite

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> popTable exit then

  //"endCreateTable_req" .

  // create column vector of table and partition
  columnVecTable

  assert::stack_0

  // pop table dictionary
  popTable

  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* export a table                                                             */
/*----------------------------------------------------------------------------*/
: exportTable_req ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable       not if <NIP+ERROR> exit then

  tableExporter not if popTable <NIP+ERROR> exit then

  // pop table dictionary
  popTable

  <OK>
;

