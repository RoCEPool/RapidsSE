;

/*----------------------------------------------------------------------------*/
/* get list of tables                                                         */
/*----------------------------------------------------------------------------*/
: listTables_req ( -- <R> )

ddlLock::grabRead

  checkInTables not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* load a table                                                               */
/*----------------------------------------------------------------------------*/
: loadTable_req ( "<fileNm>" "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  //bp::freeSpace .

snap0:

  tableLoader   not if popTable <NIP+ERROR> exit then
  //loadIndexes

  //bp::freeSpace .

  // pop table dictionary
  popTable

snap1:
  printClassCounts
  <OK>
;

/*----------------------------------------------------------------------------*/
/* load a table from a stream                                                 */
/*----------------------------------------------------------------------------*/
: loadTableStream_req ( "<fileNm>" "<tableNm>" -- <R> )

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  //bp::freeSpace .

  tableLoaderStream2 not if <NIP+ERROR> exit then

  //bp::freeSpace .

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* return a table ref                                                         */
/*----------------------------------------------------------------------------*/
: returnTable_req ( -- <R> )

  assert::stack_0

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of table                                                          */
/*----------------------------------------------------------------------------*/
: sizeTable_req ( "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then
  drop

  sizeTable ( "<size>" )

  args.metadata if
    "(size INTEGER)" metadata!
    display@ if
      "row: (" swap str.cat
      ")\n" str.cat
    then
    1 task::this task.seitf@ seitf.rowsProcessed
  then

  // pop table folder
  popTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get size of tables in the tables folder                                    */
/*----------------------------------------------------------------------------*/
: sizeTables_req (  )

  0 locals| iCount |

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  args.metadata if
    "(tableName VARCHAR, size VARCHAR)" metadata!

    ""
    0 pathPick dic.lastWord dup iterate
    1 iCount + to iCount
    "row: ('" str.cat

    object@ word.name str.cat

    "', '" str.cat

    // push table dictionary
    object@ word.name pushTable assert

    // check it is a table
    object@ word.name
    checkIsTable  not if <NIP+ERROR> exit then
    drop

    // push indexes folder
    pushIndexes assert

    //get size of hidden index
    "hidden" sizeIndex str.cat

    // pop indexes folder
    popIndexes

    // pop table folder
    popTable

    "')\n" str.cat

    object@ word.prev object!

    next
    iCount task::this task.seitf@ seitf.rowsProcessed
  else

    ""
    0 pathPick dic.lastWord dup iterate

      dup str.length if "\n" str.cat then

      object@ word.name 12 str.pad str.cat

      "(" str.cat

      "table " str.cat

      // push table dictionary
      object@ word.name pushTable assert

      // check it is a table
      object@ word.name
      checkIsTable  not if <NIP+ERROR> exit then
      drop

      // push indexes folder
      pushIndexes assert

      // get size if hidden index
      "hidden" sizeIndex str.cat

      // pop indexes folder
      popIndexes

      // pop table dictionary
      popTable

      ")" str.cat

      object@ word.prev object!

    next
  then

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate table                                                             */
/*----------------------------------------------------------------------------*/
: truncateTable_req ( "<tableNm>" -- <R> )

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  truncateTable

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* any outstanding table references                                           */
/*----------------------------------------------------------------------------*/
: tableInuse_req ( "<tableNm>" -- <R> )

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  dup checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  dup pushTable assert

  // check it is a table
  checkIsTable  not if <NIP+ERROR> exit then

  tableInUse
  if
    "table in use" .
  else
    "table not in use" .
  then

  // pop table dictionary
  popTable

   <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
