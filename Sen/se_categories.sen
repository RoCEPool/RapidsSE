/*============================================================================*/
/* se_categories.sen -- categories                                            */
/*============================================================================*/

" se_categories.sen" .verbose

/*----------------------------------------------------------------------------*/
/* categorising word                                                          */
/*----------------------------------------------------------------------------*/
: \\category immediate

  //
  // this word is used while compiling another word.
  // let us call that another word the catgWord.
  // this word sets the catgWord being compiled to be an immediate word.
  // that catgWord is then later used to set yet another word being comiled
  //   to have the category of catgWord.
  // let us call that yet another word the targetWord
  //

  // while compiling a new catgWord set the catgWord to be immediate
  true
  compiler::current@
  word.immediate!

  // add code into the catgWord so that when catgWord ised used while compiling
  // the target word, the category of the target word is set to be catgWord
  compiler::current@ encode::push
  POSTPONE compiler::current@
  POSTPONE word.category!
;

/*----------------------------------------------------------------------------*/
/* prompt category                                                            */
/*----------------------------------------------------------------------------*/
: \prompt \\category ;

: prompts \prompt find: \prompt word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* demon category                                                             */
/*----------------------------------------------------------------------------*/
: \demon \\category ;

: demons \prompt find: \demon word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* folder is used as a kind of word to identify folders                       */
/*----------------------------------------------------------------------------*/
: \folder \\category ;

: isFolder word.category@ find: \folder eql ;

: folders \prompt find: \folder word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* handler category                                                           */
/*----------------------------------------------------------------------------*/
: \handler \\category ;

: handlers \prompt find: \handler word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* include category                                                           */
/*----------------------------------------------------------------------------*/
: \include \\category ;

: includes \prompt find: \include word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* operator category                                                          */
/*----------------------------------------------------------------------------*/
: \operator \\category ;

: operators \prompt find: \operator word::ofCatg ;
: ops       \prompt find: \operator word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* procedure category                                                         */
/*----------------------------------------------------------------------------*/
: \procedure \\category ;



/*----------------------------------------------------------------------------*/
/* list all words in the current dictionary                                   */
/*----------------------------------------------------------------------------*/
: words \prompt

  iterate-words
    word@ word.name@ str.length word@ word.name@ "word: %32v %v" .printf
  next-word
;
/*----------------------------------------------------------------------------*/
//: words \prompt
//
//  //folder[] dic.lastWord dup
//  dic::root dic.lastWord dup
//  iterate                        // iterate word cursor
//    object@ word.name@ .         // print the name of the word
//    object@ word.prev object!    // advance cursor backwards thru words
//  next
//;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: lw \prompt

  0 0 locals| pWord pCatg |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor

    object@ to pWord

    pWord word.show

    object@ word.prev object!             // advance cursor backwards thru words
  next
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
