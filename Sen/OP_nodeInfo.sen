/*============================================================================*/
/* OP_nodeInfo.sen -- Operator node info                                      */
/*============================================================================*/

" OP_nodeInfo.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: nodeInfo_action

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] streamSet[].new

  // add nodeInfo to the infoSet
  streamSetTable[] streamSet[].addNodeInfo assert

  // pipeout the infoset
  streamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: NodeInfo :: NodeInfo ;

: nodeInfo opInfo tagCopy: liteOp_tags
tags{
  <jobDesc>   = "--description of operator--"
  <liteOp>    = true
  <streamDef> = __nodeInfo
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
