/*============================================================================*/
/* OP_nodeInfo.sen -- Operator node info                                      */
/*============================================================================*/

" OP_nodeInfo.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: nodeInfo_action

  // create an infoSet operand
  StreamDef[] InfoSet[].newInfoSet

  // add nodeInfo to the infoSet
  StreamDef[] InfoSet[].addNodeInfo assert

  // pipeout the streamDef
  StreamDef[].pipeout

  // pipeout the infoset
  InfoSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: NodeInfo :: NodeInfo ;

: nodeInfo opInfo tagCopy: liteOp_tags
tags{
  <jobDesc>   = "--description of operator--"
  <liteOp>    = true
  <streamDef> = __nodeInfo
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
