/*============================================================================*/
/* OP_nodeInfo.sen -- Operator node info                                      */
/*============================================================================*/

" OP_nodeInfo.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: nodeInfo_action

  // find the __ table
  <streamDef> op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] infoSet[].new

  // add nodeInfo to the infoSet
  infoSetTable[] infoSet[].addnodeInfo assert

  // pipeout the infoset
  infoSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: nodeInfo :: nodeInfo ;

: nodeInfo _cmdTags tagCopy: liteOp_tags
tags{
  <cmdDesc>   = "--desc for op--"
  <streamDef> = __nodeInfo
  <params>    = 0
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
