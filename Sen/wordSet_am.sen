/*============================================================================*/
/* wordSet_am.sen -- application mark related words                           */
/*============================================================================*/

" wordSet_am.sen" .verbose

/*----------------------------------------------------------------------------*/
/* mark cancel seed action                                                    */
/*----------------------------------------------------------------------------*/
: an::seed_can immediate

  word::this word.name ,

  POSTPONE AN_SEED_CAN

  POSTPONE ActionSequence::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark end seed action                                                       */
/*----------------------------------------------------------------------------*/
: an::seed_end immediate

  word::this word.name ,

  POSTPONE AN_SEED_END

  POSTPONE ActionSequence::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark exe seed action                                                       */
/*----------------------------------------------------------------------------*/
: an::seed_exe immediate

  word::this word.name ,

  POSTPONE AN_SEED_EXE

  POSTPONE ActionSequence::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark receive seed action                                                   */
/*----------------------------------------------------------------------------*/
: an::seed_rcv immediate

  word::this word.name ,

  POSTPONE AN_SEED_RCV

  POSTPONE ActionSequence::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark run seed action                                                       */
/*----------------------------------------------------------------------------*/
: an::seed_req immediate

  word::this word.name ,

  AN_SEED_REQ ,

  POSTPONE ActionSequence::markSeed
;

/*----------------------------------------------------------------------------*/
/* mark run seed action                                                       */
/*----------------------------------------------------------------------------*/
: an::seed_run immediate

  word::this word.name ,

  AN_SEED_RCV ,

  POSTPONE ActionSequence::markSeed
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* word entry mark                                                            */
/*----------------------------------------------------------------------------*/
: >>am immediate

  // format the string to be printed
  word::this word.name ">>%v" str.format

  // encode push of that string
  ,

  // encode call to markEntry
  POSTPONE ActivityMap::markEntry
;
/*----------------------------------------------------------------------------*/
//: >>am immediate
//
//  POSTPONE job::this
//  POSTPONE job.class
//  POSTPONE class::name
//  ">>%v %v" ,
//
//  POSTPONE str.format
//
//  // encode call to markEntry
//  POSTPONE ActivityMap::markEntry
//;


/*----------------------------------------------------------------------------*/
/* word exit mark                                                             */
/*----------------------------------------------------------------------------*/
: <<am immediate

  // format the string to be printed
  word::this word.name "<<%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE ActivityMap::markExit
;

/*----------------------------------------------------------------------------*/
/* word error mark                                                            */
/*----------------------------------------------------------------------------*/
: !!am immediate

  // format the string to be printed
  word::this word.name "!!%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE ActivityMap::markExit
;

/*----------------------------------------------------------------------------*/
/* activity mark                                                              */
/*----------------------------------------------------------------------------*/
: .am immediate

  // encode call to markEntry
  POSTPONE ActivityMap::mark
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
