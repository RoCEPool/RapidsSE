/*============================================================================*/
/* OP_dump.sen -- Operator dump                                               */
/*============================================================================*/

" OP_dump.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_SEEKOFFSETS ...                                                      */
/*----------------------------------------------------------------------------*/
: dump_SeekOffsets \handler

  ZK_SEEKOFFSETS_handler
;

/*----------------------------------------------------------------------------*/
/* dump request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dump_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dump_SeekOffsets ZK_SEEKOFFSETS op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dump :: dump ;

: dump _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
