/*============================================================================*/
/* cmd_Compiler.sen -- Command Compiler                                       */
/*============================================================================*/

" cmd_compiler.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* consume service arguments                                                  */
/*----------------------------------------------------------------------------*/
: .consumeArgs

  0 locals| nArgs |

  //".consumeArgs" .

  begin
    input::next
    dup ";&" str.equal not
  while
    nArgs 1 + to nArgs
  repeat

  // discard the ";&" from dstack
  discard

  nArgs

  // for the moment we discard the arg vector from the data stack
  dropN
;

/*----------------------------------------------------------------------------*/
/* generate two words, one which parses and another which spawns a service    */
/*----------------------------------------------------------------------------*/
: .generateService params| pInfoWd |

  // calc the name of the service
  "_" pInfoWd word.name@ str.removeSuffix locals| sServiceNm |

  sServiceNm "Service name: %v\n" .printf

  // calc the name of the spawner
  sServiceNm "_spawner" str.cat locals| sSpawnerNm |


  //----------------------------------------------------------------------------
  // SPAWNER

  // create a word by the spawner name
  sSpawnerNm :create compiler::current@ locals| pSpawnerWd |

  // debug
  //pSpawnerWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service spawning word -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // sServiceNm encode::push "++ this is service spawner for: %v" encode::push POSTPONE .printf

  sServiceNm encode::push POSTPONE job::spawnUniversal

  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pSpawnerWd word.dump


  //----------------------------------------------------------------------------
  // PARSER

  // create an immediate word by the service name

  sServiceNm :create compiler::current@ locals| pServiceWd |

  true pServiceWd word.immediate!

  // debug
  //pServiceWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service parsing word  -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // in : <serviceNm> add call(.printf)
  // sServiceNm encode::push "++ this is the service parser for: %v" encode::push POSTPONE .printf

  // in : <serviceNm> add call(.consumeArgs)
  POSTPONE .consumeArgs

  // in : <serviceNm> add code which adds call(` pSpawnerWd) in caller of service
  pSpawnerWd encode::push POSTPONE encode::call

  // in : <serviceNm> add exit
  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pServiceWd word.dump
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add any missing seed tags for a distributed job                            */
/*----------------------------------------------------------------------------*/
: cmd::addSeedsFor_distJob params| pInfoWd |

  "<SeedReq>" "defaultSeedDist" "_req" pInfoWd _info.addSeedToTagSet

  "<SeedRcv>" "defaultSeedDist" "_beg" pInfoWd _info.addSeedToTagSet

  "<SeedExe>" "defaultSeedDist" "_exe" pInfoWd _info.addSeedToTagSet

  "<SeedEnd>" "defaultSeedDist" "_end" pInfoWd _info.addSeedToTagSet

  "<SeedCan>" "defaultSeedDist" "_can" pInfoWd _info.addSeedToTagSet
;

/*----------------------------------------------------------------------------*/
/* add any missing seed tags for a generic job                                */
/*----------------------------------------------------------------------------*/
: cmd::addSeedsFor_genericJob params| pInfoWd |

  "<SeedReq>" "defaultSeedLocal" "_run" pInfoWd _info.addSeedToTagSet
;

/*----------------------------------------------------------------------------*/
/* add any missing seed tags for a local op                                   */
/*----------------------------------------------------------------------------*/
: cmd::addSeedsFor_localOp params| pInfoWd |

  "<SeedReq>" "defaultSeedLocal" "_req" pInfoWd _info.addSeedToTagSet
;

/*----------------------------------------------------------------------------*/
/* add any missing seed tags for a command                                    */
/*----------------------------------------------------------------------------*/
: cmd::addSeeds_info params| pInfoWd |

  pInfoWd word.name@ "Add seeds using _info : %v" .printf

       pInfoWd _info.aboutGenericJob  if pInfoWd cmd::addSeedsFor_genericJob
  else pInfoWd _info.aboutDistJob     if pInfoWd cmd::addSeedsFor_distJob
  else                                   pInfoWd cmd::addSeedsFor_localOp
  then then
;

/*----------------------------------------------------------------------------*/
/* add any setting tags that are missing                                      */
/*----------------------------------------------------------------------------*/
: cmd::addSettings_info params| pInfoWd |

  pInfoWd word.name@ "Adding default tags for : %v" .printf

  pInfoWd word.tagSet@ locals| pInfTags |

  // test and add default for: command kind
  "<cmdKind>" pInfTags tagSet.hasName not if
    "<cmdKind>" "CK_COMMAND" pInfTags tagSet.addTag
  then

  // test and add default for: ddl lock
  "<ddlLock>" pInfTags tagSet.hasName not if
    "<ddlLock>" "DL_NONE" pInfTags tagSet.addTag
  then

  // test and add default for: job desc
  "<jobDesc>" pInfTags tagSet.hasName not if
    "<jobDesc>" "--description  --" pInfTags tagSet.addTag
  then

  // test and add default for: job kind
  "<jobKind>" pInfTags tagSet.hasName not if
    "<jobKind>" "JK_LOCAL" pInfTags tagSet.addTag
  then

  // test and add default for:  priority
  "<priority>" pInfTags tagSet.hasName not if
    "<priority>" "PY_NORMAL" pInfTags tagSet.addTag
  then

  // test and add default for:  response kind
  "<rspKind>" pInfTags tagSet.hasName not if
    "<rspKind>" "RS_NONE" pInfTags tagSet.addTag
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* generate words for a serice (these should be demons)         TO BE REMOVED */
/*----------------------------------------------------------------------------*/
: cmd::genService_info params| pInfoWd |

  pInfoWd word.name@ "Gen service using _info : %v" .printf

  pInfoWd _info.aboutServiceCmd if pInfoWd .generateService then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* synthesize a procedure for a lite op given its info word                   */
/*----------------------------------------------------------------------------*/
: cmd::synthProcFor_liteOp params| pInfoWd |

  pInfoWd word.name_trunc locals| sCmdNm |
  pInfoWd word.tagSet@    locals| pInfTags |

  0 0 locals| iParams sText |

  sCmdNm "LiteOP: %v" .printf

  // add : cmdNm_PulseMarker
  "/liteOp/" sCmdNm tpl_liteOp_PulseMarker str.replace to sText
  sText >interpret

  // add : cmdNm_req
  "/liteOp/" sCmdNm tpl_liteOp_req str.replace to sText
  sText >interpret

  // add procedure depending on no of parameters
  "<params>" pInfTags tagSet.hasName assert
  "<params>" pInfTags tagSet.getStr >int to iParams

  iParams 2 == if
    "/liteOp/" sCmdNm tpl_liteOp_procedure2 str.replace to sText
    sText procedure::add
  else
  iParams 1 == if
    "/liteOp/" sCmdNm tpl_liteOp_procedure1 str.replace to sText
    sText procedure::add
  else
  iParams 0 == assert
    "/liteOp/" sCmdNm tpl_liteOp_procedure0 str.replace to sText
    sText procedure::add
  then then
;

/*----------------------------------------------------------------------------*/
/* synthesize a procedure for a local lite op given its info word             */
/*----------------------------------------------------------------------------*/
: cmd::synthProcFor_localLiteOp params| pInfoWd |

  pInfoWd word.name_trunc locals| sCmdNm |
  pInfoWd word.tagSet@    locals| pInfTags |

  0 0 locals| iParams sText |

  sCmdNm "LocalLiteOP: %v" .printf

  // add : cmdNm_PulseMarker
  "/localLiteOp/" sCmdNm tpl_localLiteOp_PulseMarker str.replace to sText
  sText >interpret

  // add : cmdNm_req
  "/localLiteOp/" sCmdNm tpl_localLiteOp_req str.replace to sText
  sText >interpret

  // add procedure depending on no of parameters
  "<params>" pInfTags tagSet.hasName assert
  "<params>" pInfTags tagSet.getStr >int to iParams

  iParams 2 == if
    "/localLiteOp/" sCmdNm tpl_localLiteOp_procedure2 str.replace to sText
    sText procedure::add
  else
  iParams 1 == if
    "/localLiteOp/" sCmdNm tpl_localLiteOp_procedure1 str.replace to sText
    sText procedure::add
  else
  iParams 0 == assert
    "/localLiteOp/" sCmdNm tpl_localLiteOp_procedure0 str.replace to sText
    sText procedure::add
  then then
;

/*----------------------------------------------------------------------------*/
/* synthesize procedures for lite and local lite operators given info word    */
/*----------------------------------------------------------------------------*/
: cmd::synthProc_info params| pInfoWd |

  pInfoWd word.name@ "Synth proc using _info : %v" .printf

       pInfoWd _info.aboutLiteOp      if pInfoWd cmd::synthProcFor_liteOp
  else pInfoWd _info.aboutLocalLiteOp if pInfoWd cmd::synthProcFor_localLiteOp
  then then
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* define the syntax for a command                                            */
/*----------------------------------------------------------------------------*/
: cmdSyntax:

  //
  //            cmdNm    cmd   arg       arg
  // cmdSyntax: anidx :: anidx <tableNm> <indexNm> ;
  //

  // create a word using next token from input source as the word name
  input::next locals| sCmdNm |
  sCmdNm series-name "_syntax" str.cat :create

  // set the word category to be cmdSyntax:
  [ compiler::current@ encode::push ] compiler::current@ word.category!

  // attach a tag set to hold syntax to the word being created
  tagSet::new locals| pSynTags |
  pSynTags compiler::current@ word.TagSet!

  // skip the :: token from input source
  input::next discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // add a syntax-tag for the command name
  "__cmdNm__" sCmdNm pSynTags tagSet.appendStr

  // add a syntax-tag indicating the job is a unversal job
  "__job__" "CN_JOB_UNIVERSAL" pSynTags tagSet.appendStr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till ';', building tag set representing the syntax

  begin

    input::next ";" str.equal not

    while
           input::isTag  if "__arg__"  input::chars pSynTags tagSet.appendStr
      else input::isJson if "__json__" input::chars pSynTags tagSet.appendStr
      else input::isEtc  if "__etc__"  input::chars pSynTags tagSet.appendStr
      else                  "__cmd__"  input::chars pSynTags tagSet.appendStr
      then then then

  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // pTagSet tagSet.asStr .

  does>
    // ..to be written
    discard
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* show all words that are of cmdSyntax:                                      */
/*----------------------------------------------------------------------------*/
: cmdSyntaxs prompt

  find: cmdSyntax: word::ofCatg
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_all_cmd_usingInfo

  find: _info locals| pOpInfo |

  dic::root dic.lastWord dup
  iterate                                // iterate word cursor

    object@ word.category@ pOpInfo eql if

      // multiple words get synthesized
      object@ cmd::synthProc_info
      object@ cmd::addSeeds_info

      object@ cmd::addSettings_info

      object@ cmd::genService_info       // TO BE REMOVED

    then

    object@ word.prev object!            // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_all_cmd_usingCmdSyntax

  find: cmdSyntax: locals| pCmdSyntax |

  // iterate thru all pOpInfo words

  dic::root dic.lastWord dup
  iterate                                // iterate word cursor

    object@ word.category@ pCmdSyntax eql if
      
    then

    object@ word.prev object!            // advance cursor backwards thru words
  next
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
