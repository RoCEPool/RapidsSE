/*============================================================================*/
/* cmd_Compiler.sen -- Command Compiler                                       */
/*============================================================================*/

" cmd_compiler.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* define the syntax for a command                                            */
/*----------------------------------------------------------------------------*/
: cmdSyntax:

  //
  //            cmdNm    cmd          arg       arg
  // cmdSyntax: anidx :: anidx        <tableNm> <indexNm> ;
  // cmdSyntax: anidx :: analizeIndex <tableNm> <indexNm> ;
  //                     verb   noun
  //

  // create a word using next token from input source as the word name
  input::next locals| sCmdNm |
  sCmdNm series-name "_syntax" str.cat :create

  // set the word category to be cmdSyntax:
  [ compiler::current@ encode::push ] compiler::current@ word.category!

  // attach a tag set to hold syntax to the word being created
  tagSet::new locals| pSynTags |
  pSynTags compiler::current@ word.TagSet!

  // skip the :: token from input source
  input::next discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // add a syntax-tag for the command name
  "__cmdNm__" sCmdNm pSynTags tagSet.appendStr

  // add a syntax-tag indicating the job is a distributed job
  "__job__" "CN_JOB_DISTRIBUTED" pSynTags tagSet.appendStr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till ';', building tag set representing the syntax

  begin

    input::next ";" str.equal not

    while
           input::isTag  if "__arg__"  input::chars pSynTags tagSet.appendStr
      else input::isJson if "__json__" input::chars pSynTags tagSet.appendStr
      else input::isEtc  if "__etc__"  input::chars pSynTags tagSet.appendStr
      else                  "__cmd__"  input::chars pSynTags tagSet.appendStr
      then then then

  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // pTagSet tagSet.asStr .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* show all words that are of cmdSyntax:                                      */
/*----------------------------------------------------------------------------*/
: cmdSyntaxs prompt

  find: cmdSyntax: word::ofCatg
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* consume service arguments                                                  */
/*----------------------------------------------------------------------------*/
: .consumeArgs

  0 locals| nArgs |

  //".consumeArgs" .

  begin
    input::next
    dup ";&" str.equal not
  while
    nArgs 1 + to nArgs
  repeat

  // discard the ";&" from dstack
  discard

  nArgs

  // for the moment we discard the arg vector from the data stack
  dropN
;

/*----------------------------------------------------------------------------*/
/* generate two words, one which parses and another which spawns a service    */
/*----------------------------------------------------------------------------*/
: .generateService params| pwCmdTags |

  pwCmdTags word.name@ "Gen service using _cmdTags : %v" .printf

  // calc the name of the service
  "_" pwCmdTags word.name@ str.removeSuffix locals| sServiceNm |


  sServiceNm "Service name: %v\n" .printf

  // calc the name of the spawner
  sServiceNm "_spawner" str.cat locals| sSpawnerNm |


  //----------------------------------------------------------------------------
  // SPAWNER

  // create a word by the spawner name
  sSpawnerNm :create compiler::current@ locals| pSpawnerWd |

  // debug
  //pSpawnerWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service spawning word -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // sServiceNm encode::push "++ this is service spawner for: %v" encode::push POSTPONE .printf

  sServiceNm encode::push POSTPONE job::spawnUniversal

  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pSpawnerWd word.dump


  //----------------------------------------------------------------------------
  // PARSER

  // create an immediate word by the service name

  sServiceNm :create compiler::current@ locals| pServiceWd |

  true pServiceWd word.immediate!

  // debug
  //pServiceWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service parsing word  -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // in : <serviceNm> add call(.printf)
  // sServiceNm encode::push "++ this is the service parser for: %v" encode::push POSTPONE .printf

  // in : <serviceNm> add call(.consumeArgs)
  POSTPONE .consumeArgs

  // in : <serviceNm> add code which adds call(` pSpawnerWd) in caller of service
  pSpawnerWd encode::push POSTPONE encode::call

  // in : <serviceNm> add exit
  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pServiceWd word.dump
;

/*----------------------------------------------------------------------------*/
/* generate words for a serice (these should be demons)         TO BE REMOVED */
/*----------------------------------------------------------------------------*/
: cmd::genService_info params| pwCmdTags |

  pwCmdTags _cmdTags.aboutServiceCmd if
    pwCmdTags .generateService
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add any missing seed tags for a distributed job                            */
/*----------------------------------------------------------------------------*/
: cmd::addSeedsFor_distJob params| pwCmdTags |

  "<SeedReq>" "defaultSeedDist" "_req" pwCmdTags _cmdTags.addSeedTag

  "<SeedRcv>" "defaultSeedDist" "_beg" pwCmdTags _cmdTags.addSeedTag

  "<SeedExe>" "defaultSeedDist" "_exe" pwCmdTags _cmdTags.addSeedTag

  "<SeedEnd>" "defaultSeedDist" "_end" pwCmdTags _cmdTags.addSeedTag

  "<SeedCan>" "defaultSeedDist" "_can" pwCmdTags _cmdTags.addSeedTag
;

/*----------------------------------------------------------------------------*/
/* add any missing seed tags for a generic job                                */
/*----------------------------------------------------------------------------*/
: cmd::addSeedsFor_genericJob params| pwCmdTags |

  "<SeedReq>" "defaultSeedLocal" "_run" pwCmdTags _cmdTags.addSeedTag
;

/*----------------------------------------------------------------------------*/
/* add any missing seed tags for a local op                                   */
/*----------------------------------------------------------------------------*/
: cmd::addSeedsFor_localOp params| pwCmdTags |

  "<SeedReq>" "defaultSeedLocal" "_req" pwCmdTags _cmdTags.addSeedTag
;

/*----------------------------------------------------------------------------*/
/* add any missing seed tags for a command                                    */
/*----------------------------------------------------------------------------*/
: cmd::addSeeds_info params| pwCmdTags |

  // pwCmdTags word.name@ "Add seeds using _cmdTags : %v" .printf

  pwCmdTags _cmdTags.aboutGenericJob if
    pwCmdTags cmd::addSeedsFor_genericJob
  else
  pwCmdTags _cmdTags.aboutDistJob if
    pwCmdTags cmd::addSeedsFor_distJob
  else
    pwCmdTags cmd::addSeedsFor_localOp
  then then
;

/*----------------------------------------------------------------------------*/
/* add any setting tags that are missing                                      */
/*----------------------------------------------------------------------------*/
: cmd::addSettings_info params| pwCmdTags |

  // pwCmdTags word.name@ "Adding default tags for : %v" .printf

  pwCmdTags word.tagSet@ locals| pCmdTags |

  // test and add default for: command kind
  "<cmdKind>" pCmdTags tagSet.hasName not if
    "<cmdKind>" "CK_COMMAND" pCmdTags tagSet.addTag
  then

  // test and add default for: ddl lock
  "<ddlLock>" pCmdTags tagSet.hasName not if
    "<ddlLock>" "DL_NONE" pCmdTags tagSet.addTag
  then

  // test and add default for: job desc
  "<cmdDesc>" pCmdTags tagSet.hasName not if
    "<cmdDesc>" "--description  --" pCmdTags tagSet.addTag
  then

  // test and add default for: job kind
  "<jobKind>" pCmdTags tagSet.hasName not if
    "<jobKind>" "JK_LOCAL" pCmdTags tagSet.addTag
  then

  // test and add default for:  priority
  "<priority>" pCmdTags tagSet.hasName not if
    "<priority>" "PY_NORMAL" pCmdTags tagSet.addTag
  then

  // test and add default for:  response kind
  "<rspKind>" pCmdTags tagSet.hasName not if
    "<rspKind>" "RS_NONE" pCmdTags tagSet.addTag
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* synthesize the words for a lite op given its info word                     */
/*----------------------------------------------------------------------------*/
: cmd::synthWordsFor_liteOp params| pwCmdTags |

  pwCmdTags word.name_trunc locals| sCmdNm |
  pwCmdTags word.tagSet@    locals| pCmdTags |

  0 locals| sText |

  // sCmdNm "LiteOP: %v" .printf

  // synthesize : cmdNm_PulseMarker
  "/liteOp/" sCmdNm tpl_liteOp_PulseMarker str.replace to sText
  sText >interpret

  // synthesize : cmdNm_req
  "/liteOp/" sCmdNm tpl_liteOp_req str.replace to sText
  sText >interpret
;

/*----------------------------------------------------------------------------*/
/* synthesize the procedure for a lite op given its info word                 */
/*----------------------------------------------------------------------------*/
: cmd::synthProcFor_liteOp params| pwCmdTags |

  pwCmdTags word.name_trunc locals| sCmdNm |
  pwCmdTags word.tagSet@    locals| pCmdTags |

  0 0 locals| sText iParams |

  // sCmdNm "LiteOP: %v" .printf

  // synthesize procedure depending on no of parameters
  "<params>" pCmdTags tagSet.hasName assert
  "<params>" pCmdTags tagSet.getStr >int to iParams

  iParams 2 == if
    "/liteOp/" sCmdNm tpl_liteOp_procedure2 str.replace to sText
    sText procedure::add
  else
  iParams 1 == if
    "/liteOp/" sCmdNm tpl_liteOp_procedure1 str.replace to sText
    sText procedure::add
  else
  iParams 0 == assert
    "/liteOp/" sCmdNm tpl_liteOp_procedure0 str.replace to sText
    sText procedure::add
  then then
;

/*----------------------------------------------------------------------------*/
/* synthesize the words for a local lite op given its info word               */
/*----------------------------------------------------------------------------*/
: cmd::synthWordsFor_localLiteOp params| pwCmdTags |

  pwCmdTags word.name_trunc locals| sCmdNm |
  pwCmdTags word.tagSet@    locals| pCmdTags |

  0 locals| sText |

  // sCmdNm "LocalLiteOP: %v" .printf

  // synthesize : cmdNm_PulseMarker
  "/localLiteOp/" sCmdNm tpl_localLiteOp_PulseMarker str.replace to sText
  sText >interpret

  // synthesize : cmdNm_req
  "/localLiteOp/" sCmdNm tpl_localLiteOp_req str.replace to sText
  sText >interpret
;

/*----------------------------------------------------------------------------*/
/* synthesize the procedure for a local lite op given its info word           */
/*----------------------------------------------------------------------------*/
: cmd::synthProcFor_localLiteOp params| pwCmdTags |

  pwCmdTags word.name_trunc locals| sCmdNm |
  pwCmdTags word.tagSet@    locals| pCmdTags |

  0 0 locals| sText iParams |

  // sCmdNm "LocalLiteOP: %v" .printf

  // synthesize procedure depending on no of parameters
  "<params>" pCmdTags tagSet.hasName assert
  "<params>" pCmdTags tagSet.getStr >int to iParams

  iParams 2 == if
    "/localLiteOp/" sCmdNm tpl_localLiteOp_procedure2 str.replace to sText
    sText procedure::add
  else
  iParams 1 == if
    "/localLiteOp/" sCmdNm tpl_localLiteOp_procedure1 str.replace to sText
    sText procedure::add
  else
  iParams 0 == assert
    "/localLiteOp/" sCmdNm tpl_localLiteOp_procedure0 str.replace to sText
    sText procedure::add
  then then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_synthProcs_usingInfo

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words

    word@ word.category@ pwCmdTagsCatg eql if

      word@ _cmdTags.aboutLiteOp if
        word@ cmd::synthProcFor_liteOp
      else
      word@ _cmdTags.aboutLocalLiteOp if
        word@ cmd::synthProcFor_localLiteOp
      then then

    then

  next-word
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_synthWords_usingInfo

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words

    word@ word.category@ pwCmdTagsCatg eql if

      word@ _cmdTags.aboutLiteOp if
        word@ cmd::synthWordsFor_liteOp
      else
      word@ _cmdTags.aboutLocalLiteOp if
        word@ cmd::synthWordsFor_localLiteOp
      then then

    then

  next-word
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_seedTagsInInfo

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words

    word@ word.category@ pwCmdTagsCatg eql if

      word@ cmd::addSeeds_info

    then

  next-word
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_tagSettingsInInfo

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words

    word@ word.category@ pwCmdTagsCatg eql if

      word@ cmd::addSettings_info

    then

  next-word
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_services_usingInfo

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words

    word@ word.category@ pwCmdTagsCatg eql if

      word@ cmd::genService_info       // TO BE REMOVED

    then

  next-word
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_allCmds

  [? 1 ?if
  
    cmd::fillOut_synthWords_usingInfo
    cmd::fillOut_synthProcs_usingInfo

    cmd::fillOut_seedTagsInInfo
    cmd::fillOut_tagSettingsInInfo   

    // to be removed
    cmd::fillOut_services_usingInfo

  ?else
   
   
  ?]
;

/*============================================================================*/
/* end                                                                        */
