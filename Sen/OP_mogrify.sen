/*============================================================================*/
/* OP_mogrify_.sen -- create temp copies of permanent crw buffers             */
/*============================================================================*/

" OP_mogrify_.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                     CRWBUFFER */
/*----------------------------------------------------------------------------*/
: mogrify_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  Operand[].crwDuplicate to operandB[]
  nullptr to Operand[]

  OperandB[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for mogrify_ req                                                SPAWN */
/*----------------------------------------------------------------------------*/
 : mogrify_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: mogrify_CrwBuffer  ZK_CRWBUFFER op[].handler!
 
  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: mogrify :: mogrify ;

: mogrify _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
