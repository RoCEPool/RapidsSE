/*============================================================================*/
/* job_BM_GenCrwOp.sen -- Generate Compact Row Buffers Operator               */
/*============================================================================*/

" job_BM_GenCrwOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenCrw_PulseMarker

  // pipe out the pulse marker to the next operator
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // new a stream def
  Operand[].newStreamDef

  Operand[].pipeOut

  // generate the crw buffer's
  //<nBuffers> index[].genCrwBuffers to Operand[]
  Operand[].pipeoutSet

  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenCrw_StartMarker

  "BM_GenEnt_StartMarker" .

  op__table_index

  folderPath.str     "Folder path: %v" .printf
  folderContents.str "contains: %v" .printf

  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* BM_GenCrwOp request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_GenCrwOp_req ( -- )

  >>logEntry <SEED_REQ>

  job::this locals| pJob_BM_GenCrwOp |
  0 locals| pTable |

  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode operand kind
    Operand[].kind case

      ZK_PULSEMARKER of BM_GenCrw_PulseMarker true endof

      ZK_STARTMARKER of BM_GenCrw_StartMarker true endof

      jobOperand::generic swap

    endcase

  while assert::stack_0 repeat

  "*** BM_GenCrwOp EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: BM_GenCrwOp :: BM_GenCrwOp <tableNm> <nBuffers>
                                      <topology> <nextStage> <nextOp> ;

jobInfo: BM_GenCrwOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
