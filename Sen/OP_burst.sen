/*============================================================================*/
/* OP_burst.sen -- Burst Operator                                             */
/*============================================================================*/

" OP_burst.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: OP_burst_EosMarker \handler

  "OP_burst_EosMarker" .

  true
;

/*----------------------------------------------------------------------------*/
/* BM_GenEntOp request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: OP_burst_req \operator

  >>logEntry <SEED_REQ>

  // set topology, next stage and op
  op__topology

  //find: OP_burst_EosMarker ZK_EOSMARKER op[].handler!

  op__loop

  "*** OP_burst_req EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: OP_burst :: burstOp ;

jobInfo: OP_burst
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
