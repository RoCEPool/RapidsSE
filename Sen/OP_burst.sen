/*============================================================================*/
/* OP_burst.sen -- Burst Operator                                             */
/*============================================================================*/

" OP_burst.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_ENTBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_burst_EntBuffer \handler

  "OP_burst_EntBuffer" .

  operand[].get OperandC[].collect

  //ZK_ENTBUFFER_handler
  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_burst_EosMarker \handler

  "OP_burst_EosMarker" .

  operandC[].setFirst
  operandC[].pipeoutSet

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* burst request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: burst_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: OP_burst_EntBuffer ZK_ENTBUFFER op[].handler!
  find: OP_burst_EosMarker ZK_EOSMARKER op[].handler!

  op__loop

  "*** OP_burst_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: burst :: burst ;

: burst _opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
