/*============================================================================*/
/* op_defHandlers.sen -- Default Operand Handlers                             */
/*============================================================================*/

" OPERAND__handlers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: ZK_CANCELMARKER_handler \handler

  //"ZK_CANCELMARKER_handler" .verbose
  Pipein[].pipeOut
  Op.ackPipelineJob
  false
;

