/*============================================================================*/
/* op_defHandlers.sen -- Default Operand Handlers                             */
/*============================================================================*/

" OPERAND__handlers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CALLPIPELINE ...                                            */
/*----------------------------------------------------------------------------*/
: ZK_CALLPIPELINE_handler \handler

  //"ZK_CALLPIPELINE_handler" .verbose
  PipeIn[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: ZK_CANCELMARKER_handler \handler

  //"ZK_CANCELMARKER_handler" .verbose
  PipeIn[].pipeOut
  Op.ackPipelineJob
  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELLEDMARKER ...                                         */
/*----------------------------------------------------------------------------*/
: ZK_CANCELLEDMARKER_handler \handler

  //"ZK_CANCELLEDMARKER_handler" .verbose
  Pipein[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op.pipelineJob@ ERROR_JOB !!logError
  Operand[].newErrorMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_COUNTINFO ...                                               */
/*----------------------------------------------------------------------------*/
: ZK_COUNTINFO_handler \handler

