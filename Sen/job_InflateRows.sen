/*============================================================================*/
/* job_InflateRows.sen -- Job Fetch Rows                                      */
/*============================================================================*/

" job_InflateRows.sen" .verbose

/*----------------------------------------------------------------------------*/
/* generate plan for the inflate                                              */
/*----------------------------------------------------------------------------*/
: generateInflatePlan ( "<sWhere>" ^pTable -- ^pPlanner )

  0 0 locals| pPlanner pAccessPath pTable sWhere |

  //sWhere "generatePlan" "%v %v" str.format .

  ( cdt_0 ) planner::new to pPlanner
  ( cdt_1 ) pTable pPlanner Planner.table!

  ( cdt_2 ) sWhere pPlanner Planner.parseWhere  //"parseWheres" .

  ( cdt_3 ) pPlanner Planner.genPaths           //"genPaths" .
  ( cdt_4 ) pPlanner Planner.scorePaths         //"scorePaths" .
  //( cdt_5 ) pPlanner Planner.showPaths

  ( cdt_6 ) pPlanner Planner.matchPaths         //"matchPaths" .
  //( cdt_6 ) pPlanner Planner.showPaths

  ( cdt_7 ) pPlanner Planner.choosePaths        //"choosePaths" .

  // return planner
  pPlanner
;

/*----------------------------------------------------------------------------*/
/* spawn sub fetch jobs                                                       */
/*----------------------------------------------------------------------------*/
: spawnInflateSub ( phrase planner Job_InflateRows -- )

  params| pJob_InflateRows pPlanner iPhrase |

  // spawn a subFetch job for each partition
  grid::slots 0
  do
    //I "Creating Job_SubFetch %v" fmt.print
    I iPhrase pPlanner pJob_InflateRows job_InflateRows.spawnSub
  loop

;

/*----------------------------------------------------------------------------*/
/* execute checkInflateRows                                                   */
/*----------------------------------------------------------------------------*/
: checkInflateRows ( "<sColumnNm>" "<tableNm>" -- true | errorCode false )

  params| sTableNm sColumnNm |
  0 locals| pJob_InflateRows |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  task::this task.job@ to pJob_InflateRows

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  checkInTables not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check table folder exists
  sTableNm checkIsTableFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm checkIsTable not if popTable false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // if retrieving column, check it is a valid column
  "" sColumnNm str.equal not if
    sColumnNm sTableNm checkIsColumn not if popTable false exit then
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* fetch rows table request (on originating node)                             */
/*----------------------------------------------------------------------------*/
: InflateRows_req ( -- <R> )

  >>am <SEED_REQ>

  100 apiState::senLoc

  0 0 0 0 locals| iPhrases sTableNm sColumnNm sWhere |
  0 0 0 0 locals| pJob_InflateRows pTask pPlanner pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_InflateRows

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_INFLATEROWS pJob_InflateRows object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_InflateRows job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table name, column name  and partition
  pJob_InflateRows job.objectName@ to sTableNm
  pJob_InflateRows Job_InflateRows.columnName@ to sColumnNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can fetch rows
  sColumnNm sTableNm checkInflateRows not if pJob_InflateRows <ERROR_REQUEST> !!am exit then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the table
  sTableNm pushTable assert
  sTableNm find execute to pTable
  pTable pJob_InflateRows job_InflateRows.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the column from the table and set it in the InflateRows job
  "" sColumnNm str.equal not if
    sColumnNm pTable table.findColumn pJob_InflateRows job_InflateRows.column!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the where clause from the job
  pJob_InflateRows job_InflateRows.where@ to sWhere

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the plan for the fetch
  sWhere pTable generateInflatePlan to pPlanner
  pPlanner pJob_InflateRows job_InflateRows.planner!

  //pPlanner planner.showPaths

  // assert we have a plan
  pPlanner assert
  pPlanner planner.phrases@ to iPhrases

  // set the no of last buffers to no phrases * slots in the job
  iPhrases grid::slots * pJob_InflateRows job_InflateRows.lastBuffers!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn the sub fetch jobs
  iPhrases 0
  do
    I pPlanner pJob_InflateRows spawnInflateSub
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Now spawn the subInflate jobs and wait for them to complete

  // grab this task's lock
  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the acks
  //grid::slots task::acks!
  1 task::acks!

  grid::slots 0
  do
    //I "Creating Job_SubInflate %v" fmt.print
    pJob_InflateRows job_InflateRows.spawnSubInflate
  loop

  //"InflateRows ack waiting" .
  task::wait

  popTable

  pJob_InflateRows job.notice

  900 apiState::senLoc
 
  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
