/*============================================================================*/
/* job_BM_InsIdxOp.sen -- Job BM_InsIdxOp                                     */
/*============================================================================*/

" job_BM_InsIdxOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerNew
  
  timer::new    to timer[]
  aggTimer::new to aggTimer[]
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerBegin
  
  timer[] timer.start
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerUpdate
  
  timer[] timer.update

  timer[] timer.ticks aggTimer[] aggTimer.add
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerReport

  Operand[].newCsvBuffer
  Operand[].report

  // csv report for bm_insidx
  aggTimer[] aggTimer.reportStr
    "BM_InsIdx Timer" "%v,%v\n" str.format Operand[].csvAppend

  counter0[].get
    "BM_InsIdx EntBuffers" "%v,%v\n" str.format Operand[].csvAppend

  counter1[].get
    "BM_InsIdx Entries" "%v,%v\n" str.format Operand[].csvAppend

  aggTimer[] aggTimer.nanosecs counter1[].get /
    "BM_InsIdx ns per entry" "%v,%v\n" str.format Operand[].csvAppend
  
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_ENTBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_EntBuffer

  "BM_InsIdx_EntBuffer" .

  // get index partition for current partition
  index[].get index.indexTree to indexTree[] // indexPtn

  BM_TimerBegin

  // insert all the entries into tree
  //   NB: registers are available in the step!!
  Operand[].get indexTree[].get indexTree.insEntBuffer // <- focal pt of bm
    counter1[] + to counter1[]

  counter0[] 1 + to counter0[]

  BM_TimerUpdate

  Operand[].delete

  BM_TimerReport
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_EosMarker

  Operand[].delete

  BM_TimerReport

  Operand[].newEosMarker
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_StartMarker

  // table index folder push
  op__table_index

  folderPath.str "Folder path: %v" .printf

  BM_TimerNew

  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* execute for insertOp                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_InsIdxOp_req ( -- )
 
  >>logEntry <SEED_REQ>
//
  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

    ZK_ENTBUFFER   of BM_InsIdx_EntBuffer   true endof

    //ZK_EOSMARKER   of BM_InsIdx_EosMarker   true endof

    ZK_STARTMARKER of BM_InsIdx_StartMarker true endof

    jobOperand::generic swap

    endcase

  while assert::stack_0 repeat

  "*** BM_InsIdxOp EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: BM_InsIdxOp :: BM_InsIdxOp <tableNm> <indexNm> <topology> <nextStage> <nextOp> ;

jobInfo: BM_InsIdxOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
