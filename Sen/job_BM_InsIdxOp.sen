/*============================================================================*/
/* job_BM_InsIdxOp.sen -- Job BM_InsIdxOp                                     */
/*============================================================================*/

" job_BM_InsIdxOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerBegin
  
  timer::new to timer[]

  timer[] timer.start
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerReport

  timer[] timer.update

  Operand[].newCsvBuffer
  Operand[].report
  timer[] timer.reportStr "InsIdx" "%v,%v\n" str.format Operand[].csvAppend
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_ENTBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_EntBuffer

  "BM_InsIdx_EntBuffer" .

  BM_TimerBegin

  // get index tree for current partition
  index[].get index.indexTree to indexTree[]

  // insert all the entries into tree
  Operand[].get indexTree[].get indexTree.insEntBuffer

  Operand[].delete

  BM_TimerReport
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_EosMarker

  Operand[].delete

  BM_TimerReport

  Operand[].newEosMarker
  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_InsIdx_StartMarker

  op__table_index

  folderPath.str "Folder path: %v" .printf

  Operand[].pipeout
;

/*----------------------------------------------------------------------------*/
/* execute for insertOp                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_InsIdxOp_req ( -- )
 
  >>logEntry <SEED_REQ>
//
  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

    ZK_ENTBUFFER   of BM_InsIdx_EntBuffer   true endof

    //ZK_EOSMARKER   of BM_InsIdx_EosMarker   true endof

    ZK_STARTMARKER of BM_InsIdx_StartMarker true endof

    jobOperand::generic swap

    endcase

  while assert::stack_0 repeat

  "*** BM_InsIdxOp EXITS" .
  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: BM_InsIdxOp :: BM_InsIdxOp <tableNm> <indexNm> <topology> <nextStage> <nextOp> ;

jobInfo: BM_InsIdxOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_PARTICIPANT_RESPONSE
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
