/*============================================================================*/
/* job_StartNode.sen -- Job Start Node                                        */
/*============================================================================*/

" job_StartNode.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Job_StartNode request (on origin node)                                     */
/*----------------------------------------------------------------------------*/
: startNode_req (  -- <R> )

  >>logEntry <SEED_REQ>

  0 0 0 locals| pJob_StartNode pTask sNodeNm |

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob_StartNode

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //pJob_StartNode job.nodeName@ to sNodeNm
  <nodeNm> to sNodeNm
  sNodeNm "Starting node %v" fmt.print

  sNodeNm grid::spawnAddingNode

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: startNode :: start node <nodeNm> ;

jobInfo: startNode
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_STARTNODE
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NONE
  <?ddlLock?>  = DL_NONE
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
