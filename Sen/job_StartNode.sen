/*============================================================================*/
/* job_StartNode.sen -- Job Start Node                                        */
/*============================================================================*/

" job_StartNode.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Job_StartNode request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: startNode_req (  -- <R> )

  >>logEntry <SEED_REQ>

  0 0 0 locals| pJob_StartNode pTask sNodeNm |

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob_StartNode

  pJob_StartNode job.objectName@ to sNodeNm
  sNodeNm grid::findNode node.start if
    "Node started" .
  else
    "Node not started" .
  then

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
