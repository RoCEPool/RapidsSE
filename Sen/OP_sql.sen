/*============================================================================*/
/* OP_sql.sen -- sql                                                          */
/*============================================================================*/

" OP_sql.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create an (int) index def                                                  */
/*----------------------------------------------------------------------------*/
: idxDef_int

  indexDef[].new

  "idx_int" indexDef[].name!

  CT_INTEGER "intA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create an (int,int) index def                                              */
/*----------------------------------------------------------------------------*/
: idxDef_intInt

  indexDef[].new

  "idx_intInt" indexDef[].name!

  CT_INTEGER "intA" indexDef[].addColumn
  CT_INTEGER "intB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch) index def                                                   */
/*----------------------------------------------------------------------------*/
: idxDef_vch

  indexDef[].new

  "idx_vch" indexDef[].name!

  CT_VARCHAR "vchA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch,vch) index def                                               */
/*----------------------------------------------------------------------------*/
: idxDef_vchVch

  indexDef[].new

  "idx_vchVch" indexDef[].name!

  CT_VARCHAR "vchA" indexDef[].addColumn
  CT_VARCHAR "vchB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: sql_StartMarker \handler

  0 locals| queryNo |

  Pot[].new

  //"@ 0 2 %" LogicUnit[].source!

  <queryNo> >int to queryNo
  queryNo case
    100 of
      queryNo "QUERY %v" .printf
      100 LogicUnit[].genCode
      idxDef_int indexDef[] indexTree[].new
    endof

    102 of
      queryNo "QUERY %v" .printf
      102 LogicUnit[].genCode
      idxDef_int indexDef[] indexTree[].new
    endof

    300 of
      queryNo "QUERY %v" .printf
    endof

    400 of
      queryNo "QUERY %v" .printf
    endof

    600 of
      queryNo "QUERY %v" .printf
      600 LogicUnit[].genCode
    endof

    601 of
      queryNo "QUERY %v" .printf
      601 LogicUnit[].genCode
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    10000 of
      // FILTER
      queryNo "QUERY %v" .printf

      "ss pi bs L GET gs jf END @ 0 2 % jf GET nd = j GET L END ft ret"
      LogicUnit[].source!
      LogicUnit[].compile assert
    endof

    11000 of
      // PROJECT
      queryNo "QUERY %v" .printf

      //"ss po bs L GET gs jf END nd .s = @ 3 10 * ! 3 .d j GET L END ft ret"
      "ss po bs L GET gs jf END nd = @ 3 10 * ! 3 j GET L END ft ret"
      LogicUnit[].source!
      LogicUnit[].compile assert
    endof

    12000 of
      queryNo "QUERY %v" .printf
      //12000 LogicUnit[].genCode
      "dn dp dn dy . ss pi bs L GET gs jf END nd = wr @ 0 ae .w os wo .w xi xd j GET L END ft ret"
      //"ss pi bs L GET gs jf END nd = wr j GET L END ft ret"
      LogicUnit[].source!
      LogicUnit[].compile assert

      idxDef_int indexDef[] indexTree[].new
    endof

    13000 of
      // AGGREGATE
      queryNo "QUERY %v" .printf
      13000 LogicUnit[].genCode
    endof

    14000 of
      // AGGREGATE WITH GROUPBY
      queryNo "QUERY %v" .printf
      14000 LogicUnit[].genCode
      idxDef_int indexDef[] indexTree[].new
    endof

    14002 of
      // SUPER AGGREGATE WITH GROUPBY
      queryNo "QUERY %v" .printf
      14002 LogicUnit[].genCode
      idxDef_int indexDef[] indexTree[].new
    endof

    20001 of
      // SRC INDEX WALK TEST 1
      queryNo "QUERY %v" .printf
      "dn dp xsb jf END L NXT .xs rsf csf 0 . bp xsn jt NXT L END ret"
         LogicUnit[].source!
      LogicUnit[].compile assert
    endof

    20002 of
      // SRC INDEX WALK TEST 2
      queryNo "QUERY %v" .printf
      "dn dp xsb jf END L NXT .xs rsf csf 0 . bp xsn jt NXT L END ret"
         LogicUnit[].source!
      LogicUnit[].compile assert
    endof

    20003 of
      // SRC INDEX WALK TEST 3
      queryNo "QUERY %v" .printf
      "dn dp xsb jf END L NXT .xs rsf csf 0 . bp xsn jt NXT L END ret"
         LogicUnit[].source!
      LogicUnit[].compile assert
    endof

    20004 of
      // SRC INDEX WALK TEST 4
      queryNo "QUERY %v" .printf
      "dn dp xsb jf ALT L NXT_S .xs rsf csf 0 . bp xsn jt NXT_S
       L ALT xab jf END L NXT_A .xa raf caf 0 . bp xan jt NXT_A
       L END ret"
         LogicUnit[].source!
      LogicUnit[].compile assert
    endof

    20005 of
      // SRC INDEX WALK TEST 4
      queryNo "QUERY %v" .printf
      "dn dp xsb jf ALT L NXT_S .xs rsf csf 0 . bp xsn jt NXT_S
       L ALT xab jf END L NXT_A .xa raf caf 0 . bp xan jt NXT_A
       L END ret"
         LogicUnit[].source!
      LogicUnit[].compile assert
    endof

  endcase

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    20001 of
      "-------------------------- 20001 PULSEMARKER --------------------------" .

      "lineItem" "lineItem_Idx1" op__table_index assert

      Table[].asSrcStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asSrc

      LogicUnit[].transform

    endof

    20002 of
      "-------------------------- 20002 PULSEMARKER --------------------------" .

      "orders" "orders_Idx1" op__table_index assert

      Table[].asSrcStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asSrc

      LogicUnit[].transform

    endof

    20003 of
      "-------------------------- 20003 PULSEMARKER --------------------------" .

      "customer" "customer_Idx1" op__table_index assert

      Table[].asSrcStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asSrc

      LogicUnit[].transform

    endof

    20004 of
      "-------------------------- 20004 PULSEMARKER --------------------------" .

      "orders" "orders_Idx1" op__table_index assert

      Table[].asSrcStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asSrc

     
      "lineItem" "lineItem_Idx1" op__table_index assert

      Table[].asAltStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asAlt


      LogicUnit[].transform

    endof

    20005 of
      "-------------------------- 20005 PULSEMARKER --------------------------" .

      "orders" "orders_Idx1" op__table_index assert

      Table[].asSrcStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asSrc

  
      "lineItem" "lineItem_Idx1" op__table_index assert

      Table[].asAltStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asAlt


      LogicUnit[].transform

    endof

  endcase

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: sql_RsbBuffer \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    12000 of
      "--------------------------- 12000 RSBBUFFER ---------------------------" .
    endof

  endcase

  Operand[].pipeIn
  LogicUnit[].transform
  Operand[].delete

  Pot[].pipeoutAllCompleted

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: sql_EosMarker \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    100 of
      // AGGREGATE WITH GROUPBY
      queryNo "QUERY %v" .printf
      101 LogicUnit[].genCode
      LogicUnit[].transform
      IndexTree[].delete
    endof

    102 of
      // AGGREGATE WITH GROUPBY (SUPER)
      queryNo "QUERY %v" .printf
      101 LogicUnit[].genCode
      LogicUnit[].transform
      IndexTree[].delete
    endof

    12000 of
      IndexTree[].delete
    endof

    14000 of
      // AGGREGATE WITH GROUPBY
      queryNo "QUERY %v" .printf
      14001 LogicUnit[].genCode
      LogicUnit[].transform
      IndexTree[].delete
    endof

    14002 of
      // AGGREGATE WITH GROUPBY (SUPER)
      queryNo "QUERY %v" .printf
      14001 LogicUnit[].genCode
      LogicUnit[].transform
      IndexTree[].delete
    endof

  endcase

  Pot[].pipeoutAllDangling
  Pot[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: sql_StreamDef \handler

  0 0 locals| queryNo pColumn |

  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  <queryNo> >int to queryNo
  queryNo case

    100 of
      StreamDefOut[].new

      // add column L_RETURNFLAG
      3 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column SUM(L_QUANTITY) as SUM_QTY
      4 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "sum_qty"
      StreamDefOut[].addColumn

      StreamDef[].delete

      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    102 of
      StreamDef[].duplicate to StreamDefOut[]
      StreamDef[].pipeout
    endof

    300 of
    endof

    400 of
    endof

    600 of
      StreamDefOut[].new

      // add column L_EXTENTEDPRICE
      5 StreamDef[].column@ to pColumn

      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "revenue"
      StreamDefOut[].addColumn
      StreamDef[].delete

      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout

      //StreamDefOut[].print

    endof

    601 of
      StreamDef[].duplicate to StreamDefOut[]
      StreamDef[].pipeout
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    10000 of
      StreamDef[].pipeout
    endof

    11000 of
      //StreamDef[].pipeIn

      StreamDef[].duplicate to OperandB[]
      OperandB[].pipeOut

      StreamDef[].print

      StreamDef[].duplicate to StreamDefOut[]
      //StreamDefOut[].print
    endof

    12000 of
      StreamDef[].pipeout
    endof

    13000 of
      StreamDefOut[].new
      0 C_MAX_INT_PRECISION CT_INTEGER "sum" StreamDefOut[].addColumn

      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    14000 of
      StreamDefOut[].new

      // get column L_ORDERKEY
      0 StreamDef[].column@ to pColumn

      // add column L_ORDERKEY
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add sumGby for l_orderkey
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "sumGby"
      StreamDefOut[].addColumn

      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout

      StreamDefOut[].print
    endof

    14002 of
      StreamDef[].duplicate to StreamDefOut[]
      StreamDef[].pipeout
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: sql_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sql_EosMarker   ZK_EOSMARKER   op[].handler!
  find: sql_PulseMarker ZK_PULSEMARKER op[].handler!
  find: sql_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: sql_StartMarker ZK_STARTMARKER op[].handler!
  find: sql_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sql :: sql <queryNo> ;

: sql _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
