/*============================================================================*/
/* OP_sql.sen -- sql                                                          */
/*============================================================================*/

" OP_sql.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create an (int) index def                                                  */
/*----------------------------------------------------------------------------*/
: idxDef_int

  indexDef[].new

  "idx_int" indexDef[].name!

  CT_INTEGER "intA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create an (int,int) index def                                              */
/*----------------------------------------------------------------------------*/
: idxDef_intInt

  indexDef[].new

  "idx_intInt" indexDef[].name!

  CT_INTEGER "intA" indexDef[].addColumn
  CT_INTEGER "intB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch) index def                                                   */
/*----------------------------------------------------------------------------*/
: idxDef_vch

  indexDef[].new

  "idx_vch" indexDef[].name!

  CT_VARCHAR "vchA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch,vch) index def                                               */
/*----------------------------------------------------------------------------*/
: idxDef_vchVch

  indexDef[].new

  "idx_vchVch" indexDef[].name!

  CT_VARCHAR "vchA" indexDef[].addColumn
  CT_VARCHAR "vchB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* outbound stream def for 300                                                */
/*----------------------------------------------------------------------------*/
: streamDefOut_300

  StreamDefOut[].new  "Q300_out" StreamDefOut[].name!

  0 19 CT_INTEGER "o_orderkey"     StreamDefOut[].addColumn
  0 0  CT_DATE    "o_orderdate"    StreamDefOut[].addColumn
  0 19 CT_INTEGER "o_shippriority" StreamDefOut[].addColumn

  StreamDefOut[].print
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 301                                                */
/*----------------------------------------------------------------------------*/
: streamDefOut_301

  StreamDefOut[].new  "Q301_out" StreamDefOut[].name!

  0 19 CT_INTEGER "l_orderkey"     StreamDefOut[].addColumn
  2 17 CT_DECIMAL "revenue"        StreamDefOut[].addColumn
  0 0  CT_DATE    "o_orderdate"    StreamDefOut[].addColumn
  0 19 CT_INTEGER "o_shippriority" StreamDefOut[].addColumn

  StreamDefOut[].print
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: sql_StartMarker \handler

  0 locals| queryNo |

  Pot[].new

  <queryNo> >int to queryNo
  queryNo case

    100 of
      queryNo "QUERY %v" .printf
      100 LogicUnit[].genCode
      idxDef_vchvch indexDef[] indexTree[].new
    endof

    102 of
      queryNo "QUERY %v" .printf
      102 LogicUnit[].genCode
      idxDef_vchvch indexDef[] indexTree[].new
    endof

    300 of
      "^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 300=STARTMARKER" .
      queryNo "QUERY %v" .printf
      300 LogicUnit[].genCode

      streamDefOut_300
      Pot[].useStreamDefOut
      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    301 of
      "^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 301=STARTMARKER" .
      queryNo "QUERY %v" .printf
      301 LogicUnit[].genCode

      streamDefOut_301
      Pot[].useStreamDefOut
      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    400 of
      queryNo "QUERY %v" .printf
      400 LogicUnit[].genCode
    endof

    600 of
      queryNo "QUERY %v" .printf
      600 LogicUnit[].genCode
    endof

    601 of
      queryNo "QUERY %v" .printf
      601 LogicUnit[].genCode
    endof

  endcase

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_300

  "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 300=PULSEMARKER" .

  ZK_PULSEMARKER_handler

  "customer" "customer_Idx1" op__table_index assert

  Table[].asSrcStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asSrc


  "orders" "orders_Idx2" op__table_index assert

  Table[].asAltStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asAlt


  LogicUnit[].transform

  Pot[].pipeoutAllDangling
  Pot[].delete

  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_301

  "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 301=PULSEMARKER" .

  ZK_PULSEMARKER_handler

  "lineitem" "lineitem_Idx1" op__table_index assert

  Table[].asAltStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asAlt

  idxDef_int indexDef[] indexTree[].new
  indexTree[].asTmp


//  LogicUnit[].transform
//
//  Pot[].pipeoutAllDangling
//  Pot[].delete
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_400

  "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 400=PULSEMARKER" .

  ZK_PULSEMARKER_handler

  "orders" "orders_Idx1" op__table_index assert

  Table[].asSrcStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asSrc


  "lineItem" "lineItem_Idx1" op__table_index assert

  Table[].asAltStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asAlt


  LogicUnit[].transform
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    300 of sql_PulseMarker_300   endof
    301 of sql_PulseMarker_301   endof

    400 of sql_PulseMarker_400   endof

    ZK_PULSEMARKER_handler

  endcase
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: sql_RsbBuffer \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    301 of
      "---------------------------- 301=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      LogicUnit[].transform
      Operand[].delete

    endof

    "------------------------------ =RSBBUFFER -----------------------------" .
    Operand[].pipeIn
    LogicUnit[].transform
    Operand[].delete

  endcase

  Pot[].pipeoutAllCompleted

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: sql_EosMarker \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    100 of
      // AGGREGATE WITH GROUPBY
      queryNo "QUERY %v" .printf
      101 LogicUnit[].genCode
      LogicUnit[].transform
      IndexTree[].delete
    endof

    102 of
      // AGGREGATE WITH GROUPBY (SUPER)
      queryNo "QUERY %v" .printf
      103 LogicUnit[].genCode
      LogicUnit[].transform
      IndexTree[].delete
    endof

    300 of
      "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 300=EOSMARKER" .
    endof

    301 of
      "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 301=EOSMARKER" .
    endof

  endcase

  Pot[].pipeoutAllDangling
  Pot[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: sql_StreamDef \handler

  0 0 locals| queryNo pColumn |

  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  <queryNo> >int to queryNo
  queryNo case

    100 of

      StreamDefOut[].new
      // add column L_RETURNFLAG
      8 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column L_LINESTATUS
      9 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column SUM(L_QUANTITY) as SUM_QTY
      4 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "sum_qty"
      StreamDefOut[].addColumn

      // add column SUM(L_EXTENDEDPRICE) as SUM_BASE_PRICESUM_QTY
      5 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "sum_base_price"
      StreamDefOut[].addColumn

      // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)) as SUM_DISC_PRICE
      5 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "sum_disc_price"
      StreamDefOut[].addColumn

      // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)*(1+L_TAX)) as SUM_CHARGESUM_QTY
      5 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "sum_charge"
      StreamDefOut[].addColumn

      // add column COUNT(L_QUANTITY) as COUNT_QTY
      0
      19
      CT_INTEGER
      "count_qty"
      StreamDefOut[].addColumn

      StreamDef[].delete

      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    102 of
      StreamDefOut[].new
      // add column L_RETURNFLAG
      0 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column L_LINESTATUS
      1 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column SUM(L_QUANTITY) as SUM_QTY
      2 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column SUM(L_EXTENDEDPRICE) as SUM_BASE_PRICESUM_QTY
      3 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)) as SUM_DISC_PRICE
      4 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)*(1+L_TAX)) as SUM_CHARGESUM_QTY
      5 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      pColumn column.name@
      StreamDefOut[].addColumn

      // add column COUNT(L_QUANTITY) as AVG_QTY
      2 StreamDef[].column@ to pColumn
      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "avg_qty"
      StreamDefOut[].addColumn

      StreamDef[].delete

      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout

    endof

    300 of
      "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 300=STREAMDEF" .
      // sql 300 should not get a stream def
      0 assert
    endof

    301 of
      "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 301=STREAMDEF" .
      // the stream def was  piped out in sql_StartMarker by 300
    endof

    400 of
    endof

    600 of
      StreamDefOut[].new

      // add column L_EXTENTEDPRICE
      5 StreamDef[].column@ to pColumn

      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "revenue"
      StreamDefOut[].addColumn
      StreamDef[].delete

      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout

      //StreamDefOut[].print

    endof

    601 of
      StreamDef[].duplicate to StreamDefOut[]
      StreamDef[].pipeout
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: sql_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sql_EosMarker   ZK_EOSMARKER   op[].handler!
  find: sql_PulseMarker ZK_PULSEMARKER op[].handler!
  find: sql_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: sql_StartMarker ZK_STARTMARKER op[].handler!
  find: sql_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sql :: sql <queryNo> ;

: sql _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
