  StreamDefOut[].new  "Q401_out" StreamDefOut[].name!

  0 15 CT_VARCHAR "o_orderpriority" StreamDefOut[].addColumn
  0 19 CT_INTEGER "order_count"     StreamDefOut[].addColumn

  //StreamDefOut[].print
