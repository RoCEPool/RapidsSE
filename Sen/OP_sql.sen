/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: sql_StartMarker \handler

  0 locals| queryNo |

  0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  ZK_STARTMARKER_handler

  <queryNo> >int to queryNo
  //queryNo .

  Pot[].new
  LogicUnit[].init

  queryNo "sql %v" str.format profile.name!
  queryNo case

    100 of
      //queryNo "QUERY %v" .printf
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 100=STARTMARKER" .
      100 LogicUnit[].genCode
      Counter0[] 1 == if
        logicCompiler[].new
        LogicCompiler[].compile
      then
      //ray100
      //idxDef_vchvch indexDef[] indexTree[].new indexTree[].asTmp
      idxDef_int indexDef[] indexTree[].new indexTree[].asTmp
      indexDef[].delete
    endof

    103 of
      //queryNo "QUERY %v" .printf
      103 LogicUnit[].genCode

      Counter0[] 1 == if
        logicCompiler[].new
        LogicCompiler[].compile
      then
      //ray100
      //idxDef_vchvch indexDef[] indexTree[].new indexTree[].asTmp
      idxDef_int indexDef[] indexTree[].new indexTree[].asTmp
      indexDef[].delete
    endof

    300 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 300=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      300 LogicUnit[].genCode

      Counter0[] 1 == if
        logicCompiler[].new
        LogicCompiler[].compile
      then

      "customer" "customer_Idx1" op__table_index assert

      Table[].asSrcStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asSrc


      "orders" "orders_Idx2" op__table_index assert

      Table[].asAltStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asAlt


      streamDefOut_300
      true Pot[].useStreamDefOut
      //StreamDefOut[].duplicate to StreamDef[]

      ZK_STREAMDEF EG_ZK PP_PIPE_OUT 0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryAction

      StreamDefOut[].pipeout
    endof

    301 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 301=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      301 LogicUnit[].genCode

      Counter0[] 1 == if
        logicCompiler[].new
        LogicCompiler[].compile
      then
      "lineitem" "lineitem_Idx1" op__table_index assert

      Table[].asAltStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asAlt

      idxDef_int indexDef[] indexTree[].new
      indexTree[].asTmp

      indexTree[] 0 LogicUnit[].dev!


      streamDefOut_301
      true Pot[].useStreamDefOut
      //StreamDefOut[].duplicate to StreamDef[]

      ZK_STREAMDEF EG_ZK PP_PIPE_OUT 0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryAction

      StreamDefOut[].pipeout
    endof

    302 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 302=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      302 LogicUnit[].genCode

      Counter0[] 1 == if
        logicCompiler[].new
        LogicCompiler[].compile
      then

      idxDef_int indexDef[] indexTree[].new
      indexTree[].asTmp

      indexTree[] 0 LogicUnit[].dev!


      streamDefOut_302
      true Pot[].useStreamDefOut
      //StreamDefOut[].duplicate to StreamDef[]

      ZK_STREAMDEF EG_ZK PP_PIPE_OUT 0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryAction

      StreamDefOut[].pipeout
    endof

    400 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 400=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      400 LogicUnit[].genCode

      Counter0[] 1 == if
        LogicCompiler[].new
        LogicCompiler[].compile
      then

      streamDefOut_400
      true Pot[].useStreamDefOut
      //StreamDefOut[].duplicate to StreamDef[]
      ZK_STREAMDEF EG_ZK PP_PIPE_OUT 0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryAction
      StreamDefOut[].pipeout
    endof

    401 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 401=STARTMARKER" .

          idxDef_vch indexDef[] indexTree[].new
          indexTree[].asTmp

          indexTree[] 0 LogicUnit[].dev!

      //queryNo "QUERY %v" .printf
      401 LogicUnit[].genCode

      Counter0[] 1 == if
        LogicCompiler[].new
        LogicCompiler[].compile
      then

      streamDefOut_401
      true Pot[].useStreamDefOut
      //StreamDefOut[].duplicate to StreamDef[]
      ZK_STREAMDEF EG_ZK PP_PIPE_OUT 0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryAction
      StreamDefOut[].pipeout
    endof

    600 of
      //queryNo "QUERY %v" .printf
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 600=STARTMARKER" .
      <tableNm> <indexNm> op__table_index not if
        false
        exit
      then
      index[].indexTree to indexTree[]
      indexTree[].asSrc
      Table[].asSrcStreamDef
      600 LogicUnit[].genCode

    Counter0[] 1 == if
      LogicCompiler[].new
      LogicCompiler[].compile
    then

    endof

    601 of
      //queryNo "QUERY %v" .printf
      601 LogicUnit[].genCode
      Counter0[] 1 == if
        LogicCompiler[].new
        LogicCompiler[].compile
      then
    endof

    100000 of
      //queryNo "QUERY %v" .printf
      100000 LogicUnit[].genCode

      Counter0[] 1 == if
        LogicCompiler[].new
        LogicCompiler[].compile
        LogicUnit[].dynFun
        LogicCompiler[].delete
      else
        LogicUnit[].transform
      then

    endof

    100001 of
      //queryNo "QUERY %v" .printf
      100001 LogicUnit[].genCode

      Counter0[] 1 == if
        LogicCompiler[].new
        LogicCompiler[].compile
        LogicUnit[].dynFun
        LogicCompiler[].delete
      else
        LogicUnit[].transform
      then

    endof

  endcase
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_300

  // "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 300=PULSEMARKER" .

  PipeIn[].isNull not if

    ZK_PULSEMARKER EG_ZK PP_PIPE_OUT 0 ZK_PULSEMARKER EG_ZK LogicUnit[].diaryAction

    PipeIn[].pipeOut // ZK_PULSEMARKER_handler
    // "PIPEDOUT PULSE MARKER" .
  then

//  LogicUnit[].calledAgain@ not if
//    PipeIn[].pipeOut // ZK_PULSEMARKER_handler
//  then



Counter0[] 1 == if
  LogicUnit[].dynFun
else
  LogicUnit[].transform
then

  false LogicUnit[].calledAgain!

  LogicUnit[].callAgain@ if
    //"Completed test" .
    Pot[].pipeoutAllCompletedPtns
    true
  else
    Counter0[] 1 == if
      LogicCompiler[].delete
    then
    Pot[].pipeoutAllDanglingPtns
    Operand[].newEosMarker
    ZK_EOSMARKER EG_ZK PP_PIPE_OUT 0 ZK_PULSEMARKER EG_ZK LogicUnit[].diaryAction
    Operand[].pipeOut
    Pot[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_301

  // "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 301=PULSEMARKER" .

  ZK_PULSEMARKER EG_ZK PP_PIPE_OUT 0 ZK_PULSEMARKER EG_ZK LogicUnit[].diaryAction

  ZK_PULSEMARKER_handler

//  "lineitem" "lineitem_Idx1" op__table_index assert
//
//  Table[].asAltStreamDef
//
//  Index[].indexTree to IndexTree[]
//  IndexTree[].asAlt
//
//  idxDef_int indexDef[] indexTree[].new
//  indexTree[].asTmp
//
//  indexTree[] 0 LogicUnit[].dev!


//  LogicUnit[].transform
//
//  Pot[].pipeoutAllDangling
//  Pot[].delete
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_302

  //"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 302=PULSEMARKER" .

  ZK_PULSEMARKER EG_ZK PP_PIPE_OUT 0 ZK_PULSEMARKER EG_ZK LogicUnit[].diaryAction

  ZK_PULSEMARKER_handler

//  idxDef_int indexDef[] indexTree[].new
//  indexTree[].asTmp
//
//  indexTree[] 0 LogicUnit[].dev!
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_400

  //"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 400=PULSEMARKER" .

  ZK_PULSEMARKER_handler

  "orders" "orders_Idx1" op__table_index assert

  Table[].asSrcStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asSrc


  "lineItem" "lineItem_Idx1" op__table_index assert

  Table[].asAltStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asAlt

  idxDef_vch indexDef[] indexTree[].new
  indexTree[].asTmp

  indexTree[] 0 LogicUnit[].dev!

  Counter0[] 1 == if
    LogicUnit[].dynFun
    LogicCompiler[].delete
  else
    logicUnit[].transform
  then

  Pot[].pipeoutAllDangling
  Pot[].delete

  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_401

  //"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 401=PULSEMARKER" .

  ZK_PULSEMARKER_handler

/*
  idxDef_vch indexDef[] indexTree[].new
  indexTree[].asTmp

  indexTree[] 0 LogicUnit[].dev!
*/

;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_600

  //"++++++++++++++++++++++++++++ 600=PULSEMARKER ++++++++++++++++++++++++++++" .

  0 locals| pColumn |

  ZK_PULSEMARKER_handler

  // new a streamDef from table
  table[] StreamDef[].new

  // new a streamDef to be piped out
  StreamDefOut[].new

  // add column SUM(L_EXTENDEDPRICE*L_DISCOUNT) as REVENUE
  5 StreamDef[].column@ to pColumn

  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "revenue"
  StreamDefOut[].addColumn

  // add column COUNT(*)
  //0 19 CT_INTEGER "count"
  //StreamDefOut[].addColumn

  // now delete the streamDef of table
  StreamDef[].delete

  // set streamDefOut in the pot
  true Pot[].useStreamDefOut
  StreamDefOut[].pipeout

  Counter0[] 1 == if
    LogicUnit[].dynFun
    LogicCompiler[].delete
  else
    LogicUnit[].transform
  then

  Pot[].pipeoutAllCompleted
  Pot[].pipeoutAllDangling

  Pot[].delete

  // pipeout an EOS MARKER
  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker \handler

  0 ZK_PULSEMARKER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    300 of sql_PulseMarker_300   endof
    301 of sql_PulseMarker_301   endof
    302 of sql_PulseMarker_302   endof

    400 of sql_PulseMarker_400   endof
    401 of sql_PulseMarker_401   endof

    600 of sql_PulseMarker_600   endof

    //"++++++++++++++++++++++++++++ OTHER=PULSEMARKER ++++++++++++++++++++++++++++" .
    ZK_PULSEMARKER_handler

  endcase


;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: sql_CrwBuffer \handler

  0 ZK_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    100 of
      //"---------------------------- 100=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcCrwBuffer
      Counter0[] 1 == if
        LogicUnit[].dynFun
      else
        LogicUnit[].transform
      then
      Operand[].delete
      //Pot[].pipeoutAllCompleted
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: sql_RsbBuffer \handler

  0 ZK_RSBBUFFER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  //PipeIn[]
  //profile.start

  queryNo case

    103 of
     // "---------------------------- 103=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      Counter0[] 1 == if
        true 1 LogicUnit[].dynFunArgs
      else
        true 1 LogicUnit[].transformArgs
      then
      Operand[].delete
      //Pot[].pipeoutAllCompleted
    endof

    301 of
      //"---------------------------- 301=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      //Operand[] "RsbBuffer %v\n" .printf
      Operand[].asSrcRowSlab

      Counter0[] 1 == if
        LogicUnit[].dynFun
      else
        LogicUnit[].transform
      then
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    302 of
      //"---------------------------- 302=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab

      Counter0[] 1 == if
        true 1 LogicUnit[].dynFunArgs
      else
        true 1 LogicUnit[].transformArgs
      then

      Operand[].delete
      Pot[].pipeoutAllCompleted

    endof

    401 of
      //"---------------------------- 401=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab

      Counter0[] 1 == if
        true 1 LogicUnit[].dynFunArgs
      else
        true 1 LogicUnit[].transformArgs
      then
      Operand[].delete
      Pot[].pipeoutAllCompleted

    endof

    601 of
      //"---------------------------- 601=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab

      Counter0[] 1 == if
        true 1 LogicUnit[].dynFunArgs
      else
        true 1 LogicUnit[].transformArgs
      then
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    // default
    queryNo "ERROR : Unexpected queryno %v" .printf
    0 assert
  endcase

  //profile.end

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: sql_EosMarker \handler

  0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    100 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 100=EOSMARKER" .
      // delete the original source streamDef now
      streamDef[].delete

      // AGGREGATE WITH GROUPBY

      Counter0[] 1 == if
        LogicUnit[].dynFun
        LogicCompiler[].delete
      else
        LogicUnit[].transform
      then
      IndexTree[].delete
      Pot[].pipeoutAllCompleted
    endof

    103 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 103=EOSMARKER" .
      // AGGREGATE WITH GROUPBY (SUPER)

      //queryNo "QUERY %v" .printf

      Counter0[] 1 == if
        false 1 LogicUnit[].dynFunArgs
        LogicCompiler[].delete
      else
        false 1 LogicUnit[].transformArgs
      then
      IndexTree[].delete
      Pot[].pipeoutAllCompleted
    endof

    300 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 300=EOSMARKER" .
    endof

    301 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 301=EOSMARKER" .
    Counter0[] 1 == if
      LogicCompiler[].delete
    then
    endof

    302 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 302=EOSMARKER" .
      Counter0[] 1 == if
        false 1 LogicUnit[].dynFunArgs
        LogicCompiler[].delete
      else
        false 1 LogicUnit[].transformArgs
      then
    endof

    401 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 302=EOSMARKER" .
    Counter0[] 1 == if
      false 1 LogicUnit[].dynFunArgs
      LogicCompiler[].delete
    else
      false 1 LogicUnit[].transformArgs
    then

    endof

    600 of
    endof

    601 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 601=EOSMARKER" .
      Counter0[] 1 == if
        LogicCompiler[].delete
      then
    endof

  endcase

  //queryNo "dangling %v" .printf
  Pot[].pipeoutAllDangling
  Pot[].delete

  // get the profile from the task
  //task[] task.profile@ to Operand[]
  //nullptr task[] task.profile!
  //Operand[].pipeOut

  ZK_EOSMARKER EG_ZK PP_PIPE_OUT 0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryAction
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: sql_StreamDef \handler

  0 ZK_STREAMDEF EG_ZK LogicUnit[].diaryNote

  0 0 locals| queryNo pColumn |

  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  <queryNo> >int to queryNo
  queryNo case

    100 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 100=STREAMDEF" .
      streamDefOut_100
      streamDef[].asSrcStreamDef
    endof

    103 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 101=STREAMDEF" .
      streamDefOut_103
    endof

    300 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 300=STREAMDEF" .
      // sql 300 should not get a stream def
      0 assert
    endof

    301 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 301=STREAMDEF" .
      // the stream def was  piped out in sql_StartMarker by 300
      StreamDef[].delete
    endof

    302 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 302=STREAMDEF" .
      // the stream def was  piped out in sql_StartMarker by 300
      StreamDef[].delete
    endof

    400 of
      StreamDef[].delete
    endof

    401 of
      StreamDef[].delete
    endof

    601 of
      StreamDef[] to StreamDefOut[]
      true Pot[].useStreamDefOut
      StreamDefOut[].pipeout
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: sql_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: sql_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: sql_EosMarker   ZK_EOSMARKER   op[].handler!
  find: sql_PulseMarker ZK_PULSEMARKER op[].handler!
  find: sql_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: sql_StartMarker ZK_STARTMARKER op[].handler!
  find: sql_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sql :: sql <queryNo> <compiled> ;
cmdSyntax: sql :: sql <queryNo> <compiled> <tableNm> <indexNm> ;

: sql _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
