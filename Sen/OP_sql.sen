/*============================================================================*/
/* OP_sql.sen -- sql                                                          */
/*============================================================================*/

" OP_sql.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create an (int) index def                                                  */
/*----------------------------------------------------------------------------*/
: idxDef_int

  indexDef[].new

  "idx_int" indexDef[].name!

  CT_INTEGER "intA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create an (int,int) index def                                              */
/*----------------------------------------------------------------------------*/
: idxDef_intInt

  indexDef[].new

  "idx_intInt" indexDef[].name!

  CT_INTEGER "intA" indexDef[].addColumn
  CT_INTEGER "intB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch) index def                                                   */
/*----------------------------------------------------------------------------*/
: idxDef_vch

  indexDef[].new

  "idx_vch" indexDef[].name!

  CT_VARCHAR "vchA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch,vch) index def                                               */
/*----------------------------------------------------------------------------*/
: idxDef_vchVch

  indexDef[].new

  "idx_vchVch" indexDef[].name!

  CT_VARCHAR "vchA" indexDef[].addColumn
  CT_VARCHAR "vchB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* outbound stream def for 100                                      STREAMDEF */
/*----------------------------------------------------------------------------*/
: streamDefOut_100

  0 locals| pColumn |

  StreamDefOut[].new

  // add column L_RETURNFLAG
  8 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column L_LINESTATUS
  9 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column SUM(L_QUANTITY) as SUM_QTY
  4 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_qty"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE) as SUM_BASE_PRICESUM_QTY
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_base_price"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)) as SUM_DISC_PRICE
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_disc_price"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)*(1+L_TAX)) as SUM_CHARGESUM_QTY
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_charge"
  StreamDefOut[].addColumn

  // add column COUNT(L_QUANTITY) as COUNT_QTY
  0
  19
  CT_INTEGER
  "count_qty"
  StreamDefOut[].addColumn

  // add column COUNT(L_EXTENDEDPRICE)
  0
  19
  CT_INTEGER
  "count_price"
  StreamDefOut[].addColumn

  // add column SUM(L_DISCOUNT)) as SUM_DISCOUNT
  6 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_discount"
  StreamDefOut[].addColumn

  // add column COUNT(L_DISCOUNT)
  0
  19
  CT_INTEGER
  "count_discount"
  StreamDefOut[].addColumn

  // add column COUNT(*) as COUNT_ORDER
  0
  19
  CT_INTEGER
  "count_order"
  StreamDefOut[].addColumn

  false Pot[].useStreamDefOut
  streamDefOut[].pipeout
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 103                                      STREAMDEF */
/*----------------------------------------------------------------------------*/
: streamDefOut_103

  0 locals| pColumn |

  StreamDefOut[].new

  // add column Q101_RETURNFLAG
  0 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_LINESTATUS
  1 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_QTY as sum_qty
  2 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_BASE_PRICE as SUM_BASE_PRICESUM_QTY
  3 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_DISC_PRICE as SUM_DISC_PRICE
  4 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_CHARGE as SUM_CHARGE
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_QTY/Q101_COUNT_QTY as AVG_QTY
  2 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_qty"
  StreamDefOut[].addColumn

  // add column Q101_SUM_BASE_PRICE/Q101_COUNT_PRICE as AVG_PRICE
  3 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_price"
  StreamDefOut[].addColumn

  // add column Q101_SUM_DISC/Q101_COUNT_DISC as AVG_DISC
  8 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_disc"
  StreamDefOut[].addColumn

  // add column Q101_COUNT_ORDER as COUNT_ORDER
  10 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "count_order"
  StreamDefOut[].addColumn

  StreamDef[].delete

  false Pot[].useStreamDefOut
  streamDefOut[].pipeout
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 300                                                */
/*----------------------------------------------------------------------------*/
: streamDefOut_300

  StreamDefOut[].new  "Q300_out" StreamDefOut[].name!

  0 19 CT_INTEGER "o_orderkey"     StreamDefOut[].addColumn
  0 0  CT_DATE    "o_orderdate"    StreamDefOut[].addColumn
  0 19 CT_INTEGER "o_shippriority" StreamDefOut[].addColumn

  //StreamDefOut[].print
;

