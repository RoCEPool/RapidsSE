/*============================================================================*/
/* OP_sql.sen -- sql                                                          */
/*============================================================================*/

" OP_sql.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create an (int) index def                                                  */
/*----------------------------------------------------------------------------*/
: idxDef_int

  indexDef[].new

  "idx_int" indexDef[].name!

  CT_INTEGER "intA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create an (int,int) index def                                              */
/*----------------------------------------------------------------------------*/
: idxDef_intInt

  indexDef[].new

  "idx_intInt" indexDef[].name!

  CT_INTEGER "intA" indexDef[].addColumn
  CT_INTEGER "intB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch) index def                                                   */
/*----------------------------------------------------------------------------*/
: idxDef_vch

  indexDef[].new

  "idx_vch" indexDef[].name!

  CT_VARCHAR "vchA" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch,vch) index def                                               */
/*----------------------------------------------------------------------------*/
: idxDef_vchVch

  indexDef[].new

  "idx_vchVch" indexDef[].name!

  CT_VARCHAR "vchA" indexDef[].addColumn
  CT_VARCHAR "vchB" indexDef[].addColumn
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* outbound stream def for 300                                                */
/*----------------------------------------------------------------------------*/
: streamDefOut_300

  StreamDefOut[].new  "Q300_out" StreamDefOut[].name!

  0 19 CT_INTEGER "o_orderkey"     StreamDefOut[].addColumn
  0 0  CT_DATE    "o_orderdate"    StreamDefOut[].addColumn
  0 19 CT_INTEGER "o_shippriority" StreamDefOut[].addColumn

  //StreamDefOut[].print
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 301                                                */
/*----------------------------------------------------------------------------*/
: streamDefOut_301

  StreamDefOut[].new  "Q301_out" StreamDefOut[].name!

  0 19 CT_INTEGER "l_orderkey"     StreamDefOut[].addColumn
  2 17 CT_DECIMAL "revenue"        StreamDefOut[].addColumn
  0 0  CT_DATE    "o_orderdate"    StreamDefOut[].addColumn
  0 19 CT_INTEGER "o_shippriority" StreamDefOut[].addColumn

  //StreamDefOut[].print
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 302                                                */
/*----------------------------------------------------------------------------*/
: streamDefOut_302

  StreamDefOut[].new  "Q302_out" StreamDefOut[].name!

  0 19 CT_INTEGER "l_orderkey"     StreamDefOut[].addColumn
  2 17 CT_DECIMAL "revenue"        StreamDefOut[].addColumn
  0 0  CT_DATE    "o_orderdate"    StreamDefOut[].addColumn
  0 19 CT_INTEGER "o_shippriority" StreamDefOut[].addColumn

  //StreamDefOut[].print
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 400                                                */
/*----------------------------------------------------------------------------*/
: streamDefOut_400

  StreamDefOut[].new  "Q400_out" StreamDefOut[].name!

  0 15 CT_VARCHAR "o_orderpriority" StreamDefOut[].addColumn
  0 19 CT_INTEGER "order_count"     StreamDefOut[].addColumn

  //StreamDefOut[].print
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 401                                                */
/*----------------------------------------------------------------------------*/
: streamDefOut_401

  StreamDefOut[].new  "Q401_out" StreamDefOut[].name!

  0 15 CT_VARCHAR "o_orderpriority" StreamDefOut[].addColumn
  0 19 CT_INTEGER "order_count"     StreamDefOut[].addColumn

  //StreamDefOut[].print
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: sql_StartMarker \handler

  0 locals| queryNo |

  ZK_STARTMARKER_handler

  Pot[].new

  <queryNo> >int to queryNo

  queryNo "sql %v" str.format profile.name!
  queryNo case

    103 of
      //queryNo "QUERY %v" .printf
      103 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile
      idxDef_vchvch indexDef[] indexTree[].new indexTree[].asTmp
    endof

    101 of
      //queryNo "QUERY %v" .printf
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 1  0=STARTMARKER" .
      101 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile
      idxDef_vchvch indexDef[] indexTree[].new indexTree[].asTmp
    endof

    100 of
      //queryNo "QUERY %v" .printf
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 100=STARTMARKER" .
      <tableNm> <indexNm> op__table_index not if
        false
        exit
      then
      index[].indexTree to indexTree[]
      indexTree[].asSrc
      100 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile
    endof

    300 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 300=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      300 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile


      "customer" "customer_Idx1" op__table_index assert

      Table[].asSrcStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asSrc


      "orders" "orders_Idx2" op__table_index assert

      Table[].asAltStreamDef

      Index[].indexTree to IndexTree[]
      IndexTree[].asAlt


      streamDefOut_300
      true Pot[].useStreamDefOut
      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    301 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 301=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      301 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile

      streamDefOut_301
      true Pot[].useStreamDefOut
      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    302 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 302=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      302 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile

      streamDefOut_302
      true Pot[].useStreamDefOut
      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    400 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 400=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      400 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile

      streamDefOut_400
      true Pot[].useStreamDefOut
      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    401 of
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 401=STARTMARKER" .
      //queryNo "QUERY %v" .printf
      401 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile

      streamDefOut_401
      true Pot[].useStreamDefOut
      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout
    endof

    602 of
      //queryNo "QUERY %v" .printf
      602 LogicUnit[].genCode
      logicCompiler[].new
      logicCompiler[].compile
    endof

    600 of
      //queryNo "QUERY %v" .printf
      //"^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ 600=STARTMARKER" .
      <tableNm> <indexNm> op__table_index not if
        false
        exit
      then
      index[].indexTree to indexTree[]
      indexTree[].asSrc
      600 LogicUnit[].genCode
      logicCompiler[].new
      logicCompiler[].compile
    endof

    100000 of
      //queryNo "QUERY %v" .printf
      100000 LogicUnit[].genCode

      logicCompiler[].new
      logicCompiler[].compile
      logicUnit[].dynFun
      logicCompiler[].delete
    endof

    100001 of
      //queryNo "QUERY %v" .printf
      100001 LogicUnit[].genCode

      logicCompiler[].new
      logicCompiler[].compile
      logicUnit[].dynFun
      logicCompiler[].delete
    endof

  endcase
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_300

  //"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 300=PULSEMARKER" .

  LogicUnit[].calledAgain@ not if
    PipeIn[].pipeOut // ZK_PULSEMARKER_handler
  then


  //LogicUnit[].transform
  LogicUnit[].dynFun

  false LogicUnit[].calledAgain!

  LogicUnit[].callAgain@ if
    //"Completed test" .
    Pot[].pipeoutAllCompletedPtns
    true
  else
    Pot[].pipeoutAllDanglingPtns
    Operand[].newEosMarker
    Operand[].pipeOut
    Pot[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_301

  //"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 301=PULSEMARKER" .

  ZK_PULSEMARKER_handler

  "lineitem" "lineitem_Idx1" op__table_index assert

  Table[].asAltStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asAlt

  idxDef_int indexDef[] indexTree[].new
  indexTree[].asTmp

  indexTree[] 0 LogicUnit[].dev!


//  LogicUnit[].transform
//
//  Pot[].pipeoutAllDangling
//  Pot[].delete
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_302

  //"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 302=PULSEMARKER" .

  ZK_PULSEMARKER_handler

  idxDef_int indexDef[] indexTree[].new
  indexTree[].asTmp

  indexTree[] 0 LogicUnit[].dev!
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_400

  //"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 400=PULSEMARKER" .

  ZK_PULSEMARKER_handler

  "orders" "orders_Idx1" op__table_index assert

  Table[].asSrcStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asSrc


  "lineItem" "lineItem_Idx1" op__table_index assert

  Table[].asAltStreamDef

  Index[].indexTree to IndexTree[]
  IndexTree[].asAlt

  idxDef_vch indexDef[] indexTree[].new
  indexTree[].asTmp

  indexTree[] 0 LogicUnit[].dev!


  //LogicUnit[].transform
  LogicUnit[].dynFun

  Pot[].pipeoutAllDangling
  Pot[].delete

  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_401

  //"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 401=PULSEMARKER" .

  ZK_PULSEMARKER_handler

  idxDef_vch indexDef[] indexTree[].new
  indexTree[].asTmp

  indexTree[] 0 LogicUnit[].dev!
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_600

  //"++++++++++++++++++++++++++++ 600=PULSEMARKER ++++++++++++++++++++++++++++" .

  0 locals| pColumn |

  ZK_PULSEMARKER_handler

  // new a streamDef from table
  table[] StreamDef[].new

  // new a streamDef to be piped out
  StreamDefOut[].new

  // add column SUM(L_EXTENDEDPRICE*L_DISCOUNT) as REVENUE
  5 StreamDef[].column@ to pColumn

  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "revenue"
  StreamDefOut[].addColumn

  // add column COUNT(*)
  //0 19 CT_INTEGER "count"
  //StreamDefOut[].addColumn

  // pipeout the streamDefOut
  StreamDefOut[].duplicate to Operand[]
  Operand[].pipeout

  // set streamDefOut in the pot
  true Pot[].useStreamDefOut

  LogicUnit[].DynFun
  Pot[].pipeoutAllCompleted
  Pot[].pipeoutAllDangling

  // pipeout an EOS MARKER
  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    100 of
      //"++++++++++++++++++++++++++++ 100=PULSEMARKER ++++++++++++++++++++++++++++" .
      ZK_PULSEMARKER_handler
      // pipe out a new a stream def
      Operand[].newStreamDef
      Operand[] to StreamDef[]
      nullptr to Operand[]
      StreamDef[].duplicate to StreamDefOut[]
      true Pot[].useStreamDefOut
      StreamDef[].pipeout

      LogicUnit[].dynFun
      Pot[].pipeoutAllCompleted
      Pot[].pipeoutAllDangling

      // pipeout an EOS MARKER
      Operand[].newEosMarker
      Operand[].pipeOut

    endof

    300 of sql_PulseMarker_300   endof
    301 of sql_PulseMarker_301   endof
    302 of sql_PulseMarker_302   endof

    400 of sql_PulseMarker_400   endof
    401 of sql_PulseMarker_401   endof

    600 of sql_PulseMarker_600   endof

    //"++++++++++++++++++++++++++++ OTHER=PULSEMARKER ++++++++++++++++++++++++++++" .
    ZK_PULSEMARKER_handler

  endcase


;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: sql_RsbBuffer \handler

  <queryNo> >int locals| queryNo |

  PipeIn[]
  profile.start

  queryNo case

    100 of
      //"---------------------------- 100=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      LogicUnit[].transform
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    103 of
     // "---------------------------- 103=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      LogicUnit[].dynFun
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    101 of
      //"---------------------------- 101=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      LogicUnit[].dynFun
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    301 of
      //"---------------------------- 301=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[] "RsbBuffer %v\n" .printf
      Operand[].asSrcRowSlab
      //LogicUnit[].transform
      LogicUnit[].dynFun
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    302 of
      //"---------------------------- 302=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      //true 1 LogicUnit[].transformArgs
      true 1 LogicUnit[].dynFunArgs
      Operand[].delete
      Pot[].pipeoutAllCompleted

    endof

    401 of
      //"---------------------------- 401=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      //true 1 LogicUnit[].transformArgs
      true 1 LogicUnit[].dynFunArgs
      Operand[].delete
      Pot[].pipeoutAllCompleted

    endof

    602 of
      //"---------------------------- 602=RSBBUFFER ----------------------------" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      LogicUnit[].dynFun
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    // default
    queryNo "ERROR : Unexpected queryno %v" .printf
    0 assert
  endcase

  profile.end

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: sql_EosMarker \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    100 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 100=EOSMARKER" .
      // AGGREGATE WITH GROUPBY
      //queryNo "QUERY %v" .printf
      102 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile
      LogicUnit[].dynFun
      IndexTree[].delete
    endof

    103 of
      // AGGREGATE WITH GROUPBY (SUPER)
      //queryNo "QUERY %v" .printf
      104 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile
      LogicUnit[].dynFun
      IndexTree[].delete
    endof

    101 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 1  0=EOSMARKER" .
      // AGGREGATE WITH GROUPBY
      //queryNo "QUERY %v" .printf
      102 LogicUnit[].genCode
      logicCompiler[].new
      LogicCompiler[].compile
      LogicUnit[].dynFun
      IndexTree[].delete
    endof

    300 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 300=EOSMARKER" .
    endof

    301 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 301=EOSMARKER" .
    endof

    302 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 302=EOSMARKER" .
      //false 1 LogicUnit[].transformArgs
      false 1 LogicUnit[].dynFunArgs
    endof

    401 of
      //"$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ 302=EOSMARKER" .
      //false 1 LogicUnit[].transformArgs
      false 1 LogicUnit[].dynFunArgs
    endof

  endcase

  Pot[].pipeoutAllDangling
  Pot[].delete

  // get the profile from the task
  task[] task.profile@ to Operand[]
  nullptr task[] task.profile!
  Operand[].pipeOut

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ... (100)                                        STREAMDEF */
/*----------------------------------------------------------------------------*/
: sql_StreamDef_100

  0 locals| pColumn |

  StreamDefOut[].new
  // add column L_RETURNFLAG
  8 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column L_LINESTATUS
  9 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column SUM(L_QUANTITY) as SUM_QTY
  4 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_qty"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE) as SUM_BASE_PRICESUM_QTY
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_base_price"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)) as SUM_DISC_PRICE
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_disc_price"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)*(1+L_TAX)) as SUM_CHARGESUM_QTY
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_charge"
  StreamDefOut[].addColumn

  // add column COUNT(L_QUANTITY) as COUNT_QTY
  0
  19
  CT_INTEGER
  "count_qty"
  StreamDefOut[].addColumn

  // add column COUNT(L_EXTENDEDPRICE)
  0
  19
  CT_INTEGER
  "count_price"
  StreamDefOut[].addColumn

  // add column SUM(L_DISCOUNT)) as SUM_DISCOUNT
  6 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_discount"
  StreamDefOut[].addColumn

  // add column COUNT(L_DISCOUNT)
  0
  19
  CT_INTEGER
  "count_discount"
  StreamDefOut[].addColumn

  // add column COUNT(*) as COUNT_ORDER
  0
  19
  CT_INTEGER
  "count_order"
  StreamDefOut[].addColumn

  StreamDef[].delete

  StreamDefOut[].duplicate to StreamDef[]
  StreamDef[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ... (103)                                        STREAMDEF */
/*----------------------------------------------------------------------------*/
: sql_StreamDef_103

  0 locals| pColumn |

  StreamDefOut[].new

  // add column Q101_RETURNFLAG
  0 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_LINESTATUS
  1 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_QTY as sum_qty
  2 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_BASE_PRICE as SUM_BASE_PRICESUM_QTY
  3 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_DISC_PRICE as SUM_DISC_PRICE
  4 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_CHARGE as SUM_CHARGE
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_QTY/Q101_COUNT_QTY as AVG_QTY
  2 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_qty"
  StreamDefOut[].addColumn

  // add column Q101_SUM_BASE_PRICE/Q101_COUNT_PRICE as AVG_PRICE
  3 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_price"
  StreamDefOut[].addColumn

  // add column Q101_SUM_DISC/Q101_COUNT_DISC as AVG_DISC
  8 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_disc"
  StreamDefOut[].addColumn

  // add column Q101_COUNT_ORDER as COUNT_ORDER
  10 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "count_order"
  StreamDefOut[].addColumn

  StreamDef[].delete

  StreamDefOut[].duplicate to StreamDef[]
  StreamDef[].pipeout
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: sql_StreamDef \handler

  0 0 locals| queryNo pColumn |

  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  <queryNo> >int to queryNo
  queryNo case

    100 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 100=STREAMDEF" .
      sql_StreamDef_100
      true Pot[].useStreamDefOut
    endof

    103 of
      sql_StreamDef_103
      true Pot[].useStreamDefOut
    endof

    101 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 101=STREAMDEF" .
      sql_StreamDef_100
      true Pot[].useStreamDefOut
    endof

    300 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 300=STREAMDEF" .
      // sql 300 should not get a stream def
      0 assert
    endof

    301 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 301=STREAMDEF" .
      // the stream def was  piped out in sql_StartMarker by 300
    endof

    302 of
      //"!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 302=STREAMDEF" .
      // the stream def was  piped out in sql_StartMarker by 300
    endof

    400 of
    endof

    401 of
    endof

    602 of
      StreamDef[].duplicate to StreamDefOut[]
      StreamDef[].pipeout
      true Pot[].useStreamDefOut
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: sql_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sql_EosMarker   ZK_EOSMARKER   op[].handler!
  find: sql_PulseMarker ZK_PULSEMARKER op[].handler!
  find: sql_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: sql_StartMarker ZK_STARTMARKER op[].handler!
  find: sql_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sql :: sql <queryNo> ;
cmdSyntax: sql :: sql <queryNo> <tableNm> <indexNm> ;

: sql _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
