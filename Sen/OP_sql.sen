/*============================================================================*/
/* OP_sql.sen -- sql                                                          */
/*============================================================================*/

" OP_sql.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: sql_StartMarker \handler

  0 locals| queryNo |

  Pot[].new

  //"@ 0 2 %" LogicUnit[].source!

  <queryNo> >int to queryNo
  queryNo case
    1 of
      queryNo "QUERY %v" .printf
    endof

    3 of
      queryNo "QUERY %v" .printf
    endof

    4 of
      queryNo "QUERY %v" .printf
    endof

    6 of
      queryNo "QUERY %v" .printf
      LogicUnit[].exprQuery6
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    1001 of
      queryNo "QUERY %v" .printf

      //"bs L GET gs jf END @ 0 2 % jf GET nd .s = .d j GET L END ret"
      "ss pi bs L GET gs jf END @ 0 2 % jf GET nd = j GET L END ret"
      LogicUnit[].source!

      LogicUnit[].compile assert
    endof

    1002 of
      queryNo "QUERY %v" .printf
    endof

    1003 of
      queryNo "QUERY %v" .printf
      LogicUnit[].test1003Sort
    endof

  endcase

  //LogicUnit[].compile assert

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker \handler

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: sql_RsbBuffer \handler

  <queryNo> >int locals| queryNo |

  queryNo case

    1001 of
      Operand[].pipeIn
      LogicUnit[].transform
      Operand[].delete

      Pot[].pipeoutAllCompleted
    endof

    Operand[].pipeIn
    LogicUnit[].query
    Operand[].delete

    Pot[].pipeoutAllCompleted

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: sql_EosMarker \handler

  Pot[].pipeoutAllDangling

  Pot[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: sql_StreamDef \handler

  0 0 locals| queryNo pColumn |

  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  <queryNo> >int to queryNo
  queryNo case
    1 of
    endof

    3 of
    endof

    4 of
    endof

    6 of
      StreamDefOut[].new
      5 StreamDef[].column@ to pColumn

      pColumn column.scale@
      pColumn column.length@
      pColumn column.type@
      "revenue"
      StreamDefOut[].addColumn
      StreamDef[].delete

      StreamDefOut[].duplicate to StreamDef[]
      StreamDef[].pipeout

      StreamDefOut[].print
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

    1001 of
      StreamDef[].pipeout
    endof

    1002 of
    endof

    1003 of
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: sql_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sql_EosMarker   ZK_EOSMARKER   op[].handler!
  find: sql_PulseMarker ZK_PULSEMARKER op[].handler!
  find: sql_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: sql_StartMarker ZK_STARTMARKER op[].handler!
  find: sql_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sql :: sql <queryNo> ;

: sql _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
