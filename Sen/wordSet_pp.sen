/*============================================================================*/
/* wordSet_pp.sen -- performance point words                                  */
/*============================================================================*/

" wordSet_pp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* named performance point                                                    */
/*----------------------------------------------------------------------------*/
: pp: immediate

  token:
  encodePushValue
  //tick . compile,

  word::this encodePushValue
  tick word.name compile,
  //tick . compile,
  tick performancepoint compile,
;

: ppTest

  "before" .
  pp: first
  pp: second
  pp: third
  "after" .

  performancePrint
;

: ppLoops

  100000 0 do
    pp: ppLoops

    I 1000 % 0 == if
      I .
    then

  loop

  performancePrint
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
