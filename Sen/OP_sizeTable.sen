/*============================================================================*/
/* OP_sizeTable.sen -- Operator size table                                    */
/*============================================================================*/

" OP_sizeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: sztbl_action

  <tableNm> op__table not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeout

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  0 table[].size number.magnitude >str

  // insert index size
  streamSetTable[] StreamSet[].addSizeTable assert

  // pipeout the infoset
  StreamSet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sztbl :: sztbl <tableNm> ;

: sztbl _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __sizeTable
    <params>    = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
