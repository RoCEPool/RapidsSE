/*============================================================================*/
/* job__generic.sen -- generic job related words                              */
/*============================================================================*/

"job__generic.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                              Job                                           //
////////////////////////////////////////////////////////////////////////////////
/*----------------------------------------------------------------------------*/
/* distribute the job to all the nodes                                        */
/*----------------------------------------------------------------------------*/
: Job::distribute ( ^task ^job -- )

  locals| pJob pTask |

  // set originating task
  pTask pJob job.originatingTask!

  // add job to originator jobs
  pJob job.addOriginator

  // set the no of acks expected in originator job to nodes in the grid
  grid::nodes pJob job.acksRemaining!

  // grab this task's lock
  task::this task.grabLock

  // set acks for originator task
  1 setAcks

  // send the job to each node in the grid
  grid::nodes 0 do

    // set the send node
    I grid::node pTask task.sendNode!
    task.send

    // add job to valset
    pJob 1 >valset

    // send job
    >socketR35

  loop

  // wait for ack from deciding job__Ended
  ackWait
;

////////////////////////////////////////////////////////////////////////////////
//                              Job__Ended                                    //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* execute Job__Ended on originating node                                     */
/*----------------------------------------------------------------------------*/
: Job__Ended::execute ( iJobId pJob__Ended -- )

  params| pJob__Ended iJobId |

  0 0 locals| pJob iAcksRemaining |

  // find the job in the originator jobs
  iJobId job.findOriginator to pJob

  // decrement the acks remaining
  pJob job.decAcksRemaining to iAcksRemaining

  // if there are acks remaining just exit
  iAcksRemaining 0 != if exit then

  "received Job__Ended from all nodes" .

  // all the lines below get moved to nodeStatusR35_req
/*
  grid::nodes 0
  do
    I pJob job.error@ error.msg .
  loop

  // somehow notify the request task that job is ended
  // all the lines below get moved to nodeStatusR35_req
  grid::nodes 0
  do
    I pJob job.response@ .
  loop

  // remove the job from the originator jobs
  pJob job.removeOriginator

  // delete the job
  pJob job.delete
*/

  // remove the job from the originator jobs
  pJob job.removeOriginator

  // notify the originating task
  pJob job.originatingTask@ ack

  "All Done" .
;

/*----------------------------------------------------------------------------*/
/* send Job__Ended back to originating node                                   */
/*----------------------------------------------------------------------------*/
: Job__Ended::send ( iJobId -- )

  params| iJobId |

  0 locals| pJob__Ended |

  // send ended to originating node
  iJobId job.newEnded to pJob__Ended

  // send job__end to originating node
  iJobId job::originator@ grid::node task::this task.sendNode!
  task.send

  // send the ended job
  pJob__Ended 1 >valset

  >socketR35

  // now delete the ended job
  pJob__Ended job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                               Job__End                                     //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* execute Job__End on participating node                                     */
/*----------------------------------------------------------------------------*/
: Job__End::execute ( iJobId pJob__End -- )

  params| pJob__End iJobId |

  0 locals| pJob |

  // find the job in the participating jobs
  iJobId job.findParticipant to pJob

  // remove the job from the participant jobs
  pJob job.removeParticipant

  // delete the job
  pJob job.delete

  iJobId Job__Ended::send
;

/*----------------------------------------------------------------------------*/
/* distribute Job__End to all participants                                    */
/*----------------------------------------------------------------------------*/
: Job__End::distribute ( pJob -- )

  //
  // where:  On the originator node.
  //

  params| pJob |

  0 locals| pJob__End |

  // set the no of acks expected in originator job
  grid::nodes pJob job.acksRemaining!

  // new a temporary Job__End
  pJob job.id@ job.newEnd to pJob__End

  // send Job__End to all nodes
  grid::nodes 0
  do
  // set which node this task will to send to
  I grid::node task::this task.sendNode!

  // move this task through send state/queue
  task.send

  // pack Job__End into a valset
  pJob__End 1 >valset

  // send the end job
  >socketR35
  loop

  // now delete the end job
  pJob__End job.delete
;


////////////////////////////////////////////////////////////////////////////////
//                             Job__Cancelled                                 //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job__Cancelled back to originating node                                */
/*----------------------------------------------------------------------------*/
: Job__Cancelled::send ( iJobId pJobParticipant -- )

  params| pJobParticipant iJobId |

  0 0 0 locals| pJob pJob__Cancelled error |

  // new a temporary Job__Cancelled
  iJobId job.newCancelled to pJob__Cancelled

  // set the originator node as the send target node
  iJobId job::originator@ grid::node task::this task.sendNode!

  grid::thisNode@ pJobParticipant job.error@ to error

  error EC_NONE != if
    // set error in executed job
    error pJob__Cancelled jobCancelled.error!
  then

  // move this task through send state/queue
  task.send

  // pack Job__Cancelled into a valset
  pJob__Cancelled 1 >valset

  // send Job__Executed
  >socketR35

  // delete the pJob__Cancelled
  pJob__Cancelled job.delete
;

/*----------------------------------------------------------------------------*/
/* execute Job__Cancelled on originating node                                  */
/*----------------------------------------------------------------------------*/
: Job__Cancelled::execute ( iJobId pJob__Cancelled -- )

  params| pJob__Cancelled iJobId |

  0 0 0 0 0 locals| pJobParticipant iParticipantNode error pJob iAcksRemaining |

  // get participant node that executed the job
  iJobId job.findParticipant to pJobParticipant
  pJob__Cancelled job.participant@ to iParticipantNode

  // find the job in the originator jobs
  iJobId job.findOriginator to pJob

  // get the error code from job__executed
  pJob__Cancelled jobCancelled.error@ to error

  // set the error code in pJob
  error iParticipantNode pJob job.error!

  // decrement the acks remaining
  pJob job.decAcksRemaining to iAcksRemaining

  // if there are acks remaining just exit
  iAcksRemaining 0 != if exit then

  "received Job__Executed from all nodes" .

  pJob Job__End::distribute
;

////////////////////////////////////////////////////////////////////////////////
//                             Job__Cancel                                    //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job__Cancel to all participants                                 */
/*----------------------------------------------------------------------------*/
: Job__Cancel::distribute ( pJob -- )

  //
  // where:  On the originator node.
  //

  params| pJob |

  0 locals| pJob__Cancel |

  // set the no of acks expected in originator job
  grid::nodes pJob job.acksRemaining!

  // create a new Job__Cancel
  pJob job.id@ job.newCancel to pJob__Cancel

  // send job__execute to all nodes
  grid::nodes 0
  do
    // set which node this task will to send to
    I grid::node task::this task.sendNode!

    // move this task through send state/queue
    task.send

    // pack Job__Cancel into a valset
    pJob__Cancel 1 >valset

    // send the execute job
    >socketR35
  loop

  // now delete the cancel job
  pJob__Cancel job.delete
;

/*----------------------------------------------------------------------------*/
/* execute Job__Cancel on participating node                                 */
/*----------------------------------------------------------------------------*/
: Job__Cancel::execute ( iJobId pJob__Execute -- )

  params| pJob__Cancel iJobId |

  0 0 0 locals| sReleaseResources pJob pJobCancelled |

  // find the job in the participating jobs
  iJobId job.findParticipant to pJob

  // execute the job's releaseResources command
  pJob job.releaseResources@ to sReleaseResources
  sReleaseResources "" str.equal not if 
    pJob sReleaseResources find execute
  then

  // send job__executed back to originating node
  iJobId pJob Job__Cancelled::send
;

////////////////////////////////////////////////////////////////////////////////
//                             Job__Executed                                  //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job__Executed back to originating node                                */
/*----------------------------------------------------------------------------*/
: Job__Executed::send ( iJobId pJobParticipant -- )

  params| pJobParticipant iJobId |

  0 0 0 locals| pJob pJob__Executed error |

  // new a temporary Job__Executed
  iJobId job.newExecuted to pJob__Executed

  // set the originator node as the send target node
  iJobId job::originator@ grid::node task::this task.sendNode!

  grid::thisNode@ pJobParticipant job.error@ to error

  error EC_NONE == if
    // get the response from participant job and set it in executed job
    grid::thisNode@  pJobParticipant job.response@ pJob__Executed jobExecuted.response!

    // get the no of rows processed from participant job and set it in executed job
    grid::thisNode@  pJobParticipant job.rowsProcessed@ pJob__Executed jobExecuted.rowsProcessed!
  else
     // set error in executed job
     error pJob__Executed jobExecuted.error!
  then

  // move this task through send state/queue
  task.send

  // pack Job__Executed into a valset
  pJob__Executed 1 >valset

  // send Job__Executed
  >socketR35

  // delete the Job__Executed
  pJob__Executed job.delete
;

/*----------------------------------------------------------------------------*/
/* execute Job__Executed on originating node                                  */
/*----------------------------------------------------------------------------*/
: Job__Executed::execute ( iJobId pJob__Executed -- )

  params| pJob__Executed iJobId |

  0 0 0 0 0 0 locals| pJobParticipant iParticipantNode error pJob iAcksRemaining |

  // get participant node that executed the job
  iJobId job.findParticipant to pJobParticipant
  pJob__Executed job.participant@ to iParticipantNode

  // find the job in the originator jobs
  iJobId job.findOriginator to pJob

  // get the error code from job__executed
  pJob__Executed jobExecuted.error@ to error

  error EC_NONE == if

    // get the response string from job__executed and set in pJob
    pJob__Executed jobExecuted.response@ iParticipantNode pJob job.response!

    // get the rows processed from job__executed and set in pJob
    pJob__Executed jobExecuted.rowsProcessed@ iParticipantNode pJob job.rowsProcessed!

  else

    // set the error code in pJob
    error iParticipantNode pJob job.error!

  then

  // decrement the acks remaining
  pJob job.decAcksRemaining to iAcksRemaining

  // if there are acks remaining just exit
  iAcksRemaining 0 != if exit then

  "received Job__Executed from all nodes" .

  pJob Job__End::distribute

;

////////////////////////////////////////////////////////////////////////////////
//                             Job__Execute                                   //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job__Execute to all participants                                */
/*----------------------------------------------------------------------------*/
: Job__Execute::distribute ( pJob -- )

  //
  // where:  On the originator node.
  //

  params| pJob |

  0 locals| pJob__Execute |

  // set the no of acks expected in originator job
  grid::nodes pJob job.acksRemaining!

  // create a new job__execute
  pJob job.id@ job.newExecute to pJob__Execute

  // send job__execute to all nodes
  grid::nodes 0
  do
    // set which node this task will to send to
    I grid::node task::this task.sendNode!

    // move this task through send state/queue
    task.send

    // pack Job__Execute into a valset
    pJob__Execute 1 >valset

    // send the execute job
    >socketR35
  loop

  // now delete the execute job
  pJob__Execute job.delete
;

/*----------------------------------------------------------------------------*/
/* execute Job__Execute on participating node                                 */
/*----------------------------------------------------------------------------*/
: Job__Execute::execute ( iJobId pJob__Execute -- )

  params| pJob__Execute iJobId |

  0 0 locals| pJob pJobExecuted |

  // find the job in the participating jobs
  iJobId job.findParticipant to pJob

  // execute the job on this participating node
  pJob pJob job.execute@ find execute

  // send job__executed back to originating node
  iJobId pJob Job__Executed::send
;

////////////////////////////////////////////////////////////////////////////////
//                             Job__Begun                                     //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job__Begun back to originating node                                   */
/*----------------------------------------------------------------------------*/
: Job__Begun::send ( iJobId pJobParticipant -- )

  params| pJobParticipant iJobId |

  0 0 0 locals| pJob pJob__Begun error |

  // new a temporary Job__Executed
  iJobId job.newBegun to pJob__Begun

  // set the originator node as the send target node
  iJobId job::originator@ grid::node task::this task.sendNode!

  // get error if any
  grid::thisNode@ pJobParticipant job.error@ to error

  error EC_NONE != if
    // set error in executed job
    error error.msg "Setting error '%v' in Job__Begun" str.format .
    error pJob__Begun jobBegun.error!
  then

  // move this task through send state/queue
  task.send

  // pack Job__Executed into a valset
  pJob__Begun 1 >valset

  // send Job__Executed
  >socketR35

  // delete the Job__Executed
  pJob__Begun job.delete
;

/*----------------------------------------------------------------------------*/
/* execute Job__Begun on originating node                                     */
/*----------------------------------------------------------------------------*/
: Job__Begun::execute ( iJobId Job__Begun -- )

  //
  // where:  On the originator node.
  // event:  A Job__Begun has been received from a participating node
  //         indicating the job has been received and put into the
  //         participating jobs list.
  // data:   The job will exist in the originating jobs list.
  // action: 1) find the job in the originating list;
  //         2) decrement its ack's remaining
  //         3) if all acks received distribute Job_Execute
  //

  params| pJob__Begun iJobId |

  0 locals| pJob  |
  0 0 0 0 locals| iAcksRemaining error pJobParticipant iParticipantNode |

  // get participant node that executed the job
  iJobId job.findParticipant to pJobParticipant
  pJob__Begun job.participant@ to iParticipantNode

  // find the job in the originator jobs
  iJobId job.findOriginator to pJob

  // get the error code from job__executed
  pJob__Begun jobBegun.error@ to error

  error EC_NONE != if
    // set the error code in pJob
    error iParticipantNode pJob job.error!
  then

  // decrement the acks remaining
  pJob job.decAcksRemaining to iAcksRemaining

  // test for all acks received all
  iAcksRemaining 0 != if exit then

  "received job__begun from all nodes" .

  // received job__begun from all nodes
  // this is the decider job.

  // check if any node returned an error
  grid::nodes 0 do
    I pJob job.error@ EC_NONE != if
      // distribute Job__Cancel to all participants
      pJob Job__Cancel::distribute
      unloop
      exit
    then
  loop

  // distribute Job__Execute to all participants
  pJob Job__Execute::distribute
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
