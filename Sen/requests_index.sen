/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create an index on a table                                                 */
/*----------------------------------------------------------------------------*/
: create_index ( "<indexNm>" "<tableNm>" -- <R> )

tp: create_index
  ddlLock.grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeIndex     not if <NIP+ERROR> exit then

  makeIndex ( ) assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop an index                                                              */
/*----------------------------------------------------------------------------*/
: drop_index ( "<indexNm>" -- <R> )

  tp: dropIndex

  ddlLock.grabWrite

  // move to indexes folder
  "indexes" find execute dup not if drop EC_NOT_IN_TABLE false exit then
  pathPush

  checkRemoveIndex not if <NIP+ERROR> exit then

  tp ( "<indexNm>" )

  removeIndex ( ) assert.stack_0

  tp: droppedIndex

  pathDrop

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump index                                                                 */
/*----------------------------------------------------------------------------*/
: dump_index ( "<indexNm>" -- <R> )

  ddlLock.grabRead

  checkInIndexes not if <NIP+ERROR> exit then
  checkIsIndex  not if <NIP+ERROR> exit then

  find execute
  index.dump

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create index sequence                                               */
/*----------------------------------------------------------------------------*/
: end_create_index ( "<indexNm>" -- <R> )

tp: end_create_index

  ddlLock.grabWrite

  dup
  checkInIndexes not if <NIP+ERROR> exit then

  "end_create_index" .

  columnVecIndex

  assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of indices                                                        */
/*----------------------------------------------------------------------------*/
: list_indexes ( "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
