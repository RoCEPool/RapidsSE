/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create an index on a table                                                 */
/*----------------------------------------------------------------------------*/
: create_index ( "<indexNm>" "<tableNm>" "<columnNm>"-- <R> )

tp: create_index
  ddlLock.grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  //1 pick getTableRef not if <NIP+ERROR> exit then

  makeIndex ( ) assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of indices                                                        */
/*----------------------------------------------------------------------------*/
: list_indexes ( "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
