/*============================================================================*/
/* requests_index.sen -- the set of index related requests                    */
/*============================================================================*/

"requests_index.sen" .verbose

timer: pIdxSelectTimer

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyzeIdx ( "<sIndexNm>" "<sTableNm>" bDetailed -- <R> )
                                                                    // ../tables
  tp: analyzeIdx

  locals| bDetailed sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> assertInTables exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
     popIndexes popTable                                            // ../tables
     assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // analyse the index
  bDetailed not if
    args.metadata if
      "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, entries INTEGER)"
        metadata!
    then
  then

  bDetailed sIndexNm analyzeIndex ( )

  // set no of rows processed equal to total no of partitions
  grid.partitions task::this task.seitf@ seitf.rowsProcessed

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path 

  popIndexes popTable assertInTables                                // ../tables

  tp: analyzedIndex

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyzeIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
   0 analyzeIdx
;

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: danalyzeIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
  1 analyzeIdx
;

/*----------------------------------------------------------------------------*/
/* create an index on a table                                                 */
/*----------------------------------------------------------------------------*/
: createIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  tp: createIndex_req

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  checkEnoughBuffers not if <NIP+ERROR> exit then

  sIndexNm sTableNm checkMakeIndex  not if <NIP+ERROR> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create index

  //sTableNm pushTable assert                                // ../tables/sTableNm
  //sTableNm getTable_req
  //popTable                                                          // ../tables

  sTableNm sIndexNm makeIndex assertInTables

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* distributed export of a table                                              */
/*----------------------------------------------------------------------------*/
: distFetchRowsIndex_req ( "<sWhere>" "<sTableNm>" -- <R> )

  locals| sTableNm sWhere |
  ddlLock::grabRead

  //sWhere 0 == if
  //  sTableNm "Executing a distributed fetch of table %v" str.format .
  //else
    sWhere sTableNm "Executing a distributed fetch of table %v where %v" str.format .
  //then

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert

  // check it is a table
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // call the distributed fetch
  sWhere sTableNm distFetchRowsIndex not if <NIP+ERROR> exit then

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop an index                                                              */
/*----------------------------------------------------------------------------*/
: dropIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  tp: dropIndex

  locals| sTableNm sIndexNm |

  assertInTables

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  sIndexNm sTableNm checkRemoveIndex not if <NIP+ERROR> exit then

  tp ( "<sIndexNm>" )

  // push table dictionary
  sTableNm pushTable assert ( "<sIndexNm>" )               // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert ( "<sIndexNm>" )              // ../tables/sTableNm/indexes

  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  sIndexNm "hidden" str.equal if
    popIndexes popTable assertInTables EC_NO_SUCH_INDEX <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index
  sIndexNm removeIndex ( ) assert::stack_0

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  assertInTables

  tp: droppedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump index                                                                 */
/*----------------------------------------------------------------------------*/
: dumpIndex_req ( "<sIndexNm>" "<sTableNm" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump index

  sIndexNm find execute
  index.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: dumpedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create index sequence                                               */
/*----------------------------------------------------------------------------*/
: endCreateIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                    // ../tables
  0 locals| pIndexPtr sTableNm sIndexNm |

  tp: endCreateIndex_req

  assertInTables

  ddlLock::grabWrite

  // push table dictionary
  sTableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks
  checkInIndexes not if <NIP+ERROR> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create column vector and populate index

  // create the column vector of the index
  sIndexNm columnVecIndex

  // validate the unqiue index columns are a subset of the partition keys
  sIndexNm findInCurrent execute to pIndexPtr
  pIndexPtr index.isUnique@ if
    pIndexPtr index.isValidUniqueIndex
      not if EC_INVALID_COLUMNS_UNIQUE_INDEX <NIP+ERROR> popIndexes popTable
        exit then
  then

  // now populate the index
  sIndexNm populateIndex
     not if <NIP+ERROR> popIndexes popTable
        exit then
                                                    // ../tables/tableNm/indexes
  // pop indexes
  popIndexes                                                // ../tables/tableNm

  // return the table reference
  returnTableRef not if <NIP+ERROR> popTable exit then
  task::this task.seitf@ seitf.table@ not assert

  // pop table folder
  popTable

  assertInTables

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* generate plan for the fetch                                                */
/*----------------------------------------------------------------------------*/
: generatePlan ( "<sWhere>" ^pTable -- ^pPlanner )

  0 0 locals| pPlanner pAccessPath pTable sWhere |

  //sWhere "generatePlan" "%v %v" str.format .

  ( cdt_0 ) planner::new to pPlanner
  ( cdt_1 ) pTable pPlanner Planner.table!

  ( cdt_2 ) sWhere pPlanner Planner.parseWhere  //"parseWheres" .

  ( cdt_3 ) pPlanner Planner.genPaths           //"genPaths" .
  ( cdt_4 ) pPlanner Planner.scorePaths         //"scorePaths" .
  //( cdt_5 ) pPlanner Planner.showPaths

  ( cdt_6 ) pPlanner Planner.matchPaths         //"matchPaths" .
  //( cdt_6 ) pPlanner Planner.showPaths

  ( cdt_7 ) pPlanner Planner.choosePaths        //"choosePaths" .

  // return planner
  pPlanner
;

/*----------------------------------------------------------------------------*/
/* fetch rows using an index for given phrase (this is request)               */
/*----------------------------------------------------------------------------*/
: spawnFetch ( pBufferQueue iSlot bGroupBy i_Phrase pPlanner -- <R> )

  //assert::stack_5

  locals| pPlanner i_Phrase bGroupBy iSlot pBufferQueue |

//0 locals| i_Phrase |

  //"Phrase " i_Phrase >str str.cat .

  //i_Phrase pPlanner Planner.indexNm@ .

  // put the planner in the seitf (moved to req)
  //pPlanner task::this task.seitf@ seitf.planner!

  i_Phrase pPlanner Planner.fetchTechnique@
  case

  // an exact select using index
  AT_EXACT of
    //"case equal" .
    i_Phrase
    pPlanner
    i_Phrase pPlanner Planner.key@
    "0"  //lower
    "0"  //upper
    "exactSelectIdxTask"
    i_Phrase pPlanner Planner.indexNm@
    pBufferQueue iSlot spawnSelectTask
  endof

  // a lower bound select using index
  AT_LOWER of
    //"case lower" .
    i_Phrase
    pPlanner
    "0" //key
    i_Phrase pPlanner Planner.lowKey@
    "0" //upper
    "lowerSelectIdxTaskOLD"
    i_Phrase pPlanner Planner.indexNm@
    pBufferQueue iSlot spawnSelectTask
  endof

  // an upper bound select using index
  AT_UPPER of
    //"case upper" .
    i_Phrase
    pPlanner
    "0" //key
    "0" //lower
    i_Phrase pPlanner Planner.highKey@
    "upperSelectIdxTaskOLD"
    i_Phrase pPlanner Planner.indexNm@
    pBufferQueue iSlot spawnSelectTask
  endof

  // a range select using index
  AT_RANGE of
    i_Phrase
    pPlanner
    "0" //key
    i_Phrase pPlanner Planner.lowKey@
    i_Phrase pPlanner Planner.highKey@
    bGroupBy if
      //"case groupBy" .
      "groupByIdxTask_RH"
      "hidden"
      spawnGroupByTask
    else
      //"case range" .
      "rangeSelectIdxTaskOLD"
      i_Phrase pPlanner Planner.indexNm@
      pBufferQueue iSlot spawnSelectTask
    then
  endof

  // full scan (no index)
  AT_SCAN of
    //"case scan" .
    i_Phrase
    pPlanner
    "0" //key
    "0" //lower
    "0" //upper
    "scanSelectIdxTask"
    "hidden"
     pBufferQueue iSlot spawnSelectTask
    endof
  endcase

  // delete the planner

  //i_Phrase 1 + pPlanner planner.phrases@ ==
  //if
  //  pPlanner planner.delete
  //then
;

/*----------------------------------------------------------------------------*/
/* spawn fetch rows task (this is request)                                    */
/*----------------------------------------------------------------------------*/
: spawnFetchRows_apiReq ( "groupBy" "<sWhere>" "<sTableNm>" -- <R> )
  // ../tables
  //"fetchRowsIndex_req" .

  // task is a request server
  task::this task.kind@ TK_REQUEST_SERVER == assert

  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_INTVAL assert::class_2

  0 0 0 0 0 locals| pBufferQueue pSeitf iSlot pPlanner pTable sTableNm sWhere bGroupBy |

  pIdxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // get the seitf
  task::this task.seitf@ to pSeitf

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  sTableNm find execute to pTable

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // generate plan for the fetch
  sWhere pTable generatePlan to pPlanner

  // assert we have a plan
  pPlanner assert

  // set the no of last buffers to no of phrases in plan
  pPlanner planner.phrases@ pSeitf seitf.lastBuffers!

  // spawn select task for the fetch
  //0 locals| i_Phrase |

  //pPlanner planner.phrases@ .

  // create the buffer queue in the seitf
  "selectTask.queue" queue::new to pBufferQueue
  //pBufferQueue >str "BufferQueue %v" str.format .

  // set planner in seitf
  pPlanner task::this task.seitf@ seitf.planner!

  // get the slot no from the seitf
  pSeitf seitf.slot@ to iSlot

  pPlanner planner.phrases@ 0
  do
    pBufferQueue iSlot bGroupBy I pPlanner spawnFetch
  loop
  <OK>
;

/*----------------------------------------------------------------------------*/
/* spawn a fetcg task for each slot                                           */
/*----------------------------------------------------------------------------*/
: spawnFetchForEachSlot ( iPhrase pBufferQueue bGroupBy pPlanner )

  0 locals| iSlots pPlanner bGroupBy pBufferQueue iPhrase |

  // for each slot
  grid.slots to iSlots
  iSlots 0
  do
    pBufferQueue I bGroupBy iPhrase pPlanner spawnFetch
  loop
;

/*----------------------------------------------------------------------------*/
/* fetch rows using an index (this is request)                                */
/*----------------------------------------------------------------------------*/
: fetchRowsIndex_req ( "groupBy" "<sWhere>" "<sTableNm>" -- <R> )
                                                                    // ../tables
//"fetchRowsIndex_req" .

  //pp: beginning

  // task is a request server
  task::this task.kind@ TK_REQUEST_SERVER == assert

  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_INTVAL assert::class_2

  0 0 0 0 locals| pBufferQueue pSeitf pPlanner pTable sTableNm sWhere bGroupBy |

  pIdxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ to pSeitf
  pSeitf seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  sTableNm find execute to pTable

  // set the metadata string
  args.metadata if
    pTable table.getColumns "(partition INTEGER,%v)" str.format metadata!
  then

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // generate plan for the fetch
  sWhere pTable generatePlan to pPlanner

  // assert we have a plan
  pPlanner assert

  // set the no of last buffers to no pf phrases in plan
  pPlanner planner.phrases@ grid.slots * pSeitf seitf.lastBuffers!

  // create the buffer queue in the seitf
  "selectTask.queue" queue::new to pBufferQueue
  //pBufferQueue >str "BufferQueue %v" str.format .

  // set planner in seitf
  pPlanner task::this task.seitf@ seitf.planner!

  // spawn select task for the fetch
  //0 locals| i_Phrase |
  pPlanner planner.phrases@ 0
  do
    I pBufferQueue bGroupBy pPlanner spawnFetchForEachSlot
  loop

  popTable assertInTables

  //pp: end

  //performancePrint

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get an index                                                               */
/*----------------------------------------------------------------------------*/
: getIndex_req ( "<indexNm>" "<tableNm>"-- <R> )

  getIndex not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of indexes                                                        */
/*----------------------------------------------------------------------------*/
: listIndexes_req ( "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list indexes
  listIndexesContents

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* return an index                                                            */
/*----------------------------------------------------------------------------*/
: returnIndex_req ( "<indexNm>" -- <R> )

  returnIndex not if <NIP+ERROR> exit then

  <OK>
;
/*----------------------------------------------------------------------------*/
/* set unique property of an index                                            */
/*----------------------------------------------------------------------------*/
: indexSetUnique_req ( true/false "<sIndexNm>" "<sTableNm>" -- <R> )
                                                   // ../tables
  assert::stack_3

  assertInTables

  locals| sTableNm sIndexNm bIsUnique |

  // push table dictionary
  sTableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  tp: indexSetUnique_req

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks
  checkInIndexes not if <NIP+ERROR> popIndexes popTable exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // uniqueness
  bIsUnique sIndexNm setIndexIsUnique ( ) assert::stack_0

  // pop indexs folder
  popIndexes

  // pop table folder
  popTable

  assertInTables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of index                                                          */
/*----------------------------------------------------------------------------*/
: sizeIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check there is an index of the name
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get index size
  sIndexNm sizeIndex ( "<size>" )

  args.metadata if
    "(size VARCHAR)" metadata!
    "row: ('" swap str.cat
    "')\n" str.cat
    1 task::this task.seitf@ seitf.rowsProcessed
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate index                                                             */
/*----------------------------------------------------------------------------*/
: truncateIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check there is an index of the name
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // truncate index

  // find the index
  sIndexNm find execute

  // truncate the index
  index.truncate

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* verify an index of a table                                                 */
/*----------------------------------------------------------------------------*/
: verifyIdx ( "<sIndexNm>" "<sTableNm>" -- <R> )
  // ../tables
  tp: verifyIdx

  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> assertInTables exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
  popIndexes popTable                                            // ../tables
  assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // verify the index
  args.metadata if
  "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, entries INTEGER)"
  metadata!
  then

  sIndexNm verifyIndex ( )

  // set no of rows processed equal to total no of partitions
  grid.partitions task::this task.seitf@ seitf.rowsProcessed

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: verifiedIndex

  not if <NIP+ERROR> else <SUCCESS> then
;


/*----------------------------------------------------------------------------*/
/* verify an index of a table                                                 */
/*----------------------------------------------------------------------------*/
: verifyIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
   verifyIdx
;

/*----------------------------------------------------------------------------*/
/* visualize index                                                            */
/*----------------------------------------------------------------------------*/
: visualizeIndex_req ( "<sIndexNm>" "<sTableNm" -- <R> )
  // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
  popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize index

  sIndexNm find execute
  index.visualize

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: dumpedIndex

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
