/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyze_index ( "<tableNm>" "<indexNm>"-- <R> )

  tp: analyzeIndex

  locals| indexNm tableNm |

  ddlLock::grabWrite

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  indexNm checkIsIndex  not if popIndexes popTable <NIP+ERROR> exit then

  analyzeIndex ( )

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  tp: analyzedIndex

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* create an index on a table                                                 */
/*----------------------------------------------------------------------------*/
: create_index ( "<indexNm>" "<tableNm>" -- <R> )

tp: create_index
  ddlLock::grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeIndex     not if <NIP+ERROR> exit then

  makeIndex ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop an index                                                              */
/*----------------------------------------------------------------------------*/
: drop_index ( "<tableNm>" "<indexNm>" -- <R> )

  tp: dropIndex

  locals| indexNm tableNm |
  ddlLock::grabWrite

  tableNm indexNm checkRemoveIndex not if <NIP+ERROR> exit then

  tp ( "<indexNm>" )

  // push table dictionary
  tableNm pushTable assert ( "<indexNm>" )

  // push indexes folder
  pushIndexes assert ( "<indexNm>" )

  checkIsIndex  not if popIndexes popTable <NIP+ERROR> exit then

  removeIndex ( ) assert::stack_0

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  tp: droppedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump index                                                                 */
/*----------------------------------------------------------------------------*/
: dump_index ( "<tableNm" "<indexNm>" -- <R> )

  locals| indexNm tableNm |

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  indexNm checkIsIndex  not if popIndexes popTable <NIP+ERROR> exit then

  find execute
  index.dump

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create index sequence                                               */
/*----------------------------------------------------------------------------*/
: end_create_index ( "<indexNm>" -- <R> )

tp: end_create_index

  ddlLock::grabWrite

  dup
  checkInIndexes not if <NIP+ERROR> exit then

  //"end_create_index" .

  columnVecIndex

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of indices                                                        */
/*----------------------------------------------------------------------------*/
: list_indexes ( "<tableNm>" -- <R> )

ddlLock::grabRead

  checkInTables not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* get size of index                                                          */
/*----------------------------------------------------------------------------*/
: size_index ( "<tableNm>" "<indexNm>" -- <R> )

  locals| indexNm tableNm |

ddlLock::grabWrite

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  indexNm checkIsIndex  not if popIndexes popTable <NIP+ERROR> exit then

  sizeIndex ( "<size>" )

  // pop table folder
  popIndexes

  // pop table folder
  popTable

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate index                                                             */
/*----------------------------------------------------------------------------*/
: truncate_index ( "<tableNm" "<indexNm>" -- <R> )

  locals| indexNm tableNm |

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  indexNm checkIsIndex  not if popIndexes popTable <NIP+ERROR> exit then

  find execute
  index.truncate

  // pop indexes folder
  popIndexes

  // pop table folder
  popTable

<OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
