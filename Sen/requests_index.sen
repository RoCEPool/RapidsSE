/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose

timer: idxSelectTimer

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyze_index ( "<indexNm>" "<tableNm>" -- <R> )

  tp: analyzeIndex

  locals| tableNm indexNm |

  ddlLock::grabWrite

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> assertInTables exit then

  // push table dictionary
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  indexNm checkIsIndex not if
     popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  indexNm analyzeIndex ( )

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  tp: analyzedIndex

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* create an index on a table                                                 */
/*----------------------------------------------------------------------------*/
: create_index ( "<indexNm>" "<tableNm>" -- <R> )

  locals| tableNm indexNm |

tp: create_index

  ddlLock::grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  indexNm tableNm checkMakeIndex  not if <NIP+ERROR> exit then

  tableNm pushTable assert
    tableNm get_table
  popTable

  tableNm indexNm makeIndex ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop an index                                                              */
/*----------------------------------------------------------------------------*/
: drop_index ( "<indexNm>" "<tableNm>" -- <R> )

  tp: dropIndex

  locals|  tableNm indexNm |
  ddlLock::grabWrite

  indexNm tableNm checkRemoveIndex not if <NIP+ERROR> exit then

  tp ( "<indexNm>" )

  // push table dictionary
  tableNm pushTable assert ( "<indexNm>" )

  // push indexes folder
  pushIndexes assert ( "<indexNm>" )

  // check it is an index we are dropping
  indexNm checkIsIndex  not if popIndexes popTable assertInTables <NIP+ERROR> exit then

  // remove the index
  indexNm removeIndex ( ) assert::stack_0

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  tp: droppedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump index                                                                 */
/*----------------------------------------------------------------------------*/
: dump_index ( "<indexNm>" "<tableNm" -- <R> )

  locals| tableNm indexNm |

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  indexNm checkIsIndex  not if popIndexes popTable assertInTables <NIP+ERROR> exit then

  indexNm find execute
  index.dump

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

tp: dumpedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create index sequence                                               */
/*----------------------------------------------------------------------------*/
: end_create_index ( "<indexNm>" "<tableNm>" -- <R> )

  locals| tableNm indexNm |

tp: end_create_index

  ddlLock::grabWrite

  checkInIndexes not if <NIP+ERROR> exit then

  //"end_create_index" .

  // create the column vector of the index
  indexNm columnVecIndex

  // pop indexes folder temporarily
  popIndexes

  // return teh table reference
  returnTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ not assert

  // push back teh indexes folder
  pushIndexes assert

  assertInIndexes

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of indices                                                        */
/*----------------------------------------------------------------------------*/
: list_indexes ( "<tableNm>" -- <R> )

  locals| tableNm |

ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  listContents

  // pop indexes folder
  popIndexes

  // pop table dictionary
  popTable

  // assert we are still in tables folder
  assertInTables

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* lower bound select of table given an index                                 */
/*----------------------------------------------------------------------------*/
: lower_select_index ( "<lower>" "<indexNm>" "<tableNm>" -- <R> )

  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_STRVAL assert::class_2

  locals| tableNm indexNm lower |

  idxSelectTimer timer.start

  ddlLock::grabRead

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<tableNm>" is a table folder within ../tables
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<tableNm>
  tableNm pushTable assert

  // check "<tablenm"> is a table in ../tables/<tableNm>
  tableNm checkIsTable not if <NIP+ERROR> exit then

  // push indexes folder
  pushIndexes assert

  // check indexNm is an index
  indexNm checkIsIndex
  not if
  popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // pop indexes folder
  popIndexes

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // execute a lower bound select using index
  lower indexNm lowerSelectIndex ( lower index )

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // pop named table folder off path
  // i.e. task.dicStack will now be back to ../tables
  popTable
  withinTables assert

  idxSelectTimer timer.update
  "select time " .put
  idxSelectTimer timer.millisecs .put "ms" .put .\n

  <OK>
;

/*----------------------------------------------------------------------------*/
/* range select of table given an index                                       */
/*----------------------------------------------------------------------------*/
: range_select_index ( "<upper>" "<lower>" "<indexNm>" "<tableNm>" -- <R> )

tp: range_select_index

  assert::stack_4
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_STRVAL assert::class_2
  CN_STRVAL assert::class_3

  locals| tableNm indexNm lower upper |

  idxSelectTimer timer.start

  ddlLock::grabRead

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<tableNm>" is a table folder within ../tables
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<tableNm>
  tableNm pushTable assert

  // check "<tablenm"> is a table in ../tables/<tableNm>
  tableNm checkIsTable not if <NIP+ERROR> exit then

  // push indexes folder
  pushIndexes assert

  // check indexNm is an index
  indexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // pop indexes folder
  popIndexes

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // execute a range select on idx
  upper lower indexNm rangeSelectIndex ( upper lower index )

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // pop named table folder off path
  // i.e. task.dicStack will now be back to ../tables
  popTable
  withinTables assert

  idxSelectTimer timer.update
  "select time " .put
  idxSelectTimer timer.millisecs .put "ms" .put .\n

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of index                                                          */
/*----------------------------------------------------------------------------*/
: size_index ( "<indexNm>" "<tableNm>" -- <R> )

  locals| tableNm indexNm |

ddlLock::grabWrite

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  // check there is an index of the name
  indexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  indexNm sizeIndex ( "<size>" )

  // pop table folder
  popIndexes

  // pop table folder
  popTable

  // assert we are still in tables folder
  assertInTables

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate index                                                             */
/*----------------------------------------------------------------------------*/
: truncate_index ( "<indexNm>" "<tableNm" -- <R> )

  locals| tableNm indexNm |

  ddlLock::grabRead

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  tableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  tableNm pushTable assert

  // push indexes folder
  pushIndexes assert

  // check there is an index of the name
  indexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // find the index
  indexNm find execute

  // truncate the index
  index.truncate

  // pop indexes folder
  popIndexes

  // pop table folder
  popTable

  // assert we are still in tables folder
  assertInTables

  <OK>
;

