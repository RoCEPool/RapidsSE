/*============================================================================*/
/* requests_table.sen -- the set of table related requests                    */
/*============================================================================*/

"requests.sen" .verbose


/*----------------------------------------------------------------------------*/
/* make an index (run by participant)                                         */
/*----------------------------------------------------------------------------*/
: makeIndex allParticipants 3 checkResult ( "<indexNm>" "<tableNm>" "<columnNm>"-- true n# true )

tp: makingIndex

  locals| columnNm tableNm indexNm |

  args.tracepoint if
  indexNm tableNm columnNm "MAKING INDEX %V on table %V using column %V" str.format .
  then

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* create an index on a table                                                 */
/*----------------------------------------------------------------------------*/
: create_index ( "<indexNm>" "<tableNm>" "<columnNm>"-- <R> )

tp: create_index
  ddlLock.grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  1 pick getTableRef not if <NIP+ERROR> exit then

  makeIndex ( ) assert.stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of indices                                                        */
/*----------------------------------------------------------------------------*/
: list_indices ( "<tableNm>" -- <R> )

ddlLock.grabRead

  checkInTables not if <NIP+ERROR> exit then

  //listIndices

  <SUCCESS>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
