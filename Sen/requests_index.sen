/*============================================================================*/
/* requests_index.sen -- the set of index related requests                    */
/*============================================================================*/

"requests_index.sen" .verbose

timer: pIdxSelectTimer

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyzeIdx ( "<sIndexNm>" "<sTableNm>" bDetailed -- <R> )
                                                                    // ../tables
  tp: analyzeIdx

  locals| bDetailed sTableNm sIndexNm |

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> assertInTables exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
     popIndexes popTable                                            // ../tables
     assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // analyse the index
  bDetailed not if
    args.metadata if
      "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, entries INTEGER)"
        metadata!
    then
  then

  bDetailed sIndexNm analyzeIndex ( )

  // set no of rows processed equal to total no of partitions
  grid.partitions task::this task.seitf@ seitf.rowsProcessed

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path 

  popIndexes popTable assertInTables                                // ../tables

  tp: analyzedIndex

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyzeIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
   0 analyzeIdx
;

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: danalyzeIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
  1 analyzeIdx
;

/*----------------------------------------------------------------------------*/
/* create an index on a table                                                 */
/*----------------------------------------------------------------------------*/
: createIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  tp: createIndex_req

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  checkEnoughBuffers not if <NIP+ERROR> exit then

  sIndexNm sTableNm checkMakeIndex  not if <NIP+ERROR> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create index

  //sTableNm pushTable assert                                // ../tables/sTableNm
  //sTableNm getTable_req
  //popTable                                                          // ../tables

  sTableNm sIndexNm makeIndex assertInTables

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop an index                                                              */
/*----------------------------------------------------------------------------*/
: dropIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  tp: dropIndex

  locals| sTableNm sIndexNm |

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  sIndexNm sTableNm checkRemoveIndex not if <NIP+ERROR> exit then

  tp ( "<sIndexNm>" )

  // push table dictionary
  sTableNm pushTable assert ( "<sIndexNm>" )               // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert ( "<sIndexNm>" )              // ../tables/sTableNm/indexes

  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  sIndexNm "hidden" str.equal if
    popIndexes popTable assertInTables EC_NO_SUCH_INDEX <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove index from table
  sIndexNm find execute dup index.table@ table.removeIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index
  sIndexNm removeIndex ( ) assert::stack_0


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: droppedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump index                                                                 */
/*----------------------------------------------------------------------------*/
: dumpIndex_req ( "<sIndexNm>" "<sTableNm" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump index

  sIndexNm find execute
  index.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: dumpedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create index sequence                                               */
/*----------------------------------------------------------------------------*/
: endCreateIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                    // ../tables/tableNm/indexes
  locals| sTableNm sIndexNm |

  tp: endCreateIndex_req

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks
  checkInIndexes not if <NIP+ERROR> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create column vector and populate index

  // create the column vector of the index
  sIndexNm columnVecIndex

  // now populate the index
  sIndexNm populateIndex
                                                    // ../tables/tableNm/indexes
  // pop indexes folder temporarily
  popIndexes                                                // ../tables/tableNm

  // return the table reference
  returnTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ not assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  // push back the indexes folder
  pushIndexes assert                                // ../tables/tableNm/indexes

  assertInIndexes

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* generate plan for the fetch                                                */
/*----------------------------------------------------------------------------*/
: generatePlan ( "<sWhere>" ^pTable -- ^pPlanner )

  0 0 locals| pPlanner pAccessPath pTable sWhere |

  sWhere "generatePlan" "%v %v" str.format .

  ( cdt_0 ) planner::new to pPlanner
  ( cdt_1 ) pTable pPlanner Planner.table!

  ( cdt_2 ) pPlanner Planner.genPaths           //"genPaths" .
  ( cdt_3 ) pPlanner Planner.scorePaths         //"scorePaths" .
  ( cdt_4 ) pPlanner Planner.showPaths

  ( cdt_5 ) sWhere pPlanner Planner.parseWhere  //"parseWheres" .
  //( cdt_4 ) pPlanner Planner.showPaths

  ( cdt_7 ) pPlanner Planner.matchPaths         //"matchPaths" .
  //( cdt_8 ) pPlanner Planner.showPaths

  ( cdt_9 ) pPlanner Planner.choosePaths        //"choosePaths" .

  // return planner
  pPlanner
;

/*----------------------------------------------------------------------------*/
/* fetch rows using an index (this is request)                                */
/*----------------------------------------------------------------------------*/
: spawnFetch ( bSinglePartition bGroupBy ^pPlanner -- <R> )

  locals| pPlanner bGroupBy bSinglePartition |

  pPlanner Planner.indexNm@ .

  0 locals| i_Phrase |

  i_Phrase pPlanner Planner.fetchTechnique@

  // execute a lower bound select using index
  case
    AT_EXACT of
    "case equal" .
    pPlanner Planner.key@
    "0"  //lower
    "0"  //upper
    "exactSelectIdxTask"
    pPlanner Planner.indexNm@
    bSinglePartition spawnSelectTask
  endof

  AT_LOWER of
    "case lower" .
    "0" //key
    pPlanner Planner.lowKey@
    "0" //upper
    "lowerSelectIdxTask"
    pPlanner Planner.indexNm@
    bSinglePartition spawnSelectTask
  endof

  AT_UPPER of
    "case upper" .
    "0" //key
    "0" //lower
    pPlanner Planner.highKey@
    "upperSelectIdxTask"
    pPlanner Planner.indexNm@
     bSinglePartition spawnSelectTask
  endof

  AT_RANGE of

    "0" //key
    pPlanner Planner.lowKey@
    pPlanner Planner.highKey@
    bGroupBy if
      "case groupBy" .
      "groupByIdxTask_RH"
      "hidden"
      spawnGroupByTask
    else
      "case range" .
      "rangeSelectIdxTask"
      pPlanner Planner.indexNm@
      bSinglePartition spawnSelectTask
    then
  endof

  AT_SCAN of
    "case scan" .
    "0" //key
    "0" //lower
    "0" //upper
    "scanSelectIdxTask"
    "hidden"
     bSinglePartition spawnSelectTask
    endof
  endcase

  // delete the planner
  pPlanner planner.delete
;

/*----------------------------------------------------------------------------*/
/* spawn fetch rows task (this is request)                                    */
/*----------------------------------------------------------------------------*/
: spawnFetchRows_apiReq ( "groupBy" "<sWhere>" "<sTableNm>" -- <R> )
  // ../tables
  //"fetchRowsIndex_req" .

  // task is a request server
  task::this task.kind@ TK_REQUEST_SERVER == assert

  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_INTVAL assert::class_2

  0 0 0 locals| bSinglePartition pPlanner pTable sTableNm sWhere bGroupBy |

  pIdxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  sTableNm find execute to pTable

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // generate plan for the fetch
  sWhere pTable generatePlan to pPlanner

  // assert we have a plan
  pPlanner assert
  true to bSinglePartition

  // spawn select task for the fetch
  bSinglePartition bGroupBy pPlanner spawnFetch

  <OK>
;

/*----------------------------------------------------------------------------*/
/* fetch rows using an index (this is request)                                */
/*----------------------------------------------------------------------------*/
: fetchRowsIndex_req ( "groupBy" "<sWhere>" "<sTableNm>" -- <R> )
                                                                    // ../tables
//"fetchRowsIndex_req" .

  // task is a request server
  task::this task.kind@ TK_REQUEST_SERVER == assert

  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_INTVAL assert::class_2

  0 0 0 locals| pSeitf pPlanner pTable sTableNm sWhere bGroupBy |

  pIdxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ to pSeitf
  pSeitf seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  sTableNm find execute to pTable

  // set the metadata string
  args.metadata if
    pTable table.getColumns "(partition INTEGER,%v)" str.format metadata!
  then

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // generate plan for the fetch
  sWhere pTable generatePlan to pPlanner

  // assert we have a plan
  pPlanner assert

  // spawn select task for the fetch
  bGroupBy pPlanner spawnFetch

  // fetch rows from the buffers in the buffer queue
  bGroupBy if
    groupByQueueBufferRows
  else
    fetchQueueBufferRows
  then

  // clear index in seitf
  nullptr pSeitf seitf.index!

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path
  popTable assertInTables                                           // ../tables

  args.metadata not if
    pIdxSelectTimer timer.update
    "select time " .put
    pIdxSelectTimer timer.millisecs .put "ms" .put .\n
  then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get an index                                                               */
/*----------------------------------------------------------------------------*/
: getIndex_req ( "<indexNm>" -- <R> )

  getIndex not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of indexes                                                        */
/*----------------------------------------------------------------------------*/
: listIndexes_req ( "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list indexes
  listIndexesContents

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* return an index                                                            */
/*----------------------------------------------------------------------------*/
: returnIndex_req ( "<indexNm>" -- <R> )

  returnIndex not if <NIP+ERROR> exit then

  <OK>
;
/*----------------------------------------------------------------------------*/
/* set unique property of an index                                            */
/*----------------------------------------------------------------------------*/
: indexSetUnique_req ( true/false "<sIndexNm>" "<sTableNm>" -- <R> )
                                                   // ../tables/sTableNm/indexes
  assert::stack_3

  locals| sTableNm sIndexNm bIsUnique |

  tp: indexSetUnique_req

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks
  checkInIndexes not if <NIP+ERROR> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // uniqueness
  bIsUnique sIndexNm setIndexIsUnique ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of index                                                          */
/*----------------------------------------------------------------------------*/
: sizeIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check there is an index of the name
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get index size
  sIndexNm sizeIndex ( "<size>" )

  args.metadata if
    "(size VARCHAR)" metadata!
    "row: ('" swap str.cat
    "')\n" str.cat
    1 task::this task.seitf@ seitf.rowsProcessed
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate index                                                             */
/*----------------------------------------------------------------------------*/
: truncateIndex_req ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check there is an index of the name
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // truncate index

  // find the index
  sIndexNm find execute

  // truncate the index
  index.truncate

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* visualize index                                                            */
/*----------------------------------------------------------------------------*/
: visualizeIndex_req ( "<sIndexNm>" "<sTableNm" -- <R> )
  // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
  popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize index

  sIndexNm find execute
  index.visualize

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: dumpedIndex

  <OK>
;

