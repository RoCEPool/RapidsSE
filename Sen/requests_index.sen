/*============================================================================*/
/* requests_index.sen -- the set of index related requests                    */
/*============================================================================*/

"requests_index.sen" .verbose

timer: idxSelectTimer

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyzeIdx ( "<sIndexNm>" "<sTableNm>" bDetailed -- <R> )
                                                                    // ../tables
  tp: analyzeIdx

  locals| bDetailed sTableNm sIndexNm |

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables       not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> assertInTables exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
     popIndexes popTable                                            // ../tables
     assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // analyse the index
  bDetailed not if
    args.metadata if
      "(nodeName VARCHAR, partition INTEGER, bufferNo INTEGER, bufferLevel INTEGER, entries INTEGER)"
        metadata!
    then
  then

  bDetailed sIndexNm analyzeIndex ( )

  // set no of rows processed equal to total no of partitions
  grid.partitions task::this task.seitf@ seitf.rowsProcessed

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path 

  popIndexes popTable assertInTables                                // ../tables

  tp: analyzedIndex

  not if <NIP+ERROR> else <SUCCESS> then
;

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: analyze_index ( "<sIndexNm>" "<sTableNm>" -- <R> )
   0 analyzeIdx
;

/*----------------------------------------------------------------------------*/
/* analyse an index of a table                                                */
/*----------------------------------------------------------------------------*/
: danalyze_index ( "<sIndexNm>" "<sTableNm>" -- <R> )
  1 analyzeIdx
;

/*----------------------------------------------------------------------------*/
/* create an index on a table                                                 */
/*----------------------------------------------------------------------------*/
: create_index ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  tp: create_index

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  checkEnoughBuffers not if <NIP+ERROR> exit then
  sIndexNm sTableNm checkMakeIndex  not if <NIP+ERROR> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create index

  //sTableNm pushTable assert                                // ../tables/sTableNm
  //sTableNm get_table
  //popTable                                                          // ../tables

  sTableNm sIndexNm makeIndex assertInTables

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* drop an index                                                              */
/*----------------------------------------------------------------------------*/
: drop_index ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  tp: dropIndex

  locals| sTableNm sIndexNm |

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  sIndexNm sTableNm checkRemoveIndex not if <NIP+ERROR> exit then

  tp ( "<sIndexNm>" )

  // push table dictionary
  sTableNm pushTable assert ( "<sIndexNm>" )               // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert ( "<sIndexNm>" )              // ../tables/sTableNm/indexes

  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index

  sIndexNm removeIndex ( ) assert::stack_0

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: droppedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* dump index                                                                 */
/*----------------------------------------------------------------------------*/
: dump_index ( "<sIndexNm>" "<sTableNm" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump index

  sIndexNm find execute
  index.dump

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: dumpedIndex

  <OK>
;

/*----------------------------------------------------------------------------*/
/* end of create index sequence                                               */
/*----------------------------------------------------------------------------*/
: end_create_index ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                    // ../tables/tableNm/indexes
  locals| sTableNm sIndexNm |

  tp: end_create_index

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks
  checkInIndexes not if <NIP+ERROR> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create column vector and populate index

  // create the column vector of the index
  sIndexNm columnVecIndex

  // now populate the index
  sIndexNm find execute ( ^index )
  index.populate                                    // ../tables/tableNm/indexes

  // pop indexes folder temporarily
  popIndexes                                                // ../tables/tableNm

  // return the table reference
  returnTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ not assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  // push back the indexes folder
  pushIndexes assert                                // ../tables/tableNm/indexes

  assertInIndexes

  assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* fetch rows using an index                                                  */
/*----------------------------------------------------------------------------*/
: fetch_rows_index ( "<sWhere>" "<sTableNm>" -- <R> )
                                                                    // ../tables
"fetch_rows_index" .
stk

  assert::stack_2
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1

  0 0 0 locals| pPlanner pAccessPath pTable sTableNm sWhere |

  idxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  sTableNm find execute to pTable

/*
  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check sIndexNm is an index
  sIndexNm checkIsIndex
  not if
  popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // pop indexes folder
  popIndexes                                               // ../tables/sTableNm
*/

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // lower bound select

  // set the metadata string
  args.metadata if
  "(partition INTEGER, data VARCHAR)" metadata!
  then

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // create access path and put into seitf
  accessPath::new to pAccessPath

  pAccessPath task::this task.seitf@ seitf.accessPath!

  pTable pAccessPath accesspath.table!

  ( cdt_0 ) planner::new to pPlanner
  ( cdt_1 ) pTable pPlanner Planner.table!

  ( cdt_2 ) pPlanner Planner.genPaths
  ( cdt_3 ) pPlanner Planner.scorePaths
  ( cdt_4 ) pPlanner Planner.showPaths

  ( cdt_5 ) sWhere pPlanner Planner.parseWhere
  ( cdt_6 ) pPlanner Planner.showPredicates
  ( cdt_7 ) pPlanner Planner.matchPaths
  ( cdt_8 ) pPlanner Planner.showPaths
  ( cdt_9 ) pPlanner Planner.choosePath

  sWhere pAccessPath accessPath.parse

  // execute a lower bound select using index
  case
    FT_EQUAL of
      "case equal" . ( xKey pIndex ) equalSelectIndex
    endof

    FT_LOWER of
      "case lower" . ( xKey pIndex ) lowerSelectIndex
    endof

    FT_UPPER of
      "case upper" . ( xKey pIndex ) upperSelectIndex
    endof

    FT_RANGE of
      "case range" . ( xHighKey xLowKey pIndex ) rangeSelectIndex
    endof

    FT_SCAN of
      "case scan" .
    endof
  endcase

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert



  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popTable assertInTables                                           // ../tables

  args.metadata not if
  idxSelectTimer timer.update
  "select time " .put
  idxSelectTimer timer.millisecs .put "ms" .put .\n
  then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get an index                                                               */
/*----------------------------------------------------------------------------*/
: get_index ( "<indexNm>" -- <R> )

  getIndex not if <NIP+ERROR> exit then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get list of indexes                                                        */
/*----------------------------------------------------------------------------*/
: list_indexes ( "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list indexes
  listIndexesContents

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* exact key select of table given an index                                   */
/*----------------------------------------------------------------------------*/
: key_select_index ( "<xKey>" "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_STRVAL assert::class_2

  locals| sTableNm sIndexNm xKey |

  idxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check sIndexNm is an index
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // pop indexes folder
  popIndexes                                               // ../tables/sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // exact key select

  // set the metadata string
  args.metadata if
    "(partition INTEGER, data VARCHAR)" metadata!
  then

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // execute a exact key select using index
  xKey sIndexNm equalSelectIndex ( lower index )

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  // pop named table folder off path
  // i.e. task.dicStack will now be back to ../tables
  popTable assertInTables                                           // ../tables

  args.metadata not if
    idxSelectTimer timer.update
    "select time " .put
    idxSelectTimer timer.millisecs .put "ms" .put .\n
  then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* lower bound select of table given an index                                 */
/*----------------------------------------------------------------------------*/
: lower_select_index ( "<sLower>" "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
"lower_select_index" .

  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_STRVAL assert::class_2

  locals| sTableNm sIndexNm sLower |

  idxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check sIndexNm is an index
  sIndexNm checkIsIndex
    not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // pop indexes folder
  popIndexes                                               // ../tables/sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // lower bound select

  // set the metadata string
  args.metadata if
   "(partition INTEGER, data VARCHAR)" metadata!
  then

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // execute a lower bound select using index
  sLower sIndexNm lowerSelectIndex ( lower index )

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popTable assertInTables                                           // ../tables

  args.metadata not if
    idxSelectTimer timer.update
    "select time " .put
    idxSelectTimer timer.millisecs .put "ms" .put .\n
  then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* range select of table given an index                                       */
/*----------------------------------------------------------------------------*/
: range_select_index ( "<sUpper>" "<sLower>" "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  tp: range_select_index

  assert::stack_4
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_STRVAL assert::class_2
  CN_STRVAL assert::class_3

  locals| sTableNm sIndexNm sLower sUpper |

  idxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check sIndexNm is an index
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // pop indexes folder
  popIndexes                                               // ../tables/sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // range select

  // set the metadata string
  args.metadata if
    "(partition INTEGER, data VARCHAR)" metadata!
  then

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert

  // execute a range select on idx
  sUpper sLower sIndexNm rangeSelectIndex ( upper lower index )

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popTable assertInTables                                           // ../tables

  args.metadata not if
    idxSelectTimer timer.update
    "select time " .put
    idxSelectTimer timer.millisecs .put "ms" .put .\n
  then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* return an index                                                            */
/*----------------------------------------------------------------------------*/
: return_index ( "<indexNm>" -- <R> )

  returnIndex not if <NIP+ERROR> exit then

  <OK>
;
/*----------------------------------------------------------------------------*/
/* set unique property of an index                                            */
/*----------------------------------------------------------------------------*/
: index_setUnique ( true/false "<sIndexNm>" "<sTableNm>" -- <R> )
                                                   // ../tables/sTableNm/indexes
  assert::stack_3

  locals| sTableNm sIndexNm bIsUnique |

  tp: index_setUnique

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks
  checkInIndexes not if <NIP+ERROR> exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // uniqueness
  bIsUnique sIndexNm setIndexIsUnique ( ) assert::stack_0

  <OK>
;

/*----------------------------------------------------------------------------*/
/* get size of index                                                          */
/*----------------------------------------------------------------------------*/
: size_index ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check there is an index of the name
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get index size
  sIndexNm sizeIndex ( "<size>" )

  args.metadata if
    "(size VARCHAR)" metadata!
    "row: ('" swap str.cat
    "')\n" str.cat
    1 task::this task.seitf@ seitf.rowsProcessed
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <SUCCESS>
;

/*----------------------------------------------------------------------------*/
/* truncate index                                                             */
/*----------------------------------------------------------------------------*/
: truncate_index ( "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table folder
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check there is an index of the name
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // truncate index

  // find the index
  sIndexNm find execute

  // truncate the index
  index.truncate

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  <OK>
;

/*----------------------------------------------------------------------------*/
/* upper bound select of table given an index                                 */
/*----------------------------------------------------------------------------*/
: upper_select_index ( "<sUpper>" "<sIndexNm>" "<sTableNm>" -- <R> )
                                                                    // ../tables
  assert::stack_3
  CN_STRVAL assert::class_0
  CN_STRVAL assert::class_1
  CN_STRVAL assert::class_2

  locals| sTableNm sIndexNm sUpper |

  idxSelectTimer timer.start

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  //
  // task will have an seitf and a dicStack path, but seitf has no table
  //

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // path should end in a tables folder
  // i.e. task.dicStack should be ../tables
  checkInTables not if <NIP+ERROR> exit then

  // check "<sTableNm>" is a table folder within ../tables
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push named table folder onto path
  // i.e. task.dicStack will be ../tables/<sTableNm>
  sTableNm pushTable assert                                // ../tables/sTableNm

  // check "<sTableNm"> is a table in ../tables/<sTableNm>
  sTableNm checkIsTable not if <NIP+ERROR> exit then

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  // check sIndexNm is an index
  sIndexNm checkIsIndex
  not if
    popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // pop indexes folder
  popIndexes                                               // ../tables/sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // upper select

  // set the metadata string
  args.metadata if
    "(partition INTEGER, data VARCHAR)" metadata!
  then

  // get and inc table reference and put into task.seitf.currentTable
  getTableRef not if <NIP+ERROR> exit then
  task::this task.seitf@ seitf.table@ assert


  // temp: run generate candidiate paths (ray)
  //task::this task.seitf@ seitf.table@ table.genCandidatePaths


  // execute a lower bound select using index
  sUpper sIndexNm upperSelectIndex ( upper index )

  // dec and return table reference and clear task.seitf.currentTable
  returnTableRef not if <NIP+ERROR> exit then

  // assert no seitf.table
  task::this task.seitf@ seitf.table@ not assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popTable assertInTables                                           // ../tables

  args.metadata not if
    idxSelectTimer timer.update
    "select time " .put
    idxSelectTimer timer.millisecs .put "ms" .put .\n
  then

  <OK>
;

/*----------------------------------------------------------------------------*/
/* visualize index                                                            */
/*----------------------------------------------------------------------------*/
: visualize_index ( "<sIndexNm>" "<sTableNm" -- <R> )
  // ../tables
  locals| sTableNm sIndexNm |

  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // checks

  // should be in the tables folder
  checkInTables not if <NIP+ERROR> exit then

  // there should be a table folder
  sTableNm checkIsTableFolder not if <NIP+ERROR> exit then

  // push table dictionary
  sTableNm pushTable assert                                // ../tables/sTableNm

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
  popIndexes popTable assertInTables <NIP+ERROR> exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize index

  sIndexNm find execute
  index.visualize

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // restore path

  popIndexes popTable assertInTables                                // ../tables

  tp: dumpedIndex

  <OK>
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
