/*============================================================================*/
/* job_Space.sen -- Job Space                                                 */
/*============================================================================*/

" job_Space.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request to get space in the pool (on originating node)                     */
/*----------------------------------------------------------------------------*/
: space_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: space_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(nodeName VARCHAR, poolSize VARCHAR, inUse VARCHAR, free VARCHAR)"
    pJob job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* get space in the pool (executed on all nodes)                              */
/*----------------------------------------------------------------------------*/
: space_exe ( pJob_Space -- )

  >>am <SEED_EXE>

  //params| pJob_Space |
  job::this locals| pJob_Space |

  CN_JOB_SPACE pJob_Space object.assertClass

  "GETTING SPACE on NODE " grid::thisNode@ >str str.cat .verbose
//
  "row: ('"
  grid::thisNodeName@ str.cat
  "', '" str.cat
  2 bp::totalSpace number.magnitude str.cat
  "', '" str.cat
  2 bp::inUseSpace number.magnitude str.cat
  "', '" str.cat
  2 bp::freeSpace number.magnitude str.cat
  "')" str.cat

  grid::thisNode@ pJob_Space job.response!
  1 grid::thisNode@ pJob_Space job.rowsProcessed!

  pJob_Space job.notice

  pJob_Space job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: space_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_space |

  pJob_space job.becomeParticipant

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: space_end ( -- )

  >>am <SEED_END>

  ">> space_end <<" .verbose

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: space_can ( -- )

  >>am <SEED_CAN>

  ">> space_can <<" .verbose

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

