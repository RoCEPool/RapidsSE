/*============================================================================*/
/* job_Space.sen -- Job Space                                                 */
/*============================================================================*/

"job_Space.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request to get space in the pool (executed on originating node)            */
/*----------------------------------------------------------------------------*/
: poolSpaceR35_req ( -- <R> )

  0 0 locals| pJob pTask |

  tp: poolSpaceR35_req

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  pTask pJob "job::distribute" find execute

  // ack the waiting prompt task
  "Acking parent" .
  pJob job.promptTask@ ack
  "Acked parent" .

  <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute Job_Space job                                                      */
/*----------------------------------------------------------------------------*/
: poolSpaceR35_node ( pJob_Space -- str t/f )

  params| pJob_Space |

  CN_JOB_SPACE pJob_Space object.assertClass

  "GETTING SPACE on NODE " grid::thisNode@ >str str.cat .

  args.metadata if
    "row: ('"
    grid::thisNodeName@ str.cat
    "', '" str.cat
    2 bp::totalSpace number.magnitude str.cat
    "', '" str.cat
    2 bp::inUseSpace number.magnitude str.cat
    "', '" str.cat
    2 bp::freeSpace number.magnitude str.cat
    "')" str.cat
  else
    "Pool - Size(" 2 bp::totalSpace number.magnitude str.cat ")" str.cat
    " InUse(" 2 bp::inUseSpace number.magnitude str.cat ")" str.cat
    " Free(" 2 bp::freeSpace number.magnitude str.cat ")" str.cat
    str.cat str.cat
  then

  grid::thisNode@ pJob_Space job.response!

  pJob_Space job.notice
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

