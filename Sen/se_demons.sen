/*============================================================================*/
/* se_demon.sen -- demons                                                     */
/*============================================================================*/

" se_demon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* install demon pipeline job                                                 */
/*----------------------------------------------------------------------------*/
: demon::install

  //ddlLock[].dropRead  : check with RAY

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__" <pipelineNm> str.cat locals| sDemonNm |

  sDemonNm "installing demon pipeline job: %v" .printf

  sDemonNm >createInRoot locals| pDemonWd |

  job[] pDemonWd word.object!
  job[] job.addDemon
;

//tag "<pre_execute>" = "demon::install" endTag
/*----------------------------------------------------------------------------*/
/* answer demon                                                               */
/*----------------------------------------------------------------------------*/
: answerDemonStr

  "
    pipelineLocal answerDemon

    begin

      stage stageA on origin :
        start | answerOP | eatAll | stageA

    end ;
  "
;

/*----------------------------------------------------------------------------*/
/* connector demon                                                            */
/*----------------------------------------------------------------------------*/
: connectorDemonStr

  "
    pipelineLocal connectorDemon

    begin

      stage stageA on origin :
        start | connectorOP __nodeInfo | eatAll | stageA

    end ;
  "
;

