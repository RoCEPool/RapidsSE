/*============================================================================*/
/* job_DropSchema.sen -- Job Drop Schama                                      */
/*============================================================================*/

" job_DropSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable schema folder                                 */
/*----------------------------------------------------------------------------*/
: checkRemoveSchema ( "<schemaNm>" --  true | errorCode false )

 params| sSchemaNm |

  checkInSchemas not if false exit then
  sSchemaNm checkIsWord not if EC_NO_SUCH_SCHEMA false exit then
  checkIsSchema  not if false exit then
  checkIsEmpty   not if false exit then
  checkNotUsed   not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* remove a schema folder                                                     */
/*----------------------------------------------------------------------------*/
: removeSchema ( "<schemaNm>" --  )

  tp: removeSchema

  args.tracepoint if
  dup "REMOVING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  :forget ( )
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropSchema job on a node                                       */
/*----------------------------------------------------------------------------*/
: dropSchema::execute _eeh ( -- )

  tp: dropSchema_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  <schemaNm> removeSchema
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropSchema job check resources                                 */
/*----------------------------------------------------------------------------*/
: dropSchema::checkResources _eeh ( -- )

  tp: dropSchema.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - --
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the schema
  //pJob_DropSchema job.schemaName@
  <schemaNm> checkRemoveSchema not if job::this <ERROR_JOB> !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: dropSchema :: drop schema <schemaNm> ;

jobInfo: dropSchema
{
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_WRITE
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
