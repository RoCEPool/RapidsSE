"job_DropSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute Job_DropSchema job                                                 */
/*----------------------------------------------------------------------------*/
: Job_DropSchema.execute ( pJob_DropSchema -- )

  params| pJob_DropSchema |

  CN_JOB_DROPSCHEMA pJob_DropSchema object.assertClass

  ddlLock::grabWrite

  pJob_DropSchema getPathR35
  dicStack.set
  pJob_DropSchema job.objectName@   ( schemaNm )

  removeSchemaR35 ( )  not if "got error" . exit then

  ddlLock::testDrop

  pJob_DropSchema job.notice
;

