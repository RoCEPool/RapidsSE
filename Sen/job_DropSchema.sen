/*============================================================================*/
/* job_DropSchema.sen -- Job Drop Schama                                      */
/*============================================================================*/

" job_DropSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable schema folder                                 */
/*----------------------------------------------------------------------------*/
: checkRemoveSchema ( "<schemaNm>" --  true | errorCode false )

 params| sSchemaNm |

  checkInSchemas not if false exit then
  sSchemaNm checkIsWord not if EC_NO_SUCH_SCHEMA false exit then
  checkIsSchema  not if false exit then
  checkIsEmpty   not if false exit then
  checkNotUsed   not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* remove a schema folder                                                     */
/*----------------------------------------------------------------------------*/
: removeSchema ( "<schemaNm>" --  )

  tp: removeSchema

  args.tracepoint if
  dup "REMOVING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  :forget ( )
;

/*----------------------------------------------------------------------------*/
/* drop schema request (on originating node)                                  */
/*----------------------------------------------------------------------------*/
: dropSchema_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: dropSchema_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropSchema job on a node                                       */
/*----------------------------------------------------------------------------*/
: dropSchema_exe ( pJob_DropSchema -- )

  >>am <SEED_EXE>

  //params| pJob_DropSchema |
  job::this locals| pJob_DropSchema |

  tp: dropSchema_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_DROPSCHEMA pJob_DropSchema object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_DropSchema job.pushPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  pJob_DropSchema job.objectName@   ( catalogNm )
  removeSchema

  pJob_DropSchema job.notice

  pJob_DropSchema send_job__executed

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropSchema job check resources                                 */
/*----------------------------------------------------------------------------*/
: dropSchema.checkResources ( Job_DropSchema -- )

  >>am <Check_Resources>

  params| pJob_DropSchema  |

  tp: dropSchema.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - --
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_DropSchema job.pushPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the catalog
  pJob_DropSchema job.objectName@
  checkRemoveSchema not if pJob_DropSchema <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropSchema job release resources                               */
/*----------------------------------------------------------------------------*/
: dropSchema.releaseResources ( Job_DropSchema -- )

  >>am <Release_Resources>

  params| pJob_DropSchema  |

  tp: dropSchema.releaseResources
  //releaseResources received" .

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: dropSchema_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_dropSchema |

  pJob_dropSchema job.beginParticipant

  // check resources
  pJob_dropSchema dropSchema.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: dropSchema_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_dropSchema |

  pJob_dropSchema dropSchema.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: dropSchema_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_dropSchema |

  pJob_dropSchema dropSchema.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
