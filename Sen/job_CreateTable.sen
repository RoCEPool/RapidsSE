/*============================================================================*/
/* job_CreateTable.sen -- Job Create Table                                    */
/*============================================================================*/

" job_CreateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check word is not a table                                                  */
/*----------------------------------------------------------------------------*/
: checkIsNotTable ( "<wordNm" -- t|f )
  findInCurrent not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable table                                          */
/*----------------------------------------------------------------------------*/
: checkMakeTable ( "<tableNm>" -- true | errorCode false )

  checkInTables   not if false exit then
  checkIsNotTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* make a table (run by all participants)                                     */
/*----------------------------------------------------------------------------*/
: makeTable ( "<tableNm>" )

  tp: makingTable

  params| sTableNm |
  0 0 locals| pTable pIndex |

  args.tracepoint if
  sTableNm "MAKING TABLE " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  //----------------------------------------------------------------------------
  // make the table dictionary
  sTableNm makeTableDic

  //----------------------------------------------------------------------------
  // make the indexes dictionary
  sTableNm pushTable assert
  sTableNm "makeIndexes" find execute

  //----------------------------------------------------------------------------
  // create the table
  sTableNm :table ( ^table ) drop
  sTableNm find execute to pTable

  //----------------------------------------------------------------------------
  // create the hidden index for the row data
  sTableNm "hidden" "make_indexR35" find execute

  //----------------------------------------------------------------------------
  // make the index as hidden
  "indexes" find execute pathPush
  "hidden" findInCurrent execute to pIndex
  true pIndex index.isHidden!

  // now add a column to the hidden index
  "integer" "hidden_column" pIndex index.createColumnVec

  // step out of indexes
  pathDrop

  //----------------------------------------------------------------------------
  // store the hidden index in the table
  pIndex sTableNm find execute table.hiddenIndex!
  //pathDump

  // return table pointer
  pTable
;

/*----------------------------------------------------------------------------*/
/* Job_CreateTable request (on originating node)                              */
/*----------------------------------------------------------------------------*/
: createTable_req (  -- <R> )

  <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: createTable

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  // distribute the job
  pJob job.distribute

  <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTable job on each node                                   */
/*----------------------------------------------------------------------------*/
: createTable_exe ( pJob_CreateTable -- )

  <SEED_EXE>

  //params| pJob_CreateTable |
  job::this locals| pJob_CreateTable |

  0 0 locals| pTable sTableNm |

  tp: createTable_exe

  //----------------------------------------------------------------------------
  // assert correct job
  CN_JOB_CREATETABLE pJob_CreateTable object.assertClass

  //----------------------------------------------------------------------------
  // grad a ddl lock
  ddlLock::grabWrite

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_CreateTable getPath
  dicStack.set

  //----------------------------------------------------------------------------
  // make table
  pJob_CreateTable job.objectName@ to sTableNm
  sTableNm makeTable to pTable

  //----------------------------------------------------------------------------
  // get a table reference
  pTable table.getRef

  //----------------------------------------------------------------------------
  // add table columns
  pJob_CreateTable pTable table.createColumnVecR35

  //----------------------------------------------------------------------------
  // add partition columns
  pTable table.slots slots.createColumnVecR35

  //----------------------------------------------------------------------------
  // move back to tables
  popTable

  //----------------------------------------------------------------------------
  // return table reference
  pTable table.retRef

  //----------------------------------------------------------------------------
  // should be in tables
  assertInTables

  pJob_CreateTable job.notice

  // delete_completed_job

  pJob_CreateTable send_job__executed

  nullptr task::this task.job!

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTable job check resources                                */
/*----------------------------------------------------------------------------*/
: createTable.checkResources ( pJob_CreateTable -- )

  params| pJob_CreateTable  |

  tp: createTable.checkResources
  "checkResources received" .

  //----------------------------------------------------------------------------
  // grad a ddl lock
  ddlLock::grabWrite

  //----------------------------------------------------------------------------
  // set dictionary stack
  pJob_CreateTable getPath
  dicStack.set

  //----------------------------------------------------------------------------
  // check if we have enough buffers
  checkEnoughBuffers not if pJob_CreateTable <ERROR_JOB> exit then

  //----------------------------------------------------------------------------
  // check if we can make the table
  pJob_CreateTable job.objectName@
  checkMakeTable not if pJob_CreateTable <ERROR_JOB> exit then

  ddlLock::dropWrite
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTable job release resources                              */
/*----------------------------------------------------------------------------*/
: createTable.releaseResources ( pJob_CreateTable -- )

  params| pJob_CreateTable  |

  tp: createTable.releaseResources
  "releaseResources received" .
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: createTable_beg ( -- )

  <SEED_BEG>

  job::this locals| pJob_CreateTable |

  ">> createTable_beg <<" .

  // add this job to the participants list
  pJob_CreateTable job.beginParticipant

  // check resources
  pJob_CreateTable createTable.checkResources

  // this job has begun
  job::participantBegun

  <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: createTable_end ( -- )

  <SEED_END>

  job::this locals| pJob_CreateTable |

  ">> createTable_end <<" .

  // release resources
  pJob_CreateTable createTable.releaseResources

  job::participantEnded

  <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: createTable_can ( -- )

  <SEED_CAN>

  job::this locals| pJob_CreateTable |

  pJob_CreateTable createTable.releaseResources

  job::participantCancelled

  <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
