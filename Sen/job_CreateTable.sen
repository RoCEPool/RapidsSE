/*============================================================================*/
/* job_CreateTable.sen -- Job Create Table                                    */
/*============================================================================*/

" job_CreateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check word is not a table                                                  */
/*----------------------------------------------------------------------------*/
: checkIsNotTable ( "<wordNm>" -- t|f )

  folder[].findSymbol not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a creatable table                                    */
/*----------------------------------------------------------------------------*/
: createTable::checkCreate ( -- true | errorCode false )

  folder[].checkInTables not if
    false
    exit
  then
  
  <tableNm> checkIsNotTable not if
    false
    exit
  then

  true
;

/*----------------------------------------------------------------------------*/
/* make an table (run by all participants)                                    */
/*----------------------------------------------------------------------------*/
: createTable::createATable

  job[] locals| pJob_CreateTable |

  0 locals| pTable |

  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  <cmd> pJob_CreateTable tableDef::parse locals| pTableDef |
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  //----------------------------------------------------------------------------
  // check for error while creating tabledef
  grid::thisNode@ pJob_CreateTable job.hasError if
    pJob_CreateTable DdlLock[].testDrop !!logError exit then

  //----------------------------------------------------------------------------
  // make table
  <tableNm> makeTable to pTable

  //!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  pTableDef pTable table.tableDef!
  //!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  //----------------------------------------------------------------------------
  // add partition columns
  pTable table.createPtnDef

  //----------------------------------------------------------------------------
  // move back to tables
  path[].discardTableFolder

  //----------------------------------------------------------------------------
  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTable job check resources                                */
/*----------------------------------------------------------------------------*/
: createTable::checkResources _eeh

   // grab the ddl lock
  DdlLock[].grabRead

  // check if we have enough buffers
  node::checkEnoughBuffers not if
    job[] ERROR_JOB !!logError
    exit
  then

  // check if we can make the table
  createTable::checkCreate not if
    job[] ERROR_JOB !!logError
    exit
  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTable job on each node                                   */
/*----------------------------------------------------------------------------*/
: createTable::execute _eeh ( -- )

  // should be in tables
  folder[].isTables assert

  // create the table
  createTable::createATable

  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/* create table request (on originating node)                                 */
/*----------------------------------------------------------------------------*/
: createTable::request _eeh ( -- <R> )

  // check create table syntax
  <cmd> TableDef::syntax dup EC_NONE != if
    job[] ERROR_JOB !!logError
  else
    discard
  then
;

/*----------------------------------------------------------------------------*/
/*                              - Definition -                                */
/*----------------------------------------------------------------------------*/
cmdSyntax: createTable :: create table <tableNm> etc ;
cmdSyntax: createTable :: create table definition <tableNm> etc ;

: createTable _info tags{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
