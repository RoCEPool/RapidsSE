/*============================================================================*/
/* job_CreateTable.sen -- Job Create Table                                    */
/*============================================================================*/

" job_CreateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a creatable table                                    */
/*----------------------------------------------------------------------------*/
: createTable::checkCreate ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then
  
  // error if given name already exists
  <tableNm> check::nameIsUnknownTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* create table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: createTable::createNamedTable

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse cmd and create table definition

  <cmd> job[] tableDef::parse locals| pTableDef |

  // check for error while parsing tabledef
  job[] job.hasError if
    DdlLock[].testDrop
    !!logError
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  pTableDef <tableNm> table::createTable locals| pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* check resources for Job_CreateTable on this participating node             */
/*----------------------------------------------------------------------------*/
: createTable::checkResources _eeh

   // grab the ddl lock
  DdlLock[].grabRead

  // check there are enough buffers
  node::checkEnoughBuffers not if ( errorCode )
    job::error!
    !!logError
    exit
  then

  // check ok to create table
  createTable::checkCreate not if ( errorCode )
    job::error!
    !!logError
    exit
  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTable on this participating node                         */
/*----------------------------------------------------------------------------*/
: createTable::execute _eeh ( -- )

  // should be in tables
  folder[].isTables assert

  // create the table
  createTable::createNamedTable

  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/* request originating node to 2pc execute Job_CreateTable across the grid    */
/*----------------------------------------------------------------------------*/
: createTable::request _eeh ( -- <R> )

  // check create table syntax
  <cmd> TableDef::syntax dup EC_NONE != if  ( errorCode )
    job::error!
    !!logError
  else
    discard
  then
;

/*----------------------------------------------------------------------------*/
/*                              - Definition -                                */
/*----------------------------------------------------------------------------*/
cmdSyntax: createTable :: create table <tableNm> etc ;
cmdSyntax: createTable :: create table definition <tableNm> etc ;

: createTable _cmdTags tagCopy: distJob_tags
  tags{
    <cmdDesc>  = "--cmd desc for job--"
  
    <rspKind>  = RS_PARTICIPANT_RESPONSE
    <ddlLock>  = DL_GRAB_WRITE
  
    <preCheck> = bClusterStarted
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
