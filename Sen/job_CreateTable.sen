/*============================================================================*/
/* job_CreateTable.sen -- Job Create Table                                    */
/*============================================================================*/

" job_CreateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check word is not a known table/symbol                                     */
/*----------------------------------------------------------------------------*/
: checkIsNotTable ( "<wordNm>" -- t|f )

  folder[].findSymbol not if true exit then
  EC_TABLE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a creatable table                                    */
/*----------------------------------------------------------------------------*/
: createTable::checkCreate ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  folder[].checkIsTables not if false exit then
  
  // error if given name already exists
  <tableNm> checkIsNotTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* create table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: createTable::createNamedTable

  job[] locals| pJob_CreateTable |

  0 locals| pTable |

  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  <cmd> pJob_CreateTable tableDef::parse locals| pTableDef |
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  //----------------------------------------------------------------------------
  // check for error while creating tabledef
  grid::thisNode@ pJob_CreateTable job.hasError if
    pJob_CreateTable DdlLock[].testDrop !!logError exit then

  //----------------------------------------------------------------------------
  // make table
  <tableNm> table::makeTable_NEEDS_WORK to pTable

  //!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  pTableDef pTable table.tableDef!
  //!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  //----------------------------------------------------------------------------
  // add partition columns
  pTable table.createPtnDef

  //----------------------------------------------------------------------------
  // move back to tables
  path[].popNamedTableFolder

  //----------------------------------------------------------------------------
  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* check resources for Job_CreateTable on this participating node             */
/*----------------------------------------------------------------------------*/
: createTable::checkResources _eeh

   // grab the ddl lock
  DdlLock[].grabRead

  // check if we have enough buffers
  node::checkEnoughBuffers not if ( errorCode )
    job::error!
    !!logError
    exit
  then

  // check if we can make the table
  createTable::checkCreate not if ( errorCode )
    job::error!
    !!logError
    exit
  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTable on this participating node                         */
/*----------------------------------------------------------------------------*/
: createTable::execute _eeh ( -- )

  // should be in tables
  folder[].isTables assert

  // create the table
  createTable::createNamedTable

  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/* request originating node to 2pc execute Job_CreateTable across the grid    */
/*----------------------------------------------------------------------------*/
: createTable::request _eeh ( -- <R> )

  // check create table syntax
  <cmd> TableDef::syntax dup EC_NONE != if  ( errorCode )
    job::error!
    !!logError
  else
    discard
  then
;

/*----------------------------------------------------------------------------*/
/*                              - Definition -                                */
/*----------------------------------------------------------------------------*/
cmdSyntax: createTable :: create table <tableNm> etc ;
cmdSyntax: createTable :: create table definition <tableNm> etc ;

: createTable _info tags{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
