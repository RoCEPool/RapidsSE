/*============================================================================*/
/* job_MkJob.sen -- Make Job                                                  */
/*============================================================================*/

" job_MkJob.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request                                                                    */
/*----------------------------------------------------------------------------*/
: mkjob_req ( -- )

  >>logEntry <SEED_REQ>

  <newNm> "making new job: %v" fmt.print

  args.senDir "%votherJobs" str.format locals| sSubDir |

  <newNm> sSubDir <newNm> sSubDir
    "cat %v/job_local.txt | sed s/NAME_OF_JOB/%v/g > %v/job_%v.sen" str.format .

  <<logExit <DONE_REQ>

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: mkjob :: mkjob <newNm> ;

jobInfo: mkjob
{
  <?jobDesc?>  = "make job"
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
