/*============================================================================*/
/* job_MkJob.sen -- Make Job                                                  */
/*============================================================================*/

" job_MkJob.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request                                                                    */
/*----------------------------------------------------------------------------*/
: mkjob_req ( -- )

  >>logEntry <SEED_REQ>

  <newNm> "making new job: %v" .printf

      args.senDir      "%votherJobs" str.format locals| sSubDir  | //  sSubDir .

          sSubDir "%v/job_local.txt" str.format locals| sTxtFile | // sTxtFile .

  <newNm> sSubDir    "%v/job_%v.sen" str.format locals| sSenFile | // sSenFile .

  sSenFile <newNm> sTxtFile
    "cat %v | sed s/NAME_OF_JOB/%v/g > %v"
      str.format locals| sSedCmd |

  sSedCmd .

  sSedCmd shell::execute drop

  sSenFile include

  <<logExit <DONE_REQ>

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: mkjob :: mkjob <newNm> ;

jobInfo: mkjob
{
  <?jobDesc?>  = "make job"
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
