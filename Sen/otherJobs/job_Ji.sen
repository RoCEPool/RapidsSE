/*============================================================================*/
/* job_Ji.sen -- Job Info Dump                                                */
/*============================================================================*/

" job_Ji.sen" .verbose

/*----------------------------------------------------------------------------*/
/* job info dump                                                              */
/*----------------------------------------------------------------------------*/
: ji_req ( -- )

  >>logEntry <SEED_REQ>

  <WordNm> "_cls" str.cat find dup if
    word.EnameSet@ EnameSet.asStr .
  else
    drop
    <wordNm> "No such job: %v" .printf
  then

  <<logExit <DONE_REQ>

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: ji :: ji <wordNm> ;

jobInfo: ji
{
  <?jobDesc?>  = "dump job info"
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
