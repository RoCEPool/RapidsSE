/*============================================================================*/
/* job_wd.sen -- Job Word Dump                                                */
/*============================================================================*/

" job_Wd.sen" .verbose

/*----------------------------------------------------------------------------*/
/* word dump                                                                  */
/*----------------------------------------------------------------------------*/
: wd_req ( -- )

  LogEntry SEED_REQ

  <wordNm> find dup if
    word.see
  else
    drop
    <wordNm> "No such word: %v" .printf
  then

  LogExit DONE_REQ

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

opSyntax: wd :: wd <wordNm> ;

jobInfo: wd
{
  <jobDesc>  = "dump word"
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
