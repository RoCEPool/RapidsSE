/*============================================================================*/
/* job_x.sen -- Job x                                     */
/*============================================================================*/

" job_x.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request seed                                                               */
/*----------------------------------------------------------------------------*/
: x_req ( -- )

  >>logEntry <SEED_REQ>

  // put your code here...

  "x was created by mkjob" .

  <<logExit <DONE_REQ>

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: x :: x ;

jobInfo: x
{
  <?jobDesc?>  = "x"
}
;

