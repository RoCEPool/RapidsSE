/*============================================================================*/
/* responseOp.sen -- response operator                                        */
/*============================================================================*/

"responseOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* respond                                                                    */
/*----------------------------------------------------------------------------*/
: respondSEitf ( plan -- )

  // record the plan and profile
  locals| thePlan profile |

  // push the op frame for this writeOp
  profile thePlan plan.opFrame? opFrame.push

  "DONE" .

  // << profile plan >> -->> nextOp
  << $$nextProfile thePlan plan.id@ $$nextOp >>jobqueue

  opFrame.drop
;

/*----------------------------------------------------------------------------*/
/* response                                                                   */
/*----------------------------------------------------------------------------*/
: responseOp operator ( -- NEVER )

  begin

    depth 0 != if "stack of task has grown" . debug.trap then

    // wait for next job
    jobQueue> ( valset )

    // unpack it
    valset> ( profile planId nValues )
    drop ( profile planId )

    // find plan using planId
    planList::findPlan ( profile plan true )
    assert ( profile plan )

    // respond to seitf
    respondSEitf ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
