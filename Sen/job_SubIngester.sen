/*============================================================================*/
/* job_SubIngester.sen -- Job Table SubIngester                               */
/*============================================================================*/

" job_SubIngester.sen" .verbose

/*----------------------------------------------------------------------------*/
/* read records from file, create working buffers, send to node               */
/*----------------------------------------------------------------------------*/
: SubIngester_process ( pJob_SubIngester -- )

  params| pJob_SubIngester |

  pJob_SubIngester job_subIngester.begin not if exit then

  begin pJob_SubIngester job_subIngester.chunk while repeat

  pJob_SubIngester job_subIngester.end
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: SubIngester_ackParent ( pJob_SubIngester -- )

  params| pJob_SubIngester |

  0 locals| pJob_Ingest |

  pJob_SubIngester job_subIngester.jobIngest to pJob_Ingest

  pJob_Ingest job.task@ task.ack
;

/*----------------------------------------------------------------------------*/
/* SubIngester seed                                                           */
/*----------------------------------------------------------------------------*/
: subIngester_run ( -- )

  >>logEntry <SEED_RUN2>

  task::this locals| pThisTask |
  job::this  locals| pJob_SubIngester |

  pJob_SubIngester SubIngester_process

  pJob_SubIngester SubIngester_ackParent

  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
