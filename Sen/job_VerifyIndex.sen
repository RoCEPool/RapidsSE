/*============================================================================*/
/* job_VerifyIndex.sen -- Job Verify Index                                    */
/*============================================================================*/

" job_VerifyIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkVerifyIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* verify index request on a node                                             */
/*----------------------------------------------------------------------------*/
: verifyIndex::execute _eeh ( -- )

  job::this locals| pJob_VerifyIndex |

  0 0 0 0 locals| pTask pIndex sTableNm sIndexNm  |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table and indexes folder
  sTableNm pushTable assert
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // visualize
  sIndexNm find execute index.verify
  sTableNm sIndexNm grid::thisNodeName@
  "row: ('%v', '%v', '%v', '%v')\n" str.format
  pJob_VerifyIndex job.response!
  1 pJob_VerifyIndex job.rowsProcessed!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable
;

/*----------------------------------------------------------------------------*/
/* execute Job_VerifyIndex job check resources                                */
/*----------------------------------------------------------------------------*/
: verifyIndex::checkResources _eeh ( -- )

  0 0 locals| sIndexNm sTableNm |

  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  sTableNm sIndexNm checkVerifyIndex not if job::this <ERROR_JOB> !!logError exit then

  DdlLock[].dropRead
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: verifyIndex :: verifyIndex <tableNm> <indexNm> ;
jobSyntax: verifyIndex :: vfyIdx <tableNm> <indexNm> ;

jobInfo: verifyIndex
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_VERIFYINDEX
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
