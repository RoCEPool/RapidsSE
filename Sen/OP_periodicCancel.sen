/*============================================================================*/
/* OP_periodicCancel.sen -- Operator periodic                                 */
/*============================================================================*/

" OP_periodicCancel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: periodicCancel_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  Operand[].delete
  Operand[].newStopMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: periodicCancel_CancelMarker \handler

  "PERIODICOP: Operand:- ZK_CANCELMARKER" .
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: periodicCancel_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Operand[].pipeOut

   Counter1[] if
    begin
      begin
         Counter1[]  Counter0[] >
      while
        task::yield
        assert::stack_0
        "sleeping for 1 min" .
        60 task::sleepSsec
        Counter0[] 1 + to Counter0[]
      repeat
      0 to  Counter0[]
       Counter1[] "Sending PULSEMARKER after %v mins" str.format .
      Operand[].newPulseMarker
      Operand[].pipeOut
      true
    while assert::stack_0 repeat
  then

  //Operand[].newStopMarker
  //Operand[].pipeOut
  //Op.ackPipelineJob

  //false
  true
;

/*----------------------------------------------------------------------------*/
/* execute for periodicOp request                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : periodicCancel_req \operator
 
  LogReqEntry SEED_REQ

  0 locals| hours   |
  0 locals| minutes |

  "<minutes>" job[] job.enameset@ enameset.hasName if
    <minutes> >int to minutes
  then

  "<hours>" job[] job.enameset@ enameset.hasName if
    <hours> >int to hours
  then

  hours if
    hours 60 * to minutes
  then

  // elapsed
  0 to Counter0[]

  // minutes
  minutes to Counter1[]

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  op__topology

  find: periodicCancel_ErrorMarker ZK_CANCELMARKER op[].handler!
  find: periodicCancel_ErrorMarker ZK_ERRORMARKER op[].handler!
  find: periodicCancel_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: periodicCancel :: periodicCancel once ;
opSyntax: periodicCancel :: periodicCancel min <minutes> ;
opSyntax: periodicCancel :: periodicCancel hour <hours> ;

: periodicCancel opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
