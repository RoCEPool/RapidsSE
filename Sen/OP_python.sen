/*============================================================================*/
/* OP_python.sen -- Operator python                                           */
/*============================================================================*/

" OP_python.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: python_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Pipein[]
  Operand[].csvData
  <pythonFunction> <pythonFile> Operand[].invokePython

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
/*
: python_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  Pipein[].pipeOut

  true
;
*/

/*----------------------------------------------------------------------------*/
/* execute for python request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: python_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: python_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  //find: python_ErrorMarker ZK_ERRORMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: python :: python <pythonFile> <pythonFunction> ;

: python _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--cmd desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
