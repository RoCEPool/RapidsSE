/*============================================================================*/
/* OP_python.sen -- Operator python                                           */
/*============================================================================*/

" OP_python.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: pythonOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Pipein[] to Operand[]
  nullptr to Pipein[]
  Operand[].csvData
  <pythonFunction> <pythonFile> Operand[].invokePython

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: pythonOp_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: pythonOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for pythonOp request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pythonOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: pythonOp_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: pythonOp_ErrorMarker ZK_ERRORMARKER op[].handler!
  find: pythonOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: pythonOp :: pythonOp <pythonFile> <pythonFunction> ;

: pythonOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
