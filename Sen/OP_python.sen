/*============================================================================*/
/* OP_python.sen -- Operator python                                           */
/*============================================================================*/

" OP_python.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: pythonOp_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  Operand[].csvData
  <pythonFunction> <pythonFile> Operand[].invokePython

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: pythonOp_ErrorMarker \handler

  //"jobOperand::generic:- ZK_ERRORMARKER" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: pythonOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: pythonOp_StopMarker \handler

  //"Operand:- ZK_STOPMARKER" .verbose
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for pythonOp request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pythonOp_req ( -- )

  LogEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER   of pythonOp_CsvBuffer endof

      ZK_ERRORMARKER of pythonOp_ErrorMarker endof

      ZK_STARTMARKER of pythonOp_StartMarker endof

      ZK_STOPMARKER  of pythonOp_StopMarker endof

      Operand[].delete
      true
      swap

    endcase

  while assert::stack_0 repeat

  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: pythonOp :: pythonOp <pythonFile> <pythonFunction> ;

jobInfo: pythonOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
