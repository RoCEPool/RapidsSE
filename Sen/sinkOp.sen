/*============================================================================*/
/* sinkOp.sen -- sink operator                                                */
/*============================================================================*/

"sinkOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* sink                                                                       */
/*----------------------------------------------------------------------------*/
: sinkOp operator ( -- NEVER )

  ": sinkOp" .

  0 0 locals| planTBD profile |

  begin

    jobQueue> ( valset )

    valset> ( profile plan nValues )

    drop ( profile plan )

    to planTBD
    to profile

    planTBD planList::removePlan

    planTBD plan.delete

    "removed & deleted plan" .
    planList::show

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
