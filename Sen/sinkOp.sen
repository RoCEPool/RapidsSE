/*============================================================================*/
/* sinkOp.sen -- sink operator                                                */
/*============================================================================*/

"sinkOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* sink the plan                                                              */
/*----------------------------------------------------------------------------*/
: sinkPlan ( pSeitf profile plan -- )

  // record the plan and profile
  locals| thePlan profile pSeitf |

  thePlan planList::removePlan

  thePlan plan.delete

  //"removed & deleted plan" .
  //planList::show
;

/*----------------------------------------------------------------------------*/
/* sink operator loop                                                         */
/*----------------------------------------------------------------------------*/
: sinkOp operator ( -- NEVER )

  begin

    depth 0 != if "stack of task has grown" . debug::trap then

    // wait for next job
    jobQueue> ( valset )

    // unpack it
    valset> ( profile planId nValues )
    drop ( profile planId )

    // find plan using planId
    planList::findPlan ( pSeitf profile plan true )
    assert ( pSeitf profile plan )

    // sink the plan
    sinkPlan ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
