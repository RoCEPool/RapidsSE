/*============================================================================*/
/* sinkOp.sen -- sink operator                                                */
/*============================================================================*/

"sinkOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* sink                                                                       */
/*----------------------------------------------------------------------------*/
: sinkOp operator ( -- NEVER )

  ": sinkOp" .

  0 locals| planTBD |

  begin

    jobQueue> ( valset )

    valset> ( plan nValues )

    drop ( plan )

    to planTBD

    planTBD planList::removePlan

    planTBD plan.delete

    "removed & deleted plan" .
    planList::show

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
