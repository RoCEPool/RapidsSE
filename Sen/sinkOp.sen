/*============================================================================*/
/* sinkOp.sen -- sink operator                                                */
/*============================================================================*/

"sinkOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* sink                                                                       */
/*----------------------------------------------------------------------------*/
: sinkOp operator ( -- NEVER )

  ": sinkOp" .

  0 0 locals| planTBD profile |

  begin

    jobQueue> ( valset )

    valset> ( profile planId nValues )

    drop ( profile planId )

    planList::findPlan ( profile plan true )
    assert ( profile plan )

    to planTBD
    to profile

    // push the op frame for this sinkOp
    profile planTBD plan.opFrame? opFrame.push

    // discard this op's reg frame
    opFrame.drop

    planTBD planList::removePlan

    planTBD plan.delete

    "removed & deleted plan" .
    planList::show

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
