/*============================================================================*/
/* job_CreateSchema.sen -- Job Create Schema                                  */
/*============================================================================*/

" job_CreateSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is not a schema                                              */
/*----------------------------------------------------------------------------*/
: checkIsNotSchema ( word )
  findInCurrent not if true exit then
  EC_SCHEMA_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable schema folder                                  */
/*----------------------------------------------------------------------------*/
: checkMakeSchema ( "<schemaNm>" -- "<schemaNm>" true | "<schemaNm>" errorCode false )

  checkInSchemas   not if false exit then
  checkIsNotSchema not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* make a schema folder                                                       */
/*----------------------------------------------------------------------------*/
: makeSchema ( "<schemaNm>" --  )
 
  tp: makingSchema

  params| sSchemaNm |

  args.tracepoint if
    sSchemaNm "MAKING SCHEMA " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make the schema
 sSchemaNm :schema ( ^schema )
 drop

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make tables folder
 sSchemaNm makeTables 

;

/*----------------------------------------------------------------------------*/
/* create schema request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: createSchema_req ( -- )

  >>am <SEED_REQ>

  0 0 locals| pJob_CreateSchema pTask |

  tp: createSchema_req

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob_CreateSchema

  // distribute the job
  pJob_CreateSchema job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job on a node                                    */
/*----------------------------------------------------------------------------*/
: createSchema_exe ( pJob_CreateSchema -- )

  >>am <SEED_EXE>

  //params| pJob_CreateSchema |
  job::this locals| pJob_CreateSchema |

  0 locals| sSchemaNm |

  tp: createSchema_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  CN_JOB_CREATESCHEMA pJob_CreateSchema object.assertClass
  pJob_CreateSchema job.objectName@ to sSchemaNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_CreateSchema job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the schema
  sSchemaNm makeSchema ( )

  pJob_CreateSchema job.notice

  pJob_CreateSchema send_job__executed

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateSchema job check resources                              */
/*----------------------------------------------------------------------------*/
: createSchema.checkResources ( pJob_CreateSchema -- )

  >>am <Check_Resources>

  params| pJob_CreateSchema  |

  tp: createSchema.checkResources
  //"checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_CreateSchema job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  node::checkEnoughBuffers not if pJob_CreateSchema <ERROR_JOB> !!am exit then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can make the catalog
  pJob_CreateSchema job.objectName@
  checkMakeSchema not if pJob_CreateSchema <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateSchema job release resources                             */
/*----------------------------------------------------------------------------*/
: createSchema.releaseResources ( pJob_CreateSchema -- )

  >>am <Release_Resources>

  params| pJob_CreateSchema  |

  tp: createSchema.releaseResources
  //"releaseResources received" .

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: createSchema_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_createSchema |

  pJob_createSchema job.beginParticipant

  // check resources
  pJob_createSchema createSchema.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: createSchema_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_createSchema |

  pJob_createSchema createSchema.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: createSchema_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_createSchema |

  pJob_createSchema createSchema.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
