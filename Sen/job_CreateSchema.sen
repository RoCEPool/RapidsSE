/*============================================================================*/
/* job_CreateSchema.sen -- Job Create Schema                                  */
/*============================================================================*/

"job_CreateSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is not a schema                                              */
/*----------------------------------------------------------------------------*/
: checkIsNotSchema ( word )
  findInCurrent not if true exit then
  EC_SCHEMA_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable schema folder                                  */
/*----------------------------------------------------------------------------*/
: checkMakeSchema ( "<schemaNm>" -- "<schemaNm>" true | "<schemaNm>" errorCode false )

  checkInSchemas   not if false exit then
  checkIsNotSchema not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* make a schema folder                                                       */
/*----------------------------------------------------------------------------*/
: makeSchema ( "<schemaNm>" --  )
 
  tp: makingSchema

  params| sSchemaNm |

  args.tracepoint if
    sSchemaNm "MAKING SCHEMA " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make the schema
 sSchemaNm :schema ( ^schema )
 drop

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make tables folder
 sSchemaNm makeTables 

;

/*----------------------------------------------------------------------------*/
/* create schema request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: createSchema_req ( -- )

  0 0 locals| pJob_CreateSchema pTask |

  tp: createSchema_req

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob_CreateSchema

  // distribute the job
  pTask pJob_CreateSchema "job::distribute" find execute

  pJob_CreateSchema <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job on a node                                    */
/*----------------------------------------------------------------------------*/
: createSchema_node ( pJob_CreateSchema -- )

  params| pJob_CreateSchema |
  // job::this locals| pJob_CreateSchema |

  0 locals| sSchemaNm |

  tp: createSchema_node

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  CN_JOB_CREATESCHEMA pJob_CreateSchema object.assertClass
  pJob_CreateSchema job.objectName@ to sSchemaNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_CreateSchema getPathR35
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the schema
  sSchemaNm makeSchema ( )

  pJob_CreateSchema job.notice

  pJob_CreateSchema send_job__executed

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateSchema job check resources                              */
/*----------------------------------------------------------------------------*/
: createSchema_checkResources ( pJob_CreateSchema -- )

  params| pJob_CreateSchema  |

  tp: createSchema_checkResources
  "checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grad a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_CreateSchema getPathR35
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  checkEnoughBuffersR35 not if pJob_CreateSchema <ERROR_JOB> exit then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can make the catalog
  pJob_CreateSchema job.objectName@
  checkMakeSchema not if pJob_CreateSchema <ERROR_JOB> exit then

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateSchema job release resources                             */
/*----------------------------------------------------------------------------*/
: createSchema_releaseResources ( pJob_CreateSchema -- )

  params| pJob_CreateSchema  |

  tp: createSchema_releaseResources
  "releaseResources received" .

  <DONE_NODE>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
