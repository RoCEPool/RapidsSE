/*============================================================================*/
/* job_CreateSchema.sen -- Job Create Schema                                  */
/*============================================================================*/

" job_CreateSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is not a schema                                              */
/*----------------------------------------------------------------------------*/
: checkIsNotSchema ( word )
  folder[].findSymbol not if true exit then
  EC_SCHEMA_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable schema folder                                  */
/*----------------------------------------------------------------------------*/
: checkMakeSchema ( "<schemaNm>" -- "<schemaNm>" true | "<schemaNm>" errorCode false )

  path[].checkInSchemas   not if false exit then
  checkIsNotSchema not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateCatalog job on a node                                    */
/*----------------------------------------------------------------------------*/
: createSchema::execute _eeh ( -- )


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the schema
  <schemaNm> :makeSchemaFolder ( )
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateSchema job check resources                              */
/*----------------------------------------------------------------------------*/
: createSchema::checkResources _eeh ( -- )

  //"checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  node::checkEnoughBuffers not if job[] ERROR_JOB !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can make the catalog
  //pJob_CreateSchema job.schemaName@
  <schemaNm> checkMakeSchema not if job[] ERROR_JOB !!logError exit then

;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: createSchema :: create schema <schemaNm> ;

jobInfo: createSchema
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
