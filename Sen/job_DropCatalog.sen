/*============================================================================*/
/* job_DropCatalog.sen -- Job Drop Catalog                                    */
/*============================================================================*/

" job_DropCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable catalog folder                                */
/*----------------------------------------------------------------------------*/
: checkRemoveCatalog ( "<catalogNm>" -- true | errorCode false )

  params| sCatalogNm |

  path[].checkInCatalogs not if false exit then

  sCatalogNm word::isKnown not if EC_NO_SUCH_CATALOG false exit then

  sCatalogNm path[].checkIsCatalog  not if false exit then

  folder.isEmpty    not if false exit then
  folder.notUsed    not if false exit then

  true 
;

/*----------------------------------------------------------------------------*/
/* remove a catalog folder                                                    */
/*----------------------------------------------------------------------------*/
: removeCatalog ( "<catalogNm>" --  )


  args.tracepoint if
  dup "REMOVING CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  :forget ( )
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropCataloge job on a node                                     */
/*----------------------------------------------------------------------------*/
: dropCatalog::execute _eeh ( -- )

  job[] locals| pJob_DropCatalog |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  <catalogNm> removeCatalog
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropCatalog job check resources                                */
/*----------------------------------------------------------------------------*/
: dropCatalog::checkResources _eeh ( -- )

  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the catalog
  //<catalogNm> checkRemoveCatalog not if job[] ERROR_JOB !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: dropCatalog :: drop catalog <catalogNm> ;

jobInfo: dropCatalog
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
