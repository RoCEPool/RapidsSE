/*============================================================================*/
/* job_DropCatalog.sen -- Job Drop Catalog                                    */
/*============================================================================*/

" job_DropCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a removable catalog folder                                */
/*----------------------------------------------------------------------------*/
: checkRemoveCatalog ( "<catalogNm>" -- true | errorCode false )

  params| sCatalogNm |

  checkInCatalogs not if false exit then
  sCatalogNm checkIsWord not if EC_NO_SUCH_CATALOG false exit then
  checkIsCatalog  not if false exit then
  checkIsEmpty    not if false exit then
  checkNotUsed    not if false exit then

  true 
;

/*----------------------------------------------------------------------------*/
/* remove a catalog folder                                                    */
/*----------------------------------------------------------------------------*/
: removeCatalog ( "<catalogNm>" --  )

  tp: removeCatalog

  args.tracepoint if
  dup "REMOVING CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  :forget ( )
;

/*----------------------------------------------------------------------------*/
/* drop catalog request (on originating node)                                 */
/*----------------------------------------------------------------------------*/
: dropCatalog_req ( -- <R> )

  <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: dropCatalog_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropCataloge job on a node                                     */
/*----------------------------------------------------------------------------*/
: dropCatalog_exe ( pJob_DropCatalog -- )

  <SEED_EXE>

  //params| pJob_DropCatalog |
  job::this locals| pJob_DropCatalog |

  tp: dropCatalog_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_DROPCATALOG pJob_DropCatalog object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grad a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_DropCatalog getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  pJob_DropCatalog job.objectName@   ( catalogNm )
  removeCatalog

  pJob_DropCatalog job.notice

  pJob_DropCatalog send_job__executed

  nullptr task::this task.job!

  <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropCatalog job check resources                                */
/*----------------------------------------------------------------------------*/
: dropCatalog.checkResources ( Job_DropCatalog -- )

  params| pJob_DropCatalog  |

  tp: dropCatalog.checkResources
  "checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_DropCatalog getPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the catalog
  pJob_DropCatalog job.objectName@
  checkRemoveCatalog not if pJob_DropCatalog <ERROR_JOB> exit then

  ddlLock::dropWrite
;

/*----------------------------------------------------------------------------*/
/* execute Job_DropCatalog job release resources                              */
/*----------------------------------------------------------------------------*/
: dropCatalog.releaseResources ( Job_DropCatalog -- )

  params| pJob_DropCatalog  |

  tp: dropCatalog.releaseResources
  "releaseResources received" .
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: dropCatalog_beg ( -- )

  <SEED_BEG>

  job::this locals| pJob_dropCatalog |

  pJob_dropCatalog job.beginParticipant

  // check resources
  pJob_dropCatalog dropCatalog.checkResources

  job::participantBegun

  <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: dropCatalog_end ( -- )

  <SEED_END>

  job::this locals| pJob_dropCatalog |

  pJob_dropCatalog dropCatalog.releaseResources

  job::participantEnded

  <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: dropCatalog_can ( -- )

  <SEED_CAN>

  job::this locals| pJob_dropCatalog |

  pJob_dropCatalog dropCatalog.releaseResources

  job::participantCancelled

  <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
