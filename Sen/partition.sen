/*============================================================================*/
/* partition.sen -- partition related words                                   */
/*============================================================================*/

"partition.sen" .verbose

/*----------------------------------------------------------------------------*/
/* make a partitions folder under given named table                           */
/*----------------------------------------------------------------------------*/
: makePartitions ( "<tableNm>" -- )

  args.tracepoint if
  dup "MAKING PARTITIONS FOR TABLE " swap str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  find execute ( dic )
  "partitions" ( dic "partitions" )
  swap         ( "partitions" dic )
  :folder      ( )
;

/*----------------------------------------------------------------------------*/
/* check within partitions folder                                             */
/*----------------------------------------------------------------------------*/
: withinPartitions
  0 pathPick dic.name "partitions" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in partitions folder                                                 */
/*----------------------------------------------------------------------------*/
: checkInParitions
  withinPartitions if true exit then
  EC_NOT_IN_PARTITIONS false
;

/*----------------------------------------------------------------------------*/
/* find the partitions folder and push it onto task dictionary                */
/*----------------------------------------------------------------------------*/
: pushPartitions ( -- )
  "partitions" find execute pathPush
  true
;

/*----------------------------------------------------------------------------*/
/* pop the partitions folder                                                  */
/*----------------------------------------------------------------------------*/
: popPartitions
  pathDrop
;

/*----------------------------------------------------------------------------*/
/* check table can be partitioned                                             */
/*----------------------------------------------------------------------------*/
: checkPartitionTable ( "<tableNm>" --  true | errorCode false )

  locals| sTableNm |

  checkInTables not if false exit then

  sTableNm checkIsTableFolder not if false exit then

  sTableNm pushTable assert
  pushPartitions assert

  checkIsEmpty not if popPartitions popTable assertInTables false exit then

  popPartitions
  popTable

  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* assert top of task dictionary stack is partitions                          */
/*----------------------------------------------------------------------------*/
: assertInPartitions ( -- t|f )
  withinPartitions assert
;

/*----------------------------------------------------------------------------*/
/* tidy up of the partition                                                   */
/*----------------------------------------------------------------------------*/
: paritionTidyUp ( "<indexNm>" -- )

   find execute ( ^indexPtr )

   // truncate the index
   dup index.truncate
   
   // forget all column names
   dup partitions::subDic
   pathPush
   "columns" find execute forgetAll
   pathDrop

  // forget the sub dictionary
  partitions::subDic forgetAll
;

////////////////////////////////////////////////////////////////////////////////


/*----------------------------------------------------------------------------*/
/* make partition (run by participant)                                        */
/*----------------------------------------------------------------------------*/
: partitionTable allParticipants 2 checkResult ( "<tableNm>" -- true n# true )

tp: partitioningTable

  0 0 locals| indexPtr tablePtr tableNm |

  args.tracepoint if
  "MAKING PARTITIONS on NODE " grid.thisNode@ >str str.cat .
  then

  tableNm ( "<tableNm>" )
  find execute pathPush

  "partitions" find execute pathPush

  // make partition columns
  "makePartitionColumns" find execute

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
