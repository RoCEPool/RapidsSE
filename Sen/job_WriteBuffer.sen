/*============================================================================*/
/* job_WriteBuffer.sen -- Write Buffer Job                                    */
/*============================================================================*/

" job_WriteBuffer.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                               on kid node                                  //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* load buffer into table                                                     */
/*----------------------------------------------------------------------------*/
: WriteBuffer.insert ( pJob_WriteBuffer -- )

  params| pJob_WriteBuffer |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  0 locals| pJob_EndInsert  |

  0 locals| sTableNm    |
  0 locals| i_Partition |
  0 locals| bAllLoaded  |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "WriteBuffer.insert :" .verbose
  //pJob_WriteBuffer job.show

  // get table name
  pJob_WriteBuffer job.objectName@ to sTableNm

  // push table dictionary
  pJob_WriteBuffer getPath dicStack.set
  sTableNm pushTable assert
  //pathDump

  // use table name find and set target table
  sTableNm find execute locals| pTable |
  pTable pJob_WriteBuffer Job_WriteBuffer.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // grab write lock on table partition
  pJob_WriteBuffer Job_WriteBuffer.partition@ to i_Partition
  i_Partition pTable tablePtnGrabWrite

  // now insert the buffer of rows
  pJob_WriteBuffer Job_WriteBuffer.insertRows to bAllLoaded

  // drop write lock on table partition
  i_Partition pTable tablePtnDropWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // ack the load table task if all buffers have been loaded
  bAllLoaded if

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // get the parent job (participant node)
    // parent jo can be EndInsert of LoadTable
    pJob_WriteBuffer Job_WriteBuffer.parentJobId@ locals| iParentJobId |

    // we wait till the parent job can be found in the participant job skip list
    // there is a possiblity that the buffer arrives on a node before the parent job
    pJob_WriteBuffer iParentJobId job::waitParticipant locals| pJob_Parent |

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // first check if the job is executing SS_SEED_EXE
    // then get the task that is executing it
    begin
      pJob_Parent job.IsExecuting
    not while
      1 thread.sleep_ms
    repeat

    pJob_Parent job.executingTask@ locals| pTask_Parent |

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // wait for acks to be set in the endInsert task
    begin
       pTask_Parent task.IsAckSet
    not while
       1 thread.sleep_ms
    repeat

    "WriteBuffer.insert acking parentJob(endInsert/loadTable):" .verbose
    pTask_Parent task.grabLock
    pTask_Parent task.dropLock
    pTask_Parent task.ack

  then

;

/*----------------------------------------------------------------------------*/
/* seed on kid node                                                           */
/*----------------------------------------------------------------------------*/
: writeBuffer_kid ( -- )

  >>am <SEED_KID>

  job::this locals| pJob_WriteBuffer |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check there is enough buffers and load

  // node::checkEnoughBuffers if
  pJob_WriteBuffer writeBuffer.insert
  //then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  <<am
  delete_completed_job

  <DONE_KID>
;

////////////////////////////////////////////////////////////////////////////////
//                            on loading node                                 //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* forward this load buffer job to kid node                                   */
/*----------------------------------------------------------------------------*/
: WriteBuffer.forward ( pJob_WriteBuffer -- )

  params| pJob_WriteBuffer |

  // which partition are we forwarding to?
  pJob_WriteBuffer Job_WriteBuffer.partition@ locals| i_Partition |

  // convert i_Partition to i_ForwardNode
  i_Partition grid::toNode locals| i_ForwardNode |

  //i_Partition i_ForwardNode "WriteBuffer.forward : Node %v Partition %v" fmt.print

  // send this job to the forward node
  i_ForwardNode pJob_WriteBuffer job.forward
;

/*----------------------------------------------------------------------------*/
/* seed on inserting node                                                     */
/*----------------------------------------------------------------------------*/
: writeBuffer_run (  -- )

  >>am <SEED_RUN>

  job::this locals| pJob_WriteBuffer  |

  "pJob_WriteBuffer :" .verbose

  // simply forward this job to kid node
  pJob_WriteBuffer writeBuffer.forward

  delete_completed_job

  <DONE_RUN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
