/*============================================================================*/
/* OP_send.sen -- socket send of operands                                     */
/*============================================================================*/

" OP_send.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: send_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: send_PulseMarker \handler

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: send_CsvBuffer \handler

  ZK_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: send_EosMarker \handler

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* send request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: send_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: send_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: send_EosMarker   ZK_EOSMARKER   op[].handler!
  find: send_PulseMarker ZK_PULSEMARKER op[].handler!
  find: send_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: send :: send <ipAddress> <portNo> ;

: send _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
