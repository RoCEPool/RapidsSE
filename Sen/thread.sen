/*============================================================================*/
/* thread.sen -- thread related words                                         */
/*============================================================================*/

"thread.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a thread using string from input stream as name                     */
/*----------------------------------------------------------------------------*/

: thread:

  create
  WT_OBJECT word.this word.type!
  sizeof_thread allot
  word.this >body object.magic!
  CN_THREAD word.this >body object.class!
  word.this >body thread.init
  true word.this >body object.wordbody!
  does>
;

: :thread

  >create
  WT_OBJECT word.this word.type!
  sizeof_thread allot
  word.this >body object.magic!
  CN_THREAD word.this >body object.class!
  word.this >body thread.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* create a task using given arguments and append to general task queue       */
/*----------------------------------------------------------------------------*/
: spawnGeneralTask ( ... nArgs sSeedWord pParentTask sTaskNm -- )

  nullptr locals| pTask sTaskNm pParent sSeedWord nArgs |

  // create a new task
  nArgs sSeedWord pParent task::new to pTask

  // set task name
  sTaskNm pTask task.name!

  // append task onto general task queue
  pTask scheduler::enqueueGeneralTask

  pTask  // return the task
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
