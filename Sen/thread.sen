/*============================================================================*/
/* thread.sen -- thread related words                                         */
/*============================================================================*/

"thread.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a thread using string from input stream as name                     */
/*----------------------------------------------------------------------------*/

: thread:

  create
  WT_OBJECT word.this word.type!
  sizeof_thread allot
  word.this >body object.magic!
  CN_THREAD word.this >body object.class!
  word.this >body thread.init
  true word.this >body object.wordbody!
  does>
;

: :thread

  >create
  WT_OBJECT word.this word.type!
  sizeof_thread allot
  word.this >body object.magic!
  CN_THREAD word.this >body object.class!
  word.this >body thread.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* create a thread-task pair using given arguments                            */
/*----------------------------------------------------------------------------*/
: spawnActorTask ( ... nArgs sSeedWord pParentTask sTaskNm -- )

  // save arguments
  locals| sTaskNm pParent sSeedWord nArgs |

  // local variables
  nullptr nullptr locals| pTaskSet pThread pTask |

  // create a new task
  nArgs sSeedWord pParent task::new to pTask

  // set task name
  sTaskNm pTask task.name!

  // create a thread
  sTaskNm "Thread" str.cat :thread execute to pThread

  // set thread name
  sTaskNm "Thread" str.cat pThread thread.name!

  // create taskset
  sTaskNm "TaskSet" str.cat :taskSet execute to ptaskSet

  // attach taskset onto thread
  pTaskSet pThread thread.taskSet!

  // append task into taskset
  pTask pTaskSet taskSet.append

  // spawn posix thread for actor 
  pThread thread.spawn_actor

  pTask
;

/*----------------------------------------------------------------------------*/
/* create a task using given arguments and append to general task queue       */
/*----------------------------------------------------------------------------*/
: spawnGeneralTask ( ... nArgs sSeedWord pParentTask sTaskNm -- )

  nullptr locals| pTask sTaskNm pParent sSeedWord nArgs |

  // create a new task
  nArgs sSeedWord pParent task::new to pTask

  // set task name
  sTaskNm pTask task.name!

  // append task onto general task queue
  pTask scheduler::enqueueGeneralTask

  pTask  // return the task
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
