/*============================================================================*/
/* job_Report.sen -- Report Job                                               */
/*============================================================================*/

" job_Report.sen" .verbose

/*----------------------------------------------------------------------------*/
/* write portrait of system to output                                         */
/*----------------------------------------------------------------------------*/
: Report_process ( pJob_Report -- )

  params| pJob_Report |

  pJob_Report job_report.begin not if exit then

  begin pJob_Report job_report.take while repeat

  pJob_Report job_report.end
;

/*----------------------------------------------------------------------------*/
/* Job_Report request (on command node)                                      */
/*----------------------------------------------------------------------------*/
: Monitor_req (  -- <R> )

  >>am <SEED_REQ>

  job::this locals| pJob_Report |

  pJob_Report Report_process

  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
