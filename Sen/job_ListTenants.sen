/*============================================================================*/
/* job_ListTenants.sen -- Job List Tenants                                    */
/*============================================================================*/

" job_ListTenants.sen" .verbose

/*----------------------------------------------------------------------------*/
/* List Tenants requests (on the originating node)                            */
/*----------------------------------------------------------------------------*/
: lsten_req ( -- <R> )

  LogEntry SEED_REQ

  0 0 locals| pJob_ListTenants pTask |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task[] to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListTenants

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tenants folder
  checkInTenants not if pJob_ListTenants ERROR_REQUEST !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list tables folder contents
  pJob_ListTenants listContents

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  LogExit DONE_REQ
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: lsten :: lsten ;

jobInfo: lsten
{
  <jobKind> = JK_LOCAL
  <rspKind> = RS_JOB_RESPONSE
  ddlLock = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

