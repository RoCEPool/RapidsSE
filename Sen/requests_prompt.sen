/*============================================================================*/
/* requests_prompt.sen -- the set of prompt related requests                  */
/*============================================================================*/

"requests_prompt.sen" .verbose

/*----------------------------------------------------------------------------*/
/* run the prompt request                                                     */
/*----------------------------------------------------------------------------*/
: promptR35_req ( -- <R> )

  0 locals| pPrompt |
  0 locals| pCommandProcessor |
  0 locals| eCommand |
  0 locals| pJob |

  "promptR35_req" .

  prompt::new to pPrompt
  pPrompt prompt.commandProcessor to pCommandProcessor

  begin

    // get the next command
    pPrompt prompt.getCommand

    // check and execute the command
    pPrompt prompt.executeCommand to eCommand

    // job commands have had their job class identified
    eCommand CK_SE_JOB == if

    // create the job for the command
    pCommandProcessor commandProcessor.newJob to pJob

    pJob job.hasError false == if

      // grab this prompt task's lock
      task::this task.grabLock

      // set 1 ack required from the job
      1 setAcks

      // dispatch the job
      pPrompt prompt.dispatchJob

      // wait for ack from job
      "prompt waiting for ack" .
      ackWait

    else
      "job has error (maybe syntax error)" .
    then

     // post process and delete the job
     pCommandProcessor commandProcessor.endJob

  then

  again

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
