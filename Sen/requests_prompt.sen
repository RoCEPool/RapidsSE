/*============================================================================*/
/* requests_prompt.sen -- the set of prompt related requests                  */
/*============================================================================*/

"requests_prompt.sen" .verbose

/*----------------------------------------------------------------------------*/
/* run the prompt request                                                     */
/*----------------------------------------------------------------------------*/
: promptR35_req ( -- <R> )

  0 locals| pPrompt |
  0 locals| pSEitf |
  0 locals| pCommandProcessor |
  0 locals| eCommand |
  0 locals| pJob |

  "promptR35_req" .

  prompt::new to pPrompt
  pPrompt prompt.SEitf to pSEitf
  pSEitf seitf.commandProcessor to pCommandProcessor

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin pPrompt prompt.continue while

    // get the next command
    pCommandProcessor commandProcessor.getCommand

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // non-job possibilities

    // check for blank line
    pCommandProcessor commandProcessor.blankLine if
      //"A blank line" .
      ifAgain
    then

    // possible prompt function
    pPrompt prompt.executeFunction if
      //"A prompt function" .
      ifAgain
   then

    // possible command file
    pCommandProcessor commandProcessor.executeFile if
      //"A file executed" .
      ifAgain
    then

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // possible job

    // is this a know job class?
    pCommandProcessor commandProcessor.findJobClass not if
      "Unknown command" .
      ifAgain
    then

    // create the job for the command
    pSEitf pCommandProcessor commandProcessor.newJob to pJob

    // test for error
    pJob job.hasError if
      "job has error (maybe syntax error)" .
      pSEitf pCommandProcessor commandProcessor.postJob
      pSEitf pCommandProcessor commandProcessor.deleteJob
      ifAgain
    then

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // known valid job

    // grab this prompt task's lock
    task::this task.grabLock

    // set 1 ack required from the job
    1 setAcks

    // dispatch the job
    pSEitf pCommandProcessor commandProcessor.dispatchJob

    // wait for ack from job
    "prompt waiting for ack" .
    ackWait

    // post process and delete the job
    pSEitf pCommandProcessor commandProcessor.postJob
    pSEitf pCommandProcessor commandProcessor.deleteJob
    nullptr task::this task.job!
  repeat
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  <OK>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
