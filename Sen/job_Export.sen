/*============================================================================*/
/* job_Export.sen -- Job Export                                               */
/*============================================================================*/

" job_Export.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn sub-exporters on particpating node                      [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export.spawnSubExporters ( pJob_Export -- )

  params| pJob_Export |

  task::this task.grabLock

  grid::slots task::acks!

  grid::slots 0
  do
    I pJob_Export job_subExporter::spawn                     // [E](E`)SE:(E`)SE
  loop

  task::wait
;

/*----------------------------------------------------------------------------*/
/* twiddle till kid exports are completed                                     */
/*----------------------------------------------------------------------------*/
: export.waitForAllKidExports ( pJob_Export -- )

  params| pJob_Export |

  task::this task.grabLock

  pJob_export job_export.tapsRemaining@ if

    true pJob_export job_export.twiddling!
    "Twiddling!!!" .
    1 task::acks!
    task::wait

  else

    "No need to twiddle" .
    task::this task.dropLock

  then
;

/*----------------------------------------------------------------------------*/
/* init request export job E on this originator node                 []()E:() */
/*----------------------------------------------------------------------------*/
: export.initRequest ( pJob_Export --  )

  params| pJob_Export |

  0 locals| sTableNm  |
  0 locals| pTable    |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set path and table folder of E

  // set path
  pJob_Export job.pushPath task::dicStack.set

  // set table dictionary
  pJob_Export job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get table pointer
  sTableNm table::find to pTable
  pTable pJob_Export job_export.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // open file E::m_oCvsFile

  pJob_Export job_export.begin
;


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* init participant export job (E`) on this participant node     [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export.initParticipant ( pJob_Export --  )

  params| pJob_Export |

  0 locals| sTableNm  |
  0 locals| pTable    |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set path and table folder of (E`)

  // set path
  pJob_Export job.pushPath task::dicStack.set

  // set table folder
  pJob_Export job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find and store table pointer into (E`)::m_pTable
  sTableNm table::find to pTable
  pTable pJob_Export job_export.table!
;

/*----------------------------------------------------------------------------*/
/* check valid table folder for export job (E`) on ptp node      [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export.checkTable ( sTableNm -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* check resources for export job (E`) on participant node       [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export.checkResources ( pJob_Export -- )

  >>am <Check_Resources>

  params| pJob_Export  |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_Export job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can export the table
   pJob_Export job.objectName@ export.checkTable
   not if
     pJob_Export
     <ERROR_JOB>
     !!am exit
  then

  <<am <Resources_Checked>
  an::resources_checked
;

/*----------------------------------------------------------------------------*/
/* release resources for export job (E`) on participant node     [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export.releaseResources ( pJob_Export -- )

  >>am <Release_Resources>

  params| pJob_Export  |

  <<am <Resources_Released>
  an::resources_released
;


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* perform command req seed for E on request node                    []()E:() */
/*----------------------------------------------------------------------------*/
: export_req ( -- <R> )

  >>am <SEED_REQ>
  an::seed_req

  job::this locals| pJob_Export |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  pJob_Export export.initRequest

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn the sub-exporters on this participant node           [E](E`)SE:(E`)SE
  pJob_Export export.spawnSubExporters

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute E' to all participants                    `KE[E](`E)SE:(`E)SE,KE
  pJob_Export job.distribute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for all 'KE to write                                              [E]:
  pJob_Export export.waitForAllKidExports

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // close the export file [E]::m_oCsvFile
  pJob_Export job_export.end

  <<am <DONE_REQ>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* begin Job_Export E` on participating node                         [E]E`:E` */
/*----------------------------------------------------------------------------*/
: export_beg ( -- )

  >>am <SEED_BEG>
  an::seed_rcv

  job::this locals| pJob_Export |

  // this E` becomes (E`)                                           [E](E`):(E`)
  pJob_Export job.becomeParticipant

  // check table being exported exists on this node
  pJob_Export export.checkResources

  // send job__begin to [E]                                  __BEGUN[E](E`):(E`)
  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* execute Job_Export (E`) on participating node                 [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export_exe ( pJob_Export -- )

  >>am <SEED_EXE>
  an::seed_exe

  job::this locals| pJob_Export |

  pJob_Export export.initParticipant

  // send job__executed to [E]                            __EXECUTED[E](E`):(E`)
  pJob_Export job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* end Job_Export (E`) on participating node                     [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export_end ( -- )

  >>am <SEED_END>
  an::seed_end

  job::this locals| pJob_Export |

  pJob_Export export.releaseResources

  // send job__ended to [E]                                      __ENDED[E]():()
  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel Job_Export (E`) on participating node                  [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export_can ( -- )

  >>am <SEED_CAN>
  an::seed_can

  job::this locals| pJob_Export |

  pJob_Export export.releaseResources

  // send job__cancelled to [E]                              __CANCELLED[E]():()
  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
