/*============================================================================*/
/* job_Export.sen -- Job Export                                               */
/*============================================================================*/

" job_Export.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn sub-exporter jobs SE on particpating node               [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: (E`).spawn_SE ( pJob_(E`) -- )

  params|  pJob_(E`) |

  task::this task.grabLock

  grid::slots task::acks!

  grid::slots 0
  do
    I  pJob_(E`) job_subExporter::spawn                      // [E](E`)SE:(E`)SE
  loop

  task::wait
;

/*----------------------------------------------------------------------------*/
/* twiddle till kid exports are completed                                     */
/*----------------------------------------------------------------------------*/
: E.waitAll_KE ( pJob_[E] -- )

  params| pJob_[E] |

  task::this task.grabLock

  pJob_[E] job_export.tapsRemaining@ if

    true pJob_[E] job_export.twiddling!
    "Twiddling!!!" .
    1 task::acks!
    task::wait

  else

    "No need to twiddle" .
    task::this task.dropLock

  then
;

/*----------------------------------------------------------------------------*/
/* init export job E on this originator node                         []()E:() */
/*----------------------------------------------------------------------------*/
: E.initJob ( pJob_E --  )

  params| pJob_E |

  0 locals| sTableNm  |
  0 locals| pTable    |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set path and table folder of E

  // set path
  pJob_E job.pushPath task::dicStack.set

  // set table dictionary
  pJob_E job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get table pointer
  sTableNm table::find to pTable
  pTable pJob_E job_export.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // open file E::m_oCvsFile

  pJob_E job_export.begin
;


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* init export job (E`) on this participant node                 [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: (E`).InitJob ( pJob_(E`) --  )

  params| pJob_(E`) |

  0 locals| sTableNm  |
  0 locals| pTable    |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set path and table folder of (E`)

  // set path
  pJob_(E`) job.pushPath task::dicStack.set

  // set table folder
  pJob_(E`) job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find and store table pointer into (E`)::m_pTable
  sTableNm table::find to pTable
  pTable pJob_(E`) job_export.table!
;

/*----------------------------------------------------------------------------*/
/* check valid table folder for export job (E`) on ptp node      [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: (E`).checkTable ( sTableNm -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* check resources for export job (E`) on participant node       [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: (E`).checkResources ( pJob_(E`) -- )

  >>am <Check_Resources>

  params| pJob_(E`)  |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_(E`) job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can export the table
   pJob_(E`) job.objectName@ (E`).checkTable
   not if
     pJob_(E`)
     <ERROR_JOB>
     !!am exit
  then

  <<am <Resources_Checked>
  an::resources_checked
;

/*----------------------------------------------------------------------------*/
/* release resources for export job (E`) on participant node     [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: (E`).releaseResources ( pJob_Export -- )

  >>am <Release_Resources>

  params| pJob_Export  |

  <<am <Resources_Released>
  an::resources_released
;


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* request seed for E on request node                                []()E:() */
/*----------------------------------------------------------------------------*/
: export_req ( -- <R> )

  >>am <SEED_REQ>
  an::seed_req

  job::this locals| pJob_E |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  pJob_E E.initJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute E' to all participants                                  [E]E`:E`
  pJob_E job.distribute                                                    // E:

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for all KE' to write                                            KE',E:
  pJob_E E.waitAll_KE                                                      // E:

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // close the export file E::m_oCsvFile
  pJob_E job_export.end

  <<am <DONE_REQ>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* begin seed for E` on participating node                           [E]E`:E` */
/*----------------------------------------------------------------------------*/
: export_beg ( -- )

  >>am <SEED_BEG>
  an::seed_rcv

  job::this locals| pJob_(E`) |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // this E` becomes (E`)                                           [E](E`):(E`)
  pJob_(E`) job.becomeParticipant

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // check table being exported exists on this node
  pJob_(E`) (E`).checkResources

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send job__begin to [E]                                  __BEGUN[E](E`):(E`)
  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* execute seed for (E`) on participating node                   [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export_exe ( pJob_Export -- )

  >>am <SEED_EXE>
  an::seed_exe

  job::this locals| pJob_(E`) |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  pJob_(E`) (E`).InitJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn the sub-exporters on this participant node           [E](E`)SE:(E`)SE
  pJob_(E`) (E`).spawn_SE

  // (E`) sends job__executed to [E]                      __EXECUTED[E](E`):(E`)
  pJob_(E`) job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* end seed for (E`) on participating node                       [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export_end ( -- )

  >>am <SEED_END>
  an::seed_end

  job::this locals| pJob_(E`) |

  pJob_(E`) (E`).releaseResources

  // (E`) sends job__ended to [E]                                __ENDED[E]():()
  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel seed for (E`) on participating node                    [E](E`):(E`) */
/*----------------------------------------------------------------------------*/
: export_can ( -- )

  >>am <SEED_CAN>
  an::seed_can

  job::this locals| pJob_(E`) |

  pJob_(E`) (E`).releaseResources

  // (E`) sends job__cancelled to [E]                        __CANCELLED[E]():()
  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
