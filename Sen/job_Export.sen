/*============================================================================*/
/* job_Export.sen -- Job Export                                               */
/*============================================================================*/

" job_Export.sen" .verbose

/*----------------------------------------------------------------------------*/
/* spawn sub-exporters on particpating node                                   */
/*----------------------------------------------------------------------------*/
: export.spawnSubExporters ( pJob_Export -- )

  params| pJob_Export |

  task::this task.grabLock

  grid::slots task::acks!

  grid::slots 0
  do
    I pJob_Export job_subExporter::spawn
  loop

  task::wait
;

/*----------------------------------------------------------------------------*/
/* twiddle till kid exports are completed                                     */
/*----------------------------------------------------------------------------*/
: export.twiddle ( pJob_Export -- )

  params| pJob_Export |

  task::this task.grabLock

  true pJob_export job_export.twiddling!

  task::this task.dropLock
;

/*----------------------------------------------------------------------------*/
/* export on this participant node (same as originator)                       */
/*----------------------------------------------------------------------------*/
: export.exportOriginator ( pJob_Export --  )

  params| pJob_Export |

  0 locals| sTableNm  |
  0 locals| pTable    |

  "export_export: export on this node" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set path
  pJob_Export job.pushPath task::dicStack.set

  // set table dictionary
  pJob_Export job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get table pointer
  sTableNm table::find to pTable

  pTable pJob_Export job_export.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  pJob_Export job_export.begin
;

/*----------------------------------------------------------------------------*/
/* export on this participant node (same as originator)                       */
/*----------------------------------------------------------------------------*/
: export.exportParticipant ( pJob_Export --  )

  params| pJob_Export |

  0 locals| sTableNm  |
  0 locals| pTable    |

  "export_export: export on this node" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set path
  pJob_Export job.pushPath task::dicStack.set

  // set table dictionary
  pJob_Export job.objectName@ to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get table pointer
  sTableNm table::find to pTable

  pTable pJob_Export job_export.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_Export export.spawnSubExporters

  //1000000000 task.sleepUsec
;


////////////////////////////////////////////////////////////////////////////////


/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: export.checkTable ( sTableNm -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* check resources                                                            */
/*----------------------------------------------------------------------------*/
: export.checkResources ( pJob_Export -- )

  >>am <Check_Resources>

  params| pJob_Export  |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_Export job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can export the table
   pJob_Export job.objectName@ export.checkTable
   not if
     pJob_Export
     <ERROR_JOB>
     !!am exit
  then

  <<am <Resources_Checked>
  an::resources_checked
;

/*----------------------------------------------------------------------------*/
/* release resources                                                          */
/*----------------------------------------------------------------------------*/
: export.releaseResources ( pJob_Export -- )

  >>am <Release_Resources>

  params| pJob_Export  |

  <<am <Resources_Released>
  an::resources_released
;


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* export command request on originating node                                 */
/*----------------------------------------------------------------------------*/
: export_req ( -- <R> )

  >>am <SEED_REQ>
  an::seed_req

  job::this locals| pJob_Export |

  pJob_Export export.exportOriginator

  pJob_Export job.distribute

  <<am <DONE_REQ>
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* begin Job_Export on participating node                                     */
/*----------------------------------------------------------------------------*/
: export_beg ( -- )

  >>am <SEED_BEG>
  an::seed_rcv

  job::this locals| pJob_Export |

  pJob_Export job.beginParticipant

  pJob_Export export.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* execute Job_Export on participating node                                   */
/*----------------------------------------------------------------------------*/
: export_exe ( pJob_Export -- )

  >>am <SEED_EXE>
  an::seed_exe

  job::this locals| pJob_Export |


  pJob_Export export.exportParticipant

  pJob_Export job.notice

  // delete_completed_job

  pJob_Export send_job__executed

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* end Job_Export on participating node                                       */
/*----------------------------------------------------------------------------*/
: export_end ( -- )

  >>am <SEED_END>
  an::seed_end

  job::this locals| pJob_Export |

  pJob_Export export.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel Job_Export on participating node                                    */
/*----------------------------------------------------------------------------*/
: export_can ( -- )

  >>am <SEED_CAN>
  an::seed_can

  job::this locals| pJob_Export |

  pJob_Export export.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
