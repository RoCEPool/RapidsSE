/*============================================================================*/
/* job_Cat.sen -- Cat Job                                                     */
/*============================================================================*/

" job_Cat.sen" .verbose

/*----------------------------------------------------------------------------*/
/* read chunks from input, write them to output                               */
/*----------------------------------------------------------------------------*/
: Cat_process ( pJob_Cat -- )

  params| pJob_Cat |

  pJob_Cat job_cat.begin not if exit then

  begin pJob_Cat job_cat.chunk while repeat

  pJob_Cat job_cat.end
;

/*----------------------------------------------------------------------------*/
/* Job_Cat request (on command node)                                          */
/*----------------------------------------------------------------------------*/
: Cat_req (  -- <R> )

  >>logEntry <SEED_REQ2>

  job::this locals| pJob_Cat |

  pJob_Cat Cat_process

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
