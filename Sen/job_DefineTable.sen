/*============================================================================*/
/* job_defineTable.sen -- Job Define Info Table                               */
/*============================================================================*/

" job_defineTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a creatable table                                    */
/*----------------------------------------------------------------------------*/
: defineTable::checkCreate ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then
 
  // error if given name already exists
  <tableNm> check::nameIsUnknownTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* define table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: defineTable::createNamedTbl

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse cmd and create table definition

  <cmd> job[] tableDef::parse locals| pTableDef |

  // check for error while parsing tabledef
  job[] job.hasError if
    DdlLock[].testDrop
    !!logError
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  pTableDef <tableNm> table::createTable locals| pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* check resources for Job_defineTable                                        */
/*----------------------------------------------------------------------------*/
: defineTable::checkResources

  // grab the ddl lock
  DdlLock[].grabRead

  // check there are enough buffers
  node::checkEnoughBuffers not if ( errorCode )
    job::error!
    !!logError
    exit
  then

  // check ok to create table
  defineTable::checkCreate not if ( errorCode )
    job::error!
    !!logError
    exit
  then

  // drop the ddl lock
  //DdlLock[].dropRead
;

/*----------------------------------------------------------------------------*/
/* execute Job_defineTable on origin                                          */
/*----------------------------------------------------------------------------*/
: defineTable_req _eeh ( -- )

  // check create table syntax
  <cmd> TableDef::syntax dup EC_NONE != if  ( errorCode )
    job::error!
    !!logError
  else
    discard
  then

  defineTable::checkResources

  // should be in tables
  folder[].isTables assert

  // create the table
  defineTable::createNamedTbl

  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/*                              - Definition -                                */
/*----------------------------------------------------------------------------*/
cmdSyntax: defineTable :: define table <tableNm> etc ;

: defineTable _cmdTags
  tags{
    <cmdDesc>  = "--cmd desc for job--"
    
    <axiomOp>  = 1
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_LOCAL_RESPONSE
    <ddlLock>  = DL_GRAB_WRITE
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
