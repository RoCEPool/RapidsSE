/*============================================================================*/
/* job_CreateIndex.sen -- Job Create Index                                    */
/*============================================================================*/

" job_CreateIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> . <indexNm> is a creatable index                        */
/*----------------------------------------------------------------------------*/
: createIndex::checkCreate ( --  true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  folder[].checkIsTables not if false exit then

  // check there is a sub-folder by the name of the table
  //   ../schemas/public/tables/t
  <tableNm> folder[].checkNamedTableFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if max indexes already on table

  // push into t: ../schemas/public/tables/t \folder
  <tableNm> path[].pushNamedTableFolder assert

  // check max indexes
  <tableNm> find execute locals| pTable |
  pTable table.indexCount C_MAX_INDEXES == if
    EC_MAX_INDEXES
    path[].popNamedTableFolder
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check name doesn't already exist

  // push into indexes: ../schemas/public/tables/t/indexes
  path[].pushIndexesFolder assert
  folder[].isIndexes assert

  // error if given name already exists
  <indexNm> name::isNotKnownIndex not if
    path[].popIndexesFolder
    path[].popNamedTableFolder
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop upto tables: ../schemas/public/tables

  path[].popIndexesFolder
  path[].popNamedTableFolder
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* create index <tableNm> . <indexNm> on this particpating node               */
/*----------------------------------------------------------------------------*/
: createIndex::createNamedIndex

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // change working folder to : ./t/indexes

  // cf to: ./t
  <tableNm> path[].pushNamedTableFolder assert

  // cf to: ./indexes
  path[].pushIndexesFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse cmd and create index definition

  <tableNm> find execute locals| pTable |

  <cmd> pTable job[] IndexDef::parse locals| pIndexDef |

  // check for error while parsing indexdef
  job[] job.hasError if
    DdlLock[].testDrop
    !!logError
    path[].popIndexesFolder
    path[].popNamedTableFolder
    folder[].isTables assert
    exit
  then

//dbg>

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the index proper

  pIndexDef <indexNm> pTable index::createIndex locals| pIndex |
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // validate the unqiue index columns are a subset of the partition keys

  pIndex index.isUnique@ if
    pIndex index.isValidUniqueIndex not if
      EC_INVALID_COLUMNS_UNIQUE_INDEX job::error!
      path[].popIndexesFolder
      path[].popNamedTableFolder
      folder[].isTables assert
      exit
    then
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // populate the index

  pIndex index.populate not if ( errorCode )
    job::error!
    path[].popIndexesFolder
    path[].popNamedTableFolder
    folder[].isTables assert
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // move back to ./tables

  path[].popIndexesFolder
  path[].popNamedTableFolder
  folder[].isTables assert
;
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* check resources for Job_CreateIndex on this participating node             */
/*----------------------------------------------------------------------------*/
: createIndex::checkResources _eeh

  // grab the ddl lock
  DdlLock[].grabRead

  // check there are enough buffers
  node::checkEnoughBuffers not if ( errorCode )
    job::error!
    !!logError
    exit
  then

  // check ok to create index
  createIndex::checkCreate not if ( errorCode )
    job::error!
    !!logError
    exit
  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateIndex on this participating node                         */
/*----------------------------------------------------------------------------*/
: createIndex::execute _eeh ( -- )

  // should be in tables
  folder[].isTables assert

  // create the index
  createIndex::createNamedIndex

  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/* request originating node to execute Job_CreateIndex across the grid        */
/*----------------------------------------------------------------------------*/
: createIndex::request _eeh ( -- <R> )

  // check create index syntax
  <cmd> IndexDef::syntax dup EC_NONE != if ( errorCode )
    job::error!
    !!logError
  else
    discard
  then
;

/*----------------------------------------------------------------------------*/
/*                             - Definition -                                 */
/*----------------------------------------------------------------------------*/
cmdSyntax: createIndex :: create index <indexNm> on <tableNm> etc ;
cmdSyntax: createIndex :: create unique index <indexNm> on <tableNm> etc ;

: createIndex _info tags{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
