/*============================================================================*/
/* job_CreateIndex.sen -- Job Create Index                                    */
/*============================================================================*/

" job_CreateIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: checkIsNotIndex ( "<word>" )

  findInCurrent not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable index                                          */
/*----------------------------------------------------------------------------*/
: checkMakeIndex ( Job_CreateIndex --  true | errorCode false )

  params| pJob_CreateIndex |
  0 0 0 locals| sTableNm sIndexNm pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  pJob_CreateIndex job.indexName@ to sIndexNm
  pJob_CreateIndex job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check in tables folder
  checkInTables not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check there is a table folder
  sTableNm checkIsTableFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if max indexes already on table
  sTableNm find execute to pTable
  pTable table.indexCount
  C_INDEXES_PER_TABLE == if EC_MAX_INDEXES popTable assertInTables false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check index already exists
  sIndexNm checkIsNotIndex not if popIndexes popTable assertInTables false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if index columns are valid
  pJob_CreateIndex pTable table.isValidIndexColumns not if
    popIndexes popTable assertInTables EC_INVALID_INDEX_COLUMN false
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  popTable

  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* make an index (run by all participants)                                     */
/*----------------------------------------------------------------------------*/
: makeIndex ( Job_CreateIndex -- <R> )

  params| pJob_CreateIndex |
  0 0 0 0 locals| pTable pIndex sTableNm sIndexNm |

  pJob_CreateIndex job.indexName@ to sIndexNm
  pJob_CreateIndex job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the index
  sIndexNm :index drop

  // find the index
  sIndexNm find execute to pIndex

  // find the table
  sTableNm find execute to pTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the table in the index
  pTable pIndex index.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // add the index in the table
  pIndex pTable table.addIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // mark index as unique
  pJob_CreateIndex job_createIndex.isUnique@ pIndex index.isUnique!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the column vector of the index
  pJob_CreateIndex pIndex index.createColumnVec

  // validate the unqiue index columns are a subset of the partition keys
  pIndex index.isUnique@ if
    pIndex index.isValidUniqueIndex
    not if EC_INVALID_COLUMNS_UNIQUE_INDEX pJob_CreateIndex <ERROR_JOB>
      popIndexes popTable exit
    then
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set if single column
  pIndex index.setSingleColumn

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // now populate the index
  pIndex index.populate
  not if pJob_CreateIndex <ERROR_JOB> popIndexes popTable
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  popTable
;

/*----------------------------------------------------------------------------*/
/* Job_CreateIndex request (on originating node)                              */
/*----------------------------------------------------------------------------*/
: createIndex_req (  -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: createIndex_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateIndex job on each node                                   */
/*----------------------------------------------------------------------------*/
: createIndex_exe ( Job_CreateIndex -- )

  >>am <SEED_EXE>

  //params| pJob_CreateIndex |
  job::this locals| pJob_CreateIndex |

  0 0 locals| pTable sTableNm sIndexNm |

  tp: createIndex_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_CREATEINDEX pJob_CreateIndex object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_CreateIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the index
  pJob_CreateIndex makeIndex

  //----------------------------------------------------------------------------
  // should be in tables
  assertInTables

  pJob_CreateIndex job.notice

  pJob_CreateIndex job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateIndex job check resources                                */
/*----------------------------------------------------------------------------*/
: createIndex.checkResources ( Job_CreateIndex -- )

  >>am <Check_Resources>

  params| pJob_CreateIndex  |
  0 0 locals| sTableNm sIndexNm |

  tp: createIndex.checkResources
  //"checkResources received" .

  //----------------------------------------------------------------------------
  // grab a ddl lock
  ddlLock::grabRead

  //----------------------------------------------------------------------------
  // set task's dictionary stack from path in job
  pJob_CreateIndex job.pushPath
  task::dicStack.set

  //----------------------------------------------------------------------------
  // check if we have enough buffers
  node::checkEnoughBuffers not if pJob_CreateIndex <ERROR_JOB> !!am exit then

  //----------------------------------------------------------------------------
  // check ok to make index
  pJob_CreateIndex checkMakeIndex not if pJob_CreateIndex <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTable job release resources                              */
/*----------------------------------------------------------------------------*/
: createIndex.releaseResources ( Job_CreateIndex -- )

  >>am <Release_Resources>

  params| pJob_CreateIndex  |

  tp: createIndex.releaseResources
  //"releaseResources received" .

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: createIndex_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_createIndex |

  pJob_createIndex job.becomeParticipant

  pJob_createIndex createIndex.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: createIndex_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_createIndex |

  pJob_createIndex createIndex.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: createIndex_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_createIndex |

  // check resources
  pJob_createIndex createIndex.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
