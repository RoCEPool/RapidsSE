/*============================================================================*/
/* job_CreateIndex.sen -- Job Create Index                                    */
/*============================================================================*/

" job_CreateIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: checkIsNotIndex ( "<word>" )

  findInCurrent not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable index                                          */
/*----------------------------------------------------------------------------*/
: checkMakeIndex ( Job_CreateIndex --  true | errorCode false )

  params| pJob_CreateIndex |
  0 0 0 locals| sTableNm sIndexNm pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  <tableNm> to sTableNm
  <indexNm> to sIndexNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check in tables folder
  checkInTables not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check there is a table folder
  sTableNm checkIsTableFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if max indexes already on table
  sTableNm find execute to pTable
  pTable table.indexCount
  C_MAX_INDEXES == if EC_MAX_INDEXES popTable assertInTables false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check index already exists
  sIndexNm checkIsNotIndex not if popIndexes popTable assertInTables false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if index columns are valid
  pJob_CreateIndex pTable table.isValidIndexColumns not if
    popIndexes popTable assertInTables EC_INVALID_INDEX_COLUMN false
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  popTable

  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* make an index (run by all participants)                                     */
/*----------------------------------------------------------------------------*/
: makeIndex ( Job_CreateIndex -- <R> )

  params| pJob_CreateIndex |
  0 0 0 0 locals| pTable pIndex sTableNm sIndexNm |

  //pJob_CreateIndex job.indexName@ to sIndexNm
  //pJob_CreateIndex job.objectName@ to sTableNm
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the index
  sIndexNm :index drop

  // find the index
  sIndexNm find execute to pIndex

  // find the table
  sTableNm find execute to pTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the table in the index
  pTable pIndex index.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // add the index in the table
  pIndex pTable table.addIndex


  //!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  <cmd> pTable IndexDef::parse locals| pIndexDef |
  //!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  pIndexDef pIndex index.indexDef!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // validate the unqiue index columns are a subset of the partition keys
  pIndex index.isUnique@ if
    pIndex index.isValidUniqueIndex
    not if EC_INVALID_COLUMNS_UNIQUE_INDEX pJob_CreateIndex <ERROR_JOB>
      popIndexes popTable exit
    then
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // now populate the index
  pIndex index.populate
  not if pJob_CreateIndex <ERROR_JOB> popIndexes popTable
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes
  popIndexes

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  popTable
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateIndex job on each node                                   */
/*----------------------------------------------------------------------------*/
: createIndex::execute _eeh ( -- )

  job::this locals| pJob_CreateIndex |

  0 0 locals| pTable sTableNm sIndexNm |

  tp: createIndex_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the index
  pJob_CreateIndex makeIndex

  //----------------------------------------------------------------------------
  // should be in tables
  assertInTables

;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateIndex job check resources                                */
/*----------------------------------------------------------------------------*/
: createIndex::checkResources _eeh ( -- )

  job::this locals| pJob_CreateIndex |
  0 0 locals| sTableNm sIndexNm |

  tp: createIndex.checkResources
  //"checkResources received" .

  //----------------------------------------------------------------------------
  // grab a ddl lock
  DdlLock[].grabRead

  //----------------------------------------------------------------------------
  // check if we have enough buffers
  node::checkEnoughBuffers not if pJob_CreateIndex <ERROR_JOB> !!logError exit then

  //----------------------------------------------------------------------------
  // check ok to make index
  pJob_CreateIndex checkMakeIndex not if pJob_CreateIndex <ERROR_JOB> !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: createIndex :: create index <indexNm> on <tableNm> etc ;
jobSyntax: createIndex :: create unique index <indexNm> on <tableNm> etc ;

jobInfo: createIndex
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_CREATEINDEX
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_WRITE
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
