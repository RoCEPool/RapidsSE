/*============================================================================*/
/* job_CreateIndex.sen -- Job Create Index                                    */
/*============================================================================*/

" job_CreateIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check in indexes folder                                                    */
/*----------------------------------------------------------------------------*/
: checkIsNotIndex ( "<word>" )

  folder[].findSymbol not if true exit then
  EC_INDEX_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if <tableNm> . <indexNm> is a creatable index                        */
/*----------------------------------------------------------------------------*/
: createIndex::checkCreate ( --  true | errorCode false )

  // check in tables folder
  folder[].checkInTables not if false exit then

  // check there is a table folder
  <tableNm> folder[].checkIsTablesFolder not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // push table
  <tableNm> path[].pushNamedTableFolder assert

  // check if max indexes already on table
  <tableNm> find execute locals| pTable |
  pTable table.indexCount
  C_MAX_INDEXES == if
    EC_MAX_INDEXES
    path[].discardTableFolder
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // push indexes
  path[].pushIndexesFolder assert

  // check if index already exists
  <indexNm> checkIsNotIndex not if
    path[].discardIndexesFolder
    path[].discardTableFolder
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // pop indexes
  path[].discardIndexesFolder

  // pop table
  path[].discardTableFolder

  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* make an index (run by all participants)                                     */
/*----------------------------------------------------------------------------*/
: createIndex::createAnIndex

  0 0 0 0 locals| pTable sTableNm sIndexNm |

  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  sIndexNm sTableNm index::make locals| pwIndexTest |

  pwIndexTest execute locals| pIndex |

  //----------------------------------------------------------------------------

  // assert starting folder is:
  // ../schemas/public/tables
  folder[].isTables assert

  // ../schemas/public/tables/t
  sTableNm path[].pushNamedTableFolder assert

  // ../schemas/public/tables/t/indexes
  path[].pushIndexesFolder assert

  // find the table upwards in the path
  sTableNm find execute to pTable

  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  <cmd> pTable job[] IndexDef::parse locals| pIndexDef |
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check for error while creating indexdef
  //grid::thisNode@
  job[] job.hasError if
    //pJob_CreateIndex
    DdlLock[].testDrop
    !!logError
    sIndexNm :forget
    path[].discardIndexesFolder
    path[].discardTableFolder
    folder[].isTables assert
    exit
  then

//dbg>

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the table in the index
  pTable pIndex index.table!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // add the index in the table
  pIndex pTable table.addIndex

  pIndexDef pIndex index.indexDef!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // validate the unqiue index columns are a subset of the partition keys
  pIndex index.isUnique@ if
    pIndex index.isValidUniqueIndex
    not if EC_INVALID_COLUMNS_UNIQUE_INDEX job[] ERROR_JOB
      path[].discardIndexesFolder
      path[].discardTableFolder
      folder[].isTables assert
      exit
    then
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // now populate the index
  pIndex index.populate
  not if job[]
    ERROR_JOB
    path[].discardIndexesFolder
    path[].discardTableFolder
    folder[].isTables assert
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  path[].discardIndexesFolder
  path[].discardTableFolder
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute Job_CreateIndex job check resources                                */
/*----------------------------------------------------------------------------*/
: createIndex::checkResources _eeh

  // grab the ddl lock
  DdlLock[].grabRead

  // check if we have enough buffers
  node::checkEnoughBuffers not if
    job[] ERROR_JOB !!logError
    exit
  then

  // check ok to make index
  createIndex::checkCreate not if
    job[] ERROR_JOB !!logError
    exit
  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateIndex job on each node                                   */
/*----------------------------------------------------------------------------*/
: createIndex::execute _eeh ( -- )

  // should be in tables
  folder[].isTables assert

  // create the index
  createIndex::createAnIndex

  // should be in tables
  folder[].isTables assert
;

/*----------------------------------------------------------------------------*/
/* create index request (on originating node)                                 */
/*----------------------------------------------------------------------------*/
: createIndex::request _eeh ( -- <R> )

  // check create index syntax
  <cmd> IndexDef::syntax dup EC_NONE != if
    job[] ERROR_JOB !!logError
  else
    discard
  then
;

/*----------------------------------------------------------------------------*/
/*                             - Definition -                                 */
/*----------------------------------------------------------------------------*/
cmdSyntax: createIndex :: create index <indexNm> on <tableNm> etc ;
cmdSyntax: createIndex :: create unique index <indexNm> on <tableNm> etc ;

: createIndex _info tags{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
