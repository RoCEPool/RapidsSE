/*============================================================================*/
/* operator.sen -- operator modifier                                          */
/*============================================================================*/

"operator.sen" .verbose

/*----------------------------------------------------------------------------*/
/* operator kind                                                              */
/*----------------------------------------------------------------------------*/
: opKind ;

/*----------------------------------------------------------------------------*/
/* set the word currently being compiled to be an opKind                      */
/*----------------------------------------------------------------------------*/
: operator immediate

  ' opKind word.this word.kind!
;

/*----------------------------------------------------------------------------*/
/* the op queues                                                              */
/*----------------------------------------------------------------------------*/
queue: scanOp_Queue
queue: sinkOp_Queue
queue: writeOp_Queue

/*----------------------------------------------------------------------------*/
/* compile the plan                                                           */
/*----------------------------------------------------------------------------*/
: compilePlan ( plan -- )

  dup ( plan plan )

  plan.dic task.this task.dicStack dicPath.push ( plan )
  plan.lambda@ >:
  task.this task.dicStack dicPath.drop
;

/*----------------------------------------------------------------------------*/
/* symbolic plan arguments                                                    */
/*----------------------------------------------------------------------------*/

//FIRST VARIATION:

/*
?*----------------------------------------------------------------------------*?
?* tableName                                                                  *?
?*----------------------------------------------------------------------------*?
  : arg$tableNm "arg$tableNm" find execute ;

?*----------------------------------------------------------------------------*?
?* set the tableName from the plan                                            *?
?*----------------------------------------------------------------------------*?
: tableName!! ( plan value -- )
  ": arg$tableNm \"%v\"; " str.format
  swap
  plan.lambda+
;

?*----------------------------------------------------------------------------*?
?* get the tableName from the plan                                            *?
?*----------------------------------------------------------------------------*?
: tableName@@ ( plan -- )
  arg$tableNm find execute
;

 ?*----------------------------------------------------------------------------*?
 ?* fileName                                                                   *?
 ?*----------------------------------------------------------------------------*?
 : arg$fileNm  "arg$fileNm"  find execute ;
 
 ?*----------------------------------------------------------------------------*?
 ?* set the fileName from the plan                                             *?
 ?*----------------------------------------------------------------------------*?
 : fileName! ( plan value -- )
   ": arg$fileNm \"%v\"; " str.format
   swap
   plan.lambda+
 ;
 
 ?*----------------------------------------------------------------------------*?
 ?* get the fileName from the plan                                             *?
 ?*----------------------------------------------------------------------------*?
 : fileName@ ( plan -- )
   arg$fileNm find execute
 ;
 
*/

//SECOND VARIATION:
: tableName2 indirect ( plan -- ) ;
: fileName2  indirect ( plan -- ) ;
: nextQueue2 indirect ( plan -- ) ;
: nextOp2    indirect ( plan -- ) ;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
