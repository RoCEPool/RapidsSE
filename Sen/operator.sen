/*============================================================================*/
/* operator.sen -- operator modifier                                          */
/*============================================================================*/

"operator.sen" .verbose

/*----------------------------------------------------------------------------*/
/* operator kind                                                              */
/*----------------------------------------------------------------------------*/
: opKind ;

/*----------------------------------------------------------------------------*/
/* set the word currently being compiled to be an opKind                      */
/*----------------------------------------------------------------------------*/
: operator immediate

  ' opKind word.this word.kind!
;

/*----------------------------------------------------------------------------*/
/* define a symbolic argument                                                 */
/*----------------------------------------------------------------------------*/
: symArg:

  // create a word in the dic which is on top of path stack
  // using the next token in the compile stream as its name
  // this new word becomes the current word
  create

  // push the name of the word
  word.this word.name

  // append the name of the word as a pushValue in the symbolic arg
  encodePushValue

  ' find compile,
  ' execute compile,
  ' exit compile,
;

/*----------------------------------------------------------------------------*/
/* pipe to job queue on same node                                             */
/*----------------------------------------------------------------------------*/
: >>jobQueue_sameNode ( << [ rb true | false ] profile plan op.task -- )

  "same node" .

  locals| op.task | ( << [ rb true | false ] profile plan )

  >>

  // find and put onto jobqueue

  op.task find execute >jobqueue
;

/*----------------------------------------------------------------------------*/
/* pipe to job queue on other node                                            */
/*----------------------------------------------------------------------------*/
: >>jobQueue_otherNode ( << [ rb true | false ] profile plan op.task -- )

  "other node" .

  locals| op.task | ( << [ rb true | false ] profile plan )

  >>

  // find and put onto jobqueue

  op.task find execute >jobqueue
;

/*----------------------------------------------------------------------------*/
/* network aware pipe                                                         */
/*----------------------------------------------------------------------------*/
: >>jobQueue ( << [ rb true | false ] profile plan op.task -- )

  // << false profile plan op.task

  // record the op.task
  locals| op.task | ( << [ rb true | false ] profile plan )

  // partition
  0 0 "" locals| profile partitionId nodeNo |

  // the profile contains partition information
  over to profile

  profile str.tailInt
  if
    // profile has a #partitionId

    to partitionId
    partitionId grid::toNode to nodeNo

    nodeNo partitionId profile "Profile %v: partition %v on node %v" str.format .

    nodeNo grid.thisNode@ ==
    if
      op.task >>jobQueue_sameNode
    else
      op.task >>jobQueue_otherNode
    then

  else
    // profile is # only

    profile "Profile %v: on originating node" str.format .

    grid.thisNode@ 0==
    if
      op.task >>jobQueue_sameNode
    else
      op.task >>jobQueue_otherNode
    then

  then
;

/*----------------------------------------------------------------------------*/
/* the op queues                                                              */
/*----------------------------------------------------------------------------*/
queue: scanOp_Queue
queue: sinkOp_Queue
queue: writeOp_Queue

/*----------------------------------------------------------------------------*/
/* compile the plan                                                           */
/*----------------------------------------------------------------------------*/
: compilePlan ( plan -- )

  dup task.this task.plan!

  dup ( plan plan )

  plan.dic task.this task.dicStack dicPath.push ( plan )
  pathDump
  plan.lambda@ dup . >:
  task.this task.dicStack dicPath.drop

  0 task.this task.plan!
;

/*----------------------------------------------------------------------------*/
/* execute the plan                                                           */
/*----------------------------------------------------------------------------*/
: executePlan ( plan -- )

  // record the plan and profile
  locals| thePlan profile |

  // trigger triggerOp by piping the plan to it
  //<< "triggerOp" thePlan >>
  //"triggerOp.task" find execute >jobQueue

  << "triggerOp" thePlan "triggerOp.task" >>jobQueue
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
