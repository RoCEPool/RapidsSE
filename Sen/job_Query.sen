/*============================================================================*/
/* job_Query.sen -- Job Query                                                 */
/*============================================================================*/

" job_Query.sen" .verbose

/*----------------------------------------------------------------------------*/
/* query command request                                                      */
/*----------------------------------------------------------------------------*/
: query_req ( -- <R> )

  >>am <SEED_REQ>

  100 apiState::senLoc

  ": query_req" .

  task::this      locals| pTask |
  pTask task.job@ locals| pJob_Query |
  0               locals| sTableNm |
  0               locals| pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set dic stack
  pJob_Query job.pushPath task::dicStack.set

  // grab a ddl lock
  ddlLock::grabRead

  // get table name
  pJob_Query job.objectName@ to sTableNm

  // find table
  sTableNm pushTable assert
  sTableNm find execute to pTable
  pTable pJob_Query jobMark2.table!

  popIndexes
  popTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_Query job_query.begin
  pJob_Query job_query.end
  pJob_Query job_query.execute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ": query_req SLEEP" .

  10000 task::sleepSsec

  ": query_req END" .

  900 apiState::senLoc

  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
