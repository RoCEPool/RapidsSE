/*============================================================================*/
/* threadQueue.sen -- thread queue related words                              */
/*============================================================================*/

"threadQueue.sen" .verbose

: threadQueue:

  create
  WT_OBJECT word.this word.type!
  sizeof_threadQueue allot
  word.this >body object.magic!
  CN_THREADQUEUE word.this >body object.class!
  word.this >body threadQueue.init
  true word.this >body object.wordbody!
  does> 
;

: :threadQueue

  >create
  WT_OBJECT word.this word.type!
  sizeof_threadQueue allot
  word.this >body object.magic!
  CN_THREADQUEUE word.this >body object.class!
  word.this >body threadQueue.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
