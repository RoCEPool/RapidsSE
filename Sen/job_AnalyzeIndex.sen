/*============================================================================*/
/* job_AnalyzeIndex.sen -- Job Analyze Index                                  */
/*============================================================================*/

" job_AnalyzeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a analyzable table folder                                 */
/*----------------------------------------------------------------------------*/
: checkAnalyzeIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then

  // push indexes folder
  pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
    popIndexes popTable                                            // ../tables
    assertInTables false exit
  then

  //pop indexes folder
  popIndexes

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* anakyze index request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: analyzeIndex_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 0 locals| pJob pTask bIsDetailed |

  tp: analyzeIndex

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  pJob jobAnalyzeIndex.isDetailed to bIsDetailed

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    bIsDetailed 1 == if
      "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, bufferLevel VARCHAR, entries INTEGER)"
    else
      "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, entries INTEGER)"
    then
    pJob job.metadata!

  then

  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeIndex job on a node                                     */
/*----------------------------------------------------------------------------*/
: analyzeIndex_exe ( Job_AnalyzeIndex -- )

  >>am <SEED_EXE>

  //params| pJob_AnalyzeIndex |
  job::this locals| pJob_AnalyzeIndex |

  0 0 locals| sTableNm bIsDetailed |

  tp: analyzeIndex_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_ANALYZEINDEX pJob_AnalyzeIndex object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_AnalyzeIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  pJob_AnalyzeIndex job.objectName@ to sTableNm
  sTableNm pushTable assert

  //
  // push indexes
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // analyze the table
  pJob_AnalyzeIndex jobAnalyzeIndex.isDetailed to bIsDetailed
  bIsDetailed
  pJob_AnalyzeIndex job.indexName@ find execute
  index.analyze

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // put response in the job
  grid::thisNode@ pJob_AnalyzeIndex job.response!
  grid::slots grid::thisNode@ pJob_AnalyzeIndex job.rowsProcessed!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  popTable

  pJob_AnalyzeIndex job.notice

  pJob_AnalyzeIndex send_job__executed

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeIndex job check resources                               */
/*----------------------------------------------------------------------------*/
: analyzeIndex.checkResources ( Job_AnalyzeIndex -- )

  >>am <Check_Resources>

  params| pJob_AnalyzeIndex  |

  tp: analyzeIndex.checkResources
  //"checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_AnalyzeIndex job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  pJob_AnalyzeIndex job.objectName@
  pJob_AnalyzeIndex job.indexName@
  checkAnalyzeIndex not if pJob_AnalyzeIndex <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeIndex job release resources                             */
/*----------------------------------------------------------------------------*/
: analyzeIndex.releaseResources ( Job_AnalyzeIndex -- )

  >>am <Release_Resources>

  params| pJob_AnalyzeIndex  |

  tp: analyzeIndex.releaseResources
  //"releaseResources received" .

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: analyzeIndex_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_analyzeIndex |

  pJob_analyzeIndex job.beginParticipant

  // check resources
  pJob_analyzeIndex analyzeIndex.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: analyzeIndex_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_analyzeIndex |

  pJob_analyzeIndex analyzeIndex.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: analyzeIndex_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_analyzeIndex |

  pJob_analyzeIndex analyzeIndex.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
