/*============================================================================*/
/* job_AnalyzeIndex.sen -- Job Analyze Index                                  */
/*============================================================================*/

" job_AnalyzeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a analyzable table folder                                 */
/*----------------------------------------------------------------------------*/
: checkAnalyzeIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushTable assert

  sTableNm checkIsTable not if path[].popTable false exit then

  // push indexes folder
  path[].pushIndexes assert                               // ../tables/sTableNm/indexes

  sIndexNm checkIsIndex not if
    path[].popIndexes path[].popTable                                            // ../tables
    assertInTables false exit
  then

  //pop indexes folder
  path[].popIndexes

  // pop table folder
  path[].popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* analyze index request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: analyzeIndex::request _eeh ( -- <R> )

  "<detailed>" job[] job.enameset@ enameset.hasName not if

    "<detailed>" "0" job[] job.enameset@ enameSet.insertStr
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    <detailed> >int 1 == if
      "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, bufferLevel VARCHAR, entries INTEGER)"
    else
      "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, entries INTEGER)"
    then
    job[] job.metadata!

  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeIndex job on a node                                     */
/*----------------------------------------------------------------------------*/
: analyzeIndex::execute _eeh ( -- )


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  <tableNm> path[].pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes
  path[].pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // analyze the table
  <detailed> >int <indexNm> find execute index.analyze

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // put response in the job
  job[] job.response!
  grid::slots job[] job.rowsProcessed!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  path[].popTable
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeIndex job check resources                               */
/*----------------------------------------------------------------------------*/
: analyzeIndex::checkResources _eeh ( -- )

  //"checkResources received" .

  "<detailed>" job[] job.enameset@ enameset.hasName not if

    "<detailed>" "0" job[] job.enameset@ enameSet.insertStr
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  <tableNm>
  <indexNm> 
  checkAnalyzeIndex not if job[] ERROR_JOB !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: analyzeIndex :: analyzeIndex <tableNm> <indexNm> ;
jobSyntax: analyzeIndex :: analyzeIndex <tableNm> <indexNm> <detailed> ;
jobSyntax: analyzeIndex :: anidx <tableNm> <indexNm> ;
jobSyntax: analyzeIndex :: anidx <tableNm> <indexNm> <detailed> ;

jobInfo: analyzeIndex
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
