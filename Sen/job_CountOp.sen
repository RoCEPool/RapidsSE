/*============================================================================*/
/* job_CountOp.sen -- Job CountOp                                               */
/*============================================================================*/

" job_CountOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Count_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_CountOp |

   tp: CountOp_run

   pJob_CountOp job.opLoop

   //pJob_CountOp job::participantExecuted

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: Count :: Count ;

jobInfo: Count
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
