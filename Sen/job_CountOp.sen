/*============================================================================*/
/* job_CountOp.sen -- Job CountOp                                               */
/*============================================================================*/

" job_CountOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for countOp                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : CountOp_req ( -- )
 
  >>logEntry <SEED_REQ>
  job::this locals| pJob_CountOp |
  0 locals| nCount |

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

    ZK_CRWBUFFER of
      "Operand:- ZK_CRWBUFFER" .
      nCount Operand[].rowCount@ + to nCount
      true
    endof

    ZK_CSVBUFFER of
      "Operand:- ZK_CSVBUFFER" .
      nCount Operand[].itemCount@ + to nCount
      true
    endof

    ZK_ENDMARKER of
      "Operand:- ZK_ENDMARKER" .
      nCount Operand[].handleAggEnd
      false
    endof

    ZK_ENTBUFFER of
      "Operand:- ZK_ENTBUFFER" .
      nCount Operand[].itemCount@ + to nCount
      true
    endof

    ZK_IRWBUFFER of
      "Operand:- ZK_IRWBUFFER" .
      nCount Operand[].itemCount@ + to nCount
      true
    endof

    ZK_SRTBUFFER of
      "Operand:- ZK_SRTBUFFER" .
      nCount Operand[].itemCount@ + to nCount
      true
    endof

    ZK_STREAMDEF of
      "Operand:- ZK_STREAMDEF" .
      Operand[].delete
      true
    endof

    endcase

    while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: CountOp :: CountOp ;

jobInfo: CountOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_COUNTOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
