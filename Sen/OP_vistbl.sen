/*============================================================================*/
/* OP_vistbl.sen -- Operator visualize table                                  */
/*============================================================================*/

" OP_vistbl.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: vistbl_action

  <tableNm> op__table if
    table[].visualize
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: vistbl :: vistbl <tableNm> ;

: vistbl opInfo tagCopy: localLiteOp_tags
  tags{
    <jobDesc>     = "--description of operator--"
    <localLiteOp> = true
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
