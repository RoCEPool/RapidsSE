/*============================================================================*/
/* job_SizeIndex.sen -- Job Size Table                                        */
/*============================================================================*/

" job_SizeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid index                                             */
/*----------------------------------------------------------------------------*/
: checkSizeIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeIndex job on a node                                        */
/*----------------------------------------------------------------------------*/
: sizeIndex::execute _eeh ( -- )

  //params| pJob_SizeIndex |
  job::this locals| pJob_SizeIndex |

  0 0 0 0 locals| pIndex iSize sTableNm sIndexNm |

  tp: sizeIndex_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table and indexes folder
  sTableNm pushTable assert
  pushIndexes assert

  sIndexNm find execute to pIndex
  pIndex index.space 0 swap number.magnitude to iSize

  iSize grid::thisNodeName@ "row: ('%v' %v)" str.format

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  pJob_SizeIndex job.response!
  1 pJob_SizeIndex job.rowsProcessed!
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeIndex job check resources                                  */
/*----------------------------------------------------------------------------*/
: sizeIndex::checkResources _eeh ( -- )

  0 0 locals| sIndexNm sTableNm |

  tp: sizeIndex.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  sTableNm sIndexNm checkSizeIndex not if job::this <ERROR_JOB> !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: sizeIndex :: sizeIndex <tableNm> <indexNm> ;
jobSyntax: sizeIndex :: szIdx <tableNm> <indexNm> ;

jobInfo: sizeIndex
{
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
