/*============================================================================*/
/* job_SizeIndex.sen -- Job Size Table                                        */
/*============================================================================*/

" job_SizeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid index                                             */
/*----------------------------------------------------------------------------*/
: checkSizeIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  folder[].checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm word::isKnown not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm path[].pushTableFolder assert

  sTableNm name::checkIsTable not if
    path[].discardTableFolder
    false exit
  then
  //sTableNm tableInUse if path[].discardTableFolder EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  path[].pushIndexesFolder assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm name::checkIsIndex not if
    path[].discardIndexesFolder
    path[].discardTableFolder
    folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  path[].discardIndexesFolder
  path[].discardTableFolder

  // assert in tables
  folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* size index request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: sizeIndex::request _eeh ( -- <R> )

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(nodeName VARCHAR, size VARCHAR)"
  job[] job.metadata!

  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeIndex job on a node                                        */
/*----------------------------------------------------------------------------*/
: sizeIndex::execute _eeh ( -- )

  <indexNm> <tableNm> index::size locals| iSize |

  0 iSize number.magnitude >str locals| sSize |

  sSize grid::thisNodeName@ "row: ('%v', '%v')" str.format
    job[] job.response!

  1 job[] job.rowsProcessed!
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeIndex job check resources                                  */
/*----------------------------------------------------------------------------*/
: sizeIndex::checkResources _eeh ( -- )

  0 0 locals| sIndexNm sTableNm |

  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  <indexNm> to sIndexNm
  <tableNm> to sTableNm

  sTableNm sIndexNm checkSizeIndex not if job[] ERROR_JOB !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: sizeIndex :: sizeIndex <tableNm> <indexNm> ;
jobSyntax: sizeIndex :: szIdx <tableNm> <indexNm> ;

jobInfo: sizeIndex
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
