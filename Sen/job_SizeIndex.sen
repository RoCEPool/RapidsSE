/*============================================================================*/
/* job_SizeIndex.sen -- Job Size Table                                        */
/*============================================================================*/

" job_SizeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid index                                             */
/*----------------------------------------------------------------------------*/
: checkSizeIndex ( "<tableNm>" "<indexNm>" -- true | errorCode false )

  params| sIndexNm sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWordR35 not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTableR35 not if popTable false exit then
  sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push indexes folder
  pushIndexes assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is an index we are dropping
  sIndexNm checkIsIndex not if
    popIndexes popTable assertInTables false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* size index request (on originating node)                                   */
/*----------------------------------------------------------------------------*/
: sizeIndex_req ( -- <R> )

  0 0 locals| pJob pTask |

  tp: sizeIndex
  "sizeIndex_req" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(nodeName VARCHAR, size VARCHAR)" 
    pJob job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pTask pJob "job::distribute" find execute

  pJob <DONE_REQUEST>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeIndex job on a node                                        */
/*----------------------------------------------------------------------------*/
: sizeIndex_exe ( Job_SizeIndex -- )

  //params| pJob_SizeIndex |
  job::this locals| pJob_SizeIndex |

  0 0 0 0 locals| pIndex iSize sTableNm sIndexNm |

  tp: sizeIndex_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert correct job
  CN_JOB_SIZEINDEX pJob_SizeIndex object.assertClass

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grad a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_SizeIndex getPathR35
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the table and index names
  pJob_SizeIndex job.indexName@ to sIndexNm
  pJob_SizeIndex job.objectName@ to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table and indexes folder
  sTableNm pushTable assert
  pushIndexes assert

  sIndexNm find execute to pIndex
  pIndex index.space 0 swap number.magnitude to iSize

  iSize grid::thisNodeName@ "row: ( %v %v )" str.format

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop indexes and table folder
  popIndexes
  popTable

  grid::thisNode@ pJob_SizeIndex job.response!
  1 grid::thisNode@ pJob_SizeIndex job.rowsProcessed!

  pJob_SizeIndex job.notice

  pJob_SizeIndex send_job__executed

  nullptr task::this task.job!

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeIndex job check resources                                  */
/*----------------------------------------------------------------------------*/
: sizeIndex.checkResources ( Job_SizeIndex -- )

  params| pJob_SizeIndex  |
  0 0 locals| sIndexNm sTableNm |

  tp: sizeIndex.checkResources
  "checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_SizeIndex getPathR35
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get index and table name
  pJob_SizeIndex job.indexName@ to sIndexNm
  pJob_SizeIndex job.objectName@ to sTableNm

  sTableNm sIndexNm checkSizeIndex not if pJob_SizeIndex <ERROR_JOB> exit then

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_SizeTable job release resources                                */
/*----------------------------------------------------------------------------*/
: sizeIndex.releaseResources ( Job_SizeIndex -- )

  params| pJob_SizeIndex  |

  tp: sizeIndex.releaseResources
  "releaseResources received" .

  <DONE_NODE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: sizeIndex_beg ( -- )

  job::this locals| pJob_sizeIndex |

  pJob_sizeIndex job.beginParticipant

  // check resources
  pJob_sizeIndex sizeIndex.checkResources

  job::participantBegun
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: sizeIndex_end ( -- )

  job::this locals| pJob_sizeIndex |

  pJob_sizeIndex sizeIndex.releaseResources

  job::participantEnded
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: sizeIndex_can ( -- )

  job::this locals| pJob_sizeIndex |

  pJob_sizeIndex sizeIndex.releaseResources

  job::participantCancelled
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
