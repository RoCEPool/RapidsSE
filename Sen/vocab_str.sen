/*============================================================================*/
/* vocab_str.sen -- additional str words                                      */
/*============================================================================*/

" vocab_str.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .isMetaToken ( str -- t|f )

  dup 1 swap str.left  "<" str.equal not if drop false exit_rt then

  1 swap str.right ">" str.equal not if false exit_rt then

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .isJsonToken ( str -- t|f )

  "{name:value}" str.equal
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
