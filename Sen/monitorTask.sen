/*============================================================================*/
/* monitorTask.sen -- monitor task                                            */
/*============================================================================*/

"monitorTask.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

lock:    zMonitorLock

str:     sMonitorString

"pMonitorTaskSet" :taskSet drop

"pMonitorThread" :thread drop

/*----------------------------------------------------------------------------*/
/* start the monitor task                                                     */
/*----------------------------------------------------------------------------*/
: monitorStart

/*
  0 "mon.loop" nullPtr task::new pMonitorTaskSet taskSet.Append

  pMonitorTaskSet  pMonitorThread thread.taskset!

  "pMonitorThread" pMonitorThread thread.name!
                   pMonitorThread thread.spawn_actor
*/

  0 "mon.loop" nullptr "MonitorActor" spawnActorTask drop
;

/*----------------------------------------------------------------------------*/
/* monitor task loop                                                          */
/*----------------------------------------------------------------------------*/
: mon.loop

  "monitorTask" task::this task.name!

  "" sMonitorString !

  monitorTaskPrint if "Monitor Task running..." . then

  begin

    zMonitorLock lock.grabWrite

      "freespace " bp::freeSpace >str str.cat

      " queries " str.cat

      queryCount @ >str str.cat

      sMonitorString !

    zMonitorLock lock.dropWrite

    // sMonitorString @ .

    monitorTaskPrint if bp::analyze then

  10 thread.sleep_s


  again
;

/*----------------------------------------------------------------------------*/
/* get monitor string                                                         */
/*----------------------------------------------------------------------------*/

: MonitorString@

  zMonitorLock lock.grabRead

    sMonitorString @

  zMonitorLock lock.dropRead
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
