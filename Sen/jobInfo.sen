/*============================================================================*/
/* jobInfo.sen -- Job Info Compiler                                           */
/*============================================================================*/

" jobInfo.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: findJobClassEnmSet ( sJobNm -- pEnameSet )

  params| sJobNm |

  sJobNm "_cls" str.cat find word.EnameSet@
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedExists?

  word::name_trunc swap str.cat
    find if true else false then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedEnameAdd params| sSuffix sSeedEname |

  compiler::current word.EnameSet@ locals| pEnameSet |

  sSuffix seedExists?
    if word::name_trunc else "defaultSeed" then
      sSuffix str.cat  locals| pWordName |

  sSeedEname pWordName pEnameSet EnameSet.addStr
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .fillEnameSet_dist

  "SeedReq" "_req" seedEnameAdd

  "SeedRcv" "_beg" seedEnameAdd

  "SeedExe" "_exe" seedEnameAdd

  "SeedEnd" "_end" seedEnameAdd

  "SeedCan" "_can" seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* populate the JobInfo ename-set with the names of the seeds for the job     */
/* being compiled.  Use default seeds where appropropriate                    */
/*----------------------------------------------------------------------------*/
: .fillEnameSet params| pEnameSet |

  "jobPriority" pEnameSet EnameSet.hasName not if
     "jobPriority" "PY_NORMAL" pEnameSet EnameSet.addStr
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  .fillEnameSet_dist

  pEnameSet EnameSet.asStr .
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* the job info compiler                                                      */
/*----------------------------------------------------------------------------*/
: jobInfo:

  0 locals| pEnameSet |

  // create a word using next token from input source as the word name
  next-token "_cls" str.cat >create

  // set the word kind to be jobClass
  [ compiler::current , ] compiler::current word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet

  pEnameSet compiler::current word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "JobName" word::name_trunc pEnameSet EnameSet.addStr

  // skip the "{" token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    next-token
    dup "}" str.equal not
  while
    next-token drop next-token
    pEnameSet EnameSet.addStr
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // complete the ename-set

  pEnameSet EnameSet.asStr .

  pEnameSet .fillEnameSet

  pEnameSet EnameSet.asStr .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
