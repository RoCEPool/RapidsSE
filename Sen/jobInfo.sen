/*============================================================================*/
/* jobInfo.sen -- Job Info Compiler                                           */
/*============================================================================*/

" jobInfo.sen" .verbose


/*----------------------------------------------------------------------------*/
/* preliminary setup                                                          */
/*----------------------------------------------------------------------------*/
: __liteOp_SetUp

"
: /liteOp/_setup

  job[] job.enameSet@ enameSet.asStr .

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  table[] StreamDef[].new

  true
;
"
;
    
/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: __liteOp_PulseMarker

"
: /liteOp/_PulseMarker \\handler

  Pipein[].pipeout

  /liteOp/_setup  assert
  /liteOp/_action assert

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;
"
;


/*----------------------------------------------------------------------------*/
/* execute for space req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
: __liteOp_req

"
: /liteOp/_req \\operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: /liteOp/_PulseMarker  ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;
"
;


/*----------------------------------------------------------------------------*/
/* get space on each node                                                     */
/*----------------------------------------------------------------------------*/
: __liteOp_procedure

"
procedure /liteOp/
begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    /liteOp/ | stageC

  stage stageC on origin :
    output | sink | stageA

end
"
;
    

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* preliminary setup                                                          */
/*----------------------------------------------------------------------------*/
: __localLiteOp_SetUp

"
: /localLiteOp/_setup

  job[] job.enameSet@ enameSet.asStr .

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  table[] StreamDef[].new

  true
  ;
"
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: __localLiteOp_PulseMarker

"
  : /localLiteOp/_PulseMarker \\handler

    Pipein[].pipeout

    /localLiteOp/_setup  assert
    /localLiteOp/_action assert

    Operand[].newEosMarker
    Operand[].pipeOut

    true
  ;
"
;


/*----------------------------------------------------------------------------*/
/* execute for space req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
: __localLiteOp_req

"
  : /localLiteOp/_req \\operator

    LogReqEntry SEED_REQ

    op__topology

    find: /localLiteOp/_PulseMarker  ZK_PULSEMARKER op[].handler!

    op__loop

    LogReqExit
    job::deleteThis
    DONE_REQ_OP
  ;
"
;


/*----------------------------------------------------------------------------*/
/* get space on each node                                                     */
/*----------------------------------------------------------------------------*/
: __localLiteOp_procedure

"
  procedure /localLiteOp/
  begin

  stage stageA on origin :
    start | periodicOp once | /localLiteOp/ |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: findJobClassEnmSet ( sJobNm -- pEnameSet )

  params| sJobNm |

  sJobNm "_info" str.cat find word.EnameSet@
;

/*----------------------------------------------------------------------------*/
/* test if the job is a generic job                                           */
/*----------------------------------------------------------------------------*/
: job::isGenericJob params| pWord |

  pWord word.EnameSet@ locals| pEnameSet |

  "<jobKind>" pEnameSet EnameSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  JK_GENERIC
  == if
    // "job::isGenericJob - job is a generic job" .
    true
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // "job::isGenericJob - job is not a generic job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job::isLocalJob params| pWord |

  pWord word.EnameSet@ locals| pEnameSet |

  "<jobKind>" pEnameSet EnameSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  JK_LOCAL
  == if
    // "job::isLocalJob - job is a local job" .
    true
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // "job::isLocalJob - job is not a local job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job::isDistJob params| pWord |

  pWord word.EnameSet@ locals| pEnameSet |

 "<jobKind>" pEnameSet EnameSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  JK_DIST2PC
  == if
    // "job::isDistJob - job is a distributed job" .
    true
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // "job::isDistJob - job is not a distributed job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job::isServiceCmd params| pWord |

  pWord word.EnameSet@ locals| pEnameSet |

  "<cmdKind>" pEnameSet EnameSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  JK_DIST2PC
  == if
   // "job::isDistJob - job is a distributed job" .
   true
   exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // "job::isDistJob - job is not a distributed job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedExists? params| pWord sSuffix |

  pWord word.name_trunc sSuffix str.cat
    find if true else false then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedEnameAdd params| pWord sDefaultSeed sSuffix sSeedEname |

  pWord word.EnameSet@ locals| pEnameSet |

  sSuffix pWord seedExists?
    if pWord word.name_trunc else sDefaultSeed then
    sSuffix str.cat locals| pWordName |

  sSeedEname pWordName pEnameSet enameSet.insertStr
;

/*----------------------------------------------------------------------------*/
/* add default seeds for a distributed job                                    */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet_dist params| pWord |

  "<SeedReq>" "_req" "defaultSeedDist" pWord seedEnameAdd

  "<SeedRcv>" "_beg" "defaultSeedDist" pWord seedEnameAdd

  "<SeedExe>" "_exe" "defaultSeedDist" pWord seedEnameAdd

  "<SeedEnd>" "_end" "defaultSeedDist" pWord seedEnameAdd

  "<SeedCan>" "_can" "defaultSeedDist" pWord seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* add default seeds for a local job                                          */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet_local params| pWord |

  "<SeedReq>" "_req" "defaultSeedLocal" pWord seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* add default seeds for a generic job                                        */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet_generic params| pWord |

  "<SeedReq>" "_run" "defaultSeedLocal" pWord seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* populate the JobInfo ename-set with the names of the seeds for the job     */
/* being compiled.  Use default seeds where appropropriate                    */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet params| pWord |

  pWord word.name_trunc locals| sWordNm_trunc |
  pWord word.enameSet@  locals| pEnameSet |


  // default for command kind
  "<cmdKind>" pEnameSet EnameSet.hasName not if
    "<cmdKind>" "CK_COMMAND" pWord jobInfo::addEname
  then

  // default for ddl lock
  "<ddlLock>" pEnameSet EnameSet.hasName not if
    "<ddlLock>" "DL_NONE" pWord jobInfo::addEname
  then

  // default for job desc
  "<jobDesc>" pEnameSet EnameSet.hasName not if
    "<jobDesc>" "--description of job--" pWord jobInfo::addEname
  then

  // default for job kind
  "<jobKind>" pEnameSet EnameSet.hasName not if
    "<jobKind>" "JK_LOCAL" pWord jobInfo::addEname
  then

  // default for priority
  "<priority>" pEnameSet EnameSet.hasName not if
    "<priority>" "PY_NORMAL" pWord jobInfo::addEname
  then

  // default for response kind
  "<rspKind>" pEnameSet EnameSet.hasName not if
    "<rspKind>" "RS_NONE" pWord jobInfo::addEname
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pWord job::isgenericJob if
    pWord .fillOutEnameSet_generic
  else
  pWord job::isDistJob if
    pWord .fillOutEnameSet_dist
  else

    "<liteOp>" pEnameSet EnameSet.hasName if
      sWordNm_trunc "LiteOP: %v\n" .printf

      "/liteOp/" sWordNm_trunc __liteop_Setup       str.replace >interpret
      "/liteOp/" sWordNm_trunc __liteOp_PulseMarker str.replace >interpret
      "/liteOp/" sWordNm_trunc __liteOp_req         str.replace >interpret
      "/liteOp/" sWordNm_trunc __liteOp_procedure   str.replace procedure::add

    else

    "<localLiteOp>" pEnameSet EnameSet.hasName if
      sWordNm_trunc "LocalLiteOP: %v\n" .printf

      "/localLiteOp/" sWordNm_trunc __localLiteop_Setup       str.replace >interpret
      "/localLiteOp/" sWordNm_trunc __localLiteOp_PulseMarker str.replace >interpret
      "/localLiteOp/" sWordNm_trunc __localLiteOp_req         str.replace >interpret
      "/localLiteOp/" sWordNm_trunc __localLiteOp_procedure   str.replace procedure::add

    then

    pWord .fillOutEnameSet_local

  then then then

  // pEnameSet EnameSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* consume service arguments                                                  */
/*----------------------------------------------------------------------------*/
: .consumeArgs

  0 locals| nArgs |

  //".consumeArgs" .

  begin
    next-token
    dup ";&" str.equal not
  while
    nArgs 1 + to nArgs
  repeat

  // drop the ";&" from dstack
  drop

  nArgs

  // for the moment we drop the arg vector from the data stack
  dropN
;

/*----------------------------------------------------------------------------*/
/* generate two words, one which parses and another which spawns a service    */
/*----------------------------------------------------------------------------*/
: .generateService

  // calc the name of the service
  "_" compiler::current@ word.name@ str.removeSuffix locals| sServiceNm |

  // calc the name of the spawner
  sServiceNm "_spawner" str.cat locals| sSpawnerNm |


  //----------------------------------------------------------------------------
  // SPAWNER

  // create a word by the spawner name
  sSpawnerNm :create
  compiler::current@ locals| pSpawnerWd |

  // debug
  //pSpawnerWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service spawning word -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // sServiceNm , "++ this is service spawner for: %v" , POSTPONE .printf

  sServiceNm , POSTPONE job::spawnUniversal

  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pSpawnerWd word.dump


  //----------------------------------------------------------------------------
  // PARSER

  // create an immediate word by the service name

  sServiceNm :create
  compiler::current@ locals| pServiceWd |
  true pServiceWd word.immediate!

  // debug
  //pServiceWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service parsing word  -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // in : <serviceNm> add call(.printf)
  // sServiceNm , "++ this is the service parser for: %v" , POSTPONE .printf

  // in : <serviceNm> add call(.consumeArgs)
  POSTPONE .consumeArgs

  // in : <serviceNm> add code which adds call(` pSpawnerWd) in caller of service
  pSpawnerWd , POSTPONE compile,

  // in : <serviceNm> add exit
  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pServiceWd word.dump
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* the job info compiler                                                      */
/*----------------------------------------------------------------------------*/
: jobInfo:

  0 0 0 0 locals| pWord sEname sEvalue pEnameSet |

  // create a word using next token from input source as the word name
  next-token "_info" str.cat :create

  compiler::current@ to pWord

  // set the word kind to be jobClass
  [ compiler::current@ , ] pWord word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet

  pEnameSet pWord word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<jobNm>" pWord word.name_trunc pEnameSet enameSet.insertStr

  // skip the "{" token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    next-token
    dup "}" str.equal not
  while
    to sEname
    next-token drop
    next-token to sEvalue
    sEname sEvalue pWord jobInfo::addEname
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // complete the ename-set

  //pEnameSet EnameSet.asStr .

  pWord .fillOutEnameSet

  //pEnameSet EnameSet.asStr .

  pWord job::isServiceCmd if .generateService then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
