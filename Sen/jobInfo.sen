/*============================================================================*/
/* jobInfo.sen -- Job Info Compiler                                           */
/*============================================================================*/

" jobInfo.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: findJobClassEnmSet ( sJobNm -- pEnameSet )

  params| sJobNm |

  sJobNm "_cls" str.cat find word.EnameSet@
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job::isLocalJob

  "jobKind" <jobNm> findJobClassEnmSet EnameSet.getStr

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  "JK_LOCAL"
  str.equal if
    "job::isLocalJob - job is a local job" .
    true
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  "job::isLocalJob - job is not a local job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job::isDistJob

  compiler::current word.EnameSet@ locals| pEnameSet |

 "jobKind" pEnameSet EnameSet.getStr dup .

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  "JK_DIST2PC"
  str.equal if
    "job::isDistJob - job is a distributed job" .
    true
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  "job::isDistJob - job is not a distributed job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedExists?

  word::name_trunc swap str.cat
    find if true else false then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedEnameAdd params| sDefaultSeed sSuffix sSeedEname |

  compiler::current word.EnameSet@ locals| pEnameSet |

  sSuffix seedExists?
    if word::name_trunc else sDefaultSeed then
      sSuffix str.cat  locals| pWordName |

  sSeedEname pWordName pEnameSet EnameSet.addStr
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet_dist

  "SeedReq" "_req" "defaultSeedDist" seedEnameAdd

  "SeedRcv" "_beg" "defaultSeedDist" seedEnameAdd

  "SeedExe" "_exe" "defaultSeedDist" seedEnameAdd

  "SeedEnd" "_end" "defaultSeedDist" seedEnameAdd

  "SeedCan" "_can" "defaultSeedDist" seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet_local

  "SeedReq" "_req" "defaultSeedLocal" seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* populate the JobInfo ename-set with the names of the seeds for the job     */
/* being compiled.  Use default seeds where appropropriate                    */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet params| pEnameSet |

  "jobPriority" pEnameSet EnameSet.hasName not if
     "jobPriority" "PY_NORMAL" pEnameSet EnameSet.addStr
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  job::isDistJob if
    .fillOutEnameSet_dist
  else
    .fillOutEnameSet_local
  then

  pEnameSet EnameSet.asStr .
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* the job info compiler                                                      */
/*----------------------------------------------------------------------------*/
: jobInfo:

  0 0 0 locals| sEname sEvalue pEnameSet |

  // create a word using next token from input source as the word name
  next-token "_cls" str.cat >create

  // set the word kind to be jobClass
  [ compiler::current , ] compiler::current word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet

  pEnameSet compiler::current word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "JobName" word::name_trunc pEnameSet EnameSet.addStr

  // skip the "{" token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    next-token
    dup "}" str.equal not
  while
    to sEname
    next-token drop
    next-token to sEvalue
    sEname sEvalue pEnameSet EnameSet.addStr
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // complete the ename-set

  pEnameSet EnameSet.asStr .

  pEnameSet .fillOutEnameSet

  pEnameSet EnameSet.asStr .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
