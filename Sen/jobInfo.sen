/*============================================================================*/
/* jobInfo.sen -- Job Info Compiler                                           */
/*============================================================================*/

" jobInfo.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobInfo::addEname params| sEvalue sEname |

  compiler::current word.EnameSet@ locals| pEnameSet |

  sEvalue find locals| pEvalueWord |

  pEvalueWord if
    pEvalueWord word.category@ tick rootConstant eql if

      // sEvalue "  %v is a constant" fmt.print
       sEname pEvalueWord execute pEnameSet EnameSet.addInt
      exit

    then
  then

  // -- -- --
  sEname sEvalue pEnameSet EnameSet.addStr
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: findJobClassEnmSet ( sJobNm -- pEnameSet )

  params| sJobNm |

  sJobNm "_cls" str.cat find word.EnameSet@
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job::isLocalJob

  compiler::current word.EnameSet@ locals| pEnameSet |

  "<?jobKind?>" pEnameSet EnameSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  JK_LOCAL
  == if
    // "job::isLocalJob - job is a local job" .
    true
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // "job::isLocalJob - job is not a local job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job::isDistJob

  compiler::current word.EnameSet@ locals| pEnameSet |

 "<?jobKind?>" pEnameSet EnameSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  JK_DIST2PC
  == if
    // "job::isDistJob - job is a distributed job" .
    true
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // "job::isDistJob - job is not a distributed job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job::isServiceCmd

  compiler::current word.EnameSet@ locals| pEnameSet |

  "<?cmdKind?>" pEnameSet EnameSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  JK_DIST2PC
  == if
   // "job::isDistJob - job is a distributed job" .
   true
   exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // "job::isDistJob - job is not a distributed job" .
  false
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedExists?

  word::name_trunc swap str.cat
    find if true else false then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: seedEnameAdd params| sDefaultSeed sSuffix sSeedEname |

  compiler::current word.EnameSet@ locals| pEnameSet |

  sSuffix seedExists?
    if word::name_trunc else sDefaultSeed then
      sSuffix str.cat  locals| pWordName |

  sSeedEname pWordName pEnameSet EnameSet.addStr
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet_dist

  "<?SeedReq?>" "_req" "defaultSeedDist" seedEnameAdd

  "<?SeedRcv?>" "_beg" "defaultSeedDist" seedEnameAdd

  "<?SeedExe?>" "_exe" "defaultSeedDist" seedEnameAdd

  "<?SeedEnd?>" "_end" "defaultSeedDist" seedEnameAdd

  "<?SeedCan?>" "_can" "defaultSeedDist" seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet_local

  "<?SeedReq?>" "_req" "defaultSeedLocal" seedEnameAdd
;

/*----------------------------------------------------------------------------*/
/* populate the JobInfo ename-set with the names of the seeds for the job     */
/* being compiled.  Use default seeds where appropropriate                    */
/*----------------------------------------------------------------------------*/
: .fillOutEnameSet params| pEnameSet |

  // default for command kind
  "<?cmdKind?>" pEnameSet EnameSet.hasName not if
    "<?cmdKind?>" "CK_COMMAND" jobInfo::addEname
  then

  // default for ddl lock
  "<?ddlLock?>" pEnameSet EnameSet.hasName not if
    "<?ddlLock?>" "DL_NONE" jobInfo::addEname
  then

  // default for job desc
  "<?jobDesc?>" pEnameSet EnameSet.hasName not if
    "<?jobDesc?>" "--description of job--" jobInfo::addEname
  then

  // default for job kind
  "<?jobKind?>" pEnameSet EnameSet.hasName not if
    "<?jobKind?>" "JK_LOCAL" jobInfo::addEname
  then

  // default for job type
  "<?jobType?>" pEnameSet EnameSet.hasName not if
    "<?jobType?>" "JT_NONE" jobInfo::addEname
  then

  // default for priority
  "<?priority?>" pEnameSet EnameSet.hasName not if
    "<?priority?>" "PY_NORMAL" jobInfo::addEname
  then

  // default for response kind
  "<?rspKind?>" pEnameSet EnameSet.hasName not if
    "<?rspKind?>" "RS_NONE" jobInfo::addEname
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  job::isDistJob if
    .fillOutEnameSet_dist
  else
    .fillOutEnameSet_local
  then

  pEnameSet EnameSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* consume service arguments                                                  */
/*----------------------------------------------------------------------------*/
: .consumeArgs

  0 locals| nArgs |

  //".consumeArgs" .

  begin
    next-token
    dup ";&" str.equal not
  while
    nArgs 1 + to nArgs
  repeat

  // drop the ";&" from dstack
  drop

  nArgs

  // for the moment we drop the arg vector from the data stack
  dropN
;

/*----------------------------------------------------------------------------*/
/* generate two words, one which parses and another which spawns a service    */
/*----------------------------------------------------------------------------*/
: .generateService

  // calc the name of the service
  "_" compiler::current word.name@ str.removeSuffix locals| sServiceNm |

  // calc the name of the spawner
  sServiceNm "_spawner" str.cat locals| sSpawnerNm |


  //----------------------------------------------------------------------------
  // SPAWNER

  // create a word by the spawner name
  sSpawnerNm >create
  compiler::current locals| pSpawnerWd |

  // debug
  //pSpawnerWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service spawning word -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  sServiceNm , "++ this is service spawner for: %v" , POSTPONE fmt.print

  sServiceNm , POSTPONE job::spawnUniversal

  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pSpawnerWd word.dump


  //----------------------------------------------------------------------------
  // PARSER

  // create an immediate word by the service name

  sServiceNm >create
  compiler::current locals| pServiceWd |
  true pServiceWd word.immediate!

  // debug
  //pServiceWd word.dump

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // -- encode the service parsing word  -- -- -- -- -- --
  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // in : <serviceNm> add call(fmt.print)
  sServiceNm , "++ this is the service parser for: %v" , POSTPONE fmt.print

  // in : <serviceNm> add call(.consumeArgs)
  POSTPONE .consumeArgs

  // in : <serviceNm> add code which adds call(` pSpawnerWd) in caller of service
  pSpawnerWd , POSTPONE compile,

  // in : <serviceNm> add exit
  POSTPONE exit

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  // debug
  //pServiceWd word.dump
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* the job info compiler                                                      */
/*----------------------------------------------------------------------------*/
: jobInfo:

  0 0 0 locals| sEname sEvalue pEnameSet |

  // create a word using next token from input source as the word name
  next-token "_cls" str.cat >create

  // set the word kind to be jobClass
  [ compiler::current , ] compiler::current word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet

  pEnameSet compiler::current word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<?jobNm?>" word::name_trunc pEnameSet EnameSet.addStr

  // skip the "{" token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    next-token
    dup "}" str.equal not
  while
    to sEname
    next-token drop
    next-token to sEvalue
    sEname sEvalue jobInfo::addEname
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // complete the ename-set

  //pEnameSet EnameSet.asStr .

  pEnameSet .fillOutEnameSet

  //pEnameSet EnameSet.asStr .

  job::isServiceCmd if .generateService then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
