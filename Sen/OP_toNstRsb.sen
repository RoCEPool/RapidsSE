/*============================================================================*/
/* OP_toNstRsb.sen -- Convert rsb to normalised string row slab buffers       */
/*============================================================================*/

" OP_toRsb.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toNstRsb_StartMarker \handler

  ToNstRsb[].create

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toNstRsb_PulseMarker \handler

  ZK_PULSEMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toNstRsb_RsbBuffer \handler

  PipeIn[] ToNstRsb[].convert to OperandB[]

  OperandB[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toNstRsb_EosMarker \handler

  // delete ToRsb
  ToRsb[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRsb request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toNstRsb_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toNstRsb_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toNstRsb_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toNstRsb_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: toNstRsb_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toNstRsb :: toNstRsb ;

: toNstRsb _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
