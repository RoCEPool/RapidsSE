/*============================================================================*/
/* wordSet_words.sen -- additional high-level core words                      */
/*============================================================================*/

" wordSet_words.sen" .verbose

/*----------------------------------------------------------------------------*/
/* word entry mark                                                            */
/*----------------------------------------------------------------------------*/
: >>am immediate

  // format the string to be printed
  word::this word.name ">>%v" str.format

  // encode push of that string
  ,

  // encode call to markEntry
  POSTPONE ActivityMap::markEntry
;

/*----------------------------------------------------------------------------*/
/* word exit mark                                                             */
/*----------------------------------------------------------------------------*/
: <<am immediate

  // format the string to be printed
  word::this word.name "<<%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE ActivityMap::markExit
;

/*----------------------------------------------------------------------------*/
/* word error mark                                                            */
/*----------------------------------------------------------------------------*/
: !!am immediate

  // format the string to be printed
  word::this word.name "!!%v" str.format

  // encode push of that string
  ,

  // encode call to markExit
  POSTPONE ActivityMap::markExit
;

/*----------------------------------------------------------------------------*/
/* activity mark                                                              */
/*----------------------------------------------------------------------------*/
: .am immediate

  // encode call to markEntry
  POSTPONE ActivityMap::mark
;

/*----------------------------------------------------------------------------*/
/* unnamed trace point                                                        */
/*----------------------------------------------------------------------------*/
: tp immediate

  "tp"

  encodePushValue

  tick tracepoint compile,
;

/*----------------------------------------------------------------------------*/
/* named trace point                                                          */
/*----------------------------------------------------------------------------*/
: tp: immediate

  token:

  encodePushValue

  tick tracepoint compile,
;

/*----------------------------------------------------------------------------*/
/* add 1 to integer on stack                                                  */
/*----------------------------------------------------------------------------*/
: 1+ 1 + ;

/*----------------------------------------------------------------------------*/
/* increment integer variable                                                 */
/*----------------------------------------------------------------------------*/
: ++ dup @ 1+ swap ! ;

/*----------------------------------------------------------------------------*/
/* decrement integer on stack                                                 */
/*----------------------------------------------------------------------------*/
: 1- 1 - ;

/*----------------------------------------------------------------------------*/
/* decrement integer variable                                                 */
/*----------------------------------------------------------------------------*/
: -- dup @ 1- swap ! ;

/*----------------------------------------------------------------------------*/
/* begin a loop                                                               */
/*----------------------------------------------------------------------------*/
: BEGIN immediate

  here
;

/*----------------------------------------------------------------------------*/
/* do a loop                                                                  */
/*----------------------------------------------------------------------------*/
: DO immediate

  POSTPONE 2>R // encode 2>r into future word

  HERE true   // push address of last cell & simple do
;

/*----------------------------------------------------------------------------*/
/* ?do a loop                                                                 */
/*----------------------------------------------------------------------------*/
: ?DO immediate

  POSTPONE 2>R // encode 2>r into future word

  POSTPONE AHEAD

  false   // push address of last cell & simple do
;

/*----------------------------------------------------------------------------*/
/* unloop by dropping limit and index off rstack                              */
/*----------------------------------------------------------------------------*/
: UNLOOP immediate

  POSTPONE rdrop
  POSTPONE rdrop
;

/*----------------------------------------------------------------------------*/
/* iterate a loop                                                             */
/*----------------------------------------------------------------------------*/
: ITERATE immediate

  POSTPONE 2>R // encode 2>r into future word

  POSTPONE AHEAD
;

/*----------------------------------------------------------------------------*/
/* define a constant                                                          */
/*----------------------------------------------------------------------------*/
: ,_ALT

  HERE ! CELL ALLOT
;

/*----------------------------------------------------------------------------*/
/* define a constant                                                          */
/*----------------------------------------------------------------------------*/
: constant

  // create a word using the next token in the input stream
  create

  // encode a push value of the value currently on the stack
  ,

  // encode an exit into the created word
  POSTPONE exit
;

/*----------------------------------------------------------------------------*/
/* define a constant (using name on stack)                                    */
/*----------------------------------------------------------------------------*/
: :constant

  // create a word using the string on top of the stack
  >create

  // encode a push value of the value currently on the stack
  ,

  // encode a push value of the value currently on the stack
  POSTPONE exit
;

/*----------------------------------------------------------------------------*/
/* resolve IF supplying alternate execution                                   */
/*----------------------------------------------------------------------------*/
: ELSE immediate ( orig1 -- orig2 / -- )

  POSTPONE AHEAD // unconditional forward branch orig2
  1 CS-ROLL      // put orig1 back on top
  POSTPONE THEN  // resolve forward branch from orig1
;

/*----------------------------------------------------------------------------*/
/* conditional exit from loops                                                */
/*----------------------------------------------------------------------------*/
: WHILE immediate ( dest -- orig dest / flag -- )

  POSTPONE IF // conditional forward branch
  1 CS-ROLL   // keep dest on top
;

/*----------------------------------------------------------------------------*/
/* resolve a single WHILE and jump to BEGIN                                   */
/*----------------------------------------------------------------------------*/
: REPEAT immediate ( orig dest -- orig dest / flag -- )

  POSTPONE AGAIN // unconditional backward branch to dest
  POSTPONE THEN  // resolve forward branch from orig
;

/*----------------------------------------------------------------------------*/
/* initialise OFs counter                                                     */
/*----------------------------------------------------------------------------*/
0 CONSTANT CASE
true tick CASE word.immediate!

/*----------------------------------------------------------------------------*/
/* OF block                                                                   */
/*----------------------------------------------------------------------------*/
: OF immediate

  1+   // inc number of OFs
  >R   // save OFs counter

  POSTPONE OVER  // copy case value
  POSTPONE ==    // test case value against of value
  POSTPONE IF    // add conditional block (with orig on control stack)
  POSTPONE DROP  // discard case value within conditional block

  R> // restore OFs counter
;

/*----------------------------------------------------------------------------*/
/* ENDOF block                                                                */
/*----------------------------------------------------------------------------*/
: ENDOF immediate

  >R // save OFs counter

  POSTPONE ELSE // add conditional block (with orig2 on control stack)

  R> // restore OFs counter
;

/*----------------------------------------------------------------------------*/
/* ENDCASE block                                                              */
/*----------------------------------------------------------------------------*/
: ENDCASE immediate

  POSTPONE DROP  // discard case value

  0 ?DO          // resolve all forward ENDOF branches
    POSTPONE THEN
  LOOP
;

/*----------------------------------------------------------------------------*/
/* case test                                                                  */
/*----------------------------------------------------------------------------*/
: caseTest

  10 0 do
    I case
      0 of "zero"  . endof
      1 of "one"   . endof
      2 of "two"   . endof
      3 of "three" . endof
      4 of "four"  . endof
      5 of "five"  . endof
      6 of "six"   . endof
      7 of "seven" . endof
      8 of "eight" . endof
      9 of "nine"  . endof
    endcase
  loop
;

/*----------------------------------------------------------------------------*/
/* get depth of path                                                          */
/*----------------------------------------------------------------------------*/
: pathDepth ( -- )

  // push the dic stack of this task
  task::this task.dicStack

  // get depth
  dicStack.depth
;

/*----------------------------------------------------------------------------*/
/* dump the data stack                                                        */
/*----------------------------------------------------------------------------*/
/*
: stk

  "data stack " .

  depth not if drop then

  depth 0 do
    I pick dump
  loop
;
*/

/*----------------------------------------------------------------------------*/
/* dump the auxiliary stack                                                   */
/*----------------------------------------------------------------------------*/
/*
: astk

  "auxiliary stack" .

  adepth not if drop exit then

  adepth 0 do
    I apick dump
  loop
;
*/

/*----------------------------------------------------------------------------*/
/* dump the return stack                                                      */
/*----------------------------------------------------------------------------*/
: rstk

  "return stack" .
  rdepth dup not if drop exit then
  0 do
    I 2 + rpick
    dup .put
    " ".put
    locate
    dup if .put else drop then
    .\n
  loop
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* interpret string on stack                                                  */
/*----------------------------------------------------------------------------*/
: >: input.push input.text docol input.pop ;


/*----------------------------------------------------------------------------*/
/* check for known word                                                       */
/*----------------------------------------------------------------------------*/
: checkIsWord ( <"wordNm"> )
  find
  not if EC_NO_SUCH_WORD false exit then
  true
;

/*----------------------------------------------------------------------------*/
/* forget named word                                                          */
/*----------------------------------------------------------------------------*/
: :forget ( <"wordNm"> )

  find ( word )

  dup not if drop exit then ( )

  word.forget ( )
;

/*----------------------------------------------------------------------------*/
/* drop all values on stack except topmost                                    */
/*----------------------------------------------------------------------------*/
: nipAll ( ... top -- top )

  // handle expty stack case
  depth not if exit then

  // save topmost
  >r

  // drop everything else
  begin
    depth while
      drop
  repeat

  // restore topmost
  r>
;

/*----------------------------------------------------------------------------*/
/* drop n values from stack                                                   */
/*----------------------------------------------------------------------------*/
: dropN ( ... #values -- )

  // handle expty stack case
  depth not if exit then

  // drop everything else
  0 do
    drop
  loop
;

/*----------------------------------------------------------------------------*/
/* test type of top stack value                                               */
/*----------------------------------------------------------------------------*/
: isType ( CN_ -- bool )

  // false if stack empty
  depth 2 >= not if drop false exit then

  // no more if not indirect
  1 stack.class ==
;

/*----------------------------------------------------------------------------*/
/* snooze briefly                                                             */
/*----------------------------------------------------------------------------*/
: snooze ( -- )

  C_1M thread.sleep_ns
;

/*----------------------------------------------------------------------------*/
/* an end marker                                                              */
/*----------------------------------------------------------------------------*/
: <<
  //1234

  [ word::this encodePushValue ]
;

/*----------------------------------------------------------------------------*/
/* test of end marker                                                         */
/*----------------------------------------------------------------------------*/
: <<test

  << << eql
  if
    "equal" .
  else
    "not equal" .
  then

  "a" << eql
  if
    "equal" .
  else
    "not equal" .
  then

  1 << eql
  if
    "equal" .
  else
    "not equal" .
  then
;

/*----------------------------------------------------------------------------*/
/* get depth of marked stack                                                  */
/*----------------------------------------------------------------------------*/
: $$depth

  // if the stack is empty then there are 0 marked values
  depth 0 == if 0 exit then

  depth 0 do

    // marked values end at a valset
    I stack.class CN_VALSET ==
    if
      I 1+
      unloop
      exit
    then

    // marked values end at <<
    I pick << eql
    if
      I
      unloop
      exit
    then

  loop

  // marked values end at bottom of stack
  depth
;

/*----------------------------------------------------------------------------*/
/* get depth of marked aux stack                                              */
/*----------------------------------------------------------------------------*/
: $$adepth

  // if the stack is empty then there are 0 marked values
  adepth 0 == if 0 exit then

  adepth 0 do

    // marked values end at a valset
    I astack.class CN_VALSET ==
    if
      I 1+
      unloop
      exit
    then

    // marked values end at <<
    I apick << eql
    if
      I
      unloop
      exit
    then

  loop

  // marked values end at bottom of stack
  adepth
;

/*----------------------------------------------------------------------------*/
/* put << at given stack depth                                                */
/*----------------------------------------------------------------------------*/
: put$$ ( atDepth -- )

  << swap roll
;

/*----------------------------------------------------------------------------*/
/* convert contents of marked stack into a valset                             */
/*----------------------------------------------------------------------------*/
: >>

  $$depth
  >valset
  depth 1 > if
    1 pick << eql
    if
      nip
    then
  then
;

/*----------------------------------------------------------------------------*/
/* convert contents of marked aux stack into a valset                         */
/*----------------------------------------------------------------------------*/
: $$>avalset

  $$adepth
  >avalset
  adepth 1 > if
    1 apick << eql
    if
      anip
    then
  then
;

/*----------------------------------------------------------------------------*/
/* test marked valset                                                         */
/*----------------------------------------------------------------------------*/
: $$vs

  <<
  1 2 3
tp: a
  >>
tp: b
  "a" "b"
tp: c
  >>
tp: d
  valset>
tp: e
  1 - dropN
  valset>
tp: f
  drop
tp: g
;

/*----------------------------------------------------------------------------*/
/* named performance point                                                    */
/*----------------------------------------------------------------------------*/
: pp: immediate

  token:
  encodePushValue
  //tick . compile,

  word::this encodePushValue
  tick word.name compile,
  //tick . compile,
  tick performancepoint compile,
;

: ppTest

  "before" .
  pp: first
  pp: second
  pp: third
  "after" .

  performancePrint
;

: ppLoops

  100000 0 do
    pp: ppLoops

    I 1000 % 0 == if
      I .
    then

  loop

  performancePrint
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
