/*============================================================================*/
/* wordSet_words.sen -- additional high-level core words                      */
/*============================================================================*/

" wordSet_words.sen" .verbose

/*----------------------------------------------------------------------------*/
/* unnamed trace point                                                        */
/*----------------------------------------------------------------------------*/
: tp immediate

  "tp"

  encodePushValue

  tick tracepoint compile,
;

/*----------------------------------------------------------------------------*/
/* named trace point                                                          */
/*----------------------------------------------------------------------------*/
: tp: immediate

  token:

  encodePushValue

  tick tracepoint compile,
;

/*----------------------------------------------------------------------------*/
/* case test                                                                  */
/*----------------------------------------------------------------------------*/
: caseTest

  10 0 do
    I case
      0 of "zero"  . endof
      1 of "one"   . endof
      2 of "two"   . endof
      3 of "three" . endof
      4 of "four"  . endof
      5 of "five"  . endof
      6 of "six"   . endof
      7 of "seven" . endof
      8 of "eight" . endof
      9 of "nine"  . endof
    endcase
  loop
;

/*----------------------------------------------------------------------------*/
/* get depth of path                                                          */
/*----------------------------------------------------------------------------*/
: pathDepth ( -- )

  // push the dic stack of this task
  task::this task.dicStack

  // get depth
  dicStack.depth
;

/*----------------------------------------------------------------------------*/
/* dump the data stack                                                        */
/*----------------------------------------------------------------------------*/
/*
: stk

  "data stack " .

  depth not if drop then

  depth 0 do
    I pick dump
  loop
;
*/

/*----------------------------------------------------------------------------*/
/* dump the auxiliary stack                                                   */
/*----------------------------------------------------------------------------*/
/*
: astk

  "auxiliary stack" .

  adepth not if drop exit then

  adepth 0 do
    I apick dump
  loop
;
*/

/*----------------------------------------------------------------------------*/
/* dump the return stack                                                      */
/*----------------------------------------------------------------------------*/
: rstk

  "return stack" .
  rdepth dup not if drop exit then
  0 do
    I 2 + rpick
    dup .put
    " ".put
    locate
    dup if .put else drop then
    .\n
  loop
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* interpret string on stack                                                  */
/*----------------------------------------------------------------------------*/
: >: input.push input.text docol input.pop ;


/*----------------------------------------------------------------------------*/
/* check for known word                                                       */
/*----------------------------------------------------------------------------*/
: checkIsWord ( <"wordNm"> )
  find
  not if EC_NO_SUCH_WORD false exit then
  true
;

/*----------------------------------------------------------------------------*/
/* test type of top stack value                                               */
/*----------------------------------------------------------------------------*/
: isType ( CN_ -- bool )

  // false if stack empty
  depth 2 >= not if drop false exit then

  // no more if not indirect
  1 stack.class ==
;

/*----------------------------------------------------------------------------*/
/* snooze briefly                                                             */
/*----------------------------------------------------------------------------*/
: snooze ( -- )

  C_1M thread.sleep_ns
;

/*----------------------------------------------------------------------------*/
/* an end marker                                                              */
/*----------------------------------------------------------------------------*/
: <<
  //1234

  [ word::this encodePushValue ]
;

/*----------------------------------------------------------------------------*/
/* test of end marker                                                         */
/*----------------------------------------------------------------------------*/
: <<test

  << << eql
  if
    "equal" .
  else
    "not equal" .
  then

  "a" << eql
  if
    "equal" .
  else
    "not equal" .
  then

  1 << eql
  if
    "equal" .
  else
    "not equal" .
  then
;

/*----------------------------------------------------------------------------*/
/* get depth of marked stack                                                  */
/*----------------------------------------------------------------------------*/
: $$depth

  // if the stack is empty then there are 0 marked values
  depth 0 == if 0 exit then

  depth 0 do

    // marked values end at a valset
    I stack.class CN_VALSET ==
    if
      I 1+
      unloop
      exit
    then

    // marked values end at <<
    I pick << eql
    if
      I
      unloop
      exit
    then

  loop

  // marked values end at bottom of stack
  depth
;

/*----------------------------------------------------------------------------*/
/* get depth of marked aux stack                                              */
/*----------------------------------------------------------------------------*/
: $$adepth

  // if the stack is empty then there are 0 marked values
  adepth 0 == if 0 exit then

  adepth 0 do

    // marked values end at a valset
    I astack.class CN_VALSET ==
    if
      I 1+
      unloop
      exit
    then

    // marked values end at <<
    I apick << eql
    if
      I
      unloop
      exit
    then

  loop

  // marked values end at bottom of stack
  adepth
;

/*----------------------------------------------------------------------------*/
/* put << at given stack depth                                                */
/*----------------------------------------------------------------------------*/
: put$$ ( atDepth -- )

  << swap roll
;

/*----------------------------------------------------------------------------*/
/* convert contents of marked stack into a valset                             */
/*----------------------------------------------------------------------------*/
: >>

  $$depth
  >valset
  depth 1 > if
    1 pick << eql
    if
      nip
    then
  then
;

/*----------------------------------------------------------------------------*/
/* convert contents of marked aux stack into a valset                         */
/*----------------------------------------------------------------------------*/
: $$>avalset

  $$adepth
  >avalset
  adepth 1 > if
    1 apick << eql
    if
      anip
    then
  then
;

/*----------------------------------------------------------------------------*/
/* test marked valset                                                         */
/*----------------------------------------------------------------------------*/
: $$vs

  <<
  1 2 3
tp: a
  >>
tp: b
  "a" "b"
tp: c
  >>
tp: d
  valset>
tp: e
  1 - dropN
  valset>
tp: f
  drop
tp: g
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
