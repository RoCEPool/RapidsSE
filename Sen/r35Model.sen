/*============================================================================*/
/* r35Model.sen -- R35 actor model                                            */
/*============================================================================*/

"r35Model.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a task using given arguments and append to server task queue        */
/*----------------------------------------------------------------------------*/
: spawnR35ChildTask ( ... nArgs sSeedWord pParentTask sTaskNm eTaskKind -- pTask )

  nullptr locals| pTask eTaskKind sTaskNm pParent sSeedWord nArgs |

  // create a new task
  nArgs sSeedWord pParent AC_R35 sTaskNm eTaskKind task::new to pTask

  // put task into system
  pTask handler::systemEvent

  pTask  // return the task
;

/*----------------------------------------------------------------------------*/
/* spawn n35 child task                                                       */
/*----------------------------------------------------------------------------*/
: n35spawnChildren

  0 0 locals| pChildTask nChildren |

  // grab task lock
  task::this task.grabLock

  // 1 child will ack this parent
  1 to nChildren

  nChildren setAcks

  nChildren 0 do

    // spawn an n35 child task
    0               // nArgs
    "n35child"      // sSeedWord
    task::this      // pParentTask
    "R35Child"      // task name
    TK_R35_CHILD    // task kind
      spawnR35ChildTask to pChildTask

  loop
;

/*----------------------------------------------------------------------------*/
/* n35 child task test                                                        */
/*----------------------------------------------------------------------------*/
: n35child

  "n35child" .

  // ack the parent task
  task.parent@ ack
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
