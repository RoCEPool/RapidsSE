/*============================================================================*/
/* r35Model.sen -- R35 actor model                                            */
/*============================================================================*/

"r35Model.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a task using given arguments and append to server task queue        */
/*----------------------------------------------------------------------------*/
: spawnR35ChildTask ( ... nArgs sSeedWord pParentTask sTaskNm eTaskKind -- pTask )

  nullptr locals| pTask eTaskKind sTaskNm pParent sSeedWord nArgs |

  // create a new task
  nArgs sSeedWord pParent AC_R35 sTaskNm eTaskKind task::new to pTask

  // put task into system
  pTask handler::spawnedTask

  pTask  // return the task
;

/*----------------------------------------------------------------------------*/
/* create a task using given arguments and append to server task queue        */
/*----------------------------------------------------------------------------*/
: spawnR35PartitionChildTask ( ... nArgs iPartition sSeedWord pParentTask sTaskNm eTaskKind -- pTask )

  nullptr locals| pTask eTaskKind sTaskNm pParent sSeedWord iPartition nArgs |

  // create a new task
  nArgs sSeedWord pParent AC_R35 sTaskNm eTaskKind task::new to pTask

  // set the partition no n the task
  iPartition pTask task.partition!

  // put task into system
  pTask handler::spawnedTask

  pTask  // return the task
;

/*----------------------------------------------------------------------------*/
/* spawn n35 child task                                                       */
/*----------------------------------------------------------------------------*/
: n35spawnChildren

  3 locals| nChildren |
  0 locals| pChildTask |

  // grab task lock
  task::this task.grabLock

  // set number of children to ack this parent
  nChildren setAcks

  // loop from 0 to nChildren-1
  nChildren 0 do

    // spawn an n35 child task
    I
    1               // nArgs
    "n35child"      // sSeedWord
    task::this      // pParentTask
    "R35Child"      // task name
    TK_R35_CHILD    // task kind
      spawnR35ChildTask to pChildTask

  loop
;

/*----------------------------------------------------------------------------*/
/* spawn n35 task                                                             */
/*----------------------------------------------------------------------------*/
: n35spawnTask ( nTasks -- )

  0 locals| pTask nTasks |

  // loop from 0 to nChildren-1
  nTasks 0 do

    // spawn an n35 task
    I
    1                // nArgs
    "n35spawnedTask" // sSeedWord
    nullPtr          // pParentTask
    "R35SpawnedTask" // task name
    TK_R35_CHILD     // task kind
      spawnR35ChildTask to pTask

  loop
;

/*----------------------------------------------------------------------------*/
/* spawn p35 partition child task                                             */
/*----------------------------------------------------------------------------*/
: p35spawnPartitionChildren

  0 locals| pChildTask |

  // grab task lock
  task::this task.grabLock

  // set number of children to ack this parent
  grid.slots setAcks

  // loop from 0 to nChildren-1
  grid.slots 0
  do

    // spawn an n35 child task
    0                        // nArgs
    I grid::toPartition      // partition
    "p35child"               // sSeedWord
    task::this               // pParentTask
    "R35PartitionChild"      // task name
    TK_R35_CHILD             // task kind
      spawnR35PartitionChildTask to pChildTask

  loop
;

/*----------------------------------------------------------------------------*/
/* n35 child task test                                                        */
/*----------------------------------------------------------------------------*/
: n35child ( childNo -- )

  locals| iChildNo |

  "n35child" .

  iChildNo "child %v yielding" str.format .
  task.yield
  iChildNo "child %v running" str.format .

  iChildNo "child %v sleeping for 3 seconds" str.format .
  3000000 task.sleep
  iChildNo "child %v awake" str.format .

  // ack the parent task
  task.parent@ ack

  iChildNo "child %v exiting" str.format .
;

/*----------------------------------------------------------------------------*/
/* n35 spawned task test                                                      */
/*----------------------------------------------------------------------------*/
: n35SpawnedTask ( taskNo -- )

  0 locals| iSleep iTaskNo |

  "n35SpawnedTask" .

  10 0
  do
    // yield
    iTaskNo "task %v yielding" str.format .
    task.yield
    iTaskNo "task %v running" str.format .

    //sleep
    I 1000000 * to iSleep
    I iTaskNo "task %v sleeping for %v seconds" str.format .
    iSleep task.sleep
    iTaskNo "task %v awake" str.format .
  loop

  iTaskNo "task %v exiting" str.format .
;


/*----------------------------------------------------------------------------*/
/* p35 child task test                                                        */
/*----------------------------------------------------------------------------*/
: p35child ( -- )

  locals| iPartitionNo |

  "p35child" .

  task::this task.partition@ to iPartitionNo

  iPartitionNo "partitionTask %v yielding" str.format .
  task.yield
  iPartitionNo "partitionTask %v running" str.format .

  iPartitionNo "partitionTask %v sleeping for 3 seconds" str.format .
  3000000 task.sleep
  iPartitionNo "partitionTask %v awake" str.format .

  // ack the parent task
  task.parent@ ack

  iPartitionNo "partitionTask %v exiting" str.format .
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
