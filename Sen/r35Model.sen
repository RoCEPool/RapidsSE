/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: r35_node_e4

  "- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -" .
  "r35_node_e4" .
  "" .

  "yielding" .
  task.yield
  "running" .

  "sleeping for 0 microseconds" .
  0 task.sleep
