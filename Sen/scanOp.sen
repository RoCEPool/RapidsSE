/*============================================================================*/
/* scanOp.sen -- table scan select operator                                   */
/*============================================================================*/

"scanOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* scan partition of table                                                    */
/*----------------------------------------------------------------------------*/
: scanPartition ( plan -- )

  // intiially just drop the plan
  drop

  // set path
  "tables" "tpchSchema" "schemas" "rapidsse" "catalogs" "boray" "tenants" 7 dicPath.set

  // dump path
  pathDump

  rbCursor.new locals| rbCrs |

  "part" find execute rbCrs rbCursor.table!

  0 rbCrs rbCursor.begin

  rbCrs rbCursor.first

  // pipe rb's

  begin while

    // << rb plan true >>
    $$ rbCrs rbCursor.get 0 true $$>valset

    "writeOp.task" find execute >jobqueue

    rbCrs rbCursor.next

  repeat

  rbCrs rbCursor.end

  rbCrs rbCursor.delete

  // pipe EOD

  // << plan false >>
  $$ 0 false $$>valset

  "writeOp.task" find execute >jobqueue
;

/*----------------------------------------------------------------------------*/
/* table scan select                                                          */
/*----------------------------------------------------------------------------*/
: scanOp operator

  begin

    jobQueue> ( valset )

    valset> ( plan nValues )

    drop ( plan )

    scanPartition ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
