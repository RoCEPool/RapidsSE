/*============================================================================*/
/* scanOp.sen -- table scan seelct operator                                   */
/*============================================================================*/

"scanOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* table scan select                                                          */
/*----------------------------------------------------------------------------*/
: scanOp operator

  // set path
  "tables" "tpchSchema" "schemas" "rapidsse" "catalogs" "boray" "tenants" 7 dicPath.set

  // dump path
  pathDump

  rowCursor.new locals| rowCrs |

  "part" rowCrs rowCursor.table!

  0 rowCrs rowCursor.begin


  rowCrs rowCursor.end
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
