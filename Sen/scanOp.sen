/*============================================================================*/
/* scanOp.sen -- table scan select operator                                   */
/*============================================================================*/

"scanOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* plan common variables for scan                                             */
/*----------------------------------------------------------------------------*/
common/ scan rbCrs /

/*----------------------------------------------------------------------------*/
/* scan partition of a table                                                  */
/*----------------------------------------------------------------------------*/
: scanPartition subDic scan ( profile plan -- )

  // record the plan
  locals| thePlan profile |


  // set path (hardcoded for the moment)
  "tables" "tpchSchema" "schemas" "rapidsse" "catalogs" "boray" "tenants" 7 dicPath.set

  // push the op frame for this scanOp
  profile thePlan plan.opFrame? opFrame.push
//pathDump

  // create a new rowCursor
  rbCursor.new toCommon rbCrs

  thePlan plan.dic task.this task.dicStack dicPath.push
//pathDump

  // set up table in rowCursor
  $$tblNm find execute rbCrs rbCursor.table!

  // begin scan of partition
  $$ptn rbCrs rbCursor.begin

task.this task.dicStack dicPath.drop

  // get first rowBuffer of partition
  rbCrs rbCursor.first

  // pipe all rb's of partition
  begin while

    // << rb true profile plan >>
    << rbCrs rbCursor.get true "writeOp#" thePlan >>
    "writeOp.task" find execute >jobqueue

    // next rowBuffer in partition
    rbCrs rbCursor.next

  repeat

  // end cursored iteration
  rbCrs rbCursor.end

  // delete cursor
  rbCrs rbCursor.delete
  0 toCommon rbCrs

  // pipe EOD to writeOp

  // << false plan >>
  << false "writeOp#" thePlan >>
  "writeOp.task" find execute >jobqueue

  // discard this op's reg frame
  opFrame.drop
;

/*----------------------------------------------------------------------------*/
/* table scan select                                                          */
/*----------------------------------------------------------------------------*/
: scanOp operator

  begin

    // wait for next job
    jobQueue> ( valset )

    // unpack it
    valset> ( profile plan nValues )
    drop ( profile plan )

    // scan the table partition and pipe to write
    scanPartition ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
