/*============================================================================*/
/* scanOp.sen -- table scan select operator                                   */
/*============================================================================*/

"scanOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* scan partition of a table                                                  */
/*----------------------------------------------------------------------------*/
: scanPartition ( plan -- )

  // record the plan
  locals| thePlan |

  // set path (hardcoded for the moment)
  "tables" "tpchSchema" "schemas" "rapidsse" "catalogs" "boray" "tenants" 7 dicPath.set
  pathDump

  // create a new rowCursor
  rbCursor.new locals| rbCrs |

  // set up table in rowCursor
  "part" find execute rbCrs rbCursor.table!

  // begin scan of partition 0 (hardcoded for the moment)
  0 rbCrs rbCursor.begin

  // get first rowBuffer of partition
  rbCrs rbCursor.first

  // pipe all rb's of partition
  begin while

    // << rb true plan >>
    $$ rbCrs rbCursor.get true thePlan $$>valset
    "writeOp.task" find execute >jobqueue

    // next rowBuffer in partition
    rbCrs rbCursor.next

  repeat

  // end cursored iteration
  rbCrs rbCursor.end

  // delete cursor
  rbCrs rbCursor.delete

  // pipe EOD to writeOp

  // << false plan >>
  $$ false thePlan $$>valset
  "writeOp.task" find execute >jobqueue
;

/*----------------------------------------------------------------------------*/
/* table scan select                                                          */
/*----------------------------------------------------------------------------*/
: scanOp operator

  begin

    // wait for next job
    jobQueue> ( valset )

    // unpack it
    valset> ( plan nValues )
    drop ( plan )

    // scan the table partition and pipe to write
    scanPartition ( )

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
