/*============================================================================*/
/* job_UseSchema.sen -- Job Use Schema                                        */
/*============================================================================*/

" job_UseSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* use given schema                                                           */
/*----------------------------------------------------------------------------*/
: useSchema ( job_UseSchema --  )

  params| pJob_UseSchema |
  0 locals| sSchemaNm |

  tp: useSchema

  // pop path till we get to tenants
  begin
    pathCurrentFolder dic.name "tenants" str.equal not while pathDrop
  repeat

  // find the boray folder
  "boray" findInCurrent
  execute pathPush

  // find the catalogs folder
  "catalogs" findInCurrent
  execute pathPush

  // find the rapidssecatalogs folder
  "rapidsse" findInCurrent
  execute pathPush

  // find the schemas folder
  "schemas" findInCurrent
  execute pathPush

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get schema name from job
  pJob_UseSchema job.objectName@ to sSchemaNm

  sSchemaNm checkIsWord not if EC_NO_SUCH_SCHEMA pJob_UseSchema <ERROR_JOB> !!am exit then
  checkIsSchema not if pJob_UseSchema <ERROR_JOB> !!am exit then
  execute pathPush

  // find the tables folder
  "tables" findInCurrent
  execute pathPush

  // save the path
  savePath
;

/*----------------------------------------------------------------------------*/
/* Use Schema request (on the originating node)                               */
/*----------------------------------------------------------------------------*/
: UseSchema_req ( -- <R> )

  >>am <SEED_REQ>

  0 0 locals| sSchemaNm pJob_UseSchema pTask |

  tp: UseSchema_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_UseSchema

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set dictionary stack
  pJob_UseSchema job.pushPath
  dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab ddl read lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // use schema
  pJob_UseSchema useSchema

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

