/*============================================================================*/
/* job_UseSchema.sen -- Job Use Schema                                        */
/*============================================================================*/

" job_UseSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* use given schema                                                           */
/*----------------------------------------------------------------------------*/
: useSchema ( job_UseSchema --  )

  params| pJob_UseSchema |

  tp: useSchema

  // pop path till we get to tenants
  begin
    pathCurrentFolder dic.name "tenants" str.equal not while pathDrop
  repeat

  // find the boray folder
  "boray" findInCurrent
  execute pathPush

  // find the catalogs folder
  "catalogs" findInCurrent
  execute pathPush

  // find the rapidssecatalogs folder
  "rapidsse" findInCurrent
  execute pathPush

  // find the schemas folder
  "schemas" findInCurrent
  execute pathPush

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get schema name from job
  //pJob_UseSchema job.schemaName@ to sSchemaNm

  <schemaNm> checkIsWord not if EC_NO_SUCH_SCHEMA pJob_UseSchema <ERROR_JOB> !!logError exit then
  checkIsSchema not if pJob_UseSchema <ERROR_JOB> !!logError exit then
  execute pathPush

  // find the tables folder
  "tables" findInCurrent
  execute pathPush

  // save the path
  setPath
;

/*----------------------------------------------------------------------------*/
/* Use Schema request (on the originating node)                               */
/*----------------------------------------------------------------------------*/
: useSchema_req ( -- <R> )

  >>logEntry <SEED_REQ>

  0 0 locals| sSchemaNm pJob_UseSchema pTask |

  tp: UseSchema_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_UseSchema

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // use schema
  pJob_UseSchema useSchema

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // return
  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: useSchema :: use schema <schemaNm>;

jobInfo: useSchema
{
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_LOCAL_ERRORS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

