/*============================================================================*/
/* OP_truncateTable.sen -- Operator truncate table                            */
/*============================================================================*/

" OP_truncateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: truncateTable_PulseMarker \handler


  //"Operand:- ZK_PULSEMARKER" .verbose
  PipeIn[].pipeOut

  // truncate the buffers of the tablePtn
  tablePtn[].truncate

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: truncateTable_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> op__table if
    table[].tablePtn@ to tablePtn[]
    PipeIn[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for TruncateOp req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : truncateTable_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: truncateTable_PulseMarker ZK_PULSEMARKER op[].handler!
  find: truncateTable_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: truncateTable :: truncateTable <tableNm> ;

: truncateTable _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
