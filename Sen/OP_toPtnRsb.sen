/*============================================================================*/
/* OP_toPtnRsb.sen -- Convert rsb buffers to partitioned row slab buffers     */
/*============================================================================*/

" OP_toPtnRsb.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toPtnRsb_StartMarker \handler

  ToPtnRsb[].create

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toPtnRsb_PulseMarker \handler

  ZK_PULSEMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toPtnRsb_RsbBuffer \handler

  PipeIn[] ToPtnRsb[].convert

  grid::partitions 0
  do

    I ToPtnRsb[].completed to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].pipeOut
      I ToPtnRsb[].completed to OperandB[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toPtnRsb_EosMarker \handler

  grid::partitions 0
  do

    I ToPtnRsb[].dangling to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].pipeOut
      I ToPtnRsb[].dangling to OperandB[]
    repeat

  loop

  ToPtnRsb[].delete
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRsb request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toPtnRsb_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toPtnRsb_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toPtnRsb_PulseMarker ZK_PULSEMARKER op[].handler!
  find: toPtnRsb_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: toPtnRsb_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toPtnRsb :: toPtnRsb ;

: toPtnRsb _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
