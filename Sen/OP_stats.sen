/*============================================================================*/
/* OP_stats.sen -- Operator stats                                             */
/*============================================================================*/

" OP_stats.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: stats_StartMarker \handler

  PipeIn[].pipeOut

  "+++ +++ +++" .

//  C_TDEF_LOCKSTATS word::find if
//    C_TDEF_LOCKSTATS path[].pushNamedTableFolder
//    path[].toStr .
//    C_TDEF_LOCKSTATS find execute to table[]
//    Operand[].newStreamDef
//    Operand[] to streamDef[]
//    streamDef[].asStr .
//    nullptr to Operand[]
//  then
/*
  // find the __lockStats table
  C_TDEF_LOCKSTATS op__tableDef_infoSet assert

  // create a new streamDef
  infoSetTable[] streamDef[].new

  //streamDef[].asStr .
  metrics::lockSample to operandC[]
  OperandC[].pipeOut
*/

  // find the __lockStats table
  C_TDEF_LOCKSTATS op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] infoSet[].new

  // add lock  to the infoSet
  infoSetTable[] infoSet[].addLockStats assert

  // pipeout the infoset
  infoSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: stats_ExitMarker \handler
/*
  metrics::lockSample // to operandC[]
  //OperandC[].pipeOut

  PipeIn[].pipeOut
 
 Op.ackPipelineJob
 false
*/

  // find the __lockStats table
  C_TDEF_LOCKSTATS op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] infoSet[].new

  // add lock  to the infoSet
  infoSetTable[] infoSet[].addLockStats assert

  // pipeout the infoset
  infoSet[].pipeOut

  PipeIn[].pipeOut
  Op.ackPipelineJob
  false
;

/*----------------------------------------------------------------------------*/
/* stats request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: stats_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: stats_StartMarker ZK_STARTMARKER op[].handler!
  find: stats_ExitMarker  ZK_EXITMARKER  op[].handler!

  op__loop

  "*** stats EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: stats :: stats ;

: stats _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
