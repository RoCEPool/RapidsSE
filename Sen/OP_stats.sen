/*============================================================================*/
/* OP_stats.sen -- Operator stats                                             */
/*============================================================================*/

" OP_stats.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: statsOp_StartMarker \handler

  Operand[].pipeOut

  "+++ +++ +++" .

  C_TDEF_LOCKSTATS word::find if
    C_TDEF_LOCKSTATS pushTable assert
    folderPath.str .
    C_TDEF_LOCKSTATS find execute to table[]
    Operand[].newStreamDef
    Operand[] to StreamDef[]
    StreamDef[].asStr .
    nullptr to Operand[]
  then

  metrics::lockSample // to operandC[]
  //OperandC[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: statsOp_StopMarker \handler

  metrics::lockSample // to operandC[]
  //OperandC[].pipeOut

  Operand[].pipeOut

  Op.ackPipelineJob
  false
;

/*----------------------------------------------------------------------------*/
/* statsOp request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: statsOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: statsOp_StartMarker ZK_STARTMARKER op[].handler!
  find: statsOp_StopMarker  ZK_STOPMARKER  op[].handler!

  op__loop

  "*** statsOP EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: statsOp :: statsOp ;

: statsOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of job--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
