/*============================================================================*/
/* job_ListPartColumns.sen -- Job list Partition Key Columns                  */
/*============================================================================*/

" job_ListPartColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* list columns of table partitioning                                         */
/*----------------------------------------------------------------------------*/
: listPartitionColumns ( "<tableNm>" Job_ListPartColumns -- list )

  params|  pJob_ListPartColumns sTableNm |

  0 0 0 locals| iPartitionCols pSlots pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table
  sTableNm find execute to pTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get slots of table
  pTable table.slots to pSlots
  pSlots slots.columnCount to iPartitionCols

  ""                             // initial ls string
  iPartitionCols 0 do
    I pSlots slots.columnName
    "row: ( '%v' )\n" str.format
    str.cat
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set response in the job
  pJob_ListPartColumns job.response!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // sent rows Processed in the job
  iPartitionCols pJob_ListPartColumns job.rowsProcessed!
;

/*----------------------------------------------------------------------------*/
/* get list of partition key columns (on originating node)                    */
/*----------------------------------------------------------------------------*/
: lspartcol_req ( -- <R> )

  >>logEntry <SEED_REQ2>

  0 0 0 locals| sTableNm pJob_ListPartColumns pTask |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListPartColumns

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  checkInTables not if pJob_ListPartColumns <ERROR_REQUEST> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get table name from job
  //pJob_ListPartColumns job.objectName@ to sTableNm
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // there should be a table folder
  sTableNm checkIsTableFolder not if pJob_ListPartColumns <ERROR_REQUEST> !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm checkIsTable not if popTable pJob_ListPartColumns <ERROR_REQUEST> !!logError exit then

  args.metadata if
    "(columnName VARCHAR)" pJob_ListPartColumns job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list partition columns
  sTableNm pJob_ListPartColumns listPartitionColumns

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  popTable
  assertInTables

  <<logExit <DONE_REQ>

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: lspartcol :: lspartcol <tableNm> ;

jobInfo: lspartcol
{
  jobKind      = JK_LOCAL
  responseKind = RS_LOCAL_ERRORS
  
  exeLock      = DL_GRAB_READ
  preCheck     = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
