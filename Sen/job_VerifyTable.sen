/*============================================================================*/
/* job_VerifyTable.sen -- Job Verify Table                                    */
/*============================================================================*/

" job_VerifyTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkverifyTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* verify table request on a node                                             */
/*----------------------------------------------------------------------------*/
: verifyTable::execute _eeh ( -- )

  job::this locals| pjob_VerifyTable |

  0 0 locals| pTask sTableNm  |

  tp: verifyTable_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the tablen ame
  <tableNm> to sTableNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table folder
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // verify the table
  sTableNm find execute table.verify
  sTableNm grid::thisNodeName@
  "row: ('%v', '%v', '%v')\n" str.format
  pjob_VerifyTable job.response!
  1 pjob_VerifyTable job.rowsProcessed!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table folder
  popIndexes
  popTable
;

/*----------------------------------------------------------------------------*/
/* execute job_VerifyTable job check resources                                */
/*----------------------------------------------------------------------------*/
: verifyTable::checkResources _eeh ( -- )
  0 0 locals| sIndexNm sTableNm |

  tp: verifyTable.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

<tableNm> checkverifyTable not if job::this <ERROR_JOB> !!logError exit then

  DdlLock[].dropRead
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: verifyTable :: verifyTable <tableNm> ;
jobSyntax: verifyTable :: vfyTbl <tableNm> ;

jobInfo: verifyTable
{
  <?jobType?>  = JT_NONE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
