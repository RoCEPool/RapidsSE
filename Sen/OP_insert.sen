/*============================================================================*/
/* OP_insert.sen -- Operator insert                                           */
/*============================================================================*/

" OP_insert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: InsertOp_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  tablePtn[].get tablePtnGrabWrite2
  Operand[].insertIntoTable
  tablePtn[].get tablePtnDropWrite2

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: InsertOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can insert into the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Operand[].delete
    Operand[].newErrorMarker
  else
    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
  then

  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: InsertOp_StopMarker \handler

  //"Operand:- ZK_STOPMARKER" .verbose
  popTable
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: InsertOp_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Operand[].delete
  Operand[].newStreamDef
  Operand[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* execute for insertOp                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : InsertOp_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: InsertOp_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: InsertOp_StartMarker ZK_STARTMARKER op[].handler!
  find: InsertOp_StopMarker  ZK_STOPMARKER  op[].handler!
  find: InsertOp_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: InsertOp :: InsertOp <tableNm> ;

: InsertOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
