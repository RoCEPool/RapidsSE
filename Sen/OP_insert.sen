/*============================================================================*/
/* OP_insert.sen -- Operator insert                                           */
/*============================================================================*/

" OP_insert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: insert_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose

  // insert the buffer into the table ptn
  tablePtn[] tablePtnGrabWrite
  PipeIn[] tablePtn[].appendBuffer
  tablePtn[] tablePtnDropWrite

  // null the Pipein
  nullptr to PipeIn[]

  // increment no of buffers inserted
  Counter0[] 1 + to Counter0[]

  // send out an infoSet of ProgressUnits every 10 buffers
  Counter0[] 10 % 0 == if

    // create an infoSet operand
    infoSetTable[] InfoSet[].new

    // insert progressUnits to the infoset
    Counter0[] infoSetTable[] InfoSet[].addProgressUnits assert

    // pipeout the infoset
    InfoSet[].pipeOut

    // reset the counter
    0 to Counter0[]

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: insert_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  PipeIn[].pipeOut

  // send out final progress units

  // create an infoSet operand
  infoSetTable[] InfoSet[].new

  // insert progressUnits to the infoset
  Counter0[] infoSetTable[] InfoSet[].addProgressUnits assert

  // pipeout the infoset
  InfoSet[].pipeOut

  true
  ;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: insert_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose

  // get the profile from the task
  //task[] task.profile@ to Operand[]
  //nullptr task[] task.profile!
  //Operand[].pipeOut

  path[].popNamedTableFolder
  PipeIn[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: insert_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // create the infoSetTable for C_TDEF_PROGRESSUNITS
  C_TDEF_PROGRESSUNITS op__tableDef_infoSet assert

  // get Table[] to be inserted into
  <tableNm> op__table if
    Table[].tablePtn@ to tablePtn[]
    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
/*
: insert_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  PipeIn[].delete
  Operand[].newStreamDef
  Operand[].pipeOut
  
  true
;
*/

/*----------------------------------------------------------------------------*/
/* execute for insert                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : insert_req \operator
 
  LogReqEntry SEED_REQ

  // init the counter to be used for progress
  0 to Counter0[]

  op__topology

  find: insert_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: insert_EosMarker   ZK_EOSMARKER   op[].handler!
  find: insert_ExitMarker  ZK_EXITMARKER  op[].handler!
  //find: insert_StreamDef   ZK_STREAMDEF   op[].handler!
  find: insert_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: insert :: insert <tableNm> ;

: insert _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
