/*============================================================================*/
/* OP_insert.sen -- Operator insert                                           */
/*============================================================================*/

" OP_insert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: Insert_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  tablePtn[].get tablePtnGrabWrite2

  // to go
  Pipein[] to Operand[]
  nullptr to Pipein[]

  Operand[].insertIntoTable
  tablePtn[].get tablePtnDropWrite2

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: Insert_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can insert into the table
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB !!logError
    Pipein[].delete
    Operand[].newErrorMarker
  else
    // move to table folder and find the table and tablePtn
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    table[].tablePtn@ to tablePtn[]
  then

  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: Insert_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  popTable
  Pipein[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: Insert_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Pipein[].delete
  Operand[].newStreamDef
  Operand[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* execute for insert                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Insert_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: Insert_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: Insert_StartMarker ZK_STARTMARKER op[].handler!
  find: Insert_ExitMarker  ZK_EXITMARKER  op[].handler!
  find: Insert_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: Insert :: Insert <tableNm> ;

: Insert opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
