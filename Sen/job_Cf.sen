/*============================================================================*/
/* job_Cf.sen -- Job Change Folder                                            */
/*============================================================================*/

" job_Cf.sen" .verbose

/*----------------------------------------------------------------------------*/
/* cf command request                                                         */
/*----------------------------------------------------------------------------*/
: cf_req ( -- )

  LogEntry SEED_REQ

  0 0 0 0 locals| pCurrentFolder sFolderNm pJob_Cf pTask |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the task
  task[] to pTask

  // get the job from the task
  pTask task.job@ to pJob_Cf

  // get the folderNm from the job
  //pJob_Cf job.folderName@ to sFolderNm
  <folderNm> to sFolderNm


  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a ".." which will go up one folder

  // pop up one folder, but not into tenants
  sFolderNm ".." str.equal if
    folder[] dic.name "tenants" str.equal not if path[].discardFolder then
    setPath
    LogExit DONE_REQ
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a "~" will pop folder path till it reaches /tenants

  // pop up to tenants
  sFolderNm "~" str.equal if
    begin folder[] dic.name "tenants" str.equal not while path[].discardFolder repeat
    setPath
    LogExit DONE_REQ
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a "tenants" will clear folder path and set to /tenants

  // clear dic path and push tenants
  sFolderNm "tenants" str.equal if
    path[].discardFolderAll
    attachmap::tenants@ execute path[].pushFolder
    setPath
    LogExit DONE_REQ
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // otherwise we expect a name of a sub-folder to which we push path to
  //  push sub-folder

  sFolderNm folder[].findSymbol to pCurrentFolder
  pCurrentFolder word.isFolder not if pJob_Cf ERROR_REQUEST !!logError exit then
  pCurrentFolder execute path[].pushFolder
  setPath
  LogExit DONE_REQ

  HAZARD
;


/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

jobSyntax: cf :: cf <folderNm> ;

jobInfo: cf
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_JOB_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  //<preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
