/*============================================================================*/
/* db_tenant.sen -- tenant related words                                      */
/*============================================================================*/

" db_tenant.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the tenant category                                                         */
/*----------------------------------------------------------------------------*/
: \tenant \\category ;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: folder[].isTenants

    folder[] dic.name "tenants" str.equal
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: checkInTenants

    folder[].isTenants if true exit then
    EC_NOT_IN_TENANTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a tenant folder                                            */
/*----------------------------------------------------------------------------*/
: checkIsTenant ( word )

  dup word.category@ find: \folder eql not if EC_NOT_A_FOLDER false exit then
  dup execute dic.kind@ find: \tenant eql if true exit then
  EC_NOT_A_TENANT false
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make a tenant folder (run by participant)                                  */
/*----------------------------------------------------------------------------*/
: :makeTenantFolder params| sTenantNm |

  args.tracepoint if
    sTenantNm "MAKING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the tenant
  sTenantNm :makeFolder
    find: \tenant swap execute dic.kind!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make catalogs folder
  sTenantNm :makeCatalogsFolder ( )
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
