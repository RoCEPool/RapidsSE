/*============================================================================*/
/* OP_EOAsm.sen -- sql                                                        */
/*============================================================================*/

" OP_EOAsm.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: EOAsm_StartMarker \handler

  0 locals| queryNo |

  0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  ZK_STARTMARKER_handler

  <queryNo> >int to queryNo
  //queryNo .

  Pot[].new
  LogicUnit[].init

  queryNo "sql %v" str.format profile.name!
  queryNo case

    100 of
      <tableNm> op__table not if
        false
        exit
      then

      Table[].asSrcStreamDef
      Table[].tablePtn@ to tablePtn[]

      Counter0[] <queryText> genAsm
      idxDef_int indexDef[] indexTree[].new indexTree[].asTmp
      indexDef[].delete
    endof

    103 of
      Counter0[] <queryText> genAsm
      idxDef_int indexDef[] indexTree[].new indexTree[].asTmp
      indexDef[].delete
    endof

    600 of
      <tableNm> <indexNm> op__table_index not if
        false
        exit
      then
      index[].indexTree to indexTree[]
      indexTree[].asSrc
      Table[].asSrcStreamDef
      Counter0[] <queryText> genAsm
    endof

    601 of
      Counter0[] <queryText> genAsm
    endof

  endcase
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 100                                      STREAMDEF */
/*----------------------------------------------------------------------------*/
: EOAsm_streamDefOut_100

  0 locals| pColumn |

  // new a streamDef from table
  table[] StreamDef[].new

  StreamDefOut[].new

  // add column L_RETURNFLAG
  8 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column L_LINESTATUS
  9 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column SUM(L_QUANTITY) as SUM_QTY
  4 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_qty"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE) as SUM_BASE_PRICESUM_QTY
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_base_price"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)) as SUM_DISC_PRICE
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_disc_price"
  StreamDefOut[].addColumn

  // add column SUM(L_EXTENDEDPRICE*(1-L_DISCOUNT)*(1+L_TAX)) as SUM_CHARGESUM_QTY
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_charge"
  StreamDefOut[].addColumn

  // add column COUNT(L_QUANTITY) as COUNT_QTY
  0
  19
  CT_INTEGER
  "count_qty"
  StreamDefOut[].addColumn

  // add column COUNT(L_EXTENDEDPRICE)
  0
  19
  CT_INTEGER
  "count_price"
  StreamDefOut[].addColumn

  // add column SUM(L_DISCOUNT)) as SUM_DISCOUNT
  6 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "sum_discount"
  StreamDefOut[].addColumn

  // add column COUNT(L_DISCOUNT)
  0
  19
  CT_INTEGER
  "count_discount"
  StreamDefOut[].addColumn

  // add column COUNT(*) as COUNT_ORDER
  0
  19
  CT_INTEGER
  "count_order"
  StreamDefOut[].addColumn

  false Pot[].useStreamDefOut
  streamDefOut[].pipeout
;

/*----------------------------------------------------------------------------*/
/* outbound stream def for 103                                      STREAMDEF */
/*----------------------------------------------------------------------------*/
: EOAsm_streamDefOut_103

  0 locals| pColumn |

  StreamDefOut[].new

  // add column Q101_RETURNFLAG
  0 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_LINESTATUS
  1 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_QTY as sum_qty
  2 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_BASE_PRICE as SUM_BASE_PRICESUM_QTY
  3 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_DISC_PRICE as SUM_DISC_PRICE
  4 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_CHARGE as SUM_CHARGE
  5 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  pColumn column.name@
  StreamDefOut[].addColumn

  // add column Q101_SUM_QTY/Q101_COUNT_QTY as AVG_QTY
  2 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_qty"
  StreamDefOut[].addColumn

  // add column Q101_SUM_BASE_PRICE/Q101_COUNT_PRICE as AVG_PRICE
  3 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_price"
  StreamDefOut[].addColumn

  // add column Q101_SUM_DISC/Q101_COUNT_DISC as AVG_DISC
  8 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "avg_disc"
  StreamDefOut[].addColumn

  // add column Q101_COUNT_ORDER as COUNT_ORDER
  10 StreamDef[].column@ to pColumn
  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "count_order"
  StreamDefOut[].addColumn

  StreamDef[].delete

  false Pot[].useStreamDefOut
  streamDefOut[].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: EOAsm_PulseMarker_100 \handler

  EOAsm_streamDefOut_100
  streamDef[].asSrcStreamDef

  // grab table ptn read lock
  tablePtn[] tablePtnGrabRead

  // new a partition stream for access crw buffer
  tablePtn[] ptnStream::new to ptnStream[]

  // open partition stream to access the crw buffers
  ptnStream[] ptnStream.open if

    // force op loop to call scan_CrwBuffer to start processing buffers
    "EOAsm_CrwBuffer" word::find LogicUnit[].handler!
    true LogicUnit[].callAgain!

  else
    // unable to open partition stream (this would be unusual)

    // delete partition stream
    ptnStream[] ptnStream.delete
    nullptr to ptnStream[]

    // drop table ptn lock
    tablePtn[] tablePtnDropRead

    // send an eos marker (there was no data)
    Operand[].newEosMarker
    Operand[].pipeOut

  then
  ;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: EOAsm_PulseMarker_600

  0 locals| pColumn |

  // new a streamDef from table
  table[] StreamDef[].new

  // new a streamDef to be piped out
  StreamDefOut[].new

  // add column SUM(L_EXTENDEDPRICE*L_DISCOUNT) as REVENUE
  5 StreamDef[].column@ to pColumn

  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "revenue"
  StreamDefOut[].addColumn

  // now delete the streamDef of table
  StreamDef[].delete

  // set streamDefOut in the pot
  true Pot[].useStreamDefOut
  StreamDefOut[].pipeout

  Counter0[] executeAsm
  Counter0[] cleanUpAsm

  Pot[].pipeoutAllCompleted
  Pot[].pipeoutAllDangling

  Pot[].delete

  // pipeout an EOS MARKER
  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: EOAsm_PulseMarker \handler

  0 ZK_PULSEMARKER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  ZK_PULSEMARKER_handler

  queryNo case

    100 of
      EOAsm_PulseMarker_100
    endof

    600 of
      EOAsm_PulseMarker_600
    endof

  endcase

;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: EOAsm_CrwBuffer \handler

  0 ZK_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    100 of
      // read next buffer from ptn stream
      ptnStream[] ptnStream.read to Operand[]

      Operand[].isNotNull if
      // read a next crw buffer

        Operand[].asSrcCrwBuffer
        Counter0[] executeAsm
        Operand[].delete

        Pot[].pipeoutAllCompleted
        // call this handler again to process next buffer
        true LogicUnit[].callAgain!

      else

      // no more crw buffers

        // close and delete partition stream
        ptnStream[] ptnStream.close
        ptnStream[] ptnStream.delete
        nullptr to ptnStream[]

        // drop partition lock
        tablePtn[] tablePtnDropRead

        streamDef[].delete
        Counter0[] executeAsm
        Counter0[] cleanUpAsm
        IndexTree[].delete

        Pot[].pipeoutAllDangling
        Pot[].delete

        Operand[].newEosMarker
        Operand[].pipeOut

      then


    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: EOAsm_RsbBuffer \handler

  0 ZK_RSBBUFFER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    103 of
"EOAsm_RsbBuffer" .
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      Counter0[] executeAsm
      Operand[].delete
    endof

    601 of
      Operand[].pipeIn
      Operand[].asSrcRowSlab
      Counter0[] executeAsm
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    // default
    queryNo "ERROR : Unexpected queryno %v" .printf
    0 assert
  endcase

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: EOAsm_EosMarker \handler

  0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    100 of
    endof

    103 of
"103 EOS MARKER" .
      Counter0[] executeAsm
      Counter0[] cleanUpAsm
      IndexTree[].delete
      Pot[].pipeoutAllCompleted
    endof

    600 of
    endof

    601 of
      Counter0[] cleanUpAsm
    endof

  endcase

  //queryNo "dangling %v" .printf
  Pot[].pipeoutAllDangling
  Pot[].delete

  ZK_EOSMARKER EG_ZK PP_PIPE_OUT 0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryAction
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: EOAsm_StreamDef \handler

  0 ZK_STREAMDEF EG_ZK LogicUnit[].diaryNote

  0 locals| queryNo |

  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  <queryNo> >int to queryNo
  queryNo case

    103 of
      EOAsm_streamDefOut_103
    endof

    601 of
      StreamDef[] to StreamDefOut[]
      true Pot[].useStreamDefOut
      StreamDefOut[].pipeout
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: EOAsm_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: EOAsm_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: EOAsm_EosMarker   ZK_EOSMARKER   op[].handler!
  find: EOAsm_PulseMarker ZK_PULSEMARKER op[].handler!
  find: EOAsm_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: EOAsm_StartMarker ZK_STARTMARKER op[].handler!
  find: EOAsm_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: EOAsm :: EOAsm <queryText> <queryNo> <compiled> ;
cmdSyntax: EOAsm :: EOAsm <queryText> <queryNo> <compiled> <tableNm> <indexNm> ;

: EOAsm _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
