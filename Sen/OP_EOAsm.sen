/*============================================================================*/
/* OP_EOAsm.sen -- sql                                                        */
/*============================================================================*/

" OP_EOAsm.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: sql_PulseMarker_600

  0 locals| pColumn |

  ZK_PULSEMARKER_handler

  // new a streamDef from table
  table[] StreamDef[].new

  // new a streamDef to be piped out
  StreamDefOut[].new

  // add column SUM(L_EXTENDEDPRICE*L_DISCOUNT) as REVENUE
  5 StreamDef[].column@ to pColumn

  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "revenue"
  StreamDefOut[].addColumn

  // now delete the streamDef of table
  StreamDef[].delete

  // set streamDefOut in the pot
  true Pot[].useStreamDefOut
  StreamDefOut[].pipeout

  Counter0[] executeAsm
  Counter0[] cleanupAsm

  Pot[].pipeoutAllCompleted
  Pot[].pipeoutAllDangling

  Pot[].delete

  // pipeout an EOS MARKER
  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: EOAsm_StartMarker \handler

  0 locals| queryNo |

  0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  ZK_STARTMARKER_handler

  <queryNo> >int to queryNo
  //queryNo .

  Pot[].new
  LogicUnit[].init

  queryNo "sql %v" str.format profile.name!
  queryNo case

    600 of
      <tableNm> <indexNm> op__table_index not if
        false
        exit
      then
      index[].indexTree to indexTree[]
      indexTree[].asSrc
      Table[].asSrcStreamDef
      Counter0[] "../EO_text/QRY_600.txt" genAsm
    endof

    601 of
      Counter0[] "../EO_text/QRY_601.txt" genAsm
    endof

  endcase
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: EOAsm_PulseMarker_600

  0 locals| pColumn |

  ZK_PULSEMARKER_handler

  // new a streamDef from table
  table[] StreamDef[].new

  // new a streamDef to be piped out
  StreamDefOut[].new

  // add column SUM(L_EXTENDEDPRICE*L_DISCOUNT) as REVENUE
  5 StreamDef[].column@ to pColumn

  pColumn column.scale@
  pColumn column.length@
  pColumn column.type@
  "revenue"
  StreamDefOut[].addColumn

  // now delete the streamDef of table
  StreamDef[].delete

  // set streamDefOut in the pot
  true Pot[].useStreamDefOut
  StreamDefOut[].pipeout

  Counter0[] executeAsm
  Counter0[] cleanUpAsm

  Pot[].pipeoutAllCompleted
  Pot[].pipeoutAllDangling

  Pot[].delete

  // pipeout an EOS MARKER
  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: EOAsm_PulseMarker \handler

  0 ZK_PULSEMARKER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    600 of sql_PulseMarker_600   endof
    ZK_PULSEMARKER_handler

  endcase

;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: EOAsm_RsbBuffer \handler

  0 ZK_RSBBUFFER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    601 of
      Operand[].pipeIn
      Operand[].asSrcRowSlab

      Counter0[] executeAsm
      Operand[].delete
      Pot[].pipeoutAllCompleted
    endof

    // default
    queryNo "ERROR : Unexpected queryno %v" .printf
    0 assert
  endcase

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: EOAsm_EosMarker \handler

  0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryNote

  <queryNo> >int locals| queryNo |

  queryNo case

    600 of
    endof

    601 of
      Counter0[] cleanUpAsm
    endof

  endcase

  //queryNo "dangling %v" .printf
  Pot[].pipeoutAllDangling
  Pot[].delete

  ZK_EOSMARKER EG_ZK PP_PIPE_OUT 0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryAction
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: EOAsm_StreamDef \handler

  0 ZK_STREAMDEF EG_ZK LogicUnit[].diaryNote

  0 locals| queryNo |

  Pipein[] to StreamDef[]
  nullptr to Pipein[]

  <queryNo> >int to queryNo
  queryNo case

    601 of
      StreamDef[] to StreamDefOut[]
      true Pot[].useStreamDefOut
      StreamDefOut[].pipeout
    endof

  endcase

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: EOAsm_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: EOAsm_EosMarker   ZK_EOSMARKER   op[].handler!
  find: EOAsm_PulseMarker ZK_PULSEMARKER op[].handler!
  find: EOAsm_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: EOAsm_StartMarker ZK_STARTMARKER op[].handler!
  find: EOAsm_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: EOAsm :: EOAsm <queryNo> <compiled> ;
cmdSyntax: EOAsm :: EOAsm <queryNo> <compiled> <tableNm> <indexNm> ;

: EOAsm _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
