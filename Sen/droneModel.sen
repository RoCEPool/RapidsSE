/*============================================================================*/
/* droneModel.sen -- drone actor model                                        */
/*============================================================================*/

"actorModel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a thread-task pair using given arguments                            */
/*----------------------------------------------------------------------------*/
: spawnDroneActor ( ... nArgs sSeedWord pParentTask sTaskNm -- )

  // save arguments
  locals| sTaskNm pParent sSeedWord nArgs |

  // local variables
  nullptr nullptr locals| pTaskSet pThread pTask |

  // create a new task
  nArgs sSeedWord pParent task::new to pTask

  // set task name
  sTaskNm pTask task.name!

  // create a thread
  sTaskNm "Thread" str.cat :thread execute to pThread

  // set thread name
  sTaskNm "Thread" str.cat pThread thread.name!

  // create taskset
  sTaskNm "TaskSet" str.cat :taskSet execute to ptaskSet

  // attach taskset onto thread
  pTaskSet pThread thread.taskSet!

  // append task into taskset
  pTask pTaskSet taskSet.append

  // spawn posix thread for drone actor 
  pThread thread.spawn_drone

  pTask
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
