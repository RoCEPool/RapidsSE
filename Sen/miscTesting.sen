/*============================================================================*/
/* miscTesting.sen -- miscellaneous testing                                   */
/*============================================================================*/

"miscTesting.sen" .verbose

: iftest if "yes" . then ;

: ifelsetest if "yes" . else "no" . then ;

: untiltest 0 begin 1 + dup . dup 10 == until ;

: whiletest 0 begin 1 + dup 10 < while dup . repeat ;

: dotest 10 0 do I . loop ;
: ?dotest 10 0 ?do I . loop 10 10 ?do I . loop ;

: +looptest 10 0 do I . 2 +loop ;

: iterateTest
    word.this word.this iterate // iterate word cursor
      object@ word.name .       // print the name of the word
      object@ word.prev object! // step backwards thru words
    next                        // next iteration
;

: string_blowup

traceon
    "abcdefghijklmnopqrstuvwxyz"
    1000000 0 do
      "abcdefghijklmnopqrstuvwxyz"
      str.cat
    loop
;

str: strvar

: strvar_blowup


traceon

  "a" strvar !
  1000000 0 do
    strvar @ "a" str.cat strvar !
  loop

;

: rottest

  2 1 0 rot . . .
;

: invrottest

  2 1 0 -rot . . .
;

/*----------------------------------------------------------------------------*/
/* globals testing                                                            */
/*----------------------------------------------------------------------------*/
: globalsTest

  reg.push

  2048 str.random 1 >valset

  >reg0

  reg0

  valset>

  . .

  reg.pop
;

: globalsTest2

//traceon

  reg.push

  // create a vector of the CN_ enums
  // currently thats ( -- 91 .. 0 92 )
  1 neg CN_ENUMS 1- ?do I 1 neg +loop CN_ENUMS

  // show the stack
  //stk

  // convert to valset
  >valset

  // put into reg0
  >reg0

  // copy into reg1
  reg0 >reg1

  // copy back to stack
  reg1 //dup drop

  // expand valset into vector
  valset>

  // show the stack
  stk

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* str.format testing                                                         */
/*----------------------------------------------------------------------------*/
: strFormatTest

  1 "abc%v" str.format .

  "def" "abc%v" str.format .

  "gh" 456 "def" 23 "abc" 1
  "%v %v %v %v %v %v" str.format .
;

/*----------------------------------------------------------------------------*/
/* locals testing                                                             */
/*----------------------------------------------------------------------------*/
: lt

  789 456 123 locals| a b c |

  a . b . c .

  321 to a
  654 to b
  789 to c 

  a . b . c .
;

/*----------------------------------------------------------------------------*/
/* postpone testing                                                           */
/*----------------------------------------------------------------------------*/
: callTest immediate

  test
;

: postponeTest

  postpone callTest
;

/*----------------------------------------------------------------------------*/
/* get a snapshot of the buffer pool objects                                  */
/*----------------------------------------------------------------------------*/
: snapshot (  )

  reg.push

  bp.snapshot ( int int .... #classes )

  >valset
  >reg0

  "First Snapshot..." .
  reg0
  valset>
  0 do
    I class.name
    "%v %v" str.format .
  loop

  bp.snapshot ( int int .... #classes )

  >valset
  >reg1

  "Second Snapshot..." .
  reg1
  valset>
  0 do
    I class.name
   "%v %v" str.format .
  loop

  reg1 reg0 vector.diff

  "Differnce of Snapshots..." .
  0 do
    I class.name
    "%v %v" str.format .
  loop

  reg.pop
;

/*----------------------------------------------------------------------------*/
/* test of embedded file in constant                                          */
/*----------------------------------------------------------------------------*/
"someEmbeddedFile.sen" constant EmbeddedFile

EmbeddedFile .

/*----------------------------------------------------------------------------*/
/* string replacement                                                         */
/*----------------------------------------------------------------------------*/
: srepl

  "this" "that" "abcthisdef" str.replace .

  "this" "that" "abcthidef" str.replace .

  "this" "that" "abcthisdefthis" str.replace .
  "this" "that" "abcthisthisdefthis" str.replace .
  "this" "that" "thisthiabcthisthisdefthis" str.replace .
;

/*----------------------------------------------------------------------------*/
/* plan list testing                                                          */
/*----------------------------------------------------------------------------*/
: pl_test

  plan::new locals| plan |

  "plan#1" plan plan.name!

  plan plan.show

  plan stk >binval stk >object stk drop

  plan planList::addPlan

  planList::show

  plan planList::removePlan

  planList::show

  plan::new planList::addPlan
  plan::new planList::addPlan
  plan::new planList::addPlan

  planList::show

  1 planList::findPlan .

  3 planList::findPlan . .

3 planList::findPlan if planList::removePlan then planList::show

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
