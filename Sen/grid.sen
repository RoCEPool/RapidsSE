/*============================================================================*/
/* grid.sen -- grid routines                                                  */
/*============================================================================*/

"grid.sen" .verbose

/*----------------------------------------------------------------------------*/
/* grid is use as a kind of word to identify grids                            */
/*----------------------------------------------------------------------------*/
: grid ;

: isGrid word.kind@ ' grid eql ;

: <SUCCESS_RESULT> grid.thisNode@ true ( v n# true ) ;

: <FAILURE_RESULT> grid.thisNode@ false ( ec n# false ) ;

/*----------------------------------------------------------------------------*/
/* check grid result                                                          */
/*----------------------------------------------------------------------------*/
: checkResult ( b n# t | ec n# f .... nn t/f )

tp: checkResult

  // was the final result true ?
  true == if  ( b n# t | ec n# f .... nn )

    // drop the rest of the result
    depth dropN ( )

  else
    // lets see which node failed
    0 do

      false == if  ( ... ec n# )

        swap error.msg swap
        grid.node node.name
        "%v ERROR: %v" str.format .

      else

        drop drop  ( ... )

      then

    loop

  then
;

/*----------------------------------------------------------------------------*/
/* print grid result                                                          */
/*----------------------------------------------------------------------------*/
: printResult ( s n# t | ec n# f .... nn t/f )

tp: printResult

  // was the final result true ?
  true == if ( s n# t | ec n# f .... nn )

    // pretty print the results resturned
    0 do  ( s n# t | s n# f .... )

      assert // should be true
      grid.node node.name "%v: %v"  str.format .
    loop

  else

    // lets see which node failed
    0 do  ( s n# t | ec n# f .... )

      false == if ( s n# t | ec n# )

        swap error.msg swap
        grid.node node.name
        "%v ERROR: %v" str.format .

      else

        drop drop

      then

    loop

  then

;

/*----------------------------------------------------------------------------*/
/* return grid result                                                         */
/*----------------------------------------------------------------------------*/
: returnResult ( s n# t | ec n# f .... nn t/f )

  tp: returnResult

  0 0 locals| results seitf |

  // get this tasks seitf
  task::this task.seitf@ to seitf

  // was the final result true ?
  true == if ( s n# t | ec n# f .... nn )

    to results
    
    // concatenate the results resturned
    results
    0 do  ( s n# t | s n# f .... )

      I 0 == if
        ""
      then

      3 roll ( " " s n# t )

      assert // should be true

        args.metadata if
          drop "row: "( " " s "row:"  )
          "%v %v\n" str.format
        else
          grid.node node.name  ( " " s nodeName )
          "%v: %v" str.format
        then
        str.cat
    loop
    results seitf seitf.rowsProcessed
    true
  else

    // lets see which node failed
    0 do  ( s n# t | ec n# f .... )

      false == if ( s n# t | ec n# )
        //swap error.msg swap
        //grid.node node.name
        //"error: %v %v" str.format
        drop false
      else
        drop drop
      then

    loop
    // returning only 1 error
    1 seitf seitf.rowsProcessed

  then
;

/*----------------------------------------------------------------------------*/
/* print grid result                                                          */
/*----------------------------------------------------------------------------*/
: printFile ( NodeObject n# t | ec n# f .... nn t/f )

  tp: printFile

  // was the final result true ?
  true == if ( s n# t | ec n# f .... nn )

    // pretty print the results resturned
    0 do  ( s n# t | s n# f .... )

      assert // should be true
      swap >object file.path@ swap
      "Node%v: %v"  str.format .
    loop

  else

    // lets see which node failed
    0 do  ( s n# t | ec n# f .... )

      false == if ( s n# t | ec n# )

        swap error.msg swap
        "Node%v ERROR: %v" str.format .

      else

        drop drop

      then

    loop

  then

;

/*----------------------------------------------------------------------------*/
/* create a grid using name from input stream                                 */
/*----------------------------------------------------------------------------*/
: grid:

  create
  WT_OBJECT word.this word.type!
  sizeof_grid allot
  word.this >body object.magic!
  CN_GRID word.this >body object.class!
  word.this >body grid.init
  ' grid word.this word.kind!
  true word.this >body object.wordbody!
  does>
;

/*----------------------------------------------------------------------------*/
/* create a grid using name on the stack (leaves grid word on stack)          */
/*----------------------------------------------------------------------------*/
: :grid

  >create
  WT_OBJECT word.this word.type!
  sizeof_grid allot
  word.this >body object.magic!
  CN_GRID word.this >body object.class!
  word.this >body grid.init
  ' grid word.this word.kind!
  true word.this >body object.wordbody!
  word.this
  does>
;

////////////////////////////////////////////////////////////////////////////////

grid: grid.this

grid.appendNodes
grid.thisNode!

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
