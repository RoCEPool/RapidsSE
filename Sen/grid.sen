/*============================================================================*/
/* grid.sen -- grid routines                                                  */
/*============================================================================*/

" grid.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check grid result                                                          */
/*----------------------------------------------------------------------------*/
: checkResult ( b n# t | ec n# f .... nn t/f )

tp: checkResult

  // was the final result true ?
  true == if  ( b n# t | ec n# f .... nn )

    // drop the rest of the result
    depth dropN ( )

  else
    // lets see which node failed
    0 do

      false == if  ( ... ec n# )

        swap error.msg swap
        grid::node node.name
        "%v ERROR: %v" str.format .

      else

        drop drop  ( ... )

      then

    loop

  then
;

/*----------------------------------------------------------------------------*/
/* print grid result                                                          */
/*----------------------------------------------------------------------------*/
: printResult ( s n# t | ec n# f .... nn t/f )

tp: printResult

  // was the final result true ?
  true == if ( s n# t | ec n# f .... nn )

    // pretty print the results resturned
    0 do  ( s n# t | s n# f .... )

      assert // should be true
      grid::node node.name "%v: %v"  str.format .
    loop

  else

    // lets see which node failed
    0 do  ( s n# t | ec n# f .... )

      false == if ( s n# t | ec n# )

        swap error.msg swap
        grid::node node.name
        "%v ERROR: %v" str.format .

      else

        drop drop

      then

    loop

  then

;

/*----------------------------------------------------------------------------*/
/* print grid result                                                          */
/*----------------------------------------------------------------------------*/
: printFile ( NodeObject n# t | ec n# f .... nn t/f )

  tp: printFile

  // was the final result true ?
  true == if ( s n# t | ec n# f .... nn )

    // pretty print the results resturned
    0 do  ( s n# t | s n# f .... )

      assert // should be true
      swap >object file.path@ swap
      "Node%v: %v"  str.format .
    loop

  else

    // lets see which node failed
    0 do  ( s n# t | ec n# f .... )

      false == if ( s n# t | ec n# )

        swap error.msg swap
        "Node%v ERROR: %v" str.format .

      else

        drop drop

      then

    loop

  then

;


////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* path for SE                                                                */
/*----------------------------------------------------------------------------*/
"../OS\\ X/Build/Products/Debug/SE" constant SE_PATH

/*----------------------------------------------------------------------------*/
/* form the shell command for spawning a node                                 */
/*----------------------------------------------------------------------------*/
: se_command ( nodeName clusterString -- "<command>" )

  locals| nodeName |
  locals| clusterString |

  to clusterString
  to nodeName

  //  "nohup "
  ""
  SE_PATH str.cat
  " --start " str.cat
  " --size " str.cat args.regionSize >str str.cat
  " --commands /Users/alkayamarti/rapidsSE/rapidsse/Commands" str.cat
  //" --commands /Users/ray/Desktop/rapidsse/Commands" str.cat
  clusterString str.cat
  " --regionPrefix " str.cat args.regionPrefix str.cat
  " --partitionsPerNode " str.cat args.partitionsPerNode >str str.cat
  " --name  " str.cat nodeName str.cat
  //" --partitionsPerNode " str.cat grid::slots >str str.cat
  args.tracepoint if " --tracepoint " str.cat then
  args.verbose if " --verbose " str.cat then
  args.dontFree if " --dontFree " str.cat then
  args.freeRB if " --freeRB " str.cat then
  args.metadata if " --metadata " str.cat then

  " &" str.cat
;

/*----------------------------------------------------------------------------*/
/* spawn all other nodes for a grid on this machine                           */
/*----------------------------------------------------------------------------*/
: spawnNodes ( -- )

  // test for single node
  grid::nodes 1 == if exit then

  // form the --node parameter string
  locals| clusterString |
  locals| node |

  ""

  grid::nodes 0 do
    I grid::node   ( node )
      to node
    node node.port
    node node.IP
    node node.name
    " --node %v %v %v " str.format
    str.cat
  loop

  to clusterString

  // spawn all other nodes
  grid::nodes 0 do

    // skip this node
    I grid::thisNode@ != if

      // form the shell command to spawn node I
      clusterString I grid::node node.name se_command

      // print the shell command
      dup .

      // execute the shell command
      shell.execute

      // check result
      not assert

    then

  loop

  //grid::thisNode@ grid::StartNode!
  grid::StartNode@ "Cluster Start node: %v" str.format .
;

/*----------------------------------------------------------------------------*/
/* set start node                                                             */
/*----------------------------------------------------------------------------*/
: setStartNode ( -- )

  // set this node as the grid start node
  grid::thisNode@ grid::StartNode!
;


/*----------------------------------------------------------------------------*/
/* check system has enough buffers                                            */
/*----------------------------------------------------------------------------*/
: checkEnoughBuffers

  // return true if enough buffers, others return error code
  bp::freeBuffers C_LOW_BUFFERS >
  if
    true
  else
     EC_LOW_BUFFERS
    false
  then
;

/*----------------------------------------------------------------------------*/
/* test system has enough buffers                                             */
/*----------------------------------------------------------------------------*/
: testEnoughBuffers

  // return true if enough buffers, others return error code
  bp::freeBuffers C_LOW_BUFFERS >
  if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/* grab lock on socket                                                        */
/*----------------------------------------------------------------------------*/
: socketLock ( -- )

  task::this task.sendNode@ node.sendSocket@ socket.grabWrite
;

/*----------------------------------------------------------------------------*/
/* drop lock on socket                                                        */
/*----------------------------------------------------------------------------*/
: socketUnlock ( -- )

  task::this task.sendNode@ node.sendSocket@ socket.dropWrite
;

/*----------------------------------------------------------------------------*/
/* send object across the socket                                              */
/*----------------------------------------------------------------------------*/
: >socketObject ( pObject -- )

  task::this task.sendNode@ node.sendSocket@

  tp: sending

  socket.sendObject ( bool )

  not if
    "send failure" .
  then
;

/*----------------------------------------------------------------------------*/
/* send valset across the socket                                              */
/*----------------------------------------------------------------------------*/
: >socketValSet ( valset -- )

  task::this task.sendNode@ node.sendSocket@

  tp: sending

  socket.sendValSet ( bool )

  not if
    "send failure" . ( 0/1 )
  then
;

/*----------------------------------------------------------------------------*/
/* recv object from the socket                                                */
/*----------------------------------------------------------------------------*/
: socketObject> ( -- pObject )

  task::this task.socket@

  tp: receiving

  socket.recvObject

  tp: received
;

/*----------------------------------------------------------------------------*/
/* recv valset from the socket                                                */
/*----------------------------------------------------------------------------*/
: socketValSet> ( -- valset )

  task::this task.socket@

  tp: receiving

  socket.recvValSet

  tp: received
;

/*----------------------------------------------------------------------------*/
/* send across the socket                                                     */
/*----------------------------------------------------------------------------*/
: >socket ( x -- )

  >socketObject
;

/*----------------------------------------------------------------------------*/
/* recv from the socket                                                       */
/*----------------------------------------------------------------------------*/
: socket> ( -- x )

  socketObject>
;

/*----------------------------------------------------------------------------*/
/* copy dictionary path from job to datastack                                 */
/*----------------------------------------------------------------------------*/
: getPath ( pJob -- )

  0 locals| pDicPathJob pJob |

  // get job dic path
  pJob job.dicPath to pDicPathJob

  // copy the path from job dic path onto data stack
  pDicPathJob dicPath.depth 0 ?do
    I pDicPathJob dicPath.pick
  loop

  pDicPathJob dicPath.depth
;

/*----------------------------------------------------------------------------*/
/* set dictionary path of this task back into session                         */
/*----------------------------------------------------------------------------*/
: savePath ( -- )

  0 0 locals| pDicStackSession pDicStackTask |

  // get session dic stack
  task::this task.session@ session.dicStack to pDicStackSession

  // get task dic stack
  task::this task.dicStack to pDicStackTask

  // copy the path from task dic stack onto data stack
  pDicStackTask dicStack.depth 0 ?do
  I pDicStackTask dicStack.pick
  loop

  // clear session dic stack
  pDicStackSession dicStack.dropAll

  // copy the path from data stack onto session dic stack
  pDicStackTask dicStack.depth 0 ?do
    pDicStackSession dicStack.push
  loop
;

/*----------------------------------------------------------------------------*/
/* test if this node is given originating node                                */
/*----------------------------------------------------------------------------*/
: isOriginNode ( iOriginNode -- true|false )

  params| iOriginNode |

  0 locals| iThisNode  |

  grid::thisNode@ to iThisNode

  iThisNode iOriginNode == if
    true
  else
    false
  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
