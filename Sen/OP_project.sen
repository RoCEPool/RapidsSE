/*============================================================================*/
/* OP_project.sen -- project                                                  */
/*============================================================================*/

" OP_project.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: project_StartMarker \handler

  ProjectRsb[].new
  Pot[].new

  Expr[].new
  ".src = @ 3 10 * ! 3 .dst" Expr[].source!
  Expr[].compile assert

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: project_PulseMarker \handler

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: project_StreamDef \handler

  ": project_StreamDef \handler" .

  StreamDef[].pipeIn

  StreamDef[].duplicate to OperandB[]
  OperandB[].pipeOut

  StreamDef[].print

  StreamDef[].duplicate to StreamDefOut[]
  StreamDefOut[].print

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: project_RsbBuffer \handler

  Operand[].pipeIn
  ProjectRsb[].project
  Operand[].delete

  Pot[].pipeoutAllCompleted

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: project_EosMarker \handler

  Pot[].pipeoutAllDangling

  ProjectRsb[].delete
  Expr[].delete
  Pot[].delete

  StreamDef[].delete
  StreamDefOut[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* project request                                                      SPAWN */
/*----------------------------------------------------------------------------*/
: project_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: project_EosMarker   ZK_EOSMARKER   op[].handler!
  find: project_PulseMarker ZK_PULSEMARKER op[].handler!
  find: project_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: project_StartMarker ZK_STARTMARKER op[].handler!
  find: project_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: project :: project ;

: project _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
