/*============================================================================*/
/* distExporter.sen -- distributed table exporter                             */
/*============================================================================*/

"distExporter.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distributed export                                                         */
/*----------------------------------------------------------------------------*/
: distExport ( "<fileNm>" ^table )

  true
;

/*----------------------------------------------------------------------------*/
/* distributed export                                                         */
/*----------------------------------------------------------------------------*/
: distTableExporter ( "<fileNm>" "<tableNm>" )

  0 locals| dexPlan |

  // push schema name
  2 pathPick dic.name  ( "<fileNm>" "<tableNm>" "<schemaNm>" )

  // push catalog name
  4 pathPick dic.name  ( "<fileNm>" "<tableNm>" "<schemaNm>" "<catalogNm>" )

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // prepare plan
  4  // 5 values to revers
  reverse  ( "<catalogNm>" "<schemaNm>" "<tableNm>" "<fileNm>" )
  dexPlanner to dexPlan

  //swap dexPlanner to dexPlan

  // set this task as the executing task in the plan
  task::this dexPlan plan.executingTask!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute (and compile) the plan
  dexPlan distributePlan

  // this task to wait for 1 ack
  1 setAcks

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // execute the plan
  dexPlan executePlan

  //"PlanTest waiting for ack" .

  // this task waits till ack'd by the responseOp
  ackWait

  //"PlanTest got ack" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reap the plan
  //dexPlan reapPlan


  true
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
