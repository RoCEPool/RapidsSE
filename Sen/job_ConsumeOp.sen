/*============================================================================*/
/* job_ConsumeOp.sen -- Job ConsumeOp                                         */
/*============================================================================*/

" job_ConsumeOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for consumeOp req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: consumeOp_req ( -- )

  >>logEntry <SEED_REQ>

  <consumeXmits> op.leftEndMarkers!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        //"Operand:- ZK_CRWBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_CSVBUFFER of
        //"Operand:- ZK_CSVBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_ENDMARKER of
        //"Operand:- ZK_ENDMARKER" .verbose
        Operand[].handleEnd
      endof

      ZK_ENTBUFFER of
        //"Operand:- ZK_ENTBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        Operand[].handleEnd
      endof

      ZK_IRWBUFFER of
        //"Operand:- ZK_IRWBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_SRTBUFFER of
        //"Operand:- ZK_SRTBUFFER" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        //Operand[].pipeOut
        Op.ackPipelineJob
        false
      endof

      ZK_STREAMDEF of
        //"Operand:- ZK_STREAMDEF" .verbose
        Operand[].workDone
        Operand[].pipeOut
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ConsumeOp :: ConsumeOp <consumeXmits> ;

jobInfo: ConsumeOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_CONSUMEOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
