/*============================================================================*/
/* job_ConsumeOp.sen -- Job ConsumeOp                                         */
/*============================================================================*/

" job_ConsumeOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for cancelQuery                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : Consume_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_ConsumeOp |

   tp: ConsumeOp_run

   pJob_ConsumeOp job.opLoop

   //pJob_ConsumeOp job::participantExecuted

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: Consume :: Consume ;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobInfo: Consume
{
  <?jobKind?>  = JK_OP
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
