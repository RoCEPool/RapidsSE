/*============================================================================*/
/* job_SnapshotOp.sen -- Job SnapshotOp                                       */
/*============================================================================*/

" job_SnapshotOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* SnapshotOp request                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
: SnapshotOp_req ( -- )

  >>logEntry <SEED_REQ>

  0 locals| pTable |

  job::this locals| pJob_SnapshotOp |
  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_PULSEMARKER of

        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut

        // new a stream def
        Operand[].newStreamDef
        Operand[].pipeOut

        // grab a read lock onn the table ptn
        tablePtn[].get tablePtnGrabRead2

        // begin a read transaction
        tx[].begin

        // pipeout all subsets from tablePtn
        tablePtn[].root to Subset[]
        Subset[]@ to Operand[]
        begin
          Operand[].isNull
        not while
          Operand[].get crwBuffer.snapshot Op::pipeOut
          nullptr Operand[].set
          Subset[].nextBuffer to Operand[]
        repeat

        // end a read transaction
        tx[].commit

        // drop the read lock on the table ptn
        tablePtn[].get tablePtnDropRead2

        Operand[].newEosMarker
        Operand[].pipeOut
        true

      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose

        // check if we can scan the table
        sTableNm checkIsValidTable not if
          op.pipelineJob@ <ERROR_JOB> !!logError
          Operand[].delete
          Operand[].newErrorMarker
        else

          // move to table folder and find the table and tablePtn
          sTableNm pushTable assert
          sTableNm find execute to table[]
          table[].tablePtn@ to tablePtn[]
        then

        Operand[].pipeOut
        true
      endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: SnapshotOp :: SnapshotOp <tableNm> <topology> <nextStage> <nextOp> ;

jobInfo: SnapshotOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SNAPSHOTOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
