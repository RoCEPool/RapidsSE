/*============================================================================*/
/* job_Prompt.sen -- Job Prompt                                               */
/*============================================================================*/

"job_Prompt.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute Job_Prompt job                                                     */
/*----------------------------------------------------------------------------*/
: Job_Prompt.execute ( pJob_Prompt -- str t/f )

  params| pJob_Prompt |

  CN_JOB_SPACE pJob_Space object.assertClass

  "PromptR35" .

  grid::thisNode@ pJob_Space job.response!

  pJob_Prompt job.notice
;

