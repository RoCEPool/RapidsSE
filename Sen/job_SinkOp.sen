/*============================================================================*/
/* job_SinkOp.sen -- Job SinkOp                                               */
/*============================================================================*/

" job_SinkOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for sinkOp request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sinkOp_req ( -- )

  >>logEntry <SEED_REQ>

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    Operand[].kind ZK_ENDMARKER == if
      Operand[].pipeToJob
      Operand[].newStopMarker
      Operand[].pipeOut
      Op.ackPipelineJob
      false
    else
      Operand[].delete
      true
    then

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: sinkOp :: sinkOp ;

jobInfo: sinkOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SINKOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
