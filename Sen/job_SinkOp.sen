/*============================================================================*/
/* job_SinkOp.sen -- Job SinkOp                                               */
/*============================================================================*/

" job_SinkOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for sinkOp request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sinkOp_req ( -- )

  >>logEntry <SEED_REQ>

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CRWBUFFER of
        //"jobOperand::generic: ZK_CRWBUFFER" .verbose
        Operand[].delete
        true
      endof

      ZK_CSVBUFFER of
        //"jobOperand::generic: ZK_CSVBUFFER" .verbose
        Operand[].delete
        true
      endof

      ZK_ENTBUFFER of
        //"jobOperand::generic: ZK_ENTBUFFER" .verbose
        Operand[].delete
        true
      endof

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        Operand[].delete
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_IRWBUFFER of
        //"jobOperand::generic::- ZK_IRWBUFFER" .verbose
        Operand[].delete
        true
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].delete
        true
      endof

      ZK_SRTBUFFER of
        //"jobOperand::generic: ZK_SRTBUFFER" .verbose
        Operand[].delete
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        Operand[].delete
        Operand[].newStartedMarker
        Operand[].pipeOut
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        Operand[].pipeToJob
        Operand[].newStoppedMarker
        Operand[].pipeOut
        Op.ackPipelineJob
        false
      endof

      ZK_STREAMDEF of
        //"jobOperand::generic:- ZK_STREAMDEF" .verbose
        Operand[].delete
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: sinkOp :: sinkOp <topology> <nextStage> <nextOp> ;

jobInfo: sinkOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SINKOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
