/*============================================================================*/
/* job_SinkOp.sen -- Job SinkOp                                               */
/*============================================================================*/

" job_SinkOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for sinkOp request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sinkOp_req ( -- )

  >>logEntry <SEED_REQ>

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // link sinkOp to next stage
  op.linkNextStage

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    Operand[].kind ZK_EOSMARKER == if
      //"Operand:- ZK_EOSMARKER" .verbose
      Operand[].delete
      true
    else

    Operand[].kind ZK_PULSEMARKER == if
      //"Operand:- ZK_PULSEMARKER" .verbose
      Operand[].delete
      true
    else

    Operand[].kind ZK_ERRORMARKER == if
      //"Operand:- ZK_ERRORMARKER" .verbose
      Operand[].newStopMarker
      Operand[].pipeOut
      Op.ackPipelineJob
      false
    else

    Operand[].kind ZK_STARTMARKER == if
      //"Operand:- ZK_STARTMARKER" .verbose
      Operand[].delete
      Operand[].newStartedMarker
      Operand[].pipeOut
      true

    else
    Operand[].kind ZK_STOPMARKER == if
      //"Operand:- ZK_STOPMARKER" .verbose
      Operand[].delete
      Operand[].newStoppedMarker
      Operand[].pipeOut
      Op.ackPipelineJob
      false
    else
      Operand[].delete
      true

    then then then then then

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: sinkOp :: sinkOp <topology> <nextStage> ;

jobInfo: sinkOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_SINKOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
