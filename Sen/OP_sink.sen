/*============================================================================*/
/* OP_sink.sen -- Operator sink                                               */
/*============================================================================*/

" OP_sink.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: sinkOp_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose
  Operand[].pipeToJob
  Operand[].newStoppedMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: sinkOp_ErrorMarker \handler

  //"jobOperand::generic:- ZK_ERRORMARKER" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: sinkOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  Operand[].delete
  Operand[].newStartedMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: sinkOp_StopMarker \handler

  //"Operand:- ZK_STOPMARKER" .verbose
  Operand[].pipeToJob
  Operand[].newStoppedMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_Xyz ...                                                     */
/*----------------------------------------------------------------------------*/
: sinkOp_Xyz \handler

  // delete all operands
  operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* execute for sinkOp request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sinkOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sinkOp_Xyz op[].handlerAll!

  find: sinkOp_CancelMarker ZK_CANCELMARKER op[].handler!
  find: sinkOp_ErrorMarker ZK_ERRORMARKER op[].handler!
  find: sinkOp_StartMarker ZK_STARTMARKER op[].handler!
  find: sinkOp_StopMarker  ZK_STOPMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: sinkOp :: sinkOp ;

: sinkOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
