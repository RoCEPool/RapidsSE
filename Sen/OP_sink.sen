/*============================================================================*/
/* OP_sink.sen -- Operator sink                                               */
/*============================================================================*/

" OP_sink.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: sinkOp_ErrorMarker \handler

  //"jobOperand::generic:- ZK_ERRORMARKER" .verbose
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: sinkOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  Operand[].delete
  Operand[].newStartedMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: sinkOp_StopMarker \handler

  //"Operand:- ZK_STOPMARKER" .verbose
  Operand[].pipeToJob
  Operand[].newStoppedMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;


/*----------------------------------------------------------------------------*/
/* execute for sinkOp request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sinkOp_req ( -- )

  LogReqEntry SEED_REQ

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_ERRORMARKER of sinkOp_ErrorMarker endof

      ZK_STARTMARKER of sinkOp_StartMarker endof

      ZK_STOPMARKER  of sinkOp_StopMarker endof

      Operand[].delete
      true
      swap

    endcase

  while assert::stack_0 repeat

  LogReqExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
opSyntax: sinkOp :: sinkOp ;

jobInfo: sinkOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
