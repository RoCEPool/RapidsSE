/*============================================================================*/
/* actorModels.sen -- actor models group                                      */
/*============================================================================*/

int:  queryCount

"actorModels.sen" .verbose

"droneModel.sen" include
"serverModel.sen" include
"workerModel.sen" include
"partitionModel.sen" include


"actorPrimitives.sen" include

"coordinatorWorker.sen" include
"participantProxyWorker.sen" include
"coordinatorProxyWorker.sen" include
"participantWorker.sen" include
"receiverDrone.sen" include
"senderWorker.sen" include

"connectorDrone.sen" include
"answerDrone.sen" include
"listerDrone.sen"  include
"monitorDrone.sen" include
"reclaimDrone.sen" include

"requestServer.sen" include

"gridActors.sen" include
"ddlLocking.sen" include

/*----------------------------------------------------------------------------*/
/* called by RapidsSE::vStartActors                                           */
/*----------------------------------------------------------------------------*/
: startActors

  "startActors" .verbose

  args.bgtasks if

    snooze startServerThreads
    snooze startPartitionThreads

    snooze spawnListerDrone
    snooze spawnMonitorDrone
    //snooze spawnReclaimDrone

    snooze spawnAnswerDrone

  then

  //dic.main true dic.frozen!

;

