/*============================================================================*/
/* job_ListPartitions.sen -- Job list partitions                              */
/*============================================================================*/

" job_ListPartitions.sen" .verbose

/*----------------------------------------------------------------------------*/
/* list partitions requests (on originating node)                             */
/*----------------------------------------------------------------------------*/
: listPartitions_req ( -- <R> )

  >>logEntry <SEED_REQ>

  0 0 locals| pJob_ListPartitions pTask |

  tp: listPartitions_req

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_ListPartitions

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    "(NodeName VARCHAR, partitionNumber INTEGER)"
    pJob_ListPartitions job.metadata!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // distribute the job
  pJob_ListPartitions job.distribute

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* get space in the pool (executed on all nodes)                              */
/*----------------------------------------------------------------------------*/
: listPartitions_exe ( pJob_ListPartitions -- )

  >>logEntry <SEED_EXE>

  //params| pJob_Space |
  job::this locals| pJob_ListPartitions |

  CN_JOB_LISTPARTITIONS pJob_ListPartitions object.assertClass

  ""   // intialize the string
  grid::slots 0 do
    I 0 != if "\n" str.cat then
    I grid::toPartition
    I grid::toPartition grid::toNode grid::toNode grid::node node.name
    "row: ( %v, %v )" str.format str.cat
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set response in job
  pJob_ListPartitions job.response!
  grid::slots pJob_ListPartitions job.rowsProcessed!

  pJob_ListPartitions job.notice

  pJob_ListPartitions job::participantExecuted

  <<logExit <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: listPartitions_beg ( -- )

  >>logEntry <SEED_BEG>

  job::this locals| pJob_ListPartitions |

  pJob_ListPartitions job.becomeParticipant

  job::participantBegun

  <<logExit <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: listPartitions_end ( -- )

  >>logEntry <SEED_END>

  ">> listPartitions_end <<" .verbose

  job::participantEnded

  <<logExit <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: listPartitions_can ( -- )

  >>logEntry <SEED_CAN>

  ">> listPartitions_can <<" .verbose

  job::participantCancelled

  <<logExit <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
