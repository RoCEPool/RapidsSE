/*============================================================================*/
/* job_ListPartitions.sen -- Job list partitions                              */
/*============================================================================*/

" job_ListPartitions.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get space in the pool (executed on all nodes)                              */
/*----------------------------------------------------------------------------*/
: listPartitions::execute _eeh ( -- )

  job[] locals| pJob_ListPartitions |

  ""   // intialize the string
  grid::slots 0 do
    I 0 != if "\n" str.cat then
    I grid::toPartition
    I grid::toPartition grid::toNode grid::toNode grid::node node.name
    "row: ( %v, %v )" str.format str.cat
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set response in job
  pJob_ListPartitions job.response!
  grid::slots pJob_ListPartitions job.rowsProcessed!

;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

opSyntax: listPartitions :: lspart ;

jobInfo: listPartitions
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_DIST2PC
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_NONE
  
  <preCheck> = bClusterStarted
}
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
