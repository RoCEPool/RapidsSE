/*============================================================================*/
/* OP_receiver.sen -- Operator receiver                                       */
/*============================================================================*/

" OP_receiver.sen" .verbose

/*----------------------------------------------------------------------------*/
/* receiver init                                                              */
/*----------------------------------------------------------------------------*/
: receiver_init ( -- )

  CN_JOB_LOCAL task[] task.thread thread.dedicated!

  NS_ACTIVE grid::thisNode@ grid::node node.state!

  args.verbose if
    grid::thisNode@ "receiver running on node %v" .printf
  then
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: receiver_loop ( -- )

  0 locals| pReceivedJob |
  0 locals| pOperand     |
  0 locals| pSendWith    |
  0 locals| pSocket      |
  0 locals| bRecvd       |
  0 locals| pTask        |
  0 locals| pParentJob   |

  "<ansNode>" job[] job.tagSet@ tagSet.hasName assert

  <ansNode> >int >ptr node.recvSocket@ to pSocket

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    trap::stackDepthZero

    // -- -- -- -- -- -- -- --
    // recv job

    pSocket socket.recvObject

    not if
      //ifAgain
      "receiver exiting" .
      exit
    then

    to pReceivedJob

    // -- -- -- -- -- -- -- --
    // log received job

    //pReceivedJob job_receiver::jobReceived

    // -- -- -- -- -- -- -- --
    // run post receive function

    pReceivedJob job.postRecv

    // -- -- -- -- -- -- -- --
    // recv operand

    pReceivedJob job.hasOperand if
      pSocket socket.recvObject discard to pOperand
      pOperand pReceivedJob job.operand!
    then

    // -- -- -- -- -- -- -- --
    // examine job
    //pReceivedJob job.kind@ JK_GENERIC == if
    //"received a generic job" .
    //  pReceivedJob job.tagSet@ tagSet.asStr .
    //then

    // -- -- -- -- -- -- -- --
    // dispatch job

    pReceivedJob job.jobClass CN_JOB_OPERAND == if
/*
      // get the parent (pipeline) job of the operand
      pReceivedJob Job_operand.parentJob@ to pParentJob

      // wait till the parent job is executing
      begin
        pParentJob job.phase@ JP_EXECUTING == not
      while
       //pParentJob job.phase@ "Job phase %v" .printf
       task::yield
      repeat

      // get the task of the parent (pipeline) job
      pParentJob job.task@ to pTask

      // wait till the parent (pipeline) job is in a WAIT state
      begin
        pTask task.isWaiting
      not while
        //pTask task.state@ "Task state %v" .printf
        task::yield
      repeat
*/
      // now pipe out the operand
      pReceivedJob Job_operand.pipeOut

    else
      //pReceivedJob job.name@ grid::thisNodeName@ "(%v) receiver_loop %v" .printf
      pReceivedJob job.seedDecode
      pReceivedJob job.seed!
      pReceivedJob job.spawn_received
    then

  again
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: receiver_StartMarker \handler

  // initialise
  receiver_init

  // loop, receiving and executing jobs
  receiver_loop

  // should never exit
  //hazard

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute for receiver req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : receiver_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: receiver_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: receiver :: receiver ;

: receiver _cmdTags tagCopy: serviceOp_tags
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
