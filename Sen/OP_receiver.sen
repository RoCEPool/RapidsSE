/*============================================================================*/
/* OP_receiver.sen -- Operator receiver                                       */
/*============================================================================*/

" OP_receiver.sen" .verbose

/*----------------------------------------------------------------------------*/
/* receiver init                                                              */
/*----------------------------------------------------------------------------*/
: receiver_init ( -- )

  CN_JOB_LOCAL task[] task.thread thread.dedicated!

  NS_ACTIVE grid::thisNode@ grid::node node.state!

  args.verbose if
    grid::thisNode@ "receiver running on node %v" .printf
  then
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: receiver_loop ( -- )

  0 locals| pReceivedObject |
  0 locals| pOperand        |
  0 locals| pSendWith       |
  0 locals| pSocket         |
  0 locals| bRecvd          |
  0 locals| pTask           |
  0 locals| pParentJob      |

  "<ansNode>" job[] job.tagSet@ tagSet.hasName assert

  <ansNode> >int >ptr node.recvSocket@ to pSocket

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    trap::stackDepthZero

    // -- -- -- -- -- -- -- --
    // recv job

    pSocket socket.recvObject

    not if
      //ifAgain
      "receiver exiting" .
      exit
    then

    to pReceivedObject

    // -- -- -- -- -- -- -- --
    // log received job

    //pReceivedJob job_receiver::jobReceived

    // -- -- -- -- -- -- -- --
    // run post receive function



    // -- -- -- -- -- -- -- --
    // recv operand

    pReceivedObject object.class@ CN_XMITOPERAND == if
      pSocket socket.recvObject discard to pOperand
      pOperand pReceivedObject xmitOperand.operand!
      pReceivedObject xmitOperand.pipeOut
    else

    // -- -- -- -- -- -- -- --
    // examine job
    //pReceivedJob job.kind@ JK_GENERIC == if
    //"received a generic job" .
    //  pReceivedJob job.tagSet@ tagSet.asStr .
    //then

    pReceivedObject job.postRecv
      //pReceivedJob job.name@ grid::thisNodeName@ "(%v) receiver_loop %v" .printf
      pReceivedObject job.seedDecode
      pReceivedObject job.seed!
      pReceivedObject job.spawn_received
    then

  again
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: receiver_StartMarker \handler

  // initialise
  receiver_init

  // loop, receiving and executing jobs
  receiver_loop

  // should never exit
  //hazard

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute for receiver req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : receiver_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: receiver_StartMarker ZK_STARTMARKER op[].handler!

  // get the pipeline job of the operator
  Op.pipelineJob@ locals| pPipelineJob |

 // peek to see if any operand
  begin
    Pipein[].peek
  not while
    "receiver waiting for STARTMARKER..." .
    2 thread::sleepMsec
  repeat

  assert::stack_0

  // pop next operand from queue into PipeIn[]
  PipeIn[].next

  // execute the operator's handler for the operand
  PipeIn[].kind op[].handler@ execute

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: receiver :: receiver ;

: receiver _cmdTags tagCopy: serviceOp_tags
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
