/*============================================================================*/
/* OP_join.sen -- join                                                        */
/*============================================================================*/

" OP_join.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: join_StartMarker \handler

  ProjectRsb[].new
  Pot[].new

  Expr[].new
  "= @ 3 10 * ! 3" Expr[].source!
  Expr[].compile assert

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: join_PulseMarker \handler

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: join_StreamDef \handler

  ": join_StreamDef \handler" .

  StreamDef[].pipeIn

  StreamDef[].duplicate to OperandB[]
  OperandB[].pipeOut

  StreamDef[].print

  StreamDef[].duplicate to StreamDefOut[]
  StreamDefOut[].print

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_RSBBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: join_RsbBuffer \handler

  Operand[].pipeIn
  ProjectRsb[].project
  Operand[].delete

  Pot[].pipeoutAllCompleted

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: join_EosMarker \handler

  Pot[].pipeoutAllDangling

  ProjectRsb[].delete
  Expr[].delete
  Pot[].delete

  StreamDef[].delete
  StreamDefOut[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* project request                                                      SPAWN */
/*----------------------------------------------------------------------------*/
: join_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: join_EosMarker   ZK_EOSMARKER   op[].handler!
  find: join_PulseMarker ZK_PULSEMARKER op[].handler!
  find: join_RsbBuffer   ZK_RSBBUFFER   op[].handler!
  find: join_StartMarker ZK_STARTMARKER op[].handler!
  find: join_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: join :: join <tableNm> <indexNm> ;

: join _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
