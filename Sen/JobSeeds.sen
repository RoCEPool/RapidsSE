/*============================================================================*/
/* jobSeeds.sen -- Default Job Seeds                                          */
/*============================================================================*/

" jobSeeds.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request default                                      (on originating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _req ( -- )

  [ compiler::current word.name@ , ] .

  <jobNm> .

  // distribute the job to all connected node as a participant
  job::distribute

  // wait for the 1 ack from deciding job__Ended
  task::wait
;

/*----------------------------------------------------------------------------*/
/* begin default                                 (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _beg ( -- )

  [ compiler::current word.name@ , ] .

  <jobNm> "::checkResources" str.cat find dup if
    execute
  else
    drop
  then
;

/*----------------------------------------------------------------------------*/
/* execute default                               (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _exe

  [ compiler::current word.name@ , ] .

  <jobNm> "::execute" str.cat find dup if
    execute
  else
    drop
  then
;

/*----------------------------------------------------------------------------*/
/* end default                                   (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _end ( -- )

  [ compiler::current word.name@ , ] .

  <jobNm> "::releaseResources" str.cat find dup if
    execute
  else
    drop
  then
;

/*----------------------------------------------------------------------------*/
/* cancel default                                (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _can ( -- )

  [ compiler::current word.name@ , ] .

  <jobNm> "::releaseResources" str.cat find dup if
    execute
  else
    drop
  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
