/*============================================================================*/
/* jobSeeds.sen -- Default Job Seeds                                          */
/*============================================================================*/

" jobSeeds.sen" .verbose

/*----------------------------------------------------------------------------*/
/* request default                                      (on originating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _req ( -- )

  [ compiler::current word.name@ , ] .

  <jobNm> .

  // add job to originator list
  job::becomeOriginator

  // distribute the job to all connected node as a participant
  job::distribute

  // wait for the 1 ack from deciding job__ended
  task::wait

  //job::this job.removeOriginator

  //"Signalling waiting thread" .
  job::this job.signalWaiter
;

/*----------------------------------------------------------------------------*/
/* begin default                                 (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _beg ( -- )

  [ compiler::current word.name@ , ] .

  JP_BEGINNING job::this job.phase!

  job::pathSet

  job::becomeParticipant

  <jobNm> "::checkResources" str.cat find dup if
    execute
  else
    drop
  then

  JP_BEGUN job::this job.phase!

  job::participantBegun                                       // send job__begun
;

/*----------------------------------------------------------------------------*/
/* execute default                               (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _exe

  [ compiler::current word.name@ , ] .

  JP_EXECUTING job::this job.phase!

  job::acquireExeLock

  <jobNm> "::execute" str.cat find dup if
    execute
  else
    drop
  then

  JP_EXECUTED job::this job.phase!

  job::this job::participantExecuted                       // send job__executed
;

/*----------------------------------------------------------------------------*/
/* end default                                   (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _end ( -- )

  [ compiler::current word.name@ , ] .

  JP_ENDING job::this job.phase!

  <jobNm> "::releaseResources" str.cat find dup if
    execute
  else
    drop
  then

  JP_ENDED job::this job.phase!

  //job::this job.removeParticipant

  job::participantEnded                                       // send job__ended
;

/*----------------------------------------------------------------------------*/
/* cancel default                                (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeed _can ( -- )

  [ compiler::current word.name@ , ] .

  JP_CANCELING job::this job.phase!

  <jobNm> "::releaseResources" str.cat find dup if
    execute
  else
    drop
  then

  JP_CANCELED job::this job.phase!

  //job::this job.removeParticipant

  job::participantCancelled                               // send job__cancelled
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
