/*============================================================================*/
/* jobSeeds.sen -- Default Job Seeds                                          */
/*============================================================================*/

" jobSeeds.sen" .verbose


/******************************************************************************/
/**                                LOCAL JOBS                                **/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* request default                                      (on originating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedLocal _req ( -- )

  task::seedInitially

  [ compiler::current word.name@ , ] .

  <jobNm> .

  task::doneFinally

  //"Signalling waiting thread" .
  job::this job.signalWaiter

  HAZARD
;


/******************************************************************************/
/**                             DISTRIBUTED JOBS                             **/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/***                          - Originating Node -                          ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* request default                                      (on originating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _req ( -- )

  task::seedInitially

  [ compiler::current word.name@ , ] .

  <jobNm> .

  job::becomeOriginator

  job::distributeConnected

  // wait for the signal from deciding job__ended/cancelled
  task::wait

  //job::this job.removeOriginator  // this is currently being done by job_ended

  task::doneFinally

  //"Signalling waiting thread" .
  job::this job.signalWaiter

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                       - Participating Nodes -                          ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* begin default                                 (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _beg ( -- )

  task::seedInitially

  [ compiler::current word.name@ , ] .

  JP_BEGINNING job::this job.phase!

  //job::pathSet
  //pushPath strVec::toPath to <path>
  <path> str.toStrVec task::dicStack.set

  job::becomeParticipant

  <jobNm> "::checkResources" str.cat find dup if
    execute
  else
    drop
  then

  JP_BEGUN job::this job.phase!

  2pcReply::job__begun

  task::doneFinally
;

/*----------------------------------------------------------------------------*/
/* execute default                               (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _exe

  task::seedInitially

  [ compiler::current word.name@ , ] .

  JP_EXECUTING job::this job.phase!

  // ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !
  // set task's dictionary stack from path in job

  <path> str.toStrVec task::dicStack.set
  //task::dump

  job::acquireDdlLock

  <jobNm> "::execute" str.cat find dup if
    execute
  else
    drop
  then

  JP_EXECUTED job::this job.phase!

  2pcReply::job__executed

  task::doneFinally
;

/*----------------------------------------------------------------------------*/
/* end default                                   (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _end ( -- )

  task::seedInitially

  [ compiler::current word.name@ , ] .

  JP_ENDING job::this job.phase!

  <jobNm> "::releaseResources" str.cat find dup if
    execute
  else
    drop
  then

  JP_ENDED job::this job.phase!

  job::this job.removeParticipant

  2pcReply::job__ended

  task::doneFinally
;

/*----------------------------------------------------------------------------*/
/* cancel default                                (on each participating node) */
/*----------------------------------------------------------------------------*/
: defaultSeedDist _can ( -- )

  task::seedInitially

  [ compiler::current word.name@ , ] .

  JP_CANCELING job::this job.phase!

  <jobNm> "::releaseResources" str.cat find dup if
    execute
  else
    drop
  then

  JP_CANCELED job::this job.phase!

  job::this job.removeParticipant

  2pcReply::job__cancelled

  task::doneFinally
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
