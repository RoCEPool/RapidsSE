/*============================================================================*/
/* requests_catalog.sen -- the set of catalog related requests                */
/*============================================================================*/

" requests_catalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a catalog                                                           */
/*----------------------------------------------------------------------------*/
/*
: createCatalog_req ( "<catalogNm>" -- <R> )

  tp: createCatalog

  ddlLock::grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeCatalog   not if <NIP+ERROR> exit then

  makeCatalog ( ) assert::stack_0

  tp: createdCatalog

  <OK>
;
*/
/*----------------------------------------------------------------------------*/
/* drop a catalog                                                             */
/*----------------------------------------------------------------------------*/
/*
: dropCatalog_req ( "<catalogNm>" -- <R> )

  tp: dropCatalog

  ddlLock::grabWrite

  checkRemoveCatalog not if <NIP+ERROR> exit then

  removeCatalog ( ) assert::stack_0

  tp: droppedCatalog

  <OK>
;
*/

/*----------------------------------------------------------------------------*/
/* get list of catalogs                                                       */
/*----------------------------------------------------------------------------*/
/*
: listCatalogs_req ( -- sCatalogList <R> )

  ddlLock::grabRead

  checkInCatalogs not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;
*/
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
