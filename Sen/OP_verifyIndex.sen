/*============================================================================*/
/* OP_verifyIndex.sen -- Operator verify index                                */
/*============================================================================*/

" OP_verifyIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: vfyidx_action

  <tableNm> <indexNm> op__table_index not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeOut

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  index[].verify

  // insert index verify
  index[] streamSetTable[] StreamSet[].addVerifyIndex assert

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: vfyidx :: vfyidx <tableNm> <indexNm> ;

: vfyidx _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __verifyIndex
    <params>    = 2
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
