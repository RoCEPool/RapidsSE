/*============================================================================*/
/* loader.sen -- Parallel Table Loader                                        */
/*============================================================================*/

"loader.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a loader using name on the stack (leaves loader on stack)           */
/*----------------------------------------------------------------------------*/
: :loader

  >create
  WT_OBJECT word.this word.type!
  sizeof_loader allot
  word.this >body object.magic!
  CN_LOADER word.this >body object.class!
  word.this >body loader.init
  true word.this >body object.wordbody!
  word.this
  does>
;

timer: loadTimer

/*----------------------------------------------------------------------------*/
/* parallel loading of file into table                                        */
/*----------------------------------------------------------------------------*/
: tableLoader ( "<path>" "<tableNm>" -- t|f )

  find execute ( "<path>" table )

  // check if path file exists
  swap ( table "<path>" )
  file.new >r ( table "<path>" ; r0: fp )
  dup r0 file.path! ( table "<path>" ; r0: fp )
  OPEN_READ r0 file.open ( table "<path>" t|f ; r0: fp )
  if
    r0 file.close r0 file.delete rdrop swap ( "<path>" table )
  else
    r0 file.delete rdrop drop drop EC_INVALID_FILE false exit
  then

  loadTimer timer.start

  // create a table loader
  "__table_loader" find dup if else
    drop
    "__table_loader" :loader
  then
  execute

  // put table loader into local
  locals| tblLoader |

  "in tableLoader" .
  assert::stack_2 ( "<path>" table )

  // initialise r0:Loader
  tblLoader loader.table! ( "<path>" )
  tblLoader loader.path!

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // begin a new transaction
  beginTransaction tblLoader loader.txref!

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::this grabMutex

  N_GENERAL_THREADS setAcks

  N_GENERAL_THREADS 0 do

    << tblLoader loader.newSub >>

    pathGet >>

    1 "loadSub" task::this task::new

    dup I >loadSubNm swap task.name!

    I >genTaskSet taskSet.append
  loop

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin tblLoader loader.findChunk while repeat


  ackWait

  task::this dropMutex

  //- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // commit the transaction
  commitTransaction

  // destroy Loader
  "__table_loader" find word.forget

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  true
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream ( "<path>" ^table -- t|f )

  // check if path file exists
  swap file.new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  reg.push

  file.new >reg0         // reg0 - file
  >reg1                  // reg1 - table
  >reg2                  // reg2 - path
  rowBuffer.new >reg3    // reg3 - rowbuffer
  beginTransaction >reg4 // reg4 - txref
  0 >regF                // regF - counter

  reg2 reg0 file.path!
  OPEN_READ reg0 file.open drop

  loadTimer timer.start

  begin
    reg0 file.read
    while
      reg4 reg3 rowbuffer.append
      not if
        reg3 0 reg1 table.appendBuffer
        rowBuffer.new >reg3
        reg4 reg3 rowbuffer.append
        drop
      then

      regF 1+ dup >regF
      100000 % not if regF . then
  repeat

  reg3 0 reg1 table.appendBuffer

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  reg0 file.close

  reg0 file.delete

  reg.pop

  true
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream2 ( "<path>" ^table -- t|f )

  find execute ( "filename" table )

  // check if path file exists
  swap file.new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  reg.push

  file.new >reg0         // reg0 - file
  >reg1                  // reg1 - table
  >reg2                  // reg2 - path
  rowBuffer.new >reg3    // reg3 - rowbuffer
  beginTransaction >reg4 // reg4 - txref
  0 >regF                // regF - counter

  reg2 reg0 file.path!
  OPEN_READ reg0 file.open drop

  loadTimer timer.start

  begin
    reg0 file.readRecord
    while
      reg0 reg4 reg3 rowbuffer.appendRecord
      not if
        reg3 0 reg1 table.appendBuffer
        rowBuffer.new >reg3
        reg0 reg4 reg3 rowbuffer.appendRecord
        drop
      then

      regF 1+ dup >regF
      100000 % not if task.yield then
  repeat

  reg3 0 reg1 table.appendBuffer

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  reg0 file.close

  reg0 file.delete

  reg.pop

  true
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
