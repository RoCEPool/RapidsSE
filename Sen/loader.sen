/*============================================================================*/
/* loader.sen -- Parallel Table Loader                                        */
/*============================================================================*/

"loader.sen" .verbose

/*----------------------------------------------------------------------------*/
/* loading timer                                                              */
/*----------------------------------------------------------------------------*/
timer: loadTimer

/*----------------------------------------------------------------------------*/
/* create a loader using name on the stack (leaves loader on stack)           */
/*----------------------------------------------------------------------------*/
: :loader

  >create
  WT_OBJECT word.this word.type!
  sizeof_loader allot
  word.this >body object.magic!
  CN_LOADER word.this >body object.class!
  word.this >body loader.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* parallel loading of file into table                                        */
/*----------------------------------------------------------------------------*/
: tableLoader ( "<esc>" "<enc>" "<fs>" "<rt>" "<path>" "<tableNm>" -- t|f )

  //assert::stack_2 ( "<path>" "<tableNm>" )
  locals| sTableNm sPath sRT sFS sENC sESC |

  task::this task.seitf@ locals| pSEitf |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if path file exists                                 //! refactor this

  file::new locals| fp |
  sPath fp file.path!

  OPEN_READ fp file.open ( t|f )
  not if
    fp file.delete assert::stack_0 EC_INVALID_FILE false exit
  then

  fp file.close fp file.delete assert::stack_0

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create table loader

  // start load timer
  loadTimer timer.start

  // create table loader
  "__table_loader" find dup if else
    drop
    "__table_loader" :loader
  then
  execute locals| pTblLoader | assert::stack_0

  // set seitf in tblLoader
  pSEitf pTblLoader loader.seitf!

  // initialise table loader
  sTableNm find execute locals| pTable |

  // check if data is already loaded
  pTable table.dataLoaded@ if EC_TABLE_ALREADY_LOADED false exit then

  pTable pTblLoader loader.table!
  sPath  pTblLoader loader.path!
  sRT    pTblLoader loader.recordTerminator!
  sFS    pTblLoader loader.fieldSeparator!
  sENC   pTblLoader loader.enclosedBy!
  sESC   pTblLoader loader.escaoeChar!

  grid.slots pTable table.indexesLoaded!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create sub loaders

  // begin a transaction
  tx::begin pSEitf seitf.tx!

  // hold task mutex while we create sub loaders
  //task::this grabMutex

  // set no of subloaders in table
  //N_SERVER_THREADS pTable table.subLoaders
  N_SERVER_THREADS sTableNm setSubLoaders

  N_SERVER_THREADS setAcks

  // set acks remaining to be (no partitions)
  grid.slots grid.nodes * pSEitf seitf.acksRemaining!

  0 locals| pSubTask |

  N_SERVER_THREADS 0 do

    << pSEitf pTblLoader loader.newSub >>

    pathGet >>

    1 "loadSub" task::this I >loadSubNm TK_LOADSUB_SERVER spawnServerTask to pSubTask

  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // break file into chunks (this causes sub loaders to load them)

  // using table loader scan thru the file and find chunks for sub loaders
  begin pTblLoader loader.findChunk while repeat

  "Load file has been chunked" .verbose

  // now wait for sub loaders to complete (drops mutex for duration)
  ackWait

  // at this point all sub loaders have completed and mutex was regrabbed

  // drop mutex
  //task::this dropMutex

  // wait for other indexes to complete load
  begin
    pTable table.indexesLoaded@
    while
    1 thread.sleep_s
  repeat

  sTableNm "Table %v and its indexes loaded" str.format .verbose

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for all dist subloaders to finish : partitionAppendBuffer
  begin
    pSEitf seitf.acksRemaining@
    while
      1 thread.sleep_s
  repeat

  // mark data as being loaded in the table
  1 pTable table.dataLoaded!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up

  // commit the transaction
  //pSEitf seitf.tx@ tx.id "dist commit of " . .

  pSEitf seitf.tx@ tx.id txDistPrepare assert::stack_0

  pSEitf seitf.tx@ tx.id txDistCommit  assert::stack_0

  // destroy Loader
  "__table_loader" find word.forget

  // print timing
  loadTimer timer.update

  "ms\n" loadTimer timer.millisecs "Load time" "%v %v %v" str.format .verbose

  true
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream ( "<path>" ^table -- t|f )

  // check if path file exists
  swap file::new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  reg.push

  file::new >reg0        // reg0 - file
  >reg1                  // reg1 - table
  >reg2                  // reg2 - path
  rowBuffer::new >reg3   // reg3 - rowbuffer
  tx::begin >reg4        // reg4 - tx
  0 >regF                // regF - counter

  reg2 reg0 file.path!
  OPEN_READ reg0 file.open drop

  loadTimer timer.start

  begin
    reg0 file.read
    while
      reg4 reg3 rowbuffer.append
      not if
        reg3 0 reg1 table.appendBuffer
        rowBuffer::new >reg3
        reg4 reg3 rowbuffer.append
        drop
      then

      regF 1+ dup >regF
      100000 % not if regF . then
  repeat

  reg3 0 reg1 table.appendBuffer

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  reg0 file.close

  reg0 file.delete

  reg.pop

  true
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream2 ( "<path>" ^table -- t|f )

  find execute ( "filename" table )

  // check if path file exists
  swap file::new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  reg.push

  file::new >reg0        // reg0 - file
  >reg1                  // reg1 - table
  >reg2                  // reg2 - path
  rowBuffer::new >reg3   // reg3 - rowbuffer
  tx::begin >reg4        // reg4 - tx
  0 >regF                // regF - counter

  reg2 reg0 file.path!
  OPEN_READ reg0 file.open drop

  loadTimer timer.start

  begin
    reg0 file.readRecord
    while
      reg0 reg4 reg3 rowbuffer.appendRecord
      not if
        reg3 0 reg1 table.appendBuffer
        rowBuffer::new >reg3
        reg0 reg4 reg3 rowbuffer.appendRecord
        drop
      then

      regF 1+ dup >regF
      100000 % not if task.yield then
  repeat

  reg3 0 reg1 table.appendBuffer

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  reg0 file.close

  reg0 file.delete

  reg.pop

  true
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
