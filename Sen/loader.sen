/*============================================================================*/
/* loader.sen -- Parallel Table Loader                                        */
/*============================================================================*/

" loader.sen" .verbose

/*----------------------------------------------------------------------------*/
/* loading timer                                                              */
/*----------------------------------------------------------------------------*/
timer: loadTimer

/*----------------------------------------------------------------------------*/
/* create a loader using name on the stack (leaves loader on stack)           */
/*----------------------------------------------------------------------------*/
: :loader

  >create
  WT_OBJECT word.this word.type!
  sizeof_loader allot
  word.this >body object.magic!
  CN_LOADER word.this >body object.class!
  word.this >body loader.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* parallel loading of file into table (on a node)                            */
/*----------------------------------------------------------------------------*/
: parallelTableLoader ( "<seif>" "<iNode>" "fieldDelimiter>" "<catalog>" "<schema" "<tableNm>" "<sameMachine>" "<path>"  -- t|f )

  assert::stack_5+ ( "<seif>" "<iNode>" "<fieldDelimiter>" "<catalog>" "<schema" "<tableNm>" "<sameMachine>" "<path>" )
  0 locals| iSameMachine sPath sSameMachine sTableNm  sSchema sCatalog sFldDel iNode pSeitf |

tp: parallelTableLoader
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set the dictionary path for this table loader on this node

  "tenants" 1 dicStack.set

  "boray" find execute
  pathPush

  "catalogs"  find execute
  pathPush

  // push tableNm folder on the dictionary path
  sCatalog find execute
  pathPush

  // push tableNm folder on the dictionary path
  "schemas" find execute
  pathPush

  // push tableNm folder on the dictionary path
  sSchema find execute
  pathPush

  // push tableNm folder on the dictionary path
  "tables" find execute
  pathPush

  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if file path exists                                 //! refactor this

  //file::new locals| fp |
  //sPath fp file.path!

  //OPEN_READ fp file.open ( t|f )
  //not if
  //fp file.delete assert::stack_0 EC_INVALID_FILE false exit
  //then

  //fp file.close fp file.delete assert::stack_0

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create table loader object

  "__table_loader" find dup if else
  drop
  "__table_loader" :loader
  then
  execute locals| pTblLoader | assert::stack_0

  // initialise table loader
  sTableNm find execute locals| pTable |

  pTable pTblLoader loader.table!

  sSameMachine str.tailInt assert to iSameMachine
  iSameMachine if
    sPath  pTblLoader loader.pathDistributed!
  else
    sPath  pTblLoader loader.path!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create sub loaders

  N_SERVER_THREADS setAcks

  0 locals| pSubTask |
  0 locals| servers |
  N_SERVER_THREADS to servers

  popTable assertInTables

  // mark table is loading
  true pTable table.isLoading!

  servers 0 do

    << pTblLoader loader.newSub >>
    pathGet sFldDel >>

    1 "distLoadSub" task::this I >loadSubNm TK_LOADSUB_SERVER spawnServerTask to pSubTask

  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // break file into chunks (this causes sub loaders to load them)

  // chunk the file
  pTblLoader loader.chunkFile

  " Load file has been chunked.." .verbose

  // now wait for sub loaders to complete (drops mutex for duration)
  ackWait

  // at this point all sub loaders have completed and mutex was regrabbed

  sTableNm " Table %v and its indexes loaded" .verbose

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // send ack to seitf of the distParallel loader task on initiating node

  <<
  13
  pSEitf  >str      ( << pSEitf )
  grid::thisNode@
  "ackSEitf$"   ( << pSEitf "ackSEitf$" )

  tp: theIndirectCall

  >>            ( <<ackSEitf$>> )

  // to which node/participant
  iNode  ( <<ackSEitf$>> node )

  //"forwarding ackSEitf$ to coordinator..." .
  >>oneParticipant> ( bool )

  // mark table is not loading
  false pTable table.isLoading!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up

  // destroy Loader
  sTableNm pushTable assert
  "__table_loader" find word.forget

;

/*----------------------------------------------------------------------------*/
/* distributed parallel loading of file into table                            */
/*----------------------------------------------------------------------------*/
: distParallelTableLoader allParticipants 8 checkResult ( "<seitf>" iNode "<fieldDelimiter>" "<path>" "<sameMachine>" "<tableNm>" "<schema>" "<catalog>" -- t|f )

  args.tracepoint if
  dup "LOADING TABLE " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  0 locals| tableLoader sCat sSch sTableNm sSameMachine sPath sFldDel iNode pSeitf |

  tp: distParallelTableLoader

  pSeitf iNode sFldDel sCat sSch sTableNm sSameMachine sPath 8 "parallelTableLoader" task::this "distLoader" TK_LOADSUB_SERVER  spawnServerTask to tableLoader
  " distLoad done" .verbose

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* parallel loading of file into table                                        */
/*----------------------------------------------------------------------------*/
: tableLoader ( "<path>" "<tableNm>" -- t|f )

  assert::stack_2 ( "<path>" "<tableNm>" )
  locals| sTableNm sPath |

  task::this task.seitf@ locals| pSEitf |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if path file exists                                 //! refactor this

  file::new locals| fp |
  sPath fp file.path!

  OPEN_READ fp file.open ( t|f )
  not if
    fp file.delete assert::stack_0 EC_INVALID_FILE false exit
  then

  fp file.close fp file.delete assert::stack_0

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create table loader

  // start load timer
  loadTimer timer.start

  // create table loader
  "__table_loader" find dup if else
    drop
    "__table_loader" :loader
  then
  execute locals| pTblLoader | assert::stack_0
  //pathDump

  // set seitf in tblLoader
  pSEitf pTblLoader loader.seitf!

  // initialise table loader
  sTableNm find execute locals| pTable |

  pTable pTblLoader loader.table!
  sPath  pTblLoader loader.path!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create sub loaders

  // begin a transaction
  tx::begin pSEitf seitf.tx!

  // hold task mutex while we create sub loaders
  //task::this grabMutex

  N_SERVER_THREADS sTableNm setSubLoaders

  N_SERVER_THREADS setAcks

  // set acks remaining to be (no partitions)* subLoaders
  grid::slots grid::nodes N_SERVER_THREADS * * pSEitf seitf.acksRemaining!

  0 locals| pSubTask |
  0 locals| servers |
  N_SERVER_THREADS to servers

  popTable assertInTables

  // mark table is loading
  true pTable table.isLoading!

  servers 0 do

  << pSEitf pTblLoader loader.newSub >>

  pathGet >>

  1 "loadSub" task::this I >loadSubNm TK_LOADSUB_SERVER spawnServerTask to pSubTask

  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // break file into chunks (this causes sub loaders to load them)

  // chunk the file
  pTblLoader loader.chunkFile

  " Load file has been chunked" .verbose

  // now wait for sub loaders to complete (drops mutex for duration)
  ackWait

  // at this point all sub loaders have completed and mutex was regrabbed

  // drop mutex
  //task::this dropMutex

  sTableNm " Table %v and its indexes loaded" .verbose

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for all last buffer acks to come

  begin
    pSEitf seitf.acksRemaining@
    while
    1 thread.sleep_s
  repeat

  // mark table is not loading
  false pTable table.isLoading!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up

  // commit the transaction
  //pSEitf seitf.tx@ tx.id "dist commit of " . .

  pSEitf seitf.tx@ tx.id txDistPrepare assert::stack_0

  pSEitf seitf.tx@ tx.id txDistCommit  assert::stack_0

  // destroy Loader
  sTableNm pushTable assert
  "__table_loader" find word.forget

  // print timing
  loadTimer timer.update

  // put valid/invalid in seitf
  pTblLoader loader.recordsInvalid@ pSEitf seitf.rowsInvalid!
  pTblLoader loader.recordsValid@ pSEitf seitf.rowsValid!

  pTblLoader loader.recordsInvalid@ pTblLoader loader.recordsValid@ " loaded %v rows (%v invalid)" .verbose

  " ms\n" loadTimer timer.millisecs "Load time" "%v %v %v" .verbose

  true
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream ( "<path>" ^table -- t|f )

  // check if path file exists
  swap file::new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  reg.push

  file::new >reg0        // reg0 - file
  >reg1                  // reg1 - table
  >reg2                  // reg2 - path
  rowBuffer::new >reg3   // reg3 - rowbuffer
  tx::begin >reg4        // reg4 - tx
  0 >regF                // regF - counter

  reg2 reg0 file.path!
  OPEN_READ reg0 file.open drop

  loadTimer timer.start

  begin
    reg0 file.read
    while
      reg4 reg3 rowbuffer.append
      not if
        reg3 0 reg1 table.appendBuffer
        rowBuffer::new >reg3
        reg4 reg3 rowbuffer.append
        drop
      then

      regF 1+ dup >regF
      100000 % not if regF . then
  repeat

  reg3 0 reg1 table.appendBuffer

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  reg0 file.close

  reg0 file.delete

  reg.pop

  true
;

/*----------------------------------------------------------------------------*/
/* loading of stream into table                                               */
/*----------------------------------------------------------------------------*/
: tableLoaderStream2 ( "<path>" ^table -- t|f )

  find execute ( "filename" table )

  // check if path file exists
  swap file::new >r
  dup r0 file.path!
  OPEN_READ r0 file.open
  if r0 file.close rdrop swap else rdrop drop drop EC_INVALID_FILE false exit then

  reg.push

  file::new >reg0        // reg0 - file
  >reg1                  // reg1 - table
  >reg2                  // reg2 - path
  rowBuffer::new >reg3   // reg3 - rowbuffer
  tx::begin >reg4        // reg4 - tx
  0 >regF                // regF - counter

  reg2 reg0 file.path!
  OPEN_READ reg0 file.open drop

  loadTimer timer.start

  begin
    reg0 file.readRecord
    while
      reg0 reg4 reg3 rowbuffer.appendRecord
      not if
        reg3 0 reg1 table.appendBuffer
        rowBuffer::new >reg3
        reg0 reg4 reg3 rowbuffer.appendRecord
        drop
      then

      regF 1+ dup >regF
      100000 % not if task.yield then
  repeat

  reg3 0 reg1 table.appendBuffer

  loadTimer timer.update

  "Load time " .put
  loadTimer timer.millisecs .put "ms" .put .\n

  reg0 file.close

  reg0 file.delete

  reg.pop

  true
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
