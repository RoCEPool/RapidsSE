/*============================================================================*/
/* requestServer.sen -- request processing server                             */
/*============================================================================*/

"requestServer.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create the parts                                                           */
/*----------------------------------------------------------------------------*/

// create the request queue
queue: requestQueue

// create the root /tenants dictionary
//dic: tenants

/*----------------------------------------------------------------------------*/
/* copy dictionary path from seitf to this request task                       */
/*----------------------------------------------------------------------------*/
: getPath

  // local for task::this.seitf.dicStack
  task::this task.seitf@ seitf.dicStack
  locals| pDicStackSEitf |

  // local for task::this.dicStack
  task::this task.dicStack
  locals| pDicStackTask |

  // copy the path from seitf dic stack onto data stack
  pDicStackSEitf dicStack.depth 0 ?do
    I pDicStackSEitf dicStack.pick
  loop

  // clear this tasks dic stack
  pDicStackTask dicStack.dropAll
  //dicStackTask dicStack.dump

  // copy the path from data stack onto this task dic stack
  pDicStackSEitf dicStack.depth 0 ?do
    pDicStackTask dicStack.push
  loop
;

/*----------------------------------------------------------------------------*/
/* copy dictionary path from job to datastack                                 */
/*----------------------------------------------------------------------------*/
: getPathR35 ( pJob -- )

  0 0 locals| pDicPathJob pDicStackTask pJob |

  // get job dic path
  pJob job.dicPath to pDicPathJob

  // get task dic stack
  task::this task.dicStack to pDicStackTask

  // copy the path from job dic path onto data stack
  pDicPathJob dicPath.depth 0 ?do
    I pDicPathJob dicPath.pick
  loop

  pDicPathJob dicPath.depth
;

/*----------------------------------------------------------------------------*/
/* set dictionary path of this task back into seitf                           */
/*----------------------------------------------------------------------------*/
: savePathR35 ( -- )

  0 0 locals| pDicStackSEitf pDicStackTask |

  // get seitf dic stack
  task::this task.seitf@ seitf.dicStack to pDicStackSEitf

  // get task dic stack
  task::this task.dicStack to pDicStackTask

  // copy the path from task dic stack onto data stack
  pDicStackTask dicStack.depth 0 ?do
    I pDicStackTask dicStack.pick
  loop

  // clear seitf dic stack
  pDicStackSEitf dicStack.dropAll

  // copy the path from data stack onto seitf dic stack
  pDicStackTask dicStack.depth 0 ?do
    pDicStackSEitf dicStack.push
  loop
;

/*----------------------------------------------------------------------------*/
/* save dictionary path of this request task back into seitf                  */
/*----------------------------------------------------------------------------*/
: savePath

  // local for task::this.seitf.dicStack
  task::this task.seitf@ seitf.dicStack
  locals| pDicStackSEitf |

  // local for task::this.dicStack
  task::this task.dicStack
  locals| pDicStackTask |

  // copy the path from task dic stack onto data stack
  pDicStackTask dicStack.depth 0 ?do
    I pDicStackTask dicStack.pick
  loop

  // clear seitf dic stack
  pDicStackSEitf dicStack.dropAll

  // copy the path from data stack onto seitf dic stack
  pDicStackTask dicStack.depth 0 ?do
    pDicStackSEitf dicStack.push
  loop
;

/*----------------------------------------------------------------------------*/
/* process request from SEitf                                                 */
/*----------------------------------------------------------------------------*/
/*
: !req 

tp: !req

  // get the request from the task
  task::this task.request

  valset>

tp: valset

  // check stack
  depth 3 != if "incorrect request stack depth" . process.quit then
  0 stack.class CN_INTVAL != if "incorrect request value 0" . process.quit then
  1 stack.class CN_STRVAL != if "incorrect request value 1" . process.quit then
  2 stack.class CN_STRVAL != if "incorrect request value 2" . process.quit then

  // drop the count from stack
  drop

  // assert the task does not have an seitf
  task::this task.seitf@ not assert

  // execute the response return address (set SEitf in request task)
  >:

  // assert the task now has an seitf
  task::this task.seitf@ assert

  // assert no dictionary path
  task::this task.dicStack dicStack.depth not assert

  // copy dictionary path from seitf to this request task
  getPath

  >:   // decode/push the request

tp: !req_exit
;
*/
/*----------------------------------------------------------------------------*/
/* send response                                                              */
/*----------------------------------------------------------------------------*/
/*
: >rsp

  // check stack
  depth 3 != if "incorrect response stack depth" . process.quit then

  0 stack.class CN_INTVAL != if "incorrect response value 0" . process.quit then
  1 stack.class CN_INTVAL != if "incorrect response value 1" . process.quit then
  2 stack.class CN_STRVAL != if "incorrect response value 2" . process.quit then

  >valset

  savePath

  dicStack.clear

  //"rspque" find execute queue.append
  task::this task.seitf@ seitf.responseQueue queue.append

  // forget the seitf
  0 task::this task.seitf!
;
*/
/*----------------------------------------------------------------------------*/
/* drop response                                                              */
/*----------------------------------------------------------------------------*/
: responseDrop

  // check stack
  depth 3 != if "incorrect response stack depth" . process.quit then

  drop drop drop
;

/*----------------------------------------------------------------------------*/
/* request processing                                                         */
/*----------------------------------------------------------------------------*/
/*
: requestLoop

  requestQueue task::this task.jobQueue!

  requestServerPrint if
    "Request Server running..." .
  then

  depth 0 != if "request task has grown" . debug::trap then

  !req

  >rsp

  exit
;
*/
/*----------------------------------------------------------------------------*/
/* process a detached request (no response)                                   */
/*----------------------------------------------------------------------------*/
/*
: processRequest_detached

  requestQueue task::this task.jobQueue!  //! is this need in R3.5?

  requestServerPrint if
    "Request Server (detached) running..." .
  then

  depth 0 != if "request task has grown" . debug::trap then

  !req

  // drop the response
  responseDrop

  exit
;
*/
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
