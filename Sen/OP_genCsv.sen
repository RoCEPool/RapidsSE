/*============================================================================*/
/* OP_genCsv.sen -- Operator genCsv                                           */
/*============================================================================*/

" OP_genCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: genCsvOp_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // pipeout a single generated csv buffer
  //begin
  table[].get table.genCsvBuffer to Operand[]
  Operand[].pipeOut
  //false
  //while repeat

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: genCsvOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  // check if table exits
  <tableNm> checkIsValidTable not if
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
  else
    // move to table folder and find the table
    <tableNm> pushTable assert
    <tableNm> find execute to table[]
    Pipein[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* genCsvOp request                                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: genCsvOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: genCsvOp_PulseMarker ZK_PULSEMARKER op[].handler!
  find: genCsvOp_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  "*** GENCSVOP EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: genCsvOp :: genCsvOp <tableNm> ;

: genCsvOp opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
