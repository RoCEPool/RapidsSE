/*============================================================================*/
/* OP_genCsv.sen -- Operator genCsv                                           */
/*============================================================================*/

" OP_genCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: genCsv_DataPulse \handler

  //"Operand:- ZK_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // check for low memory
  attachMap::isLowMemory if
    EC_LOW_MEMORY
    op.pipelineJob@ ERROR_JOB
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // pipeout a single generated csv buffer
  //begin
  Table[].genCsvBuffer to Operand[]
  Operand[].pipeOut
  //false
  //while repeat

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: genCsv_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  // check if table exits
  <tableNm> op__table if
    PipeIn[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* genCsv request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: genCsv_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: genCsv_DataPulse ZK_DATAPULSE op[].handler!
  find: genCsv_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  "*** GENCSV EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: genCsv :: genCsv <tableNm> ;

: genCsv _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
