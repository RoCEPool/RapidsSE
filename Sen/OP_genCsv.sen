/*============================================================================*/
/* OP_genCsv.sen -- Operator genCsv                                           */
/*============================================================================*/

" OP_genCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* genCsvOp request                                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: genCsvOp_req ( -- )

  LogEntry SEED_REQ

  job[] locals| pJob_GenCsvOp |
  0 locals| pTable |

  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        Operand[].pipeOut

        // new a stream def
        Operand[].newStreamDef
        Operand[].pipeOut

        // pipeout a single generated csv buffer
        //begin
        table[].get table.genCsvBuffer to Operand[]
        Operand[].pipeOut
        //false
        //while repeat

        Operand[].newEosMarker
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        // check if table exits
        sTableNm checkIsValidTable not if
          op.pipelineJob@ ERROR_JOB
          Operand[].delete
          Operand[].newErrorMarker
        else
          // move to table folder and find the table
          sTableNm pushTable assert
          sTableNm find execute to table[]
        then

        Operand[].pipeOut
        true
      endof

      // handle other operand as generic operands
      jobOperand::generic
      swap

    endcase

  while assert::stack_0 repeat

  "*** GENCSVOP EXITS" .
  LogExit
  job::deleteThis
  DONE_RUN
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: genCsvOp :: genCsvOp <tableNm> ;

jobInfo: genCsvOp
{
  <jobDesc>  = "--description of job--"
  
  ?<jobKind>?  = JK_LOCAL
  ?<rspKind>?  = RS_PARTICIPANT_RESPONSE
  ?<ddlLock>?  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
