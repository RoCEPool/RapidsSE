/*============================================================================*/
/* OP_genCsv.sen -- Operator genCsv                                           */
/*============================================================================*/

" OP_genCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: genCsv_PulseMarker \handler

  //"Operand:- ZK_PULSEMARKER" .verbose
  Pipein[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // pipeout a single generated csv buffer
  //begin
  table[].get table.genCsvBuffer to Operand[]
  Operand[].pipeOut
  //false
  //while repeat

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: genCsv_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  // check if table exits
  <tableNm> op__table if
    Pipein[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* genCsv request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: genCsv_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: genCsv_PulseMarker ZK_PULSEMARKER op[].handler!
  find: genCsv_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  "*** GENCSV EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
opSyntax: genCsv :: genCsv <tableNm> ;

: genCsv opInfo tagCopy: localOp_tags
  tags{ <jobDesc> = "--description of operator--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
