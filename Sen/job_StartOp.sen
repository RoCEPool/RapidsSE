/*============================================================================*/
/* job_StartOp.sen -- Job StartOp                                             */
/*============================================================================*/

" job_StartOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for startOp request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : start_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_StartOp |

   tp: start_run

   pJob_StartOp job.opLoop

   //pJob_StartOp job::participantExecuted

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: start :: start ;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobInfo: start
{
  <?jobKind?>  = JK_OP
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
