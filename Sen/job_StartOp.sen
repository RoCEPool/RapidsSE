/*============================================================================*/
/* job_OutputOp.sen -- Job OutputOp                                           */
/*============================================================================*/

" job_OutputOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for startOp request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : start_req ( -- )
 
   >>logEntry <SEED_REQ>

   job::this locals| pJob_StartOp |

   tp: start_run

   pJob_StartOp job.opLoop

   //pJob_StartOp job::participantExecuted

  <<logExit <DONE_RUN>
;

: start_rcv ( -- )
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: start :: start ;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobInfo: start
{
  jobKind      = JK_OP
  responseKind = RS_NODE_ZERO
  
  exeLock      = DL_GRAB_READ
  preCheck     = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
