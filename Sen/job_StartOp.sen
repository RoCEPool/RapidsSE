/*============================================================================*/
/* job_StartOp.sen -- Job StartOp                                             */
/*============================================================================*/

" job_StartOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for startOp request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : startOp_req ( -- )
 
  >>logEntry <SEED_REQ>

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CANCELMARKER of
        //"Operand:- ZK_CANCELMARKER" .verbose
        "Query being cancelled\n" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_STARTEDMARKER of
        //"Operand:- ZK_STARTEDMARKER" .verbose
        Operand[].delete
        Operand[].newPulseMarker
        Operand[].pipeout
        true
      endof

      ZK_STOPPEDMARKER of
        //"Operand:- ZK_STOPPEDMARKER" .verbose
        Operand[].delete
        Op.ackPipelineJob
        false
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: startOp :: startOp ;

jobInfo: startOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_STARTOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
