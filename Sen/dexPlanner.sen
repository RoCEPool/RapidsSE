/*============================================================================*/
/* dexPlanner.sen -- distributed export planner                               */
/*============================================================================*/

"dexPlanner.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distributed export planner                                                 */
/*----------------------------------------------------------------------------*/
: dexPlanner ( tableNm fileNm -- dexPlan )

  locals| fileNm tableNm |

  // create a distributed export plan
  plan::new locals| dexPlan |

  // synthesise the symbolic arguments into the lambda text of plan
traceon
  dexPlan tableNm $$tableNm##
  dexPlan fileNm  $$fileNm##
  dexPlan 0       $$partition##  // needs to go into opFrame dic
//  dexplan 0       ##: $$ptn
traceoff

  dexPlan task.this task.plan!

  // create the named op frames in plan
  "scanOp#"  dexPlan plan.opFrame++ drop
    dexPlan 0  ##: $$ptn  // into opFrame dic

  "writeOp#" dexPlan plan.opFrame++ drop
  "sinkOp#"  dexPlan plan.opFrame++ drop

  // add plan to plan list
  dexPlan planList::addPlan
  planList::show

  // return dexPlan
  dexPlan
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
