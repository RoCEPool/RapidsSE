/*============================================================================*/
/* OP_dropTable.sen -- Operator drop table                                    */
/*============================================================================*/

" OP_dropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: dropTable_DataMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove table
  <tableNm> check::validTableAssembly not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  <tableNm> table::dropTable

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dropTable req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropTable_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dropTable_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropTable :: dropTable <tableNm> ;

: dropTable _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <forceLog>  = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
