/*============================================================================*/
/* OP_eachPath.sen -- Operator Each Path                                      */
/*============================================================================*/

" OP_eachPath.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: eachPath_PulseMarker \handler
 
  "eachPath_PulseMarker" .

  ZK_PULSEMARKER_handler

  // find the __path table def
  C_TDEF_PATHINFO op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] infoSet[].new
    OI_PATHINFO infoSet[].opInfoset!

  "abc" 1 infoSet[].addRowVargs
    
  InfoSet[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : eachPath_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: eachPath_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eachPath :: eachPath <paths> ;

: eachPath _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
