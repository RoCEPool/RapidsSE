/*============================================================================*/
/* OP_syntaxTable.sen -- Operator synrax table                                */
/*============================================================================*/

" OP_syntaxTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: createTable::createNamedTable

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse cmd and create table definition
  <etc> <tableNm> "create table %v %v ;" str.format dup .
  job[] tableDef::parse locals| pTableDef |

  // check for error while parsing tabledef
  job[] job.hasError if
    DdlLock[].testDrop
    !!logError
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  pTableDef <tableNm> table::createTable locals| pTable |

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: syntaxTable_PulseMarker

  job[] job.tagSet@ tagSet.asStr .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check create table syntax
  <etc> <tableNm> "create table %v %v ;" str.format dup .
  TableDef::syntax dup EC_NONE != if  ( errorCode )
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  else
    discard
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in tables
  folder[].isTables assert

  // grab the ddl lock
  DdlLock[].grabRead

/*
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check there are enough buffers
  node::checkEnoughBuffers not if ( errorCode )
    op.pipelineJob@ ERROR_JOB
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then
*/

  // should be in tables
  folder[].isTables assert

  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for syntaxTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: syntaxTable_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: syntaxTable_PulseMarker ZK_PULSEMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: syntaxTable :: syntaxTable <tableNm> <etc> ;

: syntaxTable _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--description of operator--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
