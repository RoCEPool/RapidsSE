/*============================================================================*/
/* op_range.sen -- table range select operator                                 */
/*============================================================================*/

" op_range.sen" .verbose

/*----------------------------------------------------------------------------*/
/* frame-level variables for range                                            */
/*----------------------------------------------------------------------------*/
common/ range rbCrs /

/*----------------------------------------------------------------------------*/
/* send rows from buffers from teh buffer queue of the session                */
/*----------------------------------------------------------------------------*/
: sendQueueBuffers ( pBufferQueue nLastBuffers pSession sProfile planId sNextOp )

  0 0 0 locals| bIsLast nRowCount pIndexBuffer sNextOp planId sProfile pSession nLastBuffers pBufferQueue |

  //"sendingBuffers ..." .

  // loop thru buffers
  true
  begin

    while
    // pop a buffer off the buffer queue
    pBufferQueue popBuffer to pIndexBuffer

    // is it a last buffer
    pIndexBuffer entryBuffer.isLast@ to bIsLast

    // check if last buffer
    bIsLast if

      nLastBuffers 1 - to nLastBuffers
        0 nLastBuffers == if
          // send the index buffer to next printOp indicating last buffer
          
          //<<   1 pIndexBuffer true pSession sNextOp planId sProfile >>jobQueue
          false
        else
          // send the index buffer to next printOp
          //<<   0 pIndexBuffer true pSession sNextOp planId sProfile >>jobQueue
          true
        then
    else
      true  // no more entries, move to next buffer
    then
    //pIndexBuffer entryBuffer.delete
    //"Deleted buffer" .

  repeat

  //<<  false pSession sNextOp planId sProfile >>jobQueue

  // delete the buffer queue
  pBufferQueue queue.delete

;

/*----------------------------------------------------------------------------*/
/* range select for a partition of a table                                    */
/*----------------------------------------------------------------------------*/
: rangePartition subDic range ( pSession profile plan -- )

tp: rangePartition

  // record the plan, profile and the session
  locals| thePlan profile pSession |
  0 0 0 0 locals| nLastBuffers pTable pBufferQueue pPlanner |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set path (hardcoded for the moment)

  //"tables" "tpchSchema" "schemas" "rapidsse" "catalogs" "boray" "tenants" 7 dicStack.set
  "tenants" 1 dicStack.set

  // [0] push thePlan's dictionary onto path stack
  thePlan plan.dic pathPush

  // [1] find and push opFrame (along with its dictionary onto path stack)
  profile thePlan plan.opFrame? opFrame.push // [1]
  //pathDump

  $$tableNm   locals| tableNm   |
  $$schemaNm  locals| schemaNm  |
  $$catalogNm locals| catalogNm |
  $$where     locals| sWhere |

  // drop the dictionary path
  pathDrop

  // now create the dictionary path again with the catalog and schemaNm
  "catalogs" "boray" "tenants" 3 dicStack.set

  // push tableNm folder on the dictionary path
  catalogNm find execute
  pathPush

  // push tableNm folder on the dictionary path
  "schemas" find execute
  pathPush

  // push tableNm folder on the dictionary path
  schemaNm find execute
  pathPush

  // push tableNm folder on the dictionary path
  "tables" find execute
  pathPush

  // push tableNm on the dictionary path
  tableNm find execute
  pathPush

  //pathDump

  // [0] push thePlan's dictionary onto path stack
  thePlan plan.dic pathPush

  // [1] find and push opFrame (along with its dictionary onto path stack)
  profile thePlan plan.opFrame? opFrame.push // [1]

  ddlLock::grabRead

  tableNm find execute to pTable


  sWhere $$partition "Generating plan for partition %v ( %v )..." str.format .

  // generate plan for the fetch
  sWhere pTable "generatePlan" find execute to pPlanner

  pPlanner planner.phrases@ to nLastBuffers

  // assert we have a plan
  pPlanner assert

  // set the no of last buffers to no of phrases in plan
  //pPlanner planner.phrases@ pSession session.lastBuffers!

  // create the buffer queue in the session
  "rangeTask.queue" queue::new to pBufferQueue

  0 0 locals| iSlot bGroupBy |

  $$partition grid::toSlot to iSlot

  pPlanner planner.phrases@ "Spawning %v fetch tasks..." str.format .
  pPlanner planner.phrases@ 0
  do
    pBufferQueue iSlot bGroupBy I pPlanner "spawnFetch" find execute
  loop

  ddlLock::dropRead

  pBufferQueue nLastBuffers pSession $$nextOp thePlan plan.Id@ $$nextProfile
  sendQueueBuffers

  // << false plan >> -->> nextOp
  //<< false pSession $$nextProfile thePlan plan.Id@ $$nextOp >>jobQueue

  // [1] discard opFrame (and dictionary)
  opFrame.drop

  // [0] discard thePlan's dictionary from path stack
  pathDrop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
