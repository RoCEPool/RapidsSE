/*============================================================================*/
/* se_start.sen -- Start System                                               */
/*============================================================================*/

" job_Start.sen" .verbose


/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  LogEntry SEED_RUN

  nullptr locals| pParentJob |

  "start_run" .verbose

  // spawn supervisor demon
  //"" supervisorDemonStr api::spawnDemon not if
  //  "Error Code %v" .printf
  //then

  // spawn recurring demon
  "" recurringDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn waker demon
  "" wakerDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn answer demon
  "" answerDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn connector demon
  "" connectorDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  "end start_run" .verbose

  DONE_RUN
  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
