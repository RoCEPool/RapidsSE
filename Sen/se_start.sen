/*============================================================================*/
/* se_start.sen -- Start System                                               */
/*============================================================================*/

" job_Start.sen" .verbose


/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  LogEntry SEED_RUN

  nullptr locals| pParentJob |

  "start_run" .verbose

  //supervisor ;&
  //periodic ;&
  waker ;&

  //spawn answer

  //answer ;&

  "" answerDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  //connector ;&

  "" connectorDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  //service egArgA egArgB egArgC ;&

  "end start_run" .verbose

  DONE_RUN
  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
