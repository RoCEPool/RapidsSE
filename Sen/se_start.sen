/*============================================================================*/
/* se_start.sen -- Start System                                               */
/*============================================================================*/

" se_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* define apriori tables                                                      */
/*----------------------------------------------------------------------------*/
: start::defineTables

"
  define table __DEFINE_TEST (
    nodeName       VARCHAR NOT NULL ,
    partition      INTEGER NOT NULL ,
    buffers        INTEGER NOT NULL ,
    entries        INTEGER NOT NULL
  ) ;
"
  locals| sStmt |

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables"
    sStmt
    api::executeRequest
;

/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  LogEntry SEED_RUN

  nullptr locals| pParentJob |

  "start_run" .verbose


  start::defineTables


  // spawn supervisor demon
  //"" false supervisorDemonStr api::spawnDemon not if
  //  "Error Code %v" .printf
  //then

  // spawn recurring demon
  "" false recurringDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn waker demon
  "" false wakerDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn answer demon
  "" false answerDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn connector demon
  "" false connectorDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  "end start_run" .verbose

  DONE_RUN
  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
