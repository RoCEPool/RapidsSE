/*============================================================================*/
/* se_start.sen -- Start System                                               */
/*============================================================================*/

" se_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* define procedures                                                          */
/*----------------------------------------------------------------------------*/
: start::defineProcedures1

 "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create catalog
  sPath
  "
  procedure create catalog
    parameters $catalogNm
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    createCatalog $catalogNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create index
  sPath
  "
  procedure create index
    parameters $indexNm $etc
  begin

  stage stageA on origin :
    start | periodicOp once | syntaxIndex $indexNm $etc | stageB

  stage stageB on all nodes :
    createIndex $indexNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create unique index
  sPath
  "
  procedure create unique index
    parameters $indexNm $etc
  begin

  stage stageA on origin :
    start | periodicOp once | syntaxUniqueIndex $indexNm $etc | stageB

  stage stageB on all nodes :
    createIndex $indexNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create schema
  sPath
  "
  procedure create schema
    parameters $schemaNm
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    createSchema $schemaNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create table
  sPath
  "
  procedure create table
    parameters $tableNm $etc
  begin

  stage stageA on origin :
    start | periodicOp once | syntaxTable $tableNm $etc | stageB

  stage stageB on all nodes :
    createTable | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create tenant
  sPath
  "
  procedure create tenant
    parameters $tenantNm
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    createTenant $tenantNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create table as
  sPath
  "
  procedure ctas
    parameters $table1 $table2
  begin

    stage stageA on origin :
      start | periodicOp once | emitStreamDef $Table1 | stageB

    stage stageB on all nodes :
      createTable $table2 | stageC

    stage stageC on all partitions :
      scan $table1 | dupCrw | insert $table2 | stageD

    stage stageD on origin :
      sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // define table
  sPath
  "
  procedureLocal define table
    parameters $tableNm $etc
  begin

  stage stageA on origin :
    start | periodicOp once | syntaxTable $tableNm $etc |
      defineTable $tableNm | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete
  sPath
  "
  procedure delete
    parameters $table $predicate
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    delete $table $predicate | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure

;

/*----------------------------------------------------------------------------*/
/* define procedures                                                          */
/*----------------------------------------------------------------------------*/
: start::defineProcedures2

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop catalog
  sPath
  "
  procedure drop catalog
    parameters $catalogNm
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    dropCatalog $catalogNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop index
  sPath
  "
  procedure drop index
    parameters $tableNm $indexNm
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    truncateIndex $tableNm $indexNm | stageC

  stage stageC on all nodes :
    dropIndex $tableNm $indexNm | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop schema
  sPath
  "
  procedure drop schema
    parameters $schemaNm
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    dropSchema $schemaNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop table
  sPath
  "
  procedure drop table
    parameters $tableNm
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    truncateTable $tableNm | stageC

  stage stageC on all nodes :
    dropTable $tableNm | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop tenant
  sPath
  "
  procedure drop tenant
    parameters $tenantNm
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    dropTenant $tenantNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* define procedures                                                          */
/*----------------------------------------------------------------------------*/
: start::defineProcedures3

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // export
  sPath
  "
  procedure export
    parameters $Table $File
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    scan $Table | toCsv | stageC

  stage stageC on origin :
    wrFile $File | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // gridSanity
  sPath
  "
  procedure gridSanity
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all nodes :
    nodeInfo | stageC

  stage stageC on origin :
    gridSanity | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // load
  sPath
  "
  procedure load
    parameters $table $file
  begin

  stage stageA on origin :
    start | periodicOp once | chunk $file | stageB

  stage stageB on all partitions on origin :
    rdCsvChunk $file |
    toCrwH $table    |
    //  dump crwBuffer 1 |
    stageC Hashed

  stage stageC on all partitions :
    insert $table | stageD

  stage stageD on origin :
    sink | stageA
    //progress 'Load' | toStatDemon | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // partitionScan
  sPath
  "
  procedure partitionScan
    parameters $table $partition
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on partition $partition :
    scan $table | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // predicateFetch
  sPath
  "
  procedure predicateFetch
    parameters $table $predicate
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    fetch $table $predicate | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // select table
  sPath
  "
  procedure select table
    parameters $Table
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    scan $Table | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tableScan
  sPath
  "
  procedure tableScan
    parameters $table
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    scan $table | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // truncate
  sPath
  "
  procedure truncate
    parameters $table
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    truncateTable $table | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* define procedures                                                          */
/*----------------------------------------------------------------------------*/
: start::defineProcedures4

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // fload
  sPath
  "
  procedure fload
    parameters $table $file
  begin

  stage stageA on origin :

    start              |

    periodicOp once    |

    chunk $file        | // read chunks of file, produce (seekOffset) =>
    // dump seekOffsets 1 |

    rdCsvChunk $file   | // (seekOffset) => (csvBuffer)
    // dump csvBuffer 0   |

    stageB robin


  stage stageB on all partitions on origin :

    toRsb $table       | // (csvBuffer)  => (rsbBuffer)
    // dump rsbBuffer 1   |

    toPtnRsb           | // (rsbBuffer)  => (rsbBuffer 'ptn)
    // dump rsbBuffer 1   |

    toNstRsb           | // (rsbBuffer)  => (rsbBuffer 'nst)
    //dump rsbBuffer 1   |

    toHshCrw           | // (rsbBuffer)  => (crwBuffer 'hsh)
    //dump rsbBuffer 1   |

    stageC hashed

  stage stageC on all partitions :

    //eatSome |

    insert $table      | // (crwBuffer) inserted into table

    stageD

    stage stageD on origin :

    output             |

    sink               |

    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // copy file
  sPath
  "
  procedure copyFile
    parameters $FileIn $FileOut
  begin

  stage stageA on origin :
    start | periodicOp once | catFile $FileIn | wrFile $FileOut | sink | stageA

  end ;
  "
  api::addProcedure

  // copyFile "/Users/Shared/tpch/SF1/nation.csv" "/Users/Shared/tpch/SF1/nation_COPY.csv" ;


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list file
  sPath
  "
  procedure listFile
    parameters $File
  begin

    stage stageA on origin :
      start | periodicOp once | catFile $File | output | sink | stageA

  end ;
  "
  api::addProcedure

  // listFile "/Users/Shared/tpch/SF1/nation.csv" ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // xyz file
  sPath
  "
  procedure xyzFile
    parameters $Table $File $Ntimes
  begin

    stage stageA on origin :
      start
        | periodicOp once
//        | catFile $File
        | rdCsvCyclic $File $NTimes
        | toRsb $Table
        | toPtnRsb
        | toNstRsb
        | stageB hashed

    stage stageB on all partitions :
      noop
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  api::addProcedure

  // xyzFile nation "/Users/Shared/tpch/SF1/nation.csv" 3 ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // cycle read file
  sPath
  "
  procedure cyclicRdFile
    parameters $FileIn $NTimes
  begin

    stage stageA on origin :
      start | periodicOp once |
        rdCsvCyclic $FileIn $NTimes | output | sink | stageA

  end ;
  "
  api::addProcedure

// cyclicRdFile "/Users/Shared/tpch/SF1/nation.csv" 3 ;
// cyclicRdFile "/Users/Shared/tpch/SF1/supplier.csv" 3 ;
// cyclicRdFile "/Users/Shared/tpch/SF1/part.csv" 3 ;

;

/*----------------------------------------------------------------------------*/
/* define procedures                                                          */
/*----------------------------------------------------------------------------*/
: start::defineProc_SteadyState

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 1
  sPath
  "
  procedure steadyState_1
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | periodicOp once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRsb $Table
        | toPtnRsb
        | stageB hashed

    stage stageB on all partitions :
      noop
      //insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 2
  sPath
  "
  procedure steadyState_2
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | periodicOp once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRsb $Table
        | toPtnRsb
        | stageB hashed

    stage stageB on all partitions :
      //noop
      insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 3
  sPath
  "
  procedure steadyState_3
   parameters $Table $File $NTimes
  begin

   stage stageA on origin :

     start |

     periodicOp once |

     rdCsvCyclic $File $NTimes |

     stageB robin


   stage stageB on all partitions on origin  :

     toRsb $Table |

     toPtnRsb |

     //toNstRsb |

     //toHshCrw |

     stageC hashed


   stage stageC on all partitions :

     insdel $Table |

     stageD


   stage stageD on origin :

     //output |

     sink |

     stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* define procedures                                                          */
/*----------------------------------------------------------------------------*/
: start::defineProc_UnloadReload

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // unload
  sPath
  "
  procedure unload
    parameters $Table $File
  begin

  stage stageA on origin :
    start | periodicOp once | stageB

  stage stageB on all partitions :
    scan $Table | stageC

  stage stageC on origin :
    wrFile $File | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // /time unload LineItem "/tmp/lineitem.crw" ;


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reload
  sPath
  "
  procedure reload
    parameters $Table $File
  begin

  stage stageA on origin :
    start | periodicOp once | rdCrwFile $File | stageB

  stage stageB on all partitions :
    insert $Table | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // /time reload LineItem "/tmp/lineitem.crw" ;

;

/*----------------------------------------------------------------------------*/
/* define procedures                                                          */
/*----------------------------------------------------------------------------*/
: start::defineProc_Expressions

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // filtered load
  sPath
  "
  procedure expr_filter_1
    parameters $Table $File
  begin

  stage stageA on origin :
    start
      | periodicOp once
      | chunk $file
      | rdCsvChunk $file
      | stageB robin


  stage stageB on all partitions on origin :
    toRsb $table
      //| filter
      | sql 1001
      | toPtnRsb
      | toNstRsb
      | toHshCrw
      | stageC hashed

  stage stageC on all partitions :
    insert $table
      | stageD

  stage stageD on origin :
    output
      | sink
      | stageA

  end ;
  "
  api::addProcedure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // filtered projected load
  sPath
  "
  procedure expr_project_1
    parameters $Table $File
  begin

  stage stageA on origin :
    start
      | periodicOp once
      | chunk $file
      | rdCsvChunk $file
      | stageB robin


  stage stageB on all partitions on origin :
    toRsb $table
      //| sql 1001  // filter
      //| sql 1002  // project
      | sql 1003  // filter (should be sort)
      | toPtnRsb
      | toNstRsb
      | toHshCrw
      | stageC hashed

  stage stageC on all partitions :
    insert $table
      | stageD

  stage stageD on origin :
    output
      | sink
      | stageA

  end ;
  "
  api::addProcedure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // aggregate (sum)
  sPath
  "
  procedure aggregate
    parameters $Table $File
  begin

  stage stageA on origin :
    start
    | periodicOp once
    | chunk $file
    | rdCsvChunk $file
    | stageB robin

  stage stageB on all partitions :
    toRsb $table
    | sql 1004  // agg
    | stageC

  stage stageC on origin :
    sql 1004  // super agg
    | output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // sumGby
  sPath
  "
  procedure sumGby
    parameters $Table $File $Column
  begin

  stage stageA on origin :
    start
    | periodicOp once
    | chunk $file
    | rdCsvChunk $file
    | stageB robin

  stage stageB on all partitions :
    toRsb $table
    | aggregateGby $table $column
    | stageC

  stage stageC on origin :
    output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  ;
;

/*----------------------------------------------------------------------------*/
/* define procedures                                                          */
/*----------------------------------------------------------------------------*/
: start::defineProc_TPCH

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // filtered load
  sPath
  "
  procedure Query6_Exp1
    parameters $Table $File
  begin

  stage stageA on origin :
    start
    | periodicOp once
    | chunk $file
    | rdCsvChunk $file
    | stageB robin


  stage stageB on all partitions :
    toRsb $table
    | sql 600
    | stageC

  stage stageC on origin :
    sql 601
    | output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // filtered load
  sPath
  "
  procedure Query6_Exp2
    parameters $Table $File
  begin

  stage stageA on origin :
  start
    | periodicOp once
    | stageB

  stage stageB on all partitions :
    scan lineitem
    | toRsb $table
    | sql 600
    | stageC

  stage stageC on origin :
    sql 601
    | output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

;

/*----------------------------------------------------------------------------*/
/* define apriori tables                                                      */
/*----------------------------------------------------------------------------*/
: start::defineTables

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_ANALYZEINDEX
  sPath
  "
    define table __analyzeIndex (
      nodeName       VARCHAR NOT NULL ,
      partition      INTEGER NOT NULL ,
      buffers        INTEGER NOT NULL ,
      entries        INTEGER NOT NULL
    ) ;
  "
  api::executeRequest

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_ANALYZETABLE
  sPath
  "
  define table __analyzeTable (
     nodeName       VARCHAR NOT NULL ,
     partition      INTEGER NOT NULL ,
     buffers        INTEGER NOT NULL ,
     entries        INTEGER NOT NULL
  ) ;
  "
  api::executeRequest

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_GRIDSANITY
  sPath
  "
  define table __gridSanity (
    nodeName   VARCHAR NOT NULL ,
    homogenous BOOLEAN NOT NULL
  ) ;
  "
  api::executeRequest

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_LISTCOLUMNS
  sPath
  "
  define table __listColumns (
    columnName     VARCHAR NOT NULL ,
    columnType     VARCHAR NOT NULL ,
