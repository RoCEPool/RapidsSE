: start::defineInfoSets

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_LOCKSTATS
  sPath
  "
  define table __lockStats (
    nodeNo         INTEGER        NOT NULL ,
    takeNo         INTEGER        NOT NULL ,

    lockNo         INTEGER        NOT NULL ,
    lockNm         VARCHAR ( 32 ) NOT NULL ,

    readGrab       INTEGER        NOT NULL ,
    readCollision  INTEGER        NOT NULL ,
    readPercent    INTEGER        NOT NULL ,

    writeGrab      INTEGER        NOT NULL ,
    writeCollision INTEGER        NOT NULL ,
    WritePercent   INTEGER        NOT NULL
  ) ;
  "
  api::executeRequest

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_NODEINFO
