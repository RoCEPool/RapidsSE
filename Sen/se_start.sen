/*============================================================================*/
/* se_start.sen -- Start System                                               */
/*============================================================================*/

" se_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/

" start_run" .verbose

: start_run ( -- <R> )

  LogEntry SEED_RUN

  nullptr locals| pParentJob |

  "start_run" .verbose

  // define the apriori procedures
  start::defProc_Create
  start::defProc_Drop
  start::defProc_Scan
  start::defProc_Load
  start::defProc_File
  start::defProc_Elasticity
  start::defProc_SteadyState
  start::defProc_UnloadReload
  start::defProc_Query
  start::defProc_DynCompiler
  start::defProc_TPCH
  start::defProc_TPCH_ASM
  start::defProc_TPCH_ASM_I
  start::defProc_Planner

  // define the apriori system tables
  start::defineTables

  // define the apriori infoset tables
  start::defineInfoSets

  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  //
  // This point onwards the SE execution model has been fully booted
  // and we can now spawn jobs
  //
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  // spawn supervisor demon
  //"" false supervisorDemonStr api::spawnDemon not if
  //  "Error Code %v" .printf
  //then

  // spawn recurring demon
//  "" false recurringDemonStr api::spawnDemon not if
//    "Error Code %v" .printf
//  then

  // spawn stat demon
  "" false statDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn waker demon
  "" false wakerDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn answer demon
  "" false answerDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn connector demon
  "" false connectorDemonStr api::spawnDemon not if
    "Error Code %v" .printf
  then

  "end start_run" .verbose

  // delete task instead of returning to nowhere
  task::scheduleDelete

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
