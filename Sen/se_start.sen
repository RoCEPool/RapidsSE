/*============================================================================*/
/* se_start.sen -- Start System                                               */
/*============================================================================*/

" job_Start.sen" .verbose


/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/
: start_run ( -- <R> )

  LogEntry SEED_RUN

  nullptr locals| pParentJob |

  "start_run" .verbose

  //supervisor ;&
  //periodic ;&
  waker ;&

  answer ;&
  connector ;&

  //service egArgA egArgB egArgC ;&

  "end start_run" .verbose

  DONE_RUN
  job::completed

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
