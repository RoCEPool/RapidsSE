/*============================================================================*/
/* OP_delete.sen -- Operator delete                                           */
/*============================================================================*/

" OP_delete.sen" .verbose

/*----------------------------------------------------------------------------*/
/* position and begin delete                                                  */
/*----------------------------------------------------------------------------*/
: positionBeginDelete ( "iPhrase" "lowerKey" "upperKey" )

  params| upperKey lowerKey iPhrase |
  0 locals| sIndexNm |

  // find the index
  iPhrase planner[].indexNm@ to sIndexNm
  <tableNm> sIndexNm op__index assert

  // grab the table ptn read lock
  tablePtn[] tablePtnGrabRead

  // new an index stream
  index[] tablePtn[] indexStream::new to indexStream[]

  // open index stream to access index
  indexStream[].open

  // position in the index
  iPhrase  // phrase
  lowerKey // lower
  upperKey // upper
  planner[] indexStream[].seek
;

/*----------------------------------------------------------------------------*/
/* begin the delete                                                           */
/*----------------------------------------------------------------------------*/
: beginDelete ( iPhrase -- )

  params| iPhrase |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the fetch technique
  iPhrase planner[].fetchTechnique@

  case

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an exact select using index
    AT_EXACT of
      "*exact*" .verbose

      iPhrase                  // phrase
      iPhrase planner[].key@   // lower key
      iPhrase planner[].key@   // upper key
      positionBeginDelete
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // lower bound select using index
    AT_LOWER of
      "*lower*" .verbose

      iPhrase                     // phrase
      iPhrase planner[].lowKey@   // lower key
      ""                          // upper key
      positionBeginDelete
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an upper bound select using index
    AT_UPPER of
      "*upper*" .verbose

      iPhrase                     // phrase
      ""                          // lower key
      iPhrase planner[].upperKey@ // upper key
      positionBeginDelete
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // a range select using index
    AT_RANGE of
      "*range" .verbose

      iPhrase                     // phrase
      iPhrase planner[].lowKey@   // lower key
      iPhrase planner[].upperKey@ // upper key
      positionBeginDelete
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // full scan (no index)
    AT_SCAN of
      "*scan*" .verbose
      // now get excat key rows from index
      tablePtn[] tablePtnGrabRead
      tablePtn[] ptnStream::new to ptnStream[]

      // open ptn stream for the tablePtn
      ptnStream[] ptnStream.open assert
    endof

  endcase
;

/*----------------------------------------------------------------------------*/
/* generate plan for the fetch                                                */
/*----------------------------------------------------------------------------*/
: generatePlan ( -- )

  0 locals| sPredicate |

  //sWhere "generatePlan" "%v %v" str.format .

  ( cdt_0 ) planner[].new
  ( cdt_1 ) Table[] Planner[].table!

  ( cdt_2 ) <predicate> Planner[].parseWhere  //"parseWheres" .

  ( cdt_3 ) Planner[].genPaths           //"genPaths" .
  ( cdt_4 ) Planner[].scorePaths         //"scorePaths" .
  //( cdt_5 ) Planner[].showPaths

  ( cdt_6 ) Planner[].matchPaths         //"matchPaths" .
  //( cdt_6 ) Planner[].showPaths

  ( cdt_7 ) Planner[].choosePaths        //"choosePaths" .
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: delete_CancelMarker \handler

  //"ZK_CANCELMARKER_handler" .verbose
  nullptr to Operand[]
  PipeIn[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for delete_rows ...                                                */
/*----------------------------------------------------------------------------*/
: delete_rows \handler

  "Handler:- delete_rows" .verbose

  0 locals| bMoreToDelete |

  // get the fetchTechnique
  Counter1[] planner[].fetchTechnique@
  case
    AT_SCAN of
     0 assert
    endof

    indexStream[].deleteNext to bMoreToDelete

  endcase

  // no more data for counter1[] phrase ?
  bMoreToDelete not if

    // any more phrases ?
    Counter1[] 1 + to Counter1[]
    Counter1[] Counter0[] >= if
      // all done
      // close and delete partition stream
      ptnStream[].isNull not if
        ptnStream[] ptnStream.close
        ptnStream[] ptnStream.delete
        nullptr to ptnStream[]
      then

      // close and delete index stream
      indexStream[].isNull not if
        indexStream[].close
        indexStream[].delete
        nullptr to indexStream[]
      then

      tablePtn[] tablePtnDropRead

      // delete the planner
      planner[].delete

      // pipeout an eosMarker
      Operand[].newEosMarker
      Operand[].pipeOut
    else
      // position and fetch first buffer for next phrase
      Counter1[] beginDelete
    then

  else

    // call this handler again to process next buffer
    true LogicUnit[].callAgain!

  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: delete_PulseMarker \handler

  0 locals| iPhrases |

  //"Operand:- ZK_PULSEMARKER" .verbose
  PipeIn[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get no of phrases
  planner[].phrases@ to Counter0[]

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert we have at least one phrase
  Counter0[] 1 >= assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set counter1[] to 0
  0 to Counter1[]

  // position and begin delete for the first phrase
  Counter1[] beginDelete

  // force op loop to call fetch_CrwBuffer to start processing buffers
  "delete_rows" word::find LogicUnit[].handler!
  true LogicUnit[].callAgain!

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: delete_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  0 locals| iPhrases |

  <tableNm> op__table if
    Table[].tablePtn@ to tablePtn[]
    PipeIn[].pipeOut
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the plan for the fetch
  generatePlan

  //planner[].showPaths

  // assert we have a plan
  planner[].isNull not assert

  true
;

/*----------------------------------------------------------------------------*/
/* delete request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: delete_req \operator

  LogReqEntry SEED_REQ
  //<tableNm> <predicate> "PARAMETERS %v %v" str.format .

  op__topology

  find: delete_CancelMarker ZK_CANCELMARKER op[].handler!
  //find: delete_CrwBuffer    ZK_CRWBUFFER    op[].handler!
  find: delete_PulseMarker  ZK_PULSEMARKER  op[].handler!
  find: delete_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: delete :: delete <tableNm> <predicate> ;

: delete _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
