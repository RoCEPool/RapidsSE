/*============================================================================*/
/* OP_callPL.sen -- Operator Call Pipeline                                    */
/*============================================================================*/

" OP_callPL.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : callPL_req \operator

  LogReqEntry SEED_REQ

  op__topology


  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: callPL :: callPL ;

: callPL _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
