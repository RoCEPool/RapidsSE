/*============================================================================*/
/* job_Select.sen -- Job Select Table                                         */
/*============================================================================*/

" job_Select.sen" .verbose

/*----------------------------------------------------------------------------*/
/* select request (on originating node)                                       */
/*----------------------------------------------------------------------------*/
: select_req ( -- <R> )

  >>logEntry <SEED_REQ>

  100 ssn::senLoc

  ": select_req" .

  task::this      locals| pTask |
  pTask task.job@ locals| pJob |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob job_Select.begin
  pJob job_Select.execute
  pJob job_Select.end

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ": select_req END" .

  900 ssn::senLoc

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
