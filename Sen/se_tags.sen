/*============================================================================*/
/* se_tags.sen -- tags                                                        */
/*============================================================================*/

" se_tags.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add given tag to word's tag set  (with support for constant translation)   */
/*----------------------------------------------------------------------------*/
: tagSet.addTag params| pWordTagSet sTagValue sTagName |

  sTagValue find     locals| pConstantWord |

  // test for a (int) constant and translate value
  pConstantWord if
    pConstantWord word.category@ find: rootConstant eql if

      // sEvalue "  %v is a constant" .printf
      // add <name> = <constant>
      sTagName pConstantWord execute pWordTagSet tagSet.insertInt
      exit

    then
  then

  // add <name> = <string>
  sTagName sTagValue pWordTagSet tagSet.insertStr
;

/*----------------------------------------------------------------------------*/
/* add/replace given tag to word's tag set (support for constant translation) */
/*----------------------------------------------------------------------------*/
: tagSet.addReplaceTag params| pWordTagSet sTagValue sTagName |

  sTagValue find     locals| pConstantWord |

  // test for a (int) constant and translate value
  pConstantWord if
    pConstantWord word.category@ find: rootConstant eql if

      // sEvalue "  %v is a constant" .printf
      // add/replace <name> = <constant>
      sTagName pConstantWord execute pWordTagSet tagSet.replaceInt
      exit

    then
  then

  // add/replace <name> = <string>
  sTagName sTagValue pWordTagSet tagSet.replaceStr
;

/*----------------------------------------------------------------------------*/
/* the job info compiler                                                      */
/*----------------------------------------------------------------------------*/
: tags{ immediate
  
  0 locals| pTagSet |

  // attach a new ename set to the word being created
  //tagSet::new to pTagSet
  //pTagSet compiler::current@ word.TagSet!
  compiler::current@ word.EnsureTagSet
  compiler::current@ word.TagSet@ to pTagSet
  
  // add tag set name
  
  "<aTagSetNm>" compiler::current@ word.name@ compiler::current@ word.TagSet@ tagSet.addReplaceTag
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  0 0 locals| sTagName sTagValue |

  begin
  
    input::next
    
    dup "}" str.same not
    
  while
  
    // collect the tag name
    to sTagName
    
    // skip the =
    input::next discard
    
    // collect the tag value
    input::next to sTagValue
    
    // add the decoded
    sTagName sTagValue compiler::current@ word.TagSet@ tagSet.addReplaceTag
  
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // discard the "}" from dstack
  discard
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //compiler::current@ encode::push
  
  //POSTPONE word.tagSet@
;


/*----------------------------------------------------------------------------*/
/* copy ename set of input::next and copy into word being compiled             */
/*----------------------------------------------------------------------------*/
: tagCopy: immediate ( -- )

  0 0 0 0 locals| pEnamSetDst pEnamSetSrc pDstTagWord pSrcTagWord |
  
  // get the ename set of the word being compiled
  compiler::current@ to pDstTagWord
  
  pDstTagWord word.EnsureTagSet

  pDstTagWord word.tagSet@ to pEnamSetDst
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // get the ename set to be copied
  input::next find to pSrcTagWord
  
  pSrcTagWord not if
  then
    
  pSrcTagWord word.tagSet@ to pEnamSetSrc
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    
  // copy source ename set into destination
  pEnamSetSrc pEnamSetDst tagSet.copy
;
  
/*----------------------------------------------------------------------------*/
/* are current input chars a json token ?                                     */
/*----------------------------------------------------------------------------*/
: input::isEtc

  input::chars "etc" str.same
;

/*----------------------------------------------------------------------------*/
/* are current input chars a json token ?                                     */
/*----------------------------------------------------------------------------*/
: input::isJson

  input::chars str.isJsonToken
;

/*----------------------------------------------------------------------------*/
/* are current input chars a meta token ?  <tag>                              */
/*----------------------------------------------------------------------------*/
: input::isTag

  input::chars str.isMetaToken
;

/*----------------------------------------------------------------------------*/
/* are current input chars a close brace i.e. '}' ?                           */
/*----------------------------------------------------------------------------*/
: input::isCloseBrace

  input::chars "}" str.same
;

/*----------------------------------------------------------------------------*/
/* are current input chars an exclamation i.e. '!' ?                          */
/*----------------------------------------------------------------------------*/
: input::isExclamation

  input::chars "!" str.same
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
