/*============================================================================*/
/* se_tags.sen -- tags                                                        */
/*============================================================================*/

" se_tags.sen" .verbose


/*----------------------------------------------------------------------------*/
/* ensure the word has an ename set                                           */
/*----------------------------------------------------------------------------*/
: word.EnsureTagSet ( pWord -- )

  params| pWord |

  pWord word.tagSet@ not if
    tagSet::new pWord word.tagSet!
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobInfo::addEname params| pWord sEvalue sEname |

  pWord word.TagSet@ locals| pTagSet |

  sEvalue find locals| pEvalueWord |

  pEvalueWord if
    pEvalueWord word.category@ find: rootConstant eql if

      // sEvalue "  %v is a constant" .printf
       sEname pEvalueWord execute pTagSet tagSet.insertInt
      exit

    then
  then

  // -- -- --
  sEname sEvalue pTagSet tagSet.insertStr
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: tagSet::addReplace params| sEvalue sEname |

  compiler::current@ word.TagSet@ locals| pTagSet |

  sEvalue find locals| pEvalueWord |

  pEvalueWord if
    pEvalueWord word.category@ find: rootConstant eql if

      // sEvalue "  %v is a constant" .printf
       sEname pEvalueWord execute pTagSet tagSet.replaceInt
      exit

    then
  then

  // -- -- --
  sEname sEvalue pTagSet tagSet.replaceStr
;

/*----------------------------------------------------------------------------*/
/* the job info compiler                                                      */
/*----------------------------------------------------------------------------*/
: tags{ immediate
  
  0 locals| pTagSet |

  // attach a new ename set to the word being created
  //tagSet::new to pTagSet
  //pTagSet compiler::current@ word.TagSet!
  compiler::current@ word.EnsureTagSet
  compiler::current@ word.TagSet@ to pTagSet
  
  // add tag set name
  
  "<TagSetNm>" compiler::current@ word.name@ compiler::current@ jobInfo::addEname
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  0 0 locals| sTagName sTagValue |

  begin
  
    input::next
    
    dup "}" str.equal not
    
  while
  
    // collect the tag name
    to sTagName
    
    // skip the =
    input::next discard
    
    // collect the tag value
    input::next to sTagValue
    
    // add the decoded
    sTagName sTagValue tagSet::addReplace
  
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // discard the "}" from dstack
  discard
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //compiler::current@ encode::push
  
  //POSTPONE word.tagSet@
;


/*----------------------------------------------------------------------------*/
/* copy ename set of input::next and copy into word being compiled             */
/*----------------------------------------------------------------------------*/
: tagCopy: immediate ( -- )

  0 0 0 0 locals| pEnamSetDst pEnamSetSrc pDstTagWord pSrcTagWord |
  
  // get the ename set of the word being compiled
  compiler::current@ to pDstTagWord
  
  pDstTagWord word.EnsureTagSet

  pDstTagWord word.tagSet@ to pEnamSetDst
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // get the ename set to be copied
  input::next find to pSrcTagWord
  
  pSrcTagWord not if
  then
    
  pSrcTagWord word.tagSet@ to pEnamSetSrc
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    
  // copy source ename set into destination
  pEnamSetSrc pEnamSetDst tagSet.copy
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
