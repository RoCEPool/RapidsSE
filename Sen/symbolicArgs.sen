/*============================================================================*/
/* symbolicArgs.sen -- symbolic operator arguments                            */
/*============================================================================*/

"symbolicArgs.sen" .verbose

: $$ptn   "$$ptn"   find execute ;
: $$tblNm "$$tblNm" find execute ;
: $$filNm "$$filNm" find execute ;

: $$nextQueue " $$nextQueue" find execute ;
: $$nextOp    "$$nextOp"     find execute ;

