/*============================================================================*/
/* se_prompt.sen -- prompt related words                                      */
/*============================================================================*/

" se_prompt.sen" .verbose

: article_dump prompt article::dump ;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Task_Interpret_line
  
  // -- -- -- -- -- -- --
  // get next input token
  input::next

  // -- -- -- -- -- -- --
  // test for end of input?
  input::type TN_EOF == if
    //"!!NONE!!" .put
    true exit_rt
  then

  // -- -- -- -- -- -- --
  // is token an integer?
  input::type TN_INTEGER == if

    input::token >int        // convert str to int, leave on stack

    compiler::isPostponing if
      "SHOULD NOT BE POSTPONING AN INT" .put
      process::quit
      reenter
    then

    compiler::isCompiling if
      encode::push           // compile encodes push intval
      reenter
    then

    reenter                  // interpret leaves int on stack

  then

  // -- -- -- -- -- -- --
  // is token a string?
  input::type TN_STRING == if

    input::token             // put str on stack

    compiler::isPostponing if
      "SHOULD NOT BE POSTPONING A STR" .put
      process::quit
      reenter
    then

    compiler::isCompiling if
      encode::push           // compile encodes push stzVal
      reenter
    then

    reenter                  // interpret leaves str on stack

  then

  // -- -- -- -- -- -- --
  // token should be a name
  input::type TN_NAME != if
    "strange token" .put input::type .put
    reenter
  then

  // -- -- -- -- -- -- --
  // test for bye
  input::token "bye" str.equal if
    false exit_rt
  then

  // -- -- -- -- -- -- --
  // is token a known word?
  input::token word::find
  dup not if
    drop                     // token is an unknown word
    input::unknown
    reenter
  then

  // -- -- -- -- -- -- --
  // pWord now on d-stack

  // -- -- -- -- -- -- --
  // is an immediate word?
  dup word.isImmediate if
   execute                   // execute the immediate word
   reenter
  then

  // -- -- -- -- -- -- --
  // postponing mode?
  compiler::isPostponing if
    "POSTPONING" .put
    encode::push
    "encode::call" word::find encode::call
    reenter
  then

  // -- -- -- -- -- -- --
  // compiling mode?
  compiler::isCompiling if
    encode::call                 // encode::call encodes call to word
    reenter
  then

  // -- -- -- -- -- -- --
  // we are interpreting
  execute                    // execute word

  reenter                    // loop over
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Task_Interpreter
  
  //debug::breakpoint

  input::push
  input::stdin

  begin
    "SE Task> " .put

  Task_Interpret_line while repeat

  //debug::breakpoint

  input::pop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
