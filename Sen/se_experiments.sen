/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* the convertor experiment                                                   */
/*----------------------------------------------------------------------------*/
: exp_fl \prompt

": exp_fl A" .

  <fl_file> <fl_table> "exp_fl : %v %v" .printf

  <fl_file> file::size locals| nFileSize |

  nFileSize <fl_file> "File %v Size %v" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
": exp_fl B" .

  <fl_table> op__table not if
    <fl_table> "Cant find <fl_table> : %v" .printf
    exit
  then
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
": exp_fl C" .

  table[].streamDef@ convertor::new locals| pConvertor |

  csvBuffer::new locals| pCsvBuffer |

  file::new locals| pFile |

  <fl_file> OPEN_READ pFile file.open assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
": exp_fl D" .

  now[] now.asOf
  now[] now.timestampStr .

  BM_TimerNew
  BM_TimerBegin

  1 0 do

    ": exp_fl D1" .

    0 pFile file.seek

    ": exp_fl D2" .
    pCsvBuffer pFile file.ReadChunk assert

    //pCsvBuffer csvBuffer.print

    ": exp_fl D3" .
    pCsvBuffer pConvertor convertor.inspect

    ": exp_fl D4" .
  loop
  
  BM_TimerUpdate
  
  aggTimer[] aggTimer.reportStr .

  now[] now.asOf
  now[] now.timestampStr .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
": exp_fl E" .

  pFile file.close
  pFile file.delete

  pCsvBuffer csvBuffer.delete

  pConvertor convertor.delete

": exp_fl F" .
;

