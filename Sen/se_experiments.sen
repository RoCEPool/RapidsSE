/*----------------------------------------------------------------------------*/
/* experiment 2                                                               */
/*----------------------------------------------------------------------------*/

: exp2 prompt

  [? 0 ?if
    "0 compiled in" .
  ?else
    "0 not compiled in" .
  ?]

  [? 1 ?if
    "1 compiled in" .
  ?else
    "1 not compiled in" .
  ?]

  [? 6 3 / 1 == ?if
    "6 3 / 1 == compiled in" .
  ?else
    "6 3 / 1 == not compiled in" .
  ?]

  [? 6 3 / 2 == ?if
    "6 3 / 2 == compiled in" .
  ?else
    "6 3 / 2 == not compiled in" .
  ?]
;

