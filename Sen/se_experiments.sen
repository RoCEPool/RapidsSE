/*============================================================================*/
/* se_experiments.sen -- forth experiments                                    */
/*============================================================================*/

" se_experiments.sen" .verbose

/*----------------------------------------------------------------------------*/
/* exit test                                                                  */
/*----------------------------------------------------------------------------*/
: exit_test \prompt

  set_hook
  //[ "eg_hook" compiler::current@ word.exitHook! ]

  1 if
    "exit with hook" . exit
  else
    "normal exit"    . exit_rt
  then
;

/*----------------------------------------------------------------------------*/
/* hello world                                                                */
/*----------------------------------------------------------------------------*/
: helloWorld \prompt

  "Hello World!" .
;


/*----------------------------------------------------------------------------*/
/* experiment 1                                                               */
/*----------------------------------------------------------------------------*/
: exp1 \prompt

"
  pipelineLocal recurringDemon

  begin

    stage stageA on origin :
      start | recurring | eatAll | stageA

  end ;
" locals| sPipeLine |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<testTag> = 0x1234" sPipeLine api::spawnDemon not if
    "Error Code %v" .printf
  then
;


// tag <pre_execute> = demon::install endTag

/*----------------------------------------------------------------------------*/
/* experiment 2                                                               */
/*----------------------------------------------------------------------------*/
: exp2 \prompt

  [? 0 ?if
    "0 compiled in" .
  ?else
    "0 not compiled in" .
  ?]

  [? 1 ?if
    "1 compiled in" .
  ?else
    "1 not compiled in" .
  ?]

  [? 6 3 / 1 == ?if
    "6 3 / 1 == compiled in" .
  ?else
    "6 3 / 1 == not compiled in" .
  ?]

  [? 6 3 / 2 == ?if
    "6 3 / 2 == compiled in" .
  ?else
    "6 3 / 2 == not compiled in" .
  ?]
;


/*----------------------------------------------------------------------------*/
/* the toRsb convertor experiment                                             */
/*----------------------------------------------------------------------------*/
: exp3 \prompt

;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp4 \prompt

"
  create table definition __Exp4 (
    nodeName       VARCHAR NOT NULL ,
    partition      INTEGER NOT NULL ,
    buffers        INTEGER NOT NULL ,
    entries        INTEGER NOT NULL
  ) ;
"
  locals| sStmt |

  "" sStmt api::executeRequest
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp5 \prompt

  "<promptTag>" job[] job.tagSet@ tagSet.hasName if
    <promptTag> "<promptTag> = %v" .printf
  else
    "NO SUCH <promptTag>" .
  then
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp6 \prompt

  job[] job.tagSet@ tagSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp7 \prompt

  arrange::allWords locals| pArrange |
  pArrange arrange.print
  pArrange arrange.delete

  // - - - - - - -

  find: _cmdTags arrange::wordsOfCatg to pArrange
  pArrange arrange.print
  pArrange arrange.delete
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
