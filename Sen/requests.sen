/*============================================================================*/
/* requests.sen -- the request set groups                                     */
/*============================================================================*/

"-requests.sen" .verbose

"requests_basics.sen"      include
"requests_tenant.sen"      include
"requests_schema.sen"      include
"requests_folder.sen"      include
"requests_misc.sen"        include

// create the root /tenants dictionary
dicTenants: tenants

// create /tenants/boray/catalogs/rapidsse/schemas/public

// create the default folder hierarchy if not reloading
// args.reload not if
//   createDefaultFolders
// then

createDefaultFolders


/*============================================================================*/
/* end                                                                        */
