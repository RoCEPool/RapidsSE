// create /tenants/boray/catalogs/rapidsse/schemas/public
createDefaultFolders

/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *

---------------------
Connection Requests:
---------------------
connectCluster connectCluster

------------------
Tenant Requests:
-----------------
lsten   list_tenants
mkten   create_tenant
rmten   drop_tenant

-----------------
Catalog Requests:
-----------------
mkcat   create_catalog
lscat   list_catalogs
rmcat   drop_catalog

-----------------
Schema Requests:
-----------------
lssch   list_schemas
mksch   create_schema
rmsch   drop_schema
usesch  use_schema

-----------------
Table Requests:
-----------------
add     add_column
antbl   analyze_table
cp      copy_table
dantbl  danalyze_table
dex     dist_export_table
dump    dump_table
ex      export_table
gettbl  get_table
ld      load_table
lstbl   list_tables
lwrsel  lower_select
mktbl   create_table
rettbl  return_table
rgesel  range_select_table
rmtbl   drop_table
sel     select_table
sz      size_table
tableSizes size_tables
tblInUse  table_inuse
tr      truncate_table

-----------------
Index Requests:
-----------------
anidx     analyze_index
dumpidx   dump_index
mkidx     create_index
lsidx     list_indexes
lwrselidx lower_select_index
rmidx     drop_index
szidx     size_index
tridx     truncate_index
 
-----------------
Column Requests:
-----------------
add     add_column
addidx   add_idxcolumn
lscol   list_columns
lsidxcol list_indexcolumns
 
---------------------
Dictionary Requests:
---------------------
cf      cf ..
cf ~
cf
pwf     pwf
lf      lf
rf      remove_folder
 
-----------------
Misc Requests:
-----------------
seitf   seitf_count
mon     get_monitor
object  object
ping    ping
x       x

-----------------
Grid Request:
-----------------
lfG     lf on grid
pRB     print a row buffer on each node

