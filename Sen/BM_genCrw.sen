/*============================================================================*/
/* BM_genCrw.sen -- Benchmark Operator genCrw                                 */
/*============================================================================*/

" BM_genCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenCrw_PulseMarker \handler

  // pipe out the pulse marker to the next operator
  Operand[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // new a stream def
  Operand[].newStreamDef

  Operand[].pipeOut

  // generate the crw buffer's
  <nBuffers> >int tablePtn[].genCrwBuffers to Operand[]
  Operand[].pipeoutSet

  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                      */
/*----------------------------------------------------------------------------*/
: BM_GenCrw_StartMarker \handler

  "BM_GenEnt_StartMarker" .

  op__table
  table[].tablePtn@ to tablePtn[]

  folderPath.str     "Folder path: %v" .printf
  folderContents.str "contains: %v" .printf

  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* BM_GenCrwOp request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BM_GenCrwOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: BM_GenCrw_PulseMarker true ZK_PULSEMARKER op[].handler!
  find: BM_GenCrw_StartMarker true ZK_STARTMARKER op[].handler!

  op__loop

  "*** BM_GenCrwOp EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: BM_GenCrwOp :: BM_GenCrwOp <tableNm> <nBuffers> ;

jobInfo: BM_GenCrwOp
{
  <jobDesc>  = "--description of job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_PARTICIPANT_RESPONSE
  <ddlLock>  = DL_GRAB_READ
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
