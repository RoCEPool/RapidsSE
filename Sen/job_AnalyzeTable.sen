/*============================================================================*/
/* job_AnalyzeTable.sen -- Job Analyze Table                                  */
/*============================================================================*/

" job_AnalyzeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a analyzable table folder                                 */
/*----------------------------------------------------------------------------*/
: checkAnalyzeTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* anakyze table request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: analyzeTable::request _eeh ( -- <R> )

  tp: analyzeTable

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set metadata string in the job
  args.metadata if
    <detailed> 1 == if
      "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, bufferLevel VARCHAR, entries INTEGER)"
    else
      "(nodeName VARCHAR, partition INTEGER, buffers INTEGER, entries INTEGER)"
    then
    job::this job.metadata!

  then
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeTable job on a node                                     */
/*----------------------------------------------------------------------------*/
: analyzeTable::execute _eeh ( -- )

  job::this locals| pJob_AnalyzeTable |

  0 0 locals| sTableNm bIsDetailed |

  tp: analyzeTable_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table
  <tableNm> to sTableNm
  sTableNm pushTable assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // analyze the table
  <detailed> sTableNm find execute table.analyze

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // put response in the job
  pJob_AnalyzeTable job.response!
  grid::slots pJob_AnalyzeTable job.rowsProcessed!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table
  popTable
;

/*----------------------------------------------------------------------------*/
/* execute Job_AnalyzeTable job check resources                               */
/*----------------------------------------------------------------------------*/
: analyzeTable::checkResources _eeh ( -- )

  tp: analyzeTable.checkResources
  //"checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove the table
  <tableNm>
  checkAnalyzeTable not if job::this <ERROR_JOB> !!logError exit then
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
jobSyntax: analyzeTable :: analyzeTable <tableNm> ;
jobSyntax: analyzeTable :: analyzeTable <tableNm> <detailed> ;
jobSyntax: analyzeTable :: antbl <tableNm> ;
jobSyntax: analyzeTable :: antbl <tableNm> <detailed> ;

jobInfo: analyzeTable
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_ANALYZETABLE
  <?jobKind?>  = JK_DIST2PC
  <?rspKind?>  = RS_NODE_ROWS
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
