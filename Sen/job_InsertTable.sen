/*============================================================================*/
/* job_InsertTable.sen -- Job Insert Table                                    */
/*============================================================================*/

" job_InsertTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send last buffers to all partitions                                        */
/*----------------------------------------------------------------------------*/
: InsertTable_sendLast ( pJob_InsertTable -- )

  params| pJob_InsertTable  |
  0 0 locals| pThisTask pJob_SubInserter |

  task::this to pThisTask

  // calculate total partitions in the cluster
  grid::slots grid::nodes * locals| nTotalPartitions |

  pJob_InsertTable job_InsertTable.SubInserterJob@ to pJob_SubInserter
  //pJob_InsertRowss .

  // grab this task's lock
  pThisTask task.grabLock

  grid::slots task::acks!

  pJob_SubInserter Job_SubInserter.end

  //"InsertTable_sendLast ack waiting" .verbose
  task::wait
  //"InsertTable_sendLast acked" .verbose
;

/*----------------------------------------------------------------------------*/
/* wait for ack only                                                          */
/*----------------------------------------------------------------------------*/
: InsertTable_waitOnly ( pJob_InsertTable --  )

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab this task's lock
  task::this task.grabLock

  grid::slots task::acks!

  //"InsertTable_waitOnly waiting" .verbose
  task::wait
  //"InsertTable_waitOnly acked" .verbose
;


/*----------------------------------------------------------------------------*/
/* Job_InsertTable request (on originating node)                              */
/*----------------------------------------------------------------------------*/
: insertTable_req (  -- <R> )

  >>am <SEED_REQ>

  0 0 locals| pJob pTask |

  tp: createTable

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob

  // distribute the job
  pJob job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_InsertTable job on each node                                   */
/*----------------------------------------------------------------------------*/
: insertTable_exe ( Job_InsertTable -- )

  >>am <SEED_EXE>

  job::this locals| pJob_InsertTable |

  0 0 locals| pTable sTableNm |

  tp: insertTable_exe

  //----------------------------------------------------------------------------
  // assert correct job
  CN_JOB_INSERTTABLE pJob_InsertTable object.assertClass

  //----------------------------------------------------------------------------
  // grab a lock ????

  pJob_InsertTable job::originator@ locals| iOriginNode |
  grid::thisNode@ locals| iThisNode |

  //iThisNode iOriginNode "Originating node %v; this node %v" fmt.print
  
  iThisNode iOriginNode == if
    //"InsertTable is executing on this node" .
    pJob_InsertTable InsertTable_sendLast
  else
    //"InsertTable is not executed on this node" .
    InsertTable_waitOnly
  then

  //----------------------------------------------------------------------------
  pJob_InsertTable job.notice

  // delete_completed_job

  pJob_InsertTable send_job__executed

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_InsertTable job check resources                                */
/*----------------------------------------------------------------------------*/
: insertTable.checkResources ( pJob_InsertTable -- )

  params| pJob_InsertTable  |

  tp: insertTable.checkResources
  //checkResources received" .
;

/*----------------------------------------------------------------------------*/
/* execute Job_InsertTable job release resources                              */
/*----------------------------------------------------------------------------*/
: insertTable.releaseResources ( pJob_InsertTable -- )

  tp: insertTable.releaseResources
  //releaseResources received" .
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: insertTable_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_InsertTable |

  ">> insertTable_beg <<" .verbose

  // add this job to the participants list
  pJob_InsertTable job.beginParticipant

  // check resources
  pJob_InsertTable insertTable.checkResources

  // this job has begun
  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: insertTable_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_InsertTable |

  ">> insertTable_end <<" .verbose

  // release resources
  pJob_InsertTable insertTable.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: insertTable_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_InsertTable |

  pJob_InsertTable insertTable.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
