/*============================================================================*/
/* requests_tenant.sen -- the set of tenant related requests                  */
/*============================================================================*/

"requests_tenant.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a tenant                                                            */
/*----------------------------------------------------------------------------*/
/*
: createTenant_req ( "<tenantNm>" -- <R> )

  tp: createTenant

  snap0:

  ddlLock::grabWrite

  checkEnoughBuffers not if <NIP+ERROR> exit then
  checkMakeTenant    not if <NIP+ERROR> exit then

  makeTenant ( ) assert::stack_0

  snap1:
  printClassCounts

  tp: createdTenant

  <OK>
;
*/
/*----------------------------------------------------------------------------*/
/* drop a tenant                                                              */
/*----------------------------------------------------------------------------*/
/*
: dropTenant_req ( "<tenantNm>" -- <R> )

  tp: dropTenant

  snap0:

  ddlLock::grabWrite

  checkRemoveTenant not if <NIP+ERROR> exit then

  removeTenant ( ) assert::stack_0

  tp: droppedTenant

  snap1:
  printClassCounts

  <OK>
;
*/

/*----------------------------------------------------------------------------*/
/* get list of tenants                                                        */
/*----------------------------------------------------------------------------*/
/*
: listTenants_req ( -- <R> )

  ddlLock::grabRead

  checkInTenants not if <NIP+ERROR> exit then

  listContents

  <SUCCESS>
;
*/
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
