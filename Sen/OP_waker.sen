/*============================================================================*/
/* OP_waker.sen -- Operator waker                                             */
/*============================================================================*/

" OP_waker.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: waker_StartMarker \handler

  begin

    1 thread::sleepSsec

    // "checking..." .

    queues::checkSleeping

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/* execute for waker req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : waker_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: waker_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: waker :: waker ;

: waker _cmdTags tagCopy: serviceOp_tags

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
