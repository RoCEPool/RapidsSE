/*============================================================================*/
/* OP_waker.sen -- Operator waker                                             */
/*============================================================================*/

" OP_waker.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: wakerOP_StartMarker \handler

  begin

    1 thread::sleepSsec

    // "checking..." .

    queues::checkSleeping

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/* execute for waker req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : wakerOP_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: wakerOP_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: wakerOP :: wakerOP ;

: wakerOP _cmdTags

  tags{
    <jobKind>  = JK_LOCAL
    <rspKind>  = RS_PARTICIPANT_RESPONSE
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
