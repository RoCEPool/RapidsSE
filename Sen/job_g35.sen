"job_G35.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute Job_G35 job                                                        */
/*----------------------------------------------------------------------------*/
: Job_G35.execute ( pJob -- )

  locals| pJob |

  CN_JOB_G35 pJob object.assertClass

  pJob job.notice
;

