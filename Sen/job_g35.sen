"job_G35.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute Job_G35 job                                                        */
/*----------------------------------------------------------------------------*/
: Job_G35.execute ( pJob_G35 -- )

  locals| pJob_G35 |

  CN_JOB_G35 pJob_G35 object.assertClass

  pJob_G35 job.notice
;

