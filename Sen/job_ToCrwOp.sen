/*============================================================================*/
/* job_ToCrwOpOp.sen -- Job ToCrwOp                                           */
/*============================================================================*/

" job_ToCrwOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is a valid table folder                                      */
/*----------------------------------------------------------------------------*/
: checkTable ( "<tableNm>" -- true | errorCode false )

  params| sTableNm |

  // check in tables folder
  checkInTables not if false exit then

  // check if tableNm is a word in tables folder
  sTableNm checkIsWord not if EC_NO_SUCH_TABLE false exit then

  // push table folder
  sTableNm pushTable assert

  sTableNm checkIsTable not if popTable false exit then
  //sTableNm tableInUse if popTable EC_TABLE_IN_USE false exit then

  // pop table folder
  popTable

  // assert in tables
  assertInTables

  true
;

/*----------------------------------------------------------------------------*/
/* execute for ToCrwOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCrwOp_req ( -- )

  >>logEntry <SEED_REQ>

  job::this locals| pJob_ToCrwOp |

  0 0 locals| sTableNm pTable |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can access the table
  <tableNm> to sTableNm
  sTableNm checkTable not if
  pJob_ToCrwOp <ERROR_JOB> !!logError exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // move to table folder and find the table and tablePtn
  sTableNm pushTable assert
  sTableNm find execute to table[]

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER of
        "Operand:- ZK_CSVBUFFER" .verbose
        table[].get Operand[].csvToCrw
        Operand[].get to Subset[]
        begin
          Operand[].isNull
        not while
          assert::stack_0
          Operand[].pipeOut
          Subset[].nextBuffer to Operand[]
          assert::stack_0
        repeat
        true
      endof

      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .verbose
        Operand[].handleEnd
      endof

      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .verbose
        Operand[].delete
        Operand[].newStreamDef
        Operand[].pipeOut
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToCrwOp :: ToCrwOp <tableNm> ;

jobInfo: ToCrwOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_TOCRWOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
