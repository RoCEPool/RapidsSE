/*============================================================================*/
/* job_ToCrwOpOp.sen -- Job ToCrwOp                                           */
/*============================================================================*/

" job_ToCrwOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for ToCrwOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCrwOp_req ( -- )

  >>logEntry <SEED_REQ>

  job::this locals| pJob_ToCrwOp |

  <tableNm> locals| sTableNm |

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> <nextOp> op.nextStage!

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER of
        //"Operand:- ZK_CSVBUFFER" .verbose
        // use extractRow from register0 and convert csvtoCrw
        Operand[].csvToCrw
        Operand[].delete
        true
      endof

      ZK_EOSMARKER of
        //"Operand:- ZK_EOSMARKER" .verbose
        writeBehind[].handleDangling

        // delete writeBehind
        writeBehind[].delete

        // deelete extractRow from reister0
        extractRow.delete

        Operand[].pipeOut
        true
      endof

      ZK_ERRORMARKER of
        //"Operand:- ZK_ERRORMARKER" .verbose
        Operand[].pipeOut
        true
      endof

      ZK_PULSEMARKER of
        //"Operand:- ZK_PULSEMARKER" .verbose
        // create a write behind
        writeBehind[].create

        // create an extractRow and put it in register 0
        extractRow.create to register0[]

        Operand[].pipeOut
        true
      endof

      ZK_STARTMARKER of
        //"Operand:- ZK_STARTMARKER" .verbose
        // check if we can scan the table
        sTableNm checkIsValidTable not if
          op.pipelineJob@ <ERROR_JOB> !!logError
          Operand[].delete
          Operand[].newErrorMarker
        else
          // move to table folder and find the table and tablePtn
          sTableNm pushTable assert
          sTableNm find execute to table[]
        then

        Operand[].pipeout
        true
      endof

      ZK_STOPMARKER of
        //"Operand:- ZK_STOPMARKER" .verbose
        Operand[].pipeOut
        Op.ackPipelineJob
        false
      endof

      ZK_STREAMDEF of
        //"Operand:- ZK_STREAMDEF" .verbose
        Operand[].delete
        Operand[].newStreamDef
        Operand[].pipeOut
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToCrwOp :: ToCrwOp <tableNm> <topology> <nextStage> <nextOp> ;

jobInfo: ToCrwOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_TOCRWOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
