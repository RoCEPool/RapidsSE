/*============================================================================*/
/* job_ToCrwOpOp.sen -- Job ToCrwOp                                           */
/*============================================================================*/

" job_ToCrwOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for ToCrwOp req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : ToCrwOp_req ( -- )

  >>logEntry <SEED_REQ>

  begin

    // bide till next operand is available
    Operand[].bide

    // pop next operand from queue into Operand[]
    Operand[].next

    // decode kind
    Operand[].kind case

      ZK_CSVBUFFER of
        "Operand:- ZK_CSVBUFFER" .verbose
        Operand[].csvToCrw
        Operand[].get to Subset[]
        begin
          Operand[].isNull
        not while
          assert::stack_0
          Operand[].pipeOut
          Subset[].nextBuffer to Operand[]
          assert::stack_0
        repeat
        true
      endof

      ZK_ENDMARKER of
        "Operand:- ZK_ENDMARKER" .verbose
        Operand[].handleEnd
      endof

      ZK_STREAMDEF of
        "Operand:- ZK_STREAMDEF" .verbose
        Operand[].delete
        StreamDef[].newToCsvStream
        true
      endof

    endcase

  while assert::stack_0 repeat

  <<logExit
  job::deleteThis
  <DONE_RUN>
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobSyntax: ToCrwOp :: ToCrwOp ;

jobInfo: ToCrwOp
{
  <?jobDesc?>  = "--description of job--"
  
  <?jobType?>  = JT_TOCRWOP
  <?jobKind?>  = JK_LOCAL
  <?rspKind?>  = RS_NODE_ZERO
  <?ddlLock?>  = DL_GRAB_READ
  
  <?preCheck?> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
