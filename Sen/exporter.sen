/*============================================================================*/
/* exporter.sen -- table exporter                                              */
/*============================================================================*/

"exporter.sen" .verbose

: export ( "<fileNm>" ^table )

  swap file::new

  >r
  // r0 ^file

  r0 file.path! OPEN_WRITE r0 file.open
  not if rdrop drop EC_INVALID_FILE false exit then

  "__sel_cursor" find dup if else
    drop "__sel_cursor" :selCursor
  then
  execute

  >r
  // r0 ^selCursor
  // r1 ^file

  r0 selCursor.table!

  grid.slots 0
  do
    // r2 ^selCursor
    // r3 ^file

    I r2 selCursor.begin
    r2 selCursor.first
    begin
      while
      r2 selCursor.get
//dup .
      r3 file.write
      "\n" r3 file.write
      r2 selCursor.next
    repeat

    r2 selCursor.end
  loop

  r1 file.close

  rdrop rdrop

  "__sel_cursor" find word.forget

  true
;

: exportTest

//traceon

    "/tmp/nation.txt" "nation" find execute

    export

traceoff
;

: tableExporter ( "<fileNm>" "<tableNm>" )

  find execute ( "<fileNm>" table )

  export
  if
    true
  else
    false
  then
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
