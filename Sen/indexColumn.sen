    indexCols 0 do
      I indexPtr index.columnType
      I indexPtr index.columnName
      "row: ('%v', '%v')\n" str.format
      str.cat
    loop
    indexCols task::this task.seitf@ seitf.rowsProcessed
  else

    indexCols 0 do
      I indexPtr index.columnType
      I indexPtr index.columnName
      "%v %v " str.format
      I 1 + indexCols < if
        ", " str.cat
      then
      str.cat
    loop
  then

;
*/
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* add an index column (called by addIndexColumn)                             */
/*----------------------------------------------------------------------------*/
: add_indexColumn ( "<columnNm>" "<indexNm>" -- )

  0 locals| indexPtr indexNm columnNm |

  // push the index sub folder
  indexNm
  pushIndexSub assert

  // push index columns folder
  pushIndexColumns assert

  columnNm columnNm    ( "<columnNm>" "<columnNm>" )
  :indexColumn

  // pop index columns folder
  popIndexColumns

  // pop the index sub folder
  popIndexSub
;


/*----------------------------------------------------------------------------*/
/* add an index column (run by all participants)                              */
/*----------------------------------------------------------------------------*/
: addIndexColumn allParticipants 2 checkResult ( "<columnNm>" "<indexNm>" -- <result> )

  0 locals| indexPtr indexNm columnNm |

  args.tracepoint if
    "ADDING COLUMN " indexNm str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  tp: addingIndexColumn

  columnNm indexNm add_indexColumn

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* create the column vector of the index                                      */
/*----------------------------------------------------------------------------*/
