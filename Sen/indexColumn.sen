/*============================================================================*/
/* indexColumn.sen -- index column related words                              */
/*============================================================================*/

"indexColumn.sen" .verbose

: indexColumn: ;

: makeIndexColumns ( "<indexNm>" -- )

  find execute ( dic )
  index.subDic pathPush "columns" :dic drop pathDrop
;

: withinIndexColumns
    0 pathPick dic.name "columns" str.equal
;

: checkInIndexColumns
    withinIndexColumns if true exit then
    EC_NOT_IN_COLUMNS false
;

: pushIndexColumns ( -- )

    "columns" checkIsWord

    not if EC_NO_COLUMNS_DIC false exit then

    execute pathPush

    true
;

: popIndexColumns
    pathDrop
;

: :indexColumn ( "<columnName>" )
    :constant
;

: checkAddIndexColumn ( "<columnName>" "<indexNm>" -- true | eEC false )

  locals| indexNm columnNm |

  checkInIndexes not if false exit then

  indexNm
  pushIndexSub   assert // not if false exit then

  columnNm
  pushIndexColumns assert // not if false exit then

  // column should not already exist
  findInCurrent
  if EC_DUPLICATE_COLUMN false popIndexColumns popTable exit then

  popIndexColumns

  popIndexSub

  true
;

/*----------------------------------------------------------------------------*/
/* list columns of an index                                                   */
/*----------------------------------------------------------------------------*/
: listIndexColumns ( "<indexNm>" -- list )

  find execute ( ^indexPtr )

  0 locals| indexCols indexPtr |
  indexPtr index.columnCount to indexCols

  ""                             // initial ls string
  indexCols 0 do
    I indexPtr index.columnType
    I indexPtr index.columnName
    "%v %v " str.format
    I 1 + indexCols < if
      swap ", " str.cat
    then
    str.cat
  loop

;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* add an index column (run by all participants)                              */
/*----------------------------------------------------------------------------*/
: addIndexColumn allParticipants 2 checkResult ( "<columnNm>" "<indexNm>" -- <result> )

  0 locals| indexPtr indexNm columnNm |

  args.tracepoint if
    "ADDING COLUMN " indexNm str.cat " on NODE " str.cat grid.thisNode@ >str str.cat .
  then

  //indexNm find execute to indexPtr

  tp: addingIndexColumn

  indexNm
  pushIndexSub   assert   // not if false exit then

  pushIndexColumns assert // not if false exit then

  // get the table from the index
  //indexPtr index.table@ ( tablePtr )

  columnNm columnNm    ( "<columnNm>" "<columnNm>" )
  :indexColumn

  popIndexColumns

  popIndexSub

  true <SUCCESS_RESULT>
;

/*----------------------------------------------------------------------------*/
/* create the column vector of the table                                      */
/*----------------------------------------------------------------------------*/
: columnVecIndex allParticipants 1 checkResult ( "<indexNm>" -- true n# true )

  0 locals| indexPtr indexNm |

  "columnVecIndex" . indexNm .

  // get index ptr
  indexNm findInCurrent execute to indexPtr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // double check we can see the index
  //indexPtr find execute stk drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // push the index sub dic and then the columns sub dic
  indexNm pushIndexSub  assert

  pushIndexColumns assert

  // double check the path
  //task.this task.dicStack dicPath.dump

  // iterate contents of columns dictionary 
  0 pathPick dic.lastWord dup
  iterate                        // iterate word cursor
    object@ execute              ( value )
    object@ word.name            ( value wordNm )
    indexPtr                     ( value wordNm ^table )
    //stk
    index.createColumnVec
    object@ word.prev object!    // advance cursor backwards thru words
  next

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //indexPtr index.showColumnVec

  assert.stack_0

  popIndexColumns

  popIndexSub

  true <SUCCESS_RESULT>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
