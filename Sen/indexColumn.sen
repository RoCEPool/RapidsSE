/*============================================================================*/
/* indexColumn.sen -- index column related words                              */
/*============================================================================*/

" indexColumn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* indexColumn is used as a kind of word to identify index columns            */
/*----------------------------------------------------------------------------*/
: indexColumn: ;

/*----------------------------------------------------------------------------*/
/* make the index columns sub folder                                          */
/*----------------------------------------------------------------------------*/
: makeIndexColumns ( "<indexNm>" -- )

  find execute ( dic )
  index.subDic pathPush "columns" :dic drop pathDrop
;

/*----------------------------------------------------------------------------*/
/* check within index columns folder                                          */
/*----------------------------------------------------------------------------*/
: withinIndexColumns
    0 pathPick dic.name "columns" str.equal
;

/*----------------------------------------------------------------------------*/
/* check in indexes columns folder                                            */
/*----------------------------------------------------------------------------*/
: checkInIndexColumns
    withinIndexColumns if true exit then
    EC_NOT_IN_COLUMNS false
;

/*----------------------------------------------------------------------------*/
/* find the index column folder and push it onto task dictionary              */
/*----------------------------------------------------------------------------*/
: pushIndexColumns ( -- )

    "columns" checkIsWord
    not if EC_NO_COLUMNS_DIC false exit then
    execute pathPush
    true
;

/*----------------------------------------------------------------------------*/
/* pop the index column folder                                                */
/*----------------------------------------------------------------------------*/
: popIndexColumns
    pathDrop
;

/*----------------------------------------------------------------------------*/
/* create index column as a constant                                          */
/*----------------------------------------------------------------------------*/
: :indexColumn ( "<columnName>" )
    :constant
;

/*----------------------------------------------------------------------------*/
/* check and add an index column                                              */
/*----------------------------------------------------------------------------*/
: checkAddIndexColumn ( "<columnName>" "<indexNm>" "<tableNm>" -- true | eEC false )

  locals| tableNm indexNm columnNm |

  // check we are in the indexes folder
  checkInIndexes not if false exit then

  // move out of the indexes folder temporarily
  popIndexes

  // push the table sub folder
  tableNm pushTableSub assert

  // push the table columns folder
  pushColumns

  // look for the index column in the table columns
  columnNm findInCurrent

  // column should exist in table
  not if EC_INVALID_COLUMN false popColumns popTableSub pushIndexes assert exit then

  // pop the columns folder
  popColumns

  // pop the tables sub folder
  popTableSub

  // push back the indexes folder
  pushIndexes assert

  // push the index sub folder
  indexNm
  pushIndexSub assert   // not if false exit then

  // push the index columns folder
  pushIndexColumns assert // not if false exit then

  // look for the column in the indexes columns
  columnNm findInCurrent

  // column should not already exist
  if EC_DUPLICATE_COLUMN false popIndexColumns popIndexSub exit then

  //pop the index columns folder
  popIndexColumns

  // pop the index sub folder
  popIndexSub

  assertInIndexes

  true
;

/*----------------------------------------------------------------------------*/
/* list columns of an index                                                   */
/*----------------------------------------------------------------------------*/
