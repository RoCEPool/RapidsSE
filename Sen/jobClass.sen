/*============================================================================*/
/* jobClass.sen -- Job Class Compiler                                         */
/*============================================================================*/

" jobClass.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .fillEnmSet params| pEnmSet |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  "jobPriority" pEnmSet enmSet.hasName not if
     "jobPriority" "PY_NORMAL" pEnmSet enmSet.addStr then

  "SeedReq" word::name_trunc "_req" str.cat pEnmSet enmSet.addStr
  "SeedRcv" word::name_trunc "_beg" str.cat pEnmSet enmSet.addStr
  "SeedExe" word::name_trunc "_exe" str.cat pEnmSet enmSet.addStr
  "SeedEnd" word::name_trunc "_end" str.cat pEnmSet enmSet.addStr
  "SeedCan" word::name_trunc "_can" str.cat pEnmSet enmSet.addStr

  pEnmSet enmSet.asStr .
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobClass:

  0 locals| pEnmSet |

  // create a word using next token from input source as the word name
  create

  // set the word kind to be jobClass
  [ word::this , ] word::this word.kind!

  // attach an ename set to the word being created
  enmSet::new to pEnmSet
  pEnmSet word::this word.enmSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "JobName" word::name_trunc pEnmSet enmSet.addStr

  // skip the "{" token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    next-token
    dup "}" str.equal not
  while
    next-token drop next-token
    pEnmSet enmSet.addStr
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  next-token drop

  pEnmSet enmSet.asStr .

  pEnmSet .fillEnmSet

  pEnmSet enmSet.asStr .
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: findJobClassEnmSet ( sJobNm -- pEnmSet )

  params| sJobNm |

  sJobNm "_cls" str.cat find word.enmset@
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobClass: defineNode_cls
{
  jobKind      = JK_DIST2PC
  responseKind = RS_NODE_ZERO
  
  ddlLock      = DL_GRAB_WRITE
  preCheck     = bClusterStarted
}
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobClass: forgetNode_cls
{
  jobKind      = JK_DIST2PC
  responseKind = RS_NODE_ZERO
  
  ddlLock      = DL_GRAB_WRITE
  preCheck     = bClusterStarted
}
;




/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
