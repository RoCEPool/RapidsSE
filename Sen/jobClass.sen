/*============================================================================*/
/* jobClass.sen -- Job Class Compiler                                         */
/*============================================================================*/

" jobClass.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .wordName_trunc

  "_" word::this word.name str.removeSuffix
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .fillEnmSet params| pEnmSet |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  "jobPriority" pEnmSet enmSet.hasName not if
     "jobPriority" "PY_NORMAL" pEnmSet enmSet.addStr then

  .wordName_trunc "_req" str.cat "SeedReq" pEnmSet enmSet.addStr
  .wordName_trunc "_beg" str.cat "SeedRcv" pEnmSet enmSet.addStr
  .wordName_trunc "_exe" str.cat "SeedExe" pEnmSet enmSet.addStr
  .wordName_trunc "_end" str.cat "SeedEnd" pEnmSet enmSet.addStr
  .wordName_trunc "_can" str.cat "SeedCan" pEnmSet enmSet.addStr

  pEnmSet enmSet.asStr .
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobClass:

  // create a word using next token from input source as the word name
  create

  // set the word kind to be jobClass
  [ word::this , ] word::this word.kind!

  // attach an ename set to the word being created
  enmSet::new word::this word.enmSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // skip the "{" token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    next-token
    dup "}" str.equal not
  while
    next-token drop next-token
    word::this word.enmSet@ enmSet.addStr
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  next-token drop

  word::this word.enmSet@ enmSet.asStr .

  word::this word.enmSet@ .fillEnmSet

  word::this word.enmSet@ enmSet.asStr .
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
jobClass: forgetNode_cls
{
  jobKind      = JK_DIST2PC
  responseKind = RS_NODE_ZERO
  
  preCheck     = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
