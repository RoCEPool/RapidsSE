/*============================================================================*/
/* jobClass.sen -- Job Class Compiler                                         */
/*============================================================================*/

" jobClass.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: .fillEnmSet params| pEnameSet |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  "jobPriority" pEnameSet EnameSet.hasName not if
     "jobPriority" "PY_NORMAL" pEnameSet EnameSet.addStr then

  "SeedReq" word::name_trunc "_req" str.cat pEnameSet EnameSet.addStr
  "SeedRcv" word::name_trunc "_beg" str.cat pEnameSet EnameSet.addStr
  "SeedExe" word::name_trunc "_exe" str.cat pEnameSet EnameSet.addStr
  "SeedEnd" word::name_trunc "_end" str.cat pEnameSet EnameSet.addStr
  "SeedCan" word::name_trunc "_can" str.cat pEnameSet EnameSet.addStr

  pEnameSet EnameSet.asStr .
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobInfo:

  0 locals| pEnameSet |

  // create a word using next token from input source as the word name
  next-token "_cls" str.cat >create

  // set the word kind to be jobClass
  [ word::this , ] word::this word.category!

  // attach an ename set to the word being created
  EnameSet::new to pEnameSet
  pEnameSet word::this word.EnameSet!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "JobName" word::name_trunc pEnameSet EnameSet.addStr

  // skip the "{" token from input source
  next-token drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till "}", build ename set representing the syntax

  begin
    next-token
    dup "}" str.equal not
  while
    next-token drop next-token
    pEnameSet EnameSet.addStr
  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // drop the "}" from dstack
  drop

  // get and drop ";"
  next-token drop

  pEnameSet EnameSet.asStr .

  pEnameSet .fillEnmSet

  pEnameSet EnameSet.asStr .
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: findJobClassEnmSet ( sJobNm -- pEnameSet )

  params| sJobNm |

  sJobNm "_cls" str.cat find word.EnameSet@
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
