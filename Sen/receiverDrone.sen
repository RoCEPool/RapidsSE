/*============================================================================*/
/* ReceiverDrone.sen -- receiver drone                                        */
/*============================================================================*/

"ReceiverDrone.sen" .verbose

/*----------------------------------------------------------------------------*/
/* recv valset from the socket                                                */
/*----------------------------------------------------------------------------*/
: socket> ( -- valset )

  task::this task.socket@

  tp: receiving

  socket.recv

tp: received
;

/*----------------------------------------------------------------------------*/
/* receiver task processing loop                                              */
/*----------------------------------------------------------------------------*/
: rcv.loop ( socket -- )

tp: snd.loop

  task::this task.socket!

  "rcv.loop" task::this task.comment!

  receiverTaskPrint if "Receiver running on node" grid.thisNode@ >str str.cat . then

  begin
    depth 0 != if stk "stack of task has grown" . debug.trap then

    socket>

    exeOne

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
