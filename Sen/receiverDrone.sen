/*============================================================================*/
/* ReceiverDrone.sen -- receiver drone                                        */
/*============================================================================*/

"ReceiverDrone.sen" .verbose

/*----------------------------------------------------------------------------*/
/* recv valset from the socket                                                */
/*----------------------------------------------------------------------------*/
: socket> ( -- valset )

  task::this task.socket@

  tp: receiving

  socket.recv

tp: received
;

/*----------------------------------------------------------------------------*/
/* receiver task processing loop                                              */
/*----------------------------------------------------------------------------*/
: receiverLoop ( socket -- )

tp: rvc.loop

  task::this task.socket!

  "receiverLoop" task::this task.comment!

  receiverDronePrint if "Receiver Drone running on node" grid::thisNode@ >str str.cat . then

  begin
    depth 0 != if stk "stack of receiver task has grown" . debug::trap then

    socket>

    exeOne

  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
