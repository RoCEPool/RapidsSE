/*============================================================================*/
/* jobOperand.sen -- Job Operand                                              */
/*============================================================================*/

" jobOperand.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: ZK_CANCELMARKER_handler

  //"ZK_CANCELMARKER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ZK_CRWBUFFER_handler

  //"ZK_CRWBUFFER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ZK_CSVBUFFER_handler

  //"ZK_CSVBUFFER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ZK_ENTBUFFER_handler

  //"ZK_ENTBUFFER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: ZK_EOSMARKER_handler

  //"ZK_EOSMARKER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: ZK_ERRORMARKER_handler

  //"ZK_ERRORMARKER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_IRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ZK_IRWBUFFER_handler

  //"ZK_IRWBUFFER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: ZK_PULSEMARKER_handler

  //"ZK_PULSEMARKER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_SEEKOFFSETS ...                                             */
/*----------------------------------------------------------------------------*/
: ZK_SEEKOFFSETS_handler

  //"ZK_SEEKOFFSETS_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_SRTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: ZK_SRTBUFFER_handler

  //"ZK_SRTBUFFER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: ZK_STARTMARKER_handler

  //"ZK_STARTMARKER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: ZK_STARTEDMARKER_handler

  //"ZK_STARTEDMARKER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: ZK_STOPMARKER_handler

  //"jobOperand::generic:- ZK_STOPMARKER" .verbose
  Operand[].pipeOut
  Op.ackPipelineJob
  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPPEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: ZK_STOPPEDMARKER_handler

  //"ZK_STOPPEDMARKER_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: ZK_STREAMDEF_handler

  //"ZK_STREAMDEF_handler" .verbose
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobOperand::generic

  // decode kind
  Operand[].kind case

    ZK_CANCELMARKER of
      //"jobOperand::generic:- ZK_CANCELMARKER" .verbose
      "Query being cancelled\n" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_CRWBUFFER of
      //"jobOperand::generic: ZK_CRWBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_CSVBUFFER of
      //"jobOperand::generic: ZK_CSVBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_ENTBUFFER of
      //"jobOperand::generic: ZK_ENTBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_EOSMARKER of
      //"jobOperand::generic:- ZK_EOSMARKER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_ERRORMARKER of
      //"jobOperand::generic:- ZK_ERRORMARKER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_IRWBUFFER of
      //"jobOperand::generic::- ZK_IRWBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_PULSEMARKER of
      //"jobOperand::generic:- ZK_PULSEMARKER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_SEEKOFFSETS of
      //"jobOperand::generic: ZK_SEEKOFFSETS" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_SRTBUFFER of
      //"jobOperand::generic: ZK_SRTBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_STARTMARKER of
      //"jobOperand::generic:- ZK_STARTMARKER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_STOPMARKER of
      //"jobOperand::generic:- ZK_STOPMARKER" .verbose
      Operand[].pipeOut
      Op.ackPipelineJob
      false
    endof

    ZK_STREAMDEF of
      //"jobOperand::generic:- ZK_STREAMDEF" .verbose
      Operand[].pipeOut
      true
    endof

  endcase
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
