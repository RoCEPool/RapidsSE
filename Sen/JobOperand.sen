/*============================================================================*/
/* jobOperand.sen -- Job Operand                                              */
/*============================================================================*/

" jobOperand.sen" .verbose

/*----------------------------------------------------------------------------*/
/* install demon pipeline job                                                 */
/*----------------------------------------------------------------------------*/
: demon::install

  ddlLock[].dropRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "__" <pipelineNm> str.cat locals| sDemonNm |

  sDemonNm "installing demon pipeline job: %v" .printf

  sDemonNm >createInRoot locals| pDemonWd |

  job[] pDemonWd word.object!
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobOperand::generic

  // decode kind
  Pipein[].kind case

    ZK_CANCELMARKER of
      "jobOperand::generic:- ZK_CANCELMARKER" .
      "Pipeline being cancelled\n" .
      Pipein[].pipeOut
      Op.ackPipelineJob
      false
    endof

    ZK_CANCELLEDMARKER of
      "jobOperand::generic:- ZK_CANCELLEDMARKER" .
      "Pipeline being cancelled\n" .
      Pipein[].pipeOut
      Op.ackPipelineJob
      false
    endof

    ZK_CRWBUFFER of
      //"jobOperand::generic: ZK_CRWBUFFER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_CSVBUFFER of
      //"jobOperand::generic: ZK_CSVBUFFER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_ENTBUFFER of
      //"jobOperand::generic: ZK_ENTBUFFER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_EOSMARKER of
      //"jobOperand::generic:- ZK_EOSMARKER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_EXITMARKER of
      //"jobOperand::generic:- ZK_EXITMARKER" .verbose
      Pipein[].pipeOut
      Op.ackPipelineJob
      false
    endof

    ZK_EXITEDMARKER of
      //"jobOperand::generic:- ZK_EXITEDMARKER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_ERRORMARKER of
      //"jobOperand::generic:- ZK_ERRORMARKER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_INFOSET of
      //"jobOperand::generic:- ZK_INFOSET" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_IRWBUFFER of
      //"jobOperand::generic::- ZK_IRWBUFFER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_PULSEMARKER of
      //"jobOperand::generic:- ZK_PULSEMARKER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_PULSEDMARKER of
      //"jobOperand::generic:- ZK_PULSEDMARKER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_SRTBUFFER of
      //"jobOperand::generic: ZK_SRTBUFFER" .verbose
      Pipein[].pipeOut
      true
    endof

    ZK_STARTMARKER of
      "jobOperand::generic:- ZK_STARTMARKER" .
      Pipein[].pipeOut
      true
    endof

    ZK_STREAMDEF of
      //"jobOperand::generic:- ZK_STREAMDEF" .verbose
      Pipein[].pipeOut
      true
    endof

  endcase
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
