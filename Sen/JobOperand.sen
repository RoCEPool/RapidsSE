/*============================================================================*/
/* jobOperand.sen -- Job Operand                                              */
/*============================================================================*/

" jobOperand.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: OP_generic_CancelMarker

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: OP_generic_CrwBuffer

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: OP_generic_CsvBuffer

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: OP_generic_EntBuffer

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: OP_generic_EosMarker

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: OP_generic_ErrorMarker

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_IRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: OP_generic_IrwBuffer

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: OP_generic_PulseMarker

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_SEEKOFFSETS ...                                             */
/*----------------------------------------------------------------------------*/
: OP_generic_SeekOffsets

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_SRTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: OP_generic_SrtBuffer

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: OP_generic_StartMarker

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STOPMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: OP_generic_StopMarker

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: OP_generic_StreamDef

;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: jobOperand::generic

  // decode kind
  Operand[].kind case

    ZK_CANCELMARKER of
      //"jobOperand::generic:- ZK_CANCELMARKER" .verbose
      "Query being cancelled\n" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_CRWBUFFER of
      //"jobOperand::generic: ZK_CRWBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_CSVBUFFER of
      //"jobOperand::generic: ZK_CSVBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_ENTBUFFER of
      //"jobOperand::generic: ZK_ENTBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_EOSMARKER of
      //"jobOperand::generic:- ZK_EOSMARKER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_ERRORMARKER of
      //"jobOperand::generic:- ZK_ERRORMARKER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_IRWBUFFER of
      //"jobOperand::generic::- ZK_IRWBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_PULSEMARKER of
      //"jobOperand::generic:- ZK_PULSEMARKER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_SEEKOFFSETS of
      //"jobOperand::generic: ZK_SEEKOFFSETS" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_SRTBUFFER of
      //"jobOperand::generic: ZK_SRTBUFFER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_STARTMARKER of
      //"jobOperand::generic:- ZK_STARTMARKER" .verbose
      Operand[].pipeOut
      true
    endof

    ZK_STOPMARKER of
      //"jobOperand::generic:- ZK_STOPMARKER" .verbose
      Operand[].pipeOut
      Op.ackPipelineJob
      false
    endof

    ZK_STREAMDEF of
      //"jobOperand::generic:- ZK_STREAMDEF" .verbose
      Operand[].pipeOut
      true
    endof

  endcase
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
