/*============================================================================*/
/* vocab_corePlus.sen -- words complentary to core words                    */
/*============================================================================*/

" vocab_corePlus.sen" .verbose

/*----------------------------------------------------------------------------*/
/* increment integer variable                                                 */
/*----------------------------------------------------------------------------*/
: ++ dup @ 1+ swap ! ;

/*----------------------------------------------------------------------------*/
/* decrement integer variable                                                 */
/*----------------------------------------------------------------------------*/
: -- dup @ 1- swap ! ;

/*----------------------------------------------------------------------------*/
/* define a constant (using name on stack)                                    */
/*----------------------------------------------------------------------------*/
: :constant

  // create a word using the string on top of the stack
  :create

  // encode a push value of the value currently on the stack
  ,

  // encode a push value of the value currently on the stack
  POSTPONE exit_rt
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* forget named word                                                          */
/*----------------------------------------------------------------------------*/
: :forget ( <"wordNm"> )

  find dup not if drop exit_rt then

  word::delete
;

/*----------------------------------------------------------------------------*/
/* drop all values on stack except topmost                                    */
/*----------------------------------------------------------------------------*/
: nipAll ( ... top -- top )

  // handle expty stack case
  depth not if exit_rt then

  // save topmost
  >r

  // drop everything else
  begin
    depth while
      drop
  repeat

  // restore topmost
  r>
;

/*----------------------------------------------------------------------------*/
/* drop n values from stack                                                   */
/*----------------------------------------------------------------------------*/
: dropN ( ... #values -- )

  // handle expty stack case
  depth not if exit_rt then

  // drop n values
  0 ?do
    drop
  loop
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* get nested Word$$<n>                                                       */
/*----------------------------------------------------------------------------*/

: Word$$    compiler::nested@ ;
: Word$$0 0 compiler::nested@ ;
: Word$$1 1 compiler::nested@ ;
: Word$$2 2 compiler::nested@ ;
: Word$$3 3 compiler::nested@ ;
: Word$$4 4 compiler::nested@ ;
: Word$$5 5 compiler::nested@ ;
: Word$$6 6 compiler::nested@ ;
: Word$$7 7 compiler::nested@ ;
: Word$$8 8 compiler::nested@ ;
: Word$$9 9 compiler::nested@ ;

/*----------------------------------------------------------------------------*/
/* start compiling nested word                                                */
/*----------------------------------------------------------------------------*/
: :NestedWord$$ immediate

  word::new dup compiler::current! compiler::nested!
;

/*----------------------------------------------------------------------------*/
/* end compiling nested word                                                  */
/*----------------------------------------------------------------------------*/
: ;NestedWord$$ immediate

  POSTPONE exit_rt

  0 compiler::nested@
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
