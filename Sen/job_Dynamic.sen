/*============================================================================*/
/* job_Dynamic.sen -- Job Dynamic                                             */
/*============================================================================*/

" job_Dynamic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* dynamic command request (onn originating node)                             */
/*----------------------------------------------------------------------------*/
: dynamic_req ( -- <R> )

  >>logEntry <SEED_REQ>

  100 apiState::senLoc

  0 0 locals| pJob_dynamic pTask |

  //": dynamic_req" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the task
  task::this to pTask

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the job from the task
  pTask task.job@ to pJob_dynamic

  //pJob_dynamic "Job %v on originating node" str.format .

  // distribute the job
  pJob_dynamic job.distribute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ": dynamic_req END" .

  900 apiState::senLoc

  <<logExit <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_Dynamic job on a node                                          */
/*----------------------------------------------------------------------------*/
: dynamic_exe ( Job_dynamic -- )

  >>logEntry <SEED_EXE>

  task::this locals| pTask |
  job::this  locals| pJob_dynamic |

  //pJob_dynamic "Job %v on participant node" str.format .
  tp: dynamic_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  //----------------------------------------------------------------------------
  // set task's dictionary stack from path in job
  pJob_dynamic job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //pathDump

  pJob_dynamic job_Dynamic.execute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // end the startOp
  pJob_dynamic job_Dynamic.end

  pJob_dynamic job.notice

  pJob_dynamic job::participantExecuted

  <<logExit <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: dynamic_beg ( -- )

  >>logEntry <SEED_BEG>

  job::this locals| pJob_dynamic |

  pJob_dynamic job.becomeParticipant

  job::participantBegun

  <<logExit <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: dynamic_end ( -- )

  >>logEntry <SEED_END>

  job::participantEnded

  <<logExit <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: dynamic_can ( -- )

  >>logEntry <SEED_CAN>

  job::participantCancelled

  <<logExit <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
