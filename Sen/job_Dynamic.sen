/*============================================================================*/
/* job_Dynamic.sen -- Job Dynamic                                             */
/*============================================================================*/

" job_Dynamic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* dynamic command request                                                    */
/*----------------------------------------------------------------------------*/
: dynamic_req ( -- <R> )

  >>logEntry <SEED_REQ>

  100 apiState::senLoc

  ": dynamic_req" .

  task::this      locals| pTask |
  pTask task.job@ locals| pJob |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
/*
  0 locals| sTableNm |
  0 locals| pTable |

  0 locals| sIndexNm |
  0 locals| pIndex |

  // set dic stack
  pJob job.pushPath task::dicStack.set

  // grab a ddl lock
  ddlLock::grabRead

  // get table name
  pJob job.objectName@ to sTableNm

  // find table
  sTableNm pushTable assert
  sTableNm find execute to pTable
  pTable pJob jobMark2.table!

  // get index name
  pJob job.indexName@ to sIndexNm

  // find index
  sIndexNm '' str.equal not if
    pushIndexes assert
    sIndexNm find execute to pIndex
    pIndex pJob jobMark2.index!
    popIndexes
  then

  popTable
*/
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob job_Dynamic.begin
  pJob job_Dynamic.execute
  pJob job_Dynamic.end

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  task::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ": dynamic_req END" .

  900 apiState::senLoc

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
