/*============================================================================*/
/* job_Dynamic.sen -- Job Dynamic                                             */
/*============================================================================*/

" job_Dynamic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* dynamic command request                                                    */
/*----------------------------------------------------------------------------*/
: dynamic_req ( -- <R> )

  >>logEntry <SEED_REQ>

  100 apiState::senLoc

  ": dynamic_req" .

  task::this      locals| pTask |
  pTask task.job@ locals| pJob_Dynamic |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //pJob_Dynamic job_Dynamic.begin
  //pJob_Dynamic job_Dynamic.execute
  //pJob_Dynamic job_Dynamic.end

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  //task::wait

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ": dynamic_req END" .

  900 apiState::senLoc

  <<logExit <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
