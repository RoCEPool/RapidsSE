/*============================================================================*/
/* task.sen -- task related words                                             */
/*============================================================================*/

"task.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a task using string from input stream as name                       */
/*----------------------------------------------------------------------------*/

: task:

  create
  WT_OBJECT word.this word.type!
  sizeof_task allot
  word.this >body object.magic!
  CN_TASK word.this >body object.class!
  word.this >body task.init
  true word.this >body object.wordbody!
  does>
;

: :task

  >create
  WT_OBJECT word.this word.type!
  sizeof_task allot
  word.this >body object.magic!
  CN_TASK word.this >body object.class!
  word.this >body task.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* spawn a task                                                               */
/*----------------------------------------------------------------------------*/
: spawnTask ( ... nArgs sSeedWord sTaskNm -- )

  locals| sTaskNm sSeedWord nArgs |

  nArgs sSeedWord nullPtr task::new locals| pTask |
  sTaskNm pTask task.name!

  //nArgs sSeedWord pTask task.seed

  pTask scheduler::enqueueTask
  pTask  // return the task
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
