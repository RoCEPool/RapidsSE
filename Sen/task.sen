/*============================================================================*/
/* task.sen -- task ipc primitives                                            */
/*============================================================================*/

" task.sen" .verbose

: task::acks! ( nAcks -- ) task::this task.acks! ;

: task::wait  ( -- ) TS_WAITING task::this task.state! ;

: task::sendSocket@ task::this task.sendNode@ node.sendSocket@ ;

/*----------------------------------------------------------------------------*/
/* grab lock on socket                                                        */
/*----------------------------------------------------------------------------*/
: task::socketLock ( -- )

  task::this task.sendNode@ node.sendSocket@ socket.grabWrite
;

/*----------------------------------------------------------------------------*/
/* drop lock on socket                                                        */
/*----------------------------------------------------------------------------*/
: task::socketUnlock ( -- )

  task::this task.sendNode@ node.sendSocket@ socket.dropWrite
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
