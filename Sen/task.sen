/*============================================================================*/
/* task.sen -- task related words                                             */
/*============================================================================*/

"task.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create a task using string from input stream as name                       */
/*----------------------------------------------------------------------------*/

: task:

  create
  WT_OBJECT word.this word.type!
  sizeof_task allot
  word.this >body object.magic!
  CN_TASK word.this >body object.class!
  word.this >body task.init
  true word.this >body object.wordbody!
  does>
;

: :task

  >create
  WT_OBJECT word.this word.type!
  sizeof_task allot
  word.this >body object.magic!
  CN_TASK word.this >body object.class!
  word.this >body task.init
  true word.this >body object.wordbody!
  word.this
  does>
;

/*----------------------------------------------------------------------------*/
/* create a task using given arguments and append to general task queue       */
/*----------------------------------------------------------------------------*/
: spawnGeneralTask ( ... nArgs sSeedWord sTaskNm -- )

  nullPtr nullptr locals| pParent pTask sTaskNm sSeedWord nArgs |

  // create a new task
  nArgs sSeedWord pParent task::new to ptask

  // set task name
  sTaskNm pTask task.name!

  // append task onto general task queue
  pTask scheduler::enqueueGeneralTask

  pTask  // return the task
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
