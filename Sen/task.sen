/*============================================================================*/
/* task.sen -- task ipc primitives                                            */
/*============================================================================*/

" task.sen" .verbose

: setAcks     ( -- ) task::this task.acks! ;

: ackWait     ( -- ) TS_WAITING task::this task.state! ;
: ack         ( task -- ) task.ack ;

: task::sendSocket@ task::this task.sendNode@ node.sendSocket@ ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
