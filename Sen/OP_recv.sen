/*============================================================================*/
/* OP_recv.sen -- socket recv of operands                                     */
/*============================================================================*/

" OP_recv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: recv_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_PULSEMARKER ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: recv_PulseMarker \handler

  ZK_PULSEDMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_CSVBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: recv_CsvBuffer \handler

  ZK_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: recv_EosMarker \handler

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* recv request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: recv_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: recv_CsvBuffer   ZK_CSVBUFFER   op[].handler!
  find: recv_EosMarker   ZK_EOSMARKER   op[].handler!
  find: recv_PulseMarker ZK_PULSEMARKER op[].handler!
  find: recv_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: recv :: recv <portNo> ;

: recv _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
