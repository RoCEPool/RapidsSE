/*============================================================================*/
/* job_Sink.sen -- Sink Job                                                   */
/*============================================================================*/

" job_Sink.sen" .verbose

/*----------------------------------------------------------------------------*/
/* read chunks from input, write them to output                               */
/*----------------------------------------------------------------------------*/
: Sink_process ( pJob_Sink -- )

  params| pJob_Sink |

  begin pJob_Sink job_sink.chunk while repeat
;

/*----------------------------------------------------------------------------*/
/* Job_Sink request (on command node)                                         */
/*----------------------------------------------------------------------------*/
: Sink_req (  -- <R> )

  >>am <SEED_REQ>

  job::this locals| pJob_Sink |

  pJob_Sink Sink_process

  <<am <DONE_REQ>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
