/*============================================================================*/
/* job_CreateTenant.sen -- Job Create Tenant                                  */
/*============================================================================*/

" job_CreateSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check word is not already a tenant                                         */
/*----------------------------------------------------------------------------*/
: checkIsNotTenant ( word )
  findInCurrent not if true exit then
  EC_TENANT_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable tenant folder                                  */
/*----------------------------------------------------------------------------*/
: checkMakeTenant ( "<tenantNm>" -- true | errorCode false )

  checkInTenants    not if false exit then
  checkIsNotTenant  not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* make a tenant folder (run by participant)                                  */
/*----------------------------------------------------------------------------*/
: makeTenant ( "<tenantNm>" -- )


  params| sTenantNm |

  args.tracepoint if
    sTenantNm "MAKING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the tenant
  sTenantNm :tenant ( ^tenant )
  drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make catalogs folder
  sTenantNm makeCatalogs ( )
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTenant job on a node                                     */
/*----------------------------------------------------------------------------*/
: createTenant::execute _eeh ( -- )


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the catalog
  <tenantNm> makeTenant ( )
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTenant job check resources                               */
/*----------------------------------------------------------------------------*/
: createTenant::checkResources _eeh ( -- )

  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  node::checkEnoughBuffers not if job[] ERROR_JOB !!logError exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can make the catalog
  //pJob_CreateTenant job.tenantName@
  <tenantNm> checkMakeTenant not if job[] ERROR_JOB !!logError exit then

;


/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

opSyntax: createTenant :: create tenant <tenantNm> ;

jobInfo: createTenant
{
  <jobDesc>  = "--description of job--"
  
  ?<jobKind>?  = JK_DIST2PC
  ?<rspKind>?  = RS_PARTICIPANT_RESPONSE
  ?<ddlLock>?  = DL_GRAB_WRITE
  
  <preCheck> = bClusterStarted
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
