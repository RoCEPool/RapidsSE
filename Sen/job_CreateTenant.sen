/*============================================================================*/
/* job_CreateTenant.sen -- Job Create Tenant                                  */
/*============================================================================*/

" job_CreateSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check word is not already a tenant                                         */
/*----------------------------------------------------------------------------*/
: checkIsNotTenant ( word )
  findInCurrent not if true exit then
  EC_TENANT_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable tenant folder                                  */
/*----------------------------------------------------------------------------*/
: checkMakeTenant ( "<tenantNm>" -- true | errorCode false )

  checkInTenants    not if false exit then
  checkIsNotTenant  not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* make a tenant folder (run by participant)                                  */
/*----------------------------------------------------------------------------*/
: makeTenant ( "<tenantNm>" -- )

  tp: makingTenant

  params| sTenantNm |

  args.tracepoint if
    sTenantNm "MAKING TENANT " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the tenant
  sTenantNm :tenant ( ^tenant )
  drop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make catalogs folder
  sTenantNm makeCatalogs ( )
;

/*----------------------------------------------------------------------------*/
/* create tenant request (on originating node)                                */
/*----------------------------------------------------------------------------*/
: createTenant_req ( -- )

  >>am <SEED_REQ>

  0 0 locals| pJob_CreateTenant pTask |

  tp: createTenant_req

  // get the task
  task::this to pTask

  // get the job from the task
  pTask task.job@ to pJob_CreateTenant

  // distribute the job
  pJob_CreateTenant job.distribute

  <<am <DONE_REQ>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTenant job on a node                                     */
/*----------------------------------------------------------------------------*/
: createTenant_exe ( pJob_CreateTenant -- )

  >>am <SEED_EXE>

  //params| pJob_CreateTenant |
  job::this locals| pJob_CreateTenant |

  0 locals| sTenantNm |

  tp: createTenant_exe

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabWrite

  CN_JOB_CREATETENANT pJob_CreateTenant object.assertClass
  pJob_CreateTenant job.objectName@ to sTenantNm

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_CreateTenant job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the catalog
  sTenantNm makeTenant ( )

  pJob_CreateTenant job.notice

  pJob_CreateTenant job::participantExecuted

  <<am <DONE_EXE>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTenant job check resources                               */
/*----------------------------------------------------------------------------*/
: createTenant.checkResources ( pJob_CreateTenant -- )

  >>am <Check_Resources>

  params| pJob_CreateTenant  |

  tp: createTenant.checkResources
  //checkResources received" .

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab a ddl lock
  ddlLock::grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set task's dictionary stack from path in job
  pJob_CreateTenant job.pushPath
  task::dicStack.set

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  node::checkEnoughBuffers not if pJob_CreateTenant <ERROR_JOB> !!am exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can make the catalog
  pJob_CreateTenant job.objectName@
  checkMakeTenant not if pJob_CreateTenant <ERROR_JOB> !!am exit then

  <<am <Resources_Checked>
;

/*----------------------------------------------------------------------------*/
/* execute Job_CreateTenant job release resources                             */
/*----------------------------------------------------------------------------*/
: createTenant.releaseResources ( pJob_CreateTenant -- )

  >>am <Release_Resources>

  params| pJob_CreateTenant  |

  tp: createTenant.releaseResources
  //releaseResources received" .

  <<am <Resources_Released>
;

/*----------------------------------------------------------------------------*/
/* begin job                                                                  */
/*----------------------------------------------------------------------------*/
: createTenant_beg ( -- )

  >>am <SEED_BEG>

  job::this locals| pJob_createTenant |

  pJob_createTenant job.becomeParticipant

  // check resources
  pJob_createTenant createTenant.checkResources

  job::participantBegun

  <<am <DONE_BEG>
;

/*----------------------------------------------------------------------------*/
/* end job                                                                    */
/*----------------------------------------------------------------------------*/
: createTenant_end ( -- )

  >>am <SEED_END>

  job::this locals| pJob_createTenant |

  pJob_createTenant createTenant.releaseResources

  job::participantEnded

  <<am <DONE_END>
;

/*----------------------------------------------------------------------------*/
/* cancel job                                                                 */
/*----------------------------------------------------------------------------*/
: createTenant_can ( -- )

  >>am <SEED_CAN>

  job::this locals| pJob_createTenant |

  pJob_createTenant createTenant.releaseResources

  job::participantCancelled

  <<am <DONE_CAN>
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
