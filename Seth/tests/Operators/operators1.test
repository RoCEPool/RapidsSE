/*----------------------------------------------------------------------------*/
/* operators.test -- OPERATORS tests                                          */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table OpTable1 (
  jidx_key   INTEGER     NOT NULL,
  jidx_name  VARCHAR(32) NOT NULL,
  jidx_100   INTEGER     NOT NULL,
  jidx_10    INTEGER     NOT NULL,
  jidx_int   INTEGER     NOT NULL,
  jidx_flt   FLOAT       NOT NULL,
  jidx_tsp   TIMESTAMP   NOT NULL,
  jidx_dte   DATE        NOT NULL
);
success

// create indexes
create index OpTable1_idx on OpTable1 (jidx_key);
success

// check existence of index
lsidx OpTable1;
rows:
('OpTable1_idx', false, false)

load OpTable1 "../DATA/Operators/operators1_1.csv" ;
success

// check no of rows
tableScan OpTable1;
rows: 26

// (1) create a table
create table OpTable2 (
  jidx_key_2   INTEGER     NOT NULL,
  jidx_name_2  VARCHAR(32) NOT NULL,
  jidx_100_2   INTEGER     NOT NULL,
  jidx_10_2    INTEGER     NOT NULL,
  jidx_int_2   INTEGER     NOT NULL,
  jidx_flt_2   FLOAT       NOT NULL,
  jidx_tsp_2   TIMESTAMP   NOT NULL,
  jidx_dte_2   DATE        NOT NULL
  );
success

// create indexes
create index OpTable2_idx on OpTable2 (jidx_key_2);
success

// check existence of index
lsidx OpTable2;
rows:
('OpTable2_idx', false, false)

load OpTable2 "../DATA/Operators/operators1_2.csv" ;
success

// check no of rows
tableScan OpTable2;
rows: 21

