/*----------------------------------------------------------------------------*/
/* part_curlyBraces --                                                        */
/*----------------------------------------------------------------------------*/

// create the table
create table PART (
p_partkey INTEGER NOT NULL,
p_name VARCHAR(55),
p_mfgr VARCHAR(25),
p_brand VARCHAR(10),
p_type VARCHAR(25),
p_size INTEGER,
p_container VARCHAR(10),
p_retailprice FLOAT,
p_comment VARCHAR(23)
);
success

create index idx on part (p_type);

oldLoad part "../DATA/Load/part_curlyBraces.csv"
  <enclosed_by_leading> =  "{"
  <enclosed_by_trailing> = "}"
  <record_ends> = "\n";
success

tableScan part;
rows: 16

CLEANUP {
  
  drop table part;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
