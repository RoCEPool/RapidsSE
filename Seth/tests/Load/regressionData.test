  mute
  
  drop table customerh;
  mute
  
  drop table partsupp;
  mute
  
  drop table part;
  mute
  
  drop table shipping;
  mute
  
  drop table shipaddress;
  mute
  
  drop table supplier;
  mute
  
  drop table manufacturer;
  mute
  
  drop table nation;
