CLEANUP {
  
  drop table table1;
  mute

  drop table table2;
  mute
  
  drop table table3;
  mute
  
  drop table table4;
  mute
  
  drop table table5;
  mute
  
  drop table table6;
  mute
  
  drop table table7;
  mute
  
