create table T1 (
col_id       INTEGER,
col_vch      VARCHAR(15),
col_int      INTEGER
);
success

// create an ndex
create index idx on T1 (col_id) ;
success

// load table T1 with enclosed_by_leading '
tag <enclosedby_leading> = "{";
success

tag <enclosedby_trailing> = "}";
success

load T1 "../DATA/Load/emptyString2.csv";
success

// delete the tags
tag delete <enclosedby_leading>;
success

tag delete <enclosedby_trailing>;
success

// predicateFetch rows
tableScan T1;
rows: 2

predicateFetch T1 "col_id 1 =";
rows:
  (1,'',3)

predicateFetch T1 "col_id 2 =";
rows:
  (2,null,3)

export T1 "/tmp/T1.csv";
success

truncate T1;
success

tableScan T1;
rows: 0

load T1 "/tmp/T1.csv";
success

tableScan T1;
rows: 2

//! RAY TO UNCOMMENT ONCE enclosedBy glitch is fixed
//predicateFetch T1 "col_id 1 =";
//rows:
//  (1,'',3)

//predicateFetch T1 "col_id 2 =";
//rows:
//  (2,null,3)

// drop the table
drop table T1;
success

CLEANUP {
  
  drop table T1;
  mute

  bye;
  mute
}


