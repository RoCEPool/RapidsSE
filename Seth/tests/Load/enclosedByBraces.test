/*----------------------------------------------------------------------------*/
/* enclosedByBraces -- enclosedBy braces                                      */
/*----------------------------------------------------------------------------*/

// create the table
create table T1 (
    col0  INTEGER        NOT NULL,
    col1  INTEGER        NOT NULL,
    col2  INTEGER        NOT NULL,
    col3  VARCHAR(64)    NOT NULL,
    col4  TIMESTAMP      NOT NULL,
    col5  DECIMAL(19,2)  NOT NULL,
    col6  DECIMAL(19,2)  NOT NULL,
    col7  INTEGER        NOT NULL,
    col8  INTEGER        NOT NULL,
    col9  INTEGER        NOT NULL,
    col10 VARCHAR(64)    NOT NULL
);
success

// oldLoad data into the table with enclosed_by as 3 characters
oldLoad T1 "../DATA/load/enclosedByBraces.csv" <enclosed_by_leading> = "{" <enclosed_by_trailing> = "}";
success

tableScan T1;
rows:
  (0,217,260,'grey',TIMESTAMP '2015-10-31 00:00:00.0',73.44,5.34,8,-152,81,'lll')
  (1,278,45,'PINK',TIMESTAMP '2015-01-16 00:00:00.0',97.85,74.59,4,39,895,'qqq')
  (2,75,415,'green',TIMESTAMP '2015-07-26 00:00:00.0',168.48,128.91,6,40,30,'uuu')
  (3,20,109,'green',TIMESTAMP '2015-02-12 00:00:00.0',94.93,7.53,8,-162,976,'qqq')
  (4,234,124,'black',TIMESTAMP '2015-01-07 00:00:00.0',213.04,96.49,3,-167,144,'mmm')
  (5,164,438,'PINK',TIMESTAMP '2015-01-30 00:00:00.0',222.66,117.29,12,-46,449,'uuu')

export T1 "/tmp/T1.csv";
success

truncate T1;
success

tableScan T1;
rows: 0
