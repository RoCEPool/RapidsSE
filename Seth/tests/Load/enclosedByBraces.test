  (2,75,415,'green',TIMESTAMP '2015-07-26 00:00:00.0',168.48,128.91,6,40,30,'uuu')
  (3,20,109,'green',TIMESTAMP '2015-02-12 00:00:00.0',94.93,7.53,8,-162,976,'qqq')
  (4,234,124,'black',TIMESTAMP '2015-01-07 00:00:00.0',213.04,96.49,3,-167,144,'mmm')
  (5,164,438,'PINK',TIMESTAMP '2015-01-30 00:00:00.0',222.66,117.29,12,-46,449,'uuu')
*/

drop table T1;
success

CLEANUP {
  
  drop table T1;
  mute

  bye;
  mute
}


