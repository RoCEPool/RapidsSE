/*----------------------------------------------------------------------------*/
/* vch_term_defaults -- varchar with terminated                               */
/*----------------------------------------------------------------------------*/

// create the tables
create table vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on vch (vch_testno);
success;

// oldLoad data into the table with default formatter settings
Load vch "../DATA/Load/vch_term_defaults.csv"
  <record_terminator> = ";"
  <enclosed_by_leading> =  "'";
success

tableScan vch;
rows: 18

predicateFetch vch "vch_testno 501 ==";
rows:
 ( 501, 'quick brown fox', *)

predicateFetch vch "vch_testno 502 =";
rows:
  ( 502, 'quick, brown fox', *)

predicateFetch vch "vch_testno 503 =";
rows:
  ( 503, 'quick brown fox''s', *)

predicateFetch vch "vch_testno 504 =";
rows:
  ( 504, 'quick brown fox''s', *)

predicateFetch vch "vch_testno 505 =";
rows:
  ( 505, 'quick brow\n foxs', *)

predicateFetch vch "vch_testno 506 =";
rows:
  ( 506, 'quick brown fox
s', *)

predicateFetch vch "vch_testno 507 =";
rows:
  ( 507, 'quick brown fox', *)

predicateFetch vch "vch_testno 508 =";
rows:
  ( 508, 'quick brown fox', *)

predicateFetch vch "vch_testno 509 =";
rows:
  ( 509, '', *)

predicateFetch vch "vch_testno 510 =";
rows:
  ( 510, 'null', *)

predicateFetch vch "vch_testno 511 =";
rows:
  ( 511, 'N', *)

predicateFetch vch "vch_testno 512 =";
rows:
( 512, 'quick ;brown fox', *)

predicateFetch vch "vch_testno 513 =";
rows:
  ( 513, '   quick brown fox   ', *)

predicateFetch vch "vch_testno 514 =";
rows:
  ( 514, 'quick brown fox''s', *)

predicateFetch vch "vch_testno 515 =";
rows:
  ( 515, null, *)

predicateFetch vch "vch_testno 516 =";
rows:
  ( 516, null, *)

predicateFetch vch "vch_testno 517 =";
rows:
  ( 517, null, *)

predicateFetch vch "vch_testno 518 =";
rows:
  ( 518, 'quick brown fox
s', *)

drop table vch;
success

CLEANUP {
  
  drop table vch;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
