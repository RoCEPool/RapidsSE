/*----------------------------------------------------------------------------*/
/* terminatorSmallNull_cr -- cr terminator with < 1mb file                    */
/*----------------------------------------------------------------------------*/

// create the table

create table terminator_cr (
  c1 integer,
  c2 varchar not null,
  c3 varchar
);
success

// oldLoad data into the table with default formatter settings
oldLoad terminator_cr "../DATA/Load/terminatorSmallNull_cr.csv"
  record_ends "\n"
;
failure contains: '1 invalid'

// create index
create index idx on terminator_cr(c1);
success

// fetch
predicateFetch terminator_cr "c1 1 =";
rows: 2533

// fetch
tableScan terminator_cr;
rows: 2533

CLEANUP {
  
  drop table terminator_cr;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
