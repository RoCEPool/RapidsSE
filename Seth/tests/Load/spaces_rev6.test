/*----------------------------------------------------------------------------*/
/* spaces -- leading and trailing spaces tests                                */
/*----------------------------------------------------------------------------*/

create table T1 (
  col_id       INTEGER,
  col_vch      VARCHAR(50),
  col_int      INTEGER
);
success

// create an index
create index idx on T1 (col_id);
success

// load T1 with deafult enclosedBy
ld T1 "../Seth/tests/Load/spaces.csv" ;
success

// fetch rows
fetch T1;
rows: 4

fetch T1;
rows:
  (1,'   3 leading',3)
  (2,'   ''3 leading''',3)
  (3,'   ''3 leading,2 trailing''  ' ,3)
  (4,'''   3 leading,2 trailing  ''',3)

// drop the table
drop table T1;
success

create table T1 (
  col_id       INTEGER,
  col_vch      VARCHAR(50),
  col_int      INTEGER
);
success

// create an index
create index idx on T1 (col_id);
success

// load T1 with deafult enclosedBy
ld T1 "../Seth/tests/Load/spaces_enclosedBy.csv" enclosed_by_leading "'" ;
success

// fetch rows
fetch T1;
rows: 4

fetch T1;
rows:
  (1,'   3 leading',3)
  (2,'3 leading',3)
  (3,'3 leading,2 trailing',3)
  (4,'   3 leading,2 trailing  ',3)

// drop the table
drop table T1;
success

create table T1 (
  col_id       INTEGER,
  col_vch      VARCHAR(25),
  col_int      INTEGER
);
success

// create an index
create index idx on T1 (col_id);
success

// load T1 with deafult enclosedBy
ld T1 "../Seth/tests/Load/spaces_enclosedByCurly.csv" enclosed_by_leading "{" enclosed_by_trailing "}";
success

// fetch rows
fetch T1;
rows: 4

fetch T1;
rows:
  (1,'   3 leading',3)
  (2,'3 leading',3)
  (3,'3 leading,2 trailing',3)
  (4,'   3 leading,2 trailing  ',3)

// drop the table
drop table T1;
success

CLEANUP {
  
  drop table T1;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
