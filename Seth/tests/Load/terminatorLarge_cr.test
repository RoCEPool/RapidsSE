/*----------------------------------------------------------------------------*/
/* vch_defaults -- varchar with deafult formatters                            */
/*----------------------------------------------------------------------------*/

// create the table

create table terminator_cr (
  c1 integer,
  c2 varchar,
  c3 varchar,
  c4 varchar
);
success

// oldLoad data into the table with default formatter settings
Load terminator_cr "../DATA/Load/terminatorLarge_cr.csv"
  <record_ends> = "\r";
success

// create index
create index idx on terminator_cr(c1);
success

// fetch
predicateFetch terminator_cr "c1 1 =";
rows:
  (1, 'This is terminatoed by <CR>');

// fetch
tableScan terminator_cr;
rows: 6895

CLEANUP {
  
  drop table terminator_cr;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
