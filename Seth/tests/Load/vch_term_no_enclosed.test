/*----------------------------------------------------------------------------*/
/* vch_term_no_enclosed -- varchar with terminator and no enclosed            */
/*----------------------------------------------------------------------------*/

// create the tables
create table vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on vch (vch_testno);
success;

// oldLoad data into the table with default formatter settings
oldLoad vch "../DATA/Load/vch_term_no_enclosed.csv"
  <record_terminator> = ";"
  <escape_char> = "\0" ;
success

//tableScan vch;
//rows: 17

predicateFetch vch "vch_testno 601 =";
rows:
  ( 601, 'quick brown fox', *)

predicateFetch vch "vch_testno 602 =";
rows:
  ( 602, 'quick brown fox\', *)

predicateFetch vch "vch_testno 603 =";
rows:
  ( 603, 'quick brown fox''s', *)

predicateFetch vch "vch_testno 604 =";
rows:
  ( 604, 'quick brow\\n foxs', *)

predicateFetch vch "vch_testno 605 =";
rows:
  ( 605, 'quick brown fox
s', *);

predicateFetch vch "vch_testno 606 =";
rows:
( 606, 'quick brown fox', *);

predicateFetch vch "vch_testno 607 =";
rows:
  ( 607, 'quick brown fox', *)

predicateFetch vch "vch_testno 608 =";
rows:
  ( 608, '', *)

predicateFetch vch "vch_testno 609 =";
rows:
  ( 609, 'null', *)

predicateFetch vch "vch_testno 610 =";
rows:
  ( 610, '\N', *)

predicateFetch vch "vch_testno 611 =";
rows:
  ( 611, 'quick brown fox', *)

predicateFetch vch "vch_testno 612 =";
rows:
  ( 612, '   quick brown fox   ', *)

predicateFetch vch "vch_testno 613 =";
rows:
  ( 613, 'quick brown fox''s''', *)

predicateFetch vch "vch_testno 614 =";
rows:
  ( 614, null, *)

predicateFetch vch "vch_testno 615 =";
rows:
  ( 615, null, *)

predicateFetch vch "vch_testno 616 =";
rows:
  ( 616, '\N', *)

predicateFetch vch "vch_testno 617 =";
rows:
  ( 617, 'quick brown fox\ns', *)

drop table vch;
success;

CLEANUP {
  
  drop table vch;
  mute

  bye;
  mute
}


