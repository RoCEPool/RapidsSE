// track memory
//trackMemory;
//success

// incomplete oldLoad command
oldLoad;
failure contains: 'invalid command'

// incomplete oldLoad command
oldLoad T1;
failure contains: 'invalid command'

// incomplete oldLoad command
oldLoad "../DATA/load/null.csv";
failure contains: 'invalid command'

// oldLoad non-existent table T1
oldLoad T1 "../DATA/load/null.csv" ;
failure contains: 'no such table'

create table T1 (
  col_id       INTEGER,
  col_vch      VARCHAR(25),
  col_int      INTEGER
);
success

// create an index
create index idx on T1 (col_id);
success

// oldLoad T1 with invalid file
oldLoad T1 "no-such-file" ;
failure contains: 'invalid file'

// drop the table
drop table T1;
success

//MemoryLeaks;
//rows: 0

CLEANUP {
  
  drop table T1;
  mute

  bye;
  mute
}


