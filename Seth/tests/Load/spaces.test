/*----------------------------------------------------------------------------*/
/* spaces -- leading and trailing spaces tests                                */
/*----------------------------------------------------------------------------*/

create table T1 (
  col_id       INTEGER,
  col_vch      VARCHAR(50),
  col_int      INTEGER
);
success

// create an index
create index idx on T1 (col_id);
success

// load T1 with deafult enclosedBy
ld T1 "../Seth/tests/Load/spaces.csv" ;
success

// fetch rows
fetch T1;
rows: 4

fetch T1;
rows:
(*,1,'   3 leading',3)
(*,2,'   ''3 leading''',3)
(*,3,'   ''3 leading,2 trailing''  ' ,3)
(*,4,'''   3 leading,2 trailing  ''',3)

// drop the table
drop table T1;
success

