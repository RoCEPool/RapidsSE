/*----------------------------------------------------------------------------*/
/* vch_no_enclosed_no_escape -- varchar with no escape char and no enclosed by*/
/*----------------------------------------------------------------------------*/

// create the tables
create table vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on vch (vch_testno);
success;

// load data into the table with default formatter settings
ld vch "../JTEST/vch_no_enclosed_no_escape.csv"
  enclosed_by "\0" escape_char "\0" ;
success

//fetch vch;
//rows: 18

fetch vch "vch_testno 301 =";
rows:
  (*, 301, 'quick brown fox', *);
 
fetch vch "vch_testno 302 =";
rows:
  (302, 'quick, brown fox\', *);

fetch vch "vch_testno 303 =";
rows:
  (303, 'quick brown fox''s', *);

fetch vch "vch_testno 304 =";
rows:
  (304, 'quick brow\\n foxs', *);

fetch vch "vch_testno 305 =";
rows:
  (305, 'quick brown\n fox\ns', *);

fetch vch "vch_testno 306 =";
rows:
  (306, 'quick brown fox', *);

fetch vch "vch_testno 307 =";
rows:
  (307, 'quick brown fox', *);

fetch vch "vch_testno 308 =";
rows:
  (308, '', *);

fetch vch "vch_testno 309 =";
rows:
  (309, 'null', *);

fetch vch "vch_testno 310 =";
rows:
  (310, 'N', *);

fetch vch "vch_testno 311 =";
rows:
  (311, 'quick brown fox', *);

fetch vch "vch_testno 312 =";
rows:
  (312, '   quick brown fox   ', *);

fetch vch "vch_testno 313 =";
rows:
  (313, 'quick brown fox\'s\'', *);

fetch vch "vch_testno 314 =";
rows:
  (314, '', *);

fetch vch "vch_testno 315 =";
rows:
  (315, null, *);

fetch vch "vch_testno 316 =";
rows:
  (316, null, *);

fetch vch "vch_testno 317 =";
rows:
  (317, null, *);

fetch vch "vch_testno 118 =";
rows:
  (118, 'quick brown fox
s', *);


CLEANUP {
  
  //drop table vch;
  //mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
