/*----------------------------------------------------------------------------*/
/* vch_no_term_no_enclosed_no_escape -- varchar term no escape no enclosed    */
/*----------------------------------------------------------------------------*/

// create the tables
create table vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on vch (vch_testno);
success;

// oldLoad data into the table with default formatter settings
oldLoad vch "../DATA/Load/vch_term_no_enclosed_no_escape.csv"
  <record_terminator> = ";"
  <enclosed_by_leading> =  "\0"
  <escape_char> = "\0" ;
success

//tableScan vch;
//rows: 16

predicateFetch vch "vch_testno 701 =";
rows:
  ( 701, '''quick brown fox''', *)

predicateFetch vch "vch_testno 702 =";
rows:
  ( 702, '''quick brown fox''''s''', *)

predicateFetch vch "vch_testno 703 =";
rows:
  ( 703, '''quick brow\\n foxs''', *)

predicateFetch vch "vch_testno 704 =";
rows:
  ( 704, '''quick brown fox\ns''', *)

predicateFetch vch "vch_testno 705 =";
rows:
  ( 705, '''quick brown fox''', *)

predicateFetch vch "vch_testno 706 =";
rows:
  ( 706, '   ''quick brown fox''   ', *)

predicateFetch vch "vch_testno 707 =";
rows:
  ( 707, '''''', *)

predicateFetch vch "vch_testno 708 =";
rows:
  ( 708, '''null''', *)

predicateFetch vch "vch_testno 709 =";
rows:
  ( 709, '''\N''', *)

predicateFetch vch "vch_testno 710 =";
rows:
  ( 710, 'quick brown fox', *)

predicateFetch vch "vch_testno 711 =";
rows:
  ( 711, '   quick brown fox   ', *)

predicateFetch vch "vch_testno 712 =";
rows:
  ( 712, 'quick brown fox''s''', *)

predicateFetch vch "vch_testno 713 =";
rows:
  ( 713, null, *)

predicateFetch vch "vch_testno 714 =";
rows:
  ( 714, null, *)

predicateFetch vch "vch_testno 716 =";
rows:
  ( 716, 'quick brown fox\ns', *)

//predicateFetch vch "vch_testno 715 =";
//rows:
//  ( 715, 'N', *)


drop table vch;
success

CLEANUP {
  
  drop table vch;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
