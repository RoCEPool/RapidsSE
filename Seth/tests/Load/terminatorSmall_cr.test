/*----------------------------------------------------------------------------*/
/* terminatorSmall_cr -- cr terminator with < 1mb file                        */
/*----------------------------------------------------------------------------*/

// create the table

create table terminator_cr (
  c1 integer,
  c2 varchar,
  c3 varchar
);
success

// oldLoad data into the table with default formatter settings
oldLoad terminator_cr "../DATA/load/terminatorSmall_cr.csv" record_ends "\r";
success

// create index
create index idx on terminator_cr(c1);
success

// fetch
predicateFetch terminator_cr "c1 1 =";
rows: 2534

// fetch
tableScan terminator_cr;
rows: 2534

CLEANUP {
  
  drop table terminator_cr;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
