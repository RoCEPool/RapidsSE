--------------------------------------------------------------------------------
-- create partition key tests
--------------------------------------------------------------------------------

// begin tracking memory
trackMemory;
success

// create a table
create table dataTable (
  key     INTEGER NOT NULL,
  name    VARCHAR(32) NOT NULL,
  value1  INTEGER,
  value2  INTEGER
) partition by (key);
success

// check columns of partition key
lspartcol dataTable;
rows:
  ('key','INTEGER',19,0,false,true)

// oldLoad data into the table
oldLoad dataTable "../DATA/PartitionKey/data.csv";
success

// select rows from the table
tableScan dataTable;
rows:
1000

// drop the table
drop table dataTable;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  drop table dataTable;
  mute

  bye;
  mute
}

