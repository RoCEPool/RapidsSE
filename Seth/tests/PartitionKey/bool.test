/*----------------------------------------------------------------------------*/
/* create partition key tests                                                 */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// create a table
create table boolTable (
  key1   BOOLEAN NOT NULL,
  value INTEGER,
  name  VARCHAR(32) NOT NULL
) partition by (key1);
success

// check columns of partition key
lspartcol boolTable;
rows:
  ('key1')

// create an index
create index idx1 on boolTable (key1);
success;

// load data into the table
ld boolTable "../DATA/PartitionKey/bool.csv";
success

// analyze table
antbl boolTable;
rows:
 (*,*,*,0)
 (*,*,*,5)
 (*,*,*,0)
 (*,*,*,5)

// drop the table
drop table boolTable;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  drop table boolTable;
  mute

  bye;
  mute
}

