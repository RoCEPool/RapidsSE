//----------------------------------------------------------------------------//
// create table with TIMESTAMP column tests
//----------------------------------------------------------------------------//

// create a table
create table rapidsse.public.G1 (
  id    integer,
  tsp   timestamp
);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'rapidsse';
rows:
  ('G1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision, scale from rapids.system.columns where
  table_name = 'G1' and column_name = 'TSP';
rows:
  ('TIMESTAMP', false, true, null, null)

// check partition key is first column
select column_name from rapids.system.columns where table_name = 'G1' and is_partition_key = true;
mute
//CHECK_REULT
/*
 rows:
  ('ID')
 */

// insert rows in the table
insert into rapidsse.public.G1 values (10, TIMESTAMP '1900-10-08 10:30:30.555');
mute
//CHECK_REULT
//success

insert into rapidsse.public.G1 values (20, TIMESTAMP '1901-10-08 10:30:30');
mute
//CHECK_REULT
//success

insert into rapidsse.public.G1 values (30, TIMESTAMP '1908-12-31 10:59:59.999');
mute
//CHECK_REULT
//success

// null
insert into rapidsse.public.G1 (id) values (40);
success

// select from T1
select * from rapidsse.public.G1;
mute
//CHECK_REULT
/*
rows:
  (40,null)
  (10, TIMESTAMP '1900-10-08 10:30:30.555')
  (20, TIMESTAMP '1901-10-08 10:30:30.0')
  (30, TIMESTAMP '1908-12-31 10:59:59.999')
*/

// drop table
drop table rapidsse.public.G1;
success

//------------------------------------------------------------------------------
// create a table
create table rapidsse.public.G1 (
  id    integer,
  tsp   timestamp NOT NULL
) partition by (tsp);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'rapidsse';
rows:
('G1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
//select data_type, is_partition_key, is_nullable, precision, scale from rapids.system.columns where
//table_name = 'G1' and column_name = 'TSP';
//rows:
//('TIMESTAMP', true, false, 0, 0)

// check partition key is first column
select column_name from rapids.system.columns where table_name = 'G1' and is_partition_key = true;
mute
//CHECK_REULT
/*
rows:
('TSP')
*/

insert into rapidsse.public.G1 values (10, TIMESTAMP '1907-03-31 10:58:06.99999');
mute
//CHECK_REULT
//success

// insert rows in the table
insert into rapidsse.public.G1 values (20, TIMESTAMP '1900-10-31 10:30:30.000');
mute
//CHECK_REULT
//success

insert into rapidsse.public.G1 values (30, TIMESTAMP '1908-02-29 00:00:00');
mute
//CHECK_REULT
//success

insert into rapidsse.public.G1 values (40, TIMESTAMP '2018-12-31 10:59:59.230');
mute
//CHECK_REULT
//success

// null
insert into rapidsse.public.G1 (id) values (40);
failure

// select from T1
select * from rapidsse.public.G1;
mute
//CHECK_REULT
/*
rows:
(10, '1907-03-31 10:58:06.99999')
(20, '1900-10-31 10:30:30.0')
(30, '1908-02-29 00:00:00.0')
(40, '2018-12-31 10:59:59.23')
*/

CLEANUP {
  drop table rapidsse.public.G1;
  mute
}
