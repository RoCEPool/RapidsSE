//----------------------------------------------------------------------------//
// create table with TIMESTAMP column tests
//----------------------------------------------------------------------------//

// create a table
create table T1 (
  id    integer,
  tsp   timestamp
);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
  ('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision, scale from rapids.system.columns where
  table_name = 'T1' and column_name = 'TSP';
rows:
  ('TIMESTAMP', false, true, 0, null)

// check partition key is first column
select column_name from rapids.system.columns where table_name = 'T1' and is_partition_key = true;
rows:
  ('ID')

// insert rows in the table
insert into T1 values (10, TIMESTAMP '1900-10-08 10:30:30.555');
success

insert into T1 values (20, TIMESTAMP '1901-10-08 10:30:30');
success

insert into T1 values (30, TIMESTAMP '1908-12-31 10:59:59.999');
success

// null
insert into T1 (id) values (40);
success

// select from T1
select * from T1;
rows:
  (40,null)
  (10, TIMESTAMP '1900-10-08 10:30:30.555')
  (20, TIMESTAMP '1901-10-08 10:30:30.0')
  (30, TIMESTAMP '1908-12-31 10:59:59.999')

// drop table
drop table T1;
success

//------------------------------------------------------------------------------
// create a table
create table T1 (
  id    integer,
  tsp   timestamp NOT NULL
) partition by (tsp);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
//select data_type, is_partition_key, is_nullable, precision, scale from rapids.system.columns where
//table_name = 'T1' and column_name = 'TSP';
//rows:
//('TIMESTAMP', true, false, 0, 0)

// check partition key is first column
select column_name from rapids.system.columns where table_name = 'T1' and is_partition_key = true;
rows:
('TSP')

insert into T1 values (10, TIMESTAMP '1907-03-31 10:58:06.99999');
success

// insert rows in the table
insert into T1 values (20, TIMESTAMP '1900-10-31 10:30:30.000');
success

insert into T1 values (30, TIMESTAMP '1908-02-29 00:00:00');
success

insert into T1 values (40, TIMESTAMP '2018-12-31 10:59:59.230');
success

// null
insert into T1 (id) values (40);
failure

// select from T1
select * from T1;
rows:
(10, '1907-03-31 10:58:06.99999')
(20, '1900-10-31 10:30:30.0')
(30, '1908-02-29 00:00:00.0')
(40, '2018-12-31 10:59:59.23')


CLEANUP {
  drop table T1;
  mute
}
