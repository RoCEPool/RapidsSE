//----------------------------------------------------------------------------//
// create table if not exits tests                                            //
//----------------------------------------------------------------------------//

// create a table
create table rapidsse.public.G1 (c1 integer);
success;

// check existence of table
select * from rapids.system.tables where catalog_name = 'rapidsse';
rows: 1
//CHECK_RESULT
/*
('rapidsse', 'public', 'G1', true)
*/

// create table only if it does not exits
create table if not exists rapidsse.public.G1 (c1 integer);
success;

// check existence of table
select * from rapids.system.tables where catalog_name = 'rapidsse';
rows: 1
//CHECK_RESULT
/*
('rapidsse', 'public', 'G1', true)
*/

// now drop the table
drop table rapidsse.public.G1;
success;

// check existence of table
select * from rapids.system.tables where catalog_name = 'rapidsse';
rows: 0

create table if not exists rapidsse.public.G1 (c1 integer);
success;

create table rapidsse.public.G1 (c1 integer);
failure contains: 'Duplicate table name'

// check existence of table
select * from rapids.system.tables where catalog_name = 'rapidsse';
rows: 1
//CHECK_RESULT
/*
('rapidsse', 'public', 'G1', true)
*/

CLEANUP {
  drop table rapidsse.public.G1 ;   mute;

}
