//loop 100 {
create table rapidsse.public.BugTestData (
   edcol1 integer,
   edcol2 varchar(50),
   edcol3 timestamp,
   edcol4 decimal(16,4),
   edcol5 float,
   edcol6 boolean
);
success

create table rapidsse.public.NullTestData( 
   ntcol1 integer,
   ntcol2 varchar(20),
   ntcol3 varchar(50),
   ntcol4 timestamp,
   ntcol5 varchar(50)
);
success

create table rapidsse.public.TABLE1 (
   pcol1   integer not null,
   tcol1   integer,
   cola1   integer,
   colb1   varchar(20),
   colc1   timestamp,
   cold1   float,
   cole1   decimal(15,2),
   colf1   integer,
   colg1   integer,
   ucol    integer,
   ucolvc  varchar(5),
   index tbl1idx1 on (pcol1))
   partition by (pcol1)
;
success

create table rapidsse.public.TABLE2 (
   pcol2   integer not null,
   scol2   integer,
   cola2   integer,
   colb2   varchar(30),
   colc2   timestamp,
   ucol    integer,
   ucolvc  varchar(5),
   index tbl2idx1 on (pcol2))
   partition by (pcol2)
;
success

create table rapidsse.public.TABLE3 (
   pcol3   integer not null,
   scol3   integer,
   tcol3   integer,
   unicol3 integer,
   cola2   integer,
   cola1   integer,
   ucol    integer,
   cola3   integer,
   colb3   varchar(25),
   colc3   timestamp,
   index tbl3idx1 on pcol3
);
success

create table rapidsse.public.TABLE4 (
   pcol4   integer not null,
   scol4   integer,
   ucol    integer,
   ucolvc  varchar(5),
   cola4   integer,
   colb4   varchar(25),
   colc4   timestamp,
   cole4   decimal(15,2),
   index tbl4idx1 on pcol4)
   partition by (pcol4,colb4)
;
success

create table rapidsse.public.TABLE5 (
   pcol5   integer not null,
   tcol5   integer,
   cola5   integer,
   ucol    integer,
   ucolvc  varchar(5),
   colb5   varchar(20),   
   colc5   timestamp,
   index tbl5idx1 on pcol5)
   partition by (colb5,pcol5)
;
success

create table rapidsse.public.TABLE6 (
   pcol6   integer not null,
   scol6   integer,
   tcol6   integer,
   ucol    integer,
   ucolvc  varchar(5),
   cola6   integer,
   index tbl6idx1 on pcol6
);
success

create table rapidsse.public.TABLE7 (
   pcol7   integer not null,
   scol7   integer,
   cola7   integer,
   colb7   varchar(15),
   colc7   timestamp,
   cold7   float,
   cole7   decimal(15,2),
   colf7   integer,
   index tbl7idx1 on pcol7
);
success

create table rapidsse.public.TABLE8 (
   pcol8   integer not null,
   tcol8   integer,
   cola8   integer,
   colb8   varchar(20),
   ucol    integer,
   ucolvc  varchar(5),
   colh8   integer,
   coli8   varchar(5),
   index tbl8idx1 on pcol8
);
success

create table rapidsse.public.TABLE9 (
   pcol9   integer not null,
   scol9   integer,
   tcol9   integer,
   colb9   varchar(20),
   cold9   float,
   cole9   decimal(15,2),
   colf9   integer,
   colg9   integer,
   ucol    integer,
   ucolvc  varchar(5),
   index tbl9idx1 on pcol9)
   partition by (pcol9,colb9)
;
success

create table rapidsse.public.SUPPLIER (
   s_suppkey integer not null,
   s_name varchar(25) not null,
   s_address varchar(40) not null,
   s_nationkey integer not null,
   s_phone varchar(15) not null,
   s_acctbal float not null,
   s_comment varchar(101) not null,
   index ssuppkey on s_suppkey
);
success

create table rapidsse.public.PART (
   p_partkey integer not null,
   p_name varchar(55) not null,
   p_mfgr varchar(25) not null,
   p_brand varchar(10) not null,
   p_type varchar(25) null,
   p_size integer not null,
   p_container varchar(10),
   p_retailprice float not null,
   p_comment varchar(23) not null,
   index ppartkey on p_partkey)
   partition by (p_partkey,p_brand)
;
success

create table rapidsse.public.PARTSUPP (
   ps_partkey integer not null,
   ps_suppkey integer not null,
   ps_availqty integer not null,
   ps_supplycost decimal(15,2) not null,
   ps_comment varchar(199) not null,
   index pspartkey on ps_partkey)
   partition by (ps_partkey,ps_suppkey)
;
success

create table rapidsse.public.CUSTOMER (
   c_custkey integer not null,
   c_name varchar(25) not null,
   c_address varchar(40) not null,
   c_nationkey integer not null,
   c_phone varchar(15) not null,
   c_acctbal decimal(15,2) not null,
   c_mktsegment varchar(10),
   c_comment varchar(117),
   index ccustkey on c_custkey)
   partition by (c_custkey)
;
success

create table rapidsse.public.ORDERS (
   o_orderkey integer not null,
   o_custkey integer not null,
   o_orderstatus varchar(1) not null,
   o_totalprice decimal(15,2) not null,
   o_orderdate timestamp not null,
   o_orderpriority varchar(15) not null,
   o_clerk varchar(15) not null,
   o_shippriority integer not null,
   o_shipcost decimal(15,2) not null,
   o_estcost integer not null,
   o_comment varchar(79) not null,
   index oorderkey on o_orderkey,
   index oorderdt on o_orderdate)
   partition by (o_orderkey)
;
success

create table rapidsse.public.LINEITEM (
   l_orderkey integer not null,
   l_partkey integer not null,
   l_suppkey integer not null,
   l_linenumber integer not null,
   l_quantity integer not null,
   l_extendedprice decimal(15,2) not null,
   l_discount decimal(15,2) not null,
   l_tax decimal(15,2) not null,
   l_returnflag varchar(1) not null,
   l_linestatus varchar(1) not null,
   l_shipdate timestamp not null,
   l_commitdate timestamp not null,
   l_receiptdate timestamp not null,
   l_shipinstruct varchar(25) not null,
   l_shipmode varchar(10) not null,
   l_comment varchar(44) not null,
   index lshipdate on l_shipdate,
   index lorderkey on l_orderkey)
   partition by (l_orderkey,l_shipdate)
;
success

create table rapidsse.public.SHIPPING (
   sh_shipkey integer not null,
   sh_shipmode varchar(10) not null,
   sh_shipdate timestamp not null,
   sh_shippriority integer not null,
   sh_shipinstruct varchar(25) not null,
   sh_shipcost decimal(15,2) not null,
   sh_estcost integer not null,
   sh_container varchar(10),
   index shshipkey on sh_shipkey)
   partition by (sh_shipkey,sh_shipdate)
;
success

create table rapidsse.public.SHIPADDRESS (
   sa_orderkey integer not null,
   sa_shipline integer not null,
   sa_address varchar(75) not null,
   sa_city varchar(55) not null,
   sa_state varchar(55) not null,
   sa_nationkey integer not null,
   sa_shipdate timestamp not null,
   sa_carrier varchar(75) not null,
   sa_partial varchar(1) not null,
   sa_comments varchar(80) not null,
   index saorderkey on sa_orderkey,
   index sashipdt on sa_shipdate)
   partition by (sa_orderkey)
;
success

create table rapidsse.public.MANUFACTURER (
   m_orderkey integer not null,
   m_partkey integer not null,
   m_mfgkey integer not null,
   m_nationkey integer not null,
   m_qualitycode varchar(5) not null,
   m_capacity integer not null,
   m_specialorders varchar(1) not null,
   m_comments varchar(50) not null,
   index morderkey on m_orderkey,
   index mpartkey on m_partkey)
   partition by (m_orderkey,m_partkey)
;
success

create table rapidsse.public.RETURNS(
   l_orderkey integer not null,
   l_linenumber integer not null,
   m_mfgkey integer not null,
   l_suppkey integer not null,
   r_reason varchar(100) not null,
   r_condition varchar(15) not null,
   r_restock varchar(1) not null,
   r_returnmfg varchar(1) not null,
   r_credit decimal(15,2) not null,
   r_returndate timestamp not null,
   r_comments varchar(75) not null,
   index orderky on l_orderkey,
   index linenum on l_linenumber,
   index mfgkey on m_mfgkey,
   index suppkey on l_suppkey)
   partition by (l_orderkey)
;
success

create table rapidsse.public.NATION (
   n_nationkey integer not null,
   n_name varchar(25) not null,
   n_regionkey integer not null,
   n_comment varchar(152)
);
success

create table rapidsse.public.REGION (
   r_regionkey integer not null,
   r_name varchar(25) not null,
   r_comment varchar(152)
);
success

drop table rapidsse.public.BugTestData;
success

drop table rapidsse.public.NullTestData;
success

