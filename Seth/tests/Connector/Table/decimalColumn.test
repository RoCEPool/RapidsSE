//----------------------------------------------------------------------------//
// create table with DECIMAL column tests
//----------------------------------------------------------------------------//

// create a table , precision > 19
create table T1 (
  id      integer,
  val   decimal(20,10)
);
failure

// create a table , scale > precision
create table T1 (
  id      integer,
  val   decimal(3,10)
);
failure

// create a table , scale > 19
create table T1 (
  id      integer,
  val   decimal(19,20)
);
failure

// create a table , no size in varchar
create table T1 (
  id      integer,
  val     decimal
);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'rapidsse';
rows:
  ('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision, scale from rapids.system.columns where
  table_name = 'T1' and column_name = 'VAL';
rows:
  ('DECIMAL', false, true, 19, 0)

// check partition key is first column
select column_name from rapids.system.columns where table_name = 'T1' and is_partition_key = true;
rows:
  ('ID')

// insert rows in the table
insert into T1 values (10, 12.78);
success

insert into T1 values (20, 13.0);
success

insert into T1 values (30,16);
success

// null
insert into T1 (id) values (40);
success

// select from T1
select * from T1;
rows:
  (10,13)
  (20,13)
  (30,16)
  (40,null)

// drop table
drop table T1;
success

// create a table , no size in varchar
create table T1 (
  id      integer,
  val   decimal(10,2) NOT NULL
) partition by (val);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'rapidsse';
rows:
  ('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
  rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision, scale from rapids.system.columns where
table_name = 'T1'  and column_name = 'VAL';
rows:
  ('DECIMAL', true, false, 10, 2)

// insert rows in the table
insert into T1 values (10, 12.788);
success

insert into T1 values (20, 13.02);
success

insert into T1 values (30,16.4);
success

// null
insert into T1 (name) values ('abc');
failure

// insert larger than max integer
insert into T1 values (60,9223372036854775808.34);
failure

// insert smaller than min integer
insert into T1 values (60,-9223372036854775808.0);
failure

// select from T1
select * from T1;
rows:
(10,12.79)
(20,13.02)
(30,16.40)

// drop table
drop table T1;
success

CLEANUP {
  drop table T1;
  mute
}
