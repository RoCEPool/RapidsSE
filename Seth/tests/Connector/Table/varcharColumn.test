//----------------------------------------------------------------------------//
// create table with VARCHAR column tests
//----------------------------------------------------------------------------//

// create a table , size in varchar > 64K
create table T1 (
  id      integer,
  name    varchar(65540)
);
failure

// create a table , size in varchar = 64K
create table T1 (
  id      integer,
  name    varchar(65536)
);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision from rapids.system.columns where
table_name = 'T1' and column_name = 'NAME';
rows:
('VARCHAR', false, true, 65536)

// drop the table
drop table T1;
success

// create a table , no size in varchar
create table T1 (
  id      integer,
  name    varchar
);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
  ('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision from rapids.system.columns where
  table_name = 'T1' and column_name = 'NAME';
rows:
  ('VARCHAR', false, true, 65536)

// check partition key is first column
select column_name from rapids.system.columns where table_name = 'T1' and is_partition_key = true;
rows:
  ('ID')

// insert rows in the table
insert into T1 values (10, 'abcdefghijklmnopqrstuvwxyz');
success

insert into T1 values (20, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz');
success

insert into T1 values (30, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz');
success

insert into T1 values (40, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz');
success

insert into T1 values (50, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz');
success

insert into T1 (id) values (60);
success

// select from T1
select * from T1;
rows:
  (10, 'abcdefghijklmnopqrstuvwxyz')
  (20, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz')
  (30, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz')
  (40, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz')
  (50, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz')
  (60, null)

// drop table
drop table T1;
success

// create a table , no size in varchar
create table T1 (
  id      integer,
  name    varchar(32) NOT NULL
);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
  ('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
  rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision from rapids.system.columns where
table_name = 'T1'  and column_name = 'NAME';
rows:
  ('VARCHAR', false, false, 32)

// insert rows in the table
insert into T1 values (10, 'abcdefghijklmnopqrstuvwxyz');
success

insert into T1 values (20, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz');
success

insert into T1 values (30, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz');
success

insert into T1 values (40, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz');
success

insert into T1 values (50, 'abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz');
success

insert into T1 (id) values (60);
failure: 'Subsystem exception: '

// select from T1
select * from T1;
rows:
(10, 'abcdefghijklmnopqrstuvwxyz')
(20, 'abcdefghijklmnopqrstuvwxyzabcdef')
(30, 'abcdefghijklmnopqrstuvwxyzabcdef')
(40, 'abcdefghijklmnopqrstuvwxyzabcdef')
(50, 'abcdefghijklmnopqrstuvwxyzabcdef')

// drop table
drop table T1;
success

// create a table , no size in varchar
create table T1 (
id      integer,
name    varchar
) partition by (name);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision from rapids.system.columns where
table_name = 'T1' and column_name = 'NAME';
rows:
('VARCHAR', true, true, 65536)

// insert rows in the table
insert into T1 values (10, 'a');
success

insert into T1 values (20, 'b');
success

insert into T1 values (30, 'c');
success

insert into T1 values (40, 'd');
success

insert into T1 values (50, 'e');
success

// select from T1
select * from T1;
rows:
(10, 'a')
(20, 'b')
(30, 'c')
(40, 'd')
(50, 'e')

// drop table
drop table T1;
success

CLEANUP {
  drop table T1;
  mute
}
