for i in {1..5000}
do
echo "Welcome $i times"
./bootstrapper -a stop
./bootstrapper -a start
for j in {1..10}
  echo "Iteration $j of $i"
  ./rapids-shell -p 5334 < schemaCreateSE.test
  ./rapids-shell -p 5334 < schemaLoadSE.test
  ./rapids-shell -p 5334 < schemaCreateMoxe.test
  ./rapids-shell -p 5334 < insSelIntoMoxe.test
  ./rapids-shell -p 5334 < selCountSE.test
  ./rapids-shell -p 5334 < selCountMoxe.test

  ./rapids-shell -p 5334 < schemaDropSE.test
  ./rapids-shell -p 5334 < schemaCreateSE.test
  ./rapids-shell -p 5334 < insSelIntoSE.test
  ./rapids-shell -p 5334 < selCountSE.test
  ./rapids-shell -p 5334 < selCountMoxe.test

  ./rapids-shell -p 5334 < schemaDropSE.test
  ./rapids-shell -p 5334 < schemaDropMoxe.test
  done
done
