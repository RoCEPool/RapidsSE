--------------------------------------------------------------------------------
-- insert-select index tests
--------------------------------------------------------------------------------

-- refresh metadata
Loop 10 {

LOG 'Running loop';

refresh;
success

-- create a table with an index
create table rapidsse.public.T1000 (
  T1000_key   INTEGER ,
  T1000_name  VARCHAR(32),
  T1000_100   INTEGER,
  T1000_10    INTEGER,
  index index1 on T1000_key,
  index index2 on T1000_100,
  index index3 on T1000_name
);
success

-- check existence of table
select * from rapids.system.tables where catalog_name = 'rapidsse';
rows:
('rapidsse', 'public', 'T1000', true)

-- check existence of index
select * from rapids.system.indexes;
rows:
('rapidsse', 'public', 'T1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'T1000_KEY')
('rapidsse', 'public', 'T1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'T1000_100')
('rapidsse', 'public', 'T1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'T1000_NAME')


-- insert data into T1000
insert into rapidsse.public.T1000 values(0,'zero',0,0);
success

// insert an empty string
insert into rapidsse.public.T1000 values(1,'',1,1);
success;

// insert with a , in the string
insert into rapidsse.public.T1000 values(2,'two, three',2,2);
success

// insert with a ' in the string
insert into rapidsse.public.T1000 values(3,'three''',3,3);
success

// insert with a null in the string
insert into rapidsse.public.T1000 (T1000_key, T1000_100, T1000_10) values(4,4,4);
success

select * from rapidsse.public.T1000;
rows:
  (0,'zero',0,0)
  (1,'',1,1)
  (2,'two, three',2,2)
  (3,'three''',3,3)
  (4,null,4,4);

-- create another table with an index
create table rapidsse.public.R1000 (
  R1000_key   INTEGER,
  R1000_name  VARCHAR(32),
  R1000_100   INTEGER,
  R1000_10    INTEGER,
  index index1 on R1000_key,
  index index2 on R1000_100,
  index index3 on R1000_name
);
success

-- check existence of table
select * from rapids.system.tables where catalog_name = 'rapidsse';
rows:
('rapidsse', 'public', 'T1000', true)
('rapidsse', 'public', 'R1000', true)

-- check existence of index
select * from rapids.system.indexes;
rows:
('rapidsse', 'public', 'T1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'T1000_KEY')
('rapidsse', 'public', 'T1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'T1000_100')
('rapidsse', 'public', 'T1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'T1000_NAME')
('rapidsse', 'public', 'R1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'R1000_KEY')
('rapidsse', 'public', 'R1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'R1000_100')
('rapidsse', 'public', 'R1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'R1000_NAME')

-- insert-select
insert into rapidsse.public.R1000 select * from rapidsse.public.T1000;
success

-- check data
select count(*) from rapidsse.public.R1000;
rows:
(5)

select * from rapidsse.public.R1000;
rows:
(0,'zero',0,0)
(1,'',1,1)
(2,'two, three',2,2)
(3,'three''',3,3)
(4,null,4,4);

drop table rapidsse.public.T1000;
success

drop table rapidsse.public.R1000;
success

// insert large strings (JIRA-351)
create table rapidsse.public.FOO (
  COL0 VARCHAR(97),
  COL1 TIMESTAMP,
  COL2 VARCHAR(191),
  COL3 BOOLEAN,
  COL4 DECIMAL(6, 2),
  COL5 DECIMAL(13, 2)
);
success

insert into rapidsse.public.FOO values ( 'bO8cTNviezh16xVLHNuT54uTL2RKzZIVq2DDF2xjQeVc2AkJzyHBvVIYMhekvKCJYOc3oPmdUKjY3UTlxtgVHw20w1jFHgyUe', '2017-06-30 00:00:00.0', 'QYAhEltcjmTFnddCVpIG8ZzrFpO3VYUPnGoD7Q5Kr8jGRgsdq3gwpjxRzEtbtkveyxIEhFKPIqpMHWX25rvFQYc8L233aBJ87IBip749zNnKYcGe8EAZt EzMITAYfmJ0FYptB55wADXHDGC6Ya70q2045xmc8m3RvxjSkfPGvp8ycYL1NobBP7AI5807Vsc', TRUE, 9960.26, -78557870545.09);
success

select * from rapidsse.public.FOO;
rows: ('bO8cTNviezh16xVLHNuT54uTL2RKzZIVq2DDF2xjQeVc2AkJzyHBvVIYMhekvKCJYOc3oPmdUKjY3UTlxtgVHw20w1jFHgyUe',TIMESTAMP '2017-06-30 00:00:00','QYAhEltcjmTFnddCVpIG8ZzrFpO3VYUPnGoD7Q5Kr8jGRgsdq3gwpjxRzEtbtkveyxIEhFKPIqpMHWX25rvFQYc8L233aBJ87IBip749zNnKYcGe8EAZt EzMITAYfmJ0FYptB55wADXHDGC6Ya70q2045xmc8m3RvxjSkfPGvp8ycYL1NobBP7AI5807Vs',true,9960.26,-78557870545.09);

drop table rapidsse.public.foo;
success

create table rapidsse.public.dc1(c1 integer, c2 varchar, c3 integer, c4 integer);
success

insert into rapidsse.public.dc1 values(264,'1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234',2,3);
success

select c3,c4 from rapidsse.public.dc1;
rows: (2,3)

insert into dc1 values(263,'123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123',2,3);
success

select c3,c4 from rapidsse.public.dc1;
rows:
  (2,3)
  (2,3)

insert into dc1 values(270,'1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890',2,3);
success

select c3,c4 from rapidsse.public.dc1;
rows:
  (2,3)
  (2,3)
  (2,3)

drop table rapidsse.public.dc1;
success

}
CLEANUP {

  drop table rapidsse.public.foo;
  mute

  drop table rapidsse.public.dc1;
  mute

  drop table rapidsse.public.T1000;
  mute

  drop table rapidsse.public.R1000;
  mute

}


