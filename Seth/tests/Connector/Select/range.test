/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

// (1) create table jCdt
create table rapidsse.public.jCdt (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

create index jCdt_idx1 on rapidsse.public.jCdt (jA);
success

create index jCdt_idx2 on rapidsse.public.jCdt (jA,jB);
success

create index jCdt_idx3 on rapidsse.public.jCdt (jA,jB,jC);
success

create index jCdt_idx4 on rapidsse.public.jCdt (jA,jB,jC,jD);
success

create index jCdt_idx5 on rapidsse.public.jCdt (jE);
success

ESCAPE CONNECTOR se 'load jCdt' with file = '/DATA/Select/range.csv', node = 'node1';
failure contains: 'Success'

