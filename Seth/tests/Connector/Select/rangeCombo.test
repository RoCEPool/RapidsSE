/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

// (1) create table t1
create table rapidsse.public.G1 (
  jA  INTEGER NOT NULL,
  jB  INTEGER NOT NULL,
  jC  VARCHAR(10) NOT NULL,
  jD  VARCHAR(10) NOT NULL
);
success

create index T1_idx1 on rapidsse.public.G1 (jA, jC);
success

ESCAPE CONNECTOR se 'load G1' with file = '/DATA/Select/rangeCombo.csv', node = 'node1';
failure contains: 'Success'

select * from rapidsse.public.G1;
rows: 5

select * from  rapidsse.public.G1 where jA <= 2;
rows: 2

select * from  rapidsse.public.G1 where jC <= '2';
rows: 0

select * from  rapidsse.public.G1 where jA >= 4 and jC >= 'ddd';
rows:
  (4,14,'ddd',' mood')
  (5,15,'eee',' boat')

select * from  rapidsse.public.G1 where jA = 4 and jC = 'ddd';
rows:
  (4,14,'ddd',' mood')

CLEANUP {

  drop table rapidsse.public.G1;
  mute

  bye;
  mute
}
