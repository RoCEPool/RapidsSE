--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table rapidsse.public.TABLE9 (
pcol9   integer not null,
scol9   integer,
tcol9   integer,
colb9   varchar(20),
cold9   float,
cole9   decimal(15,2),
colf9   integer,
colg9   integer,
ucol    integer,
ucolvc  varchar(5),
index tbl9idx1 on pcol9)
partition by (pcol9,colb9)
;
success

ESCAPE CONNECTOR se 'load table9' WITH file = '/DATA/Load/tbl9data.csv', node = 'node1' ;
failure contains: 'Success'

create index tbl9idx2 on table9(scol9);
success

create index tblidx6 on table9(cole9);
success

select pcol9, colb9, cole9, ceiling(cole9) * 1.25 from TABLE9 where cole9 > -5.0 and cole9 < 5.0 order by pcol9;
mute
//CHECK_RESULT
//rows: 12


// now drop the table
drop table table9;
success

CLEANUP {

  drop table table9;
  mute

  bye;
  mute
}

