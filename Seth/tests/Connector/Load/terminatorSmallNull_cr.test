/*----------------------------------------------------------------------------*/
/* terminatorSmallNull_cr -- cr terminator with < 1mb file                    */
/*----------------------------------------------------------------------------*/

// create the table

create table rapidsse.public.terminator_cr (
  c1 integer,
  c2 varchar not null,
  c3 varchar
);
success

// load data into the table with default formatter settings
ESCAPE CONNECTOR se 'load terminator_cr' with file='/DATA/Load/terminatorSmallNull_cr.csv' , terminator='\n',  node='NODE1' ;
failure contains: '1 records in error'

// create index
create index idx on rapidsse.public.terminator_cr(c1);
success

// fetch
select * from rapidsse.public.terminator_cr where c1 = 1;
rows: 2533

// fetch
select * from rapidsse.public.terminator_cr ;
rows: 2533

CLEANUP {
  
  drop table rapidsse.public.terminator_cr;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
