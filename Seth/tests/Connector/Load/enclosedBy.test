/* enclosedBy -- enclosedBy tests                                             */
/*----------------------------------------------------------------------------*/

// create the table
create table rapidsse.public.G1 (
    c1 integer,
    c2 varchar,
    c3 varchar
);

// load data into the table with enclosed_by as 3 characters
ESCAPE CONNECTOR se 'load rapidsse.public.G1' WITH file = '/DATA/Load/enclosedBy.csv', enclosed_by = "'" , node = 'node1' ;
failure contains: 'Success'

Select * from rapidsse.public.G1;
rows:
  (1,'A','This should be 1 A')
  (2,'B','This should be 2 B')
  (3,'C','This should be 3 C')
  (4,'D','This should be 4 D')

drop table rapidsse.public.G1;
success

CLEANUP {
  
  drop table rapidsse.public.G1;
  mute

  bye;
  mute
}


