/*----------------------------------------------------------------------------*/
/* varchar -- varchar with deafult formatters                                 */
/*----------------------------------------------------------------------------*/

// create the tables
create table rapidsse.public.vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(100)
);
success

// create an index
create index idx on rapidsse.public.vch (vch_testno);
success

// load data into the table with default formatter settings
escape connector se 'load vch' with file='/DATA/Load/vch_large.csv' , node='NODE1';
failure contains: 'Success'

select * from rapidsse.public.vch;
rows: 21

CLEANUP {
  
  drop table rapidsse.public.vch;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
