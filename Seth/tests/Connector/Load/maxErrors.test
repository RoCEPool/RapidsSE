/*----------------------------------------------------------------------------*/
/* boolean.test -- BOOLEAN DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// (1) create a table
create table rapidsse.public.G1 (
  bol_col1   BOOLEAN     NOT NULL,
  vch_col2   VARCHAR(32) NOT NULL,
  int_col3   INTEGER     NOT NULL,
  int_col4   INTEGER     NOT NULL,
  dec_col5   DECIMAL(10,2) NOT NULL,
  flt_col6   FLOAT       NOT NULL,
  tsp_col7   TIMESTAMP   NOT NULL,
  bol_col8   BOOLEAN
);
success

ESCAPE CONNECTOR se 'load rapidsse.public.G1' WITH file = '/DATA/Datums/boolean.csv',node = 'node1', max_errors = 15;
failure contains: '15 records in error'

select * from rapidsse.public.G1;
rows: 100

ESCAPE CONNECTOR se 'load rapidsse.public.G1' WITH file = '/DATA/Datums/boolean.csv',node = 'node1', max_errors = 30;
failure contains: '19 records in error'

select * from rapidsse.public.G1;
rows: 101;

// drop the table
drop table G1;
success

CLEANUP {
  
  // drop the table
  drop table G1;
  mute
  
  bye;
  mute
}

