/*----------------------------------------------------------------------------*/
/* terminatorSmall_cr -- cr terminator with < 1mb file                        */
/*----------------------------------------------------------------------------*/

// create the table

create table terminator_cr (
  c1 integer,
  c2 varchar,
  c3 varchar
);
success

// load data into the table with default formatter settings
ESCAPE CONNECTOR se 'load terminator_cr' with file='../Seth/tests/Load/terminatorSmall_cr.csv' , terminator='\r', node='NODE1' ;
failure contains: 'Success'

// create index
create index idx on terminator_cr(c1);
success

// fetch
select * from terminator_cr where c1 = 1;
rows: 2534

// fetch
select * from terminator_cr ;
rows: 2534

CLEANUP {
  
  drop table terminator_cr;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
