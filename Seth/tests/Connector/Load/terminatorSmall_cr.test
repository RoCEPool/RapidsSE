/*----------------------------------------------------------------------------*/
/* terminatorSmall_cr -- cr terminator with < 1mb file                        */
/*----------------------------------------------------------------------------*/

// create the table

create table rapidsse.public.terminator_cr (
  c1 integer,
  c2 varchar,
  c3 varchar
);
success

// load data into the table with default formatter settings
ESCAPE CONNECTOR se 'load terminator_cr' with file='/DATA/Load/terminatorSmall_cr.csv' , terminator='\r', node='NODE1' ;
failure contains: 'Success'

// create index
create index idx on rapidsse.public.terminator_cr(c1);
success

// fetch
select * from rapidsse.public.terminator_cr where c1 = 1;
rows: 2534

// fetch
select * from rapidsse.public.terminator_cr ;
rows: 2534

CLEANUP {
  
  drop table rapidsse.public.terminator_cr;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
