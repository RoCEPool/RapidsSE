/*----------------------------------------------------------------------------*/
/* varchar -- varchar with deafult formatters                                 */
/*----------------------------------------------------------------------------*/

// create the tables
create table vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on vch (vch_testno);
success;

// load data into the table with default formatter settings
escape connector se 'load vch ../JTEST/vch_defaults.csv' with node='NODE1';
success

select * from vch;
rows: 18

select * from vch where vch_testno = 101;
rows:
 (*, 101, 'quick brown fox', *)

select * from vch where vch_testno = 102;
rows:
  (*, 102, 'quick, brown fox', *)

