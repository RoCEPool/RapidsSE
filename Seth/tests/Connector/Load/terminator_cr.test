/*----------------------------------------------------------------------------*/
/* terminator_cr -- cr terminator file                                        */
/*----------------------------------------------------------------------------*/

// create the table
create table rapidsse.public.terminator_cr (
  c1 integer,
  c2 varchar,
  c3 varchar
);
success

// load data into the table with default formatter settings
ESCAPE CONNECTOR se 'load terminator_cr' with file='/DATA/Load/terminator_cr.csv' , terminator='\r', node='NODE1' ;
failure contains: 'Success'

// create index
create index idx on rapidsse.public.terminator_cr(c1);
success

// fetch
select * from rapidsse.public.terminator_cr where c1 = 1;;
rows:
  (1, 'A', 'This is terminated by <CR>')

// fetch
select * from  rapidsse.public.terminator_cr where c1 = 2;
rows:
  (2, 'A', 'Also terminated by <CR>')

// fetch
select * from  rapidsse.public.terminator_cr;
rows: 2

drop table rapidsse.public.terminator_cr;
success

CLEANUP {
  
  drop table rapidsse.public.terminator_cr;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
