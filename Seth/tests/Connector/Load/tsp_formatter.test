/*----------------------------------------------------------------------------*/
/* timestamp format tests                                                     */
/*----------------------------------------------------------------------------*/

// create the tables
create table rapidsse.public.tsp (
  tsp_key    INTEGER     NOT NULL,
  tsp_tsp    TIMESTAMP   NOT NULL
);
success

create index idx on rapidsse.public.tsp (tsp_key);
success

//------------------------------------------------------------------------------
// load data into the table with incorrect formatters

ESCAPE CONNECTOR se 'load tsp' with file='/DATA/Load/tsp_YYYY-DD-MM.csv', DATE_FORMAT="YYYY-DD.MM", node='NODE1'  ;
failure contains: 'invalid command'

ESCAPE CONNECTOR se 'load tsp' with file='/DATA/Load/tsp_YYYY-DD-MM.csv', DATE_FORMAT="XX-DD-MM", node='NODE1'  ;
failure contains: 'invalid command'

ESCAPE CONNECTOR se 'load tsp' with file='/DATA/Load/tsp_YYYY-DD-MM.csv', DATE_FORMAT="YY-DD-MM", node='NODE1'  ;
