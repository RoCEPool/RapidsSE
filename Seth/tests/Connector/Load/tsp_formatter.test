failure contains: 'invalid command'

ESCAPE CONNECTOR se 'load tsp' with file='/DATA/Load/tsp_YYYY-DD-MM.csv', DATE_FORMAT="YYYY/DD-MM", node='NODE1'  ;
failure contains: 'invalid command'

ESCAPE CONNECTOR se 'load tsp' with file='/DATA/Load/tsp_YYYY-DD-MM.csv', DATE_FORMAT="DD-MM-YYYD", node='NODE1'  ;
failure contains: 'invalid command'

ESCAPE CONNECTOR se 'load tsp' with file='/DATA/Load/tsp_YYYY-DD-MM.csv', DATE_FORMAT="MM-MM-YYYD", node='NODE1' ;
failure contains: 'invalid command'

ESCAPE CONNECTOR se 'load tsp' with file='/DATA/Load/tsp_YYYY-DD-MM.csv', DATE_FORMAT="MM-DD/YYYYY", node='NODE1'  ;
