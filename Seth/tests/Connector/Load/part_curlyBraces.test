/*----------------------------------------------------------------------------*/
/* part_curlyBraces --                                                        */
/*----------------------------------------------------------------------------*/

// create the table
create table PART (
p_partkey INTEGER NOT NULL,
p_name VARCHAR(55),
p_mfgr VARCHAR(25),
p_brand VARCHAR(10),
p_type VARCHAR(25),
p_size INTEGER,
p_container VARCHAR(10),
p_retailprice FLOAT,
p_comment VARCHAR(23)
);
success

// load data into the table with default formatter settings
escape connector se 'load part' with file='../Seth/tests/Load/part_curlyBraces.csv', enclosed_by='{}',  terminator='\r\n', node='node1';
success

select * from part where p_type is null;
rows: 10

CLEANUP {
  
  drop table part;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
