/*----------------------------------------------------------------------------*/
/* vch_defaults -- varchar with deafult formatters                            */
/*----------------------------------------------------------------------------*/

// create the table

create table terminator_cr (
  c1 integer,
  c2 varchar,
  c3 varchar
);
success

// load data into the table with default formatter settings
ESCAPE CONNECTOR se 'load terminator_cr ../Seth/tests/Load/terminatorLarge_cr.csv' with node='NODE1' ;
success

// create index
create index idx on terminator_cr(c1);
success

// fetch
fetch terminator_cr "c1 1 =";
rows:
  (*, 1, 'This is terminatoed by <CR>');

// fetch
fetch terminator_cr;
rows: 6895

CLEANUP {
  
  drop table terminator_cr;
  mute

  bye;
  mute
}


/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
