/*----------------------------------------------------------------------------*/
/* varchar -- varchar with deafult formatters                                 */
/*----------------------------------------------------------------------------*/

// create the tables
create table vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on vch (vch_testno);
success

// load data into the table with default formatter settings
escape connector se 'load vch' with file='/home/alka/master/rapidsse/JTEST/vch_defaults.csv' , node='NODE1';
failure contains: 'Success'

select * from vch;
rows: 21

select vch_field from vch where vch_testno = 101;
rows:
 ('quick brown fox')

select vch_field from vch where vch_testno = 102;
rows:
  ('quick, brown fox')

