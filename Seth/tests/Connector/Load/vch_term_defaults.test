/*----------------------------------------------------------------------------*/
/* vch_term_defaults -- varchar with terminated                               */
/*----------------------------------------------------------------------------*/

// create the tables
create table vch (
  vch_testno  INTEGER     NOT NULL,
  vch_field   VARCHAR(32),
  vch_comment VARCHAR(64) NOT NULL
);
success

// create an index
create index idx on vch (vch_testno);
success

// load data into the table with default formatter settings
escape connector se 'load vch' with file='../JTEST/vch_term_defaults.csv', terminator=';\n' , enclosed_by="'", node='NODE1';
failure contains: 'Success'

select * from vch;
rows: 18

select vch_field from vch where vch_testno = 501;
rows:
 ('quick brown fox')

select vch_field from vch where vch_testno = 502;
rows:
  ('quick, brown fox')

select vch_field from vch where vch_testno = 503;
rows:
  ('quick brown fox''s')

select vch_field from vch where vch_testno = 504;
rows:
  ('quick brown fox''s')

select vch_field from vch where vch_testno = 505;
rows:
  ('quick brow\n foxs')

select vch_field from vch where vch_testno = 506;
rows:
  ('quick brown fox
s')

select vch_field from vch where vch_testno = 507;
rows:
  ('quick brown fox')

select vch_field from vch where vch_testno = 508;
rows:
  ('quick brown fox')

select vch_field from vch where vch_testno = 509;
rows:
  ('')

select vch_field from vch where vch_testno = 510;
rows:
  (null)

select vch_field from vch where vch_testno = 511;
rows:
  (null)

select vch_field from vch where vch_testno = 512;
rows:
  ('quick ;brown fox')

select vch_field from vch where vch_testno = 513;
rows:
  ('   quick brown fox   ')

select vch_field from vch where vch_testno = 514;
rows:
  ('quick brown fox''s')

select vch_field from vch where vch_testno = 515;
rows:
  (null)

select vch_field from vch where vch_testno = 516;
rows:
  (null)

select vch_field from vch where vch_testno = 517;
rows:
  (null)

select vch_field from vch where vch_testno = 518;
rows:
  ('quick brown fox
s')

CLEANUP {
  
  drop table vch;
  mute

  bye;
  mute
}


