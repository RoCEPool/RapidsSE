//----------------------------------------------------------------------------//
// create table with basic datatype colums
//----------------------------------------------------------------------------//

// create a table with a boolean column
create table rapidsse.public.G1 (
  id      integer,
  vch     varchar,
  dte     date,
  tsp     timestamp,
  dec     decimal(17,2),
  decL    decimal(19,2),
  flt     float,
  status  boolean
);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'rapidsse';
rows:
  ('G1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision, scale from rapids.system.columns where
  table_name = 'G1' and column_name = 'STATUS';
rows:
  ('BOOLEAN', false, true, null, null)

// check partition key is first column
select column_name from rapids.system.columns where table_name = 'G1' and is_partition_key = true;
mute
//CHECK_REULT
/*
 rows:
  ('ID')
 */

// insert rows in the table
ESCAPE CONNECTOR se 'load rapidsse.public.G1' WITH file = '/DATA/Load/dataTypes.csv', node = 'node1' ;
failure contains: 'Success'

// select from T1
select * from rapidsse.public.G1;
 rows:
(              65531, '12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890', TIMESTAMP '1995-02-13 00:00:00.0', TIMESTAMP '1998-02-08 20:20:20.2' , 10.65, 22.22, 1.777890e+03, true  )
(              65530, ''''''                                                                                                                                                                                                                                                                , TIMESTAMP '1996-03-13 00:00:00.0', TIMESTAMP '1996-03-13 10:10:10.0' , 10.23, 10.23, 1.199000e+01, true  )
(              65530, ' abcd'                                                                                                                                                                                                                                                               , TIMESTAMP '1996-03-13 00:00:00.0', TIMESTAMP '1996-03-13 10:10:10.0' , 10.23, 10.23, 1.199000e+01, true  )
(              65530, 'abcdefghijklmnopgrstuvwxyz'                                                                                                                                                                                                                                          , TIMESTAMP '1996-03-13 00:00:00.0', TIMESTAMP '1996-03-13 10:10:10.0' , 10.23, 10.23, 1.199000e+01, true  )
(              65530, 'abcdefghijklmnopgrstuvwxyz'                                                                                                                                                                                                                                          , TIMESTAMP '1996-03-13 00:00:00.0', TIMESTAMP '1996-03-13 10:10:10.0' , 10.23, 10.23, 1.199000e+01, true  )
// drop table
drop table rapidsse.public.G1;
success

CLEANUP {
  drop table rapidsse.public.G1;
  mute
}
