--------------------------------------------------------------------------------
-- insert-select MOXE->SE tests
--------------------------------------------------------------------------------

Loop 1 {
  

-- refresh metadata
refresh;
success

--------------------------------------------------------------------------------
-- set up the SE and MOXE tables and data
--------------------------------------------------------------------------------
-- create an SE table
create table rapidsse.public.PerfTest (
  PerfTest_key   INTEGER ,
  PerfTest_1     INTEGER,
  PerfTest_2     INTEGER,
  PerfTest_3     INTEGER
);
success

-- create a MOXE table
create table MOXE.PerfTest (
  PerfTest_key   INTEGER ,
  PerfTest_1     INTEGER,
  PerfTest_2     INTEGER,
  PerfTest_3     INTEGER
);
success


--------------------------------------------------------------------------------
-- Load the SE table
--------------------------------------------------------------------------------
-- Load the SE table
ESCAPE CONNECTOR se 'load rapidsse.public.PerfTest' with file='/rapids/i/t1M.csv' , node = 'Node1' ;
failure contains: 'Success'

--------------------------------------------------------------------------------
-- Insert into MOXE table selecting fromd the SE table
--------------------------------------------------------------------------------
-- insert into MOXE from SE
insert into MOXE.PerfTest select * from rapidsse.public.PerfTest;
success

--------------------------------------------------------------------------------
-- select from SE
--------------------------------------------------------------------------------
-- select from rapidsse.public.PerfTest
select count(*) from rapidsse.public.PerfTest;
rows: (1000000)

--------------------------------------------------------------------------------
-- select from MOXE
--------------------------------------------------------------------------------
-- select from MOXE.PerfTest
select count(*) from MOXE.PerfTest;
rows: (1000000)

}

CLEANUP {
 
  //drop table rapidsse.public.PerfTest;
  //mute
  
  //drop table MOXE.PerfTest;
  //mute
  
}



