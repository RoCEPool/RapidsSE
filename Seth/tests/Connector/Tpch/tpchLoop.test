--------------------------------------------------------------------------------
-- tpch queries in a loop
--------------------------------------------------------------------------------

// Logging a message
LOG 'Running tpchQueries test in a loop.';

LOOP 1 {

//------------------------------------------------------------------------------
LOG 'Create tpch schema...';
INCLUDE 'tpchSchemaCreate.test';

//------------------------------------------------------------------------------
LOG 'Loading tpch data...';
INCLUDE 'tpchLoad.test';

//------------------------------------------------------------------------------
LOG 'Selecting tpch data...';
INCLUDE 'tpchSelect.test';

//------------------------------------------------------------------------------
//LOG 'Running tpch queries...';
//INCLUDE 'tpchQueries.test';

//------------------------------------------------------------------------------
LOG 'truncating tpch tables...';
INCLUDE 'tpchTruncate.test';

//------------------------------------------------------------------------------
LOG 'selecting from truncated tpch tables...';
INCLUDE 'tpchTruncateSelect.test';

//------------------------------------------------------------------------------
LOG 'Dropping tpch schema...';
INCLUDE 'tpchSchemaDrop.test';

} -- end of loop

CLEANUP {

  drop table customer;
  mute

  drop table supplier;
  mute

  drop table orders;
  mute

  drop table partsupp;
  mute

  drop table part;
  mute

  drop table region;
  mute

  drop table lineitem;
  mute

  drop table nation;
  mute

  bye;
  mute
}

