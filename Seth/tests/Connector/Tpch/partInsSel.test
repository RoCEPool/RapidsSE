--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

loop 1 {
create table rapidsse.public.part1 (
P_PARTKEY           INTEGER NOT NULL,
P_NAME              VARCHAR(55) NOT NULL,
P_MFGR              VARCHAR(25) NOT NULL,
P_BRAND             VARCHAR(10) NOT NULL,
P_TYPE              VARCHAR(25) NOT NULL,
P_SIZE              INTEGER NOT NULL,
P_CONTAINER         VARCHAR(10) NOT NULL,
P_RETAILPRICE       DECIMAL(15,2) NOT NULL,
P_COMMENT           VARCHAR(23) NOT NULL
);
success

CREATE INDEX part_idx1 ON rapidsse.public.part1(p_brand);
success

ESCAPE CONNECTOR se 'load part1' with file='/TPCH/SF1/part.tbl' , node = 'Node1' , delimiter = '|';
failure contains: 'Success'

create table rapidsse.public.part2 (
P_PARTKEY           INTEGER NOT NULL,
P_NAME              VARCHAR(55) NOT NULL,
P_MFGR              VARCHAR(25) NOT NULL,
P_BRAND             VARCHAR(10) NOT NULL,
P_TYPE              VARCHAR(25) NOT NULL,
P_SIZE              INTEGER NOT NULL,
P_CONTAINER         VARCHAR(10) NOT NULL,
P_RETAILPRICE       DECIMAL(15,2) NOT NULL,
P_COMMENT           VARCHAR(23) NOT NULL
);
success


insert into rapidsse.public.part2 select * from rapidsse.public.part1;
success

select * from rapidsse.public.part2;
rows: 200000

}

CLEANUP {
  
  drop table rapidsse.public.part1;
  mute
  
  drop table rapidsse.public.part2;
  mute
  
  bye;
  mute
}


