--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

create table rapidsse.public.customer1 (
C_CUSTKEY       INTEGER NOT NULL,
C_NAME          VARCHAR(25) NOT NULL,
C_ADDRESS       VARCHAR(40) NOT NULL,
C_NATIONKEY     INTEGER NOT NULL,
C_PHONE         VARCHAR(15) NOT NULL,
C_ACCTBAL       DECIMAL(15,2) NOT NULL,
C_MKTSEGMENT    VARCHAR(10) NOT NULL,
C_COMMENT       VARCHAR(117) NOT NULL
);
success

ESCAPE CONNECTOR se 'load customer1' with file='/TPCH/SF1/customer.tbl' , terminator = ',\n', node = 'Node1' ;
failure contains: 'Success'

create table rapidsse.public.customer2 (
C_CUSTKEY       INTEGER NOT NULL,
C_NAME          VARCHAR(25) NOT NULL,
C_ADDRESS       VARCHAR(40) NOT NULL,
C_NATIONKEY     INTEGER NOT NULL,
C_PHONE         VARCHAR(15) NOT NULL,
C_ACCTBAL       DECIMAL(15,2) NOT NULL,
C_MKTSEGMENT    VARCHAR(10) NOT NULL,
C_COMMENT       VARCHAR(117) NOT NULL
);
success

insert into rapidsse.public.customer2 select * from customer1;
success

select * from rapidsse.public.customer2;
rows: 150000

drop table rapidsse.public.customer1;
success

drop table rapidsse.public.customer2;
success

CLEANUP {

  drop table rapidsse.public.customer1;
  mute

  drop table rapidsse.public.customer2;
  mute

  bye;
  mute
}


