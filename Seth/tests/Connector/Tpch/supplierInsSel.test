--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

loop 1 {
create table rapidsse.public.supplier1 (
S_SUPPKEY       INTEGER NOT NULL,
S_NAME          VARCHAR(25) NOT NULL,
S_ADDRESS       VARCHAR(40) NOT NULL,
S_NATIONKEY     INTEGER NOT NULL,
S_PHONE         VARCHAR(15) NOT NULL,
S_ACCTBAL       DECIMAL(15,2) NOT NULL,
S_COMMENT       VARCHAR(101) NOT NULL
);

success

ESCAPE CONNECTOR se 'load supplier1' with file='/TPCH/SF1/supplier.tbl' , node = 'Node1', delimiter = '|' ;
failure contains: 'Success'

create table rapidsse.public.supplier2 (
S_SUPPKEY       INTEGER NOT NULL,
S_NAME          VARCHAR(25) NOT NULL,
S_ADDRESS       VARCHAR(40) NOT NULL,
S_NATIONKEY     INTEGER NOT NULL,
S_PHONE         VARCHAR(15) NOT NULL,
S_ACCTBAL       DECIMAL(15,2) NOT NULL,
S_COMMENT       VARCHAR(101) NOT NULL
);

insert into rapidsse.public.supplier2 select * from rapidsse.public.supplier1;
success

select * from rapidsse.public.supplier2;
rows: 10000

drop table rapidsse.public.supplier1;
success

drop table rapidsse.public.supplier2;
success

}

CLEANUP {
  
  drop table rapidsse.public.supplier1;
  mute
  
  drop table rapidsse.public.supplier2;
  mute
  
  bye;
  mute
}


