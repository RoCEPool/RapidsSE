--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

loop 1 {
create table supplier1 (
S_SUPPKEY       INTEGER NOT NULL,
S_NAME          VARCHAR(25) NOT NULL,
S_ADDRESS       VARCHAR(40) NOT NULL,
S_NATIONKEY     INTEGER NOT NULL,
S_PHONE         VARCHAR(15) NOT NULL,
S_ACCTBAL       DECIMAL(15,2) NOT NULL,
S_COMMENT       VARCHAR(101) NOT NULL
);

success

ESCAPE CONNECTOR se 'load supplier1 /tpch/supplier.tbl' WITH node = 'Node1' ;
success

create table supplier2 (
S_SUPPKEY       INTEGER NOT NULL,
S_NAME          VARCHAR(25) NOT NULL,
S_ADDRESS       VARCHAR(40) NOT NULL,
S_NATIONKEY     INTEGER NOT NULL,
S_PHONE         VARCHAR(15) NOT NULL,
S_ACCTBAL       DECIMAL(15,2) NOT NULL,
S_COMMENT       VARCHAR(101) NOT NULL
);

insert into supplier2 select * from supplier1;
success

select * from supplier2;
rows: 10000

//drop table supplier1;
//success

//drop table supplier2;
//success

}

CLEANUP {
  
  //drop table supplier1;
  //mute
  
  //drop table supplier2;
  //mute
  
  bye;
  mute
}


