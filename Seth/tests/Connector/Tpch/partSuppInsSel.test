--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

create table rapidsse.public.partsupp1 (
PS_PARTKEY      INTEGER NOT NULL,
PS_SUPPKEY      INTEGER NOT NULL,
PS_AVAILQTY     INTEGER NOT NULL,
PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
PS_COMMENT      VARCHAR(199) NOT NULL
);
success

ESCAPE CONNECTOR se 'load partsupp1' with file='/TPCH/SF1/partsupp.tbl' , node = 'Node1' , delimiter = '|';
failure contains: 'Success'

create table rapidsse.public.partsupp2 (
PS_PARTKEY      INTEGER NOT NULL,
PS_SUPPKEY      INTEGER NOT NULL,
PS_AVAILQTY     INTEGER NOT NULL,
PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
PS_COMMENT      VARCHAR(199) NOT NULL
);
success

insert into rapidsse.public.partsupp2 select * from partsupp1;
success

select * from rapidsse.public.partsupp2;
rows: 800000

drop table rapidsse.public.partsupp1;
success

drop table rapidsse.public.partsupp2;
success

CLEANUP {
  
  drop table rapidsse.public.partsupp1;
  mute
  
  drop table rapidsse.public.partsupp2;
  mute
  
  bye;
  mute
}


