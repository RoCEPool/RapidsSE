--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

create table rapidsse.public.region1 (
R_REGIONKEY       INTEGER NOT NULL,
R_NAME            VARCHAR(25) NOT NULL,
R_COMMENT         VARCHAR(152)
);
success

create index idx1 on rapidsse.public.region1(R_REGIONKEY);
success

ESCAPE CONNECTOR se 'load region1' with file='/TPCH/SF1/region.tbl' , node = 'Node1' , delimiter = '|';
failure contains: 'Success'

create table rapidsse.public.region2 (
R_REGIONKEY       INTEGER NOT NULL,
R_NAME            VARCHAR(25) NOT NULL,
R_COMMENT         VARCHAR(152)
);
success

create index idx1 on rapidsse.public.region2(R_REGIONKEY);
success

insert into rapidsse.public.region2 select * from region1;
success

select * from rapidsse.public.region2;
rows: 5

drop table rapidsse.public.region1;
success

drop table rapidsse.public.region2;
success

CLEANUP {

  drop table rapidsse.public.region1;
  mute

  drop table rapidsse.public.region2;
  mute

  bye;
  mute
}


