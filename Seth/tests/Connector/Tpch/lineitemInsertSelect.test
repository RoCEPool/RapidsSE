--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

loop 1 {
create table lineitem1 (
  L_ORDERKEY      INTEGER NOT NULL,
  L_PARTKEY       INTEGER NOT NULL,
  L_SUPPKEY       INTEGER NOT NULL,
  L_LINENUMBER    INTEGER NOT NULL,
  L_QUANTITY      DECIMAL(15,2) NOT NULL,
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,
  L_TAX           DECIMAL(15,2) NOT NULL,
  L_RETURNFLAG    VARCHAR(1) NOT NULL,
  L_LINESTATUS    VARCHAR(1) NOT NULL,
  L_SHIPDATE      TIMESTAMP NOT NULL,
  L_COMMITDATE    TIMESTAMP NOT NULL,
  L_RECEIPTDATE   TIMESTAMP NOT NULL,
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,
  L_SHIPMODE      VARCHAR(10) NOT NULL,
  L_COMMENT       VARCHAR(44) NOT NULL
);
success

CREATE INDEX lineitem_idx1 ON lineitem1(l_partkey);
success

CREATE INDEX lineitem_idx2 ON lineitem1(l_shipdate);
success

CREATE INDEX lineitem_idx3 ON lineitem1(l_suppkey);
success

ESCAPE CONNECTOR se 'load lineitem1' with file='/tpch/lineitem.tbl' , node = 'Node1' ;
success

create table lineitem2 (
  L_ORDERKEY      INTEGER NOT NULL,
  L_PARTKEY       INTEGER NOT NULL,
  L_SUPPKEY       INTEGER NOT NULL,
  L_LINENUMBER    INTEGER NOT NULL,
  L_QUANTITY      DECIMAL(15,2) NOT NULL,
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,
  L_TAX           DECIMAL(15,2) NOT NULL,
  L_RETURNFLAG    VARCHAR(1) NOT NULL,
  L_LINESTATUS    VARCHAR(1) NOT NULL,
  L_SHIPDATE      TIMESTAMP NOT NULL,
  L_COMMITDATE    TIMESTAMP NOT NULL,
  L_RECEIPTDATE   TIMESTAMP NOT NULL,
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,
  L_SHIPMODE      VARCHAR(10) NOT NULL,
  L_COMMENT       VARCHAR(44) NOT NULL
);
success

CREATE INDEX lineitem_idx1 ON lineitem2(l_partkey);
success

CREATE INDEX lineitem_idx2 ON lineitem2(l_shipdate);
success

CREATE INDEX lineitem_idx3 ON lineitem2(l_suppkey);
success

insert into lineitem2 select * from lineitem1;
success

select * from lineitem2;
rows: 6001215

drop table lineitem1;
success

drop table lineitem2;
success

}

CLEANUP {
  
  drop table lineitem1;
  mute
  
  drop table lineitem2;
  mute
  
  bye;
  mute
}


