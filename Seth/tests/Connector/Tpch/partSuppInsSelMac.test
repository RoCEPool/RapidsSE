--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

create table partsupp1 (
PS_PARTKEY      INTEGER NOT NULL,
PS_SUPPKEY      INTEGER NOT NULL,
PS_AVAILQTY     INTEGER NOT NULL,
PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
PS_COMMENT      VARCHAR(199) NOT NULL
);
success

ESCAPE CONNECTOR se 'load partsupp1' with file='/tpch/partsupp.tbl' , node = 'Node1' ;
failure contains: 'Success'

create table partsupp2 (
PS_PARTKEY      INTEGER NOT NULL,
PS_SUPPKEY      INTEGER NOT NULL,
PS_AVAILQTY     INTEGER NOT NULL,
PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
PS_COMMENT      VARCHAR(199) NOT NULL
);
success

insert into partsupp2 select * from partsupp1;
success

select * from partsupp2;
rows: 800000

drop table partsupp1;
success

drop table partsupp2;
success

CLEANUP {
  
  drop table partsupp1;
  mute
  
  drop table partsupp2;
  mute
  
  bye;
  mute
}


