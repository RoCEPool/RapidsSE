--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

create table rapidsse.public.orders1 (
O_ORDERKEY        INTEGER NOT NULL,
O_CUSTKEY         INTEGER NOT NULL,
O_ORDERSTATUS     VARCHAR(1) NOT NULL,
O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
O_ORDERDATE       TIMESTAMP NOT NULL,
O_ORDERPRIORITY   VARCHAR(15) NOT NULL,
O_CLERK           VARCHAR(15) NOT NULL,
O_SHIPPRIORITY    INTEGER NOT NULL,
O_COMMENT         VARCHAR(79) NOT NULL
);
success

CREATE INDEX orders_idx1 ON rapidsse.public.orders1(o_orderdate);success

ESCAPE CONNECTOR se 'load orders1' with file='/TPCH/SF1/orders.tbl' , node = 'Node1', delimiter = '|' ;
failure contains: 'Success'

create table rapidsse.public.orders2 (
O_ORDERKEY        INTEGER NOT NULL,
O_CUSTKEY         INTEGER NOT NULL,
O_ORDERSTATUS     VARCHAR(1) NOT NULL,
O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
O_ORDERDATE       TIMESTAMP NOT NULL,
O_ORDERPRIORITY   VARCHAR(15) NOT NULL,
O_CLERK           VARCHAR(15) NOT NULL,
O_SHIPPRIORITY    INTEGER NOT NULL,
O_COMMENT         VARCHAR(79) NOT NULL
);
success

CREATE INDEX orders_idx1 ON rapidsse.public.orders2(o_orderdate);
success

insert into orders2 select * from rapidsse.public.orders1;
success

select * from rapidsse.public.orders2;
rows: 1500000

drop table rapidsse.public.orders1;
success

drop table rapidsse.public.orders2;
success


CLEANUP {
  
  drop table rapidsse.public.orders1;
  mute
  
  drop table rapidsse.public.orders2;
  mute
  
  bye;
  mute
}


