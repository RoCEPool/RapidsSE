--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

create table rapidsse.public.nation1 (
N_NATIONKEY       INTEGER NOT NULL,
N_NAME            VARCHAR(25) NOT NULL,
N_REGIONKEY       INTEGER NOT NULL,
N_COMMENT         VARCHAR(152)
);
success

create table rapidsse.public.nation2 (
N_NATIONKEY       INTEGER NOT NULL,
N_NAME            VARCHAR(25) NOT NULL,
N_REGIONKEY       INTEGER NOT NULL,
N_COMMENT         VARCHAR(152)
);
success

ESCAPE CONNECTOR se 'load nation1' with file='/TPCH/SF1/nation.tbl' , node = 'Node1', delimiter = '|' ;
failure contains: 'Success'

insert into rapidsse.public.nation2 select * from nation1;
success

select * from rapidsse.public.nation2;
rows: 25

drop table rapidsse.public.nation1;
success

drop table rapidsse.public.nation2;
success

CLEANUP {
  
  drop table rapidsse.public.nation1;
  mute
  
  drop table rapidsse.public.nation2;
  mute
  
  bye;
  mute
}


