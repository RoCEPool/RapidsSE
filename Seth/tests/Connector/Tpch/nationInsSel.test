--------------------------------------------------------------------------------
-- tpch insert-select tests (SF1)
-------------------------------------------------------------------------------

create table nation1 (
N_NATIONKEY       INTEGER NOT NULL,
N_NAME            VARCHAR(25) NOT NULL,
N_REGIONKEY       INTEGER NOT NULL,
N_COMMENT         VARCHAR(152)
);
success

create table nation2 (
N_NATIONKEY       INTEGER NOT NULL,
N_NAME            VARCHAR(25) NOT NULL,
N_REGIONKEY       INTEGER NOT NULL,
N_COMMENT         VARCHAR(152)
);
success

ESCAPE CONNECTOR se 'load nation1' with file='/tpch/nation.tbl' , node = 'Node1' ;
failure contains: 'Success'

insert into nation2 select * from nation1;
success

select * from nation2;
rows: 25

drop table nation1;
success

drop table nation2;
success

CLEANUP {
  
  drop table nation1;
  mute
  
  drop table nation2;
  mute
  
  bye;
  mute
}


