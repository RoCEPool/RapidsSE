// Source file: ../qa/queries/alias/ralias-1.sql
// Result file: ../qa/queries/alias/results/alias-1.res
select m_qualitycode as QualCode from manufacturer m join returns r on m.m_mfgkey = r.m_mfgkey where r_returndate >= '2013-12-26 00:00:00' and r_returndate <= '2014-12-31 00:00:00' and m_specialorders = 'Y'order by m.m_mfgkey;
mute
//CHECK_RESULT
/*
 rows:
  (79)
  (37)
  (37)
  (19)
*/

// Source file: ../qa/queries/alias/ralias-2.sql
// Result file: ../qa/queries/alias/results/alias-2.res
select count(m_qualitycode) as "NumCodesBiggernThan50" from (select m_qualitycode from manufacturer m, returns r where m.m_mfgkey = r.m_mfgkey and cast(m_qualitycode as integer) > 50);
mute
//CHECK_RESULT
/*
 rows:
  (20)
*/

