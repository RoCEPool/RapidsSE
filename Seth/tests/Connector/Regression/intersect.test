// Source file: ../qa/queries/intersect/rintersect6.sql
// Result file: ../qa/queries/intersect/results/intersect6.res
select * from rapidsse.public.(select colb1 from rapidsse.public.table1, table9, table4 where pcol1 = pcol9 and pcol1 = pcol4 and colb1 in ('violet', 'indigo', 'orange', 'teal') and colb9 in ('black','blue', 'green', 'grey') and colb4 in ('aqua','pink','purple')) intersect select colb3 from rapidsse.public.table3, table2, table5 where pcol3 = pcol2 and pcol3 = pcol5 and colb3 like '%i%' and colb2 like '%r%' order by colb1;
mute
//CHECK_RESULT
/*
rows:
  ('indigo')
*/

