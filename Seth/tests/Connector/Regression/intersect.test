// Source file: ../qa/queries/intersect/rintersect3.sql
// Result file: ../qa/queries/intersect/results/intersect3.res
select pcol9, colb9, cold9/cole9, ucolvc from rapidsse.public.table9 where ucolvc in (select ucolvc from rapidsse.public.table9 where ucolvc between 'ttt' and 'zzz' ) and cold9 / cole9 < 24.5 and pcol9 > 450 intersect select pcol9, colb9, cold9/cole9, ucolvc from rapidsse.public.table9 where colb9 not in (select colb9 from rapidsse.public.table9 where colb9 not like 'br%' and colb9 not like 'gr%') and pcol9 > 450 order by pcol9;
mute
//CHECK_RESULT
/*
rows:
  (462, 'green', 0.17724256207590783, 'yyy')
  (498, 'green', 11.829019607843136, 'www')
  (499, 'grey', -0.7597592964048758, 'vvv')
*/

// Source file: ../qa/queries/intersect/rintersect4.sql
// Result file: ../qa/queries/intersect/results/intersect4.res
select cast(((cole9*100) / cold9) as integer) + 293 as Col1, ucolvc from rapidsse.public.table9 where colb9 like '%it%' intersect select pcol8, ucolvc from rapidsse.public.table8 where substring(right(colb8,4),3,1) like '%t%' or substring(right(colb8,4),3,1) like '%i%' order by Col1;
mute
//CHECK_RESULT
/*
rows:
  (341, 'uuu')
*/

