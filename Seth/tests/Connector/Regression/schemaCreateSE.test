/*----------------------------------------------------------------------------*/
/* regressionData -- Regression data load tests                               */
/*----------------------------------------------------------------------------*/

//------------------------------------------------------------------------------
// Logging a message
LOG 'Creating regression tables ';

// create the tables
create table rapidsse.public.TABLE1 (
  pcol1   INTEGER NOT NULL,
  tcol1   INTEGER NOT NULL,
  cola1   INTEGER,
  colb1   VARCHAR(20),
  colc1   TIMESTAMP,
  cold1   FLOAT,
  cole1   DECIMAL(15, 2),
  colf1   INTEGER,
  colg1   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);
success

create table rapidsse.public.TABLE2 (
  pcol2   INTEGER NOT NULL,
  scol2   INTEGER NOT NULL,
  cola2   INTEGER,
  colb2   VARCHAR(10),
  colc2   TIMESTAMP,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);
success

create table rapidsse.public.TABLE3 (
  pcol3   INTEGER NOT NULL,
  scol3   INTEGER NOT NULL,
  tcol3   INTEGER NOT NULL,
  unicol3 INTEGER NOT NULL,
  cola2   INTEGER,
  cola1   INTEGER,
  ucol    INTEGER,
  cola3   INTEGER,
  colb3   VARCHAR(25),
  colc3   TIMESTAMP
);
success

create table rapidsse.public.TABLE4 (
  pcol4   INTEGER NOT NULL,
  scol4   INTEGER NOT NULL,
  ucol    INTEGER,
  ucolvc  VARCHAR(5),
  cola4   INTEGER,
  colb4   VARCHAR(10),
  colc4   TIMESTAMP,
  cole4   DECIMAL(15, 2)
);
success

create table rapidsse.public.TABLE5 (
  pcol5   INTEGER NOT NULL,
  tcol5   INTEGER NOT NULL,
  cola5   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5),
  colb5   VARCHAR(10),
  colc5   TIMESTAMP
);
success

create table rapidsse.public.TABLE6 (
  pcol6   INTEGER NOT NULL,
  scol6   INTEGER NOT NULL,
  tcol6   INTEGER NOT NULL,
  ucol    INTEGER NOT NULL,
  ucolvc  VARCHAR(5),
  cola6   INTEGER
);
success

create table rapidsse.public.TABLE7 (
  pcol7   INTEGER NOT NULL,
  scol7   INTEGER NOT NULL,
  cola7   INTEGER,
  colb7   VARCHAR(10),
  colc7   TIMESTAMP,
  cold7   FLOAT,
  cole7   DECIMAL(15, 2),
  colf7   INTEGER
);
success

create table rapidsse.public.TABLE8 (
  pcol8   INTEGER NOT NULL,
  tcol8   INTEGER NOT NULL,
  cola8   INTEGER,
  colb8   VARCHAR(10),
  ucol    INTEGER,
  ucolvc  VARCHAR(5),
  colh8   INTEGER,
  coli8   VARCHAR(5)
);
success

create table rapidsse.public.TABLE9 (
  pcol9   INTEGER NOT NULL,
  scol9   INTEGER NOT NULL,
  tcol9   INTEGER NOT NULL,
  colb9   VARCHAR(20),
  cold9   FLOAT,
  cole9   DECIMAL,
  colf9   INTEGER,
  colg9   INTEGER,
  ucol    INTEGER,
  ucolvc  VARCHAR(5)
);
success

create table rapidsse.public.CUSTOMERH (
  c_custkey INTEGER NOT NULL,
  c_name VARCHAR(25),
  c_address VARCHAR(40),
  c_nationkey INTEGER,
  c_phone VARCHAR(15),
  c_acctbal DECIMAL(15, 2),
  c_mktsegment VARCHAR(10),
  c_comment VARCHAR(117)
);
success

create table rapidsse.public.ORDERS (
  o_orderkey INTEGER NOT NULL,
  o_custkey INTEGER NOT NULL,
  o_orderstatus VARCHAR(1),
  o_totalprice DECIMAL(15, 2),
  o_orderdate TIMESTAMP,
  o_orderpriority VARCHAR(15),
  o_clerk VARCHAR(15),
  o_shippriority INTEGER,
  o_shipcost DECIMAL(15, 2),
  o_estcost INTEGER,
  o_comment VARCHAR(79)
);
success

create table rapidsse.public.LINEITEM (
  l_orderkey INTEGER NOT NULL,
  l_partkey INTEGER NOT NULL,
  l_suppkey INTEGER NOT NULL,
  l_linenumber INTEGER,
  l_quantity INTEGER,
  l_extendedprice DECIMAL(15, 2),
  l_discount DECIMAL(15, 2),
  l_tax DECIMAL(15, 2),
  l_returnflag VARCHAR(1),
  l_linestatus VARCHAR(1),
  l_shipdate TIMESTAMP,
  l_commitdate TIMESTAMP,
  l_receiptdate TIMESTAMP,
  l_shipinstruct VARCHAR(25),
  l_shipmode VARCHAR(10),
  l_comment VARCHAR(44)
);
success

create table rapidsse.public.PART (
  p_partkey INTEGER NOT NULL,
  p_name VARCHAR(55),
  p_mfgr VARCHAR(25),
  p_brand VARCHAR(10),
  p_type VARCHAR(25),
  p_size INTEGER,
  p_container VARCHAR(10),
  p_retailprice FLOAT,
  p_comment VARCHAR(23)
);
success

create table rapidsse.public.SUPPLIER (
  s_suppkey INTEGER NOT NULL,
  s_name VARCHAR(25),
  s_address VARCHAR(40),
  s_nationkey INTEGER,
  s_phone VARCHAR(15),
  s_acctbal FLOAT,
  s_comment VARCHAR(101)
);
success

create table rapidsse.public.PARTSUPP (
  ps_partkey INTEGER NOT NULL,
  ps_suppkey INTEGER NOT NULL,
  ps_availqty INTEGER,
  ps_supplycost DECIMAL(15, 2),
  ps_comment VARCHAR(199)
);
success

create table rapidsse.public.NATION (
  n_nationkey INTEGER NOT NULL,
  n_name VARCHAR(25),
  n_regionkey INTEGER NOT NULL,
  n_comment VARCHAR(152)
);
success

create table rapidsse.public.REGION (
  r_regionkey INTEGER NOT NULL,
  r_name VARCHAR(25),
  r_comment VARCHAR(152)
);
success

create table rapidsse.public.SHIPPING (
  sh_shipkey INTEGER NOT NULL,
  sh_shipmode VARCHAR(10),
  sh_shipdate TIMESTAMP,
  sh_shippriority INTEGER,
  sh_shipinstruct VARCHAR(25),
  sh_shipcost DECIMAL(15, 2),
  sh_estcost INTEGER,
  sh_container VARCHAR(10)
);
success

create table rapidsse.public.SHIPADDRESS (
  sa_orderkey INTEGER NOT NULL,
  sa_shipline INTEGER NOT NULL,
  sa_address VARCHAR(75),
  sa_city VARCHAR(55),
  sa_state VARCHAR(55),
  sa_nationkey INTEGER,
  sa_shipdate TIMESTAMP,
  sa_carrier VARCHAR(75),
  sa_partial VARCHAR(1),
  sa_comments VARCHAR(80)
);
success

create table rapidsse.public.MANUFACTURER (
  m_orderkey INTEGER NOT NULL,
  m_partkey INTEGER NOT NULL,
  m_mfgkey INTEGER NOT NULL,
  m_nationkey INTEGER,
  m_qualitycode VARCHAR(5),
  m_capacity INTEGER,
  m_specialorders VARCHAR(1),
  m_comments VARCHAR(50)
);
success

create table rapidsse.public.RETURNS (
  l_orderkey INTEGER NOT NULL,
  l_linenumber INTEGER NOT NULL,
  m_mfgkey INTEGER NOT NULL,
  l_suppkey INTEGER,
  r_reason VARCHAR(100),
  r_condition VARCHAR(15),
  r_restock VARCHAR(1),
  r_returnmfg VARCHAR(1),
  r_credit DECIMAL(15, 2),
  r_returndate TIMESTAMP,
  r_comments VARCHAR(75)
);
success

//------------------------------------------------------------------------------
// Logging a message
LOG 'Loading regression data ';

// load data into the tables
ESCAPE CONNECTOR se 'load TABLE1' with file='/DATA/Regression/tbl1data.csv' , node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load TABLE2' with file='/DATA/Regression/tbl2data.csv' , node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load TABLE3' with file='/DATA/Regression/tbl3data.csv' , node = 'Node1' ;
failure contains: 'Success'

