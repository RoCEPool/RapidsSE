failure contains: 'Success'

ESCAPE CONNECTOR se 'load PARTSUPP' with file='/DATA/Regression/partsupp.csv', node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load PART' with file='/DATA/Regression/part.csv', node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load SHIPPING' with file='/DATA/Regression/shipping.csv', node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load SHIPADDRESS' with file='/DATA/Regression/shipaddr.csv', node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load SUPPLIER' with file='/DATA/Regression/supplier.csv', node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load MANUFACTURER' with file='/DATA/Regression/manufacturer-MOD.csv', node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load NATION' with file='/DATA/Regression/nation.csv', terminator='\r\n', node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load REGION' with file='/DATA/Regression/region.csv', node = 'Node1' ;
failure contains: 'Success'

ESCAPE CONNECTOR se 'load RETURNS' with file='/DATA/Regression/returns.csv', node = 'Node1' ;
failure contains: 'Success'

