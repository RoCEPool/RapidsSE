  // Source file: ../qa/queries/AndOrNot/raon5.sql
  // Result file: ../qa/queries/AndOrNot/results/aon5.res
select pcol1, pcol9, colb1, colb9 from table1 a, table9 b where (colb1 = 'green' or colb9= 'blue') and a.ucol = b.ucol order by pcol1;
rows:
  (2, 256, 'green', 'orange')
  (10, 26, 'TEAL', 'blue')
  (16, 403, 'green', 'indigo')
  (37, 437, 'violet', 'blue')


