// QUERY 3 (MOXE)
select l_orderkey, sum(l_extendedprice*(1-l_discount)) as revenue, o_orderdate, o_shippriority from
MOXE.customerh, MOXE.orders, MOXE.lineitem where c_mktsegment = 'BUILDING' and c_custkey = o_custkey and l_orderkey = o_orderkey
and o_orderdate < timestamp '2014-08-01 12:00:00' and l_shipdate > timestamp '2014-08-02 12:00:00' group by
l_orderkey, o_orderdate, o_shippriority order by revenue desc, o_orderdate;
rows: 51

// QUERY 3 (SE)
select l_orderkey, sum(l_extendedprice*(1-l_discount)) as revenue, o_orderdate, o_shippriority from
rapidsse.public.customerh, rapidsse.public.orders, rapidsse.public.lineitem where c_mktsegment = 'BUILDING' and c_custkey = o_custkey and l_orderkey = o_orderkey
and o_orderdate < timestamp '2014-08-01 12:00:00' and l_shipdate > timestamp '2014-08-02 12:00:00' group by
l_orderkey, o_orderdate, o_shippriority order by revenue desc, o_orderdate;
rows: 51





// QUERY 4 (MOXE)
select o_orderpriority, count(*) as order_count from MOXE.orders where o_orderdate >= '2013-06-01 12:00:00' and
o_orderdate < '2013-09-01 12:00:00' and exists (  select * from MOXE.lineitem where l_orderkey = o_orderkey and
l_commitdate < l_receiptdate ) group by o_orderpriority order by o_orderpriority;
rows: 3

// QUERY 4 (SE)
select o_orderpriority, count(*) as order_count from rapidsse.public.orders where o_orderdate >= '2013-06-01 12:00:00' and
o_orderdate < '2013-09-01 12:00:00' and exists (  select * from rapidsse.public.lineitem where l_orderkey = o_orderkey and
l_commitdate < l_receiptdate ) group by o_orderpriority order by o_orderpriority;
rows: 3





// QUERY 5 (MOXE)
select n_name, sum(l_extendedprice * (1 - l_discount)) as revenue from
MOXE.customerh, MOXE.orders, MOXE.lineitem, MOXE.supplier, MOXE.nation, MOXE.region where
c_custkey = o_custkey and l_orderkey = o_orderkey and l_suppkey = s_suppkey and
c_nationkey = s_nationkey and s_nationkey = n_nationkey and n_regionkey = r_regionkey and
r_name = 'EUROPE' and o_orderdate >= timestamp '2013-03-01 12:00:00' and
o_orderdate < timestamp '2013-04-02 12:00:00' group by n_name order by revenue desc;
rows: 1

