// QUERY 6 (MOXE)
select sum(l_extendedprice*l_discount) as revenue from MOXE.lineitem where
l_shipdate >= timestamp '2014-01-01 12:00:00' and l_shipdate < timestamp '2014-02-01 12:00:00' and
l_discount between 35 - 1.01 and 75 + 5.01 and l_quantity < 1000;
rows: 1

// QUERY 6 (SE)
select sum(l_extendedprice*l_discount) as revenue from rapidsse.public.lineitem where
l_shipdate >= timestamp '2014-01-01 12:00:00' and l_shipdate < timestamp '2014-02-01 12:00:00' and
l_discount between 35 - 1.01 and 75 + 5.01 and l_quantity < 1000;
rows: 1


// QUERY 10 (MOXE)
select c_custkey, c_name, sum(l_extendedprice * (1 - l_discount)) as revenue, c_acctbal, n_name, c_address,
c_phone, c_comment from MOXE.customerh, MOXE.orders, MOXE.lineitem, MOXE.nation where
c_custkey = o_custkey and l_orderkey = o_orderkey and o_orderdate >= timestamp '2013-08-01 12:00:00'
and o_orderdate < timestamp '2013-11-01 12:00:00' and l_returnflag = 'R' and c_nationkey = n_nationkey
group by c_custkey, c_name, c_acctbal, c_phone, n_name, c_address, c_comment order by revenue desc;
rows: 11

