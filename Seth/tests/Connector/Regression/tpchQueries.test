// QUERY 20 (SE)
select s_name, s_address from rapidsse.public.supplier, rapidsse.public.nation where s_suppkey in
( select ps_suppkey from rapidsse.public.partsupp where ps_partkey in ( select p_partkey from rapidsse.public.part where p_name like '%ing%' )
and ps_availqty > ( select 0.5 * sum(l_quantity) from MOXE.lineitem where l_partkey = ps_partkey and
l_suppkey = ps_suppkey and l_shipdate >= timestamp '2013-08-01 12:00:00' and
l_shipdate < timestamp '2014-08-01 12:00:00') ) and s_nationkey = n_nationkey and n_name = 'POLAND' order by s_name;
rows: 1

