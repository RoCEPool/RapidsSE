// QUERY 20 (MOXE)
select s_name, s_address from MOXE.supplier, MOXE.nation where s_suppkey in
( select ps_suppkey from MOXE.partsupp where ps_partkey in ( select p_partkey from MOXE.part where p_name like '%ing%' )
and ps_availqty > ( select 0.5 * sum(l_quantity) from MOXE.lineitem where l_partkey = ps_partkey and
l_suppkey = ps_suppkey and l_shipdate >= timestamp '2013-08-01 12:00:00' and
