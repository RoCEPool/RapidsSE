// QUERY 19 (MOXE)
select sum(l_extendedprice * (1 - l_discount) ) as revenue from
MOXE.lineitem, MOXE.part where (  p_partkey = l_partkey and p_brand = 'Brand#11' and p_container in
( 'SM CASE', 'SM BAG', 'SM PACK', 'SM PKG') and l_quantity >= 90 and l_quantity <= 250 + 10 and
p_size between 1 and 35 and l_shipmode in ('RAIL', 'MAIL') and l_shipinstruct = 'NONE' ) or
( p_partkey = l_partkey and p_brand = 'Brand#24' and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED CAN')
and l_quantity >= 400 and l_quantity <= 700 + 10 and p_size between 1 and 25 and l_shipmode in ('AIR', 'REG AIR')
and l_shipinstruct = 'DELIVER IN PERSON' ) or ( p_partkey = l_partkey and p_brand = 'Brand#55' and p_container in
( 'LG CASE', 'LG BOX', 'LG PACK', 'LG PKG') and l_quantity >= 90 and l_quantity <= 300 + 10 and
p_size between 15 and 45 and l_shipmode in ('AIR', 'REG AIR') and l_shipinstruct = 'COLLECT COD');
rows: 1

