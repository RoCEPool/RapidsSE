for i in {1..5}
do
echo "Welcome $i times"

  ./bootstrapper.sh -a stop
  ./bootstrapper.sh -a start
  for j in {1..10}
  do
    echo "Iteration $j of $i"
    ./rapids-shell.sh -p 5334 < schemaCreateSE.test
    ./rapids-shell.sh -p 5334 < schemaLoadSESvr.test
    ./rapids-shell.sh -p 5334 < schemaCreateMoxe.test
    ./rapids-shell.sh -p 5334 < insSelIntoMoxe.test
    ./rapids-shell.sh -p 5334 < selCountSE.test
    ./rapids-shell.sh -p 5334 < selCountMoxe.test

    ./rapids-shell.sh -p 5334 < schemaDropSE.test
    ./rapids-shell.sh -p 5334 < schemaCreateSE.test
    ./rapids-shell.sh -p 5334 < insSelIntoSE.test
    ./rapids-shell.sh -p 5334 < selCountSE.test
    ./rapids-shell.sh -p 5334 < selCountMoxe.test

    ./rapids-shell.sh -p 5334 < schemaDropSE.test
  done

done
