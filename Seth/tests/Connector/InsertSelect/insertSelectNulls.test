--------------------------------------------------------------------------------
-- insert-select index tests
--------------------------------------------------------------------------------

-- refresh metadata
refresh;
success

-- create a table with an index
create table T1000 (
  T1000_key   INTEGER ,
  T1000_name  VARCHAR(32),
  T1000_100   INTEGER,
  T1000_10    INTEGER
);
success

-- insert data into T1000
insert into T1000 values(0,'zero',0,0);
success

insert into T1000 values(1,'one',1,null);
success;

insert into T1000 values(2,'two',2,2);
success

insert into T1000 values(3,'three',3,3);
success

-- create another table with an index
create table R1000 (
  R1000_key   INTEGER,
  R1000_name  VARCHAR(32),
  R1000_100   INTEGER,
  R1000_10    INTEGER NOT NULL
);
success

-- insert-select
insert into R1000 select * from T1000;
success

-- check data
select count(*) from R1000;
rows:
(4)

CLEANUP {
  drop table T1000;
  mute
  drop table R1000;
  mute
}


