--------------------------------------------------------------------------------
-- insert-select index tests
--------------------------------------------------------------------------------

-- refresh metadata
refresh;
success

-- create a table with an index
create table rapidsse.public.T1000 (
  T1000_key   INTEGER ,
  T1000_name  VARCHAR(32),
  T1000_100   INTEGER,
  T1000_10    INTEGER
);
success

-- insert data into T1000
insert into rapidsse.public.T1000 values(0,'zero',0,0);
success

insert into rapidsse.public.T1000 values(1,'one',1,null);
mute
//CHECK_RESULT
//success;
 
insert into rapidsse.public.T1000 values(2,'two',2,2);
success

insert into rapidsse.public.T1000 values(3,'three',3,3);
success


-- create another table with an index
create table rapidsse.public.R1000 (
  R1000_key   INTEGER,
  R1000_name  VARCHAR(32),
  R1000_100   INTEGER,
  R1000_10    INTEGER
);
success

Loop 1000 {
  
-- insert-select
insert into rapidsse.public.R1000 select * from T1000;
success

-- check data
select * from rapidsse.public.R1000;
mute
}

//CHECK_RESULT
/*
 rows: 4
*/

select * from rapidsse.public.R1000 where R1000_key = 1;
rows:
  (1,'one',1,null);

CLEANUP {
  //drop table T1000;
  //mute
  //drop table R1000;
  //mute
}


