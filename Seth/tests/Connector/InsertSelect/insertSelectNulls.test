--------------------------------------------------------------------------------
-- insert-select index tests
--------------------------------------------------------------------------------

-- refresh metadata
refresh;
success

-- create a table with an index
create table rapidsse.public.G1000 (
  G1000_key   INTEGER ,
  G1000_name  VARCHAR(32),
  G1000_100   INTEGER,
  G1000_10    INTEGER
);
success

-- insert data into G1000
insert into rapidsse.public.G1000 values(0,'zero',0,0);
success

//insert into rapidsse.public.G1000 values(1,'one',1,null);
//mute
//CHECK_RESULT
//success;
 
insert into rapidsse.public.G1000 values(2,'two',2,2);
success

insert into rapidsse.public.G1000 values(3,'three',3,3);
success


-- create another table with an index
create table rapidsse.public.R1000 (
  R1000_key   INTEGER,
  R1000_name  VARCHAR(32),
  R1000_100   INTEGER,
  R1000_10    INTEGER
);
success

select * from rapidsse.public.R1000 where R1000_key = 1;
rows:
(1,'one',1,null);

Loop 100 {
  
-- insert-select
insert into rapidsse.public.R1000 select * from rapidsse.public.G1000;
success

}

-- check data
select * from rapidsse.public.R1000;
rows: 300

CLEANUP {
  drop table rapidsse.public.G1000;
  mute
  drop table rapidsse.public.R1000;
  mute
}


