--------------------------------------------------------------------------------
-- insert-select index tests
--------------------------------------------------------------------------------

-- refresh metadata
refresh;
success

-- create a table with a unique index
create table rapidsse.public.G1000 (
  G1000_key   INTEGER ,
  G1000_name  VARCHAR(32),
  G1000_100   INTEGER,
  G1000_10    INTEGER,
  unique index index1 on G1000_key,
  index index2 on G1000_100,
  index index3 on G1000_name
);
failure

-- create a table with an index
create table rapidsse.public.G1000 (
  G1000_key   INTEGER ,
  G1000_name  VARCHAR(32),
  G1000_100   INTEGER,
  G1000_10    INTEGER,
  index index1 on G1000_key,
  index index2 on G1000_100,
  index index3 on G1000_name
);
success

-- check existence of table
select * from rapids.system.tables where catalog_name = 'rapidsse';
rows: 1
//CHECK_RESULT
/*
('rapidsse', 'public', 'G1000', true)
*/

-- check existence of index
/*
select * from rapids.system.indexes;
rows:
('rapidsse', 'public', 'G1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'G1000_KEY')
('rapidsse', 'public', 'G1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'G1000_100')
('rapidsse', 'public', 'G1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'G1000_NAME')
*/

-- insert data into rapidsse.public.G1000
insert into rapidsse.public.G1000 values(0,'zero',0,0);
success

insert into rapidsse.public.G1000 values(1,'one',1,1);
success;

insert into rapidsse.public.G1000 values(2,'two',2,2);
success

insert into rapidsse.public.G1000 values(3,'three',3,3);
success

-- create another table with an index
create table rapidsse.public.R1000 (
  R1000_key   INTEGER,
  R1000_name  VARCHAR(32),
  R1000_100   INTEGER,
  R1000_10    INTEGER,
  index index1 on R1000_key,
  index index2 on R1000_100,
  index index3 on R1000_name
);
success

-- check existence of table
select * from rapids.system.tables where catalog_name = 'rapidsse';
rows: 2
//CHECK_RESULT
/*
('rapidsse', 'public', 'G1000', true)
('rapidsse', 'public', 'R1000', true)
 */

-- check existence of index
/*
select * from rapids.system.indexes;
rows:
('rapidsse', 'public', 'G1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'G1000_KEY')
('rapidsse', 'public', 'G1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'G1000_100')
('rapidsse', 'public', 'G1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'G1000_NAME')
('rapidsse', 'public', 'R1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'R1000_KEY')
('rapidsse', 'public', 'R1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'R1000_100')
('rapidsse', 'public', 'R1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'R1000_NAME')
*/

-- insert-select
insert into rapidsse.public.R1000 select * from rapidsse.public.G1000;
success

-- check data
select count(*) from rapidsse.public.R1000;
rows:
(4)

drop table rapidsse.public.G1000;
success

drop table rapidsse.public.R1000;
success

CLEANUP {
  drop table rapidsse.public.G1000;
  mute
  
  drop table rapidsse.public.R1000;
  mute
}


