--------------------------------------------------------------------------------
-- insert-select index tests
--------------------------------------------------------------------------------

-- refresh metadata
refresh;
success

-- create a table with a unique index
create table T1000 (
  T1000_key   INTEGER ,
  T1000_name  VARCHAR(32),
  T1000_100   INTEGER,
  T1000_10    INTEGER,
  unique index index1 on T1000_key,
  index index2 on T1000_100,
  index index3 on T1000_name
);
failure

-- create a table with an index
create table T1000 (
  T1000_key   INTEGER ,
  T1000_name  VARCHAR(32),
  T1000_100   INTEGER,
  T1000_10    INTEGER,
  index index1 on T1000_key,
  index index2 on T1000_100,
  index index3 on T1000_name
);
success

-- check existence of table
select * from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
('RAPIDSSE', 'PUBLIC', 'T1000', true)

-- check existence of index
select * from rapids.system.indexes;
rows:
('RAPIDSSE', 'PUBLIC', 'T1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'T1000_KEY')
('RAPIDSSE', 'PUBLIC', 'T1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'T1000_100')
('RAPIDSSE', 'PUBLIC', 'T1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'T1000_NAME')


-- insert data into T1000
insert into T1000 values(0,'zero',0,0);
success

insert into T1000 values(1,'one',1,1);
success;

insert into T1000 values(2,'two',2,2);
success

insert into T1000 values(3,'three',3,3);
success

-- create another table with an index
create table R1000 (
  R1000_key   INTEGER,
  R1000_name  VARCHAR(32),
  R1000_100   INTEGER,
  R1000_10    INTEGER,
  index index1 on R1000_key,
  index index2 on R1000_100,
  index index3 on R1000_name
);
success

-- check existence of table
select * from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
('RAPIDSSE', 'PUBLIC', 'T1000', true)
('RAPIDSSE', 'PUBLIC', 'R1000', true)

-- check existence of index
select * from rapids.system.indexes;
rows:
('RAPIDSSE', 'PUBLIC', 'T1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'T1000_KEY')
('RAPIDSSE', 'PUBLIC', 'T1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'T1000_100')
('RAPIDSSE', 'PUBLIC', 'T1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'T1000_NAME')
('RAPIDSSE', 'PUBLIC', 'R1000', 'INDEX1', false,  false, 'SKIPLIST', 1, 'R1000_KEY')
('RAPIDSSE', 'PUBLIC', 'R1000', 'INDEX2', false, false, 'SKIPLIST', 1, 'R1000_100')
('RAPIDSSE', 'PUBLIC', 'R1000', 'INDEX3', false, false, 'SKIPLIST', 1, 'R1000_NAME')

-- insert-select
insert into R1000 select * from T1000;
success

-- check data
select count(*) from R1000;
rows:
(4)

drop table T1000;
success

drop table R1000;
success

CLEANUP {
  drop table T1000;
  mute
  drop table R1000;
  mute
}


