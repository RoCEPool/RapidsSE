/*----------------------------------------------------------------------------*/
/* create partition key tests                                                 */
/*----------------------------------------------------------------------------*/

// create a table
create table boolTable (
  key1   BOOLEAN NOT NULL,
  value INTEGER,
  name  VARCHAR(32) NOT NULL
) partition by (key1);
success

// check columns of partition key
lspartcol boolTable;
rows:
  ('key1')

// create an index
create index idx1 on boolTable (key1);
success;

// load data into the table
ld boolTable "../Seth/tests/partitionKey/bool.csv";
success

// analyze table
antbl boolTable;
rows:
 (*,*,0)
 (*,*,5)
 (*,*,0)
 (*,*,5)

// drop the table
drop table boolTable;
success

CLEANUP {
  drop table boolTable;
  mute

  bye;
  mute
}

