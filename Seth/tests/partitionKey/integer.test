--------------------------------------------------------------------------------
-- create partition key tests
--------------------------------------------------------------------------------

// create a table
create table dataTable (
  key     INTEGER NOT NULL,
  name    VARCHAR(32) NOT NULL,
  value1  INTEGER,
  value2  INTEGER
) partition by (key);
success

// check columns of partition key
lspartcol dataTable;
rows:
  ('key')

// load data into the table
ld dataTable "/DATA/partitionKey/data.csv";
success

// select rows from the table
fetch dataTable;
rows:
1000

// drop the table
drop table dataTable;
success

CLEANUP {

  drop table dataTable;
  mute

  bye;
  mute
}

