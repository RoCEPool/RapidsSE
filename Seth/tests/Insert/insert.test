/*----------------------------------------------------------------------------*/
/* insert.test -- insert tests                                                */
/*----------------------------------------------------------------------------*/

// (1) create a table
create table T1 (
  col0   integer not null,
  col1   varchar(32) not null
);
success

// (2) create an index on the table
create index idx on T1 (col0);
success

// check existence of index
lsidx T1;
rows:
  ('idx', false, false)

// check columns of index
lsidxcol T1 idx;
rows:
  ('col0', 'INTEGER', 19, 0, false, true)

// (3) now oldLoad some data into the table
oldLoad T1 "../Seth/tests/Insert/insert.csv" ;
success

// check no of rows
tableScan T1;
rows: 12

// (4) insert some rows into the table

begin insert T1;
success

insert row "1,abcdef";
success

insert row "2,ghijk";
success

insert row "3,lmno";
success

insert row "4,pqr";
success

insert row "5,stuvw";
success

insert row "6,xyz";
success

insert row "7,abc";
success

insert row "8,defgh";
success

insert row "9,ijk";
success

insert row "10,lmn";
success

end insert;
success

// check no of rows
tableScan T1;
rows: 22

insert row "21,null";
failure: 'no such table'

// (5) insert some invalid row
begin insert T1;
success

insert row "21,null";
failure: 'invalid value'

insert row "22,ghijk";
success

end insert;
success

// check no of rows
tableScan T1;
rows: 23

CLEANUP {

  drop table T1;
  mute

  bye;
  mute
}

