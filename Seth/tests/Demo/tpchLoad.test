--------------------------------------------------------------------------------
-- tpch load
--------------------------------------------------------------------------------

//------------------------------------------------------------------------------
// load customer
fload customer "/TPCH/SF1/customer.tbl";

compactidx customer customer_idx1;
success

//------------------------------------------------------------------------------
// load orders
fload orders "/TPCH/SF1/orders.tbl";
success

compactIdx Orders Orders_Idx1;
success

//------------------------------------------------------------------------------
// load lineitem
fload lineitem "/TPCH/SF1/lineitem.tbl";
success

compactIdx LineItem lineItem_Idx1;
success

compactIdx LineItem lineItem_Idx2;
success

} -- end of loop

CLEANUP {

  drop table customer;
  mute
  
  drop table orders;
  mute
  
  drop table lineitem;
  mute
  
  bye;
  mute
}

