--------------------------------------------------------------------------------
-- tpch load
--------------------------------------------------------------------------------

//------------------------------------------------------------------------------
// load customer
dfload customer "/TPCH/SF1/customer.tbl";

compactidx customer customer_idx1;
success

count;
failure contains: "invalid command"

count x;
failure contains: "no such table"

count customer;
rows:
 (150000)

//------------------------------------------------------------------------------
// load orders
dfload orders "/TPCH/SF1/orders.tbl";
success

compactIdx Orders Orders_Idx1;
success

count orders;
rows:
  (1500000)

//------------------------------------------------------------------------------
// load lineitem
dfload lineitem "/TPCH/SF1/lineitem.tbl";
success

compactIdx LineItem lineItem_Idx1;
success

compactIdx LineItem lineItem_Idx2;
success

count lineitem;
rows:
  (6001215)

} -- end of loop

CLEANUP {

  drop table customer;
  mute
  
  drop table orders;
  mute
  
  drop table lineitem;
  mute
  
  bye;
  mute
}

