//------------------------------------------------------------------------------
// compactidx
compactIdx LineItem lineItem_Idx1;
success

//------------------------------------------------------------------------------
// run query
demo select
sum(l_extendedprice*l_discount) as revenue
from
lineitem
where
l_shipdate >= "1994-01-01"
and l_shipdate < "1995-01-01"
and l_discount >= 0.05
and l_discount <= 0.07
and l_quantity < 24;

