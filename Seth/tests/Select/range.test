/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

// (1) create table t1
create table jCdt (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

create index jCdt_idx1 on jCdt (jA);
success

create index jCdt_idx2 on jCdt (jA,jB);
success

create index jCdt_idx3 on jCdt (jA,jB,jC);
success

create index jCdt_idx4 on jCdt (jA,jB,jC,jD);
success

create index jCdt_idx5 on jCdt (jE);
success

oldLoad jCdt "../DATA/Select/range.csv";
success

//------------------------------------------------------------------------------
// SCAN
tableScan jCdt;
rows: 16

// this will be a scan because no index with leading col is jB
predicateFetch jCdt "jB 24 =";
rows: 16

