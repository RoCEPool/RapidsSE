/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

// (1) create table t1
create table T1 (
  jA  INTEGER NOT NULL,
  jB  INTEGER NOT NULL,
  jC  VARCHAR(10) NOT NULL,
  jD  VARCHAR(10) NOT NULL
);
success

create index T1_idx1 on T1 (jA, jC);
success

oldLoad T1 "../DATA/Select/rangeCombo.csv";
success

tableScan T1;
rows: 5

predicateFetch T1 "jA 2 <=" ;
rows: 2

predicateFetch T1 "jC 2 <=" ;
rows: 5

predicateFetch T1 "jA 4 >= jC ddd >= and";
rows:
  (4,14,'ddd',' mood')
  (5,15,'eee',' boat')

predicateFetch T1 "jA 4 == jC ddd == and";
rows:
  (4,14,'ddd',' mood')

CLEANUP {

  drop table T1;
  mute

  bye;
  mute
}
