//Loop 50 {
// (1) create table jCdt
create table jCdt (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

create index jCdt_idx1 on jCdt (jA);
success

//create index jCdt_idx2 on jCdt (jB);
//success

//create index jCdt_idx3 on jCdt (jC);
//success

//create index jCdt_idx4 on jCdt (jD);
//success

oldLoad jCdt "../DATA/Select/range2.csv";
success

vfyidx jCdt jCdt_idx1;
rows:
  ('NODE0','jCdt','jCdt_idx1','Valid')

//------------------------------------------------------------------------------
// SCAN
tableScan jCdt;
rows: 26

//dumpidx jCdt jCdt_idx1;
//success

//------------------------------------------------------------------------------
// EXACT KEYS for index on jA

predicateFetch jCdt "jA 19 ==" ;
rows: 1

predicateFetch jCdt "jA 18 ==" ;
rows:
  (18,18,*,*,*)

predicateFetch jCdt "jA 17 ==";
rows:
  (17,*,*,*,*)

predicateFetch jCdt "jA -9223372036854775806 ==";
rows:
  (-9223372036854775806,*,*,*,*)

predicateFetch jCdt "jA 9223372036854775806 ==";
rows:
  (9223372036854775806,*,*,*,*)

predicateFetch jCdt "jA 16 ==";
rows:
  (16,*,*,*,*)

predicateFetch jCdt "jA 15 ==";
rows:
  (15,*,*,*,*)

predicateFetch jCdt "jA 14 ==";
rows:
  (14,*,*,*,*)

predicateFetch jCdt "jA 13 ==";
rows:
  (13,*,*,*,*)

predicateFetch jCdt "jA 12 ==";
rows:
  (12,*,*,*,*)

predicateFetch jCdt "jA 11 ==";
rows:
  (11,*,*,*,'bb1')

predicateFetch jCdt "jA 10 ==";
rows:
  (10,*,*,*,*)

drop table jCdt;
success
//}
CLEANUP {

  drop table jCdt;
  mute

  bye;
  mute
}

