/*----------------------------------------------------------------------------*/
/* range query tests                                                          */
/*----------------------------------------------------------------------------*/

indexEntries 5;
success

// (1) create table jCdt
create table jCdt (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

create index jCdt_idx1 on jCdt (jA);
success

//create index jCdt_idx2 on jCdt (jB);
//success

//create index jCdt_idx3 on jCdt (jC);
//success

//create index jCdt_idx4 on jCdt (jD);
//success

ld jCdt "/DATA/Select/range2.csv";
success

vfyidx jCdt jCdt_idx1;
success

//------------------------------------------------------------------------------
// SCAN
fetch jCdt;
rows: 26
//dumpidx jCdt jCdt_idx1;
//success

//------------------------------------------------------------------------------
// EXACT KEYS for index on jA

fetch jCdt "jA 19 > jA 22 == and" ;
rows: 1

fetch jCdt "jA 19 >= jA 22 == and" ;
rows: 1

fetch jCdt "jA 10 > jA 19 < and" ;
rows: 8

fetch jCdt "jA 10 > jA 19 <= and" ;
rows: 9

fetch jCdt "jA 10 >= jA 19 < and" ;
rows: 9

fetch jCdt "jA 10 >= jA 19 <= and" ;
rows: 10

fetch jCdt "jA 1 > jA 10 <= and" ;
rows: 9

fetch jCdt "jA 1 >= jA 10 <= and" ;
rows: 10

fetch jCdt "jA -9223372036854775807 > jA 0 < and";
rows: 0

fetch jCdt "jA -9223372036854775807 > jA 1 <= and";
rows: 1

drop table jCdt;
success

CLEANUP {

  drop table jCdt;
  mute

  bye;
  mute
}

