/*----------------------------------------------------------------------------*/
/* decimal.test -- DECIMAL DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table fltTbl (
  flt_col1  FLOAT       NOT NULL,
  vch_col1  VARCHAR(32) NOT NULL,
  int_col3  INTEGER     NOT NULL,
  int_col4  INTEGER     NOT NULL,
  ivl_col5  DECIMAL(10,2) NOT NULL,
  flt_col6  FLOAT
);

// create indexes
create index flt_idx1 on fltTbl (flt_col1);
success

create index flt_idx2 on fltTbl (flt_col6);
success

// check existence of index
lsidx fltTbl;
rows:
('flt_idx1', false, false)
('flt_idx2', false, false)

// check columns of index
lsidxcol fltTbl flt_idx1;
rows:
('flt_col1', 'FLOAT', 19, 0, false, true)

// check columns of index
lsidxcol fltTbl flt_idx2;
rows:
('flt_col6', 'FLOAT', 19, 0, true, false)

load fltTbl "../DATA/Datums/float.csv" ;
failure contains: '15 invalid'

// check no of rows
tableScan fltTbl;
rows: 101

// dump index flt_idx1
dumpidx fltTbl flt_idx1;

// dump index flt_idx2
dumpidx fltTbl flt_idx2;

// fetch
predicateFetch fltTbl "flt_col1 1011.011 =";
rows:
  (1011.01e0,'oneone',111,1,11.01,null)

// drop the table
drop table fltTbl;
success

// check existence of table
lstbl;
rows: 0

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table fltTbl;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
