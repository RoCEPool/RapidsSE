/*----------------------------------------------------------------------------*/
/* integer.test -- INTEGER DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// (1) create a table
create table IntTbl (
  int_col1  INTEGER NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  vch_col3  VARCHAR(32) NOT NULL,
  int_col4  INTEGER
);
success

// create indexes
create index int_idx1 on IntTbl (int_col1);
success

create index int_idx2 on IntTbl (int_col4);
success

// check existence of index
lsidx IntTbl;
rows:
  ('int_idx1', false, false)
  ('int_idx2', false, false)

// check columns of index
lsidxcol IntTbl int_idx1;
rows:
  ('int_col1', 'INTEGER')

// check columns of index
lsidxcol IntTbl int_idx2;
rows:
  ('int_col4', 'INTEGER')

ld IntTbl "../Seth/tests/Datums/integer.csv" ;
success

// check no of rows
fetch IntTbl;
affected: 101

// dump index int_idx1
dumpidx IntTbl int_idx1;
success

// dump index int_idx2
dumpidx IntTbl int_idx2;
success

// drop the table
drop table IntTbl;
success

// check existence of table
lstbl;
rows: 0

CLEANUP {
  
  // drop the table
  drop table IntTbl;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
