/*============================================================================*/
/* _testTSP -- test for timestamp                                             */
/*============================================================================*/

create table jidxTsp (
  jidx_key   INTEGER     NOT NULL,
  jidx_name  VARCHAR(32) NOT NULL,
  jidx_100   INTEGER     NOT NULL,
  jidx_10    INTEGER     NOT NULL,
  jidx_ivl   INTERVAL    NOT NULL,
  jidx_flt   FLOAT       NOT NULL,
  jidx_tsp   TIMESTAMP   NOT NULL
);

create index idx_tsp on jidxTsp (jidx_tsp);
//create index idx_flt on jidxTsp (jidx_flt);
//create index idx_ivl on jidxTsp (jidx_ivl);
//create index idx1 on jidxTsp (jidx_key);
//create index idx2 on jidxTsp (jidx_100);
//create index idx3 on jidxTsp (jidx_name);

ld jidxTsp "../JTEST/jidxTsp.csv" ;

//anidx jidxTsp idx_tsp ;
dumpidx jidxTsp idx_tsp ;

fetch jidxTsp "jidx_tsp '1989-01-01 00:00:00' >=";

