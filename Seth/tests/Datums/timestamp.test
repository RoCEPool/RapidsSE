/*============================================================================*/
/* timestamp.test -- TIMESTAMP DATUM tests                                    */
/*============================================================================*/

// begin tracking memory
trackMemory;
success

create table tspTbl (
  tsp_col1   TIMESTAMP   NOT NULL,
  vch_col2   VARCHAR(32) NOT NULL,
  int_col3   INTEGER     NOT NULL,
  int_col4   INTEGER     NOT NULL,
  ivl_col5   DECIMAL(10,2) NOT NULL,
  flt_col6   FLOAT       NOT NULL,
  tsp_col7   TIMESTAMP
);
success

// create index tsp_idx1
create index tsp_idx1 on tspTbl (tsp_col1);
success

// create index tsp_idx2
create index tsp_idx2 on tspTbl (tsp_col7);
success

// check existence of index
lsidx tspTbl;
rows:
('tsp_idx1', false, false)
('tsp_idx2', false, false)

// check columns of index
lsidxcol tspTbl tsp_idx1;
rows:
('tsp_col1', 'TIMESTAMP', 0, 0, false, true)

// check columns of index
lsidxcol tspTbl tsp_idx2;
rows:
('tsp_col7', 'TIMESTAMP', 0, 0, true, false)

load tspTbl "../DATA/Datums/timestamp.csv" ;
failure contains: '27 invalid'

// check no of rows
tableScan tspTbl;
rows: 101

// dump index tsp_idx1
dumpidx tspTbl tsp_idx1;
success

// dump index tsp_idx2
dumpidx tspTbl tsp_idx2;
success

// fetch
//
//rows:
//  ('1904-01-01 00:00:00',four,104,4,4.004,1004.004,null)

// drop the table
drop table tspTbl;
success

// check existence of table
//lstbl;
//rows: 0

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table tspTbl;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/

