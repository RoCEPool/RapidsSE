/*----------------------------------------------------------------------------*/
/* varchar.test -- VARCHAR DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// (1) create a table
create table VchTbl (
  int_col1  INTEGER NOT NULL,
  vch_col2  VARCHAR(10)  NOT NULL,
  vch_col3  VARCHAR(32)  NOT NULL,
  int_col4  INTEGER NOT NULL,
  vch_col5  VARCHAR
);
success

// create index on vch_col2
create index vch_idx1 on VchTbl (vch_col2);
affected: 0

// create index on vch_col3
create index vch_idx2 on VchTbl (vch_col3);
affected: 0

// create index on vch_col5
create index vch_idx3 on VchTbl (vch_col5);
affected: 0

// check existence of index
lsidx VchTbl;
rows:
  ('vch_idx1', false, false)
  ('vch_idx2', false, false)
  ('vch_idx3', false, false)

// check columns of index
lsidxcol VchTbl vch_idx1;
rows:
  ('vch_col2', 'VARCHAR', 10, 0, false, false)

// check columns of index
lsidxcol VchTbl vch_idx2;
rows:
  ('vch_col3', 'VARCHAR', 32, 0, false, false)

// check columns of index
lsidxcol VchTbl vch_idx3;
rows:
  ('vch_col5', 'VARCHAR', 64000, 0, true, false)

ld VchTbl "/DATA/Datums/varchar.csv" enclosed_by_leading "'";
failure contains: '2 invalid'

// check no of rows
fetch VchTbl;
rows: 101

// dump index vch_idx1
dumpidx vchTbl vch_idx1;
success

// dump index vch_idx2
dumpidx vchTbl vch_idx2;
success

// dump index vch_idx3
dumpidx vchTbl vch_idx3;
success

// fetch
fetch vchTbl "vch_col2 'nine' =";
rows:
  (9,'nine','109',9,null)

fetch vchTbl "vch_col2 'one zero' =";
rows:
  (10,'one zero','110',0,null)

fetch vchTbl "vch_col5 'abc' =";
rows:
(16,'abcdefghij',116,6,'abc')

// drop the table
drop table VchTbl;
success

// check existence of table
lstbl;
rows: 0

CLEANUP {
  
  // drop the table
  drop table VchTbl;
  mute

  bye;
  mute
}

