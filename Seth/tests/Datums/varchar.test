/*----------------------------------------------------------------------------*/
/* varchar.test -- VARCHAR DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// (1) create an index (syntax error)
create table VchT (
  vch_key     INTEGER NOT NULL,
  vch_name    VARCHAR(10)  NOT NULL,
  vch_100     VARCHAR(32),
  vch_10      INTEGER NOT NULL,
  vch_address VARCHAR NOT NULL
);
success

// create index
create index idx1 on VchT (vch_100);
affected: 0

create index idx2 on VchT (vch_name);
affected: 0

create index idx3 on VchT (vch_address);
affected: 0

// check existence of index
lsidx VchT;
rows:
  ('idx1', false, false)
  ('idx2', false, false)
  ('idx3', false, false)

// check columns of index
lsidxcol VchT Idx1;
rows:
  ('vch_100', 'VARCHAR')

ld VchT "../Seth/tests/Datums/vch.csv" ;
success

// check no of rows
fetch VchT;
affected: 100

// drop the table
drop table VchT;
success

// check existence of table
lstbl;
rows: 0


CLEANUP {
  
  // drop the table
  drop table VchT;
  mute

  bye;
  mute
}

