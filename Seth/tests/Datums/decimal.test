/*----------------------------------------------------------------------------*/
/* decimal.test -- DECIMAL DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table decTbl (
  dec_col1  DECIMAL(10,3) NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  int_col3  INTEGER     NOT NULL,
  int_col4  INTEGER     NOT NULL,
  ivl_col5  DECIMAL(10,2) NOT NULL,
  dec_col6  DECIMAL,
  tsp_col7  TIMESTAMP   NOT NULL,
  bol_col8  BOOLEAN     NOT NULL
);
success

// create indexes
create index dec_idx1 on decTbl (dec_col1);
success

create index dec_idx2 on decTbl (dec_col6);
success

// check existence of index
lsidx decTbl;
rows:
('dec_idx1', false, false)
('dec_idx2', false, false)

// check columns of index
lsidxcol decTbl dec_idx1;
rows:
('dec_col1', 'DECIMAL', 10, 3, false, true)

// check columns of index
lsidxcol decTbl dec_idx2;
rows:
('dec_col6', 'DECIMAL',19, 0, true, false)

load decTbl "../DATA/Datums/decimal.csv" ;
failure contains: '15 invalid'

// check no of rows
tableScan decTbl;
rows: 101

// dump dec_idx1
dumpidx decTbl dec_idx1;
success

// dump dec_idx2
dumpidx decTbl dec_idx2;
success

// drop the table
drop table decTbl;
success

// check existence of table
lstbl;
rows: 0

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  // drop the table
  drop table decTbl;
  mute

  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
