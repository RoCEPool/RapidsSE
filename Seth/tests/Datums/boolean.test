/*----------------------------------------------------------------------------*/
/* boolean.test -- BOOLEAN DATUM tests                                        */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table bolTbl (
  bol_col1   BOOLEAN     NOT NULL,
  vch_col2   VARCHAR(32) NOT NULL,
  int_col3   INTEGER     NOT NULL,
  int_col4   INTEGER     NOT NULL,
  dec_col5   DECIMAL(10,2) NOT NULL,
  flt_col6   FLOAT       NOT NULL,
  tsp_col7   TIMESTAMP   NOT NULL,
  bol_col8   BOOLEAN
);
success

// create indexes
create index bol_idx1 on bolTbl (bol_col1);
success

// create indexes
create index bol_idx2 on bolTbl (bol_col8);
success

// check existence of index
lsidx bolTbl;
rows:
  ('bol_idx1', false, false)
  ('bol_idx2', false, false)

// check columns of index
lsidxcol bolTbl bol_idx1;
rows:
  ('bol_col1', 'BOOLEAN', 0, 0, false, true)

// check columns of index
lsidxcol bolTbl bol_idx2;
rows:
  ('bol_col8', 'BOOLEAN', 0, 0, true, false)

oldLoad bolTbl "../DATA/Datums/boolean.csv" ;
failure contains: '19 invalid'

// check no of rows
tableScan bolTbl;
rows: 101

// dump index bol_idx1
dumpidx bolTbl bol_idx1;

// dump index bol_idx2
dumpidx bolTbl bol_idx2;

// drop the table
drop table bolTbl;
success

// check existence of table
lstbl;
rows: 0

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table bolTbl;
  mute
  
  bye;
  mute
}

