/*----------------------------------------------------------------------------*/
/* concurrency.test -- concurrency test                                       */
/*----------------------------------------------------------------------------*/

IndexEntries 100;

// create Upsert child threads
CREATE 1 THREADS {

  LOG 'STARING UPSERT THREAD.';
  
  // Child threads wait for table and index to be created by main thread.
  SYNCHRONIZE;
  
  lstbl;
  rows: 
    ('__READAPI_T')
    ('T')


LOOP 6 {
  LOG 'UPSERTING';

  // execute the upsert pipeline
  pipeline t_upsert
  begin

    stage stageA on origin:
      start | periodic once | stageB

    stage stageB on all partitions:
      genCsv T | toCrw T | upsertOp T | stageC

    stage stageC on origin:
      output | sink | stageA

  end;
  success
  
  LOG 'DONE UPSERTING';
}

LOG 'UPSERTS DONE.............';
  // Synchronizing here tells the main thread that we are done verifying the table.
  SYNCHRONIZE;

LOG 'UPSERT THREAD EXITING.............';
  -- Child threads exit here.
}

// create Purger child threads

CREATE 1 THREADS {
  
  LOG 'STARING PURGER THREAD.';
  
  // Child threads wait for table and index to be created by main thread.
  SYNCHRONIZE;
  
  lstbl;
  rows:
  ('__READAPI_T')
  ('T')
  
  Loop 20 {
    
    LOG 'PURGING';
    
    // execute the purge pipeline
    pipeline t_purge
    begin
    
      stage stageA on origin:
        start | periodic once | stageB
      
      stage stageB on all partitions:
        purge T | stageC
      
      stage stageC on origin:
        output | sink | stageA
    
    end;
    success
    
    LOG 'DONE PURGING';
    
    SLEEP 1000;
  }
  
  LOG 'PURGES DONE.............';
  
  // Synchronizing here tells the main thread that we are done with the table.
  SYNCHRONIZE;
  
  LOG 'PURGER THREAD EXITING.............';
  
  -- Child threads exit here.
}

// The main thread keeps running commands from here after creating the child threads..

// create table __READAPI_T
create table __READAPI_T
(
ref INTEGER NOT NULL,
psp INTEGER NOT NULL
)
;
success

create index __READAPI_I on __READAPI_T (ref,psp);
success

// craete table T
create table T
(
colA DECIMAL   NOT NULL min 0              max 250,
colB BOOLEAN   NOT NULL min false          max true,
colC DATE      NOT NULL min "2019-01-01"   max "2019-12-31",
colD FLOAT     NOT NULL min "1.0"          max "1000.0",
colE INTEGER   NOT NULL min 1              max 1000,
//colF INTERVAL  NOT NULL min "0.0"          max "100.0",
colG TIME      NOT NULL min "00:00:00.000" max "23:59:59.999",
//  colH TIMESTAMP NOT NULL min "2019-01-01 00:00:00.000"
//                          max "2019-12-31 23:59:59.999",
colI VARCHAR   NOT NULL min "a"            max "zzzzzzzzz"
)
rowsize 256
;
success

create index T_Idx_1 on T (colE);
success

// Unblocks child threads who can now work with the tables and indexes
SYNCHRONIZE;

LOOP 10 {
  LOG 'TAKING SNAPSHOT';

  // execute the snapshot pipeline

  pipeline t_snapshot
  begin

    stage stageA on origin:
      start | periodic once | stageB

    stage stageB on all partitions:
      snapshot T | stageC

    stage stageC on origin:
      output | sink | stageA

  end;
  success

  LOG 'DONE SNAPSHOT';
  SLEEP 1000;
}

LOG 'SNAPSHOTS DONE.............';

// Main thread waits until child threads indicate that they are done with the table.
SYNCHRONIZE;

LOG 'ONE LAST PURGE...';
pipeline t_purge
begin

  stage stageA on origin:
  start | periodic once | stageB

  stage stageB on all partitions:
  purge T | stageC

  stage stageC on origin:
  output | sink | stageA

end;
success

LOG 'LAST PURGE DONE...';

LOG 'DELETING TABLES.............';

drop table __READAPI_T;
success

drop table T;
success

CLEANUP {
  drop table __READAPI_T;
  mute
  
  drop table T;
  mute
}
