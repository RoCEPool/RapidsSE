/*----------------------------------------------------------------------------*/
/* create index tests                                                         */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create an index (syntax error)
create index on T1 (key);
failure contains: 'invalid command'

// (2) create an index (syntax error)
create index idx T1 (key);
failure contains: 'invalid command'

// (3) create an index (syntax error)
create index idx on (key);
failure contains: 'invalid command'

// (4) create an index (syntax error)
//create idx on T1 (key);
//failure contains: 'invalid command'

//! ALKA : come back to next few tests
//! should be invalid command
// (5) create an index (syntax error)
create index idx on T1;
failure contains: 'no such table'

// (6) create an index (syntax error)
create index idx on T1(;
failure contains: 'no such table'

// (7) create an index (syntax error)
create index idx on T1();
failure contains: 'no such table'

// (8) create an index (syntax error)
create index idx on T1(key) junk;
failure contains: 'no such table'

// create a table
create table T1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

// create an index
create index Idx on T1 (key);
affected: 0

// check idx with incorrect params
lsidx;
failure contains: 'invalid command'
                       
// check idx with incorrect params
lsidx T1 T2;
failure contains: 'invalid command'

// check idx with incorrect params
lsidx T2 T1;
failure contains: 'invalid command'
                       
// check idx of invalid table
lsidx T2;
failure contains: 'no such table'

// check lidx when not in tables
cf ~;
success

lsidx T1;
failure contains: 'not in tables'

cf "~tables";
success

// check existence of index
lsidx T1;
rows:
  ('Idx', false, false)

// check columns of invalid table
lsidxcol T2 Idx;
failure contains: 'no such table'

// check columns of invalid index
lsidxcol T1 Idx2;
failure contains: 'no such index'

// check columns of index when not in tables
cf ~;
success

lsidxcol T1 Idx1;
failure contains: 'not in tables'

cf "~tables";
success

// check columns of index
lsidxcol T1 Idx;
rows:
  ('key', 'INTEGER', 19, 0, false, true)

// drop the index
drop index T1 Idx;
success

// check existence of index
lsidx T1;
rows: 0

// create index where table does not exist
create index Idx on noTable (key);
failure contains: 'no such table'

pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// check existence of index
lsidx T1;
rows: 0

// create index where key does not exist
create index Idx on T1 (noKey);
failure contains: 'invalid index column'

pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// check existence of index
lsidx T1;
rows: 0

// create index once
create index Idx1 on T1 (key);
affected: 0

// create same index again
create index Idx1 on T1 (key);
failure contains: 'index exists'

// check existence of index
lsidx T1;
rows:
 ('Idx1', false, false)

// create another index with same column
create index Idx2 on T1 (key);
success

// check existence of index
lsidx T1;
rows:
 ('Idx1',false,false)
 ('Idx2',false,false)

// create index with two columns
create index Idx3 on T1 (key, name);
success

// check existence of index
lsidx T1;
rows: 3

// check columns of Idx3
lsidxcol T1 Idx3;
rows:
 ('key', 'INTEGER', 19, 0, false, true)
 ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx4 on T1 (key, name);
success

// check existence of index
lsidx T1;
rows:
 ('Idx1',false,false)
 ('Idx2',false,false)
 ('Idx3',false,false)
 ('Idx4',false,false)

// check columns of Idx4
lsidxcol T1 Idx4;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx5 on T1 (key, name);
success

// check existence of index
lsidx T1;
rows:
('Idx1',false,false)
('Idx2',false,false)
('Idx3',false,false)
('Idx4',false,false)
('Idx5',false,false)

// check columns of Idx5
lsidxcol T1 Idx5;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx6 on T1 (key, name);
success

// check existence of index
lsidx T1;
rows:
('Idx1',false,false)
('Idx2',false,false)
('Idx3',false,false)
('Idx4',false,false)
('Idx5',false,false)
('Idx6',false,false)

// check columns of Idx4
lsidxcol T1 Idx6;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx7 on T1 (key, name);
success

// check existence of index
lsidx T1;
rows:
('Idx1',false,false)
('Idx2',false,false)
('Idx3',false,false)
('Idx4',false,false)
('Idx5',false,false)
('Idx6',false,false)
('Idx7',false,false)

// check columns of Idx7
lsidxcol T1 Idx7;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx8 on T1 (key, name);
success

// check existence of index
lsidx T1;
rows:
('Idx1',false,false)
('Idx2',false,false)
('Idx3',false,false)
('Idx4',false,false)
('Idx5',false,false)
('Idx6',false,false)
('Idx7',false,false)
('Idx8',false,false)

// check columns of Idx8
lsidxcol T1 Idx8;
rows:
  ('key', 'INTEGER', 19, 0, false, true)
  ('name', 'VARCHAR', 32, 0, false, false)

// create another index with two columns
create index Idx9 on T1 (key, name);
success

drop table T1;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table T1;
  mute

  bye;
  mute
}

