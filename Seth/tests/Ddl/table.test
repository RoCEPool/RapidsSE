// (11) create table with two columns that have same name
create table T1 (
  c1   INTEGER NOT NULL, 
  c1   VARCHAR(32) NOT NULL
);
failure contains: 'duplicate column'

// (12) try create table t1 with no columns
create table T1 (
);
failure contains: 'invalid command'

// (13) try create table t1 with invalid table name
create table T1& (
  c1   INTEGER NOT NULL
);
failure contains: 'invalid command'

// (14) try create table t1 with invalid column name
create table T1 (
  c1&  INTEGER NOT NULL
);
failure contains: 'invalid command'

// (15) try create table t1 with invalid column type
create table T1 (
  c1  NOSUCHTYPE NOT NULL
);
failure contains: 'invalid command'

// (16) try create table t1 with invalid null
create table T1 (
                 c1  integer NOT NUKK
                 );
failure contains: 'invalid command'

///////////
// lscol //
///////////

// lscol on invalid table
lscol noTable;
failure contains: 'no such table'

// (17) create table t1
create table T1 (
   key   INTEGER NOT NULL,
   name  VARCHAR(32) NOT NULL
   );
success

// move to tenants
cf ~;
success

// lscol not in tables
lscol T1;
failure contains: 'not in tables'

// move to tables folder
cf "~tables";
success

// lscol
lscol T1;
rows:
  ('key','INTEGER',19,0,false,true)
  ('name','VARCHAR',32,0,false,false)

// () drop table t1
drop table T1 ;
success

///////////////
// lspartcol //
///////////////

// lspartcol on invalid table
lspartcol noTable;
failure contains: 'no such table'

// (17) create table t1
create table T1 (
   key   INTEGER NOT NULL,
   name  VARCHAR(32) NOT NULL
);
success

// move to tenants
cf ~;
success

// lspartcol not in tables
lspartcol T1;
failure contains: 'not in tables'

// move to tables folder
cf "~tables";
success

// lspartcol
lspartcol T1;
rows:
 ('key','INTEGER',19,0,false,true)

// () drop table t1
drop table T1 ;
success

// (17) create table t1
create table T1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
) partition by (name);
success

// lspartcol
lspartcol T1;
rows:
  ('name','VARCHAR',32,0,false,true)

// () drop table t1
drop table T1 ;
success

// (17) create table t1
create table T1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
) partition by (name, key);
success

// lspartcol
lspartcol T1;
rows:
  ('name','VARCHAR',32,0,false,true)
  ('key','INTEGER',19,0,false,true)

// () drop table t1
drop table T1 ;
success

////////////
// drop   //
////////////

// drop invalid table
drop table T1;
failure contains: 'no such table'

// create table t1
create table T1 (
  key   INTEGER NOT NULL,
  name  VARCHAR(32) NOT NULL
);
success

// move to tenants folder
cf ~;
success

// not in tables
drop table T;
failure contains: 'not in tables'

// move to tables
cf "~tables";
success

drop table T1;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  cf "~tables";
  mute
  
  drop table T1;
  mute
  
  bye;
  mute
}

