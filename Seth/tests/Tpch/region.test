// create a table
create table region (
R_REGIONKEY       INTEGER NOT NULL,
R_NAME            CHAR(25) NOT NULL,
R_COMMENT         VARCHAR(152)
);
success

-----------------------------------------------------------------------
// oldLoad the table
//oldLoad region "/TPCH/SF1/region.tbl" <field_delimiter> = "|";
fload region "/TPCH/SF1/region.tbl";
success

tableScan region;
rows: 5

CLEANUP {

  bye;
  mute
}

