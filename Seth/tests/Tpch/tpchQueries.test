// drop the orders table
drop table Orders;
success;

 // create a table
 create table orders (
    O_ORDERKEY        INTEGER NOT NULL,
    O_CUSTKEY         INTEGER NOT NULL,
    O_ORDERSTATUS     CHAR(1) NOT NULL,
    O_TOTALPRICE      DECIMAL(15,2) NOT NULL,
    O_ORDERDATE       TIMESTAMP NOT NULL,
    O_ORDERPRIORITY   CHAR(15) NOT NULL,
    O_CLERK           CHAR(15) NOT NULL,
    O_SHIPPRIORITY    INTEGER NOT NULL,
    O_COMMENT         VARCHAR(79) NOT NULL
    ) partition by (O_CUSTKEY)
 success
 
//------------------------------------------------------------------------------
// create an index on O_ORDERKEY
CREATE INDEX orders_idx1 ON orders(O_ORDERKEY);
affected: 0

CREATE INDEX Orders_Idx2 ON Orders(O_CUSTKEY);
affected: 0

// check orders of index
lsidx orders;
rows:
("orders_idx1",false,false)
("orders_idx2",false,false)

// check columns of index
lsidxcol orders orders_idx1;
rows:
("O_ORDERKEY", "INTEGER", 19, 0, false, false)

// check columns of index
lsidxcol orders orders_idx2;
rows:
("O_CUSTKEY", "INTEGER", 19, 0, false, false)

// load the table
//load orders "/TPCH/SF1/orders.tbl" <field_delimiter> = "|";
fload orders "/TPCH/SF1/orders.tbl";
success

tableScan orders;
rows: 1500000
 
// Query 3
select l_orderkey, sum(l_extendedprice*(1-l_discount)) as revenue,
o_orderdate, o_shippriority from CUSTOMER, ORDERS, LINEITEM where c_mktsegment = 'BUILDING' and
c_custkey = o_custkey and l_orderkey = o_orderkey and o_orderdate < date '1995-03-15' and
l_shipdate > date '1995-03-15' group by l_orderkey, o_orderdate, o_shippriority
order by revenue desc, o_orderdate ;
rows: 11620

CLEANUP {

