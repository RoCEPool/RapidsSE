--------------------------------------------------------------------------------
-- create lineitem table
--------------------------------------------------------------------------------

// create a table
create table lineitem (
  L_ORDERKEY      INTEGER NOT NULL,         //  0)  8B   3B
  L_PARTKEY       INTEGER NOT NULL,         //  1)  8B   3B
  L_SUPPKEY       INTEGER NOT NULL,         //  2)  8B   3B
  L_LINENUMBER    INTEGER NOT NULL,         //  3)  8B   3B
  L_QUANTITY      DECIMAL(15,2) NOT NULL,   //  4)  8B   3B
  L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,   //  5)  8B   3B
  L_DISCOUNT      DECIMAL(15,2) NOT NULL,   //  6)  8B   3B
  L_TAX           DECIMAL(15,2) NOT NULL,   //  7)  8B   3B
  L_RETURNFLAG    VARCHAR(1) NOT NULL,      //  8)  2B   2B
  L_LINESTATUS    VARCHAR(1) NOT NULL,      //  9)  2B   2B
  l_SHIPDATE      DATE NOT NULL,            // 10)  8B   8B
  L_COMMITDATE    DATE NOT NULL,            // 11)  8B   8B
  L_RECEIPTDATE   DATE NOT NULL,            // 12)  8B   8B
  L_SHIPINSTRUCT  VARCHAR(25) NOT NULL,     // 13) 26B  13B
  L_SHIPMODE      VARCHAR(10) NOT NULL,     // 14) 11B   5B
  L_COMMENT       VARCHAR(44) NOT NULL      // 15) 45B  23B
);
success


//------------------------------------------------------------------------------
// create an index on shipdate
CREATE INDEX lineitem_idx1 ON lineitem(L_SHIPDATE);
affected: 0

//------------------------------------------------------------------------------
// create an index on orderkey
CREATE INDEX lineitem_idx2 ON lineitem(L_ORDERKEY);
affected: 0

//------------------------------------------------------------------------------
// create an index on suppkey
CREATE INDEX lineitem_idx3 ON lineitem(L_SUPPKEY);
affected: 0

// check existence of index
lsidx lineitem;
rows:
  ("lineitem_idx1",false,false)
  ("lineitem_idx2",false,false)
  ("lineitem_idx3",false,false)

// check columns of index
lsidxcol lineitem lineitem_idx1;
rows:
  ("l_SHIPDATE", "DATE", 0, 0, false, false)

// check columns of index
lsidxcol lineitem lineitem_idx2;
rows:
  ("L_ORDERKEY", "INTEGER", 19, 0, false, true)

// check columns of index
lsidxcol lineitem lineitem_idx3;
rows:
  ("L_SUPPKEY", "INTEGER", 19, 0, false, false)

// load the table
//load lineitem "/TPCH/SF1/lineitem.tbl" <field_delimiter> = "|";
fload lineitem "/TPCH/SF1/lineitem.tbl";
success

