//----------------------------------------------------------------------------//
// create table with DECIMAL column tests
//----------------------------------------------------------------------------//

// create a table , no size in varchar
create table T1 (
  id      integer,
  value   decimal
);
success

// table should have gotten created
select table_name from rapids.system.tables where catalog_name = 'RAPIDSSE';
rows:
  ('T1')

// there should be no indexes on it
select * from rapids.system.indexes;
rows: 0

// check metadata
select data_type, is_partition_key, is_nullable, precision, scale from rapids.system.columns where
  table_name = 'T1' and column_name = 'VALUE';
rows:
  ('DECIMAL', false, true, 19, 0)

// check partition key is first column
select column_name from rapids.system.columns where table_name = 'T1' and is_partition_key = true;
rows:
  ('ID')

// insert rows in the table
insert into T1 values (10, 12.78);
success

insert into T1 values (20, 13.0);
success

insert into T1 values (30,16);
success

//max
insert into T1 values (40,+9223372036854775807);
success

// min
insert into T1 values (50,-9223372036854775807);
success

// null
insert into T1 (id) values (60);
success

// insert larger than max integer
insert into T1 values (60,9223372036854775808.34);
failure

// insert smaller than min integer
//insert into T1 values (60,-9223372036854775808.0);
//failure

// select from T1
select * from T1;
rows:
  (10,13)
  (20,13)
  (30,16)
  (40,9223372036854775807)
  (50,-9223372036854775807)
  (60,null)

// drop table
drop table T1;
success
