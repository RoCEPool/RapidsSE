/*----------------------------------------------------------------------------*/
/* L0 single buffer tests                                                     */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

IndexEntries 5;
success

// (1) create table Q1
create table Q1 (
  jA  INTEGER,
  jB  INTEGER,
  jC  INTEGER,
  jD  INTEGER,
  jE  VARCHAR(32)
);
success

create index idx on Q1 (jA);
success

oldLoad Q1 "../DATA/Queries/L0_SingleBuffer.csv";
success

dumpidx Q1 idx2;
failure contains: 'no such index'

dumpidx Q2 idx;
failure contains: 'no such table'

dumpidx Q1 idx;
success

vfyidx Q2 idx;
failure contains: 'no such table'

vfyidx Q1 idx2;
failure contains: 'no such index'

vfyidx Q1 idx;
rows:
('NODE0','Q1','idx','Valid')

//------------------------------------------------------------------------------
// SCAN
tableScan Q1;
rows: 5

//------------------------------------------------------------------------------
// EXACT KEYS for index on jA

predicateFetch Q1 "jA -2 ==" ;
rows:
  (-2,*,*,*,*)

predicateFetch Q1 "jA 1 ==" ;
rows:
  (1,*,*,*,*)

predicateFetch Q1 "jA 2 ==" ;
rows:
  (2,*,*,*,*)

predicateFetch Q1 "jA 3 ==";
rows:
  (3,*,*,*,*)

//------------------------------------------------------------------------------
// UPPER BOUND KEYS with < for index on jA

predicateFetch Q1 "jA -2 <" ;
rows:
 (null,*,*,*,*)

predicateFetch Q1 "jA 1 <" ;
rows:
(null,*,*,*,*)
 (-2,*,*,*,*)

predicateFetch Q1 "jA 2 <" ;
rows:
 (null,*,*,*,*)
(-2,*,*,*,*)
 (1,*,*,*,*)

predicateFetch Q1 "jA 3 <";
rows:
 (null,*,*,*,*)
 (-2,*,*,*,*)
 (1,*,*,*,*)
 (2,*,*,*,*)


//------------------------------------------------------------------------------
// UPPER BOUND KEYS with <= for index on jA

predicateFetch Q1 "jA -2 <=" ;
rows: 2

predicateFetch Q1 "jA 1 <=" ;
rows: 3

predicateFetch Q1 "jA 2 <=" ;
rows: 4

predicateFetch Q1 "jA 3 <=";
rows: 5


//------------------------------------------------------------------------------
// LOWER BOUND KEYS with > for index on jA

predicateFetch Q1 "jA -2 >" ;
rows: 3

predicateFetch Q1 "jA 1 >" ;
rows: 2

predicateFetch Q1 "jA 2 >" ;
rows: 1

predicateFetch Q1 "jA 3 >";
rows: 0


//------------------------------------------------------------------------------
// LOWER BOUND KEYS with >= for index on jA

predicateFetch Q1 "jA -2 >=";
rows: 4

predicateFetch Q1 "jA 1 >=" ;
rows: 3

predicateFetch Q1 "jA 2 >=" ;
rows: 2

predicateFetch Q1 "jA 3 >=";
rows: 1


//------------------------------------------------------------------------------
// RANGE for index on jA

predicateFetch Q1 "jA -2 > jA 3 < and";
rows: 2

predicateFetch Q1 "jA -2 > jA 3 <= and" ;
rows: 3

predicateFetch Q1 "jA 2 >= jA 1 < and" ;
rows: 0

drop table Q1;
success

indexEntries 0;
mute;

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {

  drop table Q1;
  mute

  indexEntries 0;
  mute;

  bye;
  mute
}

