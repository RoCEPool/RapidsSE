affected: 100000

fetch retrieve bolTbl bol_col6;
affected: 100000

fetch retrieve bolTbl bol_col7;
affected: 100000

fetch retrieve bolTbl bol_col8;
affected: 100000

fetch retrieve bolTbl bol_col9;
affected: 100000

fetch retrieve bolTbl bol_col10;
affected: 100000

fetch retrieve bolTbl bol_col11;
affected: 100000

fetch retrieve bolTbl bol_col12;
affected: 100000

fetch retrieve bolTbl bol_col13;
