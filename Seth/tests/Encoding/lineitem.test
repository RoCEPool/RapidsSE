/*----------------------------------------------------------------------------*/
/* boolean.test -- BOOLEAN ENCODING tests                                     */
/*----------------------------------------------------------------------------*/

// (1) create a table
create table lineitem (
L_ORDERKEY      INTEGER NOT NULL,         
L_PARTKEY       INTEGER NOT NULL,
L_SUPPKEY       INTEGER NOT NULL,
L_LINENUMBER    INTEGER NOT NULL,
L_QUANTITY      DECIMAL(15,2) NOT NULL,
L_EXTENDEDPRICE DECIMAL(15,2) NOT NULL,
L_DISCOUNT      DECIMAL(15,2) NOT NULL,
L_TAX           DECIMAL(15,2) NOT NULL,
L_RETURNFLAG    CHAR(1) NOT NULL,
L_LINESTATUS    CHAR(1) NOT NULL,
L_SHIPDATE      DATE NOT NULL,
L_COMMITDATE    DATE NOT NULL,
L_RECEIPTDATE   DATE NOT NULL,
L_SHIPINSTRUCT  CHAR(25) NOT NULL,
L_SHIPMODE      CHAR(10) NOT NULL,
L_COMMENT       VARCHAR(44) NOT NULL
);
success
  
time ld lineitem "/DATA/tpch/lineitem1K.csv";
success

// check no of rows
fetch lineitem;
rows: 1000

// dump table
//dumpTbl bolTbl;

fetch retrieve lineitem L_ORDERKEY;
affected: 1000

fetch retrieve lineitem L_PARTKEY;
affected: 1000

fetch retrieve lineitem L_SUPPKEY;
affected: 1000

fetch retrieve lineitem L_LINENUMBER;
affected: 1000

fetch retrieve lineitem L_QUANTITY;
affected: 1000

fetch retrieve lineitem L_EXTENDEDPRICE;
affected: 1000

fetch retrieve lineitem L_DISCOUNT;
affected: 1000

fetch retrieve lineitem L_TAX;
affected: 1000

fetch retrieve lineitem L_RETURNFLAG;
affected: 1000

fetch retrieve lineitem L_LINESTATUS;
affected: 1000

fetch retrieve lineitem L_SHIPDATE;
affected: 1000

fetch retrieve lineitem L_COMMITDATE;
affected: 1000

fetch retrieve lineitem L_RECEIPTDATE;
affected: 1000

fetch retrieve lineitem L_SHIPINSTRUCT;
affected: 1000

fetch retrieve lineitem L_SHIPMODE;
affected: 1000

fetch retrieve lineitem L_COMMENT;
affected: 1000

// drop the table
drop table lineitem;
success

CLEANUP {
  
  // drop the table
  drop table lineitem;
  mute
  
  bye;
  mute
}

