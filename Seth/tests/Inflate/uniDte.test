/*----------------------------------------------------------------------------*/
/* uniDte.test -- DATE DATUM tests                                            */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table uniDte (
  dte_col DATE NOT NULL
);
success

fload uniDte "../FASTLOAD/Data/uniDte.csv" ;
success

// check no of rows
tableScan uniDte;
rows: 24

// check data
tableScan uniDte;
rows:
  ('1961-01-01')
  ('1961-02-01')
  ('1961-03-01')
  ('1961-04-01')
  ('1961-05-01')
  ('1961-06-01')
  ('1961-07-01')
  ('1961-08-01')
  ('1961-09-01')
  ('1961-10-01')
  ('1961-11-01')
  ('1961-12-01')
  ('1971-01-31')
  ('1971-02-28')
  ('1971-03-31')
  ('1971-04-30')
  ('1971-05-31')
  ('1971-06-30')
  ('1971-07-31')
  ('1971-08-31')
  ('1971-09-30')
  ('1971-10-31')
  ('1971-11-30')
  ('1971-12-31')

// drop the table)
drop table uniDte;
success

// get memory leaks)
memoryLeaks;
rows: 0

CLEANUP {
  // drop the table)
  drop table uniDte;
  mute
  
  bye;
  mute
}

