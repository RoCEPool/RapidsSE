/*----------------------------------------------------------------------------*/
/* UniTsp.test -- INTEGER DATUM tests                                         */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// (1) create a table
create table UniTsp (
  tsp_col TIMESTAMP NOT NULL
);
success

load UniTsp "../FASTLOAD/Data/UniTsp.csv" ;
success

// check no of rows
tableScan UniTsp;
rows: 24

// check data
tableScan UniTsp;
rows:
  ('1961-01-01 04:03:02.001')
