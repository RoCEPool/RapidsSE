--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table createT1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

// create an index
create index keyIdx on createT1 (key);
affected: 0

// check existence of index
lsidx createT1;
rows:
  ('keyIdx',false,false)

// check columns of index
lsidxcol createT1 keyIdx;
rows:
  ('key', 'INTEGER')

// sz of index
szidx createT1 keyidx;
rows: 1

// lwrsel
fetch createT1 "key 10 >=";
rows: 0

// uprsel
fetch createT1 "key 10 <=";
rows: 0

// keysel
fetch createT1 "key 10 =";
rows: 0

// rgesel
fetch createT1 "key 10 >= key 20 <= AND";
rows: 0

// drop the index keyIdx;
drop index createT1.keyIdx;
success

// now drop the table
drop table createT1;
success

CLEANUP {

  drop table createT1;
  mute

  bye;
  mute
}

