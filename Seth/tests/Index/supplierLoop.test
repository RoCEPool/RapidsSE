--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table supplier (
S_SUPPKEY       INTEGER NOT NULL,
S_NAME          VARCHAR(25) NOT NULL,
S_ADDRESS       VARCHAR(40) NOT NULL,
S_NATIONKEY     INTEGER NOT NULL,
S_PHONE         VARCHAR(15) NOT NULL,
S_ACCTBAL       DECIMAL(15,2) NOT NULL,
S_COMMENT       VARCHAR(101) NOT NULL
);
success

// load the table
ld supplier "/tpch/supplier.tbl";
success

//------------------------------------------------------------------------------
// create an index on suppkey
create index idx on supplier (S_SUPPKEY);
affected: 0

// check existence of index
lsidx supplier;
rows:
  ('idx',false,false)

// check columns of index
lsidxcol supplier idx;
rows:
  ('S_SUPPKEY', 'INTEGER')

//------------------------------------------------------------------------------
// exact key fetches

fetch supplier "S_SUPPKEY 5 ==";
rows: (*, 5,'Supplier#000000005',...)

fetch supplier "S_SUPPKEY 10 =";
rows: (*, 10,'Supplier#000000010',...)

fetch supplier "S_SUPPKEY 22 ==";
rows: (*, 22,'Supplier#000000022',...)

fetch supplier "S_SUPPKEY 9972 ==";
rows: (*, 9972,'Supplier#000009972',...)
/*
//------------------------------------------------------------------------------
// lower bound key fetches

fetch supplier "S_SUPPKEY 9972 >=";
rows: 29

fetch supplier "S_SUPPKEY 9985 >=";
rows: 16

fetch supplier "S_SUPPKEY 9971 >=";
rows: 30

fetch supplier "S_SUPPKEY 9977 >=";
rows: 24

//------------------------------------------------------------------------------
// upper bound key fetches
fetch supplier "S_SUPPKEY 9972 <=";
rows: 9972

fetch supplier "S_SUPPKEY 9985 <=";
rows: 9985

fetch supplier "S_SUPPKEY 9977 <=";
rows: 9977

fetch supplier "S_SUPPKEY 9972 <= " ;
rows: 9972

fetch supplier "S_SUPPKEY 9971 <=";
rows: 9971
*/
//------------------------------------------------------------------------------
// range fetches

fetch supplier  "s_suppkey 9972 >= s_suppkey 9982 <= and";
rows: 11

fetch supplier "s_suppkey 9985 >= s_suppkey  9987 <= and";
rows: 3

fetch supplier "s_suppkey 9972 >= s_suppkey 1995 <= and";
rows: 0

fetch supplier "s_suppkey 9972 >= s_suppkey 10000 <= AND";
rows: 29

fetch supplier "s_suppkey 9972 >= s_suppkey 9999 <= AND";
rows: 28

fetch supplier "s_suppkey 9972 >= s_suppkey 9998 <= AND";
rows: 27

fetch supplier "s_suppkey 9972 >= s_suppkey 9997 <= AND";
rows: 26

fetch supplier "s_suppkey 9972 >= s_suppkey 9996 <= AND";
rows: 25

fetch supplier "s_suppkey 9972 >= s_suppkey 9995 <= AND";
rows: 24

fetch supplier "s_suppkey 9972 >= s_suppkey 9994 <= AND";
rows: 23

fetch supplier "s_suppkey 9972 >= s_suppkey 9993 <= AND";
rows: 22

fetch supplier "s_suppkey 9972 >= s_suppkey 9992 <= AND";
rows: 21

fetch supplier "s_suppkey 9972 >= s_suppkey 9991 <= AND";
rows: 20

fetch supplier "s_suppkey 9972 >= s_suppkey 9990 <= AND";
rows: 19
fetch supplier "s_suppkey 9972 >= s_suppkey 9989 <= AND";
rows: 18
fetch supplier "s_suppkey 9972 >= s_suppkey 9988 <= AND";
rows: 17
fetch supplier "s_suppkey 9972 >= s_suppkey 9987 <= AND";
rows: 16
fetch supplier "s_suppkey 9972 >= s_suppkey 9986 <= AND";
rows: 15
fetch supplier "s_suppkey 9972 >= s_suppkey 9985 <= AND";
rows: 14
fetch supplier "s_suppkey 9972 >= s_suppkey 9984 <= AND";
rows: 13
fetch supplier "s_suppkey 9972 >= s_suppkey 9983 <= AND";
rows: 12
fetch supplier "s_suppkey 9972 >= s_suppkey 9982 <= AND";
rows: 11
fetch supplier "s_suppkey 9972 >= s_suppkey 9981 <= AND";
rows: 10
fetch supplier "s_suppkey 9972 >= s_suppkey 9980 <= AND";
rows: 9
fetch supplier "s_suppkey 9972 >= s_suppkey 9979 <= AND";
rows: 8
fetch supplier "s_suppkey 9972 >= s_suppkey 9978 <= AND";
rows: 7

fetch supplier "s_suppkey 9972 >= s_suppkey 9977 <= AND";
rows: 6

fetch supplier "s_suppkey 9972 >= s_suppkey 9976 <= AND";
rows: 5

fetch supplier "s_suppkey 9972 >= s_suppkey 9975 <= AND";
rows: 4

fetch supplier "s_suppkey 9972 >= s_suppkey 9974 <= AND";
rows: 3

fetch supplier "s_suppkey 9972 >= s_suppkey 9973 <= AND";
rows: 2

fetch supplier "s_suppkey 9972 >= s_suppkey 9972 <= AND";
rows: 1

fetch supplier "s_suppkey 9972 >= s_suppkey 9971 <= AND";
rows: 0

// drop the index idx;
drop index supplier.idx;
success

