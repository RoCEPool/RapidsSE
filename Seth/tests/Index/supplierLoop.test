--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

// create a table
create table supplier (
S_SUPPKEY       INTEGER NOT NULL,
S_NAME          VARCHAR(25) NOT NULL,
S_ADDRESS       VARCHAR(40) NOT NULL,
S_NATIONKEY     INTEGER NOT NULL,
S_PHONE         VARCHAR(15) NOT NULL,
S_ACCTBAL       DECIMAL(15,2) NOT NULL,
S_COMMENT       VARCHAR(101) NOT NULL
);
success

// load the table
ld supplier "/tpch/supplier.tbl";
success

//------------------------------------------------------------------------------
// create an index on suppkey
create index idx on supplier (S_SUPPKEY);
affected: 0

// check existence of index
lsidx supplier;
rows:
  ('idx',false,false)

// check columns of index
lsidxcol supplier idx;
rows:
  ('S_SUPPKEY', 'INTEGER')

//------------------------------------------------------------------------------
// exact key fetches

fetch supplier "S_SUPPKEY 5 ==";
rows: (*, 5,'Supplier#000000005',...)

fetch supplier "S_SUPPKEY 10 =";
rows: (*, 10,'Supplier#000000010',...)

