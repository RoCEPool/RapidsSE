--------------------------------------------------------------------------------
-- create index in a loop tests
--------------------------------------------------------------------------------

--
-- Examples of other miscellaneous commands you can give to seth.
--

// Logging a message
LOG 'Running lineitemEntry test with varying indexEntries per buffer.';

//------------------------------------------------------------------------------
indexEntries 3000;
affected: 0

LOG 'Entries per buffer: 3000';
INCLUDE 'lineitemEntry.test';

//------------------------------------------------------------------------------
indexEntries 4000;
affected: 0

LOG 'Entries per buffer: 4000';
INCLUDE 'lineitemEntry.test';

