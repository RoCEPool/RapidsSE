/*----------------------------------------------------------------------------*/
/* create index tests                                                         */
/*----------------------------------------------------------------------------*/

// (1) create an index (syntax error)
create index on T1 (key);
failure: 'invalid command'

// create a table
create table T1 (
  key   INTEGER NOT NULL, 
  name  VARCHAR(32) NOT NULL
);
success

// create an index
create index Idx on T1 (key);
affected: 0

// check existence of index
lsidx T1;
rows:
  ('Idx', false, false)

// check columns of index
lsidxcol T1 Idx;
rows:
  ('key', 'INTEGER')

// drop the index
drop index T1.Idx;
success

// check existence of index
lsidx T1;
rows: 0

// create index where table does not exist
create index Idx on noTable (key);
failure: 'no such table'

// check existence of index
lsidx T1;
rows: 0

// create index where key does not exist
create index Idx on T1 (noKey);
failure: 'invalid column'

// check existence of index
lsidx T1;
rows: 0

// create index once
create index Idx1 on T1 (key);
affected: 0

// create same index again
create index Idx1 on T1 (key);
failure: 'index exists'

// check existence of index
lsidx T1;
rows:
 ('Idx1', false, false)

// create another index with same column
create index Idx2 on T1 (key);
success

// check existence of index
lsidx T1;
rows:
 ('Idx1',false,false)
 ('Idx2',false,false)

// create index with two columns
create index Idx3 on T1 (key, name);
success

// check existence of index
lsidx T1;
rows: 3

// check columns of Idx3
lsidxcol T1 Idx3;
rows:
 ('key', 'INTEGER')
 ('name', 'VARCHAR')

// create another index with two columns
create index Idx4 on T1 (key, name);
success

// check existence of index
lsidx T1;
rows:
 ('Idx1',false,false)
 ('Idx2',false,false)
 ('Idx3',false,false)
 ('Idx4',false,false)

// check columns of Idx3
lsidxcol T1 Idx3;
rows:
 ('key', 'INTEGER')
 ('name', 'VARCHAR')

CLEANUP {
  
  drop table T1;
  success;

  bye;
  mute
}

