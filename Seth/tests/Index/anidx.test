/*----------------------------------------------------------------------------*/
/* anidx.test -- ANIDX command tests                                          */
/*----------------------------------------------------------------------------*/

// begin tracking memory
trackMemory;
success

// invalid
anidx;
failure contains: "invalid command"

// invalid
anidx IntTbl;
failure contains: "invalid command"

// no such table
anidx IntTbl int_idx1;
failure contains: "no such table"

// (1) create a table
create table IntTbl (
  int_col1  INTEGER NOT NULL,
  vch_col2  VARCHAR(32) NOT NULL,
  vch_col3  VARCHAR(32) NOT NULL,
  int_col4  INTEGER
);
success

// invalid
anidx IntTbl;
failure contains: "invalid command"

// no such index
anidx IntTbl int_idx1;
failure contains: "no such index"

// create indexes
create index int_idx1 on IntTbl (int_col1);
success

// invalid
anidx IntTbl;
failure contains: "invalid command"

// invalid
anidx x int_idx1;
failure contains: "no such table"

// success
anidx IntTbl int_idx1;
rows: 4

load IntTbl "../DATA/Datums/integer.csv" ;
failure contains: '16 invalid'

// check no of rows
tableScan IntTbl;
rows: 101

// success
anidx IntTbl int_idx1;
rows: 4

// drop the table
drop table IntTbl;
success

// get memory leaks
memoryLeaks;
rows: 0

CLEANUP {
  
  // drop the table
  drop table IntTbl;
  mute
  
  bye;
  mute
}

/*----------------------------------------------------------------------------*/
/* end                                                                        */
/*----------------------------------------------------------------------------*/
