--

// Logging a message
LOG 'Running lineitemLoop test with varying indexEntries per buffer.';

//------------------------------------------------------------------------------
LOG 'Entries per buffer: default';
INCLUDE 'lineitemLoop.test';

//------------------------------------------------------------------------------
setAttachMap AM_INDEXENTRIES 2000;
affected: 0

LOG 'Entries per buffer: 2000';
INCLUDE 'lineitemLoop.test';

//------------------------------------------------------------------------------
setAttachMap AM_INDEXENTRIES 2000;
affected: 0

LOG 'Entries per buffer: 2000';
INCLUDE 'lineitemLoop.test';

//------------------------------------------------------------------------------
setAttachMap AM_INDEXENTRIES 0;
affected: 0

LOG 'Entries per buffer: default';
INCLUDE 'lineitemLoop.test';
