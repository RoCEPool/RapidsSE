/*----------------------------------------------------------------------------*/
/* lssch.test -- list schemas                                                 */
/*----------------------------------------------------------------------------*/

pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// list tenants when not in schemas folder
lsten;
failure contains: 'not in tenants'

// cf to tenants
cf "tenants";
success

// list tenants when not in tenants folder
lsten;
rows: ('boray')

create tenant myTenant;
success

lsten;
rows:
  ('myTenant')
  ('boray')

drop tenant myTenant;
success

cf "default";
success

pwf;
rows:
('/tenants/boray/catalogs/rapidsse/schemas/public/tables');

CLEANUP {
  
  //drop catalog myTenant;
  //mute
  
  //cf "default";
  //mute;
  
  bye;
  mute
}

