/*----------------------------------------------------------------------------*/
/* folder.test -- folder functions                                            */
/*----------------------------------------------------------------------------*/

// list folder
lf;
success;

// change folder
cf "noFolder";
failure contains: 'no such folder'

// present working folder
pwf;
rows:
 ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// change folder
cf "..";
success

// present working folder
pwf;
rows:
  ('/public/schemas/rapidsse/catalogs/boray/tenants/')

// change folder
cf "tables";
success

// present working folder
pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

// change folder
cf "tenants";
success

// present working folder
pwf;
rows:
  ('/tenants/')

cf "boray";
success

// present working folder
pwf;
rows:
  ('/boray/tenants/')

cf "catalogs";
success

// present working folder
pwf;
rows:
  ('/catalogs/boray/tenants/')

cf "rapidsse";
success

// present working folder
pwf;
rows:
('/rapidsse/catalogs/boray/tenants/')

cf "schemas";
success

// present working folder
pwf;
rows:
('/schemas/rapidsse/catalogs/boray/tenants/')

cf "public";
success

// present working folder
pwf;
rows:
  ('/public/schemas/rapidsse/catalogs/boray/tenants/')

cf "tables";
success

// present working folder
pwf;
rows:
  ('/tables/public/schemas/rapidsse/catalogs/boray/tenants/')

CLEANUP {
  bye;
  mute
}

