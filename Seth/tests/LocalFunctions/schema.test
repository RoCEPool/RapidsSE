rows: ('/schemas/rapidsse/catalogs/boray/tenants/')

drop schema mySchema;
failure contains: 'folder not empty'

*/

cf "default";
success

pwf;
rows:
('/tenants/boray/catalogs/rapidsse/schemas/public/tables');

CLEANUP {
  
  drop schema mySchema;
  mute
  
  cf "default";
  mute;
  
  bye;
  mute
}

