/*----------------------------------------------------------------------------*/
/* dropTable.test -- DROP TABLE tests                                        */
/*----------------------------------------------------------------------------*/

loop 100 {
  // begin tracking memory
  trackMemory;
  success

  // (1) create a table
  create table bolTbl (
    bol_col1   BOOLEAN     NOT NULL,
    vch_col2   VARCHAR(32) NOT NULL,
    int_col3   INTEGER     NOT NULL,
    int_col4   INTEGER     NOT NULL,
    dec_col5   DECIMAL(10,2) NOT NULL,
    flt_col6   FLOAT       NOT NULL,
    tsp_col7   TIMESTAMP   NOT NULL,
    bol_col8   BOOLEAN
  );
  success

  // create indexes
  create index bol_idx1 on bolTbl (bol_col1);
  success

  // create indexes
  create index bol_idx2 on bolTbl (bol_col8);
  success

  // drop the table
  drop table bolTbl;
  success

  // drop the table
  drop table noSuchTbl;
  failure contains: 'no such table'

  // get memory leaks
  memoryLeaks;
  rows: 0
}

CLEANUP {
  
  // drop the table
  drop table bolTbl;
  mute
  
  bye;
  mute
}

