// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Demonstrates basic expressions in a select list

print "";
print "";
print "*** Executing query: select l_orderkey, l_extendedprice*l_discount, l_extendedprice + 2 from lineitem limit 10";
select l_orderkey, l_extendedprice*l_discount, l_extendedprice + 2 from lineitem limit 10;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Demonstrates a GROUP BY and HAVING clause

print "";
print "";
print "*** Executing query: select l_orderkey, sum(l_quantity) as sum_qty, sum(l_extendedprice*l_discount) as sum_disc_price from lineitem where L_SHIPDATE > DATE '1993-01-01' group by l_orderkey having sum_qty > 100";

select
   l_orderkey,
   sum(l_quantity) as sum_qty,
   sum(l_extendedprice*l_discount) as sum_disc_price
from
     lineitem
where
     L_SHIPDATE > DATE '1993-01-01'
group by
     l_orderkey
having
     sum_qty > 100;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Demonstrates a UNION ALL CORRESPONDING clause

print "";
print "";
print "*** Executing query: select l_orderkey as key, sum(l_quantity) as sum_qty, sum(l_extendedprice*l_discount) as sum_disc_price from lineitem where l_shipdate > DATE '1993-01-01' group by l_orderkey having sum_qty > 100 union all corresponding select l_orderkey as key, sum(l_quantity) as sum_qty from lineitem2 where l_shipdate > DATE '1993-01-01' group by l_orderkey having sum_qty > 100";

select
   l_orderkey as key,
   sum(l_quantity) as sum_qty,
   sum(l_extendedprice*l_discount) as sum_disc_price
from
     lineitem
where
     l_shipdate > DATE '1993-01-01'
group by
     l_orderkey
having
     sum_qty > 100

union all corresponding

select
   l_orderkey as key,
   sum(l_quantity) as sum_qty
from
     lineitem2
where
     l_shipdate > DATE '1993-01-01'
group by
     l_orderkey
having
     sum_qty > 100;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Demonstrates a modified TPC-H query 1 (modified to remove the interval)

print "";
print "";
print "*** Executing query: select l_returnflag, l_linestatus, sum(l_quantity) as sum_qty, sum(l_extendedprice) as sum_base_price, sum(l_extendedprice*l_discount) as sum_disc_price, sum(l_extendedprice*l_discount*l_tax) as sum_charge, count(*) as count_order from lineitem where l_shipdate <= DATE '1998-09-01' group by l_returnflag, l_linestatus";

select
    l_returnflag,
    l_linestatus,
    sum(l_quantity) as sum_qty,
    sum(l_extendedprice) as sum_base_price,
    sum(l_extendedprice*l_discount) as sum_disc_price,
    sum(l_extendedprice*l_discount*l_tax) as sum_charge,
    count(*) as count_order
from
   lineitem
where
   l_shipdate <= DATE '1998-09-01'
   group by l_returnflag, l_linestatus;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
// Demonstrates a modified TPC-H query 4 (modified without the EXISTS subquery and ORDER BY clause)

print "";
print "";
print "*** Executing query: select o_orderpriority, count(*) as order_count from orders where o_orderdate >= DATE '1993-07-01' and o_orderdate <= DATE '1996-01-30' group by o_orderpriority";

select
  o_orderpriority,
  count(*) as order_count
from
  orders
where
  o_orderdate >= DATE '1993-07-01'
  and o_orderdate <= DATE '1996-01-30'
group by
  o_orderpriority;


