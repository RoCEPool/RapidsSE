print "loading Orders...";
 /time load Orders "../DATA/TPCH/orders10.csv";


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select count(*) from lineitem;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select count(*) from lineitem where l_shipdate > DATE '1993-01-01';

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select * from nation where n_nationKey > 10;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select * from nation where n_nationKey > 10 limit 10;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select min(l_extendedPrice), max(l_discount) from lineitem;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select min(l_extendedPrice), max(l_discount) from lineitem group by l_orderkey;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select l_orderkey, l_extendedprice*l_discount, l_extendedprice + 2 from lineitem limit 10;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select
   l_orderkey,
   sum(l_quantity) as sum_qty,
   sum(l_extendedprice*l_discount) as sum_disc_price
from
     lineitem
where
     L_SHIPDATE > DATE '1993-01-01'
group by
     l_orderkey
having
     sum_qty > 100;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select
   l_orderkey as key,
   sum(l_quantity) as sum_qty,
   sum(l_extendedprice*l_discount) as sum_disc_price
from
     lineitem
where
     l_shipdate > DATE '1993-01-01'
group by
     l_orderkey
having
     sum_qty > 100

union all corresponding

select
   l_orderkey as key,
   sum(l_quantity) as sum_qty
from
     lineitem2
where
     l_shipdate > DATE '1993-01-01'
group by
     l_orderkey
having
     sum_qty > 100;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select
    l_returnflag,
    l_linestatus,
    sum(l_quantity) as sum_qty,
    sum(l_extendedprice) as sum_base_price,
    sum(l_extendedprice*l_discount) as sum_disc_price,
    sum(l_extendedprice*l_discount*l_tax) as sum_charge,
    count(*) as count_order
from
   lineitem
where
   l_shipdate <= DATE '1998-09-01'
   group by l_returnflag, l_linestatus;


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
select
  o_orderpriority,
  count(*) as order_count
from
  orders
where
  o_orderdate >= DATE '1993-07-01'
  and o_orderdate <= DATE '1996-01-30'
group by
  o_orderpriority;


