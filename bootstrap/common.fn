#!/bin/bash
# This file contains function definitions that are imported and used by 
# other RapidsSE scripts.

# Guard against this file being executed directly.
if [ "${BASH_SOURCE[0]}" -ef "$0" ]
then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi


###############################################################################
### Constants                                                               ###
###############################################################################
# Variable that can be tested to see if we have already sourced this file
readonly __COMMON_FN=1

#shellcheck disable=2034
readonly VERSION_FILE="version"
readonly CONFIG_DEFAULT_VERSION="2"

readonly PID_FILENAME="se.pid"
readonly READY_FILENAME="se.ready"

readonly DEFAULT_CONFIG_PATH="cluster.config"
readonly DEFAULT_NAME_FILE="node.name"

# Prefix of the name of the associative arrays for each node in the cluster.config
readonly NODE_CFG_PREFIX="NODE_CFG_"

# Names of fields within each node's associative array.
readonly NODE_CFG_NAME_KEY="name"
readonly NODE_CFG_HOST_KEY="host"
readonly NODE_CFG_PORT_KEY="port"
readonly NODE_CFG_HEARTBEAT_KEY="heartbeat"
readonly NODE_CFG_DIR_KEY="dir"
readonly NODE_CFG_PARTITIONS_KEY="partitions"
readonly NODE_CFG_THREADS_KEY="threads"
readonly NODE_CFG_MEM_KEY="mem"
readonly NODE_CFG_CLUSTERID_KEY="clusterid"
readonly NODE_CFG_PARAMS_KEY="params"

# An array of all mandatory node configuration settings.
# Note that "params" is not mandatory.
declare -ra NODE_CFG_MANDATORY_KEYS=( \
  "${NODE_CFG_NAME_KEY}" \
  "${NODE_CFG_HOST_KEY}" \
  "${NODE_CFG_PORT_KEY}" \
  "${NODE_CFG_HEARTBEAT_KEY}" \
  "${NODE_CFG_DIR_KEY}" \
  "${NODE_CFG_PARTITIONS_KEY}" \
  "${NODE_CFG_THREADS_KEY}" \
  "${NODE_CFG_CLUSTERID_KEY}" \
  "${NODE_CFG_MEM_KEY}" \
)

#shellcheck disable=2034
declare -ra NODE_CFG_ALL_KEYS=( \
  "${NODE_CFG_MANDATORY_KEYS[@]}" \
  "${NODE_CFG_PARAMS_KEY}" \
)

###############################################################################
### Functions                                                               ###
###############################################################################

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Print an error message to stderr,
## Params: 
##   $1 : Error message
##   $2..$n : (optional) other arguments to print.

function printError() {
  >&2 echo -e "ERROR: $*"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Print a warning message to stdout,
## Params: 
##   $1 : Warning message
##   $2..$n : (optional) other arguments to print.

function printWarning() {
  echo -e "WARNING: $*"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Print an error message to stderr and exit,
## Params: 
##   $1 : Error message
##   $2..$n : (optional) other arguments to print.

function errorExit() {
  >&2 echo -e "ERROR: $*"
  exit 1
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints a given message if debug mode is turned on (i.e., $DEBUG == 1).
## Params:
##  $@ : The arguments to print

function debugPrint() {
  if [ -n "${DEBUG:-}" ] && [ "${DEBUG}" -eq 1 ]; then
    echo -e "$*"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints a given array (one line per element) if debug mode is turned on 
## (i.e., $DEBUG == 1).
## Params:
##  $1 : The number of indent spaces on each line.
##  $@ : The array to print.

function debugPrintArray() {
  if [ "${DEBUG}" -eq 1 ]; then
    local indents=$1
    shift
    local arrayElements=("$@")
    shift

    printIndentArray "${indents}" "${arrayElements[@]}"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints the members of an array (one per line) with an indentation.
## Params:
##  $1 : The number of indent spaces on each line.
##  $@ : The array to print.

function printIndentArray() {

  local indents=$1
  shift
  local array=("$@")

  if [ -z "${indents:-}" ]; then
   indents=2
  fi

  local var

  for var in ${array[*]}
  do
    # Intentional to preserve meaning of seq operator.
    # shellcheck disable=SC2046 
    printf "%0.s " $(seq 1 ${indents})
    printf '%s\n' "${var}"
  done
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Trims whitespace from the start and end of a string.
## Courtesy of: https://stackoverflow.com/a/3352015
## Params:
##  $1 - the string to be trimmed.
## Returns: the trimmed string on stdout.
function trim() {
  local var="$*"

  # remove leading whitespace characters
  var="${var#"${var%%[![:space:]]*}"}"

  # remove trailing whitespace characters
  var="${var%"${var##*[![:space:]]}"}"

  printf '%s' "$var"
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns with exit code 0 if the given value is present in the array.
## Otherwise returns with exit code 1.
## Params:
##  $1 - the value to test
##  $@ - the array

function isValueInArray() {

  local val="$1"
  shift
  local -a arr=("$@")

  if [ "${val:-x}" = x ]; then
    return 1
  fi

  if [ "${arr[*]:-x}" = x ] || [ "${#arr[@]}" -eq 0 ]; then
    return 1
  fi

  for item in "${arr[@]}"; do
    if [ "${item}" = "${val}" ]; then
      return 0
    fi
  done

  return 1
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Takes an array and prints to stdout a string where each item is nicely
## comma separated (with an additional space).
## Params:
##  $@ - the array of items

function arrayToCommaSeparatedString() {

  [ "$#" -gt 0 ] || errorExit "Function displayNodes() cannot have 0 arguments."

  local -a arr=("$@")
  local isFirst=1
  local str=""

  for item in "${arr[@]}"; do
    if [ "${isFirst}" -eq 1 ]; then
      isFirst=0
      str+="${item}"
    else
      str+=", ${item}"
    fi
  done

  echo "${str}"
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Compares two version numbers in the form x.y.z and returns a successful
## exit code if the first version number is greater than or equal to the 
## second version number.
## Params:
##  $1 : the version number to be compared
##  $2 : the version number to compare to

function isVersionGreaterThanOrEqualTo() {
  if [ $# -ne 2 ]; then
    printWarning "Got less than 2 arguments to function isVersionGreaterThanOrEqualTo()"
    false
    return
  fi

  local ver1
  local ver2

  ver1="$1"
  ver2="$2"

  # Check the version number.
  # Hack for comparing version numbers taken from here: https://unix.stackexchange.com/a/285928

  local result
  result="$(printf '%s\n' "${ver1}" "${ver2}" | sort -V | head -n1)"

  [ "${result}" = "${ver2}" ]
  return
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Sleeps for a given number of seconds and prints a "." for each second slept.
## Params:
##  $1 : the number of seconds to sleep.

function sleepProgressPrint() {
  local delay="$1"
  local count=0

  while [ "${count}" -lt "${delay}" ]
  do
    count=$((count+1))
    sleep 1
    echo -n " ."
  done
 
  if [ "${delay}" -ne 1 ]; then
    echo ""
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Loads the cluster configuration.
## Params: None

function loadClusterConfig() {
  if [ -z "${CONFIG_FILE:-}" ]; then
    errorExit "Cluster configuration file not specified."
  fi

  if [ ! -f "${CONFIG_FILE}" ]; then
    errorExit "Cluster configuration file not found: ${CONFIG_FILE}"
  fi

  #shellcheck disable=1090
  source "${CONFIG_FILE}" || errorExit "Error sourcing cluster config file: ${CONFIG_FILE}"

  # Now check that the configuration is valid.
  validateClusterConfig

  debugPrint "Loaded and validated the cluster configuration at: ${CONFIG_FILE}"
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that a loaded cluster configuration is sane.
## Prints an error message and exits if it is not.
## Params: None

function validateClusterConfig() {
  local errMsg="Invalid cluster configuration at ${CONFIG_FILE} :"

  if [ -z "${CONFIG_VERSION:-}" ]; then
    errorExit "${errMsg}" "No config version (\$CONFIG_VERSION) has been set."
  fi

  if [ "${CONFIG_VERSION}" -ne "${CONFIG_DEFAULT_VERSION}" ]; then
    errorExit "${errMsg}" "Config version (${CONFIG_VERSION}) does not match the expected version (${CONFIG_DEFAULT_VERSION})."
  fi

  if [ -z "${NODE_NAME_PREFIX:-}" ]; then
    errorExit "${errMsg}" "NODE_NAME_PREFIX is not defined."
  fi

  if [ -z "${NODE_SEQ_NUM:-}" ]; then
    errorExit "${errMsg}" "NODE_SEQ_NUM is not defined."
  fi

  if [ -z "${NODE_LIST[*]}" ]; then
    errorExit "${errMsg}" "NODE_LIST array is not defined."
  fi

  if [ "${#NODE_LIST[@]}" -eq 0 ]; then
    errorExit "${errMsg}" "NODE_LIST array is empty."
  fi

  local firstClusterId
  firstClusterId="$(nodeCfgGetValue "${NODE_LIST[0]}" "${NODE_CFG_CLUSTERID_KEY}")"

  if [ -z "${firstClusterId:-}" ]; then
    errorExit "${errMsg}" "Parameter \"${NODE_CFG_CLUSTERID_KEY}\" of node ${NODE_LIST[0]} is not set."
  fi

  # Check that the cluster ID is numeric
  [[ "${firstClusterId}" =~ ^[0-9]+$ ]] || errorExit "${errMsg}" "Parameter \"${NODE_CFG_CLUSTERID_KEY}\" of node ${NODE_LIST[0]} is not an integer."

  for nodeName in "${NODE_LIST[@]}"
  do
    if ! nodeCfgExists "${nodeName}"; then
      errorExit "${errMsg}" "No node configuration exists for the node named \"${nodeName}\"."
    fi

    # Must have name, dir, host, port, heartbeat, mem, threads, partitions all set.
    # Get the value of each of these and check that they are not null.
    local key
    local val

    for key in "${NODE_CFG_MANDATORY_KEYS[@]}"
    do
      val="$(nodeCfgGetValue "${nodeName}" "${key}")"

      if [ -z "${val:-}" ]; then
        errorExit "${errMsg}" "Null/unset value for key ${key} of node ${nodeName}."
      fi
    done

    # Check that this node's cluster ID is the same as the first node
    local currentClusterId
    currentClusterId="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_CLUSTERID_KEY}")"

    # First check that the cluster ID is numeric
    [[ "${currentClusterId}" =~ ^[0-9]+$ ]] || errorExit "${errMsg}" "Parameter \"${NODE_CFG_CLUSTERID_KEY}\" of node ${nodeName} is not an integer."

    if [ "${currentClusterId}" -ne "${firstClusterId}" ]; then
      errorExit "${errMsg}" "Node ${nodeName} has a different value for parameter ${NODE_CFG_CLUSTERID_KEY} than node ${NODE_LIST[0]}."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Loads from file the name of the current node.
## Params: None

function loadNodeName() {
  if [ -z "${NAME_FILE:-}" ]; then
    errorExit "Node name file not specified."
  fi

  if [ ! -f "${NAME_FILE}" ]; then
    errorExit "Node name file not found: ${NAME_FILE}"
  fi

  #shellcheck disable=1090
  source "${NAME_FILE}" || errorExit "Error sourcing node name file: ${NAME_FILE}"

  if [ -z "${CURRENT_NODE_NAME:-}" ]; then
    errorExit "\$CURRENT_NODE_NAME has not been set in node name file: ${NAME_FILE}"
  fi

  debugPrint "Loaded and validated the node name configuration at: ${NAME_FILE}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

## Writes the number of CPU cores to stdout for a given node.
## Params: 
##  $1 : nodeName - the name of the node in question.

function getCpuCount() {

  # NB Cannot print to stdout as the caller is expecting to read a value on stdout.

  local nodeName="$1"
  local host
  local remoteCmd
  declare -a sshArgs=()
  local response

  [ -n "${nodeName:-}" ] || errorExit "getCpuCount(): Parameter 1 cannot be null."

  host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

  remoteCmd="{ which nproc &>/dev/null && nproc; } || "
  remoteCmd+="{ getconf _NPROCESSORS_ONLN 2>/dev/null; } || "
  remoteCmd+="{ echo \"-1\"; }"

  sshArgs=( "-q" "${host}" "bash" "-c" "'${remoteCmd}'" )

  if ! response="$(ssh "${sshArgs[@]}")"; then
    echo "-1" 
    return
  fi

  if [[ ! "${response}" =~ ^[0-9]+$ ]]; then
    echo "-1"
    return
  fi

  echo "${response}"
  true
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

## Writes the total memory size (in GB) to stdout for a given node. The response
## may be a floating point number.
## Params: 
##  $1 : nodeName - the name of the node in question.

function getTotalMem() {
  # NB Cannot print to stdout as the caller is expecting to read a value on stdout.

  local nodeName="$1"
  local host
  local remoteCmd
  declare -a sshArgs=()
  local response

  [ -n "${nodeName:-}" ] || errorExit "getCpuCount(): Parameter 1 cannot be null."

  host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

  remoteCmd="bash -c \"cat /proc/meminfo | grep MemTotal | awk '{print \\\$2 / 1048576}'\""

  sshArgs=( "-q" "${host}" "${remoteCmd}" )

  if ! response="$(ssh "${sshArgs[@]}")"; then
    echo "-1" 
    return
  fi

  if [[ ! "${response}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "-1"
    return
  fi

  echo "${response}"
  true
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

## Writes the total SHM size (in GB) to stdout for a given node. The response
## may be a floating point number.
## Params: 
##  $1 : nodeName - the name of the node in question.

function getTotalShm() {
  # NB Cannot print to stdout as the caller is expecting to read a value on stdout.

  local nodeName="$1"
  local host
  local remoteCmd
  declare -a sshArgs=()
  local response

  [ -n "${nodeName:-}" ] || errorExit "getCpuCount(): Parameter 1 cannot be null."

  host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
  
  remoteCmd="bash -c \"df -Bk --output=size,avail /dev/shm | tail -n 1 | awk '{print \\\$1 / 1048576}'\""

  sshArgs=( "-q" "${host}" "${remoteCmd}" )

  if ! response="$(ssh "${sshArgs[@]}")"; then
    echo "-1" 
    return
  fi

  if [[ ! "${response}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "-1"
    return
  fi

  echo "${response}"
  true
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

## Writes the free SHM size (in GB) to stdout for a given node. The response
## may be a floating point number.
## Params: 
##  $1 : nodeName - the name of the node in question.

function getFreeShm() {
  # NB Cannot print to stdout as the caller is expecting to read a value on stdout.

  local nodeName="$1"
  local host
  local remoteCmd
  declare -a sshArgs=()
  local response

  [ -n "${nodeName:-}" ] || errorExit "getCpuCount(): Parameter 1 cannot be null."

  host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

  remoteCmd="bash -c \"df -Bk --output=size,avail /dev/shm | tail -n 1 | awk '{print \\\$2 / 1048576}'\""

  sshArgs=( "-q" "${host}" "${remoteCmd}" )

  if ! response="$(ssh "${sshArgs[@]}")"; then
    echo "-1" 
    return
  fi

  if [[ ! "${response}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "-1"
    return
  fi

  echo "${response}"
  true
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns the PID of the SE process running on a given node name, or an
## empty string if the process is not running.
##
## Params:
##  $1 : The name of the node to enquire on.

function getRemoteRunningPid() {

  local nodeName="$1"

  local host
  local dir
  local pid
  local remoteCmd

  host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
  dir="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"

  remoteCmd="if [ ! -f \"${dir}/${PID_FILENAME}\" ]; then exit 1; fi; cat \"${dir}/${PID_FILENAME}\" | xargs ps -o pid -h -p "

  pid="$(ssh -q "${host}" "bash" "-c" "'${remoteCmd}'")"

  local re="^[[:space:]]*([0-9]+)[[:space:]]*$"

  if [[ "${pid}" =~ $re ]]; then
    pid="${BASH_REMATCH[1]}"
  else
   pid=""
  fi

  echo "${pid}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Checks whether a remote SE is loaded and ready. Returns a non-error exit
## code if it is ready, or an error exit code if it is not.
##
## Params:
##  $1 : The name of the node to enquire on.

function isRemoteSeReady() {
  local nodeName="$1"

  local host
  local dir
  local pid
  local remoteCmd

  host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
  dir="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"

  remoteCmd="diff -qNZ \"${dir}/${PID_FILENAME}\" \"${dir}/${READY_FILENAME}\" &>/dev/null"

  ssh -q "${host}" "bash" "-c" "'${remoteCmd}'"
  local nodeReady="$?"

  if [ "${nodeReady}" -eq 0 ]; then
    debugPrint "Node ${nodeName} is started and ready"
    true
    return
  else 
    debugPrint "Node ${nodeName} is not yet started or ready"
    false
    return
  fi
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Filters row data from SE (in the form of "row: (col,col,col)"
## and returns the desired column values. Columns are returned in a CSV format
## with one row per line.
## This function should be called as follows:
##   while read -r -d ',' columnData; do <some_work_here>; done < <(parseRowData "${filename}" "${columnNum}" ...)
## If an error is encountered then the error is printed to the screen and a
# non-zero exit code is returned.
## Params:
##  $1 : The name of the file with the data
##  $2-$n : The 1-based index of the column(s) to return, otherwise all columns are returned

function parseRowData() {

  if [ $# -eq 0 ]; then
    errorExit "function parseRowData() must be called with at least one parameter"
  fi

  local filename="$1"
  shift
  local -a columnNums=( "$@" )

  while IFS='' read -r line; do

    # Ignore empty lines
    if [ -z "${line:-}" ]; then
      continue
    fi

    # Check for errors
    local errorRe="^error: (.+)$"

    if [[ "${line}" =~ $errorRe ]]; then
      local errorMsg="${BASH_REMATCH[1]}"
      printError "${errorMsg}"
      false
      return
    fi

    # Ignore lines that don't start with "row: (".
    # Also extract any data between "row: (" and ")"?
    local re="^row: \(([^\)]+)\)[[:space:]]*$"
    local row

    if [[ "${line}" =~ $re ]]; then
      row="${BASH_REMATCH[1]}"
    else
      continue
    fi

    # We need to add an extra comma on the end so the caller can parse it properly
    row="${row},"

    if [ "${#columnNums[@]}" -eq 0 ]; then
      echo "${row}"
      continue
    fi

    # Split into columns using commas as the delimiter.
    # Not worrying about commas in strings, etc.
    local -a columns=()
    while read -r -d ',' col; do
      columns+=("${col}")
    done <<<"${row}"

    # Print the right columns
    local output=""
    for colIdx in "${columnNums[@]}"; do
      if [ "${colIdx}" -le "${#columns[@]}" ]; then
        output+="${columns[$((colIdx - 1))]},"
      fi
    done

    # output the column
    if [ -n "${output:-}" ]; then
      echo "${output}"
    fi
  done < <(cat "${filename}" 2>/dev/null)
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a column value (via stdout) given some CSV row string.
## Strips single quotes off string values if present
## Params:
##  $1 : The CSV row string
##  $2 : The 1-based index of the column desired

function getColumn() {

  if [ "$#" -ne 2 ]; then
    return
  fi

  local row="$1"
  local colNum="$2"

  # Split into columns using commas as the delimiter.
  local -a columns=()
  while read -r -d ',' col; do
    columns+=("${col}")
  done <<<"${row}"

  if [ "${colNum}" -gt "${#columns[@]}" ]; then
    return
  fi

  local columnVal="${columns[$((colNum - 1))]}"

  # Strip leading/trailing spaces if present
  columnVal="$(trim "${columnVal}")"

  # Strip single quotes if necessary
  local stringRe="^[[:space:]]*'([^']*)'[[:space:]]*$"
  if [[ "${columnVal}" =~ $stringRe ]]; then
      columnVal="${BASH_REMATCH[1]}"
  fi

  echo "${columnVal}"
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# =========================================================================== #
# Node Configuration Manipulation                                             #
#   Below are functions that create and manipulate the associative arrays     #
#   used to store the configuration for each node.                            #
# =========================================================================== #

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Populates the NODE_LIST array with node names based on a given count passed
## in as a parameter.
## Params:
##  $1 : A count of node names to be created.

function createNodeNames() {
  local count=$1
  local i=0

  while [ $i -lt "${count}"  ]
  do
    NODE_SEQ_NUM=$((NODE_SEQ_NUM+1))
    NODE_LIST+=("${NODE_NAME_PREFIX}${NODE_SEQ_NUM}")
    i=$((i+1))
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Creates associative arrays for each node name that is passed in.
## Params:
##  $@ : An array of node names.

function createNodeConfigs() {
  local nodeNames
  nodeNames=("$@")

  local nodeName

  for nodeName in "${nodeNames[@]}"
  do
    # Dynamically create the associative array
    local nodeCfg="${NODE_CFG_PREFIX}${nodeName}"
    declare -gA "${nodeCfg}"

    # Populate the "name" field.
    nodeCfgSetValue "${nodeName}" "${NODE_CFG_NAME_KEY}" "${nodeName}"
  done 
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Sets a value for a key in the dynamically created associative arrays for 
## all nodes.
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
## 
## Params:
##  $1 : The name of the key to be set.
##  $2 : The value to set in this key.

function allNodeCfgsSetValue() {

  local key="$1"
  local value="$2"

  for nodeName in "${NODE_LIST[@]}"
  do
    nodeCfgSetValue "${nodeName}" "${key}" "${value}"
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Sets a value for a key in the dynamically created associative arrays for
## certain specified node names.
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the key to be set.
##  $2 : The value to set in this key.
##  $3 : The array of node names to set this key/value for

function specificNodeCfgsSetValue() {

  local key="$1"
  shift
  local value="$1"
  shift
  local -a nodeNames=("$@")

  [ "${#nodeNames[@]}" -gt 0 ] || errorExit "Invalid number of node names specified in function specificNodeCfgsSetValue()"

  for nodeName in "${nodeNames[@]}"
  do
    nodeCfgSetValue "${nodeName}" "${key}" "${value}"
  done
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Sets a value for a key in a dynamically created associative array.
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the SE node. 
##  $2 : The name of the key in this node's associate array.
##  $3 : The value to set against this key in the node's associate array.

function nodeCfgSetValue() {
  local nodeName=$1
  local key=$2
  local value=$3

  # Here be dragons
  #shellcheck disable=2140
  eval "${NODE_CFG_PREFIX}${nodeName}"["${key}"]="${value}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a value for a key in a dynamically created associative array.
## This function should be called by:
##   result="$(nodeCfgGetValue "${nodeName}" "${key}")"
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the SE node.
##  $2 : The name of the key in this nodes associate array whose value to return.

function nodeCfgGetValue() {
  local nodeName=$1
  local key=$2

  local ref="${NODE_CFG_PREFIX}${nodeName}[${key}]"
  echo "${!ref}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns an array of keys in a dynamically created associative array.
## This function should be called by:
##   local keys
##   IFS=" " read -r -a keys <<< "$(nodeCfgGetKeys "${nodeName}")"
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the SE node.

function nodeCfgGetKeys() {
  local nodeName=$1

  eval echo '${!'"${NODE_CFG_PREFIX}${nodeName}"'[@]}'
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints the configuration of all nodes.
## Params: None
 
function allNodeCfgsPrint() {
  for nodeName in "${NODE_LIST[@]}"
  do
    nodeCfgPrint "${nodeName}"
    echo ""
  done
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints the name of the node's associative array, it's keys and values.
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the SE node.

function nodeCfgPrint() {
  local nodeName=$1

  local keys
  IFS=" " read -r -a keys <<< "$(nodeCfgGetKeys "${nodeName}")"
  
  local arrayName="${NODE_CFG_PREFIX}${nodeName}"

  echo "${arrayName}"

  for key in "${keys[@]}"
  do
    local value
    value=$(nodeCfgGetValue "${nodeName}" "${key}")

    echo "  [${key}] = ${value}"
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a 0 exit status if the configuration of a node with a given name 
## exists. Otherwise it returns a non-0 exit status.
## This can be used as follows:
##    if ! nodeCfgExists "${CURRENT_NODE_NAME}"; then ...; fi;
## Params:
##  $1 : The name of the node to check.

function nodeCfgExists() {
  local nodeName="$1"

  # Check that it exists in the NODE_LIST
  local foundNode=0

  for node in "${NODE_LIST[@]}"
  do
    if [ "${node}" = "${nodeName}" ]; then
      foundNode=1
      break;
    fi
  done 

  if [ ${foundNode} -eq 0 ]; then
    false
    return
  fi

  local val
  val="$(eval echo "${NODE_CFG_PREFIX}${nodeName}[@]")"

  if [ -z "${val:-}" ]; then
    false
    return
  fi

  true
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns via stdout the number of unique hostnames in the cluster configuration.
## Params:
##  $@ - (optional) The list of node names to consider. If not supplied then all
##        nodes in the cluster will be considered.

function numberOfUniqueHosts() {

  local nodeNames=()

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local -A hostMap

  for nodeName in "${nodeNames[@]}"; do
    # Get the hostname and set it in the map
    local hostname
    hostname="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    hostMap["${hostname}"]=1
  done

  echo "${#hostMap[@]}"
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns an array of non-unique hostnames from a given list of node names.
## The output of this can be read into an array by calling it like this:
##   mapfile -t myarray < <(nonUniqueHosts "${nodeNames[@]}")
## Params:
##  $@ - (optional) The list of node names to consider. If not supplied then all
##        nodes in the cluster will be considered.
function nonUniqueHosts() {

  local nodeNames=()

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local -A hostMap

  for nodeName in "${nodeNames[@]}"; do
    # Get the hostname and set it in the map
    local hostname
    local currentVal

    hostname="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    currentVal="${hostMap["${hostname}"]:-0}"
    ((currentVal+=1))
    hostMap["${hostname}"]="${currentVal}"
  done

  # Find all of the hostnames with a value > 1
  for hostname in "${!hostMap[@]}"; do
    local currentVal
    currentVal="${hostMap["${hostname}"]}"

    if [ "${currentVal}" -gt 1 ]; then
      echo "${hostname}"
    fi
  done
}


