#!/bin/bash
# This file contains function definitions that are imported and used by the
# cluster start and stop scripts.

# Guard against this file being executed directly.
if [ "${BASH_SOURCE[0]}" -ef "$0" ]
then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

# Load other common functions
BOOTSTRAP_COMMON_FN="common.fn"

if [ -n "${DIR:-}" ]; then
  BOOTSTRAP_COMMON_FN="${DIR}/${BOOTSTRAP_COMMON_FN}"
fi

if [ -z "${__BOOTSTRAP_COMMON_FN:-}" ] ; then
  #shellcheck source=common.fn
  source "${BOOTSTRAP_COMMON_FN}" || { >&2 echo "Could not load ${BOOTSTRAP_COMMON_FN}"; exit 1; }
fi

###############################################################################
### Constants                                                               ###
###############################################################################
# Variable that can be tested to see if we have already sourced this file
readonly __BOOT_FN=1

readonly EXE_DIR="${ROOT_DIR}/bin"
readonly EXE="${EXE_DIR}/rapidsse"

readonly LOG_FILE="${ROOT_DIR}/se.log"
readonly PIDFILE="${ROOT_DIR}/${PID_FILENAME}"
readonly READYFILE="${ROOT_DIR}/${READY_FILENAME}"

readonly START_SCRIPT="startSE.sh"
readonly STOP_SCRIPT="stopSE.sh"
#readonly STATUS_SCRIPT="status.sh"
readonly COLLECTLOGS_SCRIPT="collectLogs.sh"

readonly DEFAULT_BOOT_TIMEOUT="60" # seconds
readonly DEFAULT_CLUSTER_XCONNECT_BROADCAST_TIMEOUT="15"  # seconds, or -1 to wait indefinitely
readonly DEFAULT_CLUSTER_XCONNECT_MULTICAST_TIMEOUT="45"  # seconds, or -1 to wait indefinitely
readonly DEFAULT_CLUSTER_REBALANCE_TIMEOUT="-1" # seconds, or -1 to wait indefinitely
readonly DEFAULT_CLUSTER_FORGET_NODE_TIMEOUT="-1" # seconds, or -1 to wait indefinitely

readonly REBALANCE_COMMAND="rebalance"
readonly FORGET_NODE_COMMAND="forgetNode"
readonly HEARTBEAT_BROADCAST="BROADCAST"

###############################################################################
### Functions                                                               ###
###############################################################################

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints out the valid arguments to the start & stop scripts and exits.
## Params: None
## Note: The variable ${SCRIPT_NAME} must be defined as the name of the start
##       or stop script filename.

function printStartStopUsageAndExit() {

  echo ""
  echo "Usage: ./${SCRIPT_NAME} [--cluster | --node]"
  echo "                    [--config <file>]"
  echo "                    [--debug]"
  echo "Details:"
  echo "  --cluster            [Default] Starts all nodes in the cluster."
  echo "  --node               Starts the current node only."
  echo ""
  echo "  --config <file>      Uses a given cluster configuration file."
  echo "                       Default is: ${CONFIG_FILE}"
  echo ""
  echo "  --debug              Displays additional debugging messages during execution."
  echo ""
  echo "  --reload <snapshot>  Starts SE in reload mode."
  echo "                       <snapshot> is the name of the snapshot directory relative"
  echo "                       to the cluster data directory."
  echo ""
  echo "  --clusterinit        Internal use only."
  echo ""
  echo "  --help               Displays this message."
  exit 1
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the reload path exists on all nodes in the cluster.
## Params:
##  $1 - The name of the reload snapshot
##  $@ - (optional) the array of node names to be started. If not supplied then
##       all nodes will be started.

function validateReloadPath() {

  if [ "$#" -eq 0 ]; then
    errorExit "At least 1 parameter must be specified for function validateReloadPath()"
  fi

  local snapshot="$1"
  shift

  local -a nodeNames

  if [ "$#" -eq 0 ]; then
    fullClusterStart=1
    nodeNames=( "${NODE_LIST[@]}" )
  else
    fullClusterStart=0
    nodeNames=( "$@" )
  fi

  echo "Checking that snapshot \"${snapshot}\" exists on all nodes."

  # Check each node in the cluster
  local host
  local diskPathsStr
  local -a diskPathsArray
  local diskPath
  local snapshotPath
  local remoteCmd

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    diskPathsStr="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DISK_KEY}")"

    # diskPathsStr above is a string. Let's turn it into an array based on : delimiter
    IFS=: read -r -d '' -a diskPathsArray < <(printf '%s:\0' "$diskPathsStr")

    if [ ${#diskPathsArray[@]} -ne 0 ]; then
      for diskPath in "${diskPathsArray[@]}"; do

        if [ "${diskPath:0-1}" != "/" ]; then
          diskPath+="/"
        fi

        snapshotPath="${diskPath}${snapshot}"

        if [ -n "${remoteCmd}" ]; then
          remoteCmd+=" && "
        fi

        remoteCmd+="ls ${snapshotPath}"
      done

      remoteCmd+=" &>/dev/null"
    fi

    debugPrint "Checking that snapshot \"${snapshot}\" exists on node ${nodeName} with command: ${remoteCmd}"

    # We will do this sequentially since reload is not a common operation.
    if ! ssh "${SSH_COMMON_OPTIONS[@]}" "${host}" "bash" "-c" "'${remoteCmd}'"; then
      errorExit "Could not find one or more of the snapshot directories named \"${snapshot}\" on node ${nodeName} [host: ${host}]"
    fi
  done
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Starts RapidsSE on all nodes in the cluster.
## Params:
##  $@ - (optional) the array of node names to be started. If not supplied then
##       all nodes will be started.

function startCluster() {

  local fullClusterStart
  local -a nodeNames

  if [ "$#" -eq 0 ]; then
    fullClusterStart=1
    nodeNames=( "${NODE_LIST[@]}" )
  else
    fullClusterStart=0
    nodeNames=( "$@" )
  fi

  echo -n "Checking node versions..."

  # Check that all nodes are the same version.
  local verStr
  if ! verStr="$(checkNodeVersionsAreEqual)"; then
    errorExit "Could not start the RapidsSE cluster."
  fi

  echo "All nodes are running the same version: ${verStr}"

  # Check if any nodes are already running
  if [ "${fullClusterStart}" -eq 1 ]; then
    # Full cluster start
    assertNoNodesRunning "" || errorExit "Could not start the RapidsSE cluster."
    echo "Starting the RapidsSE cluster."

  else
    # Add node start
    if [ "${#nodeNames[@]}" -gt 1 ]; then
      echo "Starting the additional nodes."
    else
      echo "Starting the additional node."
    fi
  fi

  local row

  if [ -n "${SEQ_START:-}" ]; then
    # Start the nodes sequentially
    for row in "${nodeNames[@]}"
    do
      debugPrint "Starting ${row}"
      remoteNodeArgArr=("${row}")
      [ -n "${EXTRA_START_ARGS[*]:-}" ] && remoteNodeArgArr+=("${EXTRA_START_ARGS[@]}")
      startRemoteNode "${remoteNodeArgArr[@]}" || errorExit "Could not start node ${row} in the cluster."
    done

  else
    # Start the nodes in parallel. Ignore all output.
    for row in "${nodeNames[@]}"
    do
      remoteNodeArgArr=("${row}")
      [ -n "${EXTRA_START_ARGS[*]:-}" ] && remoteNodeArgArr+=("${EXTRA_START_ARGS[@]}")
      startRemoteNode "${remoteNodeArgArr[@]}" &>/dev/null &
    done

    # Wait for all parallel jobs to finish.
    wait || true
  fi

  if [ "${#nodeNames[@]}" -gt 1 ]; then
    echo "Started ${#nodeNames[@]} nodes in the cluster. Waiting for them to boot"
  else
    echo "Started ${#nodeNames[@]} node in the cluster. Waiting for it to boot"
  fi

  # Wait for all nodes to boot and become ready
  if [ -z "${BOOT_TIMEOUT:-}" ]; then
    BOOT_TIMEOUT="${DEFAULT_BOOT_TIMEOUT}"
  fi

  # We want to wait for the cluster to boot up, but timeout if it takes too long.
  waitForClusterBoot "${BOOT_TIMEOUT}" "${nodeNames[@]}" || true

  echo ""

  if printClusterStatus; then

    # Wait for the cluster to cross connect
    remoteClusterXConnect

    if [ "${fullClusterStart}" -eq 1 ]; then
      echo "Cluster startup complete."
    else
      echo "Added nodes have started successfully."
    fi
    true

  else
    if [ "${fullClusterStart}" -eq 1 ]; then
      echo "Cluster startup failed. Please stop any running nodes in the cluster with"
      echo "./${STOP_SCRIPT} before restarting it. Refer to the se.log file on the failed"
      echo "nodes for failure details."
    else
      echo "Added nodes have failed to start up correctly. Refer to the se.log file on"
      echo "the failed nodes for failure details."
    fi
    false
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Remotely starts RapidsSE on a node given by the row parameter.
## Params: 
##  $1 : The name of the node to be started.
##  Optional arguments (supports arbitrary number of args):
##  $2 : extra arg (for ex. --reload)
##  $3 : extra arg value (for ex. <reload-dir-name>)

function startRemoteNode() {

  local row="$1"
  shift
  local host
  local dir
  local remoteCmd

  host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
  dir="$(nodeCfgGetValue "${row}" "${NODE_CFG_DIR_KEY}")"

  if [ "$#" -ne 0 ]; then
    remoteCmd="cd \"${dir}\" && ./${START_SCRIPT} --node $(printf '"%s" ' "$@")"
  else
    remoteCmd="cd \"${dir}\" && ./${START_SCRIPT} --node"
  fi

  if [ "${DEBUG}" -eq 1 ]; then
    remoteCmd="${remoteCmd} --debug"
  fi

  sshCmd=( "ssh" "-q" "${host}" "bash" "-c" "'${remoteCmd}'" )

  debugPrint "About to start node ${row} with the command: ${sshCmd[*]}"

  "${sshCmd[@]}" || errorExit "Could not start RapidsSE on node ${row}."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Starts RapidsSE on the current node only.
## Params: (Optional) extra start arguments

function startCurrentNode() {

# extract params into named variables

  # Get all of the settings for the current node
  local host
  local internalPort
  local clientPort
  local heartbeatPort
  local heartbeatAddress
  local dir
  local partitions
  local threads
  local mem
  local clusterId
  local diskPathsStr
  local params
  local extraStartArgs=("$@")


  host="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HOST_KEY}")"
  internalPort="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_INTERNAL_PORT_KEY}")"
  clientPort="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_CLIENT_PORT_KEY}")"
  heartbeatPort="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HEARTBEAT_PORT_KEY}")"
  heartbeatAddress="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HEARTBEAT_ADDRESS_KEY}")"
  dir="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_DIR_KEY}")"
  partitions="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_PARTITIONS_KEY}")"
  threads="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_THREADS_KEY}")"
  mem="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_MEM_KEY}")"
  diskPathsStr="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_DISK_KEY}")"
  clusterId="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_CLUSTERID_KEY}")"

  params="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_PARAMS_KEY}")"

  # params above is a string. Let's turn it into an array based on spaces.
  declare -a paramsArray=()
  IFS=' ' read -r -a paramsArray <<< "${params}"

  # diskPathsStr above is a string. Let's turn it into an array based on : delimiter
  IFS=: read -r -d '' -a diskPathsArray < <(printf '%s:\0' "$diskPathsStr")

  declare -a startCmd=()
  startCmd+=("nohup")
  startCmd+=("${EXE}")
  startCmd+=("--partitionsPerNode")
  startCmd+=("${partitions}")
  startCmd+=("--threads")
  startCmd+=("${threads}")
  startCmd+=("--size")
  startCmd+=("${mem}GB")
  startCmd+=("--node")
  startCmd+=("${CURRENT_NODE_NAME}")
  startCmd+=("${host}")
  startCmd+=("${internalPort}")
  startCmd+=("${clientPort}")
  startCmd+=("--name")
  startCmd+=("${CURRENT_NODE_NAME}")
  startCmd+=("--start")
  startCmd+=("--munged")
  startCmd+=("--commands")
  startCmd+=("${ROOT_DIR}/commands")
  startCmd+=("--cid")
  startCmd+=("${clusterId}")
  startCmd+=("--heartbeat")
  startCmd+=("${heartbeatAddress}")
  startCmd+=("${heartbeatPort}")

  if [ ${#diskPathsArray[@]} -ne 0 ]; then
    for path in "${diskPathsArray[@]}"
    do
      startCmd+=("--disk")
      startCmd+=("${path}")
    done
  fi

  startCmd+=("${paramsArray[@]}")
  startCmd+=("${extraStartArgs[@]}")


  # SE environment variables
  export SE_ENV_METACLUE=1
  export SE_ENV_INTKEY=1


  if [ "${DEBUG}" -eq 1 ]; then
    echo "Starting RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}] with the command:"
    echo "  ${startCmd[*]}"

  else
    echo "Starting RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}]..."
  fi

  echo "Starting SE at $(date +%FT%T)" >> "${LOG_FILE}"

  "${startCmd[@]}" 1>/dev/null 2>> "${LOG_FILE}" &

  # get the last pid and save it to a file
  local pid=$!
  echo "${pid}" > "${PIDFILE}"

  echo "[Start script]: RapidsSE started as PID ${pid}." >> "${LOG_FILE}"
  echo "[Start script]: RapidsSE started with the command:   ${startCmd[*]}" >> "${LOG_FILE}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Waits for all nodes in the cluster to boot and report that they are ready.
## Prints a "." for every second it waits
## Params:
##  $1 - how many seconds to wait before declaring the boot unsuccessful.
##  $@ - (optional) the array of node names to be started. If not supplied then
##       all nodes will be started.
## Returns a non-zero exit code if a timeout occurs

# shellcheck disable=SC2120
function waitForClusterBoot() {

  local dotPid

  [ "$#" -ge 1 ] || errorExit "Invalid number of arguments to function waitForClusterBoot : $#"

  local bootTimeout="$1"
  shift

  local fullClusterStart
  local -a nodeNames

  if [ "$#" -eq 0 ]; then
    fullClusterStart=1
    nodeNames=( "${NODE_LIST[@]}" )
  else
    fullClusterStart=0
    nodeNames=( "$@" )
  fi

  if [ "${fullClusterStart}" -eq 0 ]; then
    echo -n "Waiting for the added nodes to boot: "
  else
    echo -n "Waiting for cluster to boot: "
  fi

  # Print dots to indicate progress
  ( 
    while true; do
      printf ". "
      sleep 1
    done
  ) &

  dotPid=$!

  # If we run this function as a subshell and then kill it, we need to also
  # ensure that we kill the dot printer above.
  #shellcheck disable=SC2064
  trap "kill -0 ${dotPid} &>/dev/null && kill -15 ${dotPid} &>/dev/null && wait ${dotPid} 2>/dev/null" SIGINT SIGHUP SIGTERM EXIT

  # Give a couple of seconds for SE to attempt to start up on each node.
  # If we don't then it may look like it isn't running.

  local startTime
  local currentTime
  local targetTime

  startTime="$(date +%s)"
  targetTime=$((startTime + bootTimeout))

  sleep 2

  for row in "${nodeNames[@]}"; do

    while true; do
      # Have we taken too long?
      currentTime="$(date +%s)"
      if [ "${currentTime}" -ge "${targetTime}" ]; then
        kill -0 ${dotPid} &>/dev/null && kill -15 ${dotPid} &>/dev/null
        echo "Cluster boot timed out"
        wait ${dotPid} 2>/dev/null || true
        false
        return
      fi

      # If SE is not running then stop waiting
      if [ -z "$(getRemoteRunningPid "${row}")" ]; then
        debugPrint "Node ${row} is not running"
        break;
      fi

      # If SE is ready then stop waiting
      if isRemoteSeReady "${row}" ; then
        break
      fi

      debugPrint "Node ${row} is not ready"
      sleep 1
    done

  done

  kill -0 ${dotPid} &>/dev/null && kill -15 ${dotPid} &>/dev/null && wait ${dotPid} 2>/dev/null
  true
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns an array of strings representing the node name/host/port arguments 
## for the cluster. This can be called by executing:
##   declare -a nodeArgs
##   IFS=" " read -r -a nodeArgs <<< "$(buildNodeArguments)"
## Params: None

function buildNodeArguments() {

  declare -a nodeArgs=()
  local host
  local internalPort
  local clientPort

  for row in "${NODE_LIST[@]}"
  do
    host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
    internalPort="$(nodeCfgGetValue "${row}" "${NODE_CFG_INTERNAL_PORT_KEY}")"
    clientPort="$(nodeCfgGetValue "${row}" "${NODE_CFG_CLIENT_PORT_KEY}")"

    nodeArgs+=("--node" "${row}" "${host}" "${internalPort}" "${clientPort}")
  done
 
  echo "${nodeArgs[@]}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Cross-connects all of the nodes that were launched in the cluster. All nodes in
## the cluster must have already been started successfully. This calls the
## first node in the cluster to start the initialisation.
## Params: None

function remoteClusterXConnect() {

  local row
  local host
  local dir
  local remoteCmd

  # Let's use the first node in the list
  row="${NODE_LIST[0]}"
  host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
  dir="$(nodeCfgGetValue "${row}" "${NODE_CFG_DIR_KEY}")"

  remoteCmd="cd \"${dir}\" && ./${START_SCRIPT} --node --clusterinit"

  if [ "${DEBUG}" -eq 1 ]; then
    remoteCmd="${remoteCmd} --debug"
  fi

  sshCmd=( "ssh" "-q" "${host}" "bash" "-c" "'${remoteCmd}'" )

  debugPrint "About to initialise the cluster on node ${row} with the command: ${sshCmd[*]}"

  "${sshCmd[@]}" || errorExit "Could not initialise the RapidsSE cluster on node ${row} [host ${host}]."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Waits for all of the nodes that were launched in the cluster to discover 
## each other and cross connect. All nodes in the cluster must have already been started
## successfully. This must be called from any node that is participating in the 
## cluster.
## Params: None

function localClusterXConnect() {
  echo -n "Waiting for the cluster to cross-connect..."

  if [ -z "${CURRENT_NODE_NAME:-}" ]; then
    errorExit "The name of the local node has not been loaded."
  fi

  local host
  host="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HOST_KEY}")"

  local statusCmd="status"

  declare -a cmd=()
  cmd+=("${EXE}")
  cmd+=("--name")
  cmd+=("${CURRENT_NODE_NAME}")
  cmd+=("--munged")
  cmd+=("--commands")
  cmd+=("${ROOT_DIR}/commands")
  cmd+=("--command")
  cmd+=("${statusCmd}")
  cmd+=("--appendTrace")

  debugPrint "\nAbout to execute the cluster status command: ${cmd[*]}"

  local cmdOutputFile="${ROOT_DIR}/clusterStatus.log"

  local startTime
  local currentTime
  local endTime

  startTime="$(date +%s)"
  currentTime="${startTime}"

  # If we have a broadcast heartbeat address then we can use a shorted cluster
  # cross-connect than if we were using a multicast address.
  local xconnectTimeout
  local heartbeatAddress
  heartbeatAddress="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HEARTBEAT_ADDRESS_KEY}")"

  if [ "${heartbeatAddress}" = "${HEARTBEAT_BROADCAST}" ]; then
    xconnectTimeout="${DEFAULT_CLUSTER_XCONNECT_BROADCAST_TIMEOUT}"
  else
    xconnectTimeout="${DEFAULT_CLUSTER_XCONNECT_MULTICAST_TIMEOUT}"
  fi

  if [ "${xconnectTimeout}" -ge 0 ]; then
    endTime="$((startTime + xconnectTimeout))"
  else
    # No timeout. Let's set a really big value instead. Say, one day.
    endTime="$((startTime + 86400))"
  fi

  # An array of non-cross-connected node names
  local -a nonXConnectedNodes=()

  while [ "${currentTime}" -le "${endTime}" ]; do
    currentTime="$(date +%s)"

    # Run the status command but if it doesn't return after 10 seconds then
    # kill the process. If the process is killed then the exit status will be 124
    # so we can explicitly check for that.
    timeout -k 10s 10s "${cmd[@]}" 1>"${cmdOutputFile}" 2>&1 &
    local cmdExitStatus
    cmdExitStatus=0
    wait $! || cmdExitStatus="$?"

    if [ "${cmdExitStatus}" -eq 124 ]
    then
      errorExit "The cluster status command timed out on RapidsSE. The appropriate TCP and UDP ports may not have been opened in the firewall. Please refer to the log files of each node as well as the output file for this cluster status operation (${cmdOutputFile}). The script ./${COLLECTLOGS_SCRIPT} can be used to gather all log files."

    elif [ "${cmdExitStatus}" -ne 0 ]
    then
      errorExit "Could not get the status of the RapidsSE cluster. Please refer to the log files of each node as well as the output file for this cluster status operation (${cmdOutputFile}). The script ./${COLLECTLOGS_SCRIPT} can be used to gather all log files."
    fi

    # We got some status information, but are all of the nodes cross-connected?
    nonXConnectedNodes=()
    local nonXConnOutput

    if ! nonXConnOutput="$(getNonXConnectedNodes "${cmdOutputFile}")" ; then
      errorExit "Cluster startup failed during node cross-connect"
    fi

    if [ -z "${nonXConnOutput:-}" ]; then
      # Success. Every node is cross connected
      rm -f "${cmdOutputFile}" 2>/dev/null
      echo "Done"
      return
    fi

    while IFS='' read -r line; do nonXConnectedNodes+=("${line}"); done <<<"${nonXConnOutput}"

    # Did we validate that each node cross connected, or did we time out?
    if [ "${nonXConnectedNodes[*]:-x}" = "x" ] || [ "${#nonXConnectedNodes[@]}" -eq 0 ]; then
      # Success. Every node is cross connected
      rm -f "${cmdOutputFile}" 2>/dev/null
      echo "Done"
      return
    fi

    # There are still nodes that haven't connected yet. Give them a bit of time and try again.
    sleep 1
  done;

  # We must have timed out waiting for all nodes to cross connect.
  # Let's print which ones are affected.
  local errMsg
  echo "Timed out"
  errMsg="The following nodes did not cross-connect to other nodes in the cluster:\n"

  for row in "${nonXConnectedNodes[@]}" ; do
    local hostName
    hostName="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
    errMsg+="$(printf "  Node: %-32s  %s\n" "${row}" "[host ${hostName}]")"
  done

  errMsg+="Please check that the appropriate TCP and UDP ports have been opened in the firewall for each host."

  errorExit "${errMsg}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a the node names that haven't been cross-connected, one per line.
## Read the output of this command into an array like this:
##    myArray=()
##    while IFS='' read -r line; do myArray+=("${line}"); done < <(getNonXConnectedNodes "${cmdOutputFile}")
## Returns a non-zero exit code if something goes wrong
## Params:
##  $1 : Name of the file with the output of the status command to be parsed
function getNonXConnectedNodes() {

  local filename="$1"

  if [ -z "${filename:-}" ]; then
    errorExit "function getNonXConnectedNodes() called without a filename parameter"
  fi

  # Get the first, fourth and fifth columns. When we get the row these will be
  # the 1st, 2nd and 3rd values respectively.
  local -a interestedColumns=("1" "4" "5")

  local -a nodes=( "${NODE_LIST[@]}" )

  local numElements
  numElements="${#nodes[@]}"

  # Parse the output of the status command
  local rows
  if ! rows="$(parseRowData "${filename}" "${interestedColumns[@]}")" ; then
    false
    return
  fi

  while IFS='' read -r row; do

    if [ -z "${row:-}" ] ; then
      continue
    fi

    # Extract out the desired column and remove string quotes
    local hasSendSocket
    local hasRecvSocket
    local nodeName

    nodeName="$(getColumn "${row}" "1")"        # The first  column from the original row
    hasSendSocket="$(getColumn "${row}" "2")"   # The fourth column from the original row
    hasRecvSocket="$(getColumn "${row}" "3")"   # The fifth  column from the original row

    if [ "${hasSendSocket:-x}" != "true" ] || [ "${hasRecvSocket:-x}" != "true" ] ; then
      # This node hasn't properly cross-connected yet.
      continue
    fi

    # Is this nodeName in ${nodes[@]}? If so, remove that element
    for (( i=0; i<numElements; i++ )); do
      if [ "${nodeName:-__x}" = "${nodes[$i]}" ]; then
        unset 'nodes[i]'
        break
      fi
    done
  done <<<"${rows}"

  # Print out each non-null (unset) element in the array
  for node in "${nodes[@]}" ; do
    if [ -v "node" ] && [ -n "${node:-}" ] ; then
      echo "${node}"
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Issues a "rebalance" command to the local SE instance. This forces all nodes
## to rebalance the data across all nodes.
## All nodes in the cluster must have already been started successfully.
## This must be called from any node that is participating in the cluster.
## Returns a non-zero exit code if the rebalance fails.
