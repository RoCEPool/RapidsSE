# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints whether each node in the cluster is running or not.
## Returns a zero exit code if all nodes are running or a non-zero exit code
## if any of the nodes are not running.
## Params: None

function printClusterStatus() {
  local row
  local host
  local pid
  local statusStr
  local errorCount=0

  echo "Cluster status:"
  
  for row in "${NODE_LIST[@]}"
  do
    host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"

    pid="$(getRemoteRunningPid "${row}")"

    if [ -n "${pid:-}" ]  && [ "${pid}" -gt 0 ]; then

      # Node is running, but is it ready?
      if isRemoteSeReady "${row}"; then
        statusStr="running (pid ${pid})"
      else
        statusStr="started (pid ${pid}) but not ready"
        errorCount=$((errorCount+1))
      fi

    else
      statusStr="NOT RUNNING"
      errorCount=$((errorCount+1))
    fi

    printf "  %-30s  %s\n" "${row} (host ${host}) :" "${statusStr}"
  done

  if [ "${errorCount}" -gt 0 ]; then
    local runningCount=$(( ${#NODE_LIST[@]} - errorCount ))

    # grammar nazi
    if [ "${runningCount}" -eq 1 ]; then 
      echo -n "${runningCount} node out of ${#NODE_LIST[@]} is running. "
    else
      echo -n "${runningCount} nodes out of ${#NODE_LIST[@]} are running. "
    fi

    if [ "${errorCount}" -eq 1 ]; then
      echo "${errorCount} node is stopped."
    else
      echo "${errorCount} nodes are stopped."
    fi

    false
    return

  else
    echo "All nodes are running."
    true
    return
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints a message whether the current node is running or not.
## Params: None

function printNodeStatus() {
  if [ ! -f "${PIDFILE}" ]; then
    echo "${CURRENT_NODE_NAME} is not running."
    return
  fi

  local pid
  pid="$(xargs ps -o pid -h -p < "${PIDFILE}")"
 
  local re="[0-9]+"

  if [[ "${pid}" =~ $re ]]; then
    echo "${CURRENT_NODE_NAME} is running (pid ${pid})."
  else
    echo "${CURRENT_NODE_NAME} is not running."
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns the PID of the SE process running on the current node, or an
## empty string if the process is not running. It's not enough to just read
## the pidfile, we actually need to check if the pid is active in the system.
## To be called with:  pid="$(getLocalRunningPid)"
##
## Params: None

function getLocalRunningPid() {

  local pid

  # Does the pid file exist
  if [ ! -f "${PIDFILE}" ]; then
    return
  fi

  pid="$(xargs ps -o pid -h -p  < "${PIDFILE}" )"

  local re="^[[:space:]]*([0-9]+)[[:space:]]*$"

  if [[ "${pid}" =~ $re ]]; then
    pid="${BASH_REMATCH[1]}"
  else
   pid=""
  fi

  echo "${pid}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a zero exit status if the local SE node is running, otherwise it 
## returns a non-zero exit status if it is not running
## Params: None

function isLocalSeRunning() {
  local pid

  pid="$(getLocalRunningPid)"

  if [ -n "${pid:-}" ]; then
    true
    return

  else
    false
    return
  fi
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a zero exit status if ANY of the SE nodes in the cluster are running,
## otherwise it returns a non-zero exit status if ALL nodes are NOT running.
## Params: None

function isClusterRunning() {

  for row in "${NODE_LIST[@]}"; do

    pid="$(getRemoteRunningPid "${row}")"

    if [ -n "${pid:-}" ]; then
      true
      return
    fi
  done

  false
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Checks that none of the nodes are currently running. If one or more nodes
## are actually running then errors are printed to stderr and a non-zero
## exit code is returned.
## Params: 
##  $1 : (optional) if set to "stop" then it formats the error message for
##       asserting that there are no more nodes running after a stop operation.

function assertNoNodesRunning() {
  
  local row
  local pid
  local gotError=0

  local errMsg="The following node are already running:"

  if [ "$1" = "stop" ]; then
    errMsg="The following node are still running:"
  fi

  for row in "${NODE_LIST[@]}"
  do
    pid="$(getRemoteRunningPid "${row}")"

    if [ -n "${pid:-}" ]; then
      gotError=1
      errMsg="${errMsg}\n  ${row}  (pid: ${pid})"
    fi
  done

  if [ ${gotError} -eq 1 ]; then
    printError "${errMsg}"
    false
    return
  fi

  true
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that all nodes have the same version string. If not, write to stderr
## and return a non-zero exit code. If true then write the valid version string
## to stdout and exit with a zero exit code.
## Params: None

function checkNodeVersionsAreEqual() {

  local row
  local host
  local dir
  local remoteCmd
  local actualVerStr
  local expectedVerStr
  local firstNode
  local re="^[0-9]+.[0-9]+.[0-9]+.*$"

  for row in "${NODE_LIST[@]}"
  do
    host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
    dir="$(nodeCfgGetValue "${row}" "${NODE_CFG_DIR_KEY}")"

    remoteCmd="cd \"${dir}\" && source \"${VERSION_FILE}\" && echo \"\${SE_VERSION_STR}-\${SE_COMMIT_HASH}\""
    actualVerStr="$(ssh -q "${host}" "bash" "-c" "'${remoteCmd}'")"

    if [ -z "${actualVerStr:-}" ]; then
      printError "Got an empty version string for ${row}."
      false
      return
    fi

    if [[ ! "${actualVerStr}" =~ $re ]]; then
      printError "Got an unrecognised version string for ${row}."
      false
      return
    fi

    # if the expected version string is not set, then set it.
    if [ -z "${expectedVerStr:-}" ]; then
      expectedVerStr="${actualVerStr}"
      firstNode="${row}"
      continue
    fi

    # Otherwise compare actual to expected
    if [ "${actualVerStr}" != "${expectedVerStr}" ]; then
      printError "SE version on node ${row} (${actualVerStr}) does not match the version on node ${firstNode} (${expectedVerStr})."
      false
      return
    fi
  done

  # Otherwise we're all good
  echo "${expectedVerStr}"
  true
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Stops RapidsSE on all nodes in the cluster.
## Params: None

function stopCluster() {
  
  echo "Stopping the RapidsSE cluster."

  if [ -n "${SEQ_START:-}" ]; then
    # Stop the nodes sequentially
    for row in "${NODE_LIST[@]}"
    do
      debugPrint "Stopping ${row}"
      stopRemoteNode "${row}" || errorExit "Could not stop all nodes in the cluster."
    done

  else
    # Stop the nodes in parallel. Ignore all output.
    for row in "${NODE_LIST[@]}"
    do
      stopRemoteNode "${row}" &>/dev/null &
    done

    # Wait for all parallel jobs to finish.
    wait || true
  fi

  echo -n "Stopping all ${#NODE_LIST[@]} nodes in the cluster. Waiting for them to shutdown."

  # Check every second to see if there are any nodes still running, up to 10 secs.
  local counter=0
  while [ "${counter}" -lt 10 ]
  do
    if assertNoNodesRunning "stop" &>/dev/null; then
      break
    fi

    sleepProgressPrint 1
    ((counter++))
  done

  echo ""

  # Final check (as we may have timed out above).
  if ! assertNoNodesRunning "stop"; then
    echo "Could not stop all nodes in the cluster."
  else
    echo "Stopped all nodes in the cluster."
  fi
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Remotely stops specific RapidsSE nodes based on the node names provided.
## Params:
##  $@ : The names of the nodes to be stopped.

function stopRemoteNodes() {

  [ "$#" -ge 1 ] || errorExit "Function ${FUNCNAME[0]} must be called with at least one argument."

  local -a nodeNames=("$@")

  for nodeName in "${nodeNames[@]}"; do
    stopRemoteNode "${nodeName}"
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Remotely stopss RapidsSE on a node given by the row parameter.
## Params: 
##  $1 : The name of the node to be stopped.

function stopRemoteNode() {

  local row="$1"

  local host
  local dir
  local remoteCmd
  local sshCmd

  host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
  dir="$(nodeCfgGetValue "${row}" "${NODE_CFG_DIR_KEY}")"

  remoteCmd="cd \"${dir}\" && ./${STOP_SCRIPT} --node"

  if [ "${DEBUG}" -eq 1 ]; then
    remoteCmd="${remoteCmd} --debug"
  fi

  sshCmd=( "ssh" "-q" "${host}" "bash" "-c" "'${remoteCmd}'" )

  debugPrint "About to stop node ${row} with the command: ${sshCmd[*]}"

  "${sshCmd[@]}" || errorExit "Could not stop RapidsSE on node ${row}."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Stops RapidsSE on the current node only.
## Params: None

function stopCurrentNode() {

  # Get all of the settings for the current node
  local host
  host="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HOST_KEY}")"


  if [ ! -f "${EXE}" ]; then
    errorExit "Cannot stop RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}] because the executable cannot be found at: ${EXE}"
  fi


  if [ -f "${PIDFILE}" ]; then
    # Stop SE gracefully and then wait until the pid is no longer active.
  
    local pid
    pid="$(cat "${PIDFILE}")" 2>/dev/null

    declare -a stopCmd=()

    if which timeout &>/dev/null; then
      # Set a 10s timeout after which a SIGTERM and then a SIGKILL is
      # applied to the SE prompt process.
      # This is to prevent the SE prompt from hanging.
      stopCmd+=("timeout" "--kill-after=20" "10s")
    fi

    stopCmd+=("${EXE}")
    stopCmd+=("--name")
    stopCmd+=("${CURRENT_NODE_NAME}")
    stopCmd+=("--stop")
    stopCmd+=("--commands")
    stopCmd+=("${ROOT_DIR}/commands")
    stopCmd+=("--appendTrace")


    if [ "${DEBUG}" -eq 1 ]; then
      echo "Stopping RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}] with the command:"
      echo "  ${stopCmd[*]}"

    else
      echo "Stopping RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}]..."
    fi

    echo "Stopping SE at $(date +%FT%T)" >> "${LOG_FILE}"

    "${stopCmd[@]}" &

    
    # Now we wait for the process to stop, periodically checking if the 
    # pid has vanished.

    local counter=0
    local exitSleepTime
    local exitGiveUpTime
    local exitIterations

    exitSleepTime="0.2"   # How long to sleep (in seconds) between checking if the pid has exited.
    exitGiveUpTime="5"    # After this time (in seconds) just kill the pid.
    exitIterations="$(bc <<< "${exitGiveUpTime} / ${exitSleepTime}")"

    while ps -p "${pid}" &> /dev/null
    do
      if [ "${counter}" -ge "${exitIterations}" ]; then
        break;
      fi

      (( counter++ ))
      sleep "${exitSleepTime}"
    done   

    # Check again that the process has been stopped. If it hasn't then we shall kill it.
    if ps -p "${pid}" &> /dev/null; then    # Exit code 0 means se is still running. 

      echo "Killing RapidsSE process ${pid} on node ${CURRENT_NODE_NAME}."
      kill -9 "${pid}" &>/dev/null
    fi

    # Remove the pid file and ready file
    rm -f "${PIDFILE}" "${READYFILE}" &>/dev/null

  else 
    # The pidfile does not exist.
    # Kill by process name, restricted to processes owned by the current user.
    # We need to set the next 2 variables to avoid "illegal byte sequence" errors.
    echo "PID file missing on node ${CURRENT_NODE_NAME} [host ${host}], so stopping RapidsSE by killing all processes by that name."
    export LC_CTYPE=C
    export LANG=C

    pkill -u $UID -x "$(basename "${EXE}")" 2>/dev/null

    # Remove the ready file
    rm -f "${READYFILE}" &>/dev/null
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

