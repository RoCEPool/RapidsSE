#!/bin/bash
# This file contains function definitions that are imported and used by the
# cluster start and stop scripts.

# Guard against this file being executed directly.
if [ "${BASH_SOURCE[0]}" -ef "$0" ]
then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

# Load other common functions
COMMON_FN="common.fn"

if [ -n "${DIR:-}" ]; then
  COMMON_FN="${DIR}/${COMMON_FN}"
fi

if [ -z "${__COMMON_FN:-}" ] ; then
  #shellcheck source=common.fn
  source "${COMMON_FN}" || { >&2 echo "Could not load ${COMMON_FN}"; exit 1; }
fi

###############################################################################
### Constants                                                               ###
###############################################################################
# Variable that can be tested to see if we have already sourced this file
readonly __BOOT_FN=1

readonly EXE_DIR="${ROOT_DIR}/bin"
readonly EXE="${EXE_DIR}/rapidsse"

readonly NOHUP_FILE="${ROOT_DIR}/se.log"
readonly PIDFILE="${ROOT_DIR}/${PID_FILENAME}"
readonly READYFILE="${ROOT_DIR}/${READY_FILENAME}"

readonly START_SCRIPT="startSE.sh"
readonly STOP_SCRIPT="stopSE.sh"
#readonly STATUS_SCRIPT="status.sh"
readonly COLLECTLOGS_SCRIPT="collectLogs.sh"

readonly DEFAULT_BOOT_TIMEOUT="60" # seconds
readonly DEFAULT_CLUSTER_XCONNECT_TIMEOUT="15" # seconds

###############################################################################
### Functions                                                               ###
###############################################################################

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints out the valid arguments to the start & stop scripts and exits.
## Params: None
## Note: The variable ${SCRIPT_NAME} must be defined as the name of the start
##       or stop script filename.

function printStartStopUsageAndExit() {

  echo ""
  echo "Usage: ./${SCRIPT_NAME} [--cluster | --node]"
  echo "                    [--config <file>]"
  echo "                    [--debug]"
  echo "Details:"
  echo "  --cluster         [Default] Starts all nodes in the cluster."
  echo "  --node            Starts the current node only."
  echo ""
  echo "  --config <file>   Uses a given cluster configuration file."
  echo "                    Default is: ${CONFIG_FILE}"
  echo ""
  echo "  --debug           Displays additional debugging messages during execution."
  echo ""
  echo "  --clusterinit     Internal use only."
  echo ""
  echo "  --help            Displays this message."
  exit 1
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Process the arguments for the start and stop scripts.
## Params: None

function processStartStopArgs() {

  # Check that some globals are specified with defaults
  if [ -z "${CLUSTER_OP:-}" ];   then errorExit "No default value for \$CLUSTER_OP specified"; fi;
  if [ -z "${CLUSTER_INIT:-}" ]; then errorExit "No default value for \$CLUSTER_INIT specified"; fi;

  # Indicates if a given argument was specified.
  local argCluster=0
  local argNode=0
  local argConfig=0
  #local argClusterInit=0

  while [[ $# -gt 0 ]]
  do
    key="$1"
    case "${key}" in

      --cluster)
        CLUSTER_OP=1
        argCluster=1
        shift # past argument
        ;;

      --node)
        CLUSTER_OP=0
        argNode=1
        shift # past argument
        ;;

      --config)
        argConfig=1
        CONFIG_FILE="$2"
        shift # past argument
        shift # past value
        ;;

      --config=*)
        argConfig=1
        CONFIG_FILE="${key#*=}"
        shift # past argument=value
        ;;

      --debug)
        DEBUG=1
        shift # past argument
        ;;

      --clusterinit)
        #argClusterInit=1
        CLUSTER_INIT=1
        shift # past argument
        ;;

      --help|-h)
        shift
        printStartStopUsageAndExit
        ;;

      *)
        shift
        printStartStopUsageAndExit
        ;;
    esac
  done

  # Now we can check for invalid combinations of arguments.
    # --cluster     and --node
    # --config      and no file specified

  local errmsg="Invalid combination of arguments specified: "

  if [[ ${argCluster} -eq 1  && ${argNode} -eq 1 ]]; then
    printError "${errmsg}" "--cluster" "--node"
    printStartStopUsageAndExit
  fi

  if [[ ${argConfig} -eq 1 && -z "${CONFIG_FILE:-}" ]]; then
    printError "${errmsg}" "No config file specified"
    printStartStopUsageAndExit
  fi

  # Check that the config file exists
  if [[ ! -f "${CONFIG_FILE}" ]]; then
    printError "Config file does not exist: ${CONFIG_FILE}"
    printStartStopUsageAndExit
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Starts RapidsSE on all nodes in the cluster.
## Params: None

function startCluster() {

  echo -n "Checking node versions..."

  # Check that all nodes are the same version.
  local verStr
  if ! verStr="$(checkNodeVersionsAreEqual)"; then
    errorExit "Could not start the RapidsSE cluster."
  fi

  echo "All nodes are running the same version: ${verStr}"

  # Check if any nodes are already running
  assertNoNodesRunning "" || errorExit "Could not start the RapidsSE cluster."

  echo "Starting the RapidsSE cluster."
  local row

  if [ -n "${SEQ_START:-}" ]; then
    # Start the nodes sequentially
    for row in "${NODE_LIST[@]}"
    do
      debugPrint "Starting ${row}"
      startRemoteNode "${row}" || errorExit "Could not start all nodes in the cluster."
    done

  else
    # Start the nodes in parallel. Ignore all output.
    for row in "${NODE_LIST[@]}"
    do
      startRemoteNode "${row}" &>/dev/null &
    done

    # Wait for all parallel jobs to finish.
    wait
  fi

  echo "Started all ${#NODE_LIST[@]} nodes in the cluster. Waiting for them to boot"

  # Wait for all nodes to boot and become ready
  if [ -z "${BOOT_TIMEOUT:-}" ]; then
    BOOT_TIMEOUT="${DEFAULT_BOOT_TIMEOUT}"
  fi

  # We want to wait for the cluster to boot up, but timeout if it takes
  # too long. We can't call the timeout command because it expects an 
  # argument which is a command and not a bash function.
  # So we will call waitForClusterBoot in the background and then create
  # another background subshell task that sleeps for the desired timeout
  # and tries to kill the waitForClusterBoot task. If the waitForClusterBoot
  # task returns early then we kill the "killer" task instead.
  # Inspiration from here:  https://stackoverflow.com/a/22384727
  
  waitForClusterBoot &
  local bootWaitPid="$!"

  # The timeout killer
  ( 
    sleep "${BOOT_TIMEOUT}"
    echo "Cluster boot timed out" 
    kill -0 "${bootWaitPid}" &>/dev/null && kill "${bootWaitPid}" &>/dev/null
  ) &

  local killerPid="$!"

  wait "${bootWaitPid}" 2>/dev/null
  kill -0 "${killerPid}" &>/dev/null && kill "${killerPid}" &>/dev/null
  # We wait here and redirect stderr because it will print a message indicating that
  # the subprocess was terminated. We want to suppress that.
  # The actual kill command above simply sends a signal and does not wait for the
  # process to exit.
  wait "${killerPid}" 2>/dev/null
  
  echo ""

  if printClusterStatus; then

    # Initialise the cluster
    remoteClusterInit

    echo "Cluster startup complete."
    true

  else
    echo "Cluster startup failed. Please stop the cluster before restarting it."
    false
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Remotely starts RapidsSE on a node given by the row parameter.
## Params: 
##  $1 : The name of the node to be started.

function startRemoteNode() {

  local row="$1"

  local host
  local dir
  local remoteCmd

  host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
  dir="$(nodeCfgGetValue "${row}" "${NODE_CFG_DIR_KEY}")"

  remoteCmd="cd ${dir} && ./${START_SCRIPT} --node"

  if [ ${DEBUG} -eq 1 ]; then
    remoteCmd="${remoteCmd} --debug"
  fi

  sshCmd=( "ssh" "-q" "${host}" "bash" "-c" "'${remoteCmd}'" )

  debugPrint "About to start node ${row} with the command: ${sshCmd[*]}"

  "${sshCmd[@]}" || errorExit "Could not start RapidsSE on node ${row}."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Starts RapidsSE on the current node only.
## Params: None

function startCurrentNode() {
 
  # Remove the nohup.out file if it exists
  rm "${NOHUP_FILE}" &>/dev/null
 
  # Get all of the settings for the current node
  local host
  local port
  local heartbeat 
  local dir
  local partitions
  local threads
  local mem
  local clusterId
  local params

  host="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HOST_KEY}")"
  port="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_PORT_KEY}")"
  heartbeat="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HEARTBEAT_KEY}")"
  dir="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_DIR_KEY}")"
  partitions="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_PARTITIONS_KEY}")"
  threads="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_THREADS_KEY}")"
  mem="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_MEM_KEY}")"
  clusterId="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_CLUSTERID_KEY}")"
  params="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_PARAMS_KEY}")"

  # params above is a string. Let's turn it into an array based on spaces.
  declare -a paramsArray=()
  IFS=' ' read -r -a paramsArray <<< "${params}"

  declare -a startCmd=()
  startCmd+=("nohup")
  startCmd+=("${EXE}")
  startCmd+=("--partitionsPerNode")
  startCmd+=("${partitions}")
  startCmd+=("--threads")
  startCmd+=("${threads}")
  startCmd+=("--size")
  startCmd+=("${mem}GB")
  startCmd+=("--node")
  startCmd+=("${CURRENT_NODE_NAME}")
  startCmd+=("${host}")
  startCmd+=("${port}")
  startCmd+=("--name")
  startCmd+=("${CURRENT_NODE_NAME}")
  startCmd+=("--start")
  startCmd+=("--munged")
  startCmd+=("--script")
  startCmd+=("--metadata")
  startCmd+=("--commands")
  startCmd+=("${ROOT_DIR}/commands")
  startCmd+=("--cid")
  startCmd+=("${clusterId}")
  startCmd+=("--heartbeat")
  startCmd+=("BROADCAST")
  startCmd+=("${heartbeat}")
  startCmd+=("${paramsArray[@]}")


  # Set the library path so the RapidsSE library can be found and loaded
  export LD_LIBRARY_PATH="${EXE_DIR}:${LD_LIBRARY_PATH}"

  # SE environment variables
  export SE_ENV_METACLUE=1
  export SE_ENV_INTKEY=1


  if [ ${DEBUG} -eq 1 ]; then
    echo "Starting RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}] with the command:"
    echo "  ${startCmd[*]}"

  else 
    echo "Starting RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}]..."
  fi

  echo "Starting SE at $(date +%FT%T)" >> "${NOHUP_FILE}"

  "${startCmd[@]}" >> "${NOHUP_FILE}" 2>&1 & 

  # get the last pid and save it to a file
  PID=$!
  echo "${PID}" > "${PIDFILE}"

  echo "[Start script]: RapidsSE started as PID ${PID}." >> "${NOHUP_FILE}"
  echo "[Start script]: RapidsSE started with the command:   ${startCmd[*]}" >> "${NOHUP_FILE}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Waits for all nodes in the cluster to boot and report that they are ready.
## There is no timeout here. 
## Prints a "." for every second it waits
## Params: None

function waitForClusterBoot() {

  local dotPid

  echo -n "Waiting for cluster to boot: "

  # Print dots to indicate progress
  ( 
    while true; do
      printf ". "
      sleep 1
    done
  ) &

  dotPid=$!

  # If we run this function as a subshell and then kill it, we need to also
  # ensure that we kill the dot printer above.
  #shellcheck disable=SC2064
  trap "kill -0 ${dotPid} &>/dev/null && kill ${dotPid} &>/dev/null && wait ${dotPid} 2>/dev/null" SIGINT SIGHUP SIGTERM EXIT

  # Give a couple of seconds for SE to attempt to start up on each node.
  # If we don't then it may look like it isn't running.
  sleep 2

  for row in "${NODE_LIST[@]}"; do

    while true; do
      # If SE is not running then stop waiting
      if [ -z "$(getRemoteRunningPid "${row}")" ]; then
        debugPrint "Node ${row} is not running"
        break;
      fi

      # If SE is ready then stop waiting
      if isRemoteSeReady "${row}" ; then
        break
      fi

      debugPrint "Node ${row} is not ready"
      sleep 1
    done

  done

  kill "${dotPid}" &>/dev/null
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns an array of strings representing the node name/host/port arguments 
## for the cluster. This can be called by executing:
##   declare -a nodeArgs
##   IFS=" " read -r -a nodeArgs <<< "$(buildNodeArguments)"
## Params: None

function buildNodeArguments() {

  declare -a nodeArgs=()
  local host
  local port

  for row in "${NODE_LIST[@]}"
  do
    host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
    port="$(nodeCfgGetValue "${row}" "${NODE_CFG_PORT_KEY}")"

    nodeArgs+=("--node" "${row}" "${host}" "${port}")
  done
 
  echo "${nodeArgs[@]}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Initiates all of the nodes that were launched in the cluster. All nodes in
## the cluster must have already been started successfully. This calls the
## first node in the cluster to start the initialisation.
## Params: None

function remoteClusterInit() {

  local row
  local host
  local dir
  local remoteCmd

  # Let's use the first node in the list
  row="${NODE_LIST[0]}"
  host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
  dir="$(nodeCfgGetValue "${row}" "${NODE_CFG_DIR_KEY}")"

  remoteCmd="cd ${dir} && ./${START_SCRIPT} --node --clusterinit"

  if [ ${DEBUG} -eq 1 ]; then
    remoteCmd="${remoteCmd} --debug"
  fi

  sshCmd=( "ssh" "-q" "${host}" "bash" "-c" "'${remoteCmd}'" )

  debugPrint "About to initialise the cluster on node ${row} with the command: ${sshCmd[*]}"

  "${sshCmd[@]}" || errorExit "Could not initialise the RapidsSE cluster on node ${row} [host ${host}]."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Waits for all of the nodes that were launched in the cluster to discover 
## each other. All nodes in the cluster must have already been started 
## successfully. This must be called from any node that is participating in the 
## cluster.
## Params: None

function localClusterInit() {
  echo -n "Waiting for the cluster to cross-connect..."

  if [ -z "${CURRENT_NODE_NAME:-}" ]; then
    errorExit "The name of the local node has not been loaded."
  fi

  local host
  host="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HOST_KEY}")"

  local statusCmd="status"

  declare -a cmd=()
  cmd+=("${EXE}")
  cmd+=("--name")
  cmd+=("${CURRENT_NODE_NAME}")
  cmd+=("--munged")
  cmd+=("--script")
  cmd+=("--commands")
  cmd+=("${ROOT_DIR}/commands")
  cmd+=("--command")
  cmd+=("${statusCmd}")
  cmd+=("--appendTrace")

  debugPrint "\nAbout to execute the cluster status command: ${cmd[*]}"

  # Set the library path so the RapidsSE library can be found and loaded
  export LD_LIBRARY_PATH="${EXE_DIR}:${LD_LIBRARY_PATH}"

  local cmdOutputFile="${ROOT_DIR}/clusterStatus.log"

  local startTime
  local currentTime
  local endTime

  startTime="$(date +%s)"
  currentTime="${startTime}"
  endTime="$((startTime + DEFAULT_CLUSTER_XCONNECT_TIMEOUT))"

  # An array of non-cross-connected node names
  local -a nonXConnectedNodes=()

  while [ "${currentTime}" -le "${endTime}" ]; do
    currentTime="$(date +%s)"

    # Run the status command but if it doesn't return after 10 seconds then
    # kill the process. If the process is killed then the exit status will be 124
    # so we can explicitly check for that.
    timeout -k 10s 10s "${cmd[@]}" 1>"${cmdOutputFile}" 2>&1 &
    wait $!
    local cmdExitStatus="$?"

    if [ "${cmdExitStatus}" -eq 124 ]
    then
      errorExit "The cluster status command timed out on RapidsSE. RapidsSE may have crashed. Please refer to the log files of each node as well as the output file for this cluster status operation (${cmdOutputFile}). The script ./${COLLECTLOGS_SCRIPT} can be used to gather all log files."

    elif [ "${cmdExitStatus}" -ne 0 ]
    then
      errorExit "Could not get the status of the RapidsSE cluster. Please refer to the log files of each node as well as the output file for this cluster status operation (${cmdOutputFile}). The script ./${COLLECTLOGS_SCRIPT} can be used to gather all log files."
    fi

    # We got some status information, but are all of the nodes cross-connected?
    nonXConnectedNodes=()
    local nonXConnOutput

    if ! nonXConnOutput="$(getNonXConnectedNodes "${cmdOutputFile}")" ; then
      errorExit "Cluster startup failed during node cross-connect"
    fi

    if [ -z "${nonXConnOutput:-}" ]; then
      # Success. Every node is cross connected
      rm -f "${cmdOutputFile}" 2>/dev/null
      echo "Done"
      return
    fi

    while IFS='' read -r line; do nonXConnectedNodes+=("${line}"); done <<<"${nonXConnOutput}"

    # Did we validate that each node cross connected, or did we time out?
    if [ ! -v "nonXConnectedNodes[@]" ] || [ "${#nonXConnectedNodes[@]}" -eq 0 ]; then
      # Success. Every node is cross connected
      rm -f "${cmdOutputFile}" 2>/dev/null
      echo "Done"
      return
    fi

    # There are still nodes that haven't connected yet. Give them a bit of time and try again.
    sleep 1
  done;

  # We must have timed out waiting for all nodes to cross connect.
  # Let's print which ones are affected.
  local errMsg
  echo "Timed out"
  errMsg="The following nodes did not cross-connect to other nodes in the cluster:\n"

  for row in "${nonXConnectedNodes[@]}" ; do
    local hostName
    hostName="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
    errMsg+="$(printf "  Node: %-32s  %s\n" "${row}" "[host ${hostName}]")"
  done

  errorExit "${errMsg}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a the node names that haven't been cross-connected, one per line.
## Read the output of this command into an array like this:
##    myArray=()
##    while IFS='' read -r line; do myArray+=("${line}"); done < <(getNonXConnectedNodes "${cmdOutputFile}")
## Returns a non-zero exit code if something goes wrong
## Params:
##  $1 : Name of the file with the output of the status command to be parsed
function getNonXConnectedNodes() {

  local filename="$1"

  if [ -z "${filename:-}" ]; then
    errorExit "function getNonXConnectedNodes() called without a filename parameter"
  fi

  #local -a interestedColumns=("1" "3")  # first and third columns
  local -a interestedColumns=("1")
  local -a nodes=( "${NODE_LIST[@]}" )

  local numElements
  numElements="${#nodes[@]}"

  # Parse the output of the status command
  local rows
  if ! rows="$(parseRowData "${filename}" "${interestedColumns[@]}")" ; then
    false
    return
  fi

  while IFS='' read -r row; do

    if [ -z "${row:-}" ] ; then
      continue
    fi

    # Extract out the desired column and remove string quotes
    local nodeName
    nodeName="$(getColumn "${row}" "1")"

    # Is this nodeName in ${nodes[@]}? If so, remove that element
    for (( i=0; i<numElements; i++ )); do
      if [ "${nodeName}" = "${nodes[$i]}" ]; then
        unset 'nodes[i]'
        break
      fi
    done
  done <<<"${rows}"

  # Print out each non-null (unset) element in the array
  for node in "${nodes[@]}" ; do
    if [ -v "node" ] && [ -n "${node:-}" ] ; then
      echo "${node}"
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints whether each node in the cluster is running or not.
## Returns a zero exit code if all nodes are running or a non-zero exit code
## if any of the nodes are not running.
## Params: None

function printClusterStatus() {
  local row
  local host
  local pid
  local statusStr
  local errorCount=0

  echo "Cluster status:"
  
  for row in "${NODE_LIST[@]}"
  do
    host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"

    pid="$(getRemoteRunningPid "${row}")"

    if [ -n "${pid:-}" ]  && [ "${pid}" -gt 0 ]; then

      # Node is running, but is it ready?
      if isRemoteSeReady "${row}"; then
        statusStr="running (pid ${pid})"
      else
        statusStr="started (pid ${pid}) but not ready"
        errorCount=$((errorCount+1))
      fi

    else
      statusStr="NOT RUNNING"
      errorCount=$((errorCount+1))
    fi

    printf "  %-30s  %s\n" "${row} (host ${host}) :" "${statusStr}"
  done

  if [ "${errorCount}" -gt 0 ]; then
    local runningCount=$(( ${#NODE_LIST[@]} - errorCount ))

    # grammar nazi
    if [ "${runningCount}" -eq 1 ]; then 
      echo -n "${runningCount} node out of ${#NODE_LIST[@]} is running. "
    else
      echo -n "${runningCount} nodes out of ${#NODE_LIST[@]} are running. "
    fi

    if [ "${errorCount}" -eq 1 ]; then
      echo "${errorCount} node is stopped."
    else
      echo "${errorCount} nodes are stopped."
    fi

    false
    return

  else
    echo "All nodes are running."
    true
    return
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints a message whether the current node is running or not.
## Params: None

function printNodeStatus() {
  if [ ! -f "${PIDFILE}" ]; then
    echo "${CURRENT_NODE_NAME} is not running."
    return
  fi

  local pid
  pid="$(xargs ps -o pid -h -p < "${PIDFILE}")"
 
  local re="[0-9]+"

  if [[ "${pid}" =~ $re ]]; then
    echo "${CURRENT_NODE_NAME} is running (pid ${pid})."
  else
    echo "${CURRENT_NODE_NAME} is not running."
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns the PID of the SE process running on the current node, or an
## empty string if the process is not running. It's not enough to just read
## the pidfile, we actually need to check if the pid is active in the system.
## To be called with:  pid="$(getLocalRunningPid)"
##
## Params: None

function getLocalRunningPid() {

  local pid

  # Does the pid file exist
  if [ ! -f "${PIDFILE}" ]; then
    return
  fi

  pid="$(xargs ps -o pid -h -p  < "${PIDFILE}" )"

  local re="^[[:space:]]*([0-9]+)[[:space:]]*$"

  if [[ "${pid}" =~ $re ]]; then
    pid="${BASH_REMATCH[1]}"
  else
   pid=""
  fi

  echo "${pid}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a zero exit status if the local SE node is running, otherwise it 
## returns a non-zero exit status if it is not running
## Params: None

function isLocalSeRunning() {
  local pid

  pid="$(getLocalRunningPid)"

  if [ -n "${pid:-}" ]; then
    true
    return

  else
    false
    return
  fi
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a zero exit status if ANY of the SE nodes in the cluster are running,
## otherwise it returns a non-zero exit status if ALL nodes are NOT running.
## Params: None

function isClusterRunning() {

  for row in "${NODE_LIST[@]}"; do

    pid="$(getRemoteRunningPid "${row}")"

    if [ -n "${pid:-}" ]; then
      true
      return
    fi
  done

  false
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Checks that none of the nodes are currently running. If one or more nodes
## are actually running then errors are printed to stderr and a non-zero
## exit code is returned.
## Params: 
##  $1 : (optional) if set to "stop" then it formats the error message for
##       asserting that there are no more nodes running after a stop operation.

function assertNoNodesRunning() {
  
  local row
  local pid
  local gotError=0

  local errMsg="The following node are already running:"

  if [ "$1" == "stop" ]; then
    errMsg="The following node are still running:"
  fi

  for row in "${NODE_LIST[@]}"
  do
    pid="$(getRemoteRunningPid "${row}")"

    if [ -n "${pid:-}" ]; then
      gotError=1
      errMsg="${errMsg}\n  ${row}  (pid: ${pid})"
    fi
  done

  if [ ${gotError} -eq 1 ]; then
    printError "${errMsg}"
    false
    return
  fi

  true
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that all nodes have the same version string. If not, write to stderr
## and return a non-zero exit code. If true then write the valid version string
## to stdout and exit with a zero exit code.
## Params: None

function checkNodeVersionsAreEqual() {

  local row
  local host
  local dir
  local remoteCmd
  local actualVerStr
  local expectedVerStr
  local firstNode
  local re="^[0-9]+.[0-9]+.[0-9]+.*$"

  for row in "${NODE_LIST[@]}"
  do
    host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
    dir="$(nodeCfgGetValue "${row}" "${NODE_CFG_DIR_KEY}")"

    remoteCmd="cd \"${dir}\" && source \"${VERSION_FILE}\" && echo \"\${SE_VERSION_STR}-\${SE_COMMIT_HASH}\""
    actualVerStr="$(ssh -q "${host}" "bash" "-c" "'${remoteCmd}'")"

    if [ -z "${actualVerStr}" ]; then
      printError "Got an empty version string for ${row}."
      false
      return
    fi

    if [[ ! "${actualVerStr}" =~ $re ]]; then
      printError "Got an unrecognised version string for ${row}."
      false
      return
    fi

    # if the expected version string is not set, then set it.
    if [ -z "${expectedVerStr}" ]; then
      expectedVerStr="${actualVerStr}"
      firstNode="${row}"
      continue
    fi

    # Otherwise compare actual to expected
    if [ "${actualVerStr}" != "${expectedVerStr}" ]; then
      printError "SE version on node ${row} (${actualVerStr}) does not match the version on node ${firstNode} (${expectedVerStr})."
      false
      return
    fi
  done

  # Otherwise we're all good
  echo "${expectedVerStr}"
  true
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Stops RapidsSE on all nodes in the cluster.
## Params: None

function stopCluster() {
  
  echo "Stopping the RapidsSE cluster."

  if [ -n "${SEQ_START:-}" ]; then
    # Stop the nodes sequentially
    for row in "${NODE_LIST[@]}"
    do
      debugPrint "Stopping ${row}"
      stopRemoteNode "${row}" || errorExit "Could not stop all nodes in the cluster."
    done

  else
    # Stop the nodes in parallel. Ignore all output.
    for row in "${NODE_LIST[@]}"
    do
      stopRemoteNode "${row}" &>/dev/null &
    done

    # Wait for all parallel jobs to finish.
    wait
  fi

  echo -n "Stopping all ${#NODE_LIST[@]} nodes in the cluster. Waiting for them to shutdown."

  # Check every second to see if there are any nodes still running, up to 10 secs.
  local counter=0
  while [ "${counter}" -lt 10 ]
  do
    if assertNoNodesRunning "stop" &>/dev/null; then
      break
    fi

    sleepProgressPrint 1
    ((counter++))
  done

  echo ""

  # Final check (as we may have timed out above).
  if ! assertNoNodesRunning "stop"; then
    echo "Could not stop all nodes in the cluster."
  else
    echo "Stopped all nodes in the cluster."
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Remotely stopss RapidsSE on a node given by the row parameter.
## Params: 
##  $1 : The name of the node to be stopped.

function stopRemoteNode() {

  local row="$1"

  local host
  local dir
  local remoteCmd
  local sshCmd

  host="$(nodeCfgGetValue "${row}" "${NODE_CFG_HOST_KEY}")"
  dir="$(nodeCfgGetValue "${row}" "${NODE_CFG_DIR_KEY}")"

  remoteCmd="cd ${dir} && ./${STOP_SCRIPT} --node"

  if [ ${DEBUG} -eq 1 ]; then
    remoteCmd="${remoteCmd} --debug"
  fi

  sshCmd=( "ssh" "-q" "${host}" "bash" "-c" "'${remoteCmd}'" )

  debugPrint "About to stop node ${row} with the command: ${sshCmd[*]}"

  "${sshCmd[@]}" || errorExit "Could not stop RapidsSE on node ${row}."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Stops RapidsSE on the current node only.
## Params: None

function stopCurrentNode() {

  # Get all of the settings for the current node
  local host
  host="$(nodeCfgGetValue "${CURRENT_NODE_NAME}" "${NODE_CFG_HOST_KEY}")"


  if [ ! -f "${EXE}" ]; then
    errorExit "Cannot stop RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}] because the executable cannot be found at: ${EXE}"
  fi


  if [ -f "${PIDFILE}" ]; then
    # Stop SE gracefully and then wait until the pid is no longer active.
  
    local pid
    pid="$(cat "${PIDFILE}")" 2>/dev/null

    declare -a stopCmd=()
    stopCmd+=("${EXE}")
    stopCmd+=("--name")
    stopCmd+=("${CURRENT_NODE_NAME}")
    stopCmd+=("--stop")
    stopCmd+=("--commands")
    stopCmd+=("${ROOT_DIR}/commands")
    stopCmd+=("--appendTrace")


    # Set the library path so the RapidsSE library can be found and loaded
    export LD_LIBRARY_PATH="${EXE_DIR}:${LD_LIBRARY_PATH}"


    if [ ${DEBUG} -eq 1 ]; then
      echo "Stopping RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}] with the command:"
      echo "  ${stopCmd[*]}"

    else
      echo "Stopping RapidsSE on node ${CURRENT_NODE_NAME} [host ${host}]..."
    fi

    echo "Stopping SE at $(date +%FT%T)" >> "${NOHUP_FILE}"

    "${stopCmd[@]}" >> "${NOHUP_FILE}" 2>&1 &

    
    # Now we wait for the process to stop, periodically checking if the 
    # pid has vanished.

    local counter=0
    local exitSleepTime
    local exitGiveUpTime
    local exitIterations

    exitSleepTime="0.2"   # How long to sleep (in seconds) between checking if the pid has exited.
    exitGiveUpTime="5"    # After this time (in seconds) just kill the pid.
    exitIterations="$(bc <<< "${exitGiveUpTime}" / "${exitSleepTime}")"

    while ps -p "${pid}" &> /dev/null
    do
      if [ "${counter}" -ge "${exitIterations}" ]; then
        break;
      fi

      (( counter++ ))
      sleep "${exitSleepTime}"
    done   

    # Check again that the process has been stopped. If it hasn't then we shall kill it.
    if ps -p "${pid}" &> /dev/null; then    # Exit code 0 means se is still running. 

      echo "Killing RapidsSE process ${pid} on node ${CURRENT_NODE_NAME}."
      kill -9 "${pid}" &>/dev/null
    fi

    # Remove the pid file and ready file
    rm -f "${PIDFILE}" "${READYFILE}" &>/dev/null

  else 
    # The pidfile does not exist.
    # Kill by process name, restricted to processes owned by the current user.
    # We need to set the next 2 variables to avoid "illegal byte sequence" errors.
    echo "PID file missing on node ${CURRENT_NODE_NAME} [host ${host}], so stopping RapidsSE by killing all processes by that name."
    export LC_CTYPE=C
    export LANG=C

    pkill -u $UID -x "$(basename "${EXE}")" 2>/dev/null

    # Remove the ready file
    rm -f "${READYFILE}" &>/dev/null
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

