#!/bin/bash
# This file contains function definitions that are imported and used by setup.sh.

# Guard against this file being executed directly.
if [ "${BASH_SOURCE[0]}" -ef "$0" ]
then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

###############################################################################
### Constants                                                               ###
###############################################################################

readonly GCC_MINIMUM_VERSION="4.8.5"
readonly CLANG_MINIMUM_VERSION="4.2.0"
readonly BASH_MINIMUM_VERSION="4.2.46"

readonly UDP_SENDER_FILE="udpSender.py"
readonly UDP_RECEIVER_FILE="udpReceive.py"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the environment we are installing into is correct before
## continuing with the installation.
## Params: None

function validateInstallationEnvironment() {

  echo ""
  echo "Validating the installation environment on all nodes..."
  echo ""

  # Check that all hosts are resolvable.
  validateHostsAreResolvable

  # Check that all heartbeat hosts/IPs are resolvable.
  validateHeartbeatAddressIsResolvable

  # Check that all host/dir combinations are unique.
  validateHostsAndDirsAreUnique

  # Check that all host and {internal_port | client_port} combinations are unique.
  validateHostsAndAllPortsAreUnique

  # Check if all hosts are reachable by SSH.
  validateHostsReachableBySsh

  # Check that the installer is not inside a target installation directory
  # as that directory will be wiped, including the installer.
  validateInstallerNotInInstallDir

  # Check if SE is running in any of these host:directory combinations.
  validateSENotRunning

  # Check if the internal port is not being used on any of the hosts.
  validateInternalPortNotInUse

  # Check if the client port is not being used on any of the hosts.
  validateClientPortNotInUse

  # TODO: Check if a conflicting SE SHM file exists on any of the hosts.

  # Check if the SE reserved memory size exceeds /dev/shm total size (if this exists).
  validateShmAgainstTotalSize

  # Check if the SE reserved memory size exceeds 95% of RAM.
  validateShmAgainstRAM

  # Check if the SE reserved memory size exceeds the available SHM space.
  validateShmAgainstAvailableMem

  # Check that the number of partitions is acceptable.
  validatePartitions

  # Check that the number of threads is acceptable.
  validateThreads

  # Check that the installation dir can be created (if not already) on each node,
  # and that it is writable.
  validateInstallDirIsWritable

  # Check that the storage dirs can be created (if not already) on each node,
  # and that it is writable.
  validateStorageDirsAreWritable

  # Check that the storage dirs have enough space based on the shared memory size
  # for unload operations.
  validateStorageDirsHaveSpace

  # TODO: If an installation already exists on any node, confirm that the user wishes to overwrite it.

  # Check that node names don't contain spaces or special characters and are unique.
  validateNodeNames

  # Check that all appropriate ports are opened on firewalls
  validateFirewall
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the environment we are installing into has all of the necessary
## 3rd party applications and libraries.
##  $@ - the array of node names that are being added at this time, or none
##       for all nodes.

function validate3rdPartyTools() {

  if [ "${DEBUG}" -eq 1 ]; then
    debugPrint "Validating pre-requisite tools exist on each node."
  fi

  if [ "$#" -eq 0 ]; then

    # Customised check for pre-requisites

    # Check that bash has the correct version
    validateBash

    # Check that there is a compiler available and that we can compile
    # a simple application
    validateCompilers

    # Check that the ldconfig utility is installed
    validateLdconfig

    # Check that libAtomic.so.1 is installed (using ldconfig)
    validateLibAtomic

    # Check that the ss utility is installed
    validateSs

    # Common check that the a number of basic utilities are installed
    validateCommandLineToolExists "nc"
    validateCommandLineToolExists "tar"
    validateCommandLineToolExists "bc"
    validateCommandLineToolExists "cut"
    validateCommandLineToolExists "printf"
    validateCommandLineToolExists "sort"
    validateCommandLineToolExists "awk"

    # tar, bc, cut, printf, sort, awk
    # "nslookup" "dig" "getent"
    # "nproc" "getconf"

  else
    local -a nodeNames=()
    nodeNames=("$@")

    # Customised check for pre-requisites

    # Check that bash has the correct version
    validateBash "${nodeNames[@]}"

    # Check that there is a compiler available and that we can compile
    # a simple application
    validateCompilers "${nodeNames[@]}"

    # Check that the ldconfig utility is installed
    validateLdconfig "${nodeNames[@]}"

    # Check that libAtomic.so.1 is installed (using ldconfig)
    validateLibAtomic "${nodeNames[@]}"

    # Check that the ss utility is installed
    validateSs "${nodeNames[@]}"

    # Common check that the a number of basic utilities are installed
    validateCommandLineToolExists "nc" "${nodeNames[@]}"
    validateCommandLineToolExists "tar" "${nodeNames[@]}"
    validateCommandLineToolExists "bc" "${nodeNames[@]}"
    validateCommandLineToolExists "cut" "${nodeNames[@]}"
    validateCommandLineToolExists "printf" "${nodeNames[@]}"
    validateCommandLineToolExists "sort" "${nodeNames[@]}"
    validateCommandLineToolExists "awk" "${nodeNames[@]}"

    # Check that the bc utility is installed
    validateBc "${nodeNames[@]}"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the environment we are installing into is correct before
## nodes are added to the cluster. This is a slight subset of the full installation
## environment checks.
## Params:
##  $@ - the array of node names that are being added at this time

function validateNodeAdditionEnvironment() {

  [ "$#" -gt 0 ] || errorExit "Function validateNodeAdditionEnvironment requires at least 1 parameter"
  local -a nodeNames=("$@")

  echo ""
  echo "Validating the installation environment of nodes being added..."
  echo ""

  # Check that all hosts are resolvable.
  validateHostsAreResolvable "${nodeNames[@]}"

  # Check that all heartbeat addresses are resolvable.
  validateHeartbeatAddressIsResolvable "${nodeNames[@]}"

  # Check that all host/dir combinations are unique.
  validateHostsAndDirsAreUnique

  # Check that all host and {internal_port | client_port} combinations are unique.
  validateHostsAndAllPortsAreUnique

  # Check if all hosts are reachable by SSH.
  validateHostsReachableBySsh "${nodeNames[@]}"

  # Check that the installer is not inside a target installation directory
  # as that directory will be wiped, including the installer.
  validateInstallerNotInInstallDir "${nodeNames[@]}"

  # Check if SE is running in any of these host:directory combinations.
  validateSENotRunning "${nodeNames[@]}"

  # Check if the internal port is not being used on any of the hosts.
  validateInternalPortNotInUse "${nodeNames[@]}"

  # Check if the client port is not being used on any of the hosts.
  validateClientPortNotInUse "${nodeNames[@]}"

  # TODO: Check if a conflicting SE SHM file exists on any of the hosts.

  # Check if the SE reserved memory size exceeds /dev/shm total size (if this exists).
  validateShmAgainstTotalSize "${nodeNames[@]}"

  # Check if the SE reserved memory size exceeds 95% of RAM.
  validateShmAgainstRAM "${nodeNames[@]}"

  # Check if the SE reserved memory size exceeds the available SHM space.
  validateShmAgainstAvailableMem "${nodeNames[@]}"

  # Check that the number of partitions is acceptable.
  validatePartitions "${nodeNames[@]}"

  # Check that the number of threads is acceptable.
  validateThreads "${nodeNames[@]}"

  # Check that the installation dir can be created (if not already) on each node,
  # and that it is writable.
  validateInstallDirIsWritable "${nodeNames[@]}"

  # TODO: If an installation already exists on any node, confirm that the user wishes to overwrite it.

  # Check that the storage dir paths can be created and are writable.
  validateStorageDirsIsWritable "${nodeNames[@]}"

  # Check that the storage dir paths have space.
  validateStorageDirsHaveSpace "${nodeNames[@]}"

  # Check that node names don't contain spaces or special characters and are unique.
  validateNodeNames

  # Check that all appropriate ports are opened on firewalls
  validateFirewall "${nodeNames[@]}"
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that all hosts are resolvable on the current machine. Exits out
## and writes an error to stderr if not.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

# shellcheck disable=SC2120
function validateHostsAreResolvable() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local output

  if [ "${NO_RESOLVE_HOSTS:-x}" != "x" ]; then
    debugPrint "Skipping host resolution."
    return
  fi

  debugPrint "About to validate that all hostnames are resolvable."

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    # Check if the hostname is an IP address
    local re="^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$"

    if [[ "${host}" =~ ${re} ]]; then
      # We've got an IPv4 address
      # Check the quads
      for i in 1 2 3 4
      do
        if [ "$(echo "${host}" | cut -d. -f${i})" -gt 255 ]; then
          errorExit "Hostname \"${host}\" is not a valid IPv4 address."
        fi
      done

      # This is a valid IPv4 address
      continue

    elif [[ "${host}" = *:* ]]; then
      # We've got an IPv6 address
      re="^([0-9a-fA-F]{0,4}:){1,7}([0-9a-fA-F]){0,4}$"

      if [[ ! "${host}" =~ $re ]]; then
        errorExit "Hostname \"${host}\" is not a valid IPv6 address."
      fi

      # This is a valid IPv6 address
      continue
    fi


    # We must have a hostname to resolve. There are a few different tools that
    # can be used to resolve it, depending on what is installed.

    # Use getent to resolve the hostname, if available
    if command -v getent &>/dev/null; then

      output="$(getent hosts "${host}" | awk '{ print $1; exit }' 2>/dev/null)"
      if [ -z "${output:-}" ]; then
        errorExit "Hostname \"${host}\" is not resolvable."
      fi

      # Host was resolved.
      continue


    # No getent, then try dig
    elif command -v dig &>/dev/null; then

      output="$(dig +short +search "${host}" | awk '{ print ; exit }' 2>/dev/null)"
      if [ -z "${output:-}" ]; then
        errorExit "Hostname \"${host}\" is not resolvable."
      fi

      # Host was resolved.
      continue


    # No dig, then try nslookup
    elif command -v nslookup &>/dev/null; then

      output="$(nslookup "${host}" | awk '/^Address: / { print $2 ; exit }' 2>/dev/null)"
      if [ -z "${output:-}" ]; then
        errorExit "Hostname \"${host}\" is not resolvable."
      fi

      # Host was resolved.
      continue

    # No nslookup either. Don't validate the hostnames.
    else
      printWarning "Could not validate that the hostnames are resolvable. No [getent|dig|nslookup] tools available."
    fi

  done

  debugPrint "Successfully validated that all hostnames are resolvable."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that the heartbeat address is resolvable on the current machine. Exits out
## and writes an error to stderr if not.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

# shellcheck disable=SC2120
function validateHeartbeatAddressIsResolvable() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local heartbeatAddr
  local output
  local broadcast="BROADCAST"

  if [ "${NO_RESOLVE_HEARTBEATS:-x}" != "x" ]; then
    debugPrint "Skipping heartbeat address resolution."
    return
  fi

  debugPrint "About to validate that all heartbeat addresses are resolvable."

  for nodeName in "${nodeNames[@]}"
  do
    heartbeatAddr="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HEARTBEAT_ADDRESS_KEY}")"

    if [ "${heartbeatAddr,,}" = "${broadcast,,}" ]; then
      continue
    fi

    # Check if the heartbeat address is an IP address
    local re="^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$"

    if [[ "${heartbeatAddr}" =~ ${re} ]]; then
      # We've got an IPv4 address
      # Check the quads
      quad1="$(echo "${heartbeatAddr}" | cut -d. -f1)"
      quad2="$(echo "${heartbeatAddr}" | cut -d. -f2)"
      quad3="$(echo "${heartbeatAddr}" | cut -d. -f3)"
      quad4="$(echo "${heartbeatAddr}" | cut -d. -f4)"

      for i in "${quad1}" "${quad2}" "${quad3}" "${quad4}"
      do
        if [ "${i}" -gt 255 ]; then
          errorExit "Heartbeat address \"${heartbeatAddr}\" is not a valid IPv4 address."
        fi
      done

      # Check that this must fall within the multicast range of 224.0.0.0 - 239.255.255.255
      if [ "${quad1}" -lt 224 ] || [ "${quad1}" -gt 239 ]; then
        msg="Heartbeat address \"${heartbeatAddr}\" is outside of the valid multicast address "
        msg+="range of [224.0.0.0, 239.255.255.255]."
        errorExit "${msg}"
      fi

      # Check that this should be within the admin, organisation or local scope multicast ranges of:
      #   Admin scope: 239.0.0.0   - 239.195.255.255
      #   Org scope:   239.192.0.0 - 239.195.255.255
      #   Local scope: 239.255.0.0 - 239.255.255.255
      if [ "${quad1}" -ne 239 ]; then
        echo ""
        msg="Heartbeat multicast IP address should be in the RFC 2365 administratively scoped address "
        msg+="range of 239.0.0.0/8 to avoid conflicts with other multicast addresses."
        printWarning "${msg}"
      fi

      # This is a valid IPv4 multicast address
      continue

    elif [[ "${heartbeatAddr}" = *:* ]]; then
      # We've got an IPv6 address
      re="^([0-9a-fA-F]{0,4}:){1,7}([0-9a-fA-F]){0,4}$"

      if [[ ! "${heartbeatAddr}" =~ $re ]]; then
        errorExit "Heartbeat address \"${heartbeatAddr}\" is not a valid IPv6 address."
      fi

      # This is a valid IPv6 address
      continue
    fi


    # We must have a hostname to resolve. There are a few different tools that
    # can be used to resolve it, depending on what is installed.

    # Use getent to resolve the hostname, if available
    if command -v getent &>/dev/null; then

      output="$(getent hosts "${heartbeatAddr}" | awk '{ print $1; exit }' 2>/dev/null)"
      if [ -z "${output:-}" ]; then
        errorExit "Heartbeat address \"${heartbeatAddr}\" is not resolvable."
      fi

      # heartbeatAddr was resolved.
      continue


    # No getent, then try dig
    elif command -v dig &>/dev/null; then

      output="$(dig +short +search "${heartbeatAddr}" | awk '{ print ; exit }' 2>/dev/null)"
      if [ -z "${output:-}" ]; then
        errorExit "Heartbeat address \"${heartbeatAddr}\" is not resolvable."
      fi

      # heartbeatAddr was resolved.
      continue


    # No dig, then try nslookup
    elif command -v nslookup &>/dev/null; then

      output="$(nslookup "${heartbeatAddr}" | awk '/^Address: / { print $2 ; exit }' 2>/dev/null)"
      if [ -z "${output:-}" ]; then
        errorExit "Heartbeat address \"${heartbeatAddr}\" is not resolvable."
      fi

      # heartbeatAddr was resolved.
      continue

    # No nslookup either. Don't validate the hostnames.
    else
      echo ""
      printWarning "Could not validate that the hostnames are resolvable. No [getent|dig|nslookup] tools available."
    fi

  done

  debugPrint "Successfully validated that all heartbeat addresses are resolvable."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that there are no duplicate entries with the same host:dir combination.
## Params: None

function validateHostsAndDirsAreUnique() {

  local nodeName
  local host
  local dir
  local key

  declare -A map

  for nodeName in "${NODE_LIST[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    dir="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"

    key="${host}:${dir}"

    # Check if the value for this key is not set.
    if [ "${map[${key}]:-x}" != "x" ]; then
      errorExit "Non-unique host / installation directory combination for the following nodes:" "${map[${key}]}" "${nodeName}"
    fi

    # Set the value for this key.
    map[${key}]="${nodeName}"
  done

  # We're all good. All host/dir combinations are unique.
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that there are no duplicate entries with the same host:port
## combination for both internal and client ports.
## Params: None

function validateHostsAndAllPortsAreUnique() {

  local nodeName
  local host
  local port
  local key

  declare -A map

  for nodeName in "${NODE_LIST[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    internal_port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_INTERNAL_PORT_KEY}")"
    client_port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_CLIENT_PORT_KEY}")"

    key1="${host}:${internal_port}"
    key2="${host}:${client_port}"

    if [ "${internal_port}" -eq "${client_port}" ]; then
      errorExit "Internal port number cannot be the same as the client port number on ${nodeName}: ${key1}"
    fi

    # Check if the value for this key is not set.
    if [ "${map[${key1}]:-x}" != "x" ]; then
      errorExit "Non-unique host:internal_port combination (${key1}) for the following nodes:" "${map[${key1}]}" "${nodeName}"
    fi

    if [ "${map[${key2}]:-x}" != "x" ]; then
      errorExit "Non-unique host:client_port combination (${key2}) for the following nodes:" "${map[${key2}]}" "${nodeName}"
    fi

    # Set the value for this key.
    map[${key1}]="${nodeName}"
    map[${key2}]="${nodeName}"
  done

  # We're all good. All host:{internal|client}_port combinations are unique.
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that each hostname is reachable by SSH.
## Exits out and writes an error to stderr if not.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

# shellcheck disable=SC2120
function validateHostsReachableBySsh() {

 local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host

  declare -a sshArgs=()
  declare -a jobArray=()

  debugPrint "About to validate that nodes can be reached by SSH."

  for nodeName in "${nodeNames[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    sshArgs=("${SSH_COMMON_OPTIONS[@]}" "-o" "PasswordAuthentication no" "-o" "ConnectTimeout 10" "${host}" "exit" "0")

    # Run it, in parallel
    (
      if ! output="$(ssh "${sshArgs[@]}" 2>&1)" ; then
        >&2 echo "${output}"
        errorExit "Node ${nodeName} [host: ${host}] cannot be reached by password-less SSH."
      fi

      true
    ) &

    jobArray+=("$!")
  done

  # Check the exit status of each background job.
  for j in "${jobArray[@]}"
  do
    if ! wait "$j"; then
      exit 1
    fi
  done

  debugPrint "Successfully validated that all nodes can be reached by SSH."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that the installer is not inside a target installation directory
## as that directory will be wiped, including the installer.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateInstallerNotInInstallDir() {

  if [ -z "${INSTALL_FILE:-}" ]; then
    # No install file, no problem!
    return
  fi

  if ! [ -f "${INSTALL_FILE}" ]; then
    # File doesn't exist. This shouldn't happen.
    return
  fi

  local -a nodeNames;

    if [ "$#" -eq 0 ]; then
      nodeNames=( "${NODE_LIST[@]}" )
    else
      nodeNames=( "$@" )
    fi

  local nodeName
  local host
  local path

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    path="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"

    # For each node...
    # We first check if the path of the installer is underneath any of the
    # installation paths.
    # If it is then we need to check if the $host represents the current machine.
    # This is non-trivial because a machine can have multiple addresses that resolve
    # to it that are distinct from the hostname of the machine. e.g. multiple IP
    # addresses, DNS A records, DNS C records, fully-qualified names vs non-qualified
    # names, etc. The easiest thing to do is to create a temporary file locally and
    # then SSH to each node and see if that file exists. If it does then we are on
    # that node.

    # Is the path of the installer underneath that of the installation path.
    # Canonicalise both paths so that symlinks don't give a false result.

    case "$(realpath -m "${INSTALL_FILE}")" in

      $(realpath -m "${path}")/*)
        # Installer IS under the installation path.
        # We now need to check if $host represents the current machine.
        if isHostTheCurrentMachine "${host}"; then
          errorExit "The installer cannot be run when it exists underneath one of the installation paths: ${nodeName} ; ${host}:${path}"
        fi
        ;;

      *)
        # Installer is not under the installation path
        continue
        ;;
    esac
  done

  # We're all good.
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a zero exit code if the host given by $1 is the same as the current
## machine, otherwise a non-zero exit code is returned.
## Params:
##  $1 - A hostname or IP address to check.

function isHostTheCurrentMachine() {
  local host="$1"

  # Create a temporary file with a unique and random name
  local tempfile
  tempfile="$(mktemp /tmp/tmp.rapidsse.XXXXXXXX)"

  local retVal=1

  # SSH to $host and check for the existence of the file
  sshArgs=("${SSH_COMMON_OPTIONS[@]}" "-o" "PasswordAuthentication=no" "-o" "ConnectTimeout=10" "${host}" "ls" "${tempfile}")

  if ssh "${sshArgs[@]}" &>/dev/null; then
    # $host does indeed represent the current machine
    retVal=0
  fi

  # Cleanup the temporary file
  rm -f "${tempfile}"

  return "${retVal}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that SE is not running on any of the host:dir combinations.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateSENotRunning() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local path
  local pid

  for nodeName in "${nodeNames[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    path="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"
    pid="$(getRemoteRunningPid "${nodeName}")"

    if [ -n "${pid:-}" ]; then
      errorExit "RapidsSE is already running on ${nodeName} [host ${host}] in path: ${path}"
    fi

  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the TCP internal port specified for each node is not currently in use.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateInternalPortNotInUse() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local internal_port
  local remoteCmd
  local output

  declare -a sshArgs=()
  declare -a failedNodes=()

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    internal_port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_INTERNAL_PORT_KEY}")"

    remoteCmd="which nc &>/dev/null && nc -z 127.0.0.1 ${internal_port} && echo \"PORT_IN_USE\""

    sshArgs=("${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'")

    # Run it
    output="$(ssh "${sshArgs[@]}" || true)"

    if [ "${output}" = "PORT_IN_USE" ]; then
      failedNodes+=("${nodeName}")
    fi
  done

  if [ "${#failedNodes[@]}" -gt 0 ]; then
    local errMsg="The internal port specified for RapidsSE is already in use on the following nodes:"

    for nodeName in "${failedNodes[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      internal_port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_INTERNAL_PORT_KEY}")"
      errMsg+="$(printf "\n  %-12s %12s:%s" "${nodeName}" "${host}" "${internal_port}")"
    done

    errorExit "${errMsg}"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the TCP client port specified for each node is not currently in use.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateClientPortNotInUse() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local client_port
  local remoteCmd
  local output

  declare -a sshArgs=()
  declare -a failedNodes=()

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    client_port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_CLIENT_PORT_KEY}")"

    remoteCmd="which nc &>/dev/null && nc -z 127.0.0.1 ${client_port} && echo \"PORT_IN_USE\""

    sshArgs=("${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'")

    # Run it
    output="$(ssh "${sshArgs[@]}" || true)"

    if [ "${output}" = "PORT_IN_USE" ]; then
      failedNodes+=("${nodeName}")
    fi
  done

  if [ "${#failedNodes[@]}" -gt 0 ]; then
    local errMsg="The client port specified for RapidsSE is already in use on the following nodes:"

    for nodeName in "${failedNodes[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      client_port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_CLIENT_PORT_KEY}")"
      errMsg+="$(printf "\n  %-12s %12s:%s" "${nodeName}" "${host}" "${client_port}")"
    done

    errorExit "${errMsg}"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that the shared memory segment does not exceed the size of shared
## memory on any node.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateShmAgainstTotalSize() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local nodeShm   # SE SHM allocated for a given node
  local shmTotal  # OS SHM on /dev/shm

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodeShm="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_MEM_KEY}")"
    shmTotal="${NODE_TOTAL_SHM[${nodeName}]}"

    # Do the comparison in bc because bash doesn't handle decimals
    if [ "$(echo "${nodeShm} > ${shmTotal}" | bc -l)" -eq 1 ]; then
      errorExit "The shared memory allocated for RapidsSE (${nodeShm}GB) on ${nodeName} [host ${host}] exceeds the allocation of shared memory on that host (${shmTotal}GB). Refer to \"df -h /dev/shm\" on that host."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check if the SE shared memory size exceeds 95% of RAM on any node.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateShmAgainstRAM() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local nodeShm   # SE SHM allocated for a given node
  local ram       # OS total RAM

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodeShm="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_MEM_KEY}")"
    ram="${NODE_TOTAL_MEM[${nodeName}]}"

    if [ "$(echo "${nodeShm} > (0.95 * ${ram})" | bc -l)" -eq 1 ] &&
       [ "$(echo "${nodeShm} > (${ram} - 10)" | bc -l)" -eq 1 ]; then
      errorExit "The shared memory allocated for RapidsSE (${nodeShm}GB) on ${nodeName} [host ${host}] exceeds 95% of total RAM on that host (${ram}GB)."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check if the shared memory size exceeds the available shared memory space
## on /dev/shm. Issue a warning if this is the case.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateShmAgainstAvailableMem() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local nodeShm   # SE SHM allocated for a given node
  local availableShm  # The space left on /dev/shm

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodeShm="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_MEM_KEY}")"
    availableShm="${NODE_FREE_SHM[${nodeName}]}"

    if [ "$(echo "${nodeShm} > ${availableShm}" | bc -l)" -eq 1 ]; then
      printWarning "The shared memory allocated for RapidsSE (${nodeShm}GB) on ${nodeName} [host ${host}] exceeds the available shared memory space on /dev/shm on that host (${availableShm}GB)."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the number of partitions is acceptable. This includes the
## following rules:
##   - #partitions is > 0
##   - #partitions is <= 32 (for now)
##   - #partitions is <= #cores
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validatePartitions() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi


  local nodeName
  local host
  local nodePartitions # SE #partitions for a given node
  local cores          # #cpu cores on a given node

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodePartitions="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_PARTITIONS_KEY}")"
    cores="${NODE_CORE_COUNT[${nodeName}]}"

    if [ "${nodePartitions}" -lt 1 ]; then

      errorExit "The number of partitions specified for RapidsSE on ${nodeName} [host ${host}] (${nodePartitions}) must be greater than zero."
    fi

    if [ "${nodePartitions}" -gt "${MAXIMUM_NUM_PARTITIONS}" ]; then
      errorExit "The number of partitions specified for RapidsSE on ${nodeName} [host ${host}] (${nodePartitions}) is greater than the maximum number of partitions currently allowed (${MAXIMUM_NUM_PARTITIONS})."
    fi

    if [ "${nodePartitions}" -gt "${cores}" ]; then
      errorExit "The number of partitions specified for RapidsSE on ${nodeName} [host ${host}] (${nodePartitions}) is greater than the number of cores for that node (${cores})."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the number of threads is acceptable. This includes the following
## rules:
##   - #threads must be at least the minimum (error).
##   - #threads must be >= #partitions (error).
##   - #threads must be >= #partitions + 6.
##   - #threads should not be > #cores unless to meet any of the above rules.
##
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateThreads() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local nodeThreads    # SE #threads for a given node
  local nodePartitions # SE #partitions for a given node
  local cores          # #cpu cores on a given node

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodeThreads="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_THREADS_KEY}")"
    nodePartitions="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_PARTITIONS_KEY}")"
    cores="${NODE_CORE_COUNT[${nodeName}]}"

    if [ "${nodeThreads}" -lt "${MINIMUM_NUM_THREADS}" ]; then
      errorExit "The number of threads specified for RapidsSE on ${nodeName} [host ${host}] (${nodeThreads}) is less than the minimum value (${MINIMUM_NUM_THREADS})."
    fi

    if [ "${nodeThreads}" -lt "${nodePartitions}" ]; then
      errorExit "The number of threads specified for RapidsSE on ${nodeName} [host ${host}] (${nodeThreads}) is less than the number of partitions for that node (${nodePartitions})."
    fi

    if [ "${nodeThreads}" -lt $((nodePartitions + 6)) ]; then
      errorExit "The number of threads specified for RapidsSE on ${nodeName} [host ${host}] (${nodeThreads}) must be at least $((nodePartitions + 6)) for the given number of partitions on this node (${nodePartitions})."
    fi

    if [[ "${nodeThreads}" -gt ${cores} && "${nodeThreads}" -ne "${MINIMUM_NUM_THREADS}" && "${nodeThreads}" -ne $((nodePartitions + 6)) ]]; then
      printWarning "The number of threads specified for RapidsSE on ${nodeName} [host ${host}] (${nodeThreads}) exceeds the number of cores for that node (${cores}). This can cause sub-optimal performance."
    fi

  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that the storage disk directories on each node can be created
## and is writable. Exits out if not.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateStorageDirsAreWritable() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local diskPaths
  local remoteCmd
  local response

  declare -a sshCmd=()
  declare -A errors

  for nodeName in "${nodeNames[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    diskPaths="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DISK_KEY}")"

    # diskPaths above is a string. Let's turn it into an array based on : delimiter
    IFS=: read -r -d '' -a diskpathsArray < <(printf '%s:\0' "$diskPaths")

    for dirPath in "${diskpathsArray[@]}"
    do
      remoteCmd="$(cat <<-EOF
if [ -d "${dirPath}" ]; then
  if [ ! -w "${dirPath}" ]; then
    echo "Storage disk directory exists (${dirPath}) but is not writable.";
    false;
    exit;
  fi
else
  isWritable=0
  dname="\$(dirname "${dirPath}")"

  while true; do
    if [ -d "\${dname}" ]; then
      if [ -w "\${dname}" ]; then
        isWritable=1
      fi
      break
    fi

    if [ "\${dname}" = "/" ]; then
      break;
    fi

    dname="\$(dirname "\${dname}")"
  done

  if [ "\${isWritable}" -ne 1 ]; then
    echo "Storage disk directory (${dirPath}) cannot be created because the parent directory (\${dname}) is not writable.";
    false;
    exit;
  fi
fi
true;
EOF
      )"
      sshCmd=( "ssh" "${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'" )

      debugPrint "About to validate the storage disk directory on node ${nodeName} with the command: ${sshCmd[*]}"

      if ! response="$("${sshCmd[@]}")"; then
        debugPrint "Storage disk directory validation failed: ${response}"

        if [ -z "${response:-}" ]; then
          response="<no error returned>"
        fi

        # Save the response and the node name
        errors["${nodeName}"]="${response}"
      fi
    done
  done

  ## Be careful with checking associative arrays. They may be declared but
  ## can be unset. And with set -b (unbound variables) this can cause issues.
  ## Reference here:
  ## https://stackoverflow.com/questions/26925905/in-bash-test-if-associative-array-is-declared
  ## Also note that the "-v" operator seems to work differently on CentOS 7 compared
  ## to Ubuntu 20 when applied to arrays. So we are using the parameter substitution
  ## when the variable is null trick below to avoid unbound variable problems with arrays.

  if [ "${errors[*]:-x}" != "x" ] && [ "${#errors[@]}" -gt 0 ]; then
    local errMsg="Validation of the storage disk directory failed:"

    for nodeName in "${!errors[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      errMsg="${errMsg}\nOn ${nodeName} [host: ${host}] :	${errors[${nodeName}]}"
    done

    echo ""
    errorExit "${errMsg}"
  fi

  debugPrint "Successfully validated that the storage disk directories are writable."
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that the storage disk directories on each node have space for
## unload operations. If the directory does not exist, check the space of
## it's parent directory. If the storage path is the same as the installation
## path, keep checking the parent dirs until we find one that exists, and
## check its space.
## Displays warning if space is not available.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateStorageDirsHaveSpace() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local installDir
  local diskPaths
  local remoteCmd
  local response
  local mem

  declare -a sshCmd=()
  declare -A errors

  for nodeName in "${nodeNames[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    installDir="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"
    diskPaths="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DISK_KEY}")"
    mem="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_MEM_KEY}")"

    # diskPaths above is a string. Let's turn it into an array based on : delimiter
    IFS=: read -r -d '' -a diskpathsArray < <(printf '%s:\0' "$diskPaths")

    numDisks=${#diskpathsArray[@]}

    minSpacePerDisk=$((mem*1024/numDisks))

    for dirPath in "${diskpathsArray[@]}"
    do
      remoteCmd="$(cat <<-EOF
if [ -d "${dirPath}" ]; then
  # Check storage path space if it exists
  maxDirSpace=\$(df -m "${dirPath}" | awk '"'"'/\/dev\//{print \$2}'"'"')
  if [ "\${maxDirSpace}" -lt "${minSpacePerDisk}" ]; then
    printWarning "Storage disk directory (${dirPath}) does not have enough space: \$((\${maxDirSpace}/1024))GB available, $((${minSpacePerDisk}/1024))GB required.";
  fi
elif [[ "${dirPath}" = "${installDir}"/* ]]; then
    # Storage path does not exist. Check if it is
    # under the install directory.
    # Find the oldest parent dir that exists and
    # check its space
    dname="$(dirname "${dirPath}")"
    while [ ! -d "\${dname}" ]; do
      dname="\$(dirname "\${dname}")"
    done
    maxDirSpace=\$(df -m "\${dname}" | awk '"'"'/\/dev\//{print \$2}'"'"')
    if [ "\${maxDirSpace}" -lt "${minSpacePerDisk}" ]; then
      printWarning "Storage disk directory (\${dname}) does not have enough space: \$((\${maxDirSpace}/1024))GB available, $((${minSpacePerDisk}/1024))GB required.";
    fi
else
  # Storage path is not under the installation path
  # Only check immediate parent dir space
  # This is because we do not want to accidentally check
  # the wrong mount disk space, so we only check the
  # immediate parent dir.
  dname="$(dirname "${dirPath}")"
  if [ -d "\${dname}" ]; then
    maxDirSpace=\$(df -m "\${dname}" | awk '"'"'/\/dev\//{print \$2}'"'"')
    if [ "\${maxDirSpace}" -lt "${minSpacePerDisk}" ]; then
      printWarning "Storage disk parent directory (\${dname}) does not have enough space: \$((\${maxDirSpace}/1024))GB available, $((${minSpacePerDisk}/1024))GB required.";
    fi
  else
    echo "Storage disk parent directory (\${dname}) does not exist.";
    false;
    exit;
  fi
fi
true;
EOF
      )"
      # test ssh command locally, issue could be single quotes in sshCmd
      sshCmd=( "ssh" "${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'" )

      debugPrint "About to validate the storage disk directory space on node ${nodeName} with the command: ${sshCmd[*]}"

      if ! response="$("${sshCmd[@]}")"; then
        debugPrint "Storage disk directory space validation failed: ${response}"

        if [ -z "${response:-}" ]; then
          response="<no error returned>"
        fi

        # Save the response and the node name
        errors["${nodeName}"]="${response}"
      fi
    done
  done

  ## Be careful with checking associative arrays. They may be declared but
  ## can be unset. And with set -b (unbound variables) this can cause issues.
  ## Reference here:
  ## https://stackoverflow.com/questions/26925905/in-bash-test-if-associative-array-is-declared
  ## Also note that the "-v" operator seems to work differently on CentOS 7 compared
  ## to Ubuntu 20 when applied to arrays. So we are using the parameter substitution
  ## when the variable is null trick below to avoid unbound variable problems with arrays.

  if [ "${errors[*]:-x}" != "x" ] && [ "${#errors[@]}" -gt 0 ]; then
    local errMsg="Validation of the storage disk directory space failed:"

    for nodeName in "${!errors[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      errMsg="${errMsg}\nOn ${nodeName} [host: ${host}] :	${errors[${nodeName}]}"
    done

    echo ""
    errorExit "${errMsg}"
  fi

  debugPrint "Successfully validated that the storage disk directories have enough space for unload operations."
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that the installation directory on each node can be created
## and is writable. Exits out if not.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateInstallDirIsWritable() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local dir
  local remoteCmd
  local response

  declare -a sshCmd=()
  declare -A errors

  for nodeName in "${nodeNames[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    dir="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"

    remoteCmd="$(cat <<-EOF
			if [ -d "${dir}" ]; then
				if [ ! -w "${dir}" ]; then
					echo "Installation directory exists (${dir}) but is not writable.";
					false;
					exit;
				fi
			else
        isWritable=0
        dname="\$(dirname "${dir}")"

        while true; do
          if [ -d "\${dname}" ]; then
            if [ -w "\${dname}" ]; then
              isWritable=1
            fi
            break
          fi

          if [ "\${dname}" = "/" ]; then
            break;
          fi

          dname="\$(dirname "\${dname}")"
        done

				if [ "\${isWritable}" -ne 1 ]; then
					echo "Installation directory (${dir}) cannot be created because the parent directory (\${dname}) is not writable.";
					false;
					exit;
				fi
			fi
			true;
		EOF
    )"

    sshCmd=( "ssh" "${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'" )

    debugPrint "About to validate the installation directory on node ${nodeName} with the command: ${sshCmd[*]}"

    if ! response="$("${sshCmd[@]}")"; then
      debugPrint "Install dir validation failed: ${response}"

      if [ -z "${response:-}" ]; then
        response="<no error returned>"
      fi

      # Save the response and the node name
      errors["${nodeName}"]="${response}"
    fi

  done

  ## Be careful with checking associative arrays. They may be declared but
  ## can be unset. And with set -b (unbound variables) this can cause issues.
  ## Reference here:
  ## https://stackoverflow.com/questions/26925905/in-bash-test-if-associative-array-is-declared
  ## Also note that the "-v" operator seems to work differently on CentOS 7 compared
  ## to Ubuntu 20 when applied to arrays. So we are using the parameter substitution
  ## when the variable is null trick below to avoid unbound variable problems with arrays.
  if [ "${errors[*]:-x}" != "x" ] && [ "${#errors[@]}" -gt 0 ]; then
    local errMsg="Validation of the installation directory failed:"

    for nodeName in "${!errors[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      errMsg="${errMsg}\nOn ${nodeName} [host: ${host}] :	${errors[${nodeName}]}"
    done

    echo ""
    errorExit "${errMsg}"
  fi

  debugPrint "Successfully validated that the installation directories are writable."
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that node names don't contain spaces or special characters and are unique.
## Params: None

function validateNodeNames() {

  local nodeName
  local re="^[[:alnum:]_]+$"

  for nodeName in "${NODE_LIST[@]}"
  do
    if ! [[ "${nodeName}" =~ $re ]]; then
      errorExit "Invalid node name. Must only contain letters, numbers and underscores: $nodeName"
    fi
  done

  # Test for uniqueness of node names.
  declare -a dups=()
  readarray -t dups < <(printf "%s\n" "${NODE_LIST[@]}" | sort | uniq -d | uniq -u)

  if [ "${#dups[@]}" -gt 0 ]; then
    errorExit "Cannot have duplicate node names: ${dups[*]}"
  fi
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that a suitable compiler is installed and that it can compile a simple program.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateCompilers() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local remoteCmd
  local output
  local errMsg="The compiler validation checks failed on the following nodes:"

  declare -a sshArgs=()
  declare -a failedNodes=()
  declare -a compilers=()

  # First, determine which of gcc or clang is available
  debugPrint "Validating compilers"

  for nodeName in "${nodeNames[@]}"; do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    if ! output="$(validateCompilerOnHost ${host})"; then
      failedNodes+=("${nodeName}")
      errMsg+="$(printf "\n  %-8s [host: %12s] : %s" "${nodeName}" "${host}" "${output:-}")"
    fi
  done

  if [ "${#failedNodes[@]}" -gt 0 ]; then
    errorExit "${errMsg}"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that a suitable compiler is installed and that it can compile a simple program.
## Params:
##  $1 - hostname to check
## Returns: an error message on stdout if there is a problem.

function validateCompilerOnHost() {

  if [ $# -ne 1 ]; then
    errorExit "Function validateCompilerOnHost requires 1 parameter"
  fi

  local host="$1"
  local lastError=""
  local sampleProgram

  sampleProgram="$(cat <<-EOF
#include <stdio.h>
#include <dlfcn.h>

int main(int argc, char** argv)
{
  // Test that basic dlopen functionality is available
  void* pvHandle = dlopen(NULL, RTLD_LAZY);
  dlclose(pvHandle);

  printf("Hello World!\n");
  return 0;
}
EOF
  )"

  local compilers=("gcc" "clang")
  local compilerMinVers=("${GCC_MINIMUM_VERSION}" "${CLANG_MINIMUM_VERSION}")
  local compiler
  local compilerMinVer

  local i=0

  while [ "${i}" -lt "${#compilers[@]}" ]; do
    compiler="${compilers[$i]}"
    compilerMinVer="${compilerMinVers[$i]}"

    if [ "${lastError:-x}" != "x" ]; then
      lastError="${lastError} ;"
    fi

    # Check if gcc is available and the version is acceptable
    debugPrint "Validating ${compiler} compiler on host ${host}"

    remoteCmd="which ${compiler} &>/dev/null && ${compiler} -dumpversion 2>/dev/null"

    sshArgs=("${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'")

    # Run it and check if it returned with a success error code
    if output="$(ssh "${sshArgs[@]}")" && [ "${output:-x}" != "x" ] ; then

      # Now compare the version
      if isVersionGreaterThanOrEqualTo "${output}" "${compilerMinVer}" ; then

        # So far so good. Now compile a simple program
        remoteCmd="${compiler} -x c -ldl -o /tmp/compilerTest - 2>&1"
        sshArgs=("${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'")

        if output="$(ssh "${sshArgs[@]}" <<< "${sampleProgram}")" ; then
          true
          return
        else
          debugPrint "\nCompilation of sample program with ${compiler} failed:\n${output}\n\n"
          lastError="${lastError} Compilation of a sample program with ${compiler} failed. Rerun with --debug to see details."
        fi
      else
        lastError="${lastError} Version of ${compiler} is too old - found: ${output}, required: ${compilerMinVer}"
      fi
    else
      lastError="${lastError} ${compiler} compiler not found"
    fi

    i=$((i + 1))
  done

  echo "${lastError}"
  false
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that libAtomic.so.1 is installed on each node.
## Params:
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateLibAtomic() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local remoteCmd
  local output

  declare -a sshArgs=()
  declare -a failedNodes=()

  debugPrint "Validating libAtomic"

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    remoteCmd="PATH=\${PATH}:/usr/sbin:/sbin ldconfig -p | grep libatomic.so.1"

    sshArgs=("${SSH_COMMON_OPTIONS[@]}" "${host}" "${remoteCmd}")

    # Run it and check if it returned with a success error code
    if ! response="$(ssh "${sshArgs[@]}" &>/dev/null)"; then
      failedNodes+=("${nodeName}")
      continue
    fi

  done

  if [ "${#failedNodes[@]}" -gt 0 ]; then
    local errMsg="Dependant library libAtomic.so.1 is not installed on the following nodes:"

    for nodeName in "${failedNodes[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      errMsg+="$(printf "\n  %-12s [host: %12s]" "${nodeName}" "${host}")"
    done

    errMsg+="\n\nlibAtomic can be installed with \"yum install libatomic\" (or an equivalent command for different package managers)."

    errorExit "${errMsg}"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that bash is installed and is new enough on each node.
## Params: None
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateBash() {

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local remoteCmd
  local output

  declare -a sshArgs=()
  declare -a failedNodes=()

  debugPrint "Validating bash version"

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    # shellcheck disable=SC2016
    remoteCmd='which bash &>/dev/null && echo "${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}" 2>/dev/null'

    sshArgs=("${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'")

    # Run it and check if it returned with a success error code
    if ! output="$(ssh "${sshArgs[@]}")" ; then
      failedNodes+=("${nodeName}")
      continue
    fi

    # Check the gcc version is sufficient.
    # First check if the output is empty.
    if [ -z "${output:-}" ]; then
      failedNodes+=("${nodeName}")
      continue;
    fi

    # Check the version number.
    if ! isVersionGreaterThanOrEqualTo "${output}" "${BASH_MINIMUM_VERSION}" ; then
      debugPrint "BASH on node ${nodeName} is too old - Found: ${output} ; Required: ${BASH_MINIMUM_VERSION}"
      failedNodes+=("${nodeName}")
      continue
    fi
  done

  if [ "${#failedNodes[@]}" -gt 0 ]; then
    local errMsg="Bash is either not installed or is too old (min: ${BASH_MINIMUM_VERSION}) on the following nodes:"

    for nodeName in "${failedNodes[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      errMsg+="$(printf "\n  %-12s [host: %12s]" "${nodeName}" "${host}")"
    done

    errorExit "${errMsg}"
  fi
}


