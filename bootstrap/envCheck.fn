# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that a given command line tool is installed on each node.
## Params:
##  $1 - the name of the tool to check
##  $@ - (optional) the list of node names to check. If not set then check all.

function validateCommandLineToolExists() {

  local tool="$1"
  shift

  local -a nodeNames;

  if [ "$#" -eq 0 ]; then
    nodeNames=( "${NODE_LIST[@]}" )
  else
    nodeNames=( "$@" )
  fi

  local nodeName
  local host
  local remoteCmd
  local output

  declare -a sshArgs=()
  declare -a failedNodes=()

  debugPrint "Validating ${tool} is installed"

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    #shellcheck disable=SC2016
    remoteCmd="which ${tool} &>/dev/null"

    sshArgs=("${SSH_COMMON_OPTIONS[@]}" "${host}" "bash -c '${remoteCmd}'")

    # Run it and check if it returned with a success error code
    if ! output="$(ssh "${sshArgs[@]}")" ; then
      failedNodes+=("${nodeName}")
      continue
    fi
  done

  if [ "${#failedNodes[@]}" -gt 0 ]; then
    local errMsg="${tool} is not installed on the following nodes:"

    for nodeName in "${failedNodes[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      errMsg+="$(printf "\n  %-12s [host: %12s]" "${nodeName}" "${host}")"
    done

    errorExit "${errMsg}"
  fi
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that the local machine has the basic 3rd party tools installed.
## These are used by the installer.
## Params: None

function validateLocal3rdPartyTools() {

  validateLocalBash

  local mandatoryTools=("ssh" "tar" "bc" "cut" "printf" "sort" "awk")
  local oneOfDnsTools=("nslookup" "dig" "getent")
  local oneOfCpuTools=("nproc" "getconf")

  for tool in "${mandatoryTools[@]}"; do
    if ! which "${tool}" &>/dev/null; then
      errorExit "Cannot find the command line tool ${tool} needed for the installation."
    fi
  done

  # Check for one of the DNS tools: nslookup, dig, getent
  local gotDnsTool=0
  for tool in "${oneOfDnsTools[@]}"; do
    if which "${tool}" &>/dev/null; then
      gotDnsTool=1
      break
    fi
  done

  if [ "${gotDnsTool}" -eq 0 ]; then
    prettyList="$(arrayToCommaSeparatedString "${oneOfDnsTools[@]}")"
    errorExit "At least one of the following tools must be installed for the installation to proceed: ${prettyList}"
  fi

  # Check for one of the CPU tools: nproc, getconf
  local gotCpuTool=0
  for tool in "${oneOfCpuTools[@]}"; do
    if which "${tool}" &>/dev/null; then
      gotCpuTool=1
      break
    fi
  done

  if [ "${gotCpuTool}" -eq 0 ]; then
    prettyList="$(arrayToCommaSeparatedString "${oneOfCpuTools[@]}")"
    errorExit "At least one of the following tools must be installed for the installation to proceed: ${prettyList}"
  fi

}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Check that the local bash version is new enough.
## Params: None

function validateLocalBash() {
  local output
  debugPrint "Validating local bash version"

  output="${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}"

  # Check the bash version is sufficient.
  # First check if the output is empty.
  if [ -z "${output:-}" ]; then
    errorExit "Could not get the bash version number (empty output)"
  fi

  # Check the version number.
  if ! isVersionGreaterThanOrEqualTo "${output}" "${BASH_MINIMUM_VERSION}" ; then
    errorExit "Local version of bash is too old - Found: ${output} ; Required: ${BASH_MINIMUM_VERSION}"
  fi

  debugPrint "Bash version has been validated (${output} >= ${BASH_MINIMUM_VERSION})"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Checks that all configured ports are reachable through each machine's firewall.
## This test can be skipped by setting NO_FIREWALL=1.
## By default all ports are tested in parallel (where possible). You can force
## sequential tests by setting SEQ_FIREWALL=1
## Params:
##  $@ - (optional) a list of node names to check, otherwise all nodes will be checked.

function validateFirewall() {

  if [ "${NO_FIREWALL:-0}" -eq 1 ]; then
    debugPrint "Skipping firewall tests."
    return
  fi

  if [ "${SEQ_FIREWALL:-0}" -eq 1 ]; then
    validateFirewallSequential "$@"
  else
    validateFirewallParallel "$@"
  fi
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Checks that all configured ports are reachable through each machine's firewall.
## Runs the tests in parallel.
## Params:
##  $@ - (optional) a list of node names to check, otherwise all nodes will be checked.

function validateFirewallSequential() {

  local isFullCluster
  local -a nodeNames

  if [ "$#" -eq 0 ]; then
    # Check all nodes
    isFullCluster=1
    nodeNames=( "${NODE_LIST[@]}" )
  else
    # Check on the nodes given
    #shellcheck disable=SC2034
    isFullCluster=0
    nodeNames=( "$@" )
  fi

  # If we have a full cluster with only 1 unique hostname then there is no point checking
  # for connectivity because it is all local and unaffected by firewalls.
  local numUniqueHosts
  numUniqueHosts="$(numberOfUniqueHosts)"

  if [ "${numUniqueHosts}" -eq 1 ]; then
    debugPrint "No need to test the firewall because there is only 1 unique hostname in the cluster."
    return 0
  fi

  # TODO: There is a blind spot here. If we start with a one node cluster then we cannot test
  # TODO: that this single node has had its firewall ports opened up. For a single node cluster
  # TODO: it doesn't matter anyway.
  # TODO: But if we then add additional nodes to this cluster we really need to test the connectivity
  # TODO: to that single node from the second node being added. However if the existing cluster was
  # TODO: already running then the desired ports will already be in use and we cannot test to see
  # TODO: if they are being filtered out by the firewall, particularly any UDP ports. We could
  # TODO: potentially make a TCP connection and not send any data though.
  #
  # TODO: For now we will only only test the nodeNames that are being passed in, or the full
  # TODO: cluster if we have more than 1 unique hostname.

  local firstHost
  firstHost="$(nodeCfgGetValue "${NODE_LIST[0]}" "${NODE_CFG_HOST_KEY}")"

  # We can't test the firewall capabilities of the current host from the current host.
  # So we need to find an alternate host to test from.
  local alternateHost
  for nodeName in "${NODE_LIST[@]}"; do
    local host
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    if [ "${host}" != "${firstHost}" ]; then
      alternateHost="${host}"
      break;
    fi
  done

  #shellcheck disable=SC2016
  [ "${alternateHost:-x}" != x ] || errorExit 'null value for ${alternateHost}'

  local nodeName
  local server
  local client
  local internalPort
  local heartbeatPort

  local -a errorList=()
  local -a warningList=()

  # Check each node specified
  for nodeName in "${nodeNames[@]}"; do

    server="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    client="${firstHost}"  # by default
    internalPort="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_INTERNAL_PORT_KEY}")"
    clientPort="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_CLIENT_PORT_KEY}")"
    heartbeatPort="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HEARTBEAT_PORT_KEY}")"

    # Ensure we don't try to test the firewall of the current host from the current host
    if [ "${server}" = "${client}" ]; then
      client="${alternateHost}"
    fi

    # Test the main internal TCP port. This either succeeds or fails. Ignore stderr output.
    local tcpResult
    for port in "${internalPort}" "${clientPort}"; do
      debugPrint "Sequential TCP: ${server}:${port}"
      if ! checkFirewallTcp "${client}" "${server}" "${port}" 2>/dev/null ; then
        tcpResult="$?"

        if [ "${tcpResult}" -eq 2 ]; then
          # TCP socket is already in use. This is an error
          errorList+=( "${server}:${port}/TCP  (TCP port already in use by another process on host)" )

        else
          # Socket is blocked. Add to failed node/socket list
          errorList+=( "${server}:${port}/TCP  (TCP port may be blocked)" )
        fi
      fi
    done

    # Test the heartbeat UDP port. This may be indeterminant if another process
    # is using the socket, so we need to cater for that. Ignore stderr output.
    local udpResult
    debugPrint "Sequential UDP: ${server}:${heartbeatPort}"
    if ! checkFirewallUdp "${client}" "${server}" "${heartbeatPort}" 2>/dev/null ; then
      udpResult="$?"

      if [ "${udpResult}" -eq 2 ] ; then
        # UDP socket is already in use. Add to warning node/socket list
        warningList+=( "${server}:${heartbeatPort}/UDP  (UDP port already in use by another process on host)" )

      elif [ "${udpResult}" -eq 3 ] ; then
        # UDP port was not tested because of a missing pre-requisite.
        warningList+=( "${server}:${heartbeatPort}/UDP  (UDP port not tested due to missing python interpreter)" )

      else
        # Socket is likely blocked. Add to failed node/socket list
        errorList+=( "${server}:${heartbeatPort}/UDP  (UDP port may be blocked)" )
      fi
    fi
  done

  if [ "${#errorList[@]}" -eq 0 ] && [ "${#warningList[@]}" -eq 0 ]; then
    debugPrint "No errors or warnings from the firewall"
    return
  fi

  # Print errors/warnings
  if [ "${#errorList[@]}" -gt 0 ]; then
    local errMsg
    errMsg="The following hosts appear to have connectivity problems on their ports.\n"
    errMsg+="RapidsSE requires these ports to be open in the host's firewall."
    for host in "${errorList[@]}"; do
      errMsg+="\n  ${host}"
    done

    echo
    printError "${errMsg}"
  fi

  if [ "${#warningList[@]}" -gt 0 ]; then
    local warningMsg
    warningMsg="RapidsSE was not able to determine if the following UDP ports were accessible through the host's firewall.\n"
    warningMsg+="RapidsSE requires these ports to be open."
    for host in "${warningList[@]}"; do
      warningMsg+="\n  ${host}"
    done

    echo
    printWarning "${warningMsg}"
  fi

  if [ "${#errorList[@]}" -gt 0 ]; then
    exit 1
  fi

  if [ "${#errorList[@]}" -eq 0 ] && [ "${#warningList[@]}" -gt 0 ]; then
    echo -e "\nInstallation can continue with the above warnings, but they may prevent RapidsSE from starting correctly."
  fi

  # Otherwise continue on warnings
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Checks that all configured ports are reachable through each machine's firewall.
## Runs the tests in parallel.
## Params:
##  $@ - (optional) a list of node names to check, otherwise all nodes will be checked.

function validateFirewallParallel() {

  local isFullCluster
  local -a nodeNames

  if [ "$#" -eq 0 ]; then
    # Check all nodes
    isFullCluster=1
    nodeNames=( "${NODE_LIST[@]}" )
  else
    # Check on the nodes given
    #shellcheck disable=SC2034
    isFullCluster=0
    nodeNames=( "$@" )
  fi

  # If we have a full cluster with only 1 unique hostname then there is no point checking
  # for connectivity because it is all local and unaffected by firewalls.
  local numUniqueHosts
  numUniqueHosts="$(numberOfUniqueHosts)"

  if [ "${numUniqueHosts}" -eq 1 ]; then
    debugPrint "No need to test the firewall because there is only 1 unique hostname in the cluster."
    return 0
  fi

  # TODO: There is a blind spot here. If we start with a one node cluster then we cannot test
  # TODO: that this single node has had its firewall ports opened up. For a single node cluster
  # TODO: it doesn't matter anyway.
  # TODO: But if we then add additional nodes to this cluster we really need to test the connectivity
  # TODO: to that single node from the second node being added. However if the existing cluster was
  # TODO: already running then the desired ports will already be in use and we cannot test to see
  # TODO: if they are being filtered out by the firewall, particularly any UDP ports. We could
  # TODO: potentially make a TCP connection and not send any data though.
  #
  # TODO: For now we will only only test the nodeNames that are being passed in, or the full
  # TODO: cluster if we have more than 1 unique hostname.

  local firstHost
  firstHost="$(nodeCfgGetValue "${NODE_LIST[0]}" "${NODE_CFG_HOST_KEY}")"

  # We can't test the firewall capabilities of the current host from the current host.
  # So we need to find an alternate host to test from.
  local alternateHost
  for nodeName in "${NODE_LIST[@]}"; do
    local host
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    if [ "${host}" != "${firstHost}" ]; then
      alternateHost="${host}"
      break;
    fi
  done

  #shellcheck disable=SC2016
  [ "${alternateHost:-x}" != x ] || errorExit 'null value for ${alternateHost}'

  local nodeName
  local server
  local client
  local port
  local protocol

  local -a errorList=()
  local -a warningList=()

  # All TCP tests can be run in parallel because they have unique hosts and ports.
  # For UDP tests they can share the same port if they are on the same host, so we
  # may need to run some of those tests sequentially.

  # First we need an array to hold the pids of all background tasks
  # and an associative array to hold the client/server/port information (keyed on pid).
  local -a jobPids=()
  local -A jobParams
  local pid

  # Now launch all TCP tests in parallel
  for nodeName in "${nodeNames[@]}"; do
    server="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    client="${firstHost}"  # by default
    internalPort="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_INTERNAL_PORT_KEY}")"
    clientPort="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_CLIENT_PORT_KEY}")"

    for port in "${internalPort}" "${clientPort}"; do
      debugPrint "Parallel TCP: ${server}:${port}"

      # Ensure we don't try to test the firewall of the current host from the current host
      if [ "${server}" = "${client}" ]; then
        client="${alternateHost}"
      fi

      (checkFirewallTcp "${client}" "${server}" "${port}" 2>/dev/null) &
      pid="$!"

      jobPids+=( "${pid}" )
      jobParams["${pid}_server"]="${server}"
      jobParams["${pid}_client"]="${client}"
      jobParams["${pid}_port"]="${port}"
      jobParams["${pid}_protocol"]="TCP"
    done
  done

  # The Heartbeat UDP tests all run on the same port, so we only need to consider
  # the hostnames for uniqueness or non-uniqueness.

  # Get a list of non-unique server names
  local -a sequentialServers=()
  mapfile -t sequentialServers < <(nonUniqueHosts "${nodeNames[@]}")

  if [ -z "${sequentialServers[*]:-}" ]; then
    sequentialServers=()
  fi

  # Launch all of the unique server name UDP tests
  for nodeName in "${nodeNames[@]}"; do

    server="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    client="${firstHost}"  # by default
    port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HEARTBEAT_PORT_KEY}")"

    # Skip any sequential hosts
    if [ "${#sequentialServers[@]}" -ne 0 ] && isValueInArray "${server}" "${sequentialServers[@]:-}"; then
      continue
    fi

    debugPrint "Parallel UDP: ${server}:${port}"

    # Ensure we don't try to test the firewall of the current host from the current host
    if [ "${server}" = "${client}" ]; then
      client="${alternateHost}"
    fi

    (checkFirewallUdp "${client}" "${server}" "${port}" 2>/dev/null) &
    pid="$!"

    jobPids+=( "${pid}" )
    jobParams["${pid}_server"]="${server}"
    jobParams["${pid}_client"]="${client}"
    jobParams["${pid}_port"]="${port}"
    jobParams["${pid}_protocol"]="UDP"
  done

  # Launch all of the non-unique server name UDP tests sequentially and collate results
  port="$(nodeCfgGetValue "${nodeNames[0]}" "${NODE_CFG_HEARTBEAT_PORT_KEY}")"
  if [ "${#sequentialServers[@]}" -gt 0 ]; then
    for server in "${sequentialServers[@]}"; do
      client="${firstHost}"  # by default

      debugPrint "Sequential UDP test: ${server}:${port}"

      # Ensure we don't try to test the firewall of the current host from the current host
      if [ "${server}" = "${client}" ]; then
        client="${alternateHost}"
      fi

      # Test the heartbeat UDP port. This may be indeterminant if another process
      # is using the socket, so we need to cater for that. Ignore stderr output.
      local udpResult
      if ! checkFirewallUdp "${client}" "${server}" "${port}" 2>/dev/null ; then
        udpResult="$?"

        if [ "${udpResult}" -eq 2 ] ; then
          # UDP socket is already in use. Add to warning node/socket list
          warningList+=( "${server}:${port}/UDP  (UDP port already in use by another process on host)" )

        elif [ "${udpResult}" -eq 3 ] ; then
          # UDP port was not tested because of a missing pre-requisite.
          warningList+=( "${server}:${port}/UDP  (UDP port not tested due to missing python interpreter)" )

        else
          # Socket is likely blocked. Add to failed node/socket list
          errorList+=( "${server}:${port}/UDP  (UDP port may be blocked)" )
        fi
      fi
    done
  fi

  # Wait for all parallel jobs to finish and collate all parallel results
  for pid in "${jobPids[@]}"; do
    local pidResult
    pidResult=0
    wait "${pid}" || pidResult="$?"

    if [ "${pidResult}" -eq 0 ]; then
      # All good
      continue
    fi

    server="${jobParams["${pid}_server"]}"
    port="${jobParams["${pid}_port"]}"
    protocol="${jobParams["${pid}_protocol"]}"

    if [ "${pidResult}" -eq 2 ]; then

      # For TCP this is an error. For UDP it is a warning.
      if [ "${protocol}" = "TCP" ]; then
        errorList+=( "${server}:${port}/${protocol}  (TCP port already in use by another process on host)" )
      else
        warningList+=( "${server}:${port}/${protocol}  (UDP port already in use by another process on host)" )
      fi
      # TCP socket is already in use. This is an error

    elif [ "${pidResult}" -eq 3 ] && [ "${protocol}" = "UDP"  ]; then
      # UDP port was not tested because of a missing pre-requisite.
      warningList+=( "${server}:${port}/${protocol}  (UDP port not tested due to missing python interpreter)" )

    else
      # Socket is blocked. Add to failed node/socket list
      errorList+=( "${server}:${port}/${protocol}  (${protocol} port may be blocked)" )
    fi
  done

  # Present final results
  if [ "${#errorList[@]}" -eq 0 ] && [ "${#warningList[@]}" -eq 0 ]; then
    debugPrint "No errors or warnings from the firewall"
    return
  fi

  # Print errors/warnings
  if [ "${#errorList[@]}" -gt 0 ]; then
    local errMsg
    errMsg="The following hosts appear to have connectivity problems on their ports.\n"
    errMsg+="RapidsSE requires these ports to be open in the host's firewall."
    for host in "${errorList[@]}"; do
      errMsg+="\n  ${host}"
    done

    echo
    printError "${errMsg}"
  fi

  if [ "${#warningList[@]}" -gt 0 ]; then
    local warningMsg
    warningMsg="RapidsSE was not able to determine if the following UDP ports were accessible through the host's firewall.\n"
    warningMsg+="RapidsSE requires these ports to be open."
    for host in "${warningList[@]}"; do
      warningMsg+="\n  ${host}"
    done

    echo
    printWarning "${warningMsg}"
  fi

  if [ "${#errorList[@]}" -gt 0 ]; then
    exit 1
  fi

  if [ "${#errorList[@]}" -eq 0 ] && [ "${#warningList[@]}" -gt 0 ]; then
    echo -e "\nInstallation can continue with the above warnings, but they may prevent RapidsSE from starting correctly."
  fi

  # Otherwise continue on warnings
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Tests that two hosts can communicate via TCP/IP.
## Params:
##  $1 - hostname of the client that is establishing the connection.
##  $2 - hostname of the server that is listening for the connection and whose
##       firewall we are testing for.
##  $3 - TCP/IP port number to use.
## Returns: a 0 exit code if the two hostnames can communicate,
##          exit code 1 if there is a communication problem
##          or exit code 2 if the TCP/IP port is already in use

function checkFirewallTcp() {

  [ "$#" -eq 3 ] || errorExit "Invalid number of arguments to function checkFirewallTcp()."

  local client="$1"
  local server="$2"
  local port="$3"

  debugPrint "checkFirewallTcp $1 $2 $3"

  # Spawn a command to test that the given TCP/IP port is not currently being
  # used on the server.
  local -a cmdServerSocketInUse=()
  cmdServerSocketInUse+=( "ssh"
                          "${SSH_COMMON_OPTIONS[@]}"
                          "${server}"
                          "nc" "-z" "localhost" "${port}"
                          "&>/dev/null" )

  debugPrint "About to execute the following command to check if TCP port ${port} is in use on host ${server}:"
  debugPrint "${cmdServerSocketInUse[*]}"

  if "${cmdServerSocketInUse[@]}" ; then
    printError "TCP port ${port} is already in use on host ${server}."
    return 2
  fi

  # Spawn the server with nc in the background, but save it's pid.
  local -a cmdServerTask=()
  local cmdServerPid
  cmdServerTask+=( "ssh"
                   "${SSH_COMMON_OPTIONS[@]}"
                   "${server}"
                   "nc" "-l" "${port}" "&>/dev/null" "&" "echo" '$!' )

  debugPrint "About to execute the following command to start a TCP netcat server on host ${server}:${port} :"
  debugPrint "${cmdServerTask[*]}"

  cmdServerPid="$("${cmdServerTask[@]}")"

  # Give the server a little bit of time to load.
  sleep 1

  # Spawn a client to try to connect to the server.
  local -a cmdClientTask=()
  local exitCode=0
  cmdClientTask+=( "ssh"
                   "${SSH_COMMON_OPTIONS[@]}"
                   "${client}"
                   "nc" "-z" "${server}" "${port}" )

  debugPrint "About to execute the following command to start a netcat client on TCP host ${client}:${port} :"
  debugPrint "${cmdClientTask[*]}"

  # Run the client and get its exit code
  if ! "${cmdClientTask[@]}" ; then
    printError "TCP port ${port} may be blocked by a firewall on on host ${server}."
    exitCode=1
  fi

  # Kill nc on the server
  local -a cmdServerKill
  cmdServerKill=( "ssh" "${SSH_COMMON_OPTIONS[@]}" "${server}" "kill" "-9" "${cmdServerPid}" "&>/dev/null" )
  "${cmdServerKill[@]}" || true

  # Return the appropriate exit code
  return "${exitCode}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Tests that two hosts can communicate via UDP/IP.
## Params:
##  $1 - hostname of the client that is establishing the connection.
##  $2 - hostname of the server that is listening for the connection and whose
##       firewall we are testing for.
##  $3 - UDP/IP port number to use.
## Returns: exit code 0 if communication was attempted and the two hostnames can communicate,
##          exit code 1 if communication was attempted and the two hostnames cannot communicate,
##          exit code 2 if a process is already using the given port on the host
##          exit code 3 if communication was not attempted because of a missing pre-requisite

function checkFirewallUdp() {

  # I really wanted to do this test using native linux commands using nc. However the mechanism
  # used needs to work on all platforms, which starts at CentOS 7. The version of nc used on
  # CentOS 7 is quite old and very different to modern nc versions. Different command line parameters
  # are supported and the behaviour is vastly different as well. There isn't one common denominator
  # we can use that will also work in a noisy UDP environment (where nc may receive UDP messages
  # from other SE clusters on the network).
  #
  # So the solution is to use Python, if it is installed, to check the UDP port accessibility
  # because it's much more consistent to write the code to do so. A CentOS 7 minimal installation
  # does include a Python interpreter by default. However the Python code needs to work across
  # a Python 2 and a Python 3 interpreter as some machines will have one or the other. So we
  # need to write it carefully.
  #
  # The idea is to copy a Python script to a client (sender) and copy a separate Python script
  # to a server (receiver). Invoke both and the server (receiver) will filter out spurious
  # messages and write the expected message to a file. If that file is non-empty then we've got
  # successful UDP communication between the two hosts on a given port.
  #
  # It's also possible that one or both hosts involved here don't have Python installed. In that
  # case we will generate a warning but let them continue to install SE. We don't want to have a
  # hard dependency on Python.
  #
  # Its also possible that there is a program already on the server (receiving) node that is
  # listening on the given UDP port (e.g. from a separate cluster). In that case we cannot
  # determine if the UDP port is accessible across the firewall because that separate program
  # will eat any UDP messages we send through, and the test will be indeterminate.

  [ "$#" -eq 3 ] || errorExit "Invalid number of arguments to function checkFirewallUdp()."

  local client="$1"
  local server="$2"
  local port="$3"

  debugPrint "checkFirewallUdp $1 $2 $3"

  # Spawn a command to check if there are any applications currently listening on
  # that given UDP port on the server. If so, we cannot reliably check because
  # unicast messages may not be received by the correct receiver, and broadcast
  # messages are not possible with all versions of netcat (particularly on CentOS 7).
  #
  # If we get any lines printed from this command then it means that the socket
  # is in use.
  local -a cmdServerSocketInUse=()
  cmdServerSocketInUse+=( "ssh"
                          "${SSH_COMMON_OPTIONS[@]}"
                          "${server}"
                          "export" 'PATH=${PATH}:/usr/sbin'
                          "&&"
                          "ss" "-lunH" "'( sport = ${port} )'" )

  debugPrint "About to execute the following command to check if UDP port ${port} is in use on host ${server}:"
  debugPrint "${cmdServerSocketInUse[*]}"

  local responseServerSocketInUse
  responseServerSocketInUse="$("${cmdServerSocketInUse[@]}")"

  if [ "${responseServerSocketInUse:-x}" != "x" ]; then
    printError "Unable to determine if UDP port ${port} is opened in the firewall of host ${server} because the socket is currently being used by another process."
    return 2
  fi

  debugPrint "The UDP port ${port} does not currently appear to be in use on host ${server}."

  # Get the python interpreter to use on the server and client, or an empty string if there is none.
  local serverPythonPath
  local clientPythonPath

  serverPythonPath="$(getPythonInterpreter "${server}")"
  clientPythonPath="$(getPythonInterpreter "${client}")"

  if [ -z "${serverPythonPath}" ]; then
    printWarning "Host ${server} does not have a python interpreter installed. Unable to check accessibility of UDP port ${port} from host ${client} to ${server}."
    return 3
  fi

  if [ -z "${clientPythonPath}" ]; then
    printWarning "Host ${client} does not have a python interpreter installed. Unable to check accessibility of UDP port ${port} from host ${client} to ${server}."
    return 3
  fi

  # Make temporary directories on the server and client hosts
  local serverTmpDir
  local clientTmpDir

  serverTmpDir="$(makeRemoteTempDir "${server}")" || errorExit "Unable to create a temporary directory on host ${server}"
  clientTmpDir="$(makeRemoteTempDir "${client}")" || errorExit "Unable to create a temporary directory on host ${client}"

  # Distribute and invoke UDP server and client processes
  local serverPid
  local clientPid

  serverPid="$(invokeUdpServer "${server}" "${port}" "${serverTmpDir}" "${serverPythonPath}")"
  clientPid="$(invokeUdpClient "${client}" "${server}" "${port}" "${clientTmpDir}" "${clientPythonPath}")"

  # Give the client and server a little bit of time to do their thing.
  sleep 1

  # Check result
  local exitCode=1
  local checkResultTimeout=5

  if checkUdpResult "${server}" "${serverTmpDir}" "${checkResultTimeout}" ; then
    exitCode=0
  fi

  # Kill the server and client processes
  local -a killCmd
  killCmd=( "ssh" "${SSH_COMMON_OPTIONS[@]}" "${server}" "kill" "-9" "${serverPid}" "&>/dev/null" )
  "${killCmd[@]}" || true

  killCmd=( "ssh" "${SSH_COMMON_OPTIONS[@]}" "${client}" "kill" "-9" "${clientPid}" "&>/dev/null" )
  "${killCmd[@]}" || true


  # Finally, clean up the temporary directory that was created on both server and client
  local -a cleanupCmd
  cleanupCmd=( "ssh" "${SSH_COMMON_OPTIONS[@]}" "${server}" "rm" "-rf" "${serverTmpDir}" "&>/dev/null" )
  "${cleanupCmd[@]}" || true

  cleanupCmd=( "ssh" "${SSH_COMMON_OPTIONS[@]}" "${client}" "rm" "-rf" "${clientTmpDir}" "&>/dev/null" )
  "${cleanupCmd[@]}" || true

  if [ "${exitCode}" -ne 0 ] ; then
    printError "UDP port ${port} may be blocked by a firewall on on host ${server}."
  fi

  # Return the result
  debugPrint "Returning exit code ${exitCode}"
  return "${exitCode}"
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns the path of the python interpreter on a given node.
## Params:
##  $1 - hostname of the node in question.
## Returns: the path of the python interpreter, or an empty string if there is none.

function getPythonInterpreter() {

  [ "$#" -eq 1 ] || errorExit "Invalid number of arguments to function getPythonInterpreter()."

  local host
  host="$1"

  local pythonInterpreterPath
  local -a pythonInterpreterCmd=()
  pythonInterpreterCmd=( "ssh"
                         "${SSH_COMMON_OPTIONS[@]}"
                         "${host}"
                         "which" "python3" "2>/dev/null" "||" "which" "python" "2>/dev/null" )


  pythonInterpreterPath="$("${pythonInterpreterCmd[@]}")"

  [ -n "${pythonInterpreterPath}" ] && echo "${pythonInterpreterPath}"
  return 0
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Makes a temporary directory on a remote node and returns its pathReturns the path of the python interpreter on a given node.
## Params:
##  $1 - hostname of the node in question.
## Returns: the path of the python interpreter, or an empty string if there is none.

function makeRemoteTempDir() {

  [ "$#" -eq 1 ] || errorExit "Invalid number of arguments to function makeRemoteTempDir()."

  local host
  host="$1"

  local -a makeTempCmd=()
  makeTempCmd=( "ssh"
                "${SSH_COMMON_OPTIONS[@]}"
                "${host}"
                "mktemp" "-d" )

  local makeTempResponse
  makeTempResponse="$("${makeTempCmd[@]}")"

  [ -n "${makeTempResponse}" ] && echo "${makeTempResponse}"
  return 0
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Copies the UDP server to the server host and invokes it
## Params:
##  $1 - hostname of the node in question.
##  $2 - UDP port number of the node in question.
##  $3 - Temp dir to copy the code to
##  $4 - Python interpreter path

## Returns: the PID of the server process

function invokeUdpServer() {

  [ "$#" -eq 4 ] || errorExit "Invalid number of arguments to function invokeUdpServer()."

  local server="$1"
  local port="$2"
  local tmpDir="$3"
  local pythonPath="$4"

  local tempFile
  tempFile="$(mktemp)"

  readonly remotePath="${tmpDir}/${UDP_RECEIVER_FILE}"

  # Write the python code to a temporary file.
  # Python code works on Python 2 and 3.
  {
    cat <<-EOF
import sys
import socket
import os

if len(sys.argv) != 3:
    print("Usage: {0} host port".format(sys.argv[0]))
    sys.exit(1)

HOST = sys.argv[1]
PORT = int(sys.argv[2])
TEMPLATE = 'checkFirewallUdp:{0}:{1}:checkFirewallUdp'.format(HOST, PORT)
OUT_FILE = 'dump.txt'
OUT_PATH = os.path.dirname(os.path.realpath(__file__)) + "/" + OUT_FILE

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.bind(('', PORT))

with open(OUT_PATH, "a") as f:
    while 1:
        (data, address) = s.recvfrom(1024)

        if isinstance(data, bytes):
            try:
                data_str = str(data, 'utf-8')
            except UnicodeDecodeError:
                continue       # Ignore binary data received
            except TypeError:  # bytes and str are identical in Python 2
                data_str = data
        else:
            data_str = data

        if data_str and data_str.strip() == TEMPLATE:
            print("From address: {0} ; Got data: {1}".format(str(address), data_str))
            f.write(data_str)
            f.write("\n")
            f.flush()
EOF
  } > "${tempFile}"

  # Copy the temporary file to the remote node
  local -a copyCmd=()
  copyCmd=( "scp"
            "${SSH_COMMON_OPTIONS[@]}"
            "${tempFile}"
            "${server}:${remotePath}")

#  debugPrint "About to execute the following command to copy the UDP python server code to host ${server} :"
#  debugPrint "${copyCmd[*]}"

  "${copyCmd[@]}" || true

  # Invoke the python code on the remote node
  local -a invokeCmd=()
  invokeCmd=( "ssh"
              "${SSH_COMMON_OPTIONS[@]}"
              "${server}"
              "${pythonPath}" "${remotePath}" "${server}" "${port}" "&>/dev/null" "&" "echo" '$!')

#  debugPrint "About to execute the following command to invoke the UDP python server code on host ${server} :"
#  debugPrint "${invokeCmd[*]}"

  local serverPid
  serverPid="$("${invokeCmd[@]}")" || errorExit "Unable to invoke the server UDP port checking code with the command:\n${invokeCmd[*]}"

  # Clean up the local temporary file used
  rm -f "${tempFile}" || true

  echo "${serverPid}"
  return 0
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Copies the UDP client to the client host and invokes it
## Params:
##  $1 - hostname of the client in question.
##  $2 - hostname of the server to send UDP packets to
##  $3 - UDP port number of the node in question.
##  $4 - Temp dir to copy the code to
##  $5 - Python interpreter path

## Returns: the PID of the server process

function invokeUdpClient() {

  [ "$#" -eq 5 ] || errorExit "Invalid number of arguments to function invokeUdpClient()."

  local client="$1"
  local server="$2"
  local port="$3"
  local tmpDir="$4"
  local pythonPath="$5"

  local tempFile
  tempFile="$(mktemp)"

  readonly remotePath="${tmpDir}/${UDP_SENDER_FILE}"

  # Write the python code to a temporary file.
  # Python code works on Python 2 and 3.
  {
    cat <<-EOF
import sys
import socket
import time

if len(sys.argv) != 3:
    print("Usage: {0} host port".format(sys.argv[0]))
    sys.exit(1)

HOST = sys.argv[1]
PORT = int(sys.argv[2])
DATA='checkFirewallUdp:{0}:{1}:checkFirewallUdp'.format(HOST, PORT)

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

while True:
#   print("Sending to address {0}:{1} Data: {2}".format(HOST, str(PORT), DATA))

    try:
        # Python 2
        s.sendto(DATA, (HOST, PORT))
    except TypeError:
        # Python 3
        s.sendto(bytes(DATA, 'utf-8'), (HOST, PORT))

    time.sleep(1)
EOF
  } > "${tempFile}"

  # Copy the temporary file to the remote node
  local -a copyCmd=()
  copyCmd=( "scp"
            "${SSH_COMMON_OPTIONS[@]}"
            "${tempFile}"
            "${client}:${remotePath}")

#  debugPrint "About to execute the following command to copy the UDP python client code to host ${client} :"
#  debugPrint "${copyCmd[*]}"

  "${copyCmd[@]}" || true

  # Invoke the python code on the remote node
  local -a invokeCmd=()
  invokeCmd=( "ssh"
              "${SSH_COMMON_OPTIONS[@]}"
              "${client}"
              "${pythonPath}" "${remotePath}" "${server}" "${port}" "&>/dev/null" "&" "echo" '$!')

#  debugPrint "About to execute the following command to invoke the UDP python client code on host ${client} :"
#  debugPrint "${invokeCmd[*]}"

  local clientPid
  clientPid="$("${invokeCmd[@]}")" || errorExit "Unable to invoke the client UDP port checking code with the command:\n${invokeCmd[*]}"

  # Clean up the local temporary file used
  rm -f "${tempFile}" || true

  echo "${clientPid}"
  return 0
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Copies the UDP client to the client host and invokes it
## Params:
##  $1 - hostname of the server receiving the UDP packets.
##  $2 - Temp dir that the server operates in
##  $3 - Max number of attempts, each 1 second apart

## Returns: nothing. Just check the exit code
function checkUdpResult() {

  [ "$#" -eq 3 ] || errorExit "Invalid number of arguments to function checkUdpResult()."

  local server="$1"
  local tmpDir="$2"
  local maxAttempts="$3"

  local dumpFilePath="${tmpDir}/dump.txt"

  local -a checkCmd=()
  checkCmd=( "ssh"
              "${SSH_COMMON_OPTIONS[@]}"
              "${server}"
              "wc" "-l" "${dumpFilePath}" "2>/dev/null" "|" "cut" "-d" "' '" "-f" "1")

  local attempts=0
  local exitCode=0

  while [ "${attempts}" -lt "${maxAttempts}" ]; do
    attempts=$((attempts + 1))

    debugPrint "About to execute the following command to check the result of the UDP dump file on host ${client} :"
    debugPrint "${checkCmd[*]}"

    local numLines
    numLines="$("${checkCmd[@]}")" || errorExit "Unable to check the result of the UDP dump file with the command:\n${checkCmd[*]}"

    if [ -z "${numLines}" ] || [ "${numLines}" -eq 0 ]; then
      exitCode=1

    else
      # Success!
      exitCode=0
      break
    fi

    sleep 1
  done

  return "${exitCode}"
}
