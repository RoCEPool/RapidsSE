  declare -a failedNodes=()

  debugPrint "Validating bash version"

  for nodeName in "${nodeNames[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    # shellcheck disable=SC2016
    remoteCmd='which bash &>/dev/null && echo "${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}.${BASH_VERSINFO[2]}" 2>/dev/null'

    sshArgs=("-q" "-o" "StrictHostKeyChecking no" "${host}" "bash" "-c" "'${remoteCmd}'")

    # Run it and check if it returned with a success error code
    if ! output="$(ssh "${sshArgs[@]}" || true)" ; then
      failedNodes+=("${nodeName}")
      continue
    fi

    # Check the gcc version is sufficient.
    # First check if the output is empty.
    if [ -z "${output:-}" ]; then
      failedNodes+=("${nodeName}")
      continue;
    fi

    # Check the version number.
    if ! isVersionGreaterThanOrEqualTo "${output}" "${BASH_MINIMUM_VERSION}" ; then
      debugPrint "BASH on node ${nodeName} is too old - Found: ${output} ; Required: ${BASH_MINIMUM_VERSION}"
      failedNodes+=("${nodeName}")
      continue
    fi
  done

  if [ "${#failedNodes[@]}" -gt 0 ]; then
    local errMsg="Bash is either not installed or is too old (min: ${BASH_MINIMUM_VERSION}) on the following nodes:"

    for nodeName in "${failedNodes[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      errMsg+="$(printf "\n  %-12s [host: %12s]" "${nodeName}" "${host}")"
    done

    errorExit "${errMsg}"
  fi
}

