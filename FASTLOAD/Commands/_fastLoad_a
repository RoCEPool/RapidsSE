/* _fastLoad_a -- fast load script (original)                                 */
/*============================================================================*/

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print division "Fast Load A --" <fl_name> ;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Create Table" <fl_table> ;

drop table <fl_table> ;

<fl_create> ;

lsCol <fl_table> ;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Load File" <fl_file> ;

load <fl_table> <fl_file> ;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Scan Table" <fl_table>;

tableScan <fl_table>;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Convert Test" <fl_table> ;

exp_fl;

