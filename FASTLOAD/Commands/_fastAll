/*============================================================================*/
/* _fastAll -- base test of fast load of all column types                     */
/*============================================================================*/

bc;

tag <fl_table> = allTyp;
tag <fl_file>  = "../FASTLOAD/Data/allTyp.csv";

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "Create allTyp";

drop table allTyp;

create table allTyp (
  int INTEGER       NOT NULL,
                     
  bcd DECIMAL(15,2) NOT NULL,
  bol BOOLEAN       NOT NULL,
  dte DATE          NOT NULL,
  flt FLOAT         NOT NULL,
  ivl INTERVAL      NOT NULL,
  tme TIME          NOT NULL,
  tsp TIMESTAMP     NOT NULL,
  vch VARCHAR       NOT NULL
);

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "Load allTyp";

load allTyp "../FASTLOAD/Data/allTyp.csv" ;


//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "scan allTyp";

tableScan allTyp;

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "convert allTyp";

exp_fl;

