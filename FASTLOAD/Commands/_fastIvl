print section "Load uniIvl";

load uniIvl "../FASTLOAD/Data/uniIvl.csv" ;


//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "scan uniIvl";

tableScan uniIvl;

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "convert uniIvl";

exp_fl;

