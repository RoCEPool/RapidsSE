/*============================================================================*/
/* _fastLoad_b -- fast load script using new fload pipeline                   */
/*============================================================================*/

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print division "Fast Load B --" <fl_name> ;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Create Table" <fl_table> ;

drop table <fl_table> ;

<fl_create> ;

lsCol <fl_table> ;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Load File" <fl_file> ;

fload <fl_table> <fl_file> ;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Scan Table" <fl_table>;

tableScan <fl_table>;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
