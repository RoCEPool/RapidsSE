/* _fastFlt -- base test of fast load of float column                         */
/*============================================================================*/

bc;

tag <fl_table> = uniFlt;
tag <fl_file>  = "../FASTLOAD/Data/uniFlt.csv";

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "Create uniFlt";

drop table uniFlt;

create table uniFlt (
  flt FLOAT NOT NULL
);

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "Load uniFlt";

load uniFlt "../FASTLOAD/Data/uniFlt.csv" ;


//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "scan uniFlt";

tableScan uniFlt;

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "convert uniFlt";

exp_fl;

