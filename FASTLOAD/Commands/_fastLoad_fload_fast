/*============================================================================*/
/* _fastLoad_fload -- fast load script using new FLOAD procedure              */
/*============================================================================*/

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print division "Fast Load B (new FLOAD) --" <fl_name> ;

trackMemory;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Create Table" <fl_table> ;

drop table <fl_table> ;

<fl_create> ;

lsCol <fl_table> ;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Load File" <fl_file> ;

/time floadFast <fl_table> <fl_file> ;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
//print section "Scan Table" <fl_table>;
//
//tableScan <fl_table>;

// -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - -- - --
print section "Analyse and Size" <fl_table> ;

antbl <fl_table> ;

sztbl <fl_table> ;

drop table <fl_table> ;

sleep 2;

memoryLeaks;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
