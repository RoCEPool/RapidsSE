bc;

tag <fl_table> = uniBol;
tag <fl_file>  = "../FASTLOAD/Data/uniBol.csv";

//-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/-/
print section "Create uniBol";

drop table uniBol;

create table uniBol (
