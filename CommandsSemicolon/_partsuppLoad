/*============================================================================*/
/* _partsuppLoad -- create and load TPC-H PartSupp table for SF1              */
/*============================================================================*/

cf~
cf tenants
cf boray
cf catalogs
cf rapidsse
cf schemas

create schema tpchSchema;

cf tpchSchema
cf tables

create table partsupp (
	PS_PARTKEY      INTEGER NOT NULL,
	PS_SUPPKEY      INTEGER NOT NULL,
	PS_AVAILQTY     INTEGER NOT NULL,
	PS_SUPPLYCOST   DECIMAL(15,2) NOT NULL,
	PS_COMMENT      VARCHAR(199) NOT NULL
);

print "loading partsupp.tbl..."
ld partsupp "/tpch/partsupp.tbl"

pwf
lf

