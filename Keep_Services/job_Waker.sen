/*============================================================================*/
/* job_Waker.sen -- Waker Job                                                 */
/*============================================================================*/

" job_Waker.sen" .verbose

/*----------------------------------------------------------------------------*/
/* waker loop:                                                                */
/*----------------------------------------------------------------------------*/
: waker_req ( -- )

  std_entryHook

  begin

    1 thread::sleepSsec

    // "checking..." .

    queues::checkSleeping

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: waker :: waker ;

: waker _cmdTags tags{
  <cmdDesc>  = "--cmd desc for job--"
  
  <jobKind>  = JK_LOCAL
  <rspKind>  = RS_NONE
  <ddlLock>  = DL_NONE
  
  //<preCheck> = bClusterStarted
  
  <cmdKind>  = CK_SERVICE
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
