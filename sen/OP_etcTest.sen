/*============================================================================*/
/* OP_etcTest.sen -- etc test operator                                        */
/*============================================================================*/

" OP_etcTest" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: etcTest_DataMarker \handler

  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut
  <etc> <arg2> <arg1> "etcTest : arg1 = %v arg2 = %v etc = %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/* etcTest request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: etcTest::geb \operator

  _lu_initialise_

  op__topology

  find: etcTest_DataMarker ZK_M_DATAPULSE op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: etcTest :: etcTest <arg1> <arg2> <etc> ;

: etcTest_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>     = "--desc for op--"
  }
;
    

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
