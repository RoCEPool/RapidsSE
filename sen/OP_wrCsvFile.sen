/*============================================================================*/
/* OP_wrCsvFile.sen -- write csv file                                         */
/*============================================================================*/

" OP_wrCsvFile.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: wrCsvFile_Cleaning \handler

  File0[].isNull not if
    File0[].get file.close
    File0[].get file.delete
  then

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: wrCsvFile_CrwBuffer \handler

  PipeIn[]\clear to CrwBuffer[]

  // write the CRWBUFFER to file

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CSVBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: wrCsvFile_CsvBuffer \handler

  PipeIn[]\clear to CsvBuffer[]

  // write the CSVBUFFER to file

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PDSROWBUFFER ...                                          */
/*----------------------------------------------------------------------------*/
: wrCsvFile_PdsRowBuffer \handler

  PipeIn[]\clear to Pds[]

  // pipeout buffers other than BT_DATA
  Pds[].bufferType@ BT_DATA != if
    Pds[].pipeout
    true
    exit
  then

  // write the PDSROWBUFFER to file

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: wrCsvFile_StartMarker \handler

  PipeIn[].pipeOut

  // open the file for writing
  <fileNm> OPEN_WRITE op__file discard

  true
;

/*----------------------------------------------------------------------------*/
/* execute for wrCsvFile req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : wrCsvFile_op \operator
 
  _lu_initialise_

  op__topology

  find: wrCsvFile_Cleaning    EV_M_CLEANING    [op].handler!
  find: wrCsvFile_CrwBuffer   EV_D_CRWBUFFER   [op].handler!
  find: wrCsvFile_CsvBuffer   EV_D_CSVBUFFER   [op].handler!
  find: wrCsvFile_PdsRowBuffer   EV_D_PDSROWBUFFER   [op].handler!
  find: wrCsvFile_StartMarker EV_M_START       [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: wrCsvFile :: wrCsvFile <fileNm> ;

: wrCsvFile_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "wrCsvFile_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
