" pp_std_first.sen" .verbose
  
  STD_PATH_TAG
  "
  procedure std_first
    tags <as_first>
  begin

    stage stageA on origin :
    
        start
      | pulse once
      | next

  end ;
  "
  api::addProcedure
;

