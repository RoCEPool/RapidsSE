" it_compileErrors.sen" .verbose

: start::it_compileErrors

  // C_TDEF_COMPILEERRORS
  
  STD_WAIT_PATH_TAG
  "
  define table __compileErrors (
    nodeName       VARCHAR NOT NULL ,
    errorCode      INTEGER NOT NULL ,
    line           INTEGER NOT NULL ,
    column         INTEGER NOT NULL ,
    text           VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::forkChild api:executeCheck

;

