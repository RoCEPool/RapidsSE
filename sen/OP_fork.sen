/*============================================================================*/
/* OP_fork.sen -- Operator fork                                               */
/*============================================================================*/

" OP_fork.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: fork_EosMarker \handler

  <responseOpNm> [stream].findOp locals| pResponseOp |

  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_I_FORKCOMMAND ...                                           */
/*----------------------------------------------------------------------------*/
: fork_ForkCommand \handler

  <responseOpNm> [stream].findOp locals| pResponseOp |
  
  pResponseOp "some-pipeline" api::forkCommand assert

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: fork_StartMarker \handler
  
  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute fork op                                                            */
/*----------------------------------------------------------------------------*/
 : fork_op \operator

  _lu_initialise_

  op__topology

  find: fork_EosMarker     ZK_M_EOS           [op].handler!
  find: fork_ForkCommand   ZK_I_FORKCOMMAND   [op].handler!
  find: fork_StartMarker   ZK_M_START         [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: fork :: fork <responseOpNm> ;

: fork_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "fork_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
