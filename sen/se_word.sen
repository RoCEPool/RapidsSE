/*============================================================================*/
/* se_word.sen -- additional word related words                               */
/*============================================================================*/

" se_word.sen" .verbose

/*----------------------------------------------------------------------------*/
/* ensure the word has an ename set                                           */
/*----------------------------------------------------------------------------*/
: word.ensureTagSet params| pWord |

  pWord word.tagSet@ not if
    tagSet::new pWord word.tagSet!
  then
;

/*----------------------------------------------------------------------------*/
/* check for known word                                                       */
/*----------------------------------------------------------------------------*/
: word::isKnown ( <"wordNm"> )
  find
  not if EC_NO_SUCH_WORD false exit_rt then
  true
;

/*----------------------------------------------------------------------------*/
/* return word name with any suffix removed                                   */
/*----------------------------------------------------------------------------*/
: word.name_trunc params| pWord |

  "_" pWord word.name@ str.removeSuffix
;

/*----------------------------------------------------------------------------*/
/* show details of given word                                                 */
/*----------------------------------------------------------------------------*/
: word.show params| pWord |

  pWord word.name@     locals| sWordName |
  pWord word.category@ locals| pCatg     |
  pCatg word.name@     locals| sCatgName |

  pWord word.include@  locals| pInclude |
  pWord word.tagSet@   locals| pWordTags |

  sWordName sCatgName "%12v : %24v" .putf

  pInclude if
    pInclude word.name@ " : %16v" .putf
  else
    " " " : %16v" .putf
  then

  pWordTags if
    pWordTags tagSet.asStr "  %v" .putf
  then

  .\n
;

/*----------------------------------------------------------------------------*/
/* set word as a c++ object and encode push of the c++ object as the routine  */
/*----------------------------------------------------------------------------*/
: word.cppObject! params| pwObject pObject pwCatg |

  WK_CPPOBJECT pwObject word.kind!

  pObject pwObject word.object!

  pwCatg pwObject word.category!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pwObject compiler::current!

  pwObject encode::push

  POSTPONE word.object@

  POSTPONE exit_rt

  //[ compiler::current@ word.see ]
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* show all words that of given catg                                          */
/*----------------------------------------------------------------------------*/
: word::ofCatg params| pCatg |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor

    object@ locals| pWord |

    pWord word.category@ pCatg eql if
      pWord word.show
    then

    object@ word.prev object!             // advance cursor backwards thru words
  next
;

/*----------------------------------------------------------------------------*/
/* get a sorted arrangement of all words                                      */
/*----------------------------------------------------------------------------*/
: arrange::allWords

  arrange::new locals| pArrange |

  iterate-words
 
    word@ word.name@ word@ pArrange arrange.insert

  next-word

  pArrange arrange.sequence

  pArrange
;

/*----------------------------------------------------------------------------*/
/* get a sorted arrangement of all words which are of given category          */
/*----------------------------------------------------------------------------*/
: arrange::wordsOfCatg params| pCatg |

  arrange::new locals| pArrange |

  iterate-words

    word@ word.category@ pCatg eql if
      word@ word.name@ word@ pArrange arrange.insert
    then

  next-word

  pArrange arrange.sequence

  pArrange
;

/*----------------------------------------------------------------------------*/
/* print contents of arrangement                                              */
/*----------------------------------------------------------------------------*/
: arrange.print params| pArrange |

  nullptr locals| pCursor |
  begin
    pCursor pArrange arrange.next to pCursor
    pCursor
  while
    pCursor pArrange arrange.name .
  repeat
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
