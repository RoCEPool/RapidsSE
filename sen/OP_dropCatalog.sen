/*============================================================================*/
/* OP_dropCatalog.sen -- Operator drop catalog                                */
/*============================================================================*/

" OP_dropCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: dropCatalog_DataMarker

  0 locals| errorCode |

  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove catalog
  <catalogNm> checkRemoveCatalog not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  <catalogNm> removeCatalog

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createCatalog req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropCatalog_req \operator

  _lu_initialise_

  op__topology

  find: dropCatalog_DataMarker ZK_M_DATAPULSE op[].handler!

  op__loop

  _lu_finalise_
  
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropCatalog :: dropCatalog <catalogNm> ;

: dropCatalog_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
