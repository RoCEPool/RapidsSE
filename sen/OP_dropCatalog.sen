/*============================================================================*/
/* OP_dropCatalog.sen -- Operator drop catalog                                */
/*============================================================================*/

" OP_dropCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: dropCatalog_DataMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove catalog
  <catalogNm> checkRemoveCatalog not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  <catalogNm> removeCatalog

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createCatalog req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropCatalog_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dropCatalog_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropCatalog :: dropCatalog <catalogNm> ;

: dropCatalog _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
