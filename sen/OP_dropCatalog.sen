/*============================================================================*/
/* OP_dropCatalog.sen -- Operator drop catalog                                */
/*============================================================================*/

" OP_dropCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* drop a catalog entry in the metadata tables                                */
/*----------------------------------------------------------------------------*/
: metadata_dropCatalog params| sCatalogNm |

  sCatalogNm MetaDataTable[].deleteCatalog
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: dropCatalog_DataMarker

  0 locals| errorCode |

  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove catalog
  <catalogNm> checkRemoveCatalog not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the catalog
  <catalogNm> removeCatalog

  <catalogNm> metadata_dropCatalog

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createCatalog req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropCatalog_op \operator

  _lu_initialise_

  op__topology

  find: dropCatalog_DataMarker EV_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropCatalog :: dropCatalog <catalogNm> ;

: dropCatalog_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "dropCatalog_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
