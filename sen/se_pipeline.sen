/*============================================================================*/
/* se_pipeline.sen -- supplementary pipeline words                            */
/*============================================================================*/

" se_pipeline.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: indexDef[].pipeOut

  IndexDef[]
    nullptr to IndexDef[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: InfoSet[].pipeOut

  InfoSet[]
    nullptr to InfoSet[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Operand[].pipeOut

  Operand[]
    nullptr to Operand[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: OperandB[].pipeOut

  OperandB[]
    nullptr to OperandB[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: OperandC[].pipeOut

  OperandC[]
    nullptr to OperandC[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: OperandOoO[].pipeOut

  OperandOoO[]
    nullptr to OperandOoO[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Operand[].pipeBackIn
  Operand[]
    nullptr to Operand[]

  Op::pipeBackIn
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PipeIn[].pipeOut

  PipeIn[]
    nullptr to PipeIn[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PipeIn[].pipeBackin

  PipeIn[]
    nullptr to PipeIn[]

  Op::pipeBackin
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefLft[].pipeOut

  StreamDefLft[]
    nullptr to StreamDefLft[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefRht[].pipeOut

  StreamDefRht[]
    nullptr to StreamDefRht[]

  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefOut[].pipeOut

  StreamDefOut[]
    nullptr to StreamDefOut[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamSet[].pipeOut

  StreamSet[]
    nullptr to StreamSet[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* drain the operand queue                                                    */
/*----------------------------------------------------------------------------*/

: PipeIn[].drain

  begin
    PipeIn[].peek
  while
    PipeIn[].next
    Pipein[].delete
  repeat
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
