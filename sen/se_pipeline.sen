/*============================================================================*/
/* se_pipeline.sen -- supplementary pipeline words                            */
/*============================================================================*/

" se_pipeline.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: DataBuffer[].pipeOut

  DataBuffer[]
    nullptr to DataBuffer[]

  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: CrwBuffer[].pipeOut

  CrwBuffer[]
    nullptr to CrwBuffer[]

  Op::pipeout
;
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: CsvBuffer[].pipeOut

  CsvBuffer[]
    nullptr to CsvBuffer[]

  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: indexDef[].pipeOut

  IndexDef[]
    nullptr to IndexDef[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: InfoSet[].pipeOut

  InfoSet[]
    nullptr to InfoSet[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Marker[].pipeBackIn
  Marker[]
    nullptr to Marker[]

  Op::pipeBackIn
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Marker[].pipeOut

  Marker[]
    nullptr to Marker[]

  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Operand[].pipeOut

  Operand[]
    nullptr to Operand[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: OperandOoO[].pipeOut

  OperandOoO[]
    nullptr to OperandOoO[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Operand[].pipeBackIn
  Operand[]
    nullptr to Operand[]

  Op::pipeBackIn
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PipeIn[].pipeOut

  PipeIn[]
    nullptr to PipeIn[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PipeIn[].pipeBackin

  PipeIn[]
    nullptr to PipeIn[]

  Op::pipeBackin
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: RowBuffer[].pipeOut

  RowBuffer[]
    nullptr to RowBuffer[]

  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefLft[].pipeOut

  StreamDefLft[]
    nullptr to StreamDefLft[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefRht[].pipeOut

  StreamDefRht[]
    nullptr to StreamDefRht[]

  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefOut[].pipeOut

  StreamDefOut[]
    nullptr to StreamDefOut[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamSet[].pipeOut

  StreamSet[]
    nullptr to StreamSet[]
    
  Op::pipeout
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* drain the operand queue                                                    */
/*----------------------------------------------------------------------------*/

: PipeIn[].drain

  begin
    PipeIn[].peek
  while
    PipeIn[].next
    Pipein[].delete
  repeat
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
