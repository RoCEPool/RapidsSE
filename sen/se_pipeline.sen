/*============================================================================*/
/* se_pipeline.sen -- supplementary pipeline words                            */
/*============================================================================*/

" se_pipeline.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: DataBuffer[].pipeOut

  DataBuffer[]
    nullptr to DataBuffer[]

  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: BufferId[].pipeOut

  BufferId[]\clear

  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: BufferId[].pipeBackin

  BufferId[]\clear

  [op].pipeBackin
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: CrwBuffer[].pipeOut

  CrwBuffer[].bufferId to BufferId[]

  nullptr to CrwBuffer[]

  BufferId[].dropLock

  BufferId[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: CsvBuffer[].pipeOut

  CsvBuffer[]
    nullptr to CsvBuffer[]

  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: IndexDef[].pipeOut

  IndexDef[]
    nullptr to IndexDef[]
    
  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
/*
: InfoSet[].pipeOut

  InfoSet[]
    nullptr to InfoSet[]
    
  [op].pipeout
;
*/
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Marker[].pipeBackIn
  Marker[]
    nullptr to Marker[]

  [op].pipeBackin
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Marker[].pipeOut

  Marker[]
    nullptr to Marker[]

  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: MetaGet[].pipeOut

  MetaGet[]
    nullptr to MetaGet[]

  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: OperandOoO[].pipeOut

  OperandOoO[]
    nullptr to OperandOoO[]
    
  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: Pds[].pipeOut

  Pds[].bufferId to BufferId[]

  nullptr to Pds[]

  BufferId[].dropLock

  BufferId[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PdsErr[].pipeOut

  PdsErr[].bufferId to BufferId[]

  nullptr to PdsErr[]

  BufferId[].dropLock

  BufferId[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PdsWarn[].pipeOut

  PdsWarn[].bufferId to BufferId[]

  nullptr to PdsWarn[]

  BufferId[].dropLock

  BufferId[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PipeIn[].pipeOut

  PipeIn[]
    nullptr to PipeIn[]
    
  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PipeIn[].pipeBackin

  PipeIn[]
    nullptr to PipeIn[]

  [op].pipeBackin
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: PlanOperand[].pipeOut

  PlanOperand[]
    nullptr to PlanOperand[]

  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: RowBuffer[].pipeOut

  RowBuffer[].bufferId@ to BufferId[]

  nullptr to RowBuffer[]

  BufferId[].dropLock

  BufferId[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: RowBufferErr[].pipeOut

  RowBufferErr[].bufferId to BufferId[]

  nullptr to RowBufferErr[]

  BufferId[].dropLock

  BufferId[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefLft[].pipeOut

  StreamDefLft[]
    nullptr to StreamDefLft[]
    
  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefRht[].pipeOut

  StreamDefRht[]
    nullptr to StreamDefRht[]

  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

: StreamDefOut[].pipeOut

  StreamDefOut[]
    nullptr to StreamDefOut[]
    
  [op].pipeout
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* drain the operand queue                                                    */
/*----------------------------------------------------------------------------*/

: PipeIn[].drain

  begin
    PipeIn[].peek
  while
    PipeIn[].next
    Pipein[].delete
  repeat
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
