/*============================================================================*/
/* cmd_reject.sen -- 1sc: given pipeline has reject on participant              */
/*============================================================================*/

" cmd_reject.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                    ON ORIGINATING NODE OF GIVEN PIPELINE                   */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/
: reject:onOrigin
  "reject:onOrigin" .
  
/* <bgn org */  [args].distJob if
/* <bgn org */    "reject" "onOrigin" "<bgn org"
/* <bgn org */      "ack origin job-task"                            [job].trace
/* <bgn org */  then
/* <bgn org */
/* <bgn org */
/* <bgn org */  // find the originating job
/* <bgn org */
/* <bgn org */  [job].originId@ ListedJob[].findOriginator? if
/* <bgn org */
/* <bgn org */    ListedJob[].taskAck
/* <bgn org */
/* <bgn org */    ListedJob[].returnReference
/* <bgn org */
/* <bgn org */  then
/* <bgn org */
/* <bgn org */  [job]:retireAndExit
/* <bgn org */  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: reject:onParticipant
  "reject:onParticipant" .

/* <bgn ptp */  [args].distJob if
/* <bgn ptp */    "reject" "onParticipant"
/* <bgn ptp */      "<bgn ptp" "snd reject to origin"                 [job].trace
/* <bgn ptp */  then
/* <bgn ptp */
/* <bgn ptp */  "reject:onOrigin" [job].entryPoint!
/* <bgn ptp */
/* <bgn ptp */  [job].originNodeId@ [grid].findNodeByNo to SendNode[]
/* <bgn ptp */
/* <bgn ptp */  job.send
/* <bgn ptp */
/* <bgn ptp */  nullptr to SendNode[]
/* <bgn ptp */
/* <bgn ptp */  [job]:retireAndExit
/* <bgn ptp */  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: reject :: reject ;

: reject_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "reject:onParticipant"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
