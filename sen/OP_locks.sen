/*============================================================================*/
/* op_locks.sen -- show locks                                                 */
/*============================================================================*/

" op_locks.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: locks_action
  
  locks::show
  
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: locks :: locks ;

: locks_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 0

    <opEntry> = "locks_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
