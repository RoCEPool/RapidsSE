/*============================================================================*/
/* OP_rlu.sen -- Operator RLU                                                 */
/*============================================================================*/

" OP_rlu.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: rlu_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // cleanup the pot
  PotRlu[].cleanup

  //Counter0[] cleanUpAsm

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: rlu_CrwBuffer \handler

  0 ZK_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  Pipein[]\clear to CrwBuffer[]
  CrwBuffer[] DevLftIxt.crwBuffer!
  nullptr to CrwBuffer[]
  ZK_D_CRWBUFFER Counter0[] executeAsmArgs

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: rlu_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_M_EOS Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: rlu_RowBuffer \handler

  0 ZK_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  Pipein[]\clear to RowBuffer[]
  RowBuffer[] DevLftRow.rowBuffer!
  ZK_D_ROWBUFFER Counter0[] executeAsmArgs

  RowBuffer[].delete

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: rlu_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: rlu_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  // HACK FOR LOOPJOIN
  Counter1[] if
    Pipein[].pipeOut
    true
    exit
  then

  1 to Counter1[]

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // evaluate the project expression
  ExprEval[].new
  StreamDefOut[].new
  <project> StreamDefLft[] StreamDefOut[] ExprEval[].evaluate to eError

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // evaluate the filter expression
  Filter[].new
  <filter> StreamDefLft[] nullptr Filter[].evaluate to eError

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // generate the asm for projection
  ExprEval[] Filter[] LogicUnit[].genFilterProject to eError
  ExprEval[].delete
  Filter[].delete

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // set the streamDef in the DevLftRow
  StreamDefLft[]\clear DevLftRow.streamDef!

  // create rowPix in potRlu[] from streamDefOut[]
  false streamDefOut[] PotRlu[].rowPix!

  // pipeout the streamDefOut
  StreamDefOut[].pipeout

  // create the compiler
  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then

  // execute the streamDef asm handler
  ZK_D_STREAMDEF Counter0[] executeAsmArgs

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: rlu_op \operator

  _lu_initialise_

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: rlu_Cleaning      ZK_M_CLEANING      op[].handler!
  find: rlu_CrwBuffer     ZK_D_CRWBUFFER     op[].handler!
  find: rlu_EosMarker     ZK_M_EOS           op[].handler!
  find: rlu_RowBuffer     ZK_D_ROWBUFFER     op[].handler!
  find: rlu_StartMarker   ZK_M_START         op[].handler!
  find: rlu_StreamDef     ZK_D_STREAMDEF     op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rlu :: rlu <compiled> filter <filter> , project <project> ;

: rlu_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
