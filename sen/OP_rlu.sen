/*============================================================================*/
/* OP_rlu.sen -- Operator RLU                                                 */
/*============================================================================*/

" OP_rlu.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: rlu_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: rlu_CrwBuffer \handler

  0 ZK_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  Pipein[]\clear to CrwBuffer[]
  CrwBuffer[].flatten

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: rlu_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction

  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: rlu_RowBuffer \handler

  0 ZK_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  ZK_D_ROWBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: rlu_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: rlu_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  ZK_D_STREAMDEF_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: rlu_op \operator

  _lu_initialise_

  op__topology

  find: rlu_Cleaning      ZK_M_CLEANING      op[].handler!
  find: rlu_CrwBuffer     ZK_D_CRWBUFFER     op[].handler!
  find: rlu_EosMarker     ZK_M_EOS           op[].handler!
  find: rlu_RowBuffer     ZK_D_ROWBUFFER     op[].handler!
  find: rlu_StartMarker   ZK_M_START         op[].handler!
  find: rlu_StreamDef     ZK_D_STREAMDEF     op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rlu :: rlu ;

: rlu_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "rlu_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
