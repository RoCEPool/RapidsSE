/*============================================================================*/
/* OP_gridRecv.sen -- Operator grid recv                                      */
/*============================================================================*/

" OP_gridRecv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_PARCEL ...                                                           */
/*----------------------------------------------------------------------------*/
: gridRecv_Parcel \handler
  " gridRecv_Parcel" .

  Pipein[]\clear to Parcel[]  // pop the pParcel and put in the Parcel register

  // returns table ptr
  Parcel[]\clear [grid].putParts locals| pGrid |

  // get table name to create folder
  //pTable table.getName locals| sTableNm |

  // sTableNm .

  //path[].tostr .      // display the path

  //sTableNm table::makeTableFolder
  //sTableNm Path[].pushNamedTableFolder

  // put the table ptr to
  //pTable table::addToFolder

  //Path[].popNamedTableFolder

  true
;

/*----------------------------------------------------------------------------*/
/* execute for gridRecv request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: gridRecv_op \operator

  _lu_initialise_
  //"gridRecv_req" .

  op__topology

  // Setup EV_D_PARCEL handler here
  find: gridRecv_Parcel EV_D_PARCEL [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: gridRecv :: gridRecv ;

: gridRecv_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "gridRecv_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
