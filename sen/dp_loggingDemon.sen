/*============================================================================*/
/* dp_loggingDemon.sen -- Logging Demon Procedure                            */
/*============================================================================*/

" dp_loggingDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* logging demon                                                              */
/*----------------------------------------------------------------------------*/
: loggingDemonPipeline

  "
    pipelineLocal loggingDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | logging
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
