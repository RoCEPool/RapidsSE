/*============================================================================*/
/* pp_std_output.sen -- standard output stage                                 */
/*============================================================================*/

" pp_std_output.sen" .verbose
  
  STD_PATH_TAG
  "
  procedure std_output
    tag <as_last> = 1 endTag
  begin

    stage stageOutput on origin :
    
        output
      | sink
      | first

  end ;
  "
  procedure::add
;

