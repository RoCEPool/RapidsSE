" se_experiments.sen" .verbose

/*----------------------------------------------------------------------------*/
/* interpret mleak                                                            */
/*----------------------------------------------------------------------------*/
: mleak \prompt

  [system].bpa

  "\"Hello\" ." >interpret
  
  [system].bpa
;


/*----------------------------------------------------------------------------*/
/* exit test                                                                  */
/*----------------------------------------------------------------------------*/
: exit_test \prompt

  set_hook
  //[ "eg_hook" senCompiler::current@ word.exitHook! ]

  1 if
    "exit with hook" . exit
  else
    "normal exit"    . exit_rt
  then
;

