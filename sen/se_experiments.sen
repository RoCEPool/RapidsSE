/*============================================================================*/
/* se_experiments.sen -- forth experiments                                    */
/*============================================================================*/

" se_experiments.sen" .verbose

/*----------------------------------------------------------------------------*/
/* interpret mleak                                                            */
/*----------------------------------------------------------------------------*/
: mleak \prompt

  [system].bpa

  "\"Hello\" ." >interpret
  
  [system].bpa
;


/*----------------------------------------------------------------------------*/
/* exit test                                                                  */
/*----------------------------------------------------------------------------*/
: exit_test \prompt

  set_hook
  //[ "eg_hook" senCompiler::current@ word.exitHook! ]

  1 if
    "exit with hook" . exit
  else
    "normal exit"    . exit_rt
  then
;

/*----------------------------------------------------------------------------*/
/* hello world                                                                */
/*----------------------------------------------------------------------------*/
: helloWorld \prompt

  "Hello World!" .
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp1 \prompt

;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp2 \prompt

;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp3 \prompt

;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp4 \prompt

"
  create table definition __Exp4 (
    nodeName       VARCHAR NOT NULL ,
    partition      INTEGER NOT NULL ,
    buffers        INTEGER NOT NULL ,
    entries        INTEGER NOT NULL
  ) ;
"
  locals| sStmt |

  "" sStmt api::executeCommand 2discard
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp5 \prompt

  "<promptTag>" [job].tagSet@ tagSet.hasName if
    <promptTag> "<promptTag> = %v" .printf
  else
    "NO SUCH <promptTag>" .
  then
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp6 \prompt

  [job].tagSet@ tagSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp7 \prompt

  arrange::allWords locals| pArrange |
  pArrange arrange.print
  pArrange arrange.delete

  // - - - - - - -

  find: _cmdTags arrange::wordsOfCatg to pArrange
  pArrange arrange.print
  pArrange arrange.delete
;


