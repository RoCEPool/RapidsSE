/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp5 \prompt

  "<promptTag>" [job].tagSet@ tagSet.hasName if
    <promptTag> "<promptTag> = %v" .printf
  else
    "NO SUCH <promptTag>" .
  then
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp6 \prompt

  [job].tagSet@ tagSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* execute a statement                                                        */
/*----------------------------------------------------------------------------*/
: exp7 \prompt

  arrange::allWords locals| pArrange |
  pArrange arrange.print
  pArrange arrange.delete

  // - - - - - - -

  WC_CMDTAGS arrange::wordsOfCatg to pArrange
  pArrange arrange.print
  pArrange arrange.delete
;

// Usage:
// STD_NORMALFORK_WAIT_TAG "select * from uniqueTable;" NestedSql[]
/*----------------------------------------------------------------------------*/
/* Step to run an sql statement as a child process                            */
/*----------------------------------------------------------------------------*/
: NestedSql[]
  params| sSqlStmt |
  params| sTagSet |

  0 locals| sSmt |

  sSqlStmt "sqlCompiler \"%v\"" str.format to sSmt

  // sSmt "FORKING CHILD FOR PIPELINE: %v"  str.format .

  // spawn a job for the smt
  [op] [job].responseOp!
  sTagSet sSmt nullptr api::forkChildNestedSql not if
    "Error Code %v" .printf
    nullptr [job].responseOp!
    //op__execErr
    true
    exit
  then
;

