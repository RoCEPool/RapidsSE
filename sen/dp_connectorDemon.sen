/*============================================================================*/
/* dp_connectorDemon.sen -- Connector Demon                                   */
/*============================================================================*/

" dp_connectorDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* pipeline/procedure text for connector demon                                */
/*----------------------------------------------------------------------------*/
procText:
  pipelineLocal connectorDemonPipeline
    tag "<pre_execute>" = "demon::install" endTag
  begin

    stage stageA on origin :
        start
      | connector
      | eatAll
      | stageA

  end
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
