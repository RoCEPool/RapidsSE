/*============================================================================*/
/* OP_parser.sen -- Parser Op (SQL Compiler)                                  */
/*============================================================================*/

" OP_parser.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: parser_CancelMarker \handler

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: parser_DataPulse \handler

  // create the command error info set
  op__cmdErrInfoSet

  <sqlStatement> sqlCompiler::parser to Operand[]

  Operand[].isNull if
    InfoSet[].pipeOut
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // no error, delete the infoset
  InfoSet[].delete

  // does the sql have an explain ?
  Operand[] "parser" sqlCompiler::hasExplain if

    // find the __explain tabledef
    C_TDEF_EXPLAIN op__tableDef_streamSet assert

    // create a new streamDef
    streamSetTable[] StreamDef[].new

    // create an StreamSet operand
    streamSetTable[] StreamSet[].new

    // execute explain for this operator
    Operand[] "parser" sqlCompiler::doExplain

    // pipeout streamDef of explain
    StreamDef[].pipeout

    // pipeout explain
    StreamSet[].pipeout

    LogicUnit[].compilerToExit if
      Pipein[].delete
      Operand[].delete
      Operand[].newExitEarlyMarker
      Operand[].pipeout
      true
      exit
    then

  then

  ZK_DATAPULSE_handler
  Operand[].pipeOut
  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: parser_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: parser_CancelMarker ZK_CANCELMARKER op[].handler!
  find: parser_DataPulse    ZK_DATAPULSE    op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: parser :: parser <sqlStatement> ;

: parser_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
