/*============================================================================*/
/* OP_parser.sen -- Parser Op (SQL Compiler)                                  */
/*============================================================================*/

" OP_parser.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: parser_CancelMarker \handler

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: parser_DataMarker \handler

  // create the command error info set
  op__cmdErrInfoSet

  <sqlStatement> sqlCompiler::parser to Operand[]

  Operand[].isNull if
    InfoSet[].pipeOut
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // no error, delete the infoset
  InfoSet[].delete

  // find the __explain tabledef
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] StreamDef[].new

  // create an StreamSet operand
  streamSetTable[] StreamSet[].new

  Operand[] "parser" sqlCompiler::explain if

    // pipeout streamDef of explain
    StreamDef[].pipeout

    // pipeout explain
    StreamSet[].pipeout

    LogicUnit[].compilerToExit if
      Pipein[].delete
      Operand[].delete
      Operand[].newExitEarlyMarker
      Operand[].pipeout
      true
      exit
    then
  else
     // pipeout streamDef of explain
         StreamDef[].pipeout

     // pipeout explain
     StreamSet[].pipeout
  then

  ZK_DATAPULSE_handler
  Operand[].pipeOut
  Operand[].newEosMarker
  Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: parser_EosMarker \handler
 
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PLANOPERAND ...                                                */
/*----------------------------------------------------------------------------*/
: parser_PlanNode \handler
 
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: parser_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: parser_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: parser_CancelMarker ZK_CANCELMARKER op[].handler!
  find: parser_DataMarker   ZK_DATAPULSE    op[].handler!
  find: parser_EosMarker    ZK_EOSMARKER    op[].handler!
  find: parser_PlanNode     ZK_PLANOPERAND     op[].handler!
  find: parser_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: parser :: parser <sqlStatement> ;

: parser_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
    <streamDef>   = __explain
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
