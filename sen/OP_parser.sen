/*============================================================================*/
/* OP_parser.sen -- Parser Op (SQL Compiler)                                  */
/*============================================================================*/

" OP_parser.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: parser_Cleaning \handler

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: parser_DataPulse \handler

  Pipein[].pipeout

  // create the command error info set
  op__createCmdErrInfoSet

  <sqlStatement> sqlCompiler::parser to PlanOperand[]

  PlanOperand[].isNull if
    op__cmdErrOut
    true
    exit
  then

  // no error, delete the infoset
  InfoSet[].delete

  // does the sql have an explain ?
  PlanOperand[] "parser" sqlCompiler::hasExplain if

    // Get the tabledef for the explain format
    PlanOperand[] sqlCompiler::explainFormat to stringA[]

    // find the explain tabledef
    stringA[] op__tableDef_streamSet assert

    // create a new streamDef
    streamSetTable[] StreamDefLft[].new

    // create an StreamSet operand
    streamSetTable[] StreamSet[].new

    // execute explain for this operator
    PlanOperand[] "parser" sqlCompiler::doExplain

    // pipeout streamDef of explain
    StreamDefLft[].pipeout

    // pipeout explain
    StreamSet[].pipeout

    LogicUnit[].compilerToExit if
      PlanOperand[].delete
      Marker[].newLeaveMarker
      Marker[].pipeout
      true
      exit
    then

  then

  PlanOperand[].pipeOut
  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: parser_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: parser_Cleaning      ZK_M_CLEANING      op[].handler!
  find: parser_DataPulse     ZK_M_DATAPULSE     op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: parser :: parser <sqlStatement> ;

: parser_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
