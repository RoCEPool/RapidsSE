/*============================================================================*/
/* OP_indexScan.sen -- Operator index scan table                              */
/*============================================================================*/

" OP_range.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_CANCELMARKER ...                                                 END */
/*----------------------------------------------------------------------------*/
: indexScan_CancelMarker \handler

  0 ZK_CANCELMARKER EG_ZK LogicUnit[].diaryNote

  // cleanup the pot
  PotRlu[].cleanup

  Counter0[] cleanUpAsm

  ZK_CANCELMARKER EG_ZK PD_PIPE_OUT 0 ZK_CANCELMARKER EG_ZK LogicUnit[].diaryAction
  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: indexScan_ERRORMARKER \handler

  find: EATOPERAND_handler   ZK_CRWBUFFER   op[].handler!
  find: EATOPERAND_handler   ZK_ROWBUFFER   op[].handler!
  find: EATOPERAND_handler   ZK_EOSMARKER   op[].handler!

  PipeIn[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: indexScan_StartMarker \handler

  0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  <tableNm> <indexNm> op__table_index not if
    false
    exit
  then

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  //Index[].indexTree to indexTreeRlu[]
  //indexTreeRlu[].asSrc

  // set the indexTree in the devSrcIxt
  Index[].indexTree DevSrcIxt.indexTree!

  // new a stream def
  Table[] StreamDef[].new
  StreamDef[].duplicate to streamDefOut[]

  // evalute the expression
  ExprEval[].new

  <etc> StreamDef[] StreamDefOut[] ExprEval[].evaluate to eError

  // check for error
  eError EC_NONE == not if
    Pipein[].delete
    eError op__exprEvalExecErr
    true
    exit
  then

  // generate the asm for projection
  ExprEval[] LogicUnit[].genIndexScan to eError
  ExprEval[].delete

  // check for error
  eError EC_NONE == not if
    Pipein[].delete
    eError op__asmGenExecErr
    true
    exit
  then

  PipeIn[]\clear op::pipeout

  // set the streamDef in the devSrcRow
  StreamDef[]\clear DevSrcRow.streamDef!

  // create rowPix in potRlu[] from streamDefOut[]
  false streamDefOut[] PotRlu[].rowPix!

  // pipeout the streamDefOut
  streamDefOut[].pipeOut

  // create the compiler
  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: indexScan_EosMarker \handler

  0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_EOSMARKER Counter0[] executeAsmArgs

  // pipe out all PotRlu[]
  PotRlu[].pipeoutDanglingPtns
  PotRlu[].delete

  // create a new eos marker
  Operand[].newEosMarker
  Operand[] to Pipein[]

  // cleanup compiler
  Counter0[] cleanUpAsm

  ZK_EOSMARKER EG_ZK PD_PIPE_OUT 0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryAction
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                              DATAPULSE */
/*----------------------------------------------------------------------------*/
: indexScan_Datapulse \handler

  0 ZK_DATAPULSE EG_ZK LogicUnit[].diaryNote

  //Pipein[].isNull if
    // create a new eos marker
    //Operand[].newEosMarker
    //Operand[] to Pipein[]
  //then

  PipeIn[].pipeOut
  ZK_DATAPULSE Counter0[] executeAsmArgs

  LogicUnit[].callAgain@ not if

    // force op loop to call EOAsm_EosMarker to end
    "indexScan_EosMarker" word::find LogicUnit[].handler!
    true LogicUnit[].callAgain!

  then

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: indexScan_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: indexScan_CancelMarker ZK_CANCELMARKER  op[].handler!
  find: indexScan_DataPulse    ZK_DATAPULSE     op[].handler!
  find: indexScan_ErrorMarker  ZK_ERRORMARKER   op[].handler!
  find: indexScan_StartMarker  ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: indexScan :: indexScan <compiled> <tableNm> <indexNm> <etc> ;

: indexScan_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
