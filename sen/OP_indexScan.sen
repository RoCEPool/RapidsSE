/*============================================================================*/
/* OP_indexScan.sen -- Operator index scan table                              */
/*============================================================================*/

" OP_indexScan.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: indexScan_ComCleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // Need to hold on to the streamDef's till the combined op
  // has created the stencil

  // will be null if table not found
  StreamDefLft[].isNull not if
    StreamDefLft[].delete
  then

  StreamDefOut[].isNull not if
    StreamDefOut[].delete
  then

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: indexScan_ComStartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  PipeIn[]\clear [op].pipeout

  <tableNm> <indexNm> op__table_index not if
    true
    exit
  then

  // new a stream def
  Table[] StreamDefLft[].new
  StreamDefLft[].duplicate to streamDefOut[]

  StreamDefOut[].duplicate to Pipein[]
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: indexScan_op \operator

  _lu_initialise_

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  Counter0[] 2 == assert
  // handle combined operator
  find: indexScan_ComCleaning    ZK_M_CLEANING  [op].handler!
  find: indexScan_ComStartMarker ZK_M_START     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: indexScan :: indexScan <compiled> <tableNm> <indexNm> <expr> ;

: indexScan_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "indexScan_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
