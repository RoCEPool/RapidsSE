/*============================================================================*/
/* OP_rowCount.sen -- Operator rowCount                                       */
/*============================================================================*/

" OP_rowCount.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE...                                                       */
/*----------------------------------------------------------------------------*/
: rowCount_DataMarker \handler

  //"Operand:- EV_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // find the __count table
  C_TDEF_COUNT op__tableDef assert

  // create a Pds row buffer operand
  BT_COUNT TableDef[] Pds[].new

  // Get the table ptn
  Table[].tablePtn@ to TablePtn[]

  // grab the lock
  TablePtn[].grabRead_yieldLoop

  // add row count to Pds
  TablePtn[] TableDef[] Pds[].addRowCount assert

  TablePtn[].dropRead

  // pipeout the Pds
  Pds[].pipeOut

  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_START...                                                           */
/*----------------------------------------------------------------------------*/
: rowCount_StartMarker \handler

  //"Operand:- EV_M_START" .verbose
  PipeIn[].pipeOut

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : rowCount_op \operator
 
  _lu_initialise_

  op__topology

  find: rowCount_DataMarker EV_M_DATAPULSE [op].handler!
  find: rowCount_StartMarker EV_M_START [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rowCount :: rowCount <tableNm> ;

: rowCount_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "rowCount_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
