/*============================================================================*/
/* OP_rowCount.sen -- Operator rowCount                                       */
/*============================================================================*/

" OP_rowCount.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_INFOSET...                                                           */
/*----------------------------------------------------------------------------*/
: rowCount_DataMarker \handler

  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // find the __countInfo table
  C_TDEF_COUNTINFO op__tableDef_infoSet assert

  // create a new streamDef
  infoSetTable[] InfoSet[].new

  // create an infoSet operand
  Table[] infoSetTable[] InfoSet[].addRowCount assert

  // pipeout the infoset
  InfoSet[].pipeOut

  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START...                                                           */
/*----------------------------------------------------------------------------*/
: rowCount_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose
  PipeIn[].pipeOut

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : rowCount_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: rowCount_DataMarker ZK_M_DATAPULSE op[].handler!
  find: rowCount_StartMarker ZK_M_START op[].handler!

  op__loop

  LogReqExit
  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rowCount :: rowCount <tableNm> ;

: rowCount_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
