/*============================================================================*/
/* pp_open_system.sen -- open system procedure                                */
/*============================================================================*/

" pp_open_system.sen" .verbose
  
  STD_PATH_TAG
  "
  procedure open system
  begin

    stage stageA on origin :
    
        start
      | pulse once
      | stageB

    stage stageB on all nodes :
    
        sysOpen
      | stageC

    stage stageC on origin :
    
        sysOpened
      | output
      | sink
      | stageA

  end ;
  "
  procedure::add
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
