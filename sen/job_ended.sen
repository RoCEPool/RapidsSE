/*============================================================================*/
/* job_ended.sen -- ended 2pc job (pipeline coordination)                     */
/*============================================================================*/

" job_ended.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job_Ended back to originating node                                    */
/*----------------------------------------------------------------------------*/
: ended::replyToOrigin ( pJobParticipant -- )

  params| pJobParticipant |

  pJobParticipant job.id@ locals| iJobId |

  0 locals| pJob_Ended |

  //[grid].thisNodeName@ "(%v) ENDED::send" .printf

  // new a temporary Job_Ended
  pJobParticipant job_Ended::new to pJob_Ended

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send the ended job
  iJobId job::originator@ pJob_Ended job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_Ended job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job_Ended on originating node       recv: job.spawn */
/*----------------------------------------------------------------------------*/
: ended::ended

  Job[] locals| pJob_Ended |
  pJob_Ended job.id@ locals| iJobId |

  0 locals| bAmDecider |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the context of this __ended job

  // find the originating job
  iJobId ListedJob[].findOriginator discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // process __ended job on this originating node

  // increment the number of __ended jobs received in api state
  ListedJob[] ssn::incEnded
  ListedJob[] ssn::traceSession

  // decrement the acks remaining
  ListedJob[] job.dec2pcAcksRmg to bAmDecider

  //[grid].thisNodeName@ "(%v) ENDED GOT ACK" .printf
  // if there are acks remaining just exit
  bAmDecider not if
    ListedJob[].returnReference
    [job]:retire
    exit                                                         // *EARLY EXIT*
  then
  //[grid].thisNodeName@ "(%v) ENDED AM DECIDER" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // all __ended jobs have been received, so this job is the decider

  begin
    ListedJob[].references
  1 > while
  repeat

  [job].tscEnded


  // remove the originating job from the originator jobs
  //[job].removeOriginator

  // notify the originating task
  ListedJob[].task@ task.ack
  ListedJob[].returnReference
  
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: ended :: ended ;

: ended_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "ended::ended"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
