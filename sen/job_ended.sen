/*============================================================================*/
/* job_ended.sen -- ended 2pc job (pipeline coordination)                     */
/*============================================================================*/

" job_ended.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job_Ended back to originating node                                    */
/*----------------------------------------------------------------------------*/
: ended:reply params| pJobParticipant |

  // "ended:reply" .
  
  // new a temporary Job_Ended
  pJobParticipant job_Ended::new locals| pJob_Ended |

  // send the ended job
  pJobParticipant [job].originNodeNo@ pJob_Ended job.reply

  pJob_Ended job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job_Ended on originating node       recv: job.spawn */
/*----------------------------------------------------------------------------*/
: ended:ended

  // "ended:ended" .

  // find the originating job
  [job] job.id@ ListedJob[].findOriginator discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // increment the number of ended jobs received in api state
  ListedJob[] ssn::incEnded
  ListedJob[] ssn::traceSession

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  [with].2pcSimple? if
    ListedJob[].task@ task.ack
  else

    // decrement the acks remaining in the originating job
    ListedJob[].dec2pcDecider if

      // notify the originating task
      ListedJob[].task@ task.ack
      ListedJob[].returnReference

    then
  then
  
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: ended :: ended ;

: ended_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "ended:ended"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
