/*============================================================================*/
/* OP_metricsCtl.sen -- Metrics control                                       */
/*============================================================================*/

" OP_metricsCtl.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: metricsCtl_action

  <setting> "disable" str.same if
    AM::sysMetricsDisable
  else
  <setting> "enable" str.same if
    refTimer::reset
    locks::reset
    network::reset
    AM::sysMetricsEnable
  else
    EC_INVALID_COMMAND op__execErr
  then then

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: metricsCtl :: metricsCtl <setting> ;

: metricsCtl_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "metricsCtl_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
