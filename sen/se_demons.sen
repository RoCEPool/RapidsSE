/*============================================================================*/
/* se_demons.sen -- support words for demons                                  */
/*============================================================================*/

" se_demon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* install a demon pipeline job                                               */
/*----------------------------------------------------------------------------*/
: demon::install

  //ddlLock[].dropRead  : check with RAY

  "__" <pipelineNm> str.cat locals| sDemonNm |

  args.verbose if
    sDemonNm "installing demon pipeline job: %v" .printf
  then

  sDemonNm >createInRoot locals| pDemonWd |

  Job[] pDemonWd word.object!
  Job[].addDemon
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* event demon pipeline command                                               */
/*----------------------------------------------------------------------------*/
: eventDemonPipeline

  "
    pipelineLocal eventDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
        start | namedInsert | eatAll | stageA

    end ;
  "
;

/*----------------------------------------------------------------------------*/
/* exit demon pipeline command                                                */
/*----------------------------------------------------------------------------*/
: exitDemonPipeline

  "
    pipelineLocal exitDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
        start | jobExit | eatAll | stageA

    end ;
  "
;

/*----------------------------------------------------------------------------*/
/* metadata demon pipeline command                                            */
/*----------------------------------------------------------------------------*/
: metaDemonPipeline

  "
    pipelineLocal metaDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
        start | metaGet | stageB

      stage stageB on all nodes :
        metaSend | stageC

      stage stageC on origin :
        metaRecv | stageA

    end ;
  "
;

