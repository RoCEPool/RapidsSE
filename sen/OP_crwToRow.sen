/*============================================================================*/
/* OP_crwToRow.sen -- Convert crw buffers to row buffers                      */
/*============================================================================*/

" OP_crwToRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: crwToRow_StreamDef \handler

  // capture stream def
  PipeIn[] to StreamDef[]
  nullptr to PipeIn[]

  // pipeout copy of stream def
  StreamDef[].duplicate to OperandB[]
  OperandB[].pipeOut
    
  // ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖
  
  // create the crw to row register
  CrwToRow[].create

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: crwToRow_CrwBuffer \handler

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  crwToRow[].convert

  // test for any completed
  crwToRow[].completed to OperandB[]
  begin
    OperandB[].isNull not
  while
    OperandB[].pipeOut
      crwToRow[].completed to OperandB[]
  repeat

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: crwToRow_EosMarker \handler

  crwToRow[].completed to OperandB[]
  begin
    OperandB[].isNull not
  while
    OperandB[].pipeOut
    crwToRow[].completed to OperandB[]
  repeat

  // pipe out the eos marker
  PipeIn[].pipeOut

  // ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖
  
  // delete the crw to row register
  CrwToRow[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* crwToRow request                                                     SPAWN */
/*----------------------------------------------------------------------------*/
: crwToRow_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: crwToRow_StreamDef ZK_STREAMDEF  op[].handler!
  find: crwToRow_CrwBuffer ZK_CRWBUFFER  op[].handler!
  find: crwToRow_EosMarker ZK_EOSMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: crwToRow :: crwToRow ;

: crwToRow _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
