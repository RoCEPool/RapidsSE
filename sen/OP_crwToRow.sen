/*============================================================================*/
/* OP_crwToRow.sen -- Convert crw buffers to row buffers                      */
/*============================================================================*/

" OP_crwToRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: crwToRow_StreamDef \handler

  // capture stream def
  PipeIn[] to StreamDefLft[]
  nullptr to PipeIn[]

  // pipeout copy of stream def
  StreamDefLft[].duplicate to StreamDefOut[]
  StreamDefOut[].pipeOut
    
  // ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖
  
  // create the crw to row register
  CrwToRow[].create

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: crwToRow_CrwBuffer \handler

  PipeIn[]\clear to CrwBuffer[]

  crwToRow[].convert

  // ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖

  // test for any completed
  crwToRow[].completed to RowBuffer[]
  begin
    RowBuffer[].isNull not
  while
    RowBuffer[].pipeOut
      crwToRow[].completed to RowBuffer[]
  repeat

  CrwBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: crwToRow_EosMarker \handler

  crwToRow[].dangling to RowBuffer[]
  begin
    RowBuffer[].isNull not
  while
    RowBuffer[].pipeOut
    crwToRow[].dangling to RowBuffer[]
  repeat

  // pipe out the eos marker
  PipeIn[].pipeOut

  // ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖
  
  // delete the crw to row register
  CrwToRow[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* crwToRow request                                                     SPAWN */
/*----------------------------------------------------------------------------*/
: crwToRow_req \operator

  _op_begin_

  op__topology

  find: crwToRow_StreamDef ZK_D_STREAMDEF  op[].handler!
  find: crwToRow_CrwBuffer ZK_D_CRWBUFFER  op[].handler!
  find: crwToRow_EosMarker ZK_M_EOS  op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: crwToRow :: crwToRow ;

: crwToRow_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
