/*============================================================================*/
/* OP_emitStreamDef.sen -- Operator emit streamDef                            */
/*============================================================================*/

" OP_emitStreamDef.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: emitStreamDef_DataMarker \handler

  0 locals| rateSecs |

  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                             */
/*----------------------------------------------------------------------------*/
: emitStreamDef_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  <tableNm> op__table if

    // new a stream def
    Operand[].newStreamDef
    Operand[].pipeOut

    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* emitStreamDef reques                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
: emitStreamDef_req \operator

  LogReqEntry SEED_REQ

  op__topology

  //find: emitStreamDef_DataMarker  ZK_M_DATAPULSE  op[].handler!
  find: emitStreamDef_StartMarker  ZK_M_START  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: emitStreamDef :: emitStreamDef <tableNm> ;

: emitStreamDef_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
