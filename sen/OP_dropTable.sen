/*============================================================================*/
/* OP_dropTable.sen -- Operator drop table                                    */
/*============================================================================*/

" OP_dropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: dropTable_StartMarker

  //STD_NORMALFORK_WAIT_TAG "select * from uniqueTable;" NestedSql[]
  0 locals| errorCode |

  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove table
  <tableNm> op__table if
    // nothing to do
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DESTROY ...                                               */
/*----------------------------------------------------------------------------*/
: dropTable_DestroyMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  <tableNm> table::dropTable

  // delete the DESTROYMARKER
  PipeIn[].delete

  // pipeout an EOSMARKER
  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: dropTable_waitFinished_End \handler

  //"EV_M_END" .verbose

  true LogicUnit[].RcvdEnd!

  // if received all child exits then pipeout END
  //   else wait till all child exits have been received
  //LogicUnit[].RcvdChildExit@ if
     PipeIn[].pipeout
  //else
  //  PipeIn[].delete
  //then

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_X_CHILDEXIT ...                                       EV_X_CHILDEXIT */
/*----------------------------------------------------------------------------*/
: dropTable_ChildExit \handler

  0 EV_X_CHILDEXIT EG_ZK LogicUnit[].diaryNote

  true LogicUnit[].RcvdChildExit!

  nullptr [job].responseOp!

  LogicUnit[].RcvdEnd@ if
    Marker[].newEndMarker
    Marker[].pipeout
  then

  Pipein[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: dropTable_StreamDef \handler

  //"Operand:- EV_D_STREAMDEF" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: dropTable_RowBuffer \handler

  //"Operand:- EV_D_ROWBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PDSROWBUFFER ...                                          */
/*----------------------------------------------------------------------------*/
: dropTable_PdsRowBuffer \handler

  //"Operand:- EV_D_ROWBUFFER" .verbose
  //PipeIn[].pipeToOutput
  "Got PdsRowBuffer" .

  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dropTable req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropTable_op \operator

  _lu_initialise_

  op__topology

  find: dropTable_StartMarker   EV_M_START   [op].handler!
  find: dropTable_StreamDef     EV_D_STREAMDEF     [op].handler!
  find: dropTable_RowBuffer     EV_D_ROWBUFFER     [op].handler!
  find: dropTable_PdsRowBuffer     EV_D_PDSROWBUFFER     [op].handler!
  find: dropTable_ChildExit    EV_X_CHILDEXIT     [op].handler!
  find: dropTable_waitFinished_End       EV_M_END       [op].handler!
  find: dropTable_DestroyMarker EV_M_DESTROY [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropTable :: dropTable <tableNm> ;

: dropTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <forceLog>  = 1
    <opEntry> = "dropTable_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
