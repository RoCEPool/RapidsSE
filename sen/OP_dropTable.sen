/*============================================================================*/
/* OP_dropTable.sen -- Operator drop table                                    */
/*============================================================================*/

" OP_dropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: dropTable_StartMarker

  0 locals| errorCode |

  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove table
  <tableNm> check::validTableAssembly not if
    to errorCode
    errorCode op__execErr
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DESTROY ...                                               */
/*----------------------------------------------------------------------------*/
: dropTable_DestroyMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  <tableNm> table::dropTable

  // delete the DESTROYMARKER
  PipeIn[].delete

  // pipeout an EOSMARKER
  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dropTable req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropTable_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dropTable_StartMarker   ZK_M_START   op[].handler!
  find: dropTable_DestroyMarker ZK_M_DESTROY op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropTable :: dropTable <tableNm> ;

: dropTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <forceLog>  = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
