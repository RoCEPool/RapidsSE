/*============================================================================*/
/* OP_dropTable.sen -- Operator drop table                                    */
/*============================================================================*/

" OP_dropTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: dropTable_StartMarker

  0 locals| errorCode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove table
  <tableNm> check::validTableAssembly not if
    to errorCode
    errorCode op.pipelineJob@ ERROR_JOB
    errorCode op__execErr
    PipeIn[].delete
  else
    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DESTROYMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: dropTable_DestroyMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the table
  <tableNm> table::dropTable

  // delete the DESTROYMARKER
  PipeIn[].delete

  // pipeout an EOSMARKER
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dropTable req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropTable_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dropTable_StartMarker   ZK_STARTMARKER   op[].handler!
  find: dropTable_DestroyMarker ZK_DESTROYMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropTable :: dropTable <tableNm> ;

: dropTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <forceLog>  = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
