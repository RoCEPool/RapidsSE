/*============================================================================*/
/* OP_dupCrw.sen -- create temp copies of permanent crw buffers               */
/*============================================================================*/

" OP_dupCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                     CRWBUFFER */
/*----------------------------------------------------------------------------*/
: dupCrw_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  Operand[].crwDuplicate to operandB[]
  nullptr to Operand[]

  OperandB[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for dupCrw req                                               SPAWN */
/*----------------------------------------------------------------------------*/
 : dupCrw_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dupCrw_CrwBuffer  ZK_CRWBUFFER op[].handler!
 
  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dupCrw :: dupCrw ;

: dupCrw _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
