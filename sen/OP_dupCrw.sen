/*============================================================================*/
/* OP_dupCrw.sen -- create temp copies of permanent crw buffers               */
/*============================================================================*/

" OP_dupCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ...                                   CRWBUFFER */
/*----------------------------------------------------------------------------*/
: dupCrw_CrwBuffer \handler

  //"Operand:- ZK_D_CRWBUFFER" .verbose

  Pipein[]\clear crwBuffer.duplicate to crwBuffer[]

  crwBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for dupCrw req                                               SPAWN */
/*----------------------------------------------------------------------------*/
 : dupCrw_req \operator

  _op_begin_
  "dupCrw_req" .
  op__topology

  find: dupCrw_CrwBuffer  ZK_D_CRWBUFFER op[].handler!
 
  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dupCrw :: dupCrw ;

: dupCrw_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
