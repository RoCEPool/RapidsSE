/*============================================================================*/
/* OP_toStatDemon.sen -- To Stat demon Operator                               */
/*============================================================================*/

" OP_toStatDemon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_PDSROWBUFFER ...                                                   */
/*----------------------------------------------------------------------------*/
: OP_toStatDemon_PdsRowBuffer \handler

  //"OP_toStatD_LockStats +++ +++ +++" .

  PipeIn[].bufferType@ "OP_toStatD %v" str.format .

  // handle BT_LOCKSTATS only
  PipeIn[].bufferType@ BT_LOCKSTATS != if
    PipeIn[].pipeout
    true
    exit
  then

  PipeIn[] to Pds[]
  nullptr to PipeIn[]

  Pds[]
    "__statDemon" find dup if
      word.object@
      jobId::pipeToOp0 assert
      nullptr to Pds[]
    else
      discard discard
      Pds[].delete
    then

  true
;

/*----------------------------------------------------------------------------*/
/* toStatD request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toStatDemon_op \operator

  _lu_initialise_

  op__topology

  find: OP_toStatDemon_PdsRowBuffer EV_D_PDSROWBUFFER [op].handler!

  op__loop

  //"*** toStatDOp_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toStatDemon :: toStatDemon ;

: toStatDemon_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "toStatDemon_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
