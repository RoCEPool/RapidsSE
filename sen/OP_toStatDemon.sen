/*============================================================================*/
/* OP_toStatDemon.sen -- To Stat demon Operator                               */
/*============================================================================*/

" OP_toStatDemon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER ...                                                      */
/*----------------------------------------------------------------------------*/
: OP_toStatDemon_RowBuffer \handler

  //"OP_toStatD_LockStats +++ +++ +++" .

  PipeIn[].bufferType@ "OP_toStatD %v" str.format .

  // handle BT_LOCKSTATS only
  PipeIn[].bufferType@ BT_LOCKSTATS != if
    PipeIn[].pipeout
    true
    exit
  then

  PipeIn[] to RowBuffer[]
  nullptr to PipeIn[]

  //RowBuffer[].getBufferName .

  RowBuffer[]
    "__statDemon" find dup if
      word.object@
      jobId::pipeToOp0 assert
      nullptr to RowBuffer[]
    else
      discard discard
      RowBuffer[].delete
    then

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_PROFILE ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_toStatDemon_Profile \handler

  //"OP_toStatD_Profile +++ +++ +++" .

  PipeIn[]
  "__statDemon" find dup if
    word.object@
    jobId::pipeToOp0 assert
    nullptr to PipeIn[]
  else
    discard discard
    PipeIn[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* toStatD request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toStatDemon_op \operator

  _lu_initialise_

  op__topology

  find: OP_toStatDemon_RowBuffer EV_D_ROWBUFFER [op].handler!
  find: OP_toStatDemon_Profile   EV_D_PROFILE   [op].handler!

  op__loop

  //"*** toStatDOp_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toStatDemon :: toStatDemon ;

: toStatDemon_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "toStatDemon_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
