/*============================================================================*/
/* OP_toStatDemon.sen -- To Stat demon Operator                               */
/*============================================================================*/

" OP_toStatDemon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_I_LOCKSTATS ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_toStatDemon_LockStats \handler

  "OP_toStatD_LockStats +++ +++ +++" .

  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  InfoSet[].name .

  //InfoSet[].delete

  InfoSet[]
    "__statDemon" find dup if
      word.object@
      job(Id).pipeToOp0
      nullptr to InfoSet[]
    else
      discard discard
      InfoSet[].delete
    then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_PROFILE ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_toStatDemon_Profile \handler

  //"OP_toStatD_Profile +++ +++ +++" .

  PipeIn[]
  "__statDemon" find dup if
    word.object@
    job(Id).pipeToOp0
    nullptr to PipeIn[]
  else
    discard discard
    PipeIn[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* toStatD request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toStatDemon_op \operator

  _lu_initialise_

  op__topology

  find: OP_toStatDemon_LockStats ZK_I_LOCKSTATS [op].handler!
  find: OP_toStatDemon_Profile   ZK_D_PROFILE   [op].handler!

  op__loop

  //"*** toStatDOp_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toStatDemon :: toStatDemon ;

: toStatDemon_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "toStatDemon_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
