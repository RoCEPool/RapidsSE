/*============================================================================*/
/* OP_bucketRecv.sen -- Operator bucket recv                                      */
/*============================================================================*/

" OP_bucketRecv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: bucketRecv_Crw \handler
  " bucketRecv_Crw" .

  Operand[].pipein  // pop the pCrwBuffer and put in the Operand register

  // returns bucket ptr to
  Operand[]\clear BucketRecv.insertRows locals| pBucket |

  // insert $table
  //pBucket bucket.getRows locals| nRows |

  //nRows .

  true
;

/*----------------------------------------------------------------------------*/
/* execute for bucketRecv request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: bucketRecv_req \operator

  LogReqEntry SEED_REQ

  "bucketRecv_req" .

  op__topology

  // Setup ZK_XXXXXX handler here
  //find: bucketRecv_Crw ZK_CRWBUFFER op[].handler!
  find: bucketRecv_Crw ZK_BUCKETGET op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: bucketRecv :: bucketRecv ;

: bucketRecv_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/