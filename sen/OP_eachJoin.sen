/*============================================================================*/
/* OP_eachJoin.sen -- Operator each join                                      */
/*============================================================================*/

" OP_eachJoin.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: eachJoin_seapi

  "eachJoin_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: eachJoin_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // cleanup the pot
  PotRlu[].cleanup

  //Counter0[] cleanUpAsm

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler

;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: eachJoin_CrwBuffer \handler

  0 ZK_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  "eachJoin_CrwBuffer: got crw buffer" .

  Operand[].pipeIn
  Operand[] DevRhtIxt.crwBuffer!
  ZK_D_CRWBUFFER Counter0[] executeAsmArgs

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_EACHROWBUFFER ...                                               EACH */
/*----------------------------------------------------------------------------*/
: eachJoin_EachRowBuffer \handler

  0 ZK_D_EACHROWBUFFER EG_ZK LogicUnit[].diaryNote

  "eachJoin_EachRowBuffer: got eachRowBuffer" .

  Operand[].pipeIn
  Operand[] DevLftRow.eachRowBuffer!
  Operand[] DevLftRow.row!

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EACHSCANEOS ...                                            END */
/*----------------------------------------------------------------------------*/
: eachJoin_EachScanEosMarker \handler

  0 ZK_M_EACHSCANEOS EG_ZK LogicUnit[].diaryNote

  "eachJoin_EachScanEosMarker: got each scanEosMarker_lj;" .

  // pipeout all PotRlu[]
  PotRlu[].pipeoutCompletedPtns

  // delete the EachRowBuffer
  DevLftRow.deleteEachRowBuffer

  // cleanup compiler
  //Counter0[] cleanUpAsm

  ZK_M_EACHSCANEOS EG_ZK PD_PIPE_OUT 0 ZK_M_EACHSCANEOS EG_ZK LogicUnit[].diaryAction
  Pipein[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: eachJoin_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_M_EOS Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: eachJoin_RowBuffer \handler

  0 ZK_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  "eachJoin_RowBuffer: got rowbuffer;" .

  Operand[].pipeIn
  Operand[] DevRhtRow.rowBuffer!
  ZK_D_ROWBUFFER Counter0[] executeAsmArgs

  //Operand[].delete

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: eachJoin_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: eachJoin_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  "eachJoin_StreamDef: got each streamDef_lj;" .

  EC_NONE locals| eError |

  StreamDefLft[].isNull if

    // move pipein[] to StreamDefLft[]
    Pipein[]\clear to StreamDefLft[]

    true
    exit
  then

  // received right table stream def

  // move pipein[] to StreamDefRht[]
  Pipein[]\clear to StreamDefRht[]

  // evaluate the expression
  ExprEval[].new
  StreamDefOut[].new

  <etc> StreamDefLft[] StreamDefRht[] StreamDefOut[] ExprEval[].evaluateLoopJoin to eError

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // generate the asm for the filter
  ExprEval[] LogicUnit[].genLoopJoin to eError
  ExprEval[].delete

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // set the streamDef in the DevLftRow
  StreamDefLft[]\clear DevLftRow.streamDef!

  // set the streamDef in the devRightRow
  StreamDefRht[]\clear DevRhtRow.streamDef!

  // create rowPix in potRlu[] from streamDefOut[]
  false streamDefOut[] PotRlu[].rowPix!

  // pipeout the streamDefOut
  StreamDefOut[].pipeout

  // create the compiler
  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then

  // execute the streamDef asm handler
  ZK_D_STREAMDEF Counter0[] executeAsmArgs

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* eachJoin request                                                     SPAWN */
/*----------------------------------------------------------------------------*/
: eachJoin_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: eachJoin_Cleaning      ZK_M_CLEANING        op[].handler!
  find: eachJoin_CrwBuffer     ZK_D_CRWBUFFER       op[].handler!
  find: eachJoin_EachRowBuffer ZK_D_EACHROWBUFFER   op[].handler!
  find: eachJoin_EachScanEosMarker ZK_M_EACHSCANEOS op[].handler!
  find: eachJoin_EosMarker    ZK_M_EOS              op[].handler!
  find: eachJoin_RowBuffer    ZK_D_ROWBUFFER        op[].handler!
  find: eachJoin_StartMarker  ZK_M_START            op[].handler!
  find: eachJoin_StreamDef    ZK_D_STREAMDEF        op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eachJoin :: eachJoin <compiled> <etc> ;

: eachJoin_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
