/*============================================================================*/
/* OP__tpl_locallite.sen -- templates for local lite op                         */
/*============================================================================*/

" OP__tpl_locallite.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: OP__tpl_locallite_DataMarker

"
  : /localLiteOp/_DataMarker \\handler

    PipeIn[].pipeOut

    /localLiteOp/_action if
      Marker[].newEosMarker
      Marker[].pipeOut
    then

    true
  ;
"
;

/*----------------------------------------------------------------------------*/
/* execute for localLiteOp req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: OP__tpl_locallite_ENTRY

"
  : /localLiteOp/_op \\operator

    _lu_initialise_

    op__topology

    find: /localLiteOp/_DataMarker  EV_M_DATAPULSE [op].handler!

    op__loop

    _op_release_resources_
    op__retires
    
  HAZARD
  ;
"
;


/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 0 parameters                                   */
/*----------------------------------------------------------------------------*/
: OP__tpl_locallite_procedure0

"
  procedureLocal /localLiteOp/
    tags <lowMemory>
  begin

  stage stageA on origin :
    start | pulse once | /localLiteOp/ |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 1 parameter                                    */
/*----------------------------------------------------------------------------*/
: OP__tpl_locallite_procedure1

"
  procedureLocal /localLiteOp/
    tags <lowMemory>
    parameters $param
  begin

  stage stageA on origin :
    start | pulse once | /localLiteOp/ $param |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 2 parameters                                   */
/*----------------------------------------------------------------------------*/
: OP__tpl_locallite_procedure2

  "
    procedureLocal /localLiteOp/
      tags <lowMemory>
      parameters $param0 $param1
    begin

    stage stageA on origin :
      start | pulse once | /localLiteOp/ $param0 $param1 |
        output | sink | stageA

    end
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
