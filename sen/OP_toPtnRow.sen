/*============================================================================*/
/* OP_toPtnRow.sen -- Convert row buffers to partitioned row slab buffers     */
/*============================================================================*/

" OP_toPtnRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toPtnRow_StartMarker \handler

  ToPtnRow[].create

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: toPtnRow_DataMarker \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toPtnRow_RowBuffer \handler

  // check for low memory
  attachMap::isLowMemory if
    EC_LOW_MEMORY op__execErr
    PipeIn[].delete
    true
    exit
  then

  PipeIn[]\clear to RowBuffer[]
  RowBuffer[] ToPtnRow[].convert
  RowBuffer[].delete

  ptnmap::ptnsInGrid 0
  do

    I ToPtnRow[].completed to RowBuffer[]

    begin
      RowBuffer[].isNull not
    while
      RowBuffer[].pipeOut
      I ToPtnRow[].completed to RowBuffer[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: toPtnRow_EosMarker \handler

  ptnmap::ptnsInGrid 0
  do

    I ToPtnRow[].dangling to RowBuffer[]

    begin
      RowBuffer[].isNull not
    while
      RowBuffer[].pipeOut
      I ToPtnRow[].dangling to RowBuffer[]
    repeat

  loop

  ToPtnRow[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRow request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toPtnRow_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toPtnRow_EosMarker   ZK_M_EOS   op[].handler!
  find: toPtnRow_DataMarker  ZK_M_DATAPULSE   op[].handler!
  find: toPtnRow_RowBuffer   ZK_D_ROWBUFFER   op[].handler!
  find: toPtnRow_StartMarker ZK_M_START op[].handler!

  op__loop

  LogReqExit
  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toPtnRow :: toPtnRow ;

: toPtnRow_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
