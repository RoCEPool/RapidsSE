/*============================================================================*/
/* OP_toPtnRow.sen -- Convert row buffers to partitioned row slab buffers     */
/*============================================================================*/

" OP_toPtnRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toPtnRow_StartMarker \handler

  ToPtnRow[].create

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: toPtnRow_DataMarker \handler

  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toPtnRow_RowBuffer \handler

  // check for low memory
  attachMap::isLowMemory if
    EC_LOW_MEMORY
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  PipeIn[] ToPtnRow[].convert
  nullptr to Pipein[]

  grid::partitions 0
  do

    I ToPtnRow[].completed to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].pipeOut
      I ToPtnRow[].completed to OperandB[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toPtnRow_EosMarker \handler

  grid::partitions 0
  do

    I ToPtnRow[].dangling to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].pipeOut
      I ToPtnRow[].dangling to OperandB[]
    repeat

  loop

  ToPtnRow[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRsb request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toPtnRow_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toPtnRow_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toPtnRow_DataMarker ZK_DATAPULSE op[].handler!
  find: toPtnRow_RowBuffer   ZK_ROWBUFFER   op[].handler!
  find: toPtnRow_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toPtnRow :: toPtnRow ;

: toPtnRow _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
