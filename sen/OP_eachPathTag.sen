/*============================================================================*/
/* OP_eachPathTag.sen -- Operator Each Path Tag                               */
/*============================================================================*/

" OP_eachPathTag.sen" .verbose


/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: eachPathTag_DataPulse \handler
 
  //"eachPathTag_DataPulse" .

  EV_M_DATAPULSE_handler

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  <paths> locals| nPaths |
  
  //nPaths "eachPathTag: nPaths %v" .printf

  C_TDEF_COUNT TableDef:discover
  
  //nPaths 1 OI_COUNT InfoSet:pipeoutRow

  TableDef[] RowBuffer[].new
    BT_COUNT RowBuffer[].bufferType!

  nPaths 1 RowBuffer[].addRowVargs

  RowBuffer[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  0 0 0 locals| sPath iPathNo iPathOf |

  C_TDEF_PATH TableDef:discover

  nPaths 0
  do
    // form: iPathOf iPathNo sPath
    nPaths to iPathOf
    I to iPathNo
    "<path" I >str str.cat ">" str.cat
       [job].tagSet@ tagSet.getStr
       to sPath
       
    // iPathOf iPathNo sPath "eachPathTag: %v %v %v" .printf
    
    //iPathOf iPathNo sPath 3 OI_PATH InfoSet:pipeoutRow

      TableDef[] RowBuffer[].new
      BT_PATH RowBuffer[].bufferType!

      iPathOf iPathNo sPath 3 RowBuffer[].addRowVargs

      RowBuffer[].pipeOut
  loop
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : eachPathTag_op \operator

  _lu_initialise_

  op__topology

  find: eachPathTag_DataPulse EV_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eachPathTag :: eachPathTag ;

: eachPathTag_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "eachPathTag_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
