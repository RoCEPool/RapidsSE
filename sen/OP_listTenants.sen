/*============================================================================*/
/* OP_listTenants.sen -- Operator list tenants                                */
/*============================================================================*/

" OP_listTenants.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsten_action

  0 locals| errorCode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tenants folder
  Folder[].checkIsTenants not if
    to errorCode
    errorCode op__execErr
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the Pds for each word

  Folder[] dic.lastWord dup
  iterate                          // setup iteration of words
    object@ word.name@
    1 TableDef[] Pds[].addRowVargs  not if
      Pds[].pipeOut
      BT_DATA TableDef[] Pds[].new
      object@ word.name@
      1 TableDef[] Pds[].addRowVargs assert
    then

    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsten :: lsten ;

: lsten_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listContents
    <params>      = 0

    <opEntry> = "lsten_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
