/*============================================================================*/
/* OP_listTenants.sen -- Operator list tenants                                */
/*============================================================================*/

" OP_listTenants.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsten_action

  0 locals| errorCode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tenants folder
  Folder[].checkIsTenants not if
    to errorCode
    errorCode op__execErr
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  StreamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a rowBuffer operand
  StreamSetTable[] RowBuffer[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the rowBuffer for each word

  Folder[] dic.lastWord dup
  iterate                          // setup iteration of words
    object@ word.name@
    StreamSetTable[] RowBuffer[].addListContents  not if
      RowBuffer[].pipeOut
      StreamSetTable[] RowBuffer[].new
      object@ word.name@
      StreamSetTable[] RowBuffer[].addListContents assert
    then

    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the rowBuffer
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsten :: lsten ;

: lsten_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listContents
    <params>      = 0

    <opEntry> = "lsten_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
