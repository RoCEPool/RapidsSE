/*============================================================================*/
/* OP_gridGet.sen -- Operator meta get                                        */
/*============================================================================*/

" OP_gridGet.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_GRIDGet ...                                                 */
/*----------------------------------------------------------------------------*/
: gridGet_getObject  \handler

  // pipe out ZK_M_START
  PipeIn[].pipeOut
  ">>>>>>>>>>>>>>>>> gridGet_getObject" .
  //stk displays what in the stack

  // create an instance of class gridGet : public Operand
  // set the table name in gridGet instance
  // gridGet::getMetaData locals| pgridGet |


  grid::getGrid locals| pgridObj |
  // pipeout the gridGet instance
  pgridObj Op::pipeout

  true
  //stk
  //task::breakpoint set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for gridGet request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: gridGet_op \operator

  _lu_initialise_
  //"gridGet_req" .
  op__topology


  find: gridGet_getObject   ZK_M_DATAPULSE   op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: gridGet :: gridGet ;

: gridGet_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
