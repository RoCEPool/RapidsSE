/*============================================================================*/
/* pp_dload.sen -- distributed load pipeline procedures                       */
/*============================================================================*/

" pp_dload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* dload procedures                                                           */
/*----------------------------------------------------------------------------*/

: start::defProc_Dload

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dfload
  
  STD_PATH_TAG
  "
  procedure dfload
    parameters $table $file
  begin

  stage stageA on origin :

    start              |
 
    pulse once    |

    stageB

  stage stageB on all nodes :

    chunk $file        | // read chunks of file, produce (seekOffset) =>
    // dump seekOffsets 1 |

    rdCsvChunk $file   | // (seekOffset) => (csvBuffer)
    // dump csvBuffer 0   |

    stageC localRobin

  stage stageC on all partitions :

    toRow $table       | // (csvBuffer)  => (rowBuffer)
    // dump rowBuffer 1   |

    toPtnRow           | // (rowBuffer)  => (rowBuffer 'ptn)
    // dump rowBuffer 1   |

    toNstRow           | // (rowBuffer)  => (rowBuffer 'nst)
    //dump rowBuffer 1   |

    toHshCrw           | // (rowBuffer)  => (crwBuffer 'hsh)
    //dump rowBuffer 1   |

    stageD hashcast

  stage stageD on all partitions :

    //eatSome |

    insert $table | // (crwBuffer) inserted into table

    stageE

  stage stageE on origin :

    progress 'Load'    |

    toStatDemon        |

    sink               |

    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dload
  
  STD_PATH_TAG
  "
  procedure dload
    parameters $table
  begin

    stage stageA on origin :
        start
      | pulse once
      | eachPath 
      |   toDfload $table
      | callPipeline
      | waitPipeline
      | sink
      | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
