/*============================================================================*/
/* pp_dload.sen -- distributed load pipeline procedures                       */
/*============================================================================*/

" pp_dload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* dload procedures                                                           */
/*----------------------------------------------------------------------------*/

: start::defProc_Dload
 
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dfload
  
  STD_PATH_TAG
  "
  procedure dfload
    tags <persistentTx>
    parameters $table $file
  begin

    stage stageA on origin :
        start
      | pulse once
      | next

    stage stageB on all nodes :
        chunk      $file   // read chunks of file, produce (seekOffset) =>
      | rdCsvChunk $file   // (seekOffset) => (csvBuffer)
      | next localRobin

    stage stageC on all partitions :
        toKeyHshRow $table // (csvBuffer) => (rowBuffer w row+keyHash)
      | toLglPtnRow $table // (rowBuffer) => (rowBuffer x logical partitions)
      //| toLglPtnNst        // (rowBuffer) => (rowBuffer w normalised strings)
      | toLglPtnCrw        // (rowBuffer) => (crwBuffer x logical partitions)
      | next hashcast

    stage stageD on all partitions :
        insert $table      // (crwBuffer) inserted into table
      | next

    stage stageE on origin :
        progress 'Load'
      | toStatDemon
      | output
      | sink
      | stageA

  end ;
  "
  procedure::add

  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dload
  
  STD_PATH_TAG
  "
  procedure dload
    parameters $table
  begin

    stage stageA on origin :
        start
      | pulse once
      | checkTable $table
      | eachPathTag
      | pathToDfload $table
      | forkCommand waitFinished
      | waitFinished
      | output
      | sink
      | stageA

  end ;
  "
  procedure::add

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
