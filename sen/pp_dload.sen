/*============================================================================*/
/* pp_dload.sen -- distributed load pipeline procedures                       */
/*============================================================================*/

" pp_dload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* dload procedures                                                           */
/*----------------------------------------------------------------------------*/

: start::defProc_Dload

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dfload
  
  STD_PATH_TAG
  "
  procedure dfload
    parameters $table $file
  begin

  stage stageA on origin :

    start              |
 
    pulse once    |

    stageB

  stage stageB on all nodes :

    chunk $file        | // read chunks of file, produce (seekOffset) =>
    // dump seekOffsets 1 |

    rdCsvChunk $file   | // (seekOffset) => (csvBuffer)
    // dump csvBuffer 0   |

    stageC localRobin

  stage stageC on all partitions :

    toKeyHshRow $table    | // (csvBuffer)  => (rowBuffer)
    // dump rowBuffer 1   |

    toLglPtnRow $table    | // (rowBuffer)  => (rowBuffer 'ptn)
    // dump rowBuffer 1   |

    toLglPtnNst           | // (rowBuffer)  => (rowBuffer 'nst)
    //dump rowBuffer 1   |

    toHshCrw           | // (rowBuffer)  => (crwBuffer 'hsh)
    //dump rowBuffer 1   |

    stageD hashcast

  stage stageD on all partitions :

    //eatSome |

    insert $table | // (crwBuffer) inserted into table

    stageE

  stage stageE on origin :

    progress 'Load'    |

    toStatDemon        |

    sink               |

    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dload
  
  STD_PATH_TAG
  "
  procedure dload
    parameters $table
  begin

    stage stageA on origin :
        start
      | pulse once
      | eachPathTag
      |   toDfload $table
      | callPipeline
      | waitPipeline
      | sink
      | stageA

  end ;
  "
  api::addProcedure
 
 
  //----------------------------------------------------------------------------
 
 
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dfload2
  
  STD_PATH_TAG
  "
  procedure dfload2
    parameters $table $file
  begin

  stage stageA on origin :
      start
    | pulse once
    | stageB

  stage stageB on all nodes :
      chunk      $file   // read chunks of file, produce (seekOffset) =>
    | rdCsvChunk $file   // (seekOffset) => (csvBuffer)
    | stageC localRobin

  stage stageC on all partitions :
      toKeyHshRow $table // (csvBuffer) => (rowBuffer w row+keyHash)
    | toLglPtnRow $table // (rowBuffer) => (rowBuffer x logical partitions)
    | toLglPtnNst        // (rowBuffer) => (rowBuffer w normalised strings)
    | toLglPtnCrw        // (rowBuffer) => (crwBuffer x logical partitions)
    | stageC hashcast

  stage stageD on all partitions :
      insert $table      // (crwBuffer) inserted into table
    | stageE

  stage stageE on origin :
    |  progress 'Load'
    |  toStatDemon
    |  respond           // repond to responseOp as per fork
    |  sink
    |  stageA

  end ;
  "
  api::addProcedure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dload2
  
  STD_PATH_TAG
  "
  procedure dload2
    parameters $table
  begin

    stage stageA on origin :
        start
      | pulse once
      | eachPathTag
      | pathToDfload2 $table
      | fork wait
      | wait
      | sink
      | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
