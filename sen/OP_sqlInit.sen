/*============================================================================*/
/* OP_sqlInit.sen -- Initialise Sql Compiler  (SQL Compiler)                  */
/*============================================================================*/

" OP_sqlInit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CLEANUPMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: sqlInit_CleanupMarker \handler

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: sqlInit_DataMarker \handler
 
  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: sqlInit_EosMarker \handler
 
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: sqlInit_StartMarker \handler

  "sqlInit_StartMarker" .
  
  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sqlInit_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sqlInit_CleanupMarker ZK_CLEANUPMARKER op[].handler!
  find: sqlInit_DataMarker    ZK_DATAPULSE     op[].handler!
  find: sqlInit_EosMarker     ZK_EOSMARKER     op[].handler!
  find: sqlInit_StartMarker   ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sqlInit :: sqlInit ;

: sqlInit_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
