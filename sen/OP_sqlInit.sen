/*============================================================================*/
/* OP_sqlInit.sen -- Initialise Sql Compiler  (SQL Compiler)                  */
/*============================================================================*/

" OP_sqlInit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: sqlInit_Cleaning \handler

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: sqlInit_DataMarker \handler
 
  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: sqlInit_EosMarker \handler
 
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: sqlInit_StartMarker \handler

  "sqlInit_StartMarker" .
  
  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sqlInit_op \operator

  _lu_initialise_

  op__topology

  find: sqlInit_Cleaning      ZK_M_CLEANING      op[].handler!
  find: sqlInit_DataMarker    ZK_M_DATAPULSE     op[].handler!
  find: sqlInit_EosMarker     ZK_M_EOS           op[].handler!
  find: sqlInit_StartMarker   ZK_M_START         op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sqlInit :: sqlInit ;

: sqlInit_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
