/*============================================================================*/
/* se_infoSetRow.sen -- additional InfoSetRow related words                   */
/*============================================================================*/

" se_infoSetRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get first row of named rowBuffer                                           */
/*----------------------------------------------------------------------------*/
/*
: RowBufferRow:getFirstRow params| sTableNm |

  RowBuffer[].isNotNull assert
  InfoSetRow[].isNull assert

  // find the sTableNm table def ; set TableDef[]
  sTableNm op__tableDef assert

  // get the first (one and only) row from this infoset
  RowBuffer[].firstRow to InfoSetRow[]
;
*/

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
