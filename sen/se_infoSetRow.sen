/*============================================================================*/
/* se_infoSetRow.sen -- additional InfoSetRow related words                   */
/*============================================================================*/

" se_infoSetRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* get first row of named infoset                                             */
/*----------------------------------------------------------------------------*/
: infoSetRow:getFirstRow params| sInfoSetNm |

  InfoSet[].isNotNull assert
  InfoSetRow[].isNull assert

  // find the sInfoSetNm table def ; set infoSetTable[]
  sInfoSetNm op__tableDef_infoSet assert

  // get the first (one and only) row from this infoset
  InfoSet[].firstRow to InfoSetRow[]
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
