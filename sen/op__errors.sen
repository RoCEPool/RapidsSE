/*============================================================================*/
/* op__errors.sen -- operator error words                                     */
/*============================================================================*/

" op__errors.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create the compile error info set                                          */
/*----------------------------------------------------------------------------*/
: op__createCompileErrInfoSet

  [ddlLock].testDrop

  // delete if any rowBufferErr in the register
  RowBufferErr[].isNotNull if
    RowBufferErr[].delete
  then

  // create the tableDef for C_TDEF_COMPILEERRORS
  C_TDEF_COMPILEERRORS "op__tableDef_err" find execute assert

  // create an rowBuffer operand for compileErrors
  BT_COMPILEERRORS TableDefErr[] RowBufferErr[].new
;

/*----------------------------------------------------------------------------*/
/* pipeout compile error info set                                             */
/*----------------------------------------------------------------------------*/
: op__compileErrOut

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  RowBufferErr[].pipeOut
  ErrorMarker[].newErrorMarker
  ErrorMarker[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* create the command error info set and pipe it out                          */
/*----------------------------------------------------------------------------*/
: op__cmdErr params| errorCode errorMsg |

  [ddlLock].testDrop

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  // delete if any rowBufferErr in the register
  RowBufferErr[].isNotNull if
    RowBufferErr[].delete
  then

  // create the tableDef for C_TDEF_COMPILEERRORS
  C_TDEF_COMPILEERRORS "op__tableDef_err" find execute assert

  // create an rowBuffer operand for commandErrors
  BT_COMPILEERRORS TableDefErr[] RowBufferErr[].new

  errorMsg errorCode TableDefErr[] RowBufferErr[].addCommandError assert

  // pipeout the CMDERROR rowBuffer
  RowBufferErr[].pipeOut

  ErrorMarker[].newErrorMarker
  ErrorMarker[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* create the exec error info set                                             */
/*----------------------------------------------------------------------------*/
: op__execErr params| errorCode |

  [ddlLock].testDrop

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  // delete if any rowBufferErr in the register
  RowBufferErr[].isNotNull if
    RowBufferErr[].delete
  then

  // create the tableDef for C_TDEF_EXECERRORS
  C_TDEF_EXECERRORS "op__tableDef_err" find execute assert

  // create an infoSet operand for commandErrors
  BT_EXECERRORS TableDefErr[] RowBufferErr[].new

  errorCode attachmap::errorText@
    errorCode TableDefErr[] RowBufferErr[].addExecError assert

  // pipeout the EXECERROR infoset
  RowBufferErr[].pipeOut

  ErrorMarker[].newErrorMarker
  ErrorMarker[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* create the exec error info set                                             */
/*----------------------------------------------------------------------------*/
: op__execErrMsg params| errorCode errorMsg |

  [ddlLock].testDrop

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  // delete if any rowBufferErr in the register
  RowBufferErr[].isNotNull if
    RowBufferErr[].delete
  then

  // create the tableDef for C_TDEF_EXECERRORS
  C_TDEF_EXECERRORS "op__tableDef_err" find execute assert

  // create an rowBuffer operand for commandErrors
  BT_EXECERRORS TableDefErr[] RowBufferErr[].new

  errorMsg errorCode TableDefErr[] RowBufferErr[].addExecError assert

  // pipeout the EXECERROR rowBuffer
  RowBufferErr[].pipeOut

  ErrorMarker[].newErrorMarker
  ErrorMarker[].pipeOut
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

