/*============================================================================*/
/* op__errors.sen -- operator error words                                     */
/*============================================================================*/

" op__errors.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create the compile error Pds                                               */
/*----------------------------------------------------------------------------*/
: op__createCompileErrPdsRowBuffer

  [ddlLock].testDrop

  // delete if any PdsErr in the register
  PdsErr[].isNotNull if
    PdsErr[].delete
  then

  // create the tableDef for C_TDEF_COMPILEERRORS
  C_TDEF_COMPILEERRORS "op__tableDef_err" find execute assert

  // create a PdsErr operand for compileErrors
  BT_COMPILEERRORS TableDefErr[] PdsErr[].new
;

/*----------------------------------------------------------------------------*/
/* pipeout compile error info set                                             */
/*----------------------------------------------------------------------------*/
: op__compileErrOut

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  PdsErr[].pipeOut
  ErrorMarker[].newErrorMarker
  ErrorMarker[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* create the exec error info set                                             */
/*----------------------------------------------------------------------------*/
: op__execErr params| errorCode |

  [ddlLock].testDrop

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  // delete if any PdsErr in the register
  PdsErr[].isNotNull if
    PdsErr[].delete
  then

  // create the tableDef for C_TDEF_EXECERRORS
  C_TDEF_EXECERRORS "op__tableDef_err" find execute assert

  // create a PdsErr operand for commandErrors
  BT_EXECERRORS TableDefErr[] PdsErr[].new

  errorCode attachmap::errorText@
    errorCode PdsErr[].addExecError assert

  // pipeout the EXECERROR PdsErr
  PdsErr[].pipeOut

  ErrorMarker[].newErrorMarker
  ErrorMarker[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* create the exec error info set                                             */
/*----------------------------------------------------------------------------*/
: op__execErrMsg params| errorCode errorMsg |

  [ddlLock].testDrop

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  // delete if any PdsErr in the register
  PdsErr[].isNotNull if
    PdsErr[].delete
  then

  // create the tableDef for C_TDEF_EXECERRORS
  C_TDEF_EXECERRORS "op__tableDef_err" find execute assert

  // create an Pds operand for commandErrors
  BT_EXECERRORS TableDefErr[] PdsErr[].new

  errorMsg errorCode PdsErr[].addExecError assert

  // pipeout the EXECERROR Pds
  PdsErr[].pipeOut

  ErrorMarker[].newErrorMarker
  ErrorMarker[].pipeOut
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

