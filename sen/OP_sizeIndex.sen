/*============================================================================*/
/* OP_sizeIndex.sen -- Operator size index                                    */
/*============================================================================*/

" OP_sizeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: szidx_action

  <tableNm> <indexNm> op__table_index not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  0 locals| iIndexSize |
  Index[].size to iIndexSize

  0 iIndexSize number.magnitude >str iIndexSize

  // insert index size
  Pds[].addSizeIndex assert

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: szidx :: szidx <tableNm> <indexNm> ;

: szidx_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __sizeIndex
    <params>    = 2
    <opEntry> = "szidx_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
