/*============================================================================*/
/* pp_close_system.sen -- close system procedure                              */
/*============================================================================*/

" pp_close_system.sen" .verbose
  
  STD_PATH
  "
  procedure close system
  begin

    stage stageA on origin :
    
        start
      | periodic once
      | stageB

    stage stageB on all nodes :
    
      stageC

    stage stageC on origin :
    
        output
      | sink
      | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
