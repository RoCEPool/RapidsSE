/*============================================================================*/
/* pp_close_system.sen -- close system procedure                              */
/*============================================================================*/

" pp_close_system.sen" .verbose
  
  STD_PATH_TAG
  "
  procedure close system
  
    tag <include_0> = \"std_start\" endTag
    tag <include_1> = \"std_output\" endTag

  begin

//    stage stageA on origin :
//
//        start
//      | pulse once
//      | stageB

    stage unnamed on all nodes :
    
        sysClose
      | next

//    stage stageC on origin :
//
//        sysClosed
//      | output
//      | sink
//      | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
