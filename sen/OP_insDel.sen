/*============================================================================*/
/* OP_insDel.sen -- Insert/operator delete                                    */
/*============================================================================*/

" OP_insDel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: insDel_CrwBuffer \handler

  PipeIn[]\clear to CrwBuffer[]

  TablePtn[].grabWrite_yieldLoop
  CrwBuffer[].insdelIntoTable
  TablePtn[].dropWrite

  CrwBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: insDel_RowBuffer \handler

  PipeIn[]\clear to RowBuffer[]

  "insDel_RowBuffer" .

  TablePtn[].grabWrite_yieldLoop
  RowBuffer[].insdelIntoTable
  TablePtn[].dropWrite

  RowBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: insDel_StartMarker \handler

  PipeIn[].pipeOut

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: insDel_StreamDef \handler

  PipeIn[].delete
  Table[] streamDefOut[].newFromTable
  streamDefOut[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for insDel                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : insDel_op \operator
 
  _lu_initialise_

  op__topology

  find: insDel_CrwBuffer   EV_D_CRWBUFFER   [op].handler!
  find: insDel_RowBuffer   EV_D_ROWBUFFER   [op].handler!
  find: insDel_StartMarker EV_M_START [op].handler!
  find: insDel_StreamDef   EV_D_STREAMDEF   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: insDel :: insDel <tableNm> ;

: insDel_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "insDel_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
