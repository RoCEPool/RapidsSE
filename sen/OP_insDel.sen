/*============================================================================*/
/* OP_insDel.sen -- Insert/operator delete                                    */
/*============================================================================*/

" OP_insDel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: insDel_CrwBuffer \handler

  PipeIn[]\clear to CrwBuffer[]

  TablePtn[].grabWrite_yieldLoop
  CrwBuffer[].insdelIntoTable
  TablePtn[].dropWrite

  CrwBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: insDel_RowBuffer \handler

  PipeIn[]\clear to RowBuffer[]

  "insDel_RowBuffer" .

  TablePtn[].grabWrite_yieldLoop
  RowBuffer[].insdelIntoTable
  TablePtn[].dropWrite

  RowBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: insDel_StartMarker \handler

  PipeIn[].pipeOut

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: insDel_StreamDef \handler

  PipeIn[].delete
  Table[] streamDefOut[].newFromTable
  streamDefOut[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for insDel                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : insDel_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: insDel_CrwBuffer   ZK_D_CRWBUFFER   op[].handler!
  find: insDel_RowBuffer   ZK_D_ROWBUFFER   op[].handler!
  find: insDel_StartMarker ZK_M_START op[].handler!
  find: insDel_StreamDef   ZK_D_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: insDel :: insDel <tableNm> ;

: insDel_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
