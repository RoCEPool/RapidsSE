/*============================================================================*/
/* OP_insDel.sen -- Insert/Delete operator                                    */
/*============================================================================*/

" OP_insDel.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: insDel_CrwBuffer \handler

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  tablePtn[] tablePtnGrabWrite
  Operand[].insdelIntoTable
  tablePtn[] tablePtnDropWrite

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ROWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: insDel_RowBuffer \handler

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  "insDel_RowBuffer" .

  tablePtn[] tablePtnGrabWrite
  Operand[].insdelIntoTable
  tablePtn[] tablePtnDropWrite

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: insDel_StartMarker \handler

  <tableNm> op__table if
    Table[].tablePtn@ to tablePtn[]
    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: insDel_StreamDef \handler

  PipeIn[].delete
  Operand[].newStreamDef
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for insDel                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : insDel_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: insDel_CrwBuffer   ZK_CRWBUFFER   op[].handler!
  find: insDel_RowBuffer   ZK_ROWBUFFER   op[].handler!
  find: insDel_StartMarker ZK_STARTMARKER op[].handler!
  find: insDel_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: insDel :: insDel <tableNm> ;

: insDel _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
