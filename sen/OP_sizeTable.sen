/*============================================================================*/
/* OP_sizeTable.sen -- Operator size table                                    */
/*============================================================================*/

" OP_sizeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: sztbl_action

  <tableNm> op__table not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  0 locals| iTableSize |
  Table[].size to iTableSize

  0 iTableSize number.magnitude >str iTableSize

  // insert index size
  TableDef[] Pds[].addSizeTable assert

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sztbl :: sztbl <tableNm> ;

: sztbl_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __sizeTable
    <params>    = 1
    <opEntry> = "sztbl_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
