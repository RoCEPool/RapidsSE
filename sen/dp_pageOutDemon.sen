/*============================================================================*/
/* dp_pageOutDemon.sen -- Page Out Demon                                      */
/*============================================================================*/

" dp_pageOutDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* page out demon                                                             */
/*----------------------------------------------------------------------------*/
: pageOutDemonPipeline

  "
    pipelineLocal pageOutDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | pageout
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
