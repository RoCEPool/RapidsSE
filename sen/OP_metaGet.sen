/*============================================================================*/
/* OP_metaGet.sen -- Operator meta get                                        */
/*============================================================================*/

" OP_metaGet.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_METAGET ...                                                 */
/*----------------------------------------------------------------------------*/
: metaGet_getTable  \handler

  "metaGet_getTable" .
  
  // create an instance of class MetaGet : public Operand
  // set the table name in MetaGet instance
  <tableNm> metaGet::getMetaData locals| pMetaGet |
  //"created pMetaGet".

  // pipeout the MetaGet instance
  pMetaGet Op::pipeout
  //"pipeout pMetaGet".

  // we return true here, but somewhere failed assert on false
  true
;

/*----------------------------------------------------------------------------*/
/* execute for metaGet request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaGet_req \operator

  LogReqEntry SEED_REQ
  "metaGet_req" .
  op__topology

  find: metaGet_getTable   ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaGet :: metaGet <tableNm> ;

: metaGet_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
