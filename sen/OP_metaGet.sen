/*============================================================================*/
/* OP_metaGet.sen -- Operator meta get                                        */
/*============================================================================*/

" OP_metaGet.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: metaGet_DataPulse \handler

  //"metaGet_DataPulse" .

  // pipe out ZK_M_START
  PipeIn[].pipeOut
  //stk displays what in the stack

  // create an instance of class MetaGet : public Operand
  // set the table name in MetaGet instance
  <tableNm> MetaGet[].getMetaData to MetaGet[]

  // pipeout the MetaGet instance
  //"before meta po" .
  MetaGet[].pipeout
  //"after meta po" .

  true
  //stk
  //task::breakpoint set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for metaGet request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaGet_op \operator

  _lu_initialise_
  "metaGet_req" .
  op__topology

  find: metaGet_DataPulse   ZK_M_DATAPULSE   op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaGet :: metaGet <tableNm> ;

: metaGet_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "metaGet_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
