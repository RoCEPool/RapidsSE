/*============================================================================*/
/* OP_metaGet.sen -- Operator meta get                                        */
/*============================================================================*/

" OP_metaGet.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_METAGET ...                                               */
/*----------------------------------------------------------------------------*/
: metaGet_getTable  \handler

  // pipe out ZK_M_START
  PipeIn[].pipeOut
  "metaGet_getTable" .
  //stk displays what in the stack

  // create an instance of class MetaGet : public Operand
  // set the table name in MetaGet instance
  <tableNm> metaGet::getMetaData to Meta[]

  // pipeout the MetaGet instance
  Meta[].pipeout

  true
  //stk
  //task::breakpoint set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for metaGet request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaGet_req \operator

  LogReqEntry SEED_REQ
  "metaGet_req" .
  op__topology

  //find: metaGet_getTable   ZK_M_START   op[].handler!
  find: metaGet_getTable   ZK_M_DATAPULSE   op[].handler!

  op__loop

  LogReqExit
  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaGet :: metaGet <tableNm> ;

: metaGet_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
