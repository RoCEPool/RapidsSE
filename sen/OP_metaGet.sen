/*============================================================================*/
/* OP_metaGet.sen -- Operator meta get                                        */
/*============================================================================*/

" OP_metaGet.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: metaGet_DataPulse \handler

  //"metaGet_DataPulse" .

  PipeIn[].pipeOut

  <tableNm> MetaGet::new to MetaGet[]

  MetaGet[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for metaGet request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaGet_op \operator

  _lu_initialise_

  op__topology

  find: metaGet_DataPulse   EV_M_DATAPULSE   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaGet :: metaGet <tableNm> ;

: metaGet_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "metaGet_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
