/*============================================================================*/
/* OP_waitPipeline.sen -- Operator Wait on Pipeline                           */
/*============================================================================*/

" OP_waitPL.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: waitPipeline_Start \handler

  0  to Counter0[]
  -1 to Counter1[]

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: waitPipeline_DataPulse \handler

  PipeIn[].delete
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: waitPipeline_End \handler

  PipeIn[].delete
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: waitPipeline_ReturnPipeline \handler

  "waitPipeline_ReturnPipeline" .

  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  Counter0[] 1 + to Counter0[]

  // find the __returnPipeline table def
  C_TDEF_RETURNPIPELINE "op__tableDef_infoSet" find execute assert

  InfoSet[].firstRow to infoSetRow[]

  1 InfoSet[].colVal@ -1 != if
    1 InfoSet[].colVal@ to counter1[]
  then
  

  2 InfoSet[].colVal@ 1 InfoSet[].colVal@ 0 InfoSet[].colVal@
    Counter1[] Counter0[]
    "Got ReturnPipeline %v of %v : [%v.%v] error %v" str.format .
  InfoSet[].delete

  nullptr to InfoSetTable[]


  Counter0[] Counter1[] == if

    "All ReturnPipeline's gathered" .

    Marker[].newEosMarker
    Marker[].pipeOut

    Marker[].newDataPulse
    Marker[].pipeOut

    Marker[].newEndMarker
    Marker[].pipeOut

  then


  true
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : waitPipeline_req \operator

  SEED_REQ

  op__topology

  find: waitPipeline_DataPulse      ZK_M_DATAPULSE      op[].handler!
  find: waitPipeline_End            ZK_M_END            op[].handler!
  find: waitPipeline_ReturnPipeline ZK_I_RETURNPIPELINE op[].handler!
  find: waitPipeline_Start          ZK_M_START          op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: waitPipeline :: waitPipeline ;

: waitPipeline_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
