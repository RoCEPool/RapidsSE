/*============================================================================*/
/* OP_unload.sen -- unload                                                    */
/*============================================================================*/

" OP_unload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: unload_DataPulse \handler

  <dirName> locals| sDirName |

  sDirName unload.toDisk not if
    op__execErrMsg
    pipein[].delete
    true
    exit
  then

  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ... a RowBuffer with __path rows                */
/*----------------------------------------------------------------------------*/
: unload_Path \handler

  // handle BT_PATH only
  PipeIn[].bufferType@ BT_PATH != if
    PipeIn[].pipeout
    true
    exit
  then

  PipeIn[]\clear to RowBuffer[]

  //C_TDEF_PATH infoSetRow:getFirstRow

  C_TDEF_PATH op__tableDef assert
  RowBuffer[].firstRow to Row[]

  // extract the values
  //0 InfoSet[].colVal@ locals| sPath   |
  //1 InfoSet[].colVal@ locals| iPathNo |
  //2 InfoSet[].colVal@ locals| iPathOf |

  0 Row[].getVchColumn locals| sPath   |
  1 Row[].getVchColumn locals| iPathNo |
  2 Row[].getIntColumn locals| iPathOf |

  // unload to disk
  iPathOf iPathNo sPath unload.toDisk

  RowBuffer[].delete
  nullptr to Row[]

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* unload request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: unload_op \operator

  _lu_initialise_

  op__topology

  find: unload_DataPulse  EV_M_DATAPULSE  [op].handler!
  //find: unload_Path  EV_I_PATH  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: unload :: unload <dirName> ;

: unload_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "unload_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
