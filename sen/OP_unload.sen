/*============================================================================*/
/* OP_unload.sen -- unload                                                    */
/*============================================================================*/

" OP_unload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: unload_StartMarker \handler

  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: unload_DataPulse \handler

  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_CSVBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: unload_CsvBuffer \handler

  EV_D_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: unload_EosMarker \handler

  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* unload request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: unload_op \operator

  _lu_initialise_

  op__topology

  find: unload_CsvBuffer   EV_D_CSVBUFFER [op].handler!
  find: unload_EosMarker   EV_M_EOS       [op].handler!
  find: unload_DataPulse   EV_M_DATAPULSE [op].handler!
  find: unload_StartMarker EV_M_START     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: unload :: unload ;

: unload_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "unload_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
