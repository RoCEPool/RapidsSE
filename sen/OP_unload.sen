/*============================================================================*/
/* OP_unload.sen -- unload                                                    */
/*============================================================================*/

" OP_unload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: unload_DataPulse \handler

  <dirName> locals| sDirName |

  sDirName unload.toDisk not if
    op__execErrMsg
    pipein[].delete
    true
    exit
  then

  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_I_PATH ... an infoset with __path rows                      */
/*----------------------------------------------------------------------------*/
: unload_Path \handler

  PipeIn[]\clear to InfoSet[]

  C_TDEF_PATH infoSetRow:getFirstRow

  // extract the values
  0 InfoSet[].colVal@ locals| sPath   |
  1 InfoSet[].colVal@ locals| iPathNo |
  2 InfoSet[].colVal@ locals| iPathOf |

  // unload to disk
  iPathOf iPathNo sPath unload.toDisk

  InfoSet[].delete
  nullptr to InfoSetRow[]

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* unload request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: unload_op \operator

  _lu_initialise_

  op__topology

  find: unload_DataPulse  EV_M_DATAPULSE  [op].handler!
  //find: unload_Path  EV_I_PATH  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: unload :: unload <dirName> ;

: unload_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "unload_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
