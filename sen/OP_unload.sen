/*============================================================================*/
/* OP_unload.sen -- unload                                                    */
/*============================================================================*/

" OP_unload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: unload_StartMarker \handler

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: unload_DataPulse \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CSVBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: unload_CsvBuffer \handler

  ZK_D_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: unload_EosMarker \handler

  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* unload request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: unload_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: unload_CsvBuffer   ZK_D_CSVBUFFER op[].handler!
  find: unload_EosMarker   ZK_M_EOS       op[].handler!
  find: unload_DataPulse   ZK_M_DATAPULSE op[].handler!
  find: unload_StartMarker ZK_M_START     op[].handler!

  op__loop

  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: unload :: unload ;

: unload_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
