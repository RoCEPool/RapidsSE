/*============================================================================*/
/* OP_unload.sen -- unload                                                    */
/*============================================================================*/

" OP_unload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: unload_DataPulse \handler

  <dirName> locals| sDirName |

  sDirName unload.toDisk not if
    op__execErrMsg
    pipein[].delete
    true
    exit
  then

  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PDSROWBUFFER ... a Pds with __path rows                   */
/*----------------------------------------------------------------------------*/
: unload_Path \handler

  // get the rowBuffer
  PipeIn[]\clear to RowBuffer[]

  // pipeout buffers other than BT_PATH
  Pds[].bufferType@ BT_PATH != if
    Pds[].pipeout
    true
    exit
  then

  // get first row of Pds[]
  Pds[].firstRow to Row[]

  // get the columns from the row
  0 Row[].getVchColumn locals| sPath   |
  1 Row[].getVchColumn locals| iPathNo |
  2 Row[].getIntColumn locals| iPathOf |

  // unload to disk
  iPathOf iPathNo sPath unload.toDisk

  Pds[].delete
  nullptr to Row[]

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* unload request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: unload_op \operator

  _lu_initialise_

  op__topology

  find: unload_DataPulse  EV_M_DATAPULSE  [op].handler!
  //find: unload_Path  EV_I_PATH  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: unload :: unload <dirName> ;

: unload_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "unload_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
