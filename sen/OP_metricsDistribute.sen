/*============================================================================*/
/* OP_metricsDistribute.sen -- distribute metrics                             */
/*============================================================================*/

" OP_metricsDistribute.sen" .verbose


/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: metricsDistribute_Start

  "metricsDistribute_Start" .

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* execute for metricsDistribute_op                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metricsDistribute_op \operator

  _lu_initialise_

  op__topology

  find: metricsDistribute_Start  ZK_M_START  op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: metricsDistribute :: metricsDistribute ;

: metricsDistribute_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "metricsDistribute_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
