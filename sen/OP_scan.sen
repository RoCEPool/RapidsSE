/*============================================================================*/
/* OP_scan.sen -- Operator scan                                               */
/*============================================================================*/

" OP_scan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELLINGMARKER ...                                        */
/*----------------------------------------------------------------------------*/
: Scan_CancellingMarker \handler

  Pipein[]\clear to Operand[]

  "Scan_CancellingMarker DRAINING PIPEIN" .
  PipeIn[].drain

  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: Scan_Cleaning \handler

  // drop the tablePtn lock if held
  counter0[] true == if
    TablePtn[].dropRead
    false to counter0[]
  then

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
// ": scan_DataPulse" .

: scan_DataPulse \handler

  debug::flag@ if "(Revised) scan_DataMarker handler" . then

  // pipe out the pulse marker
  PipeIn[].pipeOut

  // pipe out a new a stream def
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[].pipeOut

  // grab table ptn read lock
  TablePtn[].grabRead_yieldLoop

  // set counter0 to true to indicate lock held
  true to counter0[]

  // new a partition stream for access crw buffer
  TablePtn[] ptnStream::new to ptnStream[]

  // open partition stream to access the crw buffers
  ptnStream[] ptnStream.open if

    // pipe in ZK_M_NEXTBUFFER
    Marker[].newNextBufferMarker
    Marker[].pipeBackIn

    //"scan_RowCrwBuffer_next" word::find LogicUnit[].handler!
    //true LogicUnit[].callAgain!

  else
    // unable to open partition stream (this would be unusual)

    // delete partition stream
    ptnStream[] ptnStream.delete
    nullptr to ptnStream[]

    // drop table ptn lock
    TablePtn[].dropRead

    // set counter0 to 0 to indicate lock released
    false to counter0[]

    // send an eos marker (there was no data)
    Marker[].newEosMarker
    Marker[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_NEXTBUFFER...                                             */
/*----------------------------------------------------------------------------*/
// ": scan_NextBuffer" .

: scan_NextBuffer \handler

  debug::flag@ if "(Revised) scan_NextBuffer handler" . then

  // read next buffer from ptn stream
  ptnStream[] ptnStream.read to Operand[]
 
  Operand[].isNotNull if
    // read a next crw buffer

    // pipe out the read crw buffer
    Operand[].pipeOut

    // requeue ZK_M_NEXTBUFFER
    Pipein[].pipeBackin

    // call this handler again to process next buffer
    //true LogicUnit[].callAgain!
 
  else
    // no more crw buffers
    Pipein[].delete

    // close and delete partition stream
    ptnStream[] ptnStream.close
    ptnStream[] ptnStream.delete
    nullptr to ptnStream[]
 
    // drop partition lock
    TablePtn[].dropRead

    // set counter0 to false to indicate lock released
    false to counter0[]

    // pipe out an eos marker
    Marker[].newEosMarker
    Marker[].pipeOut

  then
 
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 
  // check for rate metering
 
  0 locals| rateSecs |

  // "<rateSecs>" job::tagSet@ tagSet.hasName if
  "<rateSecs>" op[].tagSet@ tagSet.hasName if
    <rateSecs> >int to rateSecs
  then

  rateSecs if
    rateSecs "Scan Pausing for %v secs" str.format .
    rateSecs task::sleepSsec
    "Scan awake" .
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
// ": scan_StartMarker" .

: scan_StartMarker \handler

  PipeIn[].pipeOut
  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  //args.developer if
  //  1 debug::flag!
  //then

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scan_req \operator

  LogReqEntry SEED_REQ

  "<catalogNm>"  job::tagSet@ tagSet.hasName if
    <schemaNm> <catalogNm>
    "/tenants/boray/catalogs/%v/schemas/%v/tables" str.format
    str.toStrVec Path[].set
  then

  op__topology

  find: scan_CancellingMarker  ZK_M_CANCELLING op[].handler!
  find: scan_Cleaning          ZK_M_CLEANING   op[].handler!
  find: scan_DataPulse         ZK_M_DATAPULSE  op[].handler!
  find: scan_NextBuffer        ZK_M_NEXTBUFFER op[].handler!
  find: scan_StartMarker       ZK_M_START      op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: scan :: scan <tableNm> ;
cmdSyntax: scan :: scan <catalogNm> <schemaNm> <tableNm> ;
cmdSyntax: scan :: scan <tableNm> <rateSecs> ;
cmdSyntax: scan :: scan <catalogNm> <schemaNm> <tableNm> <rateSecs> ;

: scan_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
