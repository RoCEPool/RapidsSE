/*============================================================================*/
/* OP_scan.sen -- Operator scan                                               */
/*============================================================================*/

" OP_scan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELLINGMARKER ...                                        */
/*----------------------------------------------------------------------------*/
: Scan_CancellingMarker \handler

  Pipein[]\clear to Marker[]

  //"Scan_CancellingMarker DRAINING PIPEIN" .
  //PipeIn[].drain

  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: Scan_Cleaning \handler

  // drop the tablePtn lock if held
  counter0[] true == if
    TablePtn[].dropRead
    false to counter0[]
  then

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
// ": scan_DataPulse" .

: scan_DataPulse \handler

  debug::flag@ if "(Revised) scan_DataMarker handler" . then

  // pipe out the pulse marker
  PipeIn[].pipeOut

  // grab table ptn read lock
  TablePtn[].grabRead_yieldLoop

  // set counter0 to true to indicate lock held
  true to counter0[]

  // get the root BufferId pds cursor from this TablePtn

  TablePtn[].rootPdsCursor to PdsCursor[]
  begin
    PdsCursor[].currIsNotNull
  while
    PdsCursor[].getItemAddr TablePtn[].extractBufferId to BufferId[]

    BufferId[].pipeOut

    PdsCursor[].next
  repeat

  PdsCursor[].delete
  nullptr to PdsCursor[]


  // Finished sending all bufferIds to the next op
  // drop table ptn lock
  TablePtn[].dropRead

  // set counter0 to 0 to indicate lock released
  false to counter0[]

  // send an eos marker (there was no data)
  Marker[].newEosMarker
  Marker[].pipeOut

  Marker[].newEndMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
// ": scan_StartMarker" .

: scan_StartMarker \handler

  PipeIn[].pipeOut
  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]

    // pipe out a new a stream def
    Table[] StreamDefOut[].newFromTable
    StreamDefOut[] to Pipein[]
    nullptr to StreamDefOut[]
    Pipein[].pipeOut
  then

  //[args].developer if
  //  1 debug::flag!
  //then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
// ": scan_EndMarker" .

: scan_EndMarker \handler

  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scan_op \operator

  _lu_initialise_

  "<catalogNm>"  [job].tagSet@ tagSet.hasName if
    <schemaNm> <catalogNm>
    "/tenants/boray/catalogs/%v/schemas/%v/tables" str.format
    str.toStrVec Path[].set
  then

  op__topology

  find: scan_CancellingMarker  EV_M_CANCELLING [op].handler!
  find: scan_Cleaning          EV_M_CLEANING   [op].handler!
  find: scan_DataPulse         EV_M_DATAPULSE  [op].handler!
  find: scan_StartMarker       EV_M_START      [op].handler!
  find: scan_EndMarker         EV_M_END        [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: scan :: scan <tableNm> ;
cmdSyntax: scan :: scan <catalogNm> <schemaNm> <tableNm> ;
cmdSyntax: scan :: scan <tableNm> <rateSecs> ;
cmdSyntax: scan :: scan <catalogNm> <schemaNm> <tableNm> <rateSecs> ;

: scan_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "scan_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
