/*============================================================================*/
/* dp_printDemon.sen -- Test Print Demon                                      */
/*============================================================================*/

" dp_printDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* print demon                                                                */
/*----------------------------------------------------------------------------*/
: printDemonPipeline

  "
    pipelineLocal printDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | testPrint
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
