/*============================================================================*/
/* it_bpaRegions.sen -- Define __bpaRegions table                             */
/*============================================================================*/

" it_bpaRegions.sen" .verbose

: start::it_bpaRegions

  // C_TDEF_BPAREGIONS
  
  STD_BOOTFORK_TAG
  "
  define table __bpaRegions (
    heapType    VARCHAR NOT NULL ,
    heapSize    VARCHAR NOT NULL ,
    bufSizeKb   INTEGER NOT NULL ,
    numBuffers  INTEGER NOT NULL ,
    numAllocs   INTEGER NOT NULL ,
    numFrees    INTEGER NOT NULL
  ) < infoSet > = 1 ;
  "
  api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
