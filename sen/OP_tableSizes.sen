/*============================================================================*/
/* OP_tableSizes.sen -- Operator table sizes                                  */
/*============================================================================*/

" OP_tableSizes.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: tableSizes_action

  0 locals| errorCode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  check::folderIsTables not if
    to errorCode
    errorCode op__execErr
    false
    exit
  then

  0 locals| sTableNm |

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  Folder[] dic.lastWord dup
  iterate

    object@ word.name@ to sTableNm

    // find the table
    sTableNm op__table not if
      false
      exit
    then

    // skip definition only tables
    Table[].isUserCreated if

      0 Table[].size number.magnitude >str

      // insert table size
      sTableNm Pds[].addTableSizes  not if
        Pds[].pipeOut
        BT_DATA TableDef[] Pds[].new
        sTableNm Pds[].addTableSizes assert
      then

    then

    // move to next table
    nullptr to Table[]

    object@ word.prev object!

  next

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: tableSizes :: tableSizes ;

: tableSizes_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __tableSizes
    <params>    = 0
    <opEntry> = "tableSizes_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
