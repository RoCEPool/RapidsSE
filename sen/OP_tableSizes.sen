/*============================================================================*/
/* OP_tableSizes.sen -- Operator table sizes                                  */
/*============================================================================*/

" OP_tableSizes.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: tableSizes_action

  0 locals| errorCode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the tables folder
  check::folderIsTables not if
    to errorCode
    errorCode op__execErr
    false
    exit
  then

  0 locals| sTableNm |

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  folder[] dic.lastWord dup
  iterate

    object@ word.name@ to sTableNm

    // find the table
    sTableNm op__table not if
      false
      exit
    then

    // skip definition only tables
    Table[].isUserCreated if

      0 Table[].size number.magnitude >str

      // insert table size
      sTableNm streamSetTable[] StreamSet[].addTableSizes  not if
        StreamSet[].pipeOut
        streamSetTable[] streamSet[].new
        sTableNm streamSetTable[] StreamSet[].addTableSizes assert
      then

    then

    // move to next table
    nullptr to Table[]

    object@ word.prev object!

  next

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: tableSizes :: tableSizes ;

: tableSizes_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __tableSizes
    <params>    = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
