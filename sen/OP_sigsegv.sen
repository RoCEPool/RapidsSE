/*============================================================================*/
/* OP_sigsegv.sen -- inject a sigsegv process kill signal                     */
/*============================================================================*/

" OP_sigsegv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                      */
/*----------------------------------------------------------------------------*/
: sigsegv_sigsegv \handler

  //[task].seeFrameStack
  
  //inject::sigsegv
  inject::sigsegv_dbg

  HAZARD
  
  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* sigsegv request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sigsegv_op \operator

  _lu_initialise_

  op__topology

  find: sigsegv_sigsegv  ZK_D_CRWBUFFER  [op].handler!

  op__loop

  // "*** sigsegv_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sigsegv :: sigsegv ;

: sigsegv_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "sigsegv_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
