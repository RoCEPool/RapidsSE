/*============================================================================*/
/* pp_query.sen -- define query related procedures                            */
/*============================================================================*/

" pp_query.sen" .verbose


/*----------------------------------------------------------------------------*/
/* query related procedures                                                   */
/*----------------------------------------------------------------------------*/

"  start::defProc_Query" .verbose

: start::defProc_Query

  "<path>= /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| STD_PATH_TAG |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 3b prelim
  
  STD_PATH_TAG
  "
  procedure Query_3b
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 300 1
    | stageC hashcast

  stage stageC on all partitions :
    sql 301 1
    | stageD

  stage stageD on origin :
    sql 302 1
    | output
    | sink
    | stageA

  end ;  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 3b prelim
  
  STD_PATH_TAG
  "
  procedure Query_3b_I
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 300 0
    | stageC hashcast

  stage stageC on all partitions :
    sql 301 0
    | stageD

  stage stageD on origin :
    sql 302 0
    | output
    | sink
    | stageA

  end ;  "
  api::addProcedure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 4b prelim
  
  STD_PATH_TAG
  "
  procedure Query_4b
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 400 1
    | stageC

  stage stageC on origin :
    sql 401 1
    | output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 4b prelim
  
  STD_PATH_TAG
  "
  procedure Query_4b_I
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 400 0
    | stageC

  stage stageC on origin :
    sql 401 0
    | output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
