/*============================================================================*/
/* OP_bloat.sen -- bloat a C++ excpetion                                      */
/*============================================================================*/

" OP_bloat.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                       */
/*----------------------------------------------------------------------------*/
: bloat_cleaning \handler

  task::seeFrameStack

  //inject::bloatCleanup

  ZK_M_CLEANING_handler
;


/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                      */
/*----------------------------------------------------------------------------*/
: bloat_bloat \handler

  task::seeFrameStack
  
  inject::bloat

  PipeIn[].delete
  
  true
;

/*----------------------------------------------------------------------------*/
/* bloat request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: bloat::nigeb \operator

  _lu_initialise_

  op__topology

  find: bloat_bloat    ZK_D_CRWBUFFER   op[].handler!
  find: bloat_cleaning  ZK_M_CLEANING   op[].handler!

  op__loop

  // "*** bloat::nigeb EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: bloat :: bloat ;

: bloat_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
