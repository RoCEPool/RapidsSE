/*============================================================================*/
/* OP_bloat.sen -- bloat a C++ excpetion                                      */
/*============================================================================*/

" OP_bloat.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_CLEANUPMARKER ...                                                    */
/*----------------------------------------------------------------------------*/
: bloat_cleanup \handler

  task::seeFrameStack

  debug::bloatCleanup

  PipeIn[].pipeOut

  true
;


/*----------------------------------------------------------------------------*/
/* on ZK_Xyz ...                                                              */
/*----------------------------------------------------------------------------*/
: bloat_bloat \handler

  task::seeFrameStack
  
  debug::bloat

  PipeIn[].delete
  
  true
;

/*----------------------------------------------------------------------------*/
/* bloat request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: bloat_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: bloat_bloat    ZK_CRWBUFFER     op[].handler!
  find: bloat_cleanup  ZK_CLEANUPMARKER op[].handler!

  op__loop

  // "*** bloat_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: bloat :: bloat ;

: bloat_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
