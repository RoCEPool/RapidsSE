/*============================================================================*/
/* OP_consume.sen -- Operator consume                                         */
/*============================================================================*/

" OP_consume.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CANCELLING ...                                            */
/*----------------------------------------------------------------------------*/
: consumeOp_Cancelling \handler

  //"Operand:- EV_M_CANCELLING" .verbose
  Sends[].handleCancelling if
    EV_M_CANCELLING_handler
  else
    PipeIn[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: consumeOp_Cleaning \handler

  LogicUnit[].cleanup

  //"Operand:- EV_M_CLEANING" .verbose
  Sends[].handleCleaning if
    Pipein[].pipeout
  else
    PipeIn[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ENDING ...                                                */
/*----------------------------------------------------------------------------*/
: consumeOp_EndingMarker \handler

  //"Operand:- EV_M_ENDING" .verbose
  Sends[].handleEnding if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: consumeOp_EosMarker \handler

  //"Operand:- EV_M_EOS" .verbose
  Sends[].handleEos if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ERRORING ...                                              */
/*----------------------------------------------------------------------------*/
: consumeOp_ErroringMarker \handler

  //"Operand:- EV_M_ERRORING" .verbose
  Sends[].handleErroring if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_DataPulse \handler

  //"Operand:- EV_M_DATAPULSE" .verbose
  Sends[].handleDataPulse if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DESTROY ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_DESTROYMARKER \handler

  //"Operand:- EV_M_DESTROY" .verbose
  Sends[].handleDestroy if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: consumeOp_EndMarker \handler

  //"Operand:- EV_M_END" .verbose
  Sends[].handleEnd if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ERROR ...                                                 */
/*----------------------------------------------------------------------------*/
: consumeOp_ErrorMarker \handler

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EXITING ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_Exiting \handler

  //"Operand:- EV_M_EXITING" .verbose
  Sends[].handleExiting if
    EV_M_EXITING_handler // calling op_loop exits
  else
    PipeIn[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LEAVING ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_LeavingMarker \handler

  //"Operand:- EV_M_LEAVING" .verbose
  Sends[].handleLeaving if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: consumeOp_StartMarker \handler

  //"Operand:- EV_M_START" .verbose
  Sends[].handleStart if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_StreamDef \handler

  //"Operand:- EV_D_STREAMDEF" .verbose
  Sends[].handleStreamDef if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEFRHT ...                                          */
/*----------------------------------------------------------------------------*/
: consumeOp_StreamDefRht \handler

  //"Operand:- EV_D_STREAMDEFRHT" .verbose
  Sends[].handleStreamDefRht if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* execute for consumeOp req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: consumeOp_op \operator

  _lu_initialise_

  <Sends> >int Sends[].new

  // set topology, next stage and op
  op__topology

  find: consumeOp_Cancelling     EV_M_CANCELLING [op].handler!
  find: consumeOp_Cleaning       EV_M_CLEANING   [op].handler!
  find: consumeOp_DestroyMarker  EV_M_DESTROY    [op].handler!
  find: consumeOp_DataPulse      EV_M_DATAPULSE  [op].handler!
  find: consumeOp_EndMarker      EV_M_END        [op].handler!
  find: consumeOp_EndingMarker   EV_M_ENDING     [op].handler!
  find: consumeOp_EosMarker      EV_M_EOS        [op].handler!
  find: consumeOp_ErrorMarker    EV_M_ERROR      [op].handler!
  find: consumeOp_ErroringMarker EV_M_ERRORING   [op].handler!
  find: consumeOp_Exiting        EV_M_EXITING    [op].handler!
  find: consumeOp_LeavingMarker  EV_M_LEAVING    [op].handler!
  find: consumeOp_StartMarker    EV_M_START      [op].handler!
  find: consumeOp_StreamDef      EV_D_STREAMDEF  [op].handler!
  find: consumeOp_StreamDefRht   EV_D_STREAMDEFRHT  [op].handler!

  op__loop

  Sends[].delete

  _lu_finalise_
  
  op__retires
  
  HAZARD

;
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: consumeOp :: consumeOp <Sends> ;

: consumeOp_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "consumeOp_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
