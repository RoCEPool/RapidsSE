/*============================================================================*/
/* OP_consume.sen -- Operator consume                                         */
/*============================================================================*/

" OP_consume.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CANCELLING ...                                            */
/*----------------------------------------------------------------------------*/
: consumeOp_Cancelling \handler

  //"Operand:- ZK_M_CANCELLING" .verbose
  Sends[].handleCancelling if
    ZK_M_CANCELLING_handler
  else
    PipeIn[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: consumeOp_Cleaning \handler

  //"Operand:- ZK_M_CLEANING" .verbose
  Sends[].handleCleaning if
    Pipein[].pipeout
  else
    PipeIn[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ENDING ...                                                */
/*----------------------------------------------------------------------------*/
: consumeOp_EndingMarker \handler

  //"Operand:- ZK_M_ENDING" .verbose
  Sends[].handleEnding if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: consumeOp_EosMarker \handler

  //"Operand:- ZK_M_EOS" .verbose
  Sends[].handleEos if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ERRORING ...                                              */
/*----------------------------------------------------------------------------*/
: consumeOp_ErroringMarker \handler

  //"Operand:- ZK_M_ERRORING" .verbose
  Sends[].handleErroring if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_DataPulse \handler

  //"Operand:- ZK_M_DATAPULSE" .verbose
  Sends[].handleDataPulse if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DESTROY ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_DESTROYMARKER \handler

  //"Operand:- ZK_M_DESTROY" .verbose
  Sends[].handleDestroy if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: consumeOp_EndMarker \handler

  //"Operand:- ZK_M_END" .verbose
  Sends[].handleEnd if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ERROR ...                                                 */
/*----------------------------------------------------------------------------*/
: consumeOp_ErrorMarker \handler

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EXITING ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_Exiting \handler

  //"Operand:- ZK_M_EXITING" .verbose
  Sends[].handleExiting if
    ZK_M_EXITING_handler // calling op_loop exits
  else
    PipeIn[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_LEAVING ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_LeavingMarker \handler

  //"Operand:- ZK_M_LEAVING" .verbose
  Sends[].handleLeaving if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: consumeOp_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose
  Sends[].handleStart if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_StreamDef \handler

  //"Operand:- ZK_D_STREAMDEF" .verbose
  Sends[].handleStreamDef if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_STREAMDEFRHT ...                                          */
/*----------------------------------------------------------------------------*/
: consumeOp_StreamDefRht \handler

  //"Operand:- ZK_M_STREAMDEFRHT" .verbose
  Sends[].handleStreamDefRht if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* execute for consumeOp req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: consumeOp_req \operator

  LogReqEntry SEED_REQ

  <Sends> >int Sends[].new

  // set topology, next stage and op
  op__topology

  find: consumeOp_Cancelling     ZK_M_CANCELLING op[].handler!
  find: consumeOp_Cleaning       ZK_M_CLEANING   op[].handler!
  find: consumeOp_DestroyMarker  ZK_M_DESTROY    op[].handler!
  find: consumeOp_DataPulse      ZK_M_DATAPULSE  op[].handler!
  find: consumeOp_EndMarker      ZK_M_END        op[].handler!
  find: consumeOp_EndingMarker   ZK_M_ENDING     op[].handler!
  find: consumeOp_EosMarker      ZK_M_EOS        op[].handler!
  find: consumeOp_ErrorMarker    ZK_M_ERROR      op[].handler!
  find: consumeOp_ErroringMarker ZK_M_ERRORING   op[].handler!
  find: consumeOp_Exiting        ZK_M_EXITING    op[].handler!
  find: consumeOp_LeavingMarker  ZK_M_LEAVING    op[].handler!
  find: consumeOp_StartMarker    ZK_M_START      op[].handler!
  find: consumeOp_StreamDef      ZK_D_STREAMDEF  op[].handler!
  find: consumeOp_StreamDefRht   ZK_M_STREAMDEFRHT  op[].handler!

  op__loop

  Sends[].delete

  _op_release_resources_
  _op_retires_
  DONE_REQ_OP

;
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: consumeOp :: consumeOp <Sends> ;

: consumeOp_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
