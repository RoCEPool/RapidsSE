/*============================================================================*/
/* OP_consume.sen -- Operator consume                                         */
/*============================================================================*/

" OP_consume.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: consumeOp_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose
  Sends[].handleCancel if
    ZK_CANCELMARKER_handler
  else
    PipeIn[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CLEANUPMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: consumeOp_CleanupMarker \handler

  //"Operand:- ZK_CLEANUPMARKER" .verbose
  Sends[].handleCleanup if
    Pipein[].pipeout
  else
    PipeIn[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENDINGMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: consumeOp_EndingMarker \handler

  //"Operand:- ZK_ENDINGMARKER" .verbose
  Sends[].handleEnding if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  Sends[].handleEos if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORINGMARKER ...                                          */
/*----------------------------------------------------------------------------*/
: consumeOp_ErroringMarker \handler

  //"Operand:- ZK_ERRORINGMARKER" .verbose
  Sends[].handleErroring if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_DataPulse \handler

  //"Operand:- ZK_DATAPULSE" .verbose
  Sends[].handleDataPulse if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DESTROYMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: consumeOp_DESTROYMARKER \handler

  //"Operand:- ZK_DESTROYMARKER" .verbose
  Sends[].handleDestroy if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENDMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_EndMarker \handler

  //"Operand:- ZK_ENDMARKER" .verbose
  Sends[].handleEnd if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: consumeOp_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  Sends[].handleExit if
    PipeIn[].pipeOut
    Op.ackPipelineJob
    false
  else
    PipeIn[].delete
    true
  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: consumeOp_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  Sends[].handleStart if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: consumeOp_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  Sends[].handleStreamDef if
    PipeIn[].pipeOut
  else
    PipeIn[].delete
  then
  true
;

/*----------------------------------------------------------------------------*/
/* execute for consumeOp req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: consumeOp_req \operator

  LogReqEntry SEED_REQ

  <Sends> >int Sends[].new

  // set topology, next stage and op
  op__topology

  find: consumeOp_CancelMarker   ZK_CANCELMARKER   op[].handler!
  find: consumeOp_CleanupMarker  ZK_CLEANUPMARKER  op[].handler!
  find: consumeOp_EndMarker      ZK_ENDMARKER      op[].handler!
  find: consumeOp_EndingMarker   ZK_ENDINGMARKER   op[].handler!
  find: consumeOp_EosMarker      ZK_EOSMARKER      op[].handler!
  find: consumeOp_ErroringMarker ZK_ERRORINGMARKER op[].handler!
  find: consumeOp_ExitMarker     ZK_EXITMARKER     op[].handler!
  find: consumeOp_DestroyMarker  ZK_DESTROYMARKER  op[].handler!
  find: consumeOp_DataPulse      ZK_DATAPULSE      op[].handler!
  find: consumeOp_StartMarker    ZK_STARTMARKER    op[].handler!
  find: consumeOp_StreamDef      ZK_STREAMDEF      op[].handler!

  op__loop

  Sends[].delete

  LogReqExit
  job::deleteThis
  DONE_REQ_OP

;
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: consumeOp :: consumeOp <Sends> ;

: consumeOp_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
