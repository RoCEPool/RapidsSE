/*============================================================================*/
/* OP_defineTable.sen -- Operator define table                                */
/*============================================================================*/

" OP_defineTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a defineTable table                                  */
/*----------------------------------------------------------------------------*/
: defineTable::checkDefine ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then

  // error if given name already exists
  <tableNm> check::nameIsUnknownTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* define table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: defineTable::createDefinedTable

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapids/schemas/public/tables
  Folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  StreamDefLft[] <tableNm> table::createTable to Table[]

  // create row in metadata table with catalogNm, schemaNm, tableNm
  // Pass the table type (eTT)
  "INTERNAL" MetaDataTable[].initTables

  nullptr to StreamDefLft[]
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: defineTable_StreamDef

  0 locals| errorCode |

  // get the stream def
  Pipein[] to StreamDefLft[]
  nullptr to Pipein[]

  // grab the ddl lock
  [ddlLock].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check ok to create table
  defineTable::checkDefine not if ( errorCode )
    to errorCode
    //StreamDefLft[].delete
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table
  defineTable::createDefinedTable

  // should be in tables
  Folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute for defineTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: defineTable_op \operator

  _lu_initialise_

  op__topology

  find: defineTable_StreamDef EV_D_STREAMDEF [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: defineTable :: defineTable <tableNm> ;

: defineTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "defineTable_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
