/*============================================================================*/
/* OP_fetch.sen -- Operator fetch                                             */
/*============================================================================*/

" OP_fetch.sen" .verbose

/*----------------------------------------------------------------------------*/
/* position and begin fetch                                                   */
/*----------------------------------------------------------------------------*/
: positionBeginFetch ( "iPhrase" "lowerKey" "upperKey" )

  params| upperKey lowerKey iPhrase |
  0 locals| sIndexNm |

  // find the index
  iPhrase PathIdentifier[].indexNm@ to sIndexNm
  <tableNm> sIndexNm op__index assert

  // grab the table ptn read lock
  TablePtn[].grabRead_yieldLoop

  // new an index stream
  Index[] TablePtn[] indexStream::new to indexStream[]

  // open index stream to access index
  indexStream[].open

  // position in the index
  iPhrase  // phrase
  lowerKey // lower
  upperKey // upper
  PathIdentifier[] indexStream[].seek
;

/*----------------------------------------------------------------------------*/
/* fetch first buffer for phrase                                              */
/*----------------------------------------------------------------------------*/
: fetchFirstBuffer ( iPhrase -- )

  params| iPhrase |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the fetch technique
  iPhrase PathIdentifier[].fetchTech@

  case

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an exact select using index
    AT_EXACT of
      "*exact*" .verbose

      iPhrase                  // phrase
      iPhrase PathIdentifier[].key@   // lower key
      iPhrase PathIdentifier[].key@   // upper key
      positionBeginFetch
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // lower bound select using index
    AT_LOWER of
      "*lower*" .verbose

      iPhrase                     // phrase
      iPhrase PathIdentifier[].lowKey@   // lower key
      ""                          // upper key
      positionBeginFetch
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an upper bound select using index
    AT_UPPER of
      "*upper*" .verbose

      iPhrase                     // phrase
      ""                          // lower key
      iPhrase PathIdentifier[].upperKey@ // upper key
      positionBeginFetch
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // a range select using index
    AT_RANGE of
      "*range" .verbose

      iPhrase                     // phrase
      iPhrase PathIdentifier[].lowKey@   // lower key
      iPhrase PathIdentifier[].upperKey@ // upper key
      positionBeginFetch
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // full scan (no index)
    AT_SCAN of
      "*scan*" .verbose
      // now get excat key rows from index
      TablePtn[].grabRead_yieldLoop
      TablePtn[] ptnStream::new to ptnStream[]

      // open ptn stream for the tablePtn
      ptnStream[] ptnStream.open assert

    endof

  endcase

  // force op loop to call fetch_CrwBuffer to start processing buffers
  "fetch_CrwBuffer" word::find LogicUnit[].handler!
  true LogicUnit[].callAgain!
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: fetch_Cleaning \handler

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: fetch_CrwBuffer \handler
 
  //"Operand:- ZK_D_CRWBUFFER" .verbose

  // get the fetchTechnique
  Counter1[] PathIdentifier[].fetchTech@
  case
    AT_SCAN of
      // read next buffer from ptn stream
      ptnStream[] ptnStream.read to DataBuffer[]
    endof

    // all other types of fetches, just fetchNext
    rowOnce[].isNull if
      nullptr
    else
      rowOnce[]
    then
    indexStream[].read to DataBuffer[]

  endcase

  // no more data for counter1[] phrase ?
  DataBuffer[].isNull if

    // any more phrases ?
    Counter1[] 1 + to Counter1[]
    Counter1[] Counter0[] >= if
      // all done
      // close and delete partition stream
      ptnStream[].isNull not if
        ptnStream[] ptnStream.close
        ptnStream[] ptnStream.delete
        nullptr to ptnStream[]
      then
 
      // close and delete index stream
      indexStream[].isNull not if
        indexStream[].close
        indexStream[].delete
        nullptr to indexStream[]
      then
 
      TablePtn[].dropRead

      // delete the path identifier
      PathIdentifier[].delete
      nullptr to PathIdentifier[]
      
      // delete the rowOnce skipList
      rowOnce[].isNull not if
        rowOnce[].delete
        nullptr to rowOnce[]
      then

      // pipeout an eosMarker
      Marker[].newEosMarker
      Marker[].pipeOut
    else

      TablePtn[].dropRead

      // position and fetch first buffer for next phrase
      Counter1[] fetchFirstBuffer
    then
 
  else
 
    // pipe out the read crw buffer
    DataBuffer[].pipeOut
 
    // call this handler again to process next buffer
    true LogicUnit[].callAgain!
 
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: fetch_DataMarker \handler
 
  0 locals| iPhrases |

  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // new a stream def
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get no of phrases
  PathIdentifier[].phrases@ to Counter0[]

  // if multiple phrases create a rowOnce skipList
  Counter0[] 1 > if
    RowOnce[].new
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert we have at least one phrase
  Counter0[] 1 >= assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set counter1[] to 0
  0 to Counter1[]
 
  // position and fetch the first buffer for the first phrase
  Counter1[] fetchFirstBuffer

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: fetch_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  0 locals| iPhrases |

  PipeIn[].pipeOut

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the plan for the fetch
  generatePlan

  //PathIdentifier[].showPaths

  // assert we have a plan
  PathIdentifier[].isNull not assert

  true
;

/*----------------------------------------------------------------------------*/
/* fetch request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: fetch_op \operator

  _lu_initialise_
  //<tableNm> <predicate> "PARAMETERS %v %v" str.format .

  op__topology

  find: fetch_Cleaning      ZK_M_CLEANING      op[].handler!
  find: fetch_CrwBuffer     ZK_D_CRWBUFFER     op[].handler!
  find: fetch_DataMarker    ZK_M_DATAPULSE     op[].handler!
  find: fetch_StartMarker   ZK_M_START         op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: fetch :: fetch <tableNm> <predicate> ;

: fetch_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
