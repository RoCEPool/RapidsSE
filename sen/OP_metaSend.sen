/*============================================================================*/
/* OP_metaSend.sen -- Operator meta send                                      */
/*============================================================================*/

" OP_metaSend.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_METAGET ...                                                        */
/*----------------------------------------------------------------------------*/
: metaSend_metaGet \handler

 //"metaSend_metaGet handler" .

  Pipein[]\clear to Meta[]  // pop the pMetaGet and put in the Meta register
  //Operand[] MetaGet.getTableName
  // print table name from the stack
  //.

  // pass the table name to op__table to get the table[] register
  // then call C++ getParts to build the parcel and push the pParcel to the stack
  // op::pipeout pipe the pParcel out

  Meta[].getTableName op__table assert
  table[] MetaSend::getParts Op::pipeout

  // send EOSMARKER
  nullptr to Meta[]
  //Marker[].newEosMarker
  //Marker[].pipeOut

  true

  //task::breakpoint //set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for metasend request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaSend_req \operator

  LogReqEntry SEED_REQ
  //"metaSend_req" .

  op__topology

  // Setup ZK_D_METAGET handler
  find: metaSend_metaGet ZK_D_METAGET op[].handler!
  op__loop

  LogReqExit
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaSend :: metaSend ;

: metaSend_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
