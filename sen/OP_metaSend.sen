/*============================================================================*/
/* OP_metaSend.sen -- Operator meta send                                      */
/*============================================================================*/

" OP_metaSend.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_METAGET ...                                                          */
/*----------------------------------------------------------------------------*/
: metaSend_metaGet \handler

 "metaSend_metaGet handler, to print out the table name" .

  Operand[].pipein  // pop the pMetaGet and put in the Operand register
  Operand[] MetaGet.getTableName

  // print table name from the stack
  .
  true
;

/*----------------------------------------------------------------------------*/
/* execute for metasend request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaSend_req \operator

  LogReqEntry SEED_REQ
  "metaSend_req" .

  op__topology

  // Setup ZK_METAGET handler
  find: metaSend_metaGet ZK_METAGET op[].handler!
  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaSend :: metaSend ;

: metaSend_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
