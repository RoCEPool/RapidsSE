/*============================================================================*/
/* OP_metaSend.sen -- Operator meta send                                      */
/*============================================================================*/

" OP_metaSend.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_METAGET ...                                                          */
/*----------------------------------------------------------------------------*/
: metaGet_table \handler

  MetaSend::getParts
    
  true
;

/*----------------------------------------------------------------------------*/
/* execute for metasend request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaSend_req \operator

  LogReqEntry SEED_REQ

  op__topology

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaSend :: metaSend ;

: metaSend_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
