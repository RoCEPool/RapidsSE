/*============================================================================*/
/* OP_metaSend.sen -- Operator meta send                                      */
/*============================================================================*/

" OP_metaSend.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_METAGET ...                                                        */
/*----------------------------------------------------------------------------*/
: metaSend_MetaGet \handler

  // "metaSend_MetaGet" .

  Pipein[]\clear to MetaGet[]
  
  MetaGet[].tableName@ op__table assert

  Table[] MetaGet[].getParts [op].pipeout

  MetaGet[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* execute for metasend request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaSend_op \operator

  _lu_initialise_

  op__topology

  find: metaSend_MetaGet EV_D_METAGET [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaSend :: metaSend ;

: metaSend_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "metaSend_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
