/*============================================================================*/
/* pipeline__words.sen -- Pipeline related words                              */
/*============================================================================*/

" pipeline__words.sen" .verbose

/*----------------------------------------------------------------------------*/
/* invoke the sub-pipeline pointed to by the SubPipe[] register               */
/*----------------------------------------------------------------------------*/
: subPipe:invoke

  SubPipe[] assert
  
  [task].isLocked? not assert
  
  SubPipe[].opsOnNode@ locals| nAcks |

  [task].grabLock
    [task].isLocked? assert

    SubPipe[].opsOnNode@ to nAcks

    nAcks if
      nAcks [task].acksRemaining!

      SubPipe[].enqueueStart? if

        Marker[].newStartMarker
        Marker[]\clear SubPipe[].op0@ op.enqueOperand
      then
      [task].wait
    else
      [task].dropLock
    then
    
  [task].isLocked? not assert
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
