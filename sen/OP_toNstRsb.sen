/*============================================================================*/
/* OP_toNstRsb.sen -- Convert row to normalised string row slab buffers       */
/*============================================================================*/

" OP_toRsb.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toNstRsb_StartMarker \handler

  ToNstRsb[].create

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: toNstRsb_DataMarker \handler

  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toNstRsb_RowBuffer \handler

  PipeIn[] ToNstRsb[].convert to OperandB[]
  nullptr to PipeIn[]

  OperandB[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toNstRsb_EosMarker \handler

  // delete ToNstRsb
  ToNstRsb[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRsb request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toNstRsb_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toNstRsb_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toNstRsb_DataMarker ZK_DATAPULSE op[].handler!
  find: toNstRsb_RowBuffer   ZK_ROWBUFFER   op[].handler!
  find: toNstRsb_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toNstRsb :: toNstRsb ;

: toNstRsb _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
