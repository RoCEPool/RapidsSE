/*============================================================================*/
/* md_tables.sen -- Define md__tables table                                   */
/*============================================================================*/

" md_tables.sen" .verbose

: start::md_tables

  // C_TDEF_TABLES

  STD_BOOTFORK_TAG
  "
  define metadata table tableOfTables (
    CatalogName   VARCHAR NOT NULL ,
    SchemaName    VARCHAR NOT NULL ,
    TableName     VARCHAR NOT NULL ,
    TableType     VARCHAR NOT NULL ,
    TableAddr     INTEGER NOT NULL
  ) < metaData > = 1 ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
