/*============================================================================*/
/* se_categories.sen -- categories                                            */
/*============================================================================*/

" se_categories.sen" .verbose

/*----------------------------------------------------------------------------*/
/* categorising word                                                          */
/*----------------------------------------------------------------------------*/
: \\category immediate

  //
  // this word is used while compiling another word.
  // let us call that another word the catgWord.
  // this word sets the catgWord being compiled to be an immediate word.
  // that catgWord is then later used to set yet another word being comiled
  //   to have the category of catgWord.
  // let us call that yet another word the targetWord
  //

  // while compiling a new catgWord set that catgWord to be immediate
  true
  senCompiler::current@
  word.immediate!

  input::next find execute senCompiler::current@ word.category!


  // add code into the catgWord so that when catgWord is used while compiling
  // a target word, the category of the target word is set to be catgWord
  senCompiler::current@ word.category@ encode::push
  POSTPONE senCompiler::current@
  POSTPONE word.category!

  //[ senCompiler::current@ word.see ]
;

/*----------------------------------------------------------------------------*/
/* prompt category                                                            */
/*----------------------------------------------------------------------------*/
: \prompt \\category WC_PROMPT ;

: prompts \prompt WC_PROCEDURE word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* demon category                                                             */
/*----------------------------------------------------------------------------*/
: \demon \\category WC_DEMON ;

: demons \prompt WC_DEMON word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* folder is used as a kind of word to identify folders                       */
/*----------------------------------------------------------------------------*/
: \folder \\category WC_FOLDER ;

: isFolder word.category@ WC_FOLDER equal ;

: folders \prompt WC_FOLDER word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* handler category                                                           */
/*----------------------------------------------------------------------------*/

: _handler_entry

  [op].handlerEntry
;

: _handler_exit

  [op].handlerExit
;

: \handler \\category WC_HANDLER

  "_handler_exit" senCompiler::current@ word.exitHook!

  POSTPONE _handler_entry
;

: handlers \prompt WC_HANDLER word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* include category                                                           */
/*----------------------------------------------------------------------------*/
: \include \\category WC_INCLUDE ;

: includes \prompt WC_INCLUDE word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* operator category                                                          */
/*----------------------------------------------------------------------------*/
: \operator \\category WC_OPERATOR ;

: operators \prompt WC_OPERATOR word::ofCatg ;
: ops       \prompt WC_OPERATOR word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* procedure category                                                         */
/*----------------------------------------------------------------------------*/
: \procedure \\category WC_PROCEDURE ;



/*----------------------------------------------------------------------------*/
/* list all words in the current dictionary                                   */
/*----------------------------------------------------------------------------*/
: words \prompt

  "TO BE IMPLEMENTED" .
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: lw \prompt

  0 0 locals| pWord pCatg |

  dic::root dic.lastWord dup
  iterate                                 // iterate word cursor

    object@ to pWord

    pWord word.show

    object@ word.prev object!             // advance cursor backwards thru words
  next
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
