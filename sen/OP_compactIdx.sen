/*============================================================================*/
/* OP_compactIndex.sen -- Operator compact index                              */
/*============================================================================*/

" OP_compactIdx.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: compactIdx_action

  <tableNm> <indexNm> op__table_index if
    Index[].compact
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: compactIdx :: compactIdx   <tableNm> <indexNm> ;

: compactIdx_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <params>    = 2
    <opEntry> = "compactIdx_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
