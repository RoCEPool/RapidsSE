/*============================================================================*/
/* pp_dynCompiler.sen -- define dyn compiler procedures                       */
/*============================================================================*/

" pp_dynCompiler.sen" .verbose


/*----------------------------------------------------------------------------*/
/* dyn compiler related procedures                                            */
/*----------------------------------------------------------------------------*/

"  start::defProc_DynCompiler" .verbose

: start::defProc_DynCompiler

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 3 prelim
  STD_PATH_TAG
  "
  procedure dynCompiler
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 100001 1
    | stageC

  stage stageC on origin :
    output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
