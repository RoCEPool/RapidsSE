/*============================================================================*/
/* OP_projValidation.sen -- Validate projections are valid (SQL Compiler)     */
/*============================================================================*/

" OP_projValidation.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: projValidation_Cleaning \handler

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: projValidation_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCmdErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::projValidation to PlanOperand[]

  "projValidation" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: projValidation::nigeb \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker          ZK_M_LEAVE        op[].handler!
  find: compiler_StreamSet            ZK_D_STREAMSET    op[].handler!

  // specific handlers
  find: projValidation_Cleaning      ZK_M_CLEANING      op[].handler!
  find: projValidation_PlanOperand   ZK_D_PLANOPERAND   op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: projValidation :: projValidation ;

: projValidation_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
