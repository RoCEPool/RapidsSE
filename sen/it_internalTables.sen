/*============================================================================*/
/* it_internalTables.sen -- Define Internal Tables                            */
/*============================================================================*/

" it_internalTables.sen" .verbose

/*----------------------------------------------------------------------------*/
/* define info sets (group 1)                                                 */
/*----------------------------------------------------------------------------*/

" start::defineInfoSets1" .verbose

: start::defineInfoSets1

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_ANALYZEINDEX
  STD_PATH_TAG
  "
    define table __analyzeIndex (
      nodeName       VARCHAR NOT NULL ,
      partition      INTEGER NOT NULL ,
      buffers        INTEGER NOT NULL ,
      entries        INTEGER NOT NULL
    ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_ANALYZETABLE
  STD_PATH_TAG
  "
  define table __analyzeTable (
     nodeName       VARCHAR NOT NULL ,
     partition      INTEGER NOT NULL ,
     buffers        INTEGER NOT NULL ,
     entries        INTEGER NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_COMMANDERRORS
  STD_PATH_TAG
  "
  define table __commandErrors (
    nodeName       VARCHAR NOT NULL ,
    errorCode      INTEGER NOT NULL ,
    line           INTEGER NOT NULL ,
    column         INTEGER NOT NULL ,
    text           VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_COUNT
  STD_PATH_TAG
  "
  define table __count ( rowCount INTEGER NOT NULL ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_COUNTINFO
  STD_PATH_TAG
  "
  define table __countInfo ( rowCount INTEGER NOT NULL ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_EXECERRORS
  STD_PATH_TAG
  "
  define table __execErrors (
    nodeName       VARCHAR NOT NULL ,
    errorCode      INTEGER NOT NULL ,
    text           VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_EXPLAIN
  STD_PATH_TAG
  "
    define table __explain (
      stageNum    INTEGER NOT NULL ,
      stageName   VARCHAR NOT NULL ,
      explain     VARCHAR NOT NULL
    ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_GRIDSANITY
  STD_PATH_TAG
  "
  define table __gridSanity (
    nodeName   VARCHAR NOT NULL ,
    homogenous BOOLEAN NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_LISTCOLUMNS
  STD_PATH_TAG
  "
  define table __listColumns (
    columnName     VARCHAR NOT NULL ,
    columnType     VARCHAR NOT NULL ,
    columnLength   INTEGER NOT NULL ,
    columnScale    INTEGER NOT NULL ,
    isNullable     BOOLEAN NOT NULL ,
    isPartitionKey BOOLEAN NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_LISTCONTENTS
  STD_PATH_TAG
  "
  define table __listContents (
    Name       VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_LISTFOLDER
  STD_PATH_TAG
  "
  define table __listFolder (
    Name       VARCHAR NOT NULL ,
    Type       VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_LISTINDEX
  STD_PATH_TAG
  "
  define table __listIndex (
    indexName    VARCHAR NOT NULL ,
    isUnique     BOOLEAN NOT NULL ,
    isPrimaryKey BOOLEAN NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_LISTNODES
  STD_PATH_TAG
  "
  define table __listNodes (
    node          INTEGER NOT NULL ,
    nodeName      VARCHAR NOT NULL ,
    ptnsInNode    INTEGER NOT NULL ,
    ipAdd         VARCHAR NOT NULL ,
    portNo        INTEGER NOT NULL ,
    state         VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_LISTPARTITIONS
  STD_PATH_TAG
  "
  define table __listPartitions (
    partition     INTEGER NOT NULL ,
    nodeName      VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_PINGINFO
  STD_PATH_TAG
  "
  define table __pingInfo (
    pong      VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_PROMPTOUT
  STD_PATH_TAG
  "
  define table __promptOut (
    promptLine  VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard
;


/*----------------------------------------------------------------------------*/
/* define info sets (group 2)                                                 */
/*----------------------------------------------------------------------------*/

"  start::defineInfoSets2" .verbose

: start::defineInfoSets2

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_SHOWCLUSTER
  STD_PATH_TAG
  "
  define table __showCluster (
    NodeName  VARCHAR NOT NULL ,
    IPAddress VARCHAR NOT NULL ,
    PortNo    INTEGER NOT NULL ,
    Connected BOOLEAN NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_SIZEINDEX
  STD_PATH_TAG
  "
  define table __sizeIndex (
    NodeName  VARCHAR NOT NULL ,
    size      VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_SIZETABLE
  STD_PATH_TAG
  "
  define table __sizeTable (
    NodeName  VARCHAR NOT NULL ,
    size      VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_SPACE
  STD_PATH_TAG
  "
  define table __space (
    nodeName   VARCHAR NOT NULL ,
    totalSpace VARCHAR NOT NULL ,
    inUseSpace VARCHAR NOT NULL ,
    freeSpace  VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  api::executeCommand 2discard

;

