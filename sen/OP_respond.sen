/*============================================================================*/
/* OP_respond.sen -- Operator respond                                         */
/*============================================================================*/

" OP_respond.sen" .verbose

/*----------------------------------------------------------------------------*/
/* default redirection handler                                                */
/*----------------------------------------------------------------------------*/
: respond_redirect \handler

  responseOp:pipeout
  
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: respond_EosMarker \handler

  Marker[].newFlushMarker Marker[]\clear responseOp:enqueOpr
  
  EV_M_EOS_handler
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for respond op                                                     */
/*----------------------------------------------------------------------------*/
 : respond_op \operator

  _lu_initialise_

  op__topology

  find: respond_EosMarker  EV_M_EOS        [op].handler!
  
  find: respond_redirect   EV_D_CRWBUFFER  [op].handler!
  find: respond_redirect   EV_D_CSVBUFFER  [op].handler!
  find: respond_redirect   EV_D_ROWBUFFER  [op].handler!
  find: respond_redirect   EV_D_STREAMDEF  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: respond :: respond ;

: respond_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "respond_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
