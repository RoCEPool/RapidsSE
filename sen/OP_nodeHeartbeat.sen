/*============================================================================*/
/* OP_nodeHeartbeat.sen -- Operator node heartbeat                            */
/*============================================================================*/

" OP_nodeHeartbeat.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE...                                                       */
/*----------------------------------------------------------------------------*/
: nodeHeartbeat_DataPulse \handler

  PipeIn[].pipeOut

  // find the __ table
  <streamDef> op__tableDef assert
  
  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  // add nodeStatus to the infoSet
  TableDef[] Pds[].addNodeheartbeat assert

  // pipeout the Pds
  Pds[].pipeOut

  true
;


/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : nodeHeartbeat_op \operator
 
  _lu_initialise_

  0 to Counter0[]

  op__topology

  find: nodeHeartbeat_DataPulse  EV_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: nodeHeartbeat :: nodeHeartbeat ;

: nodeHeartbeat_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "nodeHeartbeat_op"
    <params>  = 0
    <streamDef> = __status
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
