/*============================================================================*/
/* OP_waitFinished.sen -- Operator wait finished                              */
/*============================================================================*/

" OP_waitFinished.sen" .verbose

/*

  Counter0[] : tracks the number of EV_X_CHILDEXIT expected
  
  Counter1[] : tracks the number of EV_X_CHILDEXIT processed so far

*/

/*----------------------------------------------------------------------------*/
/* test                                                                       */
/*----------------------------------------------------------------------------*/
: waitFinished_mayProceed

  //Counter1[] Counter0[] "    expected %v processed %v" .printf

  Counter0[] not if
    false
    exit
  then

  Counter1[] Counter0[] == if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/* on EV_X_CHILDEXIT ...                                       EV_X_CHILDEXIT */
/*----------------------------------------------------------------------------*/
: waitFinished_ChildExit \handler

  0 EV_X_CHILDEXIT EG_ZK LogicUnit[].diaryNote

  // increment EV_X_CHILDEXIT's processed Counter1
  Counter1[] 1 + to Counter1[]

  // may proceed ?
  waitFinished_mayProceed if

    true LogicUnit[].RcvdChildExit!

    nullptr [job].responseOp!

    LogicUnit[].RcvdEnd@ if
      Marker[].newEndMarker
      Marker[].pipeout
    then

    //"waitFinished_ChildExit" .
  then

  Pipein[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: waitFinished_End \handler

  //"EV_M_END" .verbose

  true LogicUnit[].RcvdEnd!

  // if received all child exits then pipeout END
  //   else wait till all child exits have been received
  LogicUnit[].RcvdChildExit@ if
     PipeIn[].pipeout
  else
    PipeIn[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: waitFinished_RowBuffer \handler

  0 locals| eBufferType |

  PipeIn[].bufferType@ to eBufferType

  // handle BT_COUNT only
  eBufferType BT_COUNT != if
    PipeIn[].pipeout
    true
    exit
  then

  PipeIn[] to RowBuffer[]
  nullptr to PipeIn[]

  //0 C_TDEF_COUNT InfoSet:getCol to Counter0[]
  //RowBuffer[].delete

  // get first row of RowBuffer[]
  RowBuffer[].firstRow to Row[]

  // get 0th Column (rowCount) add to Counter
  0 Row[].getIntColumn to Counter0[]

  // now delete the rowBuffer
  RowBuffer[].delete

  //Counter0[] "  expecting %v commands" .printf

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: waitFinished_Start \handler
    
  0 to Counter0[] // tracks the number of EV_X_CHILDEXIT expected
  0 to Counter1[] // tracks the number of EV_X_CHILDEXIT processed so far

  EV_M_START_handler
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute wait op                                                            */
/*----------------------------------------------------------------------------*/
 : waitFinished_op \operator

  _lu_initialise_

  op__topology

  find: waitFinished_End       EV_M_END       [op].handler!
  find: waitFinished_RowBuffer EV_D_ROWBUFFER [op].handler!
  find: waitFinished_Start     EV_M_START     [op].handler!

  find: waitFinished_ChildExit EV_X_CHILDEXIT [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: waitFinished :: waitFinished ;

: waitFinished_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "waitFinished_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
