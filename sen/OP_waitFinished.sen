/*============================================================================*/
/* OP_waitFinished.sen -- Operator wait finished                              */
/*============================================================================*/

" OP_waitFinished.sen" .verbose

/*

  Counter0[] : tracks the number of EV_M_FINISHED expected
  
  Counter1[] : tracks the number of EV_M_FINISHED processed so far

*/

/*----------------------------------------------------------------------------*/
/* test                                                                       */
/*----------------------------------------------------------------------------*/
: waitFinished_mayProceed
  
  "waitFinished_test" .

  Counter1[] Counter0[] "waitFinished: expected %v processed %v" .printf
  
  Counter0[] not if
    false
    exit
  then
  
  Counter1[] Counter0[] == if
    true
  else
    false
  then
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_I_COUNT ...                                                 */
/*----------------------------------------------------------------------------*/
: waitFinished_Count \handler
  
  PipeIn[]\clear to InfoSet[]
  
  0 C_TDEF_COUNT InfoSet:getCol to Counter0[]
  
  Counter0[] [EvMgr].curEventNm@ "waitFinished: %v expecting %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: waitFinished_End \handler

  PipeIn[].delete

  waitFinished_mayProceed if
  
    [EvMgr].curEventNm@ "waitFinished: %v may proceed" .printf
    
    Marker[].newEndMarker
    Marker[].pipeOut
    true
    
  else
  
    [EvMgr].curEventNm@ "waitFinished: %v cannot proceed" .printf

    Marker[].newEndMarker
    Marker[].pipeOut
    true
    
  then
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_FINISHED_handler ...                                      */
/*----------------------------------------------------------------------------*/
: waitFinished_Finished \handler

  Counter1[] 1 + to Counter1[]
  
  PipeIn[].delete

  waitFinished_mayProceed if
  
    [EvMgr].curEventNm@ "waitFinished: %v may proceed" .printf
    
    Marker[].newEndMarker
    Marker[].pipeOut
    true
    
  else
  
    [EvMgr].curEventNm@ "waitFinished: %v cannot proceed" .printf

    Marker[].newEndMarker
    Marker[].pipeOut
    true
    
  then
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: waitFinished_Start \handler
  
  [EvMgr].curEventNm@ "waitFinished: %v" .printf
    
  0 to Counter0[] // tracks the number of EV_M_FINISHED expected
  0 to Counter1[] // tracks the number of EV_M_FINISHED processed so far

  EV_M_START_handler
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute wait op                                                            */
/*----------------------------------------------------------------------------*/
 : waitFinished_op \operator

  _lu_initialise_

  op__topology

  find: waitFinished_Count     EV_I_COUNT     [op].handler!
  find: waitFinished_End       EV_M_END       [op].handler!
  find: waitFinished_Finished  EV_M_FINISHED  [op].handler!
  find: waitFinished_Start     EV_M_START     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: waitFinished :: waitFinished ;

: waitFinished_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "waitFinished_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
