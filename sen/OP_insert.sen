/*============================================================================*/
/* OP_insert.sen -- Operator insert                                           */
/*============================================================================*/

" OP_insert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: insert_Cleaning \handler

  //"Operand:- ZK_M_CLEANING" .verbose

  // get the profile from the task
  //Task[] task.profile@ to Operand[]
  //nullptr Task[] task.profile!
  //Operand[].pipeOut

  Path[].popNamedTableFolder

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: insert_CrwBuffer \handler

  //"Operand:- ZK_D_CRWBUFFER" .verbose

  // insert the buffer into the table ptn
  TablePtn[].grabWrite_msecLoop
  PipeIn[] TablePtn[].appendBuffer
  TablePtn[].dropWrite

  // null the Pipein
  nullptr to PipeIn[]

  // increment no of buffers inserted
  Counter0[] 1 + to Counter0[]

  // send out an infoSet of ProgressUnits every 100 buffers
  Counter0[] 100 % 0 == if

    // create an infoSet operand
    infoSetTable[] InfoSet[].new

    // insert progressUnits to the infoset
    Counter0[] infoSetTable[] InfoSet[].addProgressUnits assert

    // pipeout the infoset
    InfoSet[].pipeOut

    // reset the counter
    0 to Counter0[]

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: insert_EosMarker \handler

  //"Operand:- ZK_M_EOS" .verbose

  // send out final progress units

  // create an infoSet operand
  infoSetTable[] InfoSet[].new

  // insert progressUnits to the infoset
  Counter0[] infoSetTable[] InfoSet[].addProgressUnits assert

  // pipeout the infoset
  InfoSet[].pipeOut

  PipeIn[].pipeOut

  true
  ;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: insert_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose
  //"Operand Insert:- ZK_M_START" .
  PipeIn[].pipeOut

  // create the infoSetTable for C_TDEF_PROGRESSUNITS
  C_TDEF_PROGRESSUNITS op__tableDef_infoSet assert

  // get Table[] to be inserted into
  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
    //Table[].tablePtnZero to TablePtn[] // hack by ray to simulate insert lock collision

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
/*
: insert_StreamDef \handler

  //"Operand:- ZK_D_STREAMDEF" .verbose
  PipeIn[].delete
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[].pipeOut
  
  true
;
*/

/*----------------------------------------------------------------------------*/
/* execute for insert                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : insert_op \operator
 
  _lu_initialise_
  // "OP_insert" .
  // init the counter to be used for progress
  0 to Counter0[]

  op__topology

  find: insert_Cleaning    ZK_M_CLEANING  op[].handler!
  find: insert_CrwBuffer   ZK_D_CRWBUFFER   op[].handler!
  find: insert_EosMarker   ZK_M_EOS   op[].handler!
  //find: insert_StreamDef   ZK_D_STREAMDEF   op[].handler!
  find: insert_StartMarker ZK_M_START op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: insert :: insert <tableNm> ;

: insert_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "insert_op"  <seedReq> = "insert_req"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
