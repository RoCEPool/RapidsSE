/*============================================================================*/
/* OP_insert.sen -- Operator insert                                           */
/*============================================================================*/

" OP_insert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: insert_Cleaning \handler

  //"Operand:- EV_M_CLEANING" .verbose

  // get the profile from the task
  //[task] task.profile@ to Operand[]
  //nullptr [task] task.profile!
  //Operand[].pipeOut

  Path[].popNamedTableFolder

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER / EV_D_ROWBUFFER ...                            */
/*----------------------------------------------------------------------------*/
: insert_DataBuffer \handler

  //"insert_DataBuffer" .

  0 locals| rowsInserted |

  // insert the buffer into the table ptn
  TablePtn[].grabWrite_msecLoop
  PipeIn[] TablePtn[].appendBuffer to rowsInserted
  TablePtn[].dropWrite

  // Accumulate the inserted row counts
  rowsInserted rowCounts[].addInserted

  // null the Pipein
  nullptr to PipeIn[]

  // increment no of buffers inserted
  Counter0[] 1 + to Counter0[]

  // send out an infoSet of ProgressUnits every 100 buffers
  Counter0[] 100 % 0 == if

    // create an infoSet operand
    infoSetTable[] InfoSet[].new

    // insert progressUnits to the infoset
    Counter0[] infoSetTable[] InfoSet[].addProgressUnits assert

    // pipeout the infoset
    InfoSet[].pipeOut

    // reset the counter
    0 to Counter0[]

  then

  true
;

/*----------------------------------------------------------------------------*/
/* replicated table handler for EV_D_CRWBUFFER / EV_D_ROWBUFFER ...           */
/*----------------------------------------------------------------------------*/
: insert_Replicated \handler

  "insert_Replicated" .

  0 locals| rowsInserted |

  // insert the buffer into the table ptn
  //TablePtn[].grabWrite_msecLoop
  PipeIn[] Table[].appendBuffer to rowsInserted
  //TablePtn[].dropWrite

  // Accumulate the inserted row counts if we are on the originating node only
  [grid].thisNodeId@ [job].originNodeId@ == if
    rowsInserted rowCounts[].addInserted
  then

  // null the Pipein
  nullptr to PipeIn[]

  // increment no of buffers inserted
  Counter0[] 1 + to Counter0[]

  // send out an infoSet of ProgressUnits every 100 buffers
  Counter0[] 10 % 0 == if

    // create an infoSet operand
    infoSetTable[] InfoSet[].new

    // insert progressUnits to the infoset
    Counter0[] infoSetTable[] InfoSet[].addProgressUnits assert

    // pipeout the infoset
    InfoSet[].pipeOut

    // reset the counter
    0 to Counter0[]

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: insert_EosMarker \handler

  //"Operand:- EV_M_EOS" .verbose

  // Cleanup any hashmap locks on crw/row buffers that this Task has
  // Currently we can't grabWrite_msecLoop on replicated tables
  Table[].isReplicated not if
    TablePtn[].grabWrite_msecLoop
      TablePtn[].cleanup
    TablePtn[].dropWrite
  then

  // send out final progress units

  // create an infoSet operand
  infoSetTable[] InfoSet[].new

  // insert progressUnits to the infoset
  Counter0[] infoSetTable[] InfoSet[].addProgressUnits assert

  // pipeout the infoset
  InfoSet[].pipeOut


  // send out an AFFECTEDROWS infoset with the number of rows actually inserted
  Table[].isReplicated not
  [grid].thisNodeId@ [job].originNodeId@ ==
  or if

    C_TDEF_AFFECTEDROWS op__tableDef_infoSet assert

    // create an infoSet operand
    infoSetTable[] InfoSet[].new
    OI_AFFECTEDROWS InfoSet[].opInfoset!

    // insert row counts to the infoset
    rowCounts[].getCounters@@ rowCounts[].numCounters InfoSet[].addRowVargs

    // pipeout the infoset
    InfoSet[].pipeOut
  then

  PipeIn[].pipeOut

  true
  ;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: insert_StartMarker \handler

  //"Operand:- EV_M_START" .verbose
  //"Operand Insert:- EV_M_START" .
  PipeIn[].pipeOut

  // create the infoSetTable for C_TDEF_PROGRESSUNITS
  C_TDEF_PROGRESSUNITS op__tableDef_infoSet assert

  // get Table[] to be inserted into
  <tableNm> op__table if

    // change handler for replicated cases
    Table[].isReplicated if
      find: insert_Replicated  EV_D_CRWBUFFER  [op].handler!
      find: insert_Replicated  EV_D_ROWBUFFER  [op].handler!
    else
      Table[].tablePtn@ to TablePtn[]
    then
    
  then

  rowCounts[].new

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: insert_StreamDef \handler

  //"Operand:- EV_D_STREAMDEF" .verbose
  PipeIn[].delete
  
  true
;

/*----------------------------------------------------------------------------*/
/* execute for insert                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : insert_op \operator
 
  _lu_initialise_
  // "OP_insert" .
  // init the counter to be used for progress
  0 to Counter0[]

  op__topology

  find: insert_Cleaning      EV_M_CLEANING     [op].handler!
  find: insert_DataBuffer    EV_D_CRWBUFFER    [op].handler!
  find: insert_EosMarker     EV_M_EOS          [op].handler!
  find: insert_DataBuffer    EV_D_ROWBUFFER    [op].handler!
  find: insert_StreamDef     EV_D_STREAMDEF    [op].handler!
  find: insert_StartMarker   EV_M_START        [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: insert :: insert <tableNm> ;

: insert_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "insert_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
