/*============================================================================*/
/* dp_eventDemon.sen -- Event Demon                                           */
/*============================================================================*/

" dp_eventDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* event demon                                                                */
/*----------------------------------------------------------------------------*/
: eventDemonPipeline

  "
    pipelineLocal eventDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | namedInsert
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
