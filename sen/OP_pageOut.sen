/*============================================================================*/
/* OP_pageOut.sen -- Page Out Operator                                        */
/*============================================================================*/

" OP_pageOut.sen" .verbose

/*----------------------------------------------------------------------------*/
/* put the pageout periodic activity here                                     */
/*----------------------------------------------------------------------------*/
: pageout::activity

  //"Page Out Activity" .

  PageOut::pageOutCheckLowMemory
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: pageout_StartMarker \handler

  "Page Out Demon Started" .boot

  begin

    pageout::activity
    2 thread::sleepSsec

  again
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: pageout_RowBuffer \handler

  Pipein[]\clear PageOut::pageOutPoolBuffer to RowBuffer[]

  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: pageout_CrwBuffer \handler

  Pipein[]\clear PageOut::pageOutCrwBuffer to CrwBuffer[]

  CrwBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for pageout req                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pageout_op \operator

  _lu_initialise_

  "<testTag>" [job].tagSet@ tagSet.hasName if
      <testTag> .
  then

  op__topology

  find: pageout_StartMarker EV_M_START              [op].handler!
  find: pageout_RowBuffer   EV_D_ROWBUFFER          [op].handler!
  find: pageout_CrwBuffer   EV_D_CRWBUFFER          [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: pageout :: pageout ;

: pageout_cmdTags _cmdTags tagCopy: op_tags
  tags{
    //<dedicatedThd> = 1
    <opEntry> = "pageout_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/