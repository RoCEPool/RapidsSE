/*============================================================================*/
/* OP_bucketGet.sen -- Operator bucket get                                    */
/*============================================================================*/

" OP_bucketGet.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: bucketGet_getBucket  \handler

  // pipe out ZK_STARTMARKER
  PipeIn[].pipeOut
  "bucketGet_getBucket" .
  //stk displays what in the stack
  // set the table name (and bucket number), in BucketGet instance
  // For now, we just say give me bucket(number) and then we get rowbuffer from it

  <TableNm> .

  <TableNm> bucketGet::getBucketOfTable locals| pBucket |

  // pipeout the pBucket instance
  pBucket Op[].pipeout

  true
  //stk
  //[task].breakpoint set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for bucketGet request                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: bucketGet_op \operator

  _lu_initialise_
  "bucketGet_req" .
  op__topology

  find: bucketGet_getBucket   ZK_M_DATAPULSE   op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: bucketGet :: bucketGet <TableNm> ;

: bucketGet_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "bucketGet_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
