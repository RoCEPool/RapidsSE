/*============================================================================*/
/* OP_listCatalogs.sen -- Operator list catalogs                              */
/*============================================================================*/

" OP_listCatalogs.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lscat_action

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the schemas folder
  folder[].checkIsCatalogs not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeOut

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in teh infoSet for each word

  folder[] dic.lastWord dup
  iterate                          // setup iteration of words
    object@ word.name@
    streamSetTable[] StreamSet[].addListContents not if
      StreamSet[].pipeOut
      streamSetTable[] streamSet[].new
      object@ word.name@
      streamSetTable[] StreamSet[].addListContents assert
    then
    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lscat :: lscat ;

: lscat _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listContents
    <params>      = 0
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
