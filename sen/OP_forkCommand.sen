/*============================================================================*/
/* OP_forkCommand.sen -- Operator fork command                                */
/*============================================================================*/

" OP_forkCommand.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_I_COMMAND ...                                               */
/*----------------------------------------------------------------------------*/
: forkCommand_Command \handler

  [EvMgr].curEventNm@ "%v" .printf
  
  0 0 locals| eError tForkedJobId |
  
  PipeIn[]\clear to InfoSet[]

  0 C_TDEF_COMMAND InfoSet:getCol locals| sForkCmd |

  sForkCmd "  forkCmd=%v" .printf

/*
  STD_NOWAIT_TAG sForkCmd api::forkChildOld if
    to tForkedJobId
    tForkedJobId "forkCommand: job %v" .printf
  else
    to eError
    eError ErrorCode::decodeError eError "forkCommand: error %v %v" .printf
  then
*/


  // spawn a job for the load
  STD_NORMALFORK_TAG sForkCmd api::forkChild not if
    //"Error Code %v" .printf
    op__execErr
    true
    exit
  else
    //[Op] [job].responseOp!
    <responseOpNm> [stream].findOp locals| pResponseOp |
    pResponseOp op.name@ "  responseOp=%v" .printf
    pResponseOp [job].responseOp!

    // set the new ENDMARKER handler
    //find: forkCommand_End       EV_M_END       [op].handler!
  then

  true
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute fork op                                                            */
/*----------------------------------------------------------------------------*/
 : forkCommand_op \operator

  _lu_initialise_

  op__topology

  find: forkCommand_Command  EV_I_COMMAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: forkCommand :: forkCommand <responseOpNm> ;

: forkCommand_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "forkCommand_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
