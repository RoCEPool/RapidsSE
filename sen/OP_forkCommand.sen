/*============================================================================*/
/* OP_forkCommand.sen -- Operator fork command                                */
/*============================================================================*/

" OP_forkCommand.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PDSROWBUFFER ...                                          */
/*----------------------------------------------------------------------------*/
: forkCommand_PdsRowBuffer \handler

  0 0 locals| eError tForkedJobId |

  // handle BT_COMMAND only
  PipeIn[].bufferType@ BT_COMMAND != if
    Pipein[].pipeout
    true
    exit
  then

  PipeIn[]\clear to Pds[]

  // get the command to be forked and any tags to be used
  //0 C_TDEF_COMMAND InfoSet:getCol locals| sForkCmd |
  //1 C_TDEF_COMMAND InfoSet:getCol locals| sTags |

  Pds[].firstRow to Row[]
  0 Row[].getVchColumn locals| sForkCmd |
  1 Row[].getVchColumn locals| sTags |

  Pds[].delete

  //sForkCmd "  forkCmd=%v" .printf

  // set the responseOp for the responses coming from the forked child
  <responseOpNm> [stream].findOp locals| pResponseOp |
  pResponseOp [job].responseOp!

  // Combine the STD_NORMALFORK_TAGs with the sTags from the infoset
  sTags STD_NORMALFORK_TAG "%v %v" str.format locals| sForkTags |

//  sForkTags "  sForkTags=%v" .printf
//  sForkCmd  "  sForkCmd=%v" .printf
//  debug::breakpoint

  // fork a child job for the command
  sForkTags sForkCmd nullptr api::forkChild not if
    nullptr [job].responseOp!
    op__execErr
    true
    exit
  then

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute fork op                                                            */
/*----------------------------------------------------------------------------*/
 : forkCommand_op \operator

  _lu_initialise_

  op__topology

  find: forkCommand_PdsRowbuffer  EV_D_PDSRowBuffer   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: forkCommand :: forkCommand <responseOpNm> ;

: forkCommand_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "forkCommand_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
