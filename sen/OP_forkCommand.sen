/*============================================================================*/
/* OP_forkCommand.sen -- Operator fork command                                */
/*============================================================================*/

" OP_forkCommand.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_I_COMMAND ...                                               */
/*----------------------------------------------------------------------------*/
: forkCommand_Command \handler

  [EvMgr].curEventNm@ "forkCommand: %v" .printf
  
  
  PipeIn[]\clear to InfoSet[]

  0 C_TDEF_COMMAND InfoSet:getCol locals| sCmd |

  sCmd "forkCommand: cmd %v" .printf


  <responseOpNm> [stream].findOp locals| pResponseOp |
  
  pResponseOp op.name@ "forkCommand: responseOp %v" .printf
  
  //pResponseOp "some-pipeline" api::forkCommand assert

  true
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute fork op                                                            */
/*----------------------------------------------------------------------------*/
 : forkCommand_op \operator

  _lu_initialise_

  op__topology

  find: forkCommand_Command  ZK_I_COMMAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: forkCommand :: forkCommand dynamic <responseOpNm> ;

: forkCommand_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "forkCommand_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
