/*============================================================================*/
/* OP_compactIndexPtn.sen -- Operator compact partition of index              */
/*============================================================================*/

" OP_compactIndexPtn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: CompactIndexPtn_DataMarker \handler


  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // compact the index
  Index[].compactPtn

  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: CompactIndexPtn_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  // check if we can scan the table
  <tableNm> <indexNm> op__table_index if
    PipeIn[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for compactIndex req                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : CompactIndexPtn::geb \operator

  _lu_initialise_

  op__topology

  find: CompactIndexPtn_DataMarker ZK_M_DATAPULSE op[].handler!
  find: CompactIndexPtn_StartMarker ZK_M_START op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: compactIndexPtn :: compactIndexPtn <tableNm> <indexNm> ;

: compactIndexPtn_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
