/*============================================================================*/
/* OP_noop.sen -- Operator no op                                              */
/*============================================================================*/

" OP_noop.sen" .verbose

/*----------------------------------------------------------------------------*/
/* noop request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: noop_req \operator

  LogReqEntry SEED_REQ

  op__topology

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: noop :: noop ;

: noop _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
