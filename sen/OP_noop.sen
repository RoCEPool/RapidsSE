/*============================================================================*/
/* OP_noop.sen -- Operator no op                                              */
/*============================================================================*/

" OP_noop.sen" .verbose

/*----------------------------------------------------------------------------*/
/* noop request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: noop_op \operator

  _lu_initialise_

  op__topology

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: noop :: noop ;

: noop_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
