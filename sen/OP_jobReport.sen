/*============================================================================*/
/* OP_jobReport.sen -- Operator job report given jobId                      */
/*============================================================================*/

" OP_jobReport.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: jobReport_action

  [job].masterJobId jobId::lastJobId@ "Last Job Id %v" .printf

  <jobno> >int locals| iJob |
  
  iJob not if
    [job].masterJobId jobId::lastJobId@ to iJob
  then

  0 locals| eError |

  //"__eventDemon" find dup if
  //  word.object@ locals| pEventDemon |

  AM::DEMON::tEventDemonJobId@ locals| tEventDemonJobId |

  tEventDemonJobId jobId::isUnknown if
    "Cant find __eventDemon" .
    true
    exit
  then

  Tub[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // metrics
  
  Tub[] iJob jobReport::metrics to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // network
  
  Tub[] iJob jobReport::network to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // network dissect
  
  Tub[] iJob jobReport::netDissect to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // operators

  Tub[] iJob jobReport::operators to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // operands
  
  Tub[] iJob jobReport::operands to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  Tub[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobReport :: jobReport <jobNo> ;

: jobReport_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "jobReport_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
