/*============================================================================*/
/* OP_jobReport.sen -- Operator job report                                    */
/*============================================================================*/

" OP_jobReport.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: jobReport_action

  0 locals| eError |

  Tub[].new

  Tub[] <jobno> >int jobReport::report to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  "__eventDemon" find dup if
    word.object@ locals| eventDemon |

    // pipe out completed buffers to event demon
    begin
      Tub[].completed to DataBuffer[]
      DataBuffer[].isNotNull
    while
      DataBuffer[] eventDemon pipeline.pipeout
    repeat

    // pipe out remainder of the buffers to event demon
    begin
      Tub[].dangling to DataBuffer[]
      DataBuffer[].isNotNull
    while
      DataBuffer[] eventDemon pipeline.pipeout
    repeat

  else

    discard discard

    // pipe out completed buffers to event demon
    begin
      Tub[].completed to DataBuffer[]
      DataBuffer[].isNotNull
    while
      DataBuffer[].delete
    repeat

    // pipe out remainder of the buffers to event demon
    begin
      Tub[].dangling to DataBuffer[]
      DataBuffer[].isNotNull
    while
      DataBuffer[].delete
    repeat

    Tub[].delete

  then

  Tub[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobReport :: jobReport <jobNo> ;

: jobReport_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "jobReport_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
