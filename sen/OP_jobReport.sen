/*============================================================================*/
/* OP_jobReport.sen -- Operator job report                                    */
/*============================================================================*/

" OP_jobReport.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_JOB ...                                                   */
/*----------------------------------------------------------------------------*/
: jobReport_Job

  0 locals| eError |

  Tub[].new

  Pipein[]\clear jobReport::reportJob to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  "__eventDemon" find dup if
    word.object@ locals| eventDemon |

    eventDemon Tub[].pipeToJob

  else

    discard

    // delete all buffers in the TUB
    Tub[].deleteAllBuffers

  then

  Tub[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* execute for jobReport req                                            SPAWN */
/*----------------------------------------------------------------------------*/
 : jobReport_op \operator

  _lu_initialise_

  op__topology

  find: jobReport_Job  ZK_D_JOB op[].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobReport :: jobReport ;

: jobReport_cmdTags _cmdTags tagCopy: Op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "jobReport_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
