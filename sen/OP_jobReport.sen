/*============================================================================*/
/* OP_jobReport.sen -- Operator job report                                    */
/*============================================================================*/

" OP_jobReport.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: jobReport_action

  0 locals| eError |

  Tub[].new

  Tub[] <jobno> >int jobReport::report to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  "__eventDemon" find dup if
    word.object@ locals| eventDemon |

    eventDemon Tub[].pipeToJob

  else

    discard

    // delete all buffers in the TUB
    Tub[].deleteAllBuffers

  then

  Tub[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobReport :: jobReport <jobNo> ;

: jobReport_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "jobReport_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
