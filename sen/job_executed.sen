/*============================================================================*/
/* job_executed.sen -- executed 2pc job (pipeline coordination)               */
/*============================================================================*/

" job_executed.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job_Executed back to originating node                                 */
/*----------------------------------------------------------------------------*/
: executed::replyToOrigin ( pJobParticipant -- )

  params| pJobParticipant |

  pJobParticipant job.id@ locals| iJobId |

  0 0 0 locals| pJob pJob_Executed error |

  // new a temporary Job_Executed
  pJobParticipant job_Executed::new to pJob_Executed

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send the executed job
  iJobId job::originator@ pJob_Executed job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_Executed job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job_Executed on originating node    recv: job.spawn */
/*----------------------------------------------------------------------------*/
: executed::executed

  Job[] locals| pJob_Executed |
  pJob_Executed job.id@ locals| iJobId |

  0 0 0 locals| iParticipantNode error bAmDecider |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the context of this __executed job

  // find the originating job
  iJobId olist::findJob discard

  // get the participant node from where this job_begun started
  pJob_Executed job.participantNode@ to iParticipantNode

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // process __executed job on this originating node

  // increment the number of __executed jobs received in api state
  JobRef[] ssn::incExecuted
  JobRef[] ssn::traceSession

  // decrement the acks remaining
  JobRef[] job.dec2pcAcksRmg to bAmDecider

  //[grid].thisNodeName@ "(%v) EXECUTED GOT ACK" .printf

  // if there are acks remaining just exit
  bAmDecider not if
    JobRef[].returnReference
    [job]:retire
    exit                                                         // *EARLY EXIT*
  then
  //[grid].thisNodeName@ "(%v) EXECUTED AM DECIDER" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // all __executed jobs have been received, so this job is the decider

  [job].tscExecuted

  // send a job_end to all participants
  JobRef[] end::distribute
  JobRef[].returnReference

  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: executed :: executed ;

: executed_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "executed::executed"
    <path>     = "/"
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
