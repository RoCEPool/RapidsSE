/*============================================================================*/
/* job_executed.sen -- executed 2pc job (pipeline coordination)               */
/*============================================================================*/

" job_executed.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job_Executed back to originating node                                 */
/*----------------------------------------------------------------------------*/
: executed:reply params| pJobParticipant |

  // "executed:reply" .
    
  // new a temporary Job_Executed
  pJobParticipant job_Executed::new locals| pJob_Executed |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send the executed job
  pJobParticipant [job].originNodeNo@ pJob_Executed job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_Executed job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job_Executed on originating node              recv: job.spawn */
/*----------------------------------------------------------------------------*/
: executed:executed

  // find the originating job
  [job] job.id@ ListedJob[].findOriginator discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // process __begun job on this originating node

  // increment the number of __executed jobs received in api state
  ListedJob[] ssn::incExecuted
  ListedJob[] ssn::traceSession

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // decrement the acks remaining in the originating job
  ListedJob[] job.dec2pcAcksRmg locals| bAmDecider |

  // if there are acks remaining just exit
  bAmDecider if

    [job].tscBegun

    // notify the originating task
    ListedJob[].task@ task.ack
    ListedJob[].returnReference

  then

  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: executed :: executed ;

: executed_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "executed:executed"
    <path>     = "/"
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
