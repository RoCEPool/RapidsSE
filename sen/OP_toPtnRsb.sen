/*============================================================================*/
/* OP_toPtnRsb.sen -- Convert row buffers to partitioned row slab buffers     */
/*============================================================================*/

" OP_toPtnRsb.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toPtnRsb_StartMarker \handler

  ToPtnRsb[].create

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: toPtnRsb_DataMarker \handler

  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toPtnRsb_RsbBuffer \handler

  // check for low memory
  attachMap::isLowMemory if
    EC_LOW_MEMORY
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  PipeIn[] ToPtnRsb[].convert
  nullptr to Pipein[]

  grid::partitions 0
  do

    I ToPtnRsb[].completed to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].pipeOut
      I ToPtnRsb[].completed to OperandB[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toPtnRsb_EosMarker \handler

  grid::partitions 0
  do

    I ToPtnRsb[].dangling to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].pipeOut
      I ToPtnRsb[].dangling to OperandB[]
    repeat

  loop

  ToPtnRsb[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRsb request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toPtnRsb_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toPtnRsb_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toPtnRsb_DataMarker ZK_DATAPULSE op[].handler!
  find: toPtnRsb_RsbBuffer   ZK_ROWBUFFER   op[].handler!
  find: toPtnRsb_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toPtnRsb :: toPtnRsb ;

: toPtnRsb _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
