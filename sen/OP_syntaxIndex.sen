/*============================================================================*/
/* OP_syntaxIndex.sen -- Operator syntax index                                */
/*============================================================================*/

" OP_syntaxIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> . <indexNm> is a creatable index                        */
/*----------------------------------------------------------------------------*/
: syntaxIndex::checkCreate ( sTableNm --  true | errorCode false )

  params| sTableNm |

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then

  // check there is a sub-folder by the name of the table
  //   ../schemas/public/tables/t
  sTableNm check::folderHasNamedTable not if false exit then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if max indexes already on table

  // push into t: ../schemas/public/tables/t \folder
  sTableNm Path[].pushNamedTableFolder

  // check max indexes
  sTableNm find execute to Table[]
  Table[] table.indexCount C_MAX_INDEXES == if
    EC_MAX_INDEXES
    Path[].popNamedTableFolder
    Folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check name doesn't already exist

  // push into indexes: ../schemas/public/tables/t/indexes
  Path[].pushIndexesFolder
  Folder[].isIndexes assert

  // error if given name already exists
  <indexNm> check::nameIsUnknownIndex not if
    Path[].popIndexesFolder
    Path[].popNamedTableFolder
    Folder[].isTables assert
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop upto tables: ../schemas/public/tables

  Path[].popIndexesFolder
  Path[].popNamedTableFolder
  Folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: syntaxIndex_DataMarker

  0 0 0 locals| sTableNm sSmt errorCode |

  //[job].tagSet@ tagSet.asStr .
  Pipein[].pipeout

  // is it a unique index ?
  "<unique>" [job].tagSet@ tagSet.hasName if
    <etc> <indexNm> "create unique index %v %v ;" str.format to sSmt
  else
    <etc> <indexNm> "create index %v %v ;" str.format to sSmt
  then

  // sSmt .

  // parse the smt and get the table name
  sSmt Job[] indexDef::parseTableName to sTableNm
  [job].error@ to errorCode
  sTableNm "" str.equal if
    [job].error@ to errorCode
    errorCode op__execErr
    true
    exit
  then

  // check ok to create index
  sTableNm syntaxIndex::checkCreate not if ( errorCode )
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  sSmt Table[] Job[] indexDef::parse to IndexDef[]

  IndexDef[].isNull if
    [job].error@ to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in tables
  Folder[].isTables assert

  IndexDef[].pipeout

  // should be in tables
  Folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute for syntaxTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: syntaxIndex_op \operator

  _lu_initialise_

  op__topology

  find: syntaxIndex_DataMarker ZK_M_DATAPULSE op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: syntaxIndex :: syntaxIndex <indexNm> <etc> ;

: syntaxIndex_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "syntaxIndex_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
