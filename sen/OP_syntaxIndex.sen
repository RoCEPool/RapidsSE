/*============================================================================*/
/* OP_syntaxIndex.sen -- Operator syntax index                                */
/*============================================================================*/

" OP_syntaxIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> . <indexNm> is a creatable index                        */
/*----------------------------------------------------------------------------*/
: syntaxIndex::checkCreate ( sTableNm --  true | errorCode false )

  params| sTableNm |

  0 locals| pMetaDataTableIndexes |

  // check index name is valid
  <indexNm> check::nameIsValidIndex not if false exit then

  // check if table exists
  sTableNm MetaDataTable[].find to Table[]
  Table[] not if
    EC_NO_SUCH_TABLE
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if max indexes already on table

  // check max indexes
  Table[] table.indexCount C_MAX_INDEXES == if
    EC_MAX_INDEXES
    false exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check index doesn't already exist

  // search for <indexNm, TableNm> row in Index metadata table
  // if exists, return error

  MdTable[].indexes 2 sTableNm 3 <indexNm> MetaDataTable[].findRow if
    EC_INDEX_EXISTS
    false exit
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: syntaxIndex_DataMarker

  0 0 0 locals| sTableNm sSmt errorCode |

  //[job].tagSet@ tagSet.asStr .
  Pipein[].pipeout

  // is it a unique index ?
  "<unique>" [job].tagSet@ tagSet.hasName if
    <etc> <indexNm> "create unique index %v %v ;" str.format to sSmt
  else
    <etc> <indexNm> "create index %v %v ;" str.format to sSmt
  then

  // sSmt .

  // parse the smt and get the table name
  sSmt indexDef::parseTableName not if ( errorCode )
    to errorCode
    errorCode op__execErr
    true
    exit
  else
    to sTableNm
  then

  // check ok to create index
  sTableNm syntaxIndex::checkCreate not if ( errorCode )
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  sSmt Table[] indexDef::parse not if ( errorCode )
    to errorCode
    errorCode op__execErr
    true
    exit
  else
    to indexDef[]
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  IndexDef[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for syntaxTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: syntaxIndex_op \operator

  _lu_initialise_

  op__topology

  find: syntaxIndex_DataMarker EV_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: syntaxIndex :: syntaxIndex <indexNm> <etc> ;

: syntaxIndex_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "syntaxIndex_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
