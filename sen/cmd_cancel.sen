/*============================================================================*/
/* cmd_cancel.sen -- 1sc: given pipeline is to cancel on participant          */
/*============================================================================*/

" cmd_cancel.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: cancel:onParticipant
  //"cancel:onParticipant" .

/* >can ptp */  [args].distJob if
/* >can ptp */    "cancel" "onParticipant" ">can ptp cancel" "r" [job].trace
/* >can ptp */  then
/* >can ptp */
/* >can ptp */  // find job to be canceled in participating job list
/* >can ptp */  [job].distId@ ListedJob[].findParticipant? if
/* >can ptp */
/* >can ptp */    // stall till job's previous phase (task) has completed
/* >can ptp */    begin
/* >can ptp */      ListedJob[].taskState@ TS_HIBERNATING !=
/* >can ptp */    while
/* >can ptp */      "job to be cancelled still has non-hibernating task" .
/* >can ptp */      [task].yield
/* >can ptp */    repeat
/* >can ptp */    ListedJob[].cycleTaskLock
/* >can ptp */
/* >can ptp */    // execute the job on this participating node
/* >can ptp */    ListedJob[].scheduleNextPhase
/* >can ptp */
/* >can ptp */    ListedJob[].returnReference
/* >can ptp */
/* >can ptp */  then
/* >can ptp */
/* >can ptp */  [job]:retireAndExit
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON ORIGINATING NODE OF GIVEN PIPELINE                      */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on origin node                                                             */
/*----------------------------------------------------------------------------*/
: cancel:cancel
  //"cancel:cancel" .

/* >can org */  [args].distJob if
/* >can org */    "cancel" "cancel" ">can org brd all ptp" "r" [job].trace
/* >can org */  then
/* >can org */
/* >can org */
/* >can org */  "cancel:onParticipant" [job].entryPoint!
/* >can org */
/* >can org */  [job]:broadcast
/* >can org */
/* >can org */  [job]:retireAndExit
/* >can org */  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: cancel :: cancel ;

: cancel_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "cancel:cancel"
    <path>     = "/"
  }
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
