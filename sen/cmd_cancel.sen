/*============================================================================*/
/* cmd_cancel.sen -- 1sc: given pipeline is to cancel on participant          */
/*============================================================================*/

" cmd_cancel.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* run received Job_Cancel on participating node                              */
/*----------------------------------------------------------------------------*/
: cancel:cancel

  // "cancel:cancel" .

  // find job to be canceled in participating job list
  [job].parentId@ ListedJob[].findParticipant discard

  // stall till job's previous phase (task) has completed
  begin
    ListedJob[].task@ task.state@ TS_HIBERNATING !=
  while
    "job to be cancelled still has non-hibernating task" .
    [task].yield
  repeat
  ListedJob[].task@ task.cycleLock
    
  // execute the job on this participating node
  "pipeline:cancel" ListedJob[] job.entry!
  ListedJob[] job.scheduleNextPhase
  
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: cancel :: cancel ;

: cancel_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "cancel:cancel"
    <path>     = "/"
  }
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
