/*============================================================================*/
/* dp_connectorWL.sen -- Connector Demon for WL Adaptor                       */
/*============================================================================*/

" dp_connectorWL.sen" .verbose


/*----------------------------------------------------------------------------*/
/* pipeline/procedure text for connector demon                                */
/*----------------------------------------------------------------------------*/
procText:
  pipelineLocal connectorWL_procText
    tag "<pre_execute>" = "demon::install" endTag
  begin

    stage stageA on origin :
        start
      | connectWL
      | eatAll
      | stageA

  end
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/