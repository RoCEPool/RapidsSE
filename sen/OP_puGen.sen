/*============================================================================*/
/* OP_puGen.sen -- genrate row buffers for a pu table                         */
/*============================================================================*/

" OP_puGen.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: puGen_DataPulse \handler

  ": puGen_DataPulse" .

  // pipeout the (DataPulse)
  PipeIn[].pipeOut


  1 locals| iNextKey |
  begin
    iNextKey Table[].streamDef@ ToRow[] puGen::x to iNextKey
  iNextKey while
  
    // test for any completed
    ToRow[].completed to RowBuffer[]
    begin
      RowBuffer[].isNull not
    while
      RowBuffer[].pipeOut
      ToRow[].completed to RowBuffer[]
    repeat

    RowBuffer[].isNull assert

  repeat


  // test for any dangling
  ToRow[].dangling to RowBuffer[]
  begin
    RowBuffer[].isNull not
  while
    RowBuffer[].pipeOut
    ToRow[].dangling to RowBuffer[]
  repeat
  
  RowBuffer[].isNull assert

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                            */
/*----------------------------------------------------------------------------*/
: puGen_EosMarker \handler

  ": puGen_EosMarker" .
  
  // test for any remainders
  ToRow[].dangling to RowBuffer[]
  begin
    RowBuffer[].isNull not
  while
    RowBuffer[].pipeOut
    ToRow[].dangling to RowBuffer[]
  repeat


  // -- -- -- -- -- --
  // pipeout load results
  
  infoSetTable[] InfoSet[].new
  OI_LOADRESULT InfoSet[].opInfoset!
  
  ToRow[].rowCounters@@ 3 InfoSet[].addRowVargs

  InfoSet[].pipeOut


  // -- -- -- -- -- --

  // delete ToRow
  ToRow[].delete

  // pipeout the (EosMarker)
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                          */
/*----------------------------------------------------------------------------*/
: puGen_StartMarker \handler

  ": puGen_StartMarker" .
  
  // pipeout the (StartMarker)
  PipeIn[].pipeOut

  // test and create Table[] using <tableNm>
  <tableNm> op__table if

    // create a ToRow using Table[].streamDef
    ToRow[].create

    // new SteamDefOut and pipe out
    Table[] StreamDefOut[].newFromTable
    StreamDefOut[].pipeOut

  then

  // find the __loadResult table def
  //C_TDEF_LOADRESULT op__tableDef_infoSet assert

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* puGen request                                                              */
/*----------------------------------------------------------------------------*/
: puGen_req \operator

  _lu_initialise_

  op__topology

  find: puGen_DataPulse   ZK_M_DATAPULSE op[].handler!
  find: puGen_EosMarker   ZK_M_EOS       op[].handler!
  find: puGen_StartMarker ZK_M_START     op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: puGen :: puGen <tableNm> ;

: puGen_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
