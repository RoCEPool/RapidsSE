/*============================================================================*/
/* OP_aggreg.sen -- Operator aggreg columns                                   */
/*============================================================================*/

" OP_aggreg.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on EV_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: aggreg_Cleaning \handler

  0 EV_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // Need to hold on to the streamDef's till the combined op
  // has created the stencil

  // will be null if table not found
  StreamDefLft[].isNull not if
    StreamDefLft[].delete
  then

  StreamDefOut[].isNull not if
    StreamDefOut[].delete
  then

  IndexDef[].isNull not if
    IndexDef[].delete
  then

  EV_M_CLEANING EG_ZK PD_PIPE_OUT 0 EV_M_CLEANING EG_ZK LogicUnit[].diaryAction

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: aggreg_StreamDef \handler

  0 EV_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // create an indexDef[]
  indexDef[].new

  // generate streamDefOut from expr and streamDefIn
  <expr> indexDef[] StreamDefLft[] StreamDefOut[].generate to eError

  // check for error
  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  StreamDefOut[].duplicate to Pipein[]
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: aggreg_op \operator

  _lu_initialise_

  op__topology

  find: aggreg_Cleaning   EV_M_CLEANING      [op].handler!
  find: aggreg_StreamDef  EV_D_STREAMDEF     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: aggreg :: aggreg <expr> ;

: aggreg_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "aggreg_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
