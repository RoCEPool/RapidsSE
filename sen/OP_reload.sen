/*============================================================================*/
/* OP_reload.sen -- reload                                                    */
/*============================================================================*/

" OP_reload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: reload_StartMarker \handler

  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: reload_DataPulse \handler

  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_CSVBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: reload_CsvBuffer \handler

  EV_D_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: reload_EosMarker \handler

  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* reload request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: reload_op \operator

  _lu_initialise_

  op__topology

  find: reload_CsvBuffer   EV_D_CSVBUFFER   [op].handler!
  find: reload_EosMarker   EV_M_EOS         [op].handler!
  find: reload_DataPulse   EV_M_DATAPULSE   [op].handler!
  find: reload_StartMarker EV_M_START       [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: reload :: reload ;

: reload_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "reload_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
