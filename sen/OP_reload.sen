/*============================================================================*/
/* OP_reload.sen -- reload                                                    */
/*============================================================================*/

" OP_reload.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: reload_StartMarker \handler

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: reload_DataPulse \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CSVBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: reload_CsvBuffer \handler

  ZK_D_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: reload_EosMarker \handler

  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* reload request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: reload_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: reload_CsvBuffer   ZK_D_CSVBUFFER   op[].handler!
  find: reload_EosMarker   ZK_M_EOS         op[].handler!
  find: reload_DataPulse   ZK_M_DATAPULSE   op[].handler!
  find: reload_StartMarker ZK_M_START       op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: reload :: reload ;

: reload_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
