/*============================================================================*/
/* OP_jobOperators.sen -- Operator job operators                              */
/*============================================================================*/

" OP_jobOperators.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: jobOperators_action

  [session].lastJobId "Last Job Id %v" .printf

  <jobno> >int locals| iJob |
  
  iJob not if
    [session].lastJobId to iJob
  then

  0 locals| eError |

  "__eventDemon" find dup if
    word.object@ locals| pEventDemon |
  else
    "Cant find __eventDemon" .
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  Tub[].new

  Tub[] iJob jobReport::operators to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  pEventDemon Tub[].pipeToJob

  Tub[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  Tub[].new

  Tub[] iJob jobReport::operands to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  pEventDemon Tub[].pipeToJob

  Tub[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobOperators :: jobOperators <jobNo> ;

: jobOperators_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "jobOperators_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
