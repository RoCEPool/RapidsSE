/*============================================================================*/
/* OP_sysOpen.sen -- open the system                                          */
/*============================================================================*/

" OP_sysOpen.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: sysOpen_sysOpen \handler

  true system::open!
  
  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* sysOpen request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sysOpen_req \operator

  _lu_initialise_

  op__topology

  find: sysOpen_sysOpen  ZK_M_DATAPULSE  op[].handler!

  op__loop

  // "*** sysOpen_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sysOpen :: sysOpen ;

: sysOpen_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
