/*============================================================================*/
/* OP_jobReportId.sen -- Operator job report given jobId                      */
/*============================================================================*/

" OP_jobReportId.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: jobReportId_action

  0 locals| eError |

  Tub[].new

  Tub[] <jobno> >int jobReport::reportJobId to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  "__eventDemon" find dup if
    word.object@ locals| eventDemon |

    eventDemon Tub[].pipeToJob

  else

    discard

    // delete all buffers in the TUB
    Tub[].deleteAllBuffers

  then

  Tub[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobReportId :: jobReportId <jobNo> ;

: jobReportId_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "jobReportId_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
