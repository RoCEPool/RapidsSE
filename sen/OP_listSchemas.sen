/*============================================================================*/
/* OP_listSchemas.sen -- Operator list schemas                                      */
/*============================================================================*/

" OP_listSchemas.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lssch_action

  0 locals| errorCode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the schemas folder
  Folder[].checkIsSchemas not if
    to errorCode
    errorCode op__execErr
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in teh infoSet for each word

  Folder[] dic.lastWord dup
  iterate                          // setup iteration of words
    object@ word.name@
    streamSetTable[] StreamSet[].addListContents  not if
      StreamSet[].pipeOut
      streamSetTable[] streamSet[].new
      object@ word.name@
      streamSetTable[] StreamSet[].addListContents assert
    then

    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lssch :: lssch ;

: lssch_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listContents
    <params>      = 0
    <seedReq>     = "lssch_req"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
