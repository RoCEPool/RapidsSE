/*============================================================================*/
/* OP_listSchemas.sen -- Operator list schemas                                 */
/*============================================================================*/

" OP_listSchemas.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lssch_action

  0 locals| errorCode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in the schemas folder
  Folder[].checkIsSchemas not if
    to errorCode
    errorCode op__execErr
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an rowBuffer operand
  TableDef[] RowBuffer[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in teh infoSet for each word

  Folder[] dic.lastWord dup
  iterate                          // setup iteration of words
    object@ word.name@
    TableDef[] RowBuffer[].addListContents  not if
      RowBuffer[].pipeOut
      TableDef[] RowBuffer[].new
      object@ word.name@
      TableDef[] RowBuffer[].addListContents assert
    then

    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the infoset
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lssch :: lssch ;

: lssch_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listContents
    <params>      = 0

    <opEntry> = "lssch_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
