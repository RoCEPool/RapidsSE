/*============================================================================*/
/* OP_exprValidate.sen -- Expression Validate Op (SQL Compiler)               */
/*============================================================================*/

" OP_exprValidate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANUP ...                                           */
/*----------------------------------------------------------------------------*/
: exprValidate_CleanupMarker \handler

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: exprValidate_PlanOperand \handler

PipeIn[]\clear to Operand[]

  // create the command error info set
  op__cmdErrInfoSet

  Operand[] nullptr to Operand[] sqlCompiler::exprValidate to Operand[]

  "exprValidate" compiler_planOperand
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: exprValidate_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker  ZK_LEAVEMARKER op[].handler!
  find: compiler_StreamSet    ZK_D_STREAMSET   op[].handler!

  // specific handlers
  find: exprValidate_CleanupMarker ZK_M_CLEANUP op[].handler!
  find: exprValidate_PlanOperand   ZK_D_PLANOPERAND   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exprValidate :: exprValidate ;

: exprValidate_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
