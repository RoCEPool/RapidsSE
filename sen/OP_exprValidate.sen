/*============================================================================*/
/* OP_exprValidate.sen -- Expression Validate Op (SQL Compiler)               */
/*============================================================================*/

" OP_exprValidate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: exprValidate_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: exprValidate_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCompileErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::exprValidate to PlanOperand[]

  "exprValidate" compiler_planOperand
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: exprValidate_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker  EV_M_LEAVE       [op].handler!
  find: compiler_StreamSet    EV_D_STREAMSET   [op].handler!

  // specific handlers
  find: exprValidate_Cleaning      EV_M_CLEANING      [op].handler!
  find: exprValidate_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exprValidate :: exprValidate ;

: exprValidate_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "exprValidate_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
