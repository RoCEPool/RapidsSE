/*============================================================================*/
/* OP_exprValidate.sen -- Expression Validate Op (SQL Compiler)               */
/*============================================================================*/

" OP_exprValidate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: exprValidate_CancelMarker \handler

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: exprValidate_DataMarker \handler
 
  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: exprValidate_EosMarker \handler
 
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITEARLYMARKER ...                                         */
/*----------------------------------------------------------------------------*/
: exprValidate_ExitEarlyMarker \handler

  // save the pipein in streamSet[]
  StreamSet[].isNull not assert
  StreamSet[].pipeout

  ZK_EXITEARLYMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: exprValidate_PlanOperand \handler
 
  PipeIn[]\clear to Operand[]

  // create the command error info set
  op__cmdErrInfoSet

  Operand[] nullptr to Operand[] sqlCompiler::exprValidate to Operand[]

  Operand[].isNull if
    InfoSet[].pipeOut
    Pipein[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // no error, delete the infoset
  InfoSet[].delete

  // do we need to generate explain ?
  Operand[] "exprValidate" sqlCompiler::explain if

     // pipeout explain
     StreamSet[].pipeout

     LogicUnit[].compilerToExit if
       Operand[].delete
       Operand[].newExitEarlyMarker
       Operand[].pipeout
       true
       exit
     then

  else
    // pipeout explain
    StreamSet[].pipeout
  then

  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: exprValidate_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMSET ...                                               */
/*----------------------------------------------------------------------------*/
: exprValidate_StreamSet \handler

  // save the pipein in streamSet[]
  Pipein[]\clear to StreamSet[]

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: exprValidate_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: exprValidate_CancelMarker ZK_CANCELMARKER op[].handler!
  find: exprValidate_DataMarker   ZK_DATAPULSE    op[].handler!
  find: exprValidate_EosMarker    ZK_EOSMARKER    op[].handler!
  find: exprValidate_ExitEarlyMarker ZK_EXITEARLYMARKER op[].handler!
  find: exprValidate_PlanOperand  ZK_PLANOPERAND  op[].handler!
  find: exprValidate_StartMarker  ZK_STARTMARKER  op[].handler!
  find: exprValidate_StreamSet    ZK_STREAMSET    op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exprValidate :: exprValidate ;

: exprValidate_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
