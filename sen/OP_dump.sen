/*============================================================================*/
/* OP_dump.sen -- Operator dump                                               */
/*============================================================================*/

" OP_dump.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_CRWBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: dump_CrwBuffer \handler

  <operand> "crwBuffer" str.same if
    "OPERAND DUMP: crwBuffer" .

    <detail> >int PipeIn[] crwBuffer.operandDump
  then

  EV_D_CRWBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_CSVBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: dump_CsvBuffer \handler

  <operand> "csvBuffer" str.same if
    "OPERAND DUMP: csvBuffer" .printf

    <detail> >int PipeIn[] csvBuffer.operandDump
  then

  EV_D_CSVBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER ...                                                        */
/*----------------------------------------------------------------------------*/
: dump_RowBuffer \handler

  <operand> "rowBuffer" str.same if
    "OPERAND DUMP: rowBuffer" .

    <detail> >int PipeIn[] rowBuffer.operandDump
  then

  EV_D_ROWBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_I_SEEKOFFSETS ...                                                      */
/*----------------------------------------------------------------------------*/
: dump_SeekOffsets \handler

  <operand> "seekOffsets" str.same if
    "OPERAND DUMP: seekOffsets" .printf

    <detail> >int PipeIn[] seekOffsets.operandDump
  then

  EV_I_SEEKOFFSETS_handler
;

/*----------------------------------------------------------------------------*/
/* dump request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dump_op \operator

  _lu_initialise_

  op__topology

  find: dump_CrwBuffer   EV_D_CRWBUFFER   [op].handler!
  find: dump_CsvBuffer   EV_D_CSVBUFFER   [op].handler!
  find: dump_RowBuffer   EV_D_ROWBUFFER   [op].handler!
  find: dump_SeekOffsets EV_I_SEEKOFFSETS [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dump :: dump <operand> <detail> ;

: dump_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "dump_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
