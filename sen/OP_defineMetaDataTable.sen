/*============================================================================*/
/* OP_defineMetaDataTable.sen -- Operator define metaData table               */
/*============================================================================*/

" OP_defineMetaDataTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a defineMetaDataTable table                          */
/*----------------------------------------------------------------------------*/
: defineMetaDataTable::checkDefine ( -- true | errorCode false )

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then

  // error if given name already exists
  // <tableNm> check::nameIsUnknownTable not if false exit then
  // Don't need to check this since this is an internal thing

  true
;

/*----------------------------------------------------------------------------*/
/* define metaData table <tableNm> on this particpating node                  */
/*----------------------------------------------------------------------------*/
: defineMetaDataTable::createDefinedTable

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapids/schemas/public/tables
  Folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  StreamDefLft[] <tableNm> table::createTable to Table[]

  Table[].isMetaData assert

  // Set metadata table ptr in AM
  MetaDataTable[].setAM

  // create row in metadata table with catalogNm, schemaNm, tableNm
  MetaDataTable[].initTables

  nullptr to StreamDefLft[]
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: defineMetaDataTable_StreamDef

  0 locals| errorCode |

  // get the stream def
  Pipein[] to StreamDefLft[]
  nullptr to Pipein[]

  // grab the ddl lock
  [ddlLock].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check ok to create table
  defineMetaDataTable::checkDefine not if ( errorCode )
    to errorCode
    //StreamDefLft[].delete
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table
  defineMetaDataTable::createDefinedTable

  // should be in tables
  Folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute for defineMetaDataTable req                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: defineMetaDataTable_op \operator

  _lu_initialise_

  op__topology

  find: defineMetaDataTable_StreamDef EV_D_STREAMDEF [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: defineMetaDataTable :: defineMetaDataTable <tableNm> ;

: defineMetaDataTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "defineMetaDataTable_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
