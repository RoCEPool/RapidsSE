/*============================================================================*/
/* OP_sendWL.sen -- Operator send for WL Adaptor                              */
/*============================================================================*/

" OP_sendWL.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: sendWL_StartMarker \handler

  "sendWL_StartMarker - EV_M_START" .verbose

  "<ansSocket>" [job].tagSet@ tagSet.hasName assert

  // Make a copy of the socket where we retain the same file descriptor.
  <ansSocket> >int >ptr to Socket[]

  PipeIn[]\clear [op].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PAYLOAD operand                                           */
/*----------------------------------------------------------------------------*/
: sendWL_Payload \handler

  "sendWL_Payload - EV_D_PAYLOAD" .verbose

  PipeIn[]\clear locals| pPayloadObj |

  0 locals| iCurrTime |
  0 locals| iElapsedRecvTime |

  Socket[].isNotNull if
    // We expect to see a PayloadObj
    pPayloadObj object.class@ CN_PAYLOADOBJ == ASSERT

    TC_WLP trace.getComponent if
      // Calculate the elapsed time between receiving the payload off OP_adaptorWL
      // to processing it here in OP_sendWL
      ticking::getTick to iCurrTime
      iCurrTime pPayloadObj payloadObj::creationTime@ - to iElapsedRecvTime

      iElapsedRecvTime
      iCurrTime
      pPayloadObj payloadObj::size@
      pPayloadObj payloadObj::msgType@
      "SendWL: Sending payload: %v : %v bytes at time %v (elapsed OP_adaptorWL to OP_sendWL time: %v ns)" str.format .traceWlp
    then

    pPayloadObj Socket[].sendWLMsg not if
      Socket[].clientAddr@  "Error sending wireline message to client at %v" str.format .traceWlp
      Socket[].close
      ErrorMarker[].newErrorMarker
      ErrorMarker[].pipeOut
    then
  then

  pPayloadObj payloadObj::delete

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ERROR operand                                             */
/*----------------------------------------------------------------------------*/
: sendWL_Error \handler

  "sendWL_Error - EV_M_ERROR" .verbose

  // An up-stream operator has sent an error (usually the Adaptor).
  // This SendWL operator will intercept this and close the socket
  // before propagating the error.
  Socket[].isNotNull if
    Socket[].close
    Socket[].clientAddr@ "Connection closed to client at address %v" str.format .traceWlp
    Socket[].delete
  then

  EV_M_ERROR_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING operand                                          */
/*----------------------------------------------------------------------------*/
: sendWL_Cleaning \handler

  "sendWL_Cleaning - EV_M_CLEANING" .verbose

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* execute for send request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : sendWL_op \operator

  _lu_initialise_

  // This line ensures that if there are lots of events to be processed then
  // the operator does not yield until the input queue is empty or it has
  // processed a lot of events. i.e. try to process all events on the input
  // queue if possible.
  999999999999 [task].operandYield!

  op__topology

  find: sendWL_StartMarker EV_M_START       [op].handler!
  find: sendWL_Payload     EV_D_PAYLOAD     [op].handler!
  find: sendWL_Cleaning    EV_M_CLEANING    [op].handler!
  find: sendWL_Error       EV_M_ERROR       [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sendWL :: sendWL ;

: sendWL_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "sendWL_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/