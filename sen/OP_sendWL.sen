/*============================================================================*/
/* OP_sendWL.sen -- Operator send for WL Adaptor                              */
/*============================================================================*/

" OP_sendWL.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: sendWL_StartMarker \handler

  "sendWL_StartMarker - EV_M_START" .

  "<ansSocket>" [job].tagSet@ tagSet.hasName assert

  // Make a copy of the socket where we retain the same file descriptor.
  <ansSocket> >int >ptr socket::copy to Socket[]

  PipeIn[]\clear [op].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* send the data in the payload in the PipeIn[] register                      */
/*----------------------------------------------------------------------------*/
: sendWL_Payload \handler

  "sendWL_Payload - EV_D_PAYLOAD" .

  PipeIn[]\clear locals| pPayloadObj |

  // We expect to see a PayloadObj
  pPayloadObj object.class@ CN_PAYLOADOBJ == ASSERT

  pPayloadObj Socket[].sendWLMsg not if
    Socket[].clientAddr@  "Error sending wireline message to client at %v" .printf
    Socket[].close
    ErrorMarker[].newErrorMarker
    ErrorMarker[].pipeOut
  then

  pPayloadObj payloadObj::delete

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING operand                                          */
/*----------------------------------------------------------------------------*/
: sendWL_CLEANING \handler

  "sendWL_CLEANING - EV_M_CLEANING" .

  Socket[].close
  Socket[].object.isNotNull if
    Socket[].object.delete
  then

  Socket[].delete

  EV_M_CLEANING_handler
;

///*----------------------------------------------------------------------------*/
///* handler for EV_M_CANCELLING operand                                        */
///*----------------------------------------------------------------------------*/
//: sendWL_CANCELLING \handler
//
//  PipeIn[].drain
//
//  true
//;

///*----------------------------------------------------------------------------*/
///* handler for EV_M_EXITING operand                                           */
///*----------------------------------------------------------------------------*/
//: sendWL_EXITING \handler
//
////PipeIn[].sendTo discard
//
//  [op].ackJobTask
//
//  false // calling op_loop exits
//;

/*----------------------------------------------------------------------------*/
/* execute for send request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : sendWL_op \operator

  _lu_initialise_

  // This line ensures that if there are lots of events to be processed then
  // the operator does not yield until the input queue is empty or it has
  // processed a lot of events. i.e. try to process all events on the input
  // queue if possible.
  999999999999 [task].operandYield!

  op__topology

//find: PipeIn[].sendTo [op].handlerAll!

  find: sendWL_StartMarker EV_M_START       [op].handler!
  find: sendWL_Payload     EV_D_PAYLOAD     [op].handler!
  find: sendWL_CLEANING    EV_M_CLEANING    [op].handler!

//find: sendWL_CANCELLING  EV_M_CANCELLING  [op].handler!
//find: sendWL_EXITING     EV_M_EXITING     [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sendWL :: sendWL ;

: sendWL_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "sendWL_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/