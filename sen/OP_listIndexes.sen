/*============================================================================*/
/* OP_listIndexes.sen -- Operator list indexes                                */
/*============================================================================*/

" OP_listIndexes.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsidx_action

  0 0 0 locals| errorCode sTableNm pIndex |

  <tableNm> to sTableNm

  sTableNm op__table not if
    false
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // push table dictionary
  sTableNm Path[].pushNamedTableFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check it is a table
  sTableNm check::nameIsaTable not if
    to errorCode
    Path[].popNamedTableFolder
    errorCode op__execErr
    false
    exit
  then

  // push indexes folder
  Path[].pushIndexesFolder

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an rowBuffer operand
  BT_DATA TableDef[] RowBuffer[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the infoSet for each word

  Folder[] dic.lastWord dup
  iterate                          // setup iteration of words

    object@ word.name@ Folder[].findSymbol execute to pIndex

    pIndex TableDef[] RowBuffer[].addListIndex  not if
      RowBuffer[].pipeOut
      BT_DATA TableDef[] RowBuffer[].new
      pIndex TableDef[] RowBuffer[].addListIndex assert
    then

    object@ word.prev object!      // step backwards thru words
  next

  // pop indexes folder
  Path[].popIndexesFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pop table dictionary
  Path[].popNamedTableFolder
  Folder[].isTables assert

  // pipeout the infoset
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsidx :: lsidx <tableNm> ;

: lsidx_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listIndex
    <params>      = 1

    <opEntry> = "lsidx_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
