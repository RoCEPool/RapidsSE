/*============================================================================*/
/* OP_adaptorDummpy.sen -- dummy adaptor                                      */
/*============================================================================*/

" OP_adaptorDummpy.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: adaptorDummy_seapi

  "adaptorDummy_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on EV_X_CHILDEXIT ...                                       EV_X_CHILDEXIT */
/*----------------------------------------------------------------------------*/
: adaptorDummy_ChildExit \handler

  0 EV_X_CHILDEXIT EG_ZK LogicUnit[].diaryNote

  true LogicUnit[].RcvdChildExit!

  nullptr [job].responseOp!

  LogicUnit[].RcvdEnd@ if
    Marker[].newEndMarker
    Marker[].pipeout
  then

  "adaptorDummy_ChildExit" .
  Pipein[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: adaptorDummy_End \handler

  //"EV_M_END" .verbose

  true LogicUnit[].RcvdEnd!

  LogicUnit[].RcvdChildExit@ if
     PipeIn[].pipeout
  else
    PipeIn[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                    START */
/*----------------------------------------------------------------------------*/
: adaptorDummy_Start \handler

  0 locals| sSmt |

  0 EV_M_START EG_ZK LogicUnit[].diaryNote

  <etc> "sqlCompiler \"%v\"" str.format to sSmt

  sSmt "FORKING CHILD FOR PIPELINE: %v"  str.format .

  // spawn a job for the smt
  [Op] [job].responseOp!
  STD_NORMALFORK_TAG sSmt nullptr api::forkChild not if
    //"Error Code %v" .printf
    nullptr [job].responseOp!
    op__execErr
    true
    exit
  else
    find: adaptorDummy_End       EV_M_END       [op].handler!
  then

  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_CRWBUFFER ...                                            CRWBUFFER */
/*----------------------------------------------------------------------------*/
: adaptorDummy_CrwBuffer \handler

  EC_NONE locals| eError |

  0 EV_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  "adaptorDummy_CrwBuffer: GOT A CRWBUFFER" .
  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_PDSROWBUFFER ...                                            CRWBUFFER */
/*----------------------------------------------------------------------------*/
: adaptorDummy_PdsRowBuffer \handler

  EC_NONE locals| eError |

  0 EV_D_PDSROWBUFFER EG_ZK LogicUnit[].diaryNote

  "adaptorDummy_PdsRowBuffer: GOT A PDSROWBUFFER" .
  Pipein[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER ...                                            CRWBUFFER */
/*----------------------------------------------------------------------------*/
: adaptorDummy_RowBuffer \handler

  EC_NONE locals| eError |

  0 EV_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  "adaptorDummy_RowBuffer: GOT A ROWBUFFER" .
  Pipein[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STRAEMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: adaptorDummy_StreamDef \handler

  //"EV_D_STRAEMDEF_handler" .verbose

  PipeIn[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* adaptorDummy request                                                 SPAWN */
/*----------------------------------------------------------------------------*/
: adaptorDummy_op \operator

  _lu_initialise_

  op__topology

  find: adaptorDummy_CrwBuffer    EV_D_CRWBUFFER     [op].handler!
  find: adaptorDummy_PdsRowBuffer EV_D_PDSROWBUFFER  [op].handler!
  find: adaptorDummy_RowBuffer    EV_D_ROWBUFFER     [op].handler!
  find: adaptorDummy_StreamDef    EV_D_STREAMDEF     [op].handler!

  find: adaptorDummy_Start        EV_M_START         [op].handler!
  find: adaptorDummy_ChildExit    EV_X_CHILDEXIT     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: adaptorDummy :: adaptorDummy <etc> ;

: adaptorDummy_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "adaptorDummy_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
