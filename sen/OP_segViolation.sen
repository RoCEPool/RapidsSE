/*============================================================================*/
/* OP_segV.sen -- cause segmentation violation                                */
/*============================================================================*/

" OP_segV.sen" .verbose


/*----------------------------------------------------------------------------*/
/* segV action                                                                */
/*----------------------------------------------------------------------------*/
: segV_action

  inject::segV locals| pDumpBuffer |
  //pDumpBuffer .

  // convert the string to operand to pipe out
  pDumpBuffer str.toPromptOut [op].pipeout

  true
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: segV :: segV  ;

: segV_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 0

    <opEntry> = "segV_op"
  }
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
