/*============================================================================*/
/* dp_answerSE.sen -- Answer Demon for SE Adaptor                             */
/*============================================================================*/

" dp_answerSE.sen" .verbose


/*----------------------------------------------------------------------------*/
/* pipeline/procedure text for answer demon                                   */
/*----------------------------------------------------------------------------*/
procText:
  pipelineLocal answerSE_procText
    tag "<pre_execute>" = "demon::install" endTag
  begin

    stage stageA on origin :
        start
      | answerSE
      | eatAll
      | stageA

  end
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
