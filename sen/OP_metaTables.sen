/*============================================================================*/
/* OP_metaTables.sen -- Operator meta scan                                      */
/*============================================================================*/

" OP_metaTables.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: metaTables_DataMarker \handler

 0 0 0 locals| errorCode sTableNm pTable |

  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the Pds for each word

  Folder[] dic.lastWord dup
  iterate                          // setup iteration of words

    object@ word.name@ to sTableNm
    sTableNm Path[].pushNamedTableFolder
    sTableNm find execute to Table[]

    // skip definition only tables
    Table[].isUserCreated if

      sTableNm 1 TableDef[] Pds[].addRowVargs  not if
        Pds[].pipeOut
        BT_DATA TableDef[] Pds[].new
        sTableNm 1 TableDef[] Pds[].addRowVargs assert
      then

    then

    "Path[].popNamedTableFolder" find execute

    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the infoset
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: metaTables_StartMarker \handler

  PipeIn[].pipeOut

  // move to default tables folder
  "/tenants/boray/catalogs/rapids/schemas/public/tables"
  str.toStrVec Path[].set

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaTables_op \operator

  _lu_initialise_

  op__topology

  find: metaTables_DataMarker    EV_M_DATAPULSE  [op].handler!
  find: metaTables_StartMarker   EV_M_START      [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaTables :: metaTables ;

: metaTables_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <streamDef>  = __listContents
    <opEntry> = "metaTables_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
