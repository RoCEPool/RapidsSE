" it_pwf.sen" .verbose

: start::it_pwf

  // C_TDEF_PWF

  STD_PATH_TAG
  "
  define table __pwf (
    folder   VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  
  api::executeCommand 2discard
;

