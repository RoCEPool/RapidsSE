/*============================================================================*/
/* OP_grid.sen -- show grid                                                   */
/*============================================================================*/

" OP_grid.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: grid_action
  
  grid::show
  
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: grid :: grid ;

: grid_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 0

    <opEntry> = "grid_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
