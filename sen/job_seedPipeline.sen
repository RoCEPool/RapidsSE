/*============================================================================*/
/* job_seedPipeline.sen -- Pipeline Job Seeds                                 */
/*============================================================================*/

" job_seedPipeline.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distribute current originating job to all participating nodes              */
/*----------------------------------------------------------------------------*/
: job::sendToParticipants ( -- )

  job[] locals| pJob |

  // create the response vector in the orginating job to receive responses
  //pJob job.createResponseVec

  // set the no of acks expected by originator job
  //   to be the number of defined nodes in the grid
  grid::knownNodes pJob job.acksRemaining!

  // grab this task's lock
  task[] task.grabLock

  // set acks for originator task
  1 task::acks!

  // send the job to each connected node in the grid

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.sendSocket@ if
      pNode node.no pJob job.forward
    else
"++++++++++++++++++++++++++++++++++ NO SOCKET FOR NODE" .
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete
;


/*----------------------------------------------------------------------------*/
/***                          - Originating Node -                          ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* request                                              (on originating node) */
/*----------------------------------------------------------------------------*/
: pipelineSeed_req ::req_suffix [ word::seed# ]

  "<preCheck>" job::tagSet@ tagSet.hasName if
    <preCheck> find execute not if

      job::error!

      //"Signalling waiting thread" .
      job::informInvokerOfCompletion

      // task has no job
      task::scheduledelete

      req_exitHook
      
      exit

    then
  then

  // [ senCompiler::current@ word.name@ encode::push ] .
  // <jobNm> .

  job::becomeOriginator

  <jobNm> "::request" str.cat find dup if
    execute
  else
    discard
  then

  job[] job.hasError not if

    // distribute the job
    job::sendToParticipants

    // wait for the signal from deciding job__ended/cancelled
    task::wait

  else
    job[] job.removeOriginator  // this is currently being done by job_ended
  then

  //"Signalling waiting thread" .
  job::informInvokerOfCompletion

  // task has no job
  task::scheduledelete

  req_exitHook
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                       - Participating Nodes -                          ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* begin                                         (on each participating node) */
/*----------------------------------------------------------------------------*/
: pipelineSeed_beg _beg_suffix [ word::seed# ]

  // [ senCompiler::current@ word.name@ encode::push ] .

  JP_BEGINNING job[] job.phase!

  <path> str.toStrVec Path[].set

  job::becomeParticipant

  <jobNm> "::begin" str.cat find dup if
    execute

  else
    discard
  then

  JP_BEGUN job[] job.phase!
  nullptr job[] job.seedWord!
  
  job[] "Job__Begun::replyToOrigin" find execute
  
  beg_exitHook
;

/*----------------------------------------------------------------------------*/
/* execute                                       (on each participating node) */
/*----------------------------------------------------------------------------*/
: pipelineSeed_exe _exe_suffix [ word::seed# ]

  // [ senCompiler::current@ word.name@ encode::push ] .

  JP_EXECUTING job[] job.phase!

  // ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !
  // set task's dictionary stack from path in job

  <path> str.toStrVec Path[].set
  //task::dump

  job::acquireDdlLock

  <jobNm> "::execute" str.cat find dup if
    execute
  else
    discard
  then

  JP_EXECUTED job[] job.phase!
  nullptr job[] job.seedWord!

  job[] "Job__Executed::replyToOrigin" find execute
  
  exe_exitHook
;

/*----------------------------------------------------------------------------*/
/* end                                           (on each participating node) */
/*----------------------------------------------------------------------------*/
: pipelineSeed_end _end_suffix [ word::seed# ]

  // [ senCompiler::current@ word.name@ encode::push ] .

  //grid::thisNodeName@ "(%v) pipelineSeed _end" .printf

  JP_ENDING job[] job.phase!

  <jobNm> "::end" str.cat find dup if
    execute
  else
    discard
  then

  JP_ENDED job[] job.phase!
  nullptr job[] job.seedWord!

  job[] job.removeParticipant

  job[] "Job__Ended::replyToOrigin" find execute
  
  end_exitHook
;

/*----------------------------------------------------------------------------*/
/* cancel                                        (on each participating node) */
/*----------------------------------------------------------------------------*/
: pipelineSeed_can _can_suffix [ word::seed# ]

  // [ senCompiler::current@ word.name@ encode::push ] .

  JP_CANCELING job[] job.phase!

  <jobNm> "::cancel" str.cat find dup if
    execute
  else
    discard
  then

  JP_CANCELED job[] job.phase!
  nullptr job[] job.seedWord!

  job[] job.removeParticipant

  job[] "Job__Cancelled::replyToOrigin" find execute
  
  can_exitHook
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
