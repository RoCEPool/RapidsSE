/*============================================================================*/
/* OP_failed.sen -- failed operator (mimic)                                   */
/*============================================================================*/

" OP_Failed.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_Xyz ...                                                              */
/*----------------------------------------------------------------------------*/
: failed_failed \handler

  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: morphToFailed

  find:  failed_failed  op[].handlerAll!
;

/*----------------------------------------------------------------------------*/
/* failed request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: failed_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find:  failed_failed  op[].handlerAll!

  op__loop

  "*** failed_req EXITS" .
   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: failed :: failed ;

: failed_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
