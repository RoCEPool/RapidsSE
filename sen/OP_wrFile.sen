/*============================================================================*/
/* OP_wrFile.sen -- write to file                                             */
/*============================================================================*/

" OP_wrFile.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: wrFile_Cleaning \handler

  //File0[].isNull not if
    //File0[].get file.close
    //File0[].get file.delete
  //then

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: wrFile_CrwBuffer \handler

  PipeIn[]\clear to CrwBuffer[]

  CrwBuffer[].writetoFile0
  nullptr to CrwBuffer[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CSVBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: wrFile_CsvBuffer \handler

  PipeIn[]\clear to CsvBuffer[]

  CsvBuffer[].writetoFile0
  CsvBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: wrFile_StartMarker \handler

  PipeIn[].pipeOut

  // open the file for writing
  <fileNm> OPEN_WRITE op__file discard

  true
;

/*----------------------------------------------------------------------------*/
/* execute for wrFile req                             (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : wrFile_op \operator
 
  _lu_initialise_

  op__topology

  find: wrFile_Cleaning    EV_M_CLEANING    [op].handler!
  find: wrFile_CrwBuffer   EV_D_CRWBUFFER   [op].handler!
  find: wrFile_CsvBuffer   EV_D_CSVBUFFER   [op].handler!
  find: wrFile_StartMarker EV_M_START       [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: wrFile :: wrFile <fileNm> ;

: wrFile_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "wrFile_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
