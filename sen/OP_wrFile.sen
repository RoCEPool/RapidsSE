/*============================================================================*/
/* OP_wrFile.sen -- write to file                                             */
/*============================================================================*/

" OP_wrFile.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: wrFile_Cleaning \handler

  //File0[].isNull not if
    //File0[].get file.close
    //File0[].get file.delete
  //then

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: wrFile_CrwBuffer \handler

  PipeIn[]\clear to CrwBuffer[]

  CrwBuffer[].writetoFile0
  nullptr to CrwBuffer[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CSVBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: wrFile_CsvBuffer \handler

  PipeIn[]\clear to CsvBuffer[]

  CsvBuffer[].writetoFile0
  CsvBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: wrFile_StartMarker \handler

  PipeIn[].pipeOut

  // open the file for writing
  <fileNm> OPEN_WRITE op__file discard

  true
;

/*----------------------------------------------------------------------------*/
/* execute for wrFile req                             (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : wrFile_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: wrFile_Cleaning    ZK_M_CLEANING    op[].handler!
  find: wrFile_CrwBuffer   ZK_D_CRWBUFFER   op[].handler!
  find: wrFile_CsvBuffer   ZK_D_CSVBUFFER   op[].handler!
  find: wrFile_StartMarker ZK_M_START       op[].handler!

  op__loop

  LogReqExit
  _op_retires_
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: wrFile :: wrFile <fileNm> ;

: wrFile_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
