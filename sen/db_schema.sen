/*============================================================================*/
/* db_schema.sen -- schema related words                                      */
/*============================================================================*/

" db_schema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the schema category                                                        */
/*----------------------------------------------------------------------------*/
: \schema \\category ;

/*----------------------------------------------------------------------------*/
/* pop the schema folder                                                      */
/*----------------------------------------------------------------------------*/
: Path[].popSchemaFolder

  Path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* test if current folder is ../tables                                        */
/*----------------------------------------------------------------------------*/
: Folder[].isSchemas

  Folder[] dic.name@ "schemas" str.same
;

/*----------------------------------------------------------------------------*/
/* check current folder is ../schemas                                         */
/*----------------------------------------------------------------------------*/
: Folder[].checkIsSchemas

  Folder[].isSchemas if true exit then
  
  EC_NOT_IN_SCHEMAS false
;

/*----------------------------------------------------------------------------*/
/* check word is a schemas                                                    */
/*----------------------------------------------------------------------------*/
: checkIsSchema ( word )

  Folder[].findSymbol if true exit then
  EC_NOT_A_SCHEMA false
;

/*----------------------------------------------------------------------------*/
/* check word is a schema                                                     */
/*----------------------------------------------------------------------------*/
: Path[].checkIsSchema ( word )

  dup word.category@ find: \folder equal not if EC_NOT_A_FOLDER false exit then
  dup execute dic.kind@ find: \schema equal if true exit then
  EC_NOT_A_SCHEMA false
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable schema folder                                 */
/*----------------------------------------------------------------------------*/
: checkRemoveSchema ( "<schemaNm>" --  true | errorCode false )

  params| sSchemaNm |

  Folder[].checkIsSchemas not if false exit then
  //sSchemaNm word::isKnown not if EC_NO_SUCH_SCHEMA false exit then
  sSchemaNm checkIsSchema  not if false exit then
  //folder.isEmpty   not if false exit then
  //folder.notUsed   not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make a schema folder                                                       */
/*----------------------------------------------------------------------------*/
: :makeSchemaFolder params| sSchemaNm |

  args.tracepoint if
    sSchemaNm "MAKING SCHEMA " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make the schema
 sSchemaNm folder::makeFolder
   find: \schema swap execute dic.kind!

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // make tables folder
 sSchemaNm table::makeTablesFolder
;

/*----------------------------------------------------------------------------*/
/* make a schemas folder under given named catalog                            */
/*----------------------------------------------------------------------------*/
: :makeSchemasFolder ( "<catalogNm>" -- )

  args.tracepoint if
    dup "MAKING SCHEMAS FOR CATALOG " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  find execute ( dic )
  "schemas"    ( dic "schemas" )
  swap         ( "schemas" dic )
  folder::makeSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* find the schema folder and push it onto task dictionary                     */
/*----------------------------------------------------------------------------*/
: Path[].pushSchemaFolder ( "<schemaName>" -- )

  find execute Path[].pushFolder
  true
;

/*----------------------------------------------------------------------------*/
/* remove a schema folder                                                     */
/*----------------------------------------------------------------------------*/
: removeSchema ( "<schemaNm>" --  )

  params| sSchemaNm |

  args.tracepoint if
  dup "REMOVING SCHEMA " swap str.cat " on NODE " str.cat grid::thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // move to schema folder
  sSchemaNm Path[].pushSchemaFolder assert

  "tables" folder::remove

  Path[].popSchemaFolder

  sSchemaNm folder::remove
;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
