/*============================================================================*/
/* tpl_liteOp.sen -- templates for lite op                                    */
/*============================================================================*/

" tpl_liteOp.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                        */
/*----------------------------------------------------------------------------*/
: tpl_liteOp_DataMarker

"
: /liteOp/_DataMarker \\handler

  /liteOp/_action if
    PipeIn[].pipeOut
    Operand[].newEosMarker
    Operand[].pipeOut
  then

  true
;
"
;

/*----------------------------------------------------------------------------*/
/* execute for liteOp req                             (on node where spawned) */
/*----------------------------------------------------------------------------*/
: tpl_liteOp_req

"
: /liteOp/_req \\operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: /liteOp/_DataMarker  ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;
"
;


/*----------------------------------------------------------------------------*/
/* liteOp procedure with 0 parameters                                         */
/*----------------------------------------------------------------------------*/
: tpl_liteOp_procedure0

"
  procedure /liteOp/
    tags <lowMemory>
  begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all nodes :
      /liteOp/ | stageC

    stage stageC on origin :
      output | sink | stageA

  end
"
;
    
/*----------------------------------------------------------------------------*/
/* liteOp procedure with 1 parameter                                          */
/*----------------------------------------------------------------------------*/
: tpl_liteOp_procedure1

"
  procedure /liteOp/
    tags <lowMemory>
    parameters $param
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    /liteOp/ $param | stageC

  stage stageC on origin :
    output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* liteOp procedure with 2 parameters                                         */
/*----------------------------------------------------------------------------*/
: tpl_liteOp_procedure2

"
  procedure /liteOp/
    tags <lowMemory>
    parameters $param0 $param1
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    /liteOp/ $param0 $param1 | stageC

  stage stageC on origin :
    output | sink | stageA

  end
"
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
