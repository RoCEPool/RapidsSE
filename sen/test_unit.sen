" test_unit.sen" .verbose

"test_arithmetic.sen" include

"test_flow.sen" include

"test_logic.sen" include

: ut

  "unit testing..." .put .\n

  logicTests

  arithmeticTests

  flowTests

  "unit tests passed" .put .\n
;

