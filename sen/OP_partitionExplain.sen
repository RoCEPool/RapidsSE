/*============================================================================*/
/* OP_partitionExplain.sen -- Explain the partitioned plan Op (SQL Compiler)  */
/*============================================================================*/

" OP_partitionExplain.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: partitionExplain_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: partitionExplain_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCompileErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::partitionExplain to PlanOperand[]

  "partitionExplain" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: partitionExplain_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker  EV_M_LEAVE       [op].handler!
  find: compiler_StreamSet    EV_D_STREAMSET   [op].handler!

  // specific handlers
  find: partitionExplain_Cleaning      EV_M_CLEANING      [op].handler!
  find: partitionExplain_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: partitionExplain :: partitionExplain ;

: partitionExplain_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "partitionExplain_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
