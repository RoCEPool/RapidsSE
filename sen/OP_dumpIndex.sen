/*============================================================================*/
/* OP_dumpIndex.sen -- Operator dump index                                    */
/*============================================================================*/

" OP_dumpIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: dumpIdx_action

  <tableNm> <indexNm> op__table_index if
    Index[].dump
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dumpIdx :: dumpIdx <tableNm> <indexNm> ;

: dumpIdx_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 2
    <seedReq>     = "dumpIdx_req"
    <opEntry> = "dumpIdx_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

