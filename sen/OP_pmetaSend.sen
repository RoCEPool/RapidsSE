/*============================================================================*/
/* OP_pmetaSend.sen -- Operator meta send                                     */
/*============================================================================*/

" OP_pmetaSend.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_METAGET ...                                                          */
/*----------------------------------------------------------------------------*/
: pmetaGet_table \handler

  true
;

/*----------------------------------------------------------------------------*/
/* execute for metasend request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pmetaSend_op \operator

  _lu_initialise_

  op__topology

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: pmetaSend :: pmetaSend ;

: pmetaSend_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
