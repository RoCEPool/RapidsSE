/*============================================================================*/
/* OP_recurring.sen -- Operator recurring                                     */
/*============================================================================*/

" OP_recurring.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add recurring activity here                                                */
/*----------------------------------------------------------------------------*/
: recurring_activity ( -- )

  AM::SHOW::bRecurring if
  
    jobs::seeDlist
    jobs::seeLlist
    jobs::seeOlist
    jobs::seePlist
    jobs::seeRlist
    
    jobs::seeSqueue
    
    system::bpa
  
  else
  
    // "No Recurring Activity" .
    
  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: recurring_StartMarker \handler

  "Recurring Demon Started" .boot

  // recurring_activity
    
  begin

    //<nSeconds> >int  thread::sleepSsec

    //args.demonSleep thread::sleepSsec
    30 thread::sleepSsec

    //recurring_activity

  again
;

/*----------------------------------------------------------------------------*/
/* execute for recurring req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : recurring_op \operator
 
  _lu_initialise_

  "<testTag>" Job[].tagSet@ tagSet.hasName if
    <testTag> .
  then

  op__topology

  find: recurring_StartMarker ZK_M_START op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: recurring :: recurring <nSeconds> ;

: recurring_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <dedicatedThd> = 1
    <opEntry> = "recurring_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
