/*============================================================================*/
/* OP_recurring.sen -- Operator recurring                                     */
/*============================================================================*/

" OP_recurring.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add recurring activity here                                                */
/*----------------------------------------------------------------------------*/
: recurring_activity ( -- )

  "Recurring Activity" .
  
  jobs::seeDlist
  jobs::seeLlist
  jobs::seeOlist
  jobs::seePlist
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: recurring_StartMarker \handler

  begin

    task::yield

    // "periodic sleeping..." .
    <nSeconds> >int task::sleepSsec

    recurring_activity

  again
;

/*----------------------------------------------------------------------------*/
/* execute for recurring req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : recurring_req \operator
 
  LogReqEntry SEED_REQ

  "<testTag>" job[] job.tagSet@ tagSet.hasName if
    <testTag> .
  then

  op__topology

  find: recurring_StartMarker ZK_M_START op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: recurring :: recurring <nSeconds> ;

: recurring_cmdTags _cmdTags tagCopy: serviceOp_tags

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
