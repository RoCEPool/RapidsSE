/*============================================================================*/
/* OP_removeNode.sen -- Operator Remove Node                                  */
/*============================================================================*/

" OP_removeNode.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for remove node                            (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : removeNode::nigeb \operator
 
  _lu_initialise_

  <nodeNm> .

  op__topology

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: removeNode :: removeNode <nodeNm> ;

: removeNode_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
