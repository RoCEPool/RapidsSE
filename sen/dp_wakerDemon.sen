/*============================================================================*/
/* dp_wakerDemon.sen -- Waker Demon                                           */
/*============================================================================*/

" dp_wakerDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* waker demon                                                                */
/*----------------------------------------------------------------------------*/
: wakerDemonPipeline

  "
    pipelineLocal wakerDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | waker
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
