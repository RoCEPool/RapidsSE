/*============================================================================*/
/* OP_listPartitions.sen -- Operator list partitions                          */
/*============================================================================*/

" OP_listPartitions.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsPtns_action

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  StreamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an infoSet operand
  StreamSetTable[] RowBuffer[].new

  // get a row per partition on this node
  [grid].ptnsPerNode 0 do

    I [grid].tablePtnToPtnNo
      StreamSetTable[] RowBuffer[].addListPartitions  not if
        RowBuffer[].pipeOut
        StreamSetTable[] RowBuffer[].new
        I [grid].tablePtnToPtnNo
        StreamSetTable[] RowBuffer[].addListPartitions assert
      then

  loop

  // pipeout the infoset
  RowBuffer[].pipeOut

  true
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsPtns :: lsPtns ;

: lsPtns_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __listPartitions
    <params>    = 0
    <opEntry> = "lsPtns_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
