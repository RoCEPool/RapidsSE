/*============================================================================*/
/* OP_listPartitions.sen -- Operator list partitions                          */
/*============================================================================*/

" OP_listPartitions.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsPtns_action

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  // get a row per partition on this node
  [grid].ptnsPerNode 0 do

    I [grid].tablePtnToPtnNo TableDef[]
      Pds[].addListPartitions  not if
        Pds[].pipeOut
        BT_DATA TableDef[] Pds[].new
        I [grid].tablePtnToPtnNo TableDef[]
        Pds[].addListPartitions assert
      then

  loop

  // pipeout the Pds
  Pds[].pipeOut

  true
;
  
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsPtns :: lsPtns ;

: lsPtns_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __listPartitions
    <params>    = 0
    <opEntry> = "lsPtns_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
