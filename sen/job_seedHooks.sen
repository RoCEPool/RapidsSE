/*============================================================================*/
/* job_seedHooks.sen -- Job Seed Hooks                                        */
/*============================================================================*/

" job_seedHooks.sen" .verbose


/*----------------------------------------------------------------------------*/
/***                             - Entry Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* entry hook for request seed                                                */
/*----------------------------------------------------------------------------*/
: req_entryHook

  // "req_entryHook" .

  job::assertCorrectness

;

/*----------------------------------------------------------------------------*/
/* entry hook for begin seed                                                  */
/*----------------------------------------------------------------------------*/
: beg_entryHook

  // "beg_entryHook" .

  job::assertCorrectness

;

/*----------------------------------------------------------------------------*/
/* entry hook for execute seed                                                */
/*----------------------------------------------------------------------------*/
: exe_entryHook

  // "exe_entryHook" .

  job::assertCorrectness

;

/*----------------------------------------------------------------------------*/
/* entry hook for end seed                                                    */
/*----------------------------------------------------------------------------*/
: end_entryHook

  // "end_entryHook" .

  job::assertCorrectness

;

/*----------------------------------------------------------------------------*/
/* entry hook for cancel seed                                                 */
/*----------------------------------------------------------------------------*/
: can_entryHook

  // "can_entryHook" .

  job::assertCorrectness

;

/*----------------------------------------------------------------------------*/
/* entry hook for run seed                                                    */
/*----------------------------------------------------------------------------*/
: run_entryHook

  //"run_entryHook" .

  job::assertCorrectness

;

/*----------------------------------------------------------------------------*/
/* entry hook for standard seeds                                              */
/*----------------------------------------------------------------------------*/
: std_entryHook

  // "std_entryHook" .

  job::assertCorrectness

;


/*----------------------------------------------------------------------------*/
/***                              - Exit Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* exit hook for request seed                                                 */
/*----------------------------------------------------------------------------*/
: req_exitHook

  // "req_exitHook" .

  DdlLock[].testDrop

  Done_Finally
;

/*----------------------------------------------------------------------------*/
/* exit hook for begin seed                                                   */
/*----------------------------------------------------------------------------*/
: beg_exitHook

  // "beg_exitHook" .

  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for execute seed                                                 */
/*----------------------------------------------------------------------------*/
: exe_exitHook

  // "exe_exitHook" .

  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for end seed                                                     */
/*----------------------------------------------------------------------------*/
: end_exitHook

  // "end_exitHook" .

  DdlLock[].testDrop

  Done_Finally

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for cancel seed                                                  */
/*----------------------------------------------------------------------------*/
: can_exitHook

  // "can_exitHook" .

  Done_Finally

 job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for run seed                                                     */
/*----------------------------------------------------------------------------*/
: run_exitHook

  //"run_exitHook" .

  DdlLock[].testDrop

  Done_Finally

  job::completed

  HAZARD
;


/*----------------------------------------------------------------------------*/
/* exit hook for standard seeds                                               */
/*----------------------------------------------------------------------------*/
: std_exitHook

  //"std_exitHook" .
;

/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: std_recoveryWord

  //"std_recoveryWord" .
  
  //task::exception .

  "op__failureRecovery" FIND execute
  
  //process::quit

  //HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
