/*============================================================================*/
/* job_seedHooks.sen -- Job Seed Hooks                                        */
/*============================================================================*/

" job_seedHooks.sen" .verbose




/*----------------------------------------------------------------------------*/
/***                              - Exit Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* exit hook for request seed                                                 */
/*----------------------------------------------------------------------------*/
: req_exitHook

  // "req_exitHook" .

  DdlLock[].testDrop

  _job_finalise_
;

/*----------------------------------------------------------------------------*/
/* exit hook for begin seed                                                   */
/*----------------------------------------------------------------------------*/
: beg_exitHook

  // "beg_exitHook" .

  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for execute seed                                                 */
/*----------------------------------------------------------------------------*/
: exe_exitHook

  // "exe_exitHook" .

  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for end seed                                                     */
/*----------------------------------------------------------------------------*/
: end_exitHook

  // "end_exitHook" .

  DdlLock[].testDrop

  _job_finalise_

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for cancel seed                                                  */
/*----------------------------------------------------------------------------*/
: can_exitHook

  // "can_exitHook" .

  _job_finalise_

 job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for run seed                                                     */
/*----------------------------------------------------------------------------*/
: run_exitHook

  //"run_exitHook" .

  DdlLock[].testDrop

  _job_finalise_

  job::completed

  HAZARD
;


/*----------------------------------------------------------------------------*/
/* exit hook for standard seeds                                               */
/*----------------------------------------------------------------------------*/
: std_exitHook

  //"std_exitHook" .
;

/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: std_recoveryWord

  //"std_recoveryWord" .
  
  //task::exception .

  "op__failureRecovery" FIND execute
  
  //process::quit

  //HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
