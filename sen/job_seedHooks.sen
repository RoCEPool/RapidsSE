/*============================================================================*/
/* job_seedHooks.sen -- Job Seed Hooks                                        */
/*============================================================================*/

" job_seedHooks.sen" .verbose


/*----------------------------------------------------------------------------*/
/***                             - Entry Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* entry hook for request seed                                                */
/*----------------------------------------------------------------------------*/
: req_entryHook

  // "req_entryHook" .

  r@ locate log::markEntry

  SS_SEED_REQ log::jobSeed

  job::assertCorrectness

  Seed_Initially
;

/*----------------------------------------------------------------------------*/
/* entry hook for begin seed                                                  */
/*----------------------------------------------------------------------------*/
: beg_entryHook

  // "beg_entryHook" .

  r@ locate log::markEntry

  SS_SEED_BEG log::jobSeed

  job::assertCorrectness

  Seed_Initially
;

/*----------------------------------------------------------------------------*/
/* entry hook for execute seed                                                */
/*----------------------------------------------------------------------------*/
: exe_entryHook

  // "exe_entryHook" .

  r@ locate log::markEntry

  SS_SEED_EXE log::jobSeed

  job::assertCorrectness

  Seed_Initially
;

/*----------------------------------------------------------------------------*/
/* entry hook for end seed                                                    */
/*----------------------------------------------------------------------------*/
: end_entryHook

  // "end_entryHook" .

  r@ locate log::markEntry

  SS_SEED_END log::jobSeed

  job::assertCorrectness

  Seed_Initially
;

/*----------------------------------------------------------------------------*/
/* entry hook for cancel seed                                                 */
/*----------------------------------------------------------------------------*/
: can_entryHook

  // "can_entryHook" .

  r@ locate log::markEntry

  SS_SEED_CAN log::jobSeed

  job::assertCorrectness

  Seed_Initially
;

/*----------------------------------------------------------------------------*/
/* entry hook for run seed                                                    */
/*----------------------------------------------------------------------------*/
: run_entryHook

  //"run_entryHook" .

  r@ locate log::markEntry

  SS_SEED_RUN log::jobSeed

  job::assertCorrectness

  Seed_Initially
;

/*----------------------------------------------------------------------------*/
/* entry hook for standard seeds                                              */
/*----------------------------------------------------------------------------*/
: std_entryHook

  // "std_entryHook" .

  r@ locate log::markEntry

  job::assertCorrectness

  Seed_Initially
;


/*----------------------------------------------------------------------------*/
/***                              - Exit Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* exit hook for request seed                                                 */
/*----------------------------------------------------------------------------*/
: req_exitHook

  // "req_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  Done_Finally
;

/*----------------------------------------------------------------------------*/
/* exit hook for begin seed                                                   */
/*----------------------------------------------------------------------------*/
: beg_exitHook

  // "beg_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for execute seed                                                 */
/*----------------------------------------------------------------------------*/
: exe_exitHook

  // "exe_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for end seed                                                     */
/*----------------------------------------------------------------------------*/
: end_exitHook

  // "end_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  Done_Finally

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for cancel seed                                                  */
/*----------------------------------------------------------------------------*/
: can_exitHook

  // "can_exitHook" .

  r@ locate log::markExit

  Done_Finally

 job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for run seed                                                     */
/*----------------------------------------------------------------------------*/
: run_exitHook

  //"run_exitHook" .

  r@ locate log::markExit

  DdlLock[].testDrop

  Done_Finally

  job::completed

  HAZARD
;


/*----------------------------------------------------------------------------*/
/* exit hook for standard seeds                                               */
/*----------------------------------------------------------------------------*/
: std_exitHook

  //"std_exitHook" .

  r@ locate log::markExit
;

/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception hook                                                    */
/*----------------------------------------------------------------------------*/
: std_exceptionHook

  // "std_exceptionHook" .

  process::quit

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
