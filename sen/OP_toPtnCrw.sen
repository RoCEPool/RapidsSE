/*============================================================================*/
/* OP_toPtnCrw.sen -- Convert ptn nst row buffers to ptn crw buffers          */
/*============================================================================*/

" OP_toPtnCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                  DEFINITION */
/*----------------------------------------------------------------------------*/
: toPtnCrw_StreamDef \handler

  PipeIn[] to StreamDefLft[]
  nullptr to PipeIn[]

  StreamDefLft[].duplicate to StreamDefOut[]

  toPtnCrw[].create

  StreamDefOut[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: toPtnCrw_StartMarker \handler

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toPtnCrw_DataMarker \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: toPtnCrw_RowBuffer \handler

  PipeIn[]\clear to RowBuffer[]
  RowBuffer[] toPtnCrw[].convert
  RowBuffer[].delete

  ptnmap::ptnsInGrid 0
  do

    I toPtnCrw[].completed to CrwBuffer[]

    begin
      CrwBuffer[].isNull not
    while
      CrwBuffer[].appendClose
      CrwBuffer[].pipeOut
      I toPtnCrw[].completed to CrwBuffer[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: toPtnCrw_EosMarker \handler

  ptnmap::ptnsInGrid 0
  do

    I toPtnCrw[].dangling to CrwBuffer[]

    begin
      CrwBuffer[].isNull not
    while
      CrwBuffer[].appendClose
      CrwBuffer[].pipeOut
      I toPtnCrw[].dangling to CrwBuffer[]
    repeat

  loop

  StreamDefLft[].delete

  toPtnCrw[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRow request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toPtnCrw_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toPtnCrw_EosMarker   ZK_M_EOS         op[].handler!
  find: toPtnCrw_DataMarker  ZK_M_DATAPULSE   op[].handler!
  find: toPtnCrw_RowBuffer   ZK_D_ROWBUFFER   op[].handler!
  find: toPtnCrw_StartMarker ZK_M_START       op[].handler!
  find: toPtnCrw_StreamDef   ZK_D_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toPtnCrw :: toPtnCrw ;

: toPtnCrw_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
