/*============================================================================*/
/* OP_transliterate.sen -- Transliterate Op (SQL Compiler)                    */
/*============================================================================*/

" OP_transliterate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_X_CHILDEXIT ...                                             */
/*----------------------------------------------------------------------------*/
: transliterate_ChildExit \handler

  "EV_X_CHILDEXIT" .verbose

  true LogicUnit[].RcvdChildExit!

  nullptr [job].responseOp!

  LogicUnit[].RcvdEnd@ if
    Marker[].newEndMarker
    Marker[].pipeout
  then

  //"transliterate_ChildExit" .
  Pipein[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: transliterate_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: transliterate_DataMarker \handler
 
  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: transliterate_EosMarker \handler
 
  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: transliterate_End \handler

  "EV_M_END_handler" .verbose

  true LogicUnit[].RcvdEnd!

  LogicUnit[].RcvdChildExit@ if
     PipeIn[].pipeout
  else
    PipeIn[].delete
  then

  true
;


/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: transliterate_PlanOperand \handler

  0 0 locals| sOperatorName sPipeline |

  PipeIn[]\clear to PlanOperand[]

  "<pipelineName>" [job].tagSet@ tagSet.hasName if
    <pipelineName> to sPipeline
  else
    "unamed" to sPipeline
  then

  sPipeline PlanOperand[] sqlCompiler::transliterate to Text[]

  "transliterate" to sOperatorName
  PlanOperand[] sOperatorName sqlCompiler::hasExplain if

    // execute special explain for this operator
    PlanOperand[] Text[] sOperatorName sqlCompiler::doExplainTliterate

    // pipeout explain
    StreamSet[].isNull not assert
    StreamSet[].pipeout

    // Always exit at this point
    PlanOperand[].delete
    Marker[].newLeaveMarker
    Marker[].pipeout
    true
    exit
  then

  // We couldn't delete the plan in sqlCompiler::transliterate because
  // it might have needed to have been explained
  PlanOperand[] sqlCompiler::deletePlan
  PlanOperand[].delete

  //Text[] "FORKING CHILD FOR PIPELINE: %v"  str.format .

  "<jobTags>" [job].tagSet@ tagSet.hasName if
    "JOB TAGS:" .
    [job].tagSet@ tagSet.dump
  then

  [Op] [job].responseOp!
  STD_NORMALFORK_SELECT_TAG Text[] api::forkChild not if
     //"****Error Code %v" .printf
     nullptr [job].responseOp!
     op__execErr
     true
     exit
  else
    find: transliterate_End       EV_M_END       [op].handler!
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: transliterate_StartMarker \handler

  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LEAVE ...                                                 */
/*----------------------------------------------------------------------------*/
: transliterate_LeaveMarker \handler

  // save the pipein in streamSet[]
  StreamSet[].isNull not assert
  StreamSet[].pipeout

  EV_M_LEAVE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LOWMEMORY operand                                         */
/*----------------------------------------------------------------------------*/
: transliterate_lowMemory \handler

  //"EV_M_LOWMEMORY_handler" .verbose

  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMSET ...                                               */
/*----------------------------------------------------------------------------*/
: transliterate_StreamSet \handler

  // save the pipein in streamSet[]
  Pipein[]\clear to StreamSet[]

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: transliterate_op \operator

  _lu_initialise_

  op__topology

  find: transliterate_Cleaning      EV_M_CLEANING      [op].handler!
  find: transliterate_DataMarker    EV_M_DATAPULSE     [op].handler!
  find: transliterate_EosMarker     EV_M_EOS           [op].handler!
  find: transliterate_PlanOperand   EV_D_PLANOPERAND   [op].handler!
  find: transliterate_StartMarker   EV_M_START         [op].handler!

  find: transliterate_StreamSet     EV_D_STREAMSET     [op].handler!
  find: transliterate_LeaveMarker   EV_M_LEAVE         [op].handler!
  find: transliterate_LowMemory     EV_M_LOWMEMORY     [op].handler!
  find: transliterate_ChildExit     EV_X_CHILDEXIT     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: transliterate :: transliterate ;

: transliterate_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <streamDef> = __joinOrder
    <opEntry> = "transliterate_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
