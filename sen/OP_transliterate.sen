/*============================================================================*/
/* OP_transliterate.sen -- Transliterate Op (SQL Compiler)                    */
/*============================================================================*/

" OP_transliterate.sen" .verbose

/******************************************************************************/
/* cascade experimental code (ray)                                            */
/******************************************************************************/

: cascadeJob \prompt

  "
  pipeline cascade
  begin

  stage stageA on origin :
    start
    | periodic once
    | metaScan tables
    | rowToList
    | output
    | sink
    | stageA

  end ;
  " session::cascade!
  
  true session::hasCascade!
;



/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: transliterate_CancelMarker \handler

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: transliterate_DataMarker \handler
 
  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: transliterate_EosMarker \handler
 
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: transliterate_PlanOperand \handler

 0 0 locals| sPipeline sOperatorName |

  PipeIn[] to Operand[]
    nullptr to PipeIn[]

  Operand[] sqlCompiler::transliterate to sPipeline

  "transliterate" to sOperatorName
  Operand[] sOperatorName sqlCompiler::hasExplain if

    // execute special explain for this operator
    Operand[] sPipeline sOperatorName sqlCompiler::doExplainTliterate

    // pipeout explain
    StreamSet[].isNull not assert
    StreamSet[].pipeout

    // Always exit at this point
    Operand[].delete
    Operand[].newExitEarlyMarker
    Operand[].pipeout
    true
    exit
  then

  // We couldn't delete the plan in sqlCompiler::transliterate because
  // it might have needed to have been explained
  Operand[] sqlCompiler::deletePlan
  Operand[].delete

  //sPipeline .

  sPipeline session::cascade!

  true session::hasCascade!
  
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: transliterate_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITEARLYMARKER ...                                         */
/*----------------------------------------------------------------------------*/
: transliterate_ExitEarlyMarker \handler

  // save the pipein in streamSet[]
  StreamSet[].isNull not assert
  StreamSet[].pipeout

  ZK_EXITEARLYMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMSET ...                                               */
/*----------------------------------------------------------------------------*/
: transliterate_StreamSet \handler

  // save the pipein in streamSet[]
  Pipein[]\clear to StreamSet[]

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: transliterate_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: transliterate_CancelMarker ZK_CANCELMARKER op[].handler!
  find: transliterate_DataMarker   ZK_DATAPULSE    op[].handler!
  find: transliterate_EosMarker    ZK_EOSMARKER    op[].handler!
  find: transliterate_PlanOperand  ZK_PLANOPERAND  op[].handler!
  find: transliterate_StartMarker  ZK_STARTMARKER  op[].handler!

  find: transliterate_StreamSet    ZK_STREAMSET    op[].handler!
  find: transliterate_ExitEarlyMarker ZK_EXITEARLYMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: transliterate :: transliterate ;

: transliterate_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
