/*============================================================================*/
/* dp_reaperDemon.sen -- Reaper Demon                                         */
/*============================================================================*/

" dp_reaperDemon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* reaper demon pipeline command                                              */
/*----------------------------------------------------------------------------*/
: reaperDemonPipeline

  "
    pipelineLocal reaperDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | reap
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
