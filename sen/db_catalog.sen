/*============================================================================*/
/* db_catalog.sen -- catalog related words                                    */
/*============================================================================*/

" db_catalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the catalog category                                                       */
/*----------------------------------------------------------------------------*/
: \catalog \\category ;

/*----------------------------------------------------------------------------*/
/* pop the catalog folder                                                     */
/*----------------------------------------------------------------------------*/
: Path[].popCatalogFolder

  Path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* test if current folder is ../catalogs                                      */
/*----------------------------------------------------------------------------*/
: Folder[].isCatalogs

  Folder[] dic.name@ "catalogs" str.same
;

/*----------------------------------------------------------------------------*/
/* check current folder is ../catalogs                                        */
/*----------------------------------------------------------------------------*/
: Folder[].checkIsCatalogs

  Folder[].isCatalogs if true exit then
  EC_NOT_IN_CATALOGS false
;

/*----------------------------------------------------------------------------*/
/* check word is a catalog                                                    */
/*----------------------------------------------------------------------------*/
: Path[].checkIsCatalog ( word )

  dup word.category@ find: \folder equal not if EC_NOT_A_FOLDER false exit then
  dup execute dic.kind@ find: \catalog equal if true exit then
  EC_NOT_A_CATALOG false
;

/*----------------------------------------------------------------------------*/
/* check word is a catalog                                                    */
/*----------------------------------------------------------------------------*/
: checkIsCatalog ( word )

  Folder[].findSymbol if true exit then
  EC_NOT_A_CATALOG false
;

/*----------------------------------------------------------------------------*/
/* check if word is not a catalog                                             */
/*----------------------------------------------------------------------------*/
: name::isNotKnownCatalog ( word )

  Folder[].findSymbol not if true exit then
  EC_CATALOG_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a removable catalog folder                                 */
/*----------------------------------------------------------------------------*/
: checkRemoveCatalog ( "<catalogNm>" --  true | errorCode false )

  params| sCatalogNm |

  Folder[].checkIsCatalogs not if false exit then
  //sCatalogNm word::isKnown not if EC_NO_SUCH_CATALOG false exit then
  sCatalogNm checkIsCatalog  not if false exit then
  //folder.isEmpty   not if false exit then
  //folder.notUsed   not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make a catalogs folder under given named tenant                            */
/*----------------------------------------------------------------------------*/
: :makeCatalogsFolder ( <catalogNm> -- )

  [args].tracepoint if
  dup "MAKING CATALOGS FOR TENANT " swap str.cat " on NODE " str.cat [grid].thisNodeNo@ >str str.cat .
  then

  find execute ( dic )
  "catalogs"   ( dic "catalogs" )
  swap         ( "catalogs" dic )
  folder::makeSubFolder   ( )
;

/*----------------------------------------------------------------------------*/
/* make a named catalog folder (run by participant)                           */
/*----------------------------------------------------------------------------*/
: :makeCatalogFolder params| sCatalogNm |

  [args].tracepoint if
   sCatalogNm "MAKING CATALOG " swap str.cat " on NODE " str.cat [grid].thisNodeNo@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the catalog
  sCatalogNm folder::makeFolder
    find: \catalog swap execute dic.kind!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make catalogs folder
  sCatalogNm :makeSchemasFolder ( )
;

/*----------------------------------------------------------------------------*/
/* find the catalog folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: Path[].pushCatalogFolder ( "<catalogName>" -- )

  find execute Path[].pushFolder
  true
;

/*----------------------------------------------------------------------------*/
/* remove a catalog folder                                                     */
/*----------------------------------------------------------------------------*/
: removeCatalog ( "<catalogNm>" --  )

  params| sCatalogNm |

  [args].tracepoint if
    dup "REMOVING CATALOG " swap str.cat " on NODE " str.cat [grid].thisNodeNo@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // move to catalog folder
  sCatalogNm Path[].pushCatalogFolder assert

  "schemas" folder::remove

  Path[].popCatalogFolder

  sCatalogNm folder::remove
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
