/*============================================================================*/
/* OP_connectSE.sen -- Operator connect for SE Adaptor                        */
/*============================================================================*/

" OP_connectSE.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send node info to node we just connected to                                */
/*----------------------------------------------------------------------------*/
: connectSE_sendNodeInfo ( -- )

  // find the __nodeinfo table
  C_TDEF_NODEINFO op__tableDef assert

  // create a Pds operand
  BT_NODEINFO TableDef[] Pds[].new

  // add nodeInfo to the Pds
  Pds[].addnodeInfo assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // send node info job to the other node
  Socket[].grabWrite
  Pds[] Socket[].sendObject assert
  Socket[].dropWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete Pds
  Pds[].delete
;

/*----------------------------------------------------------------------------*/
/* attempt connect to given node                                              */
/*----------------------------------------------------------------------------*/
: connectSE_attemptConnect ( -- )

  AM::SHOW::bConnection if
    Node[] node.id [grid].thisNodeId@ "Node %v connecting to node %v" .printf
  then


  // create a new socket for node
  Node[] socket::new to Socket[]
  
  
  // attempt to connect the socket using nodes port and IP address
  Node[] node.port ( port )
  Node[] node.IP   ( port IP )
    Socket[].connect

  Socket[].isNull if
    Node[] node.id [grid].thisNodeId@ "Node %v unable to connect to node %v" .printf
    exit
  then

  // set the send socket in the node
  ptnmap::adjust
  Socket[] Node[] node.sendSocket!

 
  // print connection message
  AM::SHOW::bConnection if
     Node[] node.id [grid].thisNodeId@ "Node %v connected to node %v" .printf
  then

  // send this node's info to the node we just connected to
  connectSE_sendNodeInfo
  
  nullptr to Socket[]
;

/*----------------------------------------------------------------------------*/
/* one iteration of connector behavior                                        */
/*----------------------------------------------------------------------------*/
: connectSE_take ( -- )

  //C_ALL node_I[].new
  node_I[].init

  begin

    node_I[].node to Node[]

    Node[] node.sendSocket@ not if
      Node[] node.connectRetry if
        connectSE_attemptConnect
      then
    then
    
    nullptr to Node[]

    node_I[].next
    node_i[].more while
  repeat

  //node_I[].delete
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: connectSE_StartMarker \handler

  "Connector Demon Started" .boot

  [args].verbose if
    [grid].thisNodeId@ [job] "Connector %v on node %v running" .printf
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin
    connectSE_take
    trap::stackDepthZero

    3 thread::sleepSsec
  again

  // print started message
  //[grid].thisNodeName@ "Node %v : SE cluster started" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute for connector req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : connectSE_op \operator
 
  _lu_initialise_

  op__topology

  find: connectSE_StartMarker EV_M_START [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: connectSE :: connectSE ;

: connectSE_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <dedicatedThd> = 1
    <opEntry> = "connectSE_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
