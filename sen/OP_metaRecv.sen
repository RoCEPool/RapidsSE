/*============================================================================*/
/* OP_metaRecv.sen -- Operator meta recv                                      */
/*============================================================================*/

" OP_metaRecv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_PARCEL ...                                                         */
/*----------------------------------------------------------------------------*/
: metaRecv_Parcel \handler
  " metaRecv_Parcel" .

  Pipein[]\clear to Parcel[]  // pop the pParcel and put in the Parcel register

  // returns table ptr
  Parcel[]\clear MetaRecv::putParts locals| pTable |

  // get table name to create folder
  pTable table.getName locals| sTableNm |

  // sTableNm .

  path[].tostr .      // display the path

  sTableNm table::makeTableFolder
  sTableNm Path[].pushNamedTableFolder

  // put the table ptr to
  pTable table::addToFolder

  Path[].popNamedTableFolder

  true
;

/*----------------------------------------------------------------------------*/
/* execute for metaRecv request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaRecv_req \operator

  LogReqEntry SEED_REQ
  "metaRecv_req" .

  op__topology

  // Setup ZK_D_PARCEL handler here
  find: metaRecv_Parcel ZK_D_PARCEL op[].handler!

  op__loop

  LogReqExit
  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaRecv :: metaRecv ;

: metaRecv_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
