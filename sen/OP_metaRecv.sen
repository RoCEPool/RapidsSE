/*============================================================================*/
/* OP_metaRecv.sen -- Operator meta recv                                      */
/*============================================================================*/

" OP_metaRecv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PARCEL ...                                                           */
/*----------------------------------------------------------------------------*/
: metaRecv_Parcel \handler
  " metaRecv_Parcel"

  // pipe out ZK_STARTMARKER
  //PipeIn[].pipeOut

  Operand[].pipein  // pop the pParcel and put in the Operand register

  Operand[] MetaRecv::putParts

  // The result should be a table
  op::pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for metaRecv request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaRecv_req \operator

  LogReqEntry SEED_REQ
  "metaRecv_req" .

  op__topology

  // Setup ZK_PARCEL handler here
  find: metaRecv_Parcel ZK_PARCEL op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaRecv :: metaRecv ;

: metaRecv_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
