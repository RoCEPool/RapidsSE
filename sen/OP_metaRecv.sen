/*============================================================================*/
/* OP_metaRecv.sen -- Operator meta recv                                      */
/*============================================================================*/

" OP_metaRecv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_PARCEL ...                                                           */
/*----------------------------------------------------------------------------*/
: metaRecv_Parcel \handler
  " metaRecv_Parcel" .

  Operand[].pipein  // pop the pParcel and put in the Operand register

  // returns table ptr
  Operand[]\clear MetaRecv::putParts locals| pTable |

  // get table name to create folder
  pTable table.getName locals| sTableNm |

  // sTableNm .

  path[].tostr .      // display the path


  //sTableNm table::makeTableFolder
  //sTableNm Path[].pushNamedTableFolder

// check if tableNm is a word in tables folder
//  sTableNm word::isKnown not if discard EC_NO_SUCH_TABLE false exit then

// In this makeTableFolder, it has the following:
  //sTableNm table::makeNamedTableFolder
  //sTableNm Path[].pushNamedTableFolder
  //sTableNm "index::makeIndexesAssembly" find execute


  // put the table ptr to
  //pTable table::addToFolder
  //Path[].popNamedTableFolder

  //folder[].isTables assert
  "exiting" .
  true
;

/*----------------------------------------------------------------------------*/
/* execute for metaRecv request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaRecv_req \operator

  LogReqEntry SEED_REQ
  //"metaRecv_req" .

  op__topology

  // Setup ZK_PARCEL handler here
  find: metaRecv_Parcel ZK_PARCEL op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaRecv :: metaRecv ;

: metaRecv_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
