/*============================================================================*/
/* OP_compilerOpEg.sen -- Compiler Op Example                                  */
/*============================================================================*/

" OP_compilerOpEg.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: compilerOpEg_CancelMarker \handler

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: compilerOpEg_DataMarker \handler
 
  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: compilerOpEg_EosMarker \handler
 
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PLANNODE ...                                             */
/*----------------------------------------------------------------------------*/
: compilerOpEg_PlanNode \handler
 
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: compilerOpEg_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: compilerOpEg_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: compilerOpEg_CancelMarker ZK_CANCELMARKER op[].handler!
  find: compilerOpEg_DataMarker   ZK_DATAPULSE    op[].handler!
  find: compilerOpEg_EosMarker    ZK_EOSMARKER    op[].handler!
  find: compilerOpEg_PlanNode  ZK_PLANNODE  op[].handler!
  find: compilerOpEg_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: compilerOpEg :: compilerOpEg ;

: compilerOpEg_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
