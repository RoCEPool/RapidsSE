/*============================================================================*/
/* OP_compilerOpEg.sen -- Compiler Op Example                                 */
/*============================================================================*/

" OP_compilerOpEg.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: compilerOpEg_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: compilerOpEg_DataMarker \handler
 
  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: compilerOpEg_EosMarker \handler
 
  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: compilerOpEg_PlanNode \handler
 
  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: compilerOpEg_StartMarker \handler

  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: compilerOpEg_op \operator

  _lu_initialise_

  op__topology

  find: compilerOpEg_Cleaning      EV_M_CLEANING     [op].handler!
  find: compilerOpEg_DataMarker    EV_M_DATAPULSE    [op].handler!
  find: compilerOpEg_EosMarker     EV_M_EOS          [op].handler!
  find: compilerOpEg_PlanNode      EV_D_PLANOPERAND  [op].handler!
  find: compilerOpEg_StartMarker   EV_M_START        [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: compilerOpEg :: compilerOpEg ;

: compilerOpEg_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "compilerOpEg_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
