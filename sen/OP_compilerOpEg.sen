/*============================================================================*/
/* OP_compilerOpEg.sen -- Compiler Op Example                                 */
/*============================================================================*/

" OP_compilerOpEg.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: compilerOpEg_Cleaning \handler

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: compilerOpEg_DataMarker \handler
 
  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: compilerOpEg_EosMarker \handler
 
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: compilerOpEg_PlanNode \handler
 
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: compilerOpEg_StartMarker \handler

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: compilerOpEg_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: compilerOpEg_Cleaning      ZK_M_CLEANING     op[].handler!
  find: compilerOpEg_DataMarker    ZK_M_DATAPULSE    op[].handler!
  find: compilerOpEg_EosMarker     ZK_M_EOS          op[].handler!
  find: compilerOpEg_PlanNode      ZK_D_PLANOPERAND  op[].handler!
  find: compilerOpEg_StartMarker   ZK_M_START        op[].handler!

  op__loop

  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: compilerOpEg :: compilerOpEg ;

: compilerOpEg_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
