/*============================================================================*/
/* OP_eatSome.sen -- Eat Some Operators                                       */
/*============================================================================*/

" OP_eatSome.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_Xyz ...                                                              */
/*----------------------------------------------------------------------------*/
: OP_eatSome_Opr \handler

  //PipeIn[].kind "EATING : %v" .printf
  PipeIn[].delete
  true
;

/*----------------------------------------------------------------------------*/
/* eatSome request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: eatSome_req \operator

  find: OP_eatSome_Opr locals| pEatSomeHandler |

  LogReqEntry SEED_REQ

  // set topology, next stage and op
  op__topology

//  pEatSomeHandler ZK_CANCELMARKER     op[].handler!
//  pEatSomeHandler ZK_CANCELLEDMARKER  op[].handler!
    pEatSomeHandler ZK_CRWBUFFER        op[].handler!
    pEatSomeHandler ZK_CSVBUFFER        op[].handler!
//  pEatSomeHandler ZK_ENTBUFFER        op[].handler!
//  pEatSomeHandler ZK_EOSMARKER        op[].handler!
//  pEatSomeHandler ZK_ERRORMARKER      op[].handler!
//  pEatSomeHandler ZK_ERROREDMARKER    op[].handler!
//  pEatSomeHandler ZK_EXITMARKER       op[].handler!
//  pEatSomeHandler ZK_EXITEDMARKER     op[].handler!
//  pEatSomeHandler ZK_LOCKSTATS        op[].handler!
//  pEatSomeHandler ZK_NAMEDBUFFER      op[].handler!
//  pEatSomeHandler ZK_NODEINFO         op[].handler!
//  pEatSomeHandler ZK_PROFILE          op[].handler!
//  pEatSomeHandler ZK_PROGRESSUNITS    op[].handler!
//  pEatSomeHandler ZK_DATAPULSE        op[].handler!
//  pEatSomeHandler ZK_PULSEDMARKER     op[].handler!
    pEatSomeHandler ZK_ROWBUFFER        op[].handler!
//  pEatSomeHandler ZK_SEEKOFFSETS      op[].handler!
//  pEatSomeHandler ZK_SRTBUFFER        op[].handler!
//  pEatSomeHandler ZK_STARTMARKER      op[].handler!
//  pEatSomeHandler ZK_STARTEDMARKER    op[].handler!
//  pEatSomeHandler ZK_STREAMDEF        op[].handler!
//  pEatSomeHandler ZK_STREAMSET        op[].handler!
//  pEatSomeHandler ZK_TOTALUNITS       op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eatSome :: eatSome ;

: eatSome_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
