/*============================================================================*/
/* OP_eatSome.sen -- Eat Some Operators                                       */
/*============================================================================*/

" OP_eatSome.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_Xyz ...                                                              */
/*----------------------------------------------------------------------------*/
: OP_eatSome_Opr \handler

  //PipeIn[].kind "EATING : %v" .printf
  PipeIn[].delete
  true
;

/*----------------------------------------------------------------------------*/
/* eatSome request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: eatSome_req \operator

  find: OP_eatSome_Opr locals| pEatSomeHandler |

  LogReqEntry SEED_REQ

  // set topology, next stage and op
  op__topology

//  pEatSomeHandler ZK_M_CANCELLING     op[].handler!
//  pEatSomeHandler ZK_M_CANCELLED  op[].handler!
    pEatSomeHandler ZK_D_CRWBUFFER        op[].handler!
    pEatSomeHandler ZK_D_CSVBUFFER        op[].handler!
//  pEatSomeHandler ZK_M_LEAVE      op[].handler!
//  pEatSomeHandler ZK_M_LEAVING    op[].handler!
//  pEatSomeHandler ZK_M_LEFT       op[].handler!
//  pEatSomeHandler ZK_M_END        op[].handler!
//  pEatSomeHandler ZK_M_ENDED      op[].handler!
//  pEatSomeHandler ZK_M_ENDING     op[].handler!
//  pEatSomeHandler ZK_D_ENTBUFFER        op[].handler!
//  pEatSomeHandler ZK_M_EOS        op[].handler!
//  pEatSomeHandler ZK_M_ERROR      op[].handler!
//  pEatSomeHandler ZK_M_ERRORED    op[].handler!
//  pEatSomeHandler ZK_M_ERRORING   op[].handler!
//  pEatSomeHandler ZK_M_EXITING    op[].handler!
//  pEatSomeHandler ZK_M_EXITED     op[].handler!
//  pEatSomeHandler ZK_I_LOCKSTATS        op[].handler!
//  pEatSomeHandler ZK_D_NAMEDBUFFER      op[].handler!
//  pEatSomeHandler ZK_I_NODEINFO         op[].handler!
//  pEatSomeHandler ZK_D_PROFILE          op[].handler!
//  pEatSomeHandler ZK_I_PROGRESSUNITS    op[].handler!
//  pEatSomeHandler ZK_M_DATAPULSE        op[].handler!
    pEatSomeHandler ZK_D_ROWBUFFER        op[].handler!
//  pEatSomeHandler ZK_I_SEEKOFFSETS      op[].handler!
//  pEatSomeHandler ZK_D_SRTBUFFER        op[].handler!
//  pEatSomeHandler ZK_M_START      op[].handler!
//  pEatSomeHandler ZK_M_STARTED    op[].handler!
//  pEatSomeHandler ZK_D_STREAMDEF        op[].handler!
//  pEatSomeHandler ZK_D_STREAMSET        op[].handler!
//  pEatSomeHandler ZK_I_TOTALUNITS       op[].handler!

  op__loop

  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eatSome :: eatSome ;

: eatSome_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
