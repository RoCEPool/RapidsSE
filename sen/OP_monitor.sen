/*============================================================================*/
/* OP_monitor.sen -- Monitor Operator                                         */
/*============================================================================*/

" OP_monitor.sen" .verbose

/*----------------------------------------------------------------------------*/
/* put the monitors peridiodic activity here                                  */
/*----------------------------------------------------------------------------*/
: monitor::activity

  //"Monitor Activity" .
  
  // update node status based on heartbeat related info
  Monitor::updateNodeStatus
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: monitor_StartMarker \handler

  "Monitor Demon Started" .boot

  begin

    monitor::activity
    1 thread::sleepSsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/* execute for monitor req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: monitor::nigeb \operator
 
  _lu_initialise_

  op__topology

  find: monitor_StartMarker ZK_M_START op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: monitor :: monitor ;

: monitor_cmdTags _cmdTags tagCopy: serviceOp_tags

  tags{ <dedicatedThd> = 1 }

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
