/*============================================================================*/
/* op__EOcommon.sen -- EO operator common words                               */
/*============================================================================*/

" op__EOcommon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create the exec error info set for asm generation  errors                  */
/*----------------------------------------------------------------------------*/
: op__asmGenExecErr ( eError )

  params| eError |

  // cleanup
  //StreamDefLft[].delete
  //StreamDefOut[].delete

  // set EATOPERAND handler for buffers and EOS markers coming in
  find: EATOPERAND_handler ZK_D_CRWBUFFER [op].handler!
  find: EATOPERAND_handler ZK_D_EACHROWBUFFER [op].handler!
  find: EATOPERAND_handler ZK_D_ROWBUFFER [op].handler!
  find: EATOPERAND_handler ZK_M_EOS [op].handler!

  // generate the error infoset
  eError op__execErr
;

/*----------------------------------------------------------------------------*/
/* create an (int) index def                                                  */
/*----------------------------------------------------------------------------*/
: idxDef_int

  indexDefRlu[].new
  "idx_int" indexDefRlu[].name!
  CT_INTEGER "intA" indexDefRlu[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create an (int,int) index def                                              */
/*----------------------------------------------------------------------------*/
: idxDef_intInt

  indexDefRlu[].new
  "idx_intInt" indexDefRlu[].name!
  CT_INTEGER "intA" indexDefRlu[].addColumn
  CT_INTEGER "intB" indexDefRlu[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch) index def                                                   */
/*----------------------------------------------------------------------------*/
: idxDef_vch

  indexDefRlu[].new
  "idx_vch" indexDefRlu[].name!
  CT_VARCHAR "vchA" indexDefRlu[].addColumn
;

/*----------------------------------------------------------------------------*/
/* create a (vch,vch) index def                                               */
/*----------------------------------------------------------------------------*/
: idxDef_vchVch

  indexDefRlu[].new
  "idx_vchVch" indexDefRlu[].name!
  CT_VARCHAR "vchA" indexDefRlu[].addColumn
  CT_VARCHAR "vchB" indexDefRlu[].addColumn
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
