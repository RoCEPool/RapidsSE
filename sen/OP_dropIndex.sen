/*============================================================================*/
/* OP_dropIndex.sen -- Operator drop index                                    */
/*============================================================================*/

" OP_dropIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* drop an index entry in the metadata tables                                 */
/*----------------------------------------------------------------------------*/
: metadata_dropIndex params| sTableNm sIndexNm |

  sIndexNm sTableNm MetaDataTable[].dropIndex
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: dropIndex_StartMarker

  0 locals| errorCode |

  PipeIn[].pipeOut

  // check if we can drop the index
  //<indexNm> <tableNm> check::validIndexAssembly not if
  //  to errorCode
  //  errorCode op__execErr
  //then

  // check if we can find the index and the table
  <tableNm> <indexNm> op__table_index if
   // nothing to do
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: dropIndex_DestroyMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index
  <indexNm> <tableNm> index::dropIndex

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index from metadata tables
  <indexNm> <tableNm> metadata_dropIndex

  // delete the DESTROYMARKER
  PipeIn[].delete

  // pipeout an EOSMARKER
  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dropIndex req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropIndex_op \operator

  _lu_initialise_

  op__topology

  find: dropIndex_StartMarker   EV_M_START [op].handler!
  find: dropIndex_DestroyMarker EV_M_DESTROY [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropIndex :: dropIndex <tableNm> <indexNm> ;

: dropIndex_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "dropIndex_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
