/*============================================================================*/
/* OP_dropIndex.sen -- Operator drop index                                    */
/*============================================================================*/

" OP_dropIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: dropIndex_StartMarker

  // check if we can drop the index
  <indexNm> <tableNm> check::validIndexAssembly not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
  else
    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: dropIndex_DestroyMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the index
  <indexNm> <tableNm> index::dropIndex

  // delete the DESTROYMARKER
  PipeIn[].delete

  // pipeout an EOSMARKER
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dropIndex req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropIndex_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dropIndex_StartMarker   ZK_STARTMARKER op[].handler!
  find: dropIndex_DestroyMarker ZK_DESTROYMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropIndex :: dropIndex <tableNm> <indexNm> ;

: dropIndex _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
