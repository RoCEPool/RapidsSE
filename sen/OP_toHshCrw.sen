/*============================================================================*/
/* OP_toHshCrw.sen -- Convert ptn nst row buffers to hashed crw buffers       */
/*============================================================================*/

" OP_toHshCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                    DEFINITION */
/*----------------------------------------------------------------------------*/
: toHshCrw_StreamDef \handler

  PipeIn[] to StreamDef[]
  nullptr to PipeIn[]

  StreamDef[].duplicate to OperandB[]

  ToHshCrw[].create

  OperandB[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toHshCrw_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: toHshCrw_DataMarker \handler

  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toHshCrw_RowBuffer \handler

  PipeIn[] ToHshCrw[].convert
  nullptr to PipeIn[]

  grid::partitions 0
  do

    I ToHshCrw[].completed to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].appendClose
      OperandB[].pipeOut
      I ToHshCrw[].completed to OperandB[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toHshCrw_EosMarker \handler

  grid::partitions 0
  do

    I ToHshCrw[].dangling to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].appendClose
      OperandB[].pipeOut
      I ToHshCrw[].dangling to OperandB[]
    repeat

  loop

  StreamDef[].delete

  ToHshCrw[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRow request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toHshCrw_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toHshCrw_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toHshCrw_DataMarker ZK_DATAPULSE op[].handler!
  find: toHshCrw_RowBuffer   ZK_ROWBUFFER   op[].handler!
  find: toHshCrw_StartMarker ZK_STARTMARKER op[].handler!
  find: toHshCrw_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toHshCrw :: toHshCrw ;

: toHshCrw _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
