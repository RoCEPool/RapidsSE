/*============================================================================*/
/* OP_toHshCrw.sen -- Convert ptn nst row buffers to hashed crw buffers       */
/*============================================================================*/

" OP_toHshCrw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                    DEFINITION */
/*----------------------------------------------------------------------------*/
: toHshCrw_StreamDef \handler

  PipeIn[] to StreamDefLft[]
  nullptr to PipeIn[]

  StreamDefLft[].duplicate to OperandB[]

  ToHshCrw[].create

  OperandB[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toHshCrw_StartMarker \handler

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: toHshCrw_DataMarker \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toHshCrw_RowBuffer \handler

  PipeIn[] ToHshCrw[].convert
  nullptr to PipeIn[]

  ptnmap::ptnsInGrid 0
  do

    I ToHshCrw[].completed to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].appendClose
      OperandB[].pipeOut
      I ToHshCrw[].completed to OperandB[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: toHshCrw_EosMarker \handler

  ptnmap::ptnsInGrid 0
  do

    I ToHshCrw[].dangling to OperandB[]

    begin
      OperandB[].isNull not
    while
      OperandB[].appendClose
      OperandB[].pipeOut
      I ToHshCrw[].dangling to OperandB[]
    repeat

  loop

  StreamDefLft[].delete

  ToHshCrw[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRow request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toHshCrw_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toHshCrw_EosMarker   ZK_M_EOS   op[].handler!
  find: toHshCrw_DataMarker  ZK_M_DATAPULSE   op[].handler!
  find: toHshCrw_RowBuffer   ZK_D_ROWBUFFER   op[].handler!
  find: toHshCrw_StartMarker ZK_M_START op[].handler!
  find: toHshCrw_StreamDef   ZK_D_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toHshCrw :: toHshCrw ;

: toHshCrw_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
