cmdSyntax: reapCtl :: reapCtl <setting> ;

: reapCtl_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "reapCtl_op"
}
;
    
