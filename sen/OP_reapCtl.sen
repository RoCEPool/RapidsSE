/*============================================================================*/
/* OP_reapCtl.sen -- Reap control                                             */
/*============================================================================*/

" OP_reapCtl.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: reapCtl_action

  <setting> "disable" str.same if
    AM::reapDisable
  else
  <setting> "enable" str.same if
    AM::reapEnable
  then then
  
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: reapCtl :: reapCtl <setting> ;

: reapCtl_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "reapCtl_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
