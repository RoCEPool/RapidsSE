/*============================================================================*/
/* OP_getRows.sen -- get rows from rowbuffer and pipeout                      */
/*============================================================================*/

" OP_getRows.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                               EOS */
/*----------------------------------------------------------------------------*/
: getRows_Eos \handler

  Counter0[] "rowBuffers : %v" .printf
  Pipein[].pipeout
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                   ROWBUFFER */
/*----------------------------------------------------------------------------*/
: getRows_RowBuffer \handler

  //"Operand:- EV_D_ROWBUFFER" .verbose

  Pipein[]\clear to rowBuffer[]
  rowBuffer[].getRows to DataBuffer[]

  rowBuffer[].delete

  DataBuffer[].pipeout

  Counter0[] 1 + to Counter0[]

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for getRows req                                               SPAWN */
/*----------------------------------------------------------------------------*/
 : getRows_op \operator

  _lu_initialise_

  0 to Counter0[]

  op__topology

  find: getRows_RowBuffer  EV_D_ROWBUFFER [op].handler!
  find: getRows_Eos        EV_M_EOS [op].handler!
 
  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: getRows :: getRows ;

: getRows_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "getRows_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
