/*============================================================================*/
/* OP_metaScan.sen -- Operator meta scan                                      */
/*============================================================================*/

" OP_metaScan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: metaScan_seapi

  "metaScan_seapi" .
  
  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec Path[].set

  // find the __ table
  "__listContents" op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  // -- -- -- -- -- --
  
  PotRlu[].new

  MetaTable::listTables

  PotRlu[].pushBuffer

  PotRlu[].delete
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: metaScan_Cleaning \handler

  //Myvan: I don't think we need this
  //nullptr to Operand[]

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: metaScan_DataMarker \handler
 
  PipeIn[].pipeOut
  
  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  PotRlu[].new

  MetaTable::listTables
  
  PotRlu[].pipeoutCompleted
  PotRlu[].pipeoutDangling
  PotRlu[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send an eos marker (there was no data)
  Marker[].newEosMarker
  Marker[].pipeOut

  true
;


/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: metaScan_StartMarker \handler

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec Path[].set

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaScan_op \operator

  _lu_initialise_

  op__topology

  find: metaScan_Cleaning      EV_M_CLEANING   [op].handler!
  find: metaScan_DataMarker    EV_M_DATAPULSE  [op].handler!
  find: metaScan_StartMarker   EV_M_START      [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaScan :: metaScan <metaObjectNm> ;
cmdSyntax: metaScan :: metaScan <metaObjectNm> <metaSubNm> ;

: metaScan_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <streamDef>  = __listContents
    <opEntry> = "metaScan_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
