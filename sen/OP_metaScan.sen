/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
// ": metaScan_StartMarker" .

: metaScan_StartMarker \handler

  <metaObjectNm> op__table if
    Table[].tablePtn@ to tablePtn[]
    PipeIn[].pipeOut
  then

  //args.developer if
  //  1 debug::flag!
  //then

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metaScan_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: metaScan_CancelMarker ZK_CANCELMARKER op[].handler!
  find: metaScan_CrwBuffer    ZK_CRWBUFFER    op[].handler!
  find: metaScan_DataMarker  ZK_DATAPULSE  op[].handler!
  find: metaScan_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: metaScan :: metaScan <metaObjectNm> ;
cmdSyntax: metaScan :: metaScan <metaObjectNm> <rateSecs> ;

: metaScan_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
