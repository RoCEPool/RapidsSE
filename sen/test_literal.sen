/*============================================================================*/
/* test_literal.sen -- test sen literals                                      */
/*============================================================================*/

" test_literal.sen" .verbose

: test_literal \prompt


  1          "Integer %v" .printf
  "abc"      "String  %v" .printf
  12.34      "Decimal %v" .printf
  0.3141e1   "Float   %v" .printf
  0.34321e-1 "Float   %v" .printf

  false      "Boolean %v" .printf
  true       "Boolean %v" .printf

  see
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
