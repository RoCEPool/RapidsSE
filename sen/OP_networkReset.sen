/*============================================================================*/
/* op_networkReset.sen -- network reset                                       */
/*============================================================================*/

" op_networkReset.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: networkReset_action
  
  network::reset
  
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: networkReset :: networkReset ;

: networkReset_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 0

    <opEntry> = "networkReset_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
