/*============================================================================*/
/* dp_receiverSE.sen -- Receiver Demon for SE Adaptor                         */
/*============================================================================*/

" dp_receiverSE.sen" .verbose


/*----------------------------------------------------------------------------*/
/* pipeline/procedure text for receiver demon                                 */
/*----------------------------------------------------------------------------*/
procText:
  pipelineLocal receiverSE_procText
    tag "<pre_execute>" = "demon::install" endTag
  begin

    stage stageA on origin :
        start
      | recvSE
      | eatAll
      | stageA

  end
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
