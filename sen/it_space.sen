/*============================================================================*/
/* it_space.sen -- Define __space table                                       */
/*============================================================================*/

" it_space.sen" .verbose

: start::it_space

  // C_TDEF_SPACE
  
  STD_BOOTFORK_TAG
  "
  define table __space (
    nodeName      VARCHAR NOT NULL ,
    totalSpace    INTEGER NOT NULL ,
    totalSpaceStr VARCHAR NOT NULL ,
    inUseSpace    INTEGER NOT NULL ,
    inUseSpaceStr VARCHAR NOT NULL ,
    freeSpace     INTEGER NOT NULL ,
    freeSpaceStr  VARCHAR NOT NULL
  ) < infoSet > = 1 ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
