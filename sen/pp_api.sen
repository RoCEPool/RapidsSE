/*============================================================================*/
/* pp_api.sen -- define api procedures                                        */
/*============================================================================*/

" pp_api.sen" .verbose


/*----------------------------------------------------------------------------*/
/* api related procedures                                                     */
/*----------------------------------------------------------------------------*/

"  start::defProc_Api" .verbose

: start::defProc_Api

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // getRows
  
  STD_PATH_TAG
  "
  procedure getRows
    parameters $Table
  begin

  stage stageA on origin :
    start         |
    pulse once |
    stageB

  stage stageB on all partitions :
    scan $Table   |
    crwToRow      |
    stageC

  stage stageC on origin :
    output        |
    sink          |
    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // putRows
  
  STD_PATH_TAG
  "
  procedure putRows
    parameters $Table
  begin

  stage stageA on origin :
    start         |
    pulse once |
    input         |
    stageB localrobin

  stage stageB on all partitions on origin :
    toRow $Table  |
    toPtnRow      |
    toNstRow      |
    toHshCrw      |
    stageC hashcast

  stage stageC on all partitions :
    insert $Table |
    stageD

  stage stageD on origin :
    sink          |
    stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
