/*============================================================================*/
/* OP_rdCsvCyclic.sen -- read csv cyclically                                  */
/*============================================================================*/

" OP_rdCsvCyclic.sen" .verbose

/*----------------------------------------------------------------------------*/
/* catFile csvBuffer                                                          */
/*----------------------------------------------------------------------------*/
: rdCsvCyclic_catCsv

  csvBuffer::new to CsvBuffer[]

  CsvBuffer[] file0[] file.readChunk if
    file0[] file.tell "read a csv chunk (tell %v)" .printf
    CsvBuffer[].pipeOut

    "SLEEPING for 1 sec" .
    1 task::sleepSsec

    true
  else
    false
  then
;


/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                   INIT */
/*----------------------------------------------------------------------------*/
: rdCsvCyclic_DataMarker \handler

  PipeIn[].pipeOut

  file::new to file0[]

  <fileNm> OPEN_READ file0[] file.open if
    file0[] file.size <fileNm> "File %v opened (%v bytes)" .printf

    file0[] file.seekRndCsv

    <nTimes> >int 0 do

      task::yield

      begin
        // check for low memory
        attachMap::isLowMemory if
          EC_LOW_MEMORY op__execErr
          file0[].get file.close
          <fileNm> "File %v closed" .printf
          true
          exit
        then

        rdCsvCyclic_catCsv

      while repeat

      0 file0[] file.seek

      "SLEEPING for 1 secs" .
      1 task::sleepSsec
    loop

    file0[].get file.close
    <fileNm> "File %v closed" .printf

    Marker[].newEosMarker
    Marker[].pipeOut

  then

  true
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* rdCsvCyclic request                                                  SPAWN */
/*----------------------------------------------------------------------------*/
: rdCsvCyclic_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: rdCsvCyclic_DataMarker ZK_M_DATAPULSE op[].handler!

  op__loop

  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rdCsvCyclic :: rdCsvCyclic <fileNm> <nTimes> ;

: rdCsvCyclic_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
