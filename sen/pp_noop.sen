/*============================================================================*/
/* pp_noop.sen -- define a no-op procedure                                    */
/*============================================================================*/

" pp_noop.sen" .verbose


/*----------------------------------------------------------------------------*/
/* noop related procedures                                                    */
/*----------------------------------------------------------------------------*/

"  start::defProc_Noop" .verbose

: start::defProc_Noop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // noop

  STD_PATH_TAG
  "
  procedure noop
  begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on origin :
      output | sink | stageA

  end ;
  "
  procedure::add
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
