/*============================================================================*/
/* job_begun.sen -- begun 2pc job (pipeline coordination)                     */
/*============================================================================*/

" job_begun.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job_Begun back to originating node                                    */
/*----------------------------------------------------------------------------*/
: begun::replyToOrigin params| pJobParticipant |

  // "begun::replyToOrigin" .
  
  // new a temporary Job_Begun
  pJobParticipant job_Begun::new locals| pJob_Begun |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send the begun job
  pJobParticipant [job].originNodeNo@ pJob_Begun job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_Begun job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run this received Job_Begun on originating node  recv: job.spawn           */
/*----------------------------------------------------------------------------*/
: begun::begun


  // "begun::begun" .

  //
  // where:  On the originator node.
  // event:  A Job_Begun has been received from a participating node
  //         indicating the job has been received and put into the
  //         participating jobs list.
  // data:   The job will exist in the originating jobs list.
  // action: 1) find the job in the originating list;
  //         2) decrement its ack's remaining
  //         3) if all acks received distribute Job_Execute
  //

  [job] job.id@ locals| iJobId |

  0 0 0 0 locals| bAmDecider error iParticipantNode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the context of this __begun job

  // find the originating job
  iJobId ListedJob[].findOriginator discard

  // get the participant node from where this job_begun started
  [job] job.participantNode@ to iParticipantNode

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // process __begun job on this originating node

  // increment the number of __begun jobs received in api state
  ListedJob[] ssn::incBegun
  ListedJob[] ssn::traceSession

  // decrement the acks remaining in the originating job
  ListedJob[] job.dec2pcAcksRmg to bAmDecider

  // if there are acks remaining just exit
  bAmDecider not if
    ListedJob[].returnReference
    [job]:retire
    exit                                                         // *EARLY EXIT*
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // all job_begun's have been received, so this job is the decider

  [job].tscBegun

  // distribute Job_Execute to all participants
  ListedJob[] execute::distribute
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: begun :: begun ;

: begun_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "begun::begun"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
