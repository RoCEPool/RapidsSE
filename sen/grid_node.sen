/*============================================================================*/
/* grid_node.sen -- node routines                                             */
/*============================================================================*/

" grid_node.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check word is not a Node                                                   */
/*----------------------------------------------------------------------------*/
: name::isNotKnownNode ( "<NodeNm>" -- t|f )

  grid::findNode not if true exit then

  EC_NODE_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a makeable Node                                           */
/*----------------------------------------------------------------------------*/
: checkMakeNode ( "<NodeNm>" -- true | errorCode false )

  name::isNotKnownNode not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* test if this node is given originating node                                */
/*----------------------------------------------------------------------------*/
: node::isOrigin ( iOriginNode -- true|false )

  params| iOriginNode |

  0 locals| iThisNode  |

  grid::thisNode@ to iThisNode

  iThisNode iOriginNode == if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/* check node has enough buffers                                              */
/*----------------------------------------------------------------------------*/
: node::checkEnoughBuffers

  // return true if enough buffers, others return error code
  bp::freeBuffers C_LOW_BUFFERS > if
    true
  else
    EC_LOW_MEMORY
    false
  then
;

/*----------------------------------------------------------------------------*/
/* test node has enough buffers                                               */
/*----------------------------------------------------------------------------*/
: node::testEnoughBuffers

  // return true if enough buffers, others return error code
  bp::freeBuffers C_LOW_BUFFERS > if
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: node.isConnected ( pNode -- t|f )

  params| pNode |

  pNode node.sendSocket@ if
    true
  else
    false
  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
