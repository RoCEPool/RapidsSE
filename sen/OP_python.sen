/*============================================================================*/
/* OP_python.sen -- Operator python                                           */
/*============================================================================*/

" OP_python.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CSVBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: python_CsvBuffer \handler

  //"Operand:- ZK_D_CSVBUFFER" .verbose
  PipeIn[]\clear to CsvBuffer[]
  CsvBuffer[].csvData
  <pythonFunction> <pythonFile> Operand[].invokePython

  true
;

/*----------------------------------------------------------------------------*/
/* execute for python request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: python_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: python_CsvBuffer   ZK_D_CSVBUFFER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: python :: python <pythonFile> <pythonFunction> ;

: python_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
