/*============================================================================*/
/* OP_optimise.sen -- Operator optimise                                       */
/*============================================================================*/

" OP_optimise.sen" .verbose

/*----------------------------------------------------------------------------*/
/* HACK call the optimiser                                                    */
/*----------------------------------------------------------------------------*/
: _run_Optimiser

  "_run_Optimiser" .

  Text[] .

  Dynamo[].new

  Text[] Dynamo[].compile to ErrorCode[]
  Dynamo[].delete

  ErrorCode[] EC_NONE == not if
    // - error compile
    //"Error Compile" .
    exit
  then

  // + clean compile
  //"Clean Compile" .
  to PipeSpec[]

  Optimiser[].new
    PipeSpec[] Optimiser[].dissect
    //Optimiser[].optimise
    Optimiser[].weave to Text[] // discard
  Optimiser[].delete

  PipeSpec[].delete

  Dynamo[].delete
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: optimise_DataPulse \handler

  <etc> to Text[]

  // pipeline is 8

  8 Text[] str.clip "pipeline" str.same if
    "IS pipeline" .
  else
    "NOT pipeline" .

    file::new to File0[]

    Text[] OPEN_READ File0[] file.open if
      File0[] file.readText if
        to Text[]
      then
    then

    File0[] file.close
    nullptr to File0[]

  then

  //Text[] .

  _run_Optimiser

  //Text[] .

  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* execute for optimise req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : optimise_op \operator

  _lu_initialise_

  op__topology

  find: optimise_DataPulse     EV_M_DATAPULSE     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: optimise :: optimise <etc> ;

: optimise_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "optimise_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
