/*============================================================================*/
/* OP_docol.sen -- Operator docol                                             */
/*============================================================================*/

" OP_docol.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: docol_action

  <routineNm>
  >interpret

  begin
    depth while discard
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: docol :: docol <routineNm> ;

: docol_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
    
    <seedReq>   = "docol_req"
    <opEntry> = "docol_op"  <seedReq> = "docol_req"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
