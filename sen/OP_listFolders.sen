/*============================================================================*/
/* OP_listFolders.sen -- Operator list folder                                 */
/*============================================================================*/

" OP_listFolders.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lf_action

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a rowBuffer operand
  TableDef[] RowBuffer[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the infoSet for each word

  Folder[] dic.lastWord dup
  iterate                          // setup iteration of words

    object@ word.isaTable if
    "table"
    then

    object@ word.isaIndex if
    "index"
    then

    object@ isFolder if
      object@ execute dic.kindString@
    then

    object@ word.name@
    TableDef[] RowBuffer[].addListFolder not if
      RowBuffer[].pipeOut
      TableDef[] RowBuffer[].new
      object@ word.name@
      TableDef[] RowBuffer[].addListFolder assert
    then

    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the infoset
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lf :: lf ;

: lf_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listFolder
    <params>      = 0

    <opEntry> = "lf_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
