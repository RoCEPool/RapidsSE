/*============================================================================*/
/* OP_listFolders.sen -- Operator list folder                                 */
/*============================================================================*/

" OP_listFolders.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lf_action

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a streamSet operand
  streamSetTable[] streamSet[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the infoSet for each word

  Folder[] dic.lastWord dup
  iterate                          // setup iteration of words

    object@ word.isaTable if
    "table"
    then

    object@ word.isaIndex if
    "index"
    then

    object@ isFolder if
      object@ execute dic.kind@ word.name@
    then

    object@ word.name@
    streamSetTable[] StreamSet[].addListFolder not if
      StreamSet[].pipeOut
      streamSetTable[] streamSet[].new
      object@ word.name@
      streamSetTable[] StreamSet[].addListFolder assert
    then

    object@ word.prev object!      // step backwards thru words
  next

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lf :: lf ;

: lf_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listFolder
    <params>      = 0
    <seedReq>     = "lf_req"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
