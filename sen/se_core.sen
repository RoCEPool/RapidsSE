/*============================================================================*/
/* se_core.sen -- core words                                                  */
/*============================================================================*/

" se_core.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add 1 to integer on stack                                                  */
/*----------------------------------------------------------------------------*/
: 1+ 1 + ;

/*----------------------------------------------------------------------------*/
/* decrement integer on stack                                                 */
/*----------------------------------------------------------------------------*/
: 1- 1 - ;

/*----------------------------------------------------------------------------*/
/* allot n bytes of data in wsp of current word                               */
/*----------------------------------------------------------------------------*/
: ALLOT

  compiler::current@ word.allot discard
;

/*----------------------------------------------------------------------------*/
/* push size of cell                                                          */
/*----------------------------------------------------------------------------*/
: CELL

  8
;

/*----------------------------------------------------------------------------*/
/* create a new word using string on stack as name                            */
/*----------------------------------------------------------------------------*/
: :CREATE ( sWordNM -- )

  word::new compiler::current!
;

/*----------------------------------------------------------------------------*/
/* create a new word using next token as name                                 */
/*----------------------------------------------------------------------------*/
: CREATE:

  input::read input::chars :create
;

/*----------------------------------------------------------------------------*/
/* find a word using its name                                                 */
/*----------------------------------------------------------------------------*/
: FIND

  word::find
;

/*----------------------------------------------------------------------------*/
/* locate a word using a fip                                                  */
/*----------------------------------------------------------------------------*/
: LOCATE

  word::locate
;

/*----------------------------------------------------------------------------*/
/* begin a loop                                                               */
/*----------------------------------------------------------------------------*/
: BEGIN immediate

  HERE // push address of last cell of word
;

/*----------------------------------------------------------------------------*/
/* do a loop                                                                  */
/*----------------------------------------------------------------------------*/
: DO immediate

  POSTPONE 2>R // encode 2>r into future word
  HERE true    // push address of last cell & simple do
;

/*----------------------------------------------------------------------------*/
/* ?do a loop                                                                 */
/*----------------------------------------------------------------------------*/
: ?DO immediate

  POSTPONE 2>R   // encode 2>r into future word
  POSTPONE AHEAD
  false          // push address of last cell & simple do
;

/*----------------------------------------------------------------------------*/
/* unloop by dropping limit and index off rstack                              */
/*----------------------------------------------------------------------------*/
: UNLOOP immediate

  POSTPONE rdiscard
  POSTPONE rdiscard
;

/*----------------------------------------------------------------------------*/
/* iterate a loop                                                             */
/*----------------------------------------------------------------------------*/
: ITERATE immediate

  POSTPONE 2>R // encode 2>r into future word
  POSTPONE AHEAD
;

/*----------------------------------------------------------------------------*/
/* iterate a loop                                                             */
/*----------------------------------------------------------------------------*/
: ITERATE-WORDS immediate

  POSTPONE dic::root
  POSTPONE dic.lastWord

  POSTPONE DUP
  POSTPONE 2>R    // encode >r into future word
  POSTPONE AHEAD


  //HERE
  //POSTPONE AHEAD
;

/*----------------------------------------------------------------------------*/
/* get current iterate word                                                   */
/*----------------------------------------------------------------------------*/
: WORD@ immediate

  POSTPONE r0
;

/*----------------------------------------------------------------------------*/
/* iterate a loop                                                             */
/*----------------------------------------------------------------------------*/
: NEXT-WORD immediate

  //POSTPONE THEN
  //DISCARD


  POSTPONE object@
  POSTPONE word.prev
  POSTPONE object!
 
  //POSTPONE 1
  //POSTPONE NEXT+
  POSTPONE NEXT
;

/*----------------------------------------------------------------------------*/
/* define a constant                                                          */
/*----------------------------------------------------------------------------*/
: ,_ALT

  HERE ! CELL ALLOT
;

/*----------------------------------------------------------------------------*/
/* define a constant                                                          */
/*----------------------------------------------------------------------------*/
: CONSTANT

  CREATE:          // create a word using the next token in the input stream
  encode::push     // encode a push value of the value currently on the stack
  POSTPONE exit_rt // encode an exit into the created word
;

/*----------------------------------------------------------------------------*/
/* resolve IF supplying alternate execution                                   */
/*----------------------------------------------------------------------------*/
: ELSE immediate ( orig1 -- orig2 / -- )

  POSTPONE AHEAD // unconditional forward branch orig2
  1 CS-ROLL      // put orig1 back on top
  POSTPONE THEN  // resolve forward branch from orig1
;

/*----------------------------------------------------------------------------*/
/* conditional exit from loops                                                */
/*----------------------------------------------------------------------------*/
: WHILE immediate ( dest -- orig dest / flag -- )

  POSTPONE IF // conditional forward branch
  1 CS-ROLL   // keep dest on top
;

/*----------------------------------------------------------------------------*/
/* resolve a single WHILE and jump to BEGIN                                   */
/*----------------------------------------------------------------------------*/
: REPEAT immediate ( orig dest -- orig dest / flag -- )

  POSTPONE AGAIN // unconditional backward branch to dest
  POSTPONE THEN  // resolve forward branch from orig
;

/*----------------------------------------------------------------------------*/
/* initialise OFs counter                                                     */
/*----------------------------------------------------------------------------*/
0 CONSTANT CASE
true find: CASE word.immediate!

/*----------------------------------------------------------------------------*/
/* OF block                                                                   */
/*----------------------------------------------------------------------------*/
: OF immediate

  1+   // inc number of OFs
  >R   // save OFs counter

  POSTPONE OVER     // copy case value
  POSTPONE ==       // test case value against of value
  POSTPONE IF       // add conditional block (with orig on control stack)
  POSTPONE DISCARD  // discard case value within conditional block

  R> // restore OFs counter
;

/*----------------------------------------------------------------------------*/
/* ENDOF block                                                                */
/*----------------------------------------------------------------------------*/
: ENDOF immediate

  >R            // save OFs counter
  POSTPONE ELSE // add conditional block (with orig2 on control stack)
  R>            // restore OFs counter
;

/*----------------------------------------------------------------------------*/
/* ENDCASE block                                                              */
/*----------------------------------------------------------------------------*/
: ENDCASE immediate

  POSTPONE DISCARD // discard case value

  0 ?DO            // resolve all forward ENDOF branches
    POSTPONE THEN
  LOOP
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* forget word using next token as word name                                  */
/*----------------------------------------------------------------------------*/
: FORGET

  input::read input::chars word::find dup if
    word::delete
  else
    discard
  then
;


/*----------------------------------------------------------------------------*/
/* EXIT (optionally invoking exit hook)                                       */
/*----------------------------------------------------------------------------*/
: EXIT immediate

  compiler::current@ word.exitHook@ word::find dup if
    encode::call
  else
    discard
  then

  POSTPONE exit_rt
;

: eg_hook
   "eg_hook" .
;

: set_hook immediate

  "eg_hook"
  compiler::current@
  word.exitHook!
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* increment integer variable                                                 */
/*----------------------------------------------------------------------------*/
: ++ dup @ 1+ swap ! ;

/*----------------------------------------------------------------------------*/
/* decrement integer variable                                                 */
/*----------------------------------------------------------------------------*/
: -- dup @ 1- swap ! ;

/*----------------------------------------------------------------------------*/
/* define a constant (using name on stack)                                    */
/*----------------------------------------------------------------------------*/
: :constant

  // create a word using the string on top of the stack
  :create

  // encode a push value of the value currently on the stack
  encode::push

  // encode a push value of the value currently on the stack
  POSTPONE exit_rt
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* forget named word                                                          */
/*----------------------------------------------------------------------------*/
: :forget ( <"wordNm"> )

  find dup not if discard exit_rt then

  word::delete
;

/*----------------------------------------------------------------------------*/
/* discard all values on stack except topmost                                 */
/*----------------------------------------------------------------------------*/
: nipAll ( ... top -- top )

  // handle expty stack case
  depth not if exit_rt then

  // save topmost
  >r

  // discard everything else
  begin
    depth while
      discard
  repeat

  // restore topmost
  r>
;

/*----------------------------------------------------------------------------*/
/* discard n values from stack                                                */
/*----------------------------------------------------------------------------*/
: dropN ( ... #values -- )

  // handle expty stack case
  depth not if exit_rt then

  // discard n values
  0 ?do
    discard
  loop
;

////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* get nested Word$$<n>                                                       */
/*----------------------------------------------------------------------------*/

: Word$$    compiler::nested@ ;
: Word$$0 0 compiler::nested@ ;
: Word$$1 1 compiler::nested@ ;
: Word$$2 2 compiler::nested@ ;
: Word$$3 3 compiler::nested@ ;
: Word$$4 4 compiler::nested@ ;
: Word$$5 5 compiler::nested@ ;
: Word$$6 6 compiler::nested@ ;
: Word$$7 7 compiler::nested@ ;
: Word$$8 8 compiler::nested@ ;
: Word$$9 9 compiler::nested@ ;

/*----------------------------------------------------------------------------*/
/* start compiling nested word                                                */
/*----------------------------------------------------------------------------*/
: :NestedWord

  word::new dup compiler::current! compiler::nested!
;

/*----------------------------------------------------------------------------*/
/* end compiling nested word                                                  */
/*----------------------------------------------------------------------------*/
: ;NestedWord

  POSTPONE exit_rt

  0 compiler::nested@ compiler::current!
;

/*----------------------------------------------------------------------------*/
/* dump the return stack                                                      */
/*----------------------------------------------------------------------------*/
: rstk_w

  "return stack" .
  rdepth dup not if discard exit_rt then
  0 do
    I 2 + rpick
    dup .put
    " ".put
    locate
    dup if .put else discard then
    .\n
  loop
;

/*----------------------------------------------------------------------------*/
/* interpret string on stack                                                  */
/*----------------------------------------------------------------------------*/
: >interpret

   input::push
   input::useString
   input::senTokens
   input::useBegin

   interpret
 
   input::useEnd
   input::pop
;

/*----------------------------------------------------------------------------*/
/* test type of top stack value                                               */
/*----------------------------------------------------------------------------*/
: isType ( CN_ -- bool )

  // false if stack empty
  depth 2 >= not if discard false exit_rt then

  // no more if not indirect
  1 stack.class ==
;

/*----------------------------------------------------------------------------*/
/* formatted print     https://en.wikipedia.org/wiki/Printf_format_string     */
/*----------------------------------------------------------------------------*/
: .printf

  str.format .
;

/*----------------------------------------------------------------------------*/
/* formatted print     https://en.wikipedia.org/wiki/Printf_format_string     */
/*----------------------------------------------------------------------------*/
: .putf

  str.format .put
;


/*----------------------------------------------------------------------------*/
/* include a sub dir of sen files                                             */
/*----------------------------------------------------------------------------*/
: include-subdir

  params| sSubDir |

  0 locals| sFilePath |

  input::push

  args.senDir sSubDir str.cat dup

  "Would include .sen files from sub-dir %v" .printf

  dir::new locals| pSubDir |

  pSubDir dir.open if

    begin
      pSubDir dir.read
    while
      pSubDir dir.entryName "Entry %v" .printf

      4 pSubDir dir.entryName str.right ".sen" str.same if
        pSubDir dir.entryName "Would parse %v" .printf

        args.senDir sSubDir str.cat
          "/" str.cat
          pSubDir dir.entryName str.cat
          to sFilePath
        sFilePath "Would open %v" .printf

        sFilePath
          input::open
          input::useBegin
          interpret
          input::useEnd
          input::inspect
          input::close

      then

    repeat

    pSubDir dir.close
  then

  pSubDir dir.delete

  input::pop

;

/*----------------------------------------------------------------------------*/
/* stack should have zero values                                              */
/*----------------------------------------------------------------------------*/
: trap::stackDepthZero

  depth 0 == if exit_rt then

  task[] task.name@ "Stack of task %v has grown" .printf

  debug::trap
;

/*----------------------------------------------------------------------------*/
/* snooze briefly                                                             */
/*----------------------------------------------------------------------------*/
: snooze ( -- )

  C_1M thread::sleepNsec
;

/*----------------------------------------------------------------------------*/
/* put task into infinite snooze loop                                         */
/*----------------------------------------------------------------------------*/
: snoozeLoop

  begin
    "snoozing..." . snooze task::yield
  again
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
