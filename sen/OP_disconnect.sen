/*============================================================================*/
/* OP_disconnect.sen -- Client disconnect operator                            */
/*============================================================================*/

" OP_disconnect.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: disconnect_DataMarker \handler

  //"Operand:- EV_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // TODO: This operator can be extended to take a parameter being the session ID
  //       of the client session to be disconnected. The operator could then pipe
  //       a disconnect error to that session's pipeline to force it to disconnect.
  //       Currently the operator will simply emit an error which will end up with
  //       the current client's pipeline and cause the current client to disconnect.

  EC_WL_DISCONNECT_REQ attachmap::errorText@ "%v: self disconnection" str.format EC_WL_DISCONNECT_REQ op__execErrMsg
  Marker[].newEosMarker
  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* execute for disconnect req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : disconnect_op \operator

  _lu_initialise_

  op__topology

  find: disconnect_DataMarker EV_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: disconnect :: disconnect ;

: disconnect_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "client disconnect operator"
    <opEntry> = "disconnect_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
