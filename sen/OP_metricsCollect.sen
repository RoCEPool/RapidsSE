/*============================================================================*/
/* OP_metricsCollect.sen -- collect metrics                                   */
/*============================================================================*/

" OP_metricsCollect.sen" .verbose

/*----------------------------------------------------------------------------*/
/* collect and pipeout job metrics                                            */
/*----------------------------------------------------------------------------*/
: metricsCollectJob

  0 locals| iJob |

  LogicUnit[].intStack@ jobMetrics::jobSet

  LogicUnit[].intStack@ intStack.items@ if
    //LogicUnit[].intStack@ intStack.items@ "JobMetrics being collected for %v jobs" .printf
  then

  begin
    LogicUnit[].intStack@ intStack.items@
  while

    LogicUnit[].intStack@ intStack.pop to iJob
    //iJob "metricsDemon collecting job metrics for job %v" str.format .
    iJob jobMetrics.collect

  repeat
;

/*----------------------------------------------------------------------------*/
/* collect system metrics                                                     */
/*----------------------------------------------------------------------------*/
: metricsCollectSys

  //"collecting sys metrics" .
      
  SysMetrics::new attachmap::addSysMetrics
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: metricsCollect_Start

  // "metricsCollect_Start" .

  intStack::new LogicUnit[].intStack!

  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: metricsCollect_DataPulse

  begin

    // collect job metrics
    metricsCollectJob

    sysargs::sysMetrics@ if

      metricsCollectSys

    then


    // sleep
    sysargs::metricsSleep@ thread::sleepMsec

  again


  EV_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: metricsCollect_End

  PipeIn[].delete
  
  true
;

/*----------------------------------------------------------------------------*/
/* execute for metricsCollect_op                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metricsCollect_op \operator

  _lu_initialise_

  op__topology

  find: metricsCollect_Start       EV_M_START     [op].handler!
  find: metricsCollect_DataPulse   EV_M_DATAPULSE [op].handler!
  find: metricsCollect_End         EV_M_END       [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: metricsCollect :: metricsCollect ;

: metricsCollect_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "metricsCollect_op"
    
    <dedicatedThd> = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
