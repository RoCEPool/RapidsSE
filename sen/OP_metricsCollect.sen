/*============================================================================*/
/* OP_metricsCollect.sen -- collect metrics                                   */
/*============================================================================*/

" OP_metricsCollect.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: metricsCollect_Start

  // "metricsCollect_Start" .

  intStack::new LogicUnit[].intStack!
  
  
  //LogicUnit[].intStack@ intStack.delete
  //nullptr LogicUnit[].intStack!


  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: metricsCollect_DataPulse

  0 locals| iJob |
  
  begin

    //"metricsCollect_DataPulse" .
    
    LogicUnit[].intStack@ jobMetrics::jobSet
  
    //LogicUnit[].intStack@ intStack.items@ "intStack has %v items" .printf

    begin
      LogicUnit[].intStack@ intStack.items@
    while
      LogicUnit[].intStack@ intStack.pop to iJob
      
      iJob jobMetrics::new LogicUnit[].jobMetrics!
      
      LogicUnit[].jobMetrics@ jobMetrics.collect discard
      
      LogicUnit[].jobMetrics@ jobMetrics.delete
      nullptr LogicUnit[].jobMetrics!
    repeat


    
    3 thread::sleepSsec

  again

  ZK_M_DATAPULSE_handler

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: metricsCollect_End

  PipeIn[].delete
  
  true
;

/*----------------------------------------------------------------------------*/
/* execute for metricsCollect_op                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: metricsCollect_op \operator

  _lu_initialise_

  op__topology

  find: metricsCollect_Start       ZK_M_START     op[].handler!
  find: metricsCollect_DataPulse   ZK_M_DATAPULSE op[].handler!
  find: metricsCollect_End         ZK_M_END       op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: metricsCollect :: metricsCollect ;

: metricsCollect_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "metricsCollect_op"
    
    <dedicatedThd> = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
