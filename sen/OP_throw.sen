/*============================================================================*/
/* OP_throw.sen -- throw a C++ excpetion                                      */
/*============================================================================*/

" OP_Throw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_CRWBUFFER ...                                                      */
/*----------------------------------------------------------------------------*/
: throw_throw \handler

  //[task].seeFrameStack
  
  inject::throw

  HAZARD
  
  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* throw request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: throw_op \operator

  _lu_initialise_

  op__topology

  find: throw_throw  EV_D_CRWBUFFER  [op].handler!

  op__loop

  // "*** throw_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: throw :: throw ;

: throw_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "throw_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
