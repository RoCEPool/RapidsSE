/*============================================================================*/
/* OP_throw.sen -- throw a C++ excpetion                                      */
/*============================================================================*/

" OP_Throw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_Xyz ...                                                              */
/*----------------------------------------------------------------------------*/
: throw_throw \handler

  debug::throw

  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* throw request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: throw_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: throw_throw  ZK_CRWBUFFER  op[].handler!

  op__loop

  // "*** throw_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: throw :: throw ;

: throw_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
