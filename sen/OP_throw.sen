/*============================================================================*/
/* OP_throw.sen -- Eat All Operators                                         */
/*============================================================================*/

" OP_Throw.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_Xyz ...                                                              */
/*----------------------------------------------------------------------------*/
: throw_Xyz \handler

  true
;

/*----------------------------------------------------------------------------*/
/* throw request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: throw_req \operator

  LogReqEntry SEED_REQ

  // set topology, next stage and op
  op__topology

  op__loop

  "*** throw_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: throw :: throw ;

: throw_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
