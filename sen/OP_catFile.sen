/*============================================================================*/
/* OP_catFile.sen -- cat file                                                 */
/*============================================================================*/

" OP_catFile.sen" .verbose

/*----------------------------------------------------------------------------*/
/* catFile csvBuffer                                                          */
/*----------------------------------------------------------------------------*/
: catFile_csvBuffer

  csvBuffer::new to CsvBuffer[]

  CsvBuffer[] file0[] file.readChunk if
    file0[] file.tell "read a csv chunk (tell %v)" .printf
    CsvBuffer[].pipeOut
    true
  else
    CsvBuffer[].delete
    false
  then
;

/*----------------------------------------------------------------------------*/
/* catFile action                                                             */
/*----------------------------------------------------------------------------*/
: catFile_action

  file::new to file0[]

  <fileNm> OPEN_READ file0[] file.open if
    file0[] file.size <fileNm> "File %v opened (%v bytes)" .printf

    //file0[] file.seekRndCsv

    begin
      // check for low memory
      attachMap::isLowMemory if
        EC_LOW_MEMORY op__execErr
        file0[].get file.close
        <fileNm> "File %v closed" .printf
        true
        exit
      then

      catFile_csvBuffer

    while repeat

    file0[].get file.close
    <fileNm> "File %v closed" .printf
  then

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: catFile :: catFile <FileNm> ;

: catFile_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
    
    <opEntry> = "catFile_op"  <seedReq> = "catFile_req"
  }
;

