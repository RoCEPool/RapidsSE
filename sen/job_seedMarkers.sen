/*============================================================================*/
/* job_seedMarkers.sen -- Job Seed Marker words                               */
/*============================================================================*/

" job_seedMarkers.sen" .verbose

0 constant JM_SEED_RUN
1 constant JM_SEED_REQ
2 constant JM_SEED_RCV
3 constant JM_SEED_EXE
4 constant JM_SEED_END
5 constant JM_SEED_CAN

/*----------------------------------------------------------------------------*/
/* category of words which are seeds                                          */
/*----------------------------------------------------------------------------*/
: seed

;

/*----------------------------------------------------------------------------*/
/* sets the category of word being being compiled as seed                     */
/*----------------------------------------------------------------------------*/
: word::seed#

  find: seed senCompiler::current@ word.category!
;



/******************************************************************************/
/***                              Done Markers                              ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* done executing any seed                                                    */
/*----------------------------------------------------------------------------*/
: _job_finalise_ ( -- )

  // check this task has no job reference
  JobRef[].none

  // check this task has no ddl lock
  DdlLock[].none
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/



/******************************************************************************/
/***                                  Misc                                  ***/
/******************************************************************************/


/*----------------------------------------------------------------------------*/
/* job has encountered an error                                               */
/*----------------------------------------------------------------------------*/
: job::error! params| errorCode |

  DdlLock[].testDrop

  errorCode job[] job.error!
;






/*----------------------------------------------------------------------------*/
/***                              - Exit Hooks -                            ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* exit hook for request seed                                                 */
/*----------------------------------------------------------------------------*/
: req_exitHook

  // "req_exitHook" .

  DdlLock[].testDrop

  _job_finalise_
;

/*----------------------------------------------------------------------------*/
/* exit hook for begin seed                                                   */
/*----------------------------------------------------------------------------*/
: beg_exitHook

  // "beg_exitHook" .

  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for execute seed                                                 */
/*----------------------------------------------------------------------------*/
: exe_exitHook

  // "exe_exitHook" .

  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for end seed                                                     */
/*----------------------------------------------------------------------------*/
: end_exitHook

  // "end_exitHook" .

  DdlLock[].testDrop

  _job_finalise_

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for cancel seed                                                  */
/*----------------------------------------------------------------------------*/
: can_exitHook

  // "can_exitHook" .

  _job_finalise_

 job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* exit hook for run seed                                                     */
/*----------------------------------------------------------------------------*/
: run_exitHook

  //"run_exitHook" .

  DdlLock[].testDrop

  _job_finalise_

  job::completed

  HAZARD
;


/*----------------------------------------------------------------------------*/
/* exit hook for standard seeds                                               */
/*----------------------------------------------------------------------------*/
: std_exitHook

  //"std_exitHook" .
;

/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: std_recoveryWord

  //"std_recoveryWord" .
  
  //task::exception .

  "op__failureRecovery" FIND execute
  
  //process::quit

  //HAZARD
;








/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
