/*============================================================================*/
/* OP_toRow.sen -- Convert csv buffers to row buffers                         */
/*============================================================================*/

" OP_toRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toRow_StartMarker \handler

  // test and create Table[] using <tableNm>
  <tableNm> op__table if

    // create a ToRow using Table[].streamDef
    ToRow[].create

    // pipeout the (StartMarker)
    PipeIn[].pipeOut

    // new and pipe out (StreamDef)  DOES NOT SET StreamDefLft[]??
    Operand[].newStreamDef
    Operand[].pipeOut

  then
  
  
  // find the __loadResult table def
  C_TDEF_LOADRESULT op__tableDef_infoSet assert
  
  
  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CSVBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toRow_CsvBuffer \handler

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  //Operand[]
  //profile.start

  Operand[].csvToRow

  //profile.end

  // test for any completed
  ToRow[].completed to OperandB[]
  begin
    OperandB[].isNull not
  while
    OperandB[].pipeOut
    ToRow[].completed to OperandB[]
  repeat

  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toRow_EosMarker \handler

  // test for any remainders
  ToRow[].dangling to OperandB[]
  begin
    OperandB[].isNull not
  while
    OperandB[].pipeOut
    ToRow[].dangling to OperandB[]
  repeat


  // -- -- -- -- -- --
  // pipeout load results
  
  infoSetTable[] InfoSet[].new
  OI_LOADRESULT InfoSet[].opInfoset!
  
  ToRow[].rowCounters@@ 3 InfoSet[].addRowVargs

  InfoSet[].pipeOut


  // -- -- -- -- -- --

  // delete ToRow
  ToRow[].delete

  // get the profile from the task
  //task[] task.profile@ to Operand[]
  //nullptr task[] task.profile!
  //Operand[].pipeOut

  // pipeout the (EosMarker)
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRow request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toRow_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toRow_CsvBuffer   ZK_D_CSVBUFFER   op[].handler!
  find: toRow_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toRow_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toRow :: toRow <tableNm> ;

: toRow_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
