/*============================================================================*/
/* md_columns.sen -- Define md__columns table                                   */
/*============================================================================*/

" md_columns.sen" .verbose

: start::md_columns

  // C_TDEF_COLUMNS

  STD_BOOTFORK_TAG
  "
  define table columns (
    szCatalogName    VARCHAR NOT NULL ,
    szSchemaName     VARCHAR NOT NULL ,
    szTableName      VARCHAR NOT NULL ,
    iType            INTEGER NOT NULL ,
    iScale           INTEGER NOT NULL ,
    iPrecision       INTEGER NOT NULL ,
    bNullable        BOOLEAN NOT NULL
  ) < metaData > = MetaDataTable[].columns ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
