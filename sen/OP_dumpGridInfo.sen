" OP_dumpGridInfo.sen" .verbose


/*----------------------------------------------------------------------------*/
/* dumpGridInfo act ion                                                       */
/*----------------------------------------------------------------------------*/
: dumpGridInfo_action

  grid::dumpInfo locals| pDumpBuffer |
  //pDumpBuffer .

  // convert the string to operand to pipe out
  pDumpBuffer str.toPromptOut op::pipeOut

  true
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dumpGridInfo :: dumpGridInfo  ;

: dumpGridInfo_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 0
    <seedReq>     = "dumpGridInfo_req"
    <opEntry> = "dumpGridInfo_op"  <seedReq> = "dumpGridInfo_req"
  }
;



