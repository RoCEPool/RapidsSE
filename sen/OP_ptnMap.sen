/*----------------------------------------------------------------------------*/
cmdSyntax: ptnMap :: ptnMap ;

: ptnMap_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 0

    <opEntry> = "ptnMap_op"
  }
;
    
