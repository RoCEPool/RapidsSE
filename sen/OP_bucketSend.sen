/*============================================================================*/
/* OP_bucketSend.sen -- Operator bucket send                                  */
/*============================================================================*/

" OP_bucketSend.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_BUCKETGET ...                                                      */
/*----------------------------------------------------------------------------*/
: bktSend0_bktGet \handler

 "bktSend0_bktGet handler" .

  Pipein[]\clear to BucketGet[]  // pop the pBucket and put in the Bucket register

  // then call C++ getBucketCrw to build the rows and push the rows to the stack via parcel

  BucketGet[].getBucketCrw Op::pipeout

  BucketGet[].delete
  nullptr to BucketGet[]

  true

  //task::breakpoint //set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for bucketsend0 request                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: bktSend0_op \operator

  _lu_initialise_
  "bktSend0_req" .

  op__topology

  // Setup ZK_D_BUCKETGET handler
  find: bktSend0_bktGet ZK_D_BUCKETGET op[].handler!
  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: bktSend0 :: bktSend0 ;

: bktSend0_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "bktSend0_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
