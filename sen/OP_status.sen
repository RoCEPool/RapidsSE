/*============================================================================*/
/* OP_status.sen -- Operator status                                           */
/*============================================================================*/

" OP_status.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: status_action

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  // add nodeStatus to the Pds
  Pds[].addNodeStatus assert

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: status :: status ;

: status_cmdTags _cmdTags tagCopy: localliteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __status
    <params>    = 0
    
    <opEntry> = "status_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
