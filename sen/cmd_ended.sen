/*============================================================================*/
/* cmd_ended.sen -- 1sc: given pipeline has ended on participant              */
/*============================================================================*/

" cmd_ended.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                    ON ORIGINATING NODE OF GIVEN PIPELINE                   //
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* run received Job_Ended on originating node                                 */
/*----------------------------------------------------------------------------*/
: ended:ended

  // "ended:ended" .

  // find the originating job
  [job].parentId@ ListedJob[].findOriginator? discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ListedJob[].task@ task.ack
  
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: ended :: ended ;

: ended_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "ended:ended"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
