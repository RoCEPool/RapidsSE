/*============================================================================*/
/* cmd_ended.sen -- 1sc: given pipeline has ended on participant              */
/*============================================================================*/

" cmd_ended.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                    ON ORIGINATING NODE OF GIVEN PIPELINE                   //
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/
: ended:onOrigin
  //"ended:onOrigin" .

/* <edd org */  [args].distJob if
/* <edd org */    "ended" "onOrigin" "<edd org ack origin task" "r" [job].trace
/* <edd org */  then
/* <edd org */
/* <edd org */  // find the originating job
/* <edd org */
/* <edd org */  [job].originId@ ListedJob[].findOriginator? if
/* <edd org */
/* <edd org */    ListedJob[].taskAck
/* <edd org */
/* <edd org */    ListedJob[].returnReference
/* <edd org */
/* <edd org */  then
/* <edd org */
/* <edd org */  [job]:retireAndExit
/* <edd org */  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
//                    ON ORIGINATING NODE OF GIVEN PIPELINE                   //
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: ended:ended
  //"ended:ended" .

/* <edd ptp */  [args].distJob if
/* <edd ptp */    "ended" "ended" "<edd ptp snd origin" "r" [job].trace
/* <edd ptp */  then
/* <edd ptp */
/* <edd ptp */
/* <edd ptp */  "ended:onOrigin" [job].entryPoint!
/* <edd ptp */
/* <edd ptp */  [job].originNodeId@ [grid].findNodeByNo to SendNode[]
/* <edd ptp */
/* <edd ptp */  [job] job(Id).send
/* <edd ptp */
/* <edd ptp */  nullptr to SendNode[]
/* <edd ptp */
/* <edd ptp */  [job]:retireAndExit
/* <edd ptp */  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: ended :: ended ;

: ended_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "ended:ended"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
