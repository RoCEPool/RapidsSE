/*============================================================================*/
/* cmd_ended.sen -- 1sc: given pipeline has ended on participant              */
/*============================================================================*/

" cmd_ended.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                    ON ORIGINATING NODE OF GIVEN PIPELINE                   //
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/
: ended:onOrigin

  //"ended:onOrigin" .

  // find the originating job
  
  [job].distId@ ListedJob[].findOriginator? if

    ListedJob[].taskAck
  
    ListedJob[].returnReference
    
  then
  
  [job]:retire
  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
//                    ON ORIGINATING NODE OF GIVEN PIPELINE                   //
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* run received Job_Ended on originating node                                 */
/*----------------------------------------------------------------------------*/
: ended:ended

  //"ended:ended" .

  "ended:onOrigin" [job].entryPoint!

  [job].parentOriginNodeId@ [grid].findNodeByNo to SendNode[]
  
  [job] job(Id).send

  nullptr to SendNode[]
  
  [job]:retire
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: ended :: ended ;

: ended_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "ended:ended"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
