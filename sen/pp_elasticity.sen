/*============================================================================*/
/* pp_elasticity.sen -- define elasticity procedures                          */
/*============================================================================*/

" pp_elasticity.sen" .verbose


/*----------------------------------------------------------------------------*/
/* elasticity procedures                                                      */
/*----------------------------------------------------------------------------*/

"  start::defProc_Elasticity" .verbose

: start::defProc_Elasticity

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // add node
  
  STD_PATH_TAG
  "
  procedure add node
    parameters $NodeNm $IpAddr $PortNo
  begin

    stage stageA on origin :

      start
        | pulse once
        | stageB

    stage stageB on all nodes :

      addNode $NodeNm $IpAddr $PortNo
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // adjust partitions
  
  STD_PATH_TAG
  "
  procedure adjust partitions
  begin

    stage stageA on origin :

      start
        | pulse once
        | stageB

    stage stageB on all nodes :

      adjustPtns
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove node
  
  STD_PATH_TAG
  "
  procedure remove node
    parameters $NodeNm
  begin

    stage stageA on origin :

      start | pulse once
            | removeNode $NodeNm
            | output
            | sink
            | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn node
  
  STD_PATH_TAG
  "
  procedure spawn node
    parameters $NodeNm
  begin

    stage stageA on origin :

      start | pulse once
            | spawnNode $NodeNm
            | output
            | sink
            | stageA

  end ;
  "
  procedure::add

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // prototype assertGrid

  STD_PATH_TAG
  "
  procedure assertGrid
  begin

    stage stageA on origin :
      start | pulse once | gridGet | stageB hashed

      // prototyping, on the same machine
      //stage stageB on all nodes :                gridSend | gridRecv | stageC
      //stage stageC on origin :                noop | sink | stageA

    stage stageB on all nodes :
          gridSend | stageC

    stage stageC on origin :
          gridRecv | output | sink | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump grid info

  STD_PATH_TAG
  "
  procedure dumpGrid
  begin
    stage stageA on origin :
      start | pulse once | dumpGridInfo  | output | sink | stageA

  end ;
  "
  procedure::add

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 //  dump table meta info

  STD_PATH_TAG
  "
  procedure dumpMeta
    parameters $TableNm
  begin
    stage stageA on origin :
      start | pulse once | dumpMetaInfo $TableNm  | output | sink | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump bucket info

  STD_PATH_TAG
  "
  procedure dumpBucket
    parameters $TableNm
  begin
    stage stageA on origin :
      start | pulse once | dumpBktInfo $TableNm | output | sink | stageA

  end ;
  "
  procedure::add

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 //  dump table bucket map

  STD_PATH_TAG
  "
  procedure dumpBucketMap
    parameters $TableNm
  begin
    stage stageA on origin :
      start | pulse once | dumpBktMap $TableNm  | output | sink | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get bucket object, for prototyping, use two table params $TableNm1 -> $TableNm2
  STD_PATH_TAG
  "
  procedure getBucket
    parameters $TableNm1 $TableNm2
  begin

    stage stageA on origin :
      start | pulse once | bucketGet $TableNm1 | stageB

    stage stageB on all partitions :
      bucketSend $TableNm1 | stageC

    stage stageC on all partitions :
      insert $TableNm2 | stageD

    stage stageD on origin :
       sink | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get meta object
  
  STD_PATH_TAG
  "
  procedure getMeta
    parameters $TableNm
  begin

    stage stageA on origin :
      start | pulse once | metaGet $TableNm | stageB

    stage stageB on next node :
      metaSend | stageC

    stage stageC on origin :
      metaRecv | output | sink | stageA
      //noop | sink | stageA

  end ;
  "
  procedure::add

;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get updated bucket map for a table

  STD_PATH_TAG
  "
  procedure getBktMap
    parameters $TableNm
  begin

    stage stageA on origin :
      start | pulse once | bktMapGet $TableNm | stageB

    stage stageB on next node :
      bktMapSend | stageC

    stage stageC on all nodes :
      bktMapRecv | stageD

    stage stageD on origin :
       sink | stageA

  end ;
  "
  procedure::add

;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get bucket # from table

  STD_PATH_TAG
  "
  procedure getBkt
    parameters $TableNm $BktNo
  begin

    stage stageA on origin :
      start | pulse once | bktGet $TableNm $BktNo | stageB

    stage stageB on next node :
      bktSend | stageC

    // for debug in one machine
    //stage stageB on next node :
    //  bktSend | bktRecv | stageD

    stage stageC on origin :
      bktRecv | stageD

    stage stageD on origin :
      sink | stageA

  end ;
  "
  procedure::add


// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get bucket start from 0 of a table

  STD_PATH_TAG
  "
  procedure getBkt0
    parameters $TableNm
  begin

    stage stageA on origin :
      start | pulse once | bktGet0 $TableNm | stageB

    stage stageB on next node :
      bktSend | stageC

    // for debug in one machine
    //stage stageB on next node :
    //  bktSend | bktRecv | stageD

    stage stageC on origin :
      bktRecv | stageD

    stage stageD on origin :
      sink | stageA

  end ;
  "
  procedure::add

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete rows from bucket # of a table

  STD_PATH_TAG
  "
  procedure delBktRow
    parameters $TableNm $BktNo
  begin

    stage stageA on origin :
      start | pulse once | bktGet $TableNm $BktNo | stageB

    stage stageB on next node :
      bktRowDel | stageD

    // for debug in one machine
    //stage stageB on next node :
    //  bktRowDel | bktStatus | stageD

    //stage stageC on origin :
    //  bktStatus | stageD

    stage stageD on origin :
      sink | stageA

  end ;
  "
  procedure::add

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get bucket(s) for all tables

  STD_PATH_TAG
    "
    procedure getAllTableBkts
    begin

      stage stageStart on origin :
        start
        | pulse once
        | next

      stage stageA on next node :
        metaTables
        | next

      stage stageA on origin :
        callProc \"getbkt0\"
        | next

      stage stageLast on origin :
        output
        | sink
        | stageStart

    end ;
    "
    procedure::add

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get all metadata for user tables

  STD_PATH_TAG
    "
    procedure getAllTables
    begin

      stage stageStart on origin :
        start
        | pulse once
        | next

      stage stageA on next node :
        metaTables
        | next

      stage stageA on origin :
        callProc \"getmeta\"
        | next

      stage stageLast on origin :
        output
        | sink
        | stageStart

    end ;
    "
    procedure::add

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get all bucketmap for user tables

  STD_PATH_TAG
    "
    procedure getAllBktMaps
    begin

      stage stageStart on origin :
        start
        | pulse once
        | next

      stage stageA on next node :
        metaTables
        | next

      stage stageA on origin :
        callProc \"getbktmap\"
        | next

      stage stageLast on origin :
        output
        | sink
        | stageStart

    end ;
    "
    procedure::add

  ;
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
