/*============================================================================*/
/* pp_elasticity.sen -- define elasticity procedures                          */
/*============================================================================*/

" pp_elasticity.sen" .verbose


/*----------------------------------------------------------------------------*/
/* elasticity procedures                                                      */
/*----------------------------------------------------------------------------*/

"  start::defProc_Elasticity" .verbose

: start::defProc_Elasticity

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // add node
  
  STD_PATH_TAG
  "
  procedure add node
    parameters $NodeNm $IpAddr $PortNo $PortNoWL
  begin

    stage stageA on origin :

      start
        | pulse once
        | stageB

    stage stageB on all nodes :

      addNode $NodeNm $IpAddr $PortNo $PortNoWL
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // adjust partitions
  
  STD_PATH_TAG
  "
  procedure adjust partitions
  begin

    stage stageA on origin :

      start
        | pulse once
        | stageB

    stage stageB on all nodes :

      adjustPtns
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove node
  
  STD_PATH_TAG
  "
  procedure remove node
    parameters $NodeNm
  begin

    stage stageA on origin :

      start | pulse once
            | removeNode $NodeNm
            | output
            | sink
            | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn node
  
  STD_PATH_TAG
  "
  procedure spawn node
    parameters $NodeNm
  begin

    stage stageA on origin :

      start | pulse once
            | spawnNode $NodeNm
            | output
            | sink
            | stageA

  end ;
  "
  procedure::add

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // prototype assertGrid

  STD_PATH_TAG
  "
  procedure assertGrid
  begin

    stage stageA on origin :
      start | pulse once | gridGet | stageB hashed

      // prototyping, on the same machine
      //stage stageB on all nodes :                gridSend | gridRecv | stageC
      //stage stageC on origin :                noop | sink | stageA

    stage stageB on all nodes :
          gridSend | stageC

    stage stageC on origin :
          gridRecv | output | sink | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump grid info

  STD_PATH_TAG
  "
  procedure dumpGrid
  begin
    stage stageA on origin :
      start | pulse once | dumpGridInfo  | output | sink | stageA

  end ;
  "
  procedure::add

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 //  dump table meta info

  STD_PATH_TAG
  "
  procedure dumpMeta
    parameters $TableNm
  begin
    stage stageA on origin :
      start | pulse once | dumpMetaInfo $TableNm  | output | sink | stageA

  end ;
  "
  procedure::add

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get meta object
  
  STD_PATH_TAG
  "
  procedure getMeta
    parameters $TableNm
  begin

    stage stageA on origin :
      start | pulse once | metaGet $TableNm | stageB

    stage stageB on next node :
      metaSend | stageC

    stage stageC on origin :
      metaRecv | output | sink | stageA
      //noop | sink | stageA

  end ;
  "
  procedure::add

;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get all metadata for user tables

  STD_PATH_TAG
    "
    procedure getAllTables
    begin

      stage stageStart on origin :
        start
        | pulse once
        | next

      stage stageA on next node :
        metaTables
        | next

      stage stageA on origin :
        callProc \"getmeta\"
        | next

      stage stageLast on origin :
        output
        | sink
        | stageStart

    end ;
    "
    procedure::add

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
