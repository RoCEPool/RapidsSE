/*============================================================================*/
/* OP_createTable.sen -- Operator create table                                */
/*============================================================================*/

" OP_createTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if <tableNm> is a creatable table                                    */
/*----------------------------------------------------------------------------*/
: createTable::checkCreate ( -- true | false )

  params| sTableNm |

  // check in tables folder: ../schemas/public/tables
  check::folderIsTables not if false exit then

  // error if given name already exists
  sTableNm check::nameIsUnknownTable not if false exit then

  true
;

/*----------------------------------------------------------------------------*/
/* create table <tableNm> on this particpating node                           */
/*----------------------------------------------------------------------------*/
: createTable::createNamedTable params| sTableNm |

  // assert initial folder is ./tables
  //   /tenants/boray/catalogs/rapidsse/schemas/public/tables
  Folder[].isTables assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table

  StreamDefLft[] sTableNm table::createTable to Table[]
  nullptr to StreamDefLft[]
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: createTable_StreamDef

  0 0 locals| sTableNm errorCode |

  // get the stream def
  Pipein[] to StreamDefLft[]
  nullptr to Pipein[]

  // get the table name
  "<tableNm>" job::tagSet@ tagSet.hasName if
    <tableNm> to sTableNm
  else
    StreamDefLft[].name to sTableNm
  then

  //"***********" .
  //sTableNm .

  // grab the ddl lock
  DdlLock[].grabRead

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check ok to create table
  sTableNm createTable::checkCreate not if ( errorCode )
    to errorCode
    //StreamDefLft[].delete
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create the table
  sTableNm createTable::createNamedTable

  // should be in tables
  Folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: createTable_op \operator

  _lu_initialise_

  op__topology

  find: createTable_StreamDef ZK_D_STREAMDEF op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: createTable :: createTable ;
cmdSyntax: createTable :: createTable <tableNm> ;

: createTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
