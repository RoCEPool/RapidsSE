/*============================================================================*/
/* OP_sigill.sen -- cause SIGILL                                              */
/*============================================================================*/

" OP_sigill.sen" .verbose


/*----------------------------------------------------------------------------*/
/* sigill action                                                                */
/*----------------------------------------------------------------------------*/
: sigill_action

  "Before injected ILL" .

  inject::sigill locals| pDumpBuffer |


  // convert the string to operand to pipe out
  pDumpBuffer str.toPromptOut [op].pipeout


  true
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sigill :: sigill  ;

: sigill_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 0

    <opEntry> = "sigill_op"
  }
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
