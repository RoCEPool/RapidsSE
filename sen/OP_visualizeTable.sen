/*============================================================================*/
/* OP_visualizeTable.sen -- Operator visualize table                          */
/*============================================================================*/

" OP_visualizeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: vistbl_action

  <tableNm> op__table if
    Table[].visualize
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: vistbl :: vistbl <tableNm> ;

: vistbl_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
    <seedReq>     = "vistbl_req"
    <opEntry> = "vistbl_op"  <seedReq> = "vistbl_req"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
