/*============================================================================*/
/* md_tableIndexes.sen -- Define md_tableIndexes table                        */
/*============================================================================*/

" md_tableIndexes.sen" .verbose

: start::md_tableIndexes

  // C_TDEF_INDEXES

  STD_BOOTFORK_TAG
  "
  define metadata table tableIndexes (
    CatalogName VARCHAR NOT NULL ,
    SchemaName  VARCHAR NOT NULL ,
    TableName   VARCHAR NOT NULL ,
    IndexName   VARCHAR NOT NULL ,
    IsUnique      BOOLEAN NOT NULL ,
    IsPrimaryKey  BOOLEAN NOT NULL
  ) < metaData > = 1 ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
