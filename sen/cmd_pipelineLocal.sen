/*============================================================================*/
/* cmd_pipelineLocal.sen -- Local Pipeline Job                                */
/*============================================================================*/

" cmd_pipelineLocal.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute on local node                                                      */
/*----------------------------------------------------------------------------*/
: pipelineLocal::local

  ""    locals| sPreExe |
  false locals| bSndErrRespOp |
      
  [job].assertStructure

  [job].setOriginId

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Populate PdsErr[] if tag "<sendErrorsToResponseOp>" is set
  [job].parentResponseOpIsNotNull "<sendErrorsToResponseOp>" [job].tagSet@ tagSet.hasName and to bSndErrRespOp
  bSndErrRespOp if
    PdsErr[].isNull assert

    // create the tableDef for C_TDEF_EXECERRORS
    C_TDEF_EXECERRORS "op__tableDef_err" find execute assert

    // create a PdsErr operand for commandErrors
    // TODO: What if this fails with a low memory error?
    BT_EXECERRORS TableDefErr[] PdsErr[].new
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline command
  
  "<show_command>" sysargs::tagSet@ tagSet.hasName
  if
    [job].cmdPrint
    //[system].bpa
  then
/*
  [job].preExecuteLocal to ErrorCode[]
  ErrorCode[] if
    ErrorCode[] [job].error!
    [ddlLock].testDrop

    ListedJob[].assertNoRef

    Path[].discardAll

    [task].grabLock
    [job].updateParent assert
    [job].signalParent assert
    [job].addExited
      [task].retire // does not queue onto exit demon

    HAZARD
  then
*/

  // add job to the local job list
  [job].addLocal

  Dynamo[].new
  Dynamo[].compile to ErrorCode[]
  ErrorCode[] EC_NONE == if
    // clean compile
    to PipeSpec[]
    Dynamo[].delete
  else
    //"got error" .
    ErrorCode[] [job].error!
    
    [ddlLock].testDrop

    PipeSpec[].delete
    Dynamo[].delete

    // cross check
    PipeSpec[] not assert

    [ddlLock].testDrop

    ListedJob[].assertNoRef

    Path[].discardAll

    [task].grabLock

    bSndErrRespOp if
      ErrorCode[] attachmap::errorText@
        ErrorCode[] TableDefErr[] PdsErr[].addExecError assert
      PdsErr[]\clear [job].pipeToParentResponseOp
      Marker[].newChildExitMarker
      Marker[] [job].pipeToParentResponseOp
    then

    [job].updateParent assert
    [job].signalParent assert
    LogicUnit[].cleanup

    [job].addExited
    [task].retire // does not queue onto exit demon

    HAZARD

  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin the pipeline job (spawning jobs for ops etc)
  
  PipeSpec[] assert


/* local */  // - - - - - - - - - - - - - -
/* local */  // new all the markers needed
/* local */  // - - - - - - - - - - - - - -
/* local */  [job].newMarkerChain

  PipeSpec[]\clear Pipeline[].create
  Pipeline[].spawnOpTasks

  // run <pre_execute>

  "<pre_execute>"
  [job].tagSet@ tagSet.hasName if
    "<pre_execute>"
    [job].tagSet@ tagSet.getStr to sPreExe
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
//      [job].updateParent assert
//      [job].signalParent assert
      process::quit
    then
      execute
  else
    [args].verbose if
      <pipelineNm> "No pre execute word for pipeline: %v" .printf
    then
  then

  "<signalParent>" [job].tagSet@ tagSet.hasName not if
     //"SIGNALLING PARENT AS NO WAIT" .
     // No need to send anything to responseOp as this is a successful case.
     [job].updateParent assert
     [job].signalParent assert
  then

/* local */  // - - - - - - - - - - - - - - - -  - -
/* local */  // - - - - - - - - - - - - - - - -  - -
/* local */  // JOB NOT TO ALLLOCATE ANY MORE MEMORY
/* local */  // - - - - - - - - - - - - - -  - - - -
/* local */  [job].disableAllocate
/* local */  // - - - - - - - - - - - - - - - -  - -
/* local */  // - - - - - - - - - - - - - - - -  - -

/*
  // add job to the local job list
  [job].jobList@ JL_DEMON == not if
    [job].addLocal
  then
*/



  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // enqueue start-marker to start op to execute the pipeline job

  Pipeline[].rootDeck@ to Deck[]
  deck:invoke
  nullptr to Deck[]

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove job from the local job list
  [job].jobList@ JL_DEMON == not if
    [job].removeLocal
  then

 //<pipelineNm> [grid].thisNodeName@ "(%v) ALL DONE!!!" .

  [ddlLock].testDrop
  ListedJob[].assertNoRef

  Path[].discardAll

  [task].grabLock

  "<signalParent>" [job].tagSet@ tagSet.hasName if
    //"pipelineLocal::local SIGNALLING PARENT" .
    [job].updateParent assert
    [job].signalParent assert
  then

  LogicUnit[].cleanup
  [job].addExited
  [task].retire // does not queue onto exit demon
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipelineLocal :: pipelineLocal <pipelineNm> etc ;

: pipelineLocal_cmdTags _cmdTags tagCopy: localJob_tags
  tags{
    <cmdDesc>    = "--desc for job--"
    //<ddlLock>  = DL_GRAB_READ
    <entryPoint> = "pipelineLocal::local"

  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
