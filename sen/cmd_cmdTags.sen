/*============================================================================*/
/* cmd_cmdTags.sen -- the _cmdTags words                                      */
/*============================================================================*/

" cmd_info.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* test if info word is about a pipeline job                                  */
/*----------------------------------------------------------------------------*/
: _cmdTags.aboutPipelineJob params| pwCmdTags |

  pwCmdTags word.TagSet@ locals| pTagSet |

  "<jobKind>" pTagSet tagSet.getInt JK_PIPELINE == if true else false then
;

/*----------------------------------------------------------------------------*/
/* test if info word is about a generic job                                   */
/*----------------------------------------------------------------------------*/
: _cmdTags.aboutGenericJob params| pwCmdTags |

  pwCmdTags word.TagSet@ locals| pTagSet |

  "<jobKind>" pTagSet tagSet.getInt JK_GENERIC == if true else false then
;

/*----------------------------------------------------------------------------*/
/* test if info word is about a local job                                     */
/*----------------------------------------------------------------------------*/
: _cmdTags.aboutLocalJob params| pwCmdTags |

  pwCmdTags word.TagSet@ locals| pTagSet |

  "<jobKind>" pTagSet tagSet.getInt JK_LOCAL == if true else false then
;

/*----------------------------------------------------------------------------*/
/* test if info word is about a lite op                                       */
/*----------------------------------------------------------------------------*/
: _cmdTags.aboutLiteOp params| pwCmdTags |

  pwCmdTags word.TagSet@ locals| pTagSet |

  "<liteOp>" pTagSet tagSet.hasName if true else false then
;

/*----------------------------------------------------------------------------*/
/* test if info word is about a local lite op                                 */
/*----------------------------------------------------------------------------*/
: _cmdTags.aboutLocalLiteOp params| pwCmdTags |

  pwCmdTags word.TagSet@ locals| pTagSet |

  "<localLiteOp>" pTagSet tagSet.hasName if true else false then
;

/*----------------------------------------------------------------------------*/
/* does a seed by the name of Cmd_Suffix exist ?                              */
/*----------------------------------------------------------------------------*/
: _cmdTags.doesSeedExist? params| pwCmdTags sSuffix |

  pwCmdTags word.name_trunc locals| sCmdNm |

  sCmdNm sSuffix str.cat locals| sTagNm |

  sTagNm find if true else false then
;

/*----------------------------------------------------------------------------*/
/* add <seedNm> = Proper_Suffix to tag set of given cmd tags word             */
/*----------------------------------------------------------------------------*/
: _cmdTags.addSeedTag_local params| pwCmdTags sSuffix sProper sTagNm |

  pwCmdTags word.TagSet@ locals| pTagSet |
  
  0 locals| sTagValue |

  sSuffix pwCmdTags _cmdTags.doesSeedExist? if
    pwCmdTags word.name_trunc
      sSuffix str.cat to sTagValue
  else
    sProper
      sSuffix str.cat to sTagValue
  then

  //sTagValue  sTagNm "%v = %v" .printf
    
  sTagNm sTagValue pTagSet tagSet.insertStr
;

/*----------------------------------------------------------------------------*/
/* add <seedNm> = Proper_Suffix to tag set of given cmd tags word             */
/*----------------------------------------------------------------------------*/
: _cmdTags.addSeedTag_op params| pwCmdTags sSuffix sProper sTagNm |

  pwCmdTags word.TagSet@ locals| pTagSet |
  
  0 locals| sTagValue |

  sSuffix pwCmdTags _cmdTags.doesSeedExist? if
    pwCmdTags word.name_trunc
      sSuffix str.cat to sTagValue
  else
    sProper
      sSuffix str.cat to sTagValue
  then

  //sTagValue  sTagNm "%v = %v" .printf
    
  sTagNm sTagValue pTagSet tagSet.insertStr
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* promote current word to be an _cmdTags word                                */
/*----------------------------------------------------------------------------*/
: _cmdTags immediate

  senCompiler::current@ locals| pWord |

  // set the name of the word to be _cmdTags
  // pWord word.name@ "_cmdTags" str.cat pWord word.name!

  // set the word category to be _cmdTags
  find: _cmdTags pWord word.category!

  // attach an ename set to the word being created
  tagSet::new locals| pWordTagSet |
  pWordTagSet pWord word.TagSet!

  // add <jobNm> tag
  "<jobNm>" pWord word.name_trunc pWordTagSet tagSet.insertStr

  pWord encode::call
    POSTPONE word.tagSet@
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: _cmdTags::findTagSet params| sWordNm |

  sWordNm "_cmdTags" str.cat find word.TagSet@
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
