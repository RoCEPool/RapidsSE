/*============================================================================*/
/* OP_sort.sen -- Operator sort columns                                       */
/*============================================================================*/

" OP_sort.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: sort_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // will be null if table not found
  StreamDefLft[].isNull not if
    StreamDefLft[].delete
  then

  StreamDefOut[].isNull not if
    StreamDefOut[].delete
  then

  IndexDef[].isNull not if
    IndexDef[].delete
  then

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: sort_StreamDef \handler

  EC_NONE locals| eError |

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // new an indexDef
  indexDef[].new

  // generate selectColumns bitmap from expr and streamDefIn
  <expr> indexDef[] StreamDefLft[] StreamDefOut[].generate to eError

  // check for error
  eError EC_NONE == not if
    StreamDefOut[].delete
    eError op__execErr
    true
    exit
  then

  // delete the streamDefOut[]. Not needed for sort
  StreamDefOut[].delete

  // duplicate the streamDefLeft as streamDefOut
  StreamDefLft[].duplicate to StreamDefOut[]

  StreamDefLft[].duplicate to Pipein[]

  // pipe out the streamDef
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* sort request                                                         SPAWN */
/*----------------------------------------------------------------------------*/
: sort_op \operator

  _lu_initialise_

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  Counter0[] 2 == not if
    "Warning: sort works only with combinedOP" .
    true
    exit
  then

  find: sort_Cleaning      ZK_M_CLEANING    [op].handler!
  find: sort_StreamDef     ZK_D_STREAMDEF   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sort :: sort <compiled> <expr> ;

: sort_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "sort_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
