/*============================================================================*/
/* OP_rdCrwFile.sen -- read crw file                                         */
/*============================================================================*/

" OP_rdCrwFile.sen" .verbose

/*----------------------------------------------------------------------------*/
/* rdCrwFile crwBuffer                                                        */
/*----------------------------------------------------------------------------*/
: rdCrwFile_crwBuffer

  crwBuffer::new to CrwBuffer[]

  CrwBuffer[] file0[] file.readCrwBlock if
    //file0[] file.tell "read a crw block (tell %v)" .printf
    CrwBuffer[].pipeOut
    true
  else
    CrwBuffer[].delete
    false
  then
;

/*----------------------------------------------------------------------------*/
/* rdCrwFile action                                                           */
/*----------------------------------------------------------------------------*/
: rdCrwFile_action

  file::new to file0[]

  <fileNm> OPEN_READ file0[] file.open if
    file0[] file.size <fileNm> "File %v opened (%v bytes)" .printf

    //file0[] file.seekRndCsv

    begin
      rdCrwFile_crwBuffer
    while repeat

    file0[].get file.close
    <fileNm> "File %v closed" .printf
  then

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rdCrwFile :: rdCrwFile <FileNm> ;

: rdCrwFile_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
    <seedReq>     = "rdCrwFile_req"
}
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
