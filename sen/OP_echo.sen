/*============================================================================*/
/* OP_echo.sen -- Operator echo                                               */
/*============================================================================*/

" OP_echo.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: echo_startMarker \handler

  <string> .
  
  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* echo request                                                               */
/*----------------------------------------------------------------------------*/
: echo_op \operator

  _lu_initialise_

  op__topology

  find: echo_startMarker  EV_M_START   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: echo :: echo <string> ;

: echo_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "echo_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
