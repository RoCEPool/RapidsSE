/*============================================================================*/
/* OP_print.sen -- Operator print                                             */
/*============================================================================*/

" OP_print.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_I_PROMPTOUT ...                                             */
/*----------------------------------------------------------------------------*/
: print_promptOut \handler

  "print_promptOut:- ZK_I_PROMPTOUT" .
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: print_startMarker \handler

  "print_startMarker:- ZK_M_START" .
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* print request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: print_req \operator

  _op_begin_

  op__topology

  find: print_promptOut    ZK_I_PROMPTOUT     op[].handler!
  find: print_startMarker  ZK_M_START   op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: print :: print ;

: print_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
