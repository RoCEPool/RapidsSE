/*============================================================================*/
/* OP_print.sen -- Operator print                                             */
/*============================================================================*/

" OP_print.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_I_PROMPTOUT ...                                             */
/*----------------------------------------------------------------------------*/
: print_promptOut \handler

  "print_promptOut:- EV_I_PROMPTOUT" .
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: print_startMarker \handler

  "print_startMarker:- EV_M_START" .
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* print request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: print_op \operator

  _lu_initialise_

  op__topology

  find: print_promptOut    EV_I_PROMPTOUT     [op].handler!
  find: print_startMarker  EV_M_START   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: print :: print ;

: print_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "print_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
