/*============================================================================*/
/* OP_bucketSend1.sen -- Operator scan                                         */
/*============================================================================*/

" OP_OP_bucketSend1.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELLINGMARKER ...                                        */
/*----------------------------------------------------------------------------*/
: bucketSend_CancellingMarker \handler

  Pipein[]\clear to Marker[]

  "Bucket_CancellingMarker DRAINING PIPEIN" .
  PipeIn[].drain

  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: bucketSend_Cleaning \handler

  // drop the tablePtn lock if held
  counter0[] true == if
    TablePtn[].dropRead
    false to counter0[]
  then

  // delete the ptn stream
  //ptnStream[].isNull not if
  //  ptnStream[] ptnStream.delete
  //then

  EV_M_CLEANING_handler
;


/*----------------------------------------------------------------------------*/
/* handler for EV_M_NEXTBUFFER...                                             */
/*----------------------------------------------------------------------------*/
// ": bucketSend_NextBufferMarker" .

: bucketSend_NextBufferMarker \handler
  ": bucketSend_NextBufferMarker" .
  debug::flag@ if "(Revised) scan_NextBufferMarker handler" . then

  // read next buffer from ptn stream
  ptnStream[] ptnStream.read to DataBuffer[]

  DataBuffer[].isNotNull if
    // read a next crw buffer

    // pipe out the read crw buffer
    DataBuffer[].pipeOut

    // requeue EV_M_NEXTBUFFER
    Pipein[].pipeBackin

    // call this handler again to process next buffer
    //true LogicUnit[].callAgain!

  else
    // no more crw buffers
    Pipein[].delete

    // close and delete partition stream
    ptnStream[] ptnStream.close
    ptnStream[] ptnStream.delete
    nullptr to ptnStream[]

    // drop partition lock
    TablePtn[].dropRead

    // set counter0 to false to indicate lock released
    false to counter0[]

    // pipe out an eos marker
    Marker[].newEosMarker
    Marker[].pipeOut

  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // check for rate metering

  0 locals| rateSecs |

  // "<rateSecs>" [job].tagSet@ tagSet.hasName if
  "<rateSecs>" [op].tagSet@ tagSet.hasName if
    <rateSecs> >int to rateSecs
  then

  rateSecs if
    rateSecs "Bucket Pausing for %v secs" str.format .
    rateSecs [task].sleepSsec
    "Bucket awake" .
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
// ": bucketSend_DataMarker" .

: bucketSend_DataMarker \handler
 ": bucketSend_DataMarker" .
  debug::flag@ if "(Revised) bucketSend_DataMarker handler" . then

  // pipe out the pulse marker
  PipeIn[].pipeOut

  // pipe out a new a stream def
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[].pipeOut

  // grab table ptn read lock
  TablePtn[].grabRead_yieldLoop

  // set counter0 to true to indicate lock held
  true to counter0[]

  // new a partition stream for access crw buffer
  TablePtn[] ptnStream::new to ptnStream[]

  // open partition stream to access the crw buffers
  ptnStream[] ptnStream.open if

    // pipe in EV_M_NEXTBUFFER
    Marker[].newNextBufferMarker
    Marker[].pipeBackIn

    //"bucketSend_RowCrwBuffer_next" word::find LogicUnit[].handler!
    //true LogicUnit[].callAgain!

  else
    // unable to open partition stream (this would be unusual)

    // delete partition stream
    ptnStream[] ptnStream.delete
    nullptr to ptnStream[]

    // drop table ptn lock
    TablePtn[].dropRead

    // set counter0 to 0 to indicate lock released
    false to counter0[]

    // send an eos marker (there was no data)
    Marker[].newEosMarker
    Marker[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
// ": bucketSend_StartMarker" .

: bucketSend_StartMarker \handler
": bucketSend_StartMarker" .
  PipeIn[].pipeOut
  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  // Can call some function to get the correct bucket here, too.
  // But for now, let's get back to buckets and bucket map then
  // we'll know what to do
  //


  true
;

/*----------------------------------------------------------------------------*/
/* bucketSend request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: bucketSend_op \operator
  "bucketSend_req" .
  _lu_initialise_

  "<catalogNm>"  [job].tagSet@ tagSet.hasName if
    <schemaNm> <catalogNm>
    "/tenants/boray/catalogs/%v/schemas/%v/tables" str.format
    str.toStrVec Path[].set
  then

  op__topology

  find: bucketSend_CancellingMarker  EV_M_CANCELLING [op].handler!
  find: bucketSend_Cleaning          EV_M_CLEANING   [op].handler!
  find: bucketSend_DataMarker        EV_M_DATAPULSE  [op].handler!
  find: bucketSend_NextBufferMarker  EV_M_NEXTBUFFER [op].handler!
  find: bucketSend_StartMarker       EV_M_START      [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: bucketSend :: bucketSend <tableNm> ;

: bucketSend_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "bucketSend_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
