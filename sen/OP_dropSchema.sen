/*============================================================================*/
/* OP_dropSchema.sen -- Operator drop schema                                  */
/*============================================================================*/

" OP_dropSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: dropSchema_DataMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove schema
  <schemaNm> checkRemoveSchema not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the schema
  <schemaNm> removeSchema

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dropSchema req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropSchema_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dropSchema_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropSchema :: dropSchema <schemaNm> ;

: dropSchema _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
