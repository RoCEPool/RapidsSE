/*============================================================================*/
/* OP_dropSchema.sen -- Operator drop schema                                  */
/*============================================================================*/

" OP_dropSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: dropSchema_DataMarker

  0 locals| errorCode |

  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we can remove schema
  <schemaNm> checkRemoveSchema not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the schema
  <schemaNm> removeSchema

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dropSchema req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropSchema_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dropSchema_DataMarker ZK_M_DATAPULSE op[].handler!

  op__loop

  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropSchema :: dropSchema <schemaNm> ;

: dropSchema_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
