/*============================================================================*/
/* OP_call.sen -- Operator Call Pipeline                                      */
/*============================================================================*/

" OP_call.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                             */
/*----------------------------------------------------------------------------*/
: call_StartMarker \handler

  PipeIn[].pipeOut
  true 
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_I_CALLPIPELINE ...                                            */
/*----------------------------------------------------------------------------*/
: call_CallPipeline \handler

  "call_CallPipeline" .

  PipeIn[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : call_op \operator

  _lu_initialise_

  op__topology

  find: call_CallPipeline ZK_I_CALLPIPELINE op[].handler!
  find: call_StartMarker  ZK_M_START  op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: call :: call <nested> ;

: call_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
