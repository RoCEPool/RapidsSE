/*============================================================================*/
/* md_indexColumns.sen -- Define md__indexColumns table                                   */
/*============================================================================*/

" md_indexColumns.sen" .verbose

: start::md_indexColumns

  // C_TDEF_INDEXCOLUMNS

  STD_BOOTFORK_TAG
  "
  define table indexColumns (
    szCatalogName VARCHAR NOT NULL ,
    szSchemaName  VARCHAR NOT NULL ,
    szTableName   VARCHAR NOT NULL ,
    szIndexName   VARCHAR NOT NULL ,
    szColumnName  VARCHAR NOT NULL
  ) < metaData > = MetaDataTable[].indexColumns ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
