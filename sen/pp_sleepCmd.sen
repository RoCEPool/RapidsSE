/*============================================================================*/
/* pp_sleepCmd.sen -- define sleep related procedures                         */
/*============================================================================*/

" pp_sleep.sen" .verbose


/*----------------------------------------------------------------------------*/
/* sleep related procedures                                                   */
/*----------------------------------------------------------------------------*/

"  start::defProc_SleepCmd" .verbose

: start::defProc_SleepCmd

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // sleep

  STD_PATH_TAG
  "
  procedure sleepCmd
    parameters $millis
  begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on origin :
      sleep $millis | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  procedure::add
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
