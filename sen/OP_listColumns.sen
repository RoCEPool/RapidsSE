/*============================================================================*/
/* OP_listColumns.sen -- Operator list columns                                */
/*============================================================================*/

" OP_listColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lscol_action

  0 locals| iColumns |

  // find the table
  <tableNm> op__table not if
    false
    exit
  then

  // get the table column count
  Table[].columnCount@ to iColumns

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  // insert a row in the Pds for each column
  iColumns 0 do
    I Table[].column@ TableDef[]
      Pds[].addColumnDef not if
      Pds[].pipeOut
      BT_DATA TableDef[] Pds[].new
      I Table[].column@ TableDef[]
      Pds[].addColumnDef assert
    then
  loop

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lscol :: lscol <tableNm> ;

: lscol_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listColumns
    <params>      = 1

    <opEntry> = "lscol_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

