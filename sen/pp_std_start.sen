/*============================================================================*/
/* pp_std_start.sen -- standard start stage                                   */
/*============================================================================*/

" pp_std_start.sen" .verbose
  
  STD_PATH_TAG
  "
  procedure std_start
    tag <as_first> = 1 endTag
  begin

    stage stageStart on origin :
    
        start
      | pulse once
      | next

  end ;
  "
  procedure::add
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
