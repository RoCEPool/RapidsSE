/*============================================================================*/
/* OP_sanity.sen -- Operator sanity                                           */
/*============================================================================*/

" OP_sanity.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER...                                                       */
/*----------------------------------------------------------------------------*/
: gridSanity_RowBuffer \handler

  //"Operand:- EV_D_ROWBUFFER" .verbose

  PipeIn[] to RowBuffer[]
  nullptr to PipeIn[]

  RowBuffer[].getBufferType BT_NODEINFO != if
    RowBuffer[].pipeout
    true
    exit
  then

  // get the first row of the infoSet (nodeInfo)
  RowBuffer[].firstRow to infoSetRow[]

  // create an infoSet operand
  StreamSetTable[] RowBuffer[].new

  // add nodeInfo to the infoSet
  infoSetRow[].get StreamSetTable[] RowBuffer[].addgridSanity assert

  // pipeout the rowBuffer
  RowBuffer[].pipeOut

  // delete the rowBuffer
  RowBuffer[].delete

  true
;


/*----------------------------------------------------------------------------*/
/* on EV_M_START...                                                           */
/*----------------------------------------------------------------------------*/
: gridSanity_StartMarker \handler

  //"Operand:- EV_M_START" .verbose

  PipeIn[].pipeOut

  // find the __gridSanity table
  C_TDEF_gridSanity op__tableDef_streamSet assert

  // create a new stream defnition as per the nodeinfo being sent
  StreamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  true
;


/*----------------------------------------------------------------------------*/
/* execute for gridSanity req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : gridSanity_op \operator
 
  _lu_initialise_

  op__topology

  find: gridSanity_StartMarker EV_M_START        [op].handler!
  find: gridSanity_RowBuffer   EV_D_ROWBUFFER    [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: gridSanity :: gridSanity ;

: gridSanity_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "gridSanity_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
