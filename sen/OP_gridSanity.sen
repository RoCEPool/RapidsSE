/*============================================================================*/
/* OP_sanity.sen -- Operator sanity                                           */
/*============================================================================*/

" OP_sanity.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_PDSROWBUFFER...                                                    */
/*----------------------------------------------------------------------------*/
: gridSanity_PdsRowBuffer \handler

  //"Operand:- EV_D_PDSROWBUFFER" .verbose

  PipeIn[]\clear to Pds[]

  // handle BT_NODEINFO only
  Pds[].bufferType@ BT_NODEINFO != if
    Pds[].pipeout
    true
    exit
  then

  // get the first row of the Pds (nodeInfo)
  Pds[].firstRow to Row[]

  Pds[] to DataBuffer[]

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  // add nodeInfo to the Pds
  Row[] TableDef[] Pds[].addgridSanity assert

  // pipeout the Pds
  Pds[].pipeOut

  // delete the dataBuffer
  DataBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_START...                                                           */
/*----------------------------------------------------------------------------*/
: gridSanity_StartMarker \handler

  //"Operand:- EV_M_START" .verbose

  PipeIn[].pipeOut

  // find the __gridSanity table
  C_TDEF_GRIDSANITY op__tableDef assert

  // create a new stream definition as per the nodeinfo being sent
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  true
;


/*----------------------------------------------------------------------------*/
/* execute for gridSanity req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : gridSanity_op \operator
 
  _lu_initialise_

  op__topology

  find: gridSanity_StartMarker EV_M_START        [op].handler!
  find: gridSanity_PdsRowBuffer   EV_D_PDSROWBUFFER    [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: gridSanity :: gridSanity ;

: gridSanity_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "gridSanity_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
