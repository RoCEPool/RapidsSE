/*============================================================================*/
/* OP_sanity.sen -- Operator sanity                                           */
/*============================================================================*/

" OP_sanity.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_I_NODEINFO...                                                          */
/*----------------------------------------------------------------------------*/
: gridSanity_NodeInfo \handler

  //"Operand:- ZK_I_NODEINFO" .verbose

  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  // get the first row of the infoSet (nodeInfo)
  InfoSet[].firstRow to infoSetRow[]

  // find the __nodeInfo table
  //C_TDEF_gridSanity op__tableDef_streamSet assert

  // create a new stream defnition as per the nodeinfo being sent
  //streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  //StreamDefLft[].pipeOut

  // create an infoSet operand
  streamSetTable[] streamSet[].new

  // add nodeInfo to the infoSet
  infoSetRow[].get streamSetTable[] streamSet[].addgridSanity assert

  // pipeout the infoset
  streamSet[].pipeOut

  // delete the infoset
  InfoSet[].delete

  true
;


/*----------------------------------------------------------------------------*/
/* on ZK_M_START...                                                       */
/*----------------------------------------------------------------------------*/
: gridSanity_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  PipeIn[].pipeOut

  // find the __gridSanity table
  C_TDEF_gridSanity op__tableDef_streamSet assert

  // create a new stream defnition as per the nodeinfo being sent
  streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  true
;


/*----------------------------------------------------------------------------*/
/* execute for gridSanity req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : gridSanity_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: gridSanity_StartMarker ZK_M_START op[].handler!
  find: gridSanity_NodeInfo    ZK_I_NODEINFO    op[].handler!

  op__loop

  LogReqExit
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: gridSanity :: gridSanity ;

: gridSanity_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
