/*============================================================================*/
/* OP_eachRow.sen -- convert each row to eachRowBuffer                        */
/*============================================================================*/

" OP_eachRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: eachRow_CrwBuffer \handler

  0 0  locals| iRow nRows |

  PipeIn[]\clear to Operand[]

  Operand[].crwRowCount@ to nRows

  begin
    nRows iRow >
  while
    iRow "sending iRow %v" .printf

    iRow Operand[].crwToEachRow to OperandB[]
    OperandB[].Pipeout
    iRow 1 + to iRow
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: eachRow_EosMarker \handler

  // pipe out the eachRow eos marker

  //Operand[].newEachRowEosMarker
  PipeIn[].PipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: eachRow_RowBuffer \handler

  0 0 locals| iRow nRows |

  PipeIn[]\clear to Operand[]

  Operand[].rowRowCount@ to nRows

  begin
    nRows iRow >
  while
    iRow "***sending iRow %v" .printf

    iRow Operand[].rowToEachRow to OperandB[]
    OperandB[].Pipeout
    iRow 1 + to iRow
  repeat

  // delete the row buffer
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* eachRow request                                                     SPAWN */
/*----------------------------------------------------------------------------*/
: eachRow_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: eachRow_CrwBuffer ZK_D_CRWBUFFER  op[].handler!
  find: eachRow_RowBuffer ZK_D_ROWBUFFER  op[].handler!
  find: eachRow_EosMarker ZK_M_EOS  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eachRow :: eachRow ;

: eachRow_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
