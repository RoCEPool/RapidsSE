/*============================================================================*/
/* job_cancelled.sen -- cancelled 2pc job (pipeline coordination)             */
/*============================================================================*/

" job_cancelled.sen" .verbose


/*----------------------------------------------------------------------------*/
/* retire                                                                     */
/*----------------------------------------------------------------------------*/
: cancelled::retire

  [ddlLock].testDrop
  
  [task].grabLock
    [job] [exitDemon]:queueJob
    TR_RETIRE_THIS_TASK [task].transition!

  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job_Cancelled back to originating node                                */
/*----------------------------------------------------------------------------*/
: cancelled:reply params| pJobParticipant |

  // "cancelled:reply" .
  
  // new a temporary Job_Cancelled
  pJobParticipant job_Cancelled::new locals| pJob_Cancelled |

  // send the cancelled job
  pJobParticipant [job].originNodeId@ pJob_Cancelled job.reply

  pJob_Cancelled job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run recieved Job_Cancelled on originating node   recv: job.spawn */
/*----------------------------------------------------------------------------*/
: cancelled:cancelled

  // "cancelled:cancelled" .

  // find the originating job
  //[job] job.id@ ListedJob[].findOriginator discard
  [job].parentId@ ListedJob[].findOriginator discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ListedJob[].task@ task.ack
  
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: cancelled :: cancelled ;

: cancelled_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "cancelled:cancelled"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
