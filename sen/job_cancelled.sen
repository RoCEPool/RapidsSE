/*============================================================================*/
/* job_cancelled.sen -- cancelled 2pc job (pipeline coordination)             */
/*============================================================================*/

" job_cancelled.sen" .verbose


/*----------------------------------------------------------------------------*/
/* retire                                                                     */
/*----------------------------------------------------------------------------*/
: cancelled::retire

  [ddlLock].testDrop
  
  [task].grabLock
    [job] [exitDemon]:queueJob
    TR_RETIRE_THIS_TASK [task].transition!

  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job_Cancelled back to originating node                                */
/*----------------------------------------------------------------------------*/
: cancelled:reply params| pJobParticipant |

  // "cancelled:reply" .
  
  // new a temporary Job_Cancelled
  pJobParticipant job_Cancelled::new locals| pJob_Cancelled |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send the cancelled job
  pJobParticipant [job].originNodeNo@ pJob_Cancelled job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob_Cancelled job.delete
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run recieved Job_Cancelled on originating node   recv: job.spawn */
/*----------------------------------------------------------------------------*/
: cancelled:cancelled

  <path> str.toStrVec Path[].set
  
  
  [job] locals| pJob_Cancelled |
  pJob_Cancelled job.id@ locals| iJobId |

  0 0 0 0 locals| bAmDecider error iParticipantNode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the context of this __cancelled job

  // find the originating job
  iJobId ListedJob[].findOriginator discard

  // get the participant node from where this job_begun started
  pJob_Cancelled job.participantNode@ to iParticipantNode


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // process __begun job on this originating node

  // increment the number of __cancelled jobs received in api state
  ListedJob[] ssn::incCancelled
  ListedJob[] ssn::traceSession



  // decrement the acks remaining in the originating job
  ListedJob[] job.dec2pcAcksRmg to bAmDecider

  // if there are acks remaining just exit
  bAmDecider not if
    ListedJob[].returnReference
    cancelled::retire
    [job]:retire
    exit                                                         // *EARLY EXIT*
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // all job_cancelled's have been received, so this job is the decider

  begin
    ListedJob[].references
  1 > while
  repeat

  [job].tscCanceled


  // remove the originating job from the originator jobs
  //[job].removeOriginator

  // notify the originating task
  ListedJob[].task@ task.ack
  ListedJob[].returnReference

  // delete this completed __cancelled job
  cancelled::retire
  
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: cancelled :: cancelled ;

: cancelled_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "cancelled:cancelled"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
