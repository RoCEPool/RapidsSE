/*============================================================================*/
/* OP_postProject.sen -- Potentially add a ProjectOp on top (SQL Compiler)    */
/*============================================================================*/

" OP_postProject.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: postProject_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: postProject_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCmdErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::postProject to PlanOperand[]

  "postProject" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: postProject_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker       EV_M_LEAVE        [op].handler!
  find: compiler_StreamSet         EV_D_STREAMSET    [op].handler!

  // specific handlers
  find: postProject_Cleaning      EV_M_CLEANING      [op].handler!
  find: postProject_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: postProject :: postProject ;

: postProject_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "postProject_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
