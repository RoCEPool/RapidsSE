/*============================================================================*/
/* cmd_cancelled.sen -- 1sc: given pipeline has cancelled on participant      */
/*============================================================================*/

" cmd_cancelled.sen" .verbose


////////////////////////////////////////////////////////////////////////////////
/*                    ON ORIGINATING NODE OF GIVEN PIPELINE                   */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* run recieved Job_Cancelled on originating node                             */
/*----------------------------------------------------------------------------*/
: cancelled:cancelled

  // "cancelled:cancelled" .

  // find the originating job
  [job].distId@ ListedJob[].findOriginator? discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ListedJob[].taskAck
  
  ListedJob[].returnReference
  [job]:retireAndExit
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: cancelled :: cancelled ;

: cancelled_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "cancelled:cancelled"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
