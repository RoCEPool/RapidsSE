/*============================================================================*/
/* cmd_cancelled.sen -- 1sc: given pipeline has cancelled on participant      */
/*============================================================================*/

" cmd_cancelled.sen" .verbose


////////////////////////////////////////////////////////////////////////////////
/*                    ON ORIGINATING NODE OF GIVEN PIPELINE                   */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////



/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/

: cancelled:cancelled
  // "cancelled:cancelled" .

/* <cnd ptp */  [args].distJob if
/* <cnd ptp */    "cancelled" "cancelled" "*<edd ptp snd origin" [job].trace
/* <cnd ptp */  then
/* <cnd ptp */
/* <cnd ptp */
/* <cnd ptp */  // find the originating job
/* <cnd ptp */  [job].originId@ ListedJob[].findOriginator? discard
/* <cnd ptp */
/* <cnd ptp */
/* <cnd ptp */  ListedJob[].taskAck
/* <cnd ptp */
/* <cnd ptp */  ListedJob[].returnReference
/* <cnd ptp */  [job]:retireAndExit
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: cancelled :: cancelled ;

: cancelled_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "cancelled:cancelled"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
