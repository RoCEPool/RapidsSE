/*============================================================================*/
/* cmd_cancelled.sen -- 1sc: given pipeline has cancelled on participant      */
/*============================================================================*/

" cmd_cancelled.sen" .verbose


////////////////////////////////////////////////////////////////////////////////
/*                    ON ORIGINATING NODE OF GIVEN PIPELINE                   */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////



/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/

: cancelled:cancelled
  // "cancelled:cancelled" .

/* <cnd ptp */  [args].distJob if
/* <cnd ptp */    "cancelled" "cancelled" "<edd ptp"
/* <cnd ptp */      "snd cancelled origin"                           [job].trace
/* <cnd ptp */  then
/* <cnd ptp */
/* <cnd ptp */
/* <cnd ptp */  // find the originating job
/* <cnd ptp */  [job].originId@ ListedJob[].findOriginator? if
/* <cnd ptp */
/* <cnd org */    ListedJob[].nodeLoss@ not if
/* <cnd org */      //RAY ListedJob[].taskState@ TS_WAITING == assert
/* <cnd org */      ListedJob[].taskAck
/* <cnd org */    then
/* <cnd org */
/* <cnd ptp */  ListedJob[].returnReference
/* <cnd ptp */  then
/* <cnd ptp */
/* <cnd ptp */  [args].distJob if
/* <cnd ptp */    "cancelled" "onOrigin" "<cld org"
/* <cnd ptp */      "<cld origin" "exiting"                           [job].trace
/* <cnd ptp */  then
/* <cnd ptp */
/* <cnd ptp */  [job]:retireAndExit
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: cancelled :: cancelled ;

: cancelled_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "cancelled:cancelled"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
