/*============================================================================*/
/* dp_superDemon.sen -- Supervisor Demon                                      */
/*============================================================================*/

" se_demon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* supervisor demon                                                           */
/*----------------------------------------------------------------------------*/
: superDemonPipeline

  "
    pipelineLocal superDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | supervisor
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
