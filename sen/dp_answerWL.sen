/*============================================================================*/
/* dp_answerWL.sen -- Answer Demon for WL Adaptor                             */
/*============================================================================*/

" dp_answerWL.sen" .verbose


/*----------------------------------------------------------------------------*/
/* pipeline/procedure text for answer demon                                   */
/*----------------------------------------------------------------------------*/
procText:
  pipelineLocal answerWL_procText
    tag "<pre_execute>" = "demon::install" endTag
  begin

    stage stageA on origin :
        start
      | answerWL
      | eatAll
      | stageA

  end
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
