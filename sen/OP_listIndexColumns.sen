/*============================================================================*/
/* OP_listIndexColumns.sen -- Operator list index columns                             */
/*============================================================================*/

" OP_listIndexColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsidxcol_action

  0 locals| iColumns |

  // find the table
  <tableNm> <indexNm> op__table_index not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an infoSet operand
  TableDef[] RowBuffer[].new

  // get no of columns in the index
  Index[].columnCount@ to iColumns

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert a row in the infoSet for each index column
  iColumns 0 do
    I Index[].column@
    TableDef[] RowBuffer[].addColumnDef  not if
      RowBuffer[].pipeOut
      TableDef[] RowBuffer[].new
      I Index[].column@
      TableDef[] RowBuffer[].addColumnDef assert
    then
  loop

  // pipeout the infoset
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsidxcol :: lsidxcol <tableNm> <indexNm> ;

: lsidxcol_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listColumns
    <params>      = 2

    <opEntry> = "lsidxcol_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
