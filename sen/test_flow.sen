/*============================================================================*/
/* test_flow.sen -- flow control unit testing                                 */
/*============================================================================*/

" test_flow.sen" .verbose

: flowTests

  "  flow control tests" .put .\n

  assert::stack_0
  0
  assert::stack_1
  begin
    assert::stack_1
    1
    assert::stack_2
    +
    assert::stack_1
    dup
    assert::stack_2
    10
    assert::stack_3
    ==
    assert::stack_2
  until
  assert::stack_1
  discard
  assert::stack_0

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
