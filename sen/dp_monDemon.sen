/*============================================================================*/
/* dp_monDemon.sen -- Monitor Demon                                           */
/*============================================================================*/

" dp_monDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* monitor demon                                                              */
/*----------------------------------------------------------------------------*/
: monDemonPipeline

  "
    pipelineLocal monDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
        start | monitor | eatAll | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
