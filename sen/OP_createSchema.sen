/*============================================================================*/
/* OP_createSchema.sen -- Operator create schema                              */
/*============================================================================*/

" OP_createSchema.sen" .verbose

/*----------------------------------------------------------------------------*/
/* check if word is not a schema                                              */
/*----------------------------------------------------------------------------*/
: name::isNotKnownSchema ( word )
  Folder[].findSymbol not if true exit then
  EC_SCHEMA_EXISTS false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: createSchema_DataMarker

  0 locals| errorCode |

  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  node::checkEnoughBuffers not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if are in schemas
  Folder[].checkIsSchemas not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if schema already exits
  <schemaNm> name::isNotKnownSchema not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the schema
  <schemaNm> :makeSchemaFolder ( )

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createSchema req                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: createSchema_op \operator

  _lu_initialise_

  op__topology

  find: createSchema_DataMarker ZK_M_DATAPULSE op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: createSchema :: createSchema <schemaNm> ;

: createSchema_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
