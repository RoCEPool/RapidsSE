/*============================================================================*/
/* pp_disconnect.sen -- a pipeline for disconnecting clients                  */
/*============================================================================*/

" pp_disconnect.sen" .verbose


/*----------------------------------------------------------------------------*/
/* disconnect related procedures                                              */
/*----------------------------------------------------------------------------*/

// TODO: This can be extended to take a parameter being the session ID of
//       the client to be disconnected. Currently it will just disconnect
//       the invoking client.

"  start::defProc_disconnect" .verbose

: start::defProc_disconnect

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // disconnect

  STD_PATH_TAG
  "
  procedure disconnect
  begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on origin :
      disconnect | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  procedure::add
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
