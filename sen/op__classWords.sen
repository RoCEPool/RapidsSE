/*============================================================================*/
/* op__classWords.sen -- class word set                                       */
/*============================================================================*/

" op__classWords.sen" .verbose

  find: job:spawn CN_JOB class::postRecvWord!

  find: rejectJob:reply   CN_REJECTJOB class::postRecvWord!
  find: rejectedJob:accept CN_REJECTEDJOB class::postRecvWord!

  find: parcel.dispatch CN_PARCEL class::postRecvWord!

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
