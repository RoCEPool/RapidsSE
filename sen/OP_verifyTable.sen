/*============================================================================*/
/* OP_verifyTable.sen -- Operator verify table                                */
/*============================================================================*/

" OP_verifyTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: vfytbl_action

  <tableNm> op__table not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an rowBuffer operand
  BT_DATA TableDef[] RowBuffer[].new

  // verify the table
  Table[].verify

  // insert index verify
  Table[] TableDef[] RowBuffer[].addVerifyTable assert

  // pipeout the rowBuffer
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: vfytbl :: vfytbl <tableNm> ;

: vfytbl_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __verifyTable
    <params>    = 1
    <opEntry> = "vfytbl_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
