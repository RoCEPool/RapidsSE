/*============================================================================*/
/* job_seedSuffixs.sen -- Job Seed Suffixes                                   */
/*============================================================================*/

" job_seedSuffixs.sen" .verbose

/*----------------------------------------------------------------------------*/
/* append a suffix to name of word being compiled                             */
/*----------------------------------------------------------------------------*/
: word::addSuffix params| sSuffix |

  senCompiler::current@ word.name@ sSuffix str.cat senCompiler::current@ word.name!
;

/*----------------------------------------------------------------------------*/
/* category of words which are seeds                                          */
/*----------------------------------------------------------------------------*/
: seed

;

/*----------------------------------------------------------------------------*/
/* sets the category of word being being compiled as seed                     */
/*----------------------------------------------------------------------------*/
: word::seed#

  find: seed senCompiler::current@ word.category!
;

/*----------------------------------------------------------------------------*/
/* _suffix sets the category of word being being compiled as _suffix          */
/*----------------------------------------------------------------------------*/
: _suffix immediate

  find: _suffix senCompiler::current@ word.category!
;

/*----------------------------------------------------------------------------*/
/* _req makes the word being compile a request seed with name: /wordNm/_req   */
/*----------------------------------------------------------------------------*/
: ::req_suffix immediate _suffix

  // append _req to name of word being compiled
  // "_req" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "req_exitHook" senCompiler::current@ word.exitHook!
;

/*----------------------------------------------------------------------------*/
/* _beg makes the word being compile a seed with name: <wordNm>_beg           */
/*----------------------------------------------------------------------------*/
: _beg_suffix immediate _suffix

  // append _beg to name of word being compiled
  // "_beg" word::addSuffix

  // the compiled word is a seed
  find: seed senCompiler::current@ word.category!

  word::seed#

  // set exit hook of word being compiled
  "beg_exitHook" senCompiler::current@ word.exitHook!
;

/*----------------------------------------------------------------------------*/
/* _exe makes the word being compile a seed with name: <wordNm>_exe           */
/*----------------------------------------------------------------------------*/
: _exe_suffix immediate _suffix

  // append _exe to name of word being compiled
  // "_exe" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "exe_exitHook" senCompiler::current@ word.exitHook!
;

/*----------------------------------------------------------------------------*/
/* _end makes the word being compile a end seed with name: <wordNm>_end       */
/*----------------------------------------------------------------------------*/
: _end_suffix immediate _suffix

  // append _end to name of word being compiled
  // "_end" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "end_exitHook" senCompiler::current@ word.exitHook!
;

/*----------------------------------------------------------------------------*/
/* _can makes the word being compile a cancel seed with name: <wordNm>_can    */
/*----------------------------------------------------------------------------*/
: _can_suffix immediate _suffix

  // append _can to name of word being compiled
  // "_can" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "can_exitHook" senCompiler::current@ word.exitHook!
;

/*----------------------------------------------------------------------------*/
/* _run makes the word being compile a seed with name: <wordNm>_run           */
/*----------------------------------------------------------------------------*/
: _run_suffix immediate _suffix

  // append _beg to name of word being compiled
  // "_run" word::addSuffix

  word::seed#

  // set exit hook of word being compiled
  "run_exitHook" senCompiler::current@ word.exitHook!
;

/*----------------------------------------------------------------------------*/
/* adds a standard entry and exit hook to word being compiled                 */
/*----------------------------------------------------------------------------*/
: _eeh_suffix immediate _suffix

  "std_exitHook" senCompiler::current@ word.exitHook!
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
