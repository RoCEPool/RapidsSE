/*============================================================================*/
/* cmd_pipeSee.sen -- pipeSee command                                         */
/*============================================================================*/

" cmd_pipeSee.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute on local node                                                      */
/*----------------------------------------------------------------------------*/
: pipeSee:entry

  "PIPESEE: " .

  [job].tagSet@ tagSet.asStr .

  [cmd]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipeSee :: pipeSee etc ;

: pipeSee_cmdTags _cmdTags tagCopy: localJob_tags
  tags{
    <cmdDesc>    = "--desc for job--"
    <entryPoint> = "pipeSee:entry"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
