/*============================================================================*/
/* OP_dropTenant.sen -- Operator drop tenant                                  */
/*============================================================================*/

" OP_dropTenant.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: dropTenant_DataMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if are in tenants
  folder[].checkIsTenants not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if tenant exits
  <tenantNm> checkIsTenant not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the tenant
  <tenantNm> removeTenant

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createTenant req                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropTenant_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: dropTenant_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropTenant :: dropTenant <tenantNm> ;

: dropTenant _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
