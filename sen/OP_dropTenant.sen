/*============================================================================*/
/* OP_dropTenant.sen -- Operator drop tenant                                  */
/*============================================================================*/

" OP_dropTenant.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: dropTenant_DataMarker

  0 locals| errorCode |

  PipeIn[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if are in tenants
  Folder[].checkIsTenants not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if tenant exits
  <tenantNm> checkIsTenant not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove the tenant
  <tenantNm> removeTenant

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createTenant req                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: dropTenant_op \operator

  _lu_initialise_

  op__topology

  find: dropTenant_DataMarker EV_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dropTenant :: dropTenant <tenantNm> ;

: dropTenant_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "dropTenant_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
