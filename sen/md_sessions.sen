" md_sessions.sen" .verbose

: start::md_sessions

  // C_TDEF_SESSIONS

  STD_BOOTFORK_TAG
  "
  define table sessions (
    iSessionId    INTEGER NOT NULL ,
    bConnect      BOOLEAN NOT NULL ,
    szStatus      VARCHAR NOT NULL
  ) < metaData > = MetaDataTable[].sessions ;
