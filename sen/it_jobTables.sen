/*============================================================================*/
/* it_jobTables.sen -- Define Job Tables                                      */
/*============================================================================*/

" it_jobTables.sen" .verbose

/*----------------------------------------------------------------------------*/
/* define internal tables                                                     */
/*----------------------------------------------------------------------------*/

: start::it_jobTables


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_JOBNETDISSECT
  STD_PATH_TAG
  "
  define table se__jobNetDissect
  (
    jobId             INTEGER NOT NULL ,
    
    thisNodeNo        INTEGER NOT NULL ,
    thisNodeName      VARCHAR NOT NULL ,
    
    nodeNo            INTEGER NOT NULL ,
    nodeName          VARCHAR NOT NULL ,

    socket            VARCHAR NOT NULL ,
    kind              VARCHAR NOT NULL ,

    cnt               INTEGER NOT NULL ,
    bytes             INTEGER NOT NULL

  ) < internal > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_JOBNETWORK
  STD_PATH_TAG
  "
  define table se__jobNetwork
  (
    jobId             INTEGER NOT NULL ,
    
    thisNodeNo        INTEGER NOT NULL ,
    thisNodeName      VARCHAR NOT NULL ,

    nodeNo            INTEGER NOT NULL ,
    nodeName          VARCHAR NOT NULL ,
    nodeIP            VARCHAR NOT NULL ,
    portNo            INTEGER NOT NULL ,

    sendCount         INTEGER NOT NULL ,
    sendBytes         INTEGER NOT NULL ,
    sendBuffer        INTEGER NOT NULL ,

    recvCount         INTEGER NOT NULL ,
    recvBytes         INTEGER NOT NULL ,
    recvBuffer        INTEGER NOT NULL

  ) < internal > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_JOBOPERANDS
  STD_PATH_TAG
  "
  define table se__jobOperands
  (
    jobId             INTEGER NOT NULL ,
    
    thisNodeNo        INTEGER NOT NULL ,
    thisNodeName      VARCHAR NOT NULL ,

    pipelineName      VARCHAR NOT NULL ,
    stageName         VARCHAR NOT NULL ,
    stageNo           INTEGER NOT NULL ,
    ptnId             INTEGER NOT NULL ,
    opName            VARCHAR NOT NULL ,

    operand           INTEGER NOT NULL ,
    operandName       VARCHAR NOT NULL ,
    
    numSaw            INTEGER NOT NULL ,
    firstTimeUs       INTEGER NOT NULL ,
    lastTimeUs        INTEGER NOT NULL ,
    firstTimeUs_rel   INTEGER NOT NULL ,
    lastTimeUs_rel    INTEGER NOT NULL

  ) < internal > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_JOBOPERATORS
  STD_PATH_TAG
  "
  define table se__jobOperators
  (
    jobId             INTEGER NOT NULL ,
    
    thisNodeNo        INTEGER NOT NULL ,
    thisNodeName      VARCHAR NOT NULL ,

    pipelineName      VARCHAR NOT NULL ,
    stageName         VARCHAR NOT NULL ,
    stageNo           INTEGER NOT NULL ,
    ptnId             INTEGER NOT NULL ,
    opName            VARCHAR NOT NULL ,


    responseUS        INTEGER NOT NULL ,
    maxQs             INTEGER NOT NULL ,
    operands          INTEGER NOT NULL ,
    buffIn            INTEGER NOT NULL ,
    buffOut           INTEGER NOT NULL ,
    newRowBuffers     INTEGER NOT NULL ,
    delRowBuffers     INTEGER NOT NULL ,
    newCsvBuffers     INTEGER NOT NULL ,
    delCsvBuffers     INTEGER NOT NULL ,
    numAllocs         INTEGER NOT NULL ,
    bytesAllocated    VARCHAR NOT NULL ,
    numFrees          INTEGER NOT NULL ,
    bytesFreed        VARCHAR NOT NULL ,
    maxBytes          VARCHAR NOT NULL ,
    numReads          INTEGER NOT NULL ,
    bytesRead         VARCHAR NOT NULL ,
    numWrites         INTEGER NOT NULL ,
    bytesWrite        VARCHAR NOT NULL ,
    numParcelSends    INTEGER NOT NULL ,
    numObjectsSent    INTEGER NOT NULL ,
    numParcelRecvs    INTEGER NOT NULL ,
    numObjectsRecv    INTEGER NOT NULL

  ) < internal > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_JOBREPORT
  STD_PATH_TAG
  "
  define table se__jobReport
  (
    jobId        INTEGER NOT NULL , // pu
    subset       INTEGER NOT NULL , // puSet
    t            INTEGER NOT NULL , // t
    ft           INTEGER NOT NULL , // ft
    j            INTEGER NOT NULL , // j
    fj           INTEGER NOT NULL , // fj
    groups       INTEGER NOT NULL , // groups
    responseUS   INTEGER NOT NULL ,
    magnitude    INTEGER NOT NULL

  ) < internal > = 1 ;
  "
  api::executeCommand 2discard
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
