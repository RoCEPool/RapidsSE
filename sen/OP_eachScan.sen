/*============================================================================*/
/* OP_eachScan.sen -- Operator eachScan                                       */
/*============================================================================*/

" OP_eachScan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_Xyz ...                                                     */
/*----------------------------------------------------------------------------*/
: eachScan_Xyz \handler

  // delete all operands
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: eachScan_CancelMarker \handler

  // drop the tablePtn lock if held
  counter0[] true == if
    TablePtn[].dropRead
    false to counter0[]
  then

  // delete the ptn stream
  ptnStream[].isNull not if
    ptnStream[] ptnStream.delete
  then

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER / ZK_ROWBUFFER...                                 */
/*----------------------------------------------------------------------------*/
// ": eachScan_RowCrwBuffer" .

: eachScan_RowCrwBuffer \handler
  
  debug::flag@ if "(Revised) eachScan_RowCrwBuffer handler" . then

  // read next buffer from ptn stream
  ptnStream[] ptnStream.read to Operand[]
 
  Operand[].isNotNull if
    // read a next crw buffer

    // pipe out the read crw buffer
    Operand[].pipeOut
 
    // call this handler again to process next buffer
    true LogicUnit[].callAgain!
 
  else
    // no more crw buffers
 
    // close the partition stream
    ptnStream[] ptnStream.close

    // send an eachScanEosMarker
    Operand[].newEachScanEosMarker
    Operand[].pipeout
  then
 
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 
  // check for rate metering
 
  0 locals| rateSecs |

  "<rateSecs>" job[] job.tagSet@ tagSet.hasName if
    <rateSecs> >int to rateSecs
  then

  rateSecs if
    rateSecs "Scan Pausing for %v secs" str.format .
    rateSecs task::sleepSsec
    "Scan awake" .
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
// ": eachScan_DataMarker" .

: eachScan_DataMarker \handler
 
  debug::flag@ if "(Revised) eachScan_DataMarker handler" . then

  // pipe out the pulse marker
  PipeIn[].pipeOut

  // pipe out a new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // grab table ptn read lock
  TablePtn[].grabRead_yieldLoop

  // set counter0 to true to indicate lock held
  true to counter0[]

  // new a partition stream for access crw buffer
  TablePtn[] ptnStream::new to ptnStream[]
 
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EACHROWBUFFER ...                                           */
/*----------------------------------------------------------------------------*/
// ": eachScan_EachRowBuffer" .

: eachScan_EachRowBuffer \handler

  PipeIn[].pipeout

  // open partition stream to access the crw buffers
  ptnStream[] ptnStream.open if

    // force op loop to call eachScan_CrwBuffer to start processing buffers
    "eachScan_RowCrwBuffer" word::find LogicUnit[].handler!
    true LogicUnit[].callAgain!

  else

    // unable to open partition stream (this would be unusual)

    // delete partition stream
    ptnStream[] ptnStream.delete
    nullptr to ptnStream[]

    // drop table ptn lock
    TablePtn[].dropRead

    // set counter0 to 0 to indicate lock released
    false to counter0[]

    // send an eos marker (there was no data)
    Operand[].newEosMarker
    Operand[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
// ": eachScan_EosMarker" .

: eachScan_EosMarker \handler

  // send an eos marker
  PipeIn[].pipeout

  // delete partition stream
  ptnStream[] ptnStream.delete
  nullptr to ptnStream[]

  // drop table ptn lock
  TablePtn[].dropRead

  // set counter0 to 0 to indicate lock released
  false to counter0[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
// ": eachScan_StartMarker" .

: eachScan_StartMarker \handler

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
    PipeIn[].pipeOut
  else
    // is possible that a PULSEDMARKER arrives after this STARTMARKER
    // as per pipeline protocol no op can receive a pulsedmarker without a startmarker
    // we need eat the pulsedmarker here
    find: eachScan_Xyz   ZK_DATAPULSE      op[].handler!
    find: eachScan_Xyz   ZK_PULSEDMARKER   op[].handler!
  then

  //args.developer if
  //  1 debug::flag!
  //then

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: eachScan_req \operator

  LogReqEntry SEED_REQ

  "<catalogNm>"  job[] job.tagSet@ tagSet.hasName if
    <schemaNm> <catalogNm>
    "/tenants/boray/catalogs/%v/schemas/%v/tables" str.format
    str.toStrVec Path[].set
  then

  op__topology

  find: eachScan_CancelMarker  ZK_CANCELMARKER  op[].handler!
  find: eachScan_EosMarker     ZK_EOSMARKER     op[].handler!
  find: eachScan_EachRowBuffer ZK_EACHROWBUFFER op[].handler!
  find: eachScan_RowCrwBuffer  ZK_CRWBUFFER     op[].handler!
  find: eachScan_DataMarker    ZK_DATAPULSE     op[].handler!
  find: eachScan_RowCrwBuffer  ZK_ROWBUFFER     op[].handler!
  find: eachScan_StartMarker   ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eachScan :: eachScan <tableNm> ;
cmdSyntax: eachScan :: eachScan <catalogNm> <schemaNm> <tableNm> ;
cmdSyntax: eachScan :: eachScan <tableNm> <rateSecs> ;
cmdSyntax: eachScan :: eachScan <catalogNm> <schemaNm> <tableNm> <rateSecs> ;

: eachScan_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
