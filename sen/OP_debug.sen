/*============================================================================*/
/* OP_debug.sen -- Operator debug                                             */
/*============================================================================*/

" OP_debug.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER ...                                                      */
/*----------------------------------------------------------------------------*/
: debug_RowBuffer \handler

  pipeIn[]\clear to RowBuffer[]

  RowBuffer[].ptnId RowBuffer[].decile RowBuffer[].rows [op].partition@ [op].stageName@
    "%v.%v RowBuffer: %v rows (decile %v ptnid %v)" .printf
  
  1 0 [pipeline].addAccum
  RowBuffer[].rows 1 [pipeline].addAccum
 
  RowBuffer[].pipeout
  
  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER ...                                                      */
/*----------------------------------------------------------------------------*/
: debug_SeeRowBuffer \handler

  pipeIn[]\clear to RowBuffer[]

  [pipeline].grabDebugLock
  
  RowBuffer[].ptnId RowBuffer[].decile RowBuffer[].rows [op].partition@ [op].stageName@
    "%v.%v RowBuffer: %v rows (decile %v ptnid %v)" .printf
  
  1 0 [pipeline].addAccum
  RowBuffer[].rows 1 [pipeline].addAccum
 
  RowBuffer[].print
   
  [pipeline].dropDebugLock
  
  RowBuffer[].pipeout
  
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: debug_StreamDef \handler
  
  PipeIn[]\clear to StreamDefLft[]
  
  [op].stageName@ "%v: " .printf
  StreamDefLft[].print

  StreamDefLft[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: debug_EOS \handler

  1 [pipeline].getAccum 0 [pipeline].getAccum "Total: %v buffers %v rows" .printf

  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_ ...                                                                 */
/*----------------------------------------------------------------------------*/
: debug_ALL \handler

  PipeIn[] locals| pOperand |
  
  //pOperand object.class@ class::name "DEBUG: %v" .printf
  
  PipeIn[].kind [EvMgr].decodeEventNm "EVENT: %v" .printf
  PipeIn[].kind [EvMgr].decodeHandlerNm find execute
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for debug req                                                      */
/*----------------------------------------------------------------------------*/
 : debug_op \operator

  _lu_initialise_

  op__topology

  <option> "all" str.same if
    find: debug_ALL [op].handlerAll!
  then

  <option> "accum0" str.same if
    find: debug_EOS EV_M_EOS [op].handler!
  then

  <option> "streamdef" str.same if
    find: debug_StreamDef EV_D_STREAMDEF [op].handler!
  then
  
  <option> "rowbuffer" str.same if
    find: debug_RowBuffer EV_D_ROWBUFFER [op].handler!
  then
  
  <option> "seeRowbuffer" str.same if
    find: debug_SeeRowBuffer EV_D_ROWBUFFER [op].handler!
  then
  
  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: debug :: debug <option> ;

: debug_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "debug_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
