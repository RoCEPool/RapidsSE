/*============================================================================*/
/* OP_ping.sen -- Operator space                                             */
/*============================================================================*/

" OP_ping.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: ping_action

  "ping" str.toPromptOut [op].pipeout
  //10000 str.random dup .
  //  str.toPromptOut [op].pipeout

  "ping sleeps" .
  1 thread::sleepSsec
  "ping wakes" .

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  // add pingInfo to the Pds
  "pong" 1 Pds[].addRowVargs assert

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: ping :: ping ;

: ping_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 0
    <streamDef>   = __pingInfo

    <opEntry> = "ping_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
