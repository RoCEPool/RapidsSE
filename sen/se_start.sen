/*============================================================================*/
/* se_start.sen -- Start System                                               */
/*============================================================================*/

" se_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/

" start_run" .verbose

: start_run ( -- <R> )

  LogEntry SEED_RUN

  nullptr locals| pParentJob |

  "start_run" .verbose

  // define the apriori procedures
  start::defProc_Create
  start::defProc_Drop
  start::defProc_Scan
  start::defProc_Load
  start::defProc_Api
  start::defProc_File
  start::defProc_Elasticity
  start::defProc_SteadyState
  start::defProc_UnloadReload
  start::defProc_Query
  start::defProc_DynCompiler
  start::defProc_TPCH
  start::defProc_TPCH_ASM
  start::defProc_TPCH_ASM_I
  start::defProc_Planner
  start::defProc_PlannerTPCH
  start::defProc_Meta
  start::defProc_SqlCompiler

  // define the apriori system tables
  start::defineTables
  start::defineTables2

  // define the apriori infoset tables
  start::defineInfoSets
  start::defineInternalTables

  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  //
  // This point onwards the SE execution model has been fully booted
  // and we can now spawn jobs
  //
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  // spawn supervisor demon
  "" false superDemonPipelineCmd api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn monitor demon
  "" false monDemonPipelineCmd api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn recurring demon
  //  "" false recurringDemonPipelineCmd api::spawnDemon not if
  //    "Error Code %v" .printf
  //  then

  // spawn stat demon
  "" false statDemonPipelineCmd api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn waker demon
  "" false wakerDemonPipelineCmd api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn answer demon
  "" false answerDemonPipelineCmd api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn connector demon
  "" false connDemonPipelineCmd api::spawnDemon not if
    "Error Code %v" .printf
  then

  // What if we start the cluster here, then we can execute any DDL
  // We can use the same pipe command to start the cluster, because
  // in the new model, it's only one node to start
  //args.nodeName .
  args.nodeName "NODE0" str.same if
  "START CLUSTER OF 1" .

  "
   bootCluster
  "
  locals| sStmt |

  "" sStmt api::executeRequest
 then

  "end start_run" .verbose

  // delete task instead of returning to nowhere
  task::scheduleDelete

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
