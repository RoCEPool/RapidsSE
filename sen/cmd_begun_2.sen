/*============================================================================*/
/* cmd_begun_2.sen -- 1sc: given pipeline has begun on participant            */
/*============================================================================*/

" cmd_begun_2.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                    ON ORIGINATING NODE OF GIVEN PIPELINE                   */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/
: begun_2:onOrigin

  "begun_2:onOrigin" .
  
  // find the originating job
  
  [job].parentId@ ListedJob[].findOriginator? if

    ListedJob[].task@ task.ack
  
    ListedJob[].returnReference
    
  then
  
  [job]:retire
  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* run this received Job_Begun on originating node                            */
/*----------------------------------------------------------------------------*/
: begun_2:begun_2

  "begun_2:begun_2" .

  "begun_2:onOrigin" [job].entryPoint!

  [job].parentOriginNodeId@ [grid].findNodeByNo to SendNode[]
  
  [job] job.send

  nullptr to SendNode[]
  
  [job]:retire
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: begun_2 :: begun_2 ;

: begun_2_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "begun_2:begun_2"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
