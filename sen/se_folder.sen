/*============================================================================*/
/* se_folder.sen -- folder related words                                      */
/*============================================================================*/

" se_folder.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: folder.hasRef ( word )

  dup execute dic.ref
;

/*----------------------------------------------------------------------------*/
/* check dic is empty                                                         */
/*----------------------------------------------------------------------------*/
: folder.isEmpty ( pFolder -- true | error false )

  dup execute dic.wordCount if EC_FOLDER_NOT_EMPTY false exit_rt then

  true
;

/*----------------------------------------------------------------------------*/
/* check folder is not in use                                                 */
/*----------------------------------------------------------------------------*/
: folder.notUsed ( pFolder -- true | error false )

  folder.hasRef if EC_FOLDER_IN_USE false exit_rt then

  true
;

/*----------------------------------------------------------------------------*/
/* get current folder                                                         */
/*----------------------------------------------------------------------------*/
: folder[] ( -- )

  path[].depth 1 - path[].pick
;

/*----------------------------------------------------------------------------*/
/* get current folder contents                                                */
/*----------------------------------------------------------------------------*/
: folder[].contentStr ( -- s )

  ""
  folder[] dic.lastWord dup iterate

    object@ word.name@ str.cat

    " " str.cat

    object@ word.prev object!

  next
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make new folder given name                                                 */
/*----------------------------------------------------------------------------*/
: folder::makeFolder params| sFolderNm |

dicLock.grabwrite

  find: \folder locals| pwFolderCatg |

  sFolderNm dic::new locals| pFolder |

  sFolderNm word::new locals| pwFolder |

  pwFolderCatg pFolder pwFolder word.cppObject!

dicLock.dropwrite

  args.verbose if
    pwFolder word.name@
    path[].toStr
      "Created folder %v/%v" .printf
  then

  //pwFolder word.see

  pwFolder // returns:
;

/*----------------------------------------------------------------------------*/
/* make a sub-folder under given folder                                       */
/*----------------------------------------------------------------------------*/
: folder::makeSubFolder params| pFolder sSubFolderNm |

  pFolder path[].pushFolder

    find: \folder
    sSubFolderNm folder::makeFolder execute dic.kind!

  path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* remove folder                                                              */
/*----------------------------------------------------------------------------*/
: folder::remove params| sFolderNm |

  sFolderNm find locals| pWord |

  pWord not if exit_rt then

  pWord word.object@ locals| pDic |
  0 pWord word.object!

  pDic dic.delete
 
  sFolderNm :forget
;

/*----------------------------------------------------------------------------*/
/* test name is a known table                                                 */
/*----------------------------------------------------------------------------*/
: name::isSubFolder params| sTableNm | ( t | f )

  sTableNm folder[].findSymbol locals| pwWord |

  pwWord not if false exit then

  pwWord word.category@ find: \folder eql
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* list all words (long form) in the current dictionary                       */
/*----------------------------------------------------------------------------*/
: symbols \prompt

  path[].toStr .put "::" .put .\n

  folder[] dic.lastWord
  begin dup while
    dup word.name@ .put " " .put dup word.category@ word.name@ .put .\n
    word.prev
  repeat
  discard
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
