/*============================================================================*/
/* it_jobTables2.sen -- Define Job Tables                                     */
/*============================================================================*/

" it_jobTables2.sen" .verbose

/*----------------------------------------------------------------------------*/
/* define internal tables                                                     */
/*----------------------------------------------------------------------------*/

: start::it_jobTables2

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_JOBMETRICS
  STD_PATH_TAG
  "
  define table se__jobMetrics
  (
    jobId             INTEGER NOT NULL ,
        
    nodeNo            INTEGER NOT NULL ,
    nodeName          VARCHAR NOT NULL ,

    pipelineName      VARCHAR NOT NULL ,
    stageNo           INTEGER NOT NULL ,
    stageName         VARCHAR NOT NULL ,
    streamNo          INTEGER NOT NULL ,
    opNo              INTEGER NOT NULL ,
    opName            VARCHAR NOT NULL ,

    nRefTimer         INTEGER NOT NULL ,
    nMilliseconds     INTEGER NOT NULL ,
    nThreadsIdle      INTEGER NOT NULL ,
    nPctfree          INTEGER NOT NULL ,

    nPotSize          INTEGER NOT NULL ,
    nTmpIndexSize     INTEGER NOT NULL ,
    nQueued           INTEGER NOT NULL
    
  ) < internal > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_SYSMETRICS
  STD_PATH_TAG
  "
  define table se__sysMetrics
  (
    nodeNo            INTEGER NOT NULL ,
    nodeName          VARCHAR NOT NULL ,

    nSince            INTEGER NOT NULL ,
    nRefTimer         INTEGER NOT NULL ,

    nDataHeap         INTEGER NOT NULL ,
    nLargeHeap        INTEGER NOT NULL ,
    nMediumHeap       INTEGER NOT NULL ,
    nSmallHeap        INTEGER NOT NULL ,
    nTinyHeap         INTEGER NOT NULL ,
    
    nPctfree          INTEGER NOT NULL ,
    nThreadsIdle      INTEGER NOT NULL
    
  ) < internal > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_SYSLOCKS
  STD_PATH_TAG
  "
  define table se__sysLocks
  (
    nodeNo            INTEGER NOT NULL ,
    nodeName          VARCHAR NOT NULL ,

    nSince            INTEGER NOT NULL ,
    nRefTimer         INTEGER NOT NULL ,
    
    lockNo            INTEGER NOT NULL ,
    lockName          VARCHAR NOT NULL ,

    nReadGrabs        INTEGER NOT NULL ,
    nReadCollisions   INTEGER NOT NULL ,

    nWriteGrabs       INTEGER NOT NULL ,
    nWriteCollisions  INTEGER NOT NULL

  ) < internal > = 1 ;
  "
  api::executeCommand 2discard
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
