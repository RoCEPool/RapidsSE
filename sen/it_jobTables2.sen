/*============================================================================*/
/* it_jobTables2.sen -- Define Job Tables                                     */
/*============================================================================*/

" it_jobTables2.sen" .verbose

/*----------------------------------------------------------------------------*/
/* define internal tables                                                     */
/*----------------------------------------------------------------------------*/

: start::it_jobTables2

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_JOBNETDISSECT
  STD_PATH_TAG
  "
  define table se__jobNetDissect
  (
    jobId             INTEGER NOT NULL ,
    
    thisNodeNo        INTEGER NOT NULL ,
    thisNodeName      VARCHAR NOT NULL ,
    
    nodeNo            INTEGER NOT NULL ,
    nodeName          VARCHAR NOT NULL ,

    socket            VARCHAR NOT NULL ,
    kind              VARCHAR NOT NULL ,

    cnt               INTEGER NOT NULL ,
    bytes             INTEGER NOT NULL

  ) < internal > = 1 ;
  "
  api::executeCommand 2discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // C_TDEF_JOBNETWORK
  STD_PATH_TAG
  "
  define table se__jobNetwork
  (
    jobId             INTEGER NOT NULL ,
    
    thisNodeNo        INTEGER NOT NULL ,
    thisNodeName      VARCHAR NOT NULL ,

    nodeNo            INTEGER NOT NULL ,
    nodeName          VARCHAR NOT NULL ,
    nodeIP            VARCHAR NOT NULL ,
    portNo            INTEGER NOT NULL ,

    sendCount         INTEGER NOT NULL ,
    sendBytes         INTEGER NOT NULL ,
    sendBuffer        INTEGER NOT NULL ,

    recvCount         INTEGER NOT NULL ,
    recvBytes         INTEGER NOT NULL ,
    recvBuffer        INTEGER NOT NULL

  ) < internal > = 1 ;
  "
  api::executeCommand 2discard


;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
