/*============================================================================*/
/* OP_sleep.sen -- sleep for given time                                       */
/*============================================================================*/

" OP_sleep.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_Xyz ...                                                              */
/*----------------------------------------------------------------------------*/
: sleep_sleep \handler

  "sleeping" .
  <nSeconds> task::sleepSsec
  "awake" .

  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* sleep request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sleep_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sleep_sleep  ZK_DATAPULSE  op[].handler!

  op__loop

  // "*** sleep_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sleep :: sleep <nSeconds> ;

: sleep_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
