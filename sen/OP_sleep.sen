/*============================================================================*/
/* OP_sleep.sen -- sleep for given time                                       */
/*============================================================================*/

" OP_sleep.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: sleep_sleep \handler

  "sleeping" .
  <nSeconds> >int task::sleepSsec
  "awake" .

  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* sleep request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sleep_op \operator

  _lu_initialise_

  op__topology

  find: sleep_sleep  ZK_M_DATAPULSE  op[].handler!

  op__loop

  // "*** sleep_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sleep :: sleep <nSeconds> ;

: sleep_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
