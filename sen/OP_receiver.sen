/*============================================================================*/
/* OP_receiver.sen -- Operator receiver                                       */
/*============================================================================*/

" OP_receiver.sen" .verbose

/*----------------------------------------------------------------------------*/
/* receiver init                                                              */
/*----------------------------------------------------------------------------*/
: receiver_init ( -- )

  CN_JOB task[] task.thread thread.dedicated!

  NS_ACTIVE grid::thisNode@ grid::node node.state!

  args.verbose if
    grid::thisNode@ "receiver running on node %v" .printf
  then
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<ansNode>" job[] job.tagSet@ tagSet.hasName assert

  <ansNode> >int >ptr node.recvSocket@ to Socket[]
;

/*----------------------------------------------------------------------------*/
/* receive next operand object                                                */
/*----------------------------------------------------------------------------*/
: receiver_recvOperand_2

  nullptr to Register0[]

  Socket[].recvObject
  
  Socket[].success@ not if
    exit
  then
  
  Socket[].object@\clear to Register0[]
;
/*----------------------------------------------------------------------------*/
: receiver_recvOperand

  nullptr to Register0[]

  Socket[].recvObject
  
  Socket[].success@ not if
    exit
  then
  
  Socket[].object@\clear to Register0[]
;

/*----------------------------------------------------------------------------*/
/* receive next argument object                                               */
/*----------------------------------------------------------------------------*/
: receiver_recvArgument_2

  nullptr to Register1[]

  Socket[].recvObject
  
  Socket[].success@ not if
    false
    exit
  then
  
  Socket[].object@\clear to Register1[]
;
/*----------------------------------------------------------------------------*/
: receiver_recvArgument

  nullptr to Register1[]

  Socket[].recvObject
  
  Socket[].success@ not if
    false
    exit
  then
  
  Socket[].object@\clear to Register1[]
;

/*----------------------------------------------------------------------------*/
/* receive next object(s)                                                     */
/*----------------------------------------------------------------------------*/
: receiver_recvNext_2

  receiver_recvOperand

  Socket[].success@
;
/*----------------------------------------------------------------------------*/
: receiver_recvNext

  // get operand
  
  receiver_recvOperand

  Socket[].success@ not if
    false exit
  then
    
      
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get argument

  Register0[] object.recvArgs@ 0 == if
    true exit
  then
  
  receiver_recvArgument
      
  true
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: receiver_dispatch_2 ( -- )

  // null object (low memory)
  Register0[] not if
    exit
  then
    
  Register0[] Register0[] object.dispatchWord@ execute
;
/*----------------------------------------------------------------------------*/
: receiver_dispatch ( -- )

  // null object (low memory)
  Register0[] not if
    exit
  then
    

  // object with no arguments (probably job)
  Register0[] object.recvArgs@ 0 == if
    Register0[] Register0[] object.dispatchWord@ execute
    exit
  then
  
  
  // object with one argument (probably xmitoperand)
  Register0[] object.recvArgs@ 1 == if
    Register1[] Register0[] Register0[] object.dispatchWord@ execute
    exit
  then
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: receiver_loop_2 ( -- )

  begin

    trap::stackDepthZero

    // receive next object(s)
    receiver_recvNext
    not if
      exit
    then
        
    receiver_dispatch

  again
;
/*----------------------------------------------------------------------------*/
: receiver_loop ( -- )

  begin

    trap::stackDepthZero

    // receive next object(s)
    receiver_recvNext
    not if
      exit
    then
        
    receiver_dispatch

  again
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: receiver_StartMarker \handler

  // initialise
  receiver_init

  // loop, receiving and executing jobs
  receiver_loop

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute for receiver req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : receiver_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: receiver_StartMarker ZK_STARTMARKER op[].handler!

  // get the pipeline job of the operator
  Op.pipelineJob@ locals| pPipelineJob |

  // peek to see if any operand
  begin
    Pipein[].peek
  not while
    "receiver waiting for STARTMARKER..." .verbose
    2 thread::sleepMsec
  repeat

  assert::stack_0

  // pop operand from queue into PipeIn[]
  PipeIn[].peek assert
  PipeIn[].next

  // execute the operator's handler for the operand
  PipeIn[].kind op[].handler@ execute

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: receiver :: receiver ;

: receiver_cmdTags _cmdTags tagCopy: serviceOp_tags
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
