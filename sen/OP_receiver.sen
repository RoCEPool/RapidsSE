/*============================================================================*/
/* OP_receiver.sen -- Operator receiver                                       */
/*============================================================================*/

" OP_receiver.sen" .verbose

/*----------------------------------------------------------------------------*/
/* receiver init                                                              */
/*----------------------------------------------------------------------------*/
: receiver_init ( -- )

  CN_JOB task[] task.thread thread.dedicated!

  NS_ACTIVE grid::thisNode@ grid::node node.state!

  args.verbose if
    grid::thisNode@ "receiver running on node %v" .printf
  then
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<ansNode>" job[] job.tagSet@ tagSet.hasName assert

  <ansNode> >int >ptr node.recvSocket@ to Socket[]
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: receiver_loop ( -- )

  begin

    trap::stackDepthZero

    // -- -- -- -- -- -- -- --
    // recv first object

    Socket[] socket.recvObject

    not if
      //ifAgain
      "receiver exiting" .
      exit
    then

    to Register0[]

    // -- -- -- -- -- -- -- --
    // log received job

    //pReceivedJob job_receiver::jobReceived

    // -- -- -- -- -- -- -- --
    // run post receive function

    Register0[] object.postRecv
    

    // -- -- -- -- -- -- -- --
    // recv operand

    Register0[] object.class@ CN_XMITOPERAND == if
      Socket[] socket.recvObject true == if
        to Register1[]
        
        Register1[] object.postRecv
        
        Register1[] Register0[] xmitOperand.operand!
        Register0[] xmitOperand.pipeOut
      else
       nullptr Register0[] xmitOperand.operand!
       Register0[] xmitOperand.pipeOut
      then
      
    else
    Register0[] object.class@ CN_JOB == if
    
      // -- -- -- -- -- -- -- --
      // examine job
      //pReceivedJob job.kind@ JK_GENERIC == if
      //"received a generic job" .
      //  pReceivedJob job.tagSet@ tagSet.asStr .
      //then

      Register0[] job.postRecv
      //pReceivedJob job.name@ grid::thisNodeName@ "(%v) receiver_loop %v" .printf
      Register0[] job.seedDecode
      Register0[] job.seed!
      Register0[] job.spawn_received
    else
      HAZARD
    then then

    nullptr to Register0[]
    nullptr to Register1[]

  again
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: receiver_StartMarker \handler

  // initialise
  receiver_init

  // loop, receiving and executing jobs
  receiver_loop

  // should never exit
  //hazard

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute for receiver req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : receiver_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: receiver_StartMarker ZK_STARTMARKER op[].handler!

  // get the pipeline job of the operator
  Op.pipelineJob@ locals| pPipelineJob |

 // peek to see if any operand
  begin
    Pipein[].peek
  not while
    "receiver waiting for STARTMARKER..." .verbose
    2 thread::sleepMsec
  repeat

  assert::stack_0

  // pop next operand from queue into PipeIn[]
  PipeIn[].next

  // execute the operator's handler for the operand
  PipeIn[].kind op[].handler@ execute

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: receiver :: receiver ;

: receiver_cmdTags _cmdTags tagCopy: serviceOp_tags
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
