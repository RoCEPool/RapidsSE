/*============================================================================*/
/* OP_reap.sen -- Operator reap                                               */
/*============================================================================*/

" OP_reap.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add reap activity here                                                     */
/*----------------------------------------------------------------------------*/
: reap_activity ( -- )

  api::reapJobs
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: reap_StartMarker \handler

  "reap Demon Started" .boot
    
  begin

    // args.demonSleep thread::sleepSsec
    1 thread::sleepSsec

    reap_activity

  again
;

/*----------------------------------------------------------------------------*/
/* execute for reap req                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : reap_op \operator
 
  _lu_initialise_

  op__topology

  find: reap_StartMarker ZK_M_START op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: reap :: reap ;

: reap_cmdTags _cmdTags tagCopy: op_tags

  tags{ <dedicatedThd> = 1 }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
