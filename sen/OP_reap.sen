/*============================================================================*/
/* OP_reap.sen -- Operator reap                                               */
/*============================================================================*/

" OP_reap.sen" .verbose

/*----------------------------------------------------------------------------*/
/* add reap activity here                                                     */
/*----------------------------------------------------------------------------*/
: reap_activity ( -- )

  api::reapJobs
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: reap_StartMarker \handler

  "reap Demon Started" .boot
    
  begin

    args.demonSleep thread::sleepSsec

    reap_activity

  again
;

/*----------------------------------------------------------------------------*/
/* execute for reap req                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : reap_req \operator
 
  _op_begin_

  op__topology

  find: reap_StartMarker ZK_M_START op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: reap :: reap ;

: reap_cmdTags _cmdTags tagCopy: serviceOp_tags

  tags{ <dedicatedThd> = 1 }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
