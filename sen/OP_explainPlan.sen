/*============================================================================*/
/* OP_explainPlan.sen -- Explain Plan Op (SQL Compiler)                       */
/*============================================================================*/

" OP_explainPlan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: explainPlan_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: explainPlan_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCompileErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::explainPlan to PlanOperand[]

  "explainPlan" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: explainPlan_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker      EV_M_LEAVE         [op].handler!
  find: compiler_StreamSet        EV_D_STREAMSET     [op].handler!

  // specific handlers
  find: explainPlan_Cleaning      EV_M_CLEANING      [op].handler!
  find: explainPlan_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: explainPlan :: explainPlan ;

: explainPlan_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "explainPlan_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
