/*============================================================================*/
/* OP_explainPlan.sen -- Explain Plan Op (SQL Compiler)                       */
/*============================================================================*/

" OP_explainPlan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANUP ...                                           */
/*----------------------------------------------------------------------------*/
: explainPlan_CleanupMarker \handler

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: explainPlan_PlanOperand \handler

  PipeIn[]\clear to Operand[]

  // create the command error info set
  op__cmdErrInfoSet

  Operand[] nullptr to Operand[] sqlCompiler::explainPlan to Operand[]

   "explainPlan" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: explainPlan_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker      ZK_M_LEAVE   op[].handler!
  find: compiler_StreamSet        ZK_D_STREAMSET     op[].handler!

  // specific handlers
  find: explainPlan_CleanupMarker ZK_M_CLEANUP op[].handler!
  find: explainPlan_PlanOperand   ZK_D_PLANOPERAND   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: explainPlan :: explainPlan ;

: explainPlan_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
