/*============================================================================*/
/* cmd_pipeline.sen -- Distributed Pipeline Command                           */
/*============================================================================*/

" cmd_pipeline.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            ON ORIGINATING NODE                             //
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* coordinate a distributed pipeline command from this job on originator      */
/*----------------------------------------------------------------------------*/
: pipeline:origin
  //"pipeline:origin" .

/* org_ org */  // - - - - - - - - - - - - - - - - - -
/* org_ org */  // start as ordinary job on this node
/* org_ org */  // - - - - - - - - - - - - - - - - - -
/* org_ org */
/* org_ org */  [args].distJob if
/* org_ org */    "pipeline" "origin" "org_ org now ordinary" [job].trace
/* org_ org */  then
/* org_ org */
/* org_ org */
/* org_ org */  // - - - - - -
/* org_ org */  // pre-checks
/* org_ org */  // - - - - - -
/* org_ org */
/* org_ org */  // there should be this immutable job
/* org_ org */  //   and it shouldnt be in any job list (yet)
/* org_ org */  [job] assert
/* org_ org */  [job].assertStructure
/* org_ org */  [job].assertOrdinary
/* org_ org */
/* org_ org */  // mutable pipeSpec, pipeline and subpipeline
/* org_ org */  //   in logicUnit should be null
/* org_ org */  PipeSpec[] not assert
/* org_ org */  Pipeline[] not assert
/* org_ org */
/* org_ org */  // immutable op, subPLineOfOp and
/* org_ org */  //   pipelineOfOp should be null
/* org_ org */  [op]       not assert
/* org_ org */  [pipeline] not assert
/* org_ org */
/* org_ org */  // and so we start...
/* org_ org */  [job].tscBeginning
/* org_ org */
/* org_ org */  // pre-check
/* org_ org */  "<preCheck>" [job].tagSet@ tagSet.hasName if
/* org_ org */    // + tag exists
/* org_ org */
/* org_ org */    <preCheck> find execute not if
/* org_ org */      // - preCheck word failed
/* org_ org */
/* org_ org */      [job].error!
/* org_ org */
/* org_ org */      [ddlLock].testDrop
/* org_ org */      ListedJob[].assertNoRef
/* org_ org */
/* org_ org */      Path[].discardAll
/* org_ org */      [job].addRetired
/* org_ org */
/* org_ org */      [job].signalWaiter
/* org_ org */
/* org_ org */      [task].grabLock
/* org_ org */        [task].retire // does not queue onto exit demon
/* org_ org */
/* org_ org */      HAZARD
/* org_ org */
/* org_ org */    then
/* org_ org */  then

/* ---- --- */  // !!! org !!! org !!! org !!! org !!! org !!! org !!! org !!!

/* org_ org */  // - - - - - - - - - - - - - - - - - -
/* org_ org */  // become the originator on this node
/* org_ org */  // - - - - - - - - - - - - - - - - - -
/* org_ org */
/* org_ org */  // add this job to originator job list
/* org_ org */  [job].setOriginId
/* org_ org */  [job].distIdGenerate
/* org_ org */  [job].addOriginator
/* org_ org */  [job].assertOriginator
/* org_ org */
/* org_ org */  [args].distJob if
/* org_ org */    "pipeline" "origin" "org_ org now originator" [job].trace
/* org_ org */  then
/* org_ org */
/* org_ org */  "<show_command>" sysargs::tagSet@ tagSet.hasName if
/* org_ org */    <cmd> .
/* org_ org */    //<cmd> "pipeline:origin: %v\n" .printf
/* org_ org */    //jobs::seeRlist
/* org_ org */    //[system].bpa
/* org_ org */  then
/* org_ org */
/* org_ org */
/* org_ org */  // - - - - - - - - - - - - - - - - - - - - - - - -
/* org_ org */  // compile pipeline statement to check its syntax
/* org_ org */  // - - - - - - - - - - - - - - - - - - - - - - - -
/* org_ org */
/* org_ org */  Dynamo[].new
/* org_ org */
/* org_ org */  <cmd> Dynamo[].compile to ErrorCode[]
/* org_ org */
/* org_ org */  ErrorCode[] EC_NONE == if
/* org_ org */    // + clean compile
/* org_ org */    to PipeSpec[]
/* org_ org */  else
/* org_ org */    // - didnt compile
/* org_ org */    ErrorCode[] [job].error!
/* org_ org */    [ddlLock].testDrop
/* org_ org */  then
/* org_ org */
/* org_ org */  Dynamo[].delete
/* org_ org */
/* org_ org */
/* org_ org */  // - - - - - - - - - - - - - - - - - -
/* org_ org */  // test if distributed job may execute
/* org_ org */  // - - - - - - - - - - - - - - - - - -
/* org_ org */
/* org_ org */  [job].error@ not if
/* org_ org */    [job].preExecuteTest to ErrorCode[]
/* org_ org */    ErrorCode[] if
/* org_ org */      ErrorCode[] [job].error!
/* org_ org */      [ddlLock].testDrop
/* org_ org */    then
/* org_ org */  then
/* org_ org */
/* org_ org */
/* org_ org */  // - - - - - - - - - -
/* org_ org */  // test if optimising
/* org_ org */  // - - - - - - - - - -
/* org_ org */
/* org_ org */  [job].error@ not if
/* org_ org */
/* org_ org */    "<optimise>" [job].tagSet@ tagSet.hasName
/* org_ org */    PipeSpec[].optimisable
/* org_ org */    and
/* org_ org */    if
/* org_ org */      "Would Optimise" .
/* org_ org */      <cmd> .
/* org_ org */    then
/* org_ org */
/* org_ org */
/* org_ org */    Optimiser[].new
/* org_ org */
/* org_ org *///    PipeSpec[] Optimiser[].dissect
/* org_ org *///    Optimiser[].optimise
/* org_ org *///    Optimiser[].weave discard
/* org_ org */
/* org_ org */    Optimiser[].delete
/* org_ org */  then
/* org_ org */
/* org_ org */
/* org_ org */  // - - - -
/* org_ org */  // tidy up
/* org_ org */  // - - - -
/* org_ org */
/* org_ org */  PipeSpec[] if
/* org_ org */    PipeSpec[].delete
/* org_ org */  then
/* org_ org */
/* org_ org */  Dynamo[]    not assert
/* org_ org */  Optimiser[] not assert
/* org_ org */  PipeSpec[]  not assert


/* ---- --- */  // >>> beg >>> beg >>> beg >>> beg >>> beg >>> beg >>> beg >>>
/* org_ beg */
/* org_ beg */  // - - - - - - - - - - - - - - - - - - - - - - - -
/* org_ beg */  // broadcast this job as the distributed pipeline
/* org_ beg */  // - - - - - - - - - - - - - - - - - - - - - - - -
/* org_ beg */
/* org_ beg */  [job].error@ not if
/* org_ beg */    // + compiled without error..
/* org_ beg */
/* org_ beg */    [args].distJob if
/* org_ beg */      "pipeline" "origin" "org_ beg brd begin" [job].trace
/* org_ beg */    then
/* org_ beg */
/* org_ beg */    "pipeline:ptpBegin" [job].entryPoint!
/* org_ beg */
/* org_ beg */    [task].grabLock
/* org_ beg */      [grid].knownNodes [task].acksRemaining!
/* org_ beg */      [job]:broadcast
/* org_ beg */    [task].wait
/* org_ beg */
/* org_ beg */    [job].tscBegun
/* org_ beg */  then
/* org_ beg */
/* ---- --- */  // <<< bgn <<< bgn <<< bgn <<< bgn <<< bgn <<< bgn <<< bgn <<<


/* ---- --- */  // >>> exe >>> exe >>> exe >>> exe >>> exe >>> exe >>> exe >>>
/* org_ exe */
/* org_ exe */  // - - - - - - - - - - - - - - - - - - - - - - - -
/* org_ exe */  // broadcast a job to schedule pipeline to execute
/* org_ exe */  // - - - - - - - - - - - - - - - - - - - - - - - -
/* org_ exe */
/* org_ exe */  [job].error@ not if
/* org_ exe */
/* org_ exe */    // "ORIGIN: broadcast execute" .
/* org_ exe */
/* org_ exe */    [args].distJob if
/* org_ exe */      "pipeline" "origin" "org_ exd all begun" [job].trace
/* org_ exe */      "pipeline" "origin" "org_ exe brd execute" [job].trace
/* org_ exe */    then
/* org_ exe */
/* org_ exe */    [job].tscExecuting
/* org_ exe */
/* org_ exe */    [task].grabLock
/* org_ exe */      [grid].knownNodes [task].acksRemaining!
/* org_ exe */      STD_NOWAIT_TAG "execute" api::forkChild discard
/* org_ exe */    [task].wait
/* org_ exe */
/* org_ exe */    [job].tscExecuted
/* org_ exe */
/* org_ exe */  then
/* org_ exe */
/* ---- --- */  // <<< exd <<< exd <<< exd <<< exd <<< exd <<< exd <<< exd <<<


/* ---- --- */  // >>> end >>> end >>> end >>> end >>> end >>> end >>> end >>>
/* org_ end */
/* org_ end */  // - - - - - - - - - - - - - - - - - - - - - -
/* org_ end */  //  broadcast end job to get pipeline to end
/* org_ end */  // - - - - - - - - - - - - - - - - - - - - - -
/* org_ end */
/* org_ end */  // distribute end
/* org_ end */
/* org_ end */  [job].error@ not if
/* org_ end */
/* org_ end */    // "ORIGIN: broadcast end" .
/* org_ end */
/* org_ end */    [args].distJob if
/* org_ end */      "pipeline" "origin" "org_ end all executed" [job].trace
/* org_ end */      "pipeline" "origin" "org_ end brd end" [job].trace
/* org_ end */    then
/* org_ end */
/* org_ end */    [job].tscEnding
/* org_ end */
/* org_ end */    [task].grabLock
/* org_ end */      [grid].knownNodes [task].acksRemaining!
/* org_ end */      STD_NOWAIT_TAG "end" api::forkChild discard
/* org_ end */    [task].wait
/* org_ end */
/* org_ end */    [job].tscEnded
/* org_ end */
/* org_ end */  then
/* org_ end */
/* ---- --- */  // <<< edd <<< edd <<< edd <<< edd <<< edd <<< edd <<< edd <<<


/* ---- --- */  // !!! edd !!! edd !!! edd !!! edd !!! edd !!! edd !!! edd !!!
/* org_ edd */
/* org_ edd */  // - - - - - - - - - - - - - - - - - - - -
/* org_ edd */  // pipeline has ended; become ordinary job
/* org_ edd */  // - - - - - - - - - - - - - - - - - - - -
/* org_ edd */
/* org_ edd */  [args].distJob if
/* org_ edd */    "pipeline" "origin" "org_ edd all ended" [job].trace
/* org_ edd */  then
/* org_ edd */
/* org_ edd */  [job].removeOriginator
/* org_ edd */  [job].assertOrdinary
/* org_ edd */

/* ---- --- */  // !!! ovr !!! ovr !!! ovr !!! ovr !!! ovr !!! ovr !!! ovr !!!
/* org_ ovr */  [args].distJob if
/* org_ ovr */    "pipeline" "origin" "org_ ovr now ordinary" [job].trace
/* org_ ovr */  then
/* org_ ovr */
/* org_ ovr */
/* org_ ovr */  // - - - - - - - -
/* org_ ovr */  // this job exits
/* org_ ovr */  // - - - - - - - -
/* org_ ovr */
/* org_ ovr */  [job] job(Id).hasCascade@ if
/* org_ ovr */
/* org_ ovr */    [ddlLock].testDrop
/* org_ ovr */
/* org_ ovr */    [task].grabLock
/* org_ ovr */
/* org_ ovr */      "<signalWaiter>" [job].tagSet@ tagSet.hasName assert
/* org_ ovr */      [job].signalWaiter
/* org_ ovr */
/* org_ ovr */      [task].hibernate
/* org_ ovr */
/* org_ ovr */    HAZARD
/* org_ ovr */
/* org_ ovr */  then
/* org_ ovr */
/* org_ ovr */  [ddlLock].testDrop
/* org_ ovr */
/* org_ ovr */  ListedJob[].assertNoRef
/* org_ ovr */
/* org_ ovr */  [args].distJob if
/* org_ ovr */    "pipeline" "origin" "org_ ovr retiring..." [job].trace
/* org_ ovr */  then
/* org_ ovr */
/* org_ ovr */  Path[].discardAll
/* org_ ovr */
/* org_ ovr */  [job].addRetired
/* org_ ovr */
/* org_ ovr */  [task].grabLock
/* org_ ovr */
/* org_ ovr */    "<signalWaiter>" [job].tagSet@ tagSet.hasName if
/* org_ ovr */      [job].signalWaiter
/* org_ ovr */    then
/* org_ ovr */
/* org_ ovr */    [task].retire // does not queue onto exit demon
/* org_ ovr */
/* org_ ovr */  HAZARD

;

////////////////////////////////////////////////////////////////////////////////
/*                          ON ALL PARTICIPANTS                               */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* begin pipeline command on participant node                                 */
/*----------------------------------------------------------------------------*/
: pipeline:ptpBegin ( -- )
  //"pipeline:ptpBegin" .
  
/* ---- --- */  // >>> beg >>> beg >>> beg >>> beg >>> beg >>> beg >>> beg >>>
/* _ptp beg */
/* _ptp beg */  [args].distJob if
/* _ptp beg */    "pipeline" "ptpBegin" "_ptp beg phs begin" [job].trace
/* _ptp beg */  then
/* _ptp beg */
/* _ptp beg */  [job].progressReset
/* _ptp beg */
/* _ptp beg */  [job].assertStructure
/* _ptp beg */
/* _ptp beg */  ListedJob[].assertNoRef
/* _ptp beg */
/* _ptp beg */
/* _ptp beg */  // - - - - - - - - - - -
/* _ptp beg */  // this job is beginning
/* _ptp beg */  // - - - - - - - - - - -
/* _ptp beg */
/* _ptp beg */  JP_BEGINNING [job].phase!
/* _ptp beg */  //"pipeline:begin post [job]..phase!" [job].progress
/* _ptp beg */
/* _ptp beg */  <path> str.toStrVec Path[].set
/* _ptp beg */
/* _ptp beg */
/* _ptp beg */  // - - - - - - - - - - - - - - - - - - -
/* _ptp beg */  // compile pipeline statement into spec
/* _ptp beg */  //   (should not expect an error)
/* _ptp beg */  // - - - - - - - - - - - - - - - - - - -
/* _ptp beg */
/* _ptp beg */  Dynamo[].new
/* _ptp beg */
/* _ptp beg */  //"pipeline:begin pre dynamo" [job].progress
/* _ptp beg */  <cmd> Dynamo[].compile
/* _ptp beg */    EC_NONE == assert
/* _ptp beg */    to PipeSpec[]
/* _ptp beg */  //"pipeline:begin post Dynamo[].compile" [job].progress
/* _ptp beg */
/* _ptp beg */  Dynamo[].delete
/* _ptp beg */
/* _ptp beg */
/* _ptp beg */  // - - - - - - - - - - - - - -
/* _ptp beg */  // create pipeline from spec
/* _ptp beg */  //   and spawn tasks for ops
/* _ptp beg */  // - - - - - - - - - - - - - -
/* _ptp beg */
/* _ptp beg */  PipeSpec[] Pipeline[].create
/* _ptp beg */
/* _ptp beg */  // Pipeline[].dump
/* _ptp beg */
/* _ptp beg */  Pipeline[].spawnOpTasks

/* ---- --- */  // !!! bgn !!! bgn !!! bgn !!! bgn !!! bgn !!! bgn !!! bgn !!!

/* _ptp beg */  // - - - - - - - - - - - - - - - -
/* _ptp beg */  // this job has begun on this node
/* _ptp beg */  // - - - - - - - - - - - - - - - -
/* _ptp beg */
/* _ptp beg */  JP_BEGUN [job].phase!
/* _ptp beg */
/* _ptp beg */  // what to execute next
/* _ptp beg */  "pipeline:ptpExecute" [job].entryPoint!
/* _ptp beg */
/* _ptp beg */  // add job to participant list
/* _ptp beg */  [job].tscParticipant
/* _ptp beg */  [job].addParticipant
/* _ptp beg */  [job].assertParticipant
/* _ptp beg */  [job].assertStructure
/* _ptp beg */
/* _ptp beg */
/* _ptp beg */  // - - - - - - - - - - - - -
/* _ptp beg */  // reply begun to originator
/* _ptp beg */  // - - - - - - - - - - - - -
/* _ptp beg */
/* _ptp beg */  [args].distJob if
/* _ptp beg */    "pipeline" "ptpBegin" "_ptp beg has begun" [job].trace
/* _ptp beg */  then
/* _ptp beg */
/* _ptp beg */  // send the begun job
/* _ptp beg */  1 [task].debugMark!
/* _ptp beg */  STD_NOWAIT_TAG "begun" api::forkChild discard
/* _ptp beg */
/* _ptp beg */  [ddlLock].testDrop
/* _ptp beg */
/* _ptp beg */
/* _ptp beg */  // - - - - - - - - - - - - - - - - - - - - - - - -
/* _ptp beg */  // task hibernates (with job in participant list)
/* _ptp beg */  // - - - - - - - - - - - - - - - - - - - - - - - -
/* _ptp beg */
/* _ptp beg */  //[task].dump
/* _ptp beg */
/* _ptp beg */  [task].grabLock
/* _ptp beg */
/* _ptp beg */    //1 [task].trace!
/* _ptp beg */    //[task].preHibernate
/* _ptp beg */
/* _ptp beg */    [task].hibernate
/* _ptp beg */
/* _ptp beg */  HAZARD
/* ---- --- */  // <<< bgn <<< bgn <<< bgn <<< bgn <<< bgn <<< bgn <<< bgn <<<

;

/*----------------------------------------------------------------------------*/
/* execute pipeline command on participant node                               */
/*----------------------------------------------------------------------------*/
: pipeline:ptpExecute ( -- )
  //"pipeline:ptpExecute" .
  
/* ---- --- */  // >>> exe >>> exe >>> exe >>> exe >>> exe >>> exe >>> exe >>>
/* _ptp exe */
/* _ptp exe */  [args].distJob if
/* _ptp exe */    "pipeline" "ptpExecute" "_ptp exe phs execute" [job].trace
/* _ptp exe */  then
/* _ptp exe */
/* _ptp exe */  [job].assertStructure
/* _ptp exe */  [job].assertParticipant
/* _ptp exe */
/* _ptp exe */
/* _ptp exe */  // - - - - - - - - - - -
/* _ptp exe */  // this job is executing
/* _ptp exe */  // - - - - - - - - - - -
/* _ptp exe */
/* _ptp exe */  JP_EXECUTING [job].phase!
/* _ptp exe */
/* _ptp exe */  // set task's dictionary stack from path in job
/* _ptp exe */  //<path> str.toStrVec Path[].set
/* _ptp exe */
/* _ptp exe */  // acquire ddl lock
/* _ptp exe */  [ddlLock]:acquireLock
/* _ptp exe */
/* _ptp exe */  [job].assertStructure
/* _ptp exe */
/* _ptp exe */
/* _ptp exe */  // - - - - - - - - - - - - - - - - -
/* _ptp exe */  // run optional <pre_execute> word
/* _ptp exe */  // - - - - - - - - - - - - - - - - -
/* _ptp exe */
/* _ptp exe */  [job]:pre_execute
/* _ptp exe */
/* _ptp exe */
/* _ptp exe */  // - - - - - - - - - - - - - - - - -
/* _ptp exe */  // enqueue start-marker to start op
/* _ptp exe */  //   to execute the pipeline job
/* _ptp exe */  // - - - - - - - - - - - - - - - - -
/* _ptp exe */
/* _ptp exe */  Pipeline[].rootDeck@ to Deck[]
/* _ptp exe */  deck:invoke
/* _ptp exe */  nullptr to Deck[]

/* ---- --- */  // !!! exd !!! exd !!! exd !!! exd !!! exd !!! exd !!! exd !!!

/* _ptp exe */  // - - - - - - - - - - - -
/* _ptp exe */  // this job has executed
/* _ptp exe */  // - - - - - - - - - - - -
/* _ptp exe */
/* _ptp exe */  JP_EXECUTED [job].phase!
/* _ptp exe */
/* _ptp exe */  // what to execute next
/* _ptp exe */  "pipeline:ptpEnd" [job].entryPoint!
/* _ptp exe */
/* _ptp exe */  [ddlLock].testDrop
/* _ptp exe */  ListedJob[].assertNoRef
/* _ptp exe */
/* _ptp exe */
/* _ptp exe */  // - - - - - - - - - - - - - - -
/* _ptp exe */  // reply executed to originator
/* _ptp exe */  // - - - - - - - - - - - - - - -
/* _ptp exe */
/* _ptp exe */  [args].distJob if
/* _ptp exe */    "pipeline" "ptpBegin" "_ptp exe has executed" [job].trace
/* _ptp exe */  then
/* _ptp exe */
/* _ptp exe */  // send the executed job
/* _ptp exe */  STD_NOWAIT_TAG "executed" api::forkChild discard
/* _ptp exe */
/* _ptp exe */
/* _ptp exe */  // - - - - - - - - - - - - - - - - -
/* _ptp exe */  // task hibernates
/* _ptp exe */  //   (with job in participant list)
/* _ptp exe */  // - - - - - - - - - - - - - - - - -
/* _ptp exe */
/* _ptp exe */  [task].grabLock
/* _ptp exe */
/* _ptp exe */    [task].hibernate
/* _ptp exe */
/* _ptp exe */  HAZARD
/* ---- --- */  // <<< exd <<< exd <<< exd <<< exd <<< exd <<< exd <<< exd <<<

;

/*----------------------------------------------------------------------------*/
/* end pipeline command on participant node                                   */
/*----------------------------------------------------------------------------*/
: pipeline:ptpEnd
  //"pipeline:ptpEnd" .

/* ---- --- */  // >>> end >>> end >>> end >>> end >>> end >>> end >>> end >>>
/* _ptp end */
/* _ptp end */  [args].distJob if
/* _ptp end */    "pipeline" "ptpEnd" "_ptp end phs end" [job].trace
/* _ptp end */  then
/* _ptp end */
/* _ptp end */  [job].assertStructure
/* _ptp end */  [job].assertParticipant
/* _ptp end */
/* _ptp end */  JP_ENDING [job].phase!               // this job is ending
/* _ptp end */  [ddlLock].testDrop
/* _ptp end */

/* ---- --- */  // !!! edd !!! edd !!! edd !!! edd !!! edd !!! edd !!! edd !!!

/* _ptp end */  JP_ENDED [job].phase!                // this job has ended
/* _ptp end */  [job].removeParticipant
/* _ptp end */
/* _ptp end */  [args].distJob if
/* _ptp end */    "pipeline" "ptpEnd" "_ptp end has ended" [job].trace
/* _ptp end */  then
/* _ptp end */
/* _ptp end */  // send the ended job
/* _ptp end */  STD_NOWAIT_TAG "ended" api::forkChild discard
/* _ptp end */
/* _ptp end */  [args].distJob if
/* _ptp end */    "pipeline" "ptpBegin" "_ptp end retiring..." [job].trace
/* _ptp end */  then
/* _ptp end */
/* _ptp end */  [job]:retireAndExit
/* _ptp end */  HAZARD
/* ---- --- */  // <<< edd <<< edd <<< edd <<< edd <<< edd <<< edd <<< edd <<<

;

/*----------------------------------------------------------------------------*/
/* cancel pipeline command on participant node                                */
/*----------------------------------------------------------------------------*/
: pipeline:ptpCancel
  //"pipeline:ptpCancel" .

/* ---- --- */  // >>> can >>> can >>> can >>> can >>> can >>> can >>> can >>>
/* _ptp can */
/* _ptp can */  [args].distJob if
/* _ptp can */    "pipeline" "ptpCancel" "_ptp can phs cancel" [job].trace
/* _ptp can */  then
/* _ptp can */
/* _ptp can */  [job].assertStructure
/* _ptp can */  [job].assertParticipant
/* _ptp can */
/* _ptp can */  // [ senCompiler::current@ word.name@ encode::push ] .
/* _ptp can */
/* _ptp can */  JP_CANCELING [job].phase!
/* _ptp can */
/* _ptp can */  JP_CANCELED [job].phase!
/* _ptp can */
/* _ptp can */  [job].removeParticipant
/* _ptp can */
/* _ptp can */  [args].distJob if
/* _ptp can */    "pipeline" "ptpCancel" "_ptp can has cancelled" [job].trace
/* _ptp can */  then
/* _ptp can */
/* _ptp can */  // send the cancelled job
/* _ptp can */  STD_NOWAIT_TAG "cancelled" api::forkChild discard
/* _ptp can */
/* _ptp can */  [job]:retireAndExit
/* _ptp can */
/* _ptp can */  HAZARD
