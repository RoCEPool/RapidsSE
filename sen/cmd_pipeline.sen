/*============================================================================*/
/* cmd_pipeline.sen -- Distributed Pipeline Command                           */
/*============================================================================*/

" cmd_pipeline.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            ON ORIGINATING NODE                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* coordinate a distributed pipeline command from this job on originator      */
/*----------------------------------------------------------------------------*/
: pipeline:origin ( -- <R> )

  //"pipeline:origin" .
  
  [args].distJob if
    "pipeline" "origin" "org_ now oridinary" [job].trace
  then
  
  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + +//
  // ordinary job            / run pre-checks                                 //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  
  // there should be this immutable job and it shouldnt be in any job list (yet)
  [job] assert
  [job].assertStructure
  [job].assertOrdinary

  // mutable pipeSpec, pipeline and subpipeline in logicUnit should be null
  PipeSpec[] not assert
  Pipeline[] not assert
  
  // immutable op, subPLineOfOp and pipelineOfOp should be null
  [op]       not assert
  [pipeline] not assert

  // and so we start...
  [job].tscBeginning

  // pre-check
  "<preCheck>" [job].tagSet@ tagSet.hasName if
    // + tag exists
    
    <preCheck> find execute not if
      // - preCheck word failed
      
      [job].error!
      
      [ddlLock].testDrop
      ListedJob[].assertNoRef

      [job].addRetired
      
      [job].signalWaiter

      [task].grabLock
        [task].retire // does not queue onto exit demon
        
      HAZARD

    then
  then


  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + +//
  // passed pre-checks       / become an originator (coordinator) on this node//
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  // add this job to originator job list
  [job].setOriginId
  [job].distIdGenerate
  [job].addOriginator
  [job].assertOriginator

  [args].distJob if
    "pipeline" "origin" "org_ now originator" [job].trace
  then

  "<show_command>" sysargs::tagSet@ tagSet.hasName if
    <cmd> .
    //<cmd> "pipeline:origin: %v\n" .printf
    //jobs::seeRlist
    //[system].bpa
  then


  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + +//
  // is originator           / compile pipeline statement                     //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile pipeline statement on origin to check its syntax
    
  Dynamo[].new

  <cmd> Dynamo[].compile to ErrorCode[]
  
  ErrorCode[] EC_NONE == if
    // + clean compile
    to PipeSpec[]
  else
    // - didnt compile
    ErrorCode[] [job].error!
    [ddlLock].testDrop
  then
  
  Dynamo[].delete


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test if distributed job may execute
  
  [job].error@ not if
    [job].preExecuteTest to ErrorCode[]
    ErrorCode[] if
      ErrorCode[] [job].error!
      [ddlLock].testDrop
    then
  then
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test if optimising
  
  [job].error@ not if
        
    "<optimise>" [job].tagSet@ tagSet.hasName
    PipeSpec[].optimisable
    and
    if
      "Would Optimise" .
      <cmd> .
    then

    
    Optimiser[].new
    
//    PipeSpec[] Optimiser[].dissect
//    Optimiser[].optimise
//    Optimiser[].weave discard

    Optimiser[].delete
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up
  
  PipeSpec[] if
    PipeSpec[].delete
  then
  
  Dynamo[]       not assert
  Optimiser[]    not assert
  PipeSpec[] not assert


  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + +//
  // pipeline is beginning   / broadcast this job as the distributed pipeline //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  [job].error@ not if
    // + compiled without error..
    
    [args].distJob if
      "pipeline" "origin" "org_ brd begin" [job].trace
    then
    
    "pipeline:ptpBegin" [job].entryPoint!
    
    [task].grabLock
      [grid].knownNodes [task].acksRemaining!
      [job]:broadcast
    [task].wait

    [job].tscBegun
  then
 
  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + +//
  // pipeline has begun      / broadcast a job to schedule pipeline to execute//
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
   
  [job].error@ not if

    // "ORIGIN: broadcast execute" .

    [args].distJob if
      "pipeline" "origin" "org_ all begun" [job].trace
      "pipeline" "origin" "org_ brd execute" [job].trace
    then
    

    [job].tscExecuting

    [task].grabLock
      [grid].knownNodes [task].acksRemaining!
      STD_NOWAIT_TAG "execute" api::forkChild discard
    [task].wait

    [job].tscExecuted

  then
  
  
  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + +//
  // pipeline has executed   / broadcast a job to schedule pipeline to end    //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  // distribute end

  [job].error@ not if

    // "ORIGIN: broadcast end" .
    
    [args].distJob if
      "pipeline" "origin" "org_ all executed" [job].trace
      "pipeline" "origin" "org_ brd end" [job].trace
    then
    

    [job].tscEnding
    
    [task].grabLock
      [grid].knownNodes [task].acksRemaining!
      STD_NOWAIT_TAG "end" api::forkChild discard
    [task].wait

    [job].tscEnded

  then


  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + +//
  // pipeline has ended      / become ordinary job                            //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  [args].distJob if
    "pipeline" "origin" "org_ all ended" [job].trace
  then
  
  [job].removeOriginator
  [job].assertOrdinary

  [args].distJob if
    "pipeline" "origin" "org_ now ordinary" [job].trace
  then

  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + +//
  // ordinary job            / this job exits                                 //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  
  [job] job(Id).hasCascade@ if

    [ddlLock].testDrop
    
    [task].grabLock
    
      "<signalWaiter>" [job].tagSet@ tagSet.hasName assert
      [job].signalWaiter
 
      [task].hibernate
      
    HAZARD
    
  then
  
  [ddlLock].testDrop
  
  ListedJob[].assertNoRef

  [args].distJob if
    "pipeline" "origin" "org_ retiring..." [job].trace
  then

  [job].addRetired
  
  [task].grabLock
  
    "<signalWaiter>" [job].tagSet@ tagSet.hasName if
      [job].signalWaiter
    then
    
    [task].retire // does not queue onto exit demon

  HAZARD
;


////////////////////////////////////////////////////////////////////////////////
/*                          ON ALL PARTICIPANTS                               */
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* begin the op sequence for pipeline command on participant node             */
/*----------------------------------------------------------------------------*/
: pipeline:ptpBegin ( -- )

  //"pipeline:ptpBegin" .

  [args].distJob if
    "pipeline" "ptpBegin" "_ptp phs begin" [job].trace
  then
    
  [job].progressReset
  
  [job].assertStructure

  ListedJob[].assertNoRef
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is beginning
  
  JP_BEGINNING [job].phase!
  //"pipeline:begin post [job]..phase!" [job].progress

  <path> str.toStrVec Path[].set

  // set participant node of job
  [grid].thisNodeId@ [job].participantNodeId!


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile pipeline statement into spec (should not expect an error)

  Dynamo[].new

  //"pipeline:begin pre dynamo" [job].progress
  <cmd> Dynamo[].compile
    EC_NONE == assert
    to PipeSpec[]
  //"pipeline:begin post Dynamo[].compile" [job].progress

  Dynamo[].delete
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create pipeline from spec and spawn tasks for ops
  
  PipeSpec[] Pipeline[].create
  
  // Pipeline[].dump
  
  Pipeline[].spawnOpTasks
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job has begun on this node
  
  JP_BEGUN [job].phase!

  // what to execute next
  "pipeline:ptpExecute" [job].entryPoint!

  // add job to participant list
  [job].tscParticipant
  [job].addParticipant
  [job].assertParticipant
  [job].assertStructure
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reply begun to originator

  [args].distJob if
    "pipeline" "ptpBegin" "_ptp has begun" [job].trace
  then

  // send the begun job
  1 [task].debugMark!
  STD_NOWAIT_TAG "begun" api::forkChild discard

  [ddlLock].testDrop


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // task hibernates (with job in participant list)
  
  //[task].dump
    
  [task].grabLock
        
    //1 [task].trace!
    //[task].preHibernate

    [task].hibernate

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute the op sequence for pipeline command on participant node           */
/*----------------------------------------------------------------------------*/
: pipeline:ptpExecute ( -- )

  //"pipeline:ptpExecute" .
    
  [args].distJob if
    "pipeline" "ptpExecute" "_ptp phs execute" [job].trace
  then

  [job].assertStructure
  [job].assertParticipant


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is executing
  
  JP_EXECUTING [job].phase!

  // set task's dictionary stack from path in job
  //<path> str.toStrVec Path[].set

 
  // acquire ddl lock
  [ddlLock]:acquireLock
  
 
  [job].assertStructure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // run optional <pre_execute> word

  [job]:pre_execute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // enqueue start-marker to start op to execute the pipeline job

  Pipeline[].rootDeck@ to Deck[]
  deck:invoke
  nullptr to Deck[]

 
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job has executed
  
  JP_EXECUTED [job].phase!
  
  // what to execute next
  "pipeline:ptpEnd" [job].entryPoint!

  [ddlLock].testDrop
  ListedJob[].assertNoRef
  
 
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reply executed to originator
  
  [args].distJob if
    "pipeline" "ptpBegin" "_ptp has executed" [job].trace
  then


  // send the executed job
  STD_NOWAIT_TAG "executed" api::forkChild discard

  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // task hibernates (with job in participant list)

  [task].grabLock
      
    [task].hibernate

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* end the op sequence for pipeline command on participant node               */
/*----------------------------------------------------------------------------*/
: pipeline:ptpEnd ( -- )

  //"pipeline:ptpEnd" .

  [args].distJob if
    "pipeline" "ptpEnd" "_ptp phs end" [job].trace
  then

  [job].assertStructure
  [job].assertParticipant

  // + + 1 + + + + 2 + + + + 3 + + + + 4 + + + + 5 + + + + 6 + + + + 7 + + + + 8
  JP_ENDING [job].phase!               // this job is ending
  [ddlLock].testDrop
 
  JP_ENDED [job].phase!                // this job has ended
  [job].removeParticipant

  [args].distJob if
    "pipeline" "ptpBegin" "_ptp has ended" [job].trace
  then


  // send the ended job
  STD_NOWAIT_TAG "ended" api::forkChild discard

  [args].distJob if
    "pipeline" "ptpBegin" "_ptp retiring..." [job].trace
  then
  
  [job]:retireAndExit
  HAZARD
;

/*----------------------------------------------------------------------------*/
/* cancel op sequence for pipeline command on participant node                */
/*----------------------------------------------------------------------------*/
: pipeline:ptpCancel ( -- )

  //"pipeline:ptpCancel" .

  [args].distJob if
    "pipeline" "ptpCancel" ".cancelling" [job].trace
  then


  [job].assertStructure
  [job].assertParticipant

  // [ senCompiler::current@ word.name@ encode::push ] .

  JP_CANCELING [job].phase!

  JP_CANCELED [job].phase!

  [job].removeParticipant

  [args].distJob if
    "pipeline" "ptpBegin" "_ptp has cancelled" [job].trace
  then


  // send the cancelled job
  STD_NOWAIT_TAG "cancelled" api::forkChild discard

  [job]:retireAndExit
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipeline :: pipeline <pipelineNm> etc ;

: pipeline_cmdTags _cmdTags tagCopy: pipelineJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <ddlLock>  = DL_GRAB_READ
    <preCheck> = bClusterStarted
      
    <entryPoint>  = "pipeline:origin"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
