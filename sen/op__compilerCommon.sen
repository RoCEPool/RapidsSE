/*============================================================================*/
/* op__compilercommon.sen -- SqlCompiler operator common words                */
/*============================================================================*/

" op__compilercommon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LEAVE ...                                                 */
/*----------------------------------------------------------------------------*/
: compiler_LeaveMarker \handler

  // emit the RowBuffer[]
  RowBuffer[].isNull not assert
  RowBuffer[].pipeout

  EV_M_LEAVE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: compiler_RowBuffer \handler

  // save the pipein in RowBuffer[]
  Pipein[]\clear to RowBuffer[]

  true
;

/*----------------------------------------------------------------------------*/
/* common code for handling plan operand ...                                  */
/*----------------------------------------------------------------------------*/
: compiler_PlanOperand ( sOperatorName )

  params| sOperatorName |

  PlanOperand[].isNull if

    // We got an error, but were we going to do an explain?
    RowBuffer[].isNull not if
      RowBuffer[].delete
    then

    op__compileErrOut

    true
    exit
  then

  // no error, delete the infoset
  InfoSet[].delete

  // does the sql have an explain ?
  PlanOperand[] sOperatorName sqlCompiler::hasExplain if

    // execute explain for this operator
    PlanOperand[] sOperatorName sqlCompiler::doExplain

    // pipeout explain
    RowBuffer[].pipeout

    LogicUnit[].compilerToExit if
      PlanOperand[].delete
      Marker[].newLeaveMarker
      Marker[].pipeout
      true
      exit
    then

  then

  PlanOperand[].pipeOut

  true
 ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
