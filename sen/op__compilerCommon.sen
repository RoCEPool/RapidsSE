/*============================================================================*/
/* op__compilercommon.sen -- SqlCompiler operator common words                */
/*============================================================================*/

" op__compilercommon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LEAVE ...                                                 */
/*----------------------------------------------------------------------------*/
: compiler_LeaveMarker \handler

  // should have a Pds
  Pds[].isNull not assert

  // Pds should be of type BT_EXPLAIN
  Pds[].bufferType@ BT_EXPLAIN == assert

  // time to emit the BT_EXPLAIN Pds[]
  Pds[].pipeout

  EV_M_LEAVE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PDSROWBUFFER ...                                          */
/*----------------------------------------------------------------------------*/
: compiler_PdsRowBuffer \handler

  // handle explain data
  PipeIn[].bufferType@ BT_EXPLAIN == if
    Pipein[]\clear to Pds[]
  else
    PipeIn[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/* common code for handling plan operand ...                                  */
/*----------------------------------------------------------------------------*/
: compiler_PlanOperand ( sOperatorName )

  params| sOperatorName |

  PlanOperand[].isNull if

    // We got an error, but were we going to do an explain?
    Pds[].isNull not if
      Pds[].bufferType@ BT_EXPLAIN == assert
      Pds[].delete
   then

    op__compileErrOut

    true
    exit
  then

  // no error, delete the PdsErr
  PdsErr[].isNull not if

    PdsErr[].bufferType@ BT_EXECERRORS == if
      PdsErr[].delete
    then

    PdsErr[].bufferType@ BT_COMPILEERRORS == if
      PdsErr[].delete
    then

  then

  // does the sql have an explain ?
  PlanOperand[] sOperatorName sqlCompiler::hasExplain if

    // Get the tabledef for the explain format
    PlanOperand[] sqlCompiler::explainFormat to stringA[]

    // find the explain tabledef
    stringA[] op__tableDef assert

    // execute explain for this operator
    PlanOperand[] sOperatorName TableDef[] sqlCompiler::doExplain

    // pipeout BT_EXPLAIN Pds
    Pds[].pipeout

    LogicUnit[].compilerToExit if
      PlanOperand[].delete
      Marker[].newLeaveMarker
      Marker[].pipeout
      true
      exit
    then

  then

  PlanOperand[].pipeOut

  true
 ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
