/*============================================================================*/
/* OP_upsert.sen -- Operator upsert                                           */
/*============================================================================*/

" OP_upsert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: upsertOp_CrwBuffer \handler

  //"Operand:- ZK_D_CRWBUFFER" .verbose
  PipeIn[]\clear to CrwBuffer[]

  tx[].begin
  TablePtn[].grabWrite_yieldLoop
  CrwBuffer[].upsertIntoTable
  TablePtn[].dropWrite
  tx[].commit
  CrwBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: upsertOp_StartMarker \handler

  PipeIn[].pipeOut

  //"Operand:- ZK_M_START" .verbose
  // check if we can insert into the table
  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: upsertOp_StreamDef \handler

  //"Operand:- ZK_D_STREAMDEF" .verbose
  PipeIn[].delete
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for upsert                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : upsertOp::geb \operator
 
  _lu_initialise_

  op__topology

  find: upsertOp_CrwBuffer   ZK_D_CRWBUFFER   op[].handler!
  find: upsertOp_StartMarker ZK_M_START op[].handler!
  find: upsertOp_StreamDef   ZK_D_STREAMDEF   op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: upsertOp :: upsertOp <tableNm> ;

: upsertOp_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
