/*============================================================================*/
/* OP_eatAll.sen -- Eat All Operators                                         */
/*============================================================================*/

" OP_EatAll.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_Xyz ...                                                              */
/*----------------------------------------------------------------------------*/
: OP_EatAll_Xyz \handler

  // PipeIn[].kind "OP_EatAll_Xyz +++ +++ +++ : Operand %v" .printf

  // delete all operands
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* eatAll request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: eatAll_op \operator

  _lu_initialise_

  // set topology, next stage and op
  op__topology

  find: OP_EatAll_Xyz op[].handlerAll!

  op__loop

  "*** eatAll_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eatAll :: eatAll ;

: eatAll_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
