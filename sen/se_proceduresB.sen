"  start::defProc_JobRep" .verbose

: start::defProc_JobRep
  
  STD_PATH_TAG
  "
  procedure JobRep
    parameters $JobNo
  begin

  stage stageA on origin :
    start | pulse once | jobRepOp $JobNo | output | sink | stageA

  end ;
  "
  api::addProcedure
 ;





