/*----------------------------------------------------------------------------*/
/* Planner experiment related procedures                                      */
/*----------------------------------------------------------------------------*/

"  start::defProc_Planner" .verbose

: start::defProc_Planner

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  sPath
  "
  procedure filterRows_I
    parameters $table $etc
    begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      scan $table
      | filter 0 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  sPath
  "
  procedure filterRows
    parameters $table $etc
    begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      scan $table
      | filter 1 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  sPath
  "
  procedure projectColumns_I
    parameters $table $etc
    begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      scan $table
      | project 0 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  sPath
  "
  procedure projectColumns
    parameters $table $etc
    begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      scan $table
      | project 1 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  sPath
  "
  procedure indexScan_I
    parameters $table $index $etc
    begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      range 0 $table by $index $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  sPath
  "
  procedure indexScan
    parameters $table $index $etc
    begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      range 1 $table by $index $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  /*
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Smt0 - select * from lineitem;
  
  sPath
  "
  procedure Smt0
  begin

  stage stageA on origin :
    start
    | periodic once
    | stageB

  stage stageB on all nodes :
    genAsmTxt 0 0 ../eo_text/asmSmt0_s0.txt
    | stageC

  stage stageC on all partitions :
    EOAsm2 ../eo_text/asmSmt0_s0.txt 0
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Smt1 - select l_extendedprice from lineitem;
  
  sPath
