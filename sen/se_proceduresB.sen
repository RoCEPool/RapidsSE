/*----------------------------------------------------------------------------*/
/* Planner TPCH experiment related procedures                                 */
/*----------------------------------------------------------------------------*/

"  start::defProc_PlannerTPCH" .verbose

: start::defProc_PlannerTPCH

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 6 - interpretive
  
  sPath
  "
  procedure Query6_S
  begin

  stage stageA on origin :
    start
    | periodic once
    | genAsmTxt 6 1 ../eo_text/asm6_s1.txt
    | stageB

  stage stageB on all nodes :
    genAsmTxt 6 0 ../eo_text/asm6_s0.txt
    | stageC

  stage stageB on all partitions :
    EOAsm2 ./eo_text/asm6_s0.txt 0
    | stageC

  stage stageC on origin :
    //EOAsm2 ./eo_text/asm6_s1.txt 0
    output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 20 -
  //   [P0] ( insert into temptable select p_partkey from part where p_mfgr = 'Manufacturer#1' )
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // insert into tempTable0 select p_partkey from part where p_mfgr = 'Manufacturer#1';
  
  sPath
  "
  procedure Query20_S0
  begin

  stage stageA on origin :
    start
    | periodic once
    | stageB

  stage stageB on all nodes :
    genAsmTxt 20 0 ../eo_text/asm20_s0.txt
    | stageC

  stage stageC on all partitions :
    EOAsm2 ../eo_text/asm20_s0.txt 0
    | toNstRow
    | toHshCrw
    | insert tempTable0
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

    end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // select ps_suppkey from partsupp where ps_parkey in tempTable0;
  
  sPath
  "
  procedure Query20_S1
  begin

  stage stageA on origin :
    start
    | periodic once
    | stageB

  stage stageB on all nodes :
    genAsmTxt 20 1 ../eo_text/asm20_s1.txt
    | stageC

  stage stageC on all partitions :
    EOAsm2 ../eo_text/asm20_s1.txt 0
    | stageD

  stage stageD on origin :
    output
    | sink
    | stageA

    end ;
  "
  api::addProcedure

/*
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 20 -  [S1] select ps_suppkey from partsupp where ps_partKey in
  //             [S0] ( select p_partkey from part where p_name like 'forest%' )
  // changed to :[S0] ( select p_partkey from part where p_mfgr = 'Manufacturer#1' )
  
  sPath
  "
  procedure Smt20_S0
  begin

  stage stageA on origin :
    start
    | periodic once
    | stageB

  stage stageB on all nodes :
    genAsmTxt 20 0 ../eo_text/asm20_s0.txt
    | stageC

  stage stageC on all partitions :
    EOAsm ../eo_text/asm20_s0.txt 0
    | stageD

  stage stageD on all nodes :
    createTable
    | stageE hashed

  stage stageE on all partitions :
    insert tempTable
    | stageF

  stage stageF on origin :
    output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  sPath
  "
  procedure Smt20
  begin

  stage stageA on origin :
    start
    | periodic once
    | genAsmTxt 20 1 ../eo_text/asm20_s1_origin.txt
    | EOAsm ../eo_text/asm20_s1_origin.txt   //callPipeline Smt20_S0
    | waitPipeline
    | stageB

  stage stageB on all nodes :
     genAsmTxt 20 1 ../eo_text/asm20_s1_all_partitions.txt
     | stageC

  stage stageC on all partitions :
    EOAsm ../eo_text/asm20_s1_all_partitions.txt 0
    | truncateTable tempTable
    | stageD

  stage stageD on all nodes :
    dropTable tempTable
    | stage E

  stage stageE on origin :
      output
      | sink
      | stageA

    end ;
    "
    api::addProcedure
*/
;

/*----------------------------------------------------------------------------*/
/* meta table related procedures                                              */
/*----------------------------------------------------------------------------*/

"  start::defProc_Meta" .verbose

: start::defProc_Meta

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables"
    locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // scan tables
  
  sPath
  "
  procedure scanTables
  begin

  stage stageA on origin :
    start | periodic once | metaScan tables | rowToList | output | sink | stageA

  end ;
  "
  api::addProcedure

  // scanTables ;
 ;

/*----------------------------------------------------------------------------*/
/* sql compiler related procedures                                            */
/*----------------------------------------------------------------------------*/

"  start::defProc_SqlCompiler" .verbose

: start::defProc_SqlCompiler

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables"
    locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // sql Compiler
  
  sPath
  "
  procedure sqlCompiler
    parameters $sqlStatement

  begin

    stage stageA on origin :
      start
      | periodic once
      | parser $sqlStatement
      | nameValidate
      | transliterate
      | output
      | sink
      | stageA

  end ;
  "
  api::addProcedure

  // sqlCompiler ;
 ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
