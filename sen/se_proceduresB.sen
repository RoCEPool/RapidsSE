/*----------------------------------------------------------------------------*/
/* Planner experiment related procedures                                      */
/*----------------------------------------------------------------------------*/

"  start::defProc_Planner" .verbose

: start::defProc_Planner

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //

  STD_PATH_TAG
  "
  procedure aggregRows_I
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | aggreg 0 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //

  STD_PATH_TAG
  "
  procedure aggregRows
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | aggreg 1 $etc
      | stageC

    stage stageC on origin :
     output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure filterRows_I
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | filter 0 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure filterRows
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | filter 1 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  STD_PATH_TAG
  "
  procedure limitRows_I
    parameters $table $rows
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | limit 0 $rows
      | stageC

    stage stageC on origin :
      limit 0 $rows
      | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  STD_PATH_TAG
  "
  procedure limitRows
    parameters $table $rows
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | limit 1 $rows
      | stageC

    stage stageC on origin :
      limit 1 $rows
      | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  STD_PATH_TAG
  "
  procedure projectColumns_I
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | project 0 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure projectColumns
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | project 1 $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure range_I
    parameters $table $index $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      indexScan 0 $table $index $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure range
    parameters $table $index $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      indexScan 1 $table $index $etc
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* meta table related procedures                                              */
/*----------------------------------------------------------------------------*/

"  start::defProc_Meta" .verbose

: start::defProc_Meta

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // scan tables
  
  STD_PATH_TAG
  "
  procedure scanTables
  begin

  stage stageA on origin :
    start | pulse once | metaScan tables | rowToList | output | sink | stageA

  end ;
  "
  api::addProcedure

  // scanTables ;
 ;



