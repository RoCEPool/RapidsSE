" se_proceduresB.sen" .verbose


/*----------------------------------------------------------------------------*/
/* query related procedures                                                   */
/*----------------------------------------------------------------------------*/

"  start::defProc_Query" .verbose

: start::defProc_Query

  "<path>= /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| STD_PATH |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 3b prelim
  
  STD_PATH
  "
  procedure Query_3b
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 300 1
    | stageC hashcast

  stage stageC on all partitions :
    sql 301 1
    | stageD

  stage stageD on origin :
    sql 302 1
    | output
    | sink
    | stageA

  end ;  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 3b prelim
  
  STD_PATH
  "
  procedure Query_3b_I
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 300 0
    | stageC hashcast

  stage stageC on all partitions :
    sql 301 0
    | stageD

  stage stageD on origin :
    sql 302 0
    | output
    | sink
    | stageA

  end ;  "
  api::addProcedure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 4b prelim
  
  STD_PATH
  "
  procedure Query_4b
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 400 1
    | stageC

  stage stageC on origin :
    sql 401 1
    | output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 4b prelim
  
  STD_PATH
  "
  procedure Query_4b_I
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 400 0
    | stageC

  stage stageC on origin :
    sql 401 0
    | output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

;

/*----------------------------------------------------------------------------*/
/* dyn compiler related procedures                                            */
/*----------------------------------------------------------------------------*/

"  start::defProc_DynCompiler" .verbose

: start::defProc_DynCompiler

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // q 3 prelim
  STD_PATH
  "
  procedure dynCompiler
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 100001 1
    | stageC

  stage stageC on origin :
    output
    | sink
    | stageA

  end ;
  "
  api::addProcedure

;

/*----------------------------------------------------------------------------*/
/* TPC-H related procedures                                                   */
/*----------------------------------------------------------------------------*/

"  start::defProc_TPCH" .verbose

: start::defProc_TPCH

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 1 - iterating index on l_shipdate
  
  STD_PATH
  "
  procedure Query1
    parameters $Table
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan $Table
    | sql 100 1
    //| sql 101
    | stageC

  stage stageC on origin :
    sql 103 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 1 - iterating index on l_shipdate
  
  STD_PATH
  "
  procedure Query1_I
    parameters $Table
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan $Table
    | sql 100 0
    //| sql 101
    | stageC

  stage stageC on origin :
    sql 103 0
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 6 - converting loaded CRW data into ROW
  
  STD_PATH
  "
  procedure Query6
    parameters $Table $Index
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 600 1 $Table $Index
    | stageC

  stage stageC on origin :
    sql 601 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 6 - converting loaded CRW data into ROW
  
  STD_PATH
  "
  procedure Query6_I
    parameters $Table $Index
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 600 0 $Table $Index
    | stageC

  stage stageC on origin :
    sql 601 0
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* TPCH ASM Compiled related procedures                                       */
/*----------------------------------------------------------------------------*/

"  start::defProc_TPCH_ASM" .verbose

: start::defProc_TPCH_ASM

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 1 - compiled
  
  STD_PATH
  "
  procedure Query1_ASM
    parameters $Table $QueryText_stageB $QueryText_stageC
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan $Table
    | EOAsm $QueryText_stageB 1
    | stageC

  stage stageC on origin :
    EOAsm $QueryText_stageC 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
