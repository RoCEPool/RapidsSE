  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Smt2 - select * from lineitem where l_partkey > 1000000;
  
  sPath
  "
  procedure Smt2
  begin

  stage stageA on origin :
