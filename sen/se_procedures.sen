  stage stageA on origin :
    start
    | periodic once
    | stageB

  stage stageB on all partitions :
    scan $Table
    | sql 100 0
    //| sql 101
    | stageC

  stage stageC on origin :
    sql 103 0
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
