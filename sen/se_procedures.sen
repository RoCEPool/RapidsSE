    stage stageB on all nodes :

      addNode $NodeNm $IpAddr $PortNo
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // adjust partitions
  sPath
  "
  procedure adjust partitions
  begin

    stage stageA on origin :

      start
        | periodic once
        | stageB

    stage stageB on all nodes :

      adjustPtns
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove node
  sPath
  "
  procedure remove node
    parameters $NodeNm
  begin

    stage stageA on origin :

      start | periodic once
            | removeNode $NodeNm
            | output
            | sink
            | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn node
  sPath
  "
  procedure spawn node
    parameters $NodeNm
