"  start::defProc_UnloadReload" .verbose

: start::defProc_UnloadReload

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // unload
  sPath
  "
  procedure unload
    parameters $Table $File
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan $Table | stageC

  stage stageC on origin :
    wrFile $File | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // /time unload LineItem "/tmp/lineitem.crw" ;


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reload
  sPath
  "
  procedure reload
    parameters $Table $File
  begin

  stage stageA on origin :
    start | periodic once | rdCrwFile $File | stageB

  stage stageB on all partitions :
    insert $Table | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // /time reload LineItem "/tmp/lineitem.crw" ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reorder table
  sPath
  "
  procedure reorder
    parameters $table1 $table2 $predicate
  begin

  stage stageA on origin :
    start | periodic once | emitStreamDef $Table1 | stageB

  stage stageB on all nodes :
    createTable $table2 | stageC

  stage stageC on all partitions :
    fetch $table1 $predicate | insert $table2 | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

;

