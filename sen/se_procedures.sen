  procedure Query1
    parameters $Table
  begin

  stage stageA on origin :
    start
    | periodic once
    | stageB

  stage stageB on all partitions :
    scan $Table
    | sql 100 1
    //| sql 101
    | stageC

  stage stageC on origin :
    sql 103 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
