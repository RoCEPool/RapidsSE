/*----------------------------------------------------------------------------*/
/* load related procedures                                                    */
/*----------------------------------------------------------------------------*/

"  start::defProc_Load" .verbose

: start::defProc_Load

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // load
  
  STD_PATH_TAG
  "
  procedure load
    parameters $table $file
  begin

    stage stageA on origin :
        start
      | pulse once
      | chunk $file       // read chunks of file => (seekOffset)
      | rdCsvChunk $file  // (seekOffset) => (csvBuffer)
      | stageB localrobin

    stage stageB on all partitions on origin :
        toRow $table      // pf    (csvBuffer) => (rowBuffer w row+hash)
     // | toPtnRow          //    pf (rowBuffer) => (ptn rowBuffer)
      | toBktRow $table         //       (rowBuffer) => (bkt rowBuffer)
      | toNstRow          //       (rowBuffer) => (nst rowBuffer)
    //  | toPtnCrw          //       (rowBuffer) => (ptn crwBuffer)
      | toBktCrw          //       (rowBuffer) => (bkt crwBuffer)
      | stageC hashcast

    stage stageC on all partitions :
        insert $table     // (crwBuffer) inserted into table
      | stageD

    stage stageD on origin :
        progress 'Load'
      | output
      | toStatDemon
      | sink
      | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // load (bucket)
  
  STD_PATH_TAG
  "
  procedure load_bkt
    parameters $table $file
  begin

    stage stageA on origin :
        start
      | pulse once
      | chunk $file       // read chunks of file => (seekOffset)
      | rdCsvChunk $file  // (seekOffset) => (csvBuffer)
      | stageB localrobin

    stage stageB on all partitions on origin :
        toRow $table      // pf    (csvBuffer) => (rowBuffer w row+hash)
      | toBktRow $table   //       (rowBuffer) => (bkt rowBuffer)
      | toNstRow          //       (rowBuffer) => (nst rowBuffer)
      | toBktCrw          //       (rowBuffer) => (bkt crwBuffer)
      | stageC hashcast

    stage stageC on all partitions :
        insert $table     // (crwBuffer) inserted into table
      | stageD

    stage stageD on origin :
        progress 'Load'
      | output
      | toStatDemon
      | sink
      | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dfload
  
  STD_PATH_TAG
  "
  procedure dfload
    parameters $table $file
  begin

  stage stageA on origin :

    start              |
 
    pulse once    |

    stageB

  stage stageB on all nodes :

    chunk $file        | // read chunks of file, produce (seekOffset) =>
    // dump seekOffsets 1 |

    rdCsvChunk $file   | // (seekOffset) => (csvBuffer)
    // dump csvBuffer 0   |

    stageC localRobin

  stage stageC on all partitions :

    toRow $table       | // (csvBuffer)  => (rowBuffer)
    // dump rowBuffer 1   |

    toPtnRow           | // (rowBuffer)  => (rowBuffer 'ptn)
    // dump rowBuffer 1   |

    toNstRow           | // (rowBuffer)  => (rowBuffer 'nst)
    //dump rowBuffer 1   |

    toHshCrw           | // (rowBuffer)  => (crwBuffer 'hsh)
    //dump rowBuffer 1   |

    stageD hashcast

  stage stageD on all partitions :

    //eatSome |

    insert $table | // (crwBuffer) inserted into table

    stageE

  stage stageE on origin :

    progress 'Load'    |

    toStatDemon        |

    sink               |

    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dload
  
  STD_PATH_TAG
  "
  procedure dload
    parameters $table
  begin

    stage stageA on origin :
        start
      | pulse once
      | eachPath 
      |   toDfload $table
      | callPipeline
      | waitPipeline
      | sink
      | stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* api related procedures                                                     */
/*----------------------------------------------------------------------------*/

"  start::defProc_Api" .verbose

: start::defProc_Api

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // getRows
  
  STD_PATH_TAG
  "
  procedure getRows
    parameters $Table
  begin

  stage stageA on origin :
    start         |
    pulse once |
    stageB

  stage stageB on all partitions :
    scan $Table   |
    crwToRow      |
    stageC

  stage stageC on origin :
    output        |
    sink          |
    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // putRows
  
  STD_PATH_TAG
  "
  procedure putRows
    parameters $Table
  begin

  stage stageA on origin :
    start         |
    pulse once |
    input         |
    stageB localrobin

  stage stageB on all partitions on origin :
    toRow $Table  |
    toPtnRow      |
    toNstRow      |
    toHshCrw      |
    stageC hashcast

  stage stageC on all partitions :
    insert $Table |
    stageD

  stage stageD on origin :
    sink          |
    stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* file related procedures                                                    */
/*----------------------------------------------------------------------------*/

"  start::defProc_File" .verbose

: start::defProc_File

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // copy file
  
  STD_PATH_TAG
  "
  procedure copyFile
    parameters $FileIn $FileOut
  begin

  stage stageA on origin :
    start | pulse once | catFile $FileIn | wrFile $FileOut | sink | stageA

  end ;
  "
  api::addProcedure

  // copyFile "/Users/Shared/tpch/SF1/nation.csv" "/Users/Shared/tpch/SF1/nation_COPY.csv" ;


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list file
  
  STD_PATH_TAG
  "
  procedure listFile
    parameters $File
  begin

    stage stageA on origin :
      start | pulse once | catFile $File | output | sink | stageA

  end ;
  "
  api::addProcedure

  // listFile "/Users/Shared/tpch/SF1/nation.csv" ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // xyz file
  
  STD_PATH_TAG
  "
  procedure xyzFile
    parameters $Table $File $Ntimes
  begin

    stage stageA on origin :
      start
        | pulse once
//        | catFile $File
        | rdCsvCyclic $File $NTimes
        | toRow $Table
        | toPtnRow
        | toNstRow
        | stageB hashcast

    stage stageB on all partitions :
      noop
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  api::addProcedure

  // xyzFile nation "/Users/Shared/tpch/SF1/nation.csv" 3 ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // cycle read file
  
  STD_PATH_TAG
  "
  procedure cyclicRdFile
    parameters $FileIn $NTimes
  begin

    stage stageA on origin :
      start | pulse once |
        rdCsvCyclic $FileIn $NTimes | output | sink | stageA

  end ;
  "
  api::addProcedure

// cyclicRdFile "/Users/Shared/tpch/SF1/nation.csv" 3 ;
// cyclicRdFile "/Users/Shared/tpch/SF1/supplier.csv" 3 ;
// cyclicRdFile "/Users/Shared/tpch/SF1/part.csv" 3 ;
;

