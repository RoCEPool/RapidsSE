"  start::defProc_Elasticity" .verbose

: start::defProc_Elasticity

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables"
    locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // add node
  sPath
  "
  procedure add node
    parameters $NodeNm $IpAddr $PortNo
  begin

    stage stageA on origin :

      start
        | periodic once
