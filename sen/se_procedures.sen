  "
  procedure Query6
    parameters $Table $Index
  begin

  stage stageA on origin :
    start
    | periodic once
    | stageB

  stage stageB on all partitions :
    sql 600 1 $Table $Index
    | stageC

  stage stageC on origin :
    sql 601 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
