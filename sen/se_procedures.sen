"  start::defProc_SteadyState" .verbose

: start::defProc_SteadyState

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 1
  sPath
  "
  procedure steadyState_1
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | periodic once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRsb $Table
        | toPtnRsb
        | stageB hashed

    stage stageB on all partitions :
      noop
      //insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 2
  sPath
  "
  procedure steadyState_2
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | periodic once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRsb $Table
        | toPtnRsb
        | stageB hashed

    stage stageB on all partitions :
      //noop
      insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 3
  sPath
  "
  procedure steadyState_3
   parameters $Table $File $NTimes
  begin

   stage stageA on origin :

     start |

     periodic once |

     rdCsvCyclic $File $NTimes |

     stageB robin


   stage stageB on all partitions on origin  :

     toRsb $Table |

     toPtnRsb |

     //toNstRsb |

     //toHshCrw |

     stageC hashed


   stage stageC on all partitions :

     insdel $Table |

     stageD


   stage stageD on origin :

     //output |

     sink |

     stageA

  end ;
  "
  api::addProcedure
;

