"  start::defProc_Drop" .verbose

: start::defProc_Drop

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compact index
  sPath
  "
  procedure compact index
    parameters $tableNm $indexNm
  begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      compactIndexPtn $tableNm $indexNm | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop catalog
  sPath
  "
  procedure drop catalog
    tags <lowMemory>
    parameters $catalogNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    dropCatalog $catalogNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop index
  sPath
  "
  procedure drop index
    tags <lowMemory>
    parameters $tableNm $indexNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    truncateIndex $tableNm $indexNm | stageC

  stage stageC on all nodes :
    dropIndex $tableNm $indexNm | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop schema
  sPath
  "
  procedure drop schema
    tags <lowMemory>
    parameters $schemaNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    dropSchema $schemaNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop table
  sPath
  "
  procedure drop table
    tags <lowMemory>
    parameters $tableNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    truncateTable $tableNm | stageC

  stage stageC on all nodes :
    dropTable $tableNm | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop tenant
  sPath
  "
  procedure drop tenant
    tags <lowMemory>
    parameters $tenantNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    dropTenant $tenantNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // verify index
  sPath
  "
  procedure verify index
    parameters $tableNm $indexNm
  begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      verifyIndexPtn $tableNm $indexNm | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure


