    | periodic once
    | stageB

  stage stageB on all partitions :
    sql 600 0 $Table $Index
    | stageC

  stage stageC on origin :
    sql 601 0
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure
;

