/*============================================================================*/
/* se_procedures.sen -- define procedures                                     */
/*============================================================================*/

" se_procedures.sen" .verbose


/*----------------------------------------------------------------------------*/
/* api related procedures                                                     */
/*----------------------------------------------------------------------------*/

"  start::defProc_Api" .verbose

: start::defProc_Api

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // getRows
  
  STD_PATH_TAG
  "
  procedure getRows
    parameters $Table
  begin

  stage stageA on origin :
    start         |
    pulse once |
    stageB

  stage stageB on all partitions :
    scan $Table   |
    crwToRow      |
    stageC

  stage stageC on origin :
    output        |
    sink          |
    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // putRows
  
  STD_PATH_TAG
  "
  procedure putRows
    parameters $Table
  begin

  stage stageA on origin :
    start         |
    pulse once |
    input         |
    stageB localrobin

  stage stageB on all partitions on origin :
    toRow $Table  |
    toPtnRow      |
    toNstRow      |
    toHshCrw      |
    stageC hashcast

  stage stageC on all partitions :
    insert $Table |
    stageD

  stage stageD on origin :
    sink          |
    stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* file related procedures                                                    */
/*----------------------------------------------------------------------------*/

"  start::defProc_File" .verbose

: start::defProc_File

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // copy file
  
  STD_PATH_TAG
  "
  procedure copyFile
    parameters $FileIn $FileOut
  begin

  stage stageA on origin :
    start | pulse once | catFile $FileIn | wrFile $FileOut | sink | stageA

  end ;
  "
  api::addProcedure

  // copyFile "/Users/Shared/tpch/SF1/nation.csv" "/Users/Shared/tpch/SF1/nation_COPY.csv" ;


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list file
  
  STD_PATH_TAG
  "
  procedure listFile
    parameters $File
  begin

    stage stageA on origin :
      start | pulse once | catFile $File | output | sink | stageA

  end ;
  "
  api::addProcedure

  // listFile "/Users/Shared/tpch/SF1/nation.csv" ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // xyz file
  
  STD_PATH_TAG
  "
  procedure xyzFile
    parameters $Table $File $Ntimes
  begin

    stage stageA on origin :
      start
        | pulse once
//        | catFile $File
        | rdCsvCyclic $File $NTimes
        | toRow $Table
        | toPtnRow
        | toNstRow
        | stageB hashcast

    stage stageB on all partitions :
      noop
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  api::addProcedure

  // xyzFile nation "/Users/Shared/tpch/SF1/nation.csv" 3 ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // cycle read file
  
  STD_PATH_TAG
  "
  procedure cyclicRdFile
    parameters $FileIn $NTimes
  begin

    stage stageA on origin :
      start | pulse once |
        rdCsvCyclic $FileIn $NTimes | output | sink | stageA

  end ;
  "
  api::addProcedure

// cyclicRdFile "/Users/Shared/tpch/SF1/nation.csv" 3 ;
// cyclicRdFile "/Users/Shared/tpch/SF1/supplier.csv" 3 ;
// cyclicRdFile "/Users/Shared/tpch/SF1/part.csv" 3 ;
;

/*----------------------------------------------------------------------------*/
/* elasticity procedures                                                      */
/*----------------------------------------------------------------------------*/

"  start::defProc_Elasticity" .verbose

: start::defProc_Elasticity

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // add node
  
  STD_PATH_TAG
  "
  procedure add node
    parameters $NodeNm $IpAddr $PortNo
  begin

    stage stageA on origin :

      start
        | pulse once
        | stageB

    stage stageB on all nodes :

      addNode $NodeNm $IpAddr $PortNo
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // adjust partitions
  
  STD_PATH_TAG
  "
  procedure adjust partitions
  begin

    stage stageA on origin :

      start
        | pulse once
        | stageB

    stage stageB on all nodes :

      adjustPtns
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove node
  
  STD_PATH_TAG
  "
  procedure remove node
    parameters $NodeNm
  begin

    stage stageA on origin :

      start | pulse once
            | removeNode $NodeNm
            | output
            | sink
            | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // spawn node
  
  STD_PATH_TAG
  "
  procedure spawn node
    parameters $NodeNm
  begin

    stage stageA on origin :

      start | pulse once
            | spawnNode $NodeNm
            | output
            | sink
            | stageA

  end ;
  "
  api::addProcedure

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // prototype assertGrid

  STD_PATH_TAG
  "
  procedure assertGrid
  begin

    stage stageA on origin :
      start | pulse once | gridGet | stageB hashed

      // prototyping, on the same machine
      //stage stageB on all nodes :                gridSend | gridRecv | stageC
      //stage stageC on origin :                noop | sink | stageA

    stage stageB on all nodes :
          gridSend | stageC

    stage stageC on origin :
          gridRecv | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump grid info

  STD_PATH_TAG
  "
  procedure dumpGrid
  begin
    stage stageA on origin :
      start | pulse once | dumpGridInfo  | output | sink | stageA

  end ;
  "
  api::addProcedure

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 //  dump table meta info

  STD_PATH_TAG
  "
  procedure dumpMeta
    parameters $TableNm
  begin
    stage stageA on origin :
      start | pulse once | dumpMetaInfo $TableNm  | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dump bucket info

  STD_PATH_TAG
  "
  procedure dumpBucket
    parameters $TableNm
  begin
    stage stageA on origin :
      start | pulse once | dumpBktInfo $TableNm | output | sink | stageA

  end ;
  "
  api::addProcedure

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 //  dump table bucket map

  STD_PATH_TAG
  "
  procedure dumpBucketMap
    parameters $TableNm
  begin
    stage stageA on origin :
      start | pulse once | dumpBktMap $TableNm  | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get bucket object, for prototyping, use two table params $TableNm1 -> $TableNm2
  STD_PATH_TAG
  "
  procedure getBucket
    parameters $TableNm1 $TableNm2
  begin

    stage stageA on origin :
      start | pulse once | bucketGet $TableNm1 | stageB

    stage stageB on all partitions :
      bucketSend $TableNm1 | stageC

    stage stageC on all partitions :
      insert $TableNm2 | stageD

    stage stageD on origin :
       sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get meta object
  
  STD_PATH_TAG
  "
  procedure getMeta
    parameters $TableNm
  begin

    stage stageA on origin :
      start | pulse once | metaGet $TableNm | stageB

    stage stageB on next node :
      metaSend | stageC

    stage stageC on origin :
      metaRecv | output | sink | stageA
      //noop | sink | stageA

  end ;
  "
  api::addProcedure

;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get updated bucket map for a table

  STD_PATH_TAG
  "
  procedure getBktMap
    parameters $TableNm
  begin

    stage stageA on origin :
      start | pulse once | bktMapGet $TableNm | stageB

    stage stageB on next node :
      bktMapSend | stageC

    stage stageC on all nodes :
      bktMapRecv | stageD

    stage stageD on origin :
       sink | stageA

  end ;
  "
  api::addProcedure

;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get bucket # from table

  STD_PATH_TAG
  "
  procedure getBkt
    parameters $TableNm $BktNo
  begin

    stage stageA on origin :
      start | pulse once | bktGet $TableNm $BktNo | stageB

    // MESSING AROUND to debug some weird problem

    //stage stageB on next node :
    stage stageB on all partitions :
      bucketSend0 $TableNm | stageC
    //stage stageB on all nodes :
    //  bktSend | bktRecv | stageC

    //stage stageC on origin :
    stage stageC on all partitions :
      insert $TableNm | stageD
      //bktRecv | stageD

    stage stageD on origin :
      sink | stageA

  end ;
  "
  api::addProcedure

;





/*----------------------------------------------------------------------------*/
/* steady state related procedures                                            */
/*----------------------------------------------------------------------------*/

"  start::defProc_SteadyState" .verbose

: start::defProc_SteadyState

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 1
  
  STD_PATH_TAG
  "
  procedure steadyState_1
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | pulse once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRow $Table
        | toPtnRow
        | stageB hashcast

    stage stageB on all partitions :
      noop
      //insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 2
  
  STD_PATH_TAG
  "
  procedure steadyState_2
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | pulse once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRow $Table
        | toPtnRow
        | stageB hashcast

    stage stageB on all partitions :
      //noop
      insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 3
  
  STD_PATH_TAG
  "
  procedure steadyState_3
   parameters $Table $File $NTimes
  begin

   stage stageA on origin :

     start |

     pulse once |

     rdCsvCyclic $File $NTimes |

     stageB localrobin


   stage stageB on all partitions on origin  :

     toRow $Table |

     toPtnRow |

     //toNstRow |

     //toHshCrw |

     stageC hashcast


   stage stageC on all partitions :

     insdel $Table |

     stageD


   stage stageD on origin :

     //output |

     sink |

     stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* unload/realod related procedures                                           */
/*----------------------------------------------------------------------------*/

"  start::defProc_UnloadReload" .verbose

: start::defProc_UnloadReload

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // unload
  
  STD_PATH_TAG
  "
  procedure unload
    parameters $Table $File
  begin

  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all partitions :
    scan $Table | stageC

  stage stageC on origin :
    wrFile $File | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // /time unload LineItem "/tmp/lineitem.crw" ;


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reload
  
  STD_PATH_TAG
  "
  procedure reload
    parameters $Table $File
  begin

  stage stageA on origin :
    start | pulse once | rdCrwFile $File | stageB

  stage stageB on all partitions :
    insert $Table | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // /time reload LineItem "/tmp/lineitem.crw" ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reorder table
  
  STD_PATH_TAG
  "
  procedure reorder
    parameters $table1 $table2 $predicate
  begin

  stage stageA on origin :
    start | pulse once | emitStreamDef $Table1 | stageB

  stage stageB on all nodes :
    createTable $table2 | stageC

  stage stageC on all partitions :
    fetch $table1 $predicate | insert $table2 | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

;

/*----------------------------------------------------------------------------*/
/* forget/rebalance related procedures                                        */
/*----------------------------------------------------------------------------*/

"  start::defProc_forgetRebalance" .verbose

: start::defProc_ForgetRebalance

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // forgetNode
  
  STD_PATH_TAG
  "
  procedure forgetNode
    parameters $NodeNm $etc
  begin

  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all nodes :
    stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure
;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // rebalance
  
  STD_PATH_TAG
  "
  procedure rebalance
  begin

  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all nodes :
    stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure
;

