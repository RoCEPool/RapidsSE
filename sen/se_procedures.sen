/*============================================================================*/
/* se_procedures.sen -- define procedures                                     */
/*============================================================================*/

" se_procedures.sen" .verbose

/*----------------------------------------------------------------------------*/
/* create related procedures                                                  */
/*----------------------------------------------------------------------------*/

"  start::defProc_Create" .verbose

: start::defProc_Create

 "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create catalog
  
  sPath
  "
  procedure create catalog
    parameters $catalogNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    createCatalog $catalogNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create index
  
  sPath
  "
  procedure create index
    parameters $indexNm $etc
  begin

  stage stageA on origin :
    start | periodic once | syntaxIndex $indexNm $etc | stageB

  stage stageB on all nodes :
    createIndex $indexNm | stageC

  stage stageC on all partitions :
    populateIndex $indexNm | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create unique index
  
  sPath
  "
  procedure create unique index
    parameters $indexNm $etc
  begin

  stage stageA on origin :
    start | periodic once | syntaxUniqueIndex $indexNm $etc | stageB

  stage stageB on all nodes :
    createIndex $indexNm | stageC

  stage stageC on all partitions :
    populateIndex $indexNm | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

/*
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create index
  
  sPath
  "
  procedure create index
    parameters $indexNm $etc
  begin

  stage stageA on origin :
    start | periodic once | syntaxIndex $indexNm $etc | stageB

  stage stageB on all nodes :
    createIndex $indexNm | stageC

  stage stageC on origin :
     eatSome | stageD

  stage stageD on all partitions :
    populateIndex $indexNm | stageE

  stage stageE on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create unique index
  
  sPath
  "
  procedure create unique index
    parameters $indexNm $etc
  begin

  stage stageA on origin :
    start | periodic once | syntaxUniqueIndex $indexNm $etc | stageB

  stage stageB on all nodes :
    createIndex $indexNm | stageC

  stage stageC on origin :
    eatSome | stageD

  stage stageD on all partitions :
    populateIndex $indexNm | stageE

  stage stageE on origin :
    sink | stageA

  end ;
  "
  api::addProcedure
*/

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create schema
  
  sPath
  "
  procedure create schema
    parameters $schemaNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    createSchema $schemaNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create table
  
  sPath
  "
  procedure create table
    parameters $tableNm $etc
  begin

  stage stageA on origin :
    start | periodic once | syntaxTable $tableNm $etc | stageB

  stage stageB on all nodes :
    createTable | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create tenant
  
  sPath
  "
  procedure create tenant
    parameters $tenantNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    createTenant $tenantNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create table as
  
  sPath
  "
  procedure ctas
    parameters $table1 $table2
  begin

    stage stageA on origin :
      start | periodic once | emitStreamDef $Table1 | stageB

    stage stageB on all nodes :
      createTable $table2 | stageC

    stage stageC on all partitions :
      scan $table1 | dupCrw | insert $table2 | stageD

    stage stageD on origin :
      sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // define table
  
  sPath
  "
  procedureLocal define table
    parameters $tableNm $etc
  begin

  stage stageA on origin :
    start | periodic once | syntaxTable $tableNm $etc |
      defineTable $tableNm | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete
  
  sPath
  "
  procedure delete
    parameters $table $predicate
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    delete $table $predicate | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure

;

/*----------------------------------------------------------------------------*/
/* drop related procedures                                                    */
/*----------------------------------------------------------------------------*/

"  start::defProc_Drop" .verbose

: start::defProc_Drop

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compact index
  
  sPath
  "
  procedure compact index
    parameters $tableNm $indexNm
  begin

    stage stageA on origin :
      start | periodic once | stageB

    stage stageB on all partitions :
      compactIndexPtn $tableNm $indexNm | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop catalog
  
  sPath
  "
  procedure drop catalog
    tags <lowMemory>
    parameters $catalogNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    dropCatalog $catalogNm | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop index
  
  sPath
  "
  procedure drop index
    tags <lowMemory>
    parameters $tableNm $indexNm
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    truncateIndex $tableNm $indexNm | stageC

  stage stageC on all nodes :
    dropIndex $tableNm $indexNm | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // drop schema
  
  sPath
  "
