/*----------------------------------------------------------------------------*/
/* staedy state related procedures                                            */
/*----------------------------------------------------------------------------*/

"  start::defProc_SteadyState" .verbose

: start::defProc_SteadyState

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 1
  
  sPath
  "
  procedure steadyState_1
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | periodic once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRow $Table
        | toPtnRow
        | stageB hashed

    stage stageB on all partitions :
      noop
      //insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 2
  
  sPath
  "
  procedure steadyState_2
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | periodic once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRow $Table
        | toPtnRow
        | stageB hashed

    stage stageB on all partitions :
      //noop
      insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 3
  
  sPath
  "
  procedure steadyState_3
   parameters $Table $File $NTimes
  begin

   stage stageA on origin :

     start |

     periodic once |

     rdCsvCyclic $File $NTimes |

     stageB robin


   stage stageB on all partitions on origin  :

     toRow $Table |

     toPtnRow |

     //toNstRow |

     //toHshCrw |

     stageC hashed


   stage stageC on all partitions :

     insdel $Table |

     stageD


   stage stageD on origin :

     //output |

     sink |

     stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* unload/realod related procedures                                           */
/*----------------------------------------------------------------------------*/

"  start::defProc_UnloadReload" .verbose

: start::defProc_UnloadReload

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // unload
  
  sPath
  "
  procedure unload
    parameters $Table $File
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan $Table | stageC

  stage stageC on origin :
    wrFile $File | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // /time unload LineItem "/tmp/lineitem.crw" ;


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reload
  
  sPath
  "
  procedure reload
    parameters $Table $File
  begin

  stage stageA on origin :
    start | periodic once | rdCrwFile $File | stageB

  stage stageB on all partitions :
    insert $Table | stageC

  stage stageC on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // /time reload LineItem "/tmp/lineitem.crw" ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reorder table
  
  sPath
  "
  procedure reorder
    parameters $table1 $table2 $predicate
  begin

  stage stageA on origin :
    start | periodic once | emitStreamDef $Table1 | stageB

  stage stageB on all nodes :
    createTable $table2 | stageC

  stage stageC on all partitions :
    fetch $table1 $predicate | insert $table2 | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

;

