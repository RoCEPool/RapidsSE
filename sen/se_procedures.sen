/*----------------------------------------------------------------------------*/
/* scan related procedures                                                    */
/*----------------------------------------------------------------------------*/

"  start::defProc_Scan" .verbose

: start::defProc_Scan

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // count
  
  sPath
  "
  procedure count
    tags <lowMemory>
    parameters $table
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    rowCount $table | stageC

  stage stageC on origin :
    totalCount | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // export
  
  sPath
  "
  procedure export
    parameters $Table $File
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan $Table | toCsv | stageC

  stage stageC on origin :
    wrFile $File | stageD

  stage stageD on origin :
    sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // gridSanity
  
  sPath
  "
  procedure gridSanity
    tags <lowMemory>
  begin
  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all nodes :
    nodeInfo | stageC

  stage stageC on origin :
    gridSanity | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // partitionScan
  
  sPath
  "
  procedure partitionScan
    parameters $table $partition
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on partition $partition :
    scan $table | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // predicateFetch
  
  sPath
  "
  procedure predicateFetch
    parameters $table $predicate
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    fetch $table $predicate | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // select table
  
  sPath
  "
  procedure select table
    parameters $Table
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan $Table | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tableScan
  
  sPath
  "
  procedure tableScan
    parameters $table
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    scan $table | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // truncate
  
  sPath
  "
  procedure truncate
    tags <lowMemory>
    parameters $table
  begin

  stage stageA on origin :
    start | periodic once | stageB

  stage stageB on all partitions :
    truncateTable $table | stageC

  stage stageC on origin :
    output | sink | stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* load related procedures                                                    */
/*----------------------------------------------------------------------------*/

"  start::defProc_Load" .verbose

: start::defProc_Load

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // load
  
  sPath
  "
  procedure load
    parameters $table $file
  begin

  stage stageA on origin :

    start              |

    periodic once    |

    chunk $file        | // read chunks of file, produce (seekOffset) =>
    // dump seekOffsets 1 |

    rdCsvChunk $file   | // (seekOffset) => (csvBuffer)
    // dump csvBuffer 0   |

    stageB robin


  stage stageB on all partitions on origin :

    toRow $table       | // (csvBuffer)  => (rowBuffer)
    // dump rowBuffer 1   |

    toPtnRow           | // (rowBuffer)  => (rowBuffer 'ptn)
    // dump rowBuffer 1   |

    toNstRow           | // (rowBuffer)  => (rowBuffer 'nst)
    //dump rowBuffer 1   |

    toHshCrw           | // (rowBuffer)  => (crwBuffer 'hsh)
    //dump rowBuffer 1   |

    stageC hashed

  stage stageC on all partitions :

    //eatSome |

    insert $table | // (crwBuffer) inserted into table

    stageD

  stage stageD on origin :

    progress 'Load'    |
    
    output             |

    toStatDemon        |

    sink               |

    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dfload
  
  sPath
  "
  procedure dfload
    parameters $table $file
  begin

  stage stageA on origin :

    start              |
 
    periodic once    |

    stageB

  stage stageB on all nodes :

    chunk $file        | // read chunks of file, produce (seekOffset) =>
    // dump seekOffsets 1 |

    rdCsvChunk $file   | // (seekOffset) => (csvBuffer)
    // dump csvBuffer 0   |

    stageC localRobin

  stage stageC on all partitions :

    toRow $table       | // (csvBuffer)  => (rowBuffer)
    // dump rowBuffer 1   |

    toPtnRow           | // (rowBuffer)  => (rowBuffer 'ptn)
    // dump rowBuffer 1   |

    toNstRow           | // (rowBuffer)  => (rowBuffer 'nst)
    //dump rowBuffer 1   |

    toHshCrw           | // (rowBuffer)  => (crwBuffer 'hsh)
    //dump rowBuffer 1   |

    stageD hashed

  stage stageD on all partitions :

    //eatSome |

    insert $table | // (crwBuffer) inserted into table

    stageE

  stage stageE on origin :

    progress 'Load'    |

    toStatDemon        |

    sink               |

    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // dload
  
  sPath
  "
  procedure dload
    parameters $table
  begin

    stage stageA on origin :
        start
      | periodic once
      | eachPath 
      |   toDfload $table
      | callPipeline
      | waitPipeline
      | sink
      | stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* api related procedures                                                     */
/*----------------------------------------------------------------------------*/

"  start::defProc_Api" .verbose

: start::defProc_Api

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables" locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // getRows
  
  sPath
  "
  procedure getRows
    parameters $Table
  begin

  stage stageA on origin :
    start         |
    periodic once |
    stageB

  stage stageB on all partitions :
    scan $Table   |
    crwToRow      |
    stageC

  stage stageC on origin :
    output        |
    sink          |
    stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // putRows
  
  sPath
  "
  procedure putRows
    parameters $Table
  begin

  stage stageA on origin :
    start         |
    periodic once |
    input         |
    stageB robin

  stage stageB on all partitions on origin :
    toRow $Table  |
    toPtnRow      |
    toNstRow      |
    toHshCrw      |
    stageC hashed

  stage stageC on all partitions :
    insert $Table |
    stageD

  stage stageD on origin :
    sink          |
    stageA

  end ;
  "
  api::addProcedure
;

/*----------------------------------------------------------------------------*/
/* file related procedures                                                    */
/*----------------------------------------------------------------------------*/

"  start::defProc_File" .verbose

: start::defProc_File

  "<path> = /tenants/boray/catalogs/rapidsse/schemas/public/tables"
    locals| sPath |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // copy file
  
  sPath
  "
  procedure copyFile
    parameters $FileIn $FileOut
  begin

  stage stageA on origin :
    start | periodic once | catFile $FileIn | wrFile $FileOut | sink | stageA

  end ;
  "
  api::addProcedure

  // copyFile "/Users/Shared/tpch/SF1/nation.csv" "/Users/Shared/tpch/SF1/nation_COPY.csv" ;


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // list file
  
  sPath
  "
  procedure listFile
    parameters $File
  begin

    stage stageA on origin :
      start | periodic once | catFile $File | output | sink | stageA

  end ;
  "
  api::addProcedure

  // listFile "/Users/Shared/tpch/SF1/nation.csv" ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // xyz file
  
  sPath
  "
  procedure xyzFile
    parameters $Table $File $Ntimes
  begin

    stage stageA on origin :
      start
        | periodic once
//        | catFile $File
        | rdCsvCyclic $File $NTimes
        | toRow $Table
        | toPtnRow
        | toNstRow
        | stageB hashed

    stage stageB on all partitions :
      noop
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;
  "
  api::addProcedure

  // xyzFile nation "/Users/Shared/tpch/SF1/nation.csv" 3 ;

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // cycle read file
  
  sPath
  "
  procedure cyclicRdFile
    parameters $FileIn $NTimes
  begin

    stage stageA on origin :
      start | periodic once |
        rdCsvCyclic $FileIn $NTimes | output | sink | stageA

  end ;
  "
  api::addProcedure

// cyclicRdFile "/Users/Shared/tpch/SF1/nation.csv" 3 ;
// cyclicRdFile "/Users/Shared/tpch/SF1/supplier.csv" 3 ;
// cyclicRdFile "/Users/Shared/tpch/SF1/part.csv" 3 ;
;

