/*============================================================================*/
/* OP_refTmrReset.sen -- Reference Timer Reset                                */
/*============================================================================*/

" OP_refTmrReset.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: refTmrReset_action

  refTimer::reset
  
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: refTmrReset :: refTmrReset ;

: refTmrReset_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 0

    <opEntry> = "refTmrReset_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
