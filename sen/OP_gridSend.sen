/*============================================================================*/
/* OP_gridSend.sen -- Operator grid send                                      */
/*============================================================================*/

" OP_gridSend.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_METAGET ...                                                          */
/*----------------------------------------------------------------------------*/
: gridSend_gridObject \handler

 ">>>>>>>>> gridSend_gridObject handler" .

  Pipein[]\clear to grid[]  // pop the pgridObject and put in the grid register


  // pass the table name to op__table to get the table[] register
  // then call C++ getGridParts to build the parcel and push the pParcel to the stack
  // op::pipeout pipe the pParcel out


  grid[] grid::getParts Op::pipeout

  // send EOSMARKER
  nullptr to grid[]


  true

  //task::breakpoint //set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for gridsend request                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: gridSend::geb \operator

  _lu_initialise_
  //"gridSend::geb" .

  op__topology

  // Setup ZK_D_GRIDGET handler
  find: gridSend_gridObject ZK_D_GRID op[].handler!
  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: gridSend :: gridSend ;

: gridSend_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
