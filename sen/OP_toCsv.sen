/*============================================================================*/
/* OP_toCsv.sen -- Operator toCsv                                             */
/*============================================================================*/

" OP_toCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                    DEFINITION */
/*----------------------------------------------------------------------------*/
: toCsv_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  PipeIn[].delete

  StreamDef[].newtoCsvStream
  StreamDef[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                     CRWBUFFER */
/*----------------------------------------------------------------------------*/
: toCsv_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  // check for low memory
  attachMap::isLowMemory if
    EC_LOW_MEMORY op__execErr
    PipeIn[].delete
    true
    exit
  then

  Operand[].crwToCsv
  Operand[] to Subset[]

  begin
    Operand[].isNull

  not while

    assert::stack_0

    // get the next buffer
    Subset[].nextBuffer to Subset[]

    // now pipeout the Operand
    Operand[].pipeOut

    // move Subset to Operand
    Subset[] to Operand[]

    assert::stack_0
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ROWBUFFER ...                                     ROWBUFFER */
/*----------------------------------------------------------------------------*/
: toCsv_RowBuffer \handler

  // check for low memory
  attachMap::isLowMemory if
    EC_LOW_MEMORY op__execErr
    PipeIn[].delete
    true
    exit
  then

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  Operand[].rowToCsv
  Operand[] to Subset[]

  begin
    Operand[].isNull

  not while

    assert::stack_0

    // get the next buffer
    Subset[].nextBuffer to Subset[]

    // now pipeout the Operand
    Operand[].pipeOut

    // move Subset to Operand
    Subset[] to Operand[]

    assert::stack_0
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for toCsv req                                                SPAWN */
/*----------------------------------------------------------------------------*/
 : toCsv_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toCsv_CrwBuffer  ZK_CRWBUFFER op[].handler!
  find: toCsv_RowBuffer  ZK_ROWBUFFER op[].handler!
  find: toCsv_StreamDef  ZK_STREAMDEF op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toCsv :: toCsv ;

: toCsv_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
