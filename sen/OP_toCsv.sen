/*============================================================================*/
/* OP_toCsv.sen -- Operator toCsv                                             */
/*============================================================================*/

" OP_toCsv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: toCsv_EosMarker \handler

  Tub[].pipeOutRemainder
  Tub[].delete

  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: toCsv_CrwBuffer \handler

  PipeIn[]\clear to CrwBuffer[]

  Tub[] CrwBuffer[].toCsv
  
  Tub[].pipeOutCompleted
  
  nullptr to CrwBuffer[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: toCsv_RowBuffer \handler

  PipeIn[]\clear to RowBuffer[]

  Tub[] RowBuffer[].toCsv
    
  Tub[].pipeOutCompleted

  nullptr to RowBuffer[]
  
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: toCsv_StreamDef \handler

  PipeIn[]\clear to StreamDefLft[]

  StreamDefLft[].duplicate to StreamDefOut[]

  StreamDefOut[].pipeOut

  // ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖ ⧖
 
  Tub[].new

  true
;



/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for toCsv req                                                      */
/*----------------------------------------------------------------------------*/
 : toCsv_op \operator

  _lu_initialise_

  op__topology

  find: toCsv_CrwBuffer  EV_D_CRWBUFFER [op].handler!
  find: toCsv_EosMarker  EV_M_EOS       [op].handler!
  find: toCsv_RowBuffer  EV_D_ROWBUFFER [op].handler!
  find: toCsv_StreamDef  EV_D_STREAMDEF [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toCsv :: toCsv ;

: toCsv_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "toCsv_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
