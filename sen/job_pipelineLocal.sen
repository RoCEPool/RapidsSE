/*============================================================================*/
/* job_PipelineLocal.sen -- Local Pipeline Job                                */
/*============================================================================*/

" job_pipelineLocal.sen" .verbose

/*----------------------------------------------------------------------------*/
/* terminate this pipeline                                                    */
/*----------------------------------------------------------------------------*/
: pipelineLocal::termination

  [ddlLock].testDrop

  JobRef[].assertNone

  [job].addRetired
  [task].grabLock
    TR_RETIRE_THIS_TASK [task].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute on local node                                                      */
/*----------------------------------------------------------------------------*/
: pipelineLocal::local

  0 locals| nAcks |
  
  [job].assertCorrectness

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline command
  
  "<show_command>" sysargs::tagSet@ tagSet.hasName
  if
    <cmd> "pipelineLocal::origin: %v\n" .printf
    //system::bpa
  then

  Dynamo[].new
  <cmd> Dynamo[].compile to ErrorCode[]
  ErrorCode[] EC_NONE == if
    // clean compile
    to PipelineSpec[]
    Dynamo[].delete
  else
    //"got error" .
    ErrorCode[] [job].error!
    
    [ddlLock].testDrop

    PipelineSpec[].delete
    Dynamo[].delete

    // cross check
    PipelineSpec[] not assert

    JS_SIGNALLED [job].state!
      
    [task].grabLock
    [session].signal
    [task].dropLock
    
    pipelineLocal::termination
    
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin the pipeline job (spawning jobs for ops etc)
  
  PipelineSpec[] assert

  PipelineSpec[] [pipeline].create
  
  [pipeline].spawnOpTasks

  // run <pre_execute>

  "<pre_execute>"
  [job].tagSet@ tagSet.hasName if
    "<pre_execute>"
    [job].tagSet@ tagSet.getStr locals| sPreExe |
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
      process::quit
    then
      execute
  else
    [args].verbose if
      <pipelineNm> "No pre execute word for pipeline: %v" .printf
    then
  then

  // add job to the local job list
  Job[] job.jobList@ JL_DEMON == not if
    [job].addLocal
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // enqueue start-marker to start op to execute the pipeline job

  [task].grabLock

    [pipeline].opsOnNode@ to nAcks

    nAcks if
      nAcks [task].acksRemaining!
    
      [pipeline].startPipeline if
    
        Marker[].newStartMarker
        Marker[]\clear [pipeline].op0@ op.enqueOperand
      then
      [task].wait
    else
      [task].dropLock
    then

  // - - - - - - - - - - - - - - - - - - - - - - - - - -

  // remove job from the local job list
  Job[] job.jobList@ JL_DEMON == not if
    [job].removeLocal
  then

  //<pipelineNm> [grid].thisNodeName@ "(%v) ALL DONE!!!" .
  
  
  [ddlLock].testDrop
  JobRef[].assertNone

  [job].addRetired
  
  JS_SIGNALLED [job].state!
    [session].signal

  [task].grabLock
    TR_RETIRE_THIS_TASK [task].transition!
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipelineLocal :: pipelineLocal <pipelineNm> etc ;

: pipelineLocal_cmdTags _cmdTags tagCopy: localJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"

    <jobKind>  = JK_LOCAL
    //<ddlLock>  = DL_GRAB_READ
        
    <entryPoint> = "pipelineLocal::local"

  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
