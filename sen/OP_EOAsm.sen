/*============================================================================*/
/* OP_EOAsm.sen -- sql                                                        */
/*============================================================================*/

" OP_EOAsm.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                INIT */
/*----------------------------------------------------------------------------*/
: EOAsm_Cleaning \handler

  potRlu[].isNull not if
    potRlu[].delete
  then

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: EOAsm_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  PipeIn[].pipeout

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  // generate asm from query text
  Counter0[] <queryText> genAsm not if
    EC_INVALID_COMMAND op__execErr
    true
    exit
  then

  // execute plan generated STARTMARKER_handler
  ZK_M_START Counter0[] executeAsmArgs

  // do we have a table ?
  logicUnit[].srcTable@ "" str.equal not if

    // do we have an index ?
    logicUnit[].srcIndex@ "" str.equal not if

      // find the src table and src index
      logicUnit[].srcTable@ logicUnit[].srcIndex@ op__table_index not if
        true
        exit
      then

      Index[].indexTree to indexTreeRlu[]
      indexTreeRlu[].asSrc

    else
      // find the src table
      logicUnit[].srcTable@ op__table not if
        true
        exit
      then
    then

    // set table streamDef as src streamDef
    Table[].asSrcStreamDef
    Table[].tablePtn@ to TablePtn[]

  then

  // do we have an alternate table ?
  logicUnit[].altTable@ "" str.equal not if

    // do we have an alternative index ?
    logicUnit[].altIndex@ "" str.equal not if

      // find the alt table and alt index
      logicUnit[].altTable@ logicUnit[].altIndex@ op__table_index not if
        true
        exit
      then

      Index[].indexTree to indexTreeRlu[]
      indexTreeRlu[].asAlt

    else

      // find the src table
      logicUnit[].srcTable@ op__table not if
        true
        exit
      then

    then

    // set table streamDef as src streamDef
    Table[].asAltStreamDef
    Table[].tablePtn@ to TablePtn[]

  then

  //ZK_M_START_handler

  // pipeout streamDefout if any (q3)
  //StreamDefOut[].isNull not if
  //  StreamDefOut[].pipeout
  //then

  true

;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: EOAsm_DataMarker \handler

  //
  // HACK:: till we get the ASM of query text's out of this operator

  // If a streamDef is created in STARTMARKER
  // we cannot pipe it out there as its possible
  // that the next EOASM gets an error while handling its STARTMARKER
  // and then it doesn't know how to handle the STREAMDEF
  // eg 300 creates streamdef in startMarker handler
  // sends it out
  // 301 gets an error while ASM of 301 query text
  // can't handle stream marker (from inside ASM code (no ASM))

  // pipeout streamDefout if any (q3)
  StreamDefOut[].isNull not if
    StreamDefOut[].pipeout
  then

  // END HACK
  //

  PipeIn[].isNull not if
    ZK_M_DATAPULSE EG_ZK PD_PIPE_OUT 0 ZK_M_DATAPULSE EG_ZK LogicUnit[].diaryAction
    PipeIn[].pipeOut // ZK_M_DATAPULSE_handler
  then

  // execute plan DATAPULSE_HANDLER
  ZK_M_DATAPULSE Counter0[] executeAsmArgs

  false LogicUnit[].calledAgain!

  // pipeout streamDefout if any
  StreamDefOut[].isNull not if
    StreamDefOut[].pipeout
  then

  LogicUnit[].callAgain@ if
    //"Completed test" .
    PotRlu[].pipeoutCompletedPtns
  else
    //"not called again" .
    //PotRlu[].pipeoutDanglingPtns
    // force op loop to call EOAsm_EosMarker to end
    "EOAsm_EosMarker" word::find LogicUnit[].handler!
    true LogicUnit[].callAgain!
  then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: EOAsm_CrwBuffer \handler

  0 ZK_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  Pipein[]\clear to CrwBuffer[]
  CrwBuffer[] DevLftIxt.crwBuffer!
  ZK_D_CRWBUFFER Counter0[] executeAsmArgs
  CrwBuffer[].delete
  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: EOAsm_RowBuffer \handler

  0 ZK_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  //Pipein[] "GOT ROWBUFFER %v" .printf
  Pipein[]\clear to RowBuffer[]
  RowBuffer[] DevLftRow.rowBuffer!
  ZK_D_ROWBUFFER Counter0[] executeAsmArgs
  RowBuffer[].delete
  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: EOAsm_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote

  // Invoked from PULSEMARKER call again?
  Marker[].isNull not if
    //"PULSEMARKER created an EOSMARKER" .
    // there should be no Pipein EOSMARKER
    Pipein[].isNull assert
    Marker[]\clear to Pipein[]
  then

  // Invoked from PULSEMARKER call again?
  // but PULSEMARKER did not create an EOS MARKER
  Pipein[].isNull if
    //"PULSEMARKER is null" .
    true
    exit
  then

  // handle EOSMARKER
  ZK_M_EOS Counter0[] executeAsmArgs
  Counter0[] cleanUpAsm

  // pipe out all PotRlu[]
  PotRlu[].pipeoutDanglingPtns
  PotRlu[].delete

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction
  ZK_M_EOS_handler

;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: EOAsm_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  Pipein[] to StreamDefLft[]
  nullptr to Pipein[]

  // execute plan STREAMDEF_handler
  ZK_D_STREAMDEF Counter0[] executeAsmArgs

  // StreamDef handler saves the streamDefLft as StreamDefOut
  nullptr to StreamDefLft[]

  //StreamDefLft[].asSrcStreamDef

  // pipeout streamDefout if any
  StreamDefOut[].isNull not if
    StreamDefOut[].pipeout
  then

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: EOAsm_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: EOAsm_Cleaning      ZK_M_CLEANING op[].handler!
  find: EOAsm_CrwBuffer     ZK_D_CRWBUFFER     op[].handler!
  find: EOAsm_EosMarker     ZK_M_EOS     op[].handler!
  find: EOAsm_DataMarker    ZK_M_DATAPULSE     op[].handler!
  find: EOAsm_RowBuffer     ZK_D_ROWBUFFER     op[].handler!
  find: EOAsm_StartMarker   ZK_M_START   op[].handler!
  find: EOAsm_StreamDef     ZK_D_STREAMDEF     op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: EOAsm :: EOAsm <queryText> <compiled> ;

: EOAsm_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
