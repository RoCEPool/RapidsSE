/*============================================================================*/
/* OP_toNstRow.sen -- Convert row to normalised string row slab buffers       */
/*============================================================================*/

" OP_toNstRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toNstRow_StartMarker \handler

  ToNstRow[].create

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: toNstRow_DataMarker \handler

  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toNstRow_RowBuffer \handler

  PipeIn[] ToNstRow[].convert to OperandB[]
  nullptr to PipeIn[]

  OperandB[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: toNstRow_EosMarker \handler

  // delete ToNstRow
  ToNstRow[].delete

  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toNstRow request                                                    SPAWN */
/*----------------------------------------------------------------------------*/
: toNstRow_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toNstRow_EosMarker   ZK_EOSMARKER   op[].handler!
  find: toNstRow_DataMarker  ZK_DATAPULSE   op[].handler!
  find: toNstRow_RowBuffer   ZK_ROWBUFFER   op[].handler!
  find: toNstRow_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toNstRow :: toNstRow ;

: toNstRow _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
