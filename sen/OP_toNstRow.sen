/*============================================================================*/
/* OP_toNstRow.sen -- Convert row to normalised string row slab buffers       */
/*============================================================================*/

" OP_toNstRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: toNstRow_StartMarker \handler

  ToNstRow[].create

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: toNstRow_DataMarker \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: toNstRow_RowBuffer \handler

  PipeIn[]\clear to RowBuffer[]
  RowBuffer[]\clear ToNstRow[].convert to RowBuffer[]

  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: toNstRow_EosMarker \handler

  // delete ToNstRow
  ToNstRow[].delete

  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toNstRow request                                                    SPAWN */
/*----------------------------------------------------------------------------*/
: toNstRow_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: toNstRow_EosMarker   ZK_M_EOS   op[].handler!
  find: toNstRow_DataMarker  ZK_M_DATAPULSE   op[].handler!
  find: toNstRow_RowBuffer   ZK_D_ROWBUFFER   op[].handler!
  find: toNstRow_StartMarker ZK_M_START op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toNstRow :: toNstRow ;

: toNstRow_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
