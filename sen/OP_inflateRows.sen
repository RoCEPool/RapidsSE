/*============================================================================*/
/* OP_inflateRows.sen -- inflate rows from rowBuffer into same                */
/*============================================================================*/

" OP_inflateRows.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                               EOS */
/*----------------------------------------------------------------------------*/
: inflateRows_Eos \handler

  StreamDefLft[].delete

  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ...                                   CRWBUFFER */
/*----------------------------------------------------------------------------*/
: inflateRows_CrwBuffer \handler

  //"Operand:- ZK_D_CRWBUFFER" .verbose

  Pipein[]\clear to crwBuffer[]
  StreamDefLft[] crwBuffer[].inflate

  crwBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                   STREAMDEF */
/*----------------------------------------------------------------------------*/
: inflateRows_StreamDef \handler

  PipeIn[]\clear to StreamDefLft[]

  // pipeout copy of stream def
  StreamDefLft[].duplicate to StreamDefOut[]
  StreamDefOut[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for inflateRows req                                         SPAWN */
/*----------------------------------------------------------------------------*/
 : inflateRows_op \operator

  _lu_initialise_

  op__topology

  find: inflateRows_CrwBuffer  ZK_D_CRWBUFFER op[].handler!
  find: inflateRows_StreamDef  ZK_D_STREAMDEF op[].handler!
  find: inflateRows_Eos        ZK_M_EOS       op[].handler!
 
  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: InflateRows :: InflateRows ;

: inflateRows_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "inflateRows_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
