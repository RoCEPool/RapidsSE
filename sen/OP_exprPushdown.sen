/*============================================================================*/
/* OP_exprPushdown.sen -- Push expr generation down in the plan (SQL Compiler)*/
/*============================================================================*/

" OP_exprPushdown.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: exprPushdown_CancelMarker \handler

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: exprPushdown_PlanOperand \handler

  PipeIn[]\clear to Operand[]

  // create the command error info set
  op__cmdErrInfoSet

  Operand[] nullptr to Operand[] sqlCompiler::exprPushdown to Operand[]

   "exprPushdown" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: exprPushdown_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_ExitEarlyMarker  ZK_EXITEARLYMARKER op[].handler!
  find: compiler_StreamSet        ZK_STREAMSET       op[].handler!

  // specific handlers
  find: exprPushdown_CancelMarker ZK_CANCELMARKER op[].handler!
  find: exprPushdown_PlanOperand  ZK_PLANOPERAND  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exprPushdown :: exprPushdown ;

: exprPushdown_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
