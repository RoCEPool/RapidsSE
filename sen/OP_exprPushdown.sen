/*============================================================================*/
/* OP_exprPushdown.sen -- Push expr generation down in the plan (SQL Compiler)*/
/*============================================================================*/

" OP_exprPushdown.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: exprPushdown_Cleaning \handler

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: exprPushdown_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCmdErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::exprPushdown to PlanOperand[]

  "exprPushdown" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: exprPushdown_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker  ZK_M_LEAVE       op[].handler!
  find: compiler_StreamSet    ZK_D_STREAMSET   op[].handler!

  // specific handlers
  find: exprPushdown_Cleaning      ZK_M_CLEANING      op[].handler!
  find: exprPushdown_PlanOperand   ZK_D_PLANOPERAND   op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exprPushdown :: exprPushdown ;

: exprPushdown_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
