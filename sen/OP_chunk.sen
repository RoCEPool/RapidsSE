/*============================================================================*/
/* OP_chunk.sen -- Operator chunk                                             */
/*============================================================================*/

" OP_chunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_CLEANING ...                                                       */
/*----------------------------------------------------------------------------*/
: chunk_Cleaning \handler

  //"Operand:- EV_M_CLEANING" .verbose
  //File0[].isNull not if
  //  File0[].get file.close
  //  File0[].get file.delete
  //then

  0 thread.faultCurrent!

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_DataPulse \handler // \enterExitTrace

  //"Operand:- EV_M_DATAPULSE" .verbose

  //"*******chunk_DataPulse:- EV_M_DATAPULSE" .

  PipeIn[].pipeOut

  7 thread.faultCurrent!

  File0[].isOpen? not if
    true
    exit
  then
  

  // find the __seekOffsets table
  C_TDEF_SEEKOFFSETS op__tableDef_infoSet assert

  // set eof location in counter0
  File0[].getEofLocation to counter1[]

  // set chunk location in counter1 to 0
  0 to counter0[]

  begin
    counter1[] counter0[] >
  while
    //counter1[] "counter1 %v" .printf

    // create an infoSet operand
    infoSetTable[] InfoSet[].new
    InfoSet[].chunkFile counter2[] + to counter2[]

    InfoSet[].pipeOut
  repeat

  "<OP_chunk>" [job].tagSet@ tagSet.hasName if
    counter2[] "OP_chunk: totalBytes %v\n" .putf
  then


  // send EOSMARKER
  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                          */
/*----------------------------------------------------------------------------*/
: chunk_StartMarker \handler

  //"Operand:- EV_M_START" .verbose

  0 locals| iFileSizeMb |

  <fileNm> locals| sFileNm_raw |
  
  [job].tagSet@ sFileNm_raw str.replaceTags locals| sFileNm |

  // open the file for reading
  sFileNm OPEN_READ op__file if

    // Determine the line ending if it hasn't been explicitly set.
    // We must do this before PipeIn[].pipeOut so that it is known
    // before ToKeyHshRow[].new is executed.

    "<record_ends>" [job].tagSet@ tagSet.hasName not if
      "<record_ends>" InfoSet[].detectLineEnding [job].tagSet@ tagSet.insertStr
    then

    PipeIn[].pipeOut

    // get size of file
    File0[].size C_1Mb / to iFileSizeMb

    // create a streamDef for C_TDEF_TOTALUNITS
    C_TDEF_TOTALUNITS op__tableDef_infoSet assert

    "<OP_chunk>" [job].tagSet@ tagSet.hasName if
      iFileSizeMb sFileNm "OP_chunk: %v : %vMB\n" .putf
    then

    // create an infoSet operand for C_TDEF_TOTALUNITS
    infoSetTable[] InfoSet[].new

    // add fileSize to the infoset
    sFileNm iFileSizeMb infoSetTable[] InfoSet[].addTotalUnits assert

    // pipeout the infoset
    InfoSet[].pipeOut

  else
    PipeIn[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for chunk req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : chunk_op \operator
 
  _lu_initialise_

  op__topology

  find: chunk_Cleaning    EV_M_CLEANING  [op].handler!
  find: chunk_DataPulse   EV_M_DATAPULSE [op].handler!
  find: chunk_StartMarker EV_M_START     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: chunk :: chunk <fileNm> ;

: chunk_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "chunk_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
