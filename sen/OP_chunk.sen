/*============================================================================*/
/* OP_chunk.sen -- Operator chunk                                             */
/*============================================================================*/

" OP_chunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                       */
/*----------------------------------------------------------------------------*/
: chunk_Cleaning \handler

  //"Operand:- ZK_M_CLEANING" .verbose
  //File0[].isNull not if
  //  File0[].get file.close
  //  File0[].get file.delete
  //then

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: chunk_DataMarker \handler

  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // find the __seekOffsets table
  C_TDEF_SEEKOFFSETS op__tableDef_infoSet assert

  // set eof location in counter0
  File0[].getEofLocation to counter1[]

  // set chunk location in counter1 to 0
  0 to counter0[]

  begin
    counter1[] counter0[] >
  while
    //counter1[] "counter1 %v" .printf

    // create an infoSet operand
    infoSetTable[] InfoSet[].new
    InfoSet[].chunkFile
    InfoSet[].pipeOut
  repeat

  // send EOSMARKER
  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                          */
/*----------------------------------------------------------------------------*/
: chunk_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  0 locals| iFileSizeMb |

  <fileNm> locals| sFileNm_raw |
  
  job::tagSet@ sFileNm_raw str.replaceTags locals| sFileNm |

  PipeIn[].pipeOut

  // open the file for reading
    sFileNm OPEN_READ op__file if

    // get size of file
    File0[].size C_1Mb / to iFileSizeMb

    // create a streamDef for C_TDEF_TOTALUNITS
    C_TDEF_TOTALUNITS op__tableDef_infoSet assert

    // create an infoSet operand for C_TDEF_TOTALUNITS
    infoSetTable[] InfoSet[].new

    // add fileSize to the infoset
    sFileNm iFileSizeMb infoSetTable[] InfoSet[].addTotalUnits assert

    // pipeout the infoset
    InfoSet[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for chunk req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : chunk::geb \operator
 
  _lu_initialise_

  op__topology

  find: chunk_Cleaning    ZK_M_CLEANING  op[].handler!
  find: chunk_DataMarker  ZK_M_DATAPULSE op[].handler!
  find: chunk_StartMarker ZK_M_START     op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: chunk :: chunk <fileNm> ;

: chunk_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
