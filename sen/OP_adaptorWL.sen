/*============================================================================*/
/* OP_adaptorWL.sen -- Operator wire line adaptor                             */
/*============================================================================*/

" OP_adaptorWL.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Send any serialised wireline responses if there are any queued and waiting.*/
/* Pushes false if the protocol/connection is unviable, otherwise true.       */
/*----------------------------------------------------------------------------*/
: adaptorWL_sendAnyWLResponses

  0 locals| pPayloadObj |

  begin
    AdaptorWL[].hasPayloadToSend@

    while
      AdaptorWL[].nextPayloadToSend@ to pPayloadObj

      trace.withWlp if
        pPayloadObj payloadObj::size@
        pPayloadObj payloadObj::msgType@
        AdaptorWL[].clientAddr@
        "Client %v: Piping out payload: %v : %v bytes" str.format .traceWlp
      then

      pPayloadObj [op].pipeOut
    repeat

  0 to pPayloadObj

  // Check if the protocol is unviable (e.g. received invalid msg or in wrong sequence).
  AdaptorWL[].protocolErrorTest if
    AdaptorWL[].clientAddr@ "Client %v: Piping out error marker" str.format .traceWlp
    AdaptorWL[].protocolError@ op__execErr
    false
    exit
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handle BT_AFFECTEDROWS                                                     */
/* Called when an affectedRows pdsRowBuffer is received.                      */
/*----------------------------------------------------------------------------*/
: adaptorWL_AffectedRows

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_AffectedRows - BT_AFFECTEDROWS" str.format .traceWlp
  then

  // get the pdsRowBuffer
  PipeIn[]\clear to Pds[]

  adaptorWL[].affectedRowCountPds

  // now delete the Pds[]
  Pds[].delete

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses discard
;

/*----------------------------------------------------------------------------*/
/* handle for BT_EXECERRORS                                                   */
/* Called when there is an error from a sub command but also when the         */
/* client disconnects.                                                        */
/*----------------------------------------------------------------------------*/
: adaptorWL_ExecErrors

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_ExecErrors - BT_EXECERRORS" str.format .traceWlp
  then

  PipeIn[] to PdsErr[]
  nullptr to PipeIn[]

  AdaptorWL[].clientAddr@ "Client %v: Processing error PdsRowBuffer" str.format .traceWlp

  adaptorWL[].executionError

  // now delete the PdsErr[]
  PdsErr[].delete

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses discard
;

/*----------------------------------------------------------------------------*/
/* handle BT_COMPILEERRORS                                                    */
/* Called when there is an error from the SQL compiler.                       */
/*----------------------------------------------------------------------------*/
: adaptorWL_CompileErrors

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_CompileErrors - COMPILEERRORS" str.format .traceWlp
  then

  PipeIn[] to PdsErr[]
  nullptr to PipeIn[]

  AdaptorWL[].compilerError

  // now delete the PdsErr[]
  PdsErr[].delete

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses discard
;

/*----------------------------------------------------------------------------*/
/* handle BT_WARNINGS                                                         */
/* Called when there is a warning from a sub command.                         */
/*----------------------------------------------------------------------------*/
: adaptorWL_Warning

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_Warning - BT_WARNINGS" str.format .traceWlp
  then

  PipeIn[]\clear to PdsWarn[]

  adaptorWL[].executionWarning

  // now delete the PdsWarn[]
  PdsWarn[].delete

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses discard
;

/*----------------------------------------------------------------------------*/
/* Parse a query into one or more tasks                                       */
/*----------------------------------------------------------------------------*/
: adaptorWL_parseQuery params| sSmt |

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_parseQuery" str.format .traceWlp
  then

  TaskList[].isNull assert

  // Parse the command into one or more tasks
  STD_NORMALFORK_TAG sSmt api::parseCommand if

    // A pointer to a tasklist is now on the data stack. Save it.
    TaskList[].set
    AdaptorWL[].queryReceipt

  else
    // Error code and error message are on the stack. Use it to form a message
    // to be send to the client.
    AdaptorWL[].stmtParsingErr
    exit
  then
;

/*----------------------------------------------------------------------------*/
/* Schedule the next task, if any                                             */
/*----------------------------------------------------------------------------*/
: adaptorWL_scheduleNextTask

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_scheduleNextTask" str.format .traceWlp
  then

  0 locals| pNextTask |

  TaskList[].isEmpty AdaptorWL[].isAbortEarly or if
    AdaptorWL[].queryComplete
    TaskList[].delete
    exit
  then

  trace.withWlp if
    ticking::getTick AdaptorWL[].clientAddr@ "Client %v: Scheduling task for execution at time %v" str.format .traceWlp
  then

  TaskList[].pop to pNextTask

  pNextTask AdaptorWL[].statementToSubmit

  AdaptorWL[].stmtSubmitted

  [Op] [job].responseOp!
  pNextTask api::scheduleTask to ErrorCode[]

  // Check if there were any errors while scheduling the task.
  // If there are errors then there are likely errors like low memory
  // or system closed. i.e. fatal errors.
  ErrorCode[] if
    ErrorCode[] AdaptorWL[].stmtSubmittedErr
    AdaptorWL[].queryComplete
    TaskList[].delete
    exit
  then
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START                                                     */
/* Called when the pipeline is first started, to initialise all operators.    */
/*----------------------------------------------------------------------------*/
: adaptorWL_StartMarker \handler

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_StartMarker - EV_M_START" str.format .traceWlp
  then

  PipeIn[]\clear [op].pipeout

  // Get a temporary copy of the socket so the AdaptorWL knows the client's
  // IP and port
  "<ansSocket>" [job].tagSet@ tagSet.hasName assert
  <ansSocket> >int >ptr

  AdaptorWL[].new
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PAYLOAD                                                   */
/* This is called when a wireline message has been read from the socket and   */
/* it needs to be decoded and processed.                                      */
/*----------------------------------------------------------------------------*/
: adaptorWL_Payload \handler

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_Payload - EV_D_PAYLOAD" str.format .traceWlp
  then

  PipeIn[]\clear locals| pPayloadObj |
  0 locals| iLastTime |
  0 locals| iCurrTime |
  0 locals| iElapsedTime |

  // Check if we need to process this message
  pPayloadObj payloadObj::doNotProcess@ if
    trace.withWlp if
      AdaptorWL[].clientAddr@ "Client %v: ignoring payload with doNotProcess bit set" str.format .traceWlp
    then

    pPayloadObj [op].pipeOut
    true
    exit
  then

  // Check if we previously received an error
  AdaptorWL[].protocolErrorTest if
    pPayloadObj payloadObj::delete
    0 to pPayloadObj
    true
    exit
  then

  trace.withWlp if
    // Calculate the elapsed time between receiving the payload off the socket
    // to processing it in the AdaptorWL
    ticking::getTick to iCurrTime
    iCurrTime pPayloadObj payloadObj::creationTime@ - to iElapsedTime

    iElapsedTime
    iCurrTime
    pPayloadObj payloadObj::size@
    pPayloadObj payloadObj::msgType@
    AdaptorWL[].clientAddr@
    "Client %v: Received payload: %v : %v bytes at time %v (elapsed socket recv to adaptor recv time: %v ns)" str.format .traceWlp
  then

  // Decode the payload to a message. This might generate payloads to be sent.
  pPayloadObj AdaptorWL[].decodePayload
  pPayloadObj payloadObj::delete
  0 to pPayloadObj

  // Possible errors from decoding need to be sent here.
  adaptorWL_sendAnyWLResponses not if
    true
    exit
  then

  // Process the decoded message.

  // Processing a message may generate 1 or more payloads to be sent back to the client.
  AdaptorWL[].processWLMsg

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses not if
    true
    exit
  then

  // Check if there are queries to be parsed and submitted through the API
  AdaptorWL[].hasQuery if

    trace.withWlp if
      iCurrTime to iLastTime
      ticking::getTick to iCurrTime
      iCurrTime AdaptorWL[].clientAddr@ "Client %v: About to start parsing query at time %v" str.format .traceWlp
    then

    AdaptorWL[].queryStr@ adaptorWL_parseQuery

    trace.withWlp if
      iCurrTime to iLastTime
      ticking::getTick to iCurrTime
      iCurrTime iLastTime - to iElapsedTime
      iElapsedTime iCurrTime AdaptorWL[].clientAddr@
      "Client %v: Finished parsing query at time %v (elapsed time: %v ns)" str.format .traceWlp
    then

    // Pipeout any payloads that were just generated so they can be sent straight away
    adaptorWL_sendAnyWLResponses not if
      true
      exit
    then

    // Schedule the next task, if any
    adaptorWL_scheduleNextTask

    // Pipeout any payloads that were just generated so they can be sent straight away
    adaptorWL_sendAnyWLResponses not if
      true
      exit
    then

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF                                                 */
/* Called to indicate the definition of a resultset from a query.             */
/*----------------------------------------------------------------------------*/
: adaptorWL_StreamDef \handler

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_StreamDef - EV_D_STREAMDEF" str.format .traceWlp
  then

  // Pass stream def to Adaptor. Adaptor saves it for use with row data.
  PipeIn[]\clear AdaptorWL[].resultMetadata

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses discard

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER                                                 */
/* Called when a compact row buffer is received. CRW buffers are stored in    */
/* tables, so these are often received when a table is scanned without        */
/* projections.                                                               */
/*----------------------------------------------------------------------------*/
: adaptorWL_CrwBuffer \handler

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_CrwBuffer - EV_D_CRWBUFFER" str.format .traceWlp
  then

  PipeIn[] AdaptorWL[].crwBuffer
  Pipein[].delete

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses discard

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PDSROWBUFFER                                              */
/* Called when a pds row buffer is received. These are projections from a query*/
/*----------------------------------------------------------------------------*/
: adaptorWL_PdsRowBuffer \handler

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_PdsRowBuffer - EV_D_PDSROWBUFFER" str.format .traceWlp
  then

  // handle AFFECTEDROWS
  PipeIn[].bufferType@ BT_AFFECTEDROWS == if
    adaptorWL_affectedRows
    true
    exit
  then

  // handle BT_COMPILEERRORS
  PipeIn[].bufferType@ BT_COMPILEERRORS == if
    adaptorWL_CompileErrors
    true
    exit
  then

  // handle EXECERRORS
  PipeIn[].bufferType@ BT_EXECERRORS == if
    adaptorWL_ExecErrors
    true
    exit
  then

  // handle BT_WARNINGS
  PipeIn[].bufferType@ BT_WARNINGS == if
    adaptorWL_Warning
    true
    exit
  then

  PipeIn[] AdaptorWL[].Pds
  Pipein[].delete

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses discard

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_X_CHILDEXIT ...                                             */
/* Called when the submitted statement has finished being executed.           */
/*----------------------------------------------------------------------------*/
: adaptorWL_ChildExit \handler

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_ChildExit - EV_X_CHILDEXIT" str.format .traceWlp
  then

  0 locals| iCurrTime    |
  0 locals| iElapsedTime |

  nullptr [job].responseOp!
  Pipein[].delete

  TC_WLP trace.getComponent if
    ticking::getTick AdaptorWL[].clientAddr@ "Client %v: Child task exited at time %v" str.format .traceWlp
  then

  adaptorWL[].childJobExited

  // The client may have disconnected while the child job was executing. If so
  // then an ErrorMarker[] will be set. We couldn't pipe this out until the
  // child job has exited, so now is the time.
  ErrorMarker[].isNotNull if
    AdaptorWL[].clientAddr@ "Client %v: Piping out previously received error marker" str.format .traceWlp
    ErrorMarker[].pipeOut
    true
    exit
  then

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses not if
    true
    exit
  then

  // Schedule the next task, if any
  adaptorWL_scheduleNextTask


  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses not if
    true
    exit
  then


  // Print out how long it took from receiving the query to sending the last response.
  // This does not include the actual sending of the payloads or how long it takes for
  // the client to receive and display them.
  trace.withWlp if
    ticking::getTick to iCurrTime
    iCurrTime adaptorWL[].payloadCreateTime@ - to iElapsedTime
    iElapsedTime iCurrTime AdaptorWL[].clientAddr@ "Client %v: Recv & execution of query finished at time %v (elapsed time: %v ns)" str.format .traceWlp
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ERROR                                                     */
/* Called when an upstream operator encounters an error. Usually because the  */
/* client has disconnected.                                                   */
/*----------------------------------------------------------------------------*/
: adaptorWL_Error \handler

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_Error - EV_M_ERROR" str.format .traceWlp
  then

  // We cannot simply pass this downstream if a statement has already been
  // submitted through the API. Instead we will need to save the error and
  // only re-emit it after the child job has exited.

  AdaptorWL[].isChildJobActive if
    trace.withWlp if
      AdaptorWL[].clientAddr@ "Client %v: Saving error marker until child query has completed" str.format .traceWlp
    then

    ErrorMarker[].isNull assert
    Pipein[]\clear ErrorMarker[].set
    true

  else
    trace.withWlp if
      AdaptorWL[].clientAddr@ "Client %v: Piping out error marker" str.format .traceWlp
    then

    EV_M_ERROR_handler
  then
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING                                                  */
/* Called when the pipeline is being torn down. Usually because the client has*/
/* disconnected, or the server is disconnecting from the client.              */
/*----------------------------------------------------------------------------*/
: adaptorWL_Cleaning \handler

  trace.withWlp if
    AdaptorWL[].clientAddr@ "Client %v: adaptorWL_Cleaning - EV_M_CLEANING" str.format .traceWlp
  then

  EV_M_CLEANING_handler
;


/*----------------------------------------------------------------------------*/
/* entry point                                                                */
/*----------------------------------------------------------------------------*/
: adaptorWL_op \operator
 
  _lu_initialise_

  op__topology

  find: adaptorWL_StartMarker   EV_M_START          [op].handler!
  find: adaptorWL_Payload       EV_D_PAYLOAD        [op].handler!
  find: adaptorWL_CrwBuffer     EV_D_CRWBUFFER      [op].handler!
  find: adaptorWL_PdsRowBuffer  EV_D_PDSROWBUFFER   [op].handler!
  find: adaptorWL_StreamDef     EV_D_STREAMDEF      [op].handler!
  find: adaptorWL_ChildExit     EV_X_CHILDEXIT      [op].handler!
  find: adaptorWL_Error         EV_M_ERROR          [op].handler!
  find: adaptorWL_Cleaning      EV_M_CLEANING       [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: adaptorWL :: adaptorWL ;

: adaptorWL_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "adaptorWL_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
