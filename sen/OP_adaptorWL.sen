/*============================================================================*/
/* OP_adaptorWL.sen -- Operator wire line adaptor                             */
/*============================================================================*/

" OP_adaptorWL.sen" .verbose

/*----------------------------------------------------------------------------*/
/* Send any serialised wireline responses if there are any queued and waiting */
/*----------------------------------------------------------------------------*/
: adaptorWL_sendAnyWLResponses

  begin
    AdaptorWL[].hasPayloadToSend@
  while
    "Sending payload" .
    AdaptorWL[].nextPayloadToSend@ [op].pipeOut
  repeat
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                          */
/*----------------------------------------------------------------------------*/
: adaptorWL_StartMarker \handler

  "adaptorWL_StartMarker - EV_M_START" .

  PipeIn[]\clear [op].pipeout

  AdaptorWL[].new
  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_PAYLOAD ...                                                        */
/* This is called when a wireline message has been read from the socket and   */
/* it needs to be decoded and processed.                                      */
/*----------------------------------------------------------------------------*/
: adaptorWL_Payload \handler

  "adaptorWL_Payload- EV_D_PAYLOAD" .

  PipeIn[]\clear locals| pPayloadObj |

  // Check if we previously received an error
  AdaptorWL[].protocolErrorTest if
    pPayloadObj payloadObj::delete
    true
    exit
  then

  // Decode the payload to a message. This might generate payloads to be sent.
  pPayloadObj AdaptorWL[].decodePayload
  pPayloadObj payloadObj::delete

  // Possible errors from decoding need to be sent here.
  adaptorWL_sendAnyWLResponses

  // Check if the protocol is unviable (e.g. received invalid msg or in wrong sequence).
  AdaptorWL[].protocolErrorTest if
    AdaptorWL[].protocolError@ op__execErr
    true
    exit
  then

  // Process the decoded message.

  // Processing a message may generate 1 or more payloads to be sent back to the client.
  AdaptorWL[].processWLMsg

  // Pipeout any payloads that were just generated so they can be sent straight away
  adaptorWL_sendAnyWLResponses

  // Check if the protocol is unviable
  AdaptorWL[].protocolErrorTest if
    AdaptorWL[].protocolError@ op__execErr
    true
    exit
  then

  // Check if there are queries to be submitted through the API

//AdaptorWL[].hasApiQuery@ if
//  // TODO: Submit query through API
//then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING operand                                          */
/*----------------------------------------------------------------------------*/
: adaptorWL_Cleaning \handler

  "adaptorWL_Cleaning - EV_M_CLEANING" .

  EV_M_CLEANING_handler
;


/*----------------------------------------------------------------------------*/
/* entry point                                                                */
/*----------------------------------------------------------------------------*/
: adaptorWL_op \operator
 
  _lu_initialise_

  op__topology

  find: adaptorWL_StartMarker EV_M_START       [op].handler!
  find: adaptorWL_Payload     EV_D_PAYLOAD     [op].handler!
  find: adaptorWL_Cleaning    EV_M_CLEANING    [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: adaptorWL :: adaptorWL ;

: adaptorWL_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "adaptorWL_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
