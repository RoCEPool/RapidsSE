/*============================================================================*/
/* pp_load.sen -- load pipeline procedures                                    */
/*============================================================================*/

" pp_load.sen" .verbose

/*----------------------------------------------------------------------------*/
/* load procedures                                                            */
/*----------------------------------------------------------------------------*/

: start::defProc_LoadSys

  STD_PATH_TAG
  "
  procedure loadSystem
    parameters $table $file
  begin

    stage stageA on origin :
        start
      | pulse once
      | chunk $file       // read chunks of file => (seekOffset)
      | rdCsvChunk $file  // (seekOffset) => (csvBuffer)
      | next robin

    stage stageB on all partitions on origin :
        toRow $table      // pf    (csvBuffer) => (rowBuffer w row+hash)
      | toPtnRow          //    pf (rowBuffer) => (ptn rowBuffer)
    //| toBktRow          //       (rowBuffer) => (bkt rowBuffer)
      | toNstRow          //       (rowBuffer) => (nst rowBuffer)
      | next hashcast

    stage stageC on all partitions :
        insert $table     // (crwBuffer) inserted into table
      | next

    stage stageD on origin :
        progress 'Load'
      | output
      | toStatDemon
      | sink
      | first

  end ;
  "
  api::addProcedure


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // load (bucket)
  
  STD_PATH_TAG
  "
  procedure load_bkt
    parameters $table $file
  begin

    stage stageA on origin :
        start
      | pulse once
      | chunk $file       // read chunks of file => (seekOffset)
      | rdCsvChunk $file  // (seekOffset) => (csvBuffer)
      | stageB robin

    stage stageB on all partitions on origin :
        toRow $table      // pf    (csvBuffer) => (rowBuffer w row+hash)
      | toBktRow          //       (rowBuffer) => (bkt rowBuffer)
      | toNstRow          //       (rowBuffer) => (nst rowBuffer)
      | toBktCrw          //       (rowBuffer) => (bkt crwBuffer)
      | stageC hashcast

    stage stageC on all partitions :
        insert $table     // (crwBuffer) inserted into table
      | stageD

    stage stageD on origin :
        progress 'Load'
      | output
      | toStatDemon
      | sink
      | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
