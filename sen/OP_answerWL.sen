/*============================================================================*/
/* OP_answerWL.sen -- Operator answer for WL Adaptor                          */
/*============================================================================*/

" OP_answerWL.sen" .verbose



/*----------------------------------------------------------------------------*/
/* spawn the wireline receiver job (as a dedicated job)                       */
/*----------------------------------------------------------------------------*/
: spawn_WLReceiver ( pAcceptedSocket iConnNo -- )

  params| iConnNo |
  params| pAcceptedSocket |

  // form the tag set string
  pAcceptedSocket "<ansSocket> = %v " str.format
  iConnNo "<connectionNo> = %v " str.format str.cat
  STD_DEMONFORK_TAG str.cat

    // receiver demon pipeline
    receiverWL_procText api::forkDemon not if
      "Error Code %v" str.format .traceWlp
    else
      discard // jobId
    then
;


/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: answerWL_StartMarker \handler

  0 locals| iPort |
  0 locals| pAcceptedSocket |
  0 locals| nConns |

  "AnswerWL Demon Started" .boot

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the listening port of this node
  [grid].thisNodeName@ [grid].findNodeByName node.portWL to iPort

  iPort "Waiting for connections on port %v" str.format .traceWlp

  // now create a listening socket
  iPort Port[]::newListen

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin

    // -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
    // wait for next socket

    trap::stackDepthZero

    Port[].acceptConnection to pAcceptedSocket

    AM::SHOW::bConnection if
      iPort "Answered connection on port %v" str.format .traceWlp
    then

    // -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
    // spawn receiver task for the socket

    // increment connection counter
    nConns 1 + to nConns

    pAcceptedSocket nConns spawn_WLReceiver

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/* execute for answer req                             (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : answerWL_op \operator

  _lu_initialise_

  op__topology

  find: answerWL_StartMarker EV_M_START [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: answerWL :: answerWL ;

: answerWL_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <dedicatedThd> = 1
    <opEntry> = "answerWL_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
