/*============================================================================*/
/* OP_bpa.sen -- Buffer Pool Analysis operator                                */
/*============================================================================*/

" OP_bpa.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: bpa_DataMarker \handler

//  2 trace!

  //"Operand:- EV_M_DATAPULSE" .verbose
  PipeIn[].pipeOut


  <bpaType> "regions" str.same if
    // Create a warnings Pds. We may not need it.
    C_TDEF_WARNINGS op__tableDef_warn assert
    BT_WARNINGS TableDefWarn[] PdsWarn[].new

    // find the C_TDEF_BPAREGIONS table definition
    C_TDEF_BPAREGIONS op__tableDef assert

    // create a streamDef and pipe it out
    TableDef[] StreamDefLft[].new
    StreamDefLft[].pipeOut

    // create a DATA rowBuffer
    BT_DATA tableDef[] Pds[].new

    // populate Pds
    Pds[].addBpaRegions
    Pds[].pipeOut

    PdsWarn[].rows 0 > if
      PdsWarn[].pipeOut
    else
      PdsWarn[].delete
    then

  else <bpaType> "objects" str.same if
    // Create a warnings Pds. We may not need it.
    C_TDEF_WARNINGS op__tableDef_warn assert
    BT_WARNINGS TableDefWarn[] PdsWarn[].new

    // find the C_TDEF_BPAOBJECTS table definition
    C_TDEF_BPAOBJECTS op__tableDef assert

    // create a streamDef and pipe it out
    TableDef[] StreamDefLft[].new
    StreamDefLft[].pipeOut

    // create Pds
    BT_DATA TableDef[] Pds[].new

    // populate Pds
    Pds[].addBpaObjects
    Pds[].pipeOut

    PdsWarn[].rows 0 > if
      PdsWarn[].pipeOut
    else
      PdsWarn[].delete
    then

  else <bpaType> "pool" str.same if
    // Create a warnings Pds. We may not need it.
    C_TDEF_WARNINGS op__tableDef_warn assert
    BT_WARNINGS TableDefWarn[] PdsWarn[].new

    // find the C_TDEF_BPAPOOL table definition
    C_TDEF_BPAPOOL op__tableDef assert

    // create a streamDef and pipe it out
    TableDef[] StreamDefLft[].new
    StreamDefLft[].pipeOut

    // create Pds
    BT_DATA TableDef[] Pds[].new

    // populate Pds
    Pds[].addBpaPool
    Pds[].pipeOut

    PdsWarn[].rows 0 > if
      PdsWarn[].pipeOut
    else
      PdsWarn[].delete
    then

  else
    <bpaType> EC_INVALID_PARAMETER attachmap::errorText@ "%v: %v" str.format EC_INVALID_PARAMETER op__execErrMsg
    true
    exit
  then then then

  Marker[].newEosMarker
  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* execute for bpa req                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : bpa_op \operator

  _lu_initialise_

  op__topology

  find: bpa_DataMarker EV_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: bpa :: bpa <bpaType> ;

: bpa_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "buffer pool analysis"
    <opEntry> = "bpa_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
