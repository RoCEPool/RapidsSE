/*============================================================================*/
/* OP_rowToList.sen -- Operator rowToList                                     */
/*============================================================================*/

" OP_rowToList.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: rowToList_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                    DEFINITION */
/*----------------------------------------------------------------------------*/
: rowToList_StreamDef \handler

  Pipein[] to StreamDef[]
  nullptr to PipeIn[]
  streamDef[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ROWBUFFER ...                                     ROWBUFFER */
/*----------------------------------------------------------------------------*/
: rowToList_RowBuffer \handler

  ZK_ROWBUFFER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                         EXIT */
/*----------------------------------------------------------------------------*/
: rowToList_ExitMarker \handler

  ZK_EXITMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for toCsv req                                                SPAWN */
/*----------------------------------------------------------------------------*/
 : rowToList_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: rowToList_ExitMarker  ZK_EXITMARKER  op[].handler!
  find: rowToList_RowBuffer   ZK_ROWBUFFER   op[].handler!
  find: rowToList_StartMarker ZK_STARTMARKER op[].handler!
  find: rowToList_StreamDef   ZK_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rowToList :: rowToList ;

: rowToList_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
