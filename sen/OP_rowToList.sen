/*============================================================================*/
/* OP_rowToList.sen -- Operator rowToList                                     */
/*============================================================================*/

" OP_rowToList.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                     CLEANING */
/*----------------------------------------------------------------------------*/
: rowToList_Cleaning \handler

  List[].print

  //List[].delete

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: rowToList_seapi

  "rowToList_seapi" .
  
  List[].new

  List[].addRowBuffer
  
  List[]
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: rowToList_StartMarker \handler

  List[].new

  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                    DEFINITION */
/*----------------------------------------------------------------------------*/
: rowToList_StreamDef \handler

  Pipein[] to StreamDefLft[]
  
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                     ROWBUFFER */
/*----------------------------------------------------------------------------*/
: rowToList_RowBuffer \handler

  Pipein[]\clear to RowBuffer[]

  RowBuffer[] List[].addRowBuffer

  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for toCsv req                                                SPAWN */
/*----------------------------------------------------------------------------*/
 : rowToList_op \operator

  _lu_initialise_

  op__topology

  find: rowToList_Cleaning    EV_M_CLEANING    [op].handler!
  find: rowToList_RowBuffer   EV_D_ROWBUFFER   [op].handler!
  find: rowToList_StartMarker EV_M_START       [op].handler!
  find: rowToList_StreamDef   EV_D_STREAMDEF   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rowToList :: rowToList ;

: rowToList_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "rowToList_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
