/*============================================================================*/
/* OP_rowToList.sen -- Operator rowToList                                     */
/*============================================================================*/

" OP_rowToList.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                    DEFINITION */
/*----------------------------------------------------------------------------*/
: rowToList_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  PipeIn[].delete

  streamDef[].newtoCsvStream
  streamDef[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ROWBUFFER ...                                     ROWBUFFER */
/*----------------------------------------------------------------------------*/
: rowToList_RowBuffer \handler

  // check for low memory
  attachMap::isLowMemory if
    EC_LOW_MEMORY
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeout
    true
    exit
  then

  PipeIn[] to Operand[]
  nullptr to PipeIn[]

  Operand[].rowToCsv
  Operand[] to Subset[]

  begin
    Operand[].isNull

  not while

    assert::stack_0

    // get the next buffer
    Subset[].nextBuffer to Subset[]

    // now pipeout the Operand
    Operand[].pipeOut

    // move Subset to Operand
    Subset[] to Operand[]

    assert::stack_0
  repeat

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for toCsv req                                                SPAWN */
/*----------------------------------------------------------------------------*/
 : rowToList_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: rowToList_RowBuffer  ZK_ROWBUFFER op[].handler!
  find: rowToList_StreamDef  ZK_STREAMDEF op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toCsv :: toCsv ;

: rowToList_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
