/*============================================================================*/
/* OP_rowToList.sen -- Operator rowToList                                     */
/*============================================================================*/

" OP_rowToList.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                     CLEANING */
/*----------------------------------------------------------------------------*/
: rowToList_Cleaning \handler

  List[].print

  //List[].delete

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: rowToList_seapi

  "rowToList_seapi" .
  
  List[].new

  List[].addRowBuffer
  
  List[]
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/


/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: rowToList_StartMarker \handler

  List[].new

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                    DEFINITION */
/*----------------------------------------------------------------------------*/
: rowToList_StreamDef \handler

  Pipein[] to StreamDefLft[]
  
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_ROWBUFFER ...                                     ROWBUFFER */
/*----------------------------------------------------------------------------*/
: rowToList_RowBuffer \handler

  Pipein[]\clear to RowBuffer[]

  RowBuffer[] List[].addRowBuffer

  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for toCsv req                                                SPAWN */
/*----------------------------------------------------------------------------*/
 : rowToList_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: rowToList_Cleaning    ZK_M_CLEANING    op[].handler!
  find: rowToList_RowBuffer   ZK_D_ROWBUFFER   op[].handler!
  find: rowToList_StartMarker ZK_M_START       op[].handler!
  find: rowToList_StreamDef   ZK_D_STREAMDEF   op[].handler!

  op__loop

  _op_release_resources_
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rowToList :: rowToList ;

: rowToList_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
