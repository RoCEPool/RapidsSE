/*============================================================================*/
/* OP_trace.sen -- Operator trace                                             */
/*============================================================================*/

" OP_trace.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                      */
/*----------------------------------------------------------------------------*/
: trace_RowBuffer \handler

  pipeIn[]\clear to RowBuffer[]

  Op.partition@ Op.stageName@ "%v.%v RowBuffer" .printf
  
  RowBuffer[].pipeout
  
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: trace_StreamDef \handler

  PipeIn[]\clear to StreamDefLft[]
  
  StreamDefLft[].print

  StreamDefLft[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for trace req                                                      */
/*----------------------------------------------------------------------------*/
 : trace_op \operator

  _lu_initialise_

  op__topology

  <what> "streamdef" str.same if
    find: trace_StreamDef  ZK_D_STREAMDEF op[].handler!
  then
   <what> "rowbuffer" str.same if
    find: trace_RowBuffer  ZK_D_ROWBUFFER op[].handler!
  then

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: trace :: trace <what> ;

: trace_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "trace_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
