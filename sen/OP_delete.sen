/*============================================================================*/
/* OP_delete.sen -- Operator delete                                           */
/*============================================================================*/

" OP_delete.sen" .verbose

/*----------------------------------------------------------------------------*/
/* position and begin delete                                                  */
/*----------------------------------------------------------------------------*/
: positionBeginDelete ( "iPhrase" "lowerKey" "upperKey" )

  params| upperKey lowerKey iPhrase |
  0 locals| sIndexNm |

  // find the index
  iPhrase PathIdentifier[].indexNm@ to sIndexNm
  <tableNm> sIndexNm op__index assert

  // grab the table ptn read lock
  TablePtn[].grabRead_yieldLoop

  // new an index stream
  Index[] TablePtn[] indexStream::new to indexStream[]

  // open index stream to access index
  indexStream[].open

  // position in the index
  iPhrase  // phrase
  lowerKey // lower
  upperKey // upper
  PathIdentifier[] indexStream[].seek
;

/*----------------------------------------------------------------------------*/
/* begin the delete                                                           */
/*----------------------------------------------------------------------------*/
: beginDelete ( iPhrase -- )

  params| iPhrase |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the fetch technique
  iPhrase PathIdentifier[].fetchTech@

  case

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an exact select using index
    AT_EXACT of
      "*exact*" .verbose

      iPhrase                  // phrase
      iPhrase PathIdentifier[].key@   // lower key
      iPhrase PathIdentifier[].key@   // upper key
      positionBeginDelete
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // lower bound select using index
    AT_LOWER of
      "*lower*" .verbose

      iPhrase                     // phrase
      iPhrase PathIdentifier[].lowKey@   // lower key
      ""                          // upper key
      positionBeginDelete
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // an upper bound select using index
    AT_UPPER of
      "*upper*" .verbose

      iPhrase                     // phrase
      ""                          // lower key
      iPhrase PathIdentifier[].upperKey@ // upper key
      positionBeginDelete
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // a range select using index
    AT_RANGE of
      "*range" .verbose

      iPhrase                     // phrase
      iPhrase PathIdentifier[].lowKey@   // lower key
      iPhrase PathIdentifier[].upperKey@ // upper key
      positionBeginDelete
    endof

    // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    // full scan (no index)
    AT_SCAN of
      "*scan*" .verbose
      // now get excat key rows from index
      TablePtn[].grabRead_yieldLoop
      TablePtn[] ptnStream::new to ptnStream[]

      // open ptn stream for the tablePtn
      ptnStream[] ptnStream.open assert
    endof

  endcase
;

/*----------------------------------------------------------------------------*/
/* generate plan for the fetch                                                */
/*----------------------------------------------------------------------------*/
: generatePlan ( -- )

  0 locals| sPredicate |

  //sWhere "generatePlan" "%v %v" str.format .

  ( cdt_0 ) PathIdentifier[].new
  ( cdt_1 ) Table[] PathIdentifier[].table!

  ( cdt_2 ) <predicate> PathIdentifier[].parseWhere  //"parseWheres" .

  ( cdt_3 ) PathIdentifier[].genPaths           //"genPaths" .
  ( cdt_4 ) PathIdentifier[].scorePaths         //"scorePaths" .
  //( cdt_5 ) PathIdentifier[].showPaths

  ( cdt_6 ) PathIdentifier[].matchPaths         //"matchPaths" .
  //( cdt_6 ) PathIdentifier[].showPaths

  ( cdt_7 ) PathIdentifier[].choosePaths        //"choosePaths" .
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: delete_Cleaning \handler

  //"ZK_M_CLEANING_handler" .verbose

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for delete_rows ...                                                */
/*----------------------------------------------------------------------------*/
: delete_rows \handler

  "Handler:- delete_rows" .verbose

  0 locals| bMoreToDelete |

  // get the fetchTechnique
  Counter1[] PathIdentifier[].fetchTech@
  case
    AT_SCAN of
     0 assert
    endof

    indexStream[].deleteNext to bMoreToDelete

  endcase

  // no more data for counter1[] phrase ?
  bMoreToDelete not if

    // any more phrases ?
    Counter1[] 1 + to Counter1[]
    Counter1[] Counter0[] >= if
      // all done
      // close and delete partition stream
      ptnStream[].isNull not if
        ptnStream[] ptnStream.close
        ptnStream[] ptnStream.delete
        nullptr to ptnStream[]
      then

      // close and delete index stream
      indexStream[].isNull not if
        indexStream[].close
        indexStream[].delete
        nullptr to indexStream[]
      then

      TablePtn[].dropRead

      // delete the path identifier
      PathIdentifier[].delete
      nullptr to PathIdentifier[]

      // pipeout an eosMarker
      Marker[].newEosMarker
      Marker[].pipeOut
    else
      // position and fetch first buffer for next phrase
      Counter1[] beginDelete
    then

  else

    // call this handler again to process next buffer
    true LogicUnit[].callAgain!

  then
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: delete_DataMarker \handler

  0 locals| iPhrases |

  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // new a stream def
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get no of phrases
  PathIdentifier[].phrases@ to Counter0[]

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // assert we have at least one phrase
  Counter0[] 1 >= assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // set counter1[] to 0
  0 to Counter1[]

  // position and begin delete for the first phrase
  Counter1[] beginDelete

  // force op loop to call fetch_CrwBuffer to start processing buffers
  "delete_rows" word::find LogicUnit[].handler!
  true LogicUnit[].callAgain!

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: delete_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  0 locals| iPhrases |

  PipeIn[].pipeOut

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // generate the plan for the fetch
  generatePlan

  //PathIdentifier[].showPaths

  // assert we have a plan
  PathIdentifier[].isNull not assert

  true
;

/*----------------------------------------------------------------------------*/
/* delete request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: delete_req \operator

  LogReqEntry SEED_REQ
  //<tableNm> <predicate> "PARAMETERS %v %v" str.format .

  op__topology

  find: delete_Cleaning      ZK_M_CLEANING      op[].handler!
  //find: delete_CrwBuffer   ZK_D_CRWBUFFER     op[].handler!
  find: delete_DataMarker    ZK_M_DATAPULSE     op[].handler!
  find: delete_StartMarker   ZK_M_START         op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: delete :: delete <tableNm> <predicate> ;

: delete_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
