/*============================================================================*/
/* OP_toLglPtnNst.sen -- Convert row buffer to have normalised strings        */
/*============================================================================*/

" OP_toLglPtnNst.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: toLglPtnNst_StartMarker \handler

  ToNstRow[].create

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toLglPtnNst_DataMarker \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: toLglPtnNst_RowBuffer \handler

  PipeIn[]\clear to RowBuffer[]
  RowBuffer[]\clear ToNstRow[].convert to RowBuffer[]

  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: toLglPtnNst_EosMarker \handler

  // delete ToNstRow
  ToNstRow[].delete

  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toNstRow request                                                     SPAWN */
/*----------------------------------------------------------------------------*/
: toLglPtnNst_op \operator

  _lu_initialise_

  op__topology

  find: toLglPtnNst_EosMarker   ZK_M_EOS   [op].handler!
  find: toLglPtnNst_DataMarker  ZK_M_DATAPULSE   [op].handler!
  find: toLglPtnNst_RowBuffer   ZK_D_ROWBUFFER   [op].handler!
  find: toLglPtnNst_StartMarker ZK_M_START [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toLglPtnNst :: toLglPtnNst ;

: toLglPtnNst_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "toLglPtnNst_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
