: PotRlu[].pipeoutCompletedPtns

  ptnmap::ptnsInGrid 0
  do
    begin
      I PotRlu[].completedPtn to DataBuffer[]
      DataBuffer[].isNotNull
    while
      DataBuffer[].pipeOut
    repeat
  loop
;

/*----------------------------------------------------------------------------*/
/* pipe out all dangling buffers in the pot                                   */
/*----------------------------------------------------------------------------*/
: PotRlu[].pipeoutDangling

  begin
    PotRlu[].dangling to DataBuffer[]
    DataBuffer[].isNotNull
  while
    DataBuffer[].pipeOut
  repeat
;

/*----------------------------------------------------------------------------*/
/* pipe out all dangling buffers in the pot for all partitions                */
/*----------------------------------------------------------------------------*/
: PotRlu[].pipeoutDanglingPtns

  ptnmap::ptnsInGrid 0
  do
    begin
      I PotRlu[].danglingPtn to DataBuffer[]
      DataBuffer[].isNotNull
    while
      DataBuffer[].pipeOut
    repeat
  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
