/*============================================================================*/
/* reg__common.sen -- register common words                                   */
/*============================================================================*/

" reg__common.sen" .verbose

/*----------------------------------------------------------------------------*/
/* pipe out all completed buffers in the pot                                  */
/*----------------------------------------------------------------------------*/
: Pot[].pipeoutAllCompleted

  begin
    Pot[].completed to OperandB[]
    OperandB[].isNotNull
  while
    OperandB[].pipeOut
  repeat
;

/*----------------------------------------------------------------------------*/
/* pipe out all completed buffers in the pot for all partitions               */
/*----------------------------------------------------------------------------*/
: Pot[].pipeoutAllCompletedPtns

  grid::partitions 0
  do
    begin
      I Pot[].completedPtn to OperandB[]
      OperandB[].isNotNull
    while
      OperandB[].pipeOut
    repeat
  loop
;

/*----------------------------------------------------------------------------*/
/* pipe out all dangling buffers in the pot                                   */
/*----------------------------------------------------------------------------*/
: Pot[].pipeoutAllDangling

  begin
    Pot[].dangling to OperandB[]
    OperandB[].isNotNull
  while
    OperandB[].pipeOut
  repeat
;

/*----------------------------------------------------------------------------*/
/* pipe out all dangling buffers in the pot for all partitions                */
/*----------------------------------------------------------------------------*/
: Pot[].pipeoutAllDanglingPtns

  grid::partitions 0
  do
    begin
      I Pot[].danglingPtn to OperandB[]
      OperandB[].isNotNull
    while
      OperandB[].pipeOut
    repeat
  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
