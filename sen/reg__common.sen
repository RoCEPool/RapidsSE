/*----------------------------------------------------------------------------*/
/* pipe out all completed buffers in the pot                                  */
/*----------------------------------------------------------------------------*/
: PotRlu[].pipeoutCompleted

  begin
    PotRlu[].completed to DataBuffer[]
    DataBuffer[].isNotNull
  while
    DataBuffer[].pipeOut
  repeat
;

