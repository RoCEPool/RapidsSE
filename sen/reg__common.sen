/* cleanup                                                                    */
/*----------------------------------------------------------------------------*/
: PotRlu[].cleanup

  PotRlu[].isNull not if

    ptnmap::ptnsInGrid 0
    do
      begin
        I PotRlu[].danglingPtn to DataBuffer[]
        DataBuffer[].isNotNull
      while
        DataBuffer[].delete
