/*============================================================================*/
/* reg__common.sen -- register common words                                   */
/*============================================================================*/

" reg__common.sen" .verbose

/*----------------------------------------------------------------------------*/
/* cleanup                                                                    */
/*----------------------------------------------------------------------------*/
: PotRlu[].cleanup

  PotRlu[].isNull not if

    ptnmap::partitions 0
    do
      begin
        I PotRlu[].danglingPtn to OperandB[]
        OperandB[].isNotNull
      while
        OperandB[].delete
      repeat
    loop

    PotRlu[].delete

  then

;

/*----------------------------------------------------------------------------*/
/* pipe out all completed buffers in the pot                                  */
/*----------------------------------------------------------------------------*/
: PotRlu[].pipeoutCompleted

  begin
    PotRlu[].completed to OperandB[]
    OperandB[].isNotNull
  while
    OperandB[].pipeOut
  repeat
;

/*----------------------------------------------------------------------------*/
/* pipe out all completed buffers in the pot for all partitions               */
/*----------------------------------------------------------------------------*/
: PotRlu[].pipeoutCompletedPtns

  ptnmap::partitions 0
  do
    begin
      I PotRlu[].completedPtn to OperandB[]
      OperandB[].isNotNull
    while
      OperandB[].pipeOut
    repeat
  loop
;

/*----------------------------------------------------------------------------*/
/* pipe out all dangling buffers in the pot                                   */
/*----------------------------------------------------------------------------*/
: PotRlu[].pipeoutDangling

  begin
    PotRlu[].dangling to OperandB[]
    OperandB[].isNotNull
  while
    OperandB[].pipeOut
  repeat
;

/*----------------------------------------------------------------------------*/
/* pipe out all dangling buffers in the pot for all partitions                */
/*----------------------------------------------------------------------------*/
: PotRlu[].pipeoutDanglingPtns

  ptnmap::partitions 0
  do
    begin
      I PotRlu[].danglingPtn to OperandB[]
      OperandB[].isNotNull
    while
      OperandB[].pipeOut
    repeat
  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
