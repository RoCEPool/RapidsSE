/*============================================================================*/
/* OP_recvWL.sen -- Operator recv for WL Adaptor                              */
/*============================================================================*/

" OP_recvWL.sen" .verbose

/*----------------------------------------------------------------------------*/
/* recv init                                                                  */
/*----------------------------------------------------------------------------*/
: recvWL_init ( -- )

  "<ansSocket>" [job].tagSet@ tagSet.hasName assert

  <ansSocket> >int >ptr to Socket[]
;

/*----------------------------------------------------------------------------*/
/* recv next object(s)                                                        */
/*----------------------------------------------------------------------------*/
: recvWL_recvNext

  Socket[].object.isNotNull not assert

  // The received object is saved in Socket[].object
  Socket[].recvWLMsg

  Socket[].success@ not if
    false
    exit
  then

  Socket[].object.isNotNull if
    Socket[].object@ payloadObj::size@ "RecvWL: Piping out payload received of %v bytes" .printf
    Socket[].object@\clear [op].pipeout
    Socket[].success@
  else
    // null object (low memory or socket closed)
    false
  then
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: recvWL_loop ( -- )

  begin

    trap::stackDepthZero

    // receive next object(s)
    recvWL_recvNext
    not if
      exit
    then

  again
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: recvWL_StartMarker \handler

  "recvWL_StartMarker - EV_M_START" .

  // initialise
  recvWL_init

  // Pass the start marker on to other operators
  PipeIn[]\clear [op].pipeout

  // loop, receiving and executing jobs
  recvWL_loop

  // If we get here then there was a problem receiving the next message from the client.
  Socket[].close
  Socket[].clientAddr@ "Connection closed to client at address %v" .printf

  "recvWL_StartMarker: piping out error marker" .
  ErrorMarker[].newErrorMarker
  ErrorMarker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: recvWL_CLEANING \handler

  "in recvWL_CLEANING" .

  Socket[].close
  Socket[].object.isNotNull if
    Socket[].object.delete
  then

  Socket[].delete

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* execute for receiver req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : recvWL_op \operator

  _lu_initialise_

  op__topology

  find: recvWL_StartMarker EV_M_START     [op].handler!
  find: recvWL_CLEANING    EV_M_CLEANING  [op].handler!

  // get the pipeline job of the operator
  // [op].job@ locals| pPipelineJob |

  // peek to see if any operand
  begin
    Pipein[].peek
  not while
    "receiver waiting for STARTMARKER..." .verbose
    2 thread::sleepMsec
  repeat

  assert::stack_0

  // pop operand from queue into PipeIn[]
  PipeIn[].peek assert
  PipeIn[].next

  // execute the operator's handler for the operand
  PipeIn[].kind [op].handler@ execute
  "recvWL_op after handler execute" .

  // TODO: Needed to handle cleaning event?
  //op__loop
  //"recvWL_op after op__loop" .

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: recvWL :: recvWL ;

: recvWL_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <dedicatedThd> = 1
    <opEntry> = "recvWL_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
