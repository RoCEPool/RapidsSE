/*============================================================================*/
/* OP_recvWL.sen -- Operator recv for WL Adaptor                              */
/*============================================================================*/

" OP_recvWL.sen" .verbose

/*----------------------------------------------------------------------------*/
/* recv init                                                                  */
/*----------------------------------------------------------------------------*/
: recvWL_init ( -- )

  "<ansSocket>" [job].tagSet@ tagSet.hasName assert

  <ansSocket> >int >ptr socket::copy to Socket[]
;

/*----------------------------------------------------------------------------*/
/* recv next object(s)                                                        */
/*----------------------------------------------------------------------------*/
: recvWL_recvNext

  0 locals| pPayload |

  Socket[].object.isNotNull not assert

  // The received object is saved in Socket[].object
  Socket[].recvWLMsg

  Socket[].success@ not if
    EC_NONE ErrorCode[].get == not if

      // We got an error message set. Let's serialise it and send it to
      // the client before we disconnect the socket.
      // Mark the payload as not-for-processing so the adaptorWL doesn't inspect it.

      ErrorStr[].get ErrorCode[].get recvWL[].serialiseError to pPayload
      pPayload if
        ErrorCode[].get ErrorCode::decodeError "RecvWL: sending ErrorResponse with error message: %v" str.format .traceWlp
        pPayload [op].pipeOut
      then
    then

    // Stop reading on the socket.
    false
    exit
  then

  Socket[].object.isNotNull if
    TC_WLP trace.getComponent if
      Socket[].object@ payloadObj::creationTime@
      Socket[].object@ payloadObj::size@
      "RecvWL: Piping out payload received of %v bytes at time %v"
      str.format .traceWlp
    then

    Socket[].object@\clear [op].pipeout
    Socket[].success@
  else
    // null object (low memory or socket closed)
    false
  then
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: recvWL_loop ( -- )

  begin

    trap::stackDepthZero

    // receive next object(s)
    recvWL_recvNext
    not if
      exit
    then

  again
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: recvWL_StartMarker \handler

  "recvWL_StartMarker - EV_M_START" .verbose

  // initialise
  recvWL_init

  // Pass the start marker on to other operators
  PipeIn[]\clear [op].pipeout

  // loop, receiving and executing jobs
  recvWL_loop

  // If we get here then there was a problem receiving the next message from the client.
  "recvWL_StartMarker: piping out error marker EC_WL_SOCKET_CLOSED" .traceWlp
  EC_WL_SOCKET_CLOSED op__execErr

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: recvWL_CLEANING \handler

  "in recvWL_CLEANING" .verbose

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* execute for receiver req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : recvWL_op \operator

  _lu_initialise_

  op__topology

  find: recvWL_StartMarker EV_M_START     [op].handler!
  find: recvWL_CLEANING    EV_M_CLEANING  [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: recvWL :: recvWL ;

: recvWL_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <dedicatedThd> = 1
    <opEntry> = "recvWL_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
