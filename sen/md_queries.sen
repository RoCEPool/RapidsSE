/*============================================================================*/
/* md_queries.sen -- Define md__queries table                                   */
/*============================================================================*/

" md_queries.sen" .verbose

: start::md_queries

  // C_TDEF_QUERIES

  STD_BOOTFORK_TAG
  "
  define table md_queries (
    iQueryId          INTEGER NOT NULL ,
    tiTimestamp       TIMESTAMP NOT NULL ,
    szSqlText         VARCHAR NOT NULL ,
    szSubmitTimeStamp TIMESTAMP NOT NULL ,
    szStatus          VARCHAR NOT NULL
  ) < metaData > = MetaDataTable[].queries ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
