/*============================================================================*/
/* job_pipeline.sen -- Distributed Pipeline Job                               */
/*============================================================================*/

" job_pipeline.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            ON ORIGINATING NODE                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run a distributed pipeline from this originator                            */
/*----------------------------------------------------------------------------*/
: pipeline:origin ( -- <R> )

  //"pipeline:origin" .
    
  0 0 locals| pJob_Execute pJob_End |
  
  [job].assertCorrectness
  [job].assertNeutral

  [job].tscBeginning
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pre-check
  
  "<preCheck>" [job].tagSet@ tagSet.hasName if
    // tag exists..
    
    <preCheck> find execute not if
      // - preCheck word does not exist
      
      [job].error!
      
      [ddlLock].testDrop
      ListedJob[].assertNoRef

      [job].addRetired
      
      JS_SIGNALLED [job].state!
        [session].signal

      [task].grabLock
        TR_RETIRE_THIS_TASK [task].transition!
      
      HAZARD

    then
  then

  //5678901234567890123456789012345678901234567890123456789012345678901234567890
  //     1         2         3         4         5         6         7         8
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //                  passed pre-check / become an originator                 //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  // add this job to originator job list
  [job].addOriginator
  [job].assertOriginator

  "<show_command>" sysargs::tagSet@ tagSet.hasName
  if
    //<cmd> "pipeline:origin: %v\n" .printf
    <cmd> .
    //jobs::seeRlist

    //[system].bpa
  then


  //5678901234567890123456789012345678901234567890123456789012345678901234567890
  //     1         2         3         4         5         6         7         8
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //                     is originator / compile statement                    //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile pipeline statement on origin to check its syntax
    
  Dynamo[].new

  <cmd> Dynamo[].compile to ErrorCode[]
  
  ErrorCode[] EC_NONE == if
    // + clean compile
    to PipelineSpec[]
  else
    // - didnt compile
    ErrorCode[] [job].error!
    [ddlLock].testDrop
  then
  
  Dynamo[].delete


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test if distributed job may execute
  
  [job].error@ not if
    [job].preExecuteTest to ErrorCode[]
    ErrorCode[] if
      ErrorCode[] [job].error!
      [ddlLock].testDrop
    then
  then
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test if optimising
  
  [job].error@ not if
        
    "<optimise>" [job].tagSet@ tagSet.hasName
    PipelineSpec[].optimisable
    and
    if
      "Would Optimise" .
      <cmd> .
    then

    
    Optimiser[].new
    
//    PipelineSpec[] Optimiser[].dissect
//    Optimiser[].optimise
//    Optimiser[].weave discard

    Optimiser[].delete
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up
  
  PipelineSpec[] if
    PipelineSpec[].delete
  then
  
  Dynamo[]       not assert
  Optimiser[]    not assert
  PipelineSpec[] not assert


  //5678901234567890123456789012345678901234567890123456789012345678901234567890
  //     1         2         3         4         5         6         7         8
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //             pipeline is beginning / distribute begin                     //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  // distribute begin

  [job].error@ not if
    // + compiled without error..
    
    "pipeline:begin" [job].entryPoint!
    
    [task].grabLock
      [job] job:distribute
    [task].wait

    [job].tscBegun
  then
 
  //5678901234567890123456789012345678901234567890123456789012345678901234567890
  //     1         2         3         4         5         6         7         8
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //                pipeline has begun / distribute execute                   //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  
  // distribute execute
  
  [job].error@ not if

    // "SUBPIPLINE: distribute execute" .

    [job].tscExecuting

    [job] job_Execute::new to pJob_Execute

    [task].grabLock
      pJob_Execute job:distribute
    [task].wait

    [job].tscExecuted

    pJob_Execute job.delete
  then
  
  
  //5678901234567890123456789012345678901234567890123456789012345678901234567890
  //     1         2         3         4         5         6         7         8
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //             pipeline has executed / distribute end                       //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  // distribute end

  [job].error@ not if

    // "SUBPIPLINE: distribute end" .
    
    [job].tscEnding
    
    [job] job_End::new to pJob_End

    [task].grabLock
      pJob_End job:distribute
    [task].wait

    [job].tscEnded

    pJob_End job.delete
  then


  //5678901234567890123456789012345678901234567890123456789012345678901234567890
  //     1         2         3         4         5         6         7         8
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //                pipeline has ended / originator exits                     //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  [job].removeOriginator

  [session].hasCascade@ not
  if
      
    [ddlLock].testDrop
    ListedJob[].assertNoRef

    [job].addRetired
    
    JS_SIGNALLED [job].state!
      [session].signal
      
    [task].grabLock
      TR_RETIRE_THIS_TASK [task].transition!
      
    HAZARD

  else
      
    [ddlLock].testDrop
    JS_SIGNALLED [job].state!
    [session].signal
 
    [task].grabLock
      TR_DELETE_THIS_TASK [task].transition!
  
    HAZARD
    
  then

  HAZARD
;


////////////////////////////////////////////////////////////////////////////////
/*                          ON ALL PARTICIPANTS                               */
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* begin pipeline job on participant node                                     */
/*----------------------------------------------------------------------------*/
: pipeline:begin ( -- )

  // "pipeline:begin" .

  [job].progressReset
  
  [job].assertCorrectness

  ListedJob[].assertNoRef
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is beginning
  
  JP_BEGINNING [job].phase!
  //"pipeline:begin post [job]..phase!" [job].progress

  <path> str.toStrVec Path[].set

  // set participant node of job
  [grid].thisNodeNo@ [job].participantNodeNo!


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile pipeline statement into spec (should not expect an error)

  Dynamo[].new

  //"pipeline:begin pre dynamo" [job].progress
  <cmd> Dynamo[].compile
    EC_NONE == assert
    to PipelineSpec[]
  //"pipeline:begin post Dynamo[].compile" [job].progress

  Dynamo[].delete
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create pipeline from spec and spawn tasks for ops
  
  PipelineSpec[] subPipeline[].create
  SubPipeline[].spawnOpTasks
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job has begun on this node
  
  JP_BEGUN [job].phase!

  // what to execute next
  "pipeline:execute" [job].entryPoint!

  // add job to participant list
  [job].tscParticipant
  [job].addParticipant
  [job].assertParticipant
  [job].assertCorrectness
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reply begun to originator

  [job] begun:reply
  //"pipeline:begin post begun:reply" [job].progress

  [ddlLock].testDrop


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // task hibernates (with job in participant list)
  
  [task].grabLock
        
    TR_HIBERNATE_THIS_TASK [task].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute pipeline job on participant node                                   */
/*----------------------------------------------------------------------------*/
: pipeline:execute ( -- )

  // "pipeline:execute" .
  
  0 locals| nAcks |
  
  [job].assertCorrectness
  [job].assertParticipant


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is executing
  
  JP_EXECUTING [job].phase!

  // set task's dictionary stack from path in job
  <path> str.toStrVec Path[].set
  //[task].dump

  // acquire ddl lock
  job::acquireDdlLock
  
  [job].assertCorrectness


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // run optional <pre_execute> word

  "<pre_execute>" [job].tagSet@ tagSet.hasName if
    "<pre_execute>"
    [job].tagSet@ tagSet.getStr locals| sPreExe |
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
      process::quit
    then
      execute
  else
    [args].verbose if
      <pipelineNm> "No pre execute word for pipeline: %v" .printf
    then
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // ???? enqueue start-marker to start op to execute the pipeline job
  
  [task].grabLock

    SubPipeline[].opsOnNode@ to nAcks

    nAcks if
      nAcks [task].acksRemaining!
    
      SubPipeline[].startPipeline? if
    
        Marker[].newStartMarker
        Marker[]\clear SubPipeline[].op0@ op.enqueOperand
      then
      [task].wait
    else
      [task].dropLock
    then

  
    

  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job has executed
  
  JP_EXECUTED [job].phase!
  
  // what to execute next
  "pipeline:end" [job].entryPoint!

  [ddlLock].testDrop
  ListedJob[].assertNoRef
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reply executed to originator
  
  [job] executed:reply
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // task hibernates (with job in participant list)

  [task].grabLock
      
    TR_HIBERNATE_THIS_TASK [task].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* end pipeline job on participant node                                       */
/*----------------------------------------------------------------------------*/
: pipeline:end ( -- )

  // "pipeline:end" .

  [job].assertCorrectness
  [job].assertParticipant

  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is ending

  JP_ENDING [job].phase!

  [ddlLock].testDrop
 
 
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job has ended
  
  JP_ENDED [job].phase!
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove job from plist
  
  [job].removeParticipant

  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reply ended to originator
  
  [job] ended:reply

  JS_DELETABLE [job].state!
  [job].addRetired

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // task retires (with job in retired list)

  [task].grabLock
    [job] [exitDemon]:queueJob
    TR_RETIRE_THIS_TASK [task].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* cancel pipeline job on participant node                                    */
/*----------------------------------------------------------------------------*/
: pipeline:cancel ( -- )

  // "pipeline:cancel" .
  
  [job].assertCorrectness
  [job].assertParticipant

    // [ senCompiler::current@ word.name@ encode::push ] .

  JP_CANCELING [job].phase!

  JP_CANCELED [job].phase!


  [job].removeParticipant

  [job] cancelled:reply

  JS_DELETABLE [job].state!

  [job].addRetired
  [task].grabLock
    [job] [exitDemon]:queueJob
    TR_RETIRE_THIS_TASK [task].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipeline :: pipeline <pipelineNm> etc ;

: pipeline_cmdTags _cmdTags tagCopy: pipelineJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <ddlLock>  = DL_GRAB_READ
    <preCheck> = bClusterStarted
      
    <entryPoint>  = "pipeline:origin"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
