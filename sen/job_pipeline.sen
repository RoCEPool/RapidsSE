/*============================================================================*/
/* job_pipeline.sen -- Distributed Pipeline Job                               */
/*============================================================================*/

" job_pipeline.sen" .verbose


/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
/*                               ON ORIGIN                                    */
/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/


/*----------------------------------------------------------------------------*/
/* launch a distributed pipeline on originating node                          */
/*----------------------------------------------------------------------------*/
: pipeline::origin ( -- <R> )

  //"pipeline::origin" .
  
  Task[].job@ Job[] equal assert
  
  Job[].assertCorrectness

  job[].tscBeginning
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pre-check
  
  "<preCheck>" Job[].tagSet@ tagSet.hasName if
    // tag exists..
    
    <preCheck> find execute not if
      // - preCheck word does not exist
      
      Job[].error!
      
      DdlLock[].testDrop
      JobRef[].assertNone

      Job[].addRetired
      
      JS_SIGNALLED Job[].state!
        Session[].signal

      Task[].grabLock
        TR_RETIRE_THIS_TASK Task[].transition!
      
      HAZARD

    then
  then


  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //                           become an originator                           //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  // add this job to originator job list
  Job[].addOriginator

  "<show_command>" sysargs::tagSet@ tagSet.hasName
  if
    //<cmd> "pipeline::origin: %v\n" .printf
    <cmd> .
    //jobs::seeRlist

    //system::bpa
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile pipeline statement on origin to check its syntax
    
  Dynamo[].new

  <cmd> Dynamo[].compile to ErrorCode[]
  
  ErrorCode[] EC_NONE == if
    // + clean compile
    to PipelineSpec[]
  else
    // - didnt compile
    ErrorCode[] Job[].error!
    DdlLock[].testDrop
  then
  
  Dynamo[].delete


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test if distributed job may execute
  
  Job[].error@ not if
    Job[].preExecuteTest to ErrorCode[]
    ErrorCode[] if
      ErrorCode[] Job[].error!
      DdlLock[].testDrop
    then
  then
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // test if optimising
  
  Job[].error@ not if
    Job[].tagSet@ to TagSet[]
    
    
    "<optimise>" TagSet[] tagSet.hasName
    PipelineSpec[].optimisable
    and
    if
      "Would Optimise" .
      <cmd> .
    then

    
    Optimiser[].new
    
//    PipelineSpec[] Optimiser[].dissect
//    Optimiser[].optimise
//    Optimiser[].weave discard

    Optimiser[].delete
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // tidy up
  
  PipelineSpec[] if
    PipelineSpec[].delete
  then
  
  Dynamo[]       not assert
  Optimiser[]    not assert
  PipelineSpec[] not assert


  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //           distribute participants of this job and execute them           //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  Job[].error@ not if
    // + compiled without error..
    
    Task[].grabLock
    
    // set the no of acks expected by originator job
    //   to be the number of defined nodes in the grid
    grid::knownNodes Job[] job.acksRemaining!

    // set acks for originator task
    1 Task[].acksRemaining!

    "pipeline::participant" Job[].entry!
    job::distributeParticipants
    
    Task[].wait
  then


  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//
  //                      we're back as the originator                        //
  // + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +//

  Job[].removeOriginator
  
  session::hasCascade@ not
  if
      
    DdlLock[].testDrop
    JobRef[].assertNone

    Job[].addRetired
    
    JS_SIGNALLED Job[].state!
      Session[].signal
      
    Task[].grabLock
      TR_RETIRE_THIS_TASK Task[].transition!
      
    HAZARD

  else
      
    DdlLock[].testDrop
    JS_SIGNALLED Job[].state!
    Session[].signal
 
    Task[].grabLock
      TR_DELETE_THIS_TASK Task[].transition!
  
    HAZARD
    
  then

  HAZARD
;


/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
/*                          ON ALL PARTICIPANTS                               */
/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

/*----------------------------------------------------------------------------*/
/* begin pipeline job on participant node                                     */
/*----------------------------------------------------------------------------*/
: pipeline::participant ( -- )

  // "pipeline::participant" .

  job[].progressReset
  
  JobRef[].assertNone
  
  Task[].job@ Job[] equal assert


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is beginning
  
  JP_BEGINNING Job[].phase!
  //"pipeline::participant post Job[]..phase!" job[].progress

  <path> str.toStrVec Path[].set

  // set participant node of job
  grid::thisNode@ Job[].participantNode!


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline statement on participants (should not expect an error)

  Dynamo[].new

  //"pipeline::participant pre dynamo" job[].progress
  <cmd> Dynamo[].compile
    EC_NONE == assert
    to PipelineSpec[]
  //"pipeline::participant post Dynamo[].compile" job[].progress

  Dynamo[].delete
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin this pipeline job (spawning jobs for ops etc)
  
  PipelineSpec[] Pipeline[].create
  //"pipeline::participant post Pipeline[].create" job[].progress
  
  Pipeline[].spawnOpTasks
  //"pipeline::participant post Pipeline[].spawnOpTasks" job[].progress


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this pipeline job has begun on this node
  
  JP_BEGUN Job[].phase!

  // what to execute next
  "pipeline::execute" Job[].entry!

  // add job to participant job list
  job[].tscParticipant
  Job[].addParticipant
  Job[].assertCorrectness
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reply to originator

  Job[] begun::replyToOrigin
  //"pipeline::participant post begun::replyToOrigin" job[].progress

  DdlLock[].testDrop


  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete current task (but not this job)
  
  Task[].grabLock
    
    // about to delete task (but not this job) so unlink task and job
    nullptr Job[].task!
    nullptr Task[].job!
    
    TR_DELETE_THIS_TASK Task[].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute pipeline job on participant node                                   */
/*----------------------------------------------------------------------------*/
: pipeline::execute ( -- )

  // "pipeline::execute" .
  
  Task[].job@ Job[] equal assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is executing
  
  JP_EXECUTING Job[].phase!

  // set task's dictionary stack from path in job
  <path> str.toStrVec Path[].set
  //task::dump

  // acquire ddl lock
  job::acquireDdlLock
  
  Job[].assertCorrectness


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // run optional <pre_execute> word

  "<pre_execute>" Job[].tagSet@ tagSet.hasName if
    "<pre_execute>"
    Job[].tagSet@ tagSet.getStr locals| sPreExe |
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
      process::quit
    then
      execute
  else
    args.verbose if
      <pipelineNm> "No pre execute word for pipeline: %v" .printf
    then
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // enqueue start-marker to start op to execute the pipeline job
  
  Task[].grabLock
  
  //<pipelineNm> "%v execute" .printf
  Pipeline::enqueueStart not if
    //<pipelineNm> grid::thisNodeName@ "(%v) nothing to do" .printf
    Task[].dropLock
  else

    // wait for all operators to ack this job
    Task[].wait

  then
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job has executed
  
  JP_EXECUTED Job[].phase!
  
  // what to execute next
  "pipeline::end" Job[].entry!

  DdlLock[].testDrop
  JobRef[].assertNone
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reply to originator
  Job[] executed::replyToOrigin
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete current task (but not this job)
  
  Task[].grabLock
  
    // about to delete task (but not this job) so unlink task and job
    nullptr Job[].task!
    nullptr Task[].job!
  
    TR_DELETE_THIS_TASK Task[].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* end pipeline job on participant node                                       */
/*----------------------------------------------------------------------------*/
: pipeline::end ( -- )

  // "pipeline::end" .

  Task[].job@ Job[] equal assert

  Job[].assertCorrectness
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job is ending

  JP_ENDING Job[].phase!

  DdlLock[].testDrop
 
 
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // this job has ended
  
  JP_ENDED Job[].phase!
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // remove job from plist
  
  Job[].removeParticipant
  
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // reply to originator
  
  Job[] ended::replyToOrigin

  
  // - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete current task (but not this job)

  JS_DELETABLE Job[].state!
  Job[].addRetired

  Task[].grabLock
    Job[] job.queueExitDemon
    TR_RETIRE_THIS_TASK Task[].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* cancel pipeline job on participant node                                    */
/*----------------------------------------------------------------------------*/
: pipeline::cancel ( -- )

  // "pipeline::cancel" .
  
  Task[].job@ Job[] equal assert

  Job[].assertCorrectness
  
    // [ senCompiler::current@ word.name@ encode::push ] .

  JP_CANCELING Job[].phase!

  JP_CANCELED Job[].phase!


  Job[].removeParticipant
    
  Job[] cancelled::replyToOrigin

  JS_DELETABLE Job[].state!

  Job[].addRetired
  Task[].grabLock
    Job[] job.queueExitDemon
    TR_RETIRE_THIS_TASK Task[].transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipeline :: pipeline <pipelineNm> etc ;

: pipeline_cmdTags _cmdTags tagCopy: pipelineJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <ddlLock>  = DL_GRAB_READ
    <preCheck> = bClusterStarted
      
    <entryPoint>    = "pipeline::origin"


  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
