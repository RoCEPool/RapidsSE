/*============================================================================*/
/* OP_analyzeIndex.sen -- Operator analyze index                              */
/*============================================================================*/

" OP_analyzeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: anidx_action

  <tableNm> <indexNm> op__table_index not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an infoSet operand
  streamSetTable[] StreamSet[].new

  // add a row for each table ptn
  grid::ptnsPerNode 0
  do
    // insert index verify
    I Index[] streamSetTable[] StreamSet[].addAnalyzeIndex  not if
    StreamSet[].pipeOut
      streamSetTable[] streamSet[].new
      I Index[] streamSetTable[] StreamSet[].addAnalyzeIndex assert
    then

  loop

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/

//         opNm
//         cmdNm    cmd / procNm arg       arg
cmdSyntax: anidx :: anidx        <tableNm> <indexNm> ; // proc anidx      
cmdSyntax: anidx :: analizeIndex <tableNm> <indexNm> ; // proc analizeIndex
//           ^       ^^
//           |       ||  [synth proc needs to be this]
//  +========+-------++
//  |
//  v
: anidx_cmdTags _cmdTags tagCopy: liteOp_tags  // +==> synth: procedure andix [currently]
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __analyzeIndex
    <params>    = 2
    <opEntry> = "anidx_op"  <seedReq> = "anidx_req"
  }

  // [ senCompiler::current@ word.TagSet@ tagSet.asStr . ]
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
