/*============================================================================*/
/* se_dbg.sen -- dbg> related words                                           */
/*============================================================================*/

" se_dbg.sen" .verbose


: article_dump \prompt article::dump ;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Task_Interpret_line
  
  // -- -- -- -- -- -- --
  // get next input token
  input::read

  // -- -- -- -- -- -- --
  // test for end of input?
  input::kind@ TN_NULL == if
    //"!!NONE!!" .put
    true exit_rt
  then

  // -- -- -- -- -- -- --
  // is token an integer?
  input::kind@ TN_INTEGER == if

    input::chars >int        // convert str to int, leave on stack

    compiler::isPostponing if
      "SHOULD NOT BE POSTPONING AN INT" .put
      process::quit
      reenter
    then

    compiler::isCompiling if
      encode::push           // compile encodes push intval
      reenter
    then

    reenter                  // interpret leaves int on stack

  then

  // -- -- -- -- -- -- --
  // is token a string?
  input::kind@ TN_STRING == if

    input::chars             // put str on stack

    compiler::isPostponing if
      "SHOULD NOT BE POSTPONING A STR" .put
      process::quit
      reenter
    then

    compiler::isCompiling if
      encode::push           // compile encodes push stzVal
      reenter
    then

    reenter                  // interpret leaves str on stack

  then

  // -- -- -- -- -- -- --
  // token should be a name
  input::kind@ TN_NAME != if
    "strange token" .put input::kind@ .put
    reenter
  then

  // -- -- -- -- -- -- --
  // test for bye
  input::chars "bye" str.same if
    false exit_rt
  then

  // -- -- -- -- -- -- --
  // is token a known word?
  input::chars word::find
  dup not if
    discard                     // token is an unknown word
    input::unknown
    reenter
  then

  // -- -- -- -- -- -- --
  // pWord now on d-stack

  // -- -- -- -- -- -- --
  // is an immediate word?
  dup word.isImmediate if
   execute                   // execute the immediate word
   reenter
  then

  // -- -- -- -- -- -- --
  // postponing mode?
  compiler::isPostponing if
    "POSTPONING" .put
    encode::push
    "encode::call" word::find encode::call
    reenter
  then

  // -- -- -- -- -- -- --
  // compiling mode?
  compiler::isCompiling if
    encode::call                 // encode::call encodes call to word
    reenter
  then

  // -- -- -- -- -- -- --
  // we are interpreting
  execute                    // execute word

  reenter                    // loop over
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Task_Interpreter
  
  //debug::breakpoint

  input::push
  input::stdin
  input::useBegin

  begin
    "SE Task> " .put

  Task_Interpret_line while repeat

  //debug::breakpoint

  input::useEnd
  input::pop
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: dbg>

  "path::" .put .\n

  "symbols" find execute

  stk
  rstk

  input::push
  input::stdin
  input::senTokens
  input::useBegin

  begin
    "dbg> " .put

  Task_Interpret_line while repeat

  //debug::breakpoint

  input::useEnd
  input::pop
;

: forth \prompt

  task_interpreter
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
