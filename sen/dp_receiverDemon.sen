/*============================================================================*/
/* dp_receiverDemon.sen -- Receiver Demon                                     */
/*============================================================================*/

" dp_receiverDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* pipeline/procedure text for receiver demon                                 */
/*----------------------------------------------------------------------------*/
procText:
  pipelineLocal recvDemonPipeline
    tag "<pre_execute>" = "demon::install" endTag
  begin

    stage stageA on origin :
        start
      | recv
      | eatAll
      | stageA

  end
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
