/*============================================================================*/
/* OP_sysClose.sen -- close the system                                        */
/*============================================================================*/

" OP_sysClose.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: sysClose_sysClose \handler

  false system::open!

  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* sysClose request                                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sysClose_op \operator

  _lu_initialise_

  op__topology

  find: sysClose_sysClose  ZK_M_DATAPULSE  op[].handler!

  op__loop

  // "*** sysClose_req EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sysClose :: sysClose ;

: sysClose_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "sysClose_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
