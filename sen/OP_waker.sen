/*============================================================================*/
/* OP_waker.sen -- Operator waker                                             */
/*============================================================================*/

" OP_waker.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: waker::activity

  Schedule::checkSleeping
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: waker_StartMarker \handler

  "Waker Demon Started" .boot

  begin

    waker::activity

    10 thread::sleepMsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/* execute for waker req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : waker_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: waker_StartMarker ZK_M_START op[].handler!

  op__loop

  LogReqExit
  _op_retires_
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: waker :: waker ;

: waker_cmdTags _cmdTags tagCopy: serviceOp_tags

  tags{ <dedicatedThd> = 1 }

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
