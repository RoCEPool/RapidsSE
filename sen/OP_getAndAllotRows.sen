/*============================================================================*/
/* OP_getAndAllotRows.sen -- get rows from rowbuffer and pipeout                      */
/*============================================================================*/

" OP_getAndAllotRows.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                               EOS */
/*----------------------------------------------------------------------------*/
: getAndAllotRows_Eos \handler

  Counter0[] "rowBuffers : %v" .printf
  Pipein[].pipeout
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_ROWBUFFER ...                                   ROWBUFFER */
/*----------------------------------------------------------------------------*/
: getAndAllotRows_RowBuffer \handler

  //"Operand:- ZK_D_ROWBUFFER" .verbose

  Pipein[]\clear to rowBuffer[]
  rowBuffer[].getAndAllotRows  to DataBuffer[]

  rowBuffer[].delete

  DataBuffer[].pipeout

  Counter0[] 1 + to Counter0[]

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for getAndAllotRows req                                      SPAWN */
/*----------------------------------------------------------------------------*/
 : getAndAllotRows_op \operator

  _lu_initialise_

  0 to Counter0[]

  op__topology

  find: getAndAllotRows_RowBuffer  ZK_D_ROWBUFFER op[].handler!
  find: getAndAllotRows_Eos        ZK_M_EOS op[].handler!
 
  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: getAndAllotRows :: getAndAllotRows ;

: getAndAllotRows_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "getAndAllotRows_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
