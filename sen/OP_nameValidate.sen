/*============================================================================*/
/* OP_nameValidate.sen -- Name Validate Op (SQL Compiler)                     */
/*============================================================================*/

" OP_nameValidate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: nameValidate_CancelMarker \handler

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: nameValidate_DataMarker \handler
 
  ZK_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: nameValidate_EosMarker \handler
 
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_OTHEROPERAND ...                                            */
/*----------------------------------------------------------------------------*/
: nameValidate_OtherOperand \handler
 
  ZK_OTHEROPERAND_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PLANNODE ...                                                */
/*----------------------------------------------------------------------------*/
: nameValidate_PlanNode \handler
 
  sqlCompiler::nameValidate

  ZK_PLANNODE_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: nameValidate_StartMarker \handler

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: nameValidate_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: nameValidate_CancelMarker ZK_CANCELMARKER op[].handler!
  find: nameValidate_DataMarker   ZK_DATAPULSE    op[].handler!
  find: nameValidate_EosMarker    ZK_EOSMARKER    op[].handler!
  find: nameValidate_OtherOperand ZK_OTHEROPERAND op[].handler!
  find: nameValidate_PlanNode     ZK_PLANNODE     op[].handler!
  find: nameValidate_StartMarker  ZK_STARTMARKER  op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: nameValidate :: nameValidate ;

: nameValidate_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
