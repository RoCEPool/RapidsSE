/*============================================================================*/
/* OP_nameValidate.sen -- Name Validate Op (SQL Compiler)                     */
/*============================================================================*/

" OP_nameValidate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: nameValidate_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: nameValidate_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCmdErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::nameValidate to PlanOperand[]

  "nameValidate" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: nameValidate_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker  EV_M_LEAVE       [op].handler!
  find: compiler_StreamSet    EV_D_STREAMSET   [op].handler!

  // specific handlers
  find: nameValidate_Cleaning      EV_M_CLEANING      [op].handler!
  find: nameValidate_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: nameValidate :: nameValidate ;

: nameValidate_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "nameValidate_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
