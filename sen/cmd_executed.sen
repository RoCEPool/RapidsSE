/*============================================================================*/
/* cmd_executed.sen -- 1sc: given pipeline has executed on participant        */
/*============================================================================*/

" cmd_executed.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                    ON ORIGINATING NODE OF GIVEN PIPELINE                   //
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/
: executed:onOrigin
  //"executed:onOrigin" .

/* <exd org */  [args].distJob if
/* <exd org */    "executed" "onOrigin" "<exd ack origin task" "r" [job].trace
/* <exd org */  then
/* <exd org */
/* <exd org */
/* <exd org */  // find the originating job
/* <exd org */
/* <exd org */  [job].originId@ ListedJob[].findOriginator? if
/* <exd org */
/* <exd org */    ListedJob[].taskAck
/* <exd org */
/* <exd org */    ListedJob[].returnReference
/* <exd org */
/* <exd org */  then
/* <exd org */
/* <exd org */  [job]:retireAndExit
/* <exd org */  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: executed:executed
  //"executed:executed" .

/* <exd ptp */  [args].distJob if
/* <exd ptp */    "executed" "executed" "<exd snd origin" "r" [job].trace
/* <exd ptp */  then
/* <exd ptp */
/* <exd ptp */  "executed:onOrigin" [job].entryPoint!
/* <exd ptp */
/* <exd ptp */  [job].originNodeId@ [grid].findNodeByNo to SendNode[]
/* <exd ptp */
/* <exd ptp */  [job] job(Id).send
/* <exd ptp */
/* <exd ptp */  nullptr to SendNode[]
/* <exd ptp */
/* <exd ptp */  [job]:retireAndExit
/* <exd ptp */  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: executed :: executed ;

: executed_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "executed:executed"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
