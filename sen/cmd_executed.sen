/*============================================================================*/
/* cmd_executed.sen -- 1sc: given pipeline has executed on participant        */
/*============================================================================*/

" cmd_executed.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                    ON ORIGINATING NODE OF GIVEN PIPELINE                   //
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/
: executed:onOrigin

  //"executed:onOrigin" .

  // find the originating job
  
  [job].distId@ ListedJob[].findOriginator? if
  
    ListedJob[].taskAck
  
    ListedJob[].returnReference
  
  then
  
  [job]:retire
  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: executed:executed

  //"executed:executed" .

  "executed:onOrigin" [job].entryPoint!

  [job].parentOriginNodeId@ [grid].findNodeByNo to SendNode[]
  
  [job] job(Id).send

  nullptr to SendNode[]
  
  [job]:retire
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: executed :: executed ;

: executed_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "executed:executed"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
