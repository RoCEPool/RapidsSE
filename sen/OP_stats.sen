/*============================================================================*/
/* OP_stats.sen -- Operator stats                                             */
/*============================================================================*/

" OP_stats.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                             */
/*----------------------------------------------------------------------------*/
: stats_StartMarker \handler

  PipeIn[].pipeOut

  "+++ +++ +++" .

//  C_TDEF_LOCKSTATS word::find if
//    C_TDEF_LOCKSTATS Path[].pushNamedTableFolder
//    Path[].toStr .
//    C_TDEF_LOCKSTATS find execute to Table[]
//    StreamDefLft[].new
//    StreamDefLft[].asStr .
//    nullptr to Operand[]
//  then
/*
  // find the __lockStats table
  C_TDEF_LOCKSTATS op__tableDef_infoSet assert

  // create a new streamDef
  infoSetTable[] StreamDefLft[].new

  //StreamDefLft[].asStr .
  Expressions::lockSample to operandC[]
  OperandC[].pipeOut
*/

  // find the __lockStats table
  C_TDEF_LOCKSTATS op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] InfoSet[].new

  // add lock  to the infoSet
  infoSetTable[] InfoSet[].addLockStats assert

  // pipeout the infoset
  InfoSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EXITING ...                                               */
/*----------------------------------------------------------------------------*/
: stats_Exiting \handler

  // find the __lockStats table
  C_TDEF_LOCKSTATS op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] InfoSet[].new

  // add lock to the infoSet
  infoSetTable[] InfoSet[].addLockStats assert

  // pipeout the infoset
  InfoSet[].pipeOut

  ZK_M_EXITING_handler // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* stats request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: stats_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: stats_StartMarker ZK_M_START op[].handler!
  find: stats_Exiting     ZK_M_EXITING  op[].handler!

  op__loop

  "*** stats EXITS" .
  LogReqExit
  _op_retires_
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: stats :: stats ;

: stats_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
