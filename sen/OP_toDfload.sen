/*============================================================================*/
/* OP_toDfload.sen -- Operator To Dfload                                      */
/*============================================================================*/

" OP_toDfload.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* handler for ZK_I_PATH ...                                                  */
/*----------------------------------------------------------------------------*/
: toDfload_PathInfo \handler
 
  "toDfload_PathInfo" .

  PipeIn[] to InfoSet[]
  nullptr to Pipein[]

  // find the __path table def
  C_TDEF_PATH op__tableDef_infoSet assert

  InfoSet[].firstRow to infoSetRow[]

  0 InfoSet[].colVal@ locals| sPath | sPath .
  1 InfoSet[].colVal@ locals| iPathNo | iPathNo .
  2 InfoSet[].colVal@ locals| iPathOf | iPathOf .
  InfoSet[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  sPath <tableNm> "dfload %v \"%v\"" str.format locals| sRequest |
  sRequest .

  // find the __callPipeline table def
  C_TDEF_CALLPIPELINE op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] InfoSet[].new
    OI_CALLPIPELINE InfoSet[].opInfoset!

  iPathOf iPathNo sRequest 3 InfoSet[].addRowVargs
    
  InfoSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : toDfload_op \operator

  _lu_initialise_

  op__topology

  find: toDfload_PathInfo ZK_I_PATH [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toDfload :: toDfload <tableNm> ;

: toDfload_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "toDfload_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
