/*----------------------------------------------------------------------------*/
/* initialise                                                                 */
/*----------------------------------------------------------------------------*/
: jobExit_initialise

  "Newing a tub" .

  Tub[].new
;

/*----------------------------------------------------------------------------*/
/* metricsCollectJob : collect job metrics                                    */
/*----------------------------------------------------------------------------*/
: metricsCollectJob_ ( pJob )

  params| pJob |

  0 locals| pJobMetrics |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // job metrics
  pJob jobMetrics::new to pJobMetrics
  pJobMetrics jobMetrics.collect if
    pJobMetrics [op].pipeout
  else
    pJobMetrics jobMetrics.delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: jobExit_StartMarker \handler

   0 locals| pJobToBeDeleted |

  "jobExit Demon Started" .boot

  begin

    // get exited job to be deleted
    api::reapableJob@ to pJobToBeDeleted

    begin
        pJobToBeDeleted
    while
      // generate the job metrics here
      "<jobMetrics>" pJobToBeDeleted api::reapableJobTags@ tagSet.hasName if
        pJobToBeDeleted api::reapableJobIsOriginator not if
          pJobToBeDeleted >str "Generating JobMetrics for job %v" str.format .
          pJobToBeDeleted metricsCollectJob_
        then
      then

      // delete the job
      pJobToBeDeleted api::deleteJob

      // next exited job to be deleted
      api::reapableJob@ to pJobToBeDeleted
    repeat

    // sleep for a second
    // [args].demonSleep thread::sleepSsec
    1 thread::sleepSsec

  again
;

/*----------------------------------------------------------------------------*/
/* execute for jobReport req                                            SPAWN */
/*----------------------------------------------------------------------------*/
 : jobExit_op \operator

  _lu_initialise_

  op__topology

  //find: jobExit_Flush       EV_M_FLUSH [op].handler!
  find: jobExit_StartMarker EV_M_START [op].handler!

  //jobExit_initialise
  
  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobExit :: jobExit ;

: jobExit_cmdTags _cmdTags tagCopy: Op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "jobExit_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
