/*============================================================================*/
/* OP_jobExit.sen -- Operator job report                                */
/*============================================================================*/

" OP_jobExit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* insert job metrics                                                         */
/*----------------------------------------------------------------------------*/
: insertJobMetrics ( pJob )

  params| pJob |
  0 locals| eError |

  AM::DEMON::tEventDemonJobId@ locals| tEventDemonJobId |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // find the event demon

  tEventDemonJobId jobId::isUnknown if
    "Cant find __eventDemon" .
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // new a tub

  Tub[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // metrics

  Tub[] pJob jobReport::metrics to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // network

  Tub[] pJob jobReport::network to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // network dissect

  Tub[] pJob jobReport::netDissect to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // operators

  Tub[] pJob jobReport::operators to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // operands

  Tub[] pJob jobReport::operands to eError

  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  tEventDemonJobId Tub[].pipeToJob

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  Tub[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: jobExit_StartMarker \handler

   0 locals| pJobToBeDeleted |

  "jobExit Demon Started" .boot

  begin

    // get exited job to be deleted
    api::reapableJob@ to pJobToBeDeleted

    begin
        pJobToBeDeleted
    while
      // generate the job metrics here
      "<jobMetrics>" pJobToBeDeleted api::reapableJobTags@ tagSet.hasName if
        pJobToBeDeleted api::reapableJobIsOriginator not if
          pJobToBeDeleted api::reapableJobMetricsEnabled if
            pJobToBeDeleted >str "Inserting JobMetrics for job %v" str.format .
            pJobToBeDeleted insertJobMetrics
          then
        then
      then

      // delete the job
      pJobToBeDeleted api::deleteJob

      // next exited job to be deleted
      api::reapableJob@ to pJobToBeDeleted
    repeat

    // sleep for a second
    // [args].demonSleep thread::sleepSsec
    1 [task].sleepSsec

  again
;

/*----------------------------------------------------------------------------*/
/* execute for jobReport req                                            SPAWN */
/*----------------------------------------------------------------------------*/
 : jobExit_op \operator

  _lu_initialise_

  op__topology

  //find: jobExit_Flush       EV_M_FLUSH [op].handler!
  find: jobExit_StartMarker EV_M_START [op].handler!

  //jobExit_initialise
  
  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobExit :: jobExit ;

: jobExit_cmdTags _cmdTags tagCopy: Op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 1

    <opEntry> = "jobExit_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
