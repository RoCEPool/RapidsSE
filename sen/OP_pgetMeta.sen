 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // prototype get meta object

  STD_PATH
  "
  procedure pgetMeta
    parameters $TableNm
  begin

    stage stageA on origin :
      start | periodic once | pmetaGet $TableNm | stageB hashed

    stage stageB on all nodes :
      pmetaSend | stageC

    stage stageC on origin :
      pmetaRecv | output | sink | stageA

  end ;
  "
  api::addProcedure

 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 // get meta object 2

  STD_PATH
  "
  procedure getMeta2
    parameters $TableNm
  begin

    stage stageA on origin :
      start | metaGet $TableNm | stageB hashcast

    stage stageB on all nodes :
      metaSend | metaRecv | stageC

    stage stageC on origin :
      noop | sink | stageA

  end ;
  "
  api::addProcedure
;