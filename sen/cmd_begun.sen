/*============================================================================*/
/* cmd_begun.sen -- 1sc: given pipeline has begun on participant              */
/*============================================================================*/

" cmd_begun.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                    ON ORIGINATING NODE OF GIVEN PIPELINE                   */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* run this received Job_Begun on originating node                            */
/*----------------------------------------------------------------------------*/
: begun:begun

  // find the originating job
  [job].parentId@ ListedJob[].findOriginator discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  ListedJob[].task@ task.ack
  
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: begun :: begun ;

: begun_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "begun:begun"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
