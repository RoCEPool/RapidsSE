/*============================================================================*/
/* cmd_begun.sen -- 1sc: given pipeline has begun on participant              */
/*============================================================================*/

" cmd_begun.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                    ON ORIGINATING NODE OF GIVEN PIPELINE                   */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/
: begun:onOrigin

  //"begun:onOrigin" .
  
  [args].distJob if
    "begun" "onOrigin" "<beg ack originTask" [job].trace
  then


  // find the originating job
  
  [job].originId@ ListedJob[].findOriginator? if

    ListedJob[].taskAck
  
    ListedJob[].returnReference
    
  then
  
  [job]:retireAndExit
  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: begun:onParticipant

  //"begun:begun" .

  [args].distJob if
    "begun" "onParticipant" "<beg snd origin" [job].trace
  then

  "begun:onOrigin" [job].entryPoint!

  [job].parentOriginNodeId@ [grid].findNodeByNo to SendNode[]
  
  [job] job(Id).send

  nullptr to SendNode[]
  
  [job]:retireAndExit
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: begun :: begun ;

: begun_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "begun:onParticipant"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
