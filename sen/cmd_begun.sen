/*============================================================================*/
/* cmd_begun.sen -- 1sc: given pipeline has begun on participant              */
/*============================================================================*/

" cmd_begun.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                    ON ORIGINATING NODE OF GIVEN PIPELINE                   */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on originating node                                                        */
/*----------------------------------------------------------------------------*/
: begun:onOrigin
  //"begun:onOrigin" .
  
/* <bgn org */  [args].distJob if
/* <bgn org */    "begun" "onOrigin" "<bgn org"
/* <bgn org */      "ack origin job-task"                            [job].trace
/* <bgn org */  then
/* <bgn org */
/* <bgn org */
/* <bgn org */  // find the originating job
/* <bgn org */
/* <bgn org */  [job].originId@ ListedJob[].findOriginator? if
/* <bgn org */
/* <bgn org */    ListedJob[].taskAck
/* <bgn org */
/* <bgn org */    ListedJob[].returnReference
/* <bgn org */
/* <bgn org */  then
/* <bgn org */
/* <bgn org */  [job]:retireAndExit
/* <bgn org */  HAZARD
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: begun:onParticipant
  //"begun:begun" .

/* <bgn ptp */  [args].distJob if
/* <bgn ptp */    "begun" "onParticipant"
/* <bgn ptp */      "<bgn ptp" "snd begun to origin"                 [job].trace
/* <bgn ptp */  then
/* <bgn ptp */
/* <bgn ptp */  "begun:onOrigin" [job].entryPoint!
/* <bgn ptp */
/* <bgn ptp */  [job].originNodeId@ [grid].findNodeByNo to SendNode[]
/* <bgn ptp */
/* <bgn ptp */  [job] job(Id).send
/* <bgn ptp */
/* <bgn ptp */  nullptr to SendNode[]
/* <bgn ptp */
/* <bgn ptp */  [job]:retireAndExit
/* <bgn ptp */  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: begun :: begun ;

: begun_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "begun:onParticipant"
    <path>        = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
