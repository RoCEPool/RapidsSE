/*============================================================================*/
/* OP_xmit.sen -- Operator xmit                                               */
/*============================================================================*/

" OP_xmit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* perform a simple pipe in send                                              */
/*----------------------------------------------------------------------------*/
: PipeIn[].send

  PipeIn[]\clear op::pipeout
  
  // calling op_loop continues
  true
;



/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER operand                                        */
/*----------------------------------------------------------------------------*/
: xmit_CANCELMARKER \handler

  PipeIn[].send

  PipeIn[].drain

  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER operand                                          */
/*----------------------------------------------------------------------------*/
: xmit_EXITMARKER \handler

  PipeIn[].send

  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* execute for xmit request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : xmit_req \operator

  LogReqEntry SEED_REQ

  // set the xmit kind
  <xmitKind> >int op.xmitKind!

  999999999999 task::operandYield!

  op__topology

  find: PipeIn[].send op[].handlerAll!

  find: xmit_CANCELMARKER  ZK_CANCELMARKER  op[].handler!
  find: xmit_EXITMARKER    ZK_EXITMARKER    op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: xmit :: xmit <xmitKind> ;

: xmit_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
