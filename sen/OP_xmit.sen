/*============================================================================*/
/* OP_xmit.sen -- Operator xmit                                               */
/*============================================================================*/

" OP_xmit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* perform a simple pipeout on behalf of a standard handler                   */
/*----------------------------------------------------------------------------*/
: STANDARD_SEND

  PipeIn[]\clear op::pipeout
  
  // calling op_loop continues
  true
;


/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: xmit_EosMarker \handler

  ZK_EOSMARKER_handler

  // get the profile from the task
  //task[] task.profile@ to Operand[]
  //nullptr task[] task.profile!
  //Operand[].pipeOut
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DESTROYMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: xmit_DestroyMarker \handler

  //"ZK_DESTROYMARKER" .verbose
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: xmit_StartMarker \handler

  ZK_STARTMARKER_handler
  op.stageName@ "xmit %v" str.format profile.name!
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ROWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: xmit_RowBuffer \handler

  //"ZK_ROWBUFFER_handler" .verbose
  //Pipein[] profile.start
  PipeIn[].pipeOut
  //profile.end

  true
;




/*----------------------------------------------------------------------------*/
/* default handler for ZK_CANCELMARKER operand                                */
/*----------------------------------------------------------------------------*/
: xmit_CANCELMARKER \handler

  //"ZK_CANCELMARKER_handler" .verbose

  PipeIn[].pipeOut

  // drain the operand queue
  begin
    Pipein[].peek
  while
    PipeIn[].next
    Pipein[].delete
  repeat

  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_EXITMARKER operand                                  */
/*----------------------------------------------------------------------------*/
: xmit_EXITMARKER \handler

  //"ZK_EXITMARKER_handler" .verbose
  
  PipeIn[].pipeOut
  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* execute for xmit request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : xmit_req \operator

  LogReqEntry SEED_REQ

  // set the xmit kind
  <xmitKind> >int op.xmitKind!

  999999999999 task::operandYield!

  op__topology

  find: STANDARD_SEND op[].handlerAll!

  find: xmit_CANCELMARKER       ZK_CANCELMARKER       op[].handler!
  find: xmit_EXITMARKER         ZK_EXITMARKER         op[].handler!

  find: xmit_DestroyMarker ZK_DESTROYMARKER op[].handler!
  find: xmit_EosMarker     ZK_EOSMARKER     op[].handler!
  find: xmit_RowBuffer     ZK_ROWBUFFER     op[].handler!
  find: xmit_StartMarker   ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: xmit :: xmit <xmitKind> ;

: xmit_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
