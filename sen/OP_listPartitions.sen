/*============================================================================*/
/* OP_listPartitions.sen -- Operator list table partition information         */
/*============================================================================*/

" OP_showPartitions.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsptn_action

  0 locals| iCursor |

  // find the table
  <tableNm> op__table not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] streamDef[].new

  // pipeout the streamDef
  streamDef[].pipeOut

  begin
    streamSetTable[] StreamSet[].new
    iCursor table[].listPartition to iCursor
    
    iCursor while
      StreamSet[].pipeOut
  repeat

  // pipeout the infoset
  StreamSet[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsptn :: lsptn <tableNm> ;

: lsptn _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __promptOut
    <params>      = 1
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

