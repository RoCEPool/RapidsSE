/*============================================================================*/
/* OP_listPartitions.sen -- Operator list table partition information         */
/*============================================================================*/

" OP_showPartitions.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsptn_action

  0 locals| iCursor |

  // find the table
  <tableNm> op__table not if
    false
    exit
  then

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  begin
    BT_DATA TableDef[] RowBuffer[].new
    iCursor Table[].listPartition to iCursor
    
    iCursor while
      RowBuffer[].pipeOut
  repeat

  // pipeout the rowBuffer
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsptn :: lsptn <tableNm> ;

: lsptn_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __promptOut
    <params>      = 1

    <opEntry> = "lsptn_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

