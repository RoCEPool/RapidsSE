/*============================================================================*/
/* OP_progress.sen -- Operator progress                                       */
/*============================================================================*/

" OP_progress.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS...                                                             */
/*----------------------------------------------------------------------------*/
: progress_EosMarker \handler

  <string> StringA[]
    "*** File: %v; %v Done ***\n" str.format .

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* ProgressUnits                                                              */
/*----------------------------------------------------------------------------*/
: progress_PdsProgressUnits

  0 0 0 locals| nodeName partitionNo iPercent |

  // get first row of Pds[]
  Pds[].firstRow to Row[]

  // get 0th Column (ProgressUnits) add to Counter
  0 Row[].getIntColumn Counter1[] + to Counter1[]

  // calculat the Load %
  Counter1[] Counter0[] Int.percent to iPercent

  // print the Load %
  iPercent Counter2[] > if
    iPercent 100 >= if
      <string> StringA[]
        "File: %v; %v Progress: 100" str.format
      "%\n" str.cat .
    else
      iPercent StringA[]
        "File: %v; Progress: %v" str.format
      "%" str.cat .
    then
  then

  iPercent to Counter2[]
;

/*----------------------------------------------------------------------------*/
/* ProgressUnits                                                              */
/*----------------------------------------------------------------------------*/
: progress_ProgressUnits

  0 0 0 locals| nodeName partitionNo iPercent |

  // get first row of RowBuffer[]
  RowBuffer[].firstRow to Row[]

  // get 0th Column (ProgressUnits) add to Counter
  0 Row[].getIntColumn Counter1[] + to Counter1[]

  // calculat the Load %
  Counter1[] Counter0[] Int.percent to iPercent

  // print the Load %
  iPercent Counter2[] > if
    iPercent 100 >= if
      <string> StringA[]
        "File: %v; %v Progress: 100" str.format
      "%\n" str.cat .
    else
      iPercent StringA[]
        "File: %v; Progress: %v" str.format
      "%" str.cat .
    then
  then

  iPercent to Counter2[]
;

/*----------------------------------------------------------------------------*/
/* TotalUnits                                                                 */
/*----------------------------------------------------------------------------*/
: progress_PdsTotalUnits

  0 locals| iPercent |

  // get first row of Pds[]
  Pds[].firstRow to Row[]

  // get 0th Column (fileName)
  0 Row[].getVchColumn to StringA[]

  // get 1st column (totalUnits)
  1 Row[].getIntColumn to Counter0[]

  //Counter0[] "Total Units: %v" .printf
;

/*----------------------------------------------------------------------------*/
/* TotalUnits                                                                 */
/*----------------------------------------------------------------------------*/
: progress_TotalUnits

  0 locals| iPercent |

  // get first row of RowBuffer[]
  RowBuffer[].firstRow to Row[]

  // get 0th Column (fileName)
  0 Row[].getVchColumn to StringA[]

  // get 1st column (totalUnits)
  1 Row[].getIntColumn to Counter0[]

  //Counter0[] "Total Units: %v" .printf
;

/*----------------------------------------------------------------------------*/
/* on EV_D_PDSROWBUFFER...                                                    */
/*----------------------------------------------------------------------------*/
: progress_PdsRowBuffer \handler

  0 0 locals| iPercent eBufferType |

  //"Operand:- EV_D_PDSROWBUFFER" .verbose

  // get operand into Pds[]
  PipeIn[] to Pds[]
  nullptr to PipeIn[]

  // get the buffer type
  Pds[].bufferType@ to eBufferType

  // handle BT_PROGRESSUNITS
  eBufferType BT_PROGRESSUNITS == if
    progress_PdsProgressUnits
    Pds[].delete
    true
    exit
  then

  // handle BT_TOTALUNITS
  eBufferType BT_TOTALUNITS == if
    progress_PdsTotalUnits
    Pds[].delete
    true
    exit
  then

  // pipeout all other Pds types
  Pds[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : progress_op \operator
 
  _lu_initialise_

  op__topology

  find: progress_EosMarker     EV_M_EOS           [op].handler!
  find: progress_PdsRowBuffer  EV_D_PDSROWBUFFER  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: progress :: progress <string> ;

: progress_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "progress_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
