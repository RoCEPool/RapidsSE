/*============================================================================*/
/* OP_progress.sen -- Operator progress                                       */
/*============================================================================*/

" OP_progress.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS...                                                             */
/*----------------------------------------------------------------------------*/
: progress_EosMarker \handler

  <string> StringA[]
    "*** File: %v; %v Done ***\n" str.format .

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* ProgressUnits                                                              */
/*----------------------------------------------------------------------------*/
: progress_ProgressUnits

  0 0 0 locals| nodeName partitionNo iPercent |

  // get first row of RowBuffer[]
  RowBuffer[].firstRow to infoSetRow[]

  // get 0th Column (ProgressUnits) add to Counter
  0 infoSetRow[].getIntColumn Counter1[] + to Counter1[]

  // calculat the Load %
  Counter1[] Counter0[] Int.percent to iPercent

  // print the Load %
  iPercent Counter2[] > if
    iPercent 100 >= if
      <string> StringA[]
        "File: %v; %v Progress: 100" str.format
      "%\n" str.cat .
    else
      iPercent StringA[]
        "File: %v; Progress: %v" str.format
      "%" str.cat .
    then
  then

  iPercent to Counter2[]
;

/*----------------------------------------------------------------------------*/
/* TotalUnits                                                                 */
/*----------------------------------------------------------------------------*/
: progress_TotalUnits

  0 locals| iPercent |

  // get first row of InfoSet[]
  RowBuffer[].firstRow to infoSetRow[]

  // get 0th Column (fileName)
  0 infoSetRow[].getVchColumn to StringA[]

  // get 1st column (totalUnits)
  1 infoSetRow[].getIntColumn to Counter0[]

  //Counter0[] "Total Units: %v" .printf
;

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER...                                                       */
/*----------------------------------------------------------------------------*/
: progress_RowBuffer \handler

  0 0 locals| iPercent eBufferType |

  //"Operand:- EV_D_ROWBUFFER" .verbose

  // get operand into RowBuffer[]
  PipeIn[] to RowBuffer[]
  nullptr to PipeIn[]

  // get the buffer type
  RowBuffer[].getBufferType to eBufferType

  // check the rowBuffer type
  eBufferType BT_PROGRESSUNITS == if
    progress_ProgressUnits
  else
  eBufferType .
    eBufferType BT_TOTALUNITS == assert
    progress_TotalUnits
  then

  // now delete the RowBuffer[]
  RowBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : progress_op \operator
 
  _lu_initialise_

  op__topology

  find: Progress_EosMarker     EV_M_EOS           [op].handler!
  find: Progress_RowBuffer     EV_D_ROWBUFFER     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: progress :: progress <string> ;

: progress_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "progress_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
