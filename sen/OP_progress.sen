/*============================================================================*/
/* OP_progress.sen -- Operator progress                                       */
/*============================================================================*/

" OP_progress.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS...                                                         */
/*----------------------------------------------------------------------------*/
: progress_EosMarker \handler

  <string> StringA[]
    "*** File: %v; %v Done ***\n" str.format .

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_I_PROGRESSUNITS...                                                     */
/*----------------------------------------------------------------------------*/
: progress_ProgressUnits \handler

  0 0 0 locals| nodeName partitionNo iPercent |

  //"Operand:- EV_I_PROGRESSUNITS" .verbose

  // get operand into InfoSet[]
  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  // get first row of InfoSet[]
  InfoSet[].firstRow to infoSetRow[]

  // get 0th Column (ProgressUnits) add to Counter
  0 infoSetRow[].getIntColumn Counter1[] + to Counter1[]

  // calculat the Load %
  Counter1[] Counter0[] Int.percent to iPercent

  // print the Load %
  iPercent Counter2[] > if
    iPercent 100 >= if
      <string> StringA[]
        "File: %v; %v Progress: 100" str.format
      "%\n" str.cat .
    else
      iPercent [job].progressSeconds <string> StringA[]
        "File: %v; %v seconds %v Progress: %v" str.format
      "%" str.cat .
    then
  then

  iPercent to Counter2[]

  // now delete the InfoSet[]
  InfoSet[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_I_TOTALUNITS...                                                        */
/*----------------------------------------------------------------------------*/
: progress_TotalUnits \handler

  0 locals| iPercent |

  //"Operand:- EV_I_TOTALUNITS" .verbose

  // get operand into InfoSet[]
  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  // get first row of InfoSet[]
  InfoSet[].firstRow to infoSetRow[]

  // get 0th Column (fileName)
  0 infoSetRow[].getVchColumn to StringA[]

  // get 1st column (totalUnits)
  1 infoSetRow[].getIntColumn to Counter0[]

  // now delete the InfoSet[]
  InfoSet[].delete
  
  Counter0[] "Total Units: %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : progress_op \operator
 
  _lu_initialise_

  op__topology

  find: Progress_EosMarker     EV_M_EOS     [op].handler!
  find: Progress_ProgressUnits EV_I_PROGRESSUNITS [op].handler!
  find: Progress_TotalUnits    EV_I_TOTALUNITS    [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: progress :: progress <string> ;

: progress_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "progress_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
