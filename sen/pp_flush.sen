/*============================================================================*/
/* pp_flush.sen -- flush demon procedure                                      */
/*============================================================================*/

" pp_flush.sen" .verbose
  
  STD_PATH_TAG
  "
  procedure flush
    parameters $demon
  begin

    stage stageA on origin :
    
        start
      | pulse once
      | stageB

    stage stageB on all nodes :
    
        flushDemon $demon
      | stageC

    stage stageC on origin :
    
        output
      | sink
      | stageA

  end ;
  "
  api::addProcedure
;

//
// example:
//  flush __metricsDemon ;
//

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
