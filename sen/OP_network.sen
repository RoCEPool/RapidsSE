/*============================================================================*/
/* op_network.sen -- show network                                             */
/*============================================================================*/

" op_network.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: network_action
  
  network::show
  
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: network :: network ;

: network_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 0

    <opEntry> = "network_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
