/*============================================================================*/
/* pp_steadyState.sen -- define steady state procedures                       */
/*============================================================================*/

" pp_steadyState.sen" .verbose



/*----------------------------------------------------------------------------*/
/* steady state related procedures                                            */
/*----------------------------------------------------------------------------*/

"  start::defProc_SteadyState" .verbose

: start::defProc_SteadyState

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 1
  
  STD_PATH_TAG
  "
  procedure steadyState_1
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | pulse once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRow $Table
        | toPtnRow
        | stageB hashcast

    stage stageB on all partitions :
      noop
      //insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 2
  
  STD_PATH_TAG
  "
  procedure steadyState_2
    parameters $Table $File $NTimes
  begin

    stage stageA on origin :
      start
        | pulse once
        //|  rdCsvCyclic $File $NTimes
        | catFile $File
        | toRow $Table
        | toPtnRow
        | stageB hashcast

    stage stageB on all partitions :
      //noop
      insdel $Table
        | stageC

    stage stageC on origin :
      output
        | sink
        | stageA

  end ;

  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // steady state test 3
  
  STD_PATH_TAG
  "
  procedure steadyState_3
   parameters $Table $File $NTimes
  begin

   stage stageA on origin :

     start |

     pulse once |

     rdCsvCyclic $File $NTimes |

     stageB localrobin


   stage stageB on all partitions on origin  :

     toRow $Table |

     toPtnRow |

     //toNstRow |

     //toHshCrw |

     stageC hashcast


   stage stageC on all partitions :

     insdel $Table |

     stageD


   stage stageD on origin :

     //output |

     sink |

     stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
