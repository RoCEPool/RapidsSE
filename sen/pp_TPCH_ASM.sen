/*============================================================================*/
/* pp_TPCH_ASM.sen -- define TPCH ASM related procedures                      */
/*============================================================================*/

" pp_TPCH_ASM.sen" .verbose


/*----------------------------------------------------------------------------*/
/* TPCH ASM Compiled related procedures                                       */
/*----------------------------------------------------------------------------*/

"  start::defProc_TPCH_ASM" .verbose

: start::defProc_TPCH_ASM

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 1 - compiled
  
  STD_PATH_TAG
  "
  procedure Query1_ASM
    parameters $Table $QueryText_stageB $QueryText_stageC
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan $Table
    | EOAsm $QueryText_stageB 1
    | stageC

  stage stageC on origin :
    EOAsm $QueryText_stageC 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 3 -- compiled
  
  STD_PATH_TAG
  "
  procedure Query3_ASM
    parameters $QueryText_stageB $QueryText_stageC $QueryText_stageD
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions : //300
    EOAsm $QueryText_stageB 1
    | stageC hashcast

  stage stageC on all partitions : //301
    EOAsm $QueryText_stageC 1
    | stageD

  stage stageD on origin : //302
    EOAsm $QueryText_stageD 1
    | output
    | sink
    | stageA

  end ;  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 4 -- compiled
  
  STD_PATH_TAG
  "
  procedure Query4_ASM
    parameters $QueryText_stageB $QueryText_stageC $QueryText_stageD
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    EOAsm $QueryText_stageB 1
    | stageC hashcast

  stage stageC on all partitions :
    EOAsm $QueryText_stageC 1
    | stageD

  stage stageD on origin :
    EOAsm $QueryText_stageD 1
    | output
    | sink
    | stageA

  end ;  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 6 - compiled
  
  STD_PATH_TAG
  "
  procedure Query6_ASM
    parameters $QueryText_stageB $QueryText_stageC
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    EOAsm $QueryText_stageB 1
    | stageC

  stage stageC on origin :
    EOAsm $QueryText_stageC 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
