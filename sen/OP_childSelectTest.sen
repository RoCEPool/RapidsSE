/*============================================================================*/
/* OP_childSelectTest.sen -- child select test                                */
/*============================================================================*/

" OP_childSelectTest.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: childSelectTest_DataPulse \handler

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for childSelectTest op                                             */
/*----------------------------------------------------------------------------*/
: childSelectTest_op \operator

  _lu_initialise_

  op__topology

  find: childSelectTest_DataPulse   EV_M_DATAPULSE   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: childSelectTest :: childSelectTest ;

: childSelectTest_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "childSelectTest_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
