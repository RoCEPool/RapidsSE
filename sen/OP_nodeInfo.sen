/*============================================================================*/
/* OP_nodeInfo.sen -- Operator node info                                      */
/*============================================================================*/

" OP_nodeInfo.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: nodeInfo_action

  // find the __ table
  <streamDef> op__tableDef_infoSet assert

  // create an rowBuffer operand
  infoSetTable[] RowBuffer[].new

  // add nodeInfo to the R\rowBuffer
  infoSetTable[] RowBuffer[].addnodeInfo assert

  // pipeout the rowBuffer
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: nodeInfo :: nodeInfo ;

: nodeInfo_cmdTags _cmdTags tagCopy: liteOp_tags
tags{
  <cmdDesc>   = "--desc for op--"
  <streamDef> = __nodeInfo
  <params>    = 0
  <opEntry> = "nodeInfo_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
