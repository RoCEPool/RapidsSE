/*============================================================================*/
/* OP_nodeInfo.sen -- Operator node info                                      */
/*============================================================================*/

" OP_nodeInfo.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: nodeInfo_action

  // find the <streamDef> table
  <streamDef> op__tableDef assert

  // create a Pds operand
  BT_NODEINFO TableDef[] Pds[].new

  // add nodeInfo to the Pds
  Pds[].addnodeInfo assert

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: nodeInfo :: nodeInfo ;

: nodeInfo_cmdTags _cmdTags tagCopy: liteOp_tags
tags{
  <cmdDesc>   = "--desc for op--"
  <streamDef> = __nodeInfo
  <params>    = 0
  <opEntry> = "nodeInfo_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
