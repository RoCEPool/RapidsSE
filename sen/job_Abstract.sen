/*============================================================================*/
/* job_Abstract.sen -- Abstract/Common Job                                    */
/*============================================================================*/

" job_Abstract.sen" .verbose

/*----------------------------------------------------------------------------*/
/* distribute current originating job to all nodes as participating job       */
/*----------------------------------------------------------------------------*/
: job::distributeParticipants ( -- )

  // send the job to each connected node in the grid

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.sendSocket@ if
      pNode node.no Job[] job.forward
    else
      "++++++++++++++++++++++++++++++++++ NO SOCKET FOR NODE" .
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete
;

/*----------------------------------------------------------------------------*/
/* entry point                                                                */
/*----------------------------------------------------------------------------*/
: job::entry

  " Job[].entry@ " >interpret
  
  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
