/*============================================================================*/
/* OP_inflate.sen -- Operator Inflate                                         */
/*============================================================================*/

" OP_inflate.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on EV_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: inflate_Cleaning \handler

  0 EV_M_CLEANING EG_ZK LogicUnit[].diaryNote

  EV_M_CLEANING EG_ZK PD_PIPE_OUT 0 EV_M_CLEANING EG_ZK LogicUnit[].diaryAction

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_CRWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: inflate_CrwBuffer \handler

  0 EV_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  Pipein[]\clear to CrwBuffer[]
  Tub[] CrwBuffer[].inflateTcc
  nullptr to CrwBuffer[]

  Tub[].pipeOutCompleted

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: inflate_EosMarker \handler

  0 EV_M_EOS EG_ZK LogicUnit[].diaryNote

  // pipeout all PotRlu[]
  Tub[].pipeOutRemainder
  Tub[].delete

  EV_M_EOS EG_ZK PD_PIPE_OUT 0 EV_M_EOS EG_ZK LogicUnit[].diaryAction

  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: inflate_StartMarker \handler

  0 EV_M_START EG_ZK LogicUnit[].diaryNote

  // new Tub[]
  Tub[].new

  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: inflate_StreamDef \handler

  0 EV_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  PipeIn[]\clear to StreamDefLft[]

  // create streamDefOut
  StreamDefLft[].duplicate to StreamDefOut[]

  // pipeout copy of stream def
  StreamDefOut[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: inflate_op \operator

  _lu_initialise_

  op__topology

  find: inflate_Cleaning      EV_M_CLEANING      [op].handler!
  find: inflate_CrwBuffer     EV_D_CRWBUFFER     [op].handler!
  find: inflate_EosMarker     EV_M_EOS           [op].handler!
  find: inflate_StartMarker   EV_M_START         [op].handler!
  find: inflate_StreamDef     EV_D_STREAMDEF     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: inflate :: inflate ;

: inflate_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "inflate_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
