/*============================================================================*/
/* OP_send.sen -- Operator send                                               */
/*============================================================================*/

" OP_send.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send the operand in the PipeIn[] register                                  */
/*----------------------------------------------------------------------------*/
: PipeIn[].sendTo \handler

  0 locals| pParcel |

  PipeIn[]\clear locals| pOperand |

   //"1 before assert" .
   // assert::stack_0
  
  // we do not expect to see a job
  pOperand object.class@ CN_JOB != ASSERT

 //"2 before assert" .
 // assert::stack_0

  //pOperand object.preSendWord@ if
  //  pOperand object.preSendWord@ execute
  //then
  

  pOperand object.class@ CN_PARCEL == if
    pOperand to pParcel
    pParcel parcel.label
     "3a before assert" .
      assert::stack_0
  else
    pOperand operand.toParcel to pParcel
      "3b before assert" .
          assert::stack_0
  then
  
  pParcel parcel.sendOut
   "4 before assert" .
    assert::stack_0

  pParcel parcel::delete
  " 5 before assert" .
  assert::stack_0

  "after assert" .
  // calling op_loop continues
  true
  stk
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER operand                                        */
/*----------------------------------------------------------------------------*/
: send_CANCELMARKER \handler

  PipeIn[].sendTo discard

  PipeIn[].drain

  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER operand                                          */
/*----------------------------------------------------------------------------*/
: send_EXITMARKER \handler

  PipeIn[].sendTo discard

  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* execute for send request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : send_req \operator

  LogReqEntry SEED_REQ

  // set the send kind
  <sendKind> >int op.SendKind!

  999999999999 task::operandYield!

  op__topology

  find: PipeIn[].sendTo op[].handlerAll!

  find: send_CANCELMARKER  ZK_CANCELMARKER  op[].handler!
  find: send_EXITMARKER    ZK_EXITMARKER    op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: send :: send <sendKind> ;

: send_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
