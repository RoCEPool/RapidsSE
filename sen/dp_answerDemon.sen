/*============================================================================*/
/* dp_answerDemon.sen -- Answer Demon                                         */
/*============================================================================*/

" dp_answerDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* answer demon                                                               */
/*----------------------------------------------------------------------------*/
: answerDemonPipeline

  "
    pipelineLocal answerDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | answer
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
