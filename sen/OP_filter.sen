/*============================================================================*/
/* OP_filter.sen -- Operator filter columns                                 */
/*============================================================================*/

" OP_filter.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: filter_seapi

  "filter_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: filter_ComCleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // Need to hold on to the streamDef's till the combined op
  // has created the stencil

  // will be null if table not found
  StreamDefLft[].isNull not if
    StreamDefLft[].delete
  then

  StreamDefOut[].isNull not if
    StreamDefOut[].delete
  then

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: filter_ComStreamDef \handler

  EC_NONE locals| eError |

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // generate selectColumns bitmap from expr and streamDefIn
  //<expr> StreamDefLft[].selectColumns to eError

  // streamDefLft[] is streamDefOut[]
  StreamDefLft[].duplicate to StreamDefOut[]

  <expr> nullptr StreamDefLft[] StreamDefOut[].generate to eError

  // check for error
  eError EC_NONE == not if
    StreamDefOut[].delete
    eError op__execErr
    true
    exit
  then

  // HACK
  StreamDefOut[].delete
  StreamDefLft[].duplicate to StreamDefOut[]

  StreamDefLft[].duplicate to Pipein[]

  // pipe out the streamDef
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: filter_op \operator

  _lu_initialise_

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  Counter0[] 2 == assert
  find: filter_ComCleaning   ZK_M_CLEANING      [op].handler!
  find: filter_ComStreamDef  ZK_D_STREAMDEF     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: filter :: filter <compiled> <expr> ;

: filter_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "filter_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
