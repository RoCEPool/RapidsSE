/*============================================================================*/
/* OP_invoke.sen -- Invoke Sub-Pipeline operator                              */
/*============================================================================*/

" OP_invoke.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: invoke_StartMarker \handler

  0 locals| nAcks |

  deck:invoke
  
  nullptr to Deck[]

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* invoke a sub-pipeline                                                      */
/*----------------------------------------------------------------------------*/
 : invoke_op \operator

  _lu_initialise_

  op__topology

  find: invoke_StartMarker  ZK_M_START  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: invoke :: invoke <subPipeNm> ;

: invoke_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "invoke_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
