/*============================================================================*/
/* OP_toKeyHshRow_sf.sen -- Convert csv buffers to row buffers                   */
/*============================================================================*/

" OP_toKeyHshRow_sf.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: toKeyHshRow_sf_StartMarker \handler

  0 locals| eError |

  // pipeout the (StartMarker)
  PipeIn[].pipeOut

  // test and create Table[] using <tableNm>
  <tableNm> op__table if

    // create a ToRow using Table[].streamDef
    toKeyHshRow[].new to eError

    eError EC_NONE == if
      // new and pipe out (StreamDef)  DOES NOT SET StreamDefLft[]??
      Table[] StreamDefOut[].newFromTable
      StreamDefOut[].pipeOut

    else
      eError op__execErr
    then

  then

  // find the __affectedRows table def
  C_TDEF_AFFECTEDROWS op__tableDef_infoSet assert

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_CSVBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: toKeyHshRow_sf_CsvBuffer \handler

  PipeIn[]\clear to CsvBuffer[]

  //Operand[]
  //profile.start

  CsvBuffer[] toKeyHshRow[].csvToRow

  //profile.end

  // test for any completed
  toKeyHshRow[].completed to RowBuffer[]
  begin
    RowBuffer[].isNull not
  while
    RowBuffer[].pipeOut
    toKeyHshRow[].completed to RowBuffer[]
  repeat

  RowBuffer[].isNull assert

  CsvBuffer[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: toKeyHshRow_sf_EosMarker \handler

  // test for any remainders
  toKeyHshRow[].dangling to RowBuffer[]
  begin
    RowBuffer[].isNull not
  while
    RowBuffer[].pipeOut
    toKeyHshRow[].dangling to RowBuffer[]
  repeat


  // -- -- -- -- -- --
  // pipeout load results
  /*
  ToKeyHshRow[].countersAreZero not if
    infoSetTable[] InfoSet[].new
    OI_AFFECTEDROWS InfoSet[].opInfoset!

    0 0 0 toKeyHshRow[].counters@@ 6 InfoSet[].addRowVargs

    InfoSet[].pipeOut
  then
*/

  // -- -- -- -- -- --

  // delete ToRow
  toKeyHshRow[].delete

  // get the profile from the task
  //[task] task.profile@ to Operand[]
  //nullptr [task] task.profile!
  //Operand[].pipeOut

  // pipeout the (EosMarker)
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRow request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toKeyHshRow_sf_op \operator

  _lu_initialise_

  op__topology

  find: toKeyHshRow_sf_CsvBuffer   EV_D_CSVBUFFER   [op].handler!
  find: toKeyHshRow_sf_EosMarker   EV_M_EOS         [op].handler!
  find: toKeyHshRow_sf_StartMarker EV_M_START       [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toKeyHshRow_sf :: toKeyHshRow_sf <tableNm> ;

: toKeyHshRow_sf_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "toKeyHshRow_sf_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
