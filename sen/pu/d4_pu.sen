/*============================================================================*/
/* d4_pu.sen -- Power Unit Testing                                            */
/*============================================================================*/

" d4_pu.sen" .

Path[].save
Path[].root
  
: pu_bump params| iTest | iTest 10 * ;

/*----------------------------------------------------------------------------*/
/* pipeline pu<test> stageA on origin : <stage> | stageA ;                    */
/*----------------------------------------------------------------------------*/
: pu_pipeline params| iTest sStream |
  
  "pipeline pu0"
    iTest >str                            str.cat
    
  " begin"                                str.cat
  
    " stage stageA on origin : "          str.cat
    " start "                             str.cat
    " | pulse once "                      str.cat
    " | stageB "                          str.cat

    " stage stageB on all partitions : "  str.cat

    sStream                               str.cat
    " | stageA"                           str.cat
    
  " end ;"                                str.cat

  .
  
  counter0[] 1 + to counter0[]
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter | agggby | sink                              */
/*----------------------------------------------------------------------------*/
: pu_sink params| iTest sFrag |

  sFrag " | sink" str.cat
    iTest pu_pipeline
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter | agggby                                     */
/*----------------------------------------------------------------------------*/
: pu_agggby params| iTest sFrag |

  iTest 100 * to iTest

  iTest 1 + to iTest
  sFrag

    " | aggreg 1 \" type INTEGER )  $1 sum  , type INTEGER as l_linenumber $2 groupBy  type INTEGER as l_linenumber $2 \" " str.cat

    " <1 group>"   str.cat

    iTest pu_sink

  iTest 1 + to iTest
  sFrag

    " | aggreg 1 \" type INTEGER )  $1 sum  , type INTEGER as l_linenumber $2 groupBy  type INTEGER as l_linenumber $2 \" " str.cat

    " <10 groups>"   str.cat
    iTest pu_sink

  iTest 1 + to iTest
  sFrag

    " | aggreg 1 \" type INTEGER )  $1 sum  , type INTEGER as l_linenumber $2 groupBy  type INTEGER as l_linenumber $2 \" " str.cat

    " <100 groups>"   str.cat
    iTest pu_sink

  iTest 1 + to iTest
  sFrag

    " | aggreg 1 \" type INTEGER )  $1 sum  , type INTEGER as l_linenumber $2 groupBy  type INTEGER as l_linenumber $2 \" " str.cat

    " <1000 groups>"   str.cat
    iTest pu_sink
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter                                              */
/*----------------------------------------------------------------------------*/
: pu_postFilter params| iTest sFrag |

  iTest 100 * to iTest

  iTest 1 + to iTest
  sFrag
    " | filter 1 \"type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and\" " str.cat
    " <0.1>"   str.cat
    iTest pu_agggby

  iTest 1 + to iTest
  sFrag
    " | filter 1 \"type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and\" " str.cat
    " <0.3>"   str.cat
    iTest pu_agggby

  iTest 1 + to iTest
  sFrag
    " | filter 1 \"type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and\" " str.cat
    " <0.6>"   str.cat
    iTest pu_agggby

  iTest 1 + to iTest
  sFrag
    " | filter 1 \"type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and\" " str.cat
    " <0.9>"   str.cat
    iTest pu_agggby
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join                                                       */
/*----------------------------------------------------------------------------*/
: pu_join params| iTest sFrag |

  iTest 100 * to iTest
  
  iTest 1 + to iTest
  sFrag
    " | indexJoin 1 T10k idx \"EQUAL $I1 $L1 == \" " str.cat
    iTest pu_postFilter
    
  iTest 1 + to iTest
  sFrag
    " | indexJoin 1 T100k idx \"EQUAL $I1 $L1 == \" " str.cat
    iTest pu_postFilter
    
  iTest 1 + to iTest
  sFrag
    " | indexJoin 1 T1m idx \"EQUAL $I1 $L1 == \" " str.cat
    iTest pu_postFilter
    
  iTest 1 + to iTest
  sFrag
    " | indexJoin 1 T10m idx \"EQUAL $I1 $L1 == \" " str.cat
    iTest pu_postFilter
;

/*----------------------------------------------------------------------------*/
/* scan | filter                                                              */
/*----------------------------------------------------------------------------*/
: pu_preFilter params| iTest sFrag |

  iTest 100 * to iTest
  
  iTest 1 + to iTest
  sFrag
    " | filter 1 \"type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and\" " str.cat
    " <0.1>"        str.cat
    iTest pu_join
    
  iTest 1 + to iTest
  sFrag
    " | filter 1 \"type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and\" " str.cat
    " <0.3>"        str.cat
    iTest pu_join
    
  iTest 1 + to iTest
  sFrag
    " | filter 1 \"type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and\" " str.cat
    " <0.6>"       str.cat
    iTest pu_join
    
  iTest 1 + to iTest
  sFrag
    " | filter 1 \"type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and\" " str.cat
    " <0.9>"        str.cat
    iTest pu_join
;

/*----------------------------------------------------------------------------*/
/*  scan                                                                      */
/*----------------------------------------------------------------------------*/
: pu_scan params| iTest sFrag |
  
  iTest 1000 * to iTest
  
  iTest 1 + to iTest
    sFrag "scan T10k" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag "scan T100k" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag "scan T1m" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag "scan T10m" str.cat
    iTest pu_preFilter
;

/*----------------------------------------------------------------------------*/
/* range interval                                                             */
/*----------------------------------------------------------------------------*/
: pu_interval params| iTest sFrag |
  
  iTest 100 * to iTest
  
  iTest 1 + to iTest
    sFrag " <0.01>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <0.03>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <0.06>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <0.09>" str.cat
    iTest pu_preFilter
    
  // - - - - - - - - - - -
  iTest 1 + to iTest
    sFrag " <0.10>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <0.30>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <0.60>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <0.90>" str.cat
    iTest pu_preFilter
    
  // - - - - - - - - - - -
  iTest 1 + to iTest
    sFrag " <1.00>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <3.00>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <6.00>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <9.00>" str.cat
    iTest pu_preFilter
    
  // - - - - - - - - - - -
  iTest 1 + to iTest
    sFrag " <10.00>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <30.00>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <60.00>" str.cat
    iTest pu_preFilter

  iTest 1 + to iTest
    sFrag " <90.00>" str.cat
    iTest pu_preFilter
    

;

/*----------------------------------------------------------------------------*/
/*  range                                                                     */
/*----------------------------------------------------------------------------*/
: pu_range params| iTest sFrag |
  
  iTest 100 * to iTest
  
  iTest 1 + to iTest
    sFrag "indexScan 1 T10k idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval

  iTest 1 + to iTest
    sFrag "indexScan 1 T100k idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval

  iTest 1 + to iTest
    sFrag "indexScan 1 T1m idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval

  iTest 1 + to iTest
    sFrag "indexScan 1 T10m idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pu_begin

  "" 1 pu_scan
  
  // "" 2 pu_range

  counter0[] .
;

/*----------------------------------------------------------------------------*/
/* generate pu tests                                                          */
/*----------------------------------------------------------------------------*/
: pu_gen \prompt

  pu_begin
;

/*----------------------------------------------------------------------------*/
/* run pu tests                                                               */
/*----------------------------------------------------------------------------*/
: pu_run \prompt

;

Path[].Restore

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
