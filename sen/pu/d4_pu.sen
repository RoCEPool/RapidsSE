/*============================================================================*/
/* d4_pu.sen -- Power Unit Testing                                            */
/*============================================================================*/

" d4_pu.sen" .

Path[].save
Path[].root
  
"pre_0_1" CONSTANT pre_0_1
"pre_0_3" CONSTANT pre_0_3
"pre_0_6" CONSTANT pre_0_6
"pre_0_9" CONSTANT pre_0_9
"EQUAL $I1 $L1 ==" CONSTANT <join_key>
"pst_0_1" CONSTANT pst_0_1
"pst_0_3" CONSTANT pst_0_3
"pst_0_6" CONSTANT pst_0_6
"pst_0_9" CONSTANT pst_0_9
"" CONSTANT <agg>
"" CONSTANT <gby_1>
"" CONSTANT <gby_10>
"" CONSTANT <gby_100>
"" CONSTANT <gby_1000>


: pu_bump params| iTest | iTest 10 * ;

/*----------------------------------------------------------------------------*/
/* pipeline pu<test> stageA on origin : <stage> | stageA ;                    */
/*----------------------------------------------------------------------------*/
: pu_pipeline params| iTest sStream |
  
  "pipeline pu0" iTest >str str.cat "\n"   str.cat
    
  "begin\n"                                str.cat
  
  "  stage stageA on origin :\n"           str.cat
  "      start\n"                          str.cat
  "    | pulse once\n"                     str.cat
  "    | stageB\n"                         str.cat

  "  stage stageB on all partitions :\n"   str.cat
         sStream                           str.cat
  "    | stageC\n"                         str.cat
    
  "  stage stageC on origin :\n"           str.cat
  "      sink\n"                           str.cat
  "    | stageA\n"                         str.cat

  " end ;\n"                               str.cat

  .
  
  counter0[] 1 + to counter0[]
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter | agggby                                     */
/*----------------------------------------------------------------------------*/
: pu_agggby params| iTest sFrag |

  iTest 100 * to iTest

  "\"<agg><gby>\"" locals| sAggGby |
  
  // - - - - - - - - - - - -
  // agg by 1 group
  
  iTest 1 + to iTest
    sFrag
      "    | aggreg 1 "      str.cat
                sAggGby      str.cat
        " // 1 group\n"      str.cat
    iTest pu_pipeline

  // - - - - - - - - - - - -
  // agg by 10 groups
  
  iTest 1 + to iTest
    sFrag
      "    | aggreg 1 "      str.cat
                sAggGby      str.cat
      " // 10 groups\n"      str.cat
    iTest pu_pipeline

  // - - - - - - - - - - - -
  // agg by 100 groups
  
  iTest 1 + to iTest
    sFrag
      "    | aggreg 1 "      str.cat
                sAggGby      str.cat
        " // 100 groups\n"   str.cat
    iTest pu_pipeline

  // - - - - - - - - - - - -
  // agg by 1000 groups
  
  iTest 1 + to iTest
    sFrag
      "    | aggreg 1 "      str.cat
                sAggGby      str.cat
        " // 1000 groups\n"  str.cat
    iTest pu_pipeline
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter                                              */
/*----------------------------------------------------------------------------*/
: pu_postFilter params| iTest sFrag |

  iTest 100 * to iTest

  // type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and
  
  "\"<pst-selectivity>\"" locals| sSelectivity |
  
  // - - - - - - - - - - - -
  // filter selectivity 0.1
  
  iTest 1 + to iTest
    sFrag
      "    | filter 1 "              str.cat
                          pst_0_1    str.cat
            " // selectivity 0.1\n"  str.cat
    iTest pu_agggby
    
  // - - - - - - - - - - - -
  // filter selectivity 0.3
  
  iTest 1 + to iTest
    sFrag
      "    | filter 1 "              str.cat
                          pst_0_3    str.cat
            " // selectivity 0.3\n"  str.cat
    iTest pu_agggby
    
  // - - - - - - - - - - - -
  // filter selectivity 0.6
  
  iTest 1 + to iTest
    sFrag
      "    | filter 1 "              str.cat
                          pst_0_6    str.cat
            " // selectivity 0.6\n"  str.cat
    iTest pu_agggby
    
  // - - - - - - - - - - - -
  // filter selectivity 0.9
  
  iTest 1 + to iTest
    sFrag
      "    | filter 1 "              str.cat
                          pst_0_9    str.cat
            " // selectivity 0.9\n"  str.cat
    iTest pu_agggby
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join                                                       */
/*----------------------------------------------------------------------------*/
: pu_join params| iTest sFrag |

  iTest 100 * to iTest
  
  // EQUAL $I1 $L1 ==
  "\"<join-key>\"" locals| sJoinKey |

  // - - - - - - - - - - - -
  // join Pu10k
  
  iTest 1 + to iTest
    sFrag
      "    | indexJoin 1 Pu10k idx "  str.cat
                           sJoinKey   str.cat
                               "\n"   str.cat
    iTest pu_postFilter
    
  // - - - - - - - - - - - -
  // join Pu10k

  iTest 1 + to iTest
    sFrag
      "    | indexJoin 1 Pu100k idx " str.cat
                            sJoinKey  str.cat
                                "\n"  str.cat
    iTest pu_postFilter
    
  // - - - - - - - - - - - -
  // join Pu1m
  
  iTest 1 + to iTest
    sFrag
      "    | indexJoin 1 Pu1m idx "   str.cat
                          sJoinKey    str.cat
                              "\n"    str.cat
    iTest pu_postFilter
    
  // - - - - - - - - - - - -
  // join Pu1m
  
  iTest 1 + to iTest
    sFrag
      "    | indexJoin 1 Pu10m idx "  str.cat
                           sJoinKey   str.cat
                               "\n"   str.cat
    iTest pu_postFilter
;

/*----------------------------------------------------------------------------*/
/* scan | filter                                                              */
/*----------------------------------------------------------------------------*/
: pu_preFilter params| iTest sFrag |

  iTest 100 * to iTest
  
  // type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and
  
  "\"<pre-selectivity>\"" locals| sSelectivity |

  // - - - - - - - - - - - -
  // filter selectivity 0.1
  
  iTest 1 + to iTest
    sFrag
      "    | filter 1 "              str.cat
                          pre_0_1    str.cat
            " // selectivity 0.1\n"  str.cat
    iTest pu_join
    
  // - - - - - - - - - - - -
  // filter selectivity 0.3

  iTest 1 + to iTest
    sFrag
      "    | filter 1 "              str.cat
                          pre_0_3    str.cat
            " // selectivity 0.3\n"  str.cat
    iTest pu_join
    
  // - - - - - - - - - - - -
  // filter selectivity 0.6

  iTest 1 + to iTest
    sFrag
      "    | filter 1 "              str.cat
                          pre_0_6    str.cat
            " // selectivity 0.6\n"  str.cat
    iTest pu_join
    
  // - - - - - - - - - - - -
  // filter selectivity 0.9

  iTest 1 + to iTest
    sFrag
      "    | filter 1 "              str.cat
                          pre_0_9    str.cat
            " // selectivity 0.9\n"  str.cat
    iTest pu_join
;

/*----------------------------------------------------------------------------*/
/*  scan                                                                      */
/*----------------------------------------------------------------------------*/
: pu_scan params| iTest sFrag |
  
  iTest 1000 * to iTest
  
  // - - - - - - - - - - - -
  // scan Pu10k

  iTest 1 + to iTest
    sFrag
      "     scan Pu10k\n" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // scan Pu100k

  iTest 1 + to iTest
    sFrag
      "     scan Pu100k\n" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // scan Pu100k

  iTest 1 + to iTest
    sFrag
      "     scan Pu1m\n" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // scan Pu10m

  iTest 1 + to iTest
    sFrag
      "     scan Pu10m\n" str.cat
    iTest pu_preFilter
;

/*----------------------------------------------------------------------------*/
/* range interval                                                             */
/*----------------------------------------------------------------------------*/
: pu_interval params| iTest sFrag |
  
  iTest 100 * to iTest
  
  // - - - - - - - - - - - -
  // interval 0.001
  
  iTest 1 + to iTest
    sFrag
      " // interval 0.001" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.003
  
  iTest 1 + to iTest
    sFrag
      " // interval 0.003" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.006
  
  iTest 1 + to iTest
    sFrag
      " // interval 0.006" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.009
  
  iTest 1 + to iTest
    sFrag
      " // interval 0.009" str.cat
    iTest pu_preFilter
    
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // - - - - - - - - - - - -
  // interval 0.01

  iTest 1 + to iTest
    sFrag
      " // interval 0.01" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.03

  iTest 1 + to iTest
    sFrag
      " // interval 0.03" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.06

  iTest 1 + to iTest
    sFrag
      " // interval 0.06" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.09

  iTest 1 + to iTest
    sFrag
      " // interval 0.09" str.cat
    iTest pu_preFilter
    

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // - - - - - - - - - - - -
  // interval 0.1

  iTest 1 + to iTest
    sFrag
      " // interval 0.1" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.3

  iTest 1 + to iTest
    sFrag
      " // interval 0.3" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.6

  iTest 1 + to iTest
    sFrag
      " // interval 0.6" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.9

  iTest 1 + to iTest
    sFrag
      " // interval 0.9" str.cat
    iTest pu_preFilter
;

/*----------------------------------------------------------------------------*/
/*  indexScan                                                                 */
/*----------------------------------------------------------------------------*/
: pu_indexScan params| iTest sFrag |
  
  iTest 100 * to iTest
  
  // - - - - - - - - - - - -
  // indexScan Pu10k
  
  iTest 1 + to iTest
    sFrag
      "indexScan 1 Pu10k idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
      iTest pu_interval

  // - - - - - - - - - - - -
  // indexScan Pu100k
  
  iTest 1 + to iTest
    sFrag
      "indexScan 1 Pu100k idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval

  // - - - - - - - - - - - -
  // indexScan Pu1m
  
  iTest 1 + to iTest
    sFrag
      "indexScan 1 Pu1m idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval

  // - - - - - - - - - - - -
  // indexScan Pu10m
  
  iTest 1 + to iTest
    sFrag
      "indexScan 1 Pu10m idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pu_begin

  "" 1 pu_scan
  
  // "" 2 pu_indexScan

  counter0[] .
;

/*----------------------------------------------------------------------------*/
/* generate pu tests                                                          */
/*----------------------------------------------------------------------------*/
: pu_gen \prompt

  pu_begin
;

/*----------------------------------------------------------------------------*/
/* run pu tests                                                               */
/*----------------------------------------------------------------------------*/
: pu_run \prompt

;

Path[].Restore

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
