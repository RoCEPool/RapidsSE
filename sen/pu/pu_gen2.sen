/*============================================================================*/
/* pu_gen2.sen -- Power Unit Testing 2                                        */
/*============================================================================*/

" pu_gen2.sen" .

Path[].save
Path[].root


: >> str.cat ;
: nl "\n" str.cat ;
: sp " "  str.cat ;
: +x " x " str.cat ;
: +fx( "+" ;
: )fx >> find execute ;
: ).fx >> dup . find execute ;
: fx find execute ;
: _+ "+" swap >> ;
: __ "_" swap >> >> ;
: [n] >str "[" swap >> >> "]" >> ;

// fx -- find excute tokens
: key "key" ;
: agg "agg" ;
: gby "gby" ;
: idx "idx" ;

: _Pu10k  "_Pu10k"  >> ;
: _Pu100k "_Pu100k" >> ;
: _Pu1m   "_Pu1m"   >> ;
: _Pu10m  "_Pu10m"  >> ;

: 1g    "1g"   ;
: 10g   "10g"   ;
: 100g  "100g"  ;
: 1000g "1000g" ;

: _1g    "_1g"   ;
: _10g   "_10g"   ;
: _100g  "_100g"  ;
: _1000g "_1000g" ;

// the tables
: Pu10k  "Pu10k"  ;
: Pu100k "Pu100k" ;
: Pu1m   "Pu1m"   ;
: Pu10m  "Pu10m"  ;

: t:Pu10k  "Pu10k"  ;
: t:Pu100k "Pu100k" ;
: t:Pu1m   "Pu1m"   ;
: t:Pu10m  "Pu10m"  ;

: j:Pu10k  "Pu10k"  ;
: j:Pu100k "Pu100k" ;
: j:Pu1m   "Pu1m"   ;
: j:Pu10m  "Pu10m"  ;




// -- ops -----------------------------------------------

// the ops
: +scan   "      scan"        >> ;
: +filter "    | filter 1"    >> ;
: +join   "    | indexJoin 1" >> ;
: +aggreg "    | aggreg 1"    >> ;


// -- X scan --------------------------------------------

: (scan) "scan" string0[].set 1 to Counter0[] ;

// -- X t -----------------------------------------------

: t(Pu10k)  1 to Counter1[] "t(Pu10k)"  string1[].set ;
: t(Pu100k) 2 to Counter1[] "t(Pu100k)" string1[].set ;
: t(Pu1m)   3 to Counter1[] "t(Pu1m)"   string1[].set ;
: t(Pu10m)  4 to Counter1[] "t(Pu10m)"  string1[].set ;

// -- X tf -----------------------------------------------

: ft(0.1) 1 to Counter2[] "ft(0.1)" string2[].set ;
: ft(0.3) 2 to Counter2[] "ft(0.3)" string2[].set ;
: ft(0.6) 3 to Counter2[] "ft(0.6)" string2[].set ;
: ft(0.9) 4 to Counter2[] "ft(0.9)" string2[].set ;

// -- X t -----------------------------------------------

: j(Pu10k)  1 to Counter3[] "j(Pu10k)"  string3[].set ;
: j(Pu100k) 2 to Counter3[] "j(Pu100k)" string3[].set ;
: j(Pu1m)   3 to Counter3[] "j(Pu1m)"   string3[].set ;
: j(Pu10m)  4 to Counter3[] "j(Pu10m)"  string3[].set ;

// -- X jf -----------------------------------------------

: fj(0.1) 1 to Counter4[] "ft(0.1)" string4[].set ;
: fj(0.3) 2 to Counter4[] "ft(0.3)" string4[].set ;
: fj(0.6) 3 to Counter4[] "ft(0.6)" string4[].set ;
: fj(0.9) 4 to Counter4[] "ft(0.9)" string4[].set ;

// -- X g -----------------------------------------------

: g(1)    1 to Counter5[] "g(1)"    string5[].set ;
: g(10)   2 to Counter5[] "g(10)"   string5[].set ;
: g(100)  3 to Counter5[] "g(100)"  string5[].set ;
: g(1000) 4 to Counter5[] "g(1000)" string5[].set ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -


//expr example: type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and
//key example: " \"EQUAL $I1 $L1 ==\"" >> ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

// ft filter expr
: !ft_0_1_Pu10k  " \"type boolean pu10k_ft 100 <=\"" >> ;  // 10% of t.Pu10K
: !ft_0_3_Pu10k  " \"type boolean pu10k_ft 300 <=\"" >> ;  // 30% of t.Pu10K
: !ft_0_6_Pu10k  " \"type boolean pu10k_ft 600 <=\"" >> ;  // 60% of t.Pu10K
: !ft_0_9_Pu10k  " \"type boolean pu10k_ft 900 <=\"" >> ;  // 90% of t.Pu10K

: !ft_0_1_Pu100k " \"type boolean pu100k_ft 100 <=\"" >> ; // 10% of t.Pu100K
: !ft_0_3_Pu100k " \"type boolean pu100k_ft 300 <=\"" >> ; // 30% of t.Pu100K
: !ft_0_6_Pu100k " \"type boolean pu100k_ft 600 <=\"" >> ; // 60% of t.Pu100K
: !ft_0_9_Pu100k " \"type boolean pu100k_ft 900 <=\"" >> ; // 90% of t.Pu100K

: !ft_0_1_Pu1m   " \"type boolean pu1m_ft 100 <=\"" >> ;   // 10% of t.Pu1m
: !ft_0_3_Pu1m   " \"type boolean pu1m_ft 300 <=\"" >> ;   // 30% of t.Pu1m
: !ft_0_6_Pu1m   " \"type boolean pu1m_ft 600 <=\"" >> ;   // 60% of t.Pu1m
: !ft_0_9_Pu1m   " \"type boolean pu1m_ft 900 <=\"" >> ;   // 90% of t.Pu1m

: !ft_0_1_Pu10m  " \"type boolean pu10m_ft 100 <=\"" >> ;  // 10% of t.Pu10m
: !ft_0_3_Pu10m  " \"type boolean pu10m_ft 300 <=\"" >> ;  // 30% of t.Pu10m
: !ft_0_6_Pu10m  " \"type boolean pu10m_ft 600 <=\"" >> ;  // 60% of t.Pu10m
: !ft_0_9_Pu10m  " \"type boolean pu10m_ft 900 <=\"" >> ;  // 90% of t.Pu10m



// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: !key_Pu10k_Pu10k   " \"BOUND $I1 pu10k_10k ==\""  >> ; // what key
: !key_Pu10k_Pu100k  " \"BOUND $I1 pu10k_10k ==\""  >> ;
: !key_Pu10k_Pu1m    " \"BOUND $I1 pu10k_10k ==\""  >> ;
: !key_Pu10k_Pu10m   " \"BOUND $I1 pu10k_10k ==\""  >> ;

: !key_Pu100k_Pu10k  " \"BOUND $I1 pu100k_10k ==\""  >> ;
: !key_Pu100k_Pu100k " \"BOUND $I1 pu100k_100k ==\""  >> ;
: !key_Pu100k_Pu1m   " \"BOUND $I1 pu100k_100k ==\""  >> ;
: !key_Pu100k_Pu10m  " \"BOUND $I1 pu100k_100k ==\""  >> ;

: !key_Pu1m_Pu10k    " \"BOUND $I1 pu1m_10k ==\""  >> ;
: !key_Pu1m_Pu100k   " \"BOUND $I1 pu1m_100k ==\""  >> ;
: !key_Pu1m_Pu1m     " \"BOUND $I1 pu1m_1m ==\""  >> ;
: !key_Pu1m_Pu10m    " \"BOUND $I1 pu1m_1m ==\""  >> ;

: !key_Pu10m_Pu10k   " \"BOUND $I1 pu10m_10k ==\""  >> ;
: !key_Pu10m_Pu100k  " \"BOUND $I1 pu10m_100k ==\""  >> ;
: !key_Pu10m_Pu1m    " \"BOUND $I1 pu10m_1m ==\""  >> ;
: !key_Pu10m_Pu10m   " \"BOUND $I1 pu10m_10m ==\""  >> ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: !fj_0_1_Pu10k  " \"type boolean j1.pu10k_fj 100 <=\"" >> ; // 10% of j.Pu10K
: !fj_0_3_Pu10k  " \"type boolean j1.pu10k_fj 300 <=\"" >> ; // 30% of j.Pu10K
: !fj_0_6_Pu10k  " \"type boolean j1.pu10k_fj 600 <=\"" >> ; // 60% of j.Pu10K
: !fj_0_9_Pu10k  " \"type boolean j1.pu10k_fj 900 <=\"" >> ; // 90% of j.Pu10K

: !fj_0_1_Pu100k " \"type boolean j1.pu100k_fj 100 <=\"" >> ; // 10% of j.Pu100K
: !fj_0_3_Pu100k " \"type boolean j1.pu100k_fj 300 <=\"" >> ; // 30% of j.Pu100K
: !fj_0_6_Pu100k " \"type boolean j1.pu100k_fj 600 <=\"" >> ; // 60% of j.Pu100K
: !fj_0_9_Pu100k " \"type boolean j1.pu100k_fj 900 <=\"" >> ; // 90% of j.Pu100K

: !fj_0_1_Pu1m   " \"type boolean j1.pu1m_fj 100 <=\"" >> ; // 10% of j.Pu1m
: !fj_0_3_Pu1m   " \"type boolean j1.pu1m_fj 300 <=\"" >> ; // 30% of j.Pu1m
: !fj_0_6_Pu1m   " \"type boolean j1.pu1m_fj 600 <=\"" >> ; // 60% of j.Pu1m
: !fj_0_9_Pu1m   " \"type boolean j1.pu1m_fj 900 <=\"" >> ; // 90% of j.Pu1m

: !fj_0_1_Pu10m  " \"type boolean j1.pu10m_fj 100 <=\"" >> ; // 10% of j.Pu10m
: !fj_0_3_Pu10m  " \"type boolean j1.pu10m_fj 300 <=\"" >> ; // 30% of j.Pu10m
: !fj_0_6_Pu10m  " \"type boolean j1.pu10m_fj 600 <=\"" >> ; // 60% of j.Pu10m
: !fj_0_9_Pu10m  " \"type boolean j1.pu10m_fj 900 <=\"" >> ; // 90% of j.Pu10m

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: !agg_Pu10k_1g     " \"type integer pu10k_1g , type integer ) pu10k_10k sum"  >> ;
: !agg_Pu10k_10g    " \"type integer pu10k_10g , type integer ) pu10k_10k sum"  >> ;
: !agg_Pu10k_100g   " \"type integer pu10k_100g , type integer ) pu10k_10k sum"  >> ;
: !agg_Pu10k_1000g  " \"type integer pu10k_1000g , type integer ) pu10k_10k sum"  >> ;

: !agg_Pu100k_1g    " \"type integer pu100k_1g , type integer ) pu100k_100k sum"  >> ;
: !agg_Pu100k_10g   " \"type integer pu100k_10g , type integer ) pu100k_100k sum"  >> ;
: !agg_Pu100k_100g  " \"type integer pu100k_100g , type integer ) pu100k_100k sum"  >> ;
: !agg_Pu100k_1000g " \"type integer pu100k_1000g , type integer ) pu100k_100k sum"  >> ;

: !agg_Pu1m_1g      " \"type integer pu1m_1g , type integer ) pu1m_1m sum"  >> ;
: !agg_Pu1m_10g     " \"type integer pu1m_10g , type integer ) pu1m_1m sum"  >> ;
: !agg_Pu1m_100g    " \"type integer pu1m_100g , type integer ) pu1m_1m sum"  >> ;
: !agg_Pu1m_1000g   " \"type integer pu1m_1000g , type integer ) pu1m_1m sum"  >> ;

: !agg_Pu10m_1g     " \"type integer pu10m_1g , type integer ) pu10m_10m sum"  >> ;
: !agg_Pu10m_10g    " \"type integer pu10m_10g , type integer ) pu10m_10m sum"  >> ;
: !agg_Pu10m_100g   " \"type integer pu10m_100g , type integer ) pu10m_10m sum"  >> ;
: !agg_Pu10m_1000g  " \"type integer pu10m_1000g , type integer ) pu10m_10m sum"  >> ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: !gby_Pu10k_1g     " groupby type integer pu10k_1g\"" >> ;
: !gby_Pu10k_10g    " groupby type integer pu10k_10g\"" >> ;
: !gby_Pu10k_100g   " groupby type integer pu10k_100g\"" >> ;
: !gby_Pu10k_1000g  " groupby type integer pu10k_1000g\"" >> ;

: !gby_Pu100k_1g    " groupby type integer pu100k_1g\"" >> ;
: !gby_Pu100k_10g   " groupby type integer pu100k_10g\"" >> ;
: !gby_Pu100k_100g  " groupby type integer pu100k_100g\"" >> ;
: !gby_Pu100k_1000g " groupby type integer pu100k_1000g\"" >> ;

: !gby_Pu1m_1g      " groupby type integer pu1m_1g\"" >> ;
: !gby_Pu1m_10g     " groupby type integer pu1m_10g\"" >> ;
: !gby_Pu1m_100g    " groupby type integer pu1m_100g\"" >> ;
: !gby_Pu1m_1000g   " groupby type integer pu1m_1000g\"" >> ;

: !gby_Pu10m_1g     " groupby type integer pu10m_1g\"" >> ;
: !gby_Pu10m_10g    " groupby type integer pu10m_10g\"" >> ;
: !gby_Pu10m_100g   " groupby type integer pu10m_100g\"" >> ;
: !gby_Pu10m_1000g  " groupby type integer pu10m_1000g\"" >> ;




: +Pu10k  " " >> Pu10k  >> ;
: +Pu100k " " >> Pu100k >> ;
: +Pu1m   " " >> Pu1m   >> ;
: +Pu10m  " " >> Pu10m  >> ;


/*----------------------------------------------------------------------------*/
/* form full pipeline statement                                               */
/*----------------------------------------------------------------------------*/
: pu_pipeline params| sStreamB |
  
   counterA[] 1 + to counterA[]
   
   counterA[] locals| iTest   |
   counter0[] locals| iSubset |
   counter1[] locals| iT      |
   counter2[] locals| iFt     |
   counter3[] locals| iJ      |
   counter4[] locals| iFj     |
   counter5[] locals| iGroups |

  "\n"
  "// - - - - - - - - - - - - - - - - - - - - - -" >>
  " - - - - - - - - - - - - - - - - - - - - - - -" >> nl

  "// pu test "     >>
    /* pu     */ iTest >str >>
                 " : "       >>
    /* puSet  */ iSubset [n] string0[] +x >>
    /* t      */ iT      [n] string1[] +x >>
    /* ft     */ iFt     [n] string2[] +x >>
    /* j      */ iJ      [n] string3[] +x >>
    /* fj     */ iFj     [n] string4[] +x >>
    /* groups */ iGroups [n] string5[] sp >>
    nl
    
  "// - - - - - - - - - - - - - - - - - - - - - -" >>
  " - - - - - - - - - - - - - - - - - - - - - - -" >> nl

  
  "pipeline pu" >> counterA[] >str      >> nl
  "begin"                               >> nl
  "  stage stageA on origin :"          >> nl
  "      start"                         >> nl
  "    | pulse once"                    >> nl
  "    | stageB"                        >> nl
  "  stage stageB on all partitions :"  >> nl
         sStreamB                       >>
  "    | stageC"                        >> nl
  "  stage stageC on origin :"          >> nl
  "      output"                        >> nl
  "    | sink"                          >> nl
  "    | stageA"                        >> nl
  "end"                                 >> nl
  ";"                                   >> nl
  locals| sPipeline |


  STD_PATH_TAG
  "    <pu_test> = "   iTest   >str >>  >> nl
  "    <pu_subset> = " iSubSet >str >>  >> nl
  "    <pu_t> = "      iT      >str >>  >> nl
  "    <pu_ft> = "     iFt     >str >>  >> nl
  "    <pu_j> = "      iJ      >str >>  >> nl
  "    <pu_fj> = "     iFj     >str >>  >> nl
  "    <pu_groups> = " iGroups >str >>  >> nl
  locals| sTags |

  sPipeline .
  
  sPipeline File0[] file.writeLine
  
//  sTags sPipeline api::executeCommand
//
//    //2discard
//     discard
//       "JobRep %v " str.format
//         STD_PATH_TAG swap api::executeCommand 2discard
//
//  true api::reapJobs
;

/*----------------------------------------------------------------------------*/
/* 5[] each gby ...                                                           */
/*----------------------------------------------------------------------------*/
: pu_agggby params| j t s |
  
  // X         op                                                           next
  g(1)         s +aggreg
                 "!agg_" t >> _1g >> fx
                 "!gby_" t >> _1g >> fx nl                           pu_pipeline



;

/*----------------------------------------------------------------------------*/
/* 4[] each j-filter ...                                                      */
/*----------------------------------------------------------------------------*/
: pu_jFilter params| j t s |

  //j t s "pu_jFilter: s=%v ; t %v; j %v\n" .printf

  // X         +op                                                args      next
  fj(0.1)      s +filter
                 "!fj_0_1_" j >> fx nl                             t j pu_agggby
//  fj(0.3)      s +filter "!fj_0_3_" j >> fx nl                   t j pu_agggby
//  fj(0.6)      s +filter "!fj_0_6_" j >> fx nl                   t j pu_agggby
//  fj(0.9)      s +filter "!fj_0_9_" j >> fx nl                   t j pu_agggby
;

/*----------------------------------------------------------------------------*/
/* 3[] each j-join ...                                                        */
/*----------------------------------------------------------------------------*/
: pu_join params| t s |

  //t s "pu_join: s=%v ; t %v\n" .printf
  
  // X         +op                                               args       next
  j(Pu10k)     s +join +Pu10k sp
                 t "_Pu10k" >> >>
                 "!key_" t >> "_Pu10k" >> fx nl             j:Pu10k t pu_jFilter
    
;

/*----------------------------------------------------------------------------*/
/* 2[] each t-filter ...                                                      */
/*----------------------------------------------------------------------------*/
: pu_tFilter params| t s |
  
  //t s "pu_jFilter: s=%v ; t %v\n" .printf
  
  // X         +op                                                  args    next
  ft(0.1)      s +filter "!ft_0_1_" t >> fx nl                         t pu_join
//  ft(0.3)      s +filter "!ft_0_3_" t >> fx nl                       t pu_join
//  ft(0.6)      s +filter "!ft_0_6_" t >> fx nl                       t pu_join
//  ft(0.9)      s +filter "!ft_0_9_" t >> fx nl                       t pu_join
;

/*----------------------------------------------------------------------------*/
/* 1[]: each t-scan ...                                                       */
/*----------------------------------------------------------------------------*/
: pu_tScan params| s |

  // X         + op                                              args       next
  t(Pu10k)     s +scan +Pu10k  nl                            t:Pu10k  pu_tFilter
//t(Pu100k)    s +scan +Pu100k nl                            t:Pu100k pu_tFilter
//t(Pu1m)      s +scan +Pu1m   nl                            t:Pu1m   pu_tFilter
//t(Pu10m)     s +scan +Pu10m  nl                            t:Pu10m  pu_tFilter
;

/*----------------------------------------------------------------------------*/
/* 0[]: foreach test                                                          */
/*----------------------------------------------------------------------------*/
: pu_test

  (scan) "" pu_tScan
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* generate pu tests                                                          */
/*----------------------------------------------------------------------------*/
: pu_gen \prompt

  file::new to file0[]
  
  "/tmp/_pu_run.txt" OPEN_WRITE file0[] file.open
  
  1 >a pu_test adiscard
  
  // "" 2 pu_indexScan

  file0[].get file.close
  
  counterA[] "pu_gen: %v pipelines generated\n" .printf
;

pu_gen

Path[].Restore

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
