/*============================================================================*/
/* pu_gen2.sen -- Power Unit Testing                                          */
/*============================================================================*/

" pu_gen2.sen" .

Path[].save
Path[].root

: >> str.cat ;
: nl "\n" str.cat ;
: sp " "  str.cat ;

: Pu10k  "Pu10k"  ;
: Pu100k "Pu100k" ;
: Pu1m   "Pu1m"   ;
: Pu10m  "Pu10m"  ;

: +Pu10k  " " >> Pu10k  >> ;
: +Pu100k " " >> Pu100k >> ;
: +Pu1m   " " >> Pu1m   >> ;
: +Pu10m  " " >> Pu10m  >> ;

: +scan   "      scan" ;

: +join "    | indexJoin 1" >> ;


: +Pu10k_idx  " Pu10k idx"  >> ;
: +Pu100k_idx " Pu100k idx" >> ;
: +Pu1m_idx   " Pu1m idx"   >> ;
: +Pu10m_idx  " Pu10m idx"  >> ;

: +filter  "    | filter 1" >> ;
  // type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and

: pre_0_1 "pre_0_1" ;
: pre_0_3 "pre_0_3" ;
: pre_0_6 "pre_0_6" ;
: pre_0_9 "pre_0_9" ;

: +pre_0_1_Pu10k  " pre_0_1_Pu10k"  >> ;
: +pre_0_3_Pu10k  " pre_0_3_Pu10k"  >> ;
: +pre_0_6_Pu10k  " pre_0_6_Pu10k"  >> ;
: +pre_0_9_Pu10k  " pre_0_9_Pu10k"  >> ;

: +pre_0_1_Pu100k " pre_0_1_Pu100k" >> ;
: +pre_0_3_Pu100k " pre_0_3_Pu100k" >> ;
: +pre_0_6_Pu100k " pre_0_6_Pu100k" >> ;
: +pre_0_9_Pu100k " pre_0_9_Pu100k" >> ;

: +pre_0_1_Pu1m   " pre_0_1_Pu1m"   >> ;
: +pre_0_3_Pu1m   " pre_0_3_Pu1m"   >> ;
: +pre_0_6_Pu1m   " pre_0_6_Pu1m"   >> ;
: +pre_0_9_Pu1m   " pre_0_9_Pu1m"   >> ;

: +pre_0_1_Pu10m  " pre_0_1_Pu10m"  >> ;
: +pre_0_3_Pu10m  " pre_0_3_Pu10m"  >> ;
: +pre_0_6_Pu10m  " pre_0_6_Pu10m"  >> ;
: +pre_0_9_Pu10m  " pre_0_9_Pu10m"  >> ;

: +idx " idx"  >> ;

: idx "idx" ;

: +idx_Pu10k_Pu10k   " idx_Pu10k_Pu10k"   >> ;
: +idx_Pu10k_Pu100k  " idx_Pu10k_Pu100k"  >> ;
: +idx_Pu10k_Pu1m    " idx_Pu10k_Pu1m"    >> ;
: +idx_Pu10k_Pu10m   " idx_Pu10k_Pu10m"   >> ;

: +idx_Pu100k_Pu10k  " idx_Pu100k_Pu10k"  >> ;
: +idx_Pu100k_Pu100k " idx_Pu100k_Pu100k" >> ;
: +idx_Pu100k_Pu1m   " idx_Pu100k_Pu1m"   >> ;
: +idx_Pu100k_Pu10m  " idx_Pu100k_Pu10m"  >> ;

: +idx_Pu1m_Pu10k    " idx_Pu1m_Pu10k"    >> ;
: +idx_Pu1m_Pu100k   " idx_Pu1m_Pu100k"   >> ;
: +idx_Pu1m_Pu1m     " idx_Pu1m_Pu1m"     >> ;
: +idx_Pu1m_Pu10m    " idx_Pu1m_Pu10m"    >> ;

: +idx_Pu10m_Pu10k   " idx_Pu10m_Pu10k"   >> ;
: +idx_Pu10m_Pu100k  " idx_Pu10m_Pu100k"  >> ;
: +idx_Pu10m_Pu1m    " idx_Pu10m_Pu1m"    >> ;
: +idx_Pu10m_Pu10m   " idx_Pu10m_Pu10m"   >> ;

: +key " \"EQUAL $I1 $L1 ==\"" >> ;


: pst_0_1 "pst_0_1" ;
: pst_0_3 "pst_0_3" ;
: pst_0_6 "pst_0_6" ;
: pst_0_9 "pst_0_9" ;

: +pst_0_1_Pu10k  " pst_0_1_Pu10k"  >> ;
: +pst_0_3_Pu10k  " pst_0_3_Pu10k"  >> ;
: +pst_0_6_Pu10k  " pst_0_6_Pu10k"  >> ;
: +pst_0_9_Pu10k  " pst_0_9_Pu10k"  >> ;

: +pst_0_1_Pu100k " pst_0_1_Pu100k" >> ;
: +pst_0_3_Pu100k " pst_0_3_Pu100k" >> ;
: +pst_0_6_Pu100k " pst_0_6_Pu100k" >> ;
: +pst_0_9_Pu100k " pst_0_9_Pu100k" >> ;

: +pst_0_1_Pu1m   " pst_0_1_Pu1m"   >> ;
: +pst_0_3_Pu1m   " pst_0_3_Pu1m"   >> ;
: +pst_0_6_Pu1m   " pst_0_6_Pu1m"   >> ;
: +pst_0_9_Pu1m   " pst_0_9_Pu1m"   >> ;

: +pst_0_1_Pu10m  " pst_0_1_Pu10m"  >> ;
: +pst_0_3_Pu10m  " pst_0_3_Pu10m"  >> ;
: +pst_0_6_Pu10m  " pst_0_6_Pu10m"  >> ;
: +pst_0_9_Pu10m  " pst_0_9_Pu10m"  >> ;

: +aggreg "    | aggreg 1" >> ;

: +agg " agg" >> ;

: +gby_1    " gby_1"    >> ;
: +gby_10   " gby_10"   >> ;
: +gby_100  " gby_100"  >> ;
: +gby_1000 " gby_1000" >> ;

: gen      a> 1 + >a ;
: test_00   a0 100 * >a ;
: test_000  a0 1000 * >a ;
: tested    adiscard ;


: fx find execute ;

: _+ "+" swap >> ;

: __ "_" swap >> >> ;

/*----------------------------------------------------------------------------*/
/* form full pipeline statement                                               */
/*----------------------------------------------------------------------------*/
: pu_pipeline params| sStreamB |
  
  "pipeline pu0" a0 >str               >> nl
  "begin"                              >> nl
  "  stage stageA on origin :"         >> nl
  "      start"                        >> nl
  "    | pulse once"                   >> nl
  "    | stageB"                       >> nl
  "  stage stageB on all partitions :" >> nl
         sStreamB                      >>
  "    | stageC"                       >> nl
  "  stage stageC on origin :"         >> nl
  "      sink"                         >> nl
  "    | stageA"                       >> nl
  " end ;"                             >> nl

  .
  
  counter0[] 1 + to counter0[]
;

/*----------------------------------------------------------------------------*/
/* append aggreg -- scan | filter | join | filter | aggreg                    */
/*----------------------------------------------------------------------------*/
: pu_agggby params| j t s |
                                               test_00
  s +aggreg +agg +gby_1    nl                  ( ) gen pu_pipeline
  s +aggreg +agg +gby_10   nl                  ( ) gen pu_pipeline
  s +aggreg +agg +gby_100  nl                  ( ) gen pu_pipeline
  s +aggreg +agg +gby_1000 nl                  ( ) gen pu_pipeline
                                               tested
;

/*----------------------------------------------------------------------------*/
/* append post-filter -- scan | filter | join | filter                        */
/*----------------------------------------------------------------------------*/
: pu_pstFilter params| j t s |
                                               test_00
  s +filter "+" pst_0_1 t __ >> fx nl          ( ) gen t j pu_agggby
  s +filter "+" pst_0_3 t __ >> fx nl          ( ) gen t j pu_agggby
  s +filter "+" pst_0_6 t __ >> fx nl          ( ) gen t j pu_agggby
  s +filter "+" pst_0_9 t __ >> fx nl          ( ) gen t j pu_agggby
                                               tested
;

/*----------------------------------------------------------------------------*/
/* append join -- scan | filter | join                                        */
/*----------------------------------------------------------------------------*/
: pu_join params| t s |
                                               test_00
  s +join +Pu10k
    "+" idx t __ Pu10k  __ >> fx
    +key nl                                    ( ) gen t Pu10k  pu_pstFilter
  s +join +Pu100k
    "+" idx t __ Pu100k __ >> fx
    +key nl                                    ( ) gen t Pu100k pu_pstFilter
  s +join +Pu1m
    "+" idx t __ Pu1m   __ >> fx
    +key nl                                    ( ) gen t Pu1m   pu_pstFilter
  s +join +Pu10m
    "+" idx t __ Pu10m  __ >>
    fx +key nl                                 ( ) gen t Pu10m  pu_pstFilter
                                               tested
;

/*----------------------------------------------------------------------------*/
/* append pre-filter -- scan | filter                                         */
/*----------------------------------------------------------------------------*/
: pu_preFilter params| t s |
                                               test_00
  s +filter "+" pre_0_1 t __ >> fx nl          ( ) gen t pu_join
  s +filter "+" pre_0_3 t __ >> fx nl          ( ) gen t pu_join
  s +filter "+" pre_0_6 t __ >> fx nl          ( ) gen t pu_join
  s +filter "+" pre_0_9 t __ >> fx nl          ( ) gen t pu_join
                                               tested
;

/*----------------------------------------------------------------------------*/
/*  append scan -- scan                                                       */
/*----------------------------------------------------------------------------*/
: pu_scan params| s |
                                               test_000
  s +scan +Pu10k  nl                           ( ) gen Pu10k  pu_preFilter
  s +scan +Pu100k nl                           ( ) gen Pu100k pu_preFilter
  s +scan +Pu1m   nl                           ( ) gen Pu1m   pu_preFilter
  s +scan +Pu10m  nl                           ( ) gen Pu10m  pu_preFilter
                                               tested
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pu_begin

  1 >a "" pu_scan adiscard
  
  // "" 2 pu_indexScan


  counter0[] .
;

/*----------------------------------------------------------------------------*/
/* generate pu tests                                                          */
/*----------------------------------------------------------------------------*/
: pu_gen \prompt

  pu_begin
;

/*----------------------------------------------------------------------------*/
/* run pu tests                                                               */
/*----------------------------------------------------------------------------*/
: pu_run \prompt

;


pu_gen

Path[].Restore

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
