/*============================================================================*/
/* pu_gen2.sen -- Power Unit Testing                                          */
/*============================================================================*/

" pu_gen2.sen" .

Path[].save
Path[].root

: >> str.cat ;
: nl "\n" str.cat ;
: sp " "  str.cat ;

: Pu10k  "Pu10k"  ;
: Pu100k "Pu100k" ;
: Pu1m   "Pu1m"   ;
: Pu10m  "Pu10m"  ;

: +Pu10k  " " >> Pu10k  >> ;
: +Pu100k " " >> Pu100k >> ;
: +Pu1m   " " >> Pu1m   >> ;
: +Pu10m  " " >> Pu10m  >> ;

: +scan   "      scan" ;

: +join "    | indexJoin 1" >> ;

: +idx " idx"  >> ;

: +Pu10k_idx  " Pu10k idx"  >> ;
: +Pu100k_idx " Pu100k idx" >> ;
: +Pu1m_idx   " Pu1m idx"   >> ;
: +Pu10m_idx  " Pu10m idx"  >> ;

: +filter  "    | filter 1" >> ;
  // type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and

: +pre_0_1 " pre_0_1" >> ;
: +pre_0_3 " pre_0_3" >> ;
: +pre_0_6 " pre_0_6" >> ;
: +pre_0_9 " pre_0_9" >> ;

: +pre_0_1+10k  " pre_0_1+10k"  >> ;
: +pre_0_3+10k  " pre_0_3+10k"  >> ;
: +pre_0_6+10k  " pre_0_6+10k"  >> ;
: +pre_0_9+10k  " pre_0_9+10k"  >> ;

: +pre_0_1+100k " pre_0_1+100k" >> ;
: +pre_0_3+100k " pre_0_3+100k" >> ;
: +pre_0_6+100k " pre_0_6+100k" >> ;
: +pre_0_9+100k " pre_0_9+100k" >> ;

: +pre_0_1+1m   " pre_0_1+1m"   >> ;
: +pre_0_3+1m   " pre_0_3+1m"   >> ;
: +pre_0_6+1m   " pre_0_6+1m"   >> ;
: +pre_0_9+1m   " pre_0_9+1m"   >> ;

: +pre_1+10m    " pre_1+10m"    >> ;
: +pre_3+10m    " pre_3+10m"    >> ;
: +pre_6+10m    " pre_6+10m"    >> ;
: +pre_9+10m    " pre_9+10m"    >> ;

: +key " \"EQUAL $I1 $L1 ==\"" >> ;

: +pst_0_1+10k  " pst_0_1+10k"  >> ;
: +pst_0_3+10k  " pst_0_3+10k"  >> ;
: +pst_0_6+10k  " pst_0_6+10k"  >> ;
: +pst_0_9+10k  " pst_0_9+10k"  >> ;

: +pst_0_1+100k " pst_0_1+100k" >> ;
: +pst_0_3+100k " pst_0_3+100k" >> ;
: +pst_0_6+100k " pst_0_6+100k" >> ;
: +pst_0_9+100k " pst_0_9+100k" >> ;

: +pst_0_1+1m   " pst_0_1+1m"   >> ;
: +pst_0_3+1m   " pst_0_3+1m"   >> ;
: +pst_0_6+1m   " pst_0_6+1m"   >> ;
: +pst_0_9+1m   " pst_0_9+1m"   >> ;

: +pst_0_1+10m  " pst_0_1+10m"  >> ;
: +pst_0_3+10m  " pst_0_3+10m"  >> ;
: +pst_0_6+10m  " pst_0_6+10m"  >> ;
: +pst_0_9+10m  " pst_0_9+10m"  >> ;

: +pst_0_1   " pst_0_1" >> ;
: +pst_0_3   " pst_0_3" >> ;
: +pst_0_6   " pst_0_6" >> ;
: +pst_0_9   " pst_0_9" >> ;


: +aggreg "    | aggreg 1" >> ;

: +agg " agg" >> ;

: +gby_1    " gby_1"    >> ;
: +gby_10   " gby_10"   >> ;
: +gby_100  " gby_100"  >> ;
: +gby_1000 " gby_1000" >> ;

: test    a> 1 + >a ;
: test_00   a0 100 * >a ;
: test_000  a0 1000 * >a ;
: tested    adiscard ;

: 2do >> find execute ;

/*----------------------------------------------------------------------------*/
/* pipeline pu<test> stageA on origin : <stage> | stageA ;                    */
/*----------------------------------------------------------------------------*/
: pu_pipeline params| sStream |
  
  "pipeline pu0" a0 >str               >> nl
  "begin"                              >> nl
  "  stage stageA on origin :"         >> nl
  "      start"                        >> nl
  "    | pulse once"                   >> nl
  "    | stageB"                       >> nl
  "  stage stageB on all partitions :" >> nl
         sStream                       >>
  "    | stageC"                       >> nl
  "  stage stageC on origin :"         >> nl
  "      sink"                         >> nl
  "    | stageA"                       >> nl
  " end ;"                             >> nl

  .
  
  counter0[] 1 + to counter0[]
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter | agggby                                     */
/*----------------------------------------------------------------------------*/
: pu_agggby params| j t s |

                                               test_00
  s +aggreg +agg +gby_1    nl                  ( ) test pu_pipeline
  s +aggreg +agg +gby_10   nl                  ( ) test pu_pipeline
  s +aggreg +agg +gby_100  nl                  ( ) test pu_pipeline
  s +aggreg +agg +gby_1000 nl                  ( ) test pu_pipeline
                                               tested
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter                                              */
/*----------------------------------------------------------------------------*/
: pu_pstFilter params| j t s |

                                               test_00
  s +filter +pst_0_1 nl                        ( ) test t j pu_agggby
  s +filter +pst_0_3 nl                        ( ) test t j pu_agggby
  s +filter +pst_0_6 nl                        ( ) test t j pu_agggby
  s +filter +pst_0_9 nl                        ( ) test t j pu_agggby
                                               tested
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join                                                       */
/*----------------------------------------------------------------------------*/
: pu_join params| t s |

                                               test_00
  s +join +Pu10k  +idx +key nl                 ( ) test t Pu10k  pu_pstFilter
  s +join +Pu100k +idx +key nl                 ( ) test t Pu100k pu_pstFilter
  s +join +Pu1m   +idx +key nl                 ( ) test t Pu1m   pu_pstFilter
  s +join +Pu10m  +idx +key nl                 ( ) test t Pu10m  pu_pstFilter
                                               tested
;

/*----------------------------------------------------------------------------*/
/* scan | filter                                                              */
/*----------------------------------------------------------------------------*/
: pu_preFilter params| t s |

                                               test_00
  s +filter +pre_0_1 nl                        ( ) test t pu_join
  s +filter +pre_0_3 nl                        ( ) test t pu_join
  s +filter +pre_0_6 nl                        ( ) test t pu_join
  s +filter +pre_0_9 nl                        ( ) test t pu_join
                                               tested
;

/*----------------------------------------------------------------------------*/
/*  scan                                                                      */
/*----------------------------------------------------------------------------*/
: pu_scan params| s |
    
                                               test_000
  s +scan +Pu10k  nl                           ( ) test Pu10k  pu_preFilter
  s +scan +Pu100k nl                           ( ) test Pu100k pu_preFilter
  s +scan +Pu1m   nl                           ( ) test Pu1m   pu_preFilter
  s +scan +Pu10m  nl                           ( ) test Pu10m  pu_preFilter
                                               tested
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pu_begin

  1 >a "" pu_scan adiscard
  
  // "" 2 pu_indexScan


  counter0[] .
;

/*----------------------------------------------------------------------------*/
/* generate pu tests                                                          */
/*----------------------------------------------------------------------------*/
: pu_gen \prompt

  pu_begin
;

/*----------------------------------------------------------------------------*/
/* run pu tests                                                               */
/*----------------------------------------------------------------------------*/
: pu_run \prompt

;

Path[].Restore

pu_gen

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
