/*============================================================================*/
/* pu_gen.sen -- Power Unit Testing                                           */
/*============================================================================*/

" pu_gen.sen" .

Path[].save
Path[].root

: >> str.cat ;
: nl "\n" str.cat ;
: sp " "  str.cat ;

: +scan   "      scan" ;

: +Pu10k  " Pu10k"  >> ;
: +Pu100k " Pu100k" >> ;
: +Pu1m   " Pu1m"   >> ;
: +Pu10m  " Pu10m"  >> ;

: +indexJoin "    | indexJoin 1" >> ;

: +idx " idx"  >> ;

: +Pu10k_idx  " Pu10k idx"  >> ;
: +Pu100k_idx " Pu100k idx" >> ;
: +Pu1m_idx   " Pu1m idx"   >> ;
: +Pu10m_idx  " Pu10m idx"  >> ;

: +filter  "    | filter 1" >> ;
  // type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and

: +pre_0_1 " pre_0_1" >> ;
: +pre_0_3 " pre_0_3" >> ;
: +pre_0_6 " pre_0_6" >> ;
: +pre_0_9 " pre_0_9" >> ;

: +join_key " \"EQUAL $I1 $L1 ==\"" >> ;

: +pst_0_1 " pst_0_1" >> ;
: +pst_0_3 " pst_0_3" >> ;
: +pst_0_6 " pst_0_6" >> ;
: +pst_0_9 " pst_0_9" >> ;

: +aggreg "    | aggreg 1" >> ;

: +agg " agg" >> ;

: +gby_1    " gby_1"    >> ;
: +gby_10   " gby_10"   >> ;
: +gby_100  " gby_100"  >> ;
: +gby_1000 " gby_1000" >> ;


/*----------------------------------------------------------------------------*/
/* pipeline pu<test> stageA on origin : <stage> | stageA ;                    */
/*----------------------------------------------------------------------------*/
: pu_pipeline params| iTest sStream |
  
  "pipeline pu0" iTest >str            >> nl
  "begin"                              >> nl
  "  stage stageA on origin :"         >> nl
  "      start"                        >> nl
  "    | pulse once"                   >> nl
  "    | stageB"                       >> nl
  "  stage stageB on all partitions :" >> nl
         sStream                       >>
  "    | stageC"                       >> nl
  "  stage stageC on origin :"         >> nl
  "      sink"                         >> nl
  "    | stageA"                       >> nl
  " end ;"                             >> nl

  .
  
  counter0[] 1 + to counter0[]
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter | agggby                                     */
/*----------------------------------------------------------------------------*/
: pu_agggby params| iTest sStream |

  iTest 100 * to iTest
    
  iTest 1 + to iTest sStream +aggreg +agg +gby_1  nl   iTest pu_pipeline
  iTest 1 + to iTest sStream +aggreg +agg +gby_10 nl   iTest pu_pipeline
  iTest 1 + to iTest sStream +aggreg +agg +gby_100 nl  iTest pu_pipeline
  iTest 1 + to iTest sStream +aggreg +agg +gby_1000 nl iTest pu_pipeline
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join | filter                                              */
/*----------------------------------------------------------------------------*/
: pu_postFilter params| iTest sStream |

  iTest 100 * to iTest
  
  iTest 1 + to iTest sStream +filter +pst_0_1 nl  iTest pu_agggby
  iTest 1 + to iTest sStream +filter +pst_0_3 nl  iTest pu_agggby
  iTest 1 + to iTest sStream +filter +pst_0_6 nl  iTest pu_agggby
  iTest 1 + to iTest sStream +filter +pst_0_9 nl  iTest pu_agggby
;

/*----------------------------------------------------------------------------*/
/* scan | filter | join                                                       */
/*----------------------------------------------------------------------------*/
: pu_join params| iTest sStream |

  iTest 100 * to iTest
  
  iTest 1 + to iTest sStream +indexJoin +Pu10k  +idx +join_key nl iTest pu_postFilter
  iTest 1 + to iTest sStream +indexJoin +Pu100k +idx +join_key nl iTest pu_postFilter
  iTest 1 + to iTest sStream +indexJoin +Pu1m   +idx +join_key nl iTest pu_postFilter
  iTest 1 + to iTest sStream +indexJoin +Pu10m  +idx +join_key nl iTest pu_postFilter
;

/*----------------------------------------------------------------------------*/
/* scan | filter                                                              */
/*----------------------------------------------------------------------------*/
: pu_preFilter params| iTest sStream |

  iTest 100 * to iTest
  
  iTest 1 + to iTest sStream +filter +pre_0_1 nl   iTest pu_join
  iTest 1 + to iTest sStream +filter +pre_0_3 nl   iTest pu_join
  iTest 1 + to iTest sStream +filter +pre_0_6 nl   iTest pu_join
  iTest 1 + to iTest sStream +filter +pre_0_9 nl   iTest pu_join
;

/*----------------------------------------------------------------------------*/
/*  scan                                                                      */
/*----------------------------------------------------------------------------*/
: pu_scan params| iTest sStream |
  
  iTest 1000 * to iTest
  
  iTest 1 + to iTest sStream +scan +Pu10k  nl    iTest pu_preFilter
  iTest 1 + to iTest sStream +scan +Pu100k nl    iTest pu_preFilter
  iTest 1 + to iTest sStream +scan +Pu1m   nl    iTest pu_preFilter
  iTest 1 + to iTest sStream +scan +Pu10m  nl    iTest pu_preFilter
;

/*----------------------------------------------------------------------------*/
/* range interval                                                             */
/*----------------------------------------------------------------------------*/
: pu_interval params| iTest sStream |
  
  iTest 100 * to iTest
  
  // - - - - - - - - - - - -
  // interval 0.001
  
  iTest 1 + to iTest
    sStream
      " // interval 0.001" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.003
  
  iTest 1 + to iTest
    sStream
      " // interval 0.003" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.006
  
  iTest 1 + to iTest
    sStream
      " // interval 0.006" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.009
  
  iTest 1 + to iTest
    sStream
      " // interval 0.009" str.cat
    iTest pu_preFilter
    
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // - - - - - - - - - - - -
  // interval 0.01

  iTest 1 + to iTest
    sStream
      " // interval 0.01" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.03

  iTest 1 + to iTest
    sStream
      " // interval 0.03" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.06

  iTest 1 + to iTest
    sStream
      " // interval 0.06" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.09

  iTest 1 + to iTest
    sStream
      " // interval 0.09" str.cat
    iTest pu_preFilter
    

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  // - - - - - - - - - - - -
  // interval 0.1

  iTest 1 + to iTest
    sStream
      " // interval 0.1" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.3

  iTest 1 + to iTest
    sStream
      " // interval 0.3" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.6

  iTest 1 + to iTest
    sStream
      " // interval 0.6" str.cat
    iTest pu_preFilter

  // - - - - - - - - - - - -
  // interval 0.9

  iTest 1 + to iTest
    sStream
      " // interval 0.9" str.cat
    iTest pu_preFilter
;

/*----------------------------------------------------------------------------*/
/*  indexScan                                                                 */
/*----------------------------------------------------------------------------*/
: pu_indexScan params| iTest sStream |
  
  iTest 100 * to iTest
  
  // - - - - - - - - - - - -
  // indexScan Pu10k
  
  iTest 1 + to iTest
    sStream
      "indexScan 1 Pu10k idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
      iTest pu_interval

  // - - - - - - - - - - - -
  // indexScan Pu100k
  
  iTest 1 + to iTest
    sStream
      "indexScan 1 Pu100k idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval

  // - - - - - - - - - - - -
  // indexScan Pu1m
  
  iTest 1 + to iTest
    sStream
      "indexScan 1 Pu1m idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval

  // - - - - - - - - - - - -
  // indexScan Pu10m
  
  iTest 1 + to iTest
    sStream
      "indexScan 1 Pu10m idx \"LBOUND $I1 1 > UBOUND $I1 10 <= \" " str.cat
    iTest pu_interval
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pu_begin

  "" 1 pu_scan
  
  // "" 2 pu_indexScan

  counter0[] .
;

/*----------------------------------------------------------------------------*/
/* generate pu tests                                                          */
/*----------------------------------------------------------------------------*/
: pu_gen \prompt

  pu_begin
;

/*----------------------------------------------------------------------------*/
/* run pu tests                                                               */
/*----------------------------------------------------------------------------*/
: pu_run \prompt

;

Path[].Restore

pu_gen

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
