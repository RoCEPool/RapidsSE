/*============================================================================*/
/* pu_gen.sen -- Power Unit Testing                                           */
/*============================================================================*/

" pu_gen.sen" .

Path[].save
Path[].root

: >> str.cat ;
: nl "\n" str.cat ;
: sp " "  str.cat ;
: +x " x " str.cat ;
: fx find execute ;
: _+ "+" swap >> ;
: __ "_" swap >> >> ;

: [n] >str "[" swap >> >> "]" >> ;


: scan    "      scan"           ;
: +filter "    | filter 1"    >> ;
: +join   "    | indexJoin 1" >> ;
: +aggreg "    | aggreg 1"    >> ;

: Pu10k  "Pu10k"  ;
: Pu100k "Pu100k" ;
: Pu1m   "Pu1m"   ;
: Pu10m  "Pu10m"  ;

: t:Pu10k  "t(Pu10k)"  string1[].set ;
: t:Pu100k "t(Pu100k)" string1[].set ;
: t:Pu1m   "t(Pu1m)"   string1[].set ;
: t:Pu10m  "t(Pu10m)"  string1[].set ;

: j:Pu10k  "j(Pu10k)"  string3[].set ;
: j:Pu100k "j(Pu100k)" string3[].set ;
: j:Pu1m   "j(Pu1m)"   string3[].set ;
: j:Pu10m  "j(Pu10m)"  string3[].set ;

: g:1      "g(1)"      string5[].set ;
: g:10     "g(10)"     string5[].set ;
: g:100    "g(100)"    string5[].set ;
: g:1000   "g(1000)"   string5[].set ;

: >c0 to Counter0[] ;
: >c1 to Counter1[] ;
: >c2 to Counter2[] ;
: >c3 to Counter3[] ;
: >c4 to Counter4[] ;
: >c5 to Counter5[] ;
: >c6 to Counter6[] ;
: >c7 to Counter7[] ;

: +Pu10k  " " >> Pu10k  >> ;
: +Pu100k " " >> Pu100k >> ;
: +Pu1m   " " >> Pu1m   >> ;
: +Pu10m  " " >> Pu10m  >> ;


: gby "gby" ;
: 1g    "1g" ;
: 10g   "10g" ;
: 100g  "100g" ;
: 1000g "1000g" ;

: +gby_Pu10k_1g      " gby(j:Pu10k_1g)"     >> ;
: +gby_Pu10k_10g     " gby(j:Pu10k_10g)"    >> ;
: +gby_Pu10k_100g    " gby(j:Pu10k_100g)"   >> ;
: +gby_Pu10k_1000g   " gby(j:Pu10k_1000g)"  >> ;

: +gby_Pu100k_1g     " gby(j:Pu100k_1g)"    >> ;
: +gby_Pu100k_10g    " gby(j:Pu100k_10g)"   >> ;
: +gby_Pu100k_100g   " gby(j:Pu100k_100g)"  >> ;
: +gby_Pu100k_1000g  " gby(j:Pu100k_1000g)" >> ;

: +gby_Pu1m_1g       " gby(j:Pu1m_1g)"      >> ;
: +gby_Pu1m_10g      " gby(j:Pu1m_10g)"     >> ;
: +gby_Pu1m_100g     " gby(j:Pu1m_100g)"    >> ;
: +gby_Pu1m_1000g    " gby(j:Pu1m_1000g)"   >> ;

: +gby_Pu10m_1g      " gby(j:Pu10m_1g)"     >> ;
: +gby_Pu10m_10g     " gby(j:Pu10m_10g)"    >> ;
: +gby_Pu10m_100g    " gby(j:Pu10m_100g)"   >> ;
: +gby_Pu10m_1000g   " gby(j:Pu10m_1000g)"  >> ;


: agg "agg" ;

: +agg_Pu10k_Pu10k   " agg(t:Pu10k,j:Pu10k)"   >> ;
: +agg_Pu10k_Pu100k  " agg(t:Pu10k,j:Pu100k)"  >> ;
: +agg_Pu10k_Pu1m    " agg(t:Pu10k,j:Pu1m)"    >> ;
: +agg_Pu10k_Pu10m   " agg(t:Pu10k,j:Pu10m)"   >> ;

: +agg_Pu100k_Pu10k  " agg(t:Pu100k,j:Pu10k)"  >> ;
: +agg_Pu100k_Pu100k " agg(t:Pu100k,j:Pu100k)" >> ;
: +agg_Pu100k_Pu1m   " agg(t:Pu100k,j:Pu1m)"   >> ;
: +agg_Pu100k_Pu10m  " agg(t:Pu100k,j:Pu10m)"  >> ;

: +agg_Pu1m_Pu10k    " agg(t:Pu1m,j:Pu10k)"    >> ;
: +agg_Pu1m_Pu100k   " agg(t:Pu1m,j:Pu100k)"   >> ;
: +agg_Pu1m_Pu1m     " agg(t:Pu1m,j:Pu1m)"     >> ;
: +agg_Pu1m_Pu10m    " agg(t:Pu1m,j:Pu10m)"    >> ;

: +agg_Pu10m_Pu10k   " agg(t:Pu10,j:Pu10k)"    >> ;
: +agg_Pu10m_Pu100k  " agg(t:Pu10,j:Pu100k)"   >> ;
: +agg_Pu10m_Pu1m    " agg(t:Pu10,j:Pu1m)"     >> ;
: +agg_Pu10m_Pu10m   " agg(t:Pu10,j:Pu10m)"    >> ;


: pst_0_1 "pst_0_1" "p(0.1)" string4[].set ;
: pst_0_3 "pst_0_3" "p(0.3)" string4[].set ;
: pst_0_6 "pst_0_6" "p(0.6)" string4[].set ;
: pst_0_9 "pst_0_9" "p(0.9)" string4[].set ;

: +pst_0_1_Pu10k  " pst(0.1 x j:Pu10k)"  >> ;
: +pst_0_3_Pu10k  " pst(0.3 x j:Pu10k)"  >> ;
: +pst_0_6_Pu10k  " pst(0.6 x j:Pu10k)"  >> ;
: +pst_0_9_Pu10k  " pst(0.9 x j:Pu10k)"  >> ;

: +pst_0_1_Pu100k " pst(0.1 x j:Pu100k)" >> ;
: +pst_0_3_Pu100k " pst(0.3 x j:Pu100k)" >> ;
: +pst_0_6_Pu100k " pst(0.6 x j:Pu100k)" >> ;
: +pst_0_9_Pu100k " pst(0.9 x j:Pu100k)" >> ;

: +pst_0_1_Pu1m   " pst(0.1 x j:Pu1m)"   >> ;
: +pst_0_3_Pu1m   " pst(0.3 x j:Pu1m)"   >> ;
: +pst_0_6_Pu1m   " pst(0.6 x j:Pu1m)"   >> ;
: +pst_0_9_Pu1m   " pst(0.9 x j:Pu1m)"   >> ;

: +pst_0_1_Pu10m  " pst(0.1 x j:Pu10m)"  >> ;
: +pst_0_3_Pu10m  " pst(0.3 x j:Pu10m)"  >> ;
: +pst_0_6_Pu10m  " pst(0.6 x j:Pu10m)"  >> ;
: +pst_0_9_Pu10m  " pst(0.9 x j:Pu10m)"  >> ;


: key "key" ;

: +key_Pu10k_Pu10k   " key(t:Pu10k=j:Pu10k)"   >> ;
: +key_Pu10k_Pu100k  " key(t:Pu10k=j:Pu100k)"  >> ;
: +key_Pu10k_Pu1m    " key(t:Pu10k=j:Pu1m)"    >> ;
: +key_Pu10k_Pu10m   " key(t:Pu10k=j:Pu10m)"   >> ;

: +key_Pu100k_Pu10k  " key(t:Pu100k=j:Pu10k)"  >> ;
: +key_Pu100k_Pu100k " key(t:Pu100k=j:Pu100k)" >> ;
: +key_Pu100k_Pu1m   " key(t:Pu100k=j:Pu1m)"   >> ;
: +key_Pu100k_Pu10m  " key(t:Pu100k=j:Pu10m)"  >> ;

: +key_Pu1m_Pu10k    " key(t:Pu1m=j:Pu10k)"    >> ;
: +key_Pu1m_Pu100k   " key(t:Pu1m=j:Pu100k)"   >> ;
: +key_Pu1m_Pu1m     " key(t:Pu1m=j:Pu1m)"     >> ;
: +key_Pu1m_Pu10m    " key(t:Pu1m=j:Pu10m)"    >> ;

: +key_Pu10m_Pu10k   " key(t:Pu10=j:Pu10k)"    >> ;
: +key_Pu10m_Pu100k  " key(t:Pu10=j:Pu100k)"   >> ;
: +key_Pu10m_Pu1m    " key(t:Pu10=j:Pu1m)"     >> ;
: +key_Pu10m_Pu10m   " key(t:Pu10=j:Pu10m)"    >> ;
//key example: " \"EQUAL $I1 $L1 ==\"" >> ;


: idx "idx" ;

: +idx_Pu10k_Pu10k   " idx(t:Pu10k->j:Pu10k)"   >> ;
: +idx_Pu10k_Pu100k  " idx(t:Pu10k->j:Pu100k)"  >> ;
: +idx_Pu10k_Pu1m    " idx(t:Pu10k->j:Pu1m)"    >> ;
: +idx_Pu10k_Pu10m   " idx(t:Pu10k->j:Pu10m)"   >> ;

: +idx_Pu100k_Pu10k  " idx(t:Pu100k->j:Pu10k)"  >> ;
: +idx_Pu100k_Pu100k " idx(t:Pu100k->j:Pu100k)" >> ;
: +idx_Pu100k_Pu1m   " idx(t:Pu100k->j:Pu1m)"   >> ;
: +idx_Pu100k_Pu10m  " idx(t:Pu100k->j:Pu10m)"  >> ;

: +idx_Pu1m_Pu10k    " idx(t:Pu1m->j:Pu10k)"    >> ;
: +idx_Pu1m_Pu100k   " idx(t:Pu1m->j:Pu100k)"   >> ;
: +idx_Pu1m_Pu1m     " idx(t:Pu1m->j:Pu1m)"     >> ;
: +idx_Pu1m_Pu10m    " idx(t:Pu1m->j:Pu10m)"    >> ;

: +idx_Pu10m_Pu10k   " idx(t:Pu10m->j:Pu10k)"   >> ;
: +idx_Pu10m_Pu100k  " idx(t:Pu10m->j:Pu100k)"  >> ;
: +idx_Pu10m_Pu1m    " idx(t:Pu10m->j:Pu1m)"    >> ;
: +idx_Pu10m_Pu10m   " idx(t:Pu10m->j:Pu10m)"   >> ;


: pre_0_1 "pre_0_1" "f(0.1)" string2[].set ;
: pre_0_3 "pre_0_3" "f(0.3)" string2[].set ;
: pre_0_6 "pre_0_6" "f(0.6)" string2[].set ;
: pre_0_9 "pre_0_9" "f(0.9)" string2[].set ;

: +pre_0_1_Pu10k  " pre(0.1 x t:Pu10k)"  >> ;
: +pre_0_3_Pu10k  " pre(0.3 x t:Pu10k)"  >> ;
: +pre_0_6_Pu10k  " pre(0.6 x t:Pu10k)"  >> ;
: +pre_0_9_Pu10k  " pre(0.9 x t:Pu10k)"  >> ;

: +pre_0_1_Pu100k " pre(0.1 x t:Pu100k)" >> ;
: +pre_0_3_Pu100k " pre(0.3 x t:Pu100k)" >> ;
: +pre_0_6_Pu100k " pre(0.6 x t:Pu100k)" >> ;
: +pre_0_9_Pu100k " pre(0.9 x t:Pu100k)" >> ;

: +pre_0_1_Pu1m   " pre(0.1 x t:Pu1m)"   >> ;
: +pre_0_3_Pu1m   " pre(0.3 x t:Pu1m)"   >> ;
: +pre_0_6_Pu1m   " pre(0.6 x t:Pu1m)"   >> ;
: +pre_0_9_Pu1m   " pre(0.9 x t:Pu1m)"   >> ;

: +pre_0_1_Pu10m  " pre(0.1 x t:Pu10m)"  >> ;
: +pre_0_3_Pu10m  " pre(0.3 x t:Pu10m)"  >> ;
: +pre_0_6_Pu10m  " pre(0.6 x t:Pu10m)"  >> ;
: +pre_0_9_Pu10m  " pre(0.9 x t:Pu10m)"  >> ;

//expr example: type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and

/*----------------------------------------------------------------------------*/
/* form full pipeline statement                                               */
/*----------------------------------------------------------------------------*/
: pu_pipeline params| sStreamB |
  
   counterA[] 1 + to counterA[]

//  string0[] .
//  string1[] .
//  string3[] .

  "\n"
  "// - - - - - - - - - - - - - - - - - - - - - - - - - -" >>
  " - - - - - - - - - - - - - - - - - - - - - - - - - - -" >> nl

  "// pu test "     >>
    counterA[] >str >>
    " : "           >>
    counter0[] [n] string0[] +x >>
    counter1[] [n] string1[] +x >>
    counter2[] [n] string2[] +x >>
    counter3[] [n] string3[] +x >>
    counter4[] [n] string4[] +x >>
    counter5[] [n] string5[] sp >>
    nl
    
  "// - - - - - - - - - - - - - - - - - - - - - - - - - -" >>
  " - - - - - - - - - - - - - - - - - - - - - - - - - - -" >> nl

  
  "pipeline pu" >> counterA[] >str      >> nl
  "begin"                               >> nl
  "  stage stageA on origin :"          >> nl
  "      start"                         >> nl
  "    | pulse once"                    >> nl
  "    | stageB"                        >> nl
  "  stage stageB on all partitions :"  >> nl
         sStreamB                       >>
  "    | stageC"                        >> nl
  "  stage stageC on origin :"          >> nl
  "      sink"                          >> nl
  "    | stageA"                        >> nl
  "end ;"                               >> nl
  " "                                   >> nl
    
  dup .
  
  File0[] file.writeLine
  
;

/*----------------------------------------------------------------------------*/
/* append aggreg -- scan | filter | join | filter | agg gby Counter5[]        */
/*----------------------------------------------------------------------------*/
: pu_agggby params| j t s |

  s +aggreg
    "+" agg t __ j  __ >> fx
    "+" gby j __ 1g __ >> fx            g:1    ( ) nl 1 >c5 pu_pipeline
  s +aggreg
    "+" agg t __ j  __ >> fx
    "+" gby j __ 10g __ >> fx           g:10   ( ) nl 2 >c5 pu_pipeline
  s +aggreg
    "+" agg t __ j  __ >> fx
    "+" gby j __ 100g __ >> fx          g:100  ( ) nl 3 >c5 pu_pipeline
  s +aggreg
    "+" agg t __ j  __ >> fx
    "+" gby j __ 1000g __ >> fx         g:1000 ( ) nl 4 >c5 pu_pipeline

;

/*----------------------------------------------------------------------------*/
/* append post-filter -- scan | filter | join | filter Counter4[]             */
/*----------------------------------------------------------------------------*/
: pu_pstFilter params| j t s |

  s +filter "+" pst_0_1 t __ >> fx             ( ) nl 1 >c4 t j pu_agggby
  s +filter "+" pst_0_3 t __ >> fx             ( ) nl 2 >c4 t j pu_agggby
  s +filter "+" pst_0_6 t __ >> fx             ( ) nl 3 >c4 t j pu_agggby
  s +filter "+" pst_0_9 t __ >> fx             ( ) nl 4 >c4 t j pu_agggby
;

/*----------------------------------------------------------------------------*/
/* append join -- scan | filter | join Counter3[]                             */
/*----------------------------------------------------------------------------*/
: pu_join params| t s |

  s +join +Pu10k
    "+" idx t __ Pu10k  __ >> fx
    "+" key t __ Pu10k  __ >> fx      j:Pu10k  ( ) nl 1 >c3 t Pu10k  pu_pstFilter
  s +join +Pu100k
    "+" idx t __ Pu100k __ >> fx
    "+" key t __ Pu10k  __ >> fx      j:Pu100k ( ) nl 2 >c3 t Pu100k pu_pstFilter
  s +join +Pu1m
    "+" idx t __ Pu1m   __ >> fx
    "+" key t __ Pu1m   __ >> fx      j:Pu1m   ( ) nl 3 >c3 t Pu1m   pu_pstFilter
  s +join +Pu10m
    "+" idx t __ Pu10m  __ >> fx
    "+" key t __ Pu10m  __ >> fx      j:Pu10m  ( ) nl 4 >c3 t Pu10m  pu_pstFilter
;

/*----------------------------------------------------------------------------*/
/* append pre-filter -- scan | filter Counter2[]                              */
/*----------------------------------------------------------------------------*/
: pu_preFilter params| t s |
  s +filter "+" pre_0_1 t __ >> fx             ( ) nl 1 >c2 t pu_join
  s +filter "+" pre_0_3 t __ >> fx             ( ) nl 2 >c2 t pu_join
  s +filter "+" pre_0_6 t __ >> fx             ( ) nl 3 >c2 t pu_join
  s +filter "+" pre_0_9 t __ >> fx             ( ) nl 4 >c2 t pu_join
;

/*----------------------------------------------------------------------------*/
/*  append scan -- scan Counter0[] t Counter1[]                               */
/*----------------------------------------------------------------------------*/
: pu_scan "scan" string0[].set 1 >c0

  scan +Pu10k                        t:Pu10k   ( ) nl 1 >c1 Pu10k  pu_preFilter
  scan +Pu100k                       t:Pu100k  ( ) nl 2 >c1 Pu100k pu_preFilter
  scan +Pu1m                         t:Pu1m    ( ) nl 3 >c1 Pu1m   pu_preFilter
  scan +Pu10m                        t:Pu10m   ( ) nl 4 >c1 Pu10m  pu_preFilter
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* generate pu tests                                                          */
/*----------------------------------------------------------------------------*/
: pu_gen \prompt

  file::new to file0[]
  
  "/tmp/_pu_run" OPEN_WRITE file0[] file.open
  
  1 >a pu_scan adiscard
  
  // "" 2 pu_indexScan

  file0[].get file.close
  
  counterA[] "pu_gen: %v pipelines generated\n" .printf
;

pu_gen

Path[].Restore

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
