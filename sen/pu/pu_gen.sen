/*============================================================================*/
/* pu_gen.sen -- Power Unit Testing                                           */
/*============================================================================*/

" pu_gen.sen" .

Path[].save
Path[].root


: >> str.cat ;
: nl "\n" str.cat ;
: sp " "  str.cat ;
: +x " x " str.cat ;
: +fx( "+" ;
: )fx >> find execute ;
: _+ "+" swap >> ;
: __ "_" swap >> >> ;
: [n] >str "[" swap >> >> "]" >> ;
: >c0 to Counter0[] ;
: >c1 to Counter1[] ;
: >c2 to Counter2[] ;
: >c3 to Counter3[] ;
: >c4 to Counter4[] ;
: >c5 to Counter5[] ;
: >c6 to Counter6[] ;
: >c7 to Counter7[] ;

// fx -- find excute tokens
: key "key" ;
: agg "agg" ;
: gby "gby" ;
: idx "idx" ;

: 1g    "1g" ;
: 10g   "10g" ;
: 100g  "100g" ;
: 1000g "1000g" ;

: ft_0_1 "ft_0_1" "ft(0.1)" string2[].set ;
: ft_0_3 "ft_0_3" "ft(0.3)" string2[].set ;
: ft_0_6 "ft_0_6" "ft(0.6)" string2[].set ;
: ft_0_9 "ft_0_9" "ft(0.9)" string2[].set ;

: fj_0_1 "fj_0_1" "fj(0.1)" string4[].set ;
: fj_0_3 "fj_0_3" "fj(0.3)" string4[].set ;
: fj_0_6 "fj_0_6" "fj(0.6)" string4[].set ;
: fj_0_9 "fj_0_9" "fj(0.9)" string4[].set ;

// the tables
: Pu10k  "Pu10k"  ;
: Pu100k "Pu100k" ;
: Pu1m   "Pu1m"   ;
: Pu10m  "Pu10m"  ;

: +Pu10k  " " >> Pu10k  >> ;
: +Pu100k " " >> Pu100k >> ;
: +Pu1m   " " >> Pu1m   >> ;
: +Pu10m  " " >> Pu10m  >> ;

// the ops
: scan    "      scan"           ;
: +filter "    | filter 1"    >> ;
: +join   "    | indexJoin 1" >> ;
: +aggreg "    | aggreg 1"    >> ;

// tables as t
: t:Pu10k  "t(Pu10k)"  string1[].set ;
: t:Pu100k "t(Pu100k)" string1[].set ;
: t:Pu1m   "t(Pu1m)"   string1[].set ;
: t:Pu10m  "t(Pu10m)"  string1[].set ;

// tables as j
: j:Pu10k  "j(Pu10k)"  string3[].set ;
: j:Pu100k "j(Pu100k)" string3[].set ;
: j:Pu1m   "j(Pu1m)"   string3[].set ;
: j:Pu10m  "j(Pu10m)"  string3[].set ;

// goups
: g:1      "g(1)"      string5[].set ;
: g:10     "g(10)"     string5[].set ;
: g:100    "g(100)"    string5[].set ;
: g:1000   "g(1000)"   string5[].set ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: +ft_0_1_Pu10k  " \"type boolean $2 100 <=\"" >> ; // allow 10% of (t.)Pu10K
: +ft_0_3_Pu10k  " \"type boolean $2 300 <=\"" >> ; // allow 30% of (t.)Pu10K
: +ft_0_6_Pu10k  " \"type boolean $2 600 <=\"" >> ; // allow 60% of (t.)Pu10K
: +ft_0_9_Pu10k  " \"type boolean $2 900 <=\"" >> ; // allow 90% of (t.)Pu10K

: +ft_0_1_Pu100k " \"type boolean $3 100 <=\"" >> ; // allow 10% of (t.)Pu100K
: +ft_0_3_Pu100k " \"type boolean $3 300 <=\"" >> ; // allow 30% of (t.)Pu100K
: +ft_0_6_Pu100k " \"type boolean $3 600 <=\"" >> ; // allow 60% of (t.)Pu100K
: +ft_0_9_Pu100k " \"type boolean $3 900 <=\"" >> ; // allow 90% of (t.)Pu100K

: +ft_0_1_Pu1m   " \"type boolean $4 100 <=\"" >> ; // allow 10% of (t.)Pu1m
: +ft_0_3_Pu1m   " \"type boolean $4 300 <=\"" >> ; // allow 30% of (t.)Pu1m
: +ft_0_6_Pu1m   " \"type boolean $4 600 <=\"" >> ; // allow 60% of (t.)Pu1m
: +ft_0_9_Pu1m   " \"type boolean $4 900 <=\"" >> ; // allow 90% of (t.)Pu1m

: +ft_0_1_Pu10m  " \"type boolean $5 100 <=\"" >> ; // allow 10% of (t.)Pu10m
: +ft_0_3_Pu10m  " \"type boolean $5 300 <=\"" >> ; // allow 30% of (t.)Pu10m
: +ft_0_6_Pu10m  " \"type boolean $5 600 <=\"" >> ; // allow 60% of (t.)Pu10m
: +ft_0_9_Pu10m  " \"type boolean $5 900 <=\"" >> ; // allow 90% of (t.)Pu10m

//expr example: type boolean $7 0.06 0.01 - >=  $7 0.06 0.01 +  <= and
//key example: " \"EQUAL $I1 $L1 ==\"" >> ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: +idx_Pu10k_Pu10k   " Pu10k_10k"   >> ; // which index
: +idx_Pu10k_Pu100k  " Pu100k_10k"  >> ;
: +idx_Pu10k_Pu1m    " Pu1m_10k"    >> ;
: +idx_Pu10k_Pu10m   " Pu10m_10k"   >> ;

: +idx_Pu100k_Pu10k  " Pu10k_10k"   >> ;
: +idx_Pu100k_Pu100k " Pu100k_100k" >> ;
: +idx_Pu100k_Pu1m   " Pu1m_100k"   >> ;
: +idx_Pu100k_Pu10m  " Pu10m_100k"  >> ;

: +idx_Pu1m_Pu10k    " Pu10k_10k"    >> ;
: +idx_Pu1m_Pu100k   " Pu100k_100k"   >> ;
: +idx_Pu1m_Pu1m     " Pu1m_1m"     >> ;
: +idx_Pu1m_Pu10m    " Pu1m_1m"    >> ;

: +idx_Pu10m_Pu10k   " Pu10k_10k"   >> ;
: +idx_Pu10m_Pu100k  " Pu100k_100k"  >> ;
: +idx_Pu10m_Pu1m    " Pu1m_1m"    >> ;
: +idx_Pu10m_Pu10m   " Pu10m_10m"   >> ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: +key_Pu10k_Pu10k   " \"BOUND $I1 $L1 ==\""  >> ; // what key
: +key_Pu10k_Pu100k  " \"BOUND $I1 $L1 ==\""  >> ;
: +key_Pu10k_Pu1m    " \"BOUND $I1 $L1 ==\""  >> ;
: +key_Pu10k_Pu10m   " \"BOUND $I1 $L1 ==\""  >> ;

: +key_Pu100k_Pu10k  " \"BOUND $I1 $L2 ==\""  >> ;
: +key_Pu100k_Pu100k " \"BOUND $I1 $L1 ==\""  >> ;
: +key_Pu100k_Pu1m   " \"BOUND $I1 $L1 ==\""  >> ;
: +key_Pu100k_Pu10m  " \"BOUND $I1 $L1 ==\""  >> ;

: +key_Pu1m_Pu10k    " \"BOUND $I1 $L3 ==\""  >> ;
: +key_Pu1m_Pu100k   " \"BOUND $I1 $L2 ==\""  >> ;
: +key_Pu1m_Pu1m     " \"BOUND $I1 $L1 ==\""  >> ;
: +key_Pu1m_Pu10m    " \"BOUND $I1 $L1 ==\""  >> ;

: +key_Pu10m_Pu10k   " \"BOUND $I1 $L4 ==\""  >> ;
: +key_Pu10m_Pu100k  " \"BOUND $I1 $L3 ==\""  >> ;
: +key_Pu10m_Pu1m    " \"BOUND $I1 $L2 ==\""  >> ;
: +key_Pu10m_Pu10m   " \"BOUND $I1 $L1 ==\""  >> ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: +fj_0_1_Pu10k  "  \"type boolean $13 100 <=\"" >> ; // allow 10% of (j.)Pu10K
: +fj_0_3_Pu10k  "  \"type boolean $13 300 <=\"" >> ; // allow 30% of (j.)Pu10K
: +fj_0_6_Pu10k  "  \"type boolean $13 600 <=\"" >> ; // allow 60% of (j.)Pu10K
: +fj_0_9_Pu10k  "  \"type boolean $13 900 <=\"" >> ; // allow 90% of (j.)Pu10K

: +fj_0_1_Pu100k "  \"type boolean $3 100 <=\"" >> ; // allow 10% of (j.)Pu100K
: +fj_0_3_Pu100k "  \"type boolean $3 300 <=\"" >> ; // allow 30% of (j.)Pu100K
: +fj_0_6_Pu100k "  \"type boolean $3 600 <=\"" >> ; // allow 60% of (j.)Pu100K
: +fj_0_9_Pu100k "  \"type boolean $3 900 <=\"" >> ; // allow 90% of (j.)Pu100K

: +fj_0_1_Pu1m   "  \"type boolean $4 100 <=\"" >> ; // allow 10% of (j.)Pu1m
: +fj_0_3_Pu1m   "  \"type boolean $4 300 <=\"" >> ; // allow 30% of (j.)Pu1m
: +fj_0_6_Pu1m   "  \"type boolean $4 600 <=\"" >> ; // allow 60% of (j.)Pu1m
: +fj_0_9_Pu1m   "  \"type boolean $4 900 <=\"" >> ; // allow 90% of (j.)Pu1m

: +fj_0_1_Pu10m  "  \"type boolean $5 100 <=\"" >> ; // allow 10% of (j.)Pu10m
: +fj_0_3_Pu10m  "  \"type boolean $5 300 <=\"" >> ; // allow 30% of (j.)Pu10m
: +fj_0_6_Pu10m  "  \"type boolean $5 600 <=\"" >> ; // allow 60% of (j.)Pu10m
: +fj_0_9_Pu10m  "  \"type boolean $5 900 <=\"" >> ; // allow 90% of (j.)Pu10m

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: +agg_Pu10k_Pu10k   " \"type integer $4 , type integer ) $11 sum"  >> ;
: +agg_Pu10k_Pu100k  " \"type integer $5 , type integer ) $11 sum"  >> ;
: +agg_Pu10k_Pu1m    " \"type integer $6 , type integer ) $11 sum"  >> ;
: +agg_Pu10k_Pu10m   " \"type integer $7 , type integer ) $11 sum"  >> ;

: +agg_Pu100k_Pu10k  " \"type integer $5 , type integer ) $12 sum"  >> ;
: +agg_Pu100k_Pu100k " \"type integer $6 , type integer ) $12 sum"  >> ;
: +agg_Pu100k_Pu1m   " \"type integer $7 , type integer ) $12 sum"  >> ;
: +agg_Pu100k_Pu10m  " \"type integer $8 , type integer ) $12 sum"  >> ;

: +agg_Pu1m_Pu10k    " \"type integer $6 , type integer ) $13 sum"  >> ;
: +agg_Pu1m_Pu100k   " \"type integer $7 , type integer ) $13 sum"  >> ;
: +agg_Pu1m_Pu1m     " \"type integer $8 , type integer ) $13 sum"  >> ;
: +agg_Pu1m_Pu10m    " \"type integer $9 , type integer ) $13 sum"  >> ;

: +agg_Pu10m_Pu10k   " \"type integer $7 , type integer ) $14 sum"  >> ;
: +agg_Pu10m_Pu100k  " \"type integer $8 , type integer ) $14 sum"  >> ;
: +agg_Pu10m_Pu1m    " \"type integer $9 , type integer ) $14 sum"  >> ;
: +agg_Pu10m_Pu10m   " \"type integer $10 , type integer ) $14 sum"  >> ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: +gby_Pu10k_1g      " groupby type integer $4\"" >> ;
: +gby_Pu10k_10g     " groupby type integer $5\"" >> ;
: +gby_Pu10k_100g    " groupby type integer $6\"" >> ;
: +gby_Pu10k_1000g   " groupby type integer $7\"" >> ;

: +gby_Pu100k_1g     " groupby type integer $5\"" >> ;
: +gby_Pu100k_10g    " groupby type integer $6\"" >> ;
: +gby_Pu100k_100g   " groupby type integer $7\"" >> ;
: +gby_Pu100k_1000g  " groupby type integer $8\"" >> ;

: +gby_Pu1m_1g       " groupby type integer $6\"" >> ;
: +gby_Pu1m_10g      " groupby type integer $7\"" >> ;
: +gby_Pu1m_100g     " groupby type integer $8\"" >> ;
: +gby_Pu1m_1000g    " groupby type integer $9\"" >> ;

: +gby_Pu10m_1g      " groupby type integer $7\"" >> ;
: +gby_Pu10m_10g     " groupby type integer $8\"" >> ;
: +gby_Pu10m_100g    " groupby type integer $9\"" >> ;
: +gby_Pu10m_1000g   " groupby type integer $10\"" >> ;

/*----------------------------------------------------------------------------*/
/* form full pipeline statement                                               */
/*----------------------------------------------------------------------------*/
: pu_pipeline params| sStreamB |
  
   counterA[] 1 + to counterA[]
   
   counterA[] locals| iJobId  |
   counter0[] locals| iPuSet  |
   counter1[] locals| iT      |
   counter2[] locals| iFt     |
   counter3[] locals| iJ      |
   counter4[] locals| iFj     |
   counter5[] locals| iGroups |

  "\n"
  "// - - - - - - - - - - - - - - - - - - - - - -" >>
  " - - - - - - - - - - - - - - - - - - - - - - -" >> nl

  "// pu test "     >>
    /* pu     */ iJobId >str >>
                 " : "       >>
    /* puSet  */ iPuSet  [n] string0[] +x >>
    /* t      */ iT      [n] string1[] +x >>
    /* ft     */ iFt     [n] string2[] +x >>
    /* j      */ iJ      [n] string3[] +x >>
    /* fj     */ iFj     [n] string4[] +x >>
    /* groups */ iGroups [n] string5[] sp >>
    nl
    
  "// - - - - - - - - - - - - - - - - - - - - - -" >>
  " - - - - - - - - - - - - - - - - - - - - - - -" >> nl

  
  "pipeline pu" >> counterA[] >str      >> nl
  "begin"                               >> nl
  "  stage stageA on origin :"          >> nl
  "      start"                         >> nl
  "    | pulse once"                    >> nl
  "    | stageB"                        >> nl
  "  stage stageB on all partitions :"  >> nl
         sStreamB                       >>
  "    | stageC"                        >> nl
  "  stage stageC on origin :"          >> nl
  "      output"                        >> nl
  "    | sink"                          >> nl
  "    | stageA"                        >> nl
  "end"                                 >> nl
  "    <pu_jobId> = "  iJobId  >str >>  >> nl
  "    <pu_puSet> = "  iPuSet  >str >>  >> nl
  "    <pu_t> = "      iT      >str >>  >> nl
  "    <pu_ft> = "     iFt     >str >>  >> nl
  "    <pu_j> = "      iJ      >str >>  >> nl
  "    <pu_fj> = "     iFj     >str >>  >> nl
  "    <pu_groups> = " iGroups >str >>  >> nl
  ";"                                   >> nl
  " "                                   >> nl
    
  locals| sPipeline |
  
  sPipeline .
  
  sPipeline File0[] file.writeLine
  
  STD_PATH sPipeline api::executeCommand 2discard
  
  
  
  
  
  
  
//  STD_PATH
//  "
//  pipeline unnamed
//  begin
//  stage stageStart on origin :
//    start
//    | pulse once
//    | stageMarker0861
//  stage stageMarker0861 on all partitions :
//    scan rapidsse public Pu10k
//    | aggreg 0 \" type INTEGER )  $1 sum  , type INTEGER )  $1 count  , type INTEGER as pu10k_10g $6 groupBy  type INTEGER as pu10k_10g $6 \"
//    | stageMarker0864
//  stage stageMarker0864 on all nodes :
//    aggreg 0 \" type INTEGER )  $1 sum  , type INTEGER )  $2 sum  , type INTEGER as pu10k_10g $3 groupBy  type INTEGER as pu10k_10g $3 \"
//    | stageMarker0867
//  stage stageMarker0867 on origin :
//    aggreg 0 \" type INTEGER as pu10k_10g $3 , type INTEGER )  $2 sum  , type INTEGER )  $1 sum  groupBy  type INTEGER as pu10k_10g $3 \"
//    | aggreg 0 \" type INTEGER $3 $2 /  , type INTEGER as pu10k_10g $1 groupBy  type INTEGER as pu10k_10g $1 \"
//    | project 0 \" type INTEGER $1 \"
//    | stageLast
//  stage stageLast on origin :
//    output
//    | sink
//    | stageStart
//  end ;
//  "
//  api::executeCommand
;

/*----------------------------------------------------------------------------*/
/* append aggreg -- scan | filter | join | filter | agg gby Counter5[]        */
/*----------------------------------------------------------------------------*/
: pu_agggby params| j t s |

  s +aggreg +fx( agg t __ j     __ )fx
            +fx( gby j __ 1g    __ )fx nl              1 >c5 g:1    pu_pipeline
  s +aggreg +fx( agg t __ j     __ )fx
            +fx( gby j __ 10g   __ )fx nl              2 >c5 g:10   pu_pipeline
  s +aggreg +fx( agg t __ j     __ )fx
            +fx( gby j __ 100g  __ )fx nl              3 >c5 g:100  pu_pipeline
  s +aggreg +fx( agg t __ j     __ )fx
            +fx( gby j __ 1000g __ )fx nl              4 >c5 g:1000 pu_pipeline
;

/*----------------------------------------------------------------------------*/
/* append post-filter -- scan | filter | join | filter Counter4[]             */
/*----------------------------------------------------------------------------*/
: pu_jFilter params| j t s |

  s +filter +fx( fj_0_1 t __ )fx nl                         1 >c4 t j pu_agggby
  s +filter +fx( fj_0_3 t __ )fx nl                         2 >c4 t j pu_agggby
  s +filter +fx( fj_0_6 t __ )fx nl                         3 >c4 t j pu_agggby
  s +filter +fx( fj_0_9 t __ )fx nl                         4 >c4 t j pu_agggby
;

/*----------------------------------------------------------------------------*/
/* append join -- scan | filter | join Counter3[]                             */
/*----------------------------------------------------------------------------*/
: pu_join params| t s |

  s +join +Pu10k
    +fx( idx t __ Pu10k  __ )fx
    +fx( key t __ Pu10k  __ )fx nl           1 >c3 j:Pu10k  Pu10k  t pu_agggby
  s +join +Pu100k
    +fx( idx t __ Pu100k __ )fx
    +fx( key t __ Pu10k  __ )fx nl           2 >c3 j:Pu100k Pu100k t pu_agggby
  s +join +Pu1m
    +fx( idx t __ Pu1m   __ )fx
    +fx( key t __ Pu1m   __ )fx nl           3 >c3 j:Pu1m   Pu1m   t pu_agggby
  s +join +Pu10m
    +fx( idx t __ Pu10m  __ )fx
    +fx( key t __ Pu10m  __ )fx nl           4 >c3 j:Pu10m  Pu10m  t pu_agggby
;

/*----------------------------------------------------------------------------*/
/* append pre-filter -- scan | filter Counter2[]                              */
/*----------------------------------------------------------------------------*/
: pu_tFilter params| t s |

  s +filter +fx( ft_0_1 t __ )fx nl                             1 >c2 t pu_join
  s +filter +fx( ft_0_3 t __ )fx nl                             2 >c2 t pu_join
  s +filter +fx( ft_0_6 t __ )fx nl                             3 >c2 t pu_join
  s +filter +fx( ft_0_9 t __ )fx nl                             4 >c2 t pu_join
;

/*----------------------------------------------------------------------------*/
/*  append scan -- scan Counter0[] t Counter1[]                               */
/*----------------------------------------------------------------------------*/
: pu_scan "scan" string0[].set 1 >c0

  scan +Pu10k  nl                              1 >c1 t:Pu10k  Pu10k  pu_tFilter
  scan +Pu100k nl                              2 >c1 t:Pu100k Pu100k pu_tFilter
  scan +Pu1m   nl                              3 >c1 t:Pu1m   Pu1m   pu_tFilter
  scan +Pu10m  nl                              4 >c1 t:Pu10m  Pu10m  pu_tFilter
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* generate pu tests                                                          */
/*----------------------------------------------------------------------------*/
: pu_gen \prompt

  file::new to file0[]
  
  "/tmp/_pu_run.txt" OPEN_WRITE file0[] file.open
  
  1 >a pu_scan adiscard
  
  // "" 2 pu_indexScan

  file0[].get file.close
  
  counterA[] "pu_gen: %v pipelines generated\n" .printf
;

pu_gen

Path[].Restore

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
