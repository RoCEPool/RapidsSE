/*============================================================================*/
/* OP_truncateTable.sen -- Operator truncate table                            */
/*============================================================================*/

" OP_truncateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: truncateTable_DataPulse \handler


  //"Operand:- ZK_M_DATAPULSE" .verbose

  // truncate the buffers of the tablePtn
  TablePtn[].truncate

  PipeIn[].pipeout

  Marker[].newDestroyMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: truncateTable_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  PipeIn[].pipeOut

  // check if we can truncate the table
  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for TruncateOp req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : truncateTable::geb \operator

  _lu_initialise_

  op__topology

  find: truncateTable_StartMarker ZK_M_START     op[].handler!
  find: truncateTable_DataPulse   ZK_M_DATAPULSE op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: truncateTable :: truncateTable <tableNm> ;

: truncateTable_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
