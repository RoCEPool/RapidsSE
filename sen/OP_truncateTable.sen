/*============================================================================*/
/* OP_truncateTable.sen -- Operator truncate table                            */
/*============================================================================*/

" OP_truncateTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: truncateTable_DataPulse \handler


  //"Operand:- EV_M_DATAPULSE" .verbose

  // check for replicated table
  Table[].isReplicated if
    // truncate the buffers of the table only on partition 0
    [op].partition@ 0 == if
      TablePtn[].grabWrite_msecLoop
      TablePtn[].truncate
      TablePtn[].dropWrite
    then
  else
    TablePtn[].grabWrite_msecLoop
    // truncate the buffers of the tablePtn
    TablePtn[].truncate
    TablePtn[].dropWrite
  then

  PipeIn[].pipeout

  Marker[].newDestroyMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: truncateTable_StartMarker \handler

  0 locals| errorCode |

  //"Operand:- EV_M_START" .verbose

  PipeIn[].pipeOut

  // check if we can truncate the table
  <tableNm> op__table if
    // If table kind is not user defined (TT_NORMAL)
    // throw error
    Table[].kind TT_NORMAL != if
      // create an exec error rowBuffer
      EC_TABLE_CANT_BE_DELETED to errorCode
      errorCode op__execErr
      true
      exit
    else
      Table[].tablePtn@ to TablePtn[]
    then
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for TruncateOp req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : truncateTable_op \operator

  _lu_initialise_

  op__topology

  find: truncateTable_StartMarker EV_M_START     [op].handler!
  find: truncateTable_DataPulse   EV_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: truncateTable :: truncateTable <tableNm> ;

: truncateTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "truncateTable_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
