/*============================================================================*/
/* OP_showCuster.sen -- Operator show cluster                                 */
/*============================================================================*/

" OP_showCluster.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: showCluster_action

  // find the __ table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // create an rowBuffer operand
  TableDef[] RowBuffer[].new

  0 locals| pNode |

  node_I[].init

  begin
    node_I[].node to pNode

    pNode node.id TableDef[] RowBuffer[].addShowCluster  not if
      RowBuffer[].pipeOut
      TableDef[] RowBuffer[].new
      pNode node.id TableDef[] RowBuffer[].addShowCluster assert
    then

    node_I[].next
    node_i[].more while
  repeat

  //node_I[].delete


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pipeout the rowBuffer
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: showCluster :: showCluster ;

: showCluster_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __showCluster
    <params>      = 0

    <opEntry> = "showCluster_op"
 }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
