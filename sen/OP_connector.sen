/*============================================================================*/
/* OP_connector.sen -- Operator connector                                     */
/*============================================================================*/

" OP_connector.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send node info to node we just connected to                                */
/*----------------------------------------------------------------------------*/
: .sendNodeInfo ( pSocket -- )

  params| pSocket |

  // find the __nodeinfo table
  C_TDEF_NODEINFO op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] infoSet[].new

  // add nodeInfo to the infoSet
  infoSetTable[] infoSet[].addnodeInfo assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // send node info job to the other node
  pSocket socket.grabWrite
  infoSet[] pSocket socket.sendObject assert
  pSocket socket.dropWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete infoset
  infoSet[].delete
;

/*----------------------------------------------------------------------------*/
/* attempt connect to given node                                              */
/*----------------------------------------------------------------------------*/
: .attemptConnectNode ( pNode -- )

  params| pNode |

  0 locals| pSocket |

  args.verbose if
    pNode node.no grid::thisNode@ "Node %v connecting to node %v" .printf
  then

  // get the nodes port and IP address
  pNode node.port ( port )
  pNode node.IP   ( port IP )

  // attempt connect to that node
  pNode socket::open socket.connect to pSocket

  pSocket not if
    pNode node.no grid::thisNode@ "Node %v unable to connect to node %v" .printf
    exit
  then

  // set the send socket in the node
  grid::incConnectedNodes
  pSocket pNode node.sendSocket!

 
  // print connection message
  args.verbose if
    pNode node.no grid::thisNode@ "Node %v connected to node %v" .printf
  then

  // send this node's info to the node we just connected to
  pSocket .sendNodeInfo
;

/*----------------------------------------------------------------------------*/
/* one iteration of connector behavior                                        */
/*----------------------------------------------------------------------------*/
//: _connectorTake ( -- )
//
//  0 locals| pNode |
//
//  // "_connectorTake" .
//
//  grid::bootNodes 0
//  do
//
//    // get node I
//    I grid::node to pNode
//
//    // connect to the node
//    pNode node.sendSocket@ not if
//      pNode .attemptConnectNode
//    then
//
//  loop
//;
/*----------------------------------------------------------------------------*/
: _connectorTake ( -- )

  0 locals| pNode |

  C_ALL node_I[].new

  begin

    node_I[].node to pNode

    pNode node.sendSocket@ not if
      pNode .attemptConnectNode
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: connector_StartMarker \handler

  0 locals| pThisTask |
  0 locals| pJob_Connector |

  //"connector_run" .

  args.verbose if
    grid::thisNode@ job[] "Connector %v on node %v running" .printf
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the task
  task[] to pThisTask

  // get the connectpr job from the task
  pThisTask task.job@ to pJob_Connector

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin
    _connectorTake
    trap::stackDepthZero

    3 thread::sleepSsec
  again

  // print started message
  //grid::thisNodeName@ "Node %v : SE cluster started" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute for connector req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : connector_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: connector_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: connector :: connector ;

: connector _cmdTags tagCopy: serviceOp_tags

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
