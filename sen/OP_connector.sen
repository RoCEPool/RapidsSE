/*============================================================================*/
/* OP_connector.sen -- Operator connector                                     */
/*============================================================================*/

" OP_connector.sen" .verbose

/*----------------------------------------------------------------------------*/
/* send node info to node we just connected to                                */
/*----------------------------------------------------------------------------*/
: connector_sendNodeInfo ( -- )

  // find the __nodeinfo table
  C_TDEF_NODEINFO op__tableDef_infoSet assert

  // create an infoSet operand
  infoSetTable[] InfoSet[].new

  // add nodeInfo to the infoSet
  infoSetTable[] InfoSet[].addnodeInfo assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // send node info job to the other node
  Socket[] socket.grabWrite
  InfoSet[] Socket[] socket.sendObject assert
  Socket[] socket.dropWrite

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // delete infoset
  InfoSet[].delete
;

/*----------------------------------------------------------------------------*/
/* attempt connect to given node                                              */
/*----------------------------------------------------------------------------*/
: connector_attemptConnect ( Node[] -- )

  args.verbose if
    Node[] node.no grid::thisNode@ "Node %v connecting to node %v" .printf
  then

  // get the nodes port and IP address
  Node[] node.port ( port )
  Node[] node.IP   ( port IP )

  // attempt connect to that node
  Node[] socket::open socket.connect to Socket[]

  Socket[].isNull if
    Node[] node.no grid::thisNode@ "Node %v unable to connect to node %v" .printf
    exit
  then

  // set the send socket in the node
  grid::incConnectedNodes
  Socket[] Node[] node.sendSocket!

 
  // print connection message
  args.verbose if
    Node[] node.no grid::thisNode@ "Node %v connected to node %v" .printf
  then

  // send this node's info to the node we just connected to
  connector_sendNodeInfo
  
  nullptr to Socket[]
;

/*----------------------------------------------------------------------------*/
/* one iteration of connector behavior                                        */
/*----------------------------------------------------------------------------*/
: connector_take ( -- )

  C_ALL node_I[].new

  begin

    node_I[].node to Node[]

    Node[] node.sendSocket@ not if
      connector_attemptConnect
    then
    
    nullptr to Node[]

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: connector_StartMarker \handler

  //"connector_StartMarker" .

  args.verbose if
    grid::thisNode@ job[] "Connector %v on node %v running" .printf
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  begin
    connector_take
    trap::stackDepthZero

    3 thread::sleepSsec
  again

  // print started message
  //grid::thisNodeName@ "Node %v : SE cluster started" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  job::completed

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute for connector req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : connector_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: connector_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: connector :: connector ;

: connector_cmdTags _cmdTags tagCopy: serviceOp_tags

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
