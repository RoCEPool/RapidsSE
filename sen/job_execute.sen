/*============================================================================*/
/* job_execute.sen -- execute 2pc job (pipeline coordination)                 */
/*============================================================================*/

" job_execute.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job_Execute to all participants                                 */
/*----------------------------------------------------------------------------*/
: execute::distribute params| pJobOriginator |

  // "execute::distribute" .

  //
  // where: on the originator node
  //

  job[].tscExecuting

  0 locals| pJob_Execute |

  // create a temporary job_execute
  pJobOriginator job_Execute::new to pJob_Execute

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the no of acks expected in originator job
  grid::knownNodes pJobOriginator job.acksRemaining!

  // send job_execute to all nodes

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.isConnected if
      pNode node.no pJob_Execute job.forward
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete the temporary job_execute
  pJob_Execute job.delete2pc
;

/*----------------------------------------------------------------------------*/
/* run received Job_Execute on participating node   recv: job.spawn */
/*----------------------------------------------------------------------------*/
: execute::execute

  // "execute::execute" .

  //
  // where: on the participating node
  //
  Job[] locals| pJob_Execute |
  0 locals| pTask_Execute |

  // find the job to be executed in the participating jobs
  pJob_Execute job.id@ locals| iJobId |
  iJobId plist::findJob discard

  // stall till job's previous phase (task) has completed
  
  JobRef[].task@ to pTask_Execute
  begin
      pTask_Execute task.state@ TS_HIBERNATING !=
  while
    "job to be executed still has non-hibernating task" .
    [task].yield
  repeat
  pTask_Execute task.cycleLock
    
  
  // "execute::execute" .

  // execute the job on this participating node
  JobRef[] job.scheduleNextPhase // job in participant list ; perform next phase
  JobRef[].returnReference
  
  _job_2pc_delete_
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: execute :: execute ;

: execute_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "execute::execute"
    <path>     = "/"
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
