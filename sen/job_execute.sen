/*============================================================================*/
/* job_execute.sen -- execute 2pc job (pipeline coordination)                 */
/*============================================================================*/

" job_execute.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                          ON PARTICIPATING NODE                             */
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job_Execute on participating node   recv: job.spawn */
/*----------------------------------------------------------------------------*/
: execute:execute

  // "execute:execute" .

  // find the participating job
  [job] job.id@ ListedJob[].findOriginator discard

  // stall till participating job's previous phase (task) has completed
  
  begin
    ListedJob[].task@ task.state@ TS_HIBERNATING !=
  while
    "job to be executed still has non-hibernating task" .
    [task].yield
  repeat
  ListedJob[] task.cycleLock
      
  // execute the job on this participating node
  ListedJob[] job.scheduleNextPhase
  
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: execute :: execute ;

: execute_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "execute:execute"
    <path>     = "/"
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
