/*============================================================================*/
/* OP_pageIn.sen -- Page In Operator                                          */
/*============================================================================*/

" OP_pageIn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_I_PAGEINREQUEST ...                                         */
/*----------------------------------------------------------------------------*/
: pageIn::request \handler

  //PipeIn[] to InfoSet[]
  //nullptr to PipeIn[]

  //pageIn::testPrint

  PipeIn[]\clear to InfoSet[]

  C_TDEF_PAGEINREQUEST infoSetRow:getFirstRow

  // extract the values
  0 InfoSet[].colVal@ locals| pTaskPtr   |
  1 InfoSet[].colVal@ locals| oBufferId  |

  // unload to disk
  pTaskPtr oBufferId pageIn::popRequest

  InfoSet[].delete
  nullptr to InfoSetRow[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: pageIn_RowBuffer \handler

  PipeIn[]\clear pageIn::PageInPoolBuffer

  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for pageIn req                            (on node where spawned)  */
/*----------------------------------------------------------------------------*/
: pageIn_op \operator

  _lu_initialise_

  "<testTag>" [job].tagSet@ tagSet.hasName if
      <testTag> .
  then

  op__topology

  //find: pageIn_RowBuffer   EV_D_ROWBUFFER   [op].handler!
  find: pageIn::request     EV_I_PAGEINREQUEST   [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: pageIn :: pageIn ;

: pageIn_cmdTags _cmdTags tagCopy: op_tags
  tags{
    //<dedicatedThd> = 1
    <opEntry> = "pageIn_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/