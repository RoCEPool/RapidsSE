/*============================================================================*/
/* OP_pageIn.sen -- Page In Operator                                          */
/*============================================================================*/

" OP_pageIn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: pageIn::request \handler

/*
  PipeIn[]\clear to InfoSet[]

  C_TDEF_PAGEINREQUEST infoSetRow:getFirstRow

  // extract the values
  0 InfoSet[].colVal@ locals| pTaskPtr   |
  1 InfoSet[].colVal@ locals| oBufferId  |

  // unload to disk
  pTaskPtr oBufferId pageIn::popRequest

  InfoSet[].delete
  nullptr to InfoSetRow[]
*/

  C_TDEF_PAGEINREQUEST InfoSet:discover

  Pipein[].bufferType BT_PATH != if
    PipeIn[].pipeout
    true
    exit
  then

  PipeIn[]\clear to RowBuffer[]

  RowBuffer[].firstRow to InfoSetRow[]

  0 InfoSetRow[].getIntColumn locals| pTaskPtr  |
  1 InfoSetRow[].getIntColumn locals| oBufferId |

  // unload to disk
  pTaskPtr oBufferId pageIn::popRequest

  RowBuffer[].delete
  nullptr to InfoSetRow[]
  true
;

/*----------------------------------------------------------------------------*/
/* execute for pageIn req                            (on node where spawned)  */
/*----------------------------------------------------------------------------*/
: pageIn_op \operator

  _lu_initialise_

  "<testTag>" [job].tagSet@ tagSet.hasName if
      <testTag> .
  then

  op__topology

  find: pageIn::request     EV_D_ROWBUFFER  [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: pageIn :: pageIn ;

: pageIn_cmdTags _cmdTags tagCopy: op_tags
  tags{
    //<dedicatedThd> = 1
    <opEntry> = "pageIn_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/