/*============================================================================*/
/* OP_sink.sen -- Operator sink                                               */
/*============================================================================*/

" OP_sink.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_Xyz ...                                                     */
/*----------------------------------------------------------------------------*/
: sink_Xyz \handler

  // delete all operands
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: sink_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose
  PipeIn[].delete
  Operand[].newCancelledMarker
  Operand[]\clear to Pipein[]

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CLEANUPMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: sink_CleanupMarker \handler

  //"Operand:- ZK_CLEANUPMARKER" .verbose
  PipeIn[].delete
  Operand[].newCleanedupMarker
  Operand[].pipeOut
  true

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENDINGMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: sink_EndingMarker \handler

  //"Operand:- ZK_ENDINGMARKER" .verbose
  PipeIn[].delete
  Operand[].newEndedMarker
  Operand[]\clear to Pipein[]

  Pipein[].pipeOut
  true

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: sink_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  PipeIn[].delete

  // check if start has already been errored
  Pipeline::errored@ not if

    //grid::thisNodeName@ "(%v) sinkOP got error marker" .printf

    // mark pipeline as being errored
    true Pipeline::errored!

    // now pipeout an exit marker
    Operand[].newErroredMarker
    Operand[].pipeOut

  //else
  //  grid::thisNodeName@ "(%v) sinkOP ignoring error marker" .printf
  then

  find: sink_Xyz  ZK_STARTMARKER op[].handler!
  find: sink_Xyz  ZK_DATAPULSE op[].handler!

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: sink_ExitMarker \handler

  //"Operand:- ZK_EXITMARKER" .verbose
  PipeIn[].pipeToOutput
  Operand[].newExitedMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EARLYEXITMARKER ...                                         */
/*----------------------------------------------------------------------------*/
: sink_EarlyExitMarker \handler

  //"Operand:- ZK_EARLYEXITMARKER" .verbose
  PipeIn[].delete

/*
  // check if start has already been exited early
  Pipeline::earlyExit@ not if

    //grid::thisNodeName@ "(%v) sinkOP got early exit marker" .printf

    // mark pipeline as being earlyExit
    true Pipeline::earlyExit!

    // now pipeout an exit marker
    Operand[].newExitedEarlyMarker
    Operand[].pipeOut

  then
*/

   // mark pipeline as being earlyExit
   true Pipeline::earlyExit!

   // now pipeout an exit marker
   Operand[].newExitedEarlyMarker
   Operand[].pipeOut

  find: sink_Xyz  ZK_STARTMARKER op[].handler!
  find: sink_Xyz  ZK_DATAPULSE op[].handler!

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENDMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: sink_EndMarker \handler

  //"Operand:- ZK_ENDMARKER" .verbose
  Pipein[].delete

  // check if sink has already been errored
  Pipeline::errored@ if
    true
    exit
  then

  // check if sink has already been exitEarly
  Pipeline::earlyExit@ if
    true
    exit
  then

  // check if sink has already been cancelled
  Pipeline::cancelled@ if
    true
    exit
  then

  Operand[].newEndingMarker
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: sink_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  PipeIn[].delete
  Operand[].newStartedMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for sink request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sink_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sink_Xyz op[].handlerAll!

  find: sink_CancelMarker  ZK_CANCELMARKER  op[].handler!
  find: sink_CleanupMarker ZK_CLEANUPMARKER op[].handler!
  find: sink_EndMarker     ZK_ENDMARKER  op[].handler!
  find: sink_EndingMarker  ZK_ENDINGMARKER  op[].handler!
  find: sink_ErrorMarker   ZK_ERRORMARKER   op[].handler!
  find: sink_ExitMarker    ZK_EXITMARKER    op[].handler!
  find: sink_EarlyExitMarker ZK_EARLYEXITMARKER  op[].handler!
  find: sink_StartMarker   ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: sink :: sink ;

: sink_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
