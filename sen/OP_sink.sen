/*============================================================================*/
/* OP_sink.sen -- Operator sink                                               */
/*============================================================================*/

" OP_sink.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_Xyz ...                                                     */
/*----------------------------------------------------------------------------*/
: sink_Xyz \handler

  // delete all operands
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CANCELLING ...                                            */
/*----------------------------------------------------------------------------*/
: sink_Cancelling \handler

  //"Operand:- EV_M_CANCELLING" .verbose
  PipeIn[].delete
  Marker[].newCancelledMarker
  Marker[]\clear to Pipein[]

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: sink_Cleaning \handler

  //"Operand:- EV_M_CLEANING" .verbose
  PipeIn[].delete

  LogicUnit[].cleanup

  Marker[].newCleanedupMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ENDING ...                                                */
/*----------------------------------------------------------------------------*/
: sink_EndingMarker \handler

  //"Operand:- EV_M_ENDING" .verbose
  PipeIn[].delete
  Marker[].newEndedMarker
  Marker[].pipeOut
  true

;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ERRORING ...                                              */
/*----------------------------------------------------------------------------*/
: sink_ErroringMarker \handler

  //"Operand:- EV_M_ERRORED" .verbose
  PipeIn[].delete

  // now pipeout an exit marker
  Marker[].newErroredMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ERROR ...                                                 */
/*----------------------------------------------------------------------------*/
: sink_ErrorMarker \handler

  //"Operand:- EV_M_ERROR" .verbose
  PipeIn[].delete

  // check if sink has already been errored
  [pipeline].errored@ not if

    //[grid].thisNodeName@ "(%v) sinkOP got error marker" .printf

    // mark pipeline as having an errored
    true [pipeline].errored!

    // now pipeout an exit marker
    Marker[].newErroringMarker
    Marker[].pipeOut

  //else
  //  [grid].thisNodeName@ "(%v) sinkOP ignoring error marker" .printf
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EXITING ...                                               */
/*----------------------------------------------------------------------------*/
: sink_Exiting \handler

  //"Operand:- EV_M_EXITING" .verbose
  PipeIn[].delete

  // pipeout an exit operand to output
  ExitOperand[].newExitOperand
  ExitOperand[].pipeToOutput

  // pipe out and exited marker
  Marker[].newExitedMarker
  Marker[].pipeOut

  // ack the invoking task
  [op].ackInvokingTask

  false
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LEAVE ...                                                 */
/*----------------------------------------------------------------------------*/
: sink_LeaveMarker \handler

  //"Operand:- EV_M_LEAVE" .verbose
  PipeIn[].delete

   // mark pipeline as being earlyExit
   true [pipeline].earlyExit!

   // now pipeout a leaving marker
   Marker[].newLeavingMarker
   Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LEAVING ...                                               */
/*----------------------------------------------------------------------------*/
: sink_LeavingMarker \handler

  //"Operand:- EV_M_LEAVING" .verbose
  PipeIn[].delete

  // now pipeout an exit marker
  Marker[].newLeftMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: sink_EndMarker \handler

  //"Operand:- EV_M_END" .verbose
  Pipein[].delete

  // check if sink has already been errored
  [pipeline].errored@ if
    true
    exit
  then

  // check if sink has already been exitEarly
  [pipeline].earlyExit@ if
    true
    exit
  then

  // check if sink has already been cancelled
  [pipeline].cancelled@ if
    true
    exit
  then

  Marker[].newEndingMarker
  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: sink_StartMarker \handler

  //"Operand:- EV_M_START" .verbose
  PipeIn[].delete
  Marker[].newStartedMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for sink request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sink_op \operator

  _lu_initialise_

  op__topology

  find: sink_Xyz [op].handlerAll!

  find: sink_Cancelling      EV_M_CANCELLING [op].handler!
  find: sink_Cleaning        EV_M_CLEANING   [op].handler!
  find: sink_EndMarker       EV_M_END        [op].handler!
  find: sink_EndingMarker    EV_M_ENDING     [op].handler!
  find: sink_ErrorMarker     EV_M_ERROR      [op].handler!
  find: sink_ErroringMarker  EV_M_ERRORING   [op].handler!
  find: sink_Exiting         EV_M_EXITING    [op].handler!
  find: sink_LeaveMarker     EV_M_LEAVE      [op].handler!
  find: sink_LeavingMarker   EV_M_LEAVING    [op].handler!
  find: sink_StartMarker     EV_M_START      [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: sink :: sink ;

: sink_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "sink_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
