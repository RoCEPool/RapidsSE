/*============================================================================*/
/* OP_sink.sen -- Operator sink                                               */
/*============================================================================*/

" OP_sink.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_Xyz ...                                                     */
/*----------------------------------------------------------------------------*/
: sink_Xyz \handler

  // delete all operands
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CANCELLING ...                                            */
/*----------------------------------------------------------------------------*/
: sink_Cancelling \handler

  //"Operand:- ZK_M_CANCELLING" .verbose
  PipeIn[].delete
  Marker[].newCancelledMarker
  Marker[]\clear to Pipein[]

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: sink_Cleaning \handler

  //"Operand:- ZK_M_CLEANING" .verbose
  PipeIn[].delete

  LogicUnit[].cleanup

  Marker[].newCleanedupMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ENDING ...                                                */
/*----------------------------------------------------------------------------*/
: sink_EndingMarker \handler

  //"Operand:- ZK_M_ENDING" .verbose
  PipeIn[].delete
  Marker[].newEndedMarker
  Marker[].pipeOut
  true

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ERRORING ...                                              */
/*----------------------------------------------------------------------------*/
: sink_ErroringMarker \handler

  //"Operand:- ZK_M_ERRORED" .verbose
  PipeIn[].delete

  // now pipeout an exit marker
  Marker[].newErroredMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ERROR ...                                                 */
/*----------------------------------------------------------------------------*/
: sink_ErrorMarker \handler

  //"Operand:- ZK_M_ERROR" .verbose
  PipeIn[].delete

  // check if sink has already been errored
  Pipeline::errored@ not if

    //grid::thisNodeName@ "(%v) sinkOP got error marker" .printf

    // mark pipeline as having an errored
    true Pipeline::errored!

    // now pipeout an exit marker
    Marker[].newErroringMarker
    Marker[].pipeOut

  //else
  //  grid::thisNodeName@ "(%v) sinkOP ignoring error marker" .printf
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EXITING ...                                               */
/*----------------------------------------------------------------------------*/
: sink_Exiting \handler

  //"Operand:- ZK_M_EXITING" .verbose
  PipeIn[].pipeToOutput
  Marker[].newExitedMarker
  Marker[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_LEAVE ...                                                 */
/*----------------------------------------------------------------------------*/
: sink_LeaveMarker \handler

  //"Operand:- ZK_M_LEAVE" .verbose
  PipeIn[].delete

   // mark pipeline as being earlyExit
   true Pipeline::earlyExit!

   // now pipeout a leaving marker
   Marker[].newLeavingMarker
   Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_LEAVING ...                                               */
/*----------------------------------------------------------------------------*/
: sink_LeavingMarker \handler

  //"Operand:- ZK_M_LEAVING" .verbose
  PipeIn[].delete

  // now pipeout an exit marker
  Marker[].newLeftMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: sink_EndMarker \handler

  //"Operand:- ZK_M_END" .verbose
  Pipein[].delete

  // check if sink has already been errored
  Pipeline::errored@ if
    true
    exit
  then

  // check if sink has already been exitEarly
  Pipeline::earlyExit@ if
    true
    exit
  then

  // check if sink has already been cancelled
  Pipeline::cancelled@ if
    true
    exit
  then

  Marker[].newEndingMarker
  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: sink_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose
  PipeIn[].delete
  Marker[].newStartedMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for sink request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sink_req \operator

  _lu_initialise_

  op__topology

  find: sink_Xyz op[].handlerAll!

  find: sink_Cancelling      ZK_M_CANCELLING op[].handler!
  find: sink_Cleaning        ZK_M_CLEANING   op[].handler!
  find: sink_EndMarker       ZK_M_END        op[].handler!
  find: sink_EndingMarker    ZK_M_ENDING     op[].handler!
  find: sink_ErrorMarker     ZK_M_ERROR      op[].handler!
  find: sink_ErroringMarker  ZK_M_ERRORING   op[].handler!
  find: sink_Exiting         ZK_M_EXITING    op[].handler!
  find: sink_LeaveMarker     ZK_M_LEAVE      op[].handler!
  find: sink_LeavingMarker   ZK_M_LEAVING    op[].handler!
  find: sink_StartMarker     ZK_M_START      op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: sink :: sink ;

: sink_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
