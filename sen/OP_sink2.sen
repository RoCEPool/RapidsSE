/*============================================================================*/
/* OP_sink2.sen -- Operator sink                                               */
/*============================================================================*/

" OP_sink2.sen" .

/*----------------------------------------------------------------------------*/
/* handler for ZK_Xyz ...                                                     */
/*----------------------------------------------------------------------------*/
: sink2_Xyz \handler

  // delete all operands
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CANCELLING ...                                            */
/*----------------------------------------------------------------------------*/
: sink2_Cancelling \handler

  "SINKOP:- ZK_M_CANCELLING" .
  PipeIn[].delete
  Operand[].newCancelledMarker
  Operand[]\clear to Pipein[]

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                               */
/*----------------------------------------------------------------------------*/
: sink2_Cleaning \handler

  "SINKOP:- ZK_M_CLEANING" .
  PipeIn[].delete
  Operand[].newCleanedupMarker
  Operand[].pipeOut
  true

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ENDING ...                                                */
/*----------------------------------------------------------------------------*/
: sink2_EndingMarker \handler

  "SINKOP:- ZK_M_ENDING" .
  PipeIn[].delete
  Operand[].newEndedMarker
  Operand[]\clear to Pipein[]

  Pipein[].pipeOut
  true

;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ERRORING ...                                              */
/*----------------------------------------------------------------------------*/
: sink2_ErroringMarker \handler

  "SINKOP:- ZK_M_ERRORED" .
  PipeIn[].delete

  // now pipeout an exit marker
  Operand[].newErroredMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ERROR ...                                                 */
/*----------------------------------------------------------------------------*/
: sink2_ErrorMarker \handler

  "SINKOP:- ZK_M_ERROR" .
  PipeIn[].delete

  // check if sink has already been errored
  Pipeline::errored@ not if

    //grid::thisNodeName@ "(%v) sinkOP got error marker" .printf

    // mark pipeline as having an errored
    true Pipeline::errored!

    // now pipeout an exit marker
    Operand[].newErroringMarker
    Operand[].pipeOut

  //else
  //  grid::thisNodeName@ "(%v) sinkOP ignoring error marker" .printf
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EXITING ...                                               */
/*----------------------------------------------------------------------------*/
: sink2_Exiting \handler

  "SINKOP:- ZK_M_EXITING" .
  PipeIn[].pipeToOutput
  Operand[].newExitedMarker
  Operand[].pipeOut
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_LEAVE ...                                                 */
/*----------------------------------------------------------------------------*/
: sink2_LeaveMarker \handler

  "SINKOP:- ZK_M_LEAVE" .
  PipeIn[].delete

   // mark pipeline as being earlyExit
   true Pipeline::earlyExit!

   // now pipeout a leaving marker
   Operand[].newLeavingMarker
   Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_LEAVING ...                                               */
/*----------------------------------------------------------------------------*/
: sink2_LeavingMarker \handler

  "SINKOP:- ZK_M_LEAVING" .
  PipeIn[].delete

  // now pipeout an exit marker
  Operand[].newLeftMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_END ...                                                   */
/*----------------------------------------------------------------------------*/
: sink2_EndMarker \handler

  "SINKOP:- ZK_M_END" .
  Pipein[].delete

  // check if sink has already been errored
  Pipeline::errored@ if
    true
    exit
  then

  // check if sink has already been exitEarly
  Pipeline::earlyExit@ if
    true
    exit
  then

  // check if sink has already been cancelled
  Pipeline::cancelled@ if
    true
    exit
  then

  Operand[].newEndingMarker
  Operand[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: sink2_StartMarker \handler

  "SINKOP:- ZK_M_START" .
  PipeIn[].delete
  Operand[].newStartedMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for sink request                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sink2_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: sink2_Xyz op[].handlerAll!

  find: sink2_Cancelling      ZK_M_CANCELLING op[].handler!
  find: sink2_Cleaning        ZK_M_CLEANING   op[].handler!
  find: sink2_EndMarker       ZK_M_END        op[].handler!
  find: sink2_EndingMarker    ZK_M_ENDING     op[].handler!
  find: sink2_ErrorMarker     ZK_M_ERROR      op[].handler!
  find: sink2_ErroringMarker  ZK_M_ERRORING   op[].handler!
  find: sink2_Exiting         ZK_M_EXITING    op[].handler!
  find: sink2_LeaveMarker     ZK_M_LEAVE      op[].handler!
  find: sink2_LeavingMarker   ZK_M_LEAVING    op[].handler!
  find: sink2_StartMarker     ZK_M_START      op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: sink2 :: sink2 ;

: sink2_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
