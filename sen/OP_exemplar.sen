/*============================================================================*/
/* OP_exemplar.sen -- exemplar Operator                                       */
/*============================================================================*/

" OP_exemplar.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_exemplar_EosMarker \handler

  "OP_exemplar_EosMarker" .

  true
;

/*----------------------------------------------------------------------------*/
/* exemplar request                                   (on node where spawned) */
/*----------------------------------------------------------------------------*/
: exemplar_req \operator

  LogReqEntry SEED_REQ

  // set topology, next stage and op
  op__topology

  //find: OP_exemplar_EosMarker ZK_EOSMARKER op[].handler!

  op__loop

  "*** OP_exemplar_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exemplar :: exemplar ;

: exemplar _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
