/*============================================================================*/
/* job__End.sen -- generic job related words                                  */
/*============================================================================*/

" job__End.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job__End to all participants                                    */
/*----------------------------------------------------------------------------*/
: Job__End::distribute params| pJobOriginator |

  //
  // where:  On the originator node.
  //

  0 locals| pJob__End |

  // new a temporary Job__End
  pJobOriginator job__End::new to pJob__End

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the no of acks expected in originator job
  grid::knownNodes pJobOriginator job.acksRemaining!

  // send Job__End to all nodes

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.isConnected if
      pNode node.no pJob__End job.forward
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete the temporary Job__End
  pJob__End job.delete2pc
;

/*----------------------------------------------------------------------------*/
/* run received Job__End on participating node       recv: job.spawn */
/*----------------------------------------------------------------------------*/
: _End_run [ word::seed# ]

  //
  // where: on the participating node
  //
  //grid::thisNodeName@ "(%v) RECEIVED END" .printf
  Job[] locals| pJob__End |

  // find the job to be executed in the participating jobs
  pJob__End job.id@ locals| iJobId |
  iJobId plist::findJob discard

  // stall till job's previous phase (task) has completed
  begin
    JobRef[].hasTask
  while
    Task[].yield 
  repeat

  // execute the end seed of the job on this participating node
  JM_SEED_END JobRef[] job.seed!
  JobRef[] job.scheduleNextPhase
  JobRef[].returnReference
  
  _job_2pc_delete_
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: _End :: _End ;

: _End_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <seedRun>  = "_end_run"
    <path>     = "/"
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
