/*============================================================================*/
/* OP_statWrite.sen -- Operator statWrite                                     */
/*============================================================================*/

" OP_statWrite.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_I_LOCKSTATS ...                                               */
/*----------------------------------------------------------------------------*/
: OP_statWrite_LockStats \handler

  //"statWrite_InfoSet --- --- ---" .

//! ALKA TO CHECK WITH RAY
//  File0[].isNull not if
//    "File not null" .
//    process::quit
//  then

  // open the file for writing
  "/tmp/SE_Stats.csv" OPEN_APPEND op__file if

    PipeIn[] to InfoSet[]
    nullptr to PipeIn[]

    C_TDEF_LOCKSTATS op__tableDef_infoSet assert

    infoSetTable[] InfoSet[].writeCsv

    InfoSet[].delete

    //File0[].get file.close
    //File0[].get file.delete
  else
    Pipein[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PROFILE ...                                               */
/*----------------------------------------------------------------------------*/
: OP_statWrite_Profile \handler

  //"statWrite_Profile --- --- ---" .

  // open the file for writing
  "/tmp/SE_Profile.csv" OPEN_APPEND op__file if

    PipeIn[].writeProfile

    PipeIn[].delete

    //File0[].get file.close
    //File0[].get file.delete
  else
    Pipein[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for statWrite req                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : statWrite_req \operator
 
  _lu_initialise_

  op__topology

  find: OP_statWrite_LockStats ZK_I_LOCKSTATS op[].handler!
  find: OP_statWrite_Profile   ZK_D_PROFILE   op[].handler!

  op__loop

  _lu_finalise_
  
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: statWrite :: statWrite ;

: statWrite_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
