/*============================================================================*/
/* OP_output.sen -- Operator output                                           */
/*============================================================================*/

" OP_output.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_I_COMPILEERRORS ...                                         */
/*----------------------------------------------------------------------------*/
: output_CompileErrors \handler

  //"Operand:- EV_I_COMPILEERRORS" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: output_CrwBuffer \handler

  //"Operand:- EV_D_CRWBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CSVBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: output_CsvBuffer \handler

  //"Operand:- EV_D_CSVBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ENTBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: output_EntBuffer \handler

  //"Operand:- EV_D_ENTBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_I_EXECERRORS ...                                            */
/*----------------------------------------------------------------------------*/
: output_ExecErrors \handler

  //"Operand:- EV_I_EXECERRORS" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_I_LOADRESULT ...                                            */
/*----------------------------------------------------------------------------*/
: output_LoadResult \handler

  //"Operand:- EV_I_LOADRESULT" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_I_PROMPTOUT ...                                             */
/*----------------------------------------------------------------------------*/
: output_promptOut \handler

  //"Operand:- EV_I_PROMPTOUT" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: output_RowBuffer \handler

  //"Operand:- EV_D_ROWBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_SRTBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: output_SrtBuffer \handler

  //"Operand:- EV_D_SRTBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: output_StreamDef \handler

  //"Operand:- EV_D_STREAMDEF" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMSET ...                                             */
/*----------------------------------------------------------------------------*/
: output_StreamSet \handler

  //"Operand:- EV_D_STREAMSET" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* execute for output request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: output_op \operator

  _lu_initialise_

  op__topology

  find: output_CrwBuffer     EV_D_CRWBUFFER     [op].handler!
  find: output_CsvBuffer     EV_D_CSVBUFFER     [op].handler!
  find: output_EntBuffer     EV_D_ENTBUFFER     [op].handler!
  find: output_RowBuffer     EV_D_ROWBUFFER     [op].handler!
  find: output_SrtBuffer     EV_D_SRTBUFFER     [op].handler!
  find: output_StreamDef     EV_D_STREAMDEF     [op].handler!
  find: output_StreamDef     EV_D_STREAMSET     [op].handler!

  find: output_CompileErrors EV_I_COMPILEERRORS [op].handler!
  find: output_ExecErrors    EV_I_EXECERRORS    [op].handler!
  find: output_LoadResult    EV_I_LOADRESULT    [op].handler!
  find: output_PromptOut     EV_I_PROMPTOUT     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: output :: output ;

: output_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "output_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
