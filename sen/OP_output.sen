/*============================================================================*/
/* OP_output.sen -- Operator output                                           */
/*============================================================================*/

" OP_output.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_COMMANDERRORS ...                                           */
/*----------------------------------------------------------------------------*/
: output_CommandErrors \handler

  //"Operand:- ZK_COMMANDERRORS" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: output_CrwBuffer \handler

  //"Operand:- ZK_CRWBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: output_CsvBuffer \handler

  //"Operand:- ZK_CSVBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: output_DataMarker \handler

  //"Operand:- ZK_DATAPULSE" .verbose
  PipeIn[].pipeOut
  Operand[].newDataPulse
  Operand[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EACHROWBUFFER ...                                           */
/*----------------------------------------------------------------------------*/
: output_EachRowBuffer \handler

  //"Operand:- ZK_EACHROWBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: output_EntBuffer \handler

  //"Operand:- ZK_ENTBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EOSMARKER ...                                               */
/*----------------------------------------------------------------------------*/
: output_EosMarker \handler

  //"Operand:- ZK_EOSMARKER" .verbose
  PipeIn[].pipeToOutput
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: output_ErrorMarker \handler

  //"Operand:- ZK_ERRORMARKER" .verbose
  PipeIn[].pipeToOutput
  Marker[].newErrorMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXECERRORS ...                                              */
/*----------------------------------------------------------------------------*/
: output_ExecErrors \handler

  //"Operand:- ZK_EXECERRORS" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITEARLYMARKER ...                                         */
/*----------------------------------------------------------------------------*/
: output_ExitEarlyMarker \handler

  //"Operand:- ZK_EXITEARLYMARKER" .verbose
  PipeIn[].pipeToOutput

true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_LOADRESULT ...                                              */
/*----------------------------------------------------------------------------*/
: output_LoadResult \handler

  //"Operand:- ZK_LOADRESULT" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PROMPTOUT ...                                               */
/*----------------------------------------------------------------------------*/
: output_promptOut \handler

  //"Operand:- ZK_PROMPTOUT" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ROWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: output_RowBuffer \handler

  //"Operand:- ZK_ROWBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_SRTBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: output_SrtBuffer \handler

  //"Operand:- ZK_SRTBUFFER" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: output_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose
  PipeIn[].pipeToOutput
  Operand[].newStartMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMDEF ...                                               */
/*----------------------------------------------------------------------------*/
: output_StreamDef \handler

  //"Operand:- ZK_STREAMDEF" .verbose
  PipeIn[].pipeToOutput

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STREAMSET ...                                               */
/*----------------------------------------------------------------------------*/
: output_StreamSet \handler

//"Operand:- ZK_STREAMSET" .verbose
PipeIn[].pipeToOutput

true
;

/*----------------------------------------------------------------------------*/
/* execute for output request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: output_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: output_CommandErrors ZK_COMMANDERRORS op[].handler!
  find: output_CrwBuffer     ZK_CRWBUFFER   op[].handler!
  find: output_CsvBuffer     ZK_CSVBUFFER   op[].handler!
  find: output_DataMarker    ZK_DATAPULSE   op[].handler!
  find: output_EachRowBuffer ZK_EACHROWMARKER op[].handler!
  find: output_EntBuffer     ZK_ENTBUFFER   op[].handler!
  find: output_EosMarker     ZK_EOSMARKER   op[].handler!
  find: output_ErrorMarker   ZK_ERRORMARKER op[].handler!
  find: output_ExecErrors    ZK_EXECERRORS  op[].handler!
  find: output_ExitEarlyMarker ZK_EXITEARLYMARKER op[].handler!
  find: output_LoadResult    ZK_LOADRESULT  op[].handler!
  find: output_PromptOut     ZK_PROMPTOUT   op[].handler!
  find: output_RowBuffer     ZK_ROWBUFFER   op[].handler!
  find: output_SrtBuffer     ZK_SRTBUFFER   op[].handler!
  find: output_StartMarker   ZK_STARTMARKER op[].handler!
  find: output_StreamDef     ZK_STREAMDEF   op[].handler!
  find: output_StreamDef     ZK_STREAMSET   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: output :: output ;

: output_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
