/*============================================================================*/
/* cmd_end.sen -- 1sc: given pipeline is to end on participant                */
/*============================================================================*/

" cmd_end.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: end:onParticipant
  // "end:end" .

/* >end ptp */  [args].distJob if
/* >end ptp */    "end" "onParticipant" ">end ptp sch next phase" [job].trace
/* >end ptp */  then
/* >end ptp */
/* >end ptp */  // find job to be ended in participating job list
/* >end ptp */  [job].distId@ ListedJob[].findParticipant? if
/* >end ptp */
/* >end ptp */    // stall till job's previous phase (task) has completed
/* >end ptp */    begin
/* >end ptp */      ListedJob[].taskState@ TS_HIBERNATING !=
/* >end ptp */    while
/* >end ptp */      "job to be ended still has non-hibernating task" .
/* >end ptp */      [task].yield
/* >end ptp */    repeat
/* >end ptp */    ListedJob[].cycleTaskLock
/* >end ptp */
/* >end ptp */    // execute the job on this participating node
/* >end ptp */    ListedJob[].scheduleNextPhase
/* >end ptp */
/* >end ptp */    ListedJob[].returnReference
/* >end ptp */  then
/* >end ptp */
/* >end ptp */  [job]:retireAndExit
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON ORIGINATING NODE OF GIVEN PIPELINE                      */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on origin node                                                             */
/*----------------------------------------------------------------------------*/
: end:onOrigin
  //"end:onOrigin" .

/* >end org */  [args].distJob if
/* >end org */    "end" "onOrigin" ">end org brd all ptp" [job].trace
/* >end org */  then
/* >end org */
/* >end org */  "end:onParticipant" [job].entryPoint!
/* >end org */
/* >end org */  [job]:broadcast
/* >end org */
/* >end org */  [job]:retireAndExit
/* >end org */  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: end :: end ;

: end_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "end:onOrigin"
    <path>     = "/"
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
