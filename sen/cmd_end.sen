/*============================================================================*/
/* cmd_end.sen -- 1sc: given pipeline is to end on participant                */
/*============================================================================*/

" cmd_end.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: end:onParticipant

  // "end:end" .

  // find job to be ended in participating job list
  [job].parentId@ ListedJob[].findParticipant? if

    // stall till job's previous phase (task) has completed
    begin
      ListedJob[].taskState@ TS_HIBERNATING !=
    while
      "job to be ended still has non-hibernating task" .
      [task].yield
    repeat
    ListedJob[].cycleTaskLock
      
    // execute the job on this participating node
    ListedJob[].scheduleNextPhase
    
    ListedJob[].returnReference
  then
  
  [job]:retire
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON ORIGINATING NODE OF GIVEN PIPELINE                      */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on origin node                                                             */
/*----------------------------------------------------------------------------*/
: end:end

  //"end:end" .

  "end:onParticipant" [job].entryPoint!

  [job] job:broadcast

  [job]:retire
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: end :: end ;

: end_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "end:end"
    <path>     = "/"
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
