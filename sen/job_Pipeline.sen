/*============================================================================*/
/* job_Pipeline.sen -- Pipeline Job (being a distributed job)                 */
/*============================================================================*/

" job_Pipeline.sen" .verbose

/*----------------------------------------------------------------------------*/
/* pipeline request (on originating node)                                     */
/*----------------------------------------------------------------------------*/
: pipeline::request _eeh_suffix ( -- <R> )

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline statement on origin to check its syntax
  
  <cmd> Pipeline::compileStmt dup
  EC_NONE != if
    job::error! exit
  else
    Pipeline::deleteSpec
    discard
  then
;

/*----------------------------------------------------------------------------*/
/* execute pipeline job on participating node                                 */
/*----------------------------------------------------------------------------*/
: pipeline::execute _eeh_suffix ( -- )

  task[] locals| pTask |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // run optional <pre_execute> word

  "<pre_execute>" job::tagSet@ tagSet.hasName if
    "<pre_execute>"
    job::tagSet@ tagSet.getStr locals| sPreExe |
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
      process::quit
    then
      execute
  else
    args.verbose if
      <pipelineNm> "No pre execute word for pipeline: %v" .printf
    then
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab the task lock
  
  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // enqueue startmarker to start op to execute the pipeline job
  
  //<pipelineNm> "%v execute" .printf
  Pipeline::enqueueStart not if
    //<pipelineNm> grid::thisNodeName@ "(%v) nothing to do" .printf
    pTask task.dropLock
    exit
  then
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // wait for operators to finish
  
  //<pipelineNm> grid::thisNodeName@ "(%v) %v waiting on task::wait" .printf
  task::wait
  //<pipelineNm> grid::thisNodeName@ "(%v) %v running" .printf
;

/*----------------------------------------------------------------------------*/
/* check resources for pipeline on participating node                         */
/*----------------------------------------------------------------------------*/
: pipeline::checkResources _eeh_suffix ( -- )

  job[] job.phase@ JP_BEGINNING assert
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline statement 
  
  <cmd> Pipeline::compileStmt
  EC_NONE == assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin the pipeline job (spawning jobs for ops etc)
  
  Pipeline::create
  Pipeline::spawnOpTasks
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipeline :: pipeline <pipelineNm> etc ;

: pipeline_cmdTags _cmdTags tagCopy: distJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <ddlLock>  = DL_GRAB_READ
    <preCheck> = bClusterStarted
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
