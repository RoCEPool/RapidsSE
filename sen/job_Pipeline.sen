/*============================================================================*/
/* job_Pipeline.sen -- Pipeline Job (being a distributed job)                 */
/*============================================================================*/

" job_Pipeline.sen" .verbose


/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
/*                               ON ORIGIN                                    */
/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

/*----------------------------------------------------------------------------*/
/* request execution of a distributed pipeline (on originating node)          */
/*----------------------------------------------------------------------------*/
: pipeline::request ( -- <R> )

  "<preCheck>" job::tagSet@ tagSet.hasName if
  
    <preCheck> find execute not if

      job::error!

      //"Signalling waiting thread" .
      job::informInvokerOfCompletion

      // task has no job
      task::scheduledelete

      DdlLock[].testDrop

      _job_finalise_

      exit                                                         // EARLY EXIT

    then
  then

  // [ senCompiler::current@ word.name@ encode::push ] .
  // <jobNm> .

  job::becomeOriginator

  
  
  // : pipeline::request
  
  job::assertCorrectness

  // compile the pipeline statement on origin to check its syntax
  
  <cmd> Pipeline::compileStmt dup
  EC_NONE != if
    job::error!
  else
    Pipeline::deleteSpec
    discard
  then

  
  

  job[] job.hasError not if

    // distribute the job
    job::sendToParticipants

    // wait for the signal from deciding job__ended/cancelled
    task::wait

  else
    job[] job.removeOriginator  // this is currently being done by job_ended
  then

  //"Signalling waiting thread" .
  job::informInvokerOfCompletion

  // task has no job
  task::scheduledelete

  DdlLock[].testDrop

  _job_finalise_

  HAZARD

;


/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
/*                          ON ALL PARTICIPANTS                               */
/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

/*----------------------------------------------------------------------------*/
/* begin pipeline job                                                         */
/*----------------------------------------------------------------------------*/
: pipeline::begin ( -- )

  // [ senCompiler::current@ word.name@ encode::push ] .

  JP_BEGINNING job[] job.phase!

  <path> str.toStrVec Path[].set

  job::becomeParticipant




  // : pipeline::begin ( -- )

  job::assertCorrectness

  job[] job.phase@ JP_BEGINNING assert
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline statement on participants (should not expect an error)
  
  <cmd> Pipeline::compileStmt
  EC_NONE == assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin the pipeline job (spawning jobs for ops etc)
  
  Pipeline::create
  Pipeline::spawnOpTasks











  JP_BEGUN job[] job.phase!
  nullptr job[] job.seedWord!
  
  job[] "Job__Begun::replyToOrigin" find execute
  
  DdlLock[].testDrop

  task::scheduledelete

  HAZARD

;

/*----------------------------------------------------------------------------*/
/* execute pipeline job                                                       */
/*----------------------------------------------------------------------------*/
: pipeline::execute ( -- )

;

/*----------------------------------------------------------------------------*/
/* end pipeline job                                                           */
/*----------------------------------------------------------------------------*/
: pipeline::end ( -- )

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/* end pipeline job                                                           */
/*----------------------------------------------------------------------------*/
: pipeline::cancel ( -- )

  job::assertCorrectness
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipeline :: pipeline <pipelineNm> etc ;

: pipeline_cmdTags _cmdTags tagCopy: distJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <ddlLock>  = DL_GRAB_READ
    <preCheck> = bClusterStarted
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
