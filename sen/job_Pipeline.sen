/*============================================================================*/
/* job_Pipeline.sen -- Pipeline Job (being a distributed job)                 */
/*============================================================================*/

" job_Pipeline.sen" .verbose


/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
/*                               ON ORIGIN                                    */
/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

/*----------------------------------------------------------------------------*/
/* distribute current originating job to all participating nodes              */
/*----------------------------------------------------------------------------*/
: job::sendToParticipants ( -- )

  job[] locals| pJob |

  // create the response vector in the orginating job to receive responses
  //pJob job.createResponseVec

  // set the no of acks expected by originator job
  //   to be the number of defined nodes in the grid
  grid::knownNodes pJob job.acksRemaining!


  // set acks for originator task
  1 task::acks!

  // send the job to each connected node in the grid

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.sendSocket@ if
      pNode node.no pJob job.forward
    else
      "++++++++++++++++++++++++++++++++++ NO SOCKET FOR NODE" .
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete
;

/*----------------------------------------------------------------------------*/
/* terminate this origin pipeline                                             */
/*----------------------------------------------------------------------------*/
: pipeline::terminate_origin ( -- )

  _lu_finalise_

  _job_finalise_

  task[] task.grabLock
  TR_DELETE_THIS_TASK task::transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* terminate this participant pipeline                                        */
/*----------------------------------------------------------------------------*/
: pipeline::terminate_participant ( -- )
  
  JS_DELETABLE job::state!
  
  task[] task.grabLock
  TR_DELETE_THIS_TASK task::transition!

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* launch of a distributed pipeline on originating node                       */
/*----------------------------------------------------------------------------*/
: pipeline::origin ( -- <R> )

  job::assertCorrectness

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // pre-check
  
  "<preCheck>" job::tagSet@ tagSet.hasName if
  
    <preCheck> find execute not if

      job::error!

      task[] task.grabLock
      Session[].signal
      task[] task.dropLock

      pipeline::terminate_origin

      HAZARD

    then
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // become an originator
  
   // set originating task
  task[] job[] job.originatingTask!

  job[] job.id@ job[] job.originatingId!

  // add job to originator jobs
  job[] job.addOriginator
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline statement on origin to check its syntax
  
  <cmd> Dynamo::compileStmt dup
  EC_NONE == if
    // clean compile of pipeline statement
    discard
    PipelineSpec[].delete
  else
    // pipeline statement didnt compile
    job::error!
  then

  // cross check
  PipelineSpec[] not assert

  job[] job.hasError not if

    // grab this task's lock
    task[] task.grabLock
    
    // distribute the job
    job::sendToParticipants

    // wait for the signal from deciding job__ended/cancelled
    task::wait

  else
  
  then

  job[] job.removeOriginator

  job[] job.addRetired
  [? WITH_JOB_REAPING ?if "reaping" . ?else job[] job.removeRetired ?]
  
  task[] task.grabLock
  Session[].signal
  task[] task.dropLock

  pipeline::terminate_origin
  
  HAZARD
;


/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/
/*                          ON ALL PARTICIPANTS                               */
/*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*/

/*----------------------------------------------------------------------------*/
/* begin pipeline job on participant node                                     */
/*----------------------------------------------------------------------------*/
: pipeline::participant ( -- )

  // [ senCompiler::current@ word.name@ encode::push ] .

  JP_BEGINNING job[] job.phase!

  <path> str.toStrVec Path[].set

  job[] locals| pJob |

  // set participant node in job
  grid::thisNode@ pJob job.participant!

  // add job to participant job list
  pJob job.addParticipant

  job::assertCorrectness

  job[] job.phase@ JP_BEGINNING assert
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // compile the pipeline statement on participants (should not expect an error)
  
  <cmd> Dynamo::compileStmt
  EC_NONE == assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // begin the pipeline job (spawning jobs for ops etc)
  
  Pipeline[].create
  Pipeline[].spawnOpTasks

  JP_BEGUN job[] job.phase!
  nullptr job[] job.seedWord!
  
  job[] Job__Begun::replyToOrigin
  
  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute pipeline job                                                       */
/*----------------------------------------------------------------------------*/
: pipeline::execute ( -- )

  // [ senCompiler::current@ word.name@ encode::push ] .

  JP_EXECUTING job[] job.phase!

  // ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! ! !
  // set task's dictionary stack from path in job

  <path> str.toStrVec Path[].set
  //task::dump

  job::acquireDdlLock

  // : pipeline::execute ( -- )

  task[] locals| pTask |
  
  job::assertCorrectness


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // run optional <pre_execute> word

  "<pre_execute>" job::tagSet@ tagSet.hasName if
    "<pre_execute>"
    job::tagSet@ tagSet.getStr locals| sPreExe |
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
      process::quit
    then
      execute
  else
    args.verbose if
      <pipelineNm> "No pre execute word for pipeline: %v" .printf
    then
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // grab the task lock
  
  pTask task.grabLock

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // enqueue start-marker to start op to execute the pipeline job
  
  //<pipelineNm> "%v execute" .printf
  Pipeline::enqueueStart not if
    //<pipelineNm> grid::thisNodeName@ "(%v) nothing to do" .printf
    pTask task.dropLock
  else

    // wait for all operators to ack this job
    task::wait

  then
  
  



  JP_EXECUTED job[] job.phase!
  nullptr job[] job.seedWord!

  job[] Job__Executed::replyToOrigin
  
  DdlLock[].testDrop

  task::scheduledelete

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* end pipeline job                                                           */
/*----------------------------------------------------------------------------*/
: pipeline::end ( -- )

  job::assertCorrectness
  
  
  
  // [ senCompiler::current@ word.name@ encode::push ] .

  //grid::thisNodeName@ "(%v) pipelineSeed _end" .printf

  JP_ENDING job[] job.phase!


  JP_ENDED job[] job.phase!
  nullptr job[] job.seedWord!

  job[] job.removeParticipant

  job[] Job__Ended::replyToOrigin
  
  DdlLock[].testDrop

  _job_finalise_

  pipeline::terminate_participant

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* end pipeline job                                                           */
/*----------------------------------------------------------------------------*/
: pipeline::cancel ( -- )

  job::assertCorrectness
  
    // [ senCompiler::current@ word.name@ encode::push ] .

  JP_CANCELING job[] job.phase!

  JP_CANCELED job[] job.phase!
  nullptr job[] job.seedWord!

  job[] job.removeParticipant

  job[] Job__Cancelled::replyToOrigin
  
  _job_finalise_

  pipeline::terminate_participant

  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: pipeline :: pipeline <pipelineNm> etc ;

: pipeline_cmdTags _cmdTags tagCopy: pipelineJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <ddlLock>  = DL_GRAB_READ
    <preCheck> = bClusterStarted
    
    <seedReq>  = "pipelineSeed_req"
    <seedRcv>  = "pipelineSeed_beg"
    <seedExe>  = "pipelineSeed_exe"
    <seedEnd>  = "pipelineSeed_end"
    <seedCan>  = "pipelineSeed_can"

  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
