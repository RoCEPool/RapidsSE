/*============================================================================*/
/* OP_filterRight.sen -- Operator filterRight columns                         */
/*============================================================================*/

" OP_filterRight.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: filterRight_seapi

  "filterRight_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: filterRight_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // cleanup the pot
  PotRlu[].cleanup

  //Counter0[] cleanUpAsm

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: filterRight_CrwBuffer \handler

  0 ZK_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  // pipeout crwbuffer if not received startRightMarker
  Counter1[] 0 == if
     Pipein[].pipeout
    true
    exit
  then

  Pipein[]\clear to CrwBuffer[]
  CrwBuffer[]\clear DevLftIxt.crwBuffer!
  ZK_D_CRWBUFFER Counter0[] executeAsmArgs

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_ENDCRWRHT ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: filterRight_EndCrwRht \handler

  0 ZK_M_ENDCRWRHT EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_M_EOS Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns

  // record receipt of end right marker
  0 to Counter1[]

  PipeIn[].delete

  // pipeout an EndRowRht
  Marker[].newEndRowRhtMarker
  Marker[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_ENDROWRHT ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: filterRight_EndRowRht \handler

  0 ZK_M_ENDROWRHT EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_M_EOS Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns

  // record receipt of end right marker
  0 to Counter1[]

  PipeIn[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: filterRight_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote

  // Arrival of EOSMARKER implies left is all done

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: filterRight_RowBuffer \handler

  0 ZK_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  // pipeout rowBuffer if startRightMarker not received
  Counter1[] 0 == if
    Pipein[].pipeout
    true
    exit
  then

  Pipein[]\clear to RowBuffer[]
  RowBuffer[]\clear DevLftRow.rowBuffer!
  ZK_D_ROWBUFFER Counter0[] executeAsmArgs

  RowBuffer[].delete

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_STARTCRWRHT ...                                               INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartCrwRht \handler

  0 ZK_M_STARTCRWRHT EG_ZK LogicUnit[].diaryNote

  PipeIn[].delete

  // pipeout a StartRowRht
  Marker[].newStartRowRhtMarker
  Marker[].pipeout

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_STARTROWRHT ...                                               INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartRowRht \handler

  0 ZK_M_STARTROWRHT EG_ZK LogicUnit[].diaryNote

  PipeIn[].pipeout

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_STREAMDEFRHT ...                                              INIT */
/*----------------------------------------------------------------------------*/
: filterRight_M_StreamDefRht \handler

  0 assert
  0 ZK_M_STREAMDEFRHT EG_ZK LogicUnit[].diaryNote

  PipeIn[].pipeout

  // record receipt of streamDef right marker
  1 to Counter2[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEFRHT ...                                      STREAMDEFRHT */
/*----------------------------------------------------------------------------*/
: filterRight_StreamDefRht \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  // would have received a streamDefRht marker

  // move pipein[] to StreamDefRht[]
  Pipein[]\clear to StreamDefRht[]

  // evaluate the expression
  ExprEval[].new
  StreamDefRht[].duplicate to StreamDefOut[]

  <etc> StreamDefRht[] nullptr ExprEval[].evaluate to eError

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // generate the asm for the filterRight
  ExprEval[] LogicUnit[].genfilter to eError
  ExprEval[].delete

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // set the streamDef in the DevLftRow
  StreamDefRht[] DevLftRow.streamDef!

  // create rowPix in potRlu[] from streamDefOut[]
  false StreamDefOut[] PotRlu[].rowPix!

  StreamDefOut[] StreamDefRht[].new
  StreamDefOut[].delete

  // pipeout the streamDefOut
  StreamDefRht[].pipeout

  // create the compiler
  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then

  // execute the streamDef asm handler
  ZK_D_STREAMDEF Counter0[] executeAsmArgs

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filterRight request                                                  SPAWN */
/*----------------------------------------------------------------------------*/
: filterRight_req \operator

  _lu_initialise_

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: filterRight_Cleaning         ZK_M_CLEANING    op[].handler!
  find: filterRight_CrwBuffer        ZK_D_CRWBUFFER   op[].handler!
  find: filterRight_EndCrwRht        ZK_M_ENDCRWRHT   op[].handler!
  find: filterRight_EndRowRht        ZK_M_ENDROWRHT   op[].handler!
  find: filterRight_EosMarker        ZK_M_EOS         op[].handler!
  find: filterRight_RowBuffer        ZK_D_ROWBUFFER   op[].handler!
  find: filterRight_StartMarker      ZK_M_START       op[].handler!
  find: filterRight_StartCrwRht      ZK_M_STARTCRWRHT op[].handler!
  find: filterRight_StartRowRht      ZK_M_STARTROWRHT op[].handler!
  find: filterRight_StreamDefRht     ZK_D_STREAMDEFRHT op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: filterRight :: filterRight <compiled> <etc> ;

: filterRight_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
