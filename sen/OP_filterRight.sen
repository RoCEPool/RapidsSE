/*============================================================================*/
/* OP_filterRight.sen -- Operator filterRight columns                         */
/*============================================================================*/

" OP_filterRight.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: filterRight_seapi

  "filterRight_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: filterRight_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // cleanup the pot
  PotRlu[].cleanup

  Counter0[] cleanUpAsm

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction
  Pipein[].pipeOut
  true

;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: filterRight_CrwBuffer \handler

  0 ZK_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  // pipeout crwbuffer if not received startRightMarker
  Counter1[] 0 == if
     Pipein[].pipeout
    true
    exit
  then

  Operand[].pipeIn
  Operand[]\clear DevLftIxt.crwBuffer!
  ZK_D_CRWBUFFER Counter0[] executeAsmArgs

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_END_CRWRHT ...                                            INIT */
/*----------------------------------------------------------------------------*/
: filterRight_EndCrwRhtMarker \handler

  0 ZK_M_END_CRWRHT EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_M_EOS Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns

  // record receipt of end right marker
  0 to Counter1[]

  PipeIn[].delete

  // pipeout an EndRowRhtMarker
  Operand[].newEndRowRhtMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_END_ROWRHT ...                                            INIT */
/*----------------------------------------------------------------------------*/
: filterRight_EndRowRhtMarker \handler

  0 ZK_M_END_ROWRHT EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_M_EOS Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns

  // record receipt of end right marker
  0 to Counter1[]

  PipeIn[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: filterRight_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote

  // Arrival of EOSMARKER implies left is all done

  // delete the pot
  PotRlu[].delete

  // cleanup compiler
  Counter0[] cleanUpAsm

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: filterRight_RowBuffer \handler

  0 ZK_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  // pipeout rowBuffer if startRightMarker not received
  Counter1[] 0 == if
    Pipein[].pipeout
    true
    exit
  then

  Operand[].pipeIn
  Operand[]\clear DevLftRow.rowBuffer!
  ZK_D_ROWBUFFER Counter0[] executeAsmArgs

  Operand[].delete

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START_CRWRHT ...                                          INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartCrwRhtMarker \handler

  0 ZK_M_START_CRWRHT EG_ZK LogicUnit[].diaryNote

  PipeIn[].delete

  // pipeout a StartRowRhtMarker
  Operand[].newStartRowRhtMarker
  Operand[].pipeout

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START_ROWRHT ...                                          INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartRowRhtMarker \handler

  0 ZK_M_START_ROWRHT EG_ZK LogicUnit[].diaryNote

  PipeIn[].pipeout

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: filterRight_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  // filterRight gets the left streamDef, then right streamDef
  // it needs to store the right streamDef in left
  // and left in right (which it will ignore)
  StreamDefRht[].isNull if

      //"loopJoin_StreamDef got left streamDef" .
      // move pipein[] to StreamDefRht[]
      Pipein[]\clear to StreamDefRht[]

      true
      exit
  then

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // evaluate the expression
  ExprEval[].new
  StreamDefLft[].duplicate to StreamDefOut[]

  <etc> StreamDefLft[] nullptr ExprEval[].evaluate to eError

  // check for error
  eError EC_NONE == not if
    eError op__exprEvalExecErr
    true
    exit
  then

  // generate the asm for the filterRight
  ExprEval[] LogicUnit[].genfilter to eError
  ExprEval[].delete

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // set the streamDef in the DevLftRow
  StreamDefLft[]\clear DevLftRow.streamDef!

  // create rowPix in potRlu[] from streamDefOut[]
  false streamDefOut[] PotRlu[].rowPix!

  // pipeout the StreamDefRht and streamDefOut
  StreamDefRht[].pipeout
  StreamDefOut[].pipeout

  // create the compiler
  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then

  // execute the streamDef asm handler
  ZK_D_STREAMDEF Counter0[] executeAsmArgs

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filterRight request                                                  SPAWN */
/*----------------------------------------------------------------------------*/
: filterRight_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: filterRight_Cleaning         ZK_M_CLEANING    op[].handler!
  find: filterRight_CrwBuffer        ZK_D_CRWBUFFER        op[].handler!
  find: filterRight_EndCrwRhtMarker  ZK_M_END_CRWRHT   op[].handler!
  find: filterRight_EndRowRhtMarker  ZK_M_END_ROWRHT   op[].handler!
  find: filterRight_EosMarker        ZK_M_EOS        op[].handler!
  find: filterRight_RowBuffer        ZK_D_ROWBUFFER        op[].handler!
  find: filterRight_StartMarker      ZK_M_START      op[].handler!
  find: filterRight_StartCrwRhtMarker ZK_M_START_CRWRHT op[].handler!
  find: filterRight_StartRowRhtMarker ZK_M_START_ROWRHT op[].handler!
  find: filterRight_StreamDef        ZK_D_STREAMDEF        op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: filterRight :: filterRight <compiled> <etc> ;

: filterRight_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
