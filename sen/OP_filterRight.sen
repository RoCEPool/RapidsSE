/*============================================================================*/
/* OP_filterRight.sen -- Operator filterRight columns                         */
/*============================================================================*/

" OP_filterRight.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: filterRight_seapi

  "filterRight_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_CANCELMARKER ...                                                 END */
/*----------------------------------------------------------------------------*/
: filterRight_CancelMarker \handler

  0 ZK_CANCELMARKER EG_ZK LogicUnit[].diaryNote

  // cleanup the pot
  PotRlu[].cleanup

  Counter0[] cleanUpAsm

  ZK_CANCELMARKER EG_ZK PD_PIPE_OUT 0 ZK_CANCELMARKER EG_ZK LogicUnit[].diaryAction
  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_CLEANUPMARKER ...                                                END */
/*----------------------------------------------------------------------------*/
: filterRight_CleanupMarker \handler

  0 ZK_CLEANUPMARKER EG_ZK LogicUnit[].diaryNote

  // cleanup the pot
  PotRlu[].cleanup

  Counter0[] cleanUpAsm

  ZK_CLEANUPMARKER EG_ZK PD_PIPE_OUT 0 ZK_CLEANUPMARKER EG_ZK LogicUnit[].diaryAction
  Pipein[].pipeOut
  true

;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: filterRight_CrwBuffer \handler

  0 ZK_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  // pipeout crwbuffer if not received startRightMarker
  Counter1[] 0 == if
     Pipein[].pipeout
    true
    exit
  then

  Operand[].pipeIn
  Operand[]\clear DevLftIxt.crwBuffer!
  ZK_CRWBUFFER Counter0[] executeAsmArgs

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_END_CRWRHTMARKER ...                                            INIT */
/*----------------------------------------------------------------------------*/
: filterRight_EndCrwRhtMarker \handler

  0 ZK_END_CRWRHTMARKER EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_EOSMARKER Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns

  // record receipt of end right marker
  0 to Counter1[]

  PipeIn[].delete

  // pipeout an EndRowRhtMarker
  Operand[].newEndRowRhtMarker
  Operand[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_END_ROWRHTMARKER ...                                            INIT */
/*----------------------------------------------------------------------------*/
: filterRight_EndRowRhtMarker \handler

  0 ZK_END_ROWRHTMARKER EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_EOSMARKER Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns

  // record receipt of end right marker
  0 to Counter1[]

  PipeIn[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: filterRight_EosMarker \handler

  0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryNote

  // Arrival of EOSMARKER implies left is all done

  // delete the pot
  PotRlu[].delete

  // cleanup compiler
  Counter0[] cleanUpAsm

  ZK_EOSMARKER EG_ZK PD_PIPE_OUT 0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryAction
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: filterRight_ERRORMARKER \handler

  find: EATOPERAND_handler   ZK_CRWBUFFER   op[].handler!
  find: EATOPERAND_handler   ZK_ROWBUFFER   op[].handler!
  find: EATOPERAND_handler   ZK_EOSMARKER   op[].handler!

  PipeIn[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: filterRight_RowBuffer \handler

  0 ZK_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  // pipeout rowBuffer if startRightMarker not received
  Counter1[] 0 == if
    Pipein[].pipeout
    true
    exit
  then

  Operand[].pipeIn
  Operand[]\clear DevLftRow.rowBuffer!
  ZK_ROWBUFFER Counter0[] executeAsmArgs

  Operand[].delete

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartMarker \handler

  0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_START_CRWRHTMARKER ...                                          INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartCrwRhtMarker \handler

  0 ZK_START_CRWRHTMARKER EG_ZK LogicUnit[].diaryNote

  PipeIn[].delete

  // pipeout a StartRowRhtMarker
  Operand[].newStartRowRhtMarker
  Operand[].pipeout

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_START_ROWRHTMARKER ...                                          INIT */
/*----------------------------------------------------------------------------*/
: filterRight_StartRowRhtMarker \handler

  0 ZK_START_ROWRHTMARKER EG_ZK LogicUnit[].diaryNote

  PipeIn[].pipeout

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: filterRight_StreamDef \handler

  0 ZK_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  // filterRight gets the left streamDef, then right streamDef
  // it needs to store the right streamDef in left
  // and left in right (which it will ignore)
  StreamDefRht[].isNull if

      //"loopJoin_StreamDef got left streamDef" .
      // move pipein[] to StreamDefRht[]
      Pipein[]\clear to StreamDefRht[]

      true
      exit
  then

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // evaluate the expression
  ExprEval[].new
  StreamDefLft[].duplicate to StreamDefOut[]

  <etc> StreamDefLft[] nullptr ExprEval[].evaluate to eError

  // check for error
  eError EC_NONE == not if
    eError op__exprEvalExecErr
    true
    exit
  then

  // generate the asm for the filterRight
  ExprEval[] LogicUnit[].genfilter to eError
  ExprEval[].delete

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // set the streamDef in the DevLftRow
  StreamDefLft[]\clear DevLftRow.streamDef!

  // create rowPix in potRlu[] from streamDefOut[]
  false streamDefOut[] PotRlu[].rowPix!

  // pipeout the StreamDefRht and streamDefOut
  StreamDefRht[].pipeout
  StreamDefOut[].pipeout

  // create the compiler
  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then

  // execute the streamDef asm handler
  ZK_STREAMDEF Counter0[] executeAsmArgs

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filterRight request                                                  SPAWN */
/*----------------------------------------------------------------------------*/
: filterRight_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: filterRight_CancelMarker     ZK_CANCELMARKER     op[].handler!
  find: filterRight_CleanupMarker    ZK_CLEANUPMARKER    op[].handler!
  find: filterRight_CrwBuffer        ZK_CRWBUFFER        op[].handler!
  find: filterRight_EndCrwRhtMarker  ZK_END_CRWRHTMARKER   op[].handler!
  find: filterRight_EndRowRhtMarker  ZK_END_ROWRHTMARKER   op[].handler!
  find: filterRight_EosMarker        ZK_EOSMARKER        op[].handler!
  find: filterRight_ErrorMarker      ZK_ERRORMARKER      op[].handler!
  find: filterRight_RowBuffer        ZK_ROWBUFFER        op[].handler!
  find: filterRight_StartMarker      ZK_STARTMARKER      op[].handler!
  find: filterRight_StartCrwRhtMarker ZK_START_CRWRHTMARKER op[].handler!
  find: filterRight_StartRowRhtMarker ZK_START_ROWRHTMARKER op[].handler!
  find: filterRight_StreamDef        ZK_STREAMDEF        op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: filterRight :: filterRight <compiled> <etc> ;

: filterRight_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
