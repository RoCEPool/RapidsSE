/*============================================================================*/
/* OP_scan.sen -- Operator scan                                               */
/*============================================================================*/

" OP_range.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: scan2_CancelMarker \handler

  nullptr to Operand[]
  PipeIn[].pipeOut
  Op.ackPipelineJob
  false
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: scan2_StartMarker \handler

  0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
    PipeIn[].pipeOut
  else
    true
    exit
  then

  // new a stream def
  table[] StreamDef[].new

  ExprEval[].new
  StreamDef[].duplicate to StreamDefOut[]
  StreamDef[] nullptr ExprEval[].scan to eError

  // should be no error
  eError EC_NONE == assert

  StreamDefOut[] ExprEval[] LogicUnit[].genScan
  ExprEval[].delete

  StreamDef[].asSrcStreamDef
  false PotRlu[].useStreamDefOut

  StreamDef[].pipeout

  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: scan2_EosMarker \handler

  0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryNote

  // pipe out all PotRlu[]
  PotRlu[].pipeoutDanglingPtns
  PotRlu[].delete

  Pipein[].isNull if
    // create a new eos marker
    Operand[].newEosMarker
    Operand[] to Pipein[]
  then

  Counter0[] cleanUpAsm

  ZK_EOSMARKER EG_ZK PD_PIPE_OUT 0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryAction
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                              DATAPULSE */
/*----------------------------------------------------------------------------*/
: scan2_Datapulse \handler

  0 ZK_DATAPULSE EG_ZK LogicUnit[].diaryNote

  // pipe out the pulse marker
  PipeIn[].pipeOut

  ZK_DATAPULSE Counter0[] executeAsmArgs

  LogicUnit[].callAgain@ not if

    // force op loop to call EOAsm_EosMarker to end
    "scan2_EosMarker" word::find LogicUnit[].handler!
    true LogicUnit[].callAgain!

  then

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* scan request                                                         SPAWN */
/*----------------------------------------------------------------------------*/
: scan2_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: scan2_CancelMarker ZK_CANCELMARKER  op[].handler!
  find: scan2_CrwBuffer    ZK_CRWBUFFER     op[].handler!
  find: scan2_DataPulse    ZK_DATAPULSE     op[].handler!
  find: scan2_RowBuffer    ZK_ROWBUFFER     op[].handler!
  find: scan2_StartMarker  ZK_STARTMARKER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: scan2 :: scan2 <compiled> <tableNm> ;
cmdSyntax: scan2 :: scan2 <compiled> <tableNm> <rateSecs> ;

: scan2_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
