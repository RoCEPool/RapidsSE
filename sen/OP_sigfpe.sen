/*============================================================================*/
/* OP_sigfpe.sen -- cause FPE                                                 */
/*============================================================================*/

" OP_sigfpe.sen" .verbose


/*----------------------------------------------------------------------------*/
/* sigfpe action                                                                */
/*----------------------------------------------------------------------------*/
: sigfpe_action

  "Before injected FPE" .

  inject::sigfpe locals| pDumpBuffer |



  // convert the string to operand to pipe out
  pDumpBuffer str.toPromptOut [op].pipeout



  true
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sigfpe :: sigfpe  ;

: sigfpe_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 0

    <opEntry> = "sigfpe_op"
  }
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
