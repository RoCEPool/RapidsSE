/*============================================================================*/
/* dp_metricsDemon.sen -- Metrics Demon Procedure                             */
/*============================================================================*/

" dp_metricsDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* metrics update demon                                                       */
/*----------------------------------------------------------------------------*/
: metricsDemonPipeline

  "
    pipelineLocal metricsDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | metricsFlush
        | metricsUpdate
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
