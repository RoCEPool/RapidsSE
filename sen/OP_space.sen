/*============================================================================*/
/* OP_space.sen -- Operator space                                             */
/*============================================================================*/

" OP_space.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: space_action

  // find the __ table
  <streamDef> op__tableDef assert

  //[op].disableAllocate
  //[job].disableAllocate

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an rowBuffer operand
  TableDef[] RowBuffer[].new

  // add spaceInfo to the rowBuffer
  TableDef[] RowBuffer[].addSpaceInfo assert

  // pipeout the rowBuffer
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: space :: space ;

: space_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __space
    <params>    = 0
    <opEntry> = "space_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
