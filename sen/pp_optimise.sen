/*============================================================================*/
/* pp_optimise.sen -- define optimise                                         */
/*============================================================================*/

" pp_create.sen" .verbose

/*----------------------------------------------------------------------------*/
/* optimise test                                                              */
/*----------------------------------------------------------------------------*/

proc:

  procedure optimise_test
    parameters $etc
  begin

  stage stageA on origin :
      start
    | pulse once
    | optimise $etc
    | output
    | sink
    | first

  end ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
