/*============================================================================*/
/* dp_receiverWL.sen -- Receiver Demon for WL Adaptor                         */
/*============================================================================*/

" dp_receiverWL.sen" .verbose


/*----------------------------------------------------------------------------*/
/* pipeline/procedure text for receiver demon                                 */
/*----------------------------------------------------------------------------*/
procText:
  pipelineLocal receiverWL_procText
    tag "<pre_execute>" = "demon::install" endTag
  begin

    stage stageA on origin :
        start
      | recvWL
      | eatAll
      | stageA

  end
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/