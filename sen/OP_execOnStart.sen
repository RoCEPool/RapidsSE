/*============================================================================*/
/* OP_execOnStart.sen -- ExecPipeline Op (execute the pipeline)              */
/*============================================================================*/

" OP_execOnStart.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_X_CHILDEXIT ...                                             */
/*----------------------------------------------------------------------------*/
: execOnStart_ChildExit \handler

  //"EV_X_CHILDEXIT" .verbose

  true LogicUnit[].RcvdChildExit!

  nullptr [job].responseOp!

  Marker[].newStartMarker
  Marker[].pipeout

  //"execute_ChildExit" .
  Pipein[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: execOnStart_StartMarker \handler

  Pipein[].delete

  <pipeline> to Text[]

  "**************************" .
  Text[] .
  "**************************" .

  [Op] [job].responseOp!
  STD_NORMALFORK_TAG Text[] api::forkChild not if
     //"****Error Code %v" .printf
     nullptr [job].responseOp!
     op__execErr
     true
     exit
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LOWMEMORY operand                                         */
/*----------------------------------------------------------------------------*/
: execOnStart_lowMemory \handler

  //"EV_M_LOWMEMORY_handler" .verbose

  PipeIn[].pipeToOutput

  true
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: execOnStart_op \operator

  _lu_initialise_

  op__topology

  find: execOnStart_StartMarker   EV_M_START         [op].handler!

  find: execOnStart_LowMemory     EV_M_LOWMEMORY     [op].handler!
  find: execOnStart_ChildExit     EV_X_CHILDEXIT     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: execOnStart :: execOnStart <pipeline> ;

: execOnStart_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "execOnStart_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
