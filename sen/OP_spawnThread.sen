/*============================================================================*/
/* OP_spawnThread.sen -- Operator Spawn Thread                                */
/*============================================================================*/

" OP_spawnThread.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for spawn thread                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : spawnThread_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: spawnThread :: spawnThread ;

: spawnThread_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
