/*============================================================================*/
/* OP_bktSend.sen -- Operator bucket send                                     */
/*============================================================================*/

" OP_bktSend.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_BUCKETGET ...                                                      */
/*----------------------------------------------------------------------------*/
: bktSend_bktGet \handler

 //"bktSend_bktGet handler" .

  Pipein[]\clear to BucketGet[]  // pop the pBucket and put in the Bucket register

  // then call C++ getBucketCrw to build the rows and push the rows to the stack via parcel

  BucketGet[].getBucketCrw op.pipeout

  BucketGet[].delete
  nullptr to BucketGet[]

  true

  //task::breakpoint //set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for bucketsend request                     (on node where spawned) */
/*----------------------------------------------------------------------------*/
: bktSend_op \operator

  _lu_initialise_
  //"bktSend_req" .

  op__topology

  // Setup ZK_D_BUCKETGET handler
  find: bktSend_bktGet ZK_D_BUCKETGET op[].handler!
  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: bktSend :: bktSend ;

: bktSend_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "bktSend_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
