/*============================================================================*/
/* OP_limit.sen -- Operator limit rows                                        */
/*============================================================================*/

" OP_limit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: limit_seapi

  "limit_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: limit_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // will be null if table not found
  StreamDefLft[].isNull not if
    StreamDefLft[].delete
  then

  StreamDefOut[].isNull not if
    StreamDefOut[].delete
  then

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: limit_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // new a streamDefOut
  StreamDefLft[].duplicate to StreamDefOut[]

  // pipeout the streamDefOut
  StreamDefOut[].duplicate to Pipein[]
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* limit request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: limit_op \operator

  _lu_initialise_

  op__topology

  // handle combined operator
  find: limit_Cleaning    ZK_M_CLEANING      [op].handler!
  find: limit_StreamDef   ZK_D_STREAMDEF     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: limit :: limit <count> ;

: limit_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "limit_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
