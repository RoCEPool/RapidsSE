/*============================================================================*/
/* op__common.sen -- operator common words                                    */
/*============================================================================*/

" op__common.sen" .verbose

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__file ( fileNm mode -- )

  params| mode sFileNm |

  // open the file for reading
  file::new to File0[]
  sfileNm mode File0[].get file.open
  if
    true
  else
    File0[].get file.delete assert::stack_0 nullptr File0[].set EC_INVALID_FILE
    op.pipelineJob@ ERROR_JOB !!logError
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    false
  then
  ;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__tableDef_infoSet ( tableNm -- )

  params| sTableNm |

  // save current path
  path[].save

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec path[].set

  // table
  sTableNm check::validTableAssembly assert

  // move to table folder and find the table
  sTableNm path[].pushNamedTableFolder
  sTableNm find execute to infoSetTable[]

  // cross-check
  infoSetTable[] assert

  path[].popNamedTableFolder

  // restore path
  path[].restore

  true
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__tableDef_streamSet ( tableNm -- )

  params| sTableNm |

  // save current path
  path[].save

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec path[].set

  // table
  sTableNm check::validTableAssembly assert

  // move to table folder and find the table
  sTableNm path[].pushNamedTableFolder
  sTableNm find execute to streamSetTable[]

  // cross-check
  streamSetTable[] assert

  path[].popNamedTableFolder

  // restore path
  path[].restore
  true
  ;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm>                                         */
/*----------------------------------------------------------------------------*/
: op__table ( tableNm -- )

  params| sTableNm |

  // check in tables folder
  check::folderIsTables not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    false
    exit
  then

  // table
  sTableNm check::validTableAssembly not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    false
    exit
  then

  // move to table folder and find the table
  sTableNm path[].pushNamedTableFolder
  sTableNm find execute to Table[]
  path[].popNamedTableFolder

  // cross-check
  Table[] assert

  true
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <indexNm>                                         */
/*----------------------------------------------------------------------------*/
: op__index ( tableNmm indexNm )

  params| sIndexNm sTableNm |

  // check in tables folder
  check::folderIsTables not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    false
    exit
  then

  // move to table folder
  sTableNm path[].pushNamedTableFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // move to indexes folder
  path[].pushIndexesFolder

  sIndexNm check::nameIsaIndex not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    path[].popNamedTableFolder
    path[].popIndexesFolder
    false
    exit
  then

  sIndexNm find execute to index[]

  // cross-check
  index[] assert

  path[].popNamedTableFolder
  path[].popIndexesFolder

  //pathStr .
  true
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm>, then to <indexNm>                      */
/*----------------------------------------------------------------------------*/
: op__table_index ( tableNm indexNm )

  params| sIndexNm sTableNm |

  // check in tables folder
  check::folderIsTables not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    false
    exit
  then

  // table
  sTableNm check::validTableAssembly not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    false
    exit
  then

  // move to table folder and find the table
  sTableNm path[].pushNamedTableFolder
  sTableNm find execute to Table[]

  // cross-check
  Table[] assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // move to indexes folder
  path[].pushIndexesFolder

  sIndexNm check::nameIsaIndex not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    path[].popNamedTableFolder
    path[].popIndexesFolder
    false
    exit
  then

  sIndexNm find execute to index[]

  // cross-check
  index[] assert

  path[].popNamedTableFolder
  path[].popIndexesFolder

  //pathStr .
  true
;

/*----------------------------------------------------------------------------*/
/* init rlu diary                                                             */
/*----------------------------------------------------------------------------*/
: rluDiary_init

  "<note>"  job[] job.tagSet@ tagSet.hasName if
    <note> LogicUnit[].diaryJobNote
  then

  op.opName@ LogicUnit[].diaryTitle
  op.opName@ Op.partition@ >str str.cat LogicUnit[].diaryName

  <diaryDir> LogicUnit[].diaryDir
;

/*----------------------------------------------------------------------------*/
/* set operator topology, next stage and op                                   */
/*----------------------------------------------------------------------------*/
: op__topology

  op[].init

  // set topolgy in the op
  <topology> op.topology!

  // set nextStage in op
  <nextStage> op.nextStage!

  // set nextOp in op
  <nextOp> op.nextOp!

  "<diary>" job[] job.tagSet@ tagSet.hasName if
    rluDiary_init
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* wait till pipeline job has stabilised                                      */
/*----------------------------------------------------------------------------*/
: op__pipelineJobWait

  // get the pipeline job of the operator
  Op.pipelineJob@ locals| pPipelineJob |

  //pPipelineJob job.jobList@  "Job list %v" .printf

  // wait till the pipeline job is in a list
  begin
    pPipelineJob job.jobList@ JL_NONE ==
  while
    //pPipelineJob job.jobList@ "Job list %v" .printf
    task::yield
  repeat


  // ensure pipeline job is executing and task is waiting
  // for the non-demon jobs
  pPipelineJob job.jobList@ JL_PARTICIPATING == if

    // wait till the parent job is executing
    begin
      pPipelineJob job.phase@ JP_EXECUTING == not
    while
      //pPipelineJob job.phase@ "Job phase %v" .printf
      task::yield
    repeat

    // wait till the pipelinetask is in a WAIT state
    // possibilty of _execute not have arrived yet
    pPipelineJob job.task@ locals| pPipelineTask |
    begin
      pPipelineTask task.isWaiting
    not while
      //pPipelineTask task.isWaiting "task waiting %v" .printf
      task::yield
    repeat

  then
;

/*----------------------------------------------------------------------------*/
/* call handler for operand                                                   */
/*----------------------------------------------------------------------------*/
: op__handle params| pHandler iOperandKind |

  0 iOperandKind EG_ZK LogicUnit[].diaryNote
  pHandler execute
  1 iOperandKind EG_ZK LogicUnit[].diaryNote
;

/*----------------------------------------------------------------------------*/
/* return pipleine                                                            */
/*----------------------------------------------------------------------------*/
: op__returnPipeline


  // find the __returnPipeline table def
  C_TDEF_RETURNPIPELINE op__tableDef_infoSet assert

  infoSetTable[] infoSet[].new
    OI_RETURNPIPELINE infoSet[].opInfoset!

  0 <reqOf> <reqNo> 3 InfoSet[].addRowVargs

  InfoSet[]
  nullptr to InfoSet[]
;


/*----------------------------------------------------------------------------*/
/* default operator loop                                                      */
/*----------------------------------------------------------------------------*/
: op__loop

  0 0 locals| iOperandKind iOperandYield |
 
  op__pipelineJobWait

  begin

    // attempt to get an Out-of_Order Operand
    OperandOoO[].next if

      OperandOoO[] to PipeIn[]
      nullptr to OperandOoO[]

      debug::flag@ if "(Revised) Calling handler for OoO operand" . then
      PipeIn[].kind to iOperandKind

      iOperandKind op[].isOperandValid not if
        find: INVALID_OPERAND_handler op__handle
      else
        iOperandKind op[].IncOperandCount
        iOperandKind dup op[].handler@ op__handle
      then

      PipeIn[].isNull assert

    else
 
      // test for call again
      LogicUnit[].callAgain@ if

        debug::flag@ if "(Revised) Calling handler AGAIN operand" . then

        false LogicUnit[].callAgain!
        true LogicUnit[].calledAgain!

        //iOperandKind op[].isOperandValid not if
        //  find: INVALID_OPERAND_handler op__handle
        //else
          iOperandKind op[].IncOperandCount
          iOperandKind LogicUnit[].handler@ op__handle
        //then
      else
 
        iOperandYield 1 + to iOperandYield
        iOperandYield task::operandYield@ >= if
          task::yield
          0 to iOperandYield
        then

        // bide till next operand is available
        PipeIn[].bide

        // pop next operand from queue into PipeIn[]
        PipeIn[].next

        // execute the operator's handler for the operand
        debug::flag@ if "(Revised) Calling handler for NEXT operand" . then
        PipeIn[].kind to iOperandKind

        iOperandKind op[].isOperandValid not if
          iOperandKind
            find: INVALID_OPERAND_handler op__handle
        else
          iOperandKind op[].IncOperandCount

          iOperandKind dup op[].handler@
              dup LogicUnit[].handler!
            op__handle
        then

        // assert Operand is null
        PipeIn[].isNull assert

      then
  
    then

  while assert::stack_0 repeat
;

