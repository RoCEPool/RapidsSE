/*============================================================================*/
/* op__common.sen -- operator common words                                    */
/*============================================================================*/

" op__common.sen" .verbose

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerNew

  timer::new    to timer[]
  aggTimer::new to aggTimer[]
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerBegin

  timer[] timer.start
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: BM_TimerUpdate

  timer[] timer.update

  timer[] timer.ticks aggTimer[] aggTimer.add
;

/*----------------------------------------------------------------------------*/
/* set path                                                                   */
/*----------------------------------------------------------------------------*/
: _lu_set_path_

  // use the <path> from <ename-set>
  <path> str.toStrVec Path[].set
;

/*----------------------------------------------------------------------------*/
/* initialise the logic unit                                                  */
/*----------------------------------------------------------------------------*/
: _lu_initialise_

  Stats_new

  _lu_set_path_
;

/*----------------------------------------------------------------------------*/
/* initialise the logic unit                                                  */
/*----------------------------------------------------------------------------*/
: _lu_finalise_

  [ddlLock].testDrop

  // check this task has no job reference
  JobRef[].assertNone

  // check this task has no ddl lock
  [ddlLock].none
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__file ( fileNm mode -- )

  params| mode sFileNm |

  // open the file for reading
  file::new to File0[]
  sfileNm mode File0[].get file.open
  if
    true
  else

    //File0[].get file.delete assert::stack_0 nullptr File0[].set

    // create an exec error infoset
    sFileNm EC_INVALID_FILE attachmap::errorText@ str.format
    EC_INVALID_FILE
    op__execErrMsg

    false
  then
 ;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__tableDef_infoSet ( tableNm -- )

  params| sTableNm |

  // save current path
  Path[].save

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec Path[].set

  // table
  sTableNm check::validTableAssembly assert

  // move to table folder and find the table
  sTableNm Path[].pushNamedTableFolder
  sTableNm find execute to infoSetTable[]

  // cross-check
  infoSetTable[] assert

  Path[].popNamedTableFolder

  // restore path
  Path[].restore

  true
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm> of tabledef                             */
/*----------------------------------------------------------------------------*/
: op__tableDef_streamSet ( tableNm -- )

  params| sTableNm |

  // save current path
  Path[].save

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec Path[].set

  // table
  sTableNm check::validTableAssembly assert

  // move to table folder and find the table
  sTableNm Path[].pushNamedTableFolder
  sTableNm find execute to streamSetTable[]

  // cross-check
  streamSetTable[] assert

  Path[].popNamedTableFolder

  // restore path
  Path[].restore
  true
;

/*----------------------------------------------------------------------------*/
/* find table by given table name and set Table[]                             */
/*----------------------------------------------------------------------------*/
: op__table params| sTableNm |

  0 locals| errorCode |

  // check in tables folder
  check::folderIsTables not if
    to errorCode

    // create an exec error infoset
    errorCode op__execErr

    false
    exit
  then

  // table
  sTableNm check::validTableAssembly not if
    to errorCode

    // create an exec error infoset
    sTableNm errorCode attachmap::errorText@ str.format
    errorCode
    op__execErrMsg

    false
    exit
  then

  // move to table folder and find the table
  sTableNm Path[].pushNamedTableFolder
  sTableNm find execute to Table[]
  Path[].popNamedTableFolder

  // cross-check
  Table[] assert
  true
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <indexNm>                                         */
/*----------------------------------------------------------------------------*/
: op__index ( tableNmm indexNm )

  params| sIndexNm sTableNm |
  0 locals| errorCode |

  // check in tables folder
  check::folderIsTables not if
    to errorCode

    // create an exec error infoset
    errorCode op__execErr

    false
    exit
  then

  // move to table folder
  sTableNm Path[].pushNamedTableFolder

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // move to indexes folder
  Path[].pushIndexesFolder

  sIndexNm check::nameIsaIndex not if
    to errorCode

    // create an exec error infoset
    errorCode op__execErr

    Path[].popNamedTableFolder
    Path[].popIndexesFolder
    false
    exit
  then

  sIndexNm find execute to Index[]

  // cross-check
  Index[] assert

  Path[].popNamedTableFolder
  Path[].popIndexesFolder

  //pathStr .
  true
;

/*----------------------------------------------------------------------------*/
/* verify and set folder to <tableNm>, then to <indexNm>                      */
/*----------------------------------------------------------------------------*/
: op__table_index ( tableNm indexNm )

  params| sIndexNm sTableNm |
  0 locals| errorCode |

  // check in tables folder
  check::folderIsTables not if
    to errorCode

    // create an exec error infoset
    errorCode op__execErr

    false
    exit
  then

  // table
  sTableNm check::validTableAssembly not if
    to errorCode

    // create an exec error infoset
    sTableNm errorCode attachmap::errorText@ str.format
    errorCode
    op__execErrMsg

    false
    exit
  then

  // move to table folder and find the table
  sTableNm Path[].pushNamedTableFolder
  sTableNm find execute to Table[]

  // cross-check
  Table[] assert

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // move to indexes folder
  Path[].pushIndexesFolder

  sIndexNm check::nameIsaIndex not if
    to errorCode

    // create an exec error infoset
    errorCode op__execErr

    Path[].popNamedTableFolder
    Path[].popIndexesFolder
    false
    exit
  then

  sIndexNm find execute to Index[]

  // cross-check
  Index[] assert

  Path[].popNamedTableFolder
  Path[].popIndexesFolder

  //pathStr .
  true
;

/*----------------------------------------------------------------------------*/
/* init rlu diary                                                             */
/*----------------------------------------------------------------------------*/
: rluDiary_init

  "<note>"  Job[].tagSet@ tagSet.hasName if
    <note> LogicUnit[].diaryJobNote
  then

  Op[].opName@ LogicUnit[].diaryTitle
  Op[].opName@ Op[].partition@ >str str.cat LogicUnit[].diaryName

  <diaryDir> LogicUnit[].diaryDir
;

/*----------------------------------------------------------------------------*/
/* set operator topology, next stage and op                                   */
/*----------------------------------------------------------------------------*/
: op__topology

  "<diary>" Job[].tagSet@ tagSet.hasName if
    rluDiary_init
  then
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* wait till pipeline job has stabilised                                      */
/*----------------------------------------------------------------------------*/
: op__pipelineJobWait

  // get the pipeline job of the operator
  Op[].pipelineJob@ locals| pPipelineJob |
  
  pPipelineJob not if
    exit
  then

  //pPipelineJob job.jobList@  "Job list %v" .printf

  // wait till the pipeline job is in a list
  begin
    pPipelineJob job.jobList@ JL_NONE ==
  while
    //pPipelineJob job.jobList@ "Job list %v" .printf
    
    thread.dedicated@ if
      10 thread::sleepMsec
    else
      [task].yield
    then
    
  repeat


  // ensure pipeline job is executing and task is waiting
  // for the non-demon jobs
  pPipelineJob job.jobList@ JL_PARTICIPATING == if

    // wait till the parent job is executing
    begin
      pPipelineJob job.phase@ JP_EXECUTING == not
    while
      //pPipelineJob job.phase@ "Job phase %v" .printf
      
      thread.dedicated@ if
        10 thread::sleepMsec
      else
        [task].yield
      then
    
    repeat

    // wait till the pipelinetask is in a WAIT state
    // possibilty of execute not have arrived yet
    pPipelineJob job.task@ locals| pPipelineTask |
    begin
      pPipelineTask task.isWaiting?
    not while
      //pPipelineTask task.isWaiting? "task waiting %v" .printf
      
      thread.dedicated@ if
        10 thread::sleepMsec
      else
        [task].yield
      then
    
    repeat

  then
;

/*----------------------------------------------------------------------------*/
/* return pipleine                                                            */
/*----------------------------------------------------------------------------*/
: op__returnPipeline


  // find the __returnPipeline table def
  C_TDEF_RETURNPIPELINE op__tableDef_infoSet assert

  infoSetTable[] InfoSet[].new
    OI_RETURNPIPELINE InfoSet[].opInfoset!

  0 <reqOf> <reqNo> 3 InfoSet[].addRowVargs

  InfoSet[]
  nullptr to InfoSet[]
;

/*----------------------------------------------------------------------------*/
/* call event handler                                                         */
/*----------------------------------------------------------------------------*/
: op__callHandler

  // inc operands
  Stats_OperandsInc

  // start timer
  Stats_TimerBegin

  LogicUnit[].handler@ execute

  dup if
    // update timer
    Stats_TimerUpdate
  then
;

/*----------------------------------------------------------------------------*/
/* operator loop                                                              */
/*----------------------------------------------------------------------------*/
: op__loop

  0 locals| iOperandYield |
  1 locals| iContinue |

  op__pipelineJobWait
  
  //[task].grabLock //OoO

  begin  iContinue while
    
    assert::stack_0
    
    PipeIn[].isNull assert

    // - - - - - - - - - - - - - - - - -
    // test for out-of-order operand
    OperandOoO[].next if

      OperandOoO[]\clear to PipeIn[]

      // debug::flag@ if "(Revised) Calling handler for OoO operand" . then

      PipeIn[].kind op[].isOperandValid not if
        find: INVALID_OPERAND_handler op__callHandler to iContinue
        continue_if
      then

      PipeIn[].kind op[].incOperandCount
      PipeIn[].kind op[].incHandlerCount
      PipeIn[].kind op[].handler@ LogicUnit[].handler!
      op__callHandler to iContinue
      continue_if
      
    then
   
   
    // - - - - - - - - - - - - - - - - -
    // test for call again
    LogicUnit[].callAgain@ if

      // debug::flag@ if "(Revised) Calling handler AGAIN operand" . then

      false LogicUnit[].callAgain!
      true LogicUnit[].calledAgain!

      op__callHandler to iContinue
      continue_if

    then
    
    
    // - - - - - - - - - - - - - - - - -
    // possible yield

    iOperandYield 1 + to iOperandYield
    iOperandYield [task].operandYield@ >= if
      [task].yield_opLoop
      //[task].grabLock //OoO
      0 to iOperandYield
    then


    // - - - - - - - - - - - - - - - - -
    // normal operand

    // bide till next operand is available
    PipeIn[].bide

    // pop next operand from queue into PipeIn[]
    PipeIn[].bideNext

    PipeIn[].isBuffer if
      Stats[].BuffIninc
    then

    //debug::flag@ if "(Revised) Calling handler for NEXT operand" . then

    PipeIn[].kind op[].isOperandValid not if
      find: INVALID_OPERAND_handler op__callHandler to iContinue
      continue_if
    then
    
    PipeIn[].kind op[].incOperandCount
    PipeIn[].kind op[].incHandlerCount
    PipeIn[].kind op[].handler@ LogicUnit[].handler!
    op__callHandler to iContinue

  repeat
  
  iContinue not assert
;

/*----------------------------------------------------------------------------*/
/* operator recovery                                                          */
/*----------------------------------------------------------------------------*/
: op__failureRecovery

  AM::SHOW::bException if
    "op__failureRecovery" .
    [task].seeFrameStack
    [task].seeLockSets
    //[task].seeLogicUnit
    //[grid].seeNodes
  then
  
  [task].releaseLockSets

  //"<recover>" Job[].tagSet@ tagSet.hasName if
    [task].exception EC_INTERNAL_ERROR op__execErrMsg

    PipeIn[].isNull not if
      PipeIn[].delete
    then

    true
  //else
  //  process::quit
  //  HAZARD
  //then
;



/*----------------------------------------------------------------------------*/
/* operator retires                                                           */
/*----------------------------------------------------------------------------*/
: op__retires

  [task].grabLock TR_RETIRE_THIS_TASK [task].transition!
;

/*----------------------------------------------------------------------------*/
/* job to release any resources                                               */
/*----------------------------------------------------------------------------*/
: _op_release_resources_

;

/*----------------------------------------------------------------------------*/
/* compile source code in tinyC                                               */
/*----------------------------------------------------------------------------*/
: TinyC[].compileCode params| pStencil |

  TinyC[].new

  pStencil TinyC[].compile if
    1 TinyC[].symbols
    TinyC[].relocate assert
    "iFun0_" Op[].stageNm@ str.cat TinyC[].find to Fun0[]
    "iFun1_" Op[].stageNm@ str.cat TinyC[].find to Fun1[]
    "iFun2_" Op[].stageNm@ str.cat TinyC[].find to Fun2[]
    "iFun3_" Op[].stageNm@ str.cat TinyC[].find to Fun3[]
    true
  else
    false
  then

  TinyC[].delete
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tub[].pipeOutCompleted

  begin
    Tub[].completed dup to DataBuffer[]
  while
    DataBuffer[].pipeOut
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tub[].pipeOutRemainder

  begin
    Tub[].completed dup to DataBuffer[]
  while
    DataBuffer[].pipeOut
  repeat

  begin
    Tub[].dangling dup to DataBuffer[]
  while
    DataBuffer[].pipeOut
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tub[].pipeToJob params| pPipelineJob |

  begin
    Tub[].completed dup to DataBuffer[]
  while
    DataBuffer[] pPipelineJob job.pipeToOp0
  repeat

  begin
    Tub[].dangling dup to DataBuffer[]
  while
    DataBuffer[] pPipelineJob job.pipeToOp0
  repeat
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: Tub[].deleteAllBuffers

  begin
    Tub[].completed dup to DataBuffer[]
  while
    DataBuffer[].delete
  repeat

  begin
    Tub[].dangling dup to DataBuffer[]
  while
    DataBuffer[].delete
  repeat
;

