/*============================================================================*/
/* OP_emptyLoop.sen -- empty loop                                             */
/*============================================================================*/

" OP_emptyLoop.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_ROWBUFFER ...                                   ROWBUFFER */
/*----------------------------------------------------------------------------*/
: emptyLoop_RowBuffer \handler

  //"Operand:- ZK_D_ROWBUFFER" .verbose

  Pipein[]\clear to rowBuffer[]
  //rowBuffer[].iterate

  rowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for emptyLoop req                                            SPAWN */
/*----------------------------------------------------------------------------*/
 : emptyLoop_op \operator

  _lu_initialise_

  op__topology

  find: emptyLoop_RowBuffer  ZK_D_ROWBUFFER op[].handler!
 
  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: emptyLoop :: emptyLoop ;

: emptyLoop_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "emptyLoop_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
