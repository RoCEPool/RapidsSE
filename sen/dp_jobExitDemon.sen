/*============================================================================*/
/* dp_jobExitDemon.sen -- Job Exit Demon                                      */
/*============================================================================*/

" dp_jobExitDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* job exit demon pipeline command                                            */
/*----------------------------------------------------------------------------*/
: jobExitDemonPipeline

  "
    pipelineLocal exitDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          startDemon
        | jobExit
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
