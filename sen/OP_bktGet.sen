/*============================================================================*/
/* OP_bktGet.sen -- Operator Bucket get                                       */
/*============================================================================*/

" OP_bktGet.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: bktGet_DataPulse  \handler

  //"    bktGet_DataPulse" .

  // pipe out EV_M_START
  PipeIn[].pipeOut

  // create an instance of class BktGet : public Operand
  // set the table name and bucket number in BktGet instance

  //<TableNm> .
  //<bktNo> .

  <tableNm> <bktNo> BucketGet::new to BucketGet[]

  BucketGet[].pipeOut

  true
  //stk
  //[task].breakpoint set breakpoint back into C++ code, where the task loop is
;

/*----------------------------------------------------------------------------*/
/* execute for bktGet request                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: bktGet_op \operator

  _lu_initialise_
  //"bktGet_req" .
  op__topology

  find: bktGet_DataPulse   EV_M_DATAPULSE   [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                            - Definition -                                  */
/*----------------------------------------------------------------------------*/
cmdSyntax: bktGet :: bktGet <tableNm> ;
cmdSyntax: bktGet :: bktGet <tableNm> <bktNo> ;

: bktGet_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "bktGet_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
