/*============================================================================*/
/* op_locksReset.sen -- locks reset                                           */
/*============================================================================*/

" op_locksReset.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: locksReset_action
  
  locks::reset
  
  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: locksReset :: locksReset ;

: locksReset_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 0

    <opEntry> = "locksReset_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
