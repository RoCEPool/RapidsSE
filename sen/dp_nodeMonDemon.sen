/*============================================================================*/
/* dp_nodeMonDemon.sen -- Node Monitor Demon                                  */
/*============================================================================*/

" dp_nodeMonDemon.sen" .verbose


/*----------------------------------------------------------------------------*/
/* nodeMon demon                                                                */
/*----------------------------------------------------------------------------*/
: nodeMonDemonPipeline

  "
    pipelineLocal nodeMonDemon
      tag \"<pre_execute>\" = \"demon::install\" endTag
    begin

      stage stageA on origin :
          start
        | nodeMon
        | eatAll
        | stageA

    end ;
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
