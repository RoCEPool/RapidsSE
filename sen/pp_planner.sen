/*============================================================================*/
/* pp_planner.sen -- define planner procedures                                */
/*============================================================================*/

" pp_planner.sen" .verbose


/*----------------------------------------------------------------------------*/
/* Planner experiment related procedures                                      */
/*----------------------------------------------------------------------------*/

"  start::defProc_Planner" .verbose

: start::defProc_Planner

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //

  STD_PATH_TAG
  "
  procedure aggregRows_I
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | aggreg 2 $etc
      | combined 0
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //

  STD_PATH_TAG
  "
  procedure aggregRows
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | aggreg 2 $etc
      | combined 0
      | stageC

    stage stageC on origin :
     output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure filterRows_I
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | filter 2 $etc
      | combined 0
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure filterRows
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | filter 2 $etc
      | combined 0
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  STD_PATH_TAG
  "
  procedure limitRows
    parameters $table $rows
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | limit 2 $rows
      | combined 0
      | stageC

    stage stageC on origin :
      limit 2 $rows
      | combined 0
      | output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure projectColumns
    parameters $table $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      scan $table
      | project 2 $etc
      | combined 0
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //
  
  STD_PATH_TAG
  "
  procedure range
    parameters $table $index $etc
    begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all partitions :
      indexScan 2 $table $index $etc
      | combined 0
      | stageC

    stage stageC on origin :
      output | sink | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
