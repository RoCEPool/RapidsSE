/*============================================================================*/
/* OP_analyzeTable.sen -- Operator analyze table                              */
/*============================================================================*/

" OP_analyzeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: antbl_action

  0 locals| iLglPtn |

  <tableNm> op__table not if
    false
    exit
  then

  // find the <streamDef> table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an DATA Pds
  BT_DATA TableDef[] Pds[].new

  // add a row for each table ptn
  [grid].ptnsPerNode 0
  do
    // get the LglPtn
    I Table[].toLglPtn to iLglPtn

    // Get the TablePtn
    I Table[].tablePtnGet to TablePtn[]
    TablePtn[].grabRead_yieldLoop

    // analyze table
    iLglPtn TablePtn[] TableDef[] Pds[].addAnalyzeTable not if
      Pds[].pipeOut
      BT_DATA TableDef[] Pds[].new
      iLglPtn TablePtn[] TableDef[] Pds[].addAnalyzeTable assert
    then

    TablePtn[].dropRead

  loop

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: antbl :: antbl <tableNm> ;

: antbl_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __analyzeTable
    <params>    = 1
    <opEntry> = "antbl_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
