/*============================================================================*/
/* OP_analyzeTable.sen -- Operator analyze table                              */
/*============================================================================*/

" OP_analyzeTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: antbl_action

  <tableNm> op__table not if
    false
    exit
  then

  // find the <streamDef> table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an DATA rowBuffer
  BT_DATA TableDef[] RowBuffer[].new

  // add a row for each table ptn
  [grid].ptnsPerNode 0
  do
    // analyze table
    I Table[] TableDef[] RowBuffer[].addAnalyzeTable  not if
      RowBuffer[].pipeOut
      BT_DATA TableDef[] RowBuffer[].new
      I Table[] TableDef[] RowBuffer[].addAnalyzeTable assert
    then

  loop

  // pipeout the rowBuffer
  RowBuffer[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: antbl :: antbl <tableNm> ;

: antbl_cmdTags _cmdTags tagCopy: liteOp_tags
  tags{
    <cmdDesc>   = "--desc for op--"
    <streamDef> = __analyzeTable
    <params>    = 1
    <opEntry> = "antbl_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
