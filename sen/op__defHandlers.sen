/*============================================================================*/
/* op__defHandlers.sen -- Default Operand Handlers                            */
/*============================================================================*/

" op__defHandlers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* perform a simple pipein delete on behalf of an abnormal handler            */
/*----------------------------------------------------------------------------*/
: ABNORMAL_PIPEIN_DELETE

  PipeIn[].delete

  // calling op_loop continues
  true
;

/*----------------------------------------------------------------------------*/
/* perform a simple pipeout on behalf of a standard handler                   */
/*----------------------------------------------------------------------------*/
: STANDARD_PIPEOUT

  PipeIn[]\clear op::pipeout
  
  // calling op_loop continues
  true
;

/*----------------------------------------------------------------------------*/
/*                          STANDARD EVENT HANDLERS                           */
/*----------------------------------------------------------------------------*/

: ZK_D_BUCKETMAP_handler        \handler STANDARD_PIPEOUT ;
: ZK_D_CRWBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_D_CSVBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_D_EACHROWBUFFER_handler    \handler STANDARD_PIPEOUT ;
: ZK_D_ENTBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_D_INDEX_handler            \handler STANDARD_PIPEOUT ;
: ZK_D_INDEXDEF_handler         \handler STANDARD_PIPEOUT ;
: ZK_D_GRID_handler             \handler STANDARD_PIPEOUT ;
: ZK_D_NAMEDBUFFER_handler      \handler STANDARD_PIPEOUT ;
: ZK_D_METAGET_handler          \handler STANDARD_PIPEOUT ;
: ZK_D_OP_handler               \handler STANDARD_PIPEOUT ;
: ZK_D_OTHEROPERAND_handler     \handler STANDARD_PIPEOUT ;
: ZK_D_PARCEL_handler           \handler STANDARD_PIPEOUT ;
: ZK_D_PLANOPERAND_handler      \handler STANDARD_PIPEOUT ;
: ZK_D_PROFILE_handler          \handler STANDARD_PIPEOUT ;
: ZK_D_ROWBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_D_STREAMDEF_handler        \handler STANDARD_PIPEOUT ;
: ZK_M_STREAMDEFRHT_handler     \handler STANDARD_PIPEOUT ;
: ZK_D_STREAMSET_handler        \handler STANDARD_PIPEOUT ;
: ZK_D_TABLE_handler            \handler STANDARD_PIPEOUT ;


: ZK_I_CALLPIPELINE_handler     \handler STANDARD_PIPEOUT ;
: ZK_I_COMMANDERRORS_handler    \handler STANDARD_PIPEOUT ;
: ZK_I_COUNTINFO_handler        \handler STANDARD_PIPEOUT ;
: ZK_I_EXECERRORS_handler       \handler STANDARD_PIPEOUT ;
: ZK_I_LOADRESULT_handler       \handler STANDARD_PIPEOUT ;
: ZK_I_LOCKSTATS_handler        \handler STANDARD_PIPEOUT ;
: ZK_I_NODEINFO_handler         \handler STANDARD_PIPEOUT ;
: ZK_I_PATHINFO_handler         \handler STANDARD_PIPEOUT ;
: ZK_I_PROGRESSUNITS_handler    \handler STANDARD_PIPEOUT ;
: ZK_I_PROMPTOUT_handler        \handler STANDARD_PIPEOUT ;
: ZK_I_RETURNPIPELINE_handler   \handler STANDARD_PIPEOUT ;
: ZK_I_SEEKOFFSETS_handler      \handler STANDARD_PIPEOUT ;
: ZK_I_TOTALUNITS_handler       \handler STANDARD_PIPEOUT ;

: ZK_M_CANCEL_handler           \handler STANDARD_PIPEOUT ;
: ZK_M_CLEANUP_handler          \handler STANDARD_PIPEOUT ;
: ZK_M_CLEANEDUP_handler        \handler STANDARD_PIPEOUT ;

: ZK_M_DATAPULSE_handler        \handler STANDARD_PIPEOUT ;
: ZK_M_DESTROY_handler          \handler STANDARD_PIPEOUT ;
: ZK_M_EACHSCANEOS_handler      \handler STANDARD_PIPEOUT ;
: ZK_M_END_handler              \handler STANDARD_PIPEOUT ;
: ZK_M_ENDED_handler            \handler STANDARD_PIPEOUT ;
: ZK_M_ENDING_handler           \handler STANDARD_PIPEOUT ;
: ZK_M_END_CRWRHT_handler       \handler STANDARD_PIPEOUT ;
: ZK_M_END_ROWRHT_handler       \handler STANDARD_PIPEOUT ;
: ZK_M_EOS_handler              \handler STANDARD_PIPEOUT ;
: ZK_M_ERRORING_handler         \handler STANDARD_PIPEOUT ;
: ZK_M_LEAVE_handler            \handler STANDARD_PIPEOUT ;
: ZK_M_LEAVING_handler          \handler STANDARD_PIPEOUT ;
: ZK_M_LEFTOUTER_CRWLFT_handler \handler STANDARD_PIPEOUT ;
: ZK_M_LEFTOUTER_ROWLFT_handler \handler STANDARD_PIPEOUT ;
: ZK_M_NEXTBUFFER_handler       \handler STANDARD_PIPEOUT ;
: ZK_M_PULSED_handler           \handler STANDARD_PIPEOUT ;
: ZK_D_SRTBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_M_START_CRWRHT_handler    \handler STANDARD_PIPEOUT ;
: ZK_M_START_handler           \handler STANDARD_PIPEOUT ;
: ZK_M_START_ROWRHT_handler    \handler STANDARD_PIPEOUT ;
: ZK_M_TRIGGER_handler         \handler STANDARD_PIPEOUT ;

/*----------------------------------------------------------------------------*/
/*                       NON-STANDARD EVENT HANDLERS                          */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* default handler for ZK_M_ERROR operand                         (pipes out) */
/*----------------------------------------------------------------------------*/
: ZK_M_ERROR_handler \handler

  //"ZK_M_ERROR_handler" .verbose

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_M_EXIT operand                          (pipes out) */
/*----------------------------------------------------------------------------*/
: ZK_M_EXIT_handler \handler

  //"ZK_M_EXIT_handler" .verbose
  
  PipeIn[].pipeOut
  
  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* handler for eating operand                        (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EATOPERAND_handler \handler

  // delete operand
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_M_CANCELLED operand    (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: ZK_M_CANCELLED_handler \handler

  //"ZK_M_CANCELLED_handler" .verbose
  
  Pipein[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_M_ERRORED operand          (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: ZK_M_ERRORED_handler \handler

  //"ZK_M_ERRORED_handler" .verbose
  
  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_M_LEFT operand      (deletes pipein operand)        */
/*----------------------------------------------------------------------------*/
: ZK_M_LEFT_handler \handler

  //"ZK_M_LEFT_handler" .verbose

  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_M_EXITED operand           (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: ZK_M_EXITED_handler \handler

  //"ZK_M_EXITED_handler" .verbose
  
  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_M_STARTED operand      (deletes pipein operand)     */
/*----------------------------------------------------------------------------*/
: ZK_M_STARTED_handler \handler

  "ZK_M_STARTED_handler" .verbose

  // Only OP_Start can get a STARTEDMARKER
  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for unexpected operand operand    (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: INVALID_OPERAND_handler \handler

  PipeIn[].delete

  // operand incorrectly received
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/*                       ABNORMAL EVENT HANDLERS                              */
/*----------------------------------------------------------------------------*/
: default_abnormalHandlers

  find: ABNORMAL_PIPEIN_DELETE  locals| abnormalHandler |
  find: STANDARD_PIPEOUT        locals| defaultHandler |
    
  abnormalHandler ZK_D_BUCKETMAP     op[].handler!
  abnormalHandler ZK_D_CRWBUFFER     op[].handler!
  abnormalHandler ZK_D_CSVBUFFER     op[].handler!
  abnormalHandler ZK_D_EACHROWBUFFER op[].handler!
  abnormalHandler ZK_D_ENTBUFFER     op[].handler!
  abnormalHandler ZK_D_GRID          op[].handler!
  abnormalHandler ZK_D_INDEX         op[].handler!
  abnormalHandler ZK_D_INDEXDEF      op[].handler!
  abnormalHandler ZK_D_METAGET       op[].handler!
  abnormalHandler ZK_D_NAMEDBUFFER   op[].handler!
  abnormalHandler ZK_D_OP            op[].handler!
  abnormalHandler ZK_D_OTHEROPERAND  op[].handler!
  abnormalHandler ZK_D_PARCEL        op[].handler!
  abnormalHandler ZK_D_PLANOPERAND   op[].handler!
  abnormalHandler ZK_D_PROFILE       op[].handler!
  abnormalHandler ZK_D_ROWBUFFER     op[].handler!
  abnormalHandler ZK_D_SRTBUFFER     op[].handler!
  abnormalHandler ZK_D_STREAMDEF     op[].handler!
  abnormalHandler ZK_D_STREAMSET     op[].handler!
  abnormalHandler ZK_D_TABLE         op[].handler!
  

  defaultHandler ZK_M_DATAPULSE         op[].handler!
  defaultHandler ZK_M_DESTROY           op[].handler!
  defaultHandler ZK_M_EACHSCANEOS       op[].handler!
  defaultHandler ZK_M_END_CRWRHT        op[].handler!
  defaultHandler ZK_M_END_ROWRHT        op[].handler!
  defaultHandler ZK_M_EOS               op[].handler!
  defaultHandler ZK_M_LEFTOUTER_CRWLFT  op[].handler!
  defaultHandler ZK_M_LEFTOUTER_ROWLFT  op[].handler!
  defaultHandler ZK_M_NEXTBUFFER        op[].handler!
  defaultHandler ZK_M_PULSED            op[].handler!
  defaultHandler ZK_M_STARTED           op[].handler!
  defaultHandler ZK_M_START_CRWRHT      op[].handler!
  defaultHandler ZK_M_START             op[].handler!
  defaultHandler ZK_M_START_ROWRHT      op[].handler!
  defaultHandler ZK_M_STREAMDEFRHT      op[].handler!
  defaultHandler ZK_M_TRIGGER           op[].handler!

  //ZK_M_CANCEL
  //ZK_M_CLEANUP
  //ZK_M_CLEANEDUP
  //ZK_M_CANCELLED
  //ZK_M_END
  //ZK_M_ENDED
  //ZK_M_ENDING
  //ZK_M_ERROR
  //ZK_M_ERRORED
  //ZK_M_ERRORING
  //ZK_M_EXIT
  //ZK_M_EXITED
  //ZK_M_LEAVE
  //ZK_M_LEAVING
  //ZK_M_LEFT
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
