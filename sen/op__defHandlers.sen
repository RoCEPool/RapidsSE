/*============================================================================*/
/* op__defHandlers.sen -- Default Operand Handlers                            */
/*============================================================================*/

" op__defHandlers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for eating operand                                                 */
/*----------------------------------------------------------------------------*/
: EATOPERAND_handler \handler

  // delete operand
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_BUCKETMAP operand                                   */
/*----------------------------------------------------------------------------*/
: ZK_BUCKETMAP_handler \handler

  //"ZK_BUCKETMAP_handler" .verbose
  
  PipeIn[].pipeOut
  
  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_CALLPIPELINE operand                                */
/*----------------------------------------------------------------------------*/
: ZK_CALLPIPELINE_handler \handler

  //"ZK_CALLPIPELINE_handler" .verbose
  
  PipeIn[].pipeOut
  
  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_COMMANDERRORS operand                               */
/*----------------------------------------------------------------------------*/
: ZK_COMMANDERRORS_handler \handler

  //"ZK_COMMANDERRORS_handler" .verbose

  PipeIn[].pipeOut

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_CANCELMARKER operand                                */
/*----------------------------------------------------------------------------*/
: ZK_CANCELMARKER_handler \handler

  //"ZK_CANCELMARKER_handler" .verbose

  PipeIn[].pipeOut

  // drain the operand queue
  begin
    Pipein[].peek
  while
    PipeIn[].next
    Pipein[].delete
  repeat

  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_CANCELLEDMARKER operand                             */
/*----------------------------------------------------------------------------*/
: ZK_CANCELLEDMARKER_handler \handler

  //"ZK_CANCELLEDMARKER_handler" .verbose
  
  Pipein[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

