/*============================================================================*/
/* op__defHandlers.sen -- Default Operand Handlers                            */
/*============================================================================*/

" op__defHandlers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* perform a simple pipeout on behalf of a standard handler                   */
/*----------------------------------------------------------------------------*/
: STANDARD_PIPEOUT

  PipeIn[]\clear op::pipeout
  
  // calling op_loop continues
  true
;

/*----------------------------------------------------------------------------*/
/*                          STANDARD EVENT HANDLERS                           */
/*----------------------------------------------------------------------------*/

: ZK_BUCKETMAP_handler        \handler STANDARD_PIPEOUT ;
: ZK_CALLPIPELINE_handler     \handler STANDARD_PIPEOUT ;
: ZK_COMMANDERRORS_handler    \handler STANDARD_PIPEOUT ;
: ZK_COUNTINFO_handler        \handler STANDARD_PIPEOUT ;
: ZK_CRWBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_CSVBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_DATAPULSE_handler        \handler STANDARD_PIPEOUT ;
: ZK_DESTROYMARKER_handler    \handler STANDARD_PIPEOUT ;
: ZK_EACHROWBUFFER_handler    \handler STANDARD_PIPEOUT ;
: ZK_EACHSCANEOSMARKER_handler \handler STANDARD_PIPEOUT ;
: ZK_ENDCRW_RHTMARKER_handler  \handler STANDARD_PIPEOUT ;
: ZK_ENDROW_RHTMARKER_handler  \handler STANDARD_PIPEOUT ;
: ZK_ENTBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_EOSMARKER_handler        \handler STANDARD_PIPEOUT ;
: ZK_ERRORMARKER_handler      \handler STANDARD_PIPEOUT ;
: ZK_EXECERRORS_handler       \handler STANDARD_PIPEOUT ;
: ZK_EXITEARLYMARKER_handler  \handler STANDARD_PIPEOUT ;
: ZK_GRID_handler             \handler STANDARD_PIPEOUT ;
: ZK_INDEX_handler            \handler STANDARD_PIPEOUT ;
: ZK_INDEXDEF_handler         \handler STANDARD_PIPEOUT ;
: ZK_LOADRESULT_handler       \handler STANDARD_PIPEOUT ;
: ZK_LOCKSTATS_handler        \handler STANDARD_PIPEOUT ;
: ZK_NAMEDBUFFER_handler      \handler STANDARD_PIPEOUT ;
: ZK_NEXTBUFFERMARKER_handler \handler STANDARD_PIPEOUT ;
: ZK_METAGET_handler          \handler STANDARD_PIPEOUT ;
: ZK_NODEINFO_handler         \handler STANDARD_PIPEOUT ;
: ZK_OP_handler               \handler STANDARD_PIPEOUT ;
: ZK_OTHEROPERAND_handler     \handler STANDARD_PIPEOUT ;
: ZK_PARCEL_handler           \handler STANDARD_PIPEOUT ;
: ZK_PATHINFO_handler         \handler STANDARD_PIPEOUT ;
: ZK_PLANOPERAND_handler      \handler STANDARD_PIPEOUT ;
: ZK_PROFILE_handler          \handler STANDARD_PIPEOUT ;
: ZK_PROGRESSUNITS_handler    \handler STANDARD_PIPEOUT ;
: ZK_PROMPTOUT_handler        \handler STANDARD_PIPEOUT ;
: ZK_PULSEDMARKER_handler     \handler STANDARD_PIPEOUT ;
: ZK_RETURNPIPELINE_handler   \handler STANDARD_PIPEOUT ;
: ZK_ROWBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_SEEKOFFSETS_handler      \handler STANDARD_PIPEOUT ;
: ZK_SRTBUFFER_handler        \handler STANDARD_PIPEOUT ;
: ZK_STARTCRW_RHTMARKER_handler    \handler STANDARD_PIPEOUT ;
: ZK_STARTMARKER_handler      \handler STANDARD_PIPEOUT ;
: ZK_STARTROW_RHTMARKER_handler    \handler STANDARD_PIPEOUT ;
: ZK_STREAMDEF_handler        \handler STANDARD_PIPEOUT ;
: ZK_STREAMSET_handler        \handler STANDARD_PIPEOUT ;
: ZK_TABLE_handler            \handler STANDARD_PIPEOUT ;
: ZK_TOTALUNITS_handler       \handler STANDARD_PIPEOUT ;

/*----------------------------------------------------------------------------*/
/*                       NON-STANDARD EVENT HANDLERS                          */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* default handler for ZK_CANCELMARKER operand                    (pipes out) */
/*----------------------------------------------------------------------------*/
: ZK_CANCELMARKER_handler \handler

  //"ZK_CANCELMARKER_handler" .verbose

  PipeIn[].pipeOut

  PipeIn[].drain

  Op.ackPipelineJob
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_EXITMARKER operand                      (pipes out) */
/*----------------------------------------------------------------------------*/
: ZK_EXITMARKER_handler \handler

  //"ZK_EXITMARKER_handler" .verbose
  
  PipeIn[].pipeOut
  
  Op.ackPipelineJob
  
  false // calling op_loop exits
;


/*----------------------------------------------------------------------------*/
/* handler for eating operand                        (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EATOPERAND_handler \handler

  // delete operand
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_CANCELLEDMARKER operand    (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: ZK_CANCELLEDMARKER_handler \handler

  //"ZK_CANCELLEDMARKER_handler" .verbose
  
  Pipein[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_ERROREDMARKER operand      (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: ZK_ERROREDMARKER_handler \handler

  //"ZK_ERROREDMARKER_handler" .verbose
  
  PipeIn[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_EXITEDEARLYMARKER operand  (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: ZK_EXITEDEARLYMARKER_handler \handler

  //"ZK_EXITEARLYMARKER_handler" .verbose

  PipeIn[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_EXITEDMARKER operand       (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: ZK_EXITEDMARKER_handler \handler

  //"ZK_EXITEDMARKER_handler" .verbose
  
  PipeIn[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for ZK_STARTEDMARKER operand      (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: ZK_STARTEDMARKER_handler \handler

  "ZK_STARTEDMARKER_handler" .verbose

  // Only OP_Start can get a STARTEDMARKER
  PipeIn[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for unexpected operand operand    (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: INVALID_OPERAND_handler \handler

  PipeIn[].delete

  // operand incorrectly received
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
