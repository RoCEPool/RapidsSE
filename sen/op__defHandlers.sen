/*----------------------------------------------------------------------------*/
/* default handler for unexpected operand operand                             */
/*----------------------------------------------------------------------------*/
: INVALID_OPERAND_handler \handler

  PipeIn[].delete

  // operand incorrectly received
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

