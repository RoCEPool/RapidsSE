/*============================================================================*/
/* op__defHandlers.sen -- Default Operand Handlers                            */
/*============================================================================*/

" op__defHandlers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* perform a simple pipein delete on behalf of an abnormal handler            */
/*----------------------------------------------------------------------------*/
: ABNORMAL_PIPEIN_DELETE

  //PipeIn[].name [op].ptnId@ "ABNORMAL_PIPEIN_DELETE P%v %v" str.format .
  PipeIn[].delete

  // calling op_loop continues
  true
;

/*----------------------------------------------------------------------------*/
/* perform a simple pipein delete on behalf of an abnormal handler            */
/*----------------------------------------------------------------------------*/
: ABNORMAL_PIPEIN_DELETE_END

  PipeIn[].delete

  // calling op_loop discontinues
  false
;

/*----------------------------------------------------------------------------*/
/* perform a simple pipeout on behalf of a standard handler                   */
/*----------------------------------------------------------------------------*/
: STANDARD_PIPEOUT

  //PipeIn[].name "DEFAULT HANDLER %v" str.format .
  PipeIn[]\clear [op].pipeout
  
  // calling op_loop continues
  true
;

/*----------------------------------------------------------------------------*/
/*                          STANDARD EVENT HANDLERS                           */
/*----------------------------------------------------------------------------*/

: EV_D_CRWBUFFER_handler        \handler STANDARD_PIPEOUT ;
: EV_D_CSVBUFFER_handler        \handler STANDARD_PIPEOUT ;
: EV_D_ENTBUFFER_handler        \handler STANDARD_PIPEOUT ;
: EV_D_INDEX_handler            \handler STANDARD_PIPEOUT ;
: EV_D_INDEXDEF_handler         \handler STANDARD_PIPEOUT ;
: EV_D_GRID_handler             \handler STANDARD_PIPEOUT ;
: EV_D_JOB_handler              \handler STANDARD_PIPEOUT ;
: EV_D_JOBMETRICS_handler       \handler STANDARD_PIPEOUT ;
: EV_D_NAMEDBUFFER_handler      \handler STANDARD_PIPEOUT ;
: EV_D_METAGET_handler          \handler STANDARD_PIPEOUT ;
: EV_D_OP_handler               \handler STANDARD_PIPEOUT ;
: EV_D_OTHEROPERAND_handler     \handler STANDARD_PIPEOUT ;
: EV_D_PAGINGMETRICS_handler    \handler STANDARD_PIPEOUT ;
: EV_D_PARCEL_handler           \handler STANDARD_PIPEOUT ;
: EV_D_PAYLOAD_handler          \handler STANDARD_PIPEOUT ;
: EV_D_PLANOPERAND_handler      \handler STANDARD_PIPEOUT ;
: EV_D_PROFILE_handler          \handler STANDARD_PIPEOUT ;
: EV_D_ROWBUFFER_handler        \handler STANDARD_PIPEOUT ;
: EV_D_STREAMDEF_handler        \handler STANDARD_PIPEOUT ;
: EV_D_STREAMDEFRHT_handler     \handler STANDARD_PIPEOUT ;
: EV_M_STREAMDEFRHT_handler     \handler STANDARD_PIPEOUT ;
: EV_D_STREAMSET_handler        \handler STANDARD_PIPEOUT ;
: EV_D_TABLE_handler            \handler STANDARD_PIPEOUT ;
: EV_D_TABLEPTN_handler         \handler STANDARD_PIPEOUT ;


: EV_I_AFFECTEDROWS_handler     \handler STANDARD_PIPEOUT ;
: EV_I_CALLPIPELINE_handler     \handler STANDARD_PIPEOUT ;
: EV_I_COMMAND_handler          \handler STANDARD_PIPEOUT ;
: EV_I_COMPILEERRORS_handler    \handler STANDARD_PIPEOUT ;
: EV_I_COUNT_handler            \handler STANDARD_PIPEOUT ;
: EV_I_EXECERRORS_handler       \handler STANDARD_PIPEOUT ;
: EV_I_FORKCOMMAND_handler      \handler STANDARD_PIPEOUT ;
//: EV_I_LOADRESULT_handler       \handler STANDARD_PIPEOUT ;
: EV_I_LOCKSTATS_handler        \handler STANDARD_PIPEOUT ;
//: EV_I_NODEINFO_handler         \handler STANDARD_PIPEOUT ;
: EV_I_PAGEINREQUEST_handler    \handler STANDARD_PIPEOUT ;
: EV_I_PATH_handler             \handler STANDARD_PIPEOUT ;
//: EV_I_PROGRESSUNITS_handler    \handler STANDARD_PIPEOUT ;
: EV_I_PROMPTOUT_handler        \handler STANDARD_PIPEOUT ;
//: EV_I_SEEKOFFSETS_handler      \handler STANDARD_PIPEOUT ;
//: EV_I_TOTALUNITS_handler       \handler STANDARD_PIPEOUT ;
: EV_I_WARNINGS_handler         \handler STANDARD_PIPEOUT ;

: EV_M_CANCEL_handler           \handler STANDARD_PIPEOUT ;
: EV_M_CANCELLING_handler       \handler STANDARD_PIPEOUT ;

: EV_M_DATAPULSE_handler        \handler STANDARD_PIPEOUT ;
: EV_M_DESTROY_handler          \handler STANDARD_PIPEOUT ;
: EV_M_END_handler              \handler STANDARD_PIPEOUT ;
: EV_M_ENDING_handler           \handler STANDARD_PIPEOUT ;
: EV_M_EOS_handler              \handler STANDARD_PIPEOUT ;
: EV_M_ERRORING_handler         \handler STANDARD_PIPEOUT ;
: EV_M_FINISHED_handler         \handler STANDARD_PIPEOUT ;
: EV_M_FLUSH_handler            \handler STANDARD_PIPEOUT ;
: EV_M_LEAVE_handler            \handler STANDARD_PIPEOUT ;
: EV_M_LEAVING_handler          \handler STANDARD_PIPEOUT ;
//: EV_M_LOWMEMORY_handler        \handler STANDARD_PIPEOUT ;
: EV_M_NEXTBUFFER_handler       \handler STANDARD_PIPEOUT ;
: EV_D_SRTBUFFER_handler        \handler STANDARD_PIPEOUT ;
: EV_M_START_handler            \handler STANDARD_PIPEOUT ;
: EV_M_TRIGGER_handler          \handler STANDARD_PIPEOUT ;

: EV_X_CHILDEXIT_handler        \handler STANDARD_PIPEOUT ;
: EV_X_EXIT_handler             \handler STANDARD_PIPEOUT ;

/*----------------------------------------------------------------------------*/
/*                       NON-STANDARD EVENT HANDLERS                          */
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for eating operand                        (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EATOPERAND_handler \handler

  // delete operand
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for unexpected operand operand    (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: INVALID_OPERAND_handler \handler

  PipeIn[].delete

  // operand incorrectly received
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_CLEANING operand                      (pipes out) */
/*----------------------------------------------------------------------------*/
: EV_M_CLEANING_handler \handler

  //"EV_M_CLEANING_handler" .verbose

  LogicUnit[].cleanup

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_CANCELLED operand        (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EV_M_CANCELLED_handler \handler

  //"EV_M_CANCELLED_handler" .verbose
  
  Pipein[].delete

  // an error if any other operator receives it
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_CLEANED operand          (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EV_M_CLEANED_handler \handler

  //"EV_M_CLEANED_handler" .verbose

  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_ENDED operand            (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EV_M_ENDED_handler \handler

  //"EV_M_ENDED_handler" .verbose

  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_ERROR operand                         (pipes out) */
/*----------------------------------------------------------------------------*/
: EV_M_ERROR_handler \handler

  //"EV_M_ERROR_handler" .verbose

  // toggle to default abnormal handlers
  "default_abnormalHandlers" FIND execute

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_ERRORED operand          (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EV_M_ERRORED_handler \handler

  //"EV_M_ERRORED_handler" .verbose
  
  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_EXITED operand           (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EV_M_EXITED_handler \handler

  //"EV_M_EXITED_handler" .verbose
  
  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_EXITING operand                       (pipes out) */
/*----------------------------------------------------------------------------*/
: EV_M_EXITING_handler \handler

  //"EV_M_EXITING_handler" .verbose
  
  PipeIn[].pipeOut
  
  [job] assert
  [task] assert

  // ack the job task
  [op].ackJobTask
  
  false // calling op_loop exits
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_HARDABORT operand                                 */
/*----------------------------------------------------------------------------*/
: EV_M_HARDABORT_handler \handler

  "EV_M_HARDABORT_handler" .verbose
  //[op].opName@ "OP %v exiting got EV_M_HARDABORT" str.format .

  PipeIn[].delete

  LogicUnit[].cleanup

  false
;


/*----------------------------------------------------------------------------*/
/* default handler for EV_M_INTERNALERROR operand                 (pipes out) */
/*----------------------------------------------------------------------------*/
: EV_M_INTERNALERROR_handler \handler

  "EV_M_INTERNALERROR_handler" .verbose

  [op].opName@ "TOGGLING TO ABNORMAL HANDLERS FOR OP %v" str.format .
  "default_abnormalHandlers" FIND execute
  "default_internalErrorHandlers" FIND execute
  //[op].opName@ "TOGGLED TO ABNORMAL HANDLERS FOR OP %v" str.format .


  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_INVOKE operand                                    */
/*----------------------------------------------------------------------------*/
: EV_M_INVOKE_handler \handler

  //"EV_M_INVOKE_handler" .verbose

  PipeIn[].delete

  Marker[].newStartMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_LEFT operand      (deletes pipein operand)        */
/*----------------------------------------------------------------------------*/
: EV_M_LEFT_handler \handler

  //"EV_M_LEFT_handler" .verbose

  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_LOWMEMORY operand                     (pipes out) */
/*----------------------------------------------------------------------------*/
: EV_M_LOWMEMORY_handler \handler

  //"EV_M_LOWMEMORY_handler" .verbose

  //[op].opName@ "TOGGLING TO ABNORMAL HANDLERS FOR OP %v" str.format .
  "default_abnormalHandlers" FIND execute
  "default_lowMemHandlers" FIND execute
  //[op].opName@ "TOGGLED TO ABNORMAL HANDLERS FOR OP %v" str.format .


  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_NODELOSSABORT operand                             */
/*----------------------------------------------------------------------------*/
: EV_M_NODELOSSABORT_handler \handler

  "EV_M_NODELOSSABORT_handler" .verbose
  [op].opName@ [op].stageNm@ "OP %v:%v exiting got EV_M_NODELOSSABORT" str.format .

  PipeIn[].delete

  PipeIn[].drain

  LogicUnit[].cleanup

  // ack the job task
  [op].ackJobTask

  false
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_STARTED operand      (deletes pipein operand)     */
/*----------------------------------------------------------------------------*/
: EV_M_STARTED_handler \handler

  "EV_M_STARTED_handler" .verbose

  // Only OP_Start can get a STARTEDMARKER
  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/* default handler for EV_M_TRIGGERED operand        (deletes pipein operand) */
/*----------------------------------------------------------------------------*/
: EV_M_TRIGGERED_handler \handler

  //"EV_M_TRIGGERED_handler" .verbose

  PipeIn[].delete

  // an error if any other operator receives this operand
  EC_PIPELINE_PROTOCOL_ERROR op__execErr

  true // calling op_loop continues
;

/*----------------------------------------------------------------------------*/
/*                       ABNORMAL EVENT HANDLERS                              */
/*----------------------------------------------------------------------------*/
: default_abnormalHandlers

  find: ABNORMAL_PIPEIN_DELETE      locals| abnormalHandler |
  find: ABNORMAL_PIPEIN_DELETE_END  locals| abnormalHandlerEnd |
  find: STANDARD_PIPEOUT            locals| defaultHandler |

  // ABNORMAL handlers (pipein delete) for DATA Operators
  abnormalHandler EV_D_CRWBUFFER        [op].handler!
  abnormalHandler EV_D_CSVBUFFER        [op].handler!
  abnormalHandler EV_D_ENTBUFFER        [op].handler!
  abnormalHandler EV_D_GRID             [op].handler!
  abnormalHandler EV_D_INDEX            [op].handler!
  abnormalHandler EV_D_INDEXDEF         [op].handler!
  abnormalHandler EV_D_JOB              [op].handler!
  abnormalHandler EV_D_METAGET          [op].handler!
  abnormalHandler EV_D_NAMEDBUFFER      [op].handler!
  abnormalHandler EV_D_OP               [op].handler!
  abnormalHandler EV_D_OTHEROPERAND     [op].handler!
  abnormalHandler EV_D_PARCEL           [op].handler!
  abnormalHandler EV_D_PAYLOAD          [op].handler!
  abnormalHandler EV_D_PLANOPERAND      [op].handler!
  abnormalHandler EV_D_PROFILE          [op].handler!
  abnormalHandler EV_D_ROWBUFFER        [op].handler!
  abnormalHandler EV_D_SRTBUFFER        [op].handler!
  abnormalHandler EV_D_STREAMDEF        [op].handler!
  abnormalHandler EV_D_STREAMDEFRHT     [op].handler!
  abnormalHandler EV_M_STREAMDEFRHT     [op].handler!
  abnormalHandler EV_D_STREAMSET        [op].handler!
  abnormalHandler EV_D_TABLE            [op].handler!

  //abnormalHandler  EV_X_CHILDEXIT        [op].handler!
  abnormalHandler EV_X_EXIT             [op].handler!

  // DEFAULT handlers (pipein pipeout) for MARKERS
  defaultHandler EV_M_DATAPULSE         [op].handler!
  defaultHandler EV_M_DESTROY           [op].handler!
  defaultHandler EV_M_EOS               [op].handler!
  defaultHandler EV_M_FINISHED          [op].handler!
  defaultHandler EV_M_FLUSH             [op].handler!
  abnormalHandlerEnd    EV_M_HARDABORT  [op].handler!
  defaultHandler EV_M_INTERNALERROR     [op].handler!
  defaultHandler EV_M_LOWMEMORY         [op].handler!
  defaultHandler EV_M_NEXTBUFFER        [op].handler!
  defaultHandler EV_M_START             [op].handler!
  //defaultHandler EV_M_STREAMDEFRHT      [op].handler!
  //defaultHandler EV_M_TRIGGERED         [op].handler!

  //EV_M_CANCEL
  //EV_M_CANCELLING
  //EV_M_CLEANING
  //EV_M_CLEANED
  //EV_M_CANCELLED
  //EV_M_END
  //EV_M_ENDED
  //EV_M_ENDING
  //EV_M_ERROR
  //EV_M_ERRORED
  //EV_M_ERRORING
  //EV_M_EXITING
  //EV_M_EXITED
  //EV_M_LEAVE
  //EV_M_LEAVING
  //EV_M_LEFT
  //EV_M_STARTED
  //EV_M_TRIGGERED
;

/*----------------------------------------------------------------------------*/
/*                 INTERNALERROR EVENT HANDLERS                               */
/*----------------------------------------------------------------------------*/
: default_internalErrorHandlers

  [op].opName@ "SETTING default_internalErrorHandlers for OP %v" str.format .
  find: ABNORMAL_PIPEIN_DELETE  locals| abnormalHandler |

  abnormalHandler EV_I_AFFECTEDROWS     [op].handler!
  abnormalHandler EV_I_COMMAND          [op].handler!
  abnormalHandler EV_I_COMPILEERRORS    [op].handler!
  abnormalHandler EV_I_COUNT            [op].handler!
  abnormalHandler EV_I_EXECERRORS       [op].handler!
  abnormalHandler EV_I_FORKCOMMAND      [op].handler!
  //abnormalHandler EV_I_LOADRESULT       [op].handler!
  abnormalHandler EV_I_LOCKSTATS        [op].handler!
  //abnormalHandler EV_I_NODEINFO         [op].handler!
  abnormalHandler EV_I_PAGEINREQUEST    [op].handler!
  abnormalHandler EV_I_PATH             [op].handler!
  //abnormalHandler EV_I_PROGRESSUNITS    [op].handler!
  abnormalHandler EV_I_PROMPTOUT        [op].handler!
  //abnormalHandler EV_I_SEEKOFFSETS      [op].handler!
  //abnormalHandler EV_I_TOTALUNITS       [op].handler!

  //[op].opName@ "DONE SETTING default_internalErrorHandlers for OP %v" str.format .
;

/*----------------------------------------------------------------------------*/
/*                 LOWMEMORY EVENT HANDLERS                                   */
/*----------------------------------------------------------------------------*/
: default_lowMemHandlers

  //[op].opName@ "SETTING default_lowMemHandlers for OP %v" str.format .
  find: ABNORMAL_PIPEIN_DELETE  locals| abnormalHandler |

  abnormalHandler EV_I_AFFECTEDROWS     [op].handler!
  abnormalHandler EV_I_COMMAND          [op].handler!
  abnormalHandler EV_I_COMPILEERRORS    [op].handler!
  abnormalHandler EV_I_COUNT            [op].handler!
  abnormalHandler EV_I_EXECERRORS       [op].handler!
  abnormalHandler EV_I_FORKCOMMAND      [op].handler!
  //abnormalHandler EV_I_LOADRESULT       [op].handler!
  abnormalHandler EV_I_LOCKSTATS        [op].handler!
  //abnormalHandler EV_I_NODEINFO         [op].handler!
  abnormalHandler EV_I_PAGEINREQUEST    [op].handler!
  abnormalHandler EV_I_PATH             [op].handler!
  //abnormalHandler EV_I_PROGRESSUNITS    [op].handler!
  abnormalHandler EV_I_PROMPTOUT        [op].handler!
  //abnormalHandler EV_I_SEEKOFFSETS      [op].handler!
  //abnormalHandler EV_I_TOTALUNITS       [op].handler!
  abnormalHandler EV_I_WARNINGS         [op].handler!

  [op].opName@ "DONE SETTING default_lowMemHandlers for OP %v" str.format .
;

/*----------------------------------------------------------------------------*/
/*                       ABNORMAL EVENT HANDLERS                              */
/*----------------------------------------------------------------------------*/
: run_defaultHandler

  PipeIn[].kind locals| eKind |
  
  eKind 

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
