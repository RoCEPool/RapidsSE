/*============================================================================*/
/* job__Ended.sen -- generic job related words                                */
/*============================================================================*/

" job__Ended.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on participating node                           //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send Job__Ended back to originating node                                   */
/*----------------------------------------------------------------------------*/
: ended::replyToOrigin ( pJobParticipant -- )

  params| pJobParticipant |

  pJobParticipant job.id@ locals| iJobId |

  0 locals| pJob__Ended |

  //grid::thisNodeName@ "(%v) ENDED::send" .printf

  // new a temporary Job__Ended
  pJobParticipant job__Ended::new to pJob__Ended

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // send the ended job
  iJobId job::originator@ pJob__Ended job.reply

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  pJob__Ended job.delete2pc
;

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job__Ended on originating node       recv: job.spawn */
/*----------------------------------------------------------------------------*/
: _Ended_run [ word::seed# ]

  Job[] locals| pJob__Ended |
  pJob__Ended job.id@ locals| iJobId |

  0 locals| bAmDecider |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // get the context of this __ended job

  // find the originating job
  iJobId olist::findJob discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // process __ended job on this originating node

  // increment the number of __ended jobs received in api state
  JobRef[] ssn::incEnded
  JobRef[] ssn::traceSession

  // decrement the acks remaining
  JobRef[] job.dec2pcAcksRmg to bAmDecider

  //grid::thisNodeName@ "(%v) ENDED GOT ACK" .printf
  // if there are acks remaining just exit
  bAmDecider not if
    JobRef[].returnReference
    _job_2pc_delete_
    exit                                                         // *EARLY EXIT*
  then
  //grid::thisNodeName@ "(%v) ENDED AM DECIDER" .printf

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // all __ended jobs have been received, so this job is the decider

  begin
    JobRef[].references
  1 > while
  repeat

  // remove the originating job from the originator jobs
  //Job[].removeOriginator

  // notify the originating task
  JobRef[].task@ task.ack
  JobRef[].returnReference
  
  _job_2pc_delete_
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: _Ended :: _Ended ;

: _Ended_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <seedRun>  = "_ended_run"
    <path>     = "/"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
