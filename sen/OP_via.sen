/*============================================================================*/
/* OP_via.sen -- Operator Via                                                 */
/*============================================================================*/

" OP_via.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : via_op \operator

  _lu_initialise_

  op__topology


  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: via :: via ;

: via_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "via_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
