/*============================================================================*/
/* OP_via.sen -- Operator Via                                                 */
/*============================================================================*/

" OP_via.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : via_req \operator

  LogReqEntry SEED_REQ

  op__topology


  op__loop

  LogReqExit
  _op_retires_
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: via :: via ;

: via_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
