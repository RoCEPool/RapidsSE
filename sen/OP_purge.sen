/*============================================================================*/
/* OP_purge.sen -- Operator purge                                             */
/*============================================================================*/

" OP_purge.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: purge_DataMarker \handler

  //"Operand:- ZK_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // new a stream def
  Operand[].newStreamDef
  Operand[].pipeOut

  // purge
  TablePtn[].grabWrite_yieldLoop
  TablePtn[].purge
  TablePtn[].dropWrite
  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: purge_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* purge request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: purge_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: purge_DataMarker ZK_DATAPULSE op[].handler!
  find: purge_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: purge :: purge <tableNm> ;

: purge_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
