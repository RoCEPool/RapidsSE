/*============================================================================*/
/* OP_toDemon.sen -- To Demon Operator                                        */
/*============================================================================*/

" OP_toDemon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_DATAPULSE ...                                                        */
/*----------------------------------------------------------------------------*/
: OP_toDemon_DataMarker \handler

  "OP_toDemon_DataMarker" .

  ZK_DATAPULSE_handler

  Operand[].newDataPulse operand[] 
    "__anyDemon" find word.object@
    pipeline.pipeout
;

/*----------------------------------------------------------------------------*/
/* toDemon request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toDemonOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: OP_toDemon_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  "*** toDemonOp_req EXITS" .
  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toDemonOp :: toDemonOp ;

: toDemonOp _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
