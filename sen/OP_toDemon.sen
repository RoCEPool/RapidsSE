/*============================================================================*/
/* OP_toDemon.sen -- To Demon Operator                                        */
/*============================================================================*/

" OP_toDemon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: OP_toDemon_DataMarker \handler

  "OP_toDemon_DataMarker" .

  ZK_M_DATAPULSE_handler

  Marker[].newDataPulse Marker[]
    "__anyDemon" find word.object@
    pipeline.pipeout
;

/*----------------------------------------------------------------------------*/
/* toDemon request                                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: toDemonOp_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: OP_toDemon_DataMarker ZK_M_DATAPULSE op[].handler!

  op__loop

  "*** toDemonOp_req EXITS" .
  LogReqExit
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toDemonOp :: toDemonOp ;

: toDemonOp_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
