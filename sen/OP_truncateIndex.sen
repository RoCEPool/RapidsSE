/*============================================================================*/
/* OP_truncateIndex.sen -- Operator truncate index                            */
/*============================================================================*/

" OP_truncateIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: TruncateIndex_DataPulse \handler


  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // truncate the buffers of the tablePtn
  Index[] TablePtn[].truncateIndex

  Marker[].newDestroyMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: TruncateIndex_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  // check if we can scan the table
  <tableNm> <indexNm> op__table_index if
    Table[].tablePtn@ to TablePtn[]
    PipeIn[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for Truncate req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : TruncateIndex_op \operator

  _lu_initialise_

  op__topology

  find: TruncateIndex_DataPulse ZK_M_DATAPULSE op[].handler!
  find: TruncateIndex_StartMarker ZK_M_START op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: truncateIndex :: truncateIndex <tableNm> <indexNm> ;

: truncateIndex_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
