/*============================================================================*/
/* OP_nodeMon.sen -- Operator Node Monitor                                    */
/*============================================================================*/

" OP_nodeMon.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: nodeMon::activity

  NodeMonitor::InspectGrid
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: nodeMon_StartMarker \handler

  0 locals| bGridHealthy |

  "Node Monitor Demon Started" .boot

  begin

    NodeMonitor::InspectGrid to bGridHealthy
    bGridHealthy not if
      false
      exit
    else
      10000 [task].sleepMsec
    then

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/* execute for nodeMon req                              (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : nodeMon_op \operator

  _lu_initialise_

  op__topology

  find: nodeMon_StartMarker EV_M_START [op].handler!

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: nodeMon :: nodeMon ;

: nodeMon_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "nodeMon_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
