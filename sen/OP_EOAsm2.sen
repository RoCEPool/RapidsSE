/*============================================================================*/
/* OP_EOAsm2.sen -- sql                                                        */
/*============================================================================*/

" OP_EOAsm2.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: EOAsm2_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  Pipein[].pipeout

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  // generate asm from query text
  Counter0[] <queryText> genAsm not if

    EC_INVALID_COMMAND op__execErr
    true
    exit

  then

  // execute plan generated STARTMARKER_handler
  ZK_M_START Counter0[] executeAsmArgs

  // do we have a table ?
  logicUnit[].srcTable@ "null" str.equal not if

    // do we have an index ?
    logicUnit[].srcIndex@ "null" str.equal not if

      // find the src table and src index
      logicUnit[].srcTable@ logicUnit[].srcIndex@ op__table_index not if
        true
        exit
      then

      Index[].indexTree to indexTreeRlu[]
      indexTreeRlu[].asSrc

    else
      // find the src table
      logicUnit[].srcTable@ op__table not if
        true
        exit
      then

    then

    // set table streamDef as src streamDef
    Table[].asSrcStreamDef
    Table[].tablePtn@ to TablePtn[]

  then

  // do we have an alternate table ?
  logicUnit[].altTable@ "null" str.equal not if

    // do we have an alternative index ?
    logicUnit[].altIndex@ "null" str.equal not if

      // find the alt table and alt index
      logicUnit[].altTable@ logicUnit[].altIndex@ op__table_index not if
        true
        exit
      then

      Index[].indexTree to indexTreeRlu[]
      indexTreeRlu[].asAlt

    else

      // find the src table
      logicUnit[].srcTable@ op__table not if
        true
        exit
      then

    then

    // set table streamDef as alt streamDef
    Table[].asAltStreamDef
    //Table[].tablePtn@ to TablePtn[]

  then

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                  BEGIN */
/*----------------------------------------------------------------------------*/
: EOAsm2_DataPulse \handler

  PipeIn[].isNull not if
    ZK_M_DATAPULSE EG_ZK PD_PIPE_OUT 0 ZK_M_DATAPULSE EG_ZK LogicUnit[].diaryAction
    PipeIn[].pipeOut // ZK_M_DATAPULSE_handler
  then

  // execute plan DATAPULSE_HANDLER
  ZK_M_DATAPULSE Counter0[] executeAsmArgs

  LogicUnit[].callAgain@ not if

    // force op loop to call EOAsm_EosMarker to end
    "EOAsm2_EosMarker" word::find LogicUnit[].handler!
    true LogicUnit[].callAgain!
  then

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: EOAsm2_CrwBuffer \handler

  0 ZK_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  // read next buffer from ptn stream
  ptnStream[] ptnStream.read to CrwBuffer[]

  CrwBuffer[].isNotNull if
    // read a next crw buffer

    CrwBuffer[] DevLftIxt.crwBuffer!
    ZK_D_CRWBUFFER Counter0[] executeAsmArgs
    CrwBuffer[].delete

    // call this handler again to process next buffer
    true LogicUnit[].callAgain!

  else
    // no more crw buffers

    // close and delete partition stream
    ptnStream[] ptnStream.close
    ptnStream[] ptnStream.delete
    nullptr to ptnStream[]

    // drop partition lock
    TablePtn[].dropRead

    // force op loop to call EOAsm2_EosMarker to end
    "EOAsm2_EosMarker" word::find LogicUnit[].handler!
    true LogicUnit[].callAgain!

  then

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: EOAsm2_RowBuffer \handler

  0 ZK_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  //Pipein[] "GOT ROWBUFFER %v" .printf
  Pipein[]\clear to RowBuffer[]
  RowBuffer[] DevLftRow.rowBuffer!
  ZK_D_ROWBUFFER Counter0[] executeAsmArgs
  RowBuffer[].delete
  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: EOAsm2_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote

  // pipe out all PotRlu[]
  PotRlu[].pipeoutDanglingPtns
  PotRlu[].delete

  Pipein[].isNull if
    // create a new eos marker
    Marker[].newEosMarker
    Marker[] to Pipein[]
  then

  // handle EOSMARKER
  ZK_M_EOS Counter0[] executeAsmArgs
  Counter0[] cleanUpAsm

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: EOAsm2_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  // execute plan STREAMDEF_handler
  ZK_D_STREAMDEF Counter0[] executeAsmArgs
  StreamDefOut[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: EOAsm2_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: EOAsm2_CrwBuffer   ZK_D_CRWBUFFER   op[].handler!
  find: EOAsm2_EosMarker   ZK_M_EOS   op[].handler!
  find: EOAsm2_DataPulse   ZK_M_DATAPULSE   op[].handler!
  find: EOAsm2_RowBuffer   ZK_D_ROWBUFFER   op[].handler!
  find: EOAsm2_StartMarker ZK_M_START op[].handler!
  find: EOAsm2_StreamDef   ZK_D_STREAMDEF   op[].handler!

  op__loop

  LogReqExit
  _op_retires_
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: EOAsm2 :: EOAsm2 <queryText> <compiled> ;

: EOAsm2_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
