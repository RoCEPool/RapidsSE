/*============================================================================*/
/* OP_verifyIndexPtn.sen -- Operator verify partition of index                */
/*============================================================================*/

" OP_verifyIndexPtn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: VerifyIndexPtn_DataMarker \handler

  0 locals| errorCode |

  PipeIn[].pipeOut

  // check if we can verify the index
  <indexNm> <tableNm> check::validIndexAssembly not if
    to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // verify partition of index
  Index[].verifyPtn assert

  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: VerifyIndexPtn_StartMarker \handler

  //"Operand:- EV_M_START" .verbose

  // check if we can scan the table
  <tableNm> <indexNm> op__table_index if
    PipeIn[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for compactIndex req                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : VerifyIndexPtn_op \operator

  _lu_initialise_

  op__topology

  find: VerifyIndexPtn_DataMarker EV_M_DATAPULSE [op].handler!
  find: VerifyIndexPtn_StartMarker EV_M_START [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: verifyIndexPtn :: verifyIndexPtn <tableNm> <indexNm> ;

: verifyIndexPtn_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "verifyIndexPtn_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
