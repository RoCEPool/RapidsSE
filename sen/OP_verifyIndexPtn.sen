/*============================================================================*/
/* OP_verifyIndexPtn.sen -- Operator verify partition of index                */
/*============================================================================*/

" OP_verifyIndexPtn.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: VerifyIndexPtn_DataMarker \handler

  // check if we can verify the index
  <indexNm> <tableNm> check::validIndexAssembly not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  PipeIn[].pipeOut

  // verify partition of index
  index[].verifyPtn assert

  Operand[].newEosMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: VerifyIndexPtn_StartMarker \handler

  //"Operand:- ZK_STARTMARKER" .verbose

  // check if we can scan the table
  <tableNm> <indexNm> op__table_index if
    PipeIn[].pipeOut
  then

  true
;


/*----------------------------------------------------------------------------*/
/* execute for compactIndex req                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : VerifyIndexPtn_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: VerifyIndexPtn_DataMarker ZK_DATAPULSE op[].handler!
  find: VerifyIndexPtn_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: verifyIndexPtn :: verifyIndexPtn <tableNm> <indexNm> ;

: verifyIndexPtn _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
