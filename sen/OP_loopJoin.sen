/*============================================================================*/
/* OP_loopJoin.sen -- Operator loop join                                      */
/*============================================================================*/

" OP_loopJoin.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: loopJoin_seapi

  "loopJoin_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                  END */
/*----------------------------------------------------------------------------*/
: loopJoin_DataPulse \handler
  "ZK_M_DATAPULSE" .
   ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_END ...                                                        END */
/*----------------------------------------------------------------------------*/
: loopJoin_End \handler
  "ZK_M_END" .
  ZK_M_END_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_ENDING ...                                                     END */
/*----------------------------------------------------------------------------*/
: loopJoin_Ending \handler
  "ZK_M_ENDING" .
  ZK_M_ENDING_handler
;
/*----------------------------------------------------------------------------*/
/* on ZK_M_EXITING ...                                                    END */
/*----------------------------------------------------------------------------*/
: loopJoin_Exiting \handler
  "ZK_M_EXITING" .
  ZK_M_EXITING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: loopJoin_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  "ZK_M_CLEANING" .

  // cleanup the pot
  PotRlu[].cleanup

  Counter0[] cleanUpAsm

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: loopJoin_CrwBuffer \handler

  0 ZK_D_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  Counter1[] 0 == if
    "loopJoin_CrwBuffer left" .
    PipeIn[]\clear DevLftIxt.crwBuffer!
    true LogicUnit[].IsLftCrwBuffer!
  else
    "loopJoin_CrwBuffer rht" .
    Operand[].pipein
    Operand[] DevRhtIxt.crwBuffer!
    ZK_D_CRWBUFFER Counter0[] executeAsmArgs

    // delete the right crwbuffer
    Operand[].delete
    nullptr DevRhtIxt.crwBuffer!
  then

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_END_CRWRHT ...                                                INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_EndCrwRhtMarker \handler

  0 ZK_M_END_CRWRHT EG_ZK LogicUnit[].diaryNote

  "ZK_M_END_CRWRHT" .

  PipeIn[].delete

  // delete the left buffer
  LogicUnit[].IsLftCrwBuffer@ if

    // execute the leftOuter asm handler for crwLft
    ZK_M_LEFTOUTER_CRWLFT Counter0[] executeAsmArgs

    DevLftIxt.crwBuffer@ to Operand[]
    Operand[].delete
    nullptr DevLftIxt.crwBuffer!
  else

    // execute the leftOuter asm handler for rowLft
    ZK_M_LEFTOUTER_ROWLFT Counter0[] executeAsmArgs

    DevLftRow.rowBuffer@ to Operand[]
    Operand[].isNull not assert
    Operand[].delete
    nullptr DevLftRow.rowBuffer!
  then

  // record receipt of end right marker
  0 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_END_ROWRHT ...                                            INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_EndRowRhtMarker \handler

  0 ZK_M_END_ROWRHT EG_ZK LogicUnit[].diaryNote

  "ZK_M_END_ROWRHT" .

  PipeIn[].delete

  // delete the left buffer
  LogicUnit[].IsLftCrwBuffer@ if

    // execute the leftOuter asm handler for crwLft
    ZK_M_LEFTOUTER_CRWLFT Counter0[] executeAsmArgs

    DevLftIxt.crwBuffer@ to Operand[]
    Operand[].delete
    nullptr DevLftIxt.crwBuffer!
  else

    // execute the leftOuter asm handler for rowLft
    ZK_M_LEFTOUTER_ROWLFT Counter0[] executeAsmArgs

    DevLftRow.rowBuffer@ to Operand[]
    Operand[].isNull not assert
    Operand[].delete
    nullptr DevLftRow.rowBuffer!
  then

  // record receipt of end right marker
  0 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                    END */
/*----------------------------------------------------------------------------*/
: loopJoin_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote
  "ZK_M_EOS" .

  // execute the eosMarker asm handler
  ZK_M_EOS Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns
  PotRlu[].delete

  // cleanup compiler
  Counter0[] cleanUpAsm

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction
  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: loopJoin_RowBuffer \handler

  0 ZK_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  "ZK_D_ROWBUFFER" .

  Counter1[] 0 == if
    Operand[].pipeIn
    Operand[]\clear DevLftRow.rowBuffer!
    false LogicUnit[].IsLftCrwBuffer!
  else
    Operand[].pipeIn
    Operand[] DevRhtRow.rowBuffer!
    ZK_D_ROWBUFFER Counter0[] executeAsmArgs

    // delete the right rowbuffer
    Operand[].delete
    nullptr DevRhtRow.rowBuffer!
  then

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote
  "loopJoin_StartMarker" .

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START_CRWRHT ...                                          INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_StartCrwRhtMarker \handler

  0 ZK_M_START_CRWRHT EG_ZK LogicUnit[].diaryNote

  PipeIn[].delete

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START_ROWRHT ...                                          INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_StartRowRhtMarker \handler

  0 ZK_M_START_ROWRHT EG_ZK LogicUnit[].diaryNote

  "ZK_M_START_ROWRHT" .

  PipeIn[].delete

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: loopJoin_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  StreamDefLft[].isNull if
    "loopJoin_StreamDef left" .
    //"loopJoin_StreamDef got left streamDef" .
    // move pipein[] to StreamDefLft[]
    Pipein[]\clear to StreamDefLft[]

    true
    exit
  then

  "loopJoin_StreamDef rht" .

  // We have received the ZK_M_START_CRWRHT
  // Hence this the right table stream def
  //"loopJoin_StreamDef got right streamDef" .

  // move pipein[] to StreamDefRht[]
  Pipein[]\clear to StreamDefRht[]

  // evaluate the expression
  ExprEval[].new
  StreamDefOut[].new

  <etc> StreamDefLft[] StreamDefRht[] StreamDefOut[] ExprEval[].evaluateLoopJoin to eError

  // check for error
  eError EC_NONE == not if
    eError op__exprEvalExecErr
    true
    exit
  then

  // generate the asm for the loop join
  ExprEval[] LogicUnit[].genLoopJoin to eError
  ExprEval[].delete

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // set the streamDef in the DevLftRow
  StreamDefLft[]\clear DevLftRow.streamDef!

  // set the streamDef in the devRightRow
  StreamDefRht[]\clear DevRhtRow.streamDef!

  // create rowPix in potRlu[] from streamDefOut[]
  false streamDefOut[] PotRlu[].rowPix!

  // pipeout the streamDefOut
  StreamDefOut[].pipeout

  // create the compiler
  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then

  // execute the streamDef asm handler
  ZK_D_STREAMDEF Counter0[] executeAsmArgs

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* loopJoin request                                                     SPAWN */
/*----------------------------------------------------------------------------*/
: loopJoin_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: loopJoin_Cleaning         ZK_M_CLEANING      op[].handler!
  find: loopJoin_CrwBuffer        ZK_D_CRWBUFFER     op[].handler!
  find: loopJoin_EndCrwRhtMarker  ZK_M_END_CRWRHT    op[].handler!
  find: loopJoin_EndRowRhtMarker  ZK_M_END_ROWRHT    op[].handler!
  find: loopJoin_EosMarker        ZK_M_EOS           op[].handler!
  find: loopJoin_RowBuffer        ZK_D_ROWBUFFER     op[].handler!
  find: loopJoin_StartMarker      ZK_M_START         op[].handler!
  find: loopJoin_StartCrwRhtMarker ZK_M_START_CRWRHT op[].handler!
  find: loopJoin_StartRowRhtMarker ZK_M_START_ROWRHT op[].handler!
  find: loopJoin_StreamDef         ZK_D_STREAMDEF    op[].handler!

find: loopJoin_DataPulse         ZK_M_DATAPULSE      op[].handler!
find: loopJoin_End               ZK_M_END            op[].handler!
find: loopJoin_Ending            ZK_M_ENDING         op[].handler!
find: loopJoin_Exiting           ZK_M_EXITING        op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: loopJoin :: loopJoin <compiled> <etc> ;

: loopJoin_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
