/*============================================================================*/
/* OP_loopJoin.sen -- Operator loop join                                      */
/*============================================================================*/

" OP_loopJoin.sen" .verbose

/*----------------------------------------------------------------------------*/
/* support for seapi immediate                                                */
/*----------------------------------------------------------------------------*/
: loopJoin_seapi

  "loopJoin_seapi" .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_CLEANUPMARKER ...                                                END */
/*----------------------------------------------------------------------------*/
: loopJoin_CleanupMarker \handler

  0 ZK_CLEANUPMARKER EG_ZK LogicUnit[].diaryNote

  // cleanup the pot
  PotRlu[].cleanup

  Counter0[] cleanUpAsm

  ZK_CLEANUPMARKER EG_ZK PD_PIPE_OUT 0 ZK_CLEANUPMARKER EG_ZK LogicUnit[].diaryAction

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_CRWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: loopJoin_CrwBuffer \handler

  0 ZK_CRWBUFFER EG_ZK LogicUnit[].diaryNote

  Counter1[] 0 == if
    PipeIn[]\clear DevLftIxt.crwBuffer!
    true LogicUnit[].IsLftCrwBuffer!
  else
    Operand[].pipein
    Operand[] DevRhtIxt.crwBuffer!
    ZK_CRWBUFFER Counter0[] executeAsmArgs

    // delete the right crwbuffer
    Operand[].delete
    nullptr DevRhtIxt.crwBuffer!
  then

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_END_CRWRHTMARKER ...                                            INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_EndCrwRhtMarker \handler

  0 ZK_END_CRWRHTMARKER EG_ZK LogicUnit[].diaryNote

  PipeIn[].delete

  // delete the left buffer
  LogicUnit[].IsLftCrwBuffer@ if

    // execute the leftOuter asm handler for crwLft
    ZK_LEFTOUTER_CRWLFT Counter0[] executeAsmArgs

    DevLftIxt.crwBuffer@ to Operand[]
    Operand[].delete
    nullptr DevLftIxt.crwBuffer!
  else

    // execute the leftOuter asm handler for rowLft
    ZK_LEFTOUTER_ROWLFT Counter0[] executeAsmArgs

    DevLftRow.rowBuffer@ to Operand[]
    Operand[].isNull not assert
    Operand[].delete
    nullptr DevLftRow.rowBuffer!
  then

  // record receipt of end right marker
  0 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_END_ROWRHTMARKER ...                                            INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_EndRowRhtMarker \handler

  0 ZK_END_ROWRHTMARKER EG_ZK LogicUnit[].diaryNote

  PipeIn[].delete

  // delete the left buffer
  LogicUnit[].IsLftCrwBuffer@ if

    // execute the leftOuter asm handler for crwLft
    ZK_LEFTOUTER_CRWLFT Counter0[] executeAsmArgs

    DevLftIxt.crwBuffer@ to Operand[]
    Operand[].delete
    nullptr DevLftIxt.crwBuffer!
  else

    // execute the leftOuter asm handler for rowLft
    ZK_LEFTOUTER_ROWLFT Counter0[] executeAsmArgs

    DevLftRow.rowBuffer@ to Operand[]
    Operand[].isNull not assert
    Operand[].delete
    nullptr DevLftRow.rowBuffer!
  then

  // record receipt of end right marker
  0 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_EOSMARKER ...                                                    END */
/*----------------------------------------------------------------------------*/
: loopJoin_EosMarker \handler

  0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryNote

  // execute the eosMarker asm handler
  ZK_EOSMARKER Counter0[] executeAsmArgs

  // pipeout all PotRlu[]
  PotRlu[].pipeoutDanglingPtns
  PotRlu[].delete

  // cleanup compiler
  Counter0[] cleanUpAsm

  ZK_EOSMARKER EG_ZK PD_PIPE_OUT 0 ZK_EOSMARKER EG_ZK LogicUnit[].diaryAction
  ZK_EOSMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERRORMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: loopJoin_ERRORMARKER \handler

  find: EATOPERAND_handler   ZK_CRWBUFFER   op[].handler!
  find: EATOPERAND_handler   ZK_ROWBUFFER   op[].handler!
  find: EATOPERAND_handler   ZK_EOSMARKER   op[].handler!

  PipeIn[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_ROWBUFFER ...                                                   EACH */
/*----------------------------------------------------------------------------*/
: loopJoin_RowBuffer \handler

  0 ZK_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  Counter1[] 0 == if
    Operand[].pipeIn
    Operand[]\clear DevLftRow.rowBuffer!
    false LogicUnit[].IsLftCrwBuffer!
  else
    Operand[].pipeIn
    Operand[] DevRhtRow.rowBuffer!
    ZK_ROWBUFFER Counter0[] executeAsmArgs

    // delete the right rowbuffer
    Operand[].delete
    nullptr DevRhtRow.rowBuffer!
  then

  PotRlu[].pipeoutCompletedPtns

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STARTMARKER ...                                                 INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_StartMarker \handler

  0 ZK_STARTMARKER EG_ZK LogicUnit[].diaryNote

  // new the PotRlu[]
  PotRlu[].new

  // init the logicUnit[]
  LogicUnit[].init

  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_START_CRWRHTMARKER ...                                          INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_StartCrwRhtMarker \handler

  0 ZK_START_CRWRHTMARKER EG_ZK LogicUnit[].diaryNote

  PipeIn[].delete

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_START_ROWRHTMARKER ...                                          INIT */
/*----------------------------------------------------------------------------*/
: loopJoin_StartRowRhtMarker \handler

  0 ZK_START_ROWRHTMARKER EG_ZK LogicUnit[].diaryNote

  PipeIn[].delete

  // record receipt of start right marker
  1 to Counter1[]

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_STREAMDEF ...                                              STREAMDEF */
/*----------------------------------------------------------------------------*/
: loopJoin_StreamDef \handler

  0 ZK_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  StreamDefLft[].isNull if

    "loopJoin_StreamDef got left streamDef" .
    // move pipein[] to StreamDefLft[]
    Pipein[]\clear to StreamDefLft[]

    true
    exit
  then

  // We have received the ZK_START_CRWRHTMARKER
  // Hence this the right table stream def
  "loopJoin_StreamDef got right streamDef" .

  // move pipein[] to StreamDefRht[]
  Pipein[]\clear to StreamDefRht[]

  // evaluate the expression
  ExprEval[].new
  StreamDefOut[].new

  <etc> StreamDefLft[] StreamDefRht[] StreamDefOut[] ExprEval[].evaluateLoopJoin to eError

  // check for error
  eError EC_NONE == not if
    eError op__exprEvalExecErr
    true
    exit
  then

  // generate the asm for the loop join
  ExprEval[] LogicUnit[].genLoopJoin to eError
  ExprEval[].delete

  // check for error
  eError EC_NONE == not if
    eError op__asmGenExecErr
    true
    exit
  then

  // set the streamDef in the DevLftRow
  StreamDefLft[]\clear DevLftRow.streamDef!

  // set the streamDef in the devRightRow
  StreamDefRht[]\clear DevRhtRow.streamDef!

  // create rowPix in potRlu[] from streamDefOut[]
  false streamDefOut[] PotRlu[].rowPix!

  // pipeout the streamDefOut
  StreamDefOut[].pipeout

  // create the compiler
  Counter0[] if
    LogicCompiler[].new
    LogicCompiler[].compile
  then

  // execute the streamDef asm handler
  ZK_STREAMDEF Counter0[] executeAsmArgs

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* loopJoin request                                                     SPAWN */
/*----------------------------------------------------------------------------*/
: loopJoin_req \operator

  LogReqEntry SEED_REQ

  // get whether compiled or not
  <compiled> >int to Counter0[]

  op__topology

  find: loopJoin_CleanupMarker    ZK_CLEANUPMARKER     op[].handler!
  find: loopJoin_CrwBuffer        ZK_CRWBUFFER         op[].handler!
  find: loopJoin_EndCrwRhtMarker  ZK_END_CRWRHTMARKER  op[].handler!
  find: loopJoin_EndRowRhtMarker  ZK_END_ROWRHTMARKER  op[].handler!
  find: loopJoin_EosMarker        ZK_EOSMARKER         op[].handler!
  find: loopJoin_ErrorMarker      ZK_ERRORMARKER       op[].handler!
  find: loopJoin_RowBuffer        ZK_ROWBUFFER         op[].handler!
  find: loopJoin_StartMarker      ZK_STARTMARKER       op[].handler!
  find: loopJoin_StartCrwRhtMarker ZK_START_CRWRHTMARKER op[].handler!
  find: loopJoin_StartRowRhtMarker ZK_START_ROWRHTMARKER op[].handler!
  find: loopJoin_StreamDef        ZK_STREAMDEF         op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: loopJoin :: loopJoin <compiled> <etc> ;

: loopJoin_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
