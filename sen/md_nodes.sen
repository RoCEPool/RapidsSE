/*============================================================================*/
/* md_nodes.sen -- Define md__nodes table                                   */
/*============================================================================*/

" md_nodes.sen" .verbose

: start::md_nodes

  // C_TDEF_NODES

  STD_BOOTFORK_TAG
  "
  define table nodes (
    iNodeId             INTEGER NOT NULL ,
    szAddress           VARCHAR NOT NULL ,
    iPort               INTEGER NOT NULL ,
    tsConnectTimeStamp  TIMESTAMP  NOT NULL
  ) < metaData > = MetaDataTable[].nodes ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
