/*============================================================================*/
/* OP_partitionPlan.sen -- Partition the Plan Op (SQL Compiler)               */
/*============================================================================*/

" OP_partitionPlan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: partitionPlan_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: partitionPlan_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCompileErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::partitionPlan to PlanOperand[]

  "partitionPlan" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: partitionPlan_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker        EV_M_LEAVE         [op].handler!
  find: compiler_StreamSet          EV_D_STREAMSET     [op].handler!

  // specific handlers
  find: partitionPlan_Cleaning      EV_M_CLEANING      [op].handler!
  find: partitionPlan_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: partitionPlan :: partitionPlan ;

: partitionPlan_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "partitionPlan_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
