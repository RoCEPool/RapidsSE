/*============================================================================*/
/* OP_partitionPlan.sen -- Partition the Plan Op (SQL Compiler)               */
/*============================================================================*/

" OP_partitionPlan.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANUP ...                                           */
/*----------------------------------------------------------------------------*/
: partitionPlan_CleanupMarker \handler

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: partitionPlan_PlanOperand \handler

  PipeIn[]\clear to Operand[]

  // create the command error info set
  op__cmdErrInfoSet

  Operand[] nullptr to Operand[] sqlCompiler::partitionPlan to Operand[]

   "partitionPlan" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: partitionPlan_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker        ZK_M_LEAVE   op[].handler!
  find: compiler_StreamSet          ZK_D_STREAMSET     op[].handler!

  // specific handlers
  find: partitionPlan_CleanupMarker ZK_M_CLEANUP op[].handler!
  find: partitionPlan_PlanOperand   ZK_D_PLANOPERAND   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: partitionPlan :: partitionPlan ;

: partitionPlan_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
