/*============================================================================*/
/* OP_syntaxTable.sen -- Operator syntax table                                */
/*============================================================================*/

" OP_syntaxTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: syntaxTable_DataMarker

  0 locals| errorCode |

  //[job].tagSet@ tagSet.asStr .
  Pipein[].pipeout

  <etc> <tableNm> "create table %v %v ;" str.format // dup .
  [job] streamDef::parse to StreamDefLft[]

  StreamDefLft[].isNull if
    [job].error@ to errorCode
    errorCode op__execErr
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // should be in tables
  Folder[].isTables assert

  StreamDefLft[].pipeout

  // should be in tables
  Folder[].isTables assert

  true
;

/*----------------------------------------------------------------------------*/
/* execute for syntaxTable req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: syntaxTable_op \operator

  _lu_initialise_

  op__topology

  find: syntaxTable_DataMarker ZK_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: syntaxTable :: syntaxTable <tableNm> <etc> ;

: syntaxTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "syntaxTable_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
