/*============================================================================*/
/* db_tenant.sen -- tenant related words                                      */
/*============================================================================*/

" db_tenant.sen" .verbose

/*----------------------------------------------------------------------------*/
/* the tenant category                                                        */
/*----------------------------------------------------------------------------*/
: \tenant \\category ;

/*----------------------------------------------------------------------------*/
/* pop the tenant folder                                                     */
/*----------------------------------------------------------------------------*/
: Path[].popTenantFolder

  Path[].popFolder
;

/*----------------------------------------------------------------------------*/
/* test if current folder is ../tenants                                       */
/*----------------------------------------------------------------------------*/
: Folder[].isTenants

  Folder[] dic.name@ "tenants" str.same
;

/*----------------------------------------------------------------------------*/
/* check current folder is ../tenants                                         */
/*----------------------------------------------------------------------------*/
: Folder[].checkIsTenants

  Folder[].isTenants if true exit then
  EC_NOT_IN_TENANTS false
;

/*----------------------------------------------------------------------------*/
/* check if word is a tenant folder                                           */
/*----------------------------------------------------------------------------*/
: Path[].checkIsTenant ( word )

  dup word.category@ find: \folder equal not if EC_NOT_A_FOLDER false exit then
  dup execute dic.kind@ find: \tenant equal if true exit then
  EC_NOT_A_TENANT false
;

/*----------------------------------------------------------------------------*/
/* check if word is a tenant                                                  */
/*----------------------------------------------------------------------------*/
: checkIsTenant ( word )
  Folder[].findSymbol if true exit then
  EC_NOT_A_TENANT false
;

/*----------------------------------------------------------------------------*/
/* check if word is not a tenant                                              */
/*----------------------------------------------------------------------------*/
: name::isNotKnownTenant ( word )
  Folder[].findSymbol not if true exit then
  EC_TENANT_EXISTS false
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* make a tenant folder (run by participant)                                  */
/*----------------------------------------------------------------------------*/
: :makeTenantFolder params| sTenantNm |

  args.tracepoint if
    sTenantNm "MAKING TENANT " swap str.cat " on NODE " str.cat [grid].thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the tenant
  sTenantNm folder::makeFolder
    find: \tenant swap execute dic.kind!

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make catalogs folder
  sTenantNm :makeCatalogsFolder ( )
;

/*----------------------------------------------------------------------------*/
/* find the tenant folder and push it onto task dictionary                   */
/*----------------------------------------------------------------------------*/
: Path[].pushTenantFolder ( "<tenantName>" -- )

  find execute Path[].pushFolder
  true
;

/*----------------------------------------------------------------------------*/
/* remove a tenant folder                                                     */
/*----------------------------------------------------------------------------*/
: removeTenant ( "<tenantNm>" --  )

  params| sTenantNm |

  args.tracepoint if
  dup "REMOVING TENANT " swap str.cat " on NODE " str.cat [grid].thisNode@ >str str.cat .
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // move to tenant folder
  sTenantNm Path[].pushTenantFolder assert

  "catalogs" folder::remove

  Path[].popTenantFolder

  sTenantNm folder::remove
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
