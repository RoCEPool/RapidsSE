/*============================================================================*/
/* test_misc.sen -- miscellaneous testing                                     */
/*============================================================================*/

" test_misc.sen" .verbose


: chuck \prompt throw ;
: chuck1 \prompt false assert ;
: chuck3 \prompt a> . ;
: chuck4 \prompt rstk 0 1 2 3 stk throw ;
: chuck5 \prompt rstk 0 1 2 3 stk path[].dump throw ;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

: iftest if "yes" . then ;

: ifelsetest if "yes" . else "no" . then ;

: untiltest 0 begin 1 + dup . dup 10 == until ;

: whiletest 0 begin 1 + dup 10 < while dup . repeat ;

: dotest 10 0 do I . loop ;
: ?dotest 10 0 ?do I . loop 10 10 ?do I . loop ;

: +looptest 10 0 do I . 2 +loop ;

: iterateTest
    compiler::current@ compiler::current@ iterate // iterate word cursor
      object@ word.name@ .       // print the name of the word
      object@ word.prev object! // step backwards thru words
    next                        // next iteration
;

: string_blowup

traceon
    "abcdefghijklmnopqrstuvwxyz"
    1000000 0 do
      "abcdefghijklmnopqrstuvwxyz"
      str.cat
    loop
;

: rottest

  2 1 0 rot . . .
;

: invrottest

  2 1 0 -rot . . .
;

/*----------------------------------------------------------------------------*/
/* str.format testing                                                         */
/*----------------------------------------------------------------------------*/
: strFormatTest

  1 "abc%v" str.format .

  "def" "abc%v" str.format .

  "gh" 456 "def" 23 "abc" 1
  "%v %v %v %v %v %v" str.format .
;

/*----------------------------------------------------------------------------*/
/* locals testing                                                             */
/*----------------------------------------------------------------------------*/
: lt

  789 456 123 locals| a b c |

  a . b . c .

  321 to a
  654 to b
  789 to c 

  a . b . c .
;

/*----------------------------------------------------------------------------*/
/* postpone testing                                                           */
/*----------------------------------------------------------------------------*/
: callTest immediate

  test
;

: postponeTest

  postpone callTest
;

/*----------------------------------------------------------------------------*/
/* string replacement                                                         */
/*----------------------------------------------------------------------------*/
: srepl

  "this" "that" "abcthisdef" str.replace .

  "this" "that" "abcthidef" str.replace .

  "this" "that" "abcthisdefthis" str.replace .
  "this" "that" "abcthisthisdefthis" str.replace .
  "this" "that" "thisthiabcthisthisdefthis" str.replace .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: whereAmI

  "whereAmI?" .
;

/*----------------------------------------------------------------------------*/
/* locks                                                                      */
/*----------------------------------------------------------------------------*/
: locksReset
  lockTracker::reset
;

: locksList
  lockTracker::list
;

/*----------------------------------------------------------------------------*/
/* yield testing                                                              */
/*----------------------------------------------------------------------------*/
: yieldTest

  10 0 do
    I .
    task::yield
  loop
;

/*----------------------------------------------------------------------------*/
/* unknown word during boot                                                   */
/*----------------------------------------------------------------------------*/
: unknownDuringBoot

  // anUnknownWord
;


/*----------------------------------------------------------------------------*/
/* test task sleep                                                            */
/*----------------------------------------------------------------------------*/
: testSleep

  0 0 locals| sleepTime |

  10 0 do
    I to sleepTime
    time.current "start time %v" str.format .
    sleepTime "task sleeping for %v secs" str.format .
    1000000 sleepTime * task::sleepUsec
    time.current "end time %v\n" str.format .
  loop
;

/*----------------------------------------------------------------------------*/
/* test reverse                                                               */
/*----------------------------------------------------------------------------*/
: testReverse \prompt

  1 2 3 . . .
  1 2 3 3 reverse . . .
;



/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
