/*============================================================================*/
/* OP_combined.sen -- Operator job report                                     */
/*============================================================================*/

" OP_combined.sen" .verbose

/*----------------------------------------------------------------------------*/
/* execute for combined req                                                   */
/*----------------------------------------------------------------------------*/
 : combined_op \operator

  _lu_initialise_

  op__topology
  
  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: combined :: combined ;

: combined_cmdTags _cmdTags tagCopy: Op_tags
  tags{
    <cmdDesc> = "--desc for op--"
 
    <opEntry> = "combined_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
