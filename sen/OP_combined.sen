/*============================================================================*/
/* OP_combined.sen -- Operator combined                                       */
/*============================================================================*/

" OP_combined.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: combined_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  Stencil[].delete
  Tub[].delete
  Combined[].delete

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_CRWBUFFER ...                                            CRWBUFFER */
/*----------------------------------------------------------------------------*/
: combined_CrwBuffer \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  "OP_Combined got a CRWBUFFER" .

  Pipein[]\clear to CrwBuffer[]
  Counter0[] 0 == if
    CrwBuffer[] Tub[] Fun0[] 1 Combined[].execute assert
  else
    CrwBuffer[] Tub[] 1 Combined[].executeFun0 assert
  then

  nullptr to CrwBuffer[]

  Tub[].pipeOutCompleted

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                            DATAPULSE */
/*----------------------------------------------------------------------------*/
: combined_DataPulse \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  "OP_Combined got a DATAPULSE" .

  Pipein[].pipeout

  // if index is set then must be an indexScan OP
  index[].isNull not if

    Counter0[] 0 == if
      // execute the indexScan and combinedOp's
      nullptr Tub[] Fun2[] 1 Combined[].execute assert

      // execute EOS handling
      nullptr Tub[] Fun3[] 1 Combined[].execute assert
    else
     // execute the indexScan and combinedOp's
     nullptr Tub[] 1 Combined[].executeFun2 assert

    // execute EOS handling
    nullptr Tub[] 1 Combined[].executeFun3 assert
    then

    // pipeout all PotRlu[]
    Tub[].pipeOutRemainder

  then

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: combined_EosMarker \handler

  0 ZK_M_EOS EG_ZK LogicUnit[].diaryNote

  Counter0[] 0 == if
    nullptr Tub[] Fun3[] 1 Combined[].execute assert
  else
    nullptr Tub[] 1 Combined[].executeFun3 assert
  then

  // pipeout all PotRlu[]
  Tub[].pipeOutRemainder

  ZK_M_EOS EG_ZK PD_PIPE_OUT 0 ZK_M_EOS EG_ZK LogicUnit[].diaryAction

  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                            ROWBUFFER */
/*----------------------------------------------------------------------------*/
: combined_RowBuffer \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  "OP_Combined got a ROWBUFFER" .

  Pipein[]\clear to RowBuffer[]
  Counter0[] 0 == if
    RowBuffer[] Tub[] Fun1[] 1 Combined[].execute assert
  else
    RowBuffer[] Tub[] 1 Combined[].executeFun1 assert
  then

  RowBuffer[].delete

  Tub[].pipeOutCompleted

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                    START */
/*----------------------------------------------------------------------------*/
: combined_StartMarker \handler

  0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  Tub[].new
  Stencil[].new
  Combined[].new

  // pipeout the start marker
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: combined_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  // synthesize the code for the combined OP's
  Combined[] Stencil[].setup

  // pipeout the streamDef
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: combined_StreamDefGen \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  // synthesize the code for the combined OP's
  Combined[] Stencil[].sketch

  // compile the stencil sketched code
  Stencil[].source@ TinyC[].compileCode not if
    EC_TINYC_ERROR op__execErr
    Pipein[].delete
    true
    exit
  then

  // pipeout the streamDef
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for combined req                                                   */
/*----------------------------------------------------------------------------*/
 : combined_op \operator

  _lu_initialise_

  // get whether code needs to be generated or not
  <generate> >int to Counter0[]

  op__topology

  find: combined_Cleaning      ZK_M_CLEANING      op[].handler!
  find: combined_CrwBuffer     ZK_D_CRWBUFFER     op[].handler!
  find: combined_DataPulse     ZK_M_DATAPULSE     op[].handler!
  find: combined_EosMarker     ZK_M_EOS           op[].handler!
  find: combined_RowBuffer     ZK_D_ROWBUFFER     op[].handler!
  find: combined_StartMarker   ZK_M_START         op[].handler!

  Counter0[] 0 == if
    find: combined_StreamDefGen  ZK_D_STREAMDEF     op[].handler!
  else
    find: combined_StreamDef     ZK_D_STREAMDEF     op[].handler!
  then

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: combined :: combined <generate> ;

: combined_cmdTags _cmdTags tagCopy: Op_tags
  tags{
    <cmdDesc> = "--desc for op--"
 
    <opEntry> = "combined_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
