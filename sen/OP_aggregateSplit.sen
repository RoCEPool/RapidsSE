/*============================================================================*/
/* OP_aggregateSplit.sen -- Split out multiple aggs from exprs (SQL Compiler) */
/*============================================================================*/

" OP_aggregateSplit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CLEANUPMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: aggregateSplit_CleanupMarker \handler

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: aggregateSplit_PlanOperand \handler

  PipeIn[]\clear to Operand[]

  // create the command error info set
  op__cmdErrInfoSet

  Operand[] nullptr to Operand[] sqlCompiler::aggregateSplit to Operand[]

   "aggregateSplit" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: aggregateSplit_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker   ZK_LEAVEMARKER op[].handler!
  find: compiler_StreamSet     ZK_STREAMSET   op[].handler!

  // specific handlers
  find: aggregateSplit_CleanupMarker ZK_CLEANUPMARKER op[].handler!
  find: aggregateSplit_PlanOperand   ZK_PLANOPERAND   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: aggregateSplit :: aggregateSplit ;

: aggregateSplit_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
