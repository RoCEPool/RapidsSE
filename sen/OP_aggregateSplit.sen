/*============================================================================*/
/* OP_aggregateSplit.sen -- Split out multiple aggs from exprs (SQL Compiler) */
/*============================================================================*/

" OP_aggregateSplit.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: aggregateSplit_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: aggregateSplit_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCmdErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::aggregateSplit to PlanOperand[]

  "aggregateSplit" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: aggregateSplit_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker   EV_M_LEAVE       [op].handler!
  find: compiler_StreamSet     EV_D_STREAMSET   [op].handler!

  // specific handlers
  find: aggregateSplit_Cleaning      EV_M_CLEANING      [op].handler!
  find: aggregateSplit_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: aggregateSplit :: aggregateSplit ;

: aggregateSplit_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "aggregateSplit_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
