/*============================================================================*/
/* OP_sysOpened.sen -- system has been opened                                 */
/*============================================================================*/

" OP_sysOpened.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: sysOpened_sysOpened \handler

  false Session::systemCloser!

  "system opened" .
  
  PipeIn[].pipeOut
  
  true
;

/*----------------------------------------------------------------------------*/
/* sysOpened request                                  (on node where spawned) */
/*----------------------------------------------------------------------------*/
: sysOpened_req \operator

  SEED_REQ

  op__topology

  find: sysOpened_sysOpened  ZK_M_DATAPULSE  op[].handler!

  op__loop

  // "*** sysOpened_req EXITS" .
   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sysOpened :: sysOpened ;

: sysOpened_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
