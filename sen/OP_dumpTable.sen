/*============================================================================*/
/* OP_dumpTable.sen -- Operator dump table                                    */
/*============================================================================*/

" OP_dumpTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: dumpTable_action

  <tableNm> op__table if
    Table[].dump
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dumpTable :: dumpTable <tableNm> ;

: dumpTable_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1

    <opEntry> = "dumpTable_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
