/*============================================================================*/
/* OP_wait.sen -- Operator wait                                               */
/*============================================================================*/

" OP_wait.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: wait_EosMarker \handler

  ZK_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_FINISHED_handler ...                                      */
/*----------------------------------------------------------------------------*/
: wait_FinishedMarker \handler

  ZK_M_FINISHED_handler
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute wait op                                                            */
/*----------------------------------------------------------------------------*/
 : wait_op \operator

  _lu_initialise_

  op__topology

  find: wait_EosMarker       ZK_M_EOS       [op].handler!
  find: wait_FinishedMarker  ZK_M_FINISHED  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: wait :: wait ;

: wait_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "wait_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
