/*============================================================================*/
/* OP_rdCsvChunk.sen -- Op Read Csv Chunk                                     */
/*============================================================================*/

" OP_rdCsvChunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                       */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_Cleaning \handler

  //"Operand:- ZK_M_CLEANING" .verbose

  // 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  //File0[].isNull not if
  //  File0[].get file.close
  //  File0[].get file.delete
  //then

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_I_SEEKOFFSETS ...                                                    */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_SeekOffsets \handler

  // 0 ZK_I_SEEKOFFSETS EG_ZK LogicUnit[].diaryNote

  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  InfoSet[].firstRow to infoSetRow[]
  begin
    infoSetRow[].isNull
  not while

   args.operands attachmap::operands@ args.operands > and if
    
      attachmap::operands@ "Queued Arguments : %v" .printf
      25 task::sleepMsec
 
   else

      // check for low memory
      attachMap::isLowMemory if
        //InfoSet[].delete
        EC_LOW_MEMORY op__execErr
        true
        exit
      then

      infoSetRow[].get InfoSet[].rdCsvChunk to CsvBuffer[]
      CsvBuffer[].pipeOut
      InfoSet[].nextRow to infoSetRow[]

    then

  repeat

  InfoSet[].delete

  // 1 ZK_I_SEEKOFFSETS EG_ZK LogicUnit[].diaryNote

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                      */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  // 0 ZK_M_START EG_ZK LogicUnit[].diaryNote

  <fileNm> locals| sFileNm_raw |
  
  job::tagSet@ sFileNm_raw str.replaceTags locals| sFileNm |

  PipeIn[].pipeOut

  // open the file for reading
  sFileNm OPEN_READ op__file discard

  // 1 ZK_M_START EG_ZK LogicUnit[].diaryNote

  true
;

/*----------------------------------------------------------------------------*/
/* execute for reachChunk req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : rdCsvChunk_op \operator

  _lu_initialise_

//  "<note>"  job::tagSet@ tagSet.hasName if
//    <note> LogicUnit[].diaryJobNote
//  then
//
//  op.opName@ LogicUnit[].diaryTitle
//  op.opName@ LogicUnit[].diaryName

  op__topology

  find: rdCsvChunk_Cleaning      ZK_M_CLEANING     op[].handler!
  find: rdCsvChunk_SeekOffsets   ZK_I_SEEKOFFSETS  op[].handler!
  find: rdCsvChunk_StartMarker   ZK_M_START        op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rdCsvChunk :: rdCsvChunk <fileNm> ;

: rdCsvChunk_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "rdCsvChunk_op"  <seedReq> = "rdCsvChunk_req"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
