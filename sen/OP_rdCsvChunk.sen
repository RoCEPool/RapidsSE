/*============================================================================*/
/* OP_rdCsvChunk.sen -- Op Read Csv Chunk                                     */
/*============================================================================*/

" OP_rdCsvChunk.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_CLEANING ...                                                       */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_Cleaning \handler

  //"Operand:- EV_M_CLEANING" .verbose

  // 0 EV_M_CLEANING EG_ZK LogicUnit[].diaryNote

  //File0[].isNull not if
  //  File0[].get file.close
  //  File0[].get file.delete
  //then

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_Eos \handler

  "<OP_rdCsvChunk>" [job].tagSet@ tagSet.hasName if
    counter0[] "OP_rdCsvChunk: nTotalBytes %v\n" .putf
  then

  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER ...                                                      */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_RowBuffer \handler

  // 0 EV_D_ROWBUFFER EG_ZK LogicUnit[].diaryNote

  0 0 locals| iOffset nBytes |

  // handle only SEEKOFFSETS
  PipeIn[].bufferType BT_SEEKOFFSETS == not if
    Pipein[].pipeout
    true
    exit
  then

  PipeIn[] to RowBuffer[]
  nullptr to PipeIn[]

  RowBuffer[].firstRow to Row[]
  begin
    Row[].isNull
  not while

    discern::rdCsvChunk not if
    
      //"Have discerned too many queued" .
      25 [task].sleepMsec
 
    else

      // check for low memory
      /*
      attachMap::isLowMemory if
        //RowBuffer[].delete
        EC_LOW_MEMORY op__execErr
        true
        exit
      then
      */

      Row[].get RowBuffer[].rdCsvChunk
        to CsvBuffer[]
        to iOffset
        to nBytes

      counter0[] nBytes + to counter0[]

      "<OP_rdCsvChunk>" [job].tagSet@ tagSet.hasName if
        nBytes iOffset "OP_rdCsvChunk: iOffset %v nBytes %v\n" .putf
      then

      CsvBuffer[].pipeOut
      RowBuffer[].nextRow to Row[]

    then

  repeat

  RowBuffer[].delete

  // 1 EV_I_SEEKOFFSETS EG_ZK LogicUnit[].diaryNote

  true
;

/*
: rdCsvChunk_SeekOffsets \handler

  // 0 EV_I_SEEKOFFSETS EG_ZK LogicUnit[].diaryNote

  PipeIn[] to RowBuffer[]
  nullptr to PipeIn[]

  RowBuffer[].firstRow to Row[]
  begin
    Row[].isNull
  not while

   [args].operands attachmap::operands@ [args].operands > and if
    
      attachmap::operands@ "Queued Arguments : %v" .printf
      25 [task].sleepMsec
 
   else

      // check for low memory
      attachMap::isLowMemory if
        //RowBuffer[].delete
        EC_LOW_MEMORY op__execErr
        true
        exit
      then

      discern::rdCsvChunk discard
      
      Row[].get RowBuffer[].rdCsvChunk to CsvBuffer[]
      CsvBuffer[].pipeOut
      RowBuffer[].nextRow to Row[]

    then

  repeat

  RowBuffer[].delete

  // 1 EV_I_SEEKOFFSETS EG_ZK LogicUnit[].diaryNote

  true
;
*/

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                          */
/*----------------------------------------------------------------------------*/
: rdCsvChunk_StartMarker \handler

  //"Operand:- EV_M_START" .verbose

  // 0 EV_M_START EG_ZK LogicUnit[].diaryNote

  <fileNm> locals| sFileNm_raw |
  
  [job].tagSet@ sFileNm_raw str.replaceTags locals| sFileNm |

  PipeIn[].pipeOut

  // open the file for reading
  sFileNm OPEN_READ op__file discard

  // 1 EV_M_START EG_ZK LogicUnit[].diaryNote

  true
;

/*----------------------------------------------------------------------------*/
/* execute for reachChunk req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : rdCsvChunk_op \operator

  _lu_initialise_

//  "<note>"  [job].tagSet@ tagSet.hasName if
//    <note> LogicUnit[].diaryJobNote
//  then
//
//  [op].opName@ LogicUnit[].diaryTitle
//  [op].opName@ LogicUnit[].diaryName

  op__topology

  find: rdCsvChunk_Cleaning      EV_M_CLEANING     [op].handler!
  find: rdCsvChunk_Eos           EV_M_EOS          [op].handler!
  find: rdCsvChunk_RowBuffer     EV_D_ROWBUFFER    [op].handler!
  find: rdCsvChunk_StartMarker   EV_M_START        [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: rdCsvChunk :: rdCsvChunk <fileNm> ;

: rdCsvChunk_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "rdCsvChunk_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
