/*============================================================================*/
/* OP_passThru.sen -- Operator passThru                                       */
/*============================================================================*/

" OP_passThru.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: passThru_CsvBuffer \handler

  //"Operand:- ZK_D_CSVBUFFER" .verbose
  Counter0[] 1 + to  Counter0[]
  Operand[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: passThru_EosMarker \handler

  //"Operand:- ZK_M_EOS" .verbose
  PipeIn[].delete
  CsvBuffer[].new
  CsvBuffer[].report
  Counter0[] "passThru" "passThru,%v,%v\nn" str.format CsvBuffer[].csvAppend
  CsvBuffer[].pipeOut

  Marker[].newEosMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
: passThru_DataMarker \handler

  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // new a stream def
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: passThru_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  "__REPORT" locals| sReportTable |

  PipeIn[].pipeOut

  sReportTable op__table if
    sReportTable Path[].pushNamedTableFolder
    sReportTable find execute to Table[]

  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for passThru req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : passThru_req \operator

  LogReqEntry SEED_REQ

  0 to Counter0[]

  op__topology

  find: passThru_CsvBuffer   ZK_D_CSVBUFFER   op[].handler!
  find: passThru_EosMarker   ZK_M_EOS   op[].handler!
  find: passThru_DataMarker ZK_M_DATAPULSE op[].handler!
  find: passThru_StartMarker ZK_M_START op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: passThru :: passThru ;

: passThru_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
