/*============================================================================*/
/* OP_setOpValidate.sen -- SetOp Simplification & Validate Op (SQL Compiler)  */
/*============================================================================*/

" OP_setOpValidate.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: setOpValidate_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: setOpValidate_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCompileErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::setOpValidate to PlanOperand[]

  "setOpValidate" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: setOpValidate_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker       EV_M_LEAVE          [op].handler!
  find: compiler_StreamSet         EV_D_STREAMSET      [op].handler!

  // specific handlers
  find: setOpValidate_Cleaning      EV_M_CLEANING      [op].handler!
  find: setOpValidate_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: setOpValidate :: setOpValidate ;

: setOpValidate_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "setOpValidate_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
