/*============================================================================*/
/* md_indexes.sen -- Define md__indexes table                                   */
/*============================================================================*/

" md_indexes.sen" .verbose

: start::md_indexes

  // C_TDEF_INDEXES

  STD_BOOTFORK_TAG
  "
  define table indexes (
    catalogName VARCHAR NOT NULL ,
    schemaName  VARCHAR NOT NULL ,
    tableName   VARCHAR NOT NULL ,
    indexName   VARCHAR NOT NULL
  ) < metaData > = MetaDataTable[].indexes ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
