/*============================================================================*/
/* md_indexes.sen -- Define md__indexes table                                   */
/*============================================================================*/

" md_indexes.sen" .verbose

: start::md_indexes

  // C_TDEF_INDEXES

  STD_BOOTFORK_TAG
  "
  define table md_indexes (
    szCatalogName VARCHAR NOT NULL ,
    szSchemaName  VARCHAR NOT NULL ,
    szTableName   VARCHAR NOT NULL ,
    szIndexName   VARCHAR NOT NULL
  ) < metaData > = MetaDataTable[].indexes ;
  "
  nullptr api::forkChild  api:executeCheck

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
