/*============================================================================*/
/* test_rjh.sen -- rays test set                                              */
/*============================================================================*/

" test_rjh.sen" .verbose

: test_rjh \prompt

  "Rays Test Suite" .

  0 locals| pTable |

  "/tenants/boray/catalogs/rapidsse/schemas/public/tables/T"

  str.toStrVec path[].set

  "T" find execute to Table[]

  3 0 do
    Table[].genCsvBuffer discard
  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
