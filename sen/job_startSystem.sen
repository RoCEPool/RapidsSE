/*============================================================================*/
/* job_startSystem.sen -- Start System Job                                    */
/*============================================================================*/

" job_startSystem.sen" .verbose

/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/

: startSystem::startSystem

  "startSystem::startSystem" .verbose

  // define the system procedures
  start::defProc_Compact
  start::defProc_Create
  start::defProc_Drop
  start::defProc_Load
  start::defProc_Rload
  start::defProc_Scan
  start::defProc_Verify
  
  start::defProc_NextHB
  start::defProc_Dload
  start::defProc_disconnect
  start::defProc_Export
  start::defProc_File
  start::defProc_Elasticity
  start::defProc_getMeta
  start::defProc_UnloadReload
  start::defProc_ForgetRebalance
  start::defProc_Range
  start::defProc_ScanTables
  start::defProc_JobRep
  start::defProc_SqlCompiler
  start::defProc_Trackmemory
  start::defProc_Memoryleaks
  start::defProc_Bpa
  start::defProc_Noop
  start::defProc_SleepCmd
  start::defProc_LogMsg
  start::defProc_SetTrace

  // define the system tables
  "define the iternal system tables" .verbose
  start::it_affectedRows
  start::it_analyzeIndex
  start::it_analyzeTable
  start::it_bpaObjects
  start::it_bpaRegions
  start::it_columnDefs
  start::it_command
  start::it_compileErrors
  start::it_count
  start::it_deref
  start::it_eventLog
  start::it_execErrors
  start::it_explain
  start::it_gridSanity
  start::it_indexColumnDefs
  start::it_jobTables
  start::it_jobNetwork
  start::it_jobNetDissect
  start::it_joinOrder
  start::it_listColumns
  start::it_listContents
  start::it_listFolder
  start::it_listIndex
  start::it_listNodes
  start::it_listPartitions
  start::it_lockStats
  start::it_logMsg
  start::it_lookupCatalog
  start::it_lookupIndex
  start::it_lookupSchema
  start::it_lookupTable
  start::it_memoryLeaks
  start::it_memoryLog
  start::it_nodeInfo
  start::it_operandLog
  start::it_pageInRequest
  start::it_partitionKey
  start::it_path
  start::it_pingInfo
  start::it_progressUnits
  start::it_promptOut
  start::it_pwf
  start::it_resourceLog
  start::it_returnPipeline
  start::it_seekOffsets
  start::it_showCluster
  start::it_sizeIndex
  start::it_sizeTable
  start::it_space
  start::it_status
  start::it_sysLocks
  start::it_sysMetrics
  start::it_tableSizes
  start::it_totalUnits
  start::it_verifyIndex
  start::it_verifyTable
  start::it_warnings

  // define the system tables
  "define the metadata tables" .verbose
  start::md_tables
  start::md_catalog
  start::md_cluster
  start::md_columns
  start::md_indexColumns
  start::md_tableIndexes
  start::md_nodes
  start::md_queries
  start::md_schema
  start::md_sessions

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Metadata table inserts

  // Add the catalog to the metadata Catalog table
  "rapids" MetaDataTable[].insertCatalog

  // Add the schema to the metadata Schema table
  "rapids" "public" MetaDataTable[].insertSchema

  // Iterate TableOfTables and get Table Ptr from Row Data
  // AM has all the info
  // Insert Table Data into other metadata tables
  MetaDataTable[].init

  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  //
  // This point onwards the SE execution model has been fully booted
  // and we can now spawn jobs
  //
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  "spawning demons" .verbose
/*
  // spawn metrics update
  STD_DEMONFORK_TAG metricsDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tMetricsDemonJobId!
  then
*/
  // spawn metrics collect
  STD_DEMONFORK_TAG collectDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tCollectDemonJobId!
  then

  // spawn supervisor demon
  STD_DEMONFORK_TAG superDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tSuperDemonJobId!
  then

  // spawn monitor demon
  STD_DEMONFORK_TAG monDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tMonDemonJobId!
  then
  // spawn page in demon
//  STD_DEMONFORK_TAG pageInDemonPipeline api::forkDemon not if
//    "Error Code %v" .printf
//  else
//    AM::DEMON::tPageInDemonJobId!
//  then

  // spawn page out demon
//  STD_DEMONFORK_TAG pageOutDemonPipeline api::forkDemon not if
//    "Error Code %v" .printf
//  else
//    AM::DEMON::tPageOutDemonJobId!
//  then

  // spawn jobExit demon
  STD_DEMONFORK_TAG jobExitDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
      AM::DEMON::tExitDemonJobId!
  then

  //spawn recurring demon
  STD_DEMONFORK_TAG recurDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tRecurDemonJobId!
  then

  // spawn stat demon
  STD_DEMONFORK_TAG statDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tStatDemonJobId!
  then

  // spawn waker demon

  STD_DEMONFORK_TAG wakerDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tWakerDemonJobId!
  then

  // spawn nodeMon demon

  STD_DEMONFORK_TAG nodeMonDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tNodeMonDemonJobId!
  then
  
  // spawn event demon
  STD_DEMONFORK_TAG eventDemonPipeline api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tEventDemonJobId!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // spawn answer demon for SE Adaptor
  STD_DEMONFORK_TAG answerSE_procText api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tAnswerDemonJobId!
  then

  // spawn connector demon for SE Adaptor
  STD_DEMONFORK_TAG connectorSE_procText api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tConnectDemonJobId!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // spawn answer demon for wireline (WL) Adaptor
  STD_DEMONFORK_TAG answerWL_procText api::forkDemon not if
    "Error Code %v" .printf
  else
    AM::DEMON::tAnswerWLDemonJobId!
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "demons spawned" .verbose

  //[system].started@ not if
    [grid].setStartNode
    true [system].started!
    ": _Start completed" .boot
  //then

  "end startSystem::startSystem" .verbose

  Path[].discardAll

  [task].grabLock
  [job].addExited
    [task].retire

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
