/*============================================================================*/
/* job_startSystem.sen -- Start System Job                                    */
/*============================================================================*/

" job_startSystem.sen" .verbose

/*----------------------------------------------------------------------------*/
/* start system                                                               */
/*----------------------------------------------------------------------------*/

: startSystem::startSystem

  "startSystem::startSystem" .verbose

  // define the system procedures
  start::defProc_Create
  
  start::defProc_Create
  start::defProc_Drop
  start::defProc_Scan
  start::defProc_Load
  start::defProc_LoadSys
  start::defProc_NextHB
  start::defProc_Dload
  start::defProc_Export
  start::defProc_Api
  start::defProc_File
  start::defProc_Elasticity
  start::defProc_getMeta
  start::defProc_SteadyState
  start::defProc_UnloadReload
  start::defProc_ForgetRebalance
  start::defProc_Query
  start::defProc_DynCompiler
  start::defProc_TPCH
  start::defProc_TPCH_ASM
  start::defProc_TPCH_ASM_I
  start::defProc_Planner
  start::defProc_ScanTables
  start::defProc_JobRep
  start::defProc_SqlCompiler

  // define the system tables
  "define the iternal system tables" .verbose
  start::it_analyzeIndex
  start::it_analyzeTable
  start::it_callPipeline
  start::it_columnDefs
  start::it_commandErrors
  start::it_count
  start::it_countInfo
  start::it_deref
  start::it_eventLog
  start::it_execErrors
  start::it_explain
  start::it_gridSanity
  start::it_indexColumnDefs
  start::it_jobTables
  start::it_jobNetwork
  start::it_jobNetDissect
  start::it_listColumns
  start::it_listContents
  start::it_listFolder
  start::it_listIndex
  start::it_listNodes
  start::it_listPartitions
  start::it_loadResult
  start::it_lockStats
  start::it_lookupCatalog
  start::it_lookupIndex
  start::it_lookupSchema
  start::it_lookupTable
  start::it_memoryLog
  start::it_nodeInfo
  start::it_operandLog
  start::it_partitionKey
  start::it_pathInfo
  start::it_pingInfo
  start::it_progressUnits
  start::it_promptOut
  start::it_pwf
  start::it_resourceLog
  start::it_returnPipeline
  start::it_seekOffsets
  start::it_showCluster
  start::it_sizeIndex
  start::it_sizeTable
  start::it_space
  start::it_status
  start::it_sysLocks
  start::it_sysMetrics
  start::it_tableSizes
  start::it_totalUnits
  start::it_verifyIndex
  start::it_verifyTable


  start::defProc_pu

  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  //
  // This point onwards the SE execution model has been fully booted
  // and we can now spawn jobs
  //
  // !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  "spawning demons" .verbose

  // spawn metrics update
  "" metricsDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn metrics collect
  "" collectDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn supervisor demon
  "" superDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn monitor demon
  "" monDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn reaper demon
  "" reaperDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn report demon
  "" exitDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn recurring demon
  "" recurDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  //spawn recurring print demon
  "" printDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn stat demon
  "" statDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn waker demon
  "" wakerDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then
  
  // spawn event demon
  "" eventDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // spawn answer demon
  "" answerDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then

  // spawn connector demon
  "" connDemonPipeline api::spawnDemon not if
    "Error Code %v" .printf
  then


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "demons spawned" .verbose

  //[system].started@ not if
    [grid].setStartNode
    true [system].started!
    ": _Start completed" .boot
  //then

  "end startSystem::startSystem" .verbose

  [job].addRetired
  [task].grabLock
    [job] [exitDemon]:queueJob
    TR_RETIRE_THIS_TASK [task].transition!

  HAZARD
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
