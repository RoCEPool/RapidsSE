/*============================================================================*/
/* se_path.sen -- dictionary related words                                    */
/*============================================================================*/

" se_path.sen" .verbose

/*----------------------------------------------------------------------------*/
/* discard all folders from path stack                                        */
/*----------------------------------------------------------------------------*/
: Path[].popAllFolders ( -- )

  Path[].depth 0 ?do
    Path[].popFolder
  loop
;

/*----------------------------------------------------------------------------*/
/* set path from string vector                                                */
/*----------------------------------------------------------------------------*/
: Path[].set ( ... #dics -- )

  // this word puts the folder path on the stack into task dictionary stack
  // ( ... "<subFolderC>"  "<subFolderB>"  "<subFolderA>" "main" 4 )


  Path[].popAllFolders

  dup not if discard exit_rt then

  0 do

    // dup "Path[].set %v" .printf

    dup "__dicRoot" str.same if
      discard
      dic::root
      Path[].pushFolder
    else

      dup "session" str.same if
        discard
      else

        dup "tenants" str.same if
          discard attachmap::tenants@ execute Path[].pushFolder
        else

          find execute Path[].pushFolder
        then

      then

    then

  loop
;

/*----------------------------------------------------------------------------*/
/* get current folder path as string                                          */
/*----------------------------------------------------------------------------*/
: Path[].toStr ( -- s )

  "/"

  // iterate thru each folder in path and concat to end
  Path[].depth 0 ?do

    I if "/" str.cat then

    // compute the path subscript
    //Path[].depth 1 - I -
    I

    // pick the path, get its name and concat name to working string
    Path[].pick dic.name@ str.cat

  loop
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: word.checkIsAFolder params| pWord |

  pWord not if EC_NO_SUCH_FOLDER false exit_rt then

  pWord word.category@ find: \folder equal if true exit_rt then

  EC_NOT_A_FOLDER false
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
