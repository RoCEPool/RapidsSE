/*============================================================================*/
/* OP_insertGlobalIndex.sen -- Operator insert into global index              */
/*============================================================================*/

" OP_insertGlobalIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_Cleaning \handler

  //"Operand:- EV_M_CLEANING" .verbose

  StreamDefLft[].isNull not if
    StreamDefLft[].delete
  then

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PDSROWBUFFER                                              */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_PdsRowBuffer \handler

  //"insertGlobalIndex_PdsRowBuffer" .

  // insert the buffer into the table ptn
  //Table[].grabWrite_msecLoop
  PipeIn[] StreamDefLft[] Index[] Table[].populateGlobalIndex
  //Table[].dropWrite

  // delete PipeIn[]
  PipeIn[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_StartMarker \handler

  //"Operand:- EV_M_START" .verbose
  //"Operand Insert:- EV_M_START" .
  PipeIn[].pipeOut

  // get Table[]  and Index[]
  <tableNm> <indexNm> op__table_index not if
    true
    exit
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_StreamDef \handler

  "Operand:- EV_D_STREAMDEF" .
  PipeIn[]\clear to StreamDefLft[]

  true
;

/*----------------------------------------------------------------------------*/
/* execute for insert                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : insertGlobalIndex_op \operator
 
  _lu_initialise_
  // "OP_insert" .
  // init the counter to be used for progress
  0 to Counter0[]

  op__topology

  find: insertGlobalIndex_Cleaning      EV_M_CLEANING     [op].handler!
  find: insertGlobalIndex_PdsRowBuffer  EV_D_PDSROWBUFFER [op].handler!
  find: insertGlobalIndex_StreamDef     EV_D_STREAMDEF    [op].handler!
  find: insertGlobalIndex_StartMarker   EV_M_START        [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: insertGlobalIndex :: insertGlobalIndex <tableNm> <indexNm> ;

: insertGlobalIndex_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "insertGlobalIndex_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
