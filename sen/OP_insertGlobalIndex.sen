/*============================================================================*/
/* OP_insertGlobalIndex.sen -- Operator insert into global index              */
/*============================================================================*/

" OP_insert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_Cleaning \handler

  //"Operand:- EV_M_CLEANING" .verbose

  // get the profile from the task
  //[task] task.profile@ to Operand[]
  //nullptr [task] task.profile!
  //Operand[].pipeOut

  Path[].popNamedTableFolder

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER                                                 */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_CrwBuffer \handler

  //"insert_DataBuffer" .

  0 locals| rowsInserted |

  // insert the buffer into the table ptn
  TablePtn[].grabWrite_msecLoop
  PipeIn[] TablePtn[].appendBuffer to rowsInserted
  TablePtn[].dropWrite

  // Accumulate the inserted row counts
  rowsInserted rowCounts[].addInserted

  // null the Pipein
  nullptr to PipeIn[]

  // increment no of buffers inserted
  Counter0[] 1 + to Counter0[]

  // send out an infoSet of ProgressUnits every 100 buffers
  Counter0[] 100 % 0 == if

    // create a Pds operand
    BT_PROGRESSUNITS TableDef[] Pds[].new

    // insert progressUnits to the Pds
    //Counter0[] TableDef[] Pds[].addProgressUnits assert
    Counter0[] 1 TableDef[] Pds[].addRowVargs assert

    // pipeout the Pds
    Pds[].pipeOut

    // reset the counter
    0 to Counter0[]

  then

  true
;


/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_EosMarker \handler

  //"Operand:- EV_M_EOS" .verbose

  // send out final progress units

  // create a Pds operand
  BT_PROGRESSUNITS TableDef[] Pds[].new

  // insert progressUnits to the Pds
  //Counter0[] TableDef[] Pds[].addProgressUnits assert
  Counter0[] 1 TableDef[] Pds[].addRowVargs assert

  // pipeout the Pds
  Pds[].pipeOut

  // send out an AFFECTEDROWS infoset with the number of rows actually inserted
  Table[].isReplicated not
  [grid].thisNodeId@ [job].originNodeId@ ==
  or if

    // Don't emit an infoset if the values are all zeros
    rowCounts[].areAllZeros not if

      C_TDEF_AFFECTEDROWS op__tableDef assert

      // create a Pds operand
      BT_AFFECTEDROWS TableDef[] Pds[].new

      // insert row counts to the Pds
      rowCounts[].getCounters@@ rowCounts[].numCounters TableDef[] Pds[].addRowVargs assert

      // pipeout the Pds
      Pds[].pipeOut

    then
  then

  PipeIn[].pipeOut

  true
  ;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_StartMarker \handler

  //"Operand:- EV_M_START" .verbose
  //"Operand Insert:- EV_M_START" .
  PipeIn[].pipeOut

  // create the TableDef for C_TDEF_PROGRESSUNITS
  C_TDEF_PROGRESSUNITS op__tableDef assert

  // get Table[] to be inserted into
  <tableNm> op__table if

    // change handler for replicated cases
    Table[].isReplicated if
      find: insert_Replicated  EV_D_CRWBUFFER  [op].handler!
    else
      Table[].tablePtn@ to TablePtn[]
    then
    
  then

  rowCounts[].new

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
: insertGlobalIndex_StreamDef \handler

  //"Operand:- EV_D_STREAMDEF" .verbose
  PipeIn[].delete
  
  true
;


/*----------------------------------------------------------------------------*/
/* execute for insert                                 (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : insertGlobalIndex_op \operator
 
  _lu_initialise_
  // "OP_insert" .
  // init the counter to be used for progress
  0 to Counter0[]

  op__topology

  find: insertGlobalIndex_Cleaning      EV_M_CLEANING     [op].handler!
  find: insertGlobalIndex_CrwBuffer     EV_D_CRWBUFFER    [op].handler!
  find: insertGlobalIndex_EosMarker     EV_M_EOS          [op].handler!
  find: insertGlobalIndex_StreamDef     EV_D_STREAMDEF    [op].handler!
  find: insertGlobalIndex_StartMarker   EV_M_START        [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: insertGlobalIndex :: insertGlobalIndex <tableNm> ;

: insert_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "insertGlobalIndex_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
