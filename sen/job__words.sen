/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: std_recoveryWord

  //"std_recoveryWord" .
  
  //[task].exception .

  "op__failureRecovery" FIND execute
  
  //process::quit

  //HAZARD
;


/*----------------------------------------------------------------------------*/
/* queue given job onto exit demon                                            */
/*----------------------------------------------------------------------------*/
: job.queueExitDemon params| pJob |

  "__exitDemon" find dup if
  
    word.object@ locals| pExitDemonJob |

    pJob pExitDemonJob job.pipeToOp0

  else

    discard

    true pJob job.reapable!

  then

;

/*----------------------------------------------------------------------------*/
/* 2pc job exits and is deleted immediately                                   */
/*----------------------------------------------------------------------------*/
: _job_2pc_delete_

  DdlLock[].testDrop
  
  // check this task has no job reference
  JobRef[].assertNone

  JS_DELETABLE Job[].state!

  Job[].addRetired
  [task].grabLock
    Job[] job.queueExitDemon
    TR_RETIRE_THIS_TASK [task].transition!

  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job_tags
  tags{
    <job> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pipelineJob_tags
  tags{
    <distJob> = 1
    <jobKind>  = JK_PIPELINE
  }
;
        
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: genericJob_tags
  tags{
    <genericJob> = 1
    <jobKind>  = JK_GENERIC
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localJob_tags
  tags{
    <localJob> = 1
    <jobKind>  = JK_LOCAL
  }
;
        

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: operator_tags
  tags{
    <ddlLock>  = DL_GRAB_READ
  }
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: op_tags tagCopy: operator_tags
  tags{
    <op> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: liteOp_tags tagCopy: operator_tags
  tags{
    <liteOp> = 1
    <jobKind>  = JK_LOCAL
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localLiteOp_tags tagCopy: operator_tags
  tags{
    <localLiteOp> = 1
    <jobKind>     = JK_LOCAL
  }
;

