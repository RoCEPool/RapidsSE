;
*/
/*----------------------------------------------------------------------------*/
/* entry point                                                                */
/*----------------------------------------------------------------------------*/
: job::entryPoint

  //" +++++++++++++++++++++++++++++++++++++++++++++++++++++++ job::entryPoint" .
  
  //[job].entryPoint@ >interpret
  [job].setInxPtr

  HAZARD
;



/*----------------------------------------------------------------------------*/
/* distribute [job] to all nodes                                              */
/*----------------------------------------------------------------------------*/
: [job]:broadcast

  0 locals| pNode |

  //C_ALL node_I[].new

  node_I[].init

  begin
    node_I[].node to pNode

    pNode node.sendSocket@ if
      pNode node.id job.forward
    else
      "++++++++++++++++++++++++++++++++++ NO SOCKET FOR NODE" .
    then

    node_I[].next
    node_i[].more
  while
  repeat

  //node_I[].delete
;

/*----------------------------------------------------------------------------*/
/* handle a failure on the originating job (LOWMEM / NODELOSS)                */
/*----------------------------------------------------------------------------*/
: [job]:handleFailure ( -- )

  // - - - - - - - - - - - - - - -
  // pipeline becomes ordinary job
  // - - - - - - - - - - - - - - -
  [job].removeOriginator
  //[job].assertOrdinary
  [args].distJob if
    "pipeline" "origin"
      "org_ ovr" "lst ordinary again"                  [job].trace
  then


  [ddlLock].testDrop
  ListedJob[].assertNoRef

  [args].distJob if
    "pipeline" "origin"
      "org_ ovr" "retiring as origin..."               [job].trace
  then

  Path[].discardAll
  [task].grabLock
  [job].addExited

    //[job].tagSet@ tagSet.asStr .
    //"<signalParent>" [job].tagSet@ tagSet.hasName not if

      [args].distJob if
        "pipeline" "origin"
        "org_ org" "WAIT/NO_WAIT signalling parent"       [job].trace
      then

      [job].parentResponseOpIsNotNull "<sendErrorsToResponseOp>" [job].tagSet@ tagSet.hasName PdsErr[].isNotNull and and if
        [job].error@ attachmap::errorText@
          [job].error@ TableDefErr[] PdsErr[].addExecError assert
        PdsErr[]\clear [job].pipeToParentResponseOp
        Marker[].newChildExitMarker
        Marker[] [job].pipeToParentResponseOp
      then

      [job].updateParent discard
      [job].signalParent discard

      [args].distJob if
        "pipeline" "origin"
          "org_ ovr" "signalled..."                  [job].trace
      then

    //then

    LogicUnit[].cleanup
    [task].retire

  HAZARD
;

