/*============================================================================*/
/* job__words.sen -- Job related words                                        */
/*============================================================================*/

" job__words.sen" .verbose

/*----------------------------------------------------------------------------*/
/* set dictionary path of this task back into session                         */
/*----------------------------------------------------------------------------*/
: setPath ( -- )

  // copy the path from task dic stack onto data stack
  Path[].depth 0 ?do
    Path[].depth 1 - I - Path[].pick dic.name@
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // store path into the sessions <path>=<...>
  Path[].depth strVec::toPath
    [job].masterJobId jobId::folderPath! assert
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants catalogs folder                            */
/*----------------------------------------------------------------------------*/
: setCatalogs ( )
  "/tenants/boray/catalogs/"
  str.toStrVec Path[].set
  setPath
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants schemas folder                             */
/*----------------------------------------------------------------------------*/
: setSchemas ( )
  "/tenants/boray/catalogs/rapids/schemas"
  str.toStrVec Path[].set
  setPath
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants tables folder                              */
/*----------------------------------------------------------------------------*/
: setTables ( )
  "/tenants/boray/catalogs/rapids/schemas/public/tables"
  str.toStrVec Path[].set
  setPath
;



////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* send job (to the node which is in task)                                    */
/*----------------------------------------------------------------------------*/
: job.send


  //[job].name@ [grid].thisNodeName@ "(%v) job.send %v" .printf

  SendNode[] node.sendSocket@ to Socket[]

  Socket[].isNotNull if

    Socket[].grabWrite

    [job] Socket[].sendObject discard

    Socket[].dropWrite
  
    nullptr to Socket[]
  then
;

/*----------------------------------------------------------------------------*/
/* send the reject job                                                        */
/*----------------------------------------------------------------------------*/
: job.sendRejectJob

  [job].originNodeId@ [grid].findNodeByNo to SendNode[]

  SendNode[] node.sendSocket@ to Socket[]

  Socket[].isNotNull if

    Socket[].grabWrite

    [job].rejectJob@ Socket[].sendObject discard

    Socket[].dropWrite

    nullptr to Socket[]

    nullptr to SendNode[]
  then
;

/*----------------------------------------------------------------------------*/
/* send job to given participating node                                       */
/*----------------------------------------------------------------------------*/
: job.forward ( i_Node -- )

  params| i_Node |

  i_Node [grid].findNodeByNo to SendNode[]

  job.send
  
  nullptr to SendNode[]
;

/*----------------------------------------------------------------------------*/
/* dispatch received job                                                      */
/*----------------------------------------------------------------------------*/
: job:spawn params| pJob |

  pJob api::spawnJob
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: [ddlLock]:acquireLock

  "<ddlLock>" <jobNm> _cmdTags::findTagSet tagSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  dup DL_GRAB_WRITE
  == if
    discard
    // "[ddlLock]:acquireLock - grabbing ddl write lock" .
    [ddlLock].grabWrite
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  dup DL_GRAB_READ
  == if
    discard
    // "[ddlLock]:acquireLock - grabbing ddl read lock" .
    [ddlLock].grabRead
    exit
  then

  discard
;

/*----------------------------------------------------------------------------*/
/* test if this job has </flow/> and if so print the jobs ename set           */
/*----------------------------------------------------------------------------*/
: job::seeTags

  [job].tagSet@ tagSet.asStr .
;


/*----------------------------------------------------------------------------*/
/* job to release any resources                                               */
/*----------------------------------------------------------------------------*/
: _job_release_resources_
;


/*----------------------------------------------------------------------------*/
/* LibInfo cleanup                                                            */
/*----------------------------------------------------------------------------*/
: [LibInfo].cleanup

  "<keepCodeFile>" [job].tagSet@ tagSet.hasName if
    false LibInfo[].delete
  else
    true LibInfo[].delete
  then
;




/******************************************************************************/
/***                                  Misc                                  ***/
/******************************************************************************/









/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: std_recoveryWord

  "std_recoveryWord" .
  
  [task].exception .

  AM::SYSTEM::Ready@ if
    "op__failureRecovery" FIND execute
  else
    process::quit
    HAZARD
  then
;


/*----------------------------------------------------------------------------*/
/* internal error exception recovery                                          */
/*----------------------------------------------------------------------------*/
: OpInternalError_recoveryWord

  "OpInternalError_recoveryWord" .

  //[task].exception .

  AM::SYSTEM::Ready@ if
    [ddlLock].testDrop


    Pipein[].isNull not if
      Pipein[].isMarker if
        //Pipein[].pipeOut
        PipeIn[]
            nullptr to PipeIn[]

          [op].pipeout
      else
        //"deleting pipein!!!" .
        Pipein[].delete
        nullptr to Pipein[]
      then
    then

    [op].isSend not assert

    [op].isRecv not assert

    // not already detected internal error ?
    [pipeline].internalError@ not if

      //[job] >str "%v PIPELINE DETECTED INTERNAL ERROR!!!" str.format .

      Marker[].newInternalError
      Marker[]
          nullptr to Marker[]

      [op].pipeout
      //"PIPED OUT INTERNAL ERROR!!!" .
    else
      [job] >str "%v PIPELINE ALREADY DETECTED INTERNAL ERROR!!!" str.format .
    then

    //
    // toggle to default abnormal handlers
    //

    //[op].opName@ "TOGGLING TO ABNORMAL HANDLERS FOR OP %v" str.format .
    "default_abnormalHandlers" FIND execute
    "toggle_PdsRowBufferHandler" FIND execute
    //[op].opName@ "TOGGLED TO ABNORMAL HANDLERS FOR OP %v" str.format .

    true

  else
    process::quit
    HAZARD
  then
;


/*----------------------------------------------------------------------------*/
/* low memory exception recovery                                              */
/*----------------------------------------------------------------------------*/
: OpLowMem_recoveryWord

  "OpLowMem_recoveryWord" .

  //[task].exception .

  AM::SYSTEM::Ready@ if
    [ddlLock].testDrop


    Pipein[].isNull not if
      Pipein[].isMarker if
        //Pipein[].pipeOut
        PipeIn[]
            nullptr to PipeIn[]

          [op].pipeout
      else
        //"deleting pipein!!!" .
        Pipein[].delete
        nullptr to Pipein[]
      then
    then

    [op].isSend not assert

    [op].isRecv not assert


    // not already detected low memory ?
    [pipeline].lowMemory@ not if

      //[job] >str "%v PIPELINE DETECTED LOW MEMORY!!!" str.format .

      Marker[].newLowMemory
      Marker[]
          nullptr to Marker[]

      [op].pipeout
      //"PIPED OUT LOW MEMORY!!!" .
    else
      [job] >str "%v PIPELINE ALREADY DETECTED LOW MEMORY!!!" str.format .
    then

    //
    // toggle to default abnormal handlers
    //

    //[op].opName@ "TOGGLING TO ABNORMAL HANDLERS FOR OP %v" str.format .
    "default_abnormalHandlers" FIND execute
    "toggle_PdsRowBufferHandler" FIND execute
    //[op].opName@ "TOGGLED TO ABNORMAL HANDLERS FOR OP %v" str.format .

    true

  else
    process::quit
    HAZARD
  then
;

/*----------------------------------------------------------------------------*/
/* job signal parent and exit                                                 */
/*----------------------------------------------------------------------------*/
: Job_signalAndExit
   Path[].discardAll
   [task].grabLock
   [job].addExited

   [job].parentResponseOpIsNotNull "<sendErrorsToResponseOp>" [job].tagSet@ tagSet.hasName PdsErr[].isNotNull and and if
     [job].error@ attachmap::errorText@
       [job].error@ TableDefErr[] PdsErr[].addExecError assert
     PdsErr[]\clear [job].pipeToParentResponseOp
     Marker[].newChildExitMarker
     Marker[] [job].pipeToParentResponseOp
   then

   [job].updateParent assert
   [job].signalParent assert
   [task].retire
   HAZARD
;

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: JobInternalError_recoveryWord

  "JobInternalError_recoveryWord" .

  //[task].exception .

  AM::SYSTEM::Ready@ if

    EC_INTERNAL_ERROR [job].error!

    //[job].jobList@ [job].phase@ [job] >str "JOB %v phase %v list %v" str.format .

    [job].phase@ JP_NONE == if

     // local job
     [job].jobList@ JL_LOCAL == if
       //"removing job from loacl list" .
       [job].removeLocal
       Path[].discardAll
       [task].grabLock
       [job].addExited

       [job].parentResponseOpIsNotNull "<sendErrorsToResponseOp>" [job].tagSet@ tagSet.hasName PdsErr[].isNotNull and and if
         [job].error@ attachmap::errorText@
           [job].error@ TableDefErr[] PdsErr[].addExecError assert
         PdsErr[]\clear [job].pipeToParentResponseOp
         Marker[].newChildExitMarker
         Marker[] [job].pipeToParentResponseOp
       then

       [job].updateParent assert
       //"Notifying parent" .
       [job].signalParent assert
       [task].retire
       HAZARD
     then

      // originating job
      [job].jobList@ JL_ORIGINATING == if
        //"removing job from originator list" .
        [job].removeOriginator
        Path[].discardAll
        [task].grabLock
        [job].addExited

        [job].parentResponseOpIsNotNull "<sendErrorsToResponseOp>" [job].tagSet@ tagSet.hasName PdsErr[].isNotNull and and if
          [job].error@ attachmap::errorText@
            [job].error@ TableDefErr[] PdsErr[].addExecError assert
          PdsErr[]\clear [job].pipeToParentResponseOp
          Marker[].newChildExitMarker
          Marker[] [job].pipeToParentResponseOp
        then

        [job].updateParent assert
        //"Notifying parent" .
        [job].signalParent assert
        [task].retire
        HAZARD
      then

      // participant job
      [job].jobList@ JL_NONE == assert
      [job].rejectJobSetup
      EC_LOW_MEMORY [job].rejectJobError!
      //"SENDING REJECT" .
      job.sendRejectJob
      Path[].discardAll
      [task].grabLock
      [job].addExited
      [task].retire
      HAZARD
    then

    [job].phase@ JP_BEGINNING == if

      //participant job
      [job].jobList@ JL_NONE == assert
      [job].rejectJobSetup
      EC_INTERNAL_ERROR [job].rejectJobError!
      //"JP_BEGINNING SENDING REJECT" .
      job.sendRejectJob
      Path[].discardAll
      [task].grabLock
      [job].addExited
      [task].retire
      HAZARD
    then

  else
    process::quit
    HAZARD
  then
;

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: JobLowMemory_recoveryWord

  "JobLowMemory_recoveryWord" .

  //[task].exception .

  AM::SYSTEM::Ready@ if

    EC_LOW_MEMORY [job].error!

    //[job].jobList@ [job].phase@ [job] >str "JOB %v phase %v list %v" str.format .

    [job].phase@ JP_NONE == if

     // local job
     [job].jobList@ JL_LOCAL == if
       //"removing job from loacl list" .
       [job].removeLocal
       Path[].discardAll
       [task].grabLock
       [job].addExited

       [job].parentResponseOpIsNotNull "<sendErrorsToResponseOp>" [job].tagSet@ tagSet.hasName PdsErr[].isNotNull and and if
         [job].error@ attachmap::errorText@
           [job].error@ TableDefErr[] PdsErr[].addExecError assert
         PdsErr[]\clear [job].pipeToParentResponseOp
         Marker[].newChildExitMarker
         Marker[] [job].pipeToParentResponseOp
       then

       [job].updateParent assert
       //"Notifying parent" .
       [job].signalParent assert
       [task].retire
       HAZARD
     then

      // originating job
      [job].jobList@ JL_ORIGINATING == if
        //"removing job from originator list" .
        [job].removeOriginator
        Path[].discardAll
        [task].grabLock
        [job].addExited

        [job].parentResponseOpIsNotNull "<sendErrorsToResponseOp>" [job].tagSet@ tagSet.hasName PdsErr[].isNotNull and and if
          [job].error@ attachmap::errorText@
            [job].error@ TableDefErr[] PdsErr[].addExecError assert
          PdsErr[]\clear [job].pipeToParentResponseOp
          Marker[].newChildExitMarker
          Marker[] [job].pipeToParentResponseOp
        then

        [job].updateParent assert
        //"Notifying parent" .
        [job].signalParent assert
        [task].retire
        HAZARD
      then

      // participant job
      [job].jobList@ JL_NONE == assert
      [job].rejectJobSetup
      EC_LOW_MEMORY [job].rejectJobError!
      //"SENDING REJECT" .
      job.sendRejectJob
      Path[].discardAll
      [task].grabLock
      [job].addExited
      [task].retire
      HAZARD
    then

    [job].phase@ JP_BEGINNING == if

      //participant job
      [job].jobList@ JL_NONE == assert
      [job].rejectJobSetup
      EC_LOW_MEMORY [job].rejectJobError!
      //"JP_BEGINNING SENDING REJECT" .
      job.sendRejectJob
      Path[].discardAll
      [task].grabLock
      [job].addExited
      [task].retire
      HAZARD
    then

  else
    process::quit
    HAZARD
  then
;

/*----------------------------------------------------------------------------*/
/* retire this job and its task                                               */
/*----------------------------------------------------------------------------*/
: [job]:retireAndExit

  [ddlLock].testDrop
  
  // check this task has no job reference
  ListedJob[].assertNoRef

  Path[].discardAll

  [task].grabLock
  [job].addExited
    [task].retire
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/* run optional <pre_execute> word                                            */
/*----------------------------------------------------------------------------*/
: [job]:pre_execute

  "" locals| sPreExe |
  
  "<pre_execute>" [job].tagSet@ tagSet.hasName if
    "<pre_execute>"
    [job].tagSet@ tagSet.getStr to sPreExe
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
      process::quit
    then
      execute
  else
    [args].verbose if
      <pipelineNm> "No pre execute word for pipeline: %v" .printf
    then
  then
;

