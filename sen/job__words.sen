/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: std_recoveryWord

  //"std_recoveryWord" .
  
  //[task].exception .

  "op__failureRecovery" FIND execute
  
  //process::quit

  //HAZARD
;


/*----------------------------------------------------------------------------*/
/* queue given job onto exit demon                                            */
/*----------------------------------------------------------------------------*/
: [exitDemon]:queueJob params| pJob |

  "__exitDemon" find dup if
  
    word.object@ locals| pExitDemonJob |

    pJob pExitDemonJob job.pipeToOp0

  else

    discard

    true pJob job.reapable!

  then

;

/*----------------------------------------------------------------------------*/
/* retire this job and its task                                               */
/*----------------------------------------------------------------------------*/
: [job]:retire

  [ddlLock].testDrop
  
  // check this task has no job reference
  ListedJob[].assertNoRef

  JS_DELETABLE [job].state!

  [job].addRetired
  [task].grabLock
    [job] [exitDemon]:queueJob
    TR_RETIRE_THIS_TASK [task].transition!

  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/* run optional <pre_execute> word                                            */
/*----------------------------------------------------------------------------*/
: [job]:pre_execute

  "<pre_execute>" [job].tagSet@ tagSet.hasName if
    "<pre_execute>"
    [job].tagSet@ tagSet.getStr locals| sPreExe |
    sPreExe find
    dup not if
      sPreExe "Unable to find pre execute word: %v" .printf
      process::quit
    then
      execute
  else
    [args].verbose if
      <pipelineNm> "No pre execute word for pipeline: %v" .printf
    then
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job_tags
  tags{
    <job> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pipelineJob_tags
  tags{
    <distJob> = 1
    <jobKind>  = JK_PIPELINE
  }
;
        
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: genericJob_tags
  tags{
    <genericJob> = 1
    <jobKind>  = JK_GENERIC
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localJob_tags
  tags{
    <localJob> = 1
    <jobKind>  = JK_LOCAL
  }
;
        

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: operator_tags
  tags{
    <ddlLock>  = DL_GRAB_READ
  }
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: op_tags tagCopy: operator_tags
  tags{
    <op> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: liteOp_tags tagCopy: operator_tags
  tags{
    <liteOp> = 1
    <jobKind>  = JK_LOCAL
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localLiteOp_tags tagCopy: operator_tags
  tags{
    <localLiteOp> = 1
    <jobKind>     = JK_LOCAL
  }
;


/*----------------------------------------------------------------------------*/
/* distribute current originating job to all nodes as participating job       */
/*----------------------------------------------------------------------------*/
: [job]:distributeBegin ( -- )

  // send the job to each connected node in the grid

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.sendSocket@ if
      pNode node.id [job] job.forward
    else
      "++++++++++++++++++++++++++++++++++ NO SOCKET FOR NODE" .
    then

    node_I[].next
    node_i[].more
  while
  repeat

  node_I[].delete
;

/*----------------------------------------------------------------------------*/
/* entry point                                                                */
/*----------------------------------------------------------------------------*/
: job::entryPoint

  //" +++++++++++++++++++++++++++++++++++++++++++++++++++++++ job::entryPoint" .
  
  [job].entryPoint@ >interpret
  
  HAZARD
;



/*----------------------------------------------------------------------------*/
/* distribute given job to all nodes                                          */
/*----------------------------------------------------------------------------*/
: job:broadcast params| pJob |

  0 locals| pNode |
  
  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.sendSocket@ if
      pNode node.id pJob job.forward
    else
      "++++++++++++++++++++++++++++++++++ NO SOCKET FOR NODE" .
    then

    node_I[].next
    node_i[].more
  while
  repeat

  node_I[].delete
;


/*----------------------------------------------------------------------------*/
/* retired this [job] + [task]                                                */
/*----------------------------------------------------------------------------*/
: [cmd]:retire

  // [job].tagSet@ tagSet.asStr .
  
  [job].addRetired
  
  JS_SIGNALLED [job].state!
  [job].signalWaiter

  [task].grabLock
    TR_RETIRE_THIS_TASK [task].transition!
;

