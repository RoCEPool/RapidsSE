/*============================================================================*/
/* OP_populateIndex.sen -- Operator populate index                            */
/*============================================================================*/

" OP_populateIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_INDEXDEF ...                                                */
/*----------------------------------------------------------------------------*/
: populateIndex_IndexDef

  0 locals| sTableNm |

  1 Counter0[] + to Counter0[]

  Counter0[] grid::knownNodes == if
    // get the index def
    Pipein[] to indexDef[]
    nullptr to Pipein[]

    indexDef[].tableName@ to sTableNm
    indexDef[].delete

    sTableNm <indexNm> op__table_index not if
      true
      exit
    then
  else
    Pipein[].delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                */
/*----------------------------------------------------------------------------*/
: populateIndex_EosMarker

  0 locals| errorCode |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // populate the index

  Table[].tablePtn@ to TablePtn[]

  TablePtn[].grabWrite_msecLoop
  Index[] TablePtn[].populateIndex not if ( errorCode )
    to errorCode
    TablePtn[].dropWrite
    errorCode op__execErr
    PipeIn[].delete
    true
    exit
  then

  TablePtn[].dropWrite

  // should be in tables
  folder[].isTables assert

  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for populateIndex req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: populateIndex_req \operator

  _op_begin_

  op__topology

  // initialize counter0
  0 to Counter0[]

  find: populateIndex_EosMarker ZK_M_EOS op[].handler!
  find: populateIndex_IndexDef ZK_D_INDEXDEF op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: populateIndex :: populateIndex <indexNm> ;

: populateIndex_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <jobDesc>   = "--description of operator--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
