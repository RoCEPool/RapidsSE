/*============================================================================*/
/* test_gGen.sen -- generate gGen files                                       */
/*============================================================================*/

" test_gGen.sen" .verbose

/*----------------------------------------------------------------------------*/
/* generate g definitions                                                     */
/*----------------------------------------------------------------------------*/
: gCol ( eColumn -- sColType )

  params| eColumn |

  eColumn case

    eCT::CT_BOOLEAN   of "boolean"   endof
    eCT::CT_CHAR      of "char"      endof
    eCT::CT_DATE      of "date"      endof
    eCT::CT_DECIMAL   of "decimal"   endof
    eCT::CT_FLOAT     of "float"     endof
    eCT::CT_INTEGER   of "integer"   endof
    eCT::CT_INTERVAL_DT  of "interval"  endof
    eCT::CT_TIME      of "time"      endof
    eCT::CT_TIMESTAMP of "timestamp" endof
    eCT::CT_VARCHAR   of "varchar"   endof

  endcase
;

/*----------------------------------------------------------------------------*/
/* generate g definitions                                                     */
/*----------------------------------------------------------------------------*/
: gRecurse ( iDepth -- )

  params| iDepth |

  iDepth .

  iDepth if
    iDepth 1 - to iDepth
    iDepth gRecurse
  then
;

/*----------------------------------------------------------------------------*/
/* generate g definitions                                                     */
/*----------------------------------------------------------------------------*/
: gGen

  9 gRecurse

  eCT::CT_ENUMS eCT::CT_BOOLEAN
  do
    I .
    I gCol .
  loop
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
