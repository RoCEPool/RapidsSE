/*============================================================================*/
/* OP_supervisor.sen -- Supervisor Operator                                   */
/*============================================================================*/

" OP_supervisor.sen" .verbose

/*----------------------------------------------------------------------------*/
/* put the supervisors peridiodic activity here                               */
/*----------------------------------------------------------------------------*/
: supervisor::activity

  //"Supervisor Activity" .
  
  // collect heartbeat related info
  Supervisor::collectInfo
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: supervisor_StartMarker \handler

  "Supervisor Job Started" .

  begin

    supervisor::activity
    args.supervisorSleep thread::sleepSsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/* execute for supervisor req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: supervisor_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: supervisor_StartMarker ZK_STARTMARKER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: supervisor :: supervisor ;

: supervisor _cmdTags tagCopy: serviceOp_tags

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
