/*============================================================================*/
/* OP_supervisor.sen -- Supervisor Operator                                   */
/*============================================================================*/

" OP_supervisor.sen" .verbose

/*----------------------------------------------------------------------------*/
/* put the supervisors peridiodic activity here                               */
/*----------------------------------------------------------------------------*/
: supervisor::activity

  //"Supervisor Activity" .
  
  //debug::breakPoint

  // collect heartbeat related info
  Supervisor::collectInfo
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: supervisor_StartMarker \handler

  "Supervisor Demon Started" .boot
  
  begin
 
    Supervisor::halt@ not if
      supervisor::activity
    then
    
    1 thread::sleepSsec

  again

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // should never exit
  hazard
;

/*----------------------------------------------------------------------------*/
/* execute for supervisor req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: supervisor_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: supervisor_StartMarker ZK_M_START op[].handler!

  op__loop

  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: supervisor :: supervisor ;

: supervisor_cmdTags _cmdTags tagCopy: serviceOp_tags

  tags{ <dedicatedThd> = 1 }

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
