/*============================================================================*/
/* OP_checkTable.sen -- check if table exists                                 */
/*============================================================================*/

" OP_checkTable.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: checkTable_StartMarker \handler

  // pipeout the (StartMarker)
  PipeIn[].pipeOut

  // test <tableName> before moving forward
  <tableNm> op__table if
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : checkTable_op \operator

  _lu_initialise_

  op__topology

  find: checkTable_StartMarker EV_M_Start [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: checkTable :: checkTable <tableNm> ;

: checkTable_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "checkTable_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
