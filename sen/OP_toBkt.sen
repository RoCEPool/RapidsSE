/*============================================================================*/
/* OP_toBkt.sen -- Redirect row data to a new node                            */
/*============================================================================*/

" OP_toBkt.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                  DEFINITION */
/*----------------------------------------------------------------------------*/
: toBkt_StreamDef \handler



  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: toBkt_StartMarker \handler

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toBkt_DataMarker \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: toBkt_RowBuffer \handler



  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: toBkt_EosMarker \handler



  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRow request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toBkt_op \operator

  _lu_initialise_

  op__topology

  find: toBkt_EosMarker   ZK_M_EOS         [op].handler!
  find: toBkt_DataMarker  ZK_M_DATAPULSE   [op].handler!
  find: toBkt_RowBuffer   ZK_D_ROWBUFFER   [op].handler!
  find: toBkt_StartMarker ZK_M_START       [op].handler!
  find: toBkt_StreamDef   ZK_D_STREAMDEF   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toBkt :: toBkt ;

: toBkt_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "toBkt_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
