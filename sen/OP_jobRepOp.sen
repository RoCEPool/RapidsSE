/*============================================================================*/
/* OP_jobRepOp.sen -- Operator job report                                     */
/*============================================================================*/

" OP_jobRepOp.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: jobRepOp_report
  
  <jobno> >int jobReport::report

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* sleep request                                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: jobRepOp_op \operator

  _lu_initialise_

  op__topology

  find: jobRepOp_report  ZK_M_DATAPULSE  op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: jobRepOp :: jobRepOp <jobNo> ;

: jobRepOp_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "jobRepOp_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
