/*============================================================================*/
/* cmd_Compiler.sen -- Command Compiler                                       */
/*============================================================================*/

" cmd_compiler.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* define the syntax for a command                                            */
/*----------------------------------------------------------------------------*/
: cmdSyntax:

  // create a word using next token from input source as the word name
  input::next locals| sCmdNm |
  sCmdNm series-name "_syntax" str.cat :create

  // set the word category to be cmdSyntax:
  [ senCompiler::current@ encode::push ] senCompiler::current@ word.category!

  // attach a tag set to hold syntax to the word being created
  tagSet::new locals| pSynTags |
  pSynTags senCompiler::current@ word.TagSet!

  // skip the :: token from input source
  input::next discard

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // add a syntax-tag for the command name
  "__cmdNm__" sCmdNm pSynTags tagSet.appendStr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // parse each input token till ';', building tag set representing the syntax

  begin

    input::next ";" str.same not

    while
           input::isTag  if "__arg__"  input::chars pSynTags tagSet.appendStr
      else input::isJson if "__json__" input::chars pSynTags tagSet.appendStr
      else input::isEtc  if "__etc__"  input::chars pSynTags tagSet.appendStr
      else                  "__cmd__"  input::chars pSynTags tagSet.appendStr
      then then then

  repeat

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // pTagSet tagSet.asStr .
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* synthesize the procedure for a lite op command given its cmdTags word      */
/*----------------------------------------------------------------------------*/

//
// I think the orientation should be params| pwCmdSyntax |
//

: cmd::synthProc_lliteOp params| pwCmdTags |

  0 locals| sText |

  pwCmdTags word.name_trunc locals| sOpNm |
  pwCmdTags word.tagSet@    locals| pCmdTagSet |
  // sOpNm "LiteOP: %v" .printf

  // synthesize procedure depending on no of parameters
  "<params>" pCmdTagSet tagSet.hasName assert
  "<params>" pCmdTagSet tagSet.getStr >int locals| iParams |

  iParams 2 == if
    "/liteOp/" sOpNm OP__tpl_lite_procedure2 str.replace to sText
    sText procedure::add
  else
  iParams 1 == if
    "/liteOp/" sOpNm OP__tpl_lite_procedure1 str.replace to sText
    sText procedure::add
  else
  iParams 0 == assert
    "/liteOp/" sOpNm OP__tpl_lite_procedure0 str.replace to sText
    sText procedure::add
  then then
;

/*----------------------------------------------------------------------------*/
/* synthesize the procedure for a local lite op command given its info word   */
/*----------------------------------------------------------------------------*/

//
// I think the orientation should be params| pwCmdSyntax |
//

: cmd::synthProc_locallliteOp params| pwCmdTags |

  0 0 locals| sText iParams |

  pwCmdTags word.name_trunc locals| sOpNm |
  pwCmdTags word.tagSet@    locals| pCmdTagSet |
  // sOpNm "LocalLiteOP: %v" .printf

  // synthesize procedure depending on no of parameters
  "<params>" pCmdTagSet tagSet.hasName assert
  "<params>" pCmdTagSet tagSet.getStr >int to iParams

  iParams 2 == if
    "/localLiteOp/" sOpNm OP__tpl_locallite_procedure2 str.replace to sText
    sText procedure::add
  else
  iParams 1 == if
    "/localLiteOp/" sOpNm OP__tpl_locallite_procedure1 str.replace to sText
    sText procedure::add
  else
  iParams 0 == assert
    "/localLiteOp/" sOpNm OP__tpl_locallite_procedure0 str.replace to sText
    sText procedure::add
  then then
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::synthLiteOpProcs

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words word@ word.category@ pwCmdTagsCatg eql if

    word@ _cmdTags.aboutLiteOp if
      word@ cmd::synthProc_lliteOp
    else
    word@ _cmdTags.aboutLocalLiteOp if
      word@ cmd::synthProc_locallliteOp
    then then

  then next-word
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* synthesize the words for a lite op command given its cmdTags word          */
/*----------------------------------------------------------------------------*/

//
// I think the orientation should be params| pwCmdSyntax |
//

: cmd::synthWords_lliteOp params| pwCmdTags |

  0 locals| sText |

  pwCmdTags word.name_trunc locals| sOpNm |
  // sOpNm "LiteOP: %v" .printf

  // synthesize word : sOpNm_DataMarker \\handler ... ;
  "/liteOp/" sOpNm OP__tpl_lite_DataMarker str.replace to sText
  sText >interpret

  // synthesize word : sOpNm_req ... ;
  "/liteOp/" sOpNm OP__tpl_lite_req str.replace to sText
  sText >interpret
;

/*----------------------------------------------------------------------------*/
/* synthesize the words for a local lite op command given its info word       */
/*----------------------------------------------------------------------------*/

//
// I think the orientation should be params| pwCmdSyntax |
//

: cmd::synthWords_locallliteOp params| pwCmdTags |

  0 locals| sText |

  pwCmdTags word.name_trunc locals| sOpNm |
  // sOpNm "LocalLiteOP: %v" .printf

  // synthesize : sOpNm_DataMarker
  "/localLiteOp/" sOpNm OP__tpl_locallite_DataMarker str.replace to sText
  sText >interpret

  // synthesize : sOpNm_req
  "/localLiteOp/" sOpNm OP__tpl_locallite_req str.replace to sText
  sText >interpret
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::synthLiteOpWords

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words word@ word.category@ pwCmdTagsCatg eql if

    word@ _cmdTags.aboutLiteOp if
      word@ cmd::synthWords_lliteOp
    else
    word@ _cmdTags.aboutLocalLiteOp if
      word@ cmd::synthWords_locallliteOp
    then then

  then next-word
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add the seed tags for a local job                                          */
/*----------------------------------------------------------------------------*/
: cmd::addSeedTags_forLocalJob params| pwCmdTags |

  //pwCmdTags word.name@ "addSeedTags_forLocalJob %v" .printf
  
  "<seedReq>" "**unknown**" "_req" pwCmdTags _cmdTags.addSeedTag
;

/*----------------------------------------------------------------------------*/
/* add the seed tags required by a command (pipeline, generic, local)         */
/*----------------------------------------------------------------------------*/
: cmd::addSeedTags_toCmdTags params| pwCmdTags |

  // pwCmdTags word.name@ "Add seeds using _cmdTags : %v" .printf

  pwCmdTags _cmdTags.aboutPipelineJob if
    //<jobKind> == JK_PIPELINE

  else
  pwCmdTags _cmdTags.aboutGenericJob if
    //<jobKind> == JK_GENERIC

  else
  pwCmdTags _cmdTags.aboutLocalJob if
    //<jobKind> == JK_LOCAL
    pwCmdTags cmd::addSeedTags_forLocalJob
    
  else
  
  then then then
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::addSeedTags

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words word@ word.category@ pwCmdTagsCatg eql if
    word@ cmd::addSeedTags_toCmdTags
  then next-word
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* add any settings that are missing in the command tags                      */
/*----------------------------------------------------------------------------*/
: cmd::addSettings_toCmdTagSet params| pwCmdTags |

  // pwCmdTags word.name@ "Adding default tags for : %v" .printf

  // hello future Alka, you should be able to conjure up what this looks like

  pwCmdTags word.tagSet@ locals| pCmdTagSet |

  "<cmdDesc>" pCmdTagSet tagSet.hasName not if
    "<cmdDesc>" "--description--" pCmdTagSet tagSet.addTag
  then

  "<cmdKind>" pCmdTagSet tagSet.hasName not if
    "<cmdKind>" "CK_COMMAND" pCmdTagSet tagSet.addTag
  then

  "<ddlLock>" pCmdTagSet tagSet.hasName not if
    "<ddlLock>" "DL_NONE" pCmdTagSet tagSet.addTag
  then

  //"<jobKind>" pCmdTagSet tagSet.hasName not if
  //  "<jobKind>" "JK_LOCAL" pCmdTagSet tagSet.addTag
  //then

  "<priority>" pCmdTagSet tagSet.hasName not if
    "<priority>" "PY_NORMAL" pCmdTagSet tagSet.addTag
  then
;

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::addSettings

  find: _cmdTags locals| pwCmdTagsCatg |

  iterate-words word@ word.category@ pwCmdTagsCatg eql if
    word@ cmd::addSettings_toCmdTagSet
  then next-word
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* complete the info and procedures for all commands                          */
/*----------------------------------------------------------------------------*/
: cmd::fillOut_allCmds

//  [? 1 ?if
  
  cmd::synthLiteOpProcs // synthesise procs for all lite and local-lite op's
  cmd::synthLiteOpWords // synthesise words for all lite and local-lite op's

  cmd::addSeedTags      // add seed tags for all dist/local/generic jobs
  cmd::addSettings      // add missing settings for <ddlLock> etc

//  ?else
   
//  ?]
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

: cmd::seriesToCmdNm

  "_" swap str.removeSuffix str.removeTailInt
;

: decode::jobKind params| eJobKind |

  0 locals| sDecode |
  eJobKind case
    
    JK_PIPELINE of "JK_PIPELINE" to sDecode endof
    JK_GENERIC  of "JK_GENERIC"  to sDecode endof
    JK_LOCAL    of "JK_LOCAL"    to sDecode endof
    "JK_???" to sDecode

  endcase

  sDecode
;

/*----------------------------------------------------------------------------*/
/* show all words that are of cmdSyntax:                                      */
/*----------------------------------------------------------------------------*/
: cmds \prompt

  //find: cmdSyntax: word::ofCatg

  find: cmdSyntax: arrange::wordsOfCatg locals| pProcSet |

  0 locals| pwCmdSyntax |
  0 locals| sCmdSyntax  |
  0 locals| sCmdNm      |
  0 locals| sCmdTagsNm  |
  0 locals| pwCmdTags   |
  0 locals| pCmdTagSet  |
  0 locals| pSynTagSet  |

  nullptr locals| pCursor |
  begin
    pCursor pProcSet arrange.next to pCursor
    pCursor
  while

    pCursor pProcSet arrange.object to pwCmdSyntax
    pCursor pProcSet arrange.name   to sCmdSyntax
    sCmdSyntax cmd::seriesToCmdNm   to sCmdNm
    sCmdNm "_cmdTags" str.cat       to sCmdTagsNm


    pCursor pProcSet arrange.seqNo "[%3v]" .putf
    sCmdNm " %18v" .putf
    pCursor pProcSet arrange.name  " %24v" .putf
    sCmdTagsNm " %24v" .putf


    sCmdTagsNm word::find to pwCmdTags
    pwCmdTags not if
      " (no-such)" .put
    else
      pwCmdTags word.tagSet@ to pCmdtagSet

      "<jobKind>" pCmdTagSet tagSet.hasName if
        "<jobKind>" pCmdTagSet tagSet.getInt " %v" .putf
        "<jobKind>" pCmdTagSet tagSet.getInt decode::jobKind " %10v" .putf
      then


      "<axiomOp>" pCmdTagSet tagSet.hasName if
        "<axiomOp>" " %14v" .putf
      else
      "<serviceOp>" pCmdTagSet tagSet.hasName if
        "<serviceOp>" " %14v" .putf
      else
      "<localLiteOp>" pCmdTagSet tagSet.hasName if
        "<localLiteOp>" " %14v" .putf
      else
      "<liteOp>" pCmdTagSet tagSet.hasName if
        "<liteOp>" " %14v" .putf
      else
      "<op>" pCmdTagSet tagSet.hasName if
        "<op>" " %14v" .putf
      else
      "<genericJob>" pCmdTagSet tagSet.hasName if
        "<genericJob>" " %14v" .putf
      else
      "<localJob>" pCmdTagSet tagSet.hasName if
        "<localJob>" " %14v" .putf
      else
      "<distJob>" pCmdTagSet tagSet.hasName if
        "<distJob>" " %14v" .putf
      then then then then then then then then

      pwCmdSyntax word.tagSet@ to pSynTagSet
      pSynTagSet tagSet.asStr " %v" .putf

    then
    
    "\n" .putf

  repeat
;

/*----------------------------------------------------------------------------*/
/* show all words that are of _cmdTags                                        */
/*----------------------------------------------------------------------------*/
: cmdTags \prompt

  0 locals| pwCmdTags  |
  0 locals| pCmdTagSet |

  find: _cmdTags arrange::wordsOfCatg locals| pProcSet |

  nullptr locals| pCursor |
  begin
    pCursor pProcSet arrange.next to pCursor
    pCursor
  while
    pCursor pProcSet arrange.seqNo "[%2v]" .putf
    pCursor pProcSet arrange.name  " %24v"  .putf

    pCursor pProcSet arrange.object to pwCmdTags
    pwCmdTags word.tagSet@ to pCmdTagSet

    "<axiomOp>" pCmdTagSet tagSet.hasName if
      "<axiomOp>" " %14v" .putf
    else
    "<serviceOp>" pCmdTagSet tagSet.hasName if
      "<serviceOp>" " %14v" .putf
    else
    "<localLiteOp>" pCmdTagSet tagSet.hasName if
      "<localLiteOp>" " %14v" .putf
    else
    "<liteOp>" pCmdTagSet tagSet.hasName if
      "<liteOp>" " %14v" .putf
    else
    "<op>" pCmdTagSet tagSet.hasName if
      "<op>" " %14v" .putf
    else
    "<genericJob>" pCmdTagSet tagSet.hasName if
      "<genericJob>" " %14v" .putf
    else
    "<localJob>" pCmdTagSet tagSet.hasName if
      "<localJob>" " %14v" .putf
    else
    "<distJob>" pCmdTagSet tagSet.hasName if
      "<distJob>" " %14v" .putf
    then then then then then then then then


    pCmdTagSet tagSet.asStr " %v" .putf

    "\n" .putf
  repeat
;

/*----------------------------------------------------------------------------*/
/* show all procedures                                                        */
/*----------------------------------------------------------------------------*/
: procedures \prompt find: \procedure word::ofCatg ;

/*----------------------------------------------------------------------------*/
/* show all procedures                                                        */
/*----------------------------------------------------------------------------*/
: procs \prompt

  find: \procedure arrange::wordsOfCatg locals| pProcSet |

  nullptr locals| pCursor |
  begin
    pCursor pProcSet arrange.next to pCursor
    pCursor
  while
    pCursor pProcSet arrange.seqNo "[%v]" .putf
    pCursor pProcSet arrange.name  " %v"  .putf

    "\n" .putf
  repeat
;




/*----------------------------------------------------------------------------*/
/* create a file per proc                                                     */
/*----------------------------------------------------------------------------*/
: procsWriteFile params| sProcNm |

  file::new locals| pProcFile |
  
  sProcNm "/Users/ray/rapidsse/Sen/procs/proc_%v.sen" str.format
  
  OPEN_WRITE pProcFile file.open assert
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // header
  
  "/*============================================================================*/\n"
  pProcFile file.writeLine
  
  sProcNm sProcNm "/* proc_%v.sen -- define procedure %v                           */\n"
  str.format pProcFile file.writeLine
  
  "/*============================================================================*/\n"
  pProcFile file.writeLine
  sProcNm "\n" pProcFile file.writeLine
  sProcNm "\"  %v.sen\" .verbose\n" str.format pProcFile file.writeLine



  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // body

  sProcNm "\n" pProcFile file.writeLine
  sProcNm "//proc: %v\n" str.format pProcFile file.writeLine
  sProcNm "\n" pProcFile file.writeLine


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // footer

  sProcNm "\n" pProcFile file.writeLine
  "/*============================================================================*/\n"
  pProcFile file.writeLine
  "/* end                                                                        */\n"
  pProcFile file.writeLine
  "/*============================================================================*/\n"
  pProcFile file.writeLine

  pProcFile file.close
  pProcFile file.delete
;

/*----------------------------------------------------------------------------*/
/* show all procedures                                                        */
/*----------------------------------------------------------------------------*/
: procsToFiles \prompt

  find: \procedure arrange::wordsOfCatg locals| pProcSet |

  nullptr locals| pCursor |
  nullptr locals| pTags   |
  nullptr locals| sWordNm |

  begin
    pCursor pProcSet arrange.next to pCursor
    pCursor
  while
  
    pCursor pProcSet arrange.name to sWordNm

    "" .
    
    sWordNm .
    
    sWordNm find word.tagSet@ to pTags
      pTags tagSet.asStr .
      
    sWordNm "_cmdTags" str.cat find
      dup if
        word.tagSet@ to pTags
        pTags tagSet.asStr .
      else
        discard
        "  No cmdtags .: -> proc file" .
      then
      

    /*
    sWordNm find word.tagSet@ to pTags
    
    pTags tagSet.asStr .

    "procText=procedure " pTags tagSet.asStr str.contains if
    
       sWordNm .
      
    then
    */
    
    //true if
    //  sWordNm procsWriteFile
    //then
      
  repeat
  
  /*
  nullptr to pCursor
  begin
    pCursor pProcSet arrange.next to pCursor
    pCursor
  while
    pCursor pProcSet arrange.name to sWordNm
    
    sWordNm find word.tagSet@ to pTags
      
    pTags tagSet.asStr .
          
    true if
      sWordNm "\"procs/proc_%v.sen\"  include" str.format .
    then

  repeat
  */

;

