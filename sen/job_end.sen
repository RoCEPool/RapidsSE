/*============================================================================*/
/* job_end.sen -- end 2pc job (pipeline coordination)                         */
/*============================================================================*/

" job_end.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
//                            on originating node                             //
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* distribute Job_End to all participants                                     */
/*----------------------------------------------------------------------------*/
: end:distribute params| pJobOriginator |

  //
  // where:  On the originator node.
  //

  0 locals| pJob_End |

  // new a temporary Job_End
  pJobOriginator job_End::new to pJob_End

  [job].tscEnding


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // set the no of acks expected in originator job
  [grid].knownNodes pJobOriginator job.acksRemaining!

  // send Job_End to all nodes

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.isConnected if
      pNode node.no pJob_End job.forward
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // delete the temporary Job_End
  pJob_End job.delete
;

/*----------------------------------------------------------------------------*/
/* run received Job_End on participating node       recv: job.spawn */
/*----------------------------------------------------------------------------*/
: end:end

  //
  // where: on the participating node
  //
  //[grid].thisNodeName@ "(%v) RECEIVED END" .printf
  [job] locals| pJob_End |
  0 locals| pTask_End |

  // find the job to be executed in the participating jobs
  pJob_End job.id@ locals| iJobId |
  iJobId ListedJob[].findParticipant discard

  // stall till job's previous phase (task) has completed
  
  ListedJob[].task@ to pTask_End
  begin
        pTask_End task.state@ TS_HIBERNATING !=
  while
    "job to be ended still has non-hibernating task" .
    [task].yield
  repeat
  pTask_End task.cycleLock
    

  ListedJob[] job.scheduleNextPhase
  ListedJob[].returnReference
  
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: end :: end ;

: end_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "end:end"
    <path>     = "/"
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
