/*============================================================================*/
/* job_end.sen -- end 2pc job (pipeline coordination)                         */
/*============================================================================*/

" job_end.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                          ON PARTICIPATING NODE                             */
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job_End on participating node       recv: job.spawn */
/*----------------------------------------------------------------------------*/
: end:end

  //
  // where: on the participating node
  //
  //[grid].thisNodeName@ "(%v) RECEIVED END" .printf
  [job] locals| pJob_End |
  0 locals| pTask_End |

  // find the job to be executed in the participating jobs
  pJob_End job.id@ locals| iJobId |
  iJobId ListedJob[].findParticipant discard

  // stall till job's previous phase (task) has completed
  
  ListedJob[].task@ to pTask_End
  begin
        pTask_End task.state@ TS_HIBERNATING !=
  while
    "job to be ended still has non-hibernating task" .
    [task].yield
  repeat
  pTask_End task.cycleLock
    

  ListedJob[] job.scheduleNextPhase
  ListedJob[].returnReference
  
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: end :: end ;

: end_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "end:end"
    <path>     = "/"
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
