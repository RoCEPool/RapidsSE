/*============================================================================*/
/* job_end.sen -- end 2pc job (pipeline coordination)                         */
/*============================================================================*/

" job_end.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                          ON PARTICIPATING NODE                             */
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* run received Job_End on participating node       recv: job.spawn */
/*----------------------------------------------------------------------------*/
: end:end

  // "end:end" .

  // find job to be ended in participating job list
  //[job] job.id@ ListedJob[].findParticipant discard
  [job].parentId@ ListedJob[].findParticipant discard

  // stall till job's previous phase (task) has completed
  begin
    ListedJob[].task@ task.state@ TS_HIBERNATING !=
  while
    "job to be ended still has non-hibernating task" .
    [task].yield
  repeat
  ListedJob[].task@ task.cycleLock
    
  // execute the job on this participating node
  ListedJob[] job.scheduleNextPhase
  
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: end :: end ;

: end_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>  = "--desc for job--"
    <entryPoint>    = "end:end"
    <path>     = "/"
}
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
