/*----------------------------------------------------------------------------*/
/* make /tenants/boray/catalogs/rapidsse/schemas/public/tables                */
/*----------------------------------------------------------------------------*/
: makeDefaultFolders ( )

  assert::stack_0

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  [ senCompiler::current@ encode::push ] word::xcheckInxPtr

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // make the tenants root folder"
  //  /tenants
  "tenants" folder::makeFolder attachMap::tenants!
  //attachmap::tenants@ execute
  attachmap::tenants@ /*dup word.see*/ execute
  Path[].pushFolder

    // make 'boray' tenant folder:
    //  /tenants/boray
    //  /tenants/boray/catalogs
    "boray" :makeTenantFolder
    "boray" Folder[].findSymbol execute
    Path[].pushFolder

      "catalogs" Folder[].findSymbol execute
      Path[].pushFolder

        // make 'rapidsse' catalog folder:
        //  /tenants/boray/catalogs/rapidsse
        //  /tenants/boray/catalogs/rapidsse/schemas
        "rapidsse" :makeCatalogFolder
        "rapidsse" Folder[].findSymbol execute
        Path[].pushFolder

          "schemas" Folder[].findSymbol execute
          Path[].pushFolder

            // make 'public' schema folder:
            //  /tenants/boray/catalogs/rapidsse/schemas/public
            //  /tenants/boray/catalogs/rapidsse/schemas/public/tables
            "public" :makeSchemaFolder

          Path[].popFolder
      Path[].popFolder
    Path[].popFolder
  Path[].popFolder

  assert::stack_0
;

//............................................................................//
//............................................................................//
//............................................................................//

"Creating default folders" .verbose
makeDefaultFolders

"Extracting EO_ fragments" .verbose
LogicCompiler[].extract

"Extracting AM_ ASM Macros" .verbose
LogicCompiler[].extractAsm

assert::stack_0

"se_boot.sen completed" .boot

"end of se_boot.sen" .verbose

/*

Sen Naming Notes
----------------

*) \catg is a \\category

*) \folder , \table , \index

*) We make a folder -- like we mkdir in Unix

*) We remove a folder -- like we rmdir in Unix

*) path[].pushFolder Folder[].popFolder as in pushd and popd shell commands

  refer: https://en.wikipedia.org/wiki/Pushd_and_popd

*) word.isaIndex , word.isaTable , word.isAFolder

   should this pattern be word.isaIndex etc

*) word.checkIsAFolder

*) name::isNotKnownXyz

-- END --

*/


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
