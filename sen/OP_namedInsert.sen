/*============================================================================*/
/* OP_namedInsert.sen -- Operator namedInsert                                 */
/*============================================================================*/

" OP_namedInsert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_NAMEDBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: OP_namedInsert \handler

  true
;

/*----------------------------------------------------------------------------*/
/* execute for namedInsert req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : namedInsert_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: OP_namedInsert ZK_NAMEDBUFFER op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: namedInsert :: namedInsert ;

: namedInsert_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
