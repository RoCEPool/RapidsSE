/*============================================================================*/
/* OP_namedInsert.sen -- Operator namedInsert                                 */
/*============================================================================*/

" OP_namedInsert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_LOCKSTATS ...                                               */
/*----------------------------------------------------------------------------*/
: OP_namedInsert_LockStats \handler

  //"eventWrite_InfoSet --- --- ---" .

//! ALKA TO CHECK WITH RAY
//  File0[].isNull not if
//    "File not null" .
//    process::quit
//  then
/*
  file::new to File0[]
  "/tmp/SE_Stats.csv" OPEN_APPEND File0[].get file.open
  not if
    File0[].get file.delete assert::stack_0 EC_INVALID_FILE
    op__execErr
    Operand[].delete
    EC_INVALID_FILE op__execErr
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  operand[] to infoset[]
  nullptr to operand[]

  InfoSet[].writeCsv

  infoset[].delete

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

 File0[].get file.close
 File0[].get file.delete
 */

  // open the file for writing
  "/tmp/SE_Stats.csv" OPEN_APPEND op__file if

    PipeIn[] to infoset[]
    nullptr to PipeIn[]

    C_TDEF_LOCKSTATS op__tableDef_infoSet assert

    infoSetTable[] InfoSet[].writeCsv

    infoset[].delete

    File0[].get file.close
    File0[].get file.delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PROFILE ...                                                 */
/*----------------------------------------------------------------------------*/
: OP_namedInsert_Profile \handler

  //"eventWrite_Profile --- --- ---" .

  // open the file for writing
  "/tmp/SE_Profile.csv" OPEN_APPEND op__file if

    PipeIn[].writeProfile

    PipeIn[].delete

    File0[].get file.close
    File0[].get file.delete
  then

  true
;

/*----------------------------------------------------------------------------*/
/* execute for eventWrite req                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : eventWrite_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: OP_namedInsert_LockStats ZK_LOCKSTATS op[].handler!
  find: OP_namedInsert_Profile   ZK_PROFILE   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eventWrite :: eventWrite ;

: eventWrite_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc>  = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
