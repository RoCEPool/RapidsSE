/*============================================================================*/
/* OP_namedInsert.sen -- Operator namedInsert                                 */
/*============================================================================*/

" OP_namedInsert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* locate named table and set Table[]                                         */
/*----------------------------------------------------------------------------*/
: locateNamedTable params| sTableNm |

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
    str.toStrVec Path[].set

  // check table assembly : ../schemas/public/tables/<sTableNm>
  sTableNm check::validTableAssembly assert

  // move into table folder : ../schemas/public/tables/<sTableNm>
  sTableNm Path[].pushNamedTableFolder
  
  // find the pTable : ../schemas/public/tables/<sTableNm>/<sTableNm>
  sTableNm find execute to Table[]

  // cross-check Table[]
  Table[] assert
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_NAMEDBUFFER ...                                           */
/*----------------------------------------------------------------------------*/
: namedInsert_NamedBuffer \handler

  PipeIn[]\clear to NamedBuffer[]

  NamedBuffer[].name@ locals| sBufferNm |

  // locate the table
  sBufferNm locateNamedTable

  // create the streamDef of this table
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[] to StreamDefLft[]
  nullptr to StreamDefOut[]

  // morph the nameBuffer to a rowBuffer
  CN_ROWBUFFER NamedBuffer[].morphClass
  NamedBuffer[]\clear to RowBuffer[]

  // set the lgl ptn of the rowBuffer
  0 RowBuffer[].setLglPtn

  // set the decider copies of the rowBuffer
  1 RowBuffer[].setDeciderCopies

  // convert the rowBuffer to a CrwBuffer
  ToLglPtnCrw[].create
  RowBuffer[] ToLglPtnCrw[].convert

  // delete the RowBuffer
  RowBuffer[].delete

  // insert the crwBuffers into the table

  0 Table[].tablePtnGet to TablePtn[]

  0 ToLglPtnCrw[].completed to CrwBuffer[]

  begin
    CrwBuffer[].isNull not
  while
    CrwBuffer[].appendClose
    TablePtn[].grabWrite_msecLoop
    CrwBuffer[]\clear TablePtn[].appendBuffer discard
    TablePtn[].dropWrite

    0 ToLglPtnCrw[].completed to CrwBuffer[]

  repeat

  0 ToLglPtnCrw[].dangling to CrwBuffer[]

  begin
    CrwBuffer[].isNull not
  while
    CrwBuffer[].appendClose
    TablePtn[].grabWrite_msecLoop
    CrwBuffer[]\clear TablePtn[].appendBuffer discard
    TablePtn[].dropWrite

    0 ToLglPtnCrw[].dangling to CrwBuffer[]

  repeat

  // cleanup
  ToLglPtnCrw[].delete
  StreamDefLft[].delete

  //sBufferNm "$$$ OP_namedInsert %v" .printf
  Table[].name@ "$$$ OP_namedInsert %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: namedInsert_RowBuffer \handler

"namedInsert_RowBuffer" .

  PipeIn[]\clear to RowBuffer[]

  //RowBuffer[].bufferType@ BT_JOBOPERANDS == assert

  RowBuffer[].tableDefName@ locals| sTableDefName |

  sTableDefName .

  // locate the table
  sTableDefName op__tableDef assert

  // create the streamDef of this table
  TableDef[] StreamDefOut[].newFromTable
  StreamDefOut[] to StreamDefLft[]
  nullptr to StreamDefOut[]

  // morph the nameBuffer to a rowBuffer
  //CN_ROWBUFFER eBufferType[].morphClass
  //NamedBuffer[]\clear to RowBuffer[]

  // set the lgl ptn of the rowBuffer
  0 RowBuffer[].setLglPtn

  // set the decider copies of the rowBuffer
  1 RowBuffer[].setDeciderCopies

  // convert the rowBuffer to a CrwBuffer
  ToLglPtnCrw[].create
  RowBuffer[] ToLglPtnCrw[].convert

  // delete the RowBuffer
  RowBuffer[].delete

  // insert the crwBuffers into the table

  0 TableDef[].tablePtnGet to TablePtn[]

  0 ToLglPtnCrw[].completed to CrwBuffer[]

  begin
    CrwBuffer[].isNull not
  while
    CrwBuffer[].appendClose
    TablePtn[].grabWrite_msecLoop
    CrwBuffer[]\clear TablePtn[].appendBuffer discard
    TablePtn[].dropWrite

    0 ToLglPtnCrw[].completed to CrwBuffer[]

  repeat

  0 ToLglPtnCrw[].dangling to CrwBuffer[]

  begin
    CrwBuffer[].isNull not
  while
    CrwBuffer[].appendClose
    TablePtn[].grabWrite_msecLoop
    CrwBuffer[]\clear TablePtn[].appendBuffer discard
    TablePtn[].dropWrite

    0 ToLglPtnCrw[].dangling to CrwBuffer[]

  repeat

  // cleanup
  ToLglPtnCrw[].delete
  StreamDefLft[].delete

  sTableDefName "$$$ OP_namedInsert %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for namedInsert req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : namedInsert_op \operator
 
  _lu_initialise_

  op__topology

  find: namedInsert_NamedBuffer EV_D_NAMEDBUFFER [op].handler!
  find: namedInsert_RowBuffer   EV_D_ROWBUFFER   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: namedInsert :: namedInsert ;

: namedInsert_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "namedInsert_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
