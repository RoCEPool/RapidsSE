/*============================================================================*/
/* OP_namedInsert.sen -- Operator namedInsert                                 */
/*============================================================================*/

" OP_namedInsert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* locate named table and set Table[]                                         */
/*----------------------------------------------------------------------------*/
: locateNamedTable params| sTableNm |

  // move to default tables folder
  "/tenants/boray/catalogs/rapids/schemas/public/tables"
    str.toStrVec Path[].set

  // check table assembly : ../schemas/public/tables/<sTableNm>
  sTableNm check::validTableAssembly assert

  // move into table folder : ../schemas/public/tables/<sTableNm>
  sTableNm Path[].pushNamedTableFolder
  
  // find the pTable from the tables metadata table
  sTableNm MetaDataTable[].find to Table[]

  // cross-check Table[]
  Table[] assert
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PDSROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: namedInsert_PdsRowBuffer \handler

  //"namedInsert_PdsRowBuffer" .

  PipeIn[]\clear to Pds[]

  //Pds[].bufferType@ BT_JOBOPERANDS == assert

  Pds[].tableDefName@ locals| sTableDefName |

  sTableDefName .

  // locate the table
  sTableDefName op__tableDef assert

  // create the streamDef of this table
  TableDef[] StreamDefOut[].newFromTable
  StreamDefOut[] to StreamDefLft[]
  nullptr to StreamDefOut[]

  // set the lgl ptn of the Pds
  0 Pds[].setLglPtn

  // convert the Pds to a CrwBuffer
  ToLglPtnCrw[].create
  Pds[] ToLglPtnCrw[].convert

  // delete the Pds
  Pds[].delete

  // insert the crwBuffers into the table

  0 TableDef[].tablePtnGet to TablePtn[]

  0 ToLglPtnCrw[].completed to CrwBuffer[]

  begin
    CrwBuffer[].isNull not
  while
    CrwBuffer[].appendClose
    TablePtn[].grabWrite_msecLoop
    CrwBuffer[]\clear TablePtn[].appendBuffer discard
    TablePtn[].dropWrite

    0 ToLglPtnCrw[].completed to CrwBuffer[]

  repeat

  0 ToLglPtnCrw[].dangling to CrwBuffer[]

  begin
    CrwBuffer[].isNull not
  while
    CrwBuffer[].appendClose
    TablePtn[].grabWrite_msecLoop
    CrwBuffer[]\clear TablePtn[].appendBuffer discard
    TablePtn[].dropWrite

    0 ToLglPtnCrw[].dangling to CrwBuffer[]

  repeat

  // cleanup
  ToLglPtnCrw[].delete
  StreamDefLft[].delete

  //sTableDefName "$$$ OP_namedInsert %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for namedInsert req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : namedInsert_op \operator
 
  _lu_initialise_

  op__topology

  find: namedInsert_PdsRowBuffer   EV_D_PDSROWBUFFER   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: namedInsert :: namedInsert ;

: namedInsert_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "namedInsert_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
