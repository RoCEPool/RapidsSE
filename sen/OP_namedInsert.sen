/*============================================================================*/
/* OP_namedInsert.sen -- Operator namedInsert                                 */
/*============================================================================*/

" OP_namedInsert.sen" .verbose

/*----------------------------------------------------------------------------*/
/* locate named table and set Table[]                                         */
/*----------------------------------------------------------------------------*/
: locateNamedTable params| sTableNm |

  // move to default tables folder
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
    str.toStrVec Path[].set

  // check table assembly : ../schemas/public/tables/<sTableNm>
  sTableNm check::validTableAssembly assert

  // move into table folder : ../schemas/public/tables/<sTableNm>
  sTableNm Path[].pushNamedTableFolder
  
  // find the pTable : ../schemas/public/tables/<sTableNm>/<sTableNm>
  sTableNm find execute to Table[]

  // cross-check Table[]
  Table[] assert
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_NAMEDBUFFER ...                                           */
/*----------------------------------------------------------------------------*/
: namedInsert_NamedBuffer \handler

  PipeIn[]\clear to NamedBuffer[]

  NamedBuffer[].name@ locals| sBufferNm |

  sBufferNm locateNamedTable


  //CN_CRWBUFFER NamedBuffer[].morphClass
  CN_ROWBUFFER NamedBuffer[].morphClass

  0 Table[].tablePtnGet to TablePtn[]
  
  TablePtn[].grabWrite_msecLoop
  //nullptr to NamedBuffer[]
  NamedBuffer[]\clear TablePtn[].appendBuffer
  TablePtn[].dropWrite

  //sBufferNm "$$$ OP_namedInsert %v" .printf
  Table[].name@ "$$$ OP_namedInsert %v" .printf

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* execute for namedInsert req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : namedInsert_op \operator
 
  _lu_initialise_

  op__topology

  find: namedInsert_NamedBuffer ZK_D_NAMEDBUFFER [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: namedInsert :: namedInsert ;

: namedInsert_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "namedInsert_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
