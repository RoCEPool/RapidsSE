/*============================================================================*/
/* OP_toBktRow.sen -- Convert row buffers to partitioned row slab buffers     */
/*============================================================================*/

" OP_toBktRow.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: toBktRow_StartMarker \handler

  ToBktRow[].create

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                BEGIN */
/*----------------------------------------------------------------------------*/
: toBktRow_DataMarker \handler

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_ROWBUFFER ...                                                 EACH */
/*----------------------------------------------------------------------------*/
: toBktRow_RowBuffer \handler

  // check for low memory
  attachMap::isLowMemory if
    EC_LOW_MEMORY op__execErr
    PipeIn[].delete
    true
    exit
  then

  PipeIn[]\clear to RowBuffer[]
  RowBuffer[] ToBktRow[].convert
  RowBuffer[].delete

  ptnmap::ptnsInGrid 0
  do

    I ToBktRow[].completed to RowBuffer[]

    begin
      RowBuffer[].isNull not
    while
      RowBuffer[].pipeOut
      I ToBktRow[].completed to RowBuffer[]
    repeat

  loop

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS ...                                                       END */
/*----------------------------------------------------------------------------*/
: toBktRow_EosMarker \handler

  ptnmap::ptnsInGrid 0
  do

    I ToBktRow[].dangling to RowBuffer[]

    begin
      RowBuffer[].isNull not
    while
      RowBuffer[].pipeOut
      I ToBktRow[].dangling to RowBuffer[]
    repeat

  loop

  ToBktRow[].delete

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* toRow request                                                        SPAWN */
/*----------------------------------------------------------------------------*/
: toBktRow_req \operator

  _op_begin_

  op__topology

  find: toBktRow_EosMarker   ZK_M_EOS         op[].handler!
  find: toBktRow_DataMarker  ZK_M_DATAPULSE   op[].handler!
  find: toBktRow_RowBuffer   ZK_D_ROWBUFFER   op[].handler!
  find: toBktRow_StartMarker ZK_M_START       op[].handler!

  op__loop

   
  _op_release_resources_
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: toBktRow :: toBktRow ;

: toBktRow_cmdTags _cmdTags tagCopy: op_tags tags{ <cmdDesc> = "--desc for op--" } ;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
