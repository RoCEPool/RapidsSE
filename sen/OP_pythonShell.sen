/*============================================================================*/
/* OP_pythonShell.sen -- Operator pythonShell                                 */
/*============================================================================*/

" OP_pythonShell.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CSVBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: pythonShell_CsvBuffer \handler

  //"Operand:- ZK_D_CSVBUFFER" .verbose
  PipeIn[]\clear to CsvBuffer[]

  CsvBuffer[].csvData
  <pythonFile> Operand[].invokePythonShell

  true
;

/*----------------------------------------------------------------------------*/
/* execute for pythonShell request                    (on node where spawned) */
/*----------------------------------------------------------------------------*/
: pythonShell_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: pythonShell_CsvBuffer   ZK_D_CSVBUFFER   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: pythonShell :: pythonShell <pythonFile> ;

: pythonShell_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
