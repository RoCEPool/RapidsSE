/*============================================================================*/
/* OP_exeSubPipe.sen -- Operator Execute Sub-Pipeline                         */
/*============================================================================*/

" OP_exeSubPipe.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: exeSubPipe_StartMarker \handler

  0 locals| nAcks |

  // <subPipeNm> [subPipeOfOp].find to SubPipe[]
  
  subPipe:exe
  
  nullptr to SubPipe[]

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* execute sub-pipeline req                                                   */
/*----------------------------------------------------------------------------*/
 : exeSubPipe_op \operator

  _lu_initialise_

  op__topology

  find: exeSubPipe_StartMarker  ZK_M_START  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exeSubPipe :: exeSubPipe <subPipeNm> ;

: exeSubPipe_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "exeSubPipe_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
