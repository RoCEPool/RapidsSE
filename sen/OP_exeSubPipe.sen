/*============================================================================*/
/* OP_exeSubPipe.sen -- Operator Execute Sub-Pipeline                         */
/*============================================================================*/

" OP_exeSubPipe.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: exeSubPipe_StartMarker \handler

  PipeIn[].pipeOut
  true 
;

/*----------------------------------------------------------------------------*/
/* execute for execute sub-pipeline req                                       */
/*----------------------------------------------------------------------------*/
 : exeSubPipe_op \operator

  _lu_initialise_

  op__topology

  find: exeSubPipe_StartMarker  ZK_M_START  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exeSubPipeline :: exeSubPipeline <subPipeNm> ;

: exeSubPipeline_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "exeSubPipe_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
