/*============================================================================*/
/* OP_exeSubPipe.sen -- Operator Execute Sub-Pipeline                         */
/*============================================================================*/

" OP_exeSubPipe.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: exeSubPipe_StartMarker \handler

  0 locals| nAcks |

  // <name> [subPlineOfOp].find to SubPipeline[]
  
  SubPipeline[].opsOnNode@ to nAcks

  [task].grabLock

    SubPipeline[].opsOnNode@ to nAcks

    nAcks if
      nAcks [task].acksRemaining!

      SubPipeline[].enqueueStart? if

        Marker[].newStartMarker
        Marker[]\clear SubPipeline[].op0@ op.enqueOperand
      then
      [task].wait
    else
      [task].dropLock
    then

  nullptr to SubPipeline[]

  ZK_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* execute for execute sub-pipeline req                                       */
/*----------------------------------------------------------------------------*/
 : exeSubPipe_op \operator

  _lu_initialise_

  op__topology

  find: exeSubPipe_StartMarker  ZK_M_START  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: exeSubPipeline :: exeSubPipeline <subPipeNm> ;

: exeSubPipeline_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "exeSubPipe_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
