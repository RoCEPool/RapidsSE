/*============================================================================*/
/* pp_jobRep.sen -- define procedure jobRep                                   */
/*============================================================================*/

" pp_jobRep.sen" .verbose

: start::defProc_JobRep
  
  STD_PATH_TAG
  "
  procedure JobRep
    parameters $JobNo
  begin

    stage stageA on origin :
        start
      | pulse once
      | jobReport $JobNo
      | output
      | sink
      | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
