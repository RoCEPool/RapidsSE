/*============================================================================*/
/* OP_visualizeIndex.sen -- Operator visualize index                          */
/*============================================================================*/

" OP_visualizeIndex.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: visidx_action

  <tableNm> <indexNm> op__table_index if
    index[].visualize
    true
  else
    false
  then
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: visidx :: visidx <tableNm> <indexNm> ;

: visidx _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 2
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

