/*============================================================================*/
/* job_words.sen -- Job related words                                         */
/*============================================================================*/

" job_words.sen" .verbose

0 constant JM_SEED_RUN
1 constant JM_SEED_REQ
2 constant JM_SEED_RCV
3 constant JM_SEED_EXE
4 constant JM_SEED_END
5 constant JM_SEED_CAN

/*----------------------------------------------------------------------------*/
/* set dictionary path of this task back into session                         */
/*----------------------------------------------------------------------------*/
: setPath ( -- )

  // copy the path from task dic stack onto data stack
  Path[].depth 0 ?do
    Path[].depth 1 - I - Path[].pick dic.name@
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // store path into the sessions <path>=<...>
  Path[].depth strVec::toPath to /session <path>
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants catalogs folder                            */
/*----------------------------------------------------------------------------*/
: setCatalogs ( )
  "/tenants/boray/catalogs/"
  str.toStrVec Path[].set
  setPath
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants schemas folder                             */
/*----------------------------------------------------------------------------*/
: setSchemas ( )
  "/tenants/boray/catalogs/rapidsse/schemas"
  str.toStrVec Path[].set
  setPath
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants tables folder                              */
/*----------------------------------------------------------------------------*/
: setTables ( )
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec Path[].set
  setPath
;



////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* print job notice                                                           */
/*----------------------------------------------------------------------------*/
: job.notice ( pJob -- )

  params| pJob |

 //   pJob job.participant@
 //   pJob job.Id@
 //   pJob object.class@ class::name
 // "NOTICE: %v jobId %v executed on node %v" .printf
;

/*----------------------------------------------------------------------------*/
/* send job (to the node which is in task)                                    */
/*----------------------------------------------------------------------------*/
: job.send params| pJob |


  //pJob job.name@ grid::thisNodeName@ "(%v) job.send %v" .printf

  SendNode[] node.sendSocket@ to Socket[]

  Socket[].grabWrite

  pJob Socket[].sendObject discard

  Socket[].dropWrite
  
  nullptr to Socket[]
;

/*----------------------------------------------------------------------------*/
/* send job to given participating node                                       */
/*----------------------------------------------------------------------------*/
: job.forward ( i_Node pJob -- )

  params| pJob |
  params| i_Node |

  i_Node grid::findNodeByNo to SendNode[]

  pJob job.send
  
  nullptr to SendNode[]
;

/*----------------------------------------------------------------------------*/
/* send job back to originating node                                          */
/*----------------------------------------------------------------------------*/
: job.reply ( i_Node pJob -- )

  params| pJob |
  params| i_Node |

  i_Node grid::findNodeByNo to SendNode[]

  pJob job.send
  
  nullptr to SendNode[]
;

/*----------------------------------------------------------------------------*/
/* dispatch received job                                                      */
/*----------------------------------------------------------------------------*/
: job.dispatch params| pJob |

  pJob job.seedDecode
  pJob job.seed!
  pJob job.spawn
;


/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: job::acquireDdlLock

  "<ddlLock>" <jobNm> _cmdTags::findTagSet tagSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  dup DL_GRAB_WRITE
  == if
    discard
    // "job::acquireDdlLock - grabbing ddl write lock" .
    DdlLock[].grabWrite
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  dup DL_GRAB_READ
  == if
    discard
    // "job::acquireDdlLock - grabbing ddl read lock" .
    DdlLock[].grabRead
    exit
  then

  discard
;

/*----------------------------------------------------------------------------*/
/* test if this job has </flow/> and if so print the jobs ename set           */
/*----------------------------------------------------------------------------*/
: job::seeTags

  job::tagSet@ tagSet.asStr .
;


/*----------------------------------------------------------------------------*/
/* job to release any resources                                               */
/*----------------------------------------------------------------------------*/
: _job_release_resources_
;




/*----------------------------------------------------------------------------*/
/* category of words which are seeds                                          */
/*----------------------------------------------------------------------------*/
: seed

;

/*----------------------------------------------------------------------------*/
/* sets the category of word being being compiled as seed                     */
/*----------------------------------------------------------------------------*/
: word::seed#

  find: seed senCompiler::current@ word.category!
;



/******************************************************************************/
/***                              Done Markers                              ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* done executing any seed                                                    */
/*----------------------------------------------------------------------------*/
: _job_finalise_ ( -- )

  // check this task has no job reference
  JobRef[].none

  // check this task has no ddl lock
  DdlLock[].none
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/



/******************************************************************************/
/***                                  Misc                                  ***/
/******************************************************************************/


/*----------------------------------------------------------------------------*/
/* job has encountered an error                                               */
/*----------------------------------------------------------------------------*/
: job::error! params| errorCode |

  //DdlLock[].testDrop

  errorCode job[] job.error!
;







/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: std_recoveryWord

  //"std_recoveryWord" .
  
  //task::exception .

  "op__failureRecovery" FIND execute
  
  //process::quit

  //HAZARD
;


/*----------------------------------------------------------------------------*/
/* 2pc job exits and is deleted immediately                                   */
/*----------------------------------------------------------------------------*/
: _job_2pc_delete_

  DdlLock[].testDrop

  _job_finalise_
  
  JS_DELETABLE job::state!

  Task[].grabLock
  TR_DELETE_THIS_TASK Task[].transition!
  
  HAZARD
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job_tags
  tags{
    <job> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pipelineJob_tags
  tags{
    <distJob> = 1
    <jobKind>  = JK_PIPELINE
  }
;
        
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: genericJob_tags
  tags{
    <genericJob> = 1
    <jobKind>  = JK_GENERIC
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localJob_tags
  tags{
    <localJob> = 1
    <jobKind>  = JK_LOCAL
  }
;
        

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: operator_tags
  tags{
    <ddlLock>  = DL_GRAB_READ
  }
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: op_tags tagCopy: operator_tags
  tags{
    <op> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: liteOp_tags tagCopy: operator_tags
  tags{
    <liteOp> = 1
    <jobKind>  = JK_LOCAL
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localLiteOp_tags tagCopy: operator_tags
  tags{
    <localLiteOp> = 1
    <jobKind>     = JK_LOCAL
  }
;



/*----------------------------------------------------------------------------*/
/* set path                                                                   */
/*----------------------------------------------------------------------------*/
: _lu_set_path_

  // use the <path> from <ename-set>
  <path> str.toStrVec Path[].set
;

/*----------------------------------------------------------------------------*/
/* initialise the logic unit                                                  */
/*----------------------------------------------------------------------------*/
: _lu_initialise_

  _lu_set_path_
;

/*----------------------------------------------------------------------------*/
/* initialise the logic unit                                                  */
/*----------------------------------------------------------------------------*/
: _lu_finalise_

  DdlLock[].testDrop
  
  // check this task has no job reference
  JobRef[].none

  // check this task has no ddl lock
  DdlLock[].none
;

/*----------------------------------------------------------------------------*/
/* unlink task and job                                                        */
/*----------------------------------------------------------------------------*/
: job::unlinkTaskAndJob_tbr

  Task[].job@ if
  
    nullptr Task[].job@ job.task!
    
    nullptr Task[].job!
  then
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
