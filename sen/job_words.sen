/*============================================================================*/
/* job_words.sen -- Job related words                                         */
/*============================================================================*/

" job_words.sen" .verbose

0 constant JM_SEED_RUN
1 constant JM_SEED_REQ
2 constant JM_SEED_RCV
3 constant JM_SEED_EXE
4 constant JM_SEED_END
5 constant JM_SEED_CAN

/*----------------------------------------------------------------------------*/
/* set dictionary path of this task back into session                         */
/*----------------------------------------------------------------------------*/
: setPath ( -- )

  // copy the path from task dic stack onto data stack
  Path[].depth 0 ?do
    Path[].depth 1 - I - Path[].pick dic.name@
  loop

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // store path into the sessions <path>=<...>
  Path[].depth strVec::toPath to /session <path>
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants catalogs folder                            */
/*----------------------------------------------------------------------------*/
: setCatalogs ( )
  "/tenants/boray/catalogs/"
  str.toStrVec Path[].set
  setPath
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants schemas folder                             */
/*----------------------------------------------------------------------------*/
: setSchemas ( )
  "/tenants/boray/catalogs/rapidsse/schemas"
  str.toStrVec Path[].set
  setPath
;

/*----------------------------------------------------------------------------*/
/* set path to the default tenants tables folder                              */
/*----------------------------------------------------------------------------*/
: setTables ( )
  "/tenants/boray/catalogs/rapidsse/schemas/public/tables"
  str.toStrVec Path[].set
  setPath
;

/*----------------------------------------------------------------------------*/
/* job becomes a participant on participant node                              */
/*----------------------------------------------------------------------------*/
: job::becomeParticipant ( -- )

  job[] locals| pJob |

  // set participant node in job
  grid::thisNode@ pJob job.participant!

  // add job to participant job list
  pJob job.addParticipant
;

/*----------------------------------------------------------------------------*/
/* test if this job has </flow/> and if so print the jobs ename set           */
/*----------------------------------------------------------------------------*/
: job::</seeXfer/>

  "</xfer/>"
  job::tagSet@ tagSet.hasName
  if

   r@ locate .
   job::tagSet@ tagSet.asStr .

  then
;



////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////

/*----------------------------------------------------------------------------*/
/* print job notice                                                           */
/*----------------------------------------------------------------------------*/
: job.notice ( pJob -- )

  params| pJob |

 //   pJob job.participant@
 //   pJob job.Id@
 //   pJob object.class@ class::name
 // "NOTICE: %v jobId %v executed on node %v" .printf
;

/*----------------------------------------------------------------------------*/
/* send job (to the node which is in task)                                    */
/*----------------------------------------------------------------------------*/
: job.send params| pJob |


  //pJob job.name@ grid::thisNodeName@ "(%v) job.send %v" .printf

  SendNode[] node.sendSocket@ to Socket[]

  job::</seeXfer/>

  Socket[].grabWrite

  pJob Socket[].sendObject discard

  Socket[].dropWrite
  
  nullptr to Socket[]
;

/*----------------------------------------------------------------------------*/
/* send job to given participating node                                       */
/*----------------------------------------------------------------------------*/
: job.forward ( i_Node pJob -- )

  params| pJob |
  params| i_Node |

  i_Node grid::findNodeByNo to SendNode[]

  pJob job.send
  
  nullptr to SendNode[]
;

/*----------------------------------------------------------------------------*/
/* send job back to originating node                                          */
/*----------------------------------------------------------------------------*/
: job.reply ( i_Node pJob -- )

  params| pJob |
  params| i_Node |

  i_Node grid::findNodeByNo to SendNode[]

  pJob job.send
  
  nullptr to SendNode[]
;

/*----------------------------------------------------------------------------*/
/* dispatch received job                                                      */
/*----------------------------------------------------------------------------*/
: job.dispatch params| pJob |

  pJob job.seedDecode
  pJob job.seed!
  pJob job.spawn
;

/*----------------------------------------------------------------------------*/
/* add this job into originator list                                          */
/*----------------------------------------------------------------------------*/
: job::becomeOriginator ( -- )

   // set originating task
  task[] job[] job.originatingTask!

  job[] job.id@ job[] job.originatingId!

  // add job to originator jobs
  job[] job.addOriginator
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
: job::acquireDdlLock

  "<ddlLock>" <jobNm> _cmdTags::findTagSet tagSet.getInt

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  dup DL_GRAB_WRITE
  == if
    discard
    // "job::acquireDdlLock - grabbing ddl write lock" .
    DdlLock[].grabWrite
    exit
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --

  dup DL_GRAB_READ
  == if
    discard
    // "job::acquireDdlLock - grabbing ddl read lock" .
    DdlLock[].grabRead
    exit
  then

  discard
;

/*----------------------------------------------------------------------------*/
/* test if this job has </flow/> and if so print the jobs ename set           */
/*----------------------------------------------------------------------------*/
: job::seeTags

  job::tagSet@ tagSet.asStr .
;

/*----------------------------------------------------------------------------*/
/* this job has completed; coordinate with invoker                            */
/*----------------------------------------------------------------------------*/
: job::informInvokerOfCompletion

  <plProtocol> PP_SIGNAL_SESSION == if
    //"signalling session" .
    job[] job.signalSession

  else <plProtocol> PP_RETURN_PIPELINE == if
    "unused plProtocol" .
    HAZARD

  else
    "unknown plProtocol" .
    HAZARD
    
  then then
;

/*----------------------------------------------------------------------------*/
/* job to release any resources                                               */
/*----------------------------------------------------------------------------*/
: _job_release_resources_
;




/*----------------------------------------------------------------------------*/
/* category of words which are seeds                                          */
/*----------------------------------------------------------------------------*/
: seed

;

/*----------------------------------------------------------------------------*/
/* sets the category of word being being compiled as seed                     */
/*----------------------------------------------------------------------------*/
: word::seed#

  find: seed senCompiler::current@ word.category!
;



/******************************************************************************/
/***                              Done Markers                              ***/
/******************************************************************************/

/*----------------------------------------------------------------------------*/
/* done executing any seed                                                    */
/*----------------------------------------------------------------------------*/
: _job_finalise_ ( -- )

  // check this task has no job reference
  JobRef[].none

  // check this task has no ddl lock
  DdlLock[].none
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/



/******************************************************************************/
/***                                  Misc                                  ***/
/******************************************************************************/


/*----------------------------------------------------------------------------*/
/* job has encountered an error                                               */
/*----------------------------------------------------------------------------*/
: job::error! params| errorCode |

  DdlLock[].testDrop

  errorCode job[] job.error!
;







/*----------------------------------------------------------------------------*/
/***                            - Exception Hooks -                         ***/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* standard exception recovery                                                */
/*----------------------------------------------------------------------------*/
: std_recoveryWord

  //"std_recoveryWord" .
  
  //task::exception .

  "op__failureRecovery" FIND execute
  
  //process::quit

  //HAZARD
;


/*----------------------------------------------------------------------------*/
/* job exit                                                                   */
/*----------------------------------------------------------------------------*/
: job_exit

  //"job_exit" .

  DdlLock[].testDrop

  _job_finalise_

  job::completed

  HAZARD
;



/*----------------------------------------------------------------------------*/
/* distribute current originating job to all participating nodes              */
/*----------------------------------------------------------------------------*/
: job::sendToParticipants ( -- )

  job[] locals| pJob |

  // create the response vector in the orginating job to receive responses
  //pJob job.createResponseVec

  // set the no of acks expected by originator job
  //   to be the number of defined nodes in the grid
  grid::knownNodes pJob job.acksRemaining!

  // grab this task's lock
  task[] task.grabLock

  // set acks for originator task
  1 task::acks!

  // send the job to each connected node in the grid

  0 locals| pNode |

  C_ALL node_I[].new

  begin
    node_I[].node to pNode

    pNode node.sendSocket@ if
      pNode node.no pJob job.forward
    else
"++++++++++++++++++++++++++++++++++ NO SOCKET FOR NODE" .
    then

    node_I[].next
    node_i[].more while
  repeat

  node_I[].delete
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: job_tags
  tags{
    <job> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: pipelineJob_tags
  tags{
    <distJob> = 1
    <jobKind>  = JK_PIPELINE
  }
;
        
/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: genericJob_tags
  tags{
    <genericJob> = 1
    <jobKind>  = JK_GENERIC
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localJob_tags
  tags{
    <localJob> = 1
    <jobKind>  = JK_LOCAL
  }
;
        

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: operator_tags
  tags{
    <ddlLock>  = DL_GRAB_READ
  }
;


/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: op_tags tagCopy: operator_tags
  tags{
    <op> = 1
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: liteOp_tags tagCopy: operator_tags
  tags{
    <liteOp> = 1
    <jobKind>  = JK_LOCAL
  }
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
: localLiteOp_tags tagCopy: operator_tags
  tags{
    <localLiteOp> = 1
    <jobKind>     = JK_LOCAL
  }
;

