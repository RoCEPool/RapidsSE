/*============================================================================*/
/* OP_dynamic_v2.sen -- Operator combined                                    */
/*============================================================================*/

" OP_dynamic_v2.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELLINGMARKER ...                                        */
/*----------------------------------------------------------------------------*/
: dynamic_v2_CancellingMarker \handler

  Pipein[]\clear to Marker[]

  //PipeIn[].drain

  Tub[].isNull not if
    Tub[].deleteAllBuffers
  then

  Pot[].isNull not if
    Pot[].deleteAllBuffers
  then

  Marker[].pipeOut

  "default_abnormalHandlers" FIND execute
  "default_lowMemHandlers" FIND execute

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: dynamic_v2_Cleaning \handler

  0 EV_M_CLEANING EG_ZK LogicUnit[].diaryNote

  Tub[].delete
  Pot[].delete
  Stencil_v2[].delete
  Dynamic[].delete

  EV_M_CLEANING EG_ZK PD_PIPE_OUT 0 EV_M_CLEANING EG_ZK LogicUnit[].diaryAction

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_CRWBUFFER ...                                            CRWBUFFER */
/*----------------------------------------------------------------------------*/
: dynamic_v2_CrwBuffer \handler

  0 EV_M_START EG_ZK LogicUnit[].diaryNote

  0 locals| errorCode |

  //"OP_Combined got a CRWBUFFER" .

  Pipein[]\clear to CrwBuffer[]
  CrwBuffer[] Fun0[] 0 Dynamic[].execute not if
    to errorCode

    // cleanup
    CrwBuffer[].delete
    Tub[].deleteAllBuffers
    Pot[].deleteAllBuffers

    errorCode EC_LOW_MEMORY == if

      // not already detected low memory ?
      [pipeline].lowMemory@ not if

        Marker[].newLowMemory
        Marker[]
            nullptr to Marker[]

        [op].pipeout
        //"CombinedOP PIPED OUT LOW MEMORY!!!" .
      else
        "CombinedOP ALREADY DETECTED LOW MEMORY!!!" .
      then

      //"COMBINEDOP TOGGLING TO ABNORMAL HANDLERS FOR OP"  .
      "default_abnormalHandlers" FIND execute
      "default_lowMemHandlers" FIND execute
      //"COMBINEDOP TOGGLED TO ABNORMAL HANDLERS FOR OP" .
    else
      errorCode op__execErr
    then

    true
    exit
  then

  CrwBuffer[].delete

  // pipeout all completed Tub[]/Pot[]
  Dynamic[].hashRows@ if
    Pot[].pipeOutCompletedPtns
  else
    Tub[].pipeOutCompleted
  then

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE ...                                            DATAPULSE */
/*----------------------------------------------------------------------------*/
: dynamic_v2_DataPulse \handler

  0 EV_M_START EG_ZK LogicUnit[].diaryNote

  //"OP_Combined got a DATAPULSE" .

  Pipein[].pipeout

  // if index is set then must be an indexScan OP
  Dynamic[].IndexT to Index[]
  Index[].isNull not if

    // execute the indexScan and combinedOp's
    nullptr Fun2[] 0 Dynamic[].execute assert

    // execute EOS handling
    nullptr Fun3[] 1 Dynamic[].execute assert

    // pipeout all Tub[]/Pot[]
    Dynamic[].hashRows@ if
      Pot[].pipeOutRemainderPtns
    else
      Tub[].pipeOutRemainder
    then

    Marker[].newEosMarker
    Marker[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS ...                                                        END */
/*----------------------------------------------------------------------------*/
: dynamic_v2_EosMarker \handler

  0 EV_M_EOS EG_ZK LogicUnit[].diaryNote

 0 locals| errorCode |

  nullptr Fun3[] 0 Dynamic[].execute not if
    to errorCode
    Pipein[].delete
    Tub[].deleteAllBuffers
    Pot[].deleteAllBuffers
    errorCode op__execErr
    true
    exit
  then

  // pipeout all Tub[]/Pot[]
  Dynamic[].hashRows@ if
    Pot[].pipeOutRemainderPtns
  else
    Tub[].pipeOutRemainder
  then

  EV_M_EOS EG_ZK PD_PIPE_OUT 0 EV_M_EOS EG_ZK LogicUnit[].diaryAction

  EV_M_EOS_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ERRORING ...                                              */
/*----------------------------------------------------------------------------*/
: dynamic_v2_ErroringMarker \handler

  Pipein[]\clear to Marker[]

  //"combined_ErroringMarker DRAINING PIPEIN" .
  //PipeIn[].drain

  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_ROWBUFFER ...                                            ROWBUFFER */
/*----------------------------------------------------------------------------*/
: dynamic_v2_RowBuffer \handler

  0 EV_M_START EG_ZK LogicUnit[].diaryNote

  0 locals| errorCode |

  //"OP_Combined got a ROWBUFFER" .

  Pipein[]\clear to RowBuffer[]
  RowBuffer[] Fun1[] 0 Dynamic[].execute not if
    to errorCode

    // cleanup
    RowBuffer[].delete
    Tub[].deleteAllBuffers
    Pot[].deleteAllBuffers

    errorCode EC_LOW_MEMORY == if

      // not already detected low memory ?
      [pipeline].lowMemory@ not if

        Marker[].newLowMemory
        Marker[]
            nullptr to Marker[]

        [op].pipeout
        "CombinedOP PIPED OUT LOW MEMORY!!!" .
      else
        "CombinedOP ALREADY DETECTED LOW MEMORY!!!" .
      then

      //"COMBINEDOP TOGGLING TO ABNORMAL HANDLERS FOR OP"  .
      "default_abnormalHandlers" FIND execute
      "default_lowMemHandlers" FIND execute
      //"COMBINEDOP TOGGLED TO ABNORMAL HANDLERS FOR OP" .
    else
      errorCode op__execErr
    then

    true
    exit
  then

  RowBuffer[].delete

  // pipeout all completed Tub[]/Pot[]
  Dynamic[].hashRows@ if
    Pot[].pipeOutCompletedPtns
  else
    Tub[].pipeOutCompleted
  then

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                    START */
/*----------------------------------------------------------------------------*/
: dynamic_v2_StartMarker \handler

  0 EV_M_START EG_ZK LogicUnit[].diaryNote

  Tub[].new
  Pot[].new
  Stencil_v2[].new
  Dynamic[].new

  // pipeout the start marker
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: dynamic_v2_StreamDef \handler

  0 EV_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  // synthesize the code for the combined OP's
  Dynamic[] Stencil_v2[].setup

  // set up the function pointers
  Fun0[].setup not if
    EC_NO_SUCH_FUNCTION op__execErr
    Pipein[].delete
    true
    exit
  then

  Fun1[].setup not if
    EC_NO_SUCH_FUNCTION op__execErr
    Pipein[].delete
    true
    exit
  then

  Fun2[].setup not if
    EC_NO_SUCH_FUNCTION op__execErr
    Pipein[].delete
    true
    exit
  then

  Fun3[].setup not if
    EC_NO_SUCH_FUNCTION op__execErr
    Pipein[].delete
    true
    exit
  then


  // pipeout the streamDef
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: dynamic_v2_StreamDefGen \handler

  0 EV_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  // synthesize the code for the combined OP's
  Dynamic[] Stencil_v2[].sketch to eError
  EC_NONE eError == not if
    eError op__execErr
    Pipein[].delete
    true
    exit
  then

  // compile the stencil sketched code
  Stencil_v2[] TinyC[].compileCode_v2 not if
    EC_TINYC_ERROR op__execErr
    Pipein[].delete
    true
    exit
  then

  // pipeout the streamDef
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for combined req                                                   */
/*----------------------------------------------------------------------------*/
 : dynamic_v2_op \operator

  _lu_initialise_

  // get whether code needs to be generated or not
  <generate> >int to Counter0[]

  op__topology

  find: dynamic_v2_CancellingMarker  EV_M_CANCELLING [op].handler!
  find: dynamic_v2_Cleaning      EV_M_CLEANING      [op].handler!
  find: dynamic_v2_CrwBuffer     EV_D_CRWBUFFER     [op].handler!
  find: dynamic_v2_DataPulse     EV_M_DATAPULSE     [op].handler!
  find: dynamic_v2_EosMarker     EV_M_EOS           [op].handler!
  find: dynamic_v2_ErroringMarker EV_M_ERRORING     [op].handler!
  find: dynamic_v2_RowBuffer     EV_D_ROWBUFFER     [op].handler!
  find: dynamic_v2_StartMarker   EV_M_START         [op].handler!

  Counter0[] 0 == if
    find: dynamic_v2_StreamDefGen  EV_D_STREAMDEF     [op].handler!
  else
    find: dynamic_v2_StreamDef     EV_D_STREAMDEF     [op].handler!
  then

  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dynamic_v2 :: dynamic_v2 <generate> ;

: dynamic_v2_cmdTags _cmdTags tagCopy: Op_tags
  tags{
    <cmdDesc> = "--desc for op--"
 
    <opEntry> = "dynamic_v2_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
