/*============================================================================*/
/* tpl_localLiteOp.sen -- templates for local lite op                         */
/*============================================================================*/

" tpl_localLiteOp.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_DataMarker

"
  : /localLiteOp/_DataMarker \\handler

    PipeIn[].pipeOut

    /localLiteOp/_action if
      Marker[].newEosMarker
      Marker[].pipeOut
    then

    true
  ;
"
;

/*----------------------------------------------------------------------------*/
/* execute for localLiteOp req                        (on node where spawned) */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_req

"
  : /localLiteOp/_req \\operator

    LogReqEntry SEED_REQ

    op__topology

    find: /localLiteOp/_DataMarker  ZK_M_DATAPULSE op[].handler!

    op__loop

    LogReqExit
    DONE_REQ_OP
  ;
"
;


/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 0 parameters                                   */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_procedure0

"
  procedureLocal /localLiteOp/
    tags <lowMemory>
  begin

  stage stageA on origin :
    start | pulse once | /localLiteOp/ |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 1 parameter                                    */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_procedure1

"
  procedureLocal /localLiteOp/
    tags <lowMemory>
    parameters $param
  begin

  stage stageA on origin :
    start | pulse once | /localLiteOp/ $param |
      output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* local liteOp procedure with 2 parameters                                   */
/*----------------------------------------------------------------------------*/
: tpl_localLiteOp_procedure2

  "
    procedureLocal /localLiteOp/
      tags <lowMemory>
      parameters $param0 $param1
    begin

    stage stageA on origin :
      start | pulse once | /localLiteOp/ $param0 $param1 |
        output | sink | stageA

    end
  "
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
