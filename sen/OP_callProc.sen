/*============================================================================*/
/* OP_callProc.sen -- Operator Call Procedure                                 */
/*============================================================================*/

" OP_callProc.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* handler for ZK_I_CALLPIPELINE ...                                          */
/*----------------------------------------------------------------------------*/
: callProc_DataMarker \handler

  "callProc_DataMarker" .

  STD_PATH_TAG
  <procedureCall>
  api::executeCommand not if
     op__execErr
     true
     exit
  then

  discard //jobId

  PipeIn[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : callProc_op \operator

  _lu_initialise_

  op__topology

  find: callProc_DataMarker  ZK_M_DATAPULSE op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: call :: callProc <procedureCall> ;

: callProc_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "callProc_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
