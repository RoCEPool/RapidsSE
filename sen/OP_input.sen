/*============================================================================*/
/* OP_input.sen -- Operator input                                             */
/*============================================================================*/

" OP_input.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: input_StartMarker \handler

  op[] job[] job.input!
  
  ZK_STARTMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: input_DataPulse \handler

  PipeIn[].pipeToJob
  
  begin
  
    begin op.outboundOperand@ not while 100 thread::sleepUsec repeat

    op.outboundOperand@ to Operand[]
      nullptr op.outboundOperand!
    
    Operand[].kind ZK_EOSMARKER !=
  while
      Operand[].pipeOut
  repeat
  
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PULSEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: input_PulsedMarker \handler

  PipeIn[].pipeToJob

  true
;

/*----------------------------------------------------------------------------*/
/* execute for input request                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
: input_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: input_StartMarker  ZK_STARTMARKER  op[].handler!
  find: input_DataPulse    ZK_DATAPULSE    op[].handler!
  //find: input_PulsedMarker ZK_PULSEDMARKER op[].handler!
  
  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: input :: input ;

: input _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
