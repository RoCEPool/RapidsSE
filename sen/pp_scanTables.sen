"  start::defProc_ScanTables" .verbose

: start::defProc_ScanTables

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // scan tables
  
  STD_PATH_TAG
  "
  procedure scanTables
  begin

  stage stageA on origin :
    start | pulse once | metaScan tables | rowToList | output | sink | stageA

  end ;
  "
  api::addProcedure

  // scanTables ;
 ;


