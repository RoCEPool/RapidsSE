/*============================================================================*/
/* OP_pulse.sen -- Operator pulse                                             */
/*============================================================================*/

" OP_pulse.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_TRIGGER ...                                               */
/*----------------------------------------------------------------------------*/
: pulse_Trigger \handler

  //"Operand:- ZK_M_TRIGGER" .verbose
  PipeIn[].delete

  // pipe out a datapulse
  Marker[].newDataPulse
  Marker[].pipeOut

 Counter1[] if
  begin
    begin
       Counter1[]  Counter0[] >
    while
      Task[].yield 
      assert::stack_0
      "sleeping for 1 min" .
      60 task::sleepSsec
      Counter0[] 1 + to Counter0[]
    repeat
    0 to  Counter0[]
     Counter1[] "Sending DATAPULSE after %v mins" str.format .
     Marker[].newDataPulse
     Marker[].pipeOut
     true
    while assert::stack_0 repeat
  then

  Marker[].newEndMarker
  Marker[].pipeOut
  //Op.ackPipelineJob

  true
;

/*----------------------------------------------------------------------------*/
/* execute for pulse request                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : pulse_op \operator
 
  _lu_initialise_

  0 locals| hours   |
  0 locals| minutes |

  "<minutes>" job::tagSet@ tagSet.hasName if
    <minutes> >int to minutes
  then

  "<hours>" job::tagSet@ tagSet.hasName if
    <hours> >int to hours
  then

  hours if
    hours 60 * to minutes
  then

  // elapsed
  0 to Counter0[]

  // minutes
  minutes to Counter1[]

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  op__topology

  find: pulse_Trigger   ZK_M_TRIGGER   op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: pulse :: pulse once ;
cmdSyntax: pulse :: pulse min <minutes> ;
cmdSyntax: pulse :: pulse hour <hours> ;

: pulse_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
