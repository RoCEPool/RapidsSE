/*============================================================================*/
/* OP_sysReport.sen -- Operator sys report                                    */
/*============================================================================*/

" OP_sysReport.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: sysReport_action

  //"__eventDemon" find dup if
  //  word.object@ locals| pEventDemon |

  AM::DEMON::tEventDemonJobId@ locals| tEventDemonJobId |
    tEventDemonJobId jobId::isUnknown if
    "Cant find __eventDemon" .
    true
    exit
  then


  Tub[].new


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // sys metrics
  
  Tub[] sysReport::sysMetrics

  tEventDemonJobId Tub[].pipeToJob
  

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // sys locks
  
  Tub[] sysReport::sysLocks

  tEventDemonJobId Tub[].pipeToJob


  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  Tub[].delete

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: sysReport :: sysReport ;

: sysReport_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <params>  = 0

    <opEntry> = "sysReport_op"
}
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
