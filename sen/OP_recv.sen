/*============================================================================*/
/* OP_recv.sen -- Operator recv                                               */
/*============================================================================*/

" OP_recv.sen" .verbose

/*----------------------------------------------------------------------------*/
/* recv init                                                                  */
/*----------------------------------------------------------------------------*/
: recv_init ( -- )

  //CN_JOB Task[] task.thread thread.dedicated!

  NS_ACTIVE grid::thisNode@ grid::findNodeByNo node.state!

  args.verbose if
    grid::thisNode@ "receiver running on node %v" .printf
  then
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  "<ansNode>" job::tagSet@ tagSet.hasName assert

  <ansNode> >int >ptr node.recvSocket@ to Socket[]
;

/*----------------------------------------------------------------------------*/
/* recv next object(s)                                                        */
/*----------------------------------------------------------------------------*/
: recv_recvNext
  
  nullptr to recvdObject[]

  Socket[].recvObject
  
  Socket[].success@ not if
    exit
  then
  
  Socket[].object@\clear to recvdObject[]

  Socket[].success@
;

/*----------------------------------------------------------------------------*/
/* recv loop: receive a job (possibly with operand), dispatch it              */
/*----------------------------------------------------------------------------*/
: recv_dispatch ( -- )

  // null object (low memory)
  recvdObject[].isNull if
    exit
  then
    
  recvdObject[] recvdObject[] object.postRecvWord@ execute
;

/*----------------------------------------------------------------------------*/
/* receiver loop: receive a job (possibly with operand), dispatch it          */
/*----------------------------------------------------------------------------*/
: recv_loop ( -- )

  begin

    trap::stackDepthZero

    // receive next object(s)
    recv_recvNext
    not if
      exit
    then
        
    recv_dispatch

  again
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: recv_StartMarker \handler

  "Receiver Demon Started" .boot

  // initialise
  recv_init

  // loop, receiving and executing jobs
  recv_loop

  HAZARD
;

/*----------------------------------------------------------------------------*/
/* execute for receiver req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : recv_req \operator
 
  _lu_initialise_

  op__topology

  find: recv_StartMarker ZK_M_START op[].handler!

  // get the pipeline job of the operator
  Op.pipelineJob@ locals| pPipelineJob |

  // peek to see if any operand
  begin
    Pipein[].peek
  not while
    "receiver waiting for STARTMARKER..." .verbose
    2 thread::sleepMsec
  repeat

  assert::stack_0

  // pop operand from queue into PipeIn[]
  PipeIn[].peek assert
  PipeIn[].next

  // execute the operator's handler for the operand
  PipeIn[].kind op[].handler@ execute

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: recv :: recv ;

: recv_cmdTags _cmdTags tagCopy: op_tags

  tags{ <dedicatedThd> = 1 }

;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
