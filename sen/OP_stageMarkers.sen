/*============================================================================*/
/* OP_stageMarkers.sen -- Stage Marker Op (SQL Compiler)                      */
/*============================================================================*/

" OP_stageMarkers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: stageMarkers_CancelMarker \handler

  ZK_CANCELMARKER_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CLEANUPMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: stageMarkers_CleanupMarker \handler

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: stageMarkers_PlanOperand \handler

  PipeIn[]\clear to Operand[]

  // create the command error info set
  op__cmdErrInfoSet

  Operand[] nullptr to Operand[] sqlCompiler::stageMarkers to Operand[]

   "stageMarkers" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: stageMarkers_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_ExitEarlyMarker  ZK_EXITEARLYMARKER op[].handler!
  find: compiler_StreamSet        ZK_STREAMSET       op[].handler!

  // specific handlers
  find: stageMarkers_CancelMarker  ZK_CANCELMARKER  op[].handler!
  find: stageMarkers_CleanupMarker ZK_CLEANUPMARKER op[].handler!
  find: stageMarkers_PlanOperand   ZK_PLANOPERAND   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: stageMarkers :: stageMarkers ;

: stageMarkers_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
