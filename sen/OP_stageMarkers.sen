/*============================================================================*/
/* OP_stageMarkers.sen -- Stage Marker Op (SQL Compiler)                      */
/*============================================================================*/

" OP_stageMarkers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: stageMarkers_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: stageMarkers_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCmdErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::stageMarkers to PlanOperand[]

  "stageMarkers" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: stageMarkers_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker      EV_M_LEAVE          [op].handler!
  find: compiler_StreamSet        EV_D_STREAMSET      [op].handler!

  // specific handlers
  find: stageMarkers_Cleaning      EV_M_CLEANING      [op].handler!
  find: stageMarkers_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: stageMarkers :: stageMarkers ;

: stageMarkers_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "stageMarkers_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
