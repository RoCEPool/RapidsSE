/*============================================================================*/
/* OP_stageMarkers.sen -- Stage Marker Op (SQL Compiler)                      */
/*============================================================================*/

" OP_stageMarkers.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: stageMarkers_Cleaning \handler

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: stageMarkers_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__cmdErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::stageMarkers to PlanOperand[]

  "stageMarkers" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: stageMarkers_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker      ZK_M_LEAVE          op[].handler!
  find: compiler_StreamSet        ZK_D_STREAMSET      op[].handler!

  // specific handlers
  find: stageMarkers_Cleaning      ZK_M_CLEANING      op[].handler!
  find: stageMarkers_PlanOperand   ZK_D_PLANOPERAND   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: stageMarkers :: stageMarkers ;

: stageMarkers_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
