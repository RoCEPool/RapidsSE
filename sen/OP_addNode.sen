/*============================================================================*/
/* OP_addNode.sen -- Operator Add Node                                        */
/*============================================================================*/

" OP_addNode.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: addNode_DataPulse \handler
 
  "addNode_DataPulse" .

  <portNo> >int <ipAddr> <nodeNm> node::new locals| pNewNode |
   
  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* execute for add node                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : addNode_req \operator
 
  _lu_initialise_

  <nodeNm> .
  <ipAddr> .
  <portNo> .

  op__topology

  find: addNode_DataPulse ZK_M_DATAPULSE op[].handler!

  op__loop

  _lu_finalise_
  
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: addNode :: addNode <nodeNm> <ipAddr> <portNo> ;

: addNode_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
