/*============================================================================*/
/* OP_scanRight.sen -- Operator scanRight                                     */
/*============================================================================*/

" OP_scanRight.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELLINGMARKER ...                                        */
/*----------------------------------------------------------------------------*/
: ScanRight_CancellingMarker \handler

  Pipein[]\clear to Marker[]

  "Scan_CancellingMarker DRAINING PIPEIN" .
  PipeIn[].drain

  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: scanRight_Cleaning \handler

  // drop the tablePtn lock if held
  counter0[] true == if
    TablePtn[].dropRead
    false to counter0[]
  then

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                             */
/*----------------------------------------------------------------------------*/
// ": scanRight_DataPulse" .

: scanRight_DataPulse \handler

  debug::flag@ if "(Revised) scanRight_DataMarker handler" . then

  // pipe out the pulse marker
  PipeIn[].pipeOut

  // grab table ptn read lock
  TablePtn[].grabRead_yieldLoop

  // set counter0 to true to indicate lock held
  true to counter0[]

  // new a partition stream for access crw buffer
  TablePtn[] ptnStream::new to ptnStream[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
// ": scanRight_EosMarker" .

: scanRight_EosMarker \handler

  // send an eos marker
  PipeIn[].pipeout

  // drop table ptn lock
  TablePtn[].dropRead

  // set counter0 to 0 to indicate lock released
  false to counter0[]

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_ROWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
// ": scanRight_LeftCrwRowBuffer" .

: scanRight_LeftCrwRowBuffer \handler

  //"scanRight_LeftCrwRowBuffer " .

  PipeIn[].pipeout

  // send a newRightMarker (there was no data)
  Marker[].newStartCrwRhtMarker
  Marker[].pipeOut

  // open partition stream to access the crw buffers
  ptnStream[] ptnStream.open if

   // pipe in ZK_M_NEXTBUFFER
   Marker[].newNextBufferMarker
   Marker[].pipeBackIn

    // force op loop to call scanRight_CrwBuffer to start processing buffers
    //"scanRight_RightCrwBuffer" word::find LogicUnit[].handler!
    //true LogicUnit[].callAgain!

  else

    // unable to open partition stream (this would be unusual)

    // delete partition stream
    ptnStream[] ptnStream.delete
    nullptr to ptnStream[]

    // drop table ptn lock
    TablePtn[].dropRead

    // set counter0 to 0 to indicate lock released
    false to counter0[]

    // send an EndRightMarker (there was no data)
    Marker[].newEndCrwRhtMarker
    Marker[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_NEXTBUFFER...                                             */
/*----------------------------------------------------------------------------*/
// ": scanRight_NextBuffer" .

: scanRight_NextBuffer \handler

  debug::flag@ if "(Revised) scanRight_NextBuffer handler" . then

  // read next buffer from ptn stream
  ptnStream[] ptnStream.read to CrwBuffer[]

  CrwBuffer[].isNotNull if
    // read a next crw buffer

    // pipe out the read crw buffer
    CrwBuffer[].pipeOut

    // requeue ZK_M_NEXTBUFFER
    Pipein[].pipeBackin

    // call this handler again to process next buffer
    //true LogicUnit[].callAgain!

  else
    // no more crw buffers
    Pipein[].delete

    // close and delete partition stream
    ptnStream[] ptnStream.close

    // send an EndRightMarker
    Marker[].newEndCrwRhtMarker
    Marker[].pipeOut

  then

  true
  ;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ... (of right table)                            */
/*----------------------------------------------------------------------------*/
// ": scanRight_RightCrwBuffer" .

: scanRight_RightCrwBuffer \handler

  debug::flag@ if "(Revised) scanRight_RightCrwBuffer handler" . then

  // read next buffer from ptn stream
  ptnStream[] ptnStream.read to CrwBuffer[]

  CrwBuffer[].isNotNull if
    // read a next crw buffer

    // pipe out the read crw buffer
    CrwBuffer[].pipeOut

    // pipe in ZK_M_NEXTBUFFER
    Marker[].newNextBufferMarker
    Marker[].pipeBackIn

    // call this handler again to process next buffer
    //true LogicUnit[].callAgain!

  else
    // no more crw buffers

    // close the partition stream
    ptnStream[] ptnStream.close

    // send an eachScanEosMarker
    Marker[].newEndCrwRhtMarker
    Marker[].pipeout
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // check for rate metering

  0 locals| rateSecs |

  "<rateSecs>" job::tagSet@ tagSet.hasName if
    <rateSecs> >int to rateSecs
  then

  rateSecs if
    rateSecs "Scan Pausing for %v secs" str.format .
    rateSecs task::sleepSsec
    "Scan awake" .
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
// ": scanRight_StartMarker" .

: scanRight_StartMarker \handler

  PipeIn[].pipeOut

  <tableNm> op__table if
    Table[].tablePtn@ to TablePtn[]
  then

  //args.developer if
  //  1 debug::flag!
  //then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_STREAMDEF ...                                             */
/*----------------------------------------------------------------------------*/
// ": scanRight_StreamDef" .

: scanRight_StreamDef \handler

  //"piping out left streamDef" .
  PipeIn[]\clear to StreamDefLft[]
  StreamDefLft[].pipeOut

  // now pipe out the stream def for the right table
  //"piping out right streamDef" .
  // pipeout a streamDefRht marker first
  Marker[].newStreamDefRht
  Marker[].pipeout

  // pipeout the rht streamDef
  Table[] StreamDefOut[].newFromTable
  StreamDefOut[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* scan request                                       (on node where spawned) */
/*----------------------------------------------------------------------------*/
: scanRight_req \operator

  _lu_initialise_

  "<catalogNm>"  job::tagSet@ tagSet.hasName if
    <schemaNm> <catalogNm>
    "/tenants/boray/catalogs/%v/schemas/%v/tables" str.format
    str.toStrVec Path[].set
  then

  op__topology

  find: scanRight_CancellingMarker ZK_M_CANCELLING op[].handler!
  find: scanRight_Cleaning         ZK_M_CLEANING   op[].handler!
  find: scanRight_DataPulse        ZK_M_DATAPULSE  op[].handler!
  find: scanRight_EosMarker        ZK_M_EOS        op[].handler!
  find: scanRight_LeftCrwRowBuffer ZK_D_CRWBUFFER  op[].handler!
  find: scanRight_LeftCrwRowBuffer ZK_D_ROWBUFFER  op[].handler!
  find: scanRight_NextBuffer       ZK_M_NEXTBUFFER op[].handler!
  find: scanRight_StartMarker      ZK_M_START      op[].handler!
  find: scanRight_StreamDef        ZK_D_STREAMDEF  op[].handler!

  op__loop

  _lu_finalise_
  
  _op_retires_
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: scanRight :: scanRight <tableNm> ;
cmdSyntax: scanRight :: scanRight <catalogNm> <schemaNm> <tableNm> ;
cmdSyntax: scanRight :: scanRight <tableNm> <rateSecs> ;
cmdSyntax: scanRight :: scanRight <catalogNm> <schemaNm> <tableNm> <rateSecs> ;

: scanRight_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
