/*============================================================================*/
/* OP_project.sen -- Operator project columns                                 */
/*============================================================================*/

" OP_project.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on ZK_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: project_Cleaning \handler

  0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryNote

  // Need to hold on to the streamDef's till the combined op
  // has created the stencil

  // will be null if table not found
  StreamDefLft[].isNull not if
    StreamDefLft[].delete
  then

  StreamDefOut[].isNull not if
    StreamDefOut[].delete
  then

  ZK_M_CLEANING EG_ZK PD_PIPE_OUT 0 ZK_M_CLEANING EG_ZK LogicUnit[].diaryAction

  ZK_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: project_StreamDef \handler

  0 ZK_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  EC_NONE locals| eError |

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // generate streamDefOut from expr and streamDefIn
  <expr> nullptr StreamDefLft[] StreamDefOut[].generate to eError

  // check for error
  eError EC_NONE == not if
    eError op__execErr
    true
    exit
  then

  StreamDefOut[].duplicate to Pipein[]
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* project request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: project_op \operator

  _lu_initialise_

  op__topology

  // handle combined operator
  find: project_Cleaning  ZK_M_CLEANING      [op].handler!
  find: project_StreamDef ZK_D_STREAMDEF     [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: project :: project <expr> ;

: project_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "project_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
