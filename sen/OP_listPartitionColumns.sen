/*============================================================================*/
/* OP_listPartitionColumns.sen -- Operator list partition columns             */
/*============================================================================*/

" OP_listPartitionColumns.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: lsptncol_action

  0 locals| nPtnCols |

  // find the table
  <tableNm> op__table not if
    false
    exit
  then

  // find the table
  <streamDef> op__tableDef assert

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_DATA TableDef[] Pds[].new

  // get the ptn stream def from the table
  Table[].ptnDef@ to PtnDef[]
  PtnDef[].columnCount@ to nPtnCols

  // insert a row in the Pds for each column
  nPtnCols 0 do
    I PtnDef[].column@ TableDef[]
    Pds[].addColumnDef not if
      Pds[].pipeOut
      BT_DATA TableDef[] Pds[].new
      I PtnDef[].column@ TableDef[]
      Pds[].addColumnDef assert
    then
  loop
  
  nullptr to PtnDef[]

  // pipeout the Pds
  Pds[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: lsptncol :: lsptncol <tableNm> ;

: lsptncol_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <streamDef>   = __listColumns
    <params>      = 1

    <opEntry> = "lsptncol_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/

