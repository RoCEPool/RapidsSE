/*============================================================================*/
/* pp_TPCH.sen -- define TPCH related procedures                              */
/*============================================================================*/

" pp_TPCH.sen" .verbose


/*----------------------------------------------------------------------------*/
/* TPC-H related procedures                                                   */
/*----------------------------------------------------------------------------*/

"  start::defProc_TPCH" .verbose

: start::defProc_TPCH

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 1 - iterating index on l_shipdate
  
  STD_PATH_TAG
  "
  procedure Query1
    parameters $Table
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan $Table
    | sql 100 1
    //| sql 101
    | stageC

  stage stageC on origin :
    sql 103 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 1 - iterating index on l_shipdate
  
  STD_PATH_TAG
  "
  procedure Query1_I
    parameters $Table
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    scan $Table
    | sql 100 0
    //| sql 101
    | stageC

  stage stageC on origin :
    sql 103 0
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 6 - converting loaded CRW data into ROW
  
  STD_PATH_TAG
  "
  procedure Query6
    parameters $Table $Index
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 600 1 $Table $Index
    | stageC

  stage stageC on origin :
    sql 601 1
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Query 6 - converting loaded CRW data into ROW
  
  STD_PATH_TAG
  "
  procedure Query6_I
    parameters $Table $Index
  begin

  stage stageA on origin :
    start
    | pulse once
    | stageB

  stage stageB on all partitions :
    sql 600 0 $Table $Index
    | stageC

  stage stageC on origin :
    sql 601 0
    | output
    //| toStatDemon
    | sink
    | stageA

  end ;
  "
  api::addProcedure
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
