/*============================================================================*/
/* OP_report.sen -- Operator report                                           */
/*============================================================================*/

" OP_report.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_D_BFRBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: report_BfrBuffer \handler
/*
  //"Operand:- EV_D_BFRBUFFER" .verbose
  PipeIn[]\clear to BfrBuffer[]

  BfrBuffer[].isReport if
    BfrBuffer[].writeToFile0
  else
    BfrBuffer[].pipeOut
  then
*/
  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CRWBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: report_CrwBuffer \handler

  //"Operand:- EV_D_CRWBUFFER" .verbose
  PipeIn[]\clear to CrwBuffer[]

  CrwBuffer[].isReport if
    CrwBuffer[].writeToFile0
  else
    CrwBuffer[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_CSVBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: report_CsvBuffer \handler

  //"Operand:- EV_D_CSVBUFFER" .verbose
  PipeIn[]\clear to CsvBuffer[]

  CsvBuffer[].isReport if
    CsvBuffer[].writeToFile0
  else
    CsvBuffer[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: report_EosMarker \handler

  //"Operand:- EV_M_EOS" .verbose
  //File0[].get file.close
  //File0[].get file.delete
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: report_StartMarker \handler

  //"Operand:- EV_M_START" .verbose

  PipeIn[].pipeOut

  // open the file for writing
  <fileNm> OPEN_WRITE op__file discard

  true
;

/*----------------------------------------------------------------------------*/
/* execute for report request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: report_op \operator

  _lu_initialise_

  op__topology

  find: report_BfrBuffer   EV_D_BFRBUFFER   [op].handler!
  find: report_CrwBuffer   EV_D_CRWBUFFER   [op].handler!
  find: report_CsvBuffer   EV_D_CSVBUFFER   [op].handler!
  find: report_EosMarker   EV_M_EOS   [op].handler!
  find: report_StartMarker EV_M_START [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: report :: report <fileNm> ;

: report_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "report_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
