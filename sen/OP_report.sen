/*============================================================================*/
/* OP_report.sen -- Operator report                                           */
/*============================================================================*/

" OP_report.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CRWBUFFER ...                                               */
/*----------------------------------------------------------------------------*/
: report_CrwBuffer \handler

  //"Operand:- ZK_D_CRWBUFFER" .verbose
  PipeIn[]\clear to CrwBuffer[]

  CrwBuffer[].isReport if
    CrwBuffer[].writeToFile0
  else
    CrwBuffer[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_CSVBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: report_CsvBuffer \handler

  //"Operand:- ZK_D_CSVBUFFER" .verbose
  PipeIn[]\clear to CsvBuffer[]

  CsvBuffer[].isReport if
    CsvBuffer[].writeToFile0
  else
    CsvBuffer[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_ENTBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: report_EntBuffer \handler

  //"Operand:- ZK_D_ENTBUFFER" .verbose
  /*
  PipeIn[] to Operand[]
  nullptr to Operand[]

  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then
  */
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EOS ...                                                   */
/*----------------------------------------------------------------------------*/
: report_EosMarker \handler

  //"Operand:- ZK_M_EOS" .verbose
  //File0[].get file.close
  //File0[].get file.delete
  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_SRTBUFFER ...                                             */
/*----------------------------------------------------------------------------*/
: report_SrtBuffer \handler

/*
  //"Operand:- ZK_D_SRTBUFFER" .verbose
  PipeIn[] to Operand[]
  nullptr to Operand[]

  Operand[].isReport if
    Operand[].writeToFile0
  else
    Operand[].pipeOut
  then
*/
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_START ...                                                 */
/*----------------------------------------------------------------------------*/
: report_StartMarker \handler

  //"Operand:- ZK_M_START" .verbose

  PipeIn[].pipeOut

  // open the file for writing
  <fileNm> OPEN_WRITE op__file discard

  true
;

/*----------------------------------------------------------------------------*/
/* execute for report request                         (on node where spawned) */
/*----------------------------------------------------------------------------*/
: report::geb \operator

  _lu_initialise_

  op__topology

  find: report_CrwBuffer   ZK_D_CRWBUFFER   op[].handler!
  find: report_CsvBuffer   ZK_D_CSVBUFFER   op[].handler!
  find: report_EntBuffer   ZK_D_ENTBUFFER   op[].handler!
  find: report_EosMarker   ZK_M_EOS   op[].handler!
  find: report_SrtBuffer   ZK_D_SRTBUFFER   op[].handler!
  find: report_StartMarker ZK_M_START op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/
cmdSyntax: report :: report <fileNm> ;

: report_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
