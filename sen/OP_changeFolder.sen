/*============================================================================*/
/* OP_changeFolder.sen -- Operator change flolder                             */
/*============================================================================*/

" OP_changeFolder.sen" .verbose

/*----------------------------------------------------------------------------*/
/* action                                                                     */
/*----------------------------------------------------------------------------*/
: cf_action

  0 0 locals| pCurrentFolder sFolderNm |

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  // get the folderNm from the the tag
  <folderNm> to sFolderNm

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a ".." which will go up one folder

  // pop up one folder, but not into tenants
  sFolderNm ".." str.same if
    Folder[] dic.name@ "tenants" str.same not if Path[].popFolder then
    setPath
    true
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a "~" will pop folder path till it reaches /tenants

  // pop up to tenants
  sFolderNm "~" str.same if
    begin Folder[] dic.name@ "tenants" str.same not while Path[].popFolder repeat
    setPath
    true
    exit                                                         // *EARLY EXIT*
  then

  // set default catalogs
  sFolderNm "~catalogs" str.same if
    setCatalogs
    true
    exit                                                         // *EARLY EXIT*
  then

  // set default schemas
  sFolderNm "~schemas" str.same if
    setSchemas
    true
    exit                                                         // *EARLY EXIT*
  then

  // set default tables
  sFolderNm "~tables" str.same if
    setTables
    true
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // test for a "tenants" will clear folder path and set to /tenants

  // clear dic path and push tenants
  sFolderNm "tenants" str.same if
    Path[].popAllFolders
    attachmap::tenants@ execute Path[].pushFolder
    setPath
    true
    exit                                                         // *EARLY EXIT*
  then

  // -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- --
  // otherwise we expect a name of a sub-folder to which we push path to
  //  push sub-folder

  sFolderNm Folder[].findSymbol to pCurrentFolder

  pCurrentFolder word.checkIsAFolder not if
    op__execErr
    true
    exit
  then

  pCurrentFolder execute Path[].pushFolder
  setPath

  true
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: cf :: cf <folderNm> ;

: cf_cmdTags _cmdTags tagCopy: localLiteOp_tags
  tags{
    <cmdDesc>     = "--desc for op--"
    <params>      = 1
    
    <opEntry> = "cf_op"  <seedReq> = "cf_req"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
