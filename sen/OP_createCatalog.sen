/*============================================================================*/
/* OP_createCatalog.sen -- Operator create catalog                            */
/*============================================================================*/

" OP_createCatalog.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: createCatalog_DataMarker

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if we have enough buffers
  node::checkEnoughBuffers not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if are in catalogs
  folder[].checkIsCatalogs not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // check if catalog already exits
  <catalogNm> name::isNotKnownCatalog not if
    op.pipelineJob@ ERROR_JOB
    PipeIn[].delete
    Operand[].newErrorMarker
    Operand[].pipeOut
    true
    exit
  then

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // make the catalog
  <catalogNm> :makeCatalogFolder ( )

  PipeIn[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for createCatalog req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
: createCatalog_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: createCatalog_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: createCatalog :: createCatalog <catalogNm> ;

: createCatalog _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>   = "--desc for op--" }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
