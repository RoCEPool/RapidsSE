"
procedure getBucketA
  parameters $TableNm
begin

  // roundrobin or hashcast node (probably round-robin),
  // then ask for the bucket given the number
  stage stageA on origin :
    start | periodic once | bucketGet $TableNm | stageB hashcast

  // send the crwBuffer of the bucket table
  stage stageB on all nodes :
     bucketSend $TableNm | bucketRecv | stageC

  //bucketSend  | stageC
  //scan $Table   |        crwToRow      | stageC


  stage stageC on origin :
     noop | sink | stageA
   //bucketRecv  | sink | stageA


  // toHshCrw
  // send the crwBuffer of the bucket table
  //stage stageB on all nodes :
  //  bucketSend | stageC

  // receive crwBuffer, then the bucketRecv would insert into the table
  // insert $table
  //stage stageC on origin :
  //  bucketRecv | output | sink | stageA

end ;
"
procedure::add






