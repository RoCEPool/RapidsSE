/*============================================================================*/
/* OP_dynamic.sen -- Operator Dynamic                                         */
/*============================================================================*/

" OP_dynamic.sen" .verbose


/*----------------------------------------------------------------------------*/
/* on ZK_M_STARTMARKER ...                                                    */
/*----------------------------------------------------------------------------*/
: dynamic_StartMarker \handler

  "dynamic_StartMarker" .

  "iDynFun"
    "int iDynFun(void*) { printf(\"Hello World!\n\"); }"
  
  . discard


  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for dynamic req                                                    */
/*----------------------------------------------------------------------------*/
 : dynamic_op \operator

  _lu_initialise_

  op__topology

  find: dynamic_StartMarker  ZK_M_START  op[].handler!
  
  op__loop

  _lu_finalise_

  op__retires

  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: dynamic :: dynamic ;

: dynamic_cmdTags _cmdTags tagCopy: Op_tags
  tags{
    <cmdDesc> = "--desc for op--"
 
    <opEntry> = "dynamic_op"
  }
;
    
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
