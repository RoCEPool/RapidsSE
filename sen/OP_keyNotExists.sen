/*============================================================================*/
/* OP_KeyNotExists.sen -- Operator key exits                                     */
/*============================================================================*/

" OP_KeyNotExists.sen" .verbose

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* on EV_M_CLEANING ...                                                   END */
/*----------------------------------------------------------------------------*/
: KeyNotExists_Cleaning \handler

  0 EV_M_CLEANING EG_ZK LogicUnit[].diaryNote

  EV_M_CLEANING EG_ZK PD_PIPE_OUT 0 EV_M_CLEANING EG_ZK LogicUnit[].diaryAction

  EV_M_CLEANING_handler
;


/*----------------------------------------------------------------------------*/
/* on EV_M_START ...                                                     INIT */
/*----------------------------------------------------------------------------*/
: KeyNotExists_Start \handler

  0 EV_M_START EG_ZK LogicUnit[].diaryNote

  <tableNm> <indexNm> op__table_index not if
    Pipein[].delete
    true
    exit
  then

  EV_M_START_handler
;

/*----------------------------------------------------------------------------*/
/* on EV_D_STREAMDEF ...                                            STREAMDEF */
/*----------------------------------------------------------------------------*/
: KeyNotExists_StreamDef \handler

  EC_NONE locals| eError |

  0 EV_D_STREAMDEF EG_ZK LogicUnit[].diaryNote

  // move pipein[] to StreamDefLft[]
  Pipein[]\clear to StreamDefLft[]

  // new a streamDefRht from the right table
  Table[] StreamDefRht[].newFromTable

  // generate selectColumns bitmap from filter expr and streamDefRht
  <keyExpr> StreamDefLft[].selectColumns to eError

  // check for error
    eError EC_NONE == not if
      eError op__execErr
      true
      exit
    then

  <expr> nullptr StreamDefRht[] StreamDefOut[].generate to eError

  // check for error
  eError EC_NONE == not if
    StreamDefOut[].delete
    eError op__execErr
    true
    exit
  then

  // delete the streamDefOut[]. Not needed for filter
  StreamDefOut[].delete

  // evaluate the expression
  StreamDefLft[].duplicate to StreamDefOut[]

  StreamDefLft[].duplicate to Pipein[]

  // pipe out the streamDef
  Pipein[].pipeout

  true
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* filter request                                                       SPAWN */
/*----------------------------------------------------------------------------*/
: KeyNotExists_op \operator

  _lu_initialise_

  op__topology

  find: KeyNotExists_Cleaning    EV_M_CLEANING   [op].handler!
  find: KeyNotExists_Start       EV_M_START      [op].handler!
  find: KeyNotExists_StreamDef   EV_D_STREAMDEF  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: top :: KeyNotExists <tableNm> <indexNm> <keyExpr> <expr> ;

: KeyNotExists_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "KeyNotExists_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
