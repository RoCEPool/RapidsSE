/*============================================================================*/
/* OP_bufferGen.sen -- Operator bufferGen                                     */
/*============================================================================*/

" OP_bufferGen.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: BufferGen_DataPulse \handler

  "Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  <nBuffers> 0 do
    I "buffer# %v" .printf

    // check for low memory
    attachMap::isLowMemory if
      EC_LOW_MEMORY op__execErr
      true
      exit
    then

    csvBuffer::new to CrwBuffer[]
    CrwBuffer[].pipeOut
  loop

  Marker[].newEosMarker
  Marker[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* BufferGen request                                  (on node where spawned) */
/*----------------------------------------------------------------------------*/
: BufferGen_op \operator

  _lu_initialise_

  <nBuffers> "Number of buffers: %v" .printf

  op__topology

  find: BufferGen_DataPulse ZK_M_DATAPULSE op[].handler!

  op__loop

  "*** BufferGen EXITS" .
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: bufferGen :: bufferGen <nBuffers> ;

: bufferGen_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
