/*============================================================================*/
/* OP_totalCount.sen -- Operator total count                                  */
/*============================================================================*/

" OP_totalCount.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on ZK_D_STREAMSET...                                                         */
/*----------------------------------------------------------------------------*/
: totalCount_DataMarker \handler

  //"Operand:- ZK_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // find the C_TABLEDEF_COUNT
  C_TDEF_COUNTINFO op__tableDef_streamSet assert

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_INFOSET...                                                           */
/*----------------------------------------------------------------------------*/
: totalCount_CountInfo \handler

  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  // get first row of InfoSet[]
  InfoSet[].firstRow to infoSetRow[]

  // get 0th Column (rowCount) add to Counter
  0 infoSetRow[].getIntColumn Counter0[] + to Counter0[]

  // now delete the InfoSet[]
  InfoSet[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on ZK_M_EOS...                                                         */
/*----------------------------------------------------------------------------*/
: totalCount_EosMarker \handler

  //"Operand:- ZK_M_EOS" .verbose
  PipeIn[].pipeOut

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an infoSet operand
  streamSetTable[] streamSet[].new

  // insert row count into streamSet
  Counter0[] streamSetTable[] StreamSet[].addRowCount assert

  StreamSet[].Pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : totalCount_op \operator
 
  _lu_initialise_

  0 to Counter0[]

  op__topology

  find: totalCount_EosMarker   ZK_M_EOS   [op].handler!
  find: totalCount_DataMarker ZK_M_DATAPULSE [op].handler!
  find: totalCount_countInfo   ZK_I_COUNTINFO   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: totalCount :: totalCount ;

: totalCount_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "totalCount_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
