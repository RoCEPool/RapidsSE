/*============================================================================*/
/* OP_totalCount.sen -- Operator total count                                  */
/*============================================================================*/

" OP_totalCount.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE...                                                       */
/*----------------------------------------------------------------------------*/
: totalCount_DataMarker \handler

  //"Operand:- EV_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // find the C_TABLEDEF_COUNT
  C_TDEF_COUNT op__tableDef assert

  // don't create or pipeout a streamDef, we'll do that when we send the result

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_D_PDSROWBUFFER...                                                    */
/*----------------------------------------------------------------------------*/
: totalCount_PdsRowBuffer \handler

  // get the Pds
  PipeIn[]\clear to Pds[]

  // pipeout buffers other than BT_COUNT
  Pds[].bufferType@ BT_COUNT != if
    Pds[].pipeout
    true
    exit
  then

  // get first row of Pds[]
  Pds[].firstRow to Row[]

  // get 0th Column (rowCount) add to Counter
  0 Row[].getIntColumn Counter0[] + to Counter0[]

  // now delete the Pds
  Pds[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS...                                                             */
/*----------------------------------------------------------------------------*/
: totalCount_EosMarker \handler

  //"Operand:- EV_M_EOS" .verbose
  PipeIn[].pipeOut

  // create a new streamDef
  TableDef[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create a Pds operand
  BT_COUNT TableDef[] Pds[].new

  // insert row count into Pds
  Counter0[] 1 Pds[].addRowVargs assert

  Pds[].Pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : totalCount_op \operator
 
  _lu_initialise_

  0 to Counter0[]

  op__topology

  find: totalCount_EosMarker   EV_M_EOS        [op].handler!
  find: totalCount_DataMarker  EV_M_DATAPULSE  [op].handler!
  find: totalCount_PdsRowBuffer   EV_D_PDSROWBUFFER  [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: totalCount :: totalCount ;

: totalCount_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "totalCount_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
