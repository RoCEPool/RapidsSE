/*============================================================================*/
/* OP_totalCount.sen -- Operator total count                                  */
/*============================================================================*/

" OP_totalCount.sen" .verbose

/*----------------------------------------------------------------------------*/
/* on EV_M_DATAPULSE...                                                       */
/*----------------------------------------------------------------------------*/
: totalCount_DataMarker \handler

  //"Operand:- EV_M_DATAPULSE" .verbose
  PipeIn[].pipeOut

  // find the C_TABLEDEF_COUNT
  C_TDEF_COUNT op__tableDef_streamSet assert

  // don't create or pipeout a streamDef, we'll do that when we send the result

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_I_COUNT...                                                           */
/*----------------------------------------------------------------------------*/
: totalCount_CountInfo \handler

  PipeIn[] to InfoSet[]
  nullptr to PipeIn[]

  // get first row of InfoSet[]
  InfoSet[].firstRow to infoSetRow[]

  // get 0th Column (rowCount) add to Counter
  0 infoSetRow[].getIntColumn Counter0[] + to Counter0[]

  // now delete the InfoSet[]
  InfoSet[].delete

  true
;

/*----------------------------------------------------------------------------*/
/* on EV_M_EOS...                                                             */
/*----------------------------------------------------------------------------*/
: totalCount_EosMarker \handler

  //"Operand:- EV_M_EOS" .verbose
  PipeIn[].pipeOut

  // create a new streamDef
  streamSetTable[] StreamDefLft[].new

  // pipeout the streamDef
  StreamDefLft[].pipeOut

  // create an rowBuffer operand
  streamSetTable[] RowBuffer[].new

  // insert row count into rowBuffer
  Counter0[] streamSetTable[] RowBuffer[].addTotalCount assert

  RowBuffer[].Pipeout

  true
;

/*----------------------------------------------------------------------------*/
/* execute for progress req                           (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : totalCount_op \operator
 
  _lu_initialise_

  0 to Counter0[]

  op__topology

  find: totalCount_EosMarker   EV_M_EOS        [op].handler!
  find: totalCount_DataMarker  EV_M_DATAPULSE  [op].handler!
  find: totalCount_countInfo   EV_I_COUNT      [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: totalCount :: totalCount ;

: totalCount_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "totalCount_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
