/*============================================================================*/
/* dp_connectorSE.sen -- Connector Demon for SE Adaptor                       */
/*============================================================================*/

" dp_connectorSE.sen" .verbose


/*----------------------------------------------------------------------------*/
/* pipeline/procedure text for connector demon                                */
/*----------------------------------------------------------------------------*/
procText:
  pipelineLocal connectorSE_procText
    tag "<pre_execute>" = "demon::install" endTag
  begin

    stage stageA on origin :
        start
      | connector
      | eatAll
      | stageA

  end
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
