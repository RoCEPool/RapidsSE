/*============================================================================*/
/* cmd_execute.sen -- 1sc: given pipeline is to execute on participant        */
/*============================================================================*/

" cmd_execute.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: execute:onParticipant

  //"execute:onParticipant" .

  [args].distJob if
    "execute" "onParticipant" ">exe sch next" [job].trace
  then

  // find job to be executed in participating job list
  [job].distId@ ListedJob[].findParticipant? if

    // stall till job's previous phase (task) has completed
    begin
      ListedJob[].taskState@ TS_HIBERNATING !=
    while
      // "job to be executed still has non-hibernating task" .
      [task].yield
    repeat
    ListedJob[].cycleTaskLock
    
    // execute the job on this participating node
    ListedJob[].scheduleNextPhase
  
    ListedJob[].returnReference
  then
  
  [job]:retireAndExit
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON ORIGINATING NODE OF GIVEN PIPELINE                      */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on origin node                                                             */
/*----------------------------------------------------------------------------*/
: execute:onOrigin

  //"execute:execute" .

  [args].distJob if
    "execute" "onOrigin" ">exe brd all ptp" [job].trace
  then

  "execute:onParticipant" [job].entryPoint!

  [job]:broadcast

  [job]:retireAndExit
  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: execute :: execute ;

: execute_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "execute:onOrigin"
    <path>        = "/"
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
