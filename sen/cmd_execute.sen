/*============================================================================*/
/* cmd_execute.sen -- 1sc: given pipeline is to execute on participant        */
/*============================================================================*/

" cmd_execute.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on participating node                                                      */
/*----------------------------------------------------------------------------*/
: execute:onParticipant
  //"execute:onParticipant" .

/* >exe ptp */  [args].distJob if
/* >exe ptp */    "execute" "onParticipant"
/* >exe ptp */      ">exe ptp" "sch next phase of ptp"               [job].trace
/* >exe ptp */  then
/* >exe ptp */
/* >exe ptp */  // find job to be executed in participating job list
/* >exe ptp */  [job].distId@ ListedJob[].findParticipant? if
/* >exe ptp */
/* >exe ptp */    // stall till job's previous phase (task) has completed
/* >exe ptp */    begin
/* >exe ptp */      ListedJob[].taskState@ TS_HIBERNATING !=
/* >exe ptp */    while
/* >exe ptp */      // "job to be executed still has non-hibernating task" .
/* >exe ptp */      [task].yield
/* >exe ptp */    repeat
/* >exe ptp */    ListedJob[].cycleTaskLock
/* >exe ptp */
/* >exe ptp */    // execute the job on this participating node
/* >exe ptp */    ListedJob[].scheduleNextPhase
/* >exe ptp */
/* >exe ptp */    ListedJob[].returnReference
/* >exe ptp */  then
/* >exe ptp */
/* >exe ptp */  [job]:retireAndExit
;

////////////////////////////////////////////////////////////////////////////////
/*                 ON ORIGINATING NODE OF GIVEN PIPELINE                      */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* on origin node                                                             */
/*----------------------------------------------------------------------------*/
: execute:onOrigin
  //"execute:execute" .

/* >exe org */  [args].distJob if
/* >exe org */    "execute" "onOrigin" ">exe org"
/* >exe org */      "brd execute to all ptp"                         [job].trace
/* >exe org */  then
/* >exe org */
/* >exe org */  "execute:onParticipant" [job].entryPoint!
/* >exe org */
/* >exe org */  [job]:broadcast
/* >exe org */
/* >exe org */  [job]:retireAndExit
/* >exe org */  HAZARD
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: execute :: execute ;

: execute_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "execute:onOrigin"
    <path>        = "/"
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
