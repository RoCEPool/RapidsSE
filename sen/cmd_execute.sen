/*============================================================================*/
/* cmd_execute.sen -- 1sc: given pipeline is to execute on participant        */
/*============================================================================*/

" cmd_execute.sen" .verbose

////////////////////////////////////////////////////////////////////////////////
/*                 ON PARTICIPATING NODE OF GIVEN PIPELINE                    */
/////////1/////////2/////////3/////////4/////////5/////////6/////////7//////////

/*----------------------------------------------------------------------------*/
/* run received Job_Execute on participating node                             */
/*----------------------------------------------------------------------------*/
: execute:execute

  // "execute:execute" .

  // find job to be executed in participating job list
  [job].parentId@ ListedJob[].findParticipant? discard

  // stall till job's previous phase (task) has completed
  begin
    ListedJob[].task@ task.state@ TS_HIBERNATING !=
  while
    // "job to be executed still has non-hibernating task" .
    [task].yield
  repeat
  ListedJob[].task@ task.cycleLock
    
  // execute the job on this participating node
  ListedJob[] job.scheduleNextPhase
  
  ListedJob[].returnReference
  [job]:retire
;

/*----------------------------------------------------------------------------*/
/***                            - Definition -                              ***/
/*----------------------------------------------------------------------------*/

cmdSyntax: execute :: execute ;

: execute_cmdTags _cmdTags tagCopy: genericJob_tags
  tags{
    <cmdDesc>     = "--desc for job--"
    <entryPoint>  = "execute:execute"
    <path>        = "/"
  }
;


/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
