/*============================================================================*/
/* OP__tpl_lite.sen -- templates for lite op                                    */
/*============================================================================*/

" OP__tpl_lite.sen" .verbose
    
/*----------------------------------------------------------------------------*/
/* on ZK_M_DATAPULSE ...                                                      */
/*----------------------------------------------------------------------------*/
: OP__tpl_lite_DataMarker

"
: /liteOp/_DataMarker \\handler

  PipeIn[].pipeOut

  /liteOp/_action if
    Marker[].newEosMarker
    Marker[].pipeOut
  then

  true
;
"
;

/*----------------------------------------------------------------------------*/
/* execute for liteOp req                             (on node where spawned) */
/*----------------------------------------------------------------------------*/
: OP__tpl_lite_ENTRY

"
: /liteOp/_req \\operator
 
  _lu_initialise_

  op__topology

  find: /liteOp/_DataMarker  ZK_M_DATAPULSE op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;
"
;


/*----------------------------------------------------------------------------*/
/* liteOp procedure with 0 parameters                                         */
/*----------------------------------------------------------------------------*/
: OP__tpl_lite_procedure0

"
  procedure /liteOp/
    tags <lowMemory>
  begin

    stage stageA on origin :
      start | pulse once | stageB

    stage stageB on all nodes :
      /liteOp/ | stageC

    stage stageC on origin :
      output | sink | stageA

  end
"
;
    
/*----------------------------------------------------------------------------*/
/* liteOp procedure with 1 parameter                                          */
/*----------------------------------------------------------------------------*/
: OP__tpl_lite_procedure1

"
  procedure /liteOp/
    tags <lowMemory>
    parameters $param
  begin

  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all nodes :
    /liteOp/ $param | stageC

  stage stageC on origin :
    output | sink | stageA

  end
"
;

/*----------------------------------------------------------------------------*/
/* liteOp procedure with 2 parameters                                         */
/*----------------------------------------------------------------------------*/
: OP__tpl_lite_procedure2

"
  procedure /liteOp/
    tags <lowMemory>
    parameters $param0 $param1
  begin

  stage stageA on origin :
    start | pulse once | stageB

  stage stageB on all nodes :
    /liteOp/ $param0 $param1 | stageC

  stage stageC on origin :
    output | sink | stageA

  end
"
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
