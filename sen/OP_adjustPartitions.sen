/*============================================================================*/
/* OP_adjustPartitions.sen -- Operator Adjust Partitions                      */
/*============================================================================*/

" OP_adjustPartitions.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: adjustPtns_DataPulse \handler
 
  "adjustPtns_DataPulse" .
   
  ptnMap::adjust

  ZK_M_DATAPULSE_handler
;

/*----------------------------------------------------------------------------*/
/* execute for add node                               (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : adjustPtns_req \operator
 
  _lu_initialise_

  op__topology

  find: adjustPtns_DataPulse ZK_M_DATAPULSE op[].handler!

  op__loop
  
  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: adjustPtns :: adjustPtns ;

: adjustPtns_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
