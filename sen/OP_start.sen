/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CANCEL ...                                                */
/*----------------------------------------------------------------------------*/
: start_CancelMarker \handler

  //"Operand:- ZK_M_CANCEL" .verbose
  PipeIn[].delete

  // toggle to default abnormal handlers for all data operands
  "default_abnormalHandlers" FIND execute

  // check if start has already been pulsed
  Pipeline::pulsed@ if
    PipeIn[].delete
  else
    // mark pipeline as being cancelled
    true Pipeline::cancelled!

    Marker[].newCancelling
    Marker[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CANCELLED ...                                             */
/*----------------------------------------------------------------------------*/
: start_CancelledMarker \handler

  //"Operand:- ZK_M_CANCELLED" .verbose
  PipeIn[].delete

  // now pipeout a cleaning marker
  Marker[].newCleaningMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANED ...                                               */
/*----------------------------------------------------------------------------*/
: start_Cleaned \handler

  //"ZK_M_CLEANED_handler" .verbose
  Pipein[].delete

  // now pipeout an exiting marker
  Marker[].newExitingMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ENDED ...                                                 */
/*----------------------------------------------------------------------------*/
: start_EndedMarker \handler

  //"Operand:- ZK_M_ENDED" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Marker[].newCleaningMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ERRORED ...                                               */
/*----------------------------------------------------------------------------*/
: start_ErroredMarker \handler

  //"Operand:- ZK_M_ERRORED" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Marker[].newCleaningMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_EXITED ...                                                */
/*----------------------------------------------------------------------------*/
: start_ExitedMarker \handler

  //"Operand:- ZK_M_EXITED" .verbose
  PipeIn[].delete
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_LEFT ...                                                  */
/*----------------------------------------------------------------------------*/
: start_LeftMarker \handler

  //"Operand:- ZK_M_LEFT" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Marker[].newCleaningMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_LEAVING ...                                               */
/*----------------------------------------------------------------------------*/
: start_LeavingMarker \handler

  //"Operand:- ZK_M_LEAVING" .verbose

  // pipeline should not be cancelled
  Pipeline::cancelled@ not assert

  // pipeline should not be errored
  Pipeline::errored@ not assert

  // pipeline should have exited early
  Pipeline::earlyExit@ assert

  // mark pipeline as being pulsed
  true Pipeline::pulsed!

  // now pipeout the leaving marker
  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_ENDING ...                                            */
/*----------------------------------------------------------------------------*/
: start_EndingMarker \handler

  //"Operand:- ZK_M_ENDING" .verbose

  // pipeline should not be cancelled
  Pipeline::cancelled@ not assert

  // pipeline should not be errored
  Pipeline::errored@ not assert

  // pipeline should not have exited early
  Pipeline::earlyExit@ not assert

  // mark pipeline as being pulsed
  true Pipeline::pulsed!

  // now pipeout the ending marker
  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_STARTED ...                                               */
/*----------------------------------------------------------------------------*/
: start_StartedMarker \handler

  //"Operand:- ZK_M_STARTED" .verbose
  PipeIn[].delete
  Marker[].newTrigger
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for start request                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : start_op \operator
 
  _lu_initialise_

  op__topology

  find: start_CancelMarker      ZK_M_CANCEL      op[].handler!
  find: start_CancelledMarker   ZK_M_CANCELLED   op[].handler!
  find: start_Cleaned           ZK_M_CLEANED     op[].handler!
  find: start_EndingMarker      ZK_M_ENDING      op[].handler!
  find: start_EndedMarker       ZK_M_ENDED       op[].handler!
  find: start_ErroredMarker     ZK_M_ERRORED     op[].handler!
  find: start_ExitedMarker      ZK_M_EXITED      op[].handler!
  find: start_LeavingMarker     ZK_M_LEAVING     op[].handler!
  find: start_LeftMarker        ZK_M_LEFT        op[].handler!
  find: start_StartedMarker     ZK_M_STARTED     op[].handler!

  find: INVALID_OPERAND_handler ZK_D_CRWBUFFER       op[].handler!
  find: INVALID_OPERAND_handler ZK_D_CSVBUFFER       op[].handler!
  find: INVALID_OPERAND_handler ZK_D_ENTBUFFER       op[].handler!
  find: INVALID_OPERAND_handler ZK_D_ROWBUFFER       op[].handler!
  find: INVALID_OPERAND_handler ZK_D_STREAMDEF       op[].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: start :: start ;

: start_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
