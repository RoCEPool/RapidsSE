/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CANCEL ...                                                */
/*----------------------------------------------------------------------------*/
: start_CancelMarker \handler

  //"Operand:- EV_M_CANCEL" .verbose
  PipeIn[].delete

  // toggle to default abnormal handlers for all data operands
  "default_abnormalHandlers" FIND execute

  // check if start has already been pulsed
  [pipeline].pulsed@ if
    PipeIn[].delete
  else
    // mark pipeline as being cancelled
    true [pipeline].cancelled!

    Marker[].newCancelling
    Marker[].pipeOut

  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CANCELLED ...                                             */
/*----------------------------------------------------------------------------*/
: start_CancelledMarker \handler

  //"Operand:- EV_M_CANCELLED" .verbose
  PipeIn[].delete

  // now pipeout a cleaning marker
  Marker[].newCleaningMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANED ...                                               */
/*----------------------------------------------------------------------------*/
: start_Cleaned \handler

  //"EV_M_CLEANED_handler" .verbose
  Pipein[].delete

  // now pipeout an exiting marker
  Marker[].newExitingMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ENDED ...                                                 */
/*----------------------------------------------------------------------------*/
: start_EndedMarker \handler

  //"Operand:- EV_M_ENDED" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Marker[].newCleaningMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_ERRORED ...                                               */
/*----------------------------------------------------------------------------*/
: start_ErroredMarker \handler

  //"Operand:- EV_M_ERRORED" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Marker[].newCleaningMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_EXITED ...                                                */
/*----------------------------------------------------------------------------*/
: start_ExitedMarker \handler

  //"Operand:- EV_M_EXITED" .verbose
  PipeIn[].delete
  [op].ackInvokingTask

  false
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LEFT ...                                                  */
/*----------------------------------------------------------------------------*/
: start_LeftMarker \handler

  //"Operand:- EV_M_LEFT" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Marker[].newCleaningMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_LEAVING ...                                               */
/*----------------------------------------------------------------------------*/
: start_LeavingMarker \handler

  //"Operand:- EV_M_LEAVING" .verbose

  // delete the triggered marker
  Pipein[].delete

  // pipeline should not be cancelled
  [pipeline].cancelled@ not assert

  // pipeline should not be errored
  [pipeline].errored@ not assert

  // pipeline should have exited early
  [pipeline].earlyExit@ assert

  // mark pipeline as being pulsed
  true [pipeline].pulsed!

  // now pipeout the ending marker
  Marker[].newEndingMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_TRIGGERED ...                                             */
/*----------------------------------------------------------------------------*/
: start_TriggeredMarker \handler

  //"Operand:- EV_M_TRIGGERED" .verbose

  // delete the triggered marker
  Pipein[].delete

  // pipeline should not be cancelled
  [pipeline].cancelled@ not assert

  // pipeline should not be errored
  [pipeline].errored@ not assert

  // pipeline should not have exited early
  [pipeline].earlyExit@ not assert

  // mark pipeline as being pulsed
  true [pipeline].pulsed!

  // now pipeout the ending marker
  Marker[].newEndingMarker
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for EV_M_STARTED ...                                               */
/*----------------------------------------------------------------------------*/
: start_StartedMarker \handler

  //"Operand:- EV_M_STARTED" .verbose
  PipeIn[].delete
  Marker[].newTrigger
  Marker[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for start request                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : start_op \operator
 
  _lu_initialise_

  op__topology

  find: start_CancelMarker      EV_M_CANCEL      [op].handler!
  find: start_CancelledMarker   EV_M_CANCELLED   [op].handler!
  find: start_Cleaned           EV_M_CLEANED     [op].handler!
  find: start_EndedMarker       EV_M_ENDED       [op].handler!
  find: start_ErroredMarker     EV_M_ERRORED     [op].handler!
  find: start_ExitedMarker      EV_M_EXITED      [op].handler!
  find: start_LeavingMarker     EV_M_LEAVING     [op].handler!
  find: start_LeftMarker        EV_M_LEFT        [op].handler!
  find: start_StartedMarker     EV_M_STARTED     [op].handler!
  find: start_TriggeredMarker   EV_M_TRIGGERED   [op].handler!

  find: INVALID_OPERAND_handler EV_D_CRWBUFFER       [op].handler!
  find: INVALID_OPERAND_handler EV_D_CSVBUFFER       [op].handler!
  find: INVALID_OPERAND_handler EV_D_ENTBUFFER       [op].handler!
  find: INVALID_OPERAND_handler EV_D_ROWBUFFER       [op].handler!
  find: INVALID_OPERAND_handler EV_D_STREAMDEF       [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: start :: start ;

: start_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "start_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
