/*============================================================================*/
/* OP_start.sen -- Operator start                                             */
/*============================================================================*/

" OP_start.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_CancelMarker \handler

  //"Operand:- ZK_CANCELMARKER" .verbose

  // check if start has already been pulsed
  Pipeline::pulsed@ if
    PipeIn[].delete
  else
    // mark pipeline as being cancelled
    true Pipeline::cancelled!

    PipeIn[].pipeOut
  then

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CANCELLEDMARKER ...                                         */
/*----------------------------------------------------------------------------*/
: start_CancelledMarker \handler

  //"Operand:- ZK_CANCELLEDMARKER" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Operand[].newCleanupMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_CLEANEDUPMARKER ...                                         */
/*----------------------------------------------------------------------------*/
: start_CleanedupMarker \handler

  //"ZK_CLEANEDUPMARKER_handler" .verbose
  Pipein[].delete

  // now pipeout an exit marker
  Operand[].newExitMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENDEDMARKER ...                                             */
/*----------------------------------------------------------------------------*/
: start_EndedMarker \handler

  //"Operand:- ZK_ENDEDMARKER" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Operand[].newCleanupMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ERROREDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: start_ErroredMarker \handler

  //"Operand:- ZK_ERROREDMARKER" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Operand[].newCleanupMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_EXITEDMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_ExitedMarker \handler

  //"Operand:- ZK_EXITEDMARKER" .verbose
  PipeIn[].delete
  Op.ackPipelineJob

  false
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_LEFTMARKER ...                                              */
/*----------------------------------------------------------------------------*/
: start_LeftMarker \handler

  //"Operand:- ZK_LEFTMARKER" .verbose
  PipeIn[].delete

  // now pipeout a cleanup marker
  Operand[].newCleanupMarker
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_LEAVINGMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: start_LeavingMarker \handler

  //"Operand:- ZK_LEAVINGMARKER" .verbose

  // pipeline should not be cancelled
  Pipeline::cancelled@ not assert

  // pipeline should not be errored
  Pipeline::errored@ not assert

  // pipeline should have exited early
  Pipeline::earlyExit@ assert

  // mark pipeline as being pulsed
  true Pipeline::pulsed!

  // now pipeout the leaving marker
  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_ENDINGMARKER ...                                            */
/*----------------------------------------------------------------------------*/
: start_EndingMarker \handler

  //"Operand:- ZK_ENDINGMARKER" .verbose

  // pipeline should not be cancelled
  Pipeline::cancelled@ not assert

  // pipeline should not be errored
  Pipeline::errored@ not assert

  // pipeline should not have exited early
  Pipeline::earlyExit@ not assert

  // mark pipeline as being pulsed
  true Pipeline::pulsed!

  // now pipeout the ending marker
  Pipein[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_STARTEDMARKER ...                                           */
/*----------------------------------------------------------------------------*/
: start_StartedMarker \handler

  //"Operand:- ZK_STARTEDMARKER" .verbose
  PipeIn[].delete
  Operand[].newTrigger
  Operand[].pipeOut

  true
;

/*----------------------------------------------------------------------------*/
/* execute for start request                          (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : start_req \operator
 
  LogReqEntry SEED_REQ

  op__topology

  find: start_CancelMarker      ZK_CANCELMARKER      op[].handler!
  find: start_CancelledMarker   ZK_CANCELLEDMARKER   op[].handler!
  find: start_CleanedupMarker   ZK_CLEANEDUPMARKER   op[].handler!
  find: start_EndingMarker      ZK_ENDINGMARKER      op[].handler!
  find: start_EndedMarker       ZK_ENDEDMARKER       op[].handler!
  find: start_ErroredMarker     ZK_ERROREDMARKER     op[].handler!
  find: start_ExitedMarker      ZK_EXITEDMARKER      op[].handler!
  find: start_LeavingMarker     ZK_LEAVINGMARKER     op[].handler!
  find: start_LeftMarker        ZK_LEFTMARKER        op[].handler!
  find: start_StartedMarker     ZK_STARTEDMARKER     op[].handler!

  find: INVALID_OPERAND_handler ZK_CRWBUFFER       op[].handler!
  find: INVALID_OPERAND_handler ZK_CSVBUFFER       op[].handler!
  find: INVALID_OPERAND_handler ZK_ENTBUFFER       op[].handler!
  find: INVALID_OPERAND_handler ZK_ROWBUFFER       op[].handler!
  find: INVALID_OPERAND_handler ZK_STREAMDEF       op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: start :: start ;

: start_cmdTags _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
