/*============================================================================*/
/* OP_corrBySquash.sen -- Squash ProjectOps for CORRESPONDING BY clauses      */
/* (SQL Compiler)                                                             */
/*============================================================================*/

" OP_corrBySquash.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for EV_M_CLEANING ...                                              */
/*----------------------------------------------------------------------------*/
: corrBySquash_Cleaning \handler

  EV_M_CLEANING_handler
;

/*----------------------------------------------------------------------------*/
/* handler for EV_D_PLANOPERAND ...                                           */
/*----------------------------------------------------------------------------*/
: corrBySquash_PlanOperand \handler

  PipeIn[]\clear to PlanOperand[]

  // create the command error info set
  op__createCompileErrInfoSet

  PlanOperand[] nullptr to PlanOperand[] sqlCompiler::corrBySquash to PlanOperand[]

  "corrBySquash" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: corrBySquash_op \operator

  _lu_initialise_

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker       EV_M_LEAVE         [op].handler!
  find: compiler_StreamSet         EV_D_STREAMSET     [op].handler!

  // specific handlers
  find: corrBySquash_Cleaning      EV_M_CLEANING      [op].handler!
  find: corrBySquash_PlanOperand   EV_D_PLANOPERAND   [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: corrBySquash :: corrBySquash ;

: corrBySquash_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc>    = "--desc for op--"
    <opEntry> = "corrBySquash_op"
  }
;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
