/*============================================================================*/
/* OP_corrBySquash.sen -- Squash ProjectOps for CORRESPONDING BY clauses      */
/* (SQL Compiler)                                                             */
/*============================================================================*/

" OP_corrBySquash.sen" .verbose

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_CLEANUP ...                                           */
/*----------------------------------------------------------------------------*/
: corrBySquash_CleanupMarker \handler

  Pipein[].pipeOut
  true
;

/*----------------------------------------------------------------------------*/
/* handler for ZK_D_PLANOPERAND ...                                             */
/*----------------------------------------------------------------------------*/
: corrBySquash_PlanOperand \handler

  PipeIn[]\clear to Operand[]

  // create the command error info set
  op__cmdErrInfoSet

  Operand[] nullptr to Operand[] sqlCompiler::corrBySquash to Operand[]

   "corrBySquash" compiler_planOperand
;

/*----------------------------------------------------------------------------*/
/*----------------------------------------------------------------------------*/

/*----------------------------------------------------------------------------*/
/* compiler op request                                (on node where spawned) */
/*----------------------------------------------------------------------------*/
: corrBySquash_req \operator

  LogReqEntry SEED_REQ

  op__topology

  // common compiler handlers
  find: compiler_LeaveMarker       ZK_M_LEAVE   op[].handler!
  find: compiler_StreamSet         ZK_D_STREAMSET     op[].handler!

  // specific handlers
  find: corrBySquash_CleanupMarker ZK_M_CLEANUP op[].handler!
  find: corrBySquash_PlanOperand   ZK_D_PLANOPERAND   op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: corrBySquash :: corrBySquash ;

: corrBySquash_cmdTags _cmdTags tagCopy: op_tags

  tags{
    <cmdDesc>    = "--desc for op--"
  }

;
  
/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
