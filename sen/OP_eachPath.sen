/*============================================================================*/
/* OP_eachPath.sen -- Operator Each Path                                      */
/*============================================================================*/

" OP_eachPath.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* handler for ZK_M_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: eachPath_DataMarker \handler
 
  "eachPath_DataMarker" .

  ZK_M_DATAPULSE_handler

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  <paths> locals| nPaths |

  // find the __path table def
  C_TDEF_PATH op__tableDef_infoSet assert

  nPaths 0
  do
    // create each infoSet operand
    infoSetTable[] InfoSet[].new
      OI_PATH InfoSet[].opInfoset!

    nPaths
     I
     "<path" I >str str.cat ">" str.cat
       [job].tagSet@ tagSet.getStr
     3
     InfoSet[].addRowVargs
        
    InfoSet[].pipeOut
  loop
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : eachPath_op \operator

  _lu_initialise_

  op__topology

  find: eachPath_DataMarker ZK_M_DATAPULSE [op].handler!

  op__loop

  _lu_finalise_
  
  op__retires
  
  HAZARD
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eachPath :: eachPath ;

: eachPath_cmdTags _cmdTags tagCopy: op_tags
  tags{
    <cmdDesc> = "--desc for op--"
    <opEntry> = "eachPath_op"
  }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
