/*============================================================================*/
/* OP_eachPath.sen -- Operator Each Path                                      */
/*============================================================================*/

" OP_eachPath.sen" .verbose

// ... to be coded

/*----------------------------------------------------------------------------*/
/* handler for ZK_DATAPULSE ...                                               */
/*----------------------------------------------------------------------------*/
: eachPath_DataMarker \handler
 
  "eachPath_DataMarker" .

  ZK_DATAPULSE_handler

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  <paths> locals| nPaths |

  // find the __path table def
  C_TDEF_PATHINFO op__tableDef_infoSet assert

  nPaths 0
  do
    // create each infoSet operand
    infoSetTable[] infoSet[].new
      OI_PATHINFO infoSet[].opInfoset!

    nPaths
     I
     "<path" I >str str.cat ">" str.cat
       job[] job.tagSet@ tagSet.getStr
     3
     infoSet[].addRowVargs
        
    InfoSet[].pipeOut
  loop
;

/*----------------------------------------------------------------------------*/
/* execute for call pipeline req                      (on node where spawned) */
/*----------------------------------------------------------------------------*/
 : eachPath_req \operator

  LogReqEntry SEED_REQ

  op__topology

  find: eachPath_DataMarker ZK_DATAPULSE op[].handler!

  op__loop

  LogReqExit
  job::deleteThis
  DONE_REQ_OP
;

/*----------------------------------------------------------------------------*/
/*                                                                            */
/*----------------------------------------------------------------------------*/
cmdSyntax: eachPath :: eachPath ;

: eachPath _cmdTags tagCopy: op_tags
  tags{ <cmdDesc> = "--desc for op--" }
;

/*============================================================================*/
/* end                                                                        */
/*============================================================================*/
