#!/bin/bash
# This file contains function definitions that are imported and used by setup.sh.

# Guard against this file being executed directly.
if [ "${BASH_SOURCE[0]}" -ef "$0" ]
then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Print an error message to stderr,
## Params: 
##   $1 : Error message
##   $2..$n : (optional) other arguments to print.

function printError() {
  >&2 echo -e "ERROR: $*"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Print an error message to stderr and exit,
## Params: 
##   $1 : Error message
##   $2..$n : (optional) other arguments to print.

function errorExit() {
  >&2 echo -e "ERROR: $*"
  exit 1
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints the members of an array (one per line) with an indentation.
## Params:
##  $1 : The number of indent spaces on each line.
##  $@ : The array to print.

function printIndentArray() {

  local indents=$1
  shift
  local array=($@)

  if [ -z "${indents}" ]; then
   indents=2
  fi

  local var

  for var in ${array[*]}
  do
    # Intentional to preserve meaning of seq operator.
    # shellcheck disable=SC2046 
    printf "%0.s " $(seq 1 ${indents})
    printf '%s\n' "${var}"
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints the acceptable arguments to the script and then exits.
## Params: None

function printUsageAndExit() {
  echo ""
  echo "Usage: ./<install_file>.run [--node | --cluster]"
  echo "                            [--interactive | --script]"
  echo "                            --config <file>"
  echo "                            [--basic | --adv/--advanced]"
  echo "                            [--debug]"
  echo "  Details:"
  echo "    --cluster       [Default] Installs RapidsSE on a cluster."
  echo "    --node          Installs RapidsSE on the current node using a supplied"
  echo "                    configuration file. The --config option must be specified."
  echo ""
  echo "    --interactive   Uses a wizard to ask questions and prompt for answers"
  echo "                    in order to build a cluster configuration."
  echo "    --script        Does not prompt the user for input and uses the supplied"
  echo "                    configuration. The --config option must be specified."
  echo ""
  echo "    --config <file> Specifies the path to an existing configuration"
  echo "                    file that contains the cluster settings."
  echo ""
  echo "    --basic         [Default] Hides advanced questions during the cluster"
  echo "                    installation wizard (if being used)."
  echo "    --adv"
  echo "    --advanced      Asks additional questions during the cluster"
  echo "                    installation wizard."
  echo ""
  echo "   --installer     Path to the installation *.run file."
  echo ""
  echo "    --debug         Displays more messages during execution."
  exit 1
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Inspect all of the arguments, checking for incompatibilities, and set
## the appropriate global variables
## Params: the arguments to the script

function processArgs() {

  # Local variables that have value 1 if that argument has been specified.
  local argCluster=0
  local argNode=0
  local argInteractive=0
  local argScript=0
  local argConfig=0
  local argBasic=0
  local argAdvanced=0
  local argInstaller=0

  while [[ $# -gt 0 ]]
  do
    key="$1"
    case "${key}" in
  
      --cluster)
        CLUSTER_INSTALL=1
        argCluster=1
        shift # past argument
        ;;
  
      --node)
        CLUSTER_INSTALL=0
        argNode=1
        shift # past argument
        ;;
  
      --interactive)
        INTERACTIVE_INSTALL=1
        argInteractive=1
        shift # past argument
        ;;
  
      --script)
        INTERACTIVE_INSTALL=0
        argScript=1
        shift # past argument
        ;;
  
      --config)
        argConfig=1
        CONFIG_FILE="$2"
        shift # past argument
        shift # past value
        ;;
  
      --config=*)
        argConfig=1
        CONFIG_FILE="${key#*=}"
        shift # past argument=value
        ;;
  
      --basic)
        ADV_WIZARD=0
        argBasic=1
        shift # past argument
        ;;
  
      --adv|--advanced)
        ADV_WIZARD=1
        argAdvanced=1
        shift # past argument
        ;;

      --installer)
        argInstaller=1
        INSTALL_FILE="$2"
        shift # past argument
        shift # past value
        ;;
  
      --installer=*)
        argInstaller=1
        INSTALL_FILE="${key#*=}"
        shift # past argument=value
        ;;
  
      --debug)
        DEBUG=1
        shift # past argument
        ;;

      --help|-h)
        shift
        printUsageAndExit
        ;;

      *)
        shift
        printUsageAndExit
        ;;
    esac
  done

  # Now we can check for invalid combinations of arguments.
    # --cluster   and --node
    # --node      and --interactive
    # --config    and no file specified
    # --config    and file not found
    # --basic     and --script
    # --adv       and --script
    # --basic     and --node
    # --adv       and --node
    # --installer and no file specified
    # --installer and file not found

  local errmsg="Invalid combination of arguments specified: "

  if [[ ${argCluster} -eq 1  && ${argNode} -eq 1 ]];        then 
    printError "${errmsg}" "--cluster" "--node"
    printUsageAndExit
  fi

  if [[ ${argNode} -eq 1     && ${argInteractive} -eq 1 ]]; then 
    printError "${errmsg}" "--node" "--interactive"
    printUsageAndExit
  fi

  if [[ ${argBasic} -eq 1    && ${argScript} -eq 1 ]];      then 
    printError "${errmsg}" "--basic" "--script" 
    printUsageAndExit
  fi

  if [[ ${argAdvanced} -eq 1 && ${argScript} -eq 1 ]];      then 
    printError "${errmsg}" "--advanced" "--script"
    printUsageAndExit
  fi

  if [[ ${argBasic} -eq 1    && ${argNode} -eq 1 ]];        then 
    printError "${errmsg}" "--basic" "--node"
    printUsageAndExit
  fi

  if [[ ${argAdvanced} -eq 1 && ${argNode} -eq 1 ]];        then 
    printError "${errmsg}" "--advanced" "--node" 
    printUsageAndExit
  fi

  if [[ ${argConfig} -eq 1 && -z "${CONFIG_FILE}" ]];  then 
    printError "${errmsg}" "No config file specified" 
    printUsageAndExit
  fi

  if [[ ${argConfig} -eq 1 && -f "${CONFIG_FILE}" ]]; then 
    printError "Config file does not exist: ${CONFIG_FILE}"
    printUsageAndExit 
  fi

  if [[ ${argInstaller} -eq 1 && -z "${INSTALL_FILE}" ]];  then 
    printError "${errmsg}" "No installation *.run file specified" 
    printUsageAndExit
  fi

  if [[ ${argInstaller} -eq 1 && -f "${INSTALL_FILE}" ]]; then 
    printError "Installation *.run file does not exist: ${INSTALL_FILE}"
    printUsageAndExit 
  fi


  # Check for dependencies between combinations of arguments.
    # --node   must have --config
    # --script must have --config

  if [[ ${argNode} -eq 1 && ${argConfig} -eq 0  ]] 
  then 
    printError "Missing argument dependency: argument --node must also specify argument --config"
    printUsageAndExit
  fi

  if [[ ${argScript} -eq 1 && ${argConfig} -eq 0  ]] 
  then 
    printError "Missing argument dependency: argument --script must also specify argument --config"
    printUsageAndExit
  fi

}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Find the path of the installation file that kicked off this script.
## Params: None

function findInstallFile() {

  # First try to get it from the parent process's command line
  if [ "${DEBUG}" -eq 1 ]; then echo "Looking for install file from PPID."; fi;

  local parentScript
  parentScript="$(cut -f 2 -d '' < /proc/${PPID}/cmdline)"

  if [[ -n "${parentScript}" && "${parentScript:(-4):4}" == ".run" && -f "${USER_PWD}/${parentScript}" ]]
  then
    INSTALL_FILE="${USER_PWD}/${parentScript}"
    return
  fi

  # Otherwise if there is only one .run file in the $USER_PWD then this would be it.
  if [ "${DEBUG}" -eq 1 ]; then echo "Looking for install file in directory: ${USER_PWD}"; fi;

  local runfiles
  mapfile -t runfiles < <( ls -1 "${USER_PWD}"/*.run || true )
  
  if [[ ${#runfiles[@]} -eq 1 && -f "${runfiles[0]}" ]]
  then
    INSTALL_FILE="${runfiles[0]}"
    return
  fi

  errorExit "Could not find the installation *.run file. Trying specifying it with the --installer argument."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Install the product across the cluster.
## Params: None

function doClusterInstall() {
  # Need to consider if this installation is interactive or scripted, or
  # whether an existing config file is being used.

  if [ ${INTERACTIVE_INSTALL} -eq 1 ]; then
    displayWelcome

    if [ -n "${CONFIG_FILE}" ]; then
      # We have been given a config file.
      true
      # Load and validate config
      # Present summary
      # Edit ?
      # Validate config/environment
      # Write config file?
      # Install all nodes

    else
      # No config file given. We need to prompt the user to configure the cluster.
      echo "Let's build a cluster configuration."

      createConfiguration
      # Present summary
      # Edit ?
      # Validate config/environment
      # Write config file?
      # Install all nodes
    fi

  else 
    # Scripted installation
    
    # Assert that we have a config file
    [ -f "${CONFIG_FILE}" ] || errorExit "Config file does not exist: ${CONFIG_FILE}"

    # Load and validate config
    # Validate config/environment
    # Write config file?
    # Install all nodes
    
  fi
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Create a cluster configuration interactively by prompting the user.
## Params: None

function createConfiguration() {
  
  # (advanced) node name prefix
  askNamePrefix

  # hostnames
  askHostnames

  # (advanced) port
  askPort

  # installation directory
  askInstallDir

  # shared memory size
  askShmSize

  # (advanced) partitions
  askPartitions

  # (advanced) threads
  askThreads

  # (advanced) additional parameters
  askParams

}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Welcomes the user to the interactive install wizard.
## Params: None

function displayWelcome() {
  clear
  source "${VERSION_FILE}"

  echo "Welcome to the RapidsSE installation wizard for RapidsSE version ${SE_VERSION_STR}."
  echo ""
  echo "This will guide you through the process of installing and setting up RapidsSE"
  echo "on a cluster."
  echo ""
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Ask the user to enter a prefix to be used for each node name.
## This only runs when ADV_WIZARD=1.
## Params: None

function askNamePrefix() {

  if [ ${ADV_WIZARD} -ne 1 ]; then
    return
  fi

  local line

  echo ""
  echo "Node Name Prefix"
  echo "----------------"
  echo ""
  echo "Please enter a prefix for naming each node. A sequence number will be applied"
  echo "after this prefix. e.g a prefix of 'NODE' will result in NODE1, NODE2, etc."
  echo "The node name prefix must not contain spaces."
  echo "Press return with a blank input to accept the default value."

  while true
  do
    echo ""
    echo -n "Enter a node name prefix [default: ${NODE_NAME_PREFIX}] : "
    IFS=$'\n' read -r line

    # check for whitespace
    if [[ "${line}" = *[[:space:]]* ]]; then
      echo "Invalid input: node name prefix cannot contain whitespace."
      continue
    fi

    # Check if using the default value
    if [ -z "${line}" ]; then 
      break
    fi

    # Save the value
    NODE_NAME_PREFIX="${line}"
    break
  done

}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Ask the user to enter all of the hostnames/IPs where RapidsSE is to run.
## Params: None

function askHostnames() {

  declare -a hostnames
  local line

  echo ""
  echo "Hostnames"
  echo "---------"
  echo ""
  echo "Let's collect the hostnames/IP addresses of all the machines that RapidsSE"
  echo "is to be installed on (including the current machine, if applicable)."
  echo ""
  
  # Get the first host
  while true
  do
    echo ""
    echo -n "Enter a hostname/IP and press return : "
    IFS=$'\n' read -r line

    if [[ "${line}" = *[[:space:]]* ]]; then
      echo "Invalid input: hostname/IP cannot contain whitespace."
      continue
    fi

    if [ -z "${line}" ]; then 
      echo "Invalid input: must have at least one hostname."
      continue 
    fi

    hostnames+=(${line})
    break
  done

  # Get any subsequent hosts
  while true
  do
    echo ""
    echo -n "Enter another hostname/IP, or an empty line to finish : "
    IFS=$'\n' read -r line

    if [[ "${line}" = *[[:space:]]* ]]; then
      echo "Invalid input: hostname/IP cannot contain whitespace."
      continue
    fi

    if [ -z "${line}" ]; then 
      break
    fi

    hostnames+=(${line})
  done

  echo ""
  echo "Got the following hostnames / IP addresses:"
  printIndentArray 2 "${hostnames[@]}"

  # Build the node list
  createNodeNames ${#hostnames[@]}

  # Build the node_cfg associative arrays
  createNodeConfigs "${NODE_LIST[@]}"

  # set the hostname field in each node_cfg associative array
  local i=0
  while [ $i -lt ${#hostnames[@]}  ] 
  do
    nodeCfgSetValue "${NODE_LIST[$i]}" "${NODE_CFG_HOST_KEY}" "${hostnames[$i]}"
    nodeCfgPrint "${NODE_LIST[$i]}"
    i=$((i+1))
  done

}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Populates the NODE_LIST array with node names based on a given count passed
## in as a parameter.
## Params:
##  $1 : A count of node names to be created.

function createNodeNames() {
  local count=$1
  local i=0

  while [ $i -lt ${count}  ]
  do
    NODE_SEQ_NUM=$((NODE_SEQ_NUM+1))
    NODE_LIST+=("${NODE_NAME_PREFIX}${NODE_SEQ_NUM}")
    i=$((i+1))
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Creates associative arrays for each node name that is passed in.
## Params:
##  $@ : An array of node names.

function createNodeConfigs() {
  local nodeNames
  nodeNames=($@)

  local nodeName

  for nodeName in "${nodeNames[@]}"
  do
    # Dynamically create the associative array
    local nodeCfg="${NODE_CFG_PREFIX}${nodeName}"
    declare -gA "${nodeCfg}"

    # Populate the "name" field.
    nodeCfgSetValue "${nodeName}" "${NODE_CFG_NAME_KEY}" "${nodeName}"
  done 
}



# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Sets a value for a key in a dynamically created associative array.
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the SE node. 
##  $2 : The name of the key in this node's associate array.
##  $3 : The value to set against this key in the node's associate array.

function nodeCfgSetValue() {
  local nodeName=$1
  local key=$2
  local value=$3

  #declare "${NODE_CFG_PREFIX}${nodeName}[${key}]=${value}"
  eval "${NODE_CFG_PREFIX}${nodeName}"["${key}"]="${value}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns a value for a key in a dynamically created associative array.
## This function should be called by:
##   result=$(nodeCfgGetValue ${nodeName} ${key})
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the SE node.
##  $2 : The name of the key in this node's associate array whose value to return.

function nodeCfgGetValue() {
  local nodeName=$1
  local key=$2

  local ref="${NODE_CFG_PREFIX}${nodeName}[${key}]"
  echo "${!ref}"
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Returns an array of keys in a dynamically created associative array.
## This function should be called by:
##   result=($(nodeCfgGetKeys ${nodeName}))
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the SE node.

function nodeCfgGetKeys() {
  local nodeName=$1

  eval echo '${!'"${NODE_CFG_PREFIX}${nodeName}"'[@]}'
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Prints the name of the node's associative array, it's keys and values.
##
## NB: Not relying on bash v4.3 which introduces reference variables that would
##     make this a lot easier.
##
## Params:
##  $1 : The name of the SE node.

function nodeCfgPrint() {
  local nodeName=$1
  local keys=($(nodeCfgGetKeys "${nodeName}"))
  
  local arrayName="${NODE_CFG_PREFIX}${nodeName}"

  echo "${arrayName}"

  for key in "${keys[@]}"
  do
    local value
    value=$(nodeCfgGetValue "${nodeName}" "${key}")

    echo "  [${key}] = ${value}"
  done
}


