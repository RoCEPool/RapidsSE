#!/bin/bash
# This file contains function definitions that are imported and used by setup.sh.

# Guard against this file being executed directly.
if [ "${BASH_SOURCE[0]}" -ef "$0" ]
then
  >&2 echo "This file should be sourced, not executed: $0"
  exit 1
fi



# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validate that the environment we are installing into is correct before
## continuing with the installation.
## Params: None

function validateEnvironment() {

  echo "Validating the installation environment on all nodes..."
  echo ""

  # Check that all hosts are resolvable.
  validateHostsAreResolvable

  # Check that all host/dir combinations are unique.
  validateHostsAndDirsAreUnique

  # Check that all host:port combinations are unique.
  validateHostsAndPortsAreUnique

  # Check if all hosts are reachable by SSH.
  validateHostsReachableBySsh

  # TODO: Check if SE is running in any of these host:directory combinations.

  # Check if the port is not being used on any of the hosts.
  validatePortsNotInUse

  # TODO: Check if a conflicting SE SHM file exists on any of the hosts.

  # Check if the SE reserved memory size exceeds /dev/shm total size (if this exists).
  validateShmAgainstTotalSize

  # Check if the SE reserved memory size exceeds 95% of RAM.
  validateShmAgainstRAM

  # Check if the SE reserved memory size exceeds the available SHM space.
  validateShmAgainstAvailableMem

  # Check that the number of partitions is acceptable.
  validatePartitions

  # Check that the number of threads is acceptable.
  validateThreads

  # Check that the installation dir can be created (if not already) on each node,
  # and that it is writable.
  validateInstallDirIsWritable

  # TODO: If an installation already exists on any node, confirm that the user wishes to overwrite it.

  # TODO: Check that node names don't contain spaces or special characters.

  # TODO: Check that node names are unique.

  # TODO: Check that there is at least one hostname.

  # TODO: Check that NODE_SEQ_NUM is always non-zero if we read in an existing config

}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that all hosts are resolvable on the current machine. Exits out
## and writes an error to stderr if not.
## Params: None

function validateHostsAreResolvable() {

  local nodeName
  local host
  local output

  if [ "${NO_RESOLVE_HOSTS:-x}" != "x" ]; then
    debugPrint "Skipping host resolution."
    return
  fi

  debugPrint "About to validate that all hostnames are resolvable."

  for nodeName in "${NODE_LIST[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"

    # Check if the hostname is an IP address
    local re="^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$"
  
    if [[ "${host}" =~ ${re} ]]; then
      # We've got an IPv4 address
      # Check the quads
      for i in 1 2 3 4
      do
        if [ "$(echo "${host}" | cut -d. -f${i})" -gt 255 ]; then
          errorExit "Hostname \"${host}\" is not a valid IPv4 address."
        fi
      done

      # This is a valid IPv4 address
      continue

    elif [[ "${host}" == *:* ]]; then
      # We've got an IPv6 address
      re="^([0-9a-fA-F]{0,4}:){1,7}([0-9a-fA-F]){0,4}$"

      if [[ ! "${host}" =~ $re ]]; then
        errorExit "Hostname \"${host}\" is not a valid IPv6 address."
      fi

      # This is a valid IPv6 address
      continue
    fi
 
   
    # We must have a hostname to resolve. There are a few different tools that
    # can be used to resolve it, depending on what is installed.

    # Use getent to resolve the hostname, if available
    if which getent &>/dev/null; then

      output="$(getent hosts "${host}" | awk '{ print $1; exit }' 2>/dev/null)"
      if [ -z "${output}" ]; then
        errorExit "Hostname \"${host}\" is not resolvable."
      fi
  
      # Host was resolved.
      continue


    # No getent, then try dig
    elif which dig &>/dev/null; then

      output="$(dig +short +search "${host}" | awk '{ print ; exit }' 2>/dev/null)"
      if [ -z "${output}" ]; then
        errorExit "Hostname \"${host}\" is not resolvable."
      fi

      # Host was resolved.
      continue


    # No dig, then try nslookup
    elif which nslookup &>/dev/null; then
      
      output="$(nslookup "${host}" | awk '/^Address: / { print $2 ; exit }' 2>/dev/null)"
      if [ -z "${output}" ]; then
        errorExit "Hostname \"${host}\" is not resolvable."
      fi

      # Host was resolved.
      continue

    # No nslookup either. Don't validate the hostnames.
    else
      printWarning "Could not validate that the hostnames are resolvable. No [getent|dig|nslookup] tools available."
    fi

  done

  debugPrint "Successfully validated that all hostnames are resolvable."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that there are no duplicate entries with the same host:dir combination.
## Params: None

function validateHostsAndDirsAreUnique() {

  local nodeName
  local host
  local dir
  local key

  declare -A map

  for nodeName in "${NODE_LIST[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    dir="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"

    key="${host}:${dir}"

    # Check if the value for this key is not set.
    if [ "${map[${key}]:-x}" != "x" ]; then
      errorExit "Non-unique host / installation directory combination for the following nodes:" "${map[${key}]}" "${nodeName}"
    fi

    # Set the value for this key.
    map[${key}]="${nodeName}"
  done

  # We're all good. All host/dir combinations are unique.
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that there are no duplicate entries with the same host:port combination.
## Params: None

function validateHostsAndPortsAreUnique() {

  local nodeName
  local host
  local port
  local key

  declare -A map

  for nodeName in "${NODE_LIST[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_PORT_KEY}")"

    key="${host}:${port}"

    # Check if the value for this key is not set.
    if [ "${map[${key}]:-x}" != "x" ]; then
      errorExit "Non-unique host:port combination for the following nodes:" "${map[${key}]}" "${nodeName}"
    fi

    # Set the value for this key.
    map[${key}]="${nodeName}"
  done

  # We're all good. All host:port combinations are unique.
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that each hostname is reachable by SSH.
## Exits out and writes an error to stderr if not.
## Params: None

function validateHostsReachableBySsh() {
 
  local nodeName
  local host 

  declare -a sshArgs
  declare -a jobArray

  debugPrint "About to validate that nodes can be reached by SSH."

  for nodeName in "${NODE_LIST[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    sshArgs=("-q" "-o" "StrictHostKeyChecking no" "-o" "PasswordAuthentication no" "-o" "ConnectTimeout 10" "${host}" "exit" "0")

    # Run it, in parallel
    (
      if ! ssh "${sshArgs[@]}"; then
        errorExit "Node ${nodeName} [host: ${host}] cannot be reached by password-less SSH."
      fi
  
      true
    ) &

    jobArray+=("$!")
  done

  # Check the exit status of each background job.
  for j in "${jobArray[@]}"
  do
    if ! wait "$j"; then
      exit 1
    fi
  done

  debugPrint "Successfully validated that all nodes can be reached by SSH."
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Validate that the port specified for each node is not currently in use.
# Params: None

function validatePortsNotInUse() {

  local nodeName
  local host
  local port
  local remoteCmd
  local output

  declare -a sshArgs
  declare -a failedNodes
  failedNodes=()

  for nodeName in "${NODE_LIST[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_PORT_KEY}")"

    remoteCmd="which nc &>/dev/null && nc -z 127.0.0.1 ${port} && echo \"PORT_IN_USE\""

    sshArgs=("-q" "-o" "StrictHostKeyChecking no" "${host}" "bash" "-c" "'${remoteCmd}'")

    # Run it
    output="$(ssh "${sshArgs[@]}" || true)"

    if [ "${output}" == "PORT_IN_USE" ]; then
      failedNodes+=("${nodeName}")
    fi
  done

  if [ "${#failedNodes[@]}" -gt 0 ]; then
    local errMsg="The port specified for RapidsSE is already in use on the following nodes:"
    
    for nodeName in "${failedNodes[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
      port="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_PORT_KEY}")"
      errMsg+="$(printf "\n  %-12s %12s:%s" "${nodeName}" "${host}" "${port}")"
    done

    errorExit "${errMsg}"
  fi
}

  
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Validates that the shared memory segment does not exceed the size of shared
# memory on any node.
# Params: None

function validateShmAgainstTotalSize() {

  local nodeName
  local host
  local nodeShm   # SE SHM allocated for a given node
  local shmTotal  # OS SHM on /dev/shm

  for nodeName in "${!NODE_TOTAL_SHM[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodeShm="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_MEM_KEY}")"
    shmTotal="${NODE_TOTAL_SHM[${nodeName}]}"

    if [ "$(echo "${nodeShm} > ${shmTotal}" | bc -l)" -eq 1 ]; then
      errorExit "The shared memory allocated for RapidsSE (${nodeShm}GB) on ${nodeName} [host ${host}] exceeds the allocation of shared memory on that host (${shmTotal}GB). Refer to \"df -h /dev/shm\" on that host."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Check if the SE shared memory size exceeds 95% of RAM on any node.
# Params: None

function validateShmAgainstRAM() {

  local nodeName
  local host
  local nodeShm   # SE SHM allocated for a given node
  local ram       # OS total RAM

  for nodeName in "${!NODE_TOTAL_MEM[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodeShm="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_MEM_KEY}")"
    ram="${NODE_TOTAL_MEM[${nodeName}]}"
  
    if [ "$(echo "${nodeShm} > (0.95 * ${ram})" | bc -l)" -eq 1 ]; then
      errorExit "The shared memory allocated for RapidsSE (${nodeShm}GB) on ${nodeName} [host ${host}] exceeds 95% of total RAM on that host (${ram}GB)."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Check if the shared memory size exceeds the available shared memory space
# on /dev/shm. Issue a warning if this is the case.
# Params: None

function validateShmAgainstAvailableMem() {
  
  local nodeName
  local host
  local nodeShm   # SE SHM allocated for a given node
  local availableShm  # The space left on /dev/shm

  for nodeName in "${!NODE_FREE_SHM[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodeShm="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_MEM_KEY}")"
    availableShm="${NODE_FREE_SHM[${nodeName}]}"

    if [ "$(echo "${nodeShm} > ${availableShm}" | bc -l)" -eq 1 ]; then
      printWarning "The shared memory allocated for RapidsSE (${nodeShm}GB) on ${nodeName} [host ${host}] exceeds the available shared memory space on /dev/shm on that host (${availableShm}GB)."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Validate that the number of partitions is acceptable. This includes the 
# following rules:
#   - #partitions is > 0
#   - #partitions is <= 32 (for now) 
#   - #partitions is <= #cores
#
# Params: None

function validatePartitions() {

  local nodeName
  local host
  local nodePartitions # SE #partitions for a given node
  local cores          # #cpu cores on a given node

  for nodeName in "${!NODE_CORE_COUNT[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodePartitions="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_PARTITIONS_KEY}")"
    cores="${NODE_CORE_COUNT[${nodeName}]}"

    if [ "${nodePartitions}" -lt 1 ]; then

      errorExit "The number of partitions specified for RapidsSE on ${nodeName} [host ${host}] (${nodePartitions}) must be greater than zero."
    fi

    if [ "${nodePartitions}" -gt "${MAXIMUM_NUM_PARTITIONS}" ]; then
      errorExit "The number of partitions specified for RapidsSE on ${nodeName} [host ${host}] (${nodePartitions}) is greater than the maximum number of partitions currently allowed (${MAXIMUM_NUM_PARTITIONS})."
    fi

    if [ "${nodePartitions}" -gt "${cores}" ]; then
      errorExit "The number of partitions specified for RapidsSE on ${nodeName} [host ${host}] (${nodePartitions}) is greater than the number of cores for that node (${cores})."
    fi
  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Validate that the number of threads is acceptable. This includes the following
# rules:
#   - #threads must be at least the minimum (error).
#   - #threads must be >= #partitions (error).
#   - #threads must be >= #partitions + 6.
#   - #threads should not be > #cores unless to meet any of the above rules.
# 
# Params: None

function validateThreads() {

  local nodeName
  local host
  local nodeThreads    # SE #threads for a given node
  local nodePartitions # SE #partitions for a given node
  local cores          # #cpu cores on a given node

  for nodeName in "${!NODE_CORE_COUNT[@]}"
  do
    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    nodeThreads="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_THREADS_KEY}")"
    nodePartitions="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_PARTITIONS_KEY}")"
    cores="${NODE_CORE_COUNT[${nodeName}]}"

    if [ "${nodeThreads}" -lt "${MINIMUM_NUM_THREADS}" ]; then
      errorExit "The number of threads specified for RapidsSE on ${nodeName} [host ${host}] (${nodeThreads}) is less than the minimum value (${MINIMUM_NUM_THREADS})."
    fi

    if [ "${nodeThreads}" -lt "${nodePartitions}" ]; then
      errorExit "The number of threads specified for RapidsSE on ${nodeName} [host ${host}] (${nodeThreads}) is less than the number of partitions for that node (${nodePartitions})."
    fi

    if [ "${nodeThreads}" -lt $((nodePartitions + 6)) ]; then
      errorExit "The number of threads specified for RapidsSE on ${nodeName} [host ${host}] (${nodeThreads}) must be at least $((nodePartitions + 6)) for the given number of partitions on this node (${nodePartitions})."
    fi

    if [[ "${nodeThreads}" -gt ${cores} && "${nodeThreads}" -ne "${MINIMUM_NUM_THREADS}" && "${nodeThreads}" -ne $((nodePartitions + 6)) ]]; then
      printWarning "The number of threads specified for RapidsSE on ${nodeName} [host ${host}] (${nodeThreads}) exceeds the number of cores for that node (${cores}). This can cause sub-optimal performance."
    fi

  done
}


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
## Validates that the installation directory on each node can be created 
## and is writable. Exits out if not.
## Params: None

function validateInstallDirIsWritable() {
 
  local nodeName 
  local host
  local dir
  local remoteCmd
  local response
  
  declare -a sshCmd
  declare -A errors

  for nodeName in "${NODE_LIST[@]}"
  do

    host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")"
    dir="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_DIR_KEY}")"

    remoteCmd="$(cat <<-EOF
			if [ -d "${dir}" ]; then 
				if [ ! -w "${dir}" ]; then
					echo "Installation directory exists (${dir}) but is not writable.";
					false;
					exit;
				fi
			else
				if [ ! -w "$(dirname "${dir}")" ]; then
					echo "Installation directory (${dir}) cannot be created because the parent directory is not writable.";
					false;
					exit;
				fi
			fi
			true;
		EOF
    )"

    sshCmd=( "ssh" "-q" "${host}" "bash" "-c" "'${remoteCmd}'" )

    debugPrint "About to validate the installation directory on node ${nodeName} with the command: ${sshCmd[*]}"

    if ! response="$("${sshCmd[@]}")"; then
      debugPrint "Install dir validation failed: ${response}"

      # Save the response and the node name
      errors["${nodeName}"]="${response}"
    fi

  done

  if [ "${#errors[@]}" -gt 0 ]; then
    local errMsg="Validation of the installation directory failed:"

    for nodeName in "${!errors[@]}"
    do
      host="$(nodeCfgGetValue "${nodeName}" "${NODE_CFG_HOST_KEY}")" 
      errMsg="${errMsg}\nOn ${nodeName} [host: ${host}] :	${errors[${nodeName}]}"
    done

    echo ""
    errorExit "${errMsg}"
  fi

  debugPrint "Successfully validated that the installation directories are writable."
}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -


